            "dialogues": [
                {
                    "id": "686240101",
                    "speaker": "Fonógrafo Automático",
                    "text": "(Parece um fonógrafo que pode trocar discos. Deveria ter quatro discos diferentes, talvez apertar esses botões troque entre eles...)"
                }
            ]
        },
        {
            "talkId": "6862402",
            "initDialog": "686240201",
            "dialogues": [
                {
                    "id": "686240201",
                    "speaker": "Player",
                    "text": "(Pressione o botão na <color=#00E1FFFF>esquerda</color>.)"
                }
            ]
        },
        {
            "talkId": "6862403",
            "initDialog": "686240301",
            "dialogues": [
                {
                    "id": "686240301",
                    "speaker": "Player",
                    "text": "(Pressione o botão na <color=#00E1FFFF>direita</color>.)"
                }
            ]
        },
        {
            "talkId": "6862404",
            "initDialog": "686240401",
            "dialogues": [
                {
                    "id": "686240401",
                    "speaker": "Player",
                    "text": "(Pressione o botão na <color=#00E1FFFF>esquerda</color> de novo.)"
