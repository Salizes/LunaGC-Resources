        {
            "talkId": "6862408",
            "initDialog": "686240801",
            "dialogues": [
                {
                    "id": "686240801",
                    "speaker": "<UNKNOWN>",
                    "text": "(A alegria flui por uma corrente invisível, convergindo em um mar, com todo cliente do Navio-Chefe envolvido por um molhadeiro de espuma.)"
                }
            ]
        },
        {
            "talkId": "6862409",
            "initDialog": "686240901",
            "dialogues": [
                {
                    "id": "686240901",
                    "speaker": "<UNKNOWN>",
                    "text": "(A brisa da tarde carrega uma melodia da Cidade de Nasha, tocando toda janela, e explorando sonhos e desejos desconhecidos dentro delas.)"
                }
            ]
        },
        {
            "talkId": "6862410",
            "initDialog": "686241001",
            "dialogues": [
                {
                    "id": "686241001",
                    "speaker": "<UNKNOWN>",
                    "text": "(Aqui, o mundo gira no ritmo certo, com cada componente encontrando seu local preciso graças a felicidade.)"
                }
            ]
        },
        {
            "talkId": "6862411",
            "initDialog": "686241101",
            "dialogues": [
                {
                    "id": "686241101",
                    "speaker": "<UNKNOWN>",
                    "text": "(Esse ritmo é o chamado do vento, o hino da terra, um desconhecido austero e magnífico que nos motiva.)"
                }
            ]
        }
    ]
