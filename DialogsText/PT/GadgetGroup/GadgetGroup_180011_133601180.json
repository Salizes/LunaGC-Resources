                {
                    "id": "686250101",
                    "speaker": "Túmulo de Dietrich",
                    "text": "Aqui jaz Dietrich, o Portador da Lâmpada"
                }
            ]
        },
        {
            "talkId": "6862502",
            "initDialog": "686250206",
            "dialogues": [
                {
                    "id": "686250206",
                    "speaker": "<UNKNOWN>",
                    "text": "<color=#00E1FFFF>Inspecionar com atenção</color>"
                },
                {
                    "id": "686250201",
                    "speaker": "Túmulo de Dietrich",
                    "text": "<color=#00E1FFFF>\"O som da dança vinha dos vizinhos, meus pés começaram a bater, ah!\"</color>"
                },
                {
                    "id": "686250202",
                    "speaker": "Túmulo de Dietrich",
                    "text": "<color=#00E1FFFF>\"Vocês sorrindo, eu no violino,\"</color>"
                },
                {
                    "id": "686250203",
                    "speaker": "Túmulo de Dietrich",
                    "text": "<color=#00E1FFFF>\"E todos dançando pra lá e pra cá!\"</color>"
                },
                {
                    "id": "686250204",
                    "speaker": "Túmulo de Dietrich",
                    "text": "<color=#00E1FFFF>\"Chega mais perto, vamos dançar!\"</color>"
                },
                {
                    "id": "686250205",
                    "speaker": "Túmulo de Dietrich",
                    "text": "<color=#00E1FFFF>Que os sonhos dele sejam cheios de vinho e canções eternas.</color>"
                }
            ]
        }
    ]
}