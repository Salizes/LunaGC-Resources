            "dialogues": [
                {
                    "id": "684120401",
                    "speaker": "Pedaço de Notícia Descartado",
                    "text": "(Uma página antiga local do Pássaro a Vapor, recortada e descartada)"
                },
                {
                    "id": "684120402",
                    "speaker": "Pedaço de Notícia Descartado",
                    "text": "\"...importações de chá do Vale Chenyu estão previstas para checar no próximo trimestre... o mesmo tempo que o preço do chá e de outras coisas no mercado de Liyue aumentam para... Mora...\""
                },
                {
                    "id": "684120403",
                    "speaker": "Pedaço de Notícia Descartado",
                    "text": "(Várias partes do texto estão circuladas no canto inferior direito do recorte, acompanhada de um asterisco e três enormes pontos de exclamação.)",
                    "choices": [
                        {
                            "id": "684120404",
                            "text": "(Ver o conteúdo circulado.)",
                            "response": [
                                {
                                    "id": "684120405",
                                    "speaker": "Pedaço de Notícia Descartado",
                                    "text": "\"...Recentemente, todos os executivos seniores da organização criminosa Club di Pantaloni Novita foram presos. O equilíbrio subterrâneo de poder no Porto Lumidouce é temido que seja quebrado pela Spina di Rosula...\"",
                                    "choices": [
                                        {
                                            "id": "684120404",
                                            "text": "(Ver o conteúdo circulado.)"
                                        },
                                        {
                                            "id": "684120406",
                                            "text": "(Ver conteúdo marcado com um asterisco)",
                                            "response": [
                                                {
                                                    "id": "684120407",
                                                    "speaker": "Pedaço de Notícia Descartado",
                                                    "text": "\"...O projeto de Hidrovia do Porto Lumidouce foi arquivado novamente! Trabalhadores presos no porto, tratamento desconhecido...\"",
                                                    "choices": [
                                                        {
                                                            "id": "684120404",
                                                            "text": "(Ver o conteúdo circulado.)"
                                                        },
                                                        {
                                                            "id": "684120406",
