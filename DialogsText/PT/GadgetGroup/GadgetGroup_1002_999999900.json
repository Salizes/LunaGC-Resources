        },
        {
            "talkId": "6890206",
            "initDialog": "689020601",
            "dialogues": [
                {
                    "id": "689020601",
                    "speaker": "Player",
                    "text": "Conte-me sobre você..."
                },
                {
                    "id": "689020602",
                    "speaker": "Tubby",
                    "text": "O Paraíso Mágico sempre está claro e brilhante. Não tem nada a ver com o tempo do mundo real lá fora, é só porque eu gosto de ter o sol me iluminando."
                },
                {
                    "id": "689020603",
                    "speaker": "Tubby",
                    "text": "Os raios de sol depois do almoço são quentes, me dão uma boa sensação."
                }
            ]
        },
        {
            "talkId": "6890207",
            "initDialog": "689010701",
            "dialogues": [
                {
                    "id": "689010701",
