                {
                    "id": "680160101",
                    "speaker": "Opere o dispositivo",
                    "text": "Diga o código secreto, e a passagem será revelada.",
                    "choices": [
                        {
                            "id": "680160102",
                            "text": "...?",
                            "response": [
                                {
                                    "id": "680160103",
                                    "speaker": "Paimon",
                                    "text": "Hm, nenhuma resposta... Parece que temos que descobrir qual o código secreto para podermos entrar. Bem... não pode ser as palavras que estão na porta, sem dúvida."
                                },
                                {
                                    "id": "680160107",
                                    "speaker": "Paimon",
                                    "text": "Não gostaria de espionar os Eremitas próximos? Pode haver algumas pistas."
                                }
                            ]
                        },
                        {
                            "id": "680160104",
                            "text": "Código secreto.",
                            "response": [
                                {
                                    "id": "680160105",
                                    "speaker": "Paimon",
                                    "text": "Ei...! Ninguém usaria um código tão simples! Não tem como as palavras escritas nesta porta serem o código!"
                                },
                                {
                                    "id": "680160106",
                                    "speaker": "Paimon",
                                    "text": "Sim, nenhuma resposta. Parece que temos que descobrir qual é o código secreto para podermos entrar."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
