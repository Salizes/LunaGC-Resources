            "dialogues": [
                {
                    "id": "689050101",
                    "speaker": "Chubby",
                    "text": "Por isso eu, Buscador de Riquezas, viajei por todos os cantos da terra, procurando por seus tesouros..."
                }
            ]
        },
        {
            "talkId": "6890502",
            "initDialog": "689050201",
            "dialogues": [
                {
                    "id": "689050201",
                    "speaker": "Player",
                    "text": "Você vende tudo isso aqui?"
                },
                {
                    "id": "689050202",
                    "speaker": "Chubby",
                    "text": "Ah, encontros com belos tesouros não podem ser forçados. Isso é algo que só o destino pode ditar."
                }
            ]
        },
        {
            "talkId": "6890503",
            "initDialog": "689050301",
            "dialogues": [
                {
                    "id": "689050301",
                    "speaker": "Player",
                    "text": "Adeus."
                },
                {
                    "id": "689050302",
                    "speaker": "Chubby",
                    "text": "É ótimo conseguir o que se quer. Caso não consiga, não precisa ficar decepcionado, apenas deixe para lá."
                }
            ]
        },
        {
            "talkId": "6890511",
            "initDialog": "689051101",
            "dialogues": [
                {
                    "id": "689051101",
                    "speaker": "Observar",
                    "text": "(Parece que esse também é um Espírito do Bule...)"
                }
            ]
        }
    ]
