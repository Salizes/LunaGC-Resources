        {
            "talkId": "7403508",
            "initDialog": "740350801",
            "dialogues": [
                {
                    "id": "740350801",
                    "speaker": "Iaune",
                    "text": "Ótimo! Agora eu posso finalmente continuar trabalhando. Esta proposta deve ser concluída hoje!"
                },
                {
                    "id": "740350802",
                    "speaker": "Iaune",
                    "text": "Muito obrigado. Quando eu tiver tempo, certamente pagarei uma refeição excelente para vocês!"
                },
                {
                    "id": "740350807",
                    "speaker": "Iaune",
                    "text": "Você está livre amanhã? Se sim, venha aqui."
                },
                {
                    "id": "740350808",
                    "speaker": "Iaune",
                    "text": "Quando eu terminar meu trabalho, podemos sair para comer!",
                    "choices": [
                        {
                            "id": "740350803",
                            "text": "Vou ficar no aguardo.",
                            "response": [
                                {
                                    "id": "740350805",
                                    "speaker": "Iaune",
                                    "text": "Você tem razão, devo trabalhar mais rapidamente..."
                                },
                                {
                                    "id": "740350806",
                                    "speaker": "Iaune",
                                    "text": "Espere, qual é a próxima frase? Eu deveria ter escrito tudo..."
                                }
                            ]
                        },
                        {
                            "id": "740350804",
                            "text": "Termine seu trabalho primeiro."
                        }
                    ]
                }
            ]
        }
    ]
}