{
    "talkId": "7154017",
    "total_dialogue_lines": 20,
    "speaker_counts": {
        "Baizhu": 12,
        "Changsheng": 2,
        "Player": 6
    },
    "dialogues": [
        {
            "id": "715401701",
            "speaker": "Baizhu",
            "text": "Esse remédio está preparado... Vou pedir para o Herborista Gui entregar em breve.",
            "choices": [
                {
                    "id": "715401702",
                    "text": "Baizhu, esse envelope de presente é para você.",
                    "response": [
                        {
                            "id": "715401703",
                            "speaker": "Baizhu",
                            "text": "Quanta consideração sua, obrigado. Como tem se sentido nesses últimos dias?",
                            "choices": [
                                {
                                    "id": "715401704",
                                    "text": "De boa total, graças às suas habilidades milagrosas.",
                                    "response": [
                                        {
                                            "id": "715401705",
                                            "speaker": "Baizhu",
                                            "text": "Não havia nada milagroso naquilo — tratamento médico simples, nada mais."
                                        },
                                        {
                                            "id": "715401708",
                                            "speaker": "Baizhu",
                                            "text": "#Sua constituição é muito forte. Você estava cobert{M#o}{F#a} de um fedor terrível, mas seu sistema cardiovascular permaneceu ileso."
                                        },
                                        {
                                            "id": "715401709",
                                            "speaker": "Baizhu",
                                            "text": "O milagre de verdade é o fato que você saiu da situação sem danos duradouros... *cof* *cof*",
                                            "choices": [
                                                {
                                                    "id": "715401710",
                                                    "text": "Você está bem? Beba um pouco de água.",
                                                    "response": [
                                                        {
                                                            "id": "715401712",
                                                            "speaker": "Baizhu",
                                                            "text": "*Cof*... *cof*... Não se preocupe, é só cansaço — eu fiquei acordado a noite toda escrevendo receitas."
                                                        },
                                                        {
                                                            "id": "715401713",
                                                            "speaker": "Changsheng",
                                                            "text": "*Suspiro* Que é exatamente por isso que você precisa dar uma pausa. Relaxe, ou seu corpo vai pagar o preço."
                                                        },
                                                        {
                                                            "id": "715401714",
                                                            "speaker": "Baizhu",
                                                            "text": "Hehe, não precisa se preocupar. Eu sei o que estou fazendo."
                                                        },
                                                        {
                                                            "id": "715401715",
                                                            "speaker": "Baizhu",
                                                            "text": "Venha me encontrar se começar a se sentir mal. Posso te dar um remédio."
                                                        },
                                                        {
                                                            "id": "715401716",
                                                            "speaker": "Baizhu",
                                                            "text": "Nunca esqueça — até sintomas pequenos podem ser importantes sinais de aviso."
                                                        },
                                                        {
                                                            "id": "715401717",
                                                            "speaker": "Changsheng",
                                                            "text": "Que tal seguir o próprio conselho? Ficando acordado a noite toda — você precisa de um remédio só para você."
                                                        },
                                                        {
                                                            "id": "715401718",
                                                            "speaker": "Baizhu",
                                                            "text": "Está tudo bem, Changsheng. Eu sei o que estou fazendo."
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "715401711",
                                                    "text": "Você usou a arte secreta de Changsheng de novo?"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "715401706",
                                    "text": "Eu tô muito bem!",
                                    "response": [
                                        {
                                            "id": "715401707",
                                            "speaker": "Baizhu",
                                            "text": "Que bom ouvir isso. Textos médicos padrões oferecem poucas informações sobre o tratamento de fedor. Eu tive que recorrer a métodos comuns."
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "715401719",
                    "text": "Te vejo por aí.",
                    "response": [
                        {
                            "id": "715401720",
                            "speaker": "Baizhu",
                            "text": "Cuide-se! Agora que a crise acabou, você deveria descansar e aproveitar as festividades."
                        }
                    ]
                }
            ]
        }
    ]
}