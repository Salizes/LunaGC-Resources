                                },
                                {
                                    "id": "700530113",
                                    "text": "Estou em uma missão para te encontrar — e aproveitar pra tirar umas fotos também.",
                                    "response": [
                                        {
                                            "id": "700530114",
                                            "speaker": "Yoimiya",
                                            "text": "Awn, sério? Você tá me fazendo corar! Bom, então não vou te enrolar — vamos tirar essa foto!"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "700530109",
                    "text": "Algo assim.",
                    "response": [
                        {
                            "id": "700530110",
                            "speaker": "Yoimiya",
                            "text": "#Olha só, que mistério! Vai, conta tudo — o que trouxe o grande {NICKNAME} pra um lugar como esse?",
                            "choices": [
                                {
                                    "id": "700530111",
