{
    "talkId": "7115301",
    "total_dialogue_lines": 19,
    "speaker_counts": {
        "Player": 10,
        "Sigewinne": 9
    },
    "dialogues": [
        {
            "id": "711530102",
            "speaker": "Sigewinne",
            "text": "#Boas festas, {NICKNAME}!"
        },
        {
            "id": "711530103",
            "speaker": "Sigewinne",
            "text": "O Duque mencionou que talvez nos encontrássemos aqui, mas não imaginei que nossos caminhos se cruzariam tão cedo.",
            "choices": [
                {
                    "id": "711530101",
                    "text": "Também soltei minha Lanterna Celeste.",
                    "response": [
                        {
                            "id": "711530104",
                            "speaker": "Sigewinne",
                            "text": "É tão encantador! Uma vez tratei um paciente na Fortaleza que dizia querer soltar uma Lanterna Celeste ele mesmo."
                        },
                        {
                            "id": "711530105",
                            "speaker": "Sigewinne",
                            "text": "Já que estou aqui... acho que vou soltar uma em nome dele e deixar seu desejo voar."
                        },
                        {
                            "id": "711530106",
                            "speaker": "Player",
                            "text": "Você veio com o Wriothesley, Sigewinne?"
                        },
                        {
                            "id": "711530119",
                            "speaker": "Sigewinne",
                            "text": "Isso mesmo! Ele me convidou para vivenciar o Ritual de Lanternas em Liyue com ele e também... para finalmente usar todos os dias de folga que eu nunca cheguei a tirar."
                        },
                        {
                            "id": "711530120",
                            "speaker": "Sigewinne",
                            "text": "Conhecemos uma senhora muito gentil no porto que disse que, se quiséssemos, ela poderia providenciar um fotógrafo profissional para tirar nossa foto como lembrança!",
                            "choices": [
                                {
                                    "id": "711530107",
                                    "text": "Quanto a isso...",
                                    "response": [
                                        {
                                            "id": "711530109",
                                            "speaker": "Sigewinne",
                                            "text": "Ah, perfeito! Tenho certeza de que você vai tirar uma foto incrível, e assim poderei mostrá-la ao Monsieur Neuvillette depois!",
                                            "choices": [
                                                {
                                                    "id": "711530110",
                                                    "text": "Vamos começar, então?",
                                                    "response": [
                                                        {
                                                            "id": "711530111",
                                                            "speaker": "Sigewinne",
                                                            "text": "#Claro! Bem, sendo você {M#o}{F#a} \"fotógraf{M#o}{F#a} profissional\", que pose recomendaria?",
                                                            "choices": [
                                                                {
                                                                    "id": "711530114",
                                                                    "text": "Algo mais sério.",
                                                                    "response": [
                                                                        {
                                                                            "id": "711530116",
                                                                            "speaker": "Player",
                                                                            "text": "Essa pose está boa."
                                                                        }
                                                                    ]
                                                                },
                                                                {
                                                                    "id": "711530115",
                                                                    "text": "Uma pose mais relaxada."
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "711530112",
                                                    "text": "Espere um pouco...",
                                                    "response": [
                                                        {
                                                            "id": "711530113",
                                                            "speaker": "Sigewinne",
                                                            "text": "#Ah, surgiu algum compromisso? Sem problema, vou dar uma volta aqui por perto. Venha me encontrar quando estiver pront{M#o}{F#a}!"
                                                        }
                                                    ]
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "711530108",
                                    "text": "#Eu sou {M#o}{F#a} tal \"fotógraf{M#o}{F#a} profissional\"."
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "711530106",
                    "text": "Você veio com o Wriothesley, Sigewinne?"
                }
            ]
        }
    ]
}