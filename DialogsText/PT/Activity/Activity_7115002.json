    "dialogues": [
        {
            "id": "711500201",
            "speaker": "Varesa",
            "text": "Liyue tem tanta comida gostosa! O que eu como agora... Ah, que tal peixe cozido?"
        },
        {
            "id": "711500202",
            "speaker": "Varesa",
            "text": "Não, espera... Primeiro eu preciso tirar uma foto para o pessoal lá na tribo...",
            "choices": [
                {
                    "id": "711500203",
                    "text": "Sobre a Lanterna Celeste que eu soltei...",
                    "response": [
                        {
                            "id": "711500204",
                            "speaker": "Varesa",
                            "text": "#Uau... ela foi parar lá no alto! Ei, {NICKNAME}, tem um limite de quantas Lanternas Celestes a gente pode soltar? Eu quero lançar uma para todo mundo lá na tribo!"
                        },
                        {
                            "id": "711500205",
                            "speaker": "Varesa",
                            "text": "Eu anotei todos os desejos deles no meu caderninho, e não acaba mais, hehe... Então vamos precisar de uma montanha de lanternas."
                        },
                        {
                            "id": "711500206",
                            "speaker": "Player",
                            "text": "Varesa? Quer uma foto de lembrança?"
                        },
                        {
                            "id": "711500207",
                            "speaker": "Varesa",
                            "text": "#{NICKNAME}? Uau, então você é o fotógrafo profissional de quem aquela moça estava falando?"
                        },
                        {
                            "id": "711500208",
                            "speaker": "Player",
                            "text": "#Eu mesm{M#o}{F#a}."
                        },
                        {
                            "id": "711500209",
                            "speaker": "Varesa",
                            "text": "Hehe, que fantástico! Você tem tanto talento que é claro que também sabe usar o Aparelho Fotográfico!",
                            "choices": [
                                {
                                    "id": "711500210",
                                    "text": "Então, vamos começar?",
                                    "response": [
                                        {
                                            "id": "711500211",
                                            "speaker": "Varesa",
                                            "text": "Claro! Eu quero fazer uma pose bem estilosa... mas e se ficar esquisita na foto...?"
                                        },
                                        {
                                            "id": "711500212",
                                            "speaker": "Varesa",
                                            "text": "#Alguma dica, {NICKNAME}?",
                                            "choices": [
                                                {
                                                    "id": "711500213",
                                                    "text": "Capricha na pose!",
                                                    "response": [
                                                        {
                                                            "id": "711500215",
                                                            "speaker": "Player",
                                                            "text": "Essa pose está boa."
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "711500214",
                                                    "text": "Uma pose mais descontraída."
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "711500216",
                                    "text": "Espera um pouco...",
                                    "response": [
                                        {
                                            "id": "711500217",
                                            "speaker": "Varesa",
                                            "text": "Você tem alguma coisa para fazer? Tudo bem, vou comer alguma coisinha primeiro... hehe..."
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "711500206",
                    "text": "Varesa? Quer uma foto de lembrança?"
                }
            ]
        }
    ]
