    "dialogues": [
        {
            "id": "711550301",
            "speaker": "Yumemizuki Mizuki",
            "text": "#{NICKNAME}? Que agradável surpresa. Feliz Ritual de Lanternas",
            "choices": [
                {
                    "id": "711550302",
                    "text": "Também soltei minha Lanterna Celeste.",
                    "response": [
                        {
                            "id": "711550304",
                            "speaker": "Yumemizuki Mizuki",
                            "text": "Eu vi, e que lanterna bonita era aquela. Dei uma ajudinha agora há pouco, então ela deve subir ainda mais alto."
                        },
                        {
                            "id": "711550314",
                            "speaker": "Yumemizuki Mizuki",
                            "text": "Hehe... Como dizem em Liyue, desejos escritos em lanternas certamente se tornam realidade."
                        },
                        {
                            "id": "711550303",
                            "speaker": "Player",
                            "text": "Sobre a foto de lembrança..."
                        },
                        {
                            "id": "711550315",
                            "speaker": "Yumemizuki Mizuki",
                            "text": "#Ah... Eu pedi à Srta. Pingxi que ajudasse a organizar uma sessão de fotos comemorativa. Então você deve ser {M#o}{F#a} fotógraf{M#o}{F#a} de quem ela falou."
                        },
                        {
                            "id": "711550316",
                            "speaker": "Yumemizuki Mizuki",
                            "text": "Maravilhoso! Parece que vou levar algumas fotos encantadoras deste Ritual de Lanternas.",
                            "choices": [
                                {
                                    "id": "711550305",
                                    "text": "Então, vamos começar a sessão de fotos.",
                                    "response": [
                                        {
                                            "id": "711550306",
                                            "speaker": "Yumemizuki Mizuki",
                                            "text": "#Muito bem, então, Mestre Fotógraf{M#o}{F#a}, que tipo de pose acha que ficaria mais fotogênica?",
                                            "choices": [
                                                {
                                                    "id": "711550309",
                                                    "text": "Uma pose mais relaxada.",
                                                    "response": [
                                                        {
                                                            "id": "711550311",
                                                            "speaker": "Player",
                                                            "text": "Vamos tentar a segunda pose...",
                                                            "choices": [
                                                                {
                                                                    "id": "711550313",
                                                                    "text": "Vamos tentar a primeira pose..."
                                                                },
                                                                {
                                                                    "id": "711550312",
                                                                    "text": "Essa pose está boa."
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "711550310",
                                                    "text": "Uma pose mais séria."
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "711550307",
                                    "text": "Espere um pouco...",
                                    "response": [
                                        {
                                            "id": "711550308",
                                            "speaker": "Yumemizuki Mizuki",
                                            "text": "Você tem algo para resolver? Sem problema algum, podemos discutir os detalhes quando estiver livre."
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "711550303",
                    "text": "Sobre a foto de lembrança..."
                }
            ]
        }
    ]
}