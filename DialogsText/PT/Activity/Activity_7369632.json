{
    "talkId": "7369632",
    "total_dialogue_lines": 20,
    "speaker_counts": {
        "Bahar": 4,
        "Player": 16
    },
    "dialogues": [
        {
            "id": "736963201",
            "speaker": "Bahar",
            "text": "Por que o seu orientador estava bravo?",
            "choices": [
                {
                    "id": "736963202",
                    "text": "Porque ele não conseguiu obter a carta.",
                    "response": [
                        {
                            "id": "736963206",
                            "speaker": "Bahar",
                            "text": "Quem foi a última pessoa a ter contato com a carta?",
                            "choices": [
                                {
                                    "id": "736963207",
                                    "text": "O contato foi entre os Ladrões de Tesouro e a Academia.",
                                    "response": [
                                        {
                                            "id": "736963211",
                                            "speaker": "Bahar",
                                            "text": "Onde a carta está agora?",
                                            "choices": [
                                                {
                                                    "id": "736963212",
                                                    "text": "No escritório do orientador.",
                                                    "response": [
                                                        {
                                                            "id": "736963216",
                                                            "speaker": "Bahar",
                                                            "text": "O que havia na carta, então?",
                                                            "choices": [
                                                                {
                                                                    "id": "736963217",
                                                                    "text": "Uma poção alquímica."
                                                                },
                                                                {
                                                                    "id": "736963218",
                                                                    "text": "As chaves do escritório."
                                                                },
                                                                {
                                                                    "id": "736963219",
                                                                    "text": "Correspondência dos Ladrões de Tesouro."
                                                                },
                                                                {
                                                                    "id": "736963220",
                                                                    "text": "Uma conta."
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "736963213",
                                                    "text": "Está escondida."
                                                },
                                                {
                                                    "id": "736963214",
                                                    "text": "Nas mãos do Matra."
                                                },
                                                {
                                                    "id": "736963215",
                                                    "text": "Já foi destruída."
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "736963208",
                                    "text": "O membro do Darshan que era responsável por entregar a carta."
                                },
                                {
                                    "id": "736963209",
                                    "text": "O Matra."
                                },
                                {
                                    "id": "736963210",
                                    "text": "Bahera."
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "736963203",
                    "text": "O conteúdo da carta havia sido arruinado."
                },
                {
                    "id": "736963204",
                    "text": "Os seus planos estavam prestes a serem expostos."
                },
                {
                    "id": "736963205",
                    "text": "Bahera estava trabalhando com os Ladrões de Tesouro."
                }
            ]
        }
    ]
}