    "dialogues": [
        {
            "id": "735080701",
            "speaker": "Paimon",
            "text": "Cabeça de Bongô, Pyroalegria, Ioiozinho, Blitzor! Vocês estão todos aqui!",
            "choices": [
                {
                    "id": "735080702",
                    "text": "O grupinho realmente está todo aqui!",
                    "response": [
                        {
                            "id": "735080703",
                            "speaker": "Paimon",
                            "text": "Lembrem-se de ouvir a Haniyyah, ouviram? Comam na hora certa, durmam direitinho, treinem bastante e vivam vidas felizes!"
                        },
                        {
                            "id": "735080704",
                            "speaker": "Cabeça de Bongô",
                            "text": "♪~"
                        },
                        {
                            "id": "735080705",
                            "speaker": "Pyro-1",
                            "text": "♫~"
                        },
                        {
                            "id": "735080706",
                            "speaker": "Ioiozinho",
                            "text": "♩~"
                        },
                        {
                            "id": "735080707",
                            "speaker": "Blitzor",
                            "text": "♬~"
                        },
                        {
                            "id": "735080708",
                            "speaker": "Paimon",
                            "text": "Hehehehe, isso é ótimo. Teremos vários presentinhos para vocês da próxima vez que nos encontrarmos!",
                            "choices": [
                                {
                                    "id": "735080709",
                                    "text": "Contemplem, Paimon, grande mestre da língua dos cogumelos!",
                                    "response": [
                                        {
                                            "id": "735080711",
                                            "speaker": "Paimon",
                                            "text": "Hehe, para ser sincera, Paimon também não faz ideia do que estão falando, mas eles parecem felizes e escutam Paimon!"
                                        },
                                        {
                                            "id": "735080712",
                                            "speaker": "Paimon",
                                            "text": "Hehe, Paimon já até sabe o que deveria trazer para eles..."
                                        },
                                        {
                                            "id": "735080713",
                                            "speaker": "Paimon",
                                            "text": "Pegaremos um chapéu redondinho para o Cabeça de Bongô. Ficará bonitinho e também protegerá sua cabeça molinha."
                                        },
                                        {
                                            "id": "735080714",
                                            "speaker": "Paimon",
                                            "text": "Ele pode ficar usando esse chapéu, e quando não estiver, Paimon cuidará dele."
                                        },
                                        {
                                            "id": "735080715",
                                            "speaker": "Paimon",
                                            "text": "Dessa forma, o Cabeça de Bongô nunca ficará sem seu bongô e ficará mais estiloso do que nunca."
                                        },
                                        {
                                            "id": "735080716",
                                            "speaker": "Cabeça de Bongô",
                                            "text": "♪~",
                                            "choices": [
                                                {
                                                    "id": "735080717",
                                                    "text": "O Cabeça de Bongô é um Cogumelo Hydro...",
                                                    "response": [
                                                        {
                                                            "id": "735080719",
                                                            "speaker": "Paimon",
                                                            "text": "Uh, hmm... Acho que podemos conseguir um chapéu a prova d'água! Sabe, talvez consigamos um que seja feito de Lótus Nilotpala ou algo assim. Dessa forma, as gotículas de água vão apenas escorrer para fora!"
                                                        },
                                                        {
                                                            "id": "735080720",
                                                            "speaker": "Paimon",
                                                            "text": "Vai ser um pouco mais caro, mas eh, tudo bem — você pode tirar da mesada da Paimon!"
                                                        },
                                                        {
                                                            "id": "735080721",
                                                            "speaker": "Paimon",
                                                            "text": "O Ioiozinho é o próximo. Podemos conseguir uma bolsinha para ele guardar Geleias Maravilhosas. Dessa forma, ele pode simplesmente pegar algumas quando estiver com fome."
                                                        },
                                                        {
                                                            "id": "735080722",
                                                            "speaker": "Paimon",
                                                            "text": "O Ioiozinho é todo flutuante, pode usar Anemo e é muito forte também — carregar coisas para os outros Cogumelos não deve ser problema para ele!"
                                                        },
                                                        {
                                                            "id": "735080723",
                                                            "speaker": "Paimon",
                                                            "text": "Ele consegue carregar sua própria mala, afinal de contas."
                                                        },
                                                        {
                                                            "id": "735080724",
                                                            "speaker": "Player",
                                                            "text": "Ioiozinho é bem forte."
                                                        },
                                                        {
                                                            "id": "735080725",
                                                            "speaker": "Ioiozinho",
                                                            "text": "♩~"
                                                        },
                                                        {
                                                            "id": "735080726",
                                                            "speaker": "Paimon",
                                                            "text": "Hehe! Parece que o Ioiozinho adorou a ideia!"
                                                        },
                                                        {
                                                            "id": "735080727",
                                                            "speaker": "Paimon",
                                                            "text": "O Pyroalegria é o próximo. Precisamos escolher uma máscara de dormir bem justa para ele, que não caia, não importa o quanto ele se mova..."
                                                        },
                                                        {
                                                            "id": "735080728",
                                                            "speaker": "Paimon",
                                                            "text": "Certo, também precisamos de uma oportunidade da Haniyyah tirar as medidas dele.",
                                                            "choices": [
                                                                {
                                                                    "id": "735080729",
                                                                    "text": "E por qual motivo mesmo?",
                                                                    "response": [
                                                                        {
                                                                            "id": "735080731",
                                                                            "speaker": "Paimon",
                                                                            "text": "Qual é, o Pyroalegria é um Cogumelo Pyro! Pense bem nisso. Cogumelos Pyro são super brilhantes!"
                                                                        },
                                                                        {
                                                                            "id": "735080732",
                                                                            "speaker": "Paimon",
                                                                            "text": "Você não acha que o Pyroalegria pode acabar acordando com sua própria luz o tempo todo? Isso parece que seria bem desconfortável!",
                                                                            "choices": [
                                                                                {
                                                                                    "id": "735080733",
                                                                                    "text": "Bem, você vê o Pyroalegria com olheiras, por acaso?",
                                                                                    "response": [
                                                                                        {
                                                                                            "id": "735080735",
                                                                                            "speaker": "Paimon",
                                                                                            "text": "Talvez devêssemos apenas perguntar diretamente para ele!"
                                                                                        },
                                                                                        {
                                                                                            "id": "735080736",
                                                                                            "speaker": "Paimon",
                                                                                            "text": "Pyroalegria, você costuma dormir bem?"
                                                                                        },
                                                                                        {
                                                                                            "id": "735080737",
                                                                                            "speaker": "Pyro-1",
                                                                                            "text": "♫~"
                                                                                        },
                                                                                        {
                                                                                            "id": "735080738",
                                                                                            "speaker": "Paimon",
                                                                                            "text": "Parece que ele está dizendo... \"muito bem\"... Então ele não tem esse tipo de problema, hã."
                                                                                        },
                                                                                        {
                                                                                            "id": "735080739",
                                                                                            "speaker": "Paimon",
                                                                                            "text": "Vamos pensar um pouco melhor nisso. Paimon tem certeza de que vai chegar em algo que o Pyroalegria vai amar!"
                                                                                        },
                                                                                        {
                                                                                            "id": "735080740",
                                                                                            "speaker": "Paimon",
                                                                                            "text": "Em seguida, vamos falar do presente do Blitzor. Paimon acha que deveria ser um quadro de desenho que você possa deixar os rastros usando Electro."
                                                                                        },
                                                                                        {
                                                                                            "id": "735080741",
                                                                                            "speaker": "Paimon",
                                                                                            "text": "O Blitzor é bem ativo e ágil, então ele deve gostar bastante de desenhar!"
                                                                                        },
                                                                                        {
                                                                                            "id": "735080742",
                                                                                            "speaker": "Paimon",
                                                                                            "text": "E ele também pode se exercitar ao mesmo tempo — dois coelhos com uma cajadada!"
                                                                                        },
                                                                                        {
                                                                                            "id": "735080743",
                                                                                            "speaker": "Blitzor",
                                                                                            "text": "♬~",
                                                                                            "choices": [
                                                                                                {
                                                                                                    "id": "735080744",
                                                                                                    "text": "Esse quadro vai precisar ser daqueles que dá para apagar.",
                                                                                                    "response": [
                                                                                                        {
                                                                                                            "id": "735080746",
                                                                                                            "speaker": "Paimon",
                                                                                                            "text": "Isso é verdade! Vamos pensar um pouco mais em como fazer isso primeiro antes de pedir para alguém fazer."
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "735080747",
                                                                                                            "speaker": "Paimon",
                                                                                                            "text": "Também precisamos pensar quem seria capaz de fazer algo assim...",
                                                                                                            "choices": [
                                                                                                                {
                                                                                                                    "id": "735080748",
                                                                                                                    "text": "Hmm, mas, sabe, você já revelou o conteúdo dos presentes...",
                                                                                                                    "response": [
                                                                                                                        {
                                                                                                                            "id": "735080750",
                                                                                                                            "speaker": "Paimon",
                                                                                                                            "text": "Hehe, está tudo bem! Paimon disse que pensaríamos em \"vários\" presentes, então vão ser muitos!"
                                                                                                                        },
                                                                                                                        {
                                                                                                                            "id": "735080751",
                                                                                                                            "speaker": "Paimon",
                                                                                                                            "text": "Podemos tomar o nosso tempo e pensar direitinho ao escolher. Não estamos restritos a números, no fim das contas."
                                                                                                                        },
                                                                                                                        {
                                                                                                                            "id": "735080752",
                                                                                                                            "speaker": "Paimon",
                                                                                                                            "text": "Nosso objetivo é garantir que nossos cogumigos se divirtam muito com os presentes!",
                                                                                                                            "choices": [
                                                                                                                                {
                                                                                                                                    "id": "735080753",
                                                                                                                                    "text": "Então, será uma pilha de presentes!",
                                                                                                                                    "response": [
                                                                                                                                        {
                                                                                                                                            "id": "735080755",
                                                                                                                                            "speaker": "Paimon",
                                                                                                                                            "text": "Muito bem, acho que devemos ir andando também. Vamos pegar quantas comissões pudermos, para guardar Mora o suficiente para comprar todos os presentes."
                                                                                                                                        },
                                                                                                                                        {
                                                                                                                                            "id": "735080756",
                                                                                                                                            "speaker": "Paimon",
                                                                                                                                            "text": "Muito bem, Cabeça de Bongô, Pyroalegria, Ioiozinho, Blitzor. Veremos vocês logo, então sejam pacientes, tudo bem?"
                                                                                                                                        }
                                                                                                                                    ]
                                                                                                                                },
                                                                                                                                {
                                                                                                                                    "id": "735080754",
                                                                                                                                    "text": "Realmente muita diversão!"
                                                                                                                                }
                                                                                                                            ]
                                                                                                                        }
                                                                                                                    ]
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "735080749",
                                                                                                                    "text": "A essa altura, você já não estragou a surpresa?"
                                                                                                                }
                                                                                                            ]
                                                                                                        }
                                                                                                    ]
                                                                                                },
                                                                                                {
                                                                                                    "id": "735080745",
                                                                                                    "text": "Senão o desenho pode acabar uma bagunça."
                                                                                                }
                                                                                            ]
                                                                                        }
                                                                                    ]
                                                                                },
                                                                                {
                                                                                    "id": "735080734",
                                                                                    "text": "Hmm... Sabe, quando você fala dessa forma, parece que quem realmente precisa da máscara é a Haniyyah."
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                },
                                                                {
                                                                    "id": "735080730",
                                                                    "text": "Espera, eu não entendi o motivo desse presente."
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "735080718",
                                                    "text": "Você não quis dizer que vai ficar mais molhado do que nunca?"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "735080710",
                                    "text": "Seja minha tutora, ó grande mestre!"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "735080757",
                    "text": "Voltaremos para brincar com eles logo.",
                    "response": [
                        {
                            "id": "735080758",
                            "speaker": "Paimon",
                            "text": "Hmm, parece que Haniyyah e Souka estão se preparando para ir embora logo. Vamos aproveitar o tempo restante e ver todo mundo!"
                        }
                    ]
                }
            ]
        }
    ]
}