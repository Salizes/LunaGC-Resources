    "dialogues": [
        {
            "id": "711500301",
            "speaker": "Varesa",
            "text": "Você voltou? Acabei de comer, vamos tirar aquelas fotos!",
            "choices": [
                {
                    "id": "711500302",
                    "text": "Sobre a Lanterna Celeste que eu soltei...",
                    "response": [
                        {
                            "id": "711500303",
                            "speaker": "Varesa",
                            "text": "#Uau... ela está lá no alto! Ei, {NICKNAME}, existe um limite de quantas Lanternas Celestes podemos soltar? Eu quero soltar uma para todo mundo da tribo!"
                        },
                        {
                            "id": "711500304",
                            "speaker": "Varesa",
                            "text": "Eu anotei todos os desejos deles no meu caderninho, e não acaba mais, hehe... Então vamos precisar de uma montanha de lanternas.",
                            "choices": [
                                {
                                    "id": "711500305",
                                    "text": "Então, vamos começar?",
                                    "response": [
                                        {
                                            "id": "711500306",
                                            "speaker": "Varesa",
                                            "text": "Claro! Eu quero fazer uma pose bem estilosa... mas e se ficar esquisita na foto...?"
                                        },
                                        {
                                            "id": "711500307",
                                            "speaker": "Varesa",
                                            "text": "#Alguma dica, {NICKNAME}?",
                                            "choices": [
                                                {
                                                    "id": "711500310",
                                                    "text": "Capricha na pose!",
                                                    "response": [
                                                        {
                                                            "id": "711500312",
                                                            "speaker": "Player",
                                                            "text": "Essa pose está boa."
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "711500311",
                                                    "text": "Uma pose mais descontraída."
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "711500308",
                                    "text": "Espera um pouco...",
                                    "response": [
                                        {
                                            "id": "711500309",
                                            "speaker": "Varesa",
                                            "text": "Você tem alguma coisa para fazer? Tudo bem, vou comer alguma coisinha primeiro... hehe..."
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "711500305",
                    "text": "Então, vamos começar?"
                },
                {
                    "id": "711500308",
                    "text": "Espera um pouco..."
                }
            ]
        }
    ]
