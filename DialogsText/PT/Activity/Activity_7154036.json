{
    "talkId": "7154036",
    "total_dialogue_lines": 19,
    "speaker_counts": {
        "Charlotte": 13,
        "Player": 6
    },
    "dialogues": [
        {
            "id": "715403601",
            "speaker": "Charlotte",
            "text": "Estranho... Por que não consigo encontrar nenhuma pista?",
            "choices": [
                {
                    "id": "715403602",
                    "text": "Charlotte, esse envelope de presente é—",
                    "response": [
                        {
                            "id": "715403603",
                            "speaker": "Charlotte",
                            "text": "#Hã? AH! Grande {M#Herói}{F#Heroína} de Liyue! Momento perfeito!"
                        },
                        {
                            "id": "715403604",
                            "speaker": "Charlotte",
                            "text": "Vem, tenho tanto para te perguntar! Não se preocupe — ninguém vai saber...",
                            "choices": [
                                {
                                    "id": "715403605",
                                    "text": "E-Eu só tô aqui para te dar um envelope de presente!",
                                    "response": [
                                        {
                                            "id": "715403607",
                                            "speaker": "Charlotte",
                                            "text": "Ah, obrigada por isso — é lindo. Agora, vamos falar de negócios de verdade."
                                        },
                                        {
                                            "id": "715403608",
                                            "speaker": "Charlotte",
                                            "text": "Você sabe sobre o ritual que a Srta. Tianquan conduziu, certo?"
                                        },
                                        {
                                            "id": "715403609",
                                            "speaker": "Charlotte",
                                            "text": "Eu perguntei por aí e todos disseram ser uma das cerimônias tradicionais daqui. Mas eu também soube que não é realizado há muito tempo."
                                        },
                                        {
                                            "id": "715403610",
                                            "speaker": "Charlotte",
                                            "text": "Sem falar que enquanto o ritual estava começando, eu vi uma revoada se espalhar nas montanhas próximo ao porto e uma luz estranha saindo da floresta...",
                                            "choices": [
                                                {
                                                    "id": "715403611",
                                                    "text": "Como você viu isso?",
                                                    "response": [
                                                        {
                                                            "id": "715403613",
                                                            "speaker": "Charlotte",
                                                            "text": "Ah, é tudo graças ao meu Aparelho Fotográfico. Eu comprei uma lente de ultra-zoom recentemente — foi bem útil ainda agora!"
                                                        },
                                                        {
                                                            "id": "715403614",
                                                            "speaker": "Charlotte",
                                                            "text": "Infelizmente, tava super escuro, então as fotos ficaram borradas demais para conseguir ver alguma coisa..."
                                                        },
                                                        {
                                                            "id": "715403615",
                                                            "speaker": "Charlotte",
                                                            "text": "#É por isso que eu esperava que você pudesse me deixar por dentro, {NICKNAME}. Tem alguma coisa que você pode me dizer? Não precisa ser nesse momento — você pode me escrever uma carta se lembrar de algo..."
                                                        },
                                                        {
                                                            "id": "715403616",
                                                            "speaker": "Charlotte",
                                                            "text": "Aqui, pega isso. Pense nisso como... um adiantamento."
                                                        },
                                                        {
                                                            "id": "715403617",
                                                            "speaker": "Charlotte",
                                                            "text": "Eu te pago um jantar lá em Fontaine também! Que tal?"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "715403612",
                                                    "text": "Você andou até lá?"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "715403606",
                                    "text": "N-Não ria para mim assim!"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "715403618",
                    "text": "Te vejo por aí.",
                    "response": [
                        {
                            "id": "715403619",
                            "speaker": "Charlotte",
                            "text": "Tchau! Vou perguntar mais um pouco por aí..."
                        }
                    ]
                }
            ]
        }
    ]
}