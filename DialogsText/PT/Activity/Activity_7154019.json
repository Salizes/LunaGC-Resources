{
    "talkId": "7154019",
    "total_dialogue_lines": 21,
    "speaker_counts": {
        "Player": 8,
        "Xiao": 13
    },
    "dialogues": [
        {
            "id": "715401901",
            "speaker": "Xiao",
            "text": "Você chegou.",
            "choices": [
                {
                    "id": "715401902",
                    "text": "Xiao, esse envelope de presente é para você.",
                    "response": [
                        {
                            "id": "715401903",
                            "speaker": "Xiao",
                            "text": "...Obrigado."
                        },
                        {
                            "id": "715401904",
                            "speaker": "Xiao",
                            "text": "Sua respiração está estável e seus passos leves — parece que você se recuperou completamente."
                        },
                        {
                            "id": "715401905",
                            "speaker": "Xiao",
                            "text": "Mesmo assim, suas ações foram muito imprudentes. Você deveria refletir sobre sua falta de consideração pela sua segurança...",
                            "choices": [
                                {
                                    "id": "715401906",
                                    "text": "Bem, foi uma emergência...",
                                    "response": [
                                        {
                                            "id": "715401908",
                                            "speaker": "Xiao",
                                            "text": "Eu não estava lá no momento, mas através do Selo de Testemunha, eu pude sentir suas ações."
                                        },
                                        {
                                            "id": "715401909",
                                            "speaker": "Xiao",
                                            "text": "Eu podia perceber que você entrou lá e recebeu a força da explosão em nome da jovem da Funerária de Wangsheng."
                                        },
                                        {
                                            "id": "715401910",
                                            "speaker": "Xiao",
                                            "text": "...",
                                            "choices": [
                                                {
                                                    "id": "715401911",
                                                    "text": "Eu fiquei de boa.",
                                                    "response": [
                                                        {
                                                            "id": "715401913",
                                                            "speaker": "Xiao",
                                                            "text": "Em todo caso, fico feliz que você está bem."
                                                        },
                                                        {
                                                            "id": "715401914",
                                                            "speaker": "Xiao",
                                                            "text": "...Agora posso parar de me preocupar."
                                                        },
                                                        {
                                                            "id": "715401915",
                                                            "speaker": "Xiao",
                                                            "text": "Monstros enlouquecidos pelo fedor ainda podiam atacar, então eu devia patrulhar a área."
                                                        },
                                                        {
                                                            "id": "715401916",
                                                            "speaker": "Xiao",
                                                            "text": "Se você entrar em apuros...",
                                                            "choices": [
                                                                {
                                                                    "id": "715401917",
                                                                    "text": "Chamarei o seu nome.",
                                                                    "response": [
                                                                        {
                                                                            "id": "715401919",
                                                                            "speaker": "Xiao",
                                                                            "text": "Tudo bem, cuide-se."
                                                                        }
                                                                    ]
                                                                },
                                                                {
                                                                    "id": "715401918",
                                                                    "text": "Deixarei a patrulha com você."
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "715401912",
                                                    "text": "O remédio de Baizhu foi bem eficaz."
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "715401907",
                                    "text": "Ah, então você descobriu..."
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "715401920",
                    "text": "Te vejo por aí.",
                    "response": [
                        {
                            "id": "715401921",
                            "speaker": "Xiao",
                            "text": "Cuide-se."
                        }
                    ]
                }
            ]
        }
    ]
}