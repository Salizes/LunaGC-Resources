{
    "talkId": "4019705",
    "total_dialogue_lines": 35,
    "speaker_counts": {
        "Paimon": 9,
        "Player": 10,
        "Sigewinne": 16
    },
    "dialogues": [
        {
            "id": "401970501",
            "speaker": "Sigewinne",
            "text": "#Olá, {NICKNAME} e Paimon!"
        },
        {
            "id": "401970502",
            "speaker": "Paimon",
            "text": "Ei, Sigewinne! Seja bem-vinda ao Mundo Fantástico Chevalmarin Filmes!",
            "choices": [
                {
                    "id": "401970503",
                    "text": "Sigewinne é muito informada.",
                    "response": [
                        {
                            "id": "401970505",
                            "speaker": "Sigewinne",
                            "text": "Os dois! Navia me contou sobre os planos durante o último encontro da Associação de Beleza, e estou ansiosa desde então!"
                        },
                        {
                            "id": "401970506",
                            "speaker": "Sigewinne",
                            "text": "Mas já se tornou tão popular que tá todo mundo falando sobre, até na Fortaleza Meropide! Muitos dos nossos funcionários estão querendo folgar logo para visitarem."
                        },
                        {
                            "id": "401970507",
                            "speaker": "Paimon",
                            "text": "Hehe, um encorajamento desse deixa Paimon ainda mais motivada!",
                            "choices": [
                                {
                                    "id": "401970508",
                                    "text": "Que tipo de filmes você gosta, Sigewinne?",
                                    "response": [
                                        {
                                            "id": "401970510",
                                            "speaker": "Sigewinne",
                                            "text": "Oh, bem... acho que prefiro filmes animados! Sabe, aqueles bem leves e divertidos."
                                        },
                                        {
                                            "id": "401970511",
                                            "speaker": "Sigewinne",
                                            "text": "Por exemplo, há um grupo de criadores que bolou essas histórias mágicas sobre animais fofinhos. Eu assisti todos os seus filmes!"
                                        },
                                        {
                                            "id": "401970512",
                                            "speaker": "Sigewinne",
                                            "text": "E por coincidência, de acordo com nossas novas regulações, presidiários com bom comportamento podem gastar seus Cupons Especiais para assistirem filmes até três vezes por semana."
                                        },
                                        {
                                            "id": "401970513",
                                            "speaker": "Sigewinne",
                                            "text": "Eu costumo cuidar do projetor no meu tempo livre, já que não temos um funcionário específico para isso."
                                        },
                                        {
                                            "id": "401970514",
                                            "speaker": "Sigewinne",
                                            "text": "E foi por isso que decidi exibir filmes como Meu Vizinho Kokoro."
                                        },
                                        {
                                            "id": "401970515",
                                            "speaker": "Sigewinne",
                                            "text": "Também comecei a exibir uma série famosa chamada Dom e Cherry. É super longa, tem centenas de episódios, mas nunca perde a graça.",
                                            "choices": [
                                                {
                                                    "id": "401970516",
                                                    "text": "Um monte de criminosos assistindo filmes sobre animais fofinhos...",
                                                    "response": [
                                                        {
                                                            "id": "401970518",
                                                            "speaker": "Paimon",
                                                            "text": "Mas agora que eles podem assistir filmes, até os que costumavam causar problemas podem melhorar, né?"
                                                        },
                                                        {
                                                            "id": "401970519",
                                                            "speaker": "Paimon",
                                                            "text": "Temos nossa própria área temática de animais, chamamos ela de Mansão Descontraída, mas os clientes chamam de lugar mais relaxante do parque!"
                                                        },
                                                        {
                                                            "id": "401970520",
                                                            "speaker": "Sigewinne",
                                                            "text": "Oh, eu já estive lá! Não estava esperando que fosse tão divertido!"
                                                        },
                                                        {
                                                            "id": "401970521",
                                                            "speaker": "Sigewinne",
                                                            "text": "Há vários tipos de animais vivendo juntos, alguns que eu nunca imaginei, é como se eu tivesse entrado no filme Zoopólis!",
                                                            "choices": [
                                                                {
                                                                    "id": "401970522",
                                                                    "text": "Se você estiver livre, que tal vir todo dia?",
                                                                    "response": [
                                                                        {
                                                                            "id": "401970524",
                                                                            "speaker": "Paimon",
                                                                            "text": "Oh, você quer dizer que poderíamos convidar Sigewinne para ser uma consultora na Mansão Descontraída?"
                                                                        },
                                                                        {
                                                                            "id": "401970525",
                                                                            "speaker": "Paimon",
                                                                            "text": "Agora que você falou, parece uma ótima ideia! Sigewinne é ótima em cuidar das pessoas, e ela é também tão simpática e carinhosa. Cuidar de animais deve ser bem fácil!"
                                                                        },
                                                                        {
                                                                            "id": "401970526",
                                                                            "speaker": "Sigewinne",
                                                                            "text": "Uma... consultora?"
                                                                        },
                                                                        {
                                                                            "id": "401970527",
                                                                            "speaker": "Paimon",
                                                                            "text": "Sim! Tipo alguém que dá conselhos e diz à equipe do parque como fazer melhor seu trabalho!"
                                                                        },
                                                                        {
                                                                            "id": "401970528",
                                                                            "speaker": "Paimon",
                                                                            "text": "Não é muito trabalho, mas é importante. Além disso, você estará mais brincando com os animais!"
                                                                        },
                                                                        {
                                                                            "id": "401970529",
                                                                            "speaker": "Sigewinne",
                                                                            "text": "Isso parece bem divertido! Pode contar comigo!"
                                                                        },
                                                                        {
                                                                            "id": "401970530",
                                                                            "speaker": "Sigewinne",
                                                                            "text": "Bem, por um acaso, as coisas não estão tão movimentadas na Fortaleza no momento. Se eu soubesse mais cedo que você estava recrutando para esta posição, talvez até mesmo eu teria aplicado para essa posição!"
                                                                        },
                                                                        {
                                                                            "id": "401970531",
                                                                            "speaker": "Sigewinne",
                                                                            "text": "Mas, antes de começar, tenho que fazer os preparativos para a equipe médica em minha ausência, pegar emprestado alguns livros relacionados com meus amigos médicos e — por último, mas não menos importante — preparar presentes para os animais!"
                                                                        },
                                                                        {
                                                                            "id": "401970532",
                                                                            "speaker": "Sigewinne",
                                                                            "text": "Se não for muito inconveniente para você, por que não nos encontramos de novo na Estação Marcotte em breve?",
                                                                            "choices": [
                                                                                {
                                                                                    "id": "401970533",
                                                                                    "text": "Inconveniência nenhuma!",
                                                                                    "response": [
                                                                                        {
                                                                                            "id": "401970535",
                                                                                            "speaker": "Paimon",
                                                                                            "text": "Hehe, com Sigewinne a bordo, a Mansão Descontraída será ainda melhor do que antes. Paimon tem a sensação de que nosso faturamento está prestes a disparar!"
                                                                                        }
                                                                                    ]
                                                                                },
                                                                                {
                                                                                    "id": "401970534",
                                                                                    "text": "Então está combinado!"
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                },
                                                                {
                                                                    "id": "401970523",
                                                                    "text": "Quer se divertir e ganhar um pouco de Mora?"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "401970517",
                                                    "text": "É difícil de imaginar isso."
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "401970509",
                                    "text": "#Estou curios{F#a}{M#o}... qual filmes você gosta, Sigewinne?"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "401970504",
                    "text": "Ou será que o parque tá realmente muito famoso?"
                }
            ]
        }
    ]
}