                    "response": [
                        {
                            "id": "401540804",
                            "speaker": "Sucrose",
                            "text": "Eu deveria ter imaginado. Você realmente tem um talento para alquimia."
                        },
                        {
                            "id": "401540805",
                            "speaker": "Sucrose",
                            "text": "Tenho certeza de que esse exame também será bem simples para você."
                        },
                        {
                            "id": "401540809",
                            "speaker": "Sucrose",
                            "text": "#Bem, pront{M#o}{F#a} para começar?",
                            "choices": [
                                {
                                    "id": "401540810",
                                    "text": "Verificar os requisitos do exame..."
                                },
                                {
                                    "id": "401540811",
                                    "text": "Ainda preciso de um pouco mais de tempo...",
                                    "response": [
                                        {
                                            "id": "401540812",
                                            "speaker": "Sucrose",
                                            "text": "Tudo bem! Sem pressa! Leve o tempo que precisar."
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "401540806",
                    "text": "Ainda estamos resolvendo alguns probleminhas...",
                    "response": [
                        {
                            "id": "401540807",
                            "speaker": "Sucrose",
                            "text": "Bem, você só precisa continuar praticando! Você vai pegar o jeito rapidinho."
                        },
                        {
                            "id": "401540808",
                            "speaker": "Sucrose",
