    },
    "dialogues": [
        {
            "id": "400770601",
            "speaker": "Kaedehara Kazuha",
            "text": "O som da natureza é tão relaxante. Não há mais nada para se preocupar...",
            "choices": [
                {
                    "id": "400770602",
                    "text": "Quer conversar?",
                    "response": [
                        {
                            "id": "400770603",
                            "speaker": "Kaedehara Kazuha",
                            "text": "Claro. O que você está pensando?",
                            "choices": [
                                {
                                    "id": "400770606",
                                    "text": "Sobre a bebida...",
                                    "response": [
                                        {
                                            "id": "400770607",
                                            "speaker": "Kaedehara Kazuha",
                                            "text": "Ahem..."
                                        },
                                        {
                                            "id": "400770608",
                                            "speaker": "Kaedehara Kazuha",
                                            "text": "Isso foi alguns dias atrás. Estou surpreso que você ainda lembra."
                                        },
                                        {
                                            "id": "400770609",
                                            "speaker": "Kaedehara Kazuha",
                                            "text": "Bebidas refinadas pertencem à mesma categoria que poesia e elegância. Perder minha compostura na taverna... Foi humilhante."
                                        }
                                    ]
                                },
                                {
                                    "id": "400770610",
                                    "text": "Sobre o seu passado...",
                                    "response": [
                                        {
                                            "id": "400770611",
                                            "speaker": "Kaedehara Kazuha",
                                            "text": "Ah sim, sobre isso... Após esses eventos, creio que tenha me despedido de meu passado."
                                        },
                                        {
                                            "id": "400770612",
                                            "speaker": "Kaedehara Kazuha",
                                            "text": "Não se preocupe, eu estou bem, como já estava antes. Não sinto culpa ou arrependimento."
                                        },
                                        {
                                            "id": "400770613",
                                            "speaker": "Kaedehara Kazuha",
                                            "text": "Aprecio esses giros do destino com todo meu coração."
                                        },
                                        {
                                            "id": "400770614",
                                            "speaker": "Player",
                                            "text": "Kazuha, você é sempre tão positivo..."
                                        },
                                        {
                                            "id": "400770615",
                                            "speaker": "Kaedehara Kazuha",
                                            "text": "Obrigado. Posso ver isso como um elogio?"
                                        },
                                        {
                                            "id": "400770616",
                                            "speaker": "Player",
                                            "text": "Com certeza."
                                        },
                                        {
                                            "id": "400770617",
                                            "speaker": "Kaedehara Kazuha",
                                            "text": "Estou muito feliz de ter um amigo com você."
                                        },
                                        {
                                            "id": "400770618",
                                            "speaker": "Kaedehara Kazuha",
                                            "text": "Bem, vamos voltar nosso foco à paisagem a nossa frente. Vamos observar as luas e ondas antes de partir."
                                        }
                                    ]
                                },
                                {
                                    "id": "400770619",
                                    "text": "Sobre estas férias...",
                                    "response": [
                                        {
                                            "id": "400770620",
                                            "speaker": "Kaedehara Kazuha",
                                            "text": "Apesar dos altos e baixos, foi uma viagem que valeu a pena."
                                        },
                                        {
                                            "id": "400770621",
                                            "speaker": "Kaedehara Kazuha",
                                            "text": "Se Beidou e a capitã me perguntassem sobre nossas experiências, eu diria a eles sobre os esquilos e o espírito do barco... Quanto a histórias sobre meus novos amigos, reservarei elas para mim."
                                        },
                                        {
                                            "id": "400770622",
                                            "speaker": "Player",
                                            "text": "Soa bem para mim."
                                        },
                                        {
                                            "id": "400770623",
                                            "speaker": "Kaedehara Kazuha",
                                            "text": "#O fim de uma jornada é também o início da próxima. Tenho certeza que essa é uma sensação familiar para você, {NICKNAME}."
                                        },
                                        {
                                            "id": "400770624",
                                            "speaker": "Kaedehara Kazuha",
                                            "text": "... Continuemos seguindo em frente. Isso é o mais importante."
                                        },
                                        {
                                            "id": "400770625",
                                            "speaker": "Kaedehara Kazuha",
                                            "text": "Assim como você, também tenho muita esperança no futuro."
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "400770604",
                    "text": "Não lhe incomodarei mais.",
                    "response": [
                        {
                            "id": "400770605",
                            "speaker": "Kaedehara Kazuha",
                            "text": "#Você deve estar cansado{F#a}{M#o} dos últimos dias. Tire um merecido descanso.",
                            "choices": [
                                {
                                    "id": "400770606",
                                    "text": "Sobre a bebida..."
                                },
                                {
                                    "id": "400770610",
                                    "text": "Sobre o seu passado..."
                                },
                                {
                                    "id": "400770619",
                                    "text": "Sobre estas férias..."
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}