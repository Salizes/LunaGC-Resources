{
    "talkId": "7154033",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Black Screen": 1,
        "Player": 4,
        "Tighnari": 11
    },
    "dialogues": [
        {
            "id": "715403301",
            "speaker": "Tighnari",
            "text": "O que eu deveria pegar...?",
            "choices": [
                {
                    "id": "715403302",
                    "text": "Tighnari, esse envelope de presente é para você.",
                    "response": [
                        {
                            "id": "715403303",
                            "speaker": "Tighnari",
                            "text": "#Ah, eu não esperava te ver aqui, {NICKNAME}. Obrigado pelo envelope — é adorável."
                        },
                        {
                            "id": "715403304",
                            "speaker": "Player",
                            "text": "Aproveitando o festival?"
                        },
                        {
                            "id": "715403305",
                            "speaker": "Tighnari",
                            "text": "Cyno e eu nos divertimos muito. Comemos muita comida deliciosa e compramos alguns presentes."
                        },
                        {
                            "id": "715403306",
                            "speaker": "Tighnari",
                            "text": "Infelizmente, o Porto fica um pouco lotado nessa época do ano. Se eu ficar perto da multidão por tempo demais, meus ouvidos começam a doer."
                        },
                        {
                            "id": "715403307",
                            "speaker": "Tighnari",
                            "text": "Então eu vim aqui descansar."
                        },
                        {
                            "id": "715403308",
                            "speaker": "Tighnari",
                            "text": "Cyno disse que precisava ficar um tempo sozinho para pensar em alguma coisa."
                        },
                        {
                            "id": "715403309",
                            "speaker": "Player",
                            "text": "Ele... pensou em outra piada..."
                        },
                        {
                            "id": "715403310",
                            "speaker": "Black Screen",
                            "text": "Você conta a Tighnari tudo sobre a piada de envelope de Cyno..."
                        },
                        {
                            "id": "715403311",
                            "speaker": "Tighnari",
                            "text": "..."
                        },
                        {
                            "id": "715403312",
                            "speaker": "Tighnari",
                            "text": "*Suspiro* Nenhuma surpresa aí..."
                        },
                        {
                            "id": "715403313",
                            "speaker": "Tighnari",
                            "text": "Obrigado pelo aviso, Viajante. Pelo menos posso me preparar mentalmente dessa vez..."
                        },
                        {
                            "id": "715403314",
                            "speaker": "Tighnari",
                            "text": "Obrigado de novo pelo envelope — é muito lindo. Vou cuidar bem dele."
                        }
                    ]
                },
                {
                    "id": "715403315",
                    "text": "Te vejo por aí.",
                    "response": [
                        {
                            "id": "715403316",
                            "speaker": "Tighnari",
                            "text": "Tchau! Vou procurar por Cyno. *Suspiro* Só espero que ele não esteja se sentindo inspirado demais hoje..."
                        }
                    ]
                }
            ]
        }
    ]
}