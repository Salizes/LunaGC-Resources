{
    "talkId": "7350711",
    "total_dialogue_lines": 70,
    "speaker_counts": {
        "Cabeça de Bongô": 9,
        "Paimon": 39,
        "Player": 13,
        "Pyro-1": 9
    },
    "dialogues": [
        {
            "id": "735071101",
            "speaker": "Paimon",
            "text": "Ei, Cabeça de Bongô. Pyroalegria! Estamos aqui para brincar!"
        },
        {
            "id": "735071102",
            "speaker": "Paimon",
            "text": "#O que faremos junto de nossos cogumigos, {NICKNAME}?",
            "choices": [
                {
                    "id": "735071103",
                    "text": "Alimentá-los?",
                    "response": [
                        {
                            "id": "735071104",
                            "speaker": "Paimon",
                            "text": "Claro! Nós nos divertimos tanto da última vez que não percebemos os muitos sabores de Geleia Maravilhosa disponíveis. Vamos prestar um pouco mais de atenção aos que os Cogumelos preferem, está bem?",
                            "choices": [
                                {
                                    "id": "735071105",
                                    "text": "Usar as geleias sabor Valberry.",
                                    "response": [
                                        {
                                            "id": "735071106",
                                            "speaker": "Cabeça de Bongô",
                                            "text": "♪~"
                                        },
                                        {
                                            "id": "735071107",
                                            "speaker": "Pyro-1",
                                            "text": "?"
                                        },
                                        {
                                            "id": "735071108",
                                            "speaker": "Paimon",
                                            "text": "Ooh, então Cabeça de Bongô gosta das geleias sabor Valberry, hein?"
                                        },
                                        {
                                            "id": "735071109",
                                            "speaker": "Paimon",
                                            "text": "Talvez possamos espremer muito suco de Valberry e deixar Cabeça de Bongô de molho nele da próxima vez..."
                                        },
                                        {
                                            "id": "735071110",
                                            "speaker": "Paimon",
                                            "text": "Por outro lado, parece que Pyroalegria não ficou muito contente... Talvez ele não goste de coisas doces — cabe bem com a personalidade dele!"
                                        }
                                    ]
                                },
                                {
                                    "id": "735071111",
                                    "text": "Usar as geleias sabor Menta.",
                                    "response": [
                                        {
                                            "id": "735071112",
                                            "speaker": "Cabeça de Bongô",
                                            "text": "♪~"
                                        },
                                        {
                                            "id": "735071113",
                                            "speaker": "Pyro-1",
                                            "text": "?"
                                        },
                                        {
                                            "id": "735071114",
                                            "speaker": "Paimon",
                                            "text": "Ei, parece que Cabeça de Bongô ama sabores frescos de Menta!"
                                        },
                                        {
                                            "id": "735071115",
                                            "speaker": "Paimon",
                                            "text": "Você acha que ele se divertiria muito em um campo de Menta?"
                                        },
                                        {
                                            "id": "735071116",
                                            "speaker": "Paimon",
                                            "text": "Hmm... Mas parece que Pyroalegria não está amando tanto assim os sabores refrescantes."
                                        }
                                    ]
                                },
                                {
                                    "id": "735071117",
                                    "text": "Usar as geleias sabor Ovas de Caranguejo",
                                    "response": [
                                        {
                                            "id": "735071118",
                                            "speaker": "Paimon",
                                            "text": "Hmm, este sabor é de verdade mesmo? Haniyyah tem umas... ideias interessantes..."
                                        },
                                        {
                                            "id": "735071119",
                                            "speaker": "Cabeça de Bongô",
                                            "text": "♪~"
                                        },
                                        {
                                            "id": "735071120",
                                            "speaker": "Pyro-1",
                                            "text": "♫~"
                                        },
                                        {
                                            "id": "735071121",
                                            "speaker": "Paimon",
                                            "text": "Hã, parece que Cabeça de Bongô não se importa com o sabor de Ovas de Caranguejo também!"
                                        },
                                        {
                                            "id": "735071122",
                                            "speaker": "Paimon",
                                            "text": "Pyroalegria parece feliz também. Parece que Ovas de Caranguejo é um comprometimento de sucesso!"
                                        },
                                        {
                                            "id": "735071123",
                                            "speaker": "Paimon",
                                            "text": "Demora um muito fazer Ovas de Caranguejo, mas é um pequeno sacrifício a se fazer pelos nossos cogumigos, não é? Vamos fazer um pouco mais depois!"
                                        },
                                        {
                                            "id": "735071124",
                                            "speaker": "Paimon",
                                            "text": "Agora que sabemos como fazer Geleias Maravilhosas, nós podemos preparar um banquete para eles!"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "735071125",
                    "text": "Vamos fazer esse gesto para eles.",
                    "response": [
                        {
                            "id": "735071126",
                            "speaker": "Paimon",
                            "text": "Hmm? Isso é verdade, parece que algumas pessoas podem usar gestos simples com as mãos para fazer animais entenderem o que querem dizer."
                        },
                        {
                            "id": "735071127",
                            "speaker": "Paimon",
                            "text": "Vamos tentar — com nossos laços com nossos cogumigos, nós não teremos problemas!",
                            "choices": [
                                {
                                    "id": "735071128",
                                    "text": "Faça um legal para seus cogumigos.",
                                    "response": [
                                        {
                                            "id": "735071129",
                                            "speaker": "Paimon",
                                            "text": "Certo, Paimon vai fazer também. Legal para o bom e velho Cabeça de Bongô e o belíssimo Pyroalegria!"
                                        },
                                        {
                                            "id": "735071130",
                                            "speaker": "Cabeça de Bongô",
                                            "text": "♪~"
                                        },
                                        {
                                            "id": "735071131",
                                            "speaker": "Pyro-1",
                                            "text": "♫~"
                                        },
                                        {
                                            "id": "735071132",
                                            "speaker": "Paimon",
                                            "text": "Hehe, parece que os dois estão super contentes. Vamos dar mais encorajamento a eles no futuro!"
                                        }
                                    ]
                                },
                                {
                                    "id": "735071133",
                                    "text": "Balance seu dedo indicador em um círculo.",
                                    "response": [
                                        {
                                            "id": "735071134",
                                            "speaker": "Paimon",
                                            "text": "Você está pedindo que eles se virem? Isso não é um pouco complicado?"
                                        },
                                        {
                                            "id": "735071135",
                                            "speaker": "Cabeça de Bongô",
                                            "text": "♪~"
                                        },
                                        {
                                            "id": "735071136",
                                            "speaker": "Pyro-1",
                                            "text": "♫~"
                                        },
                                        {
                                            "id": "735071137",
                                            "speaker": "Paimon",
                                            "text": "Haha, olhe só para eles! São tão espertos!"
                                        },
                                        {
                                            "id": "735071138",
                                            "speaker": "Paimon",
                                            "text": "É como se eles estivessem dançando. Se Paimon também dançasse, talvez Cabeça de Bongô também quisesse ser o parceiro de dança de Paimon!"
                                        }
                                    ]
                                },
                                {
                                    "id": "735071139",
                                    "text": "Apontar para Paimon com a mão direita, mão esquerda na minha cabeça.",
                                    "response": [
                                        {
                                            "id": "735071140",
                                            "speaker": "Cabeça de Bongô",
                                            "text": "♪~"
                                        },
                                        {
                                            "id": "735071141",
                                            "speaker": "Paimon",
                                            "text": "Uau, parece que Cabeça de Bongô está vindo para deixar Paimon pôr a mão na cabeça dele!"
                                        },
                                        {
                                            "id": "735071142",
                                            "speaker": "Paimon",
                                            "text": "Mas, Pyroalegria está..."
                                        },
                                        {
                                            "id": "735071143",
                                            "speaker": "Pyro-1",
                                            "text": "♫~"
                                        },
                                        {
                                            "id": "735071144",
                                            "speaker": "Paimon",
                                            "text": "Espere! Pare! Pyroalegria parece que vai pular na cabeça de Paimon a qualquer momento!"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "735071145",
                    "text": "Usar sons diferentes para chamá-los?",
                    "response": [
                        {
                            "id": "735071146",
                            "speaker": "Paimon",
                            "text": "Você quer dizer que deveríamos tentar imitar outros animais para ver como eles reagiriam?"
                        },
                        {
                            "id": "735071147",
                            "speaker": "Paimon",
                            "text": "Hehe, Paimon quer tentar isso também!",
                            "choices": [
                                {
                                    "id": "735071148",
                                    "text": "*Rugido*",
                                    "response": [
                                        {
                                            "id": "735071149",
                                            "speaker": "Paimon",
                                            "text": "Quem som foi esse?! Você estava tentando imitar um Animal de Carga? Paimon nunca ouviu isso antes..."
                                        },
                                        {
                                            "id": "735071150",
                                            "speaker": "Cabeça de Bongô",
                                            "text": "♪~"
                                        },
                                        {
                                            "id": "735071151",
                                            "speaker": "Pyro-1",
                                            "text": "♫~"
                                        },
                                        {
                                            "id": "735071152",
                                            "speaker": "Paimon",
                                            "text": "Hã, parece que eles estão vindo na nossa direção?"
                                        },
                                        {
                                            "id": "735071153",
                                            "speaker": "Paimon",
                                            "text": "Cogumelos também ficam juntos a Animais de Carga quando estão com frio?"
                                        }
                                    ]
                                },
                                {
                                    "id": "735071154",
                                    "text": "Miau~",
                                    "response": [
                                        {
                                            "id": "735071155",
                                            "speaker": "Paimon",
                                            "text": "#Haha, então você é {F#uma}{M#um} gat{F#a}{M#o}? Paimon vai miar também!"
                                        },
                                        {
                                            "id": "735071156",
                                            "speaker": "Cabeça de Bongô",
                                            "text": "?"
                                        },
                                        {
                                            "id": "735071157",
                                            "speaker": "Pyro-1",
                                            "text": "?"
                                        },
                                        {
                                            "id": "735071158",
                                            "speaker": "Paimon",
                                            "text": "Hã, eles parecem um pouco curiosos. Será que nunca viram um gato antes?"
                                        },
                                        {
                                            "id": "735071159",
                                            "speaker": "Paimon",
                                            "text": "Bem, podemos tentar apresentar eles a alguns no futuro para se tornarem amigos!"
                                        },
                                        {
                                            "id": "735071160",
                                            "speaker": "Paimon",
                                            "text": "Falando nisso, será que podemos chamar um gato que vive na floresta tropical de Gato da Floresta?"
                                        },
                                        {
                                            "id": "735071161",
                                            "speaker": "Paimon",
                                            "text": "E se ele se tornar amigo dos Cogumelos, ele seria um Gatogumelo!"
                                        }
                                    ]
                                },
                                {
                                    "id": "735071162",
                                    "text": "Ya!",
                                    "response": [
                                        {
                                            "id": "735071163",
                                            "speaker": "Paimon",
                                            "text": "Ei, você não está imitando um animal! Vai acabar assustando nossos Cogumigos!"
                                        },
                                        {
                                            "id": "735071164",
                                            "speaker": "Cabeça de Bongô",
                                            "text": "!"
                                        },
                                        {
                                            "id": "735071165",
                                            "speaker": "Pyro-1",
                                            "text": "!"
                                        },
                                        {
                                            "id": "735071166",
                                            "speaker": "Paimon",
                                            "text": "Veja, eles agora ficaram alertas!"
                                        },
                                        {
                                            "id": "735071167",
                                            "speaker": "Paimon",
                                            "text": "#Não se preocupem, não há Hilichurls por aqui. {NICKNAME} só está brincando."
                                        },
                                        {
                                            "id": "735071168",
                                            "speaker": "Paimon",
                                            "text": "Hmm, então isso quer dizer que os Cogumelos podem nos ajudar a ficar de olho enquanto estamos dormindo! Eles são bem confiáveis, né?"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "735071169",
                    "text": "Voltaremos depois e brincaremos com eles.",
                    "response": [
                        {
                            "id": "735071170",
                            "speaker": "Paimon",
                            "text": "Hã, será que temos mais alguma coisa para fazer? Bem, vamos logo, assim podemos voltar rápido para continuar brincando com Cabeça de Bongô e Pyroalegria!"
                        }
                    ]
                }
            ]
        }
    ]
}