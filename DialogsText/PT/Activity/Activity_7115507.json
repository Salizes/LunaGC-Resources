                                            "text": "#Muito bem, então, Mestre Fotógraf{M#o}{F#a}, que tipo de pose acha que ficaria mais fotogênica?",
                                            "choices": [
                                                {
                                                    "id": "711550706",
                                                    "text": "Uma pose mais relaxada.",
                                                    "response": [
                                                        {
                                                            "id": "711550708",
                                                            "speaker": "Player",
                                                            "text": "Essa pose está boa."
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "711550707",
                                                    "text": "Uma pose mais séria."
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
