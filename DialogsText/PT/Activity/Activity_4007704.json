    },
    "dialogues": [
        {
            "id": "400770401",
            "speaker": "Mona",
            "text": "Nossas férias estão acabando...",
            "choices": [
                {
                    "id": "400770402",
                    "text": "Quer conversar?",
                    "response": [
                        {
                            "id": "400770403",
                            "speaker": "Mona",
                            "text": "Claro, você queria me perguntar algo?",
                            "choices": [
                                {
                                    "id": "400770406",
                                    "text": "Sobre seu Hydroprofetizador...",
                                    "response": [
                                        {
                                            "id": "400770407",
                                            "speaker": "Mona",
                                            "text": "*Suspiro* É frustrante. Ultimamente meu Hydroprofetizador sempre tem estado com algum problema quando alguma coisa importante acontece."
                                        },
                                        {
                                            "id": "400770408",
                                            "speaker": "Mona",
                                            "text": "... É como se algo deliberadamente estivesse impedindo de ver como as coisas acabarão."
                                        },
                                        {
                                            "id": "400770409",
                                            "speaker": "Mona",
                                            "text": "Espere... Você não está falando isso só para tirar sarro com a minha cara, não é?"
                                        }
                                    ]
                                },
                                {
                                    "id": "400770410",
                                    "text": "Sobre o céu estrelado...",
                                    "response": [
                                        {
                                            "id": "400770411",
                                            "speaker": "Mona",
                                            "text": "Oh, eu queria lhe perguntar algo também. Como você se sentiu quando viu aquele céu estrelado?"
                                        },
                                        {
                                            "id": "400770412",
                                            "speaker": "Player",
                                            "text": "Foi magnífico!"
                                        },
                                        {
                                            "id": "400770413",
                                            "speaker": "Mona",
                                            "text": "Oh... Mesmo?"
                                        },
                                        {
                                            "id": "400770414",
                                            "speaker": "Mona",
                                            "text": "Bem, eu, ahem... Eu sou uma astróloga genial. É claro que minha miragem seria magnífica."
                                        },
                                        {
                                            "id": "400770415",
                                            "speaker": "Player",
                                            "text": "Essa é a Mona!"
                                        },
                                        {
                                            "id": "400770416",
                                            "speaker": "Mona",
                                            "text": "Hmm... Mas na época eu estava tão mergulhada em meus pensamentos que não percebi até ouvir você falar..."
                                        },
                                        {
                                            "id": "400770417",
                                            "speaker": "Player",
                                            "text": "Tudo era lindo!"
                                        },
                                        {
                                            "id": "400770418",
                                            "speaker": "Mona",
                                            "text": "Ei... Eu entendi. Foi de propósito, não foi?"
                                        }
                                    ]
                                },
                                {
                                    "id": "400770419",
                                    "text": "Sobre estas férias...",
                                    "response": [
                                        {
                                            "id": "400770420",
                                            "speaker": "Mona",
                                            "text": "Embora eu só esteja aqui porque Fischl me arrastou, em algum momento isso virou um verão maravilhoso."
                                        },
                                        {
                                            "id": "400770421",
                                            "speaker": "Mona",
                                            "text": "Testemunhar e proteger o destino de todos... É exatamente isso que tento fazer."
                                        },
                                        {
                                            "id": "400770422",
                                            "speaker": "Player",
                                            "text": "Mona, você fez um ótimo trabalho."
                                        },
                                        {
                                            "id": "400770423",
                                            "speaker": "Mona",
                                            "text": "Obrigada, e você... você trabalhou duro também."
                                        },
                                        {
                                            "id": "400770424",
                                            "speaker": "Mona",
                                            "text": "Mal posso esperar para continuar trabalhando com você da próxima vez, hehe... Tenho certeza que nos daremos ainda melhor."
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "400770404",
                    "text": "Não lhe incomodarei mais.",
                    "response": [
                        {
                            "id": "400770405",
                            "speaker": "Mona",
                            "text": "Hmm, aproveite bastante essa ilha antes de partirmos.",
                            "choices": [
                                {
                                    "id": "400770406",
                                    "text": "Sobre seu Hydroprofetizador..."
                                },
                                {
                                    "id": "400770410",
                                    "text": "Sobre o céu estrelado..."
                                },
                                {
                                    "id": "400770419",
                                    "text": "Sobre estas férias..."
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}