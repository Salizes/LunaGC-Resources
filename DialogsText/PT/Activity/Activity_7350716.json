{
    "talkId": "7350716",
    "total_dialogue_lines": 53,
    "speaker_counts": {
        "Blitzor": 6,
        "Ioiozinho": 7,
        "Paimon": 31,
        "Player": 9
    },
    "dialogues": [
        {
            "id": "735071601",
            "speaker": "Paimon",
            "text": "Olá, Ioiozinho! Olá Blitzor! Ainda se lembram da gente?"
        },
        {
            "id": "735071602",
            "speaker": "Paimon",
            "text": "Hahahaha, não hesitaram nem um pouco! Parecem tão felizes!"
        },
        {
            "id": "735071603",
            "speaker": "Paimon",
            "text": "Hmmm, o que devemos fazer enquanto estamos juntos?",
            "choices": [
                {
                    "id": "735071604",
                    "text": "Alimentá-los?",
                    "response": [
                        {
                            "id": "735071605",
                            "speaker": "Paimon",
                            "text": "Muito bem, vamos ver quais sabores eles gostam!",
                            "choices": [
                                {
                                    "id": "735071606",
                                    "text": "Usar as Geleias Maravilhosa com gosto de Bagas.",
                                    "response": [
                                        {
                                            "id": "735071607",
                                            "speaker": "Ioiozinho",
                                            "text": "♩~"
                                        },
                                        {
                                            "id": "735071608",
                                            "speaker": "Blitzor",
                                            "text": "♬~"
                                        },
                                        {
                                            "id": "735071609",
                                            "speaker": "Paimon",
                                            "text": "Hehe, parece que ambos gostaram do sabor das geleias de baga!"
                                        },
                                        {
                                            "id": "735071610",
                                            "speaker": "Paimon",
                                            "text": "E também são bem fáceis de encontrar — pegamos várias só de andar por aí. Parece que podemos deixar algumas para nossos amiguinhos cogumelos, não é?"
                                        }
                                    ]
                                },
                                {
                                    "id": "735071611",
                                    "text": "Usar as geleias com gosto de Melão de Lavanda.",
                                    "response": [
                                        {
                                            "id": "735071612",
                                            "speaker": "Paimon",
                                            "text": "Hã, então esse sabor também existe, hm? Haniyyah é realmente boa nisso — Paimon não imaginava que ela usaria ingredientes de outras nações em suas Geleias Maravilhosas."
                                        },
                                        {
                                            "id": "735071613",
                                            "speaker": "Ioiozinho",
                                            "text": "..."
                                        },
                                        {
                                            "id": "735071614",
                                            "speaker": "Blitzor",
                                            "text": "♬~"
                                        },
                                        {
                                            "id": "735071615",
                                            "speaker": "Paimon",
                                            "text": "Ioiozinho não parece entender o gosto do Melão de Lavanda. Deve estar pensando se é uma fruta ou um vegetal."
                                        },
                                        {
                                            "id": "735071616",
                                            "speaker": "Paimon",
                                            "text": "Bem, Blitzor não está tendo nenhum problema. Talvez esteja pensando sobre algo feliz."
                                        }
                                    ]
                                },
                                {
                                    "id": "735071617",
                                    "text": "Usar as geleias com gosto de Cebola.",
                                    "response": [
                                        {
                                            "id": "735071618",
                                            "speaker": "Paimon",
                                            "text": "?"
                                        },
                                        {
                                            "id": "735071619",
                                            "speaker": "Ioiozinho",
                                            "text": "?"
                                        },
                                        {
                                            "id": "735071620",
                                            "speaker": "Blitzor",
                                            "text": "?"
                                        },
                                        {
                                            "id": "735071621",
                                            "speaker": "Paimon",
                                            "text": "Esse sabor realmente deveria existir? A forma de pensar da Haniyyah é realmente interessante..."
                                        },
                                        {
                                            "id": "735071622",
                                            "speaker": "Ioiozinho",
                                            "text": "…♩~"
                                        },
                                        {
                                            "id": "735071623",
                                            "speaker": "Paimon",
                                            "text": "Oh? Parece que Ioiozinho mudou de ideia... e parece ter gostado!"
                                        },
                                        {
                                            "id": "735071624",
                                            "speaker": "Paimon",
                                            "text": "Existe algo de especial em cebolas? Deixa Paimon pensar..."
                                        },
                                        {
                                            "id": "735071625",
                                            "speaker": "Paimon",
                                            "text": "Hmm... Ela tem efeitos revigorantes?"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "735071626",
                    "text": "Usar sons diferentes para se comunicar com eles?",
                    "response": [
                        {
                            "id": "735071627",
                            "speaker": "Paimon",
                            "text": "Ooh, então você vai imitar animais? Claro! Paimon também gostaria de saber quais as relações que Ioiozinho e Blitzor tem com outros animais!"
                        },
                        {
                            "id": "735071628",
                            "speaker": "Paimon",
                            "text": "Vamos lá, vamos tentar!",
                            "choices": [
                                {
                                    "id": "735071629",
                                    "text": "Pruuu, pruuu!",
                                    "response": [
                                        {
                                            "id": "735071630",
                                            "speaker": "Ioiozinho",
                                            "text": "?"
                                        },
                                        {
                                            "id": "735071631",
                                            "speaker": "Blitzor",
                                            "text": "?"
                                        },
                                        {
                                            "id": "735071632",
                                            "speaker": "Paimon",
                                            "text": "Hmm, em Sumeru não existem pombos, então nossos amigos Cogumelos não conseguiram entender você."
                                        },
                                        {
                                            "id": "735071633",
                                            "speaker": "Paimon",
                                            "text": "Talvez você deveria tentar imitar Pássaros do Crepúsculo?"
                                        },
                                        {
                                            "id": "735071634",
                                            "speaker": "Paimon",
                                            "text": "Craaaa, cra, cracra, craaa!"
                                        },
                                        {
                                            "id": "735071635",
                                            "speaker": "Paimon",
                                            "text": "Uh... Hmm, isso é meio difícil. Paimon não consegue acompanhar o ritmo deles. Isso só deve ter confundido ainda mais nossos amiguinhos cogumelos..."
                                        }
                                    ]
                                },
                                {
                                    "id": "735071636",
                                    "text": "Rawr!",
                                    "response": [
                                        {
                                            "id": "735071637",
                                            "speaker": "Paimon",
                                            "text": "O quê? O que você estava tentando imitar? Espera aí. Isso foi você tentando imitar o som de um Caracal?"
                                        },
                                        {
                                            "id": "735071638",
                                            "speaker": "Paimon",
                                            "text": "Você vai assustar eles!"
                                        },
                                        {
                                            "id": "735071639",
                                            "speaker": "Ioiozinho",
                                            "text": "♪~"
                                        },
                                        {
                                            "id": "735071640",
                                            "speaker": "Blitzor",
                                            "text": "♫~"
                                        },
                                        {
                                            "id": "735071641",
                                            "speaker": "Paimon",
                                            "text": "Espera, como é? Eles parecem bem animados..."
                                        },
                                        {
                                            "id": "735071642",
                                            "speaker": "Paimon",
                                            "text": "Eles já fizeram amizades com Caracais antes e lutaram juntos?"
                                        },
                                        {
                                            "id": "735071643",
                                            "speaker": "Paimon",
                                            "text": "Isso é meio difícil de imaginar... Talvez devêssemos observar os Cogumelos pela natureza mais atentamente da próxima vez."
                                        }
                                    ]
                                },
                                {
                                    "id": "735071644",
                                    "text": "Gang~ gang~ woo!",
                                    "response": [
                                        {
                                            "id": "735071645",
                                            "speaker": "Paimon",
                                            "text": "Espera aí, por que você está imitando o Feiticeiro do Abismo agora!? Bem, você não é muito convincente, claro, mas você pode acabar assustando eles!"
                                        },
                                        {
                                            "id": "735071646",
                                            "speaker": "Ioiozinho",
                                            "text": "!"
                                        },
                                        {
                                            "id": "735071647",
                                            "speaker": "Blitzor",
                                            "text": "!"
                                        },
                                        {
                                            "id": "735071648",
                                            "speaker": "Paimon",
                                            "text": "Uh, Ioiozinho e Blitzor parecem assustados!"
                                        },
                                        {
                                            "id": "735071649",
                                            "speaker": "Paimon",
                                            "text": "#Está tudo bem, tudo bem, {M#o}{F#a} {NICKNAME} só está fazendo uma piadinha com vocês dois. Não tem nenhum Feiticeiro do Abismo por perto."
                                        },
                                        {
                                            "id": "735071650",
                                            "speaker": "Paimon",
                                            "text": "Mas, os Feiticeiros do Abismo saem por aí incomodando os Cogumelos, junto com os Hilichurls e tudo mais?"
                                        },
                                        {
                                            "id": "735071651",
                                            "speaker": "Paimon",
                                            "text": "Grrr, isso deixa Paimon irritada. Se encontrarmos Cogumelos sofrendo abusos na natureza da próxima vez, não deveríamos apenas ficar sem fazer nada e deixar acontecer!"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "735071652",
                    "text": "Voltaremos depois e brincaremos com eles.",
                    "response": [
                        {
                            "id": "735071653",
                            "speaker": "Paimon",
                            "text": "Sim, ainda existem algumas coisas que precisamos fazer. Bem, vamos terminar logo, e então voltar para ficarmos com o Ioiozinho e o Blitzor, tudo bem?"
                        }
                    ]
                }
            ]
        }
    ]
}