    "dialogues": [
        {
            "id": "736962601",
            "speaker": "Bahar",
            "text": "Todas as pessoas pegaram suas licenças?",
            "choices": [
                {
                    "id": "736962602",
                    "text": "Alguém escolheu uma premiação diferente.",
                    "response": [
                        {
                            "id": "736962605",
                            "speaker": "Bahar",
                            "text": "Por que ainda havia uma licença na caixa?",
                            "choices": [
                                {
                                    "id": "736962606",
                                    "text": "A pessoa que levou a licença também levou a caixa.",
                                    "response": [
                                        {
                                            "id": "736962609",
                                            "speaker": "Bahar",
                                            "text": "E o estado atual das licenças é...",
                                            "choices": [
                                                {
                                                    "id": "736962610",
                                                    "text": "Todas as licenças estão nas mãos de seus donos."
                                                },
                                                {
                                                    "id": "736962611",
                                                    "text": "Algumas licenças foram danificadas."
                                                },
                                                {
                                                    "id": "736962612",
                                                    "text": "Algumas das licenças não foram coletadas."
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "736962607",
                                    "text": "Era a licença de outra pessoa."
                                },
                                {
                                    "id": "736962608",
                                    "text": "Essa licença estava inválida."
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "736962603",
                    "text": "Alguém teve sua licença cancelada mais tarde."
                },
                {
                    "id": "736962604",
                    "text": "Todos pegaram suas licenças."
                }
            ]
        }
    ]
