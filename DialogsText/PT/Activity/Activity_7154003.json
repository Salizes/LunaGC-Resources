{
    "talkId": "7154003",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Lan Yan": 10,
        "Player": 5
    },
    "dialogues": [
        {
            "id": "715400301",
            "speaker": "Lan Yan",
            "text": "Ufa... Ainda bem que tudo deu certo...",
            "choices": [
                {
                    "id": "715400302",
                    "text": "Lan Yan, esse envelope de presente é para você.",
                    "response": [
                        {
                            "id": "715400303",
                            "speaker": "Lan Yan",
                            "text": "#Para mim? Obrigada, {NICKNAME}, é lindo!"
                        },
                        {
                            "id": "715400304",
                            "speaker": "Player",
                            "text": "Te desejo tudo de bom no ano novo."
                        },
                        {
                            "id": "715400305",
                            "speaker": "Lan Yan",
                            "text": "Idem! Também espero que esse ano seja bom para você!"
                        },
                        {
                            "id": "715400306",
                            "speaker": "Lan Yan",
                            "text": "Embora... Tenho certeza que você é alguém que pode fazer isso por conta própria."
                        },
                        {
                            "id": "715400307",
                            "speaker": "Lan Yan",
                            "text": "Não tenho dúvidas que você consegue resolver qualquer situação ruim.",
                            "choices": [
                                {
                                    "id": "715400308",
                                    "text": "Tento o meu melhor.",
                                    "response": [
                                        {
                                            "id": "715400310",
                                            "speaker": "Lan Yan",
                                            "text": "#Como esperado {M#do grande herói}{F#da grande heroína} de Liyue e {M#estimado convidado}{F#estimada convidada} da Tianquan — suas palavras exalam confiança."
                                        },
                                        {
                                            "id": "715400311",
                                            "speaker": "Lan Yan",
                                            "text": "Enfim, você e Hutao resolveram o problema da fronteira e agora meu avô não precisa se preocupar em levar gritos por conta de suas leituras da sorte."
                                        },
                                        {
                                            "id": "715400312",
                                            "speaker": "Lan Yan",
                                            "text": "Nesse sentido, acho que o Ritual de Lanternas desse ano foi um grande sucesso!"
                                        },
                                        {
                                            "id": "715400313",
                                            "speaker": "Lan Yan",
                                            "text": "Te desejo saúde, sucesso e felicidade no ano novo!"
                                        }
                                    ]
                                },
                                {
                                    "id": "715400309",
                                    "text": "Se eu me empenho nisso, é claro."
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "715400314",
                    "text": "Te vejo por aí.",
                    "response": [
                        {
                            "id": "715400315",
                            "speaker": "Lan Yan",
                            "text": "Adeus! Feliz Ritual de Lanternas!"
                        }
                    ]
                }
            ]
        }
    ]
}