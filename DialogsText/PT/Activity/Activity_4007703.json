{
    "talkId": "4007703",
    "total_dialogue_lines": 24,
    "speaker_counts": {
        "Fischl": 12,
        "Oz": 3,
        "Player": 9
    },
    "dialogues": [
        {
            "id": "400770301",
            "speaker": "Fischl",
            "text": "Ohoho, saudações, fiel escudeiro da Princesa.",
            "choices": [
                {
                    "id": "400770302",
                    "text": "Quer conversar?",
                    "response": [
                        {
                            "id": "400770303",
                            "speaker": "Fischl",
                            "text": "Certamente. Concedo-te permissão de perguntar quaisquer questões.",
                            "choices": [
                                {
                                    "id": "400770306",
                                    "text": "Sobre o Teatro do Corvo Noturno...",
                                    "response": [
                                        {
                                            "id": "400770307",
                                            "speaker": "Fischl",
                                            "text": "Oh? Testemunhaste o teatro da terra sagrada?"
                                        },
                                        {
                                            "id": "400770308",
                                            "speaker": "Fischl",
                                            "text": "#Haha, sejas franc{F#a}{M#o} com teus elogios. É uma apresentação única no mundo."
                                        },
                                        {
                                            "id": "400770309",
                                            "speaker": "Oz",
                                            "text": "A Princesa aguarda seus comentários ansiosamente."
                                        }
                                    ]
                                },
                                {
                                    "id": "400770310",
                                    "text": "Sobre o \"Canto da Terra Sagrada\"...",
                                    "response": [
                                        {
                                            "id": "400770311",
                                            "speaker": "Fischl",
                                            "text": "É a escritura sagrada do Reino da Noite Eterna. Sob nenhuma condição é permitido que seu estado se deteriore..."
                                        },
                                        {
                                            "id": "400770312",
                                            "speaker": "Player",
                                            "text": "Guardarei com cuidado."
                                        },
                                        {
                                            "id": "400770313",
                                            "speaker": "Fischl",
                                            "text": "Hunf, é melhor que sim."
                                        },
                                        {
                                            "id": "400770314",
                                            "speaker": "Oz",
                                            "text": "Para a Princesa, é uma lembrança preciosa dessa jornada. Ela está comovida em saber que você também vê dessa forma."
                                        },
                                        {
                                            "id": "400770315",
                                            "speaker": "Fischl",
                                            "text": "Oz, não é necessário traduzir em excesso o que eu disse!"
                                        }
                                    ]
                                },
                                {
                                    "id": "400770316",
                                    "text": "Sobre estas férias...",
                                    "response": [
                                        {
                                            "id": "400770317",
                                            "speaker": "Fischl",
                                            "text": "Regozijei em como essa grande cerimônia e celebração que a excursão oficial da Princesa foi recebida."
                                        },
                                        {
                                            "id": "400770318",
                                            "speaker": "Fischl",
                                            "text": "Mas, minha jornada por incontáveis mundos ensinou-me que até as coisas mais esplêndidas possuem um final."
                                        },
                                        {
                                            "id": "400770319",
                                            "speaker": "Fischl",
                                            "text": "Esse é o porquê eu ter declarado ao meu povo que minha excursão continua, pois ainda há escudeiros em terras longínquas que precisam da assistência da Princesa."
                                        },
                                        {
                                            "id": "400770320",
                                            "speaker": "Oz",
                                            "text": "A Princesa chorou quando se despediu de todos."
                                        },
                                        {
                                            "id": "400770321",
                                            "speaker": "Fischl",
                                            "text": "Oz! Eu já disse, isso foi por causa de um maldito grão de areia que caiu em meus olhos!"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "400770304",
                    "text": "Não lhe incomodarei mais.",
                    "response": [
                        {
                            "id": "400770305",
                            "speaker": "Fischl",
                            "text": "Ó, teu destino intersecciona com o meu. Desfrute bem deste paraíso.",
                            "choices": [
                                {
                                    "id": "400770306",
                                    "text": "Sobre o Teatro do Corvo Noturno..."
                                },
                                {
                                    "id": "400770310",
                                    "text": "Sobre o \"Canto da Terra Sagrada\"..."
                                },
                                {
                                    "id": "400770316",
                                    "text": "Sobre estas férias..."
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}