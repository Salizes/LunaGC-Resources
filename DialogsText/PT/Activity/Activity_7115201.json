    "dialogues": [
        {
            "id": "711520101",
            "speaker": "Kujou Sara",
            "text": "Hm... Encontrar você aqui, em meio às celebrações de Liyue, não... é nada surpreendente. Feliz Ritual de Lanternas.",
            "choices": [
                {
                    "id": "711520102",
                    "text": "Também soltei minha Lanterna Celeste.",
                    "response": [
                        {
                            "id": "711520104",
                            "speaker": "Kujou Sara",
                            "text": "Sim, eu vi. Pretendo comprar algumas Lanternas Celestes para levar de volta a Inazuma depois disso. Elas ficarão muito bonitas penduradas na entrada da Comissão Tenryou."
                        },
                        {
                            "id": "711520114",
                            "speaker": "Kujou Sara",
                            "text": "Com o Doushin Shikanoin por perto, duvido que algum ladrão se atreva a tocar nelas."
                        },
                        {
                            "id": "711520103",
                            "speaker": "Player",
                            "text": "Sobre a foto de lembrança..."
                        },
                        {
                            "id": "711520115",
                            "speaker": "Kujou Sara",
                            "text": "#De fato, fiz o pedido à Srta. Pingxi. Pelo visto, você é {M#o}{F#a} fotógraf{M#o}{F#a} profissional de quem ela falou."
                        },
                        {
                            "id": "711520116",
                            "speaker": "Kujou Sara",
                            "text": "Muito bem. Confio que fará excelentes fotos. Vamos começar.",
                            "choices": [
                                {
                                    "id": "711520117",
                                    "text": "Tudo pronto!",
                                    "response": [
                                        {
                                            "id": "711520120",
                                            "speaker": "Kujou Sara",
                                            "text": "Nesse caso, por favor, me aconselhe sobre uma pose apropriada enquanto nos preparamos.",
                                            "choices": [
                                                {
                                                    "id": "711520121",
                                                    "text": "Algo mais sério.",
                                                    "response": [
                                                        {
                                                            "id": "711520123",
                                                            "speaker": "Player",
                                                            "text": "Essa pose está boa."
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "711520122",
                                                    "text": "Uma pose mais relaxada."
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "711520118",
                                    "text": "Espere um pouco...",
                                    "response": [
                                        {
                                            "id": "711520119",
                                            "speaker": "Kujou Sara",
                                            "text": "Você tem algo urgente para resolver? Sem problema, esperarei aqui. Venha me encontrar quando terminar."
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "711520103",
                    "text": "Sobre a foto de lembrança..."
                }
            ]
        }
    ]
}