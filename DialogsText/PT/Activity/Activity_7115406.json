    "dialogues": [
        {
            "id": "711540601",
            "speaker": "Charlotte",
            "text": "#Ei, {NICKNAME}, aqui, aqui!"
        },
        {
            "id": "711540602",
            "speaker": "Charlotte",
            "text": "Eu sabia que você não ia perder o Ritual de Lanternas! Estava me perguntando quando ia esbarrar em você.",
            "choices": [
                {
                    "id": "711540603",
                    "text": "Também soltei minha Lanterna Celeste.",
                    "response": [
                        {
                            "id": "711540605",
                            "speaker": "Charlotte",
                            "text": "Eu sei, eu já vi! Lancei um monte mais cedo, foi o momento perfeito para fotos!"
                        },
                        {
                            "id": "711540606",
                            "speaker": "Charlotte",
                            "text": "Desejos? O quê... HÃ!? Eu estava tão ocupada tirando fotos que esqueci de escrever um! Droga, e eu soltei tantos... Isso quer dizer que meus desejos não vão valer...?"
                        },
                        {
                            "id": "711540604",
                            "speaker": "Player",
                            "text": "Veio a trabalho de novo, Charlotte?"
                        },
                        {
                            "id": "711540607",
                            "speaker": "Charlotte",
                            "text": "Não, não, não posso trabalhar em todo Ritual de Lanternas, não é? Desta vez eu vim mesmo de férias!"
                        },
                        {
                            "id": "711540608",
                            "speaker": "Player",
                            "text": "Você se inscreveu para uma foto de lembrança, não foi?"
                        },
                        {
                            "id": "711540609",
                            "speaker": "Charlotte",
                            "text": "Sim! A Srta. Pingxi disse que encontraria um fotógrafo profissional para tirar um bom retrato... Ei, espera aí, não me diga que..."
                        },
                        {
                            "id": "711540610",
                            "speaker": "Player",
                            "text": "#Fotógraf{M#o}{F#a} profissional, ao seu dispor."
                        },
                        {
                            "id": "711540611",
                            "speaker": "Charlotte",
                            "text": "É mesmo você? Hehe, perfeito então! Vamos lá, tire minha foto e vamos ver quem é melhor atrás da lente!"
                        },
                        {
                            "id": "711540612",
                            "speaker": "Charlotte",
                            "text": "#Então, pront{M#o}{F#a} para começar?",
                            "choices": [
                                {
                                    "id": "711540613",
                                    "text": "Sem problemas, começamos quando você quiser.",
                                    "response": [
                                        {
                                            "id": "711540614",
                                            "speaker": "Charlotte",
                                            "text": "#Beleza! Mas não dá para tirar uma foto sem posar para a câmera... Alguma sugestão, {NICKNAME}?",
                                            "choices": [
                                                {
                                                    "id": "711540615",
                                                    "text": "Algo mais sério.",
                                                    "response": [
                                                        {
                                                            "id": "711540619",
                                                            "speaker": "Player",
                                                            "text": "Essa pose está boa."
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "711540616",
                                                    "text": "Uma pose mais relaxada.",
                                                    "response": [
                                                        {
                                                            "id": "711540621",
                                                            "speaker": "Player",
                                                            "text": "Vamos tentar a primeira pose...",
                                                            "choices": [
                                                                {
                                                                    "id": "711540620",
                                                                    "text": "Vamos tentar a segunda pose..."
                                                                },
                                                                {
                                                                    "id": "711540619",
                                                                    "text": "Essa pose está boa."
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "711540617",
                                    "text": "Espera um pouco...",
                                    "response": [
                                        {
                                            "id": "711540618",
                                            "speaker": "Charlotte",
                                            "text": "Você tem outra coisa para resolver? Sem problema, podemos voltar para a foto depois."
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "711540604",
                    "text": "Veio a trabalho de novo, Charlotte?"
                }
            ]
        }
    ]
}