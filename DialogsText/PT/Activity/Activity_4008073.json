{
    "talkId": "4008073",
    "total_dialogue_lines": 25,
    "speaker_counts": {
        "Player": 6,
        "Razor": 19
    },
    "dialogues": [
        {
            "id": "400807301",
            "speaker": "Razor",
            "text": "O vento é gentil, confortável.",
            "choices": [
                {
                    "id": "400807302",
                    "text": "Você quer conversar?",
                    "response": [
                        {
                            "id": "400807305",
                            "speaker": "Razor",
                            "text": "Certo.",
                            "choices": [
                                {
                                    "id": "400807306",
                                    "text": "Sobre Varka...",
                                    "response": [
                                        {
                                            "id": "400807307",
                                            "speaker": "Razor",
                                            "text": "A mensagem na carta... Quero agradecer a ele."
                                        },
                                        {
                                            "id": "400807308",
                                            "speaker": "Razor",
                                            "text": "... Sinto falta dele. Lupical também sente."
                                        },
                                        {
                                            "id": "400807309",
                                            "speaker": "Razor",
                                            "text": "Agora, já sou crescido."
                                        },
                                        {
                                            "id": "400807310",
                                            "speaker": "Razor",
                                            "text": "Quero ouvir ele falar sobre pai e mãe humana."
                                        }
                                    ]
                                },
                                {
                                    "id": "400807311",
                                    "text": "Sobre seus pais...",
                                    "response": [
                                        {
                                            "id": "400807312",
                                            "speaker": "Razor",
                                            "text": "Eu ouço as vozes deles."
                                        },
                                        {
                                            "id": "400807313",
                                            "speaker": "Razor",
                                            "text": "Pais humanos... eram aventureiros..."
                                        },
                                        {
                                            "id": "400807314",
                                            "speaker": "Razor",
                                            "text": "Professora disse, talvez ele não sobreviveram..."
                                        },
                                        {
                                            "id": "400807315",
                                            "speaker": "Player",
                                            "text": "Razor..."
                                        },
                                        {
                                            "id": "400807316",
                                            "speaker": "Razor",
                                            "text": "Eu tenho uma caixa de madeira. Dentro estão os tesouros dos meus amigos."
                                        },
                                        {
                                            "id": "400807317",
                                            "speaker": "Razor",
                                            "text": "Eles são as coisas mais preciosas que tenho."
                                        },
                                        {
                                            "id": "400807318",
                                            "speaker": "Razor",
                                            "text": "..."
                                        },
                                        {
                                            "id": "400807319",
                                            "speaker": "Razor",
                                            "text": "Dentro da caixa do meu pai e mãe humanos... tudo é sobre mim..."
                                        }
                                    ]
                                },
                                {
                                    "id": "400807320",
                                    "text": "Sobre amigos...",
                                    "response": [
                                        {
                                            "id": "400807321",
                                            "speaker": "Razor",
                                            "text": "Há muito tempo, eu pensava que estava sozinho. Só tinha a Lupical."
                                        },
                                        {
                                            "id": "400807322",
                                            "speaker": "Razor",
                                            "text": "Agora, conheço muita gente."
                                        },
                                        {
                                            "id": "400807323",
                                            "speaker": "Razor",
                                            "text": "Todos me ajudam. Ajudarei todos também."
                                        },
                                        {
                                            "id": "400807324",
                                            "speaker": "Razor",
                                            "text": "Humanos, lobos, todo mundo."
                                        },
                                        {
                                            "id": "400807325",
                                            "speaker": "Razor",
                                            "text": "Eu sou a ponte entre cidade e a natureza."
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "400807303",
                    "text": "Não lhe incomodarei mais.",
                    "response": [
                        {
                            "id": "400807304",
                            "speaker": "Razor",
                            "text": "Tudo bem. Vá e aproveite o vento."
                        }
                    ]
                }
            ]
        }
    ]
}