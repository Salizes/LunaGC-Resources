    "dialogues": [
        {
            "id": "401114301",
            "speaker": "Sangonomiya Kokomi",
            "text": "Hmm? Oh, você veio esse caminho todo até aqui só para me ver?",
            "choices": [
                {
                    "id": "401114302",
                    "text": "Sobre os ladrões...",
                    "response": [
                        {
                            "id": "401114303",
                            "speaker": "Sangonomiya Kokomi",
                            "text": "Ah, então foi isso que você descobriu no final. Hmm, não sei muito bem como me sinto sobre isso."
                        },
                        {
                            "id": "401114304",
                            "speaker": "Sangonomiya Kokomi",
                            "text": "Mas, obrigada por ter me avisado."
                        },
                        {
                            "id": "401114305",
                            "speaker": "Sangonomiya Kokomi",
                            "text": "Ouvir como as coisas acabaram quase parece como ler o final de uma light novel. Agora todos nós podemos relaxar.",
                            "choices": [
                                {
                                    "id": "401114306",
                                    "text": "Sobre o torneio...",
                                    "response": [
                                        {
                                            "id": "401114307",
                                            "speaker": "Sangonomiya Kokomi",
                                            "text": "\"Ganhar ou perder não é o que há de importante. É sobre jogar com elegância\". Pelo menos é como eu sempre pensei sobre isso."
                                        },
                                        {
                                            "id": "401114308",
                                            "speaker": "Sangonomiya Kokomi",
                                            "text": "Mas depois de ver todos vocês torcendo por mim, acabei realmente tentando jogar o meu melhor."
                                        },
                                        {
                                            "id": "401114309",
                                            "speaker": "Sangonomiya Kokomi",
                                            "text": "Hehe... Agora que penso sobre isso, foi realmente bom ter sido capaz de falar com vocês antes da competição."
                                        },
                                        {
                                            "id": "401114310",
                                            "speaker": "Player",
                                            "text": "+5 de Energia?"
                                        },
                                        {
                                            "id": "401114311",
                                            "speaker": "Sangonomiya Kokomi",
                                            "text": "Ah! Não, por favor, nunca mais comente sobre isso para ninguém!",
                                            "choices": [
                                                {
                                                    "id": "401114302",
                                                    "text": "Sobre os ladrões..."
                                                },
                                                {
                                                    "id": "401114312",
                                                    "text": "Estou indo então.",
                                                    "response": [
                                                        {
                                                            "id": "401114313",
                                                            "speaker": "Sangonomiya Kokomi",
                                                            "text": "Já que você veio esse caminho todo até a Ilha Watatsumi, você deveria descansar um pouco antes de retornar."
                                                        },
                                                        {
                                                            "id": "401114314",
                                                            "speaker": "Sangonomiya Kokomi",
                                                            "text": "Espero que essa vista fique em seu coração para sempre."
                                                        }
                                                    ]
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "401114312",
                                    "text": "Estou indo então."
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "401114306",
                    "text": "Sobre o torneio..."
                },
                {
                    "id": "401114312",
                    "text": "Estou indo então."
                }
            ]
        }
    ]
}