{
    "talkId": "4008075",
    "total_dialogue_lines": 21,
    "speaker_counts": {
        "Player": 7,
        "Rosaria": 14
    },
    "dialogues": [
        {
            "id": "400807501",
            "speaker": "Rosaria",
            "text": "#{NICKNAME}, olá novamente...",
            "choices": [
                {
                    "id": "400807502",
                    "text": "Você quer conversar?",
                    "response": [
                        {
                            "id": "400807505",
                            "speaker": "Rosaria",
                            "text": "Certo. Tem alguma coisa que você queira me perguntar?",
                            "choices": [
                                {
                                    "id": "400807506",
                                    "text": "Sobre Varka...",
                                    "response": [
                                        {
                                            "id": "400807507",
                                            "speaker": "Rosaria",
                                            "text": "Oh, sim. Eu li a carta dele. Barbara me mostrou."
                                        },
                                        {
                                            "id": "400807508",
                                            "speaker": "Rosaria",
                                            "text": "Ela esteve tão preocupada com o pai, Seamus. Ela quase se desmanchou em lágrimas quando leu que \"a expedição está sã e salva.\""
                                        },
                                        {
                                            "id": "400807509",
                                            "speaker": "Rosaria",
                                            "text": "Hmm?... O que acho?"
                                        },
                                        {
                                            "id": "400807510",
                                            "speaker": "Rosaria",
                                            "text": "Hmm... Você tem curiosidade sobre o que ele significa para mim como figura paterna, certo? Bem, eu acho que não sou como outras filhas. Não consigo me preocupar com ele."
                                        },
                                        {
                                            "id": "400807511",
                                            "speaker": "Rosaria",
                                            "text": "Ele não estaria liderando toda essa gente se ele não tivesse a força e coragem necessária. Ele não é o tipo de pessoa que precisa que se preocupem."
                                        }
                                    ]
                                },
                                {
                                    "id": "400807512",
                                    "text": "Sobre Razor...",
                                    "response": [
                                        {
                                            "id": "400807513",
                                            "speaker": "Rosaria",
                                            "text": "Então, ele finalmente está em paz com tudo?"
                                        },
                                        {
                                            "id": "400807514",
                                            "speaker": "Player",
                                            "text": "Pelo menos, ele não está mais perdido e confuso."
                                        },
                                        {
                                            "id": "400807515",
                                            "speaker": "Player",
                                            "text": "Ele tem uma direção agora."
                                        },
                                        {
                                            "id": "400807516",
                                            "speaker": "Rosaria",
                                            "text": "Hmm, parece que ele ainda tem um longo caminho pela frente antes de poder dizer que é totalmente independente. Mas todos vivem a própria vida do próprio jeito."
                                        },
                                        {
                                            "id": "400807517",
                                            "speaker": "Rosaria",
                                            "text": "Muito bem! Parece que seus esforços valeram a pena no final."
                                        }
                                    ]
                                },
                                {
                                    "id": "400807518",
                                    "text": "Sobre o Festvinho...",
                                    "response": [
                                        {
                                            "id": "400807519",
                                            "speaker": "Rosaria",
                                            "text": "Achei que eu poderia passar o festival inteiro na taverna. Entretanto, acontece que tem muito mais trabalho durante um festival."
                                        },
                                        {
                                            "id": "400807520",
                                            "speaker": "Rosaria",
                                            "text": "Consegui fugir até aqui, mas mesmo assim, não consigo relaxar. Quem sabe quando Victoria ou Dahlia vão aparecer e me arrastar para o evento do recital de poesia."
                                        },
                                        {
                                            "id": "400807521",
                                            "speaker": "Rosaria",
                                            "text": "*Suspira* Quanto antes esse festival acabar, melhor."
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "400807503",
                    "text": "Não lhe incomodarei mais.",
                    "response": [
                        {
                            "id": "400807504",
                            "speaker": "Rosaria",
                            "text": "Tudo bem. Mas não diga a ninguém que eu estou aqui. Eu não quero ter de me mexer nem tão cedo."
                        }
                    ]
                }
            ]
        }
    ]
}