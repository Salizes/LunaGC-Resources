    "dialogues": [
        {
            "id": "711510301",
            "speaker": "Wriothesley",
            "text": "Uau, essa foi rápida. Vamos começar?",
            "choices": [
                {
                    "id": "711510302",
                    "text": "Também soltei minha Lanterna Celeste.",
                    "response": [
                        {
                            "id": "711510303",
                            "speaker": "Wriothesley",
                            "text": "Nada mal, voou alto e brilhou bastante. Dá até vontade de comprar algumas para levar de volta para a Fortaleza Meropide."
                        },
                        {
                            "id": "711510304",
                            "speaker": "Wriothesley",
                            "text": "Pensando bem... Lanternas Celestes lançadas na Fortaleza de Meropide não voariam para o céu nem realizariam desejos. Só significariam mais trabalho para a equipe de limpeza.",
                            "choices": [
                                {
                                    "id": "711510305",
                                    "text": "Sem problemas, começamos quando você quiser.",
                                    "response": [
                                        {
                                            "id": "711510306",
                                            "speaker": "Wriothesley",
                                            "text": "#Claro. Preciso fazer alguma pose, ou...? Sugestões são bem-vindas, {NICKNAME}.",
                                            "choices": [
                                                {
                                                    "id": "711510309",
                                                    "text": "Algo mais sério.",
                                                    "response": [
                                                        {
                                                            "id": "711510311",
                                                            "speaker": "Player",
                                                            "text": "Essa pose está boa."
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "711510310",
                                                    "text": "Uma pose mais relaxada."
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "711510307",
                                    "text": "Espere um pouco...",
                                    "response": [
                                        {
                                            "id": "711510308",
                                            "speaker": "Wriothesley",
                                            "text": "Tem algo para resolver? Sem pressa, não estou com pressa."
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "711510305",
                    "text": "Sem problemas, começamos quando você quiser."
