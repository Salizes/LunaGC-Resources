{
    "talkId": "4008074",
    "total_dialogue_lines": 22,
    "speaker_counts": {
        "Diluc": 16,
        "Player": 6
    },
    "dialogues": [
        {
            "id": "400807401",
            "speaker": "Diluc",
            "text": "O que você achou do Festvinho? Conseguiu aproveitar?",
            "choices": [
                {
                    "id": "400807402",
                    "text": "Você quer conversar?",
                    "response": [
                        {
                            "id": "400807405",
                            "speaker": "Diluc",
                            "text": "O que você gostaria de saber?",
                            "choices": [
                                {
                                    "id": "400807406",
                                    "text": "Sobre Razor...",
                                    "response": [
                                        {
                                            "id": "400807407",
                                            "speaker": "Diluc",
                                            "text": "Eu posso entender a angústia de estar longe da família."
                                        },
                                        {
                                            "id": "400807408",
                                            "speaker": "Diluc",
                                            "text": "Certamente, uma situação trágica. Mas a tragédia também pode impulsionar o crescimento pessoal, e talvez aprender como enfrentar isso faz parte do processo de crescer... parte de se tornar adulto."
                                        },
                                        {
                                            "id": "400807409",
                                            "speaker": "Diluc",
                                            "text": "Ter a ajuda de alguns bons amigos certamente facilitarão a jornada."
                                        }
                                    ]
                                },
                                {
                                    "id": "400807410",
                                    "text": "Sobre as vozes...",
                                    "response": [
                                        {
                                            "id": "400807411",
                                            "speaker": "Diluc",
                                            "text": "... Quando eu abri o vinho, parece que as palavras do meu falecido pai estavam seladas dentro."
                                        },
                                        {
                                            "id": "400807412",
                                            "speaker": "Diluc",
                                            "text": "Eu me pergunto o que ele pensaria se pudesse me ver agora."
                                        },
                                        {
                                            "id": "400807413",
                                            "speaker": "Diluc",
                                            "text": "De alguma forma, eu duvido que ele compartilharia da mesma visão que tinha antes."
                                        },
                                        {
                                            "id": "400807414",
                                            "speaker": "Player",
                                            "text": "Claro que iria."
                                        },
                                        {
                                            "id": "400807415",
                                            "speaker": "Diluc",
                                            "text": "..."
                                        },
                                        {
                                            "id": "400807416",
                                            "speaker": "Diluc",
                                            "text": "Se você diz."
                                        }
                                    ]
                                },
                                {
                                    "id": "400807417",
                                    "text": "Sobre o Festvinho...",
                                    "response": [
                                        {
                                            "id": "400807418",
                                            "speaker": "Diluc",
                                            "text": "Para o povo de Mondstadt, fermentação de vinho é uma maneira de processar emoções e lembrar de nossa história."
                                        },
                                        {
                                            "id": "400807419",
                                            "speaker": "Diluc",
                                            "text": "Nós só conseguimos fazer vinho dessa qualidade atualmente graças à paz que desfrutamos. Guerra é algo de um passado distante."
                                        },
                                        {
                                            "id": "400807420",
                                            "speaker": "Diluc",
                                            "text": "Mesmo que você não me veja curtindo com a multidão, eu sou grato por isso tanto quanto qualquer um."
                                        },
                                        {
                                            "id": "400807421",
                                            "speaker": "Diluc",
                                            "text": "Diga-me, você experimento nosso último produto, \"Frutas do Festival\"?"
                                        },
                                        {
                                            "id": "400807422",
                                            "speaker": "Diluc",
                                            "text": "Se houver alguma sugestão de melhoria, sou todo ouvidos."
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "400807403",
                    "text": "Não lhe incomodarei mais.",
                    "response": [
                        {
                            "id": "400807404",
                            "speaker": "Diluc",
                            "text": "Claro. Vamos conversar quando você estiver livre."
                        }
                    ]
                }
            ]
        }
    ]
}