{
    "talkId": "4014157",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 4,
        "Xiao": 10
    },
    "dialogues": [
        {
            "id": "401415701",
            "speaker": "Xiao",
            "text": "#{NICKNAME}."
        },
        {
            "id": "401415702",
            "speaker": "Player",
            "text": "É bem como pensei... você parou pouco antes de entrar na cidade de novo."
        },
        {
            "id": "401415703",
            "speaker": "Xiao",
            "text": "Estar na cidade não é a única forma de eu apreciar as luzes e a beleza do Ritual de Lanternas. Veja... o Porto de Liyue está logo atrás desta montanha."
        },
        {
            "id": "401415704",
            "speaker": "Xiao",
            "text": "Desde que eu fique nesse ponto vantajoso, eu posso avistar livremente todas as pipas subindo lentamente aos céus."
        },
        {
            "id": "401415705",
            "speaker": "Xiao",
            "text": "...Para mim, isso é suficiente."
        },
        {
            "id": "401415706",
            "speaker": "Player",
            "text": "Tudo bem."
        },
        {
            "id": "401415707",
            "speaker": "Xiao",
            "text": "Eu te convidei aqui, pois existe uma coisa que eu gostaria de fazer."
        },
        {
            "id": "401415708",
            "speaker": "Xiao",
            "text": "...Você soltaria essa Lanterna Celeste comigo?"
        },
        {
            "id": "401415709",
            "speaker": "Player",
            "text": "Foi você mesmo quem fez?"
        },
        {
            "id": "401415710",
            "speaker": "Xiao",
            "text": "Sim."
        },
        {
            "id": "401415711",
            "speaker": "Xiao",
            "text": "Me desculpe pela sua aparência grosseira... eu tenho pouca habilidade nesse quesito."
        },
        {
            "id": "401415712",
            "speaker": "Player",
            "text": "Não, não! Está incrível."
        },
        {
            "id": "401415713",
            "speaker": "Xiao",
            "text": "...Você é muito gentil, como sempre."
        },
        {
            "id": "401415714",
            "speaker": "Xiao",
            "text": "Então, está na hora."
        }
    ]
}