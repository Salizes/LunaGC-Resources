{
    "talkId": "4008076",
    "total_dialogue_lines": 24,
    "speaker_counts": {
        "Player": 6,
        "Sucrose": 18
    },
    "dialogues": [
        {
            "id": "400807601",
            "speaker": "Sucrose",
            "text": "Olá, quer ver o estande? Existem muitos produtos desenvolvidos recentemente.",
            "choices": [
                {
                    "id": "400807602",
                    "text": "Você quer conversar?",
                    "response": [
                        {
                            "id": "400807605",
                            "speaker": "Sucrose",
                            "text": "Hmm, certo, vá em frente...",
                            "choices": [
                                {
                                    "id": "400807606",
                                    "text": "Sobre o estande...",
                                    "response": [
                                        {
                                            "id": "400807607",
                                            "speaker": "Sucrose",
                                            "text": "Ah, isso?"
                                        },
                                        {
                                            "id": "400807608",
                                            "speaker": "Sucrose",
                                            "text": "Eu de fato escrevi todas as informações nutricionais e preços para meus produtos de Bioalquimia antes. Mas os clientes ainda preferem perguntar diretamente..."
                                        },
                                        {
                                            "id": "400807609",
                                            "speaker": "Sucrose",
                                            "text": "Então... Eu só leio a folha para eles..."
                                        },
                                        {
                                            "id": "400807610",
                                            "speaker": "Sucrose",
                                            "text": "Cuidar de um estande é um grande desafio para mim."
                                        },
                                        {
                                            "id": "400807611",
                                            "speaker": "Sucrose",
                                            "text": "Talvez eu possa pedir para Noelle interagir com os clientes, e eu faço o resto... Hmm, não, esqueça... Ela provavelmente já está ocupada."
                                        }
                                    ]
                                },
                                {
                                    "id": "400807612",
                                    "text": "Sobre seus produtos de Bioalquimia...",
                                    "response": [
                                        {
                                            "id": "400807613",
                                            "speaker": "Sucrose",
                                            "text": "Eu tenho a Flor da Neblina de Ação Rápida de Congelamento Profundo Série Iota, a Flor Doce de Fragrância Aprimorada Série Teta, Variante 21..."
                                        },
                                        {
                                            "id": "400807614",
                                            "speaker": "Sucrose",
                                            "text": "E o Fruto do Pôr do Sol Tetradoce Série Epsilon, Variante 63. Tenho orgulho de assinar meu nome em todos esses produtos!"
                                        },
                                        {
                                            "id": "400807615",
                                            "speaker": "Sucrose",
                                            "text": "Você não precisa que eu leia todas as informações, não é?"
                                        }
                                    ]
                                },
                                {
                                    "id": "400807616",
                                    "text": "Sobre Razor...",
                                    "response": [
                                        {
                                            "id": "400807617",
                                            "speaker": "Sucrose",
                                            "text": "Desculpe por fugir naquela hora..."
                                        },
                                        {
                                            "id": "400807618",
                                            "speaker": "Sucrose",
                                            "text": "Eu só pensei que você e Noelle fariam um trabalho melhor do que eu faria tentando expressar coisas..."
                                        },
                                        {
                                            "id": "400807619",
                                            "speaker": "Sucrose",
                                            "text": "No final, deu tudo certo? Misturar o Fruto do Pôr do Sol Tetradoce Série Epsilon, Variante 63 com outros ingredientes não causou problemas, causou?"
                                        },
                                        {
                                            "id": "400807620",
                                            "speaker": "Sucrose",
                                            "text": "Ah, e uh... como acabaram as coisas com Razor..."
                                        },
                                        {
                                            "id": "400807621",
                                            "speaker": "Player",
                                            "text": "Não se preocupe. Tudo deu certo."
                                        },
                                        {
                                            "id": "400807622",
                                            "speaker": "Sucrose",
                                            "text": "Ufa... Ainda bem."
                                        },
                                        {
                                            "id": "400807623",
                                            "speaker": "Sucrose",
                                            "text": "Então... posso pedir um favor? Eu quero anotar a receita completa do Vinho dos Mil Ventos que fizemos."
                                        },
                                        {
                                            "id": "400807624",
                                            "speaker": "Sucrose",
                                            "text": "Dessa forma, poderemos recriar o mesmo exato sabor que fizemos hoje no futuro, independentemente de quantos anos se passem."
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "400807603",
                    "text": "Não lhe incomodarei mais.",
                    "response": [
                        {
                            "id": "400807604",
                            "speaker": "Sucrose",
                            "text": "Ah, claro. Sem problemas."
                        }
                    ]
                }
            ]
        }
    ]
}