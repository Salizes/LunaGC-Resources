{
    "talkId": "7750117",
    "total_dialogue_lines": 35,
    "speaker_counts": {
        "Player": 11,
        "Talalikhin": 24
    },
    "dialogues": [
        {
            "id": "775011701",
            "speaker": "Talalikhin",
            "text": "#Olá, {NICKNAME}. Agradeço mais uma vez por participar do primeiro Torneio dos Aventureiros.",
            "choices": [
                {
                    "id": "775011702",
                    "text": "Pode me lembrar quem você é?",
                    "response": [
                        {
                            "id": "775011703",
                            "speaker": "Talalikhin",
                            "text": "Ah... Honestamente, o que eu disse quando nos conhecemos pela primeira vez foi praticamente tudo..."
                        },
                        {
                            "id": "775011704",
                            "speaker": "Talalikhin",
                            "text": "Meu nome é Talalikhin Gogol. Sou funcionário do Quartel-General da Guilda de Aventureiros.",
                            "choices": [
                                {
                                    "id": "775011705",
                                    "text": "Mas a sua pontuação no placar tá longe de ser baixa.",
                                    "response": [
                                        {
                                            "id": "775011707",
                                            "speaker": "Talalikhin",
                                            "text": "Só me pediram para participar porque sou familiar com esse tipo de trabalho. O resto foi pura sorte."
                                        },
                                        {
                                            "id": "775011708",
                                            "speaker": "Talalikhin",
                                            "text": "Além disso, acho que tive um pouco de vantagem, já que os aventureiros de Snezhnaya estão mais acostumados com eventos competitivos assim, afinal."
                                        }
                                    ]
                                },
                                {
                                    "id": "775011706",
                                    "text": "Esse é mesmo o tipo de ranque que se espera de um funcionário?"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "775011709",
                    "text": "Você é próximo de Lan?",
                    "response": [
                        {
                            "id": "775011710",
                            "speaker": "Talalikhin",
                            "text": "Eu não diria exatamente próximo. Ela é membro da Guilda há muito mais tempo do que eu."
                        },
                        {
                            "id": "775011711",
                            "speaker": "Talalikhin",
                            "text": "Mas, dessa vez, Lan e eu estaremos trabalhando juntos por trás dos panos.",
                            "choices": [
                                {
                                    "id": "775011712",
                                    "text": "Como assim?",
                                    "response": [
                                        {
                                            "id": "775011714",
                                            "speaker": "Talalikhin",
                                            "text": "Você lembra da espada chamada \"Lâmina Oculta\"?"
                                        },
                                        {
                                            "id": "775011715",
                                            "speaker": "Talalikhin",
                                            "text": "Lan, Mestre da Filial da Guilda de Aventureiros, também é Huo Lanling, a \"Busca-espadas de Qingxu\". Ela nunca fracassou em uma comissão desde que assumiu o cargo."
                                        },
                                        {
                                            "id": "775011716",
                                            "speaker": "Talalikhin",
                                            "text": "Há outro motivo importante para Lan vir até aqui. Ela está procurando pelo dono anterior da \"Lâmina Oculta\".",
                                            "choices": [
                                                {
                                                    "id": "775011717",
                                                    "text": "Eu não sei muito o que eaconteceu com Lan...",
                                                    "response": [
                                                        {
                                                            "id": "775011718",
                                                            "speaker": "Talalikhin",
                                                            "text": "Nesse caso, se não se importar, posso explicar em alguns minutos."
                                                        },
                                                        {
                                                            "id": "775011721",
                                                            "speaker": "Talalikhin",
                                                            "text": "Lan e eu temos uma razão para encontrar essa pessoa."
                                                        },
                                                        {
                                                            "id": "775011722",
                                                            "speaker": "Talalikhin",
                                                            "text": "Porque..."
                                                        },
                                                        {
                                                            "id": "775011723",
                                                            "speaker": "Talalikhin",
                                                            "text": "O irmão mais velho dela, Mestre Huo Zhaohui, já viajou pelas planícies congeladas de Snezhnaya com meu tio."
                                                        },
                                                        {
                                                            "id": "775011724",
                                                            "speaker": "Talalikhin",
                                                            "text": "Eles estavam procurando pelo \"material adamantino\", esperando forjar a lâmina perfeita e desenvolver um estilo de luta no qual guerreiro e arma se movem como um só."
                                                        },
                                                        {
                                                            "id": "775011725",
                                                            "speaker": "Talalikhin",
                                                            "text": "Mas, no fim, eles se envolveram num acidente com o Reino das Sombras e ninguém nunca mais soube onde estão desde então.",
                                                            "choices": [
                                                                {
                                                                    "id": "775011726",
                                                                    "text": "Eu não sabia disso...",
                                                                    "response": [
                                                                        {
                                                                            "id": "775011728",
                                                                            "speaker": "Talalikhin",
                                                                            "text": "É compreensível. O acidente foi extremamente complicado e o relatório da investigação sozinho era mais grosso do que um dicionário."
                                                                        },
                                                                        {
                                                                            "id": "775011729",
                                                                            "speaker": "Talalikhin",
                                                                            "text": "O relatório completo só foi revisado minuciosamente recentemente e as informações nele foram confirmadas como \"relativamente precisas\". O Batalhão de Missões Especiais desde então o compartilhou com a Guilda de Aventureiros."
                                                                        },
                                                                        {
                                                                            "id": "775011730",
                                                                            "speaker": "Talalikhin",
                                                                            "text": "Quando o torneio acabar, organizarei esses achados em nome da Guilda e os usarei para criar um conjunto de exercícios de treinamento mental baseados no combate do Reino das Sombras simulado."
                                                                        },
                                                                        {
                                                                            "id": "775011731",
                                                                            "speaker": "Talalikhin",
                                                                            "text": "Se tiver interesse, você pode me encontrar perto do Quartel-General quando for a hora."
                                                                        },
                                                                        {
                                                                            "id": "775011732",
                                                                            "speaker": "Talalikhin",
                                                                            "text": "Pelo bem da Guilda e por motivos pessoais também, farei tudo que puder para ajudar Lan a encontrar o irmão."
                                                                        },
                                                                        {
                                                                            "id": "775011733",
                                                                            "speaker": "Talalikhin",
                                                                            "text": "Talvez eu também possa ter a chance de encontrar meu tio e ajudar minha família a superar a tristeza que carregamos por anos."
                                                                        }
                                                                    ]
                                                                },
                                                                {
                                                                    "id": "775011727",
                                                                    "text": "Lan não sabia disso?"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "775011719",
                                                    "text": "Acho que já ajudei ela a procurar essa espada antes...",
                                                    "response": [
                                                        {
                                                            "id": "775011720",
                                                            "speaker": "Talalikhin",
                                                            "text": "#Então você lembra. Ela mencionou recentemente como vocês procuraram a espada junt{M#os}{F#as}. Ela parecia muito animada quando falou disso."
                                                        }
                                                    ]
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "775011713",
                                    "text": "Vocês estão trabalhando juntos em outra coisa?"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "775011734",
                    "text": "Não deve ter sido fácil para você também.",
                    "response": [
                        {
                            "id": "775011735",
                            "speaker": "Talalikhin",
                            "text": "Obrigado pela preocupação. Esse é o meu dever e darei o meu melhor."
                        }
                    ]
                }
            ]
        }
    ]
}