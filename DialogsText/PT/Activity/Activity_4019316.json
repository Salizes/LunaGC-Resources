    "dialogues": [
        {
            "id": "401931601",
            "speaker": "Inagi Hotomi",
            "text": "#Hmm? Você também notou esse pequeno youkai, {NICKNAME}?",
            "choices": [
                {
                    "id": "401931602",
                    "text": "Este também é um youkai?",
                    "response": [
                        {
                            "id": "401931604",
                            "speaker": "Inagi Hotomi",
                            "text": "Isso mesmo, embora pareça ter se tornado um recentemente — no momento, carece de poder e inteligência para falar. Ainda assim, parece ter sido atraído pela atmosfera festiva."
                        },
                        {
                            "id": "401931605",
                            "speaker": "???",
                            "text": "♪~~"
                        },
                        {
                            "id": "401931606",
                            "speaker": "Inagi Hotomi",
                            "text": "Hmm? Este pequeno... parece querer ver o Festival da Flor Mikawa com você. Se não me engano, ele te vê como um poderoso youkai ancião.",
                            "choices": [
                                {
                                    "id": "401931607",
                                    "text": "Então, deixe-me cumprir meu dever como um \"representante\"...",
                                    "response": [
                                        {
                                            "id": "401931609",
                                            "speaker": "???",
                                            "text": "♪~♪~♪~"
                                        },
                                        {
                                            "id": "401931610",
                                            "speaker": "Player",
                                            "text": "Como é? Por quê?"
                                        },
                                        {
                                            "id": "401931611",
                                            "speaker": "Inagi Hotomi",
                                            "text": "Hmm. Se eu tivesse que adivinhar, seria algo como... \"Conto com você!\""
                                        }
                                    ]
                                },
                                {
                                    "id": "401931608",
                                    "text": "E mostrar as atrações para meu pequeno \"júnior\"!"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "401931603",
                    "text": "Pensei que você fosse Ellin por um segundo..."
                }
            ]
        }
    ]
