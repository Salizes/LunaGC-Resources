{
    "talkId": "7115101",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Player": 8,
        "Wriothesley": 7
    },
    "dialogues": [
        {
            "id": "711510101",
            "speaker": "Wriothesley",
            "text": "#{NICKNAME}, eu tinha a sensação de que poderia te encontrar aqui. Ah... permita-me estender uma saudação tradicional de Liyue: Feliz Ritual de Lanternas.",
            "choices": [
                {
                    "id": "711510102",
                    "text": "Também soltei minha Lanterna Celeste.",
                    "response": [
                        {
                            "id": "711510104",
                            "speaker": "Wriothesley",
                            "text": "Nada mal, voou alto e brilhou bastante. Dá até vontade de comprar algumas para levar de volta para a Fortaleza Meropide."
                        },
                        {
                            "id": "711510111",
                            "speaker": "Wriothesley",
                            "text": "Pensando bem... Lanternas Celestes lançadas na Fortaleza de Meropide não voariam para o céu nem realizariam desejos. Só significariam mais trabalho para a equipe de limpeza."
                        },
                        {
                            "id": "711510103",
                            "speaker": "Player",
                            "text": "Sobre a foto de lembrança..."
                        },
                        {
                            "id": "711510112",
                            "speaker": "Wriothesley",
                            "text": "#Correto, pedi um para a Srta. Pingxi. Parece que ela realmente conseguiu um{F#a} fotógraf{M#o}{F#a} profissional."
                        },
                        {
                            "id": "711510113",
                            "speaker": "Wriothesley",
                            "text": "Vamos, então? Tire uma boa foto, pretendo pendurá-la na parede do meu escritório quando voltar para Fontaine.",
                            "choices": [
                                {
                                    "id": "711510105",
                                    "text": "Então, vamos começar a sessão de fotos.",
                                    "response": [
                                        {
                                            "id": "711510106",
                                            "speaker": "Wriothesley",
                                            "text": "#Claro. Preciso fazer alguma pose, ou...? Sugestões são bem-vindas, {NICKNAME}.",
                                            "choices": [
                                                {
                                                    "id": "711510109",
                                                    "text": "Algo mais sério.",
                                                    "response": [
                                                        {
                                                            "id": "711510114",
                                                            "speaker": "Player",
                                                            "text": "Essa pose está boa."
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "711510110",
                                                    "text": "Uma pose mais relaxada."
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "711510107",
                                    "text": "Espere um pouco...",
                                    "response": [
                                        {
                                            "id": "711510108",
                                            "speaker": "Wriothesley",
                                            "text": "Tem algo para resolver? Sem pressa, não estou com pressa."
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "711510103",
                    "text": "Sobre a foto de lembrança..."
                }
            ]
        }
    ]
}