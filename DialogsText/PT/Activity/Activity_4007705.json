{
    "talkId": "4007705",
    "total_dialogue_lines": 26,
    "speaker_counts": {
        "Player": 10,
        "Xinyan": 16
    },
    "dialogues": [
        {
            "id": "400770501",
            "speaker": "Xinyan",
            "text": "Me sinto inspirada para uma nova música...",
            "choices": [
                {
                    "id": "400770502",
                    "text": "Quer conversar?",
                    "response": [
                        {
                            "id": "400770503",
                            "speaker": "Xinyan",
                            "text": "Claro, com prazer.",
                            "choices": [
                                {
                                    "id": "400770506",
                                    "text": "Sobre os nossos amigos...",
                                    "response": [
                                        {
                                            "id": "400770507",
                                            "speaker": "Xinyan",
                                            "text": "Eu vou compartilhar essa aventura com meus amigos quando voltar. Quem sabe? Talvez até dê alguma nova ideia de ópera para Yunjin."
                                        },
                                        {
                                            "id": "400770508",
                                            "speaker": "Xinyan",
                                            "text": "Quanto a Xiangling, ela com certeza vai pensar num monte de sugestões quando eu mencionar qualquer coisa relacionada a comida."
                                        },
                                        {
                                            "id": "400770509",
                                            "speaker": "Xinyan",
                                            "text": "Você conhece ela, é uma profissional, sabe de tudo... Tipo fazer um ensopado sem uma panela. Eu gostaria de aprender com ela..."
                                        },
                                        {
                                            "id": "400770510",
                                            "speaker": "Xinyan",
                                            "text": "Eu preciso aprender alguns novos pratos antes que meus novos amigos visitem. Oh, Melão de Lavanda Assado com certeza será um deles!"
                                        }
                                    ]
                                },
                                {
                                    "id": "400770511",
                                    "text": "Sobre a música...",
                                    "response": [
                                        {
                                            "id": "400770512",
                                            "speaker": "Xinyan",
                                            "text": "#Você está desapontad{F#a}{M#o} que eu não toquei rock na miragem?"
                                        },
                                        {
                                            "id": "400770513",
                                            "speaker": "Player",
                                            "text": "De jeito nenhum."
                                        },
                                        {
                                            "id": "400770514",
                                            "speaker": "Xinyan",
                                            "text": "Uau, estou aliviada ao ouvir você dizer isso."
                                        },
                                        {
                                            "id": "400770515",
                                            "speaker": "Xinyan",
                                            "text": "Rock 'n' roll é o amor da minha vida, isso nunca mudará."
                                        },
                                        {
                                            "id": "400770516",
                                            "speaker": "Xinyan",
                                            "text": "Mas a música também é um meio para transmitir emoções. Ao invés de expressar minhas emoções, eu pensei que o que fiz era mais adequado a ocasião."
                                        },
                                        {
                                            "id": "400770517",
                                            "speaker": "Xinyan",
                                            "text": "Hehe, talvez agora eu também possa lhe chamar de alma amiga em nosso entendimento da música."
                                        }
                                    ]
                                },
                                {
                                    "id": "400770518",
                                    "text": "Sobre estas férias...",
                                    "response": [
                                        {
                                            "id": "400770519",
                                            "speaker": "Xinyan",
                                            "text": "Foi cheia de ação e super divertida!"
                                        },
                                        {
                                            "id": "400770520",
                                            "speaker": "Xinyan",
                                            "text": "Eu tenho que agradecer você e aquele bardo pelo convite."
                                        },
                                        {
                                            "id": "400770521",
                                            "speaker": "Xinyan",
                                            "text": "Me pergunto como os shows dele têm ido... Estou devendo uma a ele. Tenho que pensar numa forma de agradecê-lo depois."
                                        },
                                        {
                                            "id": "400770522",
                                            "speaker": "Player",
                                            "text": "Vamos pagar-lhe uma bebida."
                                        },
                                        {
                                            "id": "400770523",
                                            "speaker": "Xinyan",
                                            "text": "Excelente! Combinado!"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "400770504",
                    "text": "Não lhe incomodarei mais.",
                    "response": [
                        {
                            "id": "400770505",
                            "speaker": "Xinyan",
                            "text": "Bem, vá com tranquilidade.",
                            "choices": [
                                {
                                    "id": "400770506",
                                    "text": "Sobre os nossos amigos..."
                                },
                                {
                                    "id": "400770511",
                                    "text": "Sobre a música..."
                                },
                                {
                                    "id": "400770518",
                                    "text": "Sobre estas férias..."
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}