{
    "talkId": "7450708",
    "total_dialogue_lines": 49,
    "speaker_counts": {
        "Cabeça de Bongô": 6,
        "Observar Gardemek": 2,
        "Observar Srta. Gardetiqueta": 1,
        "Paimon": 25,
        "Player": 9,
        "Pyroalegria": 6
    },
    "dialogues": [
        {
            "id": "745070801",
            "speaker": "Paimon",
            "text": "Cabeça de Bongô! Pyroalegria! Quanto tempo! Paimon sentiu saudades de vocês!",
            "choices": [
                {
                    "id": "745070802",
                    "text": "Belisque nossos cogumigos!",
                    "response": [
                        {
                            "id": "745070803",
                            "speaker": "Cabeça de Bongô",
                            "text": "♪"
                        },
                        {
                            "id": "745070804",
                            "speaker": "Pyroalegria",
                            "text": "♫"
                        },
                        {
                            "id": "745070805",
                            "speaker": "Paimon",
                            "text": "Paimon quer segurar o Cabeça de Bongô e beliscar o Pyroalegria!"
                        },
                        {
                            "id": "745070806",
                            "speaker": "Cabeça de Bongô",
                            "text": "♪♪~"
                        },
                        {
                            "id": "745070807",
                            "speaker": "Pyroalegria",
                            "text": "♫♫~"
                        },
                        {
                            "id": "745070808",
                            "speaker": "Paimon",
                            "text": "Hã? Espera um momento aí..."
                        },
                        {
                            "id": "745070809",
                            "speaker": "Paimon",
                            "text": "Vocês dois parecem quase iguais, mas parece que... ficaram mais redondos!",
                            "choices": [
                                {
                                    "id": "745070810",
                                    "text": "Isso significa que estão comendo bem!",
                                    "response": [
                                        {
                                            "id": "745070812",
                                            "speaker": "Paimon",
                                            "text": "Bem, se continuarem comendo bem, talvez ficarão maiores que a gente um dia!"
                                        },
                                        {
                                            "id": "745070813",
                                            "speaker": "Paimon",
                                            "text": "Então, quando viajarmos juntos, Cabeça de Bongô pode nos levar em sua cabeça e sair voando pelos céus!"
                                        },
                                        {
                                            "id": "745070814",
                                            "speaker": "Paimon",
                                            "text": "E se o Cabeça de Bongô ficar cansado, então o Pyroalegria irá nos levar, ou então podemos encontrar um Animal de Carga e todos andarmos nele!"
                                        },
                                        {
                                            "id": "745070815",
                                            "speaker": "Cabeça de Bongô",
                                            "text": "♪♪♪!"
                                        },
                                        {
                                            "id": "745070816",
                                            "speaker": "Pyroalegria",
                                            "text": "♫♫♫!"
                                        },
                                        {
                                            "id": "745070817",
                                            "speaker": "Paimon",
                                            "text": "Parece que vocês estão ansiosos pela jornada, né?"
                                        },
                                        {
                                            "id": "745070818",
                                            "speaker": "Paimon",
                                            "text": "Quando o Orbe da Sabedoria for melhorado e os cogumigos puderem se mover mais livremente..."
                                        },
                                        {
                                            "id": "745070819",
                                            "speaker": "Paimon",
                                            "text": "#Onde deveríamos ir? {NICKNAME}, deveríamos começar a planejar?"
                                        }
                                    ]
                                },
                                {
                                    "id": "745070811",
                                    "text": "Isso significa que Haniyyah está cuidando bem deles!"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "745070820",
                    "text": "Vamos alimentar eles primeiro.",
                    "response": [
                        {
                            "id": "745070821",
                            "speaker": "Paimon",
                            "text": "Certo! Também temos um novo sabor de geleia desta vez. Qual sabor devemos escolher?",
                            "choices": [
                                {
                                    "id": "745070822",
                                    "text": "Use a Geleia de sabor de Peixe com Batatas Fritas.",
                                    "response": [
                                        {
                                            "id": "745070823",
                                            "speaker": "Cabeça de Bongô",
                                            "text": "♪~"
                                        },
                                        {
                                            "id": "745070824",
                                            "speaker": "Pyroalegria",
                                            "text": "♫~"
                                        },
                                        {
                                            "id": "745070825",
                                            "speaker": "Paimon",
                                            "text": "Paimon não imaginava que cogumelos gostariam de Peixe e Batatas Fritas!"
                                        },
                                        {
                                            "id": "745070826",
                                            "speaker": "Paimon",
                                            "text": "Acho que eles não são exigentes quanto ao que comem. Isso é bom! Um bom apetite é importante para ficar saudável!"
                                        },
                                        {
                                            "id": "745070837",
                                            "speaker": "Paimon",
                                            "text": "Hmm... sabe, já que aprendemos pratos novos em Fontaine, podemos falar com a Haniyyah e ajudá-la a fazer novos sabores para as geleias."
                                        }
                                    ]
                                },
                                {
                                    "id": "745070827",
                                    "text": "Usar a Geleia de sabor de café.",
                                    "response": [
                                        {
                                            "id": "745070828",
                                            "speaker": "Cabeça de Bongô",
                                            "text": "!"
                                        },
                                        {
                                            "id": "745070829",
                                            "speaker": "Pyroalegria",
                                            "text": "!"
                                        },
                                        {
                                            "id": "745070830",
                                            "speaker": "Paimon",
                                            "text": "Eles parecem ainda mais enérgicos agora!"
                                        },
                                        {
                                            "id": "745070831",
                                            "speaker": "Paimon",
                                            "text": "Hã, as geleias de café realmente possuem café?"
                                        }
                                    ]
                                },
                                {
                                    "id": "745070832",
                                    "text": "Usar a Geleia de sabor de Fonta.",
                                    "response": [
                                        {
                                            "id": "745070833",
                                            "speaker": "Cabeça de Bongô",
                                            "text": "?"
                                        },
                                        {
                                            "id": "745070834",
                                            "speaker": "Pyroalegria",
                                            "text": "?"
                                        },
                                        {
                                            "id": "745070835",
                                            "speaker": "Paimon",
                                            "text": "Uh, parece que estão prestes a sair flutuando!"
                                        },
                                        {
                                            "id": "745070836",
                                            "speaker": "Paimon",
                                            "text": "Então, eles não podem tomar coisas gaseificadas?"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "745070838",
                    "text": "E isso é...",
                    "response": [
                        {
                            "id": "745070839",
                            "speaker": "Paimon",
                            "text": "Parece um Gardemek que Turenna trouxe com ela."
                        },
                        {
                            "id": "745070840",
                            "speaker": "Paimon",
                            "text": "Ele estava brincando com os cogumigos enquanto estávamos fora?"
                        },
                        {
                            "id": "745070841",
                            "speaker": "Observar Gardemek",
                            "text": "(O Gardemek parece acenar conforme suas partes giram e fazem ruídos mecânicos baixos.)"
                        },
                        {
                            "id": "745070842",
                            "speaker": "Observar Gardemek",
                            "text": "(Apesar de não falar, ele emite um senso de... elegância, por algum motivo.)"
                        },
                        {
                            "id": "745070843",
                            "speaker": "Paimon",
                            "text": "Que educado! Paimon vai te dar um ótimo apelido!"
                        },
                        {
                            "id": "745070844",
                            "speaker": "Paimon",
                            "text": "Que tal... Srta. Gardetiqueta!"
                        },
                        {
                            "id": "745070845",
                            "speaker": "Observar Srta. Gardetiqueta",
                            "text": "(As partes visíveis do Gardemek brilham levemente com alegria.)"
                        },
                        {
                            "id": "745070846",
                            "speaker": "Paimon",
                            "text": "Ei! Parece que gostou do nome!"
                        },
                        {
                            "id": "745070847",
                            "speaker": "Paimon",
                            "text": "Os cogumelos vão ficar felizes de ter uma nova amiga como você, Srta. Gardetiqueta!"
                        }
                    ]
                },
                {
                    "id": "745070848",
                    "text": "Vamos sair por ora...",
                    "response": [
                        {
                            "id": "745070849",
                            "speaker": "Paimon",
                            "text": "Bem, viremos brincar com nossos cogumigos quando tivermos tempo, tudo bem?"
                        }
                    ]
                }
            ]
        }
    ]
}