{
    "talkId": "7055703",
    "total_dialogue_lines": 48,
    "speaker_counts": {
        "Horken": 33,
        "Player": 15
    },
    "dialogues": [
        {
            "id": "705570301",
            "speaker": "Horken",
            "text": "#Olá. Eu sou Horken, oficial da Companhia de Assuntos Gerais e membro da Companhia de Cavalaria. Posso lhe ajudar com algo além da peça, Cavaleir{F#a}{M#o} Honorável?",
            "choices": [
                {
                    "id": "705570302",
                    "text": "Me fale mais sobre a Companhia de Assuntos Gerais...",
                    "response": [
                        {
                            "id": "705570303",
                            "speaker": "Horken",
                            "text": "#Oh, você está interessad{F#a}{M#o} na Primeira Companhia? Nesse caso, deixe eu lhe dar uma visão geral..."
                        },
                        {
                            "id": "705570304",
                            "speaker": "Horken",
                            "text": "A Companhia de Assuntos Gerais é responsável por planejar e cuidar dos assuntos cotidianos de Mondstadt, como a produção econômica, regulamentos, e gestão da cidade."
                        },
                        {
                            "id": "705570305",
                            "speaker": "Horken",
                            "text": "Por causa disso, a maioria do trabalho envolve papelada. Como oficial, meu papel é ajudar o capitão Kaeya a coordenar a cooperação entre nossa companhia e a de Cavalaria.",
                            "choices": [
                                {
                                    "id": "705570306",
                                    "text": "Parece uma boa posição?",
                                    "response": [
                                        {
                                            "id": "705570308",
                                            "speaker": "Horken",
                                            "text": "Isso é verdade. O pagamento é bom, as horas são razoáveis, e no trabalho, lido com cidadãos amigáveis de Mondstadt. É bem agradável, física e mentalmente."
                                        },
                                        {
                                            "id": "705570309",
                                            "speaker": "Horken",
                                            "text": "Dito isso, se você tem algum amigo que queria se juntar aos Cavaleiros de Favonius, é melhor não pensar na Primeira Companhia.",
                                            "choices": [
                                                {
                                                    "id": "705570310",
                                                    "text": "O que você quer dizer?",
                                                    "response": [
                                                        {
                                                            "id": "705570312",
                                                            "speaker": "Horken",
                                                            "text": "No momento, priorizamos recrutar cavaleiros que sofreram ferimentos em combate e não podem mais atuar nas linhas de frente."
                                                        },
                                                        {
                                                            "id": "705570313",
                                                            "speaker": "Horken",
                                                            "text": "Quanto a funcionários administrativos de tempo integral, eles precisam passar por um exame profissional rigoroso. Para ser franco, mesmo aqueles que treinaram desde jovens raramente tem a chance de estudar um conhecimento tão especializado como esse."
                                                        },
                                                        {
                                                            "id": "705570314",
                                                            "speaker": "Horken",
                                                            "text": "Vagas confortáveis e bem pagas são algo que você ganha através de habilidades comprovadas e convicção. É assim que funciona.",
                                                            "choices": [
                                                                {
                                                                    "id": "705570315",
                                                                    "text": "Então você...",
                                                                    "response": [
                                                                        {
                                                                            "id": "705570316",
                                                                            "speaker": "Horken",
                                                                            "text": "Estou bem. No passado, durante um enfrentamento contra dois Olhos da Tempestade, as minhas pernas foram quebradas."
                                                                        },
                                                                        {
                                                                            "id": "705570317",
                                                                            "speaker": "Horken",
                                                                            "text": "Depois de anos me recuperando, caminhar não é mais um problema. Mas não consigo correr, nem lutar. Por isso acabei como um oficial."
                                                                        },
                                                                        {
                                                                            "id": "705570318",
                                                                            "speaker": "Player",
                                                                            "text": "Você já pensou em uma prótese?"
                                                                        },
                                                                        {
                                                                            "id": "705570319",
                                                                            "speaker": "Horken",
                                                                            "text": "Faz sentido."
                                                                        },
                                                                        {
                                                                            "id": "705570320",
                                                                            "speaker": "Horken",
                                                                            "text": "Se eu puder encontrar um modelo adequado, e os cavaleiros da linha de frente não se importarem em eu ser mais fraco que antes, eu gostaria de experimentar."
                                                                        },
                                                                        {
                                                                            "id": "705570321",
                                                                            "speaker": "Horken",
                                                                            "text": "Assim, mesmo que Hedwig volte a lutar ferozmente, posso pelo menos ficar de olho nela, e assim meus pais não se preocuparão mais."
                                                                        },
                                                                        {
                                                                            "id": "705570331",
                                                                            "speaker": "Horken",
                                                                            "text": "Sim. Nossas famílias moravam a um andar de distância. Mas quando Hedwig tinha sete anos, seus pais viajaram. Depois disso, algo parece ter acontecido. Nunca mais se ouviu falar deles."
                                                                        },
                                                                        {
                                                                            "id": "705570332",
                                                                            "speaker": "Horken",
                                                                            "text": "Por isso, minha família a criou. Ela ficou conosco até crescermos, achou um trabalho, e passou a viver sozinha."
                                                                        },
                                                                        {
                                                                            "id": "705570333",
                                                                            "speaker": "Horken",
                                                                            "text": "Mesmo minha família tendo cuidado dela como se fosse minha irmã mais velha, há vezes que quando os pais reais somem... o vazio que isso deixa não pode ser preenchido por mais nada."
                                                                        },
                                                                        {
                                                                            "id": "705570334",
                                                                            "speaker": "Horken",
                                                                            "text": "Eu acho que é por isso que ela admira tanto a comandante Gunnhildr. As duas.",
                                                                            "choices": [
                                                                                {
                                                                                    "id": "705570335",
                                                                                    "text": "Tão profundamente?",
                                                                                    "response": [
                                                                                        {
                                                                                            "id": "705570337",
                                                                                            "speaker": "Horken",
                                                                                            "text": "É só um palpite meu, na verdade..."
                                                                                        },
                                                                                        {
                                                                                            "id": "705570338",
                                                                                            "speaker": "Horken",
                                                                                            "text": "Primeiro, ela esperava que sua mãe fosse corajosa como a Cavaleira do Almeiro Vermelho, que o silêncio de seus pais fosse porque eles estavam lutando contra alguma força maléfica, ao invés de terem tido um final catastrófico"
                                                                                        },
                                                                                        {
                                                                                            "id": "705570339",
                                                                                            "speaker": "Horken",
                                                                                            "text": "E ela provavelmente queria se tornar forte como a Cavaleira de Dandelion. Forte o suficiente para um dia vencer todo obstáculo e viajar para encontrar seus pais."
                                                                                        },
                                                                                        {
                                                                                            "id": "705570340",
                                                                                            "speaker": "Horken",
                                                                                            "text": "Depois, a medida que a influência dos comandantes Gunnhildr cresceu nela, ela abandonou alguns desses pensamentos. O que restou foi só a convicção de lutar por Mondstadt."
                                                                                        },
                                                                                        {
                                                                                            "id": "705570341",
                                                                                            "speaker": "Horken",
                                                                                            "text": "É por isso que ela esforçou tanto para se juntar aos Cavaleiros de Favonius, e porque deu de tudo no dever sem considerar sua segurança. Ela fez de tudo para eliminar o perigo, onde quer que ele aparecesse."
                                                                                        },
                                                                                        {
                                                                                            "id": "705570342",
                                                                                            "speaker": "Horken",
                                                                                            "text": "E para impedir que ela se matasse, eu achei que esse irmão mais novo dela poderia ajudar. Por isso, também apostei a minha vida, e segui ela no serviço dos Cavaleiros de Favonius.",
                                                                                            "choices": [
                                                                                                {
                                                                                                    "id": "705570343",
                                                                                                    "text": "... Faz sentido.",
                                                                                                    "response": [
                                                                                                        {
                                                                                                            "id": "705570345",
                                                                                                            "speaker": "Horken",
                                                                                                            "text": "Enfim, eu já tagarelei muito. Obrigado por me ouvir. Foi uma honra."
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "705570346",
                                                                                                            "speaker": "Horken",
                                                                                                            "text": "Se você quiser saber mais sobre a Companhia de Assuntos Gerais, pode falar comigo sempre. Posso preparar alguns documentos e passar por todos os detalhes, bem como os regulamentos relevantes."
                                                                                                        }
                                                                                                    ]
                                                                                                },
                                                                                                {
                                                                                                    "id": "705570344",
                                                                                                    "text": "Ainda não tô entendendo bem..."
                                                                                                }
                                                                                            ]
                                                                                        }
                                                                                    ]
                                                                                },
                                                                                {
                                                                                    "id": "705570336",
                                                                                    "text": "Eu não tô entendendo o que você quer dizer..."
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                },
                                                                {
                                                                    "id": "705570322",
                                                                    "text": "E Hedwig?",
                                                                    "response": [
                                                                        {
                                                                            "id": "705570323",
                                                                            "speaker": "Horken",
                                                                            "text": "O caso dela é diferente. Ela transferiu-se da Companhia de Cavalaria para a Companhia de Assuntos Gerais."
                                                                        },
                                                                        {
                                                                            "id": "705570324",
                                                                            "speaker": "Horken",
                                                                            "text": "Na época, sua unidade descobriu dois Guardas das Ruínas escondidos por arbustos na estrada. Ao tentar eliminar a ameaça, os mecanismos se ativaram."
                                                                        },
                                                                        {
                                                                            "id": "705570325",
                                                                            "speaker": "Horken",
                                                                            "text": "Ela e dois camaradas garantiram a fuga da unidade, chamaram por reforços, e mantiveram o local até que a comandante Gunnhildr chegasse."
                                                                        },
                                                                        {
                                                                            "id": "705570326",
                                                                            "speaker": "Horken",
                                                                            "text": "Os outros dois precisaram de mais de um ano para se recuperarem. Hedwig retornou para o seu dever só com três meses, e então, ficou determinada a eliminar a ameaça completamente, passando a investigar a área ao redor desses Guardas das Ruínas."
                                                                        },
                                                                        {
                                                                            "id": "705570327",
                                                                            "speaker": "Horken",
                                                                            "text": "Isso a levou para um domínio pequeno, mas extremamente perigoso. Outra luta brutal aconteceu, e ela só escapou com a ajuda da comandante Gunnhildr."
                                                                        },
                                                                        {
                                                                            "id": "705570328",
                                                                            "speaker": "Horken",
                                                                            "text": "Dessa vez... metade de seus órgãos internos foram destruídos. Foi um milagre ela ter sobrevivido. Ela precisará de pelo menos uns cinco anos de recuperação. As honrarias que ela recebeu não aliviaram a dor que isso causou aos meus pais."
                                                                        }
                                                                    ]
                                                                },
                                                                {
                                                                    "id": "705570329",
                                                                    "text": "Seus pais conhecem Hedwig?"
                                                                },
                                                                {
                                                                    "id": "705570330",
                                                                    "text": "Vocês parecem próximos..."
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "705570311",
                                                    "text": "É por que não há muitas vagas?"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "705570307",
                                    "text": "Você não parece muito estressado com o trabalho."
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "705570347",
                    "text": "Por enquanto nada. Até mais!",
                    "response": [
                        {
                            "id": "705570348",
                            "speaker": "Horken",
                            "text": "Cuide-se."
                        }
                    ]
                }
            ]
        }
    ]
}