{
    "talkId": "7565402",
    "total_dialogue_lines": 33,
    "speaker_counts": {
        "Kaedehara Kazuha": 19,
        "Player": 14
    },
    "dialogues": [
        {
            "id": "756540201",
            "speaker": "Kaedehara Kazuha",
            "text": "O Rolinho da Sorte que recebi no Grande Santuário Narukami disse que uma Boa Sorte estará comigo e que eu devo esperar um reencontro."
        },
        {
            "id": "756540202",
            "speaker": "Kaedehara Kazuha",
            "text": "#Parece que o reencontro era com você. Já faz um tempo, {NICKNAME}.",
            "choices": [
                {
                    "id": "756540203",
                    "text": "Estamos aqui parar tirar fotos da Cidade de Inazuma.",
                    "response": [
                        {
                            "id": "756540205",
                            "speaker": "Kaedehara Kazuha",
                            "text": "Ah, uma busca elegante. Tirar fotos do cenário que viu é se lembrar da jornada que se teve até então."
                        },
                        {
                            "id": "756540206",
                            "speaker": "Player",
                            "text": "E quanto a você, Kazuha?"
                        },
                        {
                            "id": "756540207",
                            "speaker": "Kaedehara Kazuha",
                            "text": "Atualmente fiz planos para encontrar o Sr. Nakanishi na casa de chá para discutir a cerimônia do chá. Ele possui muito conhecimento em disciplinas relevantes, e é um regular por aqui."
                        },
                        {
                            "id": "756540208",
                            "speaker": "Player",
                            "text": "Você também é um especialista?"
                        },
                        {
                            "id": "756540209",
                            "speaker": "Kaedehara Kazuha",
                            "text": "Estudei por um tempo em minha juventude, mas minha sabedoria naquela época era bem rasa. Ultimamente, ao revisitá-los durante meus estudos, ando achando ainda mais fascinantes."
                        },
                        {
                            "id": "756540210",
                            "speaker": "Kaedehara Kazuha",
                            "text": "Por exemplo, as nações se diferenciam em suas manifestações de tais cerimônias. Para Inazuma, enfatizamos o espírito da \"pureza\" e \"tranquilidade\"."
                        },
                        {
                            "id": "756540211",
                            "speaker": "Kaedehara Kazuha",
                            "text": "A Vila Qiaoying de Liyue também produz chá, e as pessoas daquela terra gostam de \"harmonia\" e \"autenticidade\"."
                        },
                        {
                            "id": "756540212",
                            "speaker": "Kaedehara Kazuha",
                            "text": "Essas diferenças também refletem os diferentes hábitos de vida de duas pessoas. Muito fascinante.",
                            "choices": [
                                {
                                    "id": "756540213",
                                    "text": "Você é um verdadeiro amante do aprendizado.",
                                    "response": [
                                        {
                                            "id": "756540215",
                                            "speaker": "Kaedehara Kazuha",
                                            "text": "Haha, dificilmente... Na verdade, não retornei aqui apenas para isso."
                                        },
                                        {
                                            "id": "756540216",
                                            "speaker": "Kaedehara Kazuha",
                                            "text": "Essa é a terra onde nasci, e assim continua, embora eu já tenha sido obrigado a sair."
                                        },
                                        {
                                            "id": "756540217",
                                            "speaker": "Kaedehara Kazuha",
                                            "text": "Retornar ocasionalmente, ver as pessoas que eu conhecia na juventude, passar um tempo em lugares familiares..."
                                        },
                                        {
                                            "id": "756540218",
                                            "speaker": "Kaedehara Kazuha",
                                            "text": "Sinto como se eu ainda tivesse raízes aqui, que alivia as preocupações de minhas peregrinações."
                                        },
                                        {
                                            "id": "756540219",
                                            "speaker": "Kaedehara Kazuha",
                                            "text": "Usar Aparelhos Fotográficos para imortalizar tais memórias é uma ótima ideia. Afinal de contas, nós, andarilhos, precisamos de uma âncora."
                                        },
                                        {
                                            "id": "756540220",
                                            "speaker": "Kaedehara Kazuha",
                                            "text": "Enfim, chega de falar de mim. Não quero ocupar o seu tempo, mas se você precisar do meu, só dizer."
                                        },
                                        {
                                            "id": "756540221",
                                            "speaker": "Player",
                                            "text": "Nesse caso, chega junto para a foto, por favor!"
                                        },
                                        {
                                            "id": "756540222",
                                            "speaker": "Kaedehara Kazuha",
                                            "text": "Claro. Que tipo de pose eu deveria fazer?",
                                            "choices": [
                                                {
                                                    "id": "756540223",
                                                    "text": "Uma pose elegante.",
                                                    "response": [
                                                        {
                                                            "id": "756540226",
                                                            "speaker": "Kaedehara Kazuha",
                                                            "text": "Certo. Assim serve?",
                                                            "choices": [
                                                                {
                                                                    "id": "756540227",
                                                                    "text": "Perfeito. Diga xiiiis!"
                                                                },
                                                                {
                                                                    "id": "756540228",
                                                                    "text": "Vamos usar a nossa pose relaxada ao invés disso.",
                                                                    "response": [
                                                                        {
                                                                            "id": "756540229",
                                                                            "speaker": "Kaedehara Kazuha",
                                                                            "text": "Tudo bem!"
                                                                        }
                                                                    ]
                                                                },
                                                                {
                                                                    "id": "756540230",
                                                                    "text": "Acho que a dos pensamentos é melhor.",
                                                                    "response": [
                                                                        {
                                                                            "id": "756540231",
                                                                            "speaker": "Kaedehara Kazuha",
                                                                            "text": "Tudo bem!"
                                                                        }
                                                                    ]
                                                                },
                                                                {
                                                                    "id": "756540232",
                                                                    "text": "Aliás, vamos com a pose elegante.",
                                                                    "response": [
                                                                        {
                                                                            "id": "756540233",
                                                                            "speaker": "Kaedehara Kazuha",
                                                                            "text": "Tudo bem!"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "756540224",
                                                    "text": "Uma pose... relaxada."
                                                },
                                                {
                                                    "id": "756540225",
                                                    "text": "Talvez mostrando você em pensamentos profundos."
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "756540214",
                                    "text": "Um homem de gostos elegantes."
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "756540204",
                    "text": "Estamos procurando por pessoas para tirar fotos juntos."
                }
            ]
        }
    ]
}