{
    "talkId": "7154031",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Player": 5,
        "Tighnari": 10
    },
    "dialogues": [
        {
            "id": "715403101",
            "speaker": "Tighnari",
            "text": "O que eu deveria pegar...?",
            "choices": [
                {
                    "id": "715403102",
                    "text": "Tighnari, esse envelope de presente é para você.",
                    "response": [
                        {
                            "id": "715403103",
                            "speaker": "Tighnari",
                            "text": "#Ah, eu não esperava te ver aqui, {NICKNAME}. Obrigado pelo envelope — é adorável."
                        },
                        {
                            "id": "715403104",
                            "speaker": "Player",
                            "text": "Aproveitando o festival?"
                        },
                        {
                            "id": "715403105",
                            "speaker": "Tighnari",
                            "text": "Cyno e eu nos divertimos muito. Comemos muita comida deliciosa e compramos alguns presentes."
                        },
                        {
                            "id": "715403106",
                            "speaker": "Tighnari",
                            "text": "Infelizmente, o Porto fica um pouco lotado nessa época do ano. Se eu ficar perto da multidão por tempo demais, meus ouvidos começam a doer."
                        },
                        {
                            "id": "715403107",
                            "speaker": "Tighnari",
                            "text": "Então eu vim aqui descansar."
                        },
                        {
                            "id": "715403108",
                            "speaker": "Tighnari",
                            "text": "Cyno disse que precisava ficar um tempo sozinho para pensar em alguma coisa.",
                            "choices": [
                                {
                                    "id": "715403109",
                                    "text": "Ah... algum tipo de caso?",
                                    "response": [
                                        {
                                            "id": "715403111",
                                            "speaker": "Tighnari",
                                            "text": "Não, acho que não..."
                                        },
                                        {
                                            "id": "715403112",
                                            "speaker": "Tighnari",
                                            "text": "Ele continuou resmungando sobre \"envelopes de presente\", então provavelmente ele está tentando pensar em uma nova piada..."
                                        },
                                        {
                                            "id": "715403113",
                                            "speaker": "Tighnari",
                                            "text": "Como você sequer faz um piada com algo assim...?"
                                        }
                                    ]
                                },
                                {
                                    "id": "715403110",
                                    "text": "Algo a ver com trabalho?"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "715403114",
                    "text": "Te vejo por aí.",
                    "response": [
                        {
                            "id": "715403115",
                            "speaker": "Tighnari",
                            "text": "Tchau! Vou procurar por Cyno. *Suspiro* Só espero que ele não esteja se sentindo inspirado demais hoje..."
                        }
                    ]
                }
            ]
        }
    ]
}