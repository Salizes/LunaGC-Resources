            "dialogues": [
                {
                    "id": "745270201",
                    "speaker": "Player",
                    "text": "Vamos continuar com a sessão de fotos!"
                }
            ]
        },
        {
            "id": "7452703",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "745270301",
                    "speaker": "Player",
                    "text": "Me dê um momento para pensar."
                }
            ]
        },
        {
            "id": "7452704",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "745270401",
                    "speaker": "Escoffier",
                    "text": "#Ah, é você, {NICKNAME}.",
                    "choices": [
                        {
                            "id": "745270402",
                            "text": "Há quanto tempo, Escoffier.",
                            "response": [
                                {
                                    "id": "745270404",
                                    "speaker": "Escoffier",
                                    "text": "Não vou para a cozinha hoje. Estou aqui como provadora."
                                },
                                {
                                    "id": "745270405",
                                    "speaker": "Escoffier",
                                    "text": "Savanna está bolando algo novo, e pediu para eu provar. Dito isso, essa é a quinta vez que ela refaz esse prato."
                                },
                                {
                                    "id": "745270406",
                                    "speaker": "Escoffier",
                                    "text": "Se não é a textura dos ingredientes sendo afetada por causa do controle de temperatura, então é o aroma das especiarias dominando por causa de seu excesso."
                                },
                                {
                                    "id": "745270407",
                                    "speaker": "Player",
                                    "text": "Precisa como sempre."
                                },
                                {
                                    "id": "745270408",
                                    "speaker": "Escoffier",
                                    "text": "Claro! Culinária é uma ciência, e nossa amizade não vai mudar isso. Na verdade, nossa amizade e nosso dever para com nossos clientes exige que eu seja rigorosa.",
                                    "choices": [
                                        {
                                            "id": "745270409",
                                            "text": "Na verdade, eu tenho um pequeno pedido...",
                                            "response": [
                                                {
                                                    "id": "745270411",
                                                    "speaker": "Escoffier",
                                                    "text": "... Numa hora como essa? Se as fotos vão ser públicas, que tal você procurar outro momento?"
                                                },
                                                {
                                                    "id": "745270412",
                                                    "speaker": "Escoffier",
                                                    "text": "Precisamos montar o cenário com atenção, e ajustar a iluminação e o ângulo para termos os melhores resultados...",
                                                    "choices": [
                                                        {
                                                            "id": "745270413",
                                                            "text": "É só uma foto comemorativa.",
                                                            "response": [
                                                                {
                                                                    "id": "745270415",
                                                                    "speaker": "Escoffier",
                                                                    "text": "... Certo. Há ainda um tempo antes da sexta tentativa mesmo."
                                                                },
                                                                {
                                                                    "id": "745270416",
                                                                    "speaker": "Escoffier",
                                                                    "text": "Nesse caso, vamos ver se suas lentes ou aquele prato novo vão aparecer."
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "745270414",
                                                            "text": "Também quero experimentar essa lente nova."
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "745270410",
                                            "text": "Você se importaria se eu tirasse uma foto sua?"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "745270403",
                            "text": "Você está preparando uma receita nova?"
                        }
                    ]
                }
            ]
        }
    ]
