    },
    "talks": [
        {
            "id": "7450603",
            "objective": "Caminhe pela praça comercial da Corte de Fontaine",
            "dialogues": []
        },
        {
            "id": "7450602",
            "objective": "Fale com Lepine-Pauline",
            "dialogues": [
                {
                    "id": "745060201",
                    "speaker": "Lepine-Pauline",
                    "text": "Foto-foto-foto, imprime-imprime-imprime... din-din-din-dinheiro de montão!"
                },
                {
                    "id": "745060202",
                    "speaker": "Lepine-Pauline",
                    "text": "#Eita! {M#Esses dois}{F#Essas duas} são importantes!"
                },
                {
                    "id": "745060203",
                    "speaker": "Lepine-Pauline",
                    "text": "Olá, vocês aí. Que tal ter uma fotografia tirada de vocês?"
                },
                {
                    "id": "745060204",
                    "speaker": "Paimon",
                    "text": "Hã...? Ela tá falando da gente? Por que ela quer nossa foto?",
                    "choices": [
                        {
                            "id": "745060205",
                            "text": "Ela provavelmente só quer uma lembrança.",
                            "response": [
                                {
                                    "id": "745060207",
                                    "speaker": "Paimon",
                                    "text": "#Hehehe... Paimon acha que é melhor a gente se acostumar com o tratamento de celebridade, hein? Não dá para culpar os fãs por quererem uma foto de {M#seus heróis}{F#suas heroínas}!"
                                },
                                {
                                    "id": "745060208",
                                    "speaker": "Paimon",
                                    "text": "#Mas se isso for para qualquer coisa fora sua uso pessoal, somos legalmente permitid{M#os}{F#as} a te cobrar... Espera, como eles chamam isso aqui? Uma taxa de comparecimento? Uma taxa de ensaio fotográfico?"
                                },
                                {
                                    "id": "745060209",
                                    "speaker": "Lepine-Pauline",
                                    "text": "Absolutamente! É só uma honra poder fotografar a super dupla aventureira. Que tal um milhão e meio de Mora?"
                                },
                                {
                                    "id": "745060210",
                                    "speaker": "Paimon",
                                    "text": "Claro, parece bom!"
                                },
                                {
                                    "id": "745060211",
                                    "speaker": "Paimon",
                                    "text": "...Espera, quanto você disse? Um milhão e meio de Mora?! Paimon ouviu isso certo?"
                                },
                                {
                                    "id": "745060212",
                                    "speaker": "Paimon",
                                    "text": "Isso é muita Mora só por uma fotografia... Talvez um pouco demais? A gente vale tanto assim?",
                                    "choices": [
                                        {
                                            "id": "745060213",
                                            "text": "Manda ver! Tire quantas fotos quiser!",
                                            "response": [
                                                {
                                                    "id": "745060215",
                                                    "speaker": "Lepine-Pauline",
                                                    "text": "Ha! Vocês estão exagerando. Esses meros um milhão e meio são só o início!"
                                                },
                                                {
                                                    "id": "745060216",
                                                    "speaker": "Lepine-Pauline",
                                                    "text": "#Se tiver interesse em trabalhar comigo como fotógraf{M#os}{F#as}, poderiam levar para casa potencialmente até nove algarismos! Cada clique, din-din no bolso!"
                                                },
                                                {
                                                    "id": "745060217",
                                                    "speaker": "Paimon",
                                                    "text": "Nove algarismos? Isso é... espera... cada milhar são três algarismos, mais um e um.. então um milhão, são sete, mais dois são... dez milhões, cem milhões... CEM MILHÕES?!",
                                                    "choices": [
                                                        {
                                                            "id": "745060218",
                                                            "text": "Você tá só inventando número.",
                                                            "response": [
                                                                {
                                                                    "id": "745060220",
                                                                    "speaker": "Paimon",
                                                                    "text": "É! Isso parece tão maluco que nem Paimon cai nessa!"
                                                                },
                                                                {
                                                                    "id": "745060221",
                                                                    "speaker": "Paimon",
                                                                    "text": "Que tipo de esquema é esse, hein? Você vai usar umas celebridades para dar golpe em gente inocente?"
                                                                },
                                                                {
                                                                    "id": "745060222",
                                                                    "speaker": "Lepine-Pauline",
                                                                    "text": "Dar golpe em pessoas inocentes! Ha, você tirou as palavras de minha boca!"
                                                                },
                                                                {
                                                                    "id": "745060223",
                                                                    "speaker": "Lepine-Pauline",
                                                                    "text": "Mas você entendeu tudo ao contrário — meu objetivo aqui é livrar Teyvat de todos que estão por aí tentando enganar pessoas inocentes. Me ajudem, e vocês receberão um grande bônus!"
                                                                },
                                                                {
                                                                    "id": "745060224",
                                                                    "speaker": "Paimon",
                                                                    "text": "Uau, calma aí! Parece que você pulou algumas etapas... Como que você saiu de fotografia para... a luta contra o crime?"
                                                                },
                                                                {
                                                                    "id": "745060225",
                                                                    "speaker": "Lepine-Pauline",
                                                                    "text": "Bem, tem tudo a ver com um problema importante que passa normalmente despercebido dos Gardes: reconhecimento de alvo."
                                                                },
                                                                {
                                                                    "id": "745060226",
                                                                    "speaker": "Lepine-Pauline",
                                                                    "text": "O senso comum diz que os Gardemeks querem lutar contra o crime, a primeira coisa que precisam fazer é identificar quem é e quem não é o criminoso. Certo?"
                                                                },
                                                                {
                                                                    "id": "745060227",
                                                                    "speaker": "Lepine-Pauline",
                                                                    "text": "Mas o que acontece quando um Gardemek confunde um cidadão honesto com um criminoso? Ou vê alguém empunhando uma arma em público, mas falha em marcar essa pessoa como uma ameaça em potencial? Então vocês têm um grande problema!"
                                                                },
                                                                {
                                                                    "id": "745060228",
                                                                    "speaker": "Lepine-Pauline",
                                                                    "text": "Pense nos pobres pescadores cujas varas de pescar são confundidas com lanças! Ou o bandido espertinho que carrega um cano de metal para bater nas vítimas, mas é considerando um encanador comum!"
                                                                },
                                                                {
                                                                    "id": "745060229",
                                                                    "speaker": "Paimon",
                                                                    "text": "Ok... Justo, você tá fazendo um pouco de sentido agora..."
                                                                },
                                                                {
                                                                    "id": "745060230",
                                                                    "speaker": "Lepine-Pauline",
                                                                    "text": "Ótimo. Ok, então digamos que eu me disfarce de gato, ou cachorro, ou passarinho, ou pombo — ou talvez uma Foquinha Rotunda, por que não? Então estou andando pelas ruas da cidade como um funcionário de parque de diversões fugindo e um Gardemek me vê. Como acha que ia responder?",
                                                                    "choices": [
                                                                        {
                                                                            "id": "745060231",
                                                                            "text": "Desculpe, como chegamos nos parques de diversões?",
                                                                            "response": [
                                                                                {
                                                                                    "id": "745060233",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "Assim você tá trapaceando!"
                                                                                },
                                                                                {
                                                                                    "id": "745060234",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "Um Gardemek não vai fazer alguma coisa contra um bichinho fofo. Além disso, que tipo de Foquinha Rotunda sequer ia querer vir à cidade mesmo..."
                                                                                },
                                                                                {
                                                                                    "id": "745060235",
                                                                                    "speaker": "Lepine-Pauline",
                                                                                    "text": "Bingo! Resposta certa."
                                                                                },
                                                                                {
                                                                                    "id": "745060236",
                                                                                    "speaker": "Lepine-Pauline",
                                                                                    "text": "Gardemeks são incapazes de registrar gatos, cachorros, pássaros, pombos — e, claro, Foquinhas Rotundas — como alvos em potencial. Seu sistema de reconhecimento de imagem na verdade os ignora completamente."
                                                                                },
                                                                                {
                                                                                    "id": "745060237",
                                                                                    "speaker": "Lepine-Pauline",
                                                                                    "text": "Na verdade, é bem lógico se parar para pensar. Remover todas as entidades de risco quase nulo do banco de dados de alvo aumenta o desempenho na maioria das situações."
                                                                                },
                                                                                {
                                                                                    "id": "745060238",
                                                                                    "speaker": "Lepine-Pauline",
                                                                                    "text": "Mas aqui está uma citação de uma reportagem recente no Pássaro a Vapor: \"Vários ladrões de olhos aguçados que perceberam uma falha nos sistemas de detecção dos Gardemeks se disfarçaram de Foquinhas Rotundas durante a execução de seus crimes\"..."
                                                                                },
                                                                                {
                                                                                    "id": "745060239",
                                                                                    "speaker": "Lepine-Pauline",
                                                                                    "text": "Completamente cegos às Foquinhas de mentira, os Gardemeks não tentaram intervir nos roubos cometidos pela gangue.",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "745060240",
                                                                                            "text": "Que bandidos sabidinhos!",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "745060242",
                                                                                                    "speaker": "Paimon",
                                                                                                    "text": "Espera, então isso aconteceu mesmo? E os Gardemeks não capturaram eles?"
                                                                                                },
                                                                                                {
                                                                                                    "id": "745060243",
                                                                                                    "speaker": "Paimon",
                                                                                                    "text": "Ok, isso é bem ousado... mas também meio horripilante. E se eles cansarem de roubos pequenos e forem para algo pior? Eles podem se safar de tudo!"
                                                                                                },
                                                                                                {
                                                                                                    "id": "745060244",
                                                                                                    "speaker": "Lepine-Pauline",
                                                                                                    "text": "Exatamente. E é por isso que temos que lutar contra esses criminosos no domínio da tecnologia. Se transformou em um cabo-de-guerra entre os disfarces e nossas capacidades de reconhecimento de imagem."
                                                                                                },
                                                                                                {
                                                                                                    "id": "745060245",
                                                                                                    "speaker": "Lepine-Pauline",
                                                                                                    "text": "E eu, Lepine-Pauline, especialista em tecnologia de reconhecimento de imagem anticrime, estou determinada a fazer minha parte pelo futuro de Fontaine livre da criminalidade!"
                                                                                                },
                                                                                                {
                                                                                                    "id": "745060246",
                                                                                                    "speaker": "Lepine-Pauline",
                                                                                                    "text": "Atualmente, estou em processo de coletar amostras de imagens. Quando tiver uma seleção grande suficiente, vou usá-la para desenvolver um simples, porém poderoso e altamente preciso algoritmo de reconhecimento de imagem que funciona com um pequeno módulo de processamento gráfico..."
                                                                                                },
                                                                                                {
                                                                                                    "id": "745060247",
                                                                                                    "speaker": "Lepine-Pauline",
                                                                                                    "text": "Qualquer Mecautômato com esse módulo instalado conseguirá reconhecer instantaneamente pessoas usando disfarces e avaliar a ameaça criminosa que representam."
                                                                                                },
                                                                                                {
                                                                                                    "id": "745060248",
                                                                                                    "speaker": "Lepine-Pauline",
                                                                                                    "text": "Se tudo seguir o plano, o Palais Mermonia avançará na chance de ter isso instalado em cada Gardemek na cidade... é a oportunidade de negócios de uma vida inteira!",
                                                                                                    "choices": [
                                                                                                        {
                                                                                                            "id": "745060249",
                                                                                                            "text": "E tudo isso começa com você tirando fotos nas ruas?",
                                                                                                            "response": [
                                                                                                                {
                                                                                                                    "id": "745060251",
                                                                                                                    "speaker": "Paimon",
                                                                                                                    "text": "Paimon está tendo um déjà vu... Paimon adivinha, você é uma pesquisadora caseira que prefere ficar na cidade, limitando sua amostragem potencial..."
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "745060252",
                                                                                                                    "speaker": "Paimon",
                                                                                                                    "text": "E a razão para você querer trabalhar com a gente é porque podemos ir à natureza te ajudar a conseguir todas as outras fotos que precisa. Certo?"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "745060253",
                                                                                                                    "speaker": "Lepine-Pauline",
                                                                                                                    "text": "Uau, haha... Acertou de novo! Até o mínimo detalhe... Parece que a super dupla aventureira já viu de tudo."
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "745060254",
                                                                                                                    "speaker": "Lepine-Pauline",
                                                                                                                    "text": "O que me dizem? Se juntem ao meu projeto, se tornem especialistas de tecnologia de reconhecimento de imagem anticrime e podemos expor cada criminoso bem-vestido em Fontaine!"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "745060255",
                                                                                                                    "speaker": "Lepine-Pauline",
                                                                                                                    "text": "Crucialmente, com sua ajuda, podemos construir um bom projeto de reconhecimento de imagem anticrime para levar as capacidades da tecnologia e fiscalização da lei de Fontaine ao próximo nível! Todos saem ganhando!"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "745060256",
                                                                                                                    "speaker": "Paimon",
                                                                                                                    "text": "Hmm... Isso parece mesmo ser por uma boa causa..."
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "745060257",
                                                                                                                    "speaker": "Paimon",
                                                                                                                    "text": "Esqueça a Mora — não podemos ficar de braços cruzados... Há criminosos por aí manchando a reputação das Foquinhas Rotundas e Paimon não vai deixar isso barato!",
                                                                                                                    "choices": [
                                                                                                                        {
                                                                                                                            "id": "745060258",
                                                                                                                            "text": "Justiça pelas Foquinhas Rotundas!",
                                                                                                                            "response": [
                                                                                                                                {
                                                                                                                                    "id": "745060260",
                                                                                                                                    "speaker": "Lepine-Pauline",
                                                                                                                                    "text": "#Ótimo! E exatamente assim, bem-vind{M#os}{F#as} à equipe!"
                                                                                                                                },
                                                                                                                                {
                                                                                                                                    "id": "745060261",
                                                                                                                                    "speaker": "Lepine-Pauline",
                                                                                                                                    "text": "Ok, pegue isso — É um Coletor de Amostra de Reconhecimento de Imagem. Ele contém equipamento de registro e análise que eu mesma projetei, completo com um guia de usuário!"
                                                                                                                                },
                                                                                                                                {
                                                                                                                                    "id": "745060262",
                                                                                                                                    "speaker": "Lepine-Pauline",
                                                                                                                                    "text": "Eu já olhei por muitas imagens de Fontaine inteira para determinar as características principais das amostras que eu gostaria de coletar. Tudo que vocês precisam fazer é seguir o guia, conseguir as imagens e trazê-las de volta para mim. Simples!"
                                                                                                                                },
                                                                                                                                {
                                                                                                                                    "id": "745060263",
                                                                                                                                    "speaker": "Lepine-Pauline",
                                                                                                                                    "text": "Vamos começar o show, pessoal. Temos que vencer o cabo-de-guerra contra os malvados... e ganhar aqueles pedidos caros do Palais Mermonia!"
                                                                                                                                }
                                                                                                                            ]
                                                                                                                        },
                                                                                                                        {
                                                                                                                            "id": "745060259",
                                                                                                                            "text": "Bônus de nove algarismos, aqui vamos nós!"
                                                                                                                        }
                                                                                                                    ]
                                                                                                                }
                                                                                                            ]
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "745060250",
                                                                                                            "text": "Acho que você pode ter problemas pra conseguir todas as amostras..."
                                                                                                        }
                                                                                                    ]
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "745060241",
                                                                                            "text": "Malignos!"
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "745060232",
                                                                            "text": "Um disfarce? Não quer dizer uma fantasia?"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "745060219",
                                                            "text": "Tenho dúvidas sobre sua sinceridade."
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "745060214",
                                            "text": "Isso parece bom demais para ser verdade..."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "745060206",
                            "text": "Mas se for para uso comercial, a gente pode cobrar ela..."
                        }
                    ]
                }
            ]
        }
    ]
}