    "talks": [
        {
            "id": "7567101",
            "objective": "Fale com o estudioso",
            "dialogues": [
                {
                    "id": "756710101",
                    "speaker": "Basima, a Quinta",
                    "text": "Chirp chirp! Coo coo! Chirp chirp chirp!"
                },
                {
                    "id": "756710102",
                    "speaker": "Paimon",
                    "text": "Hã... o que você está fazendo?",
                    "choices": [
                        {
                            "id": "756710103",
                            "text": "Você está mandando... algum tipo de mensagem secreta?",
                            "response": [
                                {
                                    "id": "756710105",
                                    "speaker": "Basima, a Quinta",
                                    "text": "Tipo isso! É uma técnica que uso para me comunicar com os passarinhos!"
                                },
                                {
                                    "id": "756710106",
                                    "speaker": "Basima, a Quinta",
                                    "text": "Oh, eu esqueci de cumprimentar vocês. Bem como a frase essencial."
                                },
                                {
                                    "id": "756710107",
                                    "speaker": "Basima, a Quinta",
                                    "text": "Saudações, transeuntes! Eu, Basima a Quinta, pesquisadora Amurta, comerciante em ascensão, e especialista em animais fofinhos, saúdo vocês calorosamente!"
                                },
                                {
                                    "id": "756710108",
                                    "speaker": "Basima, a Quinta",
                                    "text": "Por favor. Relaxa teu corpo, limpa tua mente e ouça-me atentamente, pois tenho uma questão de suma importância para compartilhar contigo—"
                                },
                                {
                                    "id": "756710109",
                                    "speaker": "Paimon",
                                    "text": "Passarinhos são super fofinhos?"
                                },
                                {
                                    "id": "756710110",
                                    "speaker": "Basima, a Quinta",
                                    "text": "Sim! Isso mesmo! Meus parabéns, vocês também foram cativados pelos passarinhos!"
                                },
                                {
                                    "id": "756710111",
                                    "speaker": "Paimon",
                                    "text": "Que estranho. Paimon não sabe porque, mas quando viu o jogo nessa mesa, essa frase brotou na cabeça dela."
                                },
                                {
                                    "id": "756710112",
                                    "speaker": "Paimon",
                                    "text": "#Isso parece familiar para você, {NICKNAME}?",
                                    "choices": [
                                        {
                                            "id": "756710113",
                                            "text": "A gente já conheceu essa senhorita antes?",
                                            "response": [
                                                {
                                                    "id": "756710114",
                                                    "speaker": "Basima, a Quinta",
                                                    "text": "#Exato! E não foi só um breve encontro. É ótimo ver vocês chei{F#as}{M#os} de energia como sempre!"
                                                },
                                                {
                                                    "id": "756710117",
                                                    "speaker": "Basima, a Quinta",
                                                    "text": "Enfim, você gostaria de experimentar esse jogo? É a 17ª edição, a terceira geração de \"Bola de Passarinho Cling-clang\"!"
                                                },
                                                {
                                                    "id": "756710118",
                                                    "speaker": "Basima, a Quinta",
                                                    "text": "Enquanto você relaxa desfrutando o jogo, você também consegue ouvir histórias maravilhosas sobre os passarinhos, e o maior Passarinho Antigo das Penas Escarlates triunfando sobre as gaivotas!"
                                                },
                                                {
                                                    "id": "756710119",
                                                    "speaker": "Paimon",
                                                    "text": "Legal! Sempre fomos fãs de jogos relaxantes!",
                                                    "choices": [
                                                        {
                                                            "id": "756710120",
                                                            "text": "Vamos com tudo!",
                                                            "response": [
                                                                {
                                                                    "id": "756710122",
                                                                    "speaker": "Basima, a Quinta",
                                                                    "text": "Certo! Eu espero que vocês encontrem a jogatina que combina melhor com vocês. Assim o jogo será mais divertido!"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "756710121",
                                                            "text": "Vamos!"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "756710115",
                                            "text": "Acho que é hora de começar com aquilo de passarinhos são fofinhos.",
                                            "response": [
                                                {
                                                    "id": "756710116",
                                                    "speaker": "Basima, a Quinta",
                                                    "text": "Sim! E mesmo que você não lembre do passado agora, não tem problema. O que importa é aproveitar o presente..."
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "756710104",
                            "text": "Ou falando em códigos?"
                        }
                    ]
                }
            ]
        }
    ]
}