    "talks": [
        {
            "id": "7414009",
            "objective": "Entre no espelho misterioso",
            "dialogues": []
        },
        {
            "id": "7414010",
            "objective": "Siga até o local designado",
            "dialogues": []
        },
        {
            "id": "7414011",
            "objective": "Fale com Canotila",
            "dialogues": [
                {
                    "id": "741401101",
                    "speaker": "Canotila",
                    "text": "Ei, nos encontramos de novo. Hã? Você tá com Paimon dessa vez?"
                },
                {
                    "id": "741401102",
                    "speaker": "Paimon",
                    "text": "Hã? Paimon tava aqui quando meditamos da última vez..."
                },
                {
                    "id": "741401103",
                    "speaker": "Canotila",
                    "text": "É mesmo? Eu não lembro."
                },
                {
                    "id": "741401104",
                    "speaker": "Canotila",
                    "text": "Não importa. É tudo graças a vocês que encontrei o local do espelho misterioso e das flores prestes a desabrochar, e aprofundei minha compreensão deste lugar."
                },
                {
                    "id": "741401105",
                    "speaker": "Paimon",
                    "text": "Hmm... Falar com Canotila é tão confuso quanto sempre."
                },
                {
                    "id": "741401106",
                    "speaker": "Filhote",
                    "text": "Au!"
                },
                {
                    "id": "741401107",
                    "speaker": "Canotila",
                    "text": "Hã? Mas..."
                },
                {
                    "id": "741401108",
                    "speaker": "Filhote",
                    "text": "Au?"
                },
                {
                    "id": "741401109",
                    "speaker": "Canotila",
                    "text": "Ok, ok! Já sei."
                },
                {
                    "id": "741401110",
                    "speaker": "Paimon",
                    "text": "(Hã...? Ela tá falando com o filhote? Será que Melusines sempre se comunicam com cachorros?)"
                },
                {
                    "id": "741401111",
                    "speaker": "Player",
                    "text": "(Que inacreditável.)"
                },
                {
                    "id": "741401112",
                    "speaker": "Canotila",
                    "text": "Bem, acho que é isso. Vejo vocês da próxima vez. Hunf! Mesmo se você dissesse isso, ainda vou voltar para brincar com você."
                },
                {
                    "id": "741401113",
                    "speaker": "Canotila",
                    "text": "#Vamos lá, Sr{F#ta}. {NICKNAME}, Paimon!"
                }
            ]
        },
        {
            "id": "7414013",
            "objective": "Fale com Canotila",
            "dialogues": [
                {
                    "id": "741401301",
                    "speaker": "Canotila",
                    "text": "Bem. Aqui vamos nós de novo..."
                },
                {
                    "id": "741401302",
                    "speaker": "Paimon",
                    "text": "O que é isso?"
                },
                {
                    "id": "741401303",
                    "speaker": "Canotila",
                    "text": "#Me sinto muito mal por dizer isso já que todos são tão legais comigo, tod{M#os}{F#as} vocês, mas..."
                },
                {
                    "id": "741401304",
                    "speaker": "Canotila",
                    "text": "Você não sente que o mundo é tão assustadoramente entendiante? Você não acha que os mundos nos livros são muito mais bonitos?",
                    "choices": [
                        {
                            "id": "741401305",
                            "text": "Também acho.",
                            "response": [
                                {
                                    "id": "741401306",
                                    "speaker": "Paimon",
                                    "text": "Sério? Você acha isso também, é?"
                                },
                                {
                                    "id": "741401311",
                                    "speaker": "Canotila",
                                    "text": "Ainda sinto que o mundo no Livro da Revelação é o mais belo de todos. Há pétalas cobertas de orvalho por todo lugar, e finalmente fiz amizade com um filhotinho."
                                },
                                {
                                    "id": "741401312",
                                    "speaker": "Paimon",
                                    "text": "Filhotinho... Falando nisso, Canotila, você pode se comunicar com cães?"
                                },
                                {
                                    "id": "741401313",
                                    "speaker": "Canotila",
                                    "text": "Hã? Claro que não. Mas, os filhotes no Livro da Revelação são especiais. Ou talvez, eu seja especial?"
                                },
                                {
                                    "id": "741401314",
                                    "speaker": "Canotila",
                                    "text": "Estive meditando para viajar para outros mundos nos livros, então um dia, o latido comum de cachorro virou algo que eu podia entender."
                                },
                                {
                                    "id": "741401315",
                                    "speaker": "Canotila",
                                    "text": "Quanto ao que conversamos... Ele me pediu para ir embora e nunca voltar."
                                },
                                {
                                    "id": "741401316",
                                    "speaker": "Canotila",
                                    "text": "Mas... Ainda quero ver os girassóis desabrocharem..."
                                },
                                {
                                    "id": "741401317",
                                    "speaker": "Player",
                                    "text": "..."
                                },
                                {
                                    "id": "741401318",
                                    "speaker": "Paimon",
                                    "text": "É mesmo... Cuide-se, Canotila! Estamos indo nessa!"
                                }
                            ]
                        },
                        {
                            "id": "741401307",
                            "text": "Eu não acho.",
                            "response": [
                                {
                                    "id": "741401308",
                                    "speaker": "Canotila",
                                    "text": "É mesmo...? Talvez seja isso. Não sou normal."
                                }
                            ]
                        },
                        {
                            "id": "741401309",
                            "text": "Não faz diferença para mim.",
                            "response": [
                                {
                                    "id": "741401310",
                                    "speaker": "Canotila",
                                    "text": "#Parece que {M#o Sr.}{F#a Srta.} {NICKNAME} é {M#o}{F#a} mais forte de todos."
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}