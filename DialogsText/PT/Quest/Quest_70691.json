    "talks": [
        {
            "id": "7069101",
            "objective": "Fale com Klee",
            "dialogues": [
                {
                    "id": "706910101",
                    "speaker": "Klee",
                    "text": "#Cavaleir{F#a}{M#o} Honorável! Aqui!"
                },
                {
                    "id": "706910102",
                    "speaker": "Klee",
                    "text": "Eu acabei de fazer novas amigas! Quer brincar com a gente?"
                },
                {
                    "id": "706910103",
                    "speaker": "Klee",
                    "text": "As crianças mais velhas nos ensinaram um jogo novo chamado Corrida na Neve."
                },
                {
                    "id": "706910104",
                    "speaker": "Klee",
                    "text": "As regras não são difíceis. É só um tipo especial de esconde-esconde!"
                },
                {
                    "id": "706910105",
                    "speaker": "Paimon",
                    "text": "Uau, Klee, Yaoyao e Sayu viraram amigas!"
                },
                {
                    "id": "706910106",
                    "speaker": "Paimon",
                    "text": "Esse nome... Hmmm, é como se fosse uma outra versão do Labirinto de Vento? Deve ser bem divertido de jogar com vocês!",
                    "choices": [
                        {
                            "id": "706910107",
                            "text": "Esconde-esconde? Que legal!",
                            "response": [
                                {
                                    "id": "706910109",
                                    "speaker": "Sayu",
                                    "text": "ATCHIM! Apesar de não estar tão frio assim no acampamento, já estou me sentindo com sono..."
                                },
                                {
                                    "id": "706910110",
                                    "speaker": "Sayu",
                                    "text": "#Hmm, meus olhos estão me enganando, ou ess{F#as}{M#es} são {NICKNAME} e Paimon?"
                                },
                                {
                                    "id": "706910111",
                                    "speaker": "Yaoyao",
                                    "text": "#Seus olhos estão bem. É só {NICKNAME} e Paimon.",
                                    "choices": [
                                        {
                                            "id": "706910112",
                                            "text": "Oi, Yaoyao e Sayu!",
                                            "response": [
                                                {
                                                    "id": "706910114",
                                                    "speaker": "Klee",
                                                    "text": "Boa ideia! Quando começarmos a nos divertir, não vamos ter sono!"
                                                },
                                                {
                                                    "id": "706910115",
                                                    "speaker": "Yaoyao",
                                                    "text": "E aquela super séria Senhorita Aoi não disse que passar mais tempo na Espinha do Dragão ia ser bom para suas habilidades, Sayu?"
                                                },
                                                {
                                                    "id": "706910116",
                                                    "speaker": "Sayu",
                                                    "text": "Hã, não acredito que vocês lembram disso!"
                                                },
                                                {
                                                    "id": "706910117",
                                                    "speaker": "Sayu",
                                                    "text": "Certo, mas se eu perder para esses companheiros aventureiros, ou para aquele super Ninken, vai ser bem mais difícil ficar de bobeira no futuro!"
                                                },
                                                {
                                                    "id": "706910118",
                                                    "speaker": "Sayu",
                                                    "text": "Parece que vou ter que arregaçar minhas mangas nessa viagem."
                                                },
                                                {
                                                    "id": "706910119",
                                                    "speaker": "Yaoyao",
                                                    "text": "Eu bolei uma nova receita de cozido de vegetais e carne com Pimenta de Jueyun e pimenta em pó. Acabei de fazer!"
                                                },
                                                {
                                                    "id": "706910120",
                                                    "speaker": "Yaoyao",
                                                    "text": "Pegue um pouco antes de começar o esconde-esconde, prometo que você não vai sentir frio durante o jogo!"
                                                },
                                                {
                                                    "id": "706910121",
                                                    "speaker": "Sayu",
                                                    "text": "Que legal! Vou tomar toda uma tigela!"
                                                },
                                                {
                                                    "id": "706910122",
                                                    "speaker": "Paimon",
                                                    "text": "Paimon quer também!"
                                                },
                                                {
                                                    "id": "706910123",
                                                    "speaker": "Klee",
                                                    "text": "Certo, então vamos começar nosso esconde-esconde aqui na Espinha do Dragão!"
                                                },
                                                {
                                                    "id": "706910124",
                                                    "speaker": "Paimon",
                                                    "text": "Uau! A Espinha do Dragão tá coberta de neve. Paimon vai se esconder, ninguém vai encontrar ela!"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "706910113",
                                            "text": "Querem brincar de Esconde-esconde?"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "706910108",
                            "text": "Eu adoraria conhecer suas novas amigas, Klee..."
                        }
                    ]
                }
            ]
        }
    ]
