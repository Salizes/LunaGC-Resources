    "talks": [
        {
            "id": "7406307",
            "objective": "",
            "dialogues": [
                {
                    "id": "740630701",
                    "speaker": "Grainville",
                    "text": "Todos os regulamentos e procedimentos trabalhistas devem ser seguidos na Área de Produção — isso significa segurança em primeiro lugar. Se não há mais perguntas, não atrapalhem meu trabalho."
                }
            ]
        },
        {
            "id": "7406302",
            "objective": "Fale com Nelly",
            "dialogues": [
                {
                    "id": "740630201",
                    "speaker": "Paimon",
                    "text": "Hã? O que um Aparelho Fotográfico tá fazendo aqui?"
                },
                {
                    "id": "740630202",
                    "speaker": "Nelly",
                    "text": "\"Onde há notícias, há Aparelhos Fotográficos\". Nunca ouviu essa antes?",
                    "choices": [
                        {
                            "id": "740630203",
                            "text": "Acho que sim.",
                            "response": [
                                {
                                    "id": "740630204",
                                    "speaker": "Nelly",
                                    "text": "Mas eu acabei de inventar isso, onde você ouviu?"
                                },
                                {
                                    "id": "740630205",
                                    "speaker": "Nelly",
                                    "text": "Bem, nada de novo sob o sol. Não importa o que eu diga ou escreva, sempre é apenas uma paródia dos outros."
                                },
                                {
                                    "id": "740630208",
                                    "speaker": "Player",
                                    "text": "O Aparelho Fotográfico está aqui, então cadê as notícias?"
                                },
                                {
                                    "id": "740630209",
                                    "speaker": "Nelly",
                                    "text": "Notícias... São como pescaria. Requer paciência e fazer o julgamento certo na hora certa. É assim que você fisga o peixão..."
                                },
                                {
                                    "id": "740630210",
                                    "speaker": "Nelly",
                                    "text": "Oh! Digo... É assim que você fisga um furo. Hã? Espera, isso não parece certo! Ugh! Esqueça!",
                                    "choices": [
                                        {
                                            "id": "740630211",
                                            "text": "Pareceu um pouco amador. Você não é uma jornalista, é?",
                                            "response": [
                                                {
                                                    "id": "740630212",
                                                    "speaker": "Nelly",
                                                    "text": "Então você se enganou sobre mim, heh. Porque eu sou uma jornalista amadora."
                                                },
                                                {
                                                    "id": "740630222",
                                                    "speaker": "Paimon",
                                                    "text": "Enfim, por que tem uma jornalista amadora aqui?"
                                                },
                                                {
                                                    "id": "740630223",
                                                    "speaker": "Nelly",
                                                    "text": "Estou aqui para completar o projeto designado para mim: capturar os momentos mais vívidos dos guardas da Fortaleza Meropide com meu Aparelho Fotográfico!"
                                                },
                                                {
                                                    "id": "740630224",
                                                    "speaker": "Nelly",
                                                    "text": "Mas perdi muito tempo preenchendo os documentos necessários... deem uma olhada, vocês vão ver na hora."
                                                },
                                                {
                                                    "id": "740630225",
                                                    "speaker": "Black Screen",
                                                    "text": "#Nelly tira uma pilha de documentos, todos cheios de várias cláusulas e assinaturas. Só de olhar, você já fica tont{F#a}{M#o}..."
                                                },
                                                {
                                                    "id": "740630226",
                                                    "speaker": "Nelly",
                                                    "text": "Quando terminei toda a papelada, perdi os guardas no turno deles! Ou, em termos de pesca, não há peixes para fisgar agora..."
                                                },
                                                {
                                                    "id": "740630227",
                                                    "speaker": "Paimon",
                                                    "text": "Hã? Mas têm guardas no turno agora."
                                                },
                                                {
                                                    "id": "740630228",
                                                    "speaker": "Nelly",
                                                    "text": "Mas eu quero fisgar uma Coleção de Platina. Não acho que Função Básica ou Purificador Hydro são impactantes o suficiente... por isso, mesmo completando meu projeto, outros fotógrafos podem achar que ele não é bom.",
                                                    "choices": [
                                                        {
                                                            "id": "740630229",
                                                            "text": "Pare de ser tão exigente, ou vai voltar de mãos abanando.",
                                                            "response": [
                                                                {
                                                                    "id": "740630233",
                                                                    "speaker": "Nelly",
                                                                    "text": "Sim, tem razão. Preciso admitir minhas habilidades limitadas e tentar parar de pegar peixes que são areia demais pro meu caminhão... *Choro* Eu sou uma pescadora inútil... Oh, eu quis dizer, jornalista amadora."
                                                                },
                                                                {
                                                                    "id": "740630234",
                                                                    "speaker": "Nelly",
                                                                    "text": "Certo, chega de eu ficar me lamuriando, é hora de animação! Se vocês não se importarem... podiam me ajudar com um favorzinho? Por favor! Eu vou pagar!"
                                                                },
                                                                {
                                                                    "id": "740630235",
                                                                    "speaker": "Paimon",
                                                                    "text": "Uau! Que rápido! Depende do favor. Que tal dizer o que é primeiro?"
                                                                },
                                                                {
                                                                    "id": "740630236",
                                                                    "speaker": "Nelly",
                                                                    "text": "Aquele guarda ali, Grainville. Segundo meu julgamento, o valor de uma notícia sua entre os guardas é o equivalente a um Controlador entre Mecautômatos de manutenção..."
                                                                },
                                                                {
                                                                    "id": "740630237",
                                                                    "speaker": "Nelly",
                                                                    "text": "Devo conseguir escrever um bom relatório com ele como sujeito, e isso deve impedir que eu seja criticada, pelo menos."
                                                                },
                                                                {
                                                                    "id": "740630238",
                                                                    "speaker": "Nelly",
                                                                    "text": "Mas ele se recusa a vir aqui! Vocês podiam levar ele a um local adequado para eu dar um clique?",
                                                                    "choices": [
                                                                        {
                                                                            "id": "740630239",
                                                                            "text": "Por que você mesma não explica isso pra ele?",
                                                                            "response": [
                                                                                {
                                                                                    "id": "740630240",
                                                                                    "speaker": "Nelly",
                                                                                    "text": "Eu tenho certeza que se ele souber sobre a câmera, vai focar nela e ficar rígido, isso é o mesmo que uma foto artificial, não?"
                                                                                },
                                                                                {
                                                                                    "id": "740630243",
                                                                                    "speaker": "Nelly",
                                                                                    "text": "Deixe-me pensar. Acho que é melhor desligarmos o amplificador, reportar isso para Grainville como um defeito e pedir para ele dar uma olhada."
                                                                                },
                                                                                {
                                                                                    "id": "740630244",
                                                                                    "speaker": "Nelly",
                                                                                    "text": "Assim, eu com certeza vou poder capturar um momento vívido de um guarda da Fortaleza Meropide trabalhando!"
                                                                                },
                                                                                {
                                                                                    "id": "740630245",
                                                                                    "speaker": "Nelly",
                                                                                    "text": "Completar meu projeto depende disso! Estou contando com vocês! Por favor, me ajudem!"
                                                                                },
                                                                                {
                                                                                    "id": "740630246",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "#Não parece tão difícil, {NICKNAME}. Que tal a gente ajudar ela?"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "740630241",
                                                                            "text": "Você não pode só levar a câmera até ele?",
                                                                            "response": [
                                                                                {
                                                                                    "id": "740630242",
                                                                                    "speaker": "Nelly",
                                                                                    "text": "Bem... a vista é melhor daqui. E se ele vir a câmera, tenho certeza que vai focar nela e me deixar sem nada, só com um monte de poses rígidas..."
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "740630230",
                                                            "text": "Pode ir esperar sentada então, fui!",
                                                            "response": [
                                                                {
                                                                    "id": "740630231",
                                                                    "speaker": "Nelly",
                                                                    "text": "Vocês vão embora? Mesmo? Não vão me ajudar?"
                                                                },
                                                                {
                                                                    "id": "740630232",
                                                                    "speaker": "Paimon",
                                                                    "text": "Bem... a gente não pode conjurar uma Coleção de Platina do nada para você!"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "740630213",
                                            "text": "Esqueça as notícias, também gosto de pescar.",
                                            "response": [
                                                {
                                                    "id": "740630214",
                                                    "speaker": "Nelly",
                                                    "text": "Sério? Isso é perfeito! Na verdade, eu sou apenas uma pescadora novata, e tenho um monte de perguntas, mas não sei a quem pedir conselhos. Por exemplo, se você fisgar um Mecaprotetor e ele morder... O que você faria?",
                                                    "choices": [
                                                        {
                                                            "id": "740630215",
                                                            "text": "Só solte ele.",
                                                            "response": [
                                                                {
                                                                    "id": "740630219",
                                                                    "speaker": "Nelly",
                                                                    "text": "Entendi, entendi, então é assim que você resolveria. Hmm, é uma referência muito valiosa. Vou me lembrar disso."
                                                                },
                                                                {
                                                                    "id": "740630220",
                                                                    "speaker": "Nelly",
                                                                    "text": "#Hã? Por que vocês estão falando de pesca? Vocês são {F#boas}{M#bons} em guiar uma conversa! Parece que ainda tenho muito a aprender como jornalista amadora..."
                                                                },
                                                                {
                                                                    "id": "740630221",
                                                                    "speaker": "Paimon",
                                                                    "text": "Mas foi você que falou de pesca!"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "740630216",
                                                            "text": "Dê uma lição nele e mostre quem manda."
                                                        },
                                                        {
                                                            "id": "740630217",
                                                            "text": "Cozinhe ele para Paimon.",
                                                            "response": [
                                                                {
                                                                    "id": "740630218",
                                                                    "speaker": "Paimon",
                                                                    "text": "#Opa! Paimon acredita mesmo nas suas habilidades culinárias, {NICKNAME}. Mas não importa por onde olhe, aquilo lá não se come!"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "740630206",
                            "text": "Não.",
                            "response": [
                                {
                                    "id": "740630207",
                                    "speaker": "Nelly",
                                    "text": "Oh! Bem, vocês ouviram agora! Não esqueçam que se acabarem usando isso em outro lugar, devem me citar como fonte! Eu!"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7406303",
            "objective": "Desligue o amplificador",
            "dialogues": [
                {
                    "id": "740630301",
                    "speaker": "Nelly",
                    "text": "Eu tenho que tirar uma foto tão boa que os outros fotógrafos vão passar a me respeitar!"
                },
                {
                    "id": "740630302",
                    "speaker": "Nelly",
                    "text": "Maldição! Eu ainda quero a Coleção de Platina..."
                }
            ]
        },
        {
            "id": "7406304",
            "objective": "Fale com o guarda",
            "dialogues": [
                {
                    "id": "740630401",
                    "speaker": "Paimon",
                    "text": "Oi, a gente encontrou um amplificador com defeito... ele tá ali."
                },
                {
                    "id": "740630402",
                    "speaker": "Grainville",
                    "text": "De novo? Que estranho... Clynes acabou de consertar. Parece que ele nem é tão bom assim em consertar as coisas como eu. Tudo que basta é dar umas porradas nas máquinas e pronto, problema resolvido."
                },
                {
                    "id": "740630403",
                    "speaker": "Grainville",
                    "text": "Obrigado, darei uma olhada."
                },
                {
                    "id": "740630404",
                    "speaker": "Paimon",
                    "text": "Obrigada!"
                }
            ]
        },
        {
            "id": "7406306",
            "objective": "Espere até que o guarda chegue ao local designado",
            "dialogues": [
                {
                    "id": "740630601",
                    "speaker": "Grainville",
                    "text": "O que está errado? Hmm..."
                }
            ]
        },
        {
            "id": "7406305",
            "objective": "Fale com Nelly",
            "dialogues": [
                {
                    "id": "740630501",
                    "speaker": "Nelly",
                    "text": "Finalmente completei meu projeto! Sou uma jornalista agora! Obrigada!"
                },
                {
                    "id": "740630502",
                    "speaker": "Paimon",
                    "text": "Você deve ter tirado uma foto vívida mesmo."
                },
                {
                    "id": "740630503",
                    "speaker": "Nelly",
                    "text": "Sim, checa só.",
                    "choices": [
                        {
                            "id": "740630504",
                            "text": "Não parece muito vívida, mas é artística.",
                            "response": [
                                {
                                    "id": "740630505",
                                    "speaker": "Paimon",
                                    "text": "Paimon não entende bulhufas de arte..."
                                },
                                {
                                    "id": "740630508",
                                    "speaker": "Paimon",
                                    "text": "Usar isso aqui não dá problema?"
                                },
                                {
                                    "id": "740630509",
                                    "speaker": "Nelly",
                                    "text": "O que tem de errado com isso? Eu acho que é ótimo! Tenho certeza que ninguém ia esperar uma foto como essa! Todo mundo vai ficar boquiaberto..."
                                },
                                {
                                    "id": "740630510",
                                    "speaker": "Paimon",
                                    "text": "Paimon não entende mesmo o seu padrão de crítica..."
                                },
                                {
                                    "id": "740630511",
                                    "speaker": "Nelly",
                                    "text": "Oh, se chama \"significado simbólico sobre substância\". Todos os fotógrafos experientes vão entender quando eu enviar essa foto!"
                                },
                                {
                                    "id": "740630512",
                                    "speaker": "Nelly",
                                    "text": "Enfim, obrigada, aqui está. Seria ótimo se tivéssemos a chance de conversar num local de pesca na próxima vez!"
                                }
                            ]
                        },
                        {
                            "id": "740630506",
                            "text": "É tão vívida que parece que vai começar a se mover a qualquer momento.",
                            "response": [
                                {
                                    "id": "740630507",
                                    "speaker": "Paimon",
                                    "text": "Hmm, Paimon pode acabar ficando tonta se olhar por mais tempo..."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7406300",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "740630004",
                    "speaker": "Nelly",
                    "text": "Hehe! Funcionou!"
                },
                {
                    "id": "740630005",
                    "speaker": "Paimon",
                    "text": "Vá em frente e desligue o amplificador."
                },
                {
                    "id": "740630006",
                    "speaker": "Paimon",
                    "text": "Depois, reportamos a Grainville e dizemos a ele que tem algo errado com o amplificador, certo?"
                },
                {
                    "id": "740630007",
                    "speaker": "Paimon",
                    "text": "Depois disso, tudo dependerá de Nelly. Vamos esperar e ver."
                }
            ]
        }
    ]
