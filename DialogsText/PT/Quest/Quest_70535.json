    "talks": [
        {
            "id": "7053502",
            "objective": "Vá para a Biblioteca dos Cavaleiros de Favonius",
            "dialogues": [
                {
                    "id": "705350201",
                    "speaker": "Klee",
                    "text": "Ok, entendi!"
                },
                {
                    "id": "705350202",
                    "speaker": "Klee",
                    "text": "Mas... peixe é mais gostoso quando acabou de ser explodido. Grelhe eles sobre fogo e eles vão ficar ainda mais crocantes e cheirar muuuuuito bem!"
                },
                {
                    "id": "705350203",
                    "speaker": "Lisa",
                    "text": "Não se preocupe, Jean... me informou de tudo há um tempo."
                },
                {
                    "id": "705350204",
                    "speaker": "Lisa",
                    "text": "Então fiz alguns pedidos no Caçador de Cervos. Durante os próximos dias, os chefs deles vão preparar os melhores peixes frescos do lago e cozinhá-los imediatamente."
                },
                {
                    "id": "705350205",
                    "speaker": "Lisa",
                    "text": "Peixe assim que fica pronto servido com as especiarias favoritas de Klee e minhas sobremesas especialmente preparadas... Hehe, tenho certeza que será tão delicioso quando o que você pega."
                },
                {
                    "id": "705350206",
                    "speaker": "Klee",
                    "text": "Ok! Então eu vou confiar no seu gosto, Lisa!"
                },
                {
                    "id": "705350207",
                    "speaker": "Klee",
                    "text": "Prometo que vou ficar na cidade e brincar de Encontro Explosivo de Dodoco! Eu não vou fazer Pesca Explosiva ou causar problemas para o amigo de Albedo!"
                },
                {
                    "id": "705350208",
                    "speaker": "Klee",
                    "text": "#Enfim, vou procurar {M#pelo Sr.}{F#pela Sra.} Cavaleir{F#a}{M#o} Honorável e Paimon agora!"
                },
                {
                    "id": "705350209",
                    "speaker": "Paimon",
                    "text": "Hehe, tem alguém procurando pela gente?",
                    "choices": [
                        {
                            "id": "705350210",
                            "text": "É bem raro ver vocês juntas.",
                            "response": [
                                {
                                    "id": "705350212",
                                    "speaker": "Klee",
                                    "text": "#{M#Sr. Cavaleiro}{F#Srta. Cavaleira} Honorável e Paimon!"
                                },
                                {
                                    "id": "705350213",
                                    "speaker": "Klee",
                                    "text": "Klee estava pensando em vocês agora mesmo, e vocês apareceram! Como fizeram isso? Oh! Vocês ouviram os pensamentos de Klee com mágica?!"
                                },
                                {
                                    "id": "705350214",
                                    "speaker": "Lisa",
                                    "text": "Oh? Fofura e Paimon, vocês chegaram na hora certa. Parece que não terei que escrever uma carta para você agora.",
                                    "choices": [
                                        {
                                            "id": "705350215",
                                            "text": "Os desejos de Klee nos invocaram aqui!",
                                            "response": [
                                                {
                                                    "id": "705350217",
                                                    "speaker": "Paimon",
                                                    "text": "A gente tinha um tempo nas mãos e queria procurar por algo para ler na biblioteca... Enfim, o que é \"Encontro Explosivo de Dodoco\"? Parece muito mais divertido do que ler um livro!"
                                                },
                                                {
                                                    "id": "705350218",
                                                    "speaker": "Klee",
                                                    "text": "É um novo jogo que Lisa fez para mim! A gente pensou no nome juntas. Você é incrível, Paimon! Você lembrou do nome tão depressa!"
                                                },
                                                {
                                                    "id": "705350219",
                                                    "speaker": "Paimon",
                                                    "text": "Opa opa, você pode fazer jogos, Lisa? Paimon pensava que você era só do tipo que tinha a inteligência de livros."
                                                },
                                                {
                                                    "id": "705350220",
                                                    "speaker": "Lisa",
                                                    "text": "Hehe, eu meramente tirei inspiração de Explogumelo, um jogo de quando eu era uma estudante. Não tive que fazer muita coisa."
                                                },
                                                {
                                                    "id": "705350221",
                                                    "speaker": "Lisa",
                                                    "text": "Contanto que a gente mantenha Klee feliz durante estas circunstâncias únicas, estou disposta a fazer quantos jogos ela quiser."
                                                },
                                                {
                                                    "id": "705350222",
                                                    "speaker": "Player",
                                                    "text": "Circunstâncias únicas?"
                                                },
                                                {
                                                    "id": "705350223",
                                                    "speaker": "Paimon",
                                                    "text": "Oh, agora que Paimon lembrou, Klee mencionou um amigo de Albedo, né? Alguma coisa aconteceu em Mondstadt?"
                                                },
                                                {
                                                    "id": "705350224",
                                                    "speaker": "Lisa",
                                                    "text": "Não é tão sério, mas a situação ainda precisa ser lidada com cuidado."
                                                },
                                                {
                                                    "id": "705350225",
                                                    "speaker": "Lisa",
                                                    "text": "Recentemente, espécies de peixes nativas de Sumeru começaram a aparecer no Lago de Sidra. Permitir que se espalhem colocaria o equilíbrio ecológico das águas de Mondstadt em risco."
                                                },
                                                {
                                                    "id": "705350226",
                                                    "speaker": "Lisa",
                                                    "text": "Felizmente, Klee percebeu uns peixes que nunca tinha visto antes enquanto fugia para brincar. Ela pegou alguns e mostrou eles a Kaeya."
                                                },
                                                {
                                                    "id": "705350227",
                                                    "speaker": "Lisa",
                                                    "text": "Se não fosse por Klee, receio que maioria das espécies nativas já teriam recuado quando cidadãos comuns entendessem totalmente a situação."
                                                },
                                                {
                                                    "id": "705350228",
                                                    "speaker": "Lisa",
                                                    "text": "E se uma mudança ocorrer no ecossistema aquático, poderia muito bem afetar a qualidade da água no Lago de Sidra. Consequentemente, toda a indústria de vinho de Mondstadt poderia estar em apuros... e isso é uma grande ameaça à nossa economia."
                                                },
                                                {
                                                    "id": "705350229",
                                                    "speaker": "Klee",
                                                    "text": "Hehe, eu salvei o dia! Eu fui elogiada até pela Mestre Jean!",
                                                    "choices": [
                                                        {
                                                            "id": "705350230",
                                                            "text": "Bom trabalho, Klee!",
                                                            "response": [
                                                                {
                                                                    "id": "705350232",
                                                                    "speaker": "Paimon",
                                                                    "text": "Então foi isso que aconteceu... Que bom que Klee percebeu os peixes antes que as coisas saíssem do controle."
                                                                },
                                                                {
                                                                    "id": "705350233",
                                                                    "speaker": "Lisa",
                                                                    "text": "A Equipe de Investigação enviou alguns membros para inspecionar o Lago de Sidra e procurar a origem das espécies invasoras."
                                                                },
                                                                {
                                                                    "id": "705350234",
                                                                    "speaker": "Lisa",
                                                                    "text": "Para evitar incomodar esses invasores, Klee tem que guardar suas queridas bombas por um tempo."
                                                                },
                                                                {
                                                                    "id": "705350235",
                                                                    "speaker": "Lisa",
                                                                    "text": "Os instrumentos da Equipe de Investigação são extremamente sensíveis, então qualquer explosão dentro de uma certa distância do lago afetaria os dados."
                                                                },
                                                                {
                                                                    "id": "705350236",
                                                                    "speaker": "Lisa",
                                                                    "text": "Jean disse que Klee definitivamente ficaria entediada de ficar dentro da cidade o tempo todo."
                                                                },
                                                                {
                                                                    "id": "705350237",
                                                                    "speaker": "Lisa",
                                                                    "text": "Albedo está ocupado fazendo melhorias ao equipamento experimental do Grupo da Guerrilha, enquanto Kaeya acabou de sair em uma viagem de negócios. Então, a tarefa de cuidar dela caiu sobre meus ombros..."
                                                                },
                                                                {
                                                                    "id": "705350238",
                                                                    "speaker": "Klee",
                                                                    "text": "#Mas eu não estou mais entediada, porque Lisa inventou o Encontro Explosivo de Dodoco! Sr{F#ta}. Cavaleir{F#a}{M#o} Honorável, vamos brincar junt{M#os}{F#as}!",
                                                                    "choices": [
                                                                        {
                                                                            "id": "705350239",
                                                                            "text": "Conte com a gente!",
                                                                            "response": [
                                                                                {
                                                                                    "id": "705350241",
                                                                                    "speaker": "Lisa",
                                                                                    "text": "Tudo bem, a mesa de jogo está logo ali no jardim. Os pedidos que fiz no Caçador de Cervos também serão entregues lá."
                                                                                },
                                                                                {
                                                                                    "id": "705350242",
                                                                                    "speaker": "Lisa",
                                                                                    "text": "#Por favor, aproveitem! Não é todo dia que vocês podem brincar com Klee arrodead{M#o}{F#a}s pelo cheiro de flores na brisa, com comida deliciosa entregue direto a vocês~"
                                                                                },
                                                                                {
                                                                                    "id": "705350243",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "Espera, Lisa, não vai com a gente?"
                                                                                },
                                                                                {
                                                                                    "id": "705350244",
                                                                                    "speaker": "Lisa",
                                                                                    "text": "Não acha que é um pouco injusto se a criadora do jogo participar? Eu não quero estragar a diversão."
                                                                                },
                                                                                {
                                                                                    "id": "705350245",
                                                                                    "speaker": "Lisa",
                                                                                    "text": "Além disso, como a bibliotecária, ainda tenho minhas responsabilidades básicas para resolver."
                                                                                },
                                                                                {
                                                                                    "id": "705350246",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "Isso só pareceu outra desculpa para não sair..."
                                                                                },
                                                                                {
                                                                                    "id": "705350247",
                                                                                    "speaker": "Lisa",
                                                                                    "text": "Podem ir, divirtam-se brincando com Klee!",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "705350248",
                                                                                            "text": "Vamos cuidar bem de Klee!",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "705350250",
                                                                                                    "speaker": "Paimon",
                                                                                                    "text": "Ok então, a gente se vê depois, Lisa!"
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "705350249",
                                                                                            "text": "Valeu, Lisa!"
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "705350240",
                                                                            "text": "Vamos brincar até anoitecer!"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "705350231",
                                                            "text": "Você mereceu mesmo!"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "705350216",
                                            "text": "Chegamos aqui atrás da mágica da pura coincidência!"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "705350211",
                            "text": "Parece que vocês fizeram um acordo importante."
                        }
                    ]
                }
            ]
        },
        {
            "id": "7053503",
            "objective": "Vá para o Jardim",
            "dialogues": [
                {
                    "id": "705350301",
                    "speaker": "Klee",
                    "text": "#Chegamos, Sr{F#ta}. Cavaleir{F#a}{M#o} Honorável! É aqui que vamos brincar de Encontro Explosivo de Dodoco!"
                },
                {
                    "id": "705350302",
                    "speaker": "Paimon",
                    "text": "Opa, Lisa escolheu mesmo o melhor lugar! Paimon já tá amando."
                },
                {
                    "id": "705350303",
                    "speaker": "Paimon",
                    "text": "Beleza, ensina a gente a jogar, Klee!",
                    "choices": [
                        {
                            "id": "705350304",
                            "text": "Dodocaventuras!",
                            "response": [
                                {
                                    "id": "705350306",
                                    "speaker": "Klee",
                                    "text": "Hehe! É, vamos jogar!"
                                }
                            ]
                        },
                        {
                            "id": "705350305",
                            "text": "Cabuuuuuuuuum!"
                        }
                    ]
                }
            ]
        }
    ]
