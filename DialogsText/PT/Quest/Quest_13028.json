    "talks": [
        {
            "id": "1302801",
            "objective": "Explique a situação ao Cogumelo no aguardo",
            "dialogues": [
                {
                    "id": "130280113",
                    "speaker": "Nahida",
                    "text": "Eles estão aqui há muito tempo..."
                },
                {
                    "id": "130280101",
                    "speaker": "Nahida",
                    "text": "Quero muito fazer algo para que eles tenham a chance de se encontrar novamente..."
                },
                {
                    "id": "130280102",
                    "speaker": "Paimon",
                    "text": "Além desses dois Cogumelos, Paimon também está preocupada com o acampamento do Cogumelo Flutuante Anemo."
                },
                {
                    "id": "130280103",
                    "speaker": "Nahida",
                    "text": "Sim, eu também."
                },
                {
                    "id": "130280104",
                    "speaker": "Nahida",
                    "text": "Tenho uma ideia. Que tal levarmos eles para viverem com os outros Cogumelos?"
                },
                {
                    "id": "130280105",
                    "speaker": "Nahida",
                    "text": "Ambos os lados já viveram na presença de uma forma de vida elemental, portanto seus hábitos devem ser semelhantes."
                },
                {
                    "id": "130280106",
                    "speaker": "Paimon",
                    "text": "É mesmo, e eles podem cuidar um do outro!"
                },
                {
                    "id": "130280107",
                    "speaker": "Nahida",
                    "text": "Vocês gostariam de vir conosco?"
                },
                {
                    "id": "130280108",
                    "speaker": "Cogumelo Flutuante Hydro",
                    "text": "...?"
                },
                {
                    "id": "130280109",
                    "speaker": "Cogumelo Flutuante Hydro",
                    "text": "♪~"
                },
                {
                    "id": "130280110",
                    "speaker": "Cogumelo Flutuante Hydro",
                    "text": "..."
                },
                {
                    "id": "130280111",
                    "speaker": "Paimon",
                    "text": "Parece que já se convenceram."
                },
                {
                    "id": "130280112",
                    "speaker": "Nahida",
                    "text": "Então, vamos lá."
                }
            ]
        },
        {
            "id": "1302802",
            "objective": "Leve o Cogumelo ao seu novo lar",
            "dialogues": [
                {
                    "id": "130280201",
                    "speaker": "Black Screen",
                    "text": "Após chegarem ao acampamento, os dois Cogumelos são acolhidos calorosamente."
                },
                {
                    "id": "130280202",
                    "speaker": "Paimon",
                    "text": "Oh, parece que os Cogumelos daqui nos reconhecem. Eles são tão amigáveis e gentis."
                },
                {
                    "id": "130280203",
                    "speaker": "Nahida",
                    "text": "Essa forma de vida elemental deve ter sido muito respeitada por todos que vivem aqui."
                },
                {
                    "id": "130280204",
                    "speaker": "Paimon",
                    "text": "Hã? Você está tentando brincar com Paimon?"
                },
                {
                    "id": "130280205",
                    "speaker": "Cogumelo Flutuante Anemo",
                    "text": "♩~♩~"
                },
                {
                    "id": "130280206",
                    "speaker": "Paimon",
                    "text": "#Tá bom, tá bom! {NICKNAME}, Paimon vai ficar logo ali brincando com os Cogumelos!",
                    "choices": [
                        {
                            "id": "130280207",
                            "text": "Pode ir.",
                            "response": [
                                {
                                    "id": "130280209",
                                    "speaker": "Nahida",
                                    "text": "Eu te devo um pedido de desculpas. Quando a Semente de Fogo despedaçou enquanto estávamos dentro de Apep... Eu planejava sacrificar o meu poder."
                                },
                                {
                                    "id": "130280210",
                                    "speaker": "Nahida",
                                    "text": "Paimon contou para você?",
                                    "choices": [
                                        {
                                            "id": "130280211",
                                            "text": "#Sim, eu fiquei muito preocupad{M#o}{F#a}",
                                            "response": [
                                                {
                                                    "id": "130280213",
                                                    "speaker": "Nahida",
                                                    "text": "Eu deveria ter pensado mais e ter julgado melhor a situação."
                                                },
                                                {
                                                    "id": "130280214",
                                                    "speaker": "Nahida",
                                                    "text": "Quando eu lembro do Dragão Dendro e do povo de Sumeru correndo perigo, eu fico ansiosa e assustada."
                                                },
                                                {
                                                    "id": "130280215",
                                                    "speaker": "Nahida",
                                                    "text": "Se há algo que você pode fazer e acaba não fazendo, se você não se esforçar até o final, então tudo será tempo perdido..."
                                                },
                                                {
                                                    "id": "130280216",
                                                    "speaker": "Nahida",
                                                    "text": "Usar um poder é muito simples, mas também muito complicado."
                                                },
                                                {
                                                    "id": "130280217",
                                                    "speaker": "Player",
                                                    "text": "Você ainda precisa \"crescer\" mais."
                                                },
                                                {
                                                    "id": "130280218",
                                                    "speaker": "Nahida",
                                                    "text": "Sim, acho que eles ensinaram bastante."
                                                },
                                                {
                                                    "id": "130280219",
                                                    "speaker": "Nahida",
                                                    "text": "Eu entendo o que significa ter os desejos deles realizados, mas ainda não consigo aceitar."
                                                },
                                                {
                                                    "id": "130280220",
                                                    "speaker": "Nahida",
                                                    "text": "Por que ela parecia tão contente e tranquila quando estava fazendo algo que... só dá vontade de chorar?"
                                                },
                                                {
                                                    "id": "130280221",
                                                    "speaker": "Nahida",
                                                    "text": "Parece que eu ainda não consegui entender totalmente o conceito de \"empatia\"...",
                                                    "choices": [
                                                        {
                                                            "id": "130280222",
                                                            "text": "Não é sua culpa.",
                                                            "response": [
                                                                {
                                                                    "id": "130280224",
                                                                    "speaker": "Nahida",
                                                                    "text": "Obrigada por me confortar..."
                                                                },
                                                                {
                                                                    "id": "130280225",
                                                                    "speaker": "Nahida",
                                                                    "text": "Meus sentimentos são muito complicados, acho que ainda preciso continuar aprendendo..."
                                                                },
                                                                {
                                                                    "id": "130280226",
                                                                    "speaker": "Nahida",
                                                                    "text": "Hã?"
                                                                },
                                                                {
                                                                    "id": "130280227",
                                                                    "speaker": "Cogumelo Flutuante Hydro",
                                                                    "text": "♪~"
                                                                },
                                                                {
                                                                    "id": "130280228",
                                                                    "speaker": "Cogumelo Flutuante Hydro",
                                                                    "text": "♪~♪~"
                                                                },
                                                                {
                                                                    "id": "130280229",
                                                                    "speaker": "Nahida",
                                                                    "text": "Eles sabem como cuidar da terra? Hmm, talvez só estejam seguindo o exemplo."
                                                                },
                                                                {
                                                                    "id": "130280230",
                                                                    "speaker": "Nahida",
                                                                    "text": "Mas já que aquele Cogumelo consegue falar... Talvez isso seja o resultado de ser exposto a Energia Elemental por muito tempo."
                                                                },
                                                                {
                                                                    "id": "130280231",
                                                                    "speaker": "Player",
                                                                    "text": "O tempo realmente é poderoso."
                                                                },
                                                                {
                                                                    "id": "130280232",
                                                                    "speaker": "Nahida",
                                                                    "text": "Isso mesmo. E não precisamos mais nos preocupar com a segurança desses Cogumelos."
                                                                },
                                                                {
                                                                    "id": "130280233",
                                                                    "speaker": "Nahida",
                                                                    "text": "Depois virei cuidar desse acampamento, passarei aqui às vezes para ver como eles estão."
                                                                },
                                                                {
                                                                    "id": "130280234",
                                                                    "speaker": "Nahida",
                                                                    "text": "Quero proteger os vestígios que eles deixaram para criar uma chance de se encontrarem no futuro."
                                                                },
                                                                {
                                                                    "id": "130280235",
                                                                    "speaker": "Nahida",
                                                                    "text": "De toda forma, ela se lembrou do nome \"Nur\". Suas memórias voltaram.",
                                                                    "choices": [
                                                                        {
                                                                            "id": "130280236",
                                                                            "text": "Eu acredito nos laços familiares deles.",
                                                                            "response": [
                                                                                {
                                                                                    "id": "130280238",
                                                                                    "speaker": "Nahida",
                                                                                    "text": "Sim, vamos considerar tudo como um belo desejo."
                                                                                },
                                                                                {
                                                                                    "id": "130280239",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "Nahida, os Cogumelos trouxeram frutas novamente, vamos comer juntas!"
                                                                                },
                                                                                {
                                                                                    "id": "130280240",
                                                                                    "speaker": "Nahida",
                                                                                    "text": "Você sabe que eu topo! Pode contar comigo!"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "130280237",
                                                                            "text": "Eu acredito em milagres."
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "130280223",
                                                            "text": "Me sinto do mesmo jeito."
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "130280212",
                                            "text": "#Sim, e eu fiquei muito brav{M#o}{F#a}"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "130280208",
                            "text": "Divirtam-se"
                        }
                    ]
                }
            ]
        }
    ]
