    "talks": [
        {
            "id": "49201",
            "objective": "Volte à Igreja e veja como está a Jean",
            "dialogues": [
                {
                    "id": "4901001",
                    "speaker": "Jean",
                    "text": "Ah, são vocês...",
                    "choices": [
                        {
                            "id": "4901002",
                            "text": "Então você estava aí.",
                            "response": [
                                {
                                    "id": "4901004",
                                    "speaker": "Jean",
                                    "text": "Sim, eu estou apenas... tomando um pouco de ar."
                                },
                                {
                                    "id": "4901005",
                                    "speaker": "Paimon",
                                    "text": "Uh, oh! Parece que há algo está inquietando a Jean."
                                },
                                {
                                    "id": "4901006",
                                    "speaker": "Jean",
                                    "text": "#{NICKNAME}, eu quero lhe agradecer de novo..."
                                },
                                {
                                    "id": "4901007",
                                    "speaker": "Player",
                                    "text": "Na verdade, eu também não sabia nada sobre isso."
                                },
                                {
                                    "id": "4901008",
                                    "speaker": "Jean",
                                    "text": "De qualquer forma, é bom estar aqui junto com todos. Isso levantou meu ânimo"
                                },
                                {
                                    "id": "4901011",
                                    "speaker": "Jean",
                                    "text": "Além disso, aprendi uma coisa."
                                },
                                {
                                    "id": "4901012",
                                    "speaker": "Paimon",
                                    "text": "Do que você precisa?"
                                },
                                {
                                    "id": "4901013",
                                    "speaker": "Jean",
                                    "text": "Definitivamente, sou mais uma Cavaleira de Dandelion do que uma Cavaleira Dente de Leão."
                                },
                                {
                                    "id": "4901014",
                                    "speaker": "Jean",
                                    "text": "Os Cavaleiros de Dandelion representam o passado em que a Vennessa lutou por Mondstadt."
                                },
                                {
                                    "id": "4901015",
                                    "speaker": "Jean",
                                    "text": "Mas foi a Cavaleira de Dandelion que representou suas esperanças para o futuro, um futuro pertencente aos recém-formados Cavaleiros de Favonius..."
                                },
                                {
                                    "id": "4901016",
                                    "speaker": "Paimon",
                                    "text": "Jean, Vennessa ficaria muito orgulhosa de você agora."
                                },
                                {
                                    "id": "4901017",
                                    "speaker": "Jean",
                                    "text": "Acredito que Vennessa está cuidando de nós, seja lá do alto, seja do vento que nos rodeia."
                                },
                                {
                                    "id": "4901018",
                                    "speaker": "Player",
                                    "text": "Que o vento te guie."
                                },
                                {
                                    "id": "4901019",
                                    "speaker": "Jean",
                                    "text": "#Deixe o vento te levar. Os ventos da liberdade nos guiarão neste caminho à frente. Eu espero que você continue conosco neste percurso, {NICKNAME}."
                                }
                            ]
                        },
                        {
                            "id": "4901003",
                            "text": "Você está se divertindo?"
                        }
                    ]
                }
            ]
        }
    ]
