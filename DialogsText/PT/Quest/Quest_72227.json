    "talks": [
        {
            "id": "7222706",
            "objective": "",
            "dialogues": [
                {
                    "id": "722270601",
                    "speaker": "Ruu",
                    "text": "As Mukurri são realmente tão importantes assim?"
                }
            ]
        },
        {
            "id": "7222701",
            "objective": "",
            "dialogues": [
                {
                    "id": "722270101",
                    "speaker": "Ruu",
                    "text": "#{NICKNAME}, você parece muito legal quando está lutando! Incrível!"
                },
                {
                    "id": "722270102",
                    "speaker": "Paimon",
                    "text": "Oh, Ruu, você está aqui!",
                    "choices": [
                        {
                            "id": "722270103",
                            "text": "Tá tudo bem com você?",
                            "response": [
                                {
                                    "id": "722270105",
                                    "speaker": "Ruu",
                                    "text": "Estou bem, nem um arranhão!"
                                },
                                {
                                    "id": "722270106",
                                    "speaker": "Player",
                                    "text": "Aqueles monstros..."
                                },
                                {
                                    "id": "722270108",
                                    "speaker": "Ruu",
                                    "text": "Eu também não sei de onde eles apareceram."
                                },
                                {
                                    "id": "722270109",
                                    "speaker": "Paimon",
                                    "text": "Na verdade, eles não parecem serem nativos daqui..."
                                },
                                {
                                    "id": "722270110",
                                    "speaker": "Ruu",
                                    "text": "Sim. No passado, não haviam monstros como esses em nossa ilha. Também não existiam pessoas cheias de pelo ou máquinas grandes também."
                                },
                                {
                                    "id": "722270111",
                                    "speaker": "Ruu",
                                    "text": "No passado, nós costumávamos ter esse animal nativo chamado \"pelicano\". Eles eram muito gentis, e também muito gostosos."
                                },
                                {
                                    "id": "722270112",
                                    "speaker": "Player",
                                    "text": "Nunca ouvi falar."
                                },
                                {
                                    "id": "722270113",
                                    "speaker": "Ruu",
                                    "text": "Eu também pensei nisso. Não sei quando aconteceu, mas todos desapareceram, e no lugar apareceram esses monstros."
                                },
                                {
                                    "id": "722270114",
                                    "speaker": "Ruu",
                                    "text": "Talvez eles tenham vindo de além do Mar de Neblina..."
                                },
                                {
                                    "id": "722270115",
                                    "speaker": "Player",
                                    "text": "Há Hilichurls no mundo exterior também."
                                },
                                {
                                    "id": "722270116",
                                    "speaker": "Ruu",
                                    "text": "Parece muito perigoso...",
                                    "choices": [
                                        {
                                            "id": "722270117",
                                            "text": "Realmente é muito perigoso.",
                                            "response": [
                                                {
                                                    "id": "722270118",
                                                    "speaker": "Paimon",
                                                    "text": "Entretanto, a experiência da aventura também é muito interessante!"
                                                },
                                                {
                                                    "id": "722270120",
                                                    "speaker": "Ruu",
                                                    "text": "Eu também quero ir em uma aventura!"
                                                },
                                                {
                                                    "id": "722270121",
                                                    "speaker": "Paimon",
                                                    "text": "Hehe, Paimon tem certeza que quando você crescer, se tornará um maravilhoso aventureiro!"
                                                },
                                                {
                                                    "id": "722270122",
                                                    "speaker": "Ruu",
                                                    "text": "Uhuuu!"
                                                },
                                                {
                                                    "id": "722270123",
                                                    "speaker": "Paimon",
                                                    "text": "Deixe esse poleiro conosco. Há monstros por aqui, se você ficar correndo para todo lado pode ser perigoso, Ruu."
                                                },
                                                {
                                                    "id": "722270124",
                                                    "speaker": "Player",
                                                    "text": "Deixe conosco."
                                                }
                                            ]
                                        },
                                        {
                                            "id": "722270119",
                                            "text": "Ainda assim, fazer aventuras é bem divertido."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "722270104",
                            "text": "Não está ferido, não é?"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7222702",
            "objective": "",
            "dialogues": [
                {
                    "id": "722270201",
                    "speaker": "Ruu",
                    "text": "#Eu quero crescer o mais rápido possível para então me tornar um aventureiro como você, {NICKNAME}!"
                }
            ]
        },
        {
            "id": "7222703",
            "objective": "",
            "dialogues": [
                {
                    "id": "722270301",
                    "speaker": "Paimon",
                    "text": "Parece que o poleiro daqui já está pronto!"
                },
                {
                    "id": "722270302",
                    "speaker": "Ruu",
                    "text": "#Que incrível! Isso é o que {F#uma}{M#um} aventureir{F#a}{M#o} de verdade consegue fazer?"
                },
                {
                    "id": "722270303",
                    "speaker": "Ruu",
                    "text": "Bem, outras pessoas vieram aqui antes."
                },
                {
                    "id": "722270304",
                    "speaker": "Ruu",
                    "text": "Mas nenhuma delas era forte como você e Paimon!"
                },
                {
                    "id": "722270305",
                    "speaker": "Paimon",
                    "text": "Outras pessoas?"
                },
                {
                    "id": "722270306",
                    "speaker": "Ruu",
                    "text": "Sim, elas vieram procurar pela Maushiro.",
                    "choices": [
                        {
                            "id": "722270307",
                            "text": "Será que Sumida...",
                            "response": [
                                {
                                    "id": "722270309",
                                    "speaker": "Paimon",
                                    "text": "Mas, o que é exatamente a Maushiro? Nós ouvimos dizer que são instrumentos musicais tradicionais que as pessoas da Ilha Tsurumi usam..."
                                },
                                {
                                    "id": "722270310",
                                    "speaker": "Ruu",
                                    "text": "Sim, eles fazem alguns sons..."
                                },
                                {
                                    "id": "722270311",
                                    "speaker": "Ruu",
                                    "text": "É difícil ver por causa dessa neblina, não é? Por isso todos usam as Maushiros para dizer aos outros onde estamos."
                                },
                                {
                                    "id": "722270312",
                                    "speaker": "Ruu",
                                    "text": "Bem, com certeza é melhor que gritar! Fazer isso machuca minha garganta."
                                },
                                {
                                    "id": "722270313",
                                    "speaker": "Paimon",
                                    "text": "É verdade que realmente não é possível ver nada aqui..."
                                },
                                {
                                    "id": "722270314",
                                    "speaker": "Ruu",
                                    "text": "Não é?"
                                },
                                {
                                    "id": "722270315",
                                    "speaker": "Ruu",
                                    "text": "Meu pai... Vovô Tasuku disse que as Maushiros podem ajudar a alma daqueles perdidos na neblina a encontrarem seu caminho de volta para casa, por isso elas são muito importantes."
                                },
                                {
                                    "id": "722270316",
                                    "speaker": "Paimon",
                                    "text": "Hã? Então são tão importantes assim?"
                                },
                                {
                                    "id": "722270317",
                                    "speaker": "Player",
                                    "text": "Não surpreende você precisar delas na cerimônia."
                                },
                                {
                                    "id": "722270318",
                                    "speaker": "Ruu",
                                    "text": "#Sim, eu tenho certeza que a cerimônia deixará vocês bem felizes, {NICKNAME} e Paimon!"
                                },
                                {
                                    "id": "722270319",
                                    "speaker": "Ruu",
                                    "text": "Vocês podem ir seguindo em frente. Eu gostaria de ficar mais um tempo aqui sob a árvore."
                                },
                                {
                                    "id": "722270320",
                                    "speaker": "Paimon",
                                    "text": "Você vai ficar bem? Talvez hajam monstros lá fora..."
                                },
                                {
                                    "id": "722270321",
                                    "speaker": "Ruu",
                                    "text": "Eu ficarei bem!"
                                }
                            ]
                        },
                        {
                            "id": "722270308",
                            "text": "Não surpreende Katheryne ter dito que essa missão era difícil..."
                        }
                    ]
                }
            ]
        }
    ]
}