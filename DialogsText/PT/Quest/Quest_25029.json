    "talks": [
        {
            "id": "2502901",
            "objective": "Fale com Tlathe",
            "dialogues": [
                {
                    "id": "250290101",
                    "speaker": "Tlathe",
                    "text": "Vamos lá, não perca a coragem. Só melhore e... continue tentando! Você vai chegar ao topo rapidinho!"
                },
                {
                    "id": "250290102",
                    "speaker": "Jika",
                    "text": "Rawrr..."
                },
                {
                    "id": "250290103",
                    "speaker": "Tlathe",
                    "text": "Tá com fome? Hmm... Então que tal eu arranjar algo para você comer?"
                },
                {
                    "id": "250290104",
                    "speaker": "Jika",
                    "text": "Rawr... Rawr..."
                },
                {
                    "id": "250290105",
                    "speaker": "Player",
                    "text": "O que você está fazendo?"
                },
                {
                    "id": "250290106",
                    "speaker": "Tlathe",
                    "text": "Estou brincando com meu amigo, Jika. Ele ainda é pequeno, mas a mamãe disse que ele será igual a qualquer outro Yumkassauro quando ele crescer!"
                },
                {
                    "id": "250290107",
                    "speaker": "Jika",
                    "text": "Oh... *Choro*"
                },
                {
                    "id": "250290108",
                    "speaker": "Tlathe",
                    "text": "Não fique triste. Seu corpo só está muito frágil no momento, e você ainda esteve machucado."
                },
                {
                    "id": "250290109",
                    "speaker": "Tlathe",
                    "text": "A mamãe diz que você certamente vai ficar melhor. Você só precisa comer bem e treinar comigo."
                },
                {
                    "id": "250290110",
                    "speaker": "Jika",
                    "text": "Rawr? Rawrr...",
                    "choices": [
                        {
                            "id": "250290111",
                            "text": "(Acariciar Jika)",
                            "response": [
                                {
                                    "id": "250290112",
                                    "speaker": "Jika",
                                    "text": "Rawrr..."
                                },
                                {
                                    "id": "250290119",
                                    "speaker": "Tlathe",
                                    "text": "Haha. Bem, olha as horas. Temos um treinamento chegando em breve, então vamos comer!"
                                },
                                {
                                    "id": "250290120",
                                    "speaker": "Tlathe",
                                    "text": "A mamãe fez essas frutas secas, sabe! Assou elas em uma panela gigante antes de adicionar vários condimentos com cheiro bom..."
                                },
                                {
                                    "id": "250290121",
                                    "speaker": "Tlathe",
                                    "text": "Certo, e ela também colocou algumas boas pitadas de açúcar e pétalas... De qualquer forma, tem um gosto ótimo! Só um momento, te darei um pouco..."
                                },
                                {
                                    "id": "250290122",
                                    "speaker": "Tlathe",
                                    "text": "Espera. Para onde minhas frutas secas foram? Tenho certeza de que coloquei elas em minha bolsa..."
                                },
                                {
                                    "id": "250290123",
                                    "speaker": "Jika",
                                    "text": "...Roar..."
                                },
                                {
                                    "id": "250290124",
                                    "speaker": "Tlathe",
                                    "text": "Uau! Jika! Você comeu tudo? Qual é, eu te disse para não ser avarento... Você vai ter problemas para se mover se comer tanto!"
                                },
                                {
                                    "id": "250290125",
                                    "speaker": "Jika",
                                    "text": "...Roar...",
                                    "choices": [
                                        {
                                            "id": "250290126",
                                            "text": "Bem, é bom ter apetite.",
                                            "response": [
                                                {
                                                    "id": "250290128",
                                                    "speaker": "Jika",
                                                    "text": "Rwar! Rawrrrrrr!"
                                                },
                                                {
                                                    "id": "250290129",
                                                    "speaker": "Tlathe",
                                                    "text": "É mesmo? Nesse caso... Quero ser como Jika. Quero comer muito, crescer rápido e ajudar a mamãe."
                                                },
                                                {
                                                    "id": "250290130",
                                                    "speaker": "Tlathe",
                                                    "text": "Muito bem então, Jika! Vamos treinar!"
                                                },
                                                {
                                                    "id": "250290131",
                                                    "speaker": "Jika",
                                                    "text": "Rawr!"
                                                },
                                                {
                                                    "id": "250290132",
                                                    "speaker": "Tlathe",
                                                    "text": "Vamos ver... Que tal se praticarmos alpinismo hoje?"
                                                },
                                                {
                                                    "id": "250290133",
                                                    "speaker": "Jika",
                                                    "text": "R-Rwarr..."
                                                },
                                                {
                                                    "id": "250290134",
                                                    "speaker": "Tlathe",
                                                    "text": "Ah qual é, levanta a cabeça! Faremos isso assim como da última vez. Não será nem um pouco difícil!"
                                                },
                                                {
                                                    "id": "250290135",
                                                    "speaker": "Jika",
                                                    "text": "...Roar!"
                                                },
                                                {
                                                    "id": "250290136",
                                                    "speaker": "Tlathe",
                                                    "text": "Certo, tio Yawar me disse da última vez que teremos que encontrar \"objetivos de treinamento\" razoáveis se quisermos treinar direito..."
                                                },
                                                {
                                                    "id": "250290137",
                                                    "speaker": "Tlathe",
                                                    "text": "Agora, se pelo menos eu pudesse encontrar um aventureiro incrível, e pedir que ele ajudasse a montar alguns alvos...",
                                                    "choices": [
                                                        {
                                                            "id": "250290138",
                                                            "text": "#Sou {M#um aventureiro}{F#uma aventureira} bem decente até...",
                                                            "response": [
                                                                {
                                                                    "id": "250290140",
                                                                    "speaker": "Tlathe",
                                                                    "text": "Sério? Uh, então... Você se importaria de me ajudar?",
                                                                    "choices": [
                                                                        {
                                                                            "id": "250290141",
                                                                            "text": "Quer eu te leve para fazer alpinismo?",
                                                                            "response": [
                                                                                {
                                                                                    "id": "250290143",
                                                                                    "speaker": "Tlathe",
                                                                                    "text": "#Não, não, espere. Se você é tão {M#bom}{F#boa}, de jeito nenhum vamos conseguir te acompanhar."
                                                                                },
                                                                                {
                                                                                    "id": "250290144",
                                                                                    "speaker": "Tlathe",
                                                                                    "text": "Então o que faremos é cronometrar enquanto você sobe."
                                                                                },
                                                                                {
                                                                                    "id": "250290145",
                                                                                    "speaker": "Tlathe",
                                                                                    "text": "Muito bem, então. Suba aquela montanha o mais rápido que você conseguir. Estamos contando com você!"
                                                                                },
                                                                                {
                                                                                    "id": "250290146",
                                                                                    "speaker": "Jika",
                                                                                    "text": "Roar—!"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "250290142",
                                                                            "text": "Muito bem, então. Siga-me, vamos começar."
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "250290139",
                                                            "text": "#Você disse, aventureir{M#o}{F#a} incrível? Não precisa procurar mais."
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "250290127",
                                            "text": "Quem come mais, cresce mais rápido."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "250290113",
                            "text": "Como ele se machucou?",
                            "response": [
                                {
                                    "id": "250290114",
                                    "speaker": "Tlathe",
                                    "text": "Eu não sei... mas talvez a mamãe saiba. Jika já estava doente quando a mamãe trouxe ele."
                                },
                                {
                                    "id": "250290115",
                                    "speaker": "Tlathe",
                                    "text": "Ele não conseguia comer, e ele não tinha força alguma para se mover. Tudo que eu podia fazer era dissolver um pouco de remédio na água e fazer ele beber todo dia."
                                },
                                {
                                    "id": "250290116",
                                    "speaker": "Tlathe",
                                    "text": "No fim ele se recuperou, mas seu corpo... continua bem fraco, o que o impede de escavar pelos penhascos assim como outros Yumkassauros."
                                },
                                {
                                    "id": "250290117",
                                    "speaker": "Tlathe",
                                    "text": "Ele anda bem chateado com isso, então estou tentando ajudá-lo a ficar em forma... mais forte do que qualquer outro Yumkassauro!"
                                },
                                {
                                    "id": "250290118",
                                    "speaker": "Jika",
                                    "text": "Rawr!"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2502902",
            "objective": "Escale até o topo da montanha",
            "dialogues": [
                {
                    "id": "250290201",
                    "speaker": "Tlathe",
                    "text": "Bom garoto, bom garoto! Comeu o bastante hoje? Pronto para treinar?"
                },
                {
                    "id": "250290202",
                    "speaker": "Jika",
                    "text": "Roar~!"
                },
                {
                    "id": "250290203",
                    "speaker": "Tlathe",
                    "text": "Você está bem enérgico hoje, não é? Maravilha! Vamos lá!"
                },
                {
                    "id": "250290204",
                    "speaker": "Player",
                    "text": "É, vamos lá!"
                },
                {
                    "id": "250290206",
                    "speaker": "Tlathe",
                    "text": "Hã? Oh, olá! Estamos fazendo um pouco de treinamento de alpinismo no momento."
                },
                {
                    "id": "250290207",
                    "speaker": "Jika",
                    "text": "Roar! Roar!"
                },
                {
                    "id": "250290208",
                    "speaker": "Jika",
                    "text": "Rawwr...",
                    "choices": [
                        {
                            "id": "250290209",
                            "text": "Como está indo o treinamento?",
                            "response": [
                                {
                                    "id": "250290210",
                                    "speaker": "Tlathe",
                                    "text": "Bem... estamos \"progredindo\". Jika subiu bem mais alto dessa vez."
                                },
                                {
                                    "id": "250290211",
                                    "speaker": "Tlathe",
                                    "text": "É só que Jika não é muito familiar com como você escala montanhas, e..."
                                },
                                {
                                    "id": "250290216",
                                    "speaker": "Tlathe",
                                    "text": "A propósito, você poderia demonstrar para a gente de novo?",
                                    "choices": [
                                        {
                                            "id": "250290217",
                                            "text": "Claro.",
                                            "response": [
                                                {
                                                    "id": "250290218",
                                                    "speaker": "Tlathe",
                                                    "text": "Muito obrigado! Tenho certeza que serei capaz de captar seus movimentos dessa vez."
                                                },
                                                {
                                                    "id": "250290219",
                                                    "speaker": "Tlathe",
                                                    "text": "Também fique de olhos abertos, tudo bem, Jika?"
                                                },
                                                {
                                                    "id": "250290220",
                                                    "speaker": "Jika",
                                                    "text": "Rawr!"
                                                },
                                                {
                                                    "id": "250290223",
                                                    "speaker": "Tlathe",
                                                    "text": "Estamos contando com você!"
                                                },
                                                {
                                                    "id": "250290224",
                                                    "speaker": "Tlathe",
                                                    "text": "Então o que faremos é cronometrar enquanto você sobe."
                                                },
                                                {
                                                    "id": "250290225",
                                                    "speaker": "Jika",
                                                    "text": "Rawr..."
                                                }
                                            ]
                                        },
                                        {
                                            "id": "250290221",
                                            "text": "Assista com atenção dessa vez, tudo bem?",
                                            "response": [
                                                {
                                                    "id": "250290222",
                                                    "speaker": "Tlathe",
                                                    "text": "É claro! Jika e eu não vamos perder nadinha dessa vez!"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "250290212",
                            "text": "Parece que ele está se recuperando bem.",
                            "response": [
                                {
                                    "id": "250290213",
                                    "speaker": "Tlathe",
                                    "text": "Isso mesmo. A mamãe disse que estou ficando muito bom em cuidar dele."
                                },
                                {
                                    "id": "250290214",
                                    "speaker": "Tlathe",
                                    "text": "Jika melhorou muito. Ele consegue subir bem mais alto do que podia da última vez."
                                },
                                {
                                    "id": "250290215",
                                    "speaker": "Tlathe",
                                    "text": "É só que Jika não é muito familiar com como você escala montanhas, e..."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2502903",
            "objective": "",
            "dialogues": [
                {
                    "id": "250290301",
                    "speaker": "Tlathe",
                    "text": "#Você é incrível! Você é quase tão rápid{M#o}{F#a} quanto Mayta!",
                    "choices": [
                        {
                            "id": "250290302",
                            "text": "H-Heh, não saiu tão bem quanto eu gostaria...",
                            "response": [
                                {
                                    "id": "250290303",
                                    "speaker": "Tlathe",
                                    "text": "#Sério? Você quer dizer que poderia ter sido ainda mais rápid{M#o}{F#a}? Uau. Então você é realmente {M#um aventureiro}{F#uma aventureira} especialista, hein..."
                                },
                                {
                                    "id": "250290306",
                                    "speaker": "Tlathe",
                                    "text": "Se colocarmos esse tempo como nosso objetivo... Hmm..."
                                },
                                {
                                    "id": "250290307",
                                    "speaker": "Jika",
                                    "text": "Rawr..."
                                },
                                {
                                    "id": "250290308",
                                    "speaker": "Tlathe",
                                    "text": "...É, eu sei, vai ser meio difícil para você, não é?"
                                },
                                {
                                    "id": "250290309",
                                    "speaker": "Tlathe",
                                    "text": "Acho que vou falar com Mayta sobre esse tempo. Talvez ele consiga pensar em... um plano de treinamento mais razoável para nós?"
                                },
                                {
                                    "id": "250290310",
                                    "speaker": "Tlathe",
                                    "text": "Enfim, agradeço demais sua ajuda. Aqui, fique com esses Cacahuatls!"
                                },
                                {
                                    "id": "250290311",
                                    "speaker": "Tlathe",
                                    "text": "Nós mesmos colhemos eles, então são super frescos e vão fazer um chocolate bem delicioso!"
                                },
                                {
                                    "id": "250290312",
                                    "speaker": "Jika",
                                    "text": "Rrarr, rrarrr!"
                                },
                                {
                                    "id": "250290313",
                                    "speaker": "Tlathe",
                                    "text": "Nesse caso, estamos indo. Me pergunto se Mayta voltou ao povoado. Ele não saiu para escalar de novo, né...?"
                                }
                            ]
                        },
                        {
                            "id": "250290304",
                            "text": "Quem é Mayta?",
                            "response": [
                                {
                                    "id": "250290305",
                                    "speaker": "Tlathe",
                                    "text": "Ele é um amigo meu que é muito bom em alpinismo. Tirando sua irmã mais velha, Roca, quase ninguém se compara."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
