            "dialogues": [
                {
                    "id": "722250101",
                    "speaker": "Agu",
                    "text": "Que dor..."
                },
                {
                    "id": "722250102",
                    "speaker": "Ruu",
                    "text": "#{NICKNAME}, Paimon! Vocês chegaram na hora certa..."
                },
                {
                    "id": "722250103",
                    "speaker": "Player",
                    "text": "O que aconteceu?"
                },
                {
                    "id": "722250104",
                    "speaker": "Agu",
                    "text": "Ai, eu acho que torci meu tornozelo..."
                },
                {
                    "id": "722250105",
                    "speaker": "Ruu",
                    "text": "O Irmão Agu está machucado de novo. Será que você poderia nos ajudar a fazer oferendas para o poleiro?",
                    "choices": [
                        {
                            "id": "722250106",
                            "text": "Eu esperava que isso acontecesse...",
                            "response": [
                                {
                                    "id": "722250107",
                                    "speaker": "Paimon",
                                    "text": "Não tem problema, deixe conosco!"
                                },
                                {
                                    "id": "722250109",
                                    "speaker": "Ruu",
                                    "text": "Maravilhoso! Você tem minha gratidão."
                                },
                                {
                                    "id": "722250110",
                                    "speaker": "Paimon",
                                    "text": "Oh, sim! Você não é muito sensível aos elementos, Ruu?"
                                },
                                {
                                    "id": "722250111",
                                    "speaker": "Paimon",
                                    "text": "Por que você mesmo não faz isso?"
                                },
                                {
                                    "id": "722250112",
                                    "speaker": "Ruu",
                                    "text": "Uh... Eu tentei antes em outras cerimônias, mas o resultado não foi muito bom.",
                                    "choices": [
                                        {
                                            "id": "722250113",
                                            "text": "Por quê?",
                                            "response": [
                                                {
                                                    "id": "722250114",
                                                    "speaker": "Ruu",
                                                    "text": "Eu também não sei..."
                                                },
                                                {
                                                    "id": "722250117",
                                                    "speaker": "Paimon",
                                                    "text": "Ah, bem. Acho que agora estamos lidando com essa questão do poleiro."
                                                }
                                            ]
                                        },
                                        {
                                            "id": "722250115",
                                            "text": "Bem, deixe isso comigo então."
                                        },
                                        {
                                            "id": "722250116",
                                            "text": "Deixe a pessoa ferida comigo."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "722250108",
                            "text": "Deixe comigo."
                        }
                    ]
                }
            ]
        },
        {
            "id": "7222506",
            "objective": "",
            "dialogues": [
                {
                    "id": "722250601",
                    "speaker": "Agu",
                    "text": "Urgh, que vergonha... Eu só espero que isso não afete a cerimônia."
                },
                {
                    "id": "722250602",
                    "speaker": "Agu",
                    "text": "Caso contrário, eu não sei como poderei encarar Ruu."
                },
                {
                    "id": "722250603",
                    "speaker": "Ruu",
                    "text": "Oh, não diga isso. Irmão Agu sempre foi bom comigo!"
                }
            ]
        },
        {
            "id": "7222502",
            "objective": "",
            "dialogues": [
                {
                    "id": "722250201",
                    "speaker": "Ruu",
                    "text": "Por favor, nos ajude com esse problema do poleiro!"
                },
                {
                    "id": "722250202",
                    "speaker": "Ruu",
                    "text": "Eu ficarei aqui com o Irmão Agu."
                }
            ]
        },
        {
            "id": "7222503",
            "objective": "",
            "dialogues": [
                {
                    "id": "722250301",
                    "speaker": "Ruu",
                    "text": "Oh, o poleiro agora está todo brilhando!"
                },
                {
                    "id": "722250302",
                    "speaker": "Agu",
                    "text": "Acho que pode-se dizer que a questão da oferenda está completa. Que complicação."
                },
                {
                    "id": "722250303",
                    "speaker": "Paimon",
                    "text": "Hehe! Nós somos especialistas em resolver problemas, sabia?"
                },
                {
                    "id": "722250304",
                    "speaker": "Player",
                    "text": "Parecido com a Cerimônia de Luz."
                },
                {
                    "id": "722250305",
                    "speaker": "Paimon",
                    "text": "Para resolver um problema, é necessário resolver três problemas menores para resolver um problema maior..."
                },
                {
                    "id": "722250306",
                    "speaker": "Paimon",
                    "text": "Parece que isso sempre acontece conosco, não é?"
                },
                {
                    "id": "722250307",
                    "speaker": "Ruu",
                    "text": "Eu realmente não entendo muito o que você disse, mas os adultos têm esse ditado..."
                },
                {
                    "id": "722250308",
                    "speaker": "Ruu",
                    "text": "Eles o chamam de \"Regra de Três\"."
                },
                {
                    "id": "722250309",
                    "speaker": "Paimon",
                    "text": "Regra de Três... O que isso significa?"
                },
                {
                    "id": "722250310",
                    "speaker": "Ruu",
                    "text": "Bem, acho que eles querem dizer que você precisa fazer as coisas três vezes para ter um resultado."
                },
                {
                    "id": "722250311",
                    "speaker": "Ruu",
                    "text": "Por exemplo, dizem que \"bons presságios devem ocorrer três vezes para que a boa sorte realmente desça\"... O mesmo é válido para maus presságios."
                },
                {
                    "id": "722250312",
                    "speaker": "Ruu",
                    "text": "Também dizem que \"Você deve passar por dificuldades três vezes para ter sucesso na quarta\"."
                },
                {
                    "id": "722250313",
                    "speaker": "Paimon",
                    "text": "Mas, se é assim, não deveria se chamar \"Regra de Quatro\"?"
                },
                {
                    "id": "722250314",
                    "speaker": "Ruu",
                    "text": "Haha, sim! Você é boa com números, Paimon!"
                },
                {
                    "id": "722250315",
                    "speaker": "Paimon",
                    "text": "Haha, mas é claro!",
                    "choices": [
                        {
                            "id": "722250316",
                            "text": "Como que é esse o ponto?",
                            "response": [
                                {
                                    "id": "722250317",
                                    "speaker": "Paimon",
                                    "text": "Bem, voltando ao tópico, será que Agu ficará bem?"
                                },
                                {
                                    "id": "722250319",
                                    "speaker": "Ruu",
                                    "text": "Não se preocupe. Irmão Agu sempre foi assim."
                                },
                                {
                                    "id": "722250320",
                                    "speaker": "Agu",
                                    "text": "Urgh, que vergonha... Eu só espero que isso não afete a cerimônia."
                                },
                                {
                                    "id": "722250321",
                                    "speaker": "Agu",
                                    "text": "Caso contrário, eu não sei como poderei encarar Ruu."
                                },
                                {
                                    "id": "722250322",
                                    "speaker": "Ruu",
                                    "text": "Oh, não diga isso. Irmão Agu sempre foi bom comigo!"
                                },
                                {
                                    "id": "722250323",
                                    "speaker": "Agu",
                                    "text": "..."
                                },
                                {
                                    "id": "722250324",
                                    "speaker": "Ruu",
                                    "text": "#{NICKNAME}, Paimon, vocês {F#duas}{M#dois} vão primeiro."
                                },
                                {
                                    "id": "722250325",
                                    "speaker": "Ruu",
                                    "text": "Eu ficarei aqui com Irmão Agu. E depois nós faremos a limpeza quando vocês tiverem terminado de fazer as oferendas!"
                                }
                            ]
                        },
                        {
                            "id": "722250318",
                            "text": "A ferida de Agu..."
                        }
                    ]
                }
            ]
        }
    ]
