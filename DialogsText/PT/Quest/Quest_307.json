            "objective": "Fale com o Kaeya",
            "dialogues": [
                {
                    "id": "3071101",
                    "speaker": "Kaeya",
                    "text": "Você chegou."
                },
                {
                    "id": "3071102",
                    "speaker": "Kaeya",
                    "text": "Venha, você consegue sentir o cheiro?",
                    "choices": [
                        {
                            "id": "3071103",
                            "text": "... Não consigo cheirar nada.",
                            "response": [
                                {
                                    "id": "3071105",
                                    "speaker": "Kaeya",
                                    "text": "Alguma coisa deve ter acontecido no <color=#00E1FFFF>templo</color>."
                                },
                                {
                                    "id": "3071106",
                                    "speaker": "Kaeya",
                                    "text": "Eu imagino que deve haver Slimes, Hilichurls e... Seja lá o que estiver dando energia extra ao Stormterror."
                                },
                                {
                                    "id": "3071107",
                                    "speaker": "Kaeya",
                                    "text": "Haha, deve ser muito animado ali dentro.",
                                    "choices": [
                                        {
                                            "id": "3071108",
                                            "text": "Será que é perigoso?",
                                            "response": [
                                                {
                                                    "id": "3071109",
                                                    "speaker": "Kaeya",
                                                    "text": "Hum... Pela animação, não parece ser perigoso."
                                                },
                                                {
                                                    "id": "3071112",
                                                    "speaker": "Kaeya",
                                                    "text": "É uma pena que o Templo do Lobo tenha sido perturbado dessa forma."
                                                },
                                                {
                                                    "id": "3071113",
                                                    "speaker": "Kaeya",
                                                    "text": "#Vamos indo, {NICKNAME}."
                                                },
                                                {
                                                    "id": "3071114",
                                                    "speaker": "Kaeya",
                                                    "text": "Ninguém mais faz sacrifícios aos Quatro Ventos, embora os ventos nunca tenham se dispersado..."
                                                },
                                                {
                                                    "id": "3071115",
                                                    "speaker": "Kaeya",
                                                    "text": "Agora precisamos limpar os templos dos Quatro Ventos."
                                                }
                                            ]
                                        },
                                        {
                                            "id": "3071110",
                                            "text": "É apenas um grupo de monstros.",
                                            "response": [
                                                {
                                                    "id": "3071111",
                                                    "speaker": "Kaeya",
                                                    "text": "Uau! Que atitude!"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "3071104",
                            "text": "É o cheiro de Slimes queimados."
                        }
                    ]
                }
            ]
        },
