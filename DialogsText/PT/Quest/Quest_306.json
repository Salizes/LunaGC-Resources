    "talks": [
        {
            "id": "30600",
            "objective": "Encontre a Amber no templo.",
            "dialogues": []
        },
        {
            "id": "30601",
            "objective": "Fale com a Amber",
            "dialogues": [
                {
                    "id": "3061101",
                    "speaker": "Amber",
                    "text": "Chegamos. Este é um dos <color=#00E1FFFF>Templos dos Quatro Ventos</color> abandonados."
                },
                {
                    "id": "3061102",
                    "speaker": "Amber",
                    "text": "Estes templos caíram já há muitos anos. A maioria das pessoas de Mondstadt nunca vieram aqui."
                },
                {
                    "id": "3061103",
                    "speaker": "Amber",
                    "text": "Há chances de haver um ninho de monstros ou acampamento de Hilichurls dentro."
                },
                {
                    "id": "3061104",
                    "speaker": "Amber",
                    "text": "Mesmo o Stormterror desistiu do seu próprio templo.",
                    "choices": [
                        {
                            "id": "3061105",
                            "text": "Stormterror...?",
                            "response": [
                                {
                                    "id": "3061107",
                                    "speaker": "Amber",
                                    "text": "...Sim."
                                },
                                {
                                    "id": "3061108",
                                    "speaker": "Amber",
                                    "text": "Eu também acho difícil de acreditar, mas... O Stormterror foi um dos Quatro Ventos."
                                },
                                {
                                    "id": "3061109",
                                    "speaker": "Paimon",
                                    "text": "Quêêêêê!?"
                                },
                                {
                                    "id": "3061110",
                                    "speaker": "Amber",
                                    "text": "Espere... Você sentiu isso?"
                                },
                                {
                                    "id": "3061111",
                                    "speaker": "Amber",
                                    "text": "O vento aqui... Tem algo de errado..."
                                },
                                {
                                    "id": "3061112",
                                    "speaker": "Amber",
                                    "text": "#Entre e dê uma olhada, {NICKNAME}. Tenha cuidado, o poder do dragão está interferindo nesta área."
                                }
                            ]
                        },
                        {
                            "id": "3061106",
                            "text": "Você disse \"o seu próprio templo...\"?"
                        }
                    ]
                }
            ]
        },
        {
            "id": "30602",
            "objective": "Entre no templo.",
            "dialogues": []
        },
        {
            "id": "30612",
            "objective": "",
            "dialogues": [
                {
                    "id": "3061201",
                    "speaker": "Amber",
                    "text": "Todos em Mondstadt ainda seguem surpreendidos pela tormenta..."
                },
                {
                    "id": "3061202",
                    "speaker": "Amber",
                    "text": "Cada segundo que perdemos é um golpe na reputação dos Cavaleiros de Favonius! Vamos entrar no templo imediatamente!"
                }
            ]
        },
        {
            "id": "30603",
            "objective": "Explore as profundezas do templo.",
            "dialogues": []
        },
        {
            "id": "30610",
            "objective": "Falar com a Amber",
            "dialogues": [
                {
                    "id": "3061001",
                    "speaker": "Amber",
                    "text": "Uff... Estou cansada."
                },
                {
                    "id": "3061002",
                    "speaker": "Amber",
                    "text": "Mas, pelo menos, dessa maneira nós ajudamos a Jean."
                },
                {
                    "id": "3061003",
                    "speaker": "Amber",
                    "text": "No passado, nós éramos capazes de defender a cidade e manter a segurança."
                },
                {
                    "id": "3061004",
                    "speaker": "Amber",
                    "text": "Tudo isso, basicamente, é graças a Jean."
                },
                {
                    "id": "3061005",
                    "speaker": "Amber",
                    "text": "Mas agora com o Stormterror atacando diretamente a cidade..."
                },
                {
                    "id": "3061006",
                    "speaker": "Amber",
                    "text": "\"A direção do vento muda, e nossas táticas também.\"",
                    "choices": [
                        {
                            "id": "3061007",
                            "text": "Profundo.",
                            "response": [
                                {
                                    "id": "3061009",
                                    "speaker": "Amber",
                                    "text": "É o que a Lisa gosta de dizer."
                                },
                                {
                                    "id": "3061010",
                                    "speaker": "Amber",
                                    "text": "Ah, e sobre o que estávamos falando sobre Os Quatro Ventos..."
                                },
                                {
                                    "id": "3061011",
                                    "speaker": "Amber",
                                    "text": "Se você quiser saber mais da nossa história, você pode perguntar a Lisa."
                                },
                                {
                                    "id": "3061012",
                                    "speaker": "Amber",
                                    "text": "... Não estou dizendo que não conheço a nossa história! É que..."
                                },
                                {
                                    "id": "3061013",
                                    "speaker": "Amber",
                                    "text": "Digo... Supostamente uma bibliotecária deve ter mais conhecimento que uma Aventureira!"
                                }
                            ]
                        },
                        {
                            "id": "3061008",
                            "text": "Foi você que inventou?"
                        }
                    ]
                }
            ]
        },
        {
            "id": "30604",
            "objective": "Sair do Domínio",
