        {
            "id": "7306501",
            "objective": "",
            "dialogues": [
                {
                    "id": "730650201",
                    "speaker": "Player",
                    "text": "Claro, o que estamos jogando?"
                },
                {
                    "id": "730650202",
                    "speaker": "Arapratap",
                    "text": "Arapratap preparou muitas \"coisas boas\" e vai espalhar todas. Nara deve olhar e contar com cuidado."
                },
                {
                    "id": "730650203",
                    "speaker": "Arapratap",
                    "text": "#Daqui a pouco, Arapratap vai colocar as \"coisas boas\" de lado, e Nara dourad{F#a}{M#o} vai dizer a Arapratap o número de \"coisas boas\" que Arapratap tem em mente."
                },
                {
                    "id": "730650204",
                    "speaker": "Arapratap",
                    "text": "#Você está pront{F#a}{M#o}, {F#boa}{M#bom} Nara?"
                },
                {
                    "id": "730650205",
                    "speaker": "Player",
                    "text": "Vamos nessa."
                }
            ]
        },
        {
            "id": "7306504",
            "objective": "",
            "dialogues": [
                {
                    "id": "730650601",
                    "speaker": "Player",
                    "text": "Três."
                },
                {
                    "id": "730650602",
                    "speaker": "Arapratap",
                    "text": "#Nara dourad{F#a}{M#o} nunca esquece!"
                },
                {
                    "id": "730650603",
                    "speaker": "Arapratap",
                    "text": "#Nara dourad{F#a}{M#o} é poderos{F#a}{M#o}! Arapratap tem um belo presente para {F#a}{M#o} poderos{F#a}{M#o} Nara!"
                }
            ]
        },
        {
            "id": "7306505",
            "objective": "",
            "dialogues": [
                {
                    "id": "730650501",
                    "speaker": "Arapratap",
                    "text": "#Amig{M#o}{F#a} Nara, o que Arapratap tem em mente é <color=#00E1FFFF>melão perigoso... roxo, crocante e entorpecente</color>! Quantos Nara viu?"
                }
            ]
        },
        {
            "id": "7306507",
            "objective": "",
            "dialogues": [
                {
                    "id": "730650701",
                    "speaker": "Player",
                    "text": "Dois."
                },
                {
                    "id": "730650702",
                    "speaker": "Arapratap",
                    "text": "#Nara estupid{F#a}{M#o} não prestou atenção!"
                },
                {
                    "id": "730650703",
                    "speaker": "Arapratap",
                    "text": "#Arapratap tem muitas \"chances\" para dar {F#à}{M#ao} Nara. Volte para Arapratap se você estiver {M#pronto}{F#pronta} para o desafio!"
                }
            ]
        },
        {
            "id": "7306510",
            "objective": "",
            "dialogues": [
                {
                    "id": "730651001",
                    "speaker": "Player",
                    "text": "Da próxima vez eu consigo."
                }
            ]
        },
        {
            "id": "7306501",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "730650101",
                    "speaker": "Arapratap",
                    "text": "#Oh sim! É Nara dourad{F#a}{M#o}! Venha jogar com Arapratap!"
                }
            ]
        },
        {
            "id": "7306504",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "730650401",
                    "speaker": "Player",
                    "text": "Da próxima vez eu consigo."
                },
                {
                    "id": "730650402",
                    "speaker": "Arapratap",
                    "text": "Arapratap pode esperar..."
                }
            ]
        },
        {
            "id": "7306520",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "730652001",
                    "speaker": "Player",
                    "text": "Um."
                },
                {
                    "id": "730652002",
                    "speaker": "Arapratap",
                    "text": "#Nara estupid{F#a}{M#o} não prestou atenção!"
                },
                {
                    "id": "730652003",
                    "speaker": "Arapratap",
                    "text": "#Arapratap tem muitas \"chances\" para dar {F#à}{M#ao} Nara. Volte para Arapratap se você estiver {M#pronto}{F#pronta} para o desafio!"
                }
            ]
        },
        {
            "id": "7306521",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "730652101",
                    "speaker": "Arapratap",
                    "text": "Nara sabe contar, e Arapratap sabe contar também. Nara é forte... Então Arapratap é forte também!"
