        },
        {
            "id": "7452803",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "745280301",
                    "speaker": "Player",
                    "text": "Me dê um momento para pensar."
                }
            ]
        },
        {
            "id": "7452804",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "745280401",
                    "speaker": "Skirk",
                    "text": "Ah, é você. Parece que nossos caminhos se cruzaram novamente.",
                    "choices": [
                        {
                            "id": "745280402",
                            "text": "Há quanto tempo, Skirk.",
                            "response": [
                                {
                                    "id": "745280404",
                                    "speaker": "Skirk",
                                    "text": "Estou observando as cicatrizes deixadas neste mundo. Uma explosão destruiu esse lugar por completo..."
                                },
                                {
                                    "id": "745280405",
                                    "speaker": "Skirk",
                                    "text": "Mas agora, as pessoas construíram algo novo sobre essas ruínas."
                                },
                                {
                                    "id": "745280406",
                                    "speaker": "Skirk",
                                    "text": "Tudo há de se acabar. Mas quando uma coisa desaparece, algo novo surge."
                                },
                                {
                                    "id": "745280407",
                                    "speaker": "Skirk",
                                    "text": "Você está mais forte desde nosso último encontro. Parece que você não negligenciou seu treinamento. Isso é bom.",
                                    "choices": [
                                        {
                                            "id": "745280408",
                                            "text": "Na verdade, eu tenho um pequeno pedido...",
                                            "response": [
                                                {
                                                    "id": "745280410",
                                                    "speaker": "Skirk",
                                                    "text": "Uma foto? Mas eu sou só uma transeunte para esse mundo. Por que eu deixaria para trás sinais de minha existência?",
                                                    "choices": [
                                                        {
                                                            "id": "745280411",
                                                            "text": "Para mim você não é isso.",
                                                            "response": [
                                                                {
                                                                    "id": "745280413",
                                                                    "speaker": "Skirk",
                                                                    "text": "... Se isso é algo que você decidiu fazer, então faça."
                                                                },
                                                                {
                                                                    "id": "745280414",
                                                                    "speaker": "Skirk",
                                                                    "text": "Vou ficar aqui. Você pode começar quando quiser."
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "745280412",
                                                            "text": "Todo encontro merece ser celebrado."
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "745280409",
                                            "text": "Eu gostaria de tirar uma foto sua."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "745280403",
                            "text": "O que você está fazendo aqui?"
                        }
                    ]
                }
            ]
        }
    ]
