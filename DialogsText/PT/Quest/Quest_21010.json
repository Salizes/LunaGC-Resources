            "dialogues": [
                {
                    "id": "210100001",
                    "speaker": "Dandy",
                    "text": "Hum... Eu preciso pensar..."
                },
                {
                    "id": "210100002",
                    "speaker": "Player",
                    "text": "Qual o problema?"
                },
                {
                    "id": "210100003",
                    "speaker": "Dandy",
                    "text": "Oh, não é nada. Eu estava pensando como esse Albergue Wangshu é alto. Eu me pergunto quanto tempo levaria para descer todas aquelas escadas."
                },
                {
                    "id": "210100004",
                    "speaker": "Dandy",
                    "text": "Eu ia tentar, mas então essas pilhas de folhas destruíram meus planos. Tenho que limpar todos os dias."
                },
                {
                    "id": "210100005",
                    "speaker": "Dandy",
                    "text": "Mas isso significaria descer as escadas, limpando-as um passo de cada vez. É cansativo só de pensar."
                },
                {
                    "id": "210100006",
                    "speaker": "Player",
                    "text": "Eu vou tentar."
                },
                {
                    "id": "210100007",
                    "speaker": "Dandy",
                    "text": "Haha, muito obrigada!"
                }
            ]
        },
        {
            "id": "2101002",
