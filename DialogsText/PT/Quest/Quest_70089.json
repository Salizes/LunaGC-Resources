        {
            "id": "7008901",
            "objective": "",
            "dialogues": [
                {
                    "id": "700890101",
                    "speaker": "Paimon",
                    "text": "Hã, tem alguém aqui!"
                },
                {
                    "id": "700890102",
                    "speaker": "???",
                    "text": "Essa também não..."
                },
                {
                    "id": "700890103",
                    "speaker": "Paimon",
                    "text": "Ei, o que você está fazendo?"
                },
                {
                    "id": "700890104",
                    "speaker": "???",
                    "text": "Estou tentando encontrar o caminho de volta. Só me lembro de que preciso encontrar uma Estátua do Arconte Anemo."
                },
                {
                    "id": "700890105",
                    "speaker": "???",
                    "text": "Não me lembro de mais nada."
                },
                {
                    "id": "700890106",
                    "speaker": "Paimon",
                    "text": "O seu caminho de volta?"
                },
                {
                    "id": "700890107",
                    "speaker": "???",
                    "text": "É uma vaga sensação de saudade de casa, mas não consigo me lembrar de nada."
                },
                {
                    "id": "700890108",
                    "speaker": "???",
                    "text": "Quando acordei, a única coisa que eu tinha era um bilhete na minha mão que dizia: \"Você é o 'Maukie'.\""
                },
                {
                    "id": "700890109",
                    "speaker": "\"Maukie\"",
                    "text": "Então eu suponho que meu nome é Maukie."
                },
                {
                    "id": "700890110",
                    "speaker": "\"Maukie\"",
                    "text": "Acho que já vou indo. Tchau."
                },
                {
                    "id": "700890111",
                    "speaker": "Paimon",
                    "text": "Que pessoa estranha. Mas ele não parece ser um cara ruim."
                },
                {
                    "id": "700890112",
                    "speaker": "Paimon",
                    "text": "Você está bem?"
                },
                {
                    "id": "700890113",
                    "speaker": "Player",
                    "text": "Eu tive uma visão estranha."
                },
                {
                    "id": "700890114",
                    "speaker": "Paimon",
                    "text": "Uma visão estranha? Será que é porque aquela pessoa tocou na estátua agora há pouco?"
                }
            ]
        }
    ]
