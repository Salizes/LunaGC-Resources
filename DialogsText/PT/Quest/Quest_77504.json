    "talks": [
        {
            "id": "7750401",
            "objective": "",
            "dialogues": [
                {
                    "id": "775040101",
                    "speaker": "???",
                    "text": "Hm? Mais recrutas novatos?"
                },
                {
                    "id": "775040102",
                    "speaker": "Paimon",
                    "text": "Hã? Recrutas novatos? Ela está falando da gente?"
                },
                {
                    "id": "775040103",
                    "speaker": "???",
                    "text": "Vocês não se vestem como moradores daqui e estavam bisbilhotando por perto... São amigos do Pinhãozinho e da Figura de Madeira?"
                },
                {
                    "id": "775040104",
                    "speaker": "???",
                    "text": "Na verdade, esquece! Boas-vindas à \"Rede de Ajuda Mútua e Progresso\" de Morepesok!"
                },
                {
                    "id": "775040105",
                    "speaker": "Krejcikova",
                    "text": "Agora vocês estão em boas mãos, as mãos de Krejcikova, abençoada pela Srta. Katheryne, reconhecida por Talalikhin e favorecida pelo \"Novo Limiar\"!"
                },
                {
                    "id": "775040106",
                    "speaker": "Paimon",
                    "text": "Rede de Ajuda Mútua e Progresso...? Paimon nunca ouviu falar disso..."
                },
                {
                    "id": "775040107",
                    "speaker": "Krejcikova",
                    "text": "É exatamente o que o nome diz! Somos um grupo que ajuda as pessoas a treinar, melhorar e ficarem mais fortes juntas."
                },
                {
                    "id": "775040108",
                    "speaker": "Krejcikova",
                    "text": "Se vocês têm ambição para deixar sua marca no mundo, então venham conosco!",
                    "choices": [
                        {
                            "id": "775040109",
                            "text": "Tô dentro! Ambição é o que não me falta.",
                            "response": [
                                {
                                    "id": "775040111",
                                    "speaker": "Krejcikova",
                                    "text": "Então venha comigo. Vou apresentar vocês aos outros."
                                },
                                {
                                    "id": "775040112",
                                    "speaker": "Krejcikova",
                                    "text": "Estamos prestes a começar esta rodada de atividades, então vocês chegaram na hora perfeita!"
                                },
                                {
                                    "id": "775040113",
                                    "speaker": "Paimon",
                                    "text": "Ei, espera aí! Por que você entrou nessa tão rápido?"
                                },
                                {
                                    "id": "775040114",
                                    "speaker": "Paimon",
                                    "text": "Paimon sabe que você não é de se gabar, mas vamos mesmo fingir que somos \"recrutas novatos\"?",
                                    "choices": [
                                        {
                                            "id": "775040115",
                                            "text": "Não faz mal entrar na onda de alguém tão animada assim, né?",
                                            "response": [
                                                {
                                                    "id": "775040117",
                                                    "speaker": "Paimon",
                                                    "text": "Uau... Foi a Nicole que colocou essas ideias na sua cabeça? Agora você quer encenar algum cenário de romance leve ou algo assim?"
                                                },
                                                {
                                                    "id": "775040118",
                                                    "speaker": "Paimon",
                                                    "text": "...Ah. Paimon até que também quer tentar."
                                                },
                                                {
                                                    "id": "775040119",
                                                    "speaker": "Krejcikova",
                                                    "text": "Você segue Krejcikova até um ponto de encontro perto da estação."
                                                },
                                                {
                                                    "id": "775040120",
                                                    "speaker": "Krejcikova",
                                                    "text": "Chegamos! Esta é a nossa base."
                                                },
                                                {
                                                    "id": "775040121",
                                                    "speaker": "Paimon",
                                                    "text": "Ah, então eles não são todos de Snezhnaya? Tem crianças de Natlan e de Liyue também?"
                                                },
                                                {
                                                    "id": "775040122",
                                                    "speaker": "Pequena Pinha",
                                                    "text": "Hã? Figura de Madeira, aquela pessoa não parece familiar?"
                                                },
                                                {
                                                    "id": "775040123",
                                                    "speaker": "Boneco de Madeira de Árvore Combustiva",
                                                    "text": "Espera, Pequena Pinha... Eu não estou vendo coisas, né? Aquele é... A-A-Aquele é...!"
                                                },
                                                {
                                                    "id": "775040124",
                                                    "speaker": "Boneco de Madeira de Árvore Combustiva",
                                                    "text": "Tu-Tu-Tu-Tu-...",
                                                    "choices": [
                                                        {
                                                            "id": "775040125",
                                                            "text": "Fofo demais para descrever?",
                                                            "response": [
                                                                {
                                                                    "id": "775040127",
                                                                    "speaker": "Paimon",
                                                                    "text": "Pff..."
                                                                },
                                                                {
                                                                    "id": "775040128",
                                                                    "speaker": "Paimon",
                                                                    "text": "#Como Paimon pode explicar...? Hmm... {NICKNAME} está tentando manter quem {M#ele}{F#ela} realmente é em segredo por enquanto."
                                                                },
                                                                {
                                                                    "id": "775040129",
                                                                    "speaker": "Boneco de Madeira de Árvore Combustiva",
                                                                    "text": "Então quer dizer que... vocês estão realizando uma missão especial? Acho que entendi."
                                                                },
                                                                {
                                                                    "id": "775040130",
                                                                    "speaker": "Pequena Pinha",
                                                                    "text": "Vamos guardar segredo!"
                                                                },
                                                                {
                                                                    "id": "775040173",
                                                                    "speaker": "Krejcikova",
                                                                    "text": "",
                                                                    "choices": [
                                                                        {
                                                                            "id": "775040131",
                                                                            "text": "Essa era a senha.",
                                                                            "response": [
                                                                                {
                                                                                    "id": "775040133",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "Isso mesmo! Estamos no círculo do Pequeno Pinhão e do Boneco de Madeira agora, então é claro que conhecemos o jargão."
                                                                                },
                                                                                {
                                                                                    "id": "775040134",
                                                                                    "speaker": "Boneco de Madeira de Árvore Combustiva",
                                                                                    "text": "Eu? Ela? Tumaini... no nosso círculo?"
                                                                                },
                                                                                {
                                                                                    "id": "775040135",
                                                                                    "speaker": "Pequena Pinha",
                                                                                    "text": "P-P-Precisamos escrever para a Vigee agora mesmo e contar para ela!"
                                                                                },
                                                                                {
                                                                                    "id": "775040136",
                                                                                    "speaker": "Krejcikova",
                                                                                    "text": "Nossa, vocês dois entendem mesmo do assunto! Não é de se admirar que tenham cruzado montanhas e mares para chegar até aqui, vindo lá da escaldante Natlan até a gélida Snezhnaya..."
                                                                                },
                                                                                {
                                                                                    "id": "775040137",
                                                                                    "speaker": "Krejcikova",
                                                                                    "text": "Querem pão de centeio e sopa quentinha? Aqueçam-se, recuperem o fôlego e aí vamos tratar do assunto!"
                                                                                },
                                                                                {
                                                                                    "id": "775040138",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "Você já está cuidando de todo mundo como uma irmã mais velha de verdade."
                                                                                },
                                                                                {
                                                                                    "id": "775040139",
                                                                                    "speaker": "Krejcikova",
                                                                                    "text": "Claro! Os dois irmãos mais velhos que confiaram a Rede a mim são aventureiros profissionais. Quero seguir os passos deles e me tornar uma verdadeira especialista em ajudar as pessoas."
                                                                                },
                                                                                {
                                                                                    "id": "775040140",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "Dividir lanches ajuda mesmo todo mundo a se recuperar rapidinho, mas só lanches não vão transformar você numa mestre da ajuda..."
                                                                                },
                                                                                {
                                                                                    "id": "775040141",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "Então, qual é o resto do plano?"
                                                                                },
                                                                                {
                                                                                    "id": "775040142",
                                                                                    "speaker": "Krejcikova",
                                                                                    "text": "Hehe, nosso segredo é \"compartilhar tudo\"..."
                                                                                },
                                                                                {
                                                                                    "id": "775040143",
                                                                                    "speaker": "Krejcikova",
                                                                                    "text": "A Guilda de Aventureiros é mais uma rede solta do que uma organização rígida. A Srta. Katheryne distribui comissões, e os aventureiros capazes chegam ao topo."
                                                                                },
                                                                                {
                                                                                    "id": "775040144",
                                                                                    "speaker": "Krejcikova",
                                                                                    "text": "Mas, às vezes, os mais fortes começam a ver uns aos outros como rivais. Eles guardam seus melhores truques para si mesmos, e isso significa que toda essa experiência conquistada com tanto esforço nunca é compartilhada entre os colegas aventureiros."
                                                                                },
                                                                                {
                                                                                    "id": "775040145",
                                                                                    "speaker": "Krejcikova",
                                                                                    "text": "Por exemplo, pode haver um jeito simples de derrotar certo monstro, mas se ninguém compartilhar, grupo após grupo precisa aprender da forma mais difícil e voltar todo machucado."
                                                                                },
                                                                                {
                                                                                    "id": "775040146",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "É, faz sentido... Pensando bem, esse tipo de coisa também acontece em várias outras áreas..."
                                                                                },
                                                                                {
                                                                                    "id": "775040147",
                                                                                    "speaker": "Krejcikova",
                                                                                    "text": "Isso mesmo! Como disse um irmão mais velho de Fontaine: \"Por toda Teyvat, as pessoas continuam inventando a mesma roda todos os dias.\""
                                                                                },
                                                                                {
                                                                                    "id": "775040148",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "Paimon entendeu. Nem todos os aventureiros se conhecem, e eles não se reúnem depois de cada comissão para trocar dicas, né?"
                                                                                },
                                                                                {
                                                                                    "id": "775040149",
                                                                                    "speaker": "Krejcikova",
                                                                                    "text": "Eu não entendo muito bem por que eles fazem as coisas assim. Enfim, nossa Rede de Ajuda Mútua e Progresso vai mudar isso."
                                                                                },
                                                                                {
                                                                                    "id": "775040150",
                                                                                    "speaker": "Krejcikova",
                                                                                    "text": "A coisa mais importante na nossa Rede é compartilhar todos os tipos de dicas e ferramentas entre nós, assim como compartilhar comida gostosa."
                                                                                },
                                                                                {
                                                                                    "id": "775040151",
                                                                                    "speaker": "Krejcikova",
                                                                                    "text": "Nós compartilhamos mapas marcados com locais importantes, anotações cheias de técnicas especiais, manuais antigos de espada, pedaços de espadas lendárias... todo tipo de coisa boa."
                                                                                },
                                                                                {
                                                                                    "id": "775040152",
                                                                                    "speaker": "Krejcikova",
                                                                                    "text": "Claro, os membros também podem compartilhar aqui equipamentos e suprimentos que tiverem sobrando. Às vezes, eles até trocam presentes."
                                                                                },
                                                                                {
                                                                                    "id": "775040153",
                                                                                    "speaker": "Krejcikova",
                                                                                    "text": "Quando cada um contribui com o que pode, todas essas forças se juntam. Assim, cada vez mais pessoas conseguem resolver todo tipo de problema com muito mais facilidade!",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "775040154",
                                                                                            "text": "É uma ideia interessante.",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "775040156",
                                                                                                    "speaker": "Paimon",
                                                                                                    "text": "Então, como as coisas estão indo até agora?"
                                                                                                },
                                                                                                {
                                                                                                    "id": "775040157",
                                                                                                    "speaker": "Krejcikova",
                                                                                                    "text": "Aham... Bom, nós acabamos de retomar as atividades, então ainda não estamos exatamente em plena forma."
                                                                                                },
                                                                                                {
                                                                                                    "id": "775040158",
                                                                                                    "speaker": "Krejcikova",
                                                                                                    "text": "Achei que o primeiro passo deveria ser fazer todo mundo se familiarizar com Snezhnaya, então planejei explorar todo tipo de lugar."
                                                                                                },
                                                                                                {
                                                                                                    "id": "775040159",
                                                                                                    "speaker": "Krejcikova",
                                                                                                    "text": "É só chegar ao local marcado, dar uma boa olhada ao redor, tirar alguns registros com nosso Aparelho Fotográfico e experimentar quaisquer mecanismos que encontrarem por lá. Façam tudo isso, e vamos considerar um sucesso!"
                                                                                                },
                                                                                                {
                                                                                                    "id": "775040160",
                                                                                                    "speaker": "Paimon",
                                                                                                    "text": "S-Sim, justo. Você e os outros ainda são bem jovens, então seria um pouco perigoso partir direto para as tarefas mais difíceis."
                                                                                                },
                                                                                                {
                                                                                                    "id": "775040161",
                                                                                                    "speaker": "Krejcikova",
                                                                                                    "text": "Talvez ainda não tenhamos grandes conquistas... mas antes de a Rede ser entregue a mim, ela realmente fez a diferença para muita gente."
                                                                                                },
                                                                                                {
                                                                                                    "id": "775040162",
                                                                                                    "speaker": "Krejcikova",
                                                                                                    "text": "Acredito que, se todos nós trabalharmos duro e encorajarmos uns aos outros dia após dia, vamos continuar ficando mais fortes!"
                                                                                                },
                                                                                                {
                                                                                                    "id": "775040163",
                                                                                                    "speaker": "Paimon",
                                                                                                    "text": "Certo, isso sim é motivação de verdade! Você definitivamente tem a atitude certa."
                                                                                                },
                                                                                                {
                                                                                                    "id": "775040164",
                                                                                                    "speaker": "Paimon",
                                                                                                    "text": "#E quando se trata de explorar lugares que quase ninguém conhece, {NICKNAME} e Paimon são a equipe perfeita para o trabalho. Então vamos contribuir e dar uma mão a eles!"
                                                                                                },
                                                                                                {
                                                                                                    "id": "775040165",
                                                                                                    "speaker": "Paimon",
                                                                                                    "text": "Além disso... Krejcikova nos recebeu tão bem. Sem falar do pão de centeio e da sopa reforçada.",
                                                                                                    "choices": [
                                                                                                        {
                                                                                                            "id": "775040166",
                                                                                                            "text": "Apoiar uns aos outros assim é muito bom.",
                                                                                                            "response": [
                                                                                                                {
                                                                                                                    "id": "775040168",
                                                                                                                    "speaker": "Krejcikova",
                                                                                                                    "text": "Vou me preparar, então também vou indo! Se em sua jornada você encontrar algo legal, venha nos contar sobre. Oh, e aproveitando, dê uma olhada na caixa de correio da base, beleza?"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "775040169",
                                                                                                                    "speaker": "Krejcikova",
                                                                                                                    "text": "Nunca se sabe quais surpresinhas podem aparecer!"
                                                                                                                }
                                                                                                            ]
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "775040167",
                                                                                                            "text": "É bem interessante ver novos aventureiros crescerem."
                                                                                                        }
                                                                                                    ]
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "775040155",
                                                                                            "text": "É uma meta pela qual vale a pena se esforçar."
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "775040132",
                                                                            "text": "Só um jargão interno."
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "775040126",
                                                            "text": "Mau demais para perdoar?"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "775040116",
                                            "text": "Talvez seja divertido tentar ser normal uma vez na vida."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "775040110",
                            "text": "Somos nós, recrutas novatos, prontos para aprender o básico."
                        }
                    ]
                }
            ]
        }
    ]
}