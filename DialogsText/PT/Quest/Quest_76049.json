    "talks": [
        {
            "id": "7604901",
            "objective": "Encontre-se com Damselette",
            "dialogues": [
                {
                    "id": "760490603",
                    "speaker": "Player",
                    "text": "Vamos tentar algo calmo e suave..."
                },
                {
                    "id": "760490604",
                    "speaker": "Damselette",
                    "text": "Isso foi adorável. Então você realmente memorizou a minha canção."
                },
                {
                    "id": "760490605",
                    "speaker": "Paimon",
                    "text": "Hehe, só porque você é uma ótima cantora! Sempre que ouvimos sua voz, às vezes até paramos só para escutar..."
                },
                {
                    "id": "760490606",
                    "speaker": "Damselette",
                    "text": "Hm, os Kuuhenki também pareceram bastante encantados com sua apresentação. Talvez eles tenham aprendido algumas coisas..."
                },
                {
                    "id": "760490607",
                    "speaker": "Damselette",
                    "text": "Talvez eu precise da sua ajuda educacional novamente no futuro."
                },
                {
                    "id": "760490608",
                    "speaker": "Damselette",
                    "text": "Venha, me dê sua mão."
                },
                {
                    "id": "760490609",
                    "speaker": "Paimon",
                    "text": "Hã? Não, não, essa foi uma apresentação gratuita. Não é necessário pagar nenhuma mensalidade!"
                },
                {
                    "id": "760490610",
                    "speaker": "Damselette",
                    "text": "Hmm? Mensalidade?"
                },
                {
                    "id": "760490611",
                    "speaker": "Damselette",
                    "text": "Eu só pensei... que o suave brilho do luar seria um acompanhamento perfeito para uma melodia tão bela."
                }
            ]
        },
        {
            "id": "7604901",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "760490101",
                    "speaker": "Damselette",
                    "text": "...Hmm, meio tom acima, talvez. Vamos tentar de novo, certo?"
                },
                {
                    "id": "760490102",
                    "speaker": "Paimon",
                    "text": "Oi, Columbina!"
                },
                {
                    "id": "760490103",
                    "speaker": "Paimon",
                    "text": "Espera, você está... ensinando o Kuuhenki a tocar a lira?"
                },
                {
                    "id": "760490104",
                    "speaker": "Damselette",
                    "text": "Sim. Eles ficaram tão felizes por tê-la consertada que praticamente não saíram do meu lado."
                },
                {
                    "id": "760490105",
                    "speaker": "Damselette",
                    "text": "Mas tocar lira nunca foi meu forte. Estou mais acostumada a ouvir os outros tocarem."
                },
                {
                    "id": "760490106",
                    "speaker": "Paimon",
                    "text": "Ahhh, verdade! Se você tivesse uma banda, com certeza ficaria encarregada dos vocais, né...?"
                },
                {
                    "id": "760490107",
                    "speaker": "Paimon",
                    "text": "#Mas quando se trata de instrumentos... {M#o}{F#a} Viajante é praticamente um prodígio! Da lira ao Tambor Djem Djem, ess{M#e}{F#a} aqui toca de tudo!",
                    "choices": [
                        {
                            "id": "760490108",
                            "text": "#Eu não sou nada de especial, pra ser sincer{M#o}{F#a}...",
                            "response": [
                                {
                                    "id": "760490110",
                                    "speaker": "Damselette",
                                    "text": "Ah, é mesmo? Nesse caso... talvez você pudesse ensiná-los no meu lugar?",
                                    "choices": [
                                        {
                                            "id": "760490111",
                                            "text": "Tudo bem então, por que não?",
                                            "response": [
                                                {
                                                    "id": "760490113",
                                                    "speaker": "Damselette",
                                                    "text": "Eu estava fazendo eles praticarem a canção que costumo cantar. Talvez você se lembre de como ela é..."
                                                },
                                                {
                                                    "id": "760490114",
                                                    "speaker": "Damselette",
                                                    "text": "Ou... Uma melodia diferente também serve. Raramente os Kuuhenki têm a chance de ouvir músicas de outros lugares. Eu também ficaria bastante interessada em ouvir algo assim."
                                                },
                                                {
                                                    "id": "760490115",
                                                    "speaker": "Player",
                                                    "text": "(Hmm, o que devo tocar...?)",
                                                    "choices": [
                                                        {
                                                            "id": "760490202",
                                                            "text": "Vamos tentar aquela que Columbina está sempre cantando...",
                                                            "response": [
                                                                {
                                                                    "id": "760490201",
                                                                    "speaker": "Player",
                                                                    "text": "(Mas que tom devo escolher...?)",
                                                                    "choices": [
                                                                        {
                                                                            "id": "760490603",
                                                                            "text": "Vamos tentar algo calmo e suave..."
                                                                        },
                                                                        {
                                                                            "id": "760490701",
                                                                            "text": "Vamos dar uma animada...",
                                                                            "response": [
                                                                                {
                                                                                    "id": "760490702",
                                                                                    "speaker": "Damselette",
                                                                                    "text": "Ah, já acabou? Eu poderia ouvir isso para sempre..."
                                                                                },
                                                                                {
                                                                                    "id": "760490703",
                                                                                    "speaker": "Damselette",
                                                                                    "text": "Como já lhe disse uma vez, essa é a única canção de ninar que consigo lembrar."
                                                                                },
                                                                                {
                                                                                    "id": "760490704",
                                                                                    "speaker": "Damselette",
                                                                                    "text": "Embora eu ainda não tenha compreendido o significado por trás dela, depois de ouvir você tocar, sinto que, seja qual for a resposta que me aguarda lá em cima, na lua... ao menos, deve ser uma resposta bela."
                                                                                },
                                                                                {
                                                                                    "id": "760490705",
                                                                                    "speaker": "Damselette",
                                                                                    "text": "Aqui, me dê sua mão."
                                                                                },
                                                                                {
                                                                                    "id": "760490706",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "Está tudo bem. Sério, você não precisa nos dar nada em troca."
                                                                                },
                                                                                {
                                                                                    "id": "760490707",
                                                                                    "speaker": "Damselette",
                                                                                    "text": "Ah, essa não era minha intenção... Eu só queria enfeitar sua melodia com um raio de suave luar."
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "760490801",
                                                            "text": "Vamos tentar algo de outra nação...",
                                                            "response": [
                                                                {
                                                                    "id": "760490802",
                                                                    "speaker": "Damselette",
                                                                    "text": "Que curioso... Já ouvi melodias como essa antes, mas a sua maneira de tocar lhes dá uma dimensão totalmente nova..."
                                                                },
                                                                {
                                                                    "id": "760490803",
                                                                    "speaker": "Paimon",
                                                                    "text": "#Ah, talvez seja porque {M#o}{F#a} Viajante estava canalizando seu vínculo emocional com aquele lugar..."
                                                                },
                                                                {
                                                                    "id": "760490804",
                                                                    "speaker": "Damselette",
                                                                    "text": "Curioso... É como se eu conseguisse imaginar a paisagem só de ouvir a melodia. Fico pensando em como será a comparação entre a realidade e a minha imaginação..."
                                                                },
                                                                {
                                                                    "id": "760490805",
                                                                    "speaker": "Paimon",
                                                                    "text": "Você devia ir ver com seus próprios olhos algum dia! Nós podemos ser seus guias!"
                                                                },
                                                                {
                                                                    "id": "760490806",
                                                                    "speaker": "Damselette",
                                                                    "text": "Mm... Talvez. Se esse dia chegar."
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "760490112",
                                            "text": "Mas o que eu devo tocar?"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "760490109",
                            "text": "Embora já tenha arriscado um pouco..."
                        }
                    ]
                }
            ]
        },
        {
            "id": "7604903",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "760490301",
                    "speaker": "Damselette",
                    "text": "Os kuuhenki parecem bastante satisfeitos por hoje. Ainda assim... Talvez eu precise incomodá-lo para voltar quando eles quiserem aprender mais."
                }
            ]
        },
        {
            "id": "7604907",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "760490709",
                    "speaker": "Damselette",
                    "text": "Perfuramos as nuvens e a névoa, e juntos testemunhamos a resposta na lua... Sua beleza é como a música que agora vibra em suas cordas."
                }
            ]
        }
    ]
}