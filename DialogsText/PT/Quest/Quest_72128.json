        },
        {
            "id": "7212809",
            "objective": "",
            "dialogues": [
                {
                    "id": "721280102",
                    "speaker": "Takashi",
                    "text": "Espere um minuto! Você não pode sair abrindo os baús à vontade.",
                    "choices": [
                        {
                            "id": "721280103",
                            "text": "Esses baús são seus?",
                            "response": [
                                {
                                    "id": "721280104",
                                    "speaker": "Takashi",
                                    "text": "Claro, coloquei todos esses baús aqui de propósito."
                                },
                                {
                                    "id": "721280106",
                                    "speaker": "Takashi",
                                    "text": "Esses baús estão cheios de todos os tipos de tesouros que colecionei."
                                },
                                {
                                    "id": "721280107",
                                    "speaker": "Takashi",
                                    "text": "Se você quiser abrir esses baús de tesouro, não é impossível. Mas bem .. você tem que me dar algo em troca.",
                                    "choices": [
                                        {
                                            "id": "721280108",
                                            "text": "Você quer Mora?",
                                            "response": [
                                                {
                                                    "id": "721280109",
                                                    "speaker": "Takashi",
                                                    "text": "Hahaha, não preciso de Mora."
                                                },
                                                {
                                                    "id": "721280111",
                                                    "speaker": "Takashi",
                                                    "text": "Um tipo de concha."
                                                },
                                                {
                                                    "id": "721280112",
                                                    "speaker": "Takashi",
                                                    "text": "Creio que consiga encontrar muitas dessas conchas pela praia."
                                                },
                                                {
                                                    "id": "721280113",
                                                    "speaker": "Takashi",
                                                    "text": "Se você quiser abrir os baús e pegar os tesouros, venha trocar comigo por conchas."
                                                },
                                                {
                                                    "id": "721280114",
                                                    "speaker": "Takashi",
                                                    "text": "Porém... Não vou te dizer o que há nesses baús, o que você for ganhar dependerá inteiramente da sua sorte."
                                                },
                                                {
                                                    "id": "721280115",
                                                    "speaker": "Takashi",
                                                    "text": "O que acha? Baús cheios de tesouros por conchas."
                                                }
                                            ]
                                        },
                                        {
                                            "id": "721280110",
                                            "text": "Do que você precisa então?"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "721280105",
                            "text": "O que tem dentro?"
                        }
