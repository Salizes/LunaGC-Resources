            "dialogues": [
                {
                    "id": "721280801",
                    "speaker": "Player",
                    "text": "Quero abrir um baú."
                },
                {
                    "id": "721280802",
                    "speaker": "Takashi",
                    "text": "Traga as conchas para mim que você poderá abrir."
                }
