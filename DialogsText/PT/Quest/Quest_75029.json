    "talks": [
        {
            "id": "7502901",
            "objective": "",
            "dialogues": [
                {
                    "id": "750290101",
                    "speaker": "???",
                    "text": "...",
                    "choices": [
                        {
                            "id": "750290102",
                            "text": "Errr, olá?",
                            "response": [
                                {
                                    "id": "750290104",
                                    "speaker": "???",
                                    "text": "Bahahahaha!"
                                },
                                {
                                    "id": "750290105",
                                    "speaker": "Paimon",
                                    "text": "Arg! Você quase matou Paimon do coração!"
                                },
                                {
                                    "id": "750290106",
                                    "speaker": "???",
                                    "text": "Imagino que você também esteja aqui pelo treinamento especial!?"
                                },
                                {
                                    "id": "750290107",
                                    "speaker": "???",
                                    "text": "Eu sabia, eu sabia! Seja humano ou Sauriano, guerreiros ambiciosos são sempre atraídos uns aos outros!"
                                },
                                {
                                    "id": "750290108",
                                    "speaker": "???",
                                    "text": "Bem, então, sem mais delongas, vamos direto para o treinamento especial!",
                                    "choices": [
                                        {
                                            "id": "750290109",
                                            "text": "Então eles também têm isso por aqui, hein...",
                                            "response": [
                                                {
                                                    "id": "750290111",
                                                    "speaker": "Paimon",
                                                    "text": "Sequer demos uma palavra! O que te faz pensar que estamos aqui pelo seu treinamento especial?"
                                                },
                                                {
                                                    "id": "750290112",
                                                    "speaker": "Paimon",
                                                    "text": "Mas, da forma que você fala... Você não é algum tipo de Mestre Treinador, é?"
                                                },
                                                {
                                                    "id": "750290113",
                                                    "speaker": "???",
                                                    "text": "Não é qualquer um que pode se tornar um Mestre Treinador, sabe. Não sou tão habilidoso..."
                                                },
                                                {
                                                    "id": "750290114",
                                                    "speaker": "Matahga",
                                                    "text": "Mas espera, você quer dizer... Você não voou até aqui para ter um treinamento de guerreiro especial de mim, Matahga!?",
                                                    "choices": [
                                                        {
                                                            "id": "750290115",
                                                            "text": "Só estamos de passagem.",
                                                            "response": [
                                                                {
                                                                    "id": "750290117",
                                                                    "speaker": "Matahga",
                                                                    "text": "Voar em cima de um Sauriano mostra que você sabe o básico, mas tamanha falta de ambição... que desperdício!"
                                                                },
                                                                {
                                                                    "id": "750290118",
                                                                    "speaker": "Matahga",
                                                                    "text": "#Achei que você era {M#um guerreiro}{F#uma guerreira} que pensava da mesma forma... que pena!"
                                                                },
                                                                {
                                                                    "id": "750290119",
                                                                    "speaker": "Matahga",
                                                                    "text": "Parece que eu te julguei mal... Honestamente, que lástima!"
                                                                },
                                                                {
                                                                    "id": "750290120",
                                                                    "speaker": "Paimon",
                                                                    "text": "Paimon deveria dizer que Natlan certamente é uma nação de heróis, ou que seu povo só tem o sangue quente mesmo? Até as crianças são super animadas!",
                                                                    "choices": [
                                                                        {
                                                                            "id": "750290121",
                                                                            "text": "Crianças? Não é bem assim...",
                                                                            "response": [
                                                                                {
                                                                                    "id": "750290123",
                                                                                    "speaker": "Matahga",
                                                                                    "text": "É o total oposto! Preguiça não é desculpa uma vez que você decidiu se tornar um guerreiro! Aqueles que não têm coragem, determinação e ambição jamais terão sucesso!"
                                                                                },
                                                                                {
                                                                                    "id": "750290124",
                                                                                    "speaker": "Matahga",
                                                                                    "text": "E eu já tenho doze anos! Parei de ser uma criança no momento que cheguei aos dois dígitos... Mas, eu te perdoo."
                                                                                },
                                                                                {
                                                                                    "id": "750290125",
                                                                                    "speaker": "Matahga",
                                                                                    "text": "Claro, minha altura não mudou, não importa o quanto de leite eu beba, mas minha determinação? É inquebrável e forte suficiente para derrubar qualquer obstáculo em meu caminho!"
                                                                                },
                                                                                {
                                                                                    "id": "750290126",
                                                                                    "speaker": "Matahga",
                                                                                    "text": "#Além disso, ainda estou crescendo, e não é como se vocês fossem tão alt{M#o}{F#a}s também!"
                                                                                },
                                                                                {
                                                                                    "id": "750290127",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "Q-Quanta energia! Mas por que você nos arrastou para isso?"
                                                                                },
                                                                                {
                                                                                    "id": "750290128",
                                                                                    "speaker": "Matahga",
                                                                                    "text": "Hnf! Admito que a força física de uma pessoa depende de seu físico, mas um guerreiro de verdade jamais deixaria isso se tornar uma limitação!"
                                                                                },
                                                                                {
                                                                                    "id": "750290129",
                                                                                    "speaker": "Matahga",
                                                                                    "text": "A mente domina o corpo, em qualquer dia da semana... E isso precisa de fé e crença em seus próprios sonhos e ambição!"
                                                                                },
                                                                                {
                                                                                    "id": "750290130",
                                                                                    "speaker": "Matahga",
                                                                                    "text": "Até aventureiros devem ser capazes de entender verdades tão simples!"
                                                                                },
                                                                                {
                                                                                    "id": "750290131",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "O que ele disse faz sentido, mas... Para Paimon quase soa como se... ele estivesse tirando onda com a gente?",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "750290132",
                                                                                            "text": "É.",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "750290134",
                                                                                                    "speaker": "Matahga",
                                                                                                    "text": "#Eu estava explicando a necessidade de ambição para pessoas preguiçosas como você. Você jamais vai ser {M#um herói}{F#uma heroína} de verdade se você é sempre tão relaxad{M#o}{F#a}!"
                                                                                                },
                                                                                                {
                                                                                                    "id": "750290135",
                                                                                                    "speaker": "Matahga",
                                                                                                    "text": "Como um guerreiro... Não, como uma pessoa... Sem ambição e trabalho duro nos campos de treinamentos, você não é nada além de um fracasso!"
                                                                                                },
                                                                                                {
                                                                                                    "id": "750290136",
                                                                                                    "speaker": "Matahga",
                                                                                                    "text": "Se você não consegue voar pelos céus como um herói, ou receber o reconhecimento de um Mestre Treinador, então você não é nada além de um fracasso!"
                                                                                                },
                                                                                                {
                                                                                                    "id": "750290137",
                                                                                                    "speaker": "Matahga",
                                                                                                    "text": "Então você precisa treinar bastante! Entendido!?"
                                                                                                },
                                                                                                {
                                                                                                    "id": "750290138",
                                                                                                    "speaker": "Paimon",
                                                                                                    "text": "E-Entendido! Uh... O que fazemos agora? Ele fala tão alto e tudo que ele diz é razoável, isso é impossível de Paimon debater!"
                                                                                                },
                                                                                                {
                                                                                                    "id": "750290139",
                                                                                                    "speaker": "Matahga",
                                                                                                    "text": "#Ótimo! Se você está pront{M#o}{F#a} para aprimorar suas habilidades, venha me ver para ter alguns treinamentos especiais! Seu objetivo é voar seu Sauriano a toda velocidade ao longo da pista e marcar a pontuação mais alta que conseguir."
                                                                                                },
                                                                                                {
                                                                                                    "id": "750290140",
                                                                                                    "speaker": "Matahga",
                                                                                                    "text": "Durante o treinamento, observarei e pontuarei as performances em cada ponto de verificação. Os resultados serão divididos em quatro categorias baseado nessas pontuações."
                                                                                                },
                                                                                                {
                                                                                                    "id": "750290141",
                                                                                                    "speaker": "Matahga",
                                                                                                    "text": "Voem o mais rápido que puderem! Mesmo que não consigam chegar à maior categoria, pelo menos, vocês devem chegar à segunda maior!"
                                                                                                },
                                                                                                {
                                                                                                    "id": "750290142",
                                                                                                    "speaker": "Matahga",
                                                                                                    "text": "Agora, é hora de vocês se animarem, e não deixem que minha sombra coloque vocês para comer poeira! Vai, vai, vai!"
                                                                                                },
                                                                                                {
                                                                                                    "id": "750290143",
                                                                                                    "speaker": "Matahga",
                                                                                                    "text": "..."
                                                                                                },
                                                                                                {
                                                                                                    "id": "750290144",
                                                                                                    "speaker": "Matahga",
                                                                                                    "text": "#Guerreir{M#o}{F#a}, aguardo sua resposta!",
                                                                                                    "choices": [
                                                                                                        {
                                                                                                            "id": "750290145",
                                                                                                            "text": "E-Entendido!",
                                                                                                            "response": [
                                                                                                                {
                                                                                                                    "id": "750290146",
                                                                                                                    "speaker": "Matahga",
                                                                                                                    "text": "Não consigo te ouvir, você precisa FALAR MAIS ALTO!"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "750290147",
                                                                                                                    "speaker": "Player",
                                                                                                                    "text": "ENTENDIDO!!!!"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "750290148",
                                                                                                                    "speaker": "Matahga",
                                                                                                                    "text": "É aqui que guerreiros aspirantes vêm para aprimorar suas habilidades. Agora, me mostre sua determinação e nunca pare de desafiar seus limites!"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "750290149",
                                                                                                                    "speaker": "Matahga",
                                                                                                                    "text": "#Venha falar comigo para treinar quando estiver pront{M#o}{F#a}."
                                                                                                                }
                                                                                                            ]
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "750290150",
                                                                                                            "text": "Entendido! Mas, prefiro não fazer isso!",
                                                                                                            "response": [
                                                                                                                {
                                                                                                                    "id": "750290151",
                                                                                                                    "speaker": "Matahga",
                                                                                                                    "text": "O quê!? Você ainda se recusa a largar sua preguiça!?"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "750290152",
                                                                                                                    "speaker": "Matahga",
                                                                                                                    "text": "Que coisa deplorável! Mas, não importa. Chegará um dia em que você não mais será capaz de tolerar suas falhas!"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "750290153",
                                                                                                                    "speaker": "Matahga",
                                                                                                                    "text": "Ficar fugindo e com medo para sempre não vai te levar a lugar nenhum, e te deixar sem nada! Apenas a seguir adiante que você pode esperar se sobrepor e fazer o mundo ressoar com sua risada estrondosa!"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "750290154",
                                                                                                                    "speaker": "Matahga",
                                                                                                                    "text": "Hnf, marque minhas palavras! Mas mesmo quando esse momento chegar, não será tarde demais para vir se aperfeiçoar aqui."
                                                                                                                }
                                                                                                            ]
                                                                                                        }
                                                                                                    ]
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "750290133",
                                                                                            "text": "Por que você está tirando onda com a gente?"
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "750290122",
                                                                            "text": "Isso é meio extremo, moleque."
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "750290116",
                                                            "text": "#Nunca subestime a curiosidade de {M#um aventureiro}{F#uma aventureira}."
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "750290110",
                                            "text": "O que você quer dizer com \"treinamento especial\"?"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "750290103",
                            "text": "Olá."
                        }
                    ]
                }
            ]
        },
        {
            "id": "7502905",
            "objective": "",
            "dialogues": [
                {
                    "id": "750290501",
                    "speaker": "Matahga",
                    "text": "#Guerreir{M#o}{F#a}! Como está indo seu treinamento nesse percurso?",
                    "choices": [
                        {
                            "id": "750290502",
                            "text": "Estou fazendo progresso.",
                            "response": [
                                {
                                    "id": "750290503",
                                    "speaker": "Matahga",
                                    "text": "Pah, fraco! Se você não está dando um passo para frente, então é um passo atrás!"
                                },
                                {
                                    "id": "750290506",
                                    "speaker": "Paimon",
                                    "text": "Ugh, como que a Paimon deve dizer isso... parece que \"em frente\" e os seus sinônimos são as únicas palavras no dicionário de Matahga."
                                },
                                {
                                    "id": "750290507",
                                    "speaker": "Matahga",
                                    "text": "Isso mesmo, eu sou mais focado do que os outros! Sabe por que? Porque a única coisa que reconheço é o trabalho duro."
                                },
                                {
                                    "id": "750290508",
                                    "speaker": "Matahga",
                                    "text": "Você precisa treinar, e eu também. Apenas treinar para trabalhar com Saurianos não me fará um guerreiro todo-poderoso!"
                                },
                                {
                                    "id": "750290509",
                                    "speaker": "Matahga",
                                    "text": "Eu tenho que procurar um palco maior para me aperfeiçoar! E isso significa que estarei saindo por algum tempo."
                                },
                                {
                                    "id": "750290510",
                                    "speaker": "Matahga",
                                    "text": "Não se preocupe! Manterei o curso daqui intacto, mas irei desmontar essa cabana e levá-la comigo.",
                                    "choices": [
                                        {
                                            "id": "750290511",
                                            "text": "Aonde você vai?",
                                            "response": [
                                                {
                                                    "id": "750290512",
                                                    "speaker": "Matahga",
                                                    "text": "Oh... Vou ver meu pai e minha irmã."
                                                },
                                                {
                                                    "id": "750290515",
                                                    "speaker": "Paimon",
                                                    "text": "Hã? Matahga não está soando tão confiante quanto antes."
                                                },
                                                {
                                                    "id": "750290516",
                                                    "speaker": "Matahga",
                                                    "text": "E o que tem de errado com isso? Amar e respeitar sua família é uma virtude que todo guerreiro deveria possuir! Não seja tão mente fechada!"
                                                },
                                                {
                                                    "id": "750290517",
                                                    "speaker": "Matahga",
                                                    "text": "Meu pai é o Mestre Treinador mais profissional de todo Clã das Plumas de Flores, e a minha irmã é a melhor montadora de Saurianos! Estou muito orgulhoso deles!"
                                                },
                                                {
                                                    "id": "750290518",
                                                    "speaker": "Paimon",
                                                    "text": "Ei, calma aí! Paimon não estava querendo questionar a decisão deles."
                                                },
                                                {
                                                    "id": "750290519",
                                                    "speaker": "Player",
                                                    "text": "Entendo. Boa sorte então."
                                                },
                                                {
                                                    "id": "750290520",
                                                    "speaker": "Matahga",
                                                    "text": "#Boa sorte para você também, guerreir{M#o}{F#a}! As palavras que deixarei com você dessa vez são..."
                                                },
                                                {
                                                    "id": "750290521",
                                                    "speaker": "Matahga",
                                                    "text": "#Deixe-me pensar... Nunca desista! Se torne {M#um herói}{F#uma heroína}, não importa o que custe!"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "750290513",
                                            "text": "Como planeja treinar?",
                                            "response": [
                                                {
                                                    "id": "750290514",
                                                    "speaker": "Matahga",
                                                    "text": "Hmm... Pedirei pelas opiniões deles antes de decidir."
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "750290504",
                            "text": "Não tenho tido tempo para treinar recentemente.",
                            "response": [
                                {
                                    "id": "750290505",
                                    "speaker": "Matahga",
                                    "text": "Quanta indolência! Não me diga, você esteve gastando sua vida com perambulações sem sentido?"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7502907",
            "objective": "",
            "dialogues": [
                {
                    "id": "750290701",
                    "speaker": "Matahga",
                    "text": "#Maravilhoso! Você me superou, guerreir{M#o}{F#a}! Mas não comece a fazer corpo mole agora — continue se esforçando para se tornar {M#um herói}{F#uma heroína} ainda mais incrível!"
                }
            ]
        },
        {
            "id": "7502903",
            "objective": "Comece o treinamento especial!",
            "dialogues": []
        },
        {
            "id": "7502904",
            "objective": "Fale com Matahga",
            "dialogues": [
                {
                    "id": "750290201",
                    "speaker": "Matahga",
                    "text": "Maravilhoso, excepcional! Você me superou, me ultrapassou!"
                },
                {
                    "id": "750290202",
                    "speaker": "Matahga",
                    "text": "Tenho mantido meu treinamento especial, sozinho, na esperança de um dia conseguir quebrar meu próprio recorde. Infelizmente, isso é algo que eu ainda não consegui fazer."
                },
                {
                    "id": "750290203",
                    "speaker": "Matahga",
                    "text": "Mas você conseguiu! Você provou para mim que eu deveria sair desse lugar, já que deve haver muitos outros Valentes no mundo cujos feitos superam os meus!"
                },
                {
                    "id": "750290204",
                    "speaker": "Matahga",
                    "text": "Certamente conseguirei melhorar treinando e trocando dicas com eles. Um dia, meu pai e minha irmã reconhecerão minhas conquistas — apenas espere!"
                },
                {
                    "id": "750290205",
                    "speaker": "Matahga",
                    "text": "Tirando Acomitl, claro. Esse preguiçoso não tem nenhuma ambição. Tenho vergonha de chamá-lo de meu irmão."
                },
                {
                    "id": "750290206",
                    "speaker": "Player",
                    "text": "Acomitl...?"
                },
                {
                    "id": "750290207",
                    "speaker": "Matahga",
                    "text": "Uh, deixa para lá. Chega de conversa fiada."
                },
                {
                    "id": "750290208",
                    "speaker": "Matahga",
                    "text": "#Guerreir{M#o}{F#a}, me escute agora! Nunca pare de aperfeiçoar suas habilidades!"
                },
                {
                    "id": "750290209",
                    "speaker": "Matahga",
                    "text": "Se você deseja virar uma lenda, você deve ir em frente com toda sua força! Em frente, ouviu, em frente! Essas palavras são meu presente de despedida para você."
                }
            ]
        },
        {
            "id": "7502906",
            "objective": "Fale com Matahga",
            "dialogues": []
        },
        {
            "id": "7502908",
            "objective": "Fale com todos",
            "dialogues": [
                {
                    "id": "750290801",
                    "speaker": "Matahga",
                    "text": "Eu vou me tornar um guerreiro! Não, um herói! É só esperar para ver."
                }
            ]
        },
        {
            "id": "7502906",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "750290601",
                    "speaker": "Matahga",
                    "text": "Você não foi tão ruim assim, então continue dando seu melhor. Sei que você consegue..."
                },
                {
                    "id": "750290602",
                    "speaker": "Matahga",
                    "text": "#Pah, você não realmente achou que essas seriam as minhas palavras de despedida, achou? Não! Ser \"não ruim\" e \"se bastar\" não é o jeito de {M#um guerreiro}{F#uma guerreira}!"
                },
                {
                    "id": "750290603",
                    "speaker": "Matahga",
                    "text": "#Você deve apenas focar em ser {M#o}{F#a} melhor! Qualquer um que falhar nisso é uma falha, simples assim!"
                },
                {
                    "id": "750290604",
                    "speaker": "Matahga",
                    "text": "Desde que você ainda tenha a coragem, então continue tentando! Treine até que consiga me superar!"
                }
            ]
        },
        {
            "id": "7502913",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "750291301",
                    "speaker": "Slogan Chamativo",
                    "text": "O Sauriano Voador está aberto o dia todo! Se deseja se juntar ao treinamento especial de Matahga, então venha decolar no Sauriano Voador! Observação: Assim como um treinamento sério e proativo é algo para se ter orgulho, então a preguiça e a negligência são motivos para se ter uma grande vergonha!"
                },
                {
                    "id": "750291302",
                    "speaker": "Slogan Chamativo",
                    "text": "Se não trabalharmos duro hoje, nós seremos tão inúteis como o lixo amanhã!"
                },
                {
                    "id": "750291303",
                    "speaker": "Slogan Chamativo",
                    "text": "Apenas aqueles que seguirem em frente bravamente saberão verdadeiramente a grandeza de ser um cavaleiro Sauriano!"
