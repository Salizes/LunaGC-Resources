            "dialogues": [
                {
                    "id": "705219901",
                    "speaker": "Paimon",
                    "text": "O tempo voa. O evento beneficente já vem acontecendo há algum tempo. Paimon se pergunta quanta Mora ganhamos..."
                },
                {
                    "id": "705219902",
                    "speaker": "Paimon",
                    "text": "Vamos voltar à \"Aliança Beneficente do Ventão de Favonius\" para dar uma olhada!"
                }
            ]
        }
    ]
}