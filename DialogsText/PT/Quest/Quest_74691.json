    "talks": [
        {
            "id": "7469101",
            "objective": "Dê uma volta por aí...",
            "dialogues": [
                {
                    "id": "746910101",
                    "speaker": "Paimon",
                    "text": "#...Hã? {NICKNAME}, Paimon tá vendo coisas? Ali... não é Dodoco?",
                    "choices": [
                        {
                            "id": "746910102",
                            "text": "Paimon, estamos em Fontaine.",
                            "response": [
                                {
                                    "id": "746910104",
                                    "speaker": "Paimon",
                                    "text": "N-Não! Tem mesmo um Dodoco ali, e ele é igualzinho... É igualzinho à Barbeloth!",
                                    "choices": [
                                        {
                                            "id": "746910105",
                                            "text": "Ah, ótimo...",
                                            "response": [
                                                {
                                                    "id": "746910107",
                                                    "speaker": "Barbeloth",
                                                    "text": "#Ora, que encontro inesperado. {NICKNAME}, e Paimonzinha."
                                                },
                                                {
                                                    "id": "746910108",
                                                    "speaker": "Paimon",
                                                    "text": "Por que soa tão suspeito ouvir uma adivinha tão poderosa usar a palavra \"inesperado\"?"
                                                },
                                                {
                                                    "id": "746910109",
                                                    "speaker": "Barbeloth",
                                                    "text": "Foi realmente inesperado, não estou brincando."
                                                },
                                                {
                                                    "id": "746910110",
                                                    "speaker": "Barbeloth",
                                                    "text": "#Como {F#uma}{M#um} {F#Descida}{M#Descido} vind{F#a}{M#o} de além deste mundo, o destino de {NICKNAME} não está ancorado em Teyvat."
                                                },
                                                {
                                                    "id": "746910111",
                                                    "speaker": "Barbeloth",
                                                    "text": "#Hehehe... Muitos adivinhos, inclusive eu, provavelmente não conseguiriam prever o futuro de {NICKNAME}."
                                                },
                                                {
                                                    "id": "746910112",
                                                    "speaker": "Barbeloth",
                                                    "text": "Entretanto, esse encontro foi perfeitamente oportuno. Pouco tempo atrás, eu vi um presságio estranho."
                                                },
                                                {
                                                    "id": "746910113",
                                                    "speaker": "Barbeloth",
                                                    "text": "E como eu tinha um pouco de tempo livre, decidi fazer uma breve adivinhação e seguir o rumo do presságio... apenas por diversão, entende."
                                                },
                                                {
                                                    "id": "746910114",
                                                    "speaker": "Barbeloth",
                                                    "text": "Ah, sim, e enquanto seguia esse presságio, capturei alguns fios etéreos do destino e vislumbrei o rosto de seus donos. Aqui, vejam por si mesmos."
                                                },
                                                {
                                                    "id": "746910115",
                                                    "speaker": "Player",
                                                    "text": "São todos... conhecidos..."
                                                },
                                                {
                                                    "id": "746910116",
                                                    "speaker": "Barbeloth...?",
                                                    "text": "#Tá vendo? Eu sabia! {NICKNAME} tem muitos amigos, com certeza os conhece!",
                                                    "choices": [
                                                        {
                                                            "id": "746910117",
                                                            "text": "Eu conheço essa voz...",
                                                            "response": [
                                                                {
                                                                    "id": "746910119",
                                                                    "speaker": "Alice",
                                                                    "text": "Ei, vocês! Faz tempo que não nos vemos, não é? Pensei em ajudar um pouco com a adivinhação da Barbie."
                                                                },
                                                                {
                                                                    "id": "746910120",
                                                                    "speaker": "Barbeloth",
                                                                    "text": "De fato, se Alice não tivesse insistido, eu teria tratado esses nomes como variáveis menores e os descartado da adivinhação."
                                                                },
                                                                {
                                                                    "id": "746910121",
                                                                    "speaker": "Alice",
                                                                    "text": "Mas aí você teria perdido esse pequeno passeio divertido, não teria?"
                                                                },
                                                                {
                                                                    "id": "746910122",
                                                                    "speaker": "Alice",
                                                                    "text": "Além disso, como magas, não poderíamos decepcionar as fofurinhas envolvidas depois de receber uma profecia, não é?"
                                                                },
                                                                {
                                                                    "id": "746910123",
                                                                    "speaker": "Alice",
                                                                    "text": "É o sonho de toda criança receber presentes maravilhosos, partir em grandes empreitadas e ver profecias misteriosas se desenrolarem... Ou seja, nós simplesmente precisávamos acompanhar isso até o fim!"
                                                                },
                                                                {
                                                                    "id": "746910124",
                                                                    "speaker": "Barbeloth",
                                                                    "text": "...E não adianta discutir com a Alice. De todo modo, se eu conseguir reunir essas pequenas variáveis, devo conseguir ajustar a minha adivinhação."
                                                                },
                                                                {
                                                                    "id": "746910125",
                                                                    "speaker": "Barbeloth",
                                                                    "text": "Então aqui estou eu, procurando por elas e, se possível, oferecendo-lhes uma pequena leitura da sorte."
                                                                },
                                                                {
                                                                    "id": "746910126",
                                                                    "speaker": "Player",
                                                                    "text": "Uhm... Então, quando elas vão chegar?"
                                                                },
                                                                {
                                                                    "id": "746910127",
                                                                    "speaker": "Barbeloth",
                                                                    "text": "Não tenho tempo para sair por aí adivinhando coisas assim, mas tenho certeza de que não vai demorar."
                                                                },
                                                                {
                                                                    "id": "746910128",
                                                                    "speaker": "Paimon",
                                                                    "text": "É por isso que você montou esta barraca? Para poder sentar e esperar até elas chegarem?"
                                                                },
                                                                {
                                                                    "id": "746910129",
                                                                    "speaker": "Barbeloth",
                                                                    "text": "Não se preocupe, não estou aqui só de braços cruzados. Este Dodoco é um substituto, eu ainda estou cuidando da minha pesquisa."
                                                                },
                                                                {
                                                                    "id": "746910130",
                                                                    "speaker": "Alice",
                                                                    "text": "Isso mesmo! E eu instalei sensores no Dodoco da Barbie. Assim que a pessoa certa aparecer, ela receberá uma notificação instantânea."
                                                                },
                                                                {
                                                                    "id": "746910131",
                                                                    "speaker": "Alice",
                                                                    "text": "E o Dodoco vai dar uma balançadinha feliz para garantir que nossos visitantes sejam atraídos para cá."
                                                                },
                                                                {
                                                                    "id": "746910132",
                                                                    "speaker": "Barbeloth",
                                                                    "text": "O que você está fazendo aqui atrás? Tire o braço daí, você vai derrubar meu Hydroprofetizador no chão! E segure essa xícara direito, não quero que você derrame chocolate quente nos meus manuscritos!"
                                                                },
                                                                {
                                                                    "id": "746910133",
                                                                    "speaker": "Alice",
                                                                    "text": "Está bem, não precisa se irritar! Só um segundo... Pronto. Barbie, este é o seu. Coloquei quase nada de açúcar nele, prometo."
                                                                },
                                                                {
                                                                    "id": "746910134",
                                                                    "speaker": "Barbeloth",
                                                                    "text": "Quando você diz \"quase sem açúcar\", não consigo evitar a sensação de que nós não falamos a mesma língua..."
                                                                },
                                                                {
                                                                    "id": "746910135",
                                                                    "speaker": "Alice",
                                                                    "text": "Ahem, voltando ao assunto! Depois de acompanharmos a adivinhação da Barbie, eu estava pensando em reunir todo mundo, todos os envolvidos, quer dizer, e dar uma grande festa."
                                                                },
                                                                {
                                                                    "id": "746910136",
                                                                    "speaker": "Alice",
                                                                    "text": "Até já decidi como podemos enviar os convites. Não se preocupem, já escolhi os pássaros mais lindos disponíveis."
                                                                },
                                                                {
                                                                    "id": "746910137",
                                                                    "speaker": "Alice",
                                                                    "text": "Imaginem só... No meio da noite, um enorme pássaro branco como a neve entra voando pela sua janela com uma carta misteriosa no bico. Aí você a abre, e um mundo totalmente novo aparece diante dos seus olhos..."
                                                                },
                                                                {
                                                                    "id": "746910138",
                                                                    "speaker": "Barbeloth",
                                                                    "text": "Infelizmente, como eu disse à Alice, fazer isso só serviria para perturbar o caminho do destino. Além disso, lidar com profecias tão pequenas é um baita incômodo, então está fora de questão."
                                                                },
                                                                {
                                                                    "id": "746910139",
                                                                    "speaker": "Alice",
                                                                    "text": "Que pena, mas a festa ainda pode acontecer! Quando chegar o momento certo, virei convidar todo mundo!"
                                                                },
                                                                {
                                                                    "id": "746910140",
                                                                    "speaker": "Alice",
                                                                    "text": "#Para que a festa comece logo, {NICKNAME}, Paimonzinha! Deixo para vocês a missão de trazer essas pessoas!"
                                                                },
                                                                {
                                                                    "id": "746910141",
                                                                    "speaker": "Player",
                                                                    "text": "Po-Posso?"
                                                                },
                                                                {
                                                                    "id": "746910142",
                                                                    "speaker": "Paimon",
                                                                    "text": "Haha... isso deve contar como bagunçar a trajetória do destino, né..."
                                                                },
                                                                {
                                                                    "id": "746910143",
                                                                    "speaker": "Barbeloth",
                                                                    "text": "#Hmm... essas pessoas já têm alguma ligação com {NICKNAME} desde o princípio, então, em teoria, seus destinos já estão entrelaçados..."
                                                                },
                                                                {
                                                                    "id": "746910144",
                                                                    "speaker": "Barbeloth",
                                                                    "text": "#Se {NICKNAME} for quem os convidar, isso não deve afetar muito a adivinhação..."
                                                                },
                                                                {
                                                                    "id": "746910145",
                                                                    "speaker": "Alice",
                                                                    "text": "#Sabia que podia contar com {NICKNAME}! Então, fico confiando a vocês esse serviço para a festa. Prometo reservar dois lugares especiais bem pertinho do bolo!"
                                                                },
                                                                {
                                                                    "id": "746910146",
                                                                    "speaker": "Alice",
                                                                    "text": "...Barbie, por que você começou a rasgar papel? O que está fazendo?"
                                                                },
                                                                {
                                                                    "id": "746910147",
                                                                    "speaker": "Barbeloth",
                                                                    "text": "Vou tapar meus ouvidos. Você e Nicole são um par perfeito: uma irrita meus ouvidos, a outra irrita minha cabeça. Ugh! Como eu sinto falta de Octavia..."
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "746910118",
                                                            "text": "Alice?"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "746910106",
                                            "text": "O mundo finalmente foi conquistado por Dodocos."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "746910103",
                            "text": "Você deve estar com Dodocos na cabeça."
                        }
                    ]
                }
            ]
        }
    ]
}