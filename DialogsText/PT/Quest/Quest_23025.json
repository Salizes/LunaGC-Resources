        {
            "id": "2302506",
            "objective": "Configure os sinalizadores",
            "dialogues": [
                {
                    "id": "230250601",
                    "speaker": "Farghani",
                    "text": "Espero que desta vez não haja mais erros nos dados..."
                }
            ]
        },
        {
            "id": "2302507",
            "objective": "Fale com Farghani",
            "dialogues": [
                {
                    "id": "230250701",
                    "speaker": "Farghani",
                    "text": "Hã? Você terminou de configurar todos os sinalizadores?"
                },
                {
                    "id": "230250702",
                    "speaker": "Player",
                    "text": "Tudo bem configurado."
                },
                {
                    "id": "230250703",
                    "speaker": "Farghani",
                    "text": "Não posso te agradecer o suficiente. Por favor, aceite isso como pagamento."
                },
                {
                    "id": "230250704",
                    "speaker": "Farghani",
                    "text": "Agora tudo que temos que fazer é esperar que eles terminem de coletar os dados, então poderei confirmar minha dedução!"
                },
                {
                    "id": "230250705",
                    "speaker": "Farghani",
                    "text": "Mas como vou subir e pegar os sinalizadores de volta...?"
                }
            ]
        },
        {
            "id": "2302508",
            "objective": "Fale com Farghani",
            "dialogues": [
                {
                    "id": "230250801",
                    "speaker": "Farghani",
                    "text": "Ah, Viajante, você finalmente chegou!"
                },
                {
                    "id": "230250802",
                    "speaker": "Player",
                    "text": "Como vai sua pesquisa?"
                },
                {
                    "id": "230250803",
                    "speaker": "Farghani",
                    "text": "Graças a você, fiz um grande progresso nos últimos dias. Os sinalizadores devem estar coletando dados neste exato momento."
                },
                {
                    "id": "230250804",
                    "speaker": "Farghani",
                    "text": "Só me resta recuperar esses dados para verificar as novas conjecturas propostas!",
                    "choices": [
                        {
                            "id": "230250805",
                            "text": "Tudo o que você fez esses dias foram conjecturas?",
                            "response": [
                                {
                                    "id": "230250807",
                                    "speaker": "Farghani",
                                    "text": "Bem, eu otimizei equações e calibrarei o instrumento. Afinal de contas..."
                                },
                                {
                                    "id": "230250808",
                                    "speaker": "Farghani",
                                    "text": "Não há como eu subir até onde você configurou esses sinalizadores."
                                },
                                {
                                    "id": "230250809",
                                    "speaker": "Farghani",
                                    "text": "#Receio ter que incomodá-l{M#o}{F#a} para recuperar esses sinalizadores.",
                                    "choices": [
                                        {
                                            "id": "230250810",
                                            "text": "Tudo bem então...",
                                            "response": [
                                                {
                                                    "id": "230250811",
                                                    "speaker": "Farghani",
                                                    "text": "Por favor, Viajante! Eu cuidarei da recompensa."
                                                }
                                            ]
                                        },
                                        {
                                            "id": "230250812",
                                            "text": "Que tal cuidar da recuperação dos equipamentos da próxima vez...",
                                            "response": [
                                                {
                                                    "id": "230250813",
                                                    "speaker": "Farghani",
                                                    "text": "Eu ponderei algumas opções, sabe? Podemos adicionar um dispositivo de recuperação ou expandir o escopo de aplicação... Coisas assim."
                                                },
                                                {
                                                    "id": "230250814",
                                                    "speaker": "Farghani",
                                                    "text": "Mas isso exigiria um orçamento maior, e não sei como afetaria a precisão dos dados..."
                                                },
                                                {
                                                    "id": "230250815",
                                                    "speaker": "Farghani",
                                                    "text": "De qualquer forma, também estou contando com você desta vez!"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "230250806",
                            "text": "Isso não é nenhum progresso..."
                        }
                    ]
                }
            ]
        },
        {
            "id": "2302511",
            "objective": "Vá para onde os sinalizadores foram instalados",
            "dialogues": []
        },
        {
            "id": "2302509",
            "objective": "Recupere os sinalizadores",
            "dialogues": [
                {
                    "id": "230250901",
                    "speaker": "Farghani",
                    "text": "Espero que desta vez não haja mais erros nos dados..."
                }
            ]
        },
        {
            "id": "2302510",
            "objective": "Fale com Farghani",
            "dialogues": [
                {
                    "id": "230251001",
                    "speaker": "Farghani",
                    "text": "O quê? Existem monstros lá? Não pode ser, os parâmetros ambientais desta área claramente mostram..."
                },
                {
                    "id": "230251002",
                    "speaker": "Farghani",
                    "text": "Será que os próprios sinalizadores constituem uma variável? Talvez são as leves vibrações, som e luz durante a operação que atraem monstros..."
                },
                {
                    "id": "230251003",
                    "speaker": "Farghani",
                    "text": "Espero que não afete os dados coletados... Ah, sinto muito, ainda estou falando sozinho."
                },
                {
                    "id": "230251004",
                    "speaker": "Farghani",
                    "text": "Eu não esperava que isso lhe causasse problemas extras... Por favor, aceite essa recompensa."
                },
                {
                    "id": "230251005",
                    "speaker": "Farghani",
                    "text": "Da próxima vez, eu devo ser mais consciente de minhas medições."
                }
            ]
        }
    ]
