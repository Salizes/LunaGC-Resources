    "talks": [
        {
            "id": "2302502",
            "objective": "Fale com Farghani",
            "dialogues": [
                {
                    "id": "230250201",
                    "speaker": "Farghani",
                    "text": "#Ei amig{M#o}{F#a}, posso ter um momento do seu tempo?",
                    "choices": [
                        {
                            "id": "230250202",
                            "text": "Qual é o problema?",
                            "response": [
                                {
                                    "id": "230250208",
                                    "speaker": "Farghani",
                                    "text": "Você já pensou nisso: e se o céu cair?",
                                    "choices": [
                                        {
                                            "id": "230250209",
                                            "text": "Você se preocupa demais...",
                                            "response": [
                                                {
                                                    "id": "230250212",
                                                    "speaker": "Farghani",
                                                    "text": "Pode ser. Mas por que o céu não cai? Por que a terra não desmorona? Sem medições precisas, nunca teremos uma resposta para essas perguntas."
                                                },
                                                {
                                                    "id": "230250213",
                                                    "speaker": "Farghani",
                                                    "text": "Na verdade, eu elaborei um modelo para explicar essas questões perfeitamente. Eu só preciso de mais dados observacionais para apoiar a minha tese...",
                                                    "choices": [
                                                        {
                                                            "id": "230250214",
                                                            "text": "Precisa da minha ajuda com isso?",
                                                            "response": [
                                                                {
                                                                    "id": "230250223",
                                                                    "speaker": "Farghani",
                                                                    "text": "#Então você está dispost{M#o}{F#a} a ajudar. Agradeço-lhe muito!"
                                                                },
                                                                {
                                                                    "id": "230250224",
                                                                    "speaker": "Farghani",
                                                                    "text": "Na verdade, já selecionei um excelente local de observação, mas os monstros lá estão um pouco ativos..."
                                                                },
                                                                {
                                                                    "id": "230250225",
                                                                    "speaker": "Farghani",
                                                                    "text": "Por favor, elimine esses monstros para que eu possa fazer registos da observação com segurança.",
                                                                    "choices": [
                                                                        {
                                                                            "id": "230250226",
                                                                            "text": "Está bem.",
                                                                            "response": [
                                                                                {
                                                                                    "id": "230250227",
                                                                                    "speaker": "Farghani",
                                                                                    "text": "Muito obrigado. Vamos lá, então."
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "230250228",
                                                                            "text": "Você precisa estar mesmo no local?",
                                                                            "response": [
                                                                                {
                                                                                    "id": "230250229",
                                                                                    "speaker": "Farghani",
                                                                                    "text": "Eu preciso obter dados no local para encontrar a causa de quaisquer discrepâncias em meus cálculos."
                                                                                },
                                                                                {
                                                                                    "id": "230250230",
                                                                                    "speaker": "Farghani",
                                                                                    "text": "Fixar-se em uma pilha de papéis só te levará ainda mais longe da resposta correta. Vamos pegar a estrada."
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "230250215",
                                                            "text": "Boa sorte. Até mais.",
                                                            "response": [
                                                                {
                                                                    "id": "230250216",
                                                                    "speaker": "Farghani",
                                                                    "text": "Espera, espera! Por favor, reconsidere. Se o meu trabalho puder ser publicado, pode abalar todas as estruturas!"
                                                                },
                                                                {
                                                                    "id": "230250217",
                                                                    "speaker": "Farghani",
                                                                    "text": "#E aí você será {M#um colaborador}{F#uma colaboradora} desta grande teoria e posso colocar seu nome na lista de agradecimentos ao final do artigo..."
                                                                },
                                                                {
                                                                    "id": "230250218",
                                                                    "speaker": "Farghani",
                                                                    "text": "Ou... Ou, você poderia até ser coautor dela..."
                                                                },
                                                                {
                                                                    "id": "230250219",
                                                                    "speaker": "Player",
                                                                    "text": "Isso é tão urgente mesmo?"
                                                                },
                                                                {
                                                                    "id": "230250220",
                                                                    "speaker": "Farghani",
                                                                    "text": "Se eu não conseguir os resultados, temo que terei um problema com o financiamento da minha pesquisa... O que seria muito mais devastador do que o céu caindo.",
                                                                    "choices": [
                                                                        {
                                                                            "id": "230250221",
                                                                            "text": "Não faço questão da coautoria..."
                                                                        },
                                                                        {
                                                                            "id": "230250222",
                                                                            "text": "Basta uma compensação justa."
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "230250210",
                                            "text": "Tecnicamente, o céu não pode desabar."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "230250203",
                            "text": "#Estou muito ocupad{M#o}{F#a}.",
                            "response": [
                                {
                                    "id": "230250204",
                                    "speaker": "Farghani",
                                    "text": "Ah, por favor, não diga isso. O que é pior do que ver a sua própria casa se desmoronando?"
                                },
                                {
                                    "id": "230250205",
                                    "speaker": "Player",
                                    "text": "Sua casa está... desmoronando?"
                                },
                                {
                                    "id": "230250206",
                                    "speaker": "Farghani",
                                    "text": "Ahem... Claro que não. Mas digamos que você mora em uma casa e nunca a viu na íntegra, e ninguém garantiu sua resistência estrutural..."
                                },
                                {
                                    "id": "230250207",
                                    "speaker": "Farghani",
                                    "text": "Então viver nesta casa todos os dias o preocuparia de alguma forma, certo? Assim é viver neste mundo."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2302503",
            "objective": "Derrote os monstros próximos do seu destino",
            "dialogues": []
        },
        {
            "id": "2302504",
            "objective": "Fale com Farghani",
            "dialogues": [
                {
                    "id": "230250401",
                    "speaker": "Farghani",
                    "text": "Hum... Então é isso? Desde que esta variável seja reintroduzida, as discrepâncias podem ser explicadas..."
                },
                {
                    "id": "230250402",
                    "speaker": "Farghani",
                    "text": "Mas isso também muda minhas outras deduções?"
                },
                {
                    "id": "230250403",
                    "speaker": "Player",
                    "text": "Algum progresso?"
                },
                {
                    "id": "230250404",
                    "speaker": "Farghani",
                    "text": "Ah, desculpe, eu tinha esquecido que você ainda estava aqui... Aqui, aqui está a remuneração prometida."
                },
                {
                    "id": "230250405",
                    "speaker": "Farghani",
                    "text": "No que diz respeito ao progresso... Alguns problemas foram resolvidos, mas parece que muitos novos problemas surgiram... Essa é provavelmente a essência de uma pesquisa."
                },
                {
                    "id": "230250406",
                    "speaker": "Farghani",
                    "text": "Talvez eu tenha que continuar incomodando você, Viajante, até chegar a uma conclusão final."
                }
            ]
        },
