    "talks": [
        {
            "id": "2210201",
            "objective": "Fale com Huai'an",
            "dialogues": [
                {
                    "id": "221020101",
                    "speaker": "Huai'an",
                    "text": "Está sendo um pesadelo absoluto."
                },
                {
                    "id": "221020102",
                    "speaker": "Player",
                    "text": "Qual o problema?"
                },
                {
                    "id": "221020103",
                    "speaker": "Huai'an",
                    "text": "Já não tenho dormido bem recentemente, olhe para essas olheiras..."
                },
                {
                    "id": "221020104",
                    "speaker": "Huai'an",
                    "text": "Você viu os convidados? Cada um é mais louco que o anterior. Você acredita que alguém se atreveu a pular daqui?"
                },
                {
                    "id": "221020105",
                    "speaker": "Huai'an",
                    "text": "Deixa para lá. Neste exato momento, estou esperando a minha comida, deve estar chegando em breve."
                },
                {
                    "id": "221020106",
                    "speaker": "Huai'an",
                    "text": "No entanto, existem monstros na estrada e eles certamente causarão problemas. Será que você poderia me ajudar a eliminá-los?",
                    "choices": [
                        {
                            "id": "221020107",
                            "text": "Entendi.",
                            "response": [
                                {
                                    "id": "221020109",
                                    "speaker": "Huai'an",
                                    "text": "Conto contigo."
                                }
                            ]
                        },
                        {
                            "id": "221020108",
                            "text": "Este albergue...",
                            "response": [
                                {
                                    "id": "221020110",
                                    "speaker": "Huai'an",
                                    "text": "\"Portas abertas para todos os viajantes do mundo, e para todas as histórias de vida.\" É o que eu penso..."
                                },
                                {
                                    "id": "221020111",
                                    "speaker": "Huai'an",
                                    "text": "Para falar a verdade, é apenas uma pousada um pouco mais distante e mais movimentada do que a maioria."
                                },
                                {
                                    "id": "221020112",
                                    "speaker": "Huai'an",
                                    "text": "Eu agradeço a sua ajuda. Obrigado e boa sorte!"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2210202",
            "objective": "Elimine os monstros ao redor",
            "dialogues": [
                {
                    "id": "221020201",
                    "speaker": "Huai'an",
                    "text": "Como está indo? Já eliminou todos os monstros?"
                },
                {
                    "id": "221020202",
                    "speaker": "Player",
                    "text": "Ainda não."
                },
                {
                    "id": "221020203",
                    "speaker": "Huai'an",
                    "text": "Por favor, rápido! O chefe não tem ingredientes para cozinhar."
                },
                {
                    "id": "221020204",
                    "speaker": "Huai'an",
                    "text": "Eu poderia resolver eu mesmo, mas isso seria última das opções."
                }
            ]
        },
