    },
    "talks": [
        {
            "id": "7471601",
            "objective": "Fale com Freminet",
            "dialogues": [
                {
                    "id": "747160101",
                    "speaker": "Freminet",
                    "text": "Fantástico... Isso é praticamente todo o lixo grande recuperado."
                },
                {
                    "id": "747160102",
                    "speaker": "Freminet",
                    "text": "#Vocês se esforçaram muito, {NICKNAME} e Paimon."
                },
                {
                    "id": "747160103",
                    "speaker": "Paimon",
                    "text": "Não se sinta obrigado a se desculpar, Freminet! Do jeito que a Paimon vê, a gente não esteve \"trabalhando\" — a gente esteve pescando coisas boas!",
                    "choices": [
                        {
                            "id": "747160104",
                            "text": "Ajudamos a restaurar o meio ambiente.",
                            "response": [
                                {
                                    "id": "747160106",
                                    "speaker": "Freminet",
                                    "text": "Obrigado... Eu tive um tempo tão feliz e gratificante, e tudo isso graças a vocês."
                                },
                                {
                                    "id": "747160107",
                                    "speaker": "Paimon",
                                    "text": "De nada! Além disso, foi um trabalho em equipe! E a Paimon acha que você fez um progresso real, Freminet. Você ajudou muito, tanto debaixo d'água quanto em terra firme!"
                                },
                                {
                                    "id": "747160108",
                                    "speaker": "Player",
                                    "text": "Não precisa ficar vermelho."
                                },
                                {
                                    "id": "747160109",
                                    "speaker": "Freminet",
                                    "text": "Tudo bem."
                                },
                                {
                                    "id": "747160110",
                                    "speaker": "Freminet",
                                    "text": "..."
                                },
                                {
                                    "id": "747160111",
                                    "speaker": "Freminet",
                                    "text": "Me desculpe, fora \"obrigado\", eu realmente não sei o que mais dizer em momentos como esses."
                                },
                                {
                                    "id": "747160112",
                                    "speaker": "Freminet",
                                    "text": "Talvez... Talvez eu ainda precise praticar um pouco mais?"
                                },
                                {
                                    "id": "747160113",
                                    "speaker": "Paimon",
                                    "text": "Sem pressa, vá no seu próprio ritmo. Continue praticando tranquilamente!",
                                    "choices": [
                                        {
                                            "id": "747160114",
                                            "text": "Se tivermos outra chance, vamos trabalhar juntos de novo.",
                                            "response": [
                                                {
                                                    "id": "747160116",
                                                    "speaker": "Freminet",
                                                    "text": "Certo, combinado."
                                                },
                                                {
                                                    "id": "747160117",
                                                    "speaker": "Freminet",
                                                    "text": "...Agora que a limpeza acabou, eu tinha planejado voltar para debaixo d'água e passar um tempo sozinho."
                                                },
                                                {
                                                    "id": "747160118",
                                                    "speaker": "Freminet",
                                                    "text": "Mas, depois de conversar com vocês... até o céu parece mais calmo. Eu só queria compartilhar esse sentimento com vocês."
                                                },
                                                {
                                                    "id": "747160119",
                                                    "speaker": "Freminet",
                                                    "text": "Enfim... é melhor eu voltar e me encontrar com Lyney e os outros."
                                                },
                                                {
                                                    "id": "747160120",
                                                    "speaker": "Freminet",
                                                    "text": "Vou deixar o resto dos dados da pesquisa submarina com você. Espero que encontre o que está procurando."
                                                },
                                                {
                                                    "id": "747160121",
                                                    "speaker": "Marionette",
                                                    "text": "Ei, eu pude ouvir vocês celebrando do convés. Aconteceu algo de bom?"
                                                },
                                                {
                                                    "id": "747160122",
                                                    "speaker": "Paimon",
                                                    "text": "Sim! Todo aquele lixo que estava incomodando os peixinhos foi removido. Também encontramos o resto das peças do piano!"
                                                },
                                                {
                                                    "id": "747160123",
                                                    "speaker": "Marionette",
                                                    "text": "Mesmo? Deixe-me dar uma olhada..."
                                                },
                                                {
                                                    "id": "747160124",
                                                    "speaker": "Marionette",
                                                    "text": "...Olha só, com essas peças, posso consertar o piano."
                                                },
                                                {
                                                    "id": "747160125",
                                                    "speaker": "Marionette",
                                                    "text": "Talvez não fique como era antes, mas deve conseguir tocar uma bela música."
                                                },
                                                {
                                                    "id": "747160126",
                                                    "speaker": "Paimon",
                                                    "text": "Você parece muito feliz, Sandrone!"
                                                },
                                                {
                                                    "id": "747160127",
                                                    "speaker": "Marionette",
                                                    "text": "Mesmo? Não importa, vou consertar agora. Não deve tomar muito tempo. Enquanto isso, vocês podem arrumar um pouco esse lugar?"
                                                },
                                                {
                                                    "id": "747160128",
                                                    "speaker": "Marionette",
                                                    "text": "Um instrumento maravilhoso como esse merece um palco que faça jus a sua altura."
                                                },
                                                {
                                                    "id": "747160129",
                                                    "speaker": "Paimon",
                                                    "text": "Ela parece tão feliz..."
                                                },
                                                {
                                                    "id": "747160130",
                                                    "speaker": "Paimon",
                                                    "text": "Uau! Que piano lindo!",
                                                    "choices": [
                                                        {
                                                            "id": "747160131",
                                                            "text": "É muito elegante!",
                                                            "response": [
                                                                {
                                                                    "id": "747160133",
                                                                    "speaker": "Marionette",
                                                                    "text": "Hunf, mas é claro! Eu que o consertei! Também reforcei as conexões mecânicas, e dei uns retoques no exterior."
                                                                },
                                                                {
                                                                    "id": "747160134",
                                                                    "speaker": "Marionette",
                                                                    "text": "Vocês também fizeram um bom trabalho. O palco está digno para esse piano."
                                                                },
                                                                {
                                                                    "id": "747160135",
                                                                    "speaker": "Paimon",
                                                                    "text": "Hehe, não foi nada! Enfim, já chega de conversa fiada. Você não vai tocar?"
                                                                },
                                                                {
                                                                    "id": "747160136",
                                                                    "speaker": "Marionette",
                                                                    "text": "Hã? Agora?"
                                                                },
                                                                {
                                                                    "id": "747160137",
                                                                    "speaker": "Paimon",
                                                                    "text": "E qual hora seria melhor? Por que consertar o piano se você não vai tocá-lo?"
                                                                },
                                                                {
                                                                    "id": "747160138",
                                                                    "speaker": "Marionette",
                                                                    "text": "Que tal deixarmos a apresentação para outro dia? Haverá bastante tempo para eu tocar para vocês depois!",
                                                                    "choices": [
                                                                        {
                                                                            "id": "747160139",
                                                                            "text": "Esqueceu sua partitura?",
                                                                            "response": [
                                                                                {
                                                                                    "id": "747160141",
                                                                                    "speaker": "Marionette",
                                                                                    "text": "Hunf... Que ultraje! Eu só queria sentar em silêncio um pouco e me lembrar do passado!"
                                                                                },
                                                                                {
                                                                                    "id": "747160142",
                                                                                    "speaker": "Marionette",
                                                                                    "text": "E não pense que essa provocação barata vai me convencer a tocar. Praticar primeiro, apresentar depois!"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "747160140",
                                                                            "text": "Está com vergonha?"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "747160132",
                                                            "text": "É magnífico!"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "747160115",
                                            "text": "E se precisar de ajuda, pode sempre contar conosco."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "747160105",
                            "text": "E encontramos um monte de tesouros."
                        }
                    ]
                }
            ]
        }
    ]
}