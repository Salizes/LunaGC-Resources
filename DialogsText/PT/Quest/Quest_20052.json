            "objective": "Fale com Anna",
            "dialogues": [
                {
                    "id": "200520101",
                    "speaker": "Anna",
                    "text": "Bom... hoje temos mais uma missão a cumprir!",
                    "choices": [
                        {
                            "id": "200520102",
                            "text": "Vejo que você está animada.",
                            "response": [
                                {
                                    "id": "200520103",
                                    "speaker": "Anna",
                                    "text": "Claro! Ser aventureira é muito divertido!"
                                },
                                {
                                    "id": "200520104",
                                    "speaker": "Anna",
                                    "text": "Mas... Hehe, ainda tenho muito que aprender sobre missões."
                                },
                                {
                                    "id": "200520105",
                                    "speaker": "Anna",
                                    "text": "Viajante, você se importaria de vir comigo de novo? Ainda tenho algo que gostaria de te perguntar."
                                },
                                {
                                    "id": "200520108",
                                    "speaker": "Anna",
                                    "text": "Então vamos sair. A comissão de hoje é..."
                                },
                                {
                                    "id": "200520109",
                                    "speaker": "Anna",
                                    "text": "Hã... Então estamos escoltando... outro balão de transporte..."
                                }
                            ]
                        },
                        {
                            "id": "200520106",
                            "text": "Quer que eu vá junto?",
                            "response": [
                                {
                                    "id": "200520107",
                                    "speaker": "Anna",
                                    "text": "Você iria? Hehe, claro! Ainda tem tanto que quero aprender de ti."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2005202",
            "objective": "Complete a comissão da Guilda de Aventureiros com Anna",
            "dialogues": [
                {
                    "id": "200520201",
                    "speaker": "Anna",
                    "text": "Prontinho! Obrigada, Viajante! Terminamos nossa missão."
                },
                {
                    "id": "200520202",
                    "speaker": "Anna",
                    "text": "Mas... todas as missões são assim?",
                    "choices": [
                        {
                            "id": "200520203",
                            "text": "Existem outros tipos de missões.",
                            "response": [
                                {
                                    "id": "200520204",
                                    "speaker": "Anna",
                                    "text": "Você não parece muito convincente..."
                                },
                                {
                                    "id": "200520207",
                                    "speaker": "Anna",
                                    "text": "Entendo... Está bom! Vou continuar tentando!"
                                },
                                {
                                    "id": "200520208",
                                    "speaker": "Anna",
                                    "text": "Quando eu tiver dinheiro suficiente, vou levar meu irmão e meus pais para uma viagem!"
                                },
                                {
                                    "id": "200520209",
                                    "speaker": "Anna",
                                    "text": "Meu irmão sempre quis viajar, mas... como eu fiquei doente, ele teve que ficar para cuidar de mim."
                                },
                                {
                                    "id": "200520210",
                                    "speaker": "Anna",
                                    "text": "Agora já me sinto melhor e até me tornei uma aventureira!"
                                },
                                {
                                    "id": "200520211",
                                    "speaker": "Anna",
                                    "text": "Hehe, é hora de realizar os sonhos do meu irmão."
                                }
                            ]
                        },
                        {
                            "id": "200520205",
                            "text": "Aos poucos você vai perceber...",
                            "response": [
                                {
                                    "id": "200520206",
                                    "speaker": "Anna",
                                    "text": "Ei, não diga isso com essa cara de cansaço..."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2005203",
            "objective": "Complete a comissão da Guilda de Aventureiros com Anna",
            "dialogues": [
                {
                    "id": "200520301",
                    "speaker": "Anthony",
                    "text": "Viajante, por favor, cuide da Anna. Ela está eufórica..."
                },
                {
                    "id": "200520302",
                    "speaker": "Player",
                    "text": "Você não quer que ela seja uma aventureira?"
