    "talks": [
        {
            "id": "7004601",
            "objective": "Fale com a pescadora estranha",
            "dialogues": [
                {
                    "id": "700460101",
                    "speaker": "Jala",
                    "text": "Perfeito, parece que está tudo pronto..."
                },
                {
                    "id": "700460102",
                    "speaker": "Jala",
                    "text": "Se esforce, Jala! Você vai capturar todos em alguns dias!",
                    "choices": [
                        {
                            "id": "700460103",
                            "text": "C-Capturar?",
                            "response": [
                                {
                                    "id": "700460105",
                                    "speaker": "Paimon",
                                    "text": "Eita! O que uma caçadora ilegal tá fazendo em Fontaine...? O tráfico de animais está dando uma fortuna esses dias?"
                                },
                                {
                                    "id": "700460106",
                                    "speaker": "Paimon",
                                    "text": "Não se Paimon puder evitar! Vamos te arrastar até o Maison Gardiennage imediatamente!"
                                },
                                {
                                    "id": "700460107",
                                    "speaker": "Jala",
                                    "text": "...Oh, são vocês?"
                                },
                                {
                                    "id": "700460108",
                                    "speaker": "Jala",
                                    "text": "Claro, acabei de vir do Maison Gardiennage. Precisa que te mostre o caminho?"
                                },
                                {
                                    "id": "700460109",
                                    "speaker": "Paimon",
                                    "text": "?",
                                    "choices": [
                                        {
                                            "id": "700460110",
                                            "text": "Ótimo. Eu gosto de pessoas diretas!",
                                            "response": [
                                                {
                                                    "id": "700460111",
                                                    "speaker": "Paimon",
                                                    "text": "Espera, isso não está certo... Você não está nem um pouco com medo de ser presa. Talvez você faça isso direto, ou talvez..."
                                                },
                                                {
                                                    "id": "700460114",
                                                    "speaker": "Jala",
                                                    "text": "Eu esteja do lado certo da lei."
                                                },
                                                {
                                                    "id": "700460115",
                                                    "speaker": "Jala",
                                                    "text": "Mais precisamente, fui contratada pelo Maison Gardiennage para proteger o meio ambiente — como uma \"Caçadora Indomável\"."
                                                },
                                                {
                                                    "id": "700460116",
                                                    "speaker": "Jala",
                                                    "text": "E o que estou caçando é uma espécie invasiva de peixe que chegou até as águas de Fontaine."
                                                },
                                                {
                                                    "id": "700460117",
                                                    "speaker": "Paimon",
                                                    "text": "Espécie... invasiva?",
                                                    "choices": [
                                                        {
                                                            "id": "700460118",
                                                            "text": "Isso parece familiar.",
                                                            "response": [
                                                                {
                                                                    "id": "700460119",
                                                                    "speaker": "Paimon",
                                                                    "text": "Pois é! Paimon acha que já ouvimos algo assim em Mondstadt..."
                                                                },
                                                                {
                                                                    "id": "700460122",
                                                                    "speaker": "Jala",
                                                                    "text": "Não vamos nos ater ao passado. O que importa é o aqui e o agora."
                                                                },
                                                                {
                                                                    "id": "700460123",
                                                                    "speaker": "Jala",
                                                                    "text": "Essas espécies invasivas foram soltas por comerciantes que possuíam crenças estranhas."
                                                                },
                                                                {
                                                                    "id": "700460124",
                                                                    "speaker": "Jala",
                                                                    "text": "Alguns dos peixes são extremamente agressivos, outros se reproduzem incrivelmente rápido e outros foram criados com um alimento especial. É um grande problema para todas as criaturas aquáticas locais."
                                                                },
                                                                {
                                                                    "id": "700460125",
                                                                    "speaker": "Jala",
                                                                    "text": "Se esses peixes invadirem os ninhos das criaturas locais e bagunçarem o ecossistema, a qualidade das águas de Fontaine pode ser afetada."
                                                                },
                                                                {
                                                                    "id": "700460126",
                                                                    "speaker": "Jala",
                                                                    "text": "O impacto na saúde dos habitantes de Fontaine pode ser algo que apenas sentiremos no futuro. Mas, no momento, o sabor de uma bebida como Fonta poderia mudar instantaneamente, e isso será uma enxurrada de problemas para a economia.",
                                                                    "choices": [
                                                                        {
                                                                            "id": "700460127",
                                                                            "text": "Fonta, você ainda não pode ser destruída!",
                                                                            "response": [
                                                                                {
                                                                                    "id": "700460129",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "Quanto mais você desconsidera o problema, mais sério parece. Não podemos apenas ficar sentados e não fazer nada."
                                                                                },
                                                                                {
                                                                                    "id": "700460130",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "Somos bem experientes em pegar peixes, então por que não ajudamos?"
                                                                                },
                                                                                {
                                                                                    "id": "700460131",
                                                                                    "speaker": "Jala",
                                                                                    "text": "Sim! Eu estava esperando você dizer isso! Boa, Paimon!"
                                                                                },
                                                                                {
                                                                                    "id": "700460132",
                                                                                    "speaker": "Jala",
                                                                                    "text": "Montei uma área de armadilha, onde podemos usar iscas para atrair todos aqueles peixes invasivos..."
                                                                                },
                                                                                {
                                                                                    "id": "700460133",
                                                                                    "speaker": "Jala",
                                                                                    "text": "#É hora de botar para quebrar, Cavaleir{F#a}{M#o} Honorável e Ajudante Branca! Estarei torcendo por vocês!"
                                                                                },
                                                                                {
                                                                                    "id": "700460134",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "É só a Paimon... ou ela nos conhece muito bem?"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "700460128",
                                                                            "text": "Eu nem bebo Fonta, mas compreendo a importância."
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "700460120",
                                                            "text": "Como é?",
                                                            "response": [
                                                                {
                                                                    "id": "700460121",
                                                                    "speaker": "Paimon",
                                                                    "text": "A memória de Paimon está meio bagunçada... já ouvimos algo assim em Mondstadt, um tempão atrás..."
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "700460112",
                                            "text": "Talvez... houve um mal-entendido?",
                                            "response": [
                                                {
                                                    "id": "700460113",
                                                    "speaker": "Paimon",
                                                    "text": "Verdade. Eu não estou nem um pouco com medo de ser preso. Talvez faça isso direto, ou talvez..."
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "700460104",
                            "text": "Uma c-caçadora ilegal?"
                        }
                    ]
                }
            ]
        }
    ]
}