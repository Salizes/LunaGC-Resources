            "id": "1903104",
            "objective": "Fale com o membro da equipe",
            "dialogues": [
                {
                    "id": "1903102101",
                    "speaker": "Fusaner",
                    "text": "#É perigoso andar sozinh{M#o}{F#a} por aqui."
                },
                {
                    "id": "1903102102",
                    "speaker": "Fusaner",
                    "text": "Não se sabe quem... ou o que se pode encontrar.",
                    "choices": [
                        {
                            "id": "1903102103",
                            "text": "...",
                            "response": [
                                {
                                    "id": "1903102105",
                                    "speaker": "Fusaner",
                                    "text": "#Hmm, você parece estar bem calm{M#o}{F#a}. Há um ditado que diz: \"Quem caminha ao longo do rio fica com os sapatos molhados\"."
                                },
                                {
                                    "id": "1903102106",
                                    "speaker": "Fusaner",
                                    "text": "Em um lugar tão estranho e assustador como este, você pode encontrar algo que não deveria..."
                                },
                                {
                                    "id": "1903102107",
                                    "speaker": "Fusaner",
                                    "text": "E o que encontrar aqui pode se tornar um pesadelo que assombrará você pelo resto de sua vida.",
                                    "choices": [
                                        {
                                            "id": "1903102108",
                                            "text": "É mesmo?",
                                            "response": [
                                                {
                                                    "id": "1903102110",
                                                    "speaker": "Fusaner",
                                                    "text": "#Hã? Como pode estar tão calm{M#o}{F#a}? As pessoas geralmente fogem com medo antes mesmo que eu possa terminar uma frase.",
                                                    "choices": [
                                                        {
                                                            "id": "1903102111",
                                                            "text": "Você parece uma pessoa comum.",
                                                            "response": [
                                                                {
                                                                    "id": "1903102112",
                                                                    "speaker": "Fusaner",
                                                                    "text": "Sim, mas a melhor forma de interpretar um fantasma é criar uma atmosfera assustadora que amedronte as pessoas psicologicamente."
                                                                },
                                                                {
                                                                    "id": "1903102113",
                                                                    "speaker": "Fusaner",
                                                                    "text": "Nesse caso, minha aparência é irrelevante."
                                                                },
                                                                {
                                                                    "id": "1903102117",
                                                                    "speaker": "Fusaner",
                                                                    "text": "Além do mais, nunca vou conseguir assustar alguém como você, que não acredita em fantasmas."
                                                                },
                                                                {
                                                                    "id": "1903102118",
                                                                    "speaker": "Player",
                                                                    "text": "Parece que você está apenas enrolando..."
                                                                },
                                                                {
                                                                    "id": "1903102119",
                                                                    "speaker": "Fusaner",
                                                                    "text": "Ei, isso não é verdade! Oh, é melhor eu procurar alguns covardes para assustar!"
                                                                },
                                                                {
                                                                    "id": "1903102120",
                                                                    "speaker": "Fusaner",
                                                                    "text": "Você deve voltar e encontrar seu companheiro. Ele deve estar apavorado a essa altura."
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "1903102114",
                                                            "text": "Você não tem uma fantasia ou algo parecido?",
                                                            "response": [
                                                                {
                                                                    "id": "1903102115",
                                                                    "speaker": "Fusaner",
                                                                    "text": "Sim, tenho uma, mas é quente demais por dentro... e, além disso, a melhor forma de fingir um fantasma é criar uma atmosfera assustadora que amedronte as pessoas psicologicamente."
                                                                },
                                                                {
                                                                    "id": "1903102116",
                                                                    "speaker": "Fusaner",
                                                                    "text": "Nesse caso, minha aparência é irrelevante."
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "1903102109",
                                            "text": "Desculpe, não entendi... O que você está fazendo aqui?"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "1903102104",
                            "text": "Olá."
                        }
                    ]
                }
            ]
