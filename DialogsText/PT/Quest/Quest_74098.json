            ]
        },
        {
            "id": "7409806",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "740980601",
                    "speaker": "Roussimoff",
                    "text": "Você se destaca demais para eu não te convidar."
                },
                {
                    "id": "740980602",
                    "speaker": "Roussimoff",
                    "text": "Treine comigo! Vou te mostrar como eu e meus punhos somos durões!"
                }
            ]
        },
        {
            "id": "7409808",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "740980801",
                    "speaker": "Player",
                    "text": "Pode começar."
                },
