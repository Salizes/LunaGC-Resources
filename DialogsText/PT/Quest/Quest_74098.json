                {
                    "id": "740980401",
                    "speaker": "Player",
                    "text": "Eu não tenho tempo agora..."
                },
                {
                    "id": "740980402",
                    "speaker": "Goncourt",
                    "text": "Então vou achar outra coisa para passar o tempo... e esperar por você."
