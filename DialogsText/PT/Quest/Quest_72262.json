        {
            "id": "7226206",
            "objective": "Derrote os Hilichurls",
            "dialogues": [
                {
                    "id": "722620601",
                    "speaker": "\"Kichiboushi\"",
                    "text": "Hmm, por que não entrar na água e pegar peixe?",
                    "choices": [
                        {
                            "id": "722620602",
                            "text": "Alguns peixes não podem ser pegos assim.",
                            "response": [
                                {
                                    "id": "722620605",
                                    "speaker": "Paimon",
                                    "text": "Isso mesmo! Pescar é uma ótima maneira de treinar!",
                                    "choices": [
                                        {
                                            "id": "722620606",
                                            "text": "Kichiboushi, venha experimentar.",
                                            "response": [
                                                {
                                                    "id": "722620607",
                                                    "speaker": "\"Kichiboushi\"",
                                                    "text": "Hmm?"
                                                },
                                                {
                                                    "id": "722620610",
                                                    "speaker": "Black Screen",
                                                    "text": "Kichiboushi tenta pescar.\\nComo esperado, ele não pescou nenhum peixe.\\nNo final, vocês três desistem de pescar e brincam com a água."
                                                },
                                                {
                                                    "id": "722620611",
                                                    "speaker": "Paimon",
                                                    "text": "Embora Paimon odeie se molhar, brincar na água foi bem divertido!"
                                                },
                                                {
                                                    "id": "722620612",
                                                    "speaker": "\"Kichiboushi\"",
                                                    "text": "Kichiboushi está feliz! Mas pescar é muito difícil..."
                                                },
                                                {
                                                    "id": "722620613",
                                                    "speaker": "Paimon",
                                                    "text": "#Sim. Mas se você aprender a pescar, poderá fazer novos amigos algum dia. Não é, {NICKNAME}?",
                                                    "choices": [
                                                        {
                                                            "id": "722620614",
                                                            "text": "Exatamente.",
                                                            "response": [
                                                                {
                                                                    "id": "722620617",
                                                                    "speaker": "\"Kichiboushi\"",
                                                                    "text": "Difícil de entender... Mas Kichiboushi entende."
                                                                },
                                                                {
                                                                    "id": "722620618",
                                                                    "speaker": "\"Kichiboushi\"",
                                                                    "text": "#Brincar com {NICKNAME} e Paimon muito divertido. {NICKNAME} e Paimon são amig{F#as}{M#os} de Kichiboushi."
                                                                },
                                                                {
                                                                    "id": "722620619",
                                                                    "speaker": "\"Kichiboushi\"",
                                                                    "text": "Treinar é legal!"
                                                                },
                                                                {
                                                                    "id": "722620620",
                                                                    "speaker": "Paimon",
                                                                    "text": "Oh, sim, falando nisso, o objetivo de Ioroi era levar Kichiboushi a oito lugares para treinar..."
                                                                },
                                                                {
                                                                    "id": "722620621",
                                                                    "speaker": "Paimon",
                                                                    "text": "Espinha do Dragão, Floresta de Pedra Guyun, Mondstadt, Liyue, Montanha Hulao... Já terminamos mais da metade de seu treinamento!"
                                                                },
                                                                {
                                                                    "id": "722620622",
                                                                    "speaker": "\"Kichiboushi\"",
                                                                    "text": "Hmm, é verdade..."
                                                                },
                                                                {
                                                                    "id": "722620623",
                                                                    "speaker": "Paimon",
                                                                    "text": "Bem, para onde vamos agora?"
                                                                },
                                                                {
                                                                    "id": "722620624",
                                                                    "speaker": "Player",
                                                                    "text": "Deixarei você decidir."
                                                                },
                                                                {
                                                                    "id": "722620625",
                                                                    "speaker": "Paimon",
                                                                    "text": "#Ooh, Paimon dificilmente tem chances de ouvir algo assim de você, {NICKNAME}!"
                                                                },
                                                                {
                                                                    "id": "722620626",
                                                                    "speaker": "Paimon",
                                                                    "text": "Deixe isso com Paimon!"
                                                                },
                                                                {
                                                                    "id": "722620627",
                                                                    "speaker": "\"Kichiboushi\"",
                                                                    "text": "Deixemos com Paimon!"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "722620615",
                                                            "text": "Sim, mas também é possível que suas despesas com alimentação aumentem um pouco.",
                                                            "response": [
                                                                {
                                                                    "id": "722620616",
                                                                    "speaker": "Paimon",
                                                                    "text": "Ei!"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "722620608",
                                            "text": "Tente você, Paimon.",
                                            "response": [
                                                {
                                                    "id": "722620609",
                                                    "speaker": "Paimon",
                                                    "text": "Os peixes puxariam Paimon direto para a água!"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "722620603",
                            "text": "Apesar de problemático, é um pouco interessante."
                        },
                        {
                            "id": "722620604",
                            "text": "Esse também é um tipo de treinamento."
                        }
                    ]
                }
            ]
        },
