    "talks": [
        {
            "id": "7226201",
            "objective": "",
            "dialogues": [
                {
                    "id": "722620101",
                    "speaker": "\"Kichiboushi\"",
                    "text": "Ooh, o mar daqui é bonito."
                },
                {
                    "id": "722620102",
                    "speaker": "Paimon",
                    "text": "Hã? A Ilhota Dihua não é o mar."
                },
                {
                    "id": "722620103",
                    "speaker": "Player",
                    "text": "Mas as águas daqui estão ligadas ao mar..."
                },
                {
                    "id": "722620104",
                    "speaker": "Paimon",
                    "text": "Hmm, é verdade... Mas dizer que a Ilhota de Dihua é o mar não parece certo."
                },
                {
                    "id": "722620105",
                    "speaker": "\"Kichiboushi\"",
                    "text": "Hmm... Não entendo. \"Mar\" e \"não mar\", qual diferença?",
                    "choices": [
                        {
                            "id": "722620106",
                            "text": "O gosto da água?",
                            "response": [
                                {
                                    "id": "722620107",
                                    "speaker": "\"Kichiboushi\"",
                                    "text": "Ooh! Água da floresta é doce, não é mar!"
                                },
                                {
                                    "id": "722620108",
                                    "speaker": "Paimon",
                                    "text": "Mas, se o Lago de Sidra estivesse cheio de sidra, o que ele seria...?"
                                },
                                {
                                    "id": "722620109",
                                    "speaker": "Player",
                                    "text": "Algo que Venti ficaria feliz."
                                },
                                {
                                    "id": "722620120",
                                    "speaker": "Paimon",
                                    "text": "Mas, vamos deixar esse problema de lado por um momento. É só Paimon, ou Kichiboushi está falando melhor?",
                                    "choices": [
                                        {
                                            "id": "722620121",
                                            "text": "Bem, de acordo com o que Ioroi disse...",
                                            "response": [
                                                {
                                                    "id": "722620123",
                                                    "speaker": "Paimon",
                                                    "text": "O que foi que Ioroi disse mesmo? \"Eu sou o grande Bake-Danuki, Ioroi\"... Não, não foi isso..."
                                                },
                                                {
                                                    "id": "722620124",
                                                    "speaker": "Paimon",
                                                    "text": "\"Ooh, eu quero coçar minha barriga\"... Também não foi isso..."
                                                },
                                                {
                                                    "id": "722620125",
                                                    "speaker": "\"Kichiboushi\"",
                                                    "text": "Mmhahaha! Paimon imita bem! Muito engraçada!"
                                                },
                                                {
                                                    "id": "722620126",
                                                    "speaker": "Player",
                                                    "text": "\"Quanto mais nos acostumarmos à aura de Kichiboushi...\""
                                                },
                                                {
                                                    "id": "722620127",
                                                    "speaker": "Paimon",
                                                    "text": "Ah, sim! Quanto mais nos acostumarmos à aura de Kichiboushi, melhor o entenderemos!"
                                                },
                                                {
                                                    "id": "722620128",
                                                    "speaker": "\"Kichiboushi\"",
                                                    "text": "#E treinamento também! Kichiboushi aprendendo muitas coisas com {NICKNAME} e Paimon!",
                                                    "choices": [
                                                        {
                                                            "id": "722620129",
                                                            "text": "Paimon é uma boa guia.",
                                                            "response": [
                                                                {
                                                                    "id": "722620130",
                                                                    "speaker": "Paimon",
                                                                    "text": "Hã..."
                                                                },
                                                                {
                                                                    "id": "722620131",
                                                                    "speaker": "Paimon",
                                                                    "text": "#Você lembra tudo isso de antigamente, não é, {NICKNAME}? Paimon fica feliz..."
                                                                },
                                                                {
                                                                    "id": "722620132",
                                                                    "speaker": "\"Kichiboushi\"",
                                                                    "text": "#Hmm! Obrigado, Paimon e {NICKNAME}!"
                                                                },
                                                                {
                                                                    "id": "722620136",
                                                                    "speaker": "\"Kichiboushi\"",
                                                                    "text": "Esse \"mar ou não mar\" é bonito. A casa ali atrás também muito bonita. Ajudar Kichiboushi tirar foto?"
                                                                },
                                                                {
                                                                    "id": "722620137",
                                                                    "speaker": "Player",
                                                                    "text": "Deixe comigo."
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "722620133",
                                                            "text": "Companheiros que aventuram juntos crescem juntos.",
                                                            "response": [
                                                                {
                                                                    "id": "722620134",
                                                                    "speaker": "\"Kichiboushi\"",
                                                                    "text": "Hmm! Companheiros."
                                                                },
                                                                {
                                                                    "id": "722620135",
                                                                    "speaker": "Paimon",
                                                                    "text": "Melhores companheiros!"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "722620122",
                                            "text": "Antes de partirmos, Ioroi disse algo sobre isso..."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "722620110",
                            "text": "O mar é um corpo d'água enorme ao redor de um continente.",
                            "response": [
                                {
                                    "id": "722620111",
                                    "speaker": "Paimon",
                                    "text": "Uau, que definição tão séria! Mas isso nos leva de volta a pergunta sobre o que é uma fronteira..."
                                },
                                {
                                    "id": "722620112",
                                    "speaker": "\"Kichiboushi\"",
                                    "text": "#{NICKNAME} disse há pouco que a Ilhota de Dihua é ligada ao mar. Por isso, a diferença entre continente e não-continente?"
                                },
                                {
                                    "id": "722620113",
                                    "speaker": "Paimon",
                                    "text": "... Acho que sua definição restrita não está resolvendo nosso problema, não é?"
                                }
                            ]
                        },
                        {
                            "id": "722620114",
                            "text": "Esses conceitos são criados pelas pessoas. Não possuem nenhum significado.",
                            "response": [
                                {
                                    "id": "722620115",
                                    "speaker": "Player",
                                    "text": "Se a Ilhota de Dihua crer que ela é o mar, então é o mar."
                                },
                                {
                                    "id": "722620116",
                                    "speaker": "\"Kichiboushi\"",
                                    "text": "Kichiboushi pensa que é um Adeptus, então é um Adeptus?"
                                },
                                {
                                    "id": "722620117",
                                    "speaker": "Paimon",
                                    "text": "#Ei! Kichiboushi, não dê ouvidos {F#a}{M#ao} {NICKNAME}! {NICKNAME}, o que você está falando..."
                                },
                                {
                                    "id": "722620118",
                                    "speaker": "Paimon",
                                    "text": "... Entretanto, apesar de ter sido meio bagunçado, você tinha um bom ponto. Você pode ser qualquer Bake-Danuki que quiser, Kichiboushi! E quem sabe um dia você se torne um Adeptus Tanuki!"
                                },
                                {
                                    "id": "722620119",
                                    "speaker": "\"Kichiboushi\"",
                                    "text": "Tanuki adeptus! Uhul!"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7226202",
            "objective": "Vá até um local em que é possível ver a Ilhota de DIhua",
            "dialogues": []
        },
        {
            "id": "7226203",
            "objective": "Fotografe Kichiboushi",
            "dialogues": [
                {
                    "id": "722620301",
                    "speaker": "\"Kichiboushi\"",
                    "text": "Ooh... Por quê..."
                },
                {
                    "id": "722620302",
                    "speaker": "Paimon",
                    "text": "Kichiboushi! Por que você diretamente para o acampamento dos Hilichurls?!"
                },
                {
                    "id": "722620303",
                    "speaker": "\"Kichiboushi\"",
                    "text": "Pensei que podíamos brincar..."
                },
                {
                    "id": "722620304",
                    "speaker": "Paimon",
                    "text": "Hã? Por quê? Os Hilichurls são monstros perigosos...",
                    "choices": [
                        {
                            "id": "722620305",
                            "text": "Bem, eu não diria que são tão perigosos assim...",
                            "response": [
                                {
                                    "id": "722620306",
                                    "speaker": "Paimon",
                                    "text": "#Ei! Kichiboushi não é {F#uma}{M#um} Viajante experiente como você!"
                                },
                                {
                                    "id": "722620309",
                                    "speaker": "Player",
                                    "text": "Hmm, quando nos conhecemos a primeira vez na Floresta Chinju..."
                                },
                                {
                                    "id": "722620310",
                                    "speaker": "Paimon",
                                    "text": "Isso mesmo! Os Hilichurls estavam lhe cercando, e você virou alguma outra coisa para se esconder, não foi?"
                                },
                                {
                                    "id": "722620311",
                                    "speaker": "\"Kichiboushi\"",
                                    "text": "Quando nos conhecemos pela primeira vez... Primeira vez... Estou pensando... Lembrei!"
                                },
                                {
                                    "id": "722620312",
                                    "speaker": "\"Kichiboushi\"",
                                    "text": "Eu estava brincando de esconde-esconde com os Hilichurls. Hilichurls da floresta não atacam Bake-danuki. Brincam sempre conosco."
                                },
                                {
                                    "id": "722620313",
                                    "speaker": "Paimon",
                                    "text": "Hã? Então vocês têm uma boa relação?"
                                },
                                {
                                    "id": "722620314",
                                    "speaker": "\"Kichiboushi\"",
                                    "text": "Não sei por qual motivo os Hilichurls daqui são assim. Hmm..."
                                },
                                {
                                    "id": "722620315",
                                    "speaker": "Paimon",
                                    "text": "Enfim, você precisa ter mais cuidado. Mesmo se tratando de Hilichurls... Bem, especialmente se tratando deles!"
                                },
                                {
                                    "id": "722620316",
                                    "speaker": "Paimon",
                                    "text": "#Argh, que complicado... {NICKNAME}, melhor você explicar!"
                                },
                                {
                                    "id": "722620317",
                                    "speaker": "Player",
                                    "text": "Você precisa diferenciar entre boas e más pessoas."
                                },
                                {
                                    "id": "722620318",
                                    "speaker": "Paimon",
                                    "text": "Sim! É assim que você pode se proteger no futuro."
                                },
                                {
                                    "id": "722620319",
                                    "speaker": "Player",
                                    "text": "Mas não se esqueça de ter um coração bom e aberto."
                                },
                                {
                                    "id": "722620320",
                                    "speaker": "Paimon",
                                    "text": "Sim, isso mesmo! Isso lhe ajudará aproveitar melhor a vida."
                                },
                                {
                                    "id": "722620321",
                                    "speaker": "\"Kichiboushi\"",
                                    "text": "Hmm..."
                                },
                                {
                                    "id": "722620322",
                                    "speaker": "\"Kichiboushi\"",
                                    "text": "#{NICKNAME} e Paimon dizem coisas complicadas. Kichiboushi não entende."
                                },
                                {
                                    "id": "722620323",
                                    "speaker": "\"Kichiboushi\"",
                                    "text": "Mas Kichiboushi sabe que vocês são boas pessoas. Por isso, Kichiboushi vai aprender."
                                },
                                {
                                    "id": "722620324",
                                    "speaker": "Paimon",
                                    "text": "#Bem, já chega disso. Por enquanto, é hora de aprender a pescar com {NICKNAME}!"
                                },
                                {
                                    "id": "722620325",
                                    "speaker": "\"Kichiboushi\"",
                                    "text": "Hmm! Pescar!"
                                }
                            ]
                        },
                        {
                            "id": "722620307",
                            "text": "Sim, são muito perigosos!",
                            "response": [
                                {
                                    "id": "722620308",
                                    "speaker": "Paimon",
                                    "text": "Ei, também não precisa assustá-lo!"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
