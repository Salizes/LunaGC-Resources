            "objective": "Additional",
            "dialogues": [
                {
                    "id": "130040301",
                    "speaker": "Foto Antiga",
                    "text": "A foto desse lado..."
                },
                {
                    "id": "130040302",
                    "speaker": "Foto Antiga",
                    "text": "(Uma de muitas fotografias de um grupo. Tighnari sempre está com a mesma expressão, não parece tão interessado nessa foto.)"
