    "talks": [
        {
            "id": "7467101",
            "objective": "Fale com Macadell",
            "dialogues": [
                {
                    "id": "746710101",
                    "speaker": "Macadell",
                    "text": "Droga! Potência do núcleo continua muito inconsistente. Meu projeto está acabado se continuar assim..."
                },
                {
                    "id": "746710102",
                    "speaker": "Player",
                    "text": "O que você tá fazendo?"
                },
                {
                    "id": "746710103",
                    "speaker": "Macadell",
                    "text": "AAAAH! V-Você me assustou! Podia ter sido um desastre se eu tivesse apertado esse botão!"
                },
                {
                    "id": "746710104",
                    "speaker": "Macadell",
                    "text": "Julgando pela sua aparência... Vocês não são da Guilda de Aventureiros.",
                    "choices": [
                        {
                            "id": "746710105",
                            "text": "Você publicou uma comissão na Guilda?",
                            "response": [
                                {
                                    "id": "746710106",
                                    "speaker": "Macadell",
                                    "text": "Não, eu não tenho o dinheiro para isso... E não sou bom em lidar com aventureiros."
                                },
                                {
                                    "id": "746710109",
                                    "speaker": "Macadell",
                                    "text": "Só estou \"colaborando\" em um projeto com a Guilda de Aventureiros..."
                                },
                                {
                                    "id": "746710110",
                                    "speaker": "Macadell",
                                    "text": "Opa, esqueci de me apresentar. Sou Macadell, um pesquisador do Instituto de Pesquisas de Fontaine."
                                },
                                {
                                    "id": "746710111",
                                    "speaker": "Macadell",
                                    "text": "O projeto em que trabalhei foi o \"Minidispositivo de Armazenamento de Pneumousia Portátil\"."
                                },
                                {
                                    "id": "746710112",
                                    "speaker": "Macadell",
                                    "text": "Graças aos esforços combinados dos meus companheiros de equipe, construímos o primeiro protótipo."
                                },
                                {
                                    "id": "746710113",
                                    "speaker": "Macadell",
                                    "text": "Então... Bem, como todos sabem, uma grande explosão aconteceu no Instituto."
                                },
                                {
                                    "id": "746710114",
                                    "speaker": "Macadell",
                                    "text": "O líder do projeto e maioria dos membros da equipe do projeto se foram na explosão."
                                },
                                {
                                    "id": "746710115",
                                    "speaker": "Macadell",
                                    "text": "Além de mim, não há basicamente mais ninguém que possa continuar o trabalho e avançar a pesquisa..."
                                },
                                {
                                    "id": "746710116",
                                    "speaker": "Macadell",
                                    "text": "Mas... considerando o alvoroço no Instituto, devo demonstrar seu valor assim que possível para conseguir manter o projeto vivo."
                                },
                                {
                                    "id": "746710117",
                                    "speaker": "Macadell",
                                    "text": "Então, após consultar todas as partes, a Guilda de Aventureiros e eu chegamos a um acordo."
                                },
                                {
                                    "id": "746710118",
                                    "speaker": "Macadell",
                                    "text": "Eu queria usar o protótipo do Minidispositivo de Armazenamento de Pneumousia Portátil como núcleo para criar um Impactador Pressurizado."
                                },
                                {
                                    "id": "746710119",
                                    "speaker": "Macadell",
                                    "text": "Eu queria usar o desempenho operacional dos Impactadores Pressurizados para provar a confiabilidade no Minidispositivo de Armazenamento de Pneumousia Portátil."
                                },
                                {
                                    "id": "746710120",
                                    "speaker": "Macadell",
                                    "text": "E eu consegui construir a máquina com sucesso, e comecei a operá-la.",
                                    "choices": [
                                        {
                                            "id": "746710121",
                                            "text": "Parece que deu tudo certo.",
                                            "response": [
                                                {
                                                    "id": "746710122",
                                                    "speaker": "Macadell",
                                                    "text": "Hahaha, sim, de fato... Até o Impactador Pressurizado começar a funcionar."
                                                },
                                                {
                                                    "id": "746710125",
                                                    "speaker": "Macadell",
                                                    "text": "*Suspiro* Eu tinha uma dor de cabeça sempre que falava disso."
                                                },
                                                {
                                                    "id": "746710126",
                                                    "speaker": "Macadell",
                                                    "text": "Não faço ideia se o problema é com o design do protótipo, ou falhas no método de transferência de energia do Impactador Pressurizado..."
                                                },
                                                {
                                                    "id": "746710127",
                                                    "speaker": "Macadell",
                                                    "text": "A energia indo do Minidispositivo de Armazenamento de Pneumousia Portátil para o Impactador Pressurizado sempre flutuou intensamente."
                                                },
                                                {
                                                    "id": "746710128",
                                                    "speaker": "Macadell",
                                                    "text": "E isso tornou a potência do Impactador imprevisível também!"
                                                },
                                                {
                                                    "id": "746710129",
                                                    "speaker": "Macadell",
                                                    "text": "Quando a potência está alta, essa máquina pode facilmente destruir pedras. Mas quando a potência está baixa, até fazer um furo na lama é um desafio."
                                                },
                                                {
                                                    "id": "746710130",
                                                    "speaker": "Macadell",
                                                    "text": "Considerando a situação do Instituto, era basicamente impossível eu voltar e reconstruir o Minidispositivo de Armazenamento de Pneumousia Portátil..."
                                                },
                                                {
                                                    "id": "746710131",
                                                    "speaker": "Macadell",
                                                    "text": "Eu só posso instalar um dispositivo de monitoramento extra no protótipo para monitorar a força de sua potência energética em tempo real."
                                                },
                                                {
                                                    "id": "746710132",
                                                    "speaker": "Macadell",
                                                    "text": "Eu só tenho que ativar o Impactador Pressurizado quando a potência estiver no ápice para maximizar o potencial!",
                                                    "choices": [
                                                        {
                                                            "id": "746710133",
                                                            "text": "Isso é conturbado demais!",
                                                            "response": [
                                                                {
                                                                    "id": "746710134",
                                                                    "speaker": "Macadell",
                                                                    "text": "Mas essa é a melhor e mais barata solução que pude pensar... O que mais posso fazer?"
                                                                },
                                                                {
                                                                    "id": "746710137",
                                                                    "speaker": "Macadell",
                                                                    "text": "*Suspiro* A Guilda de Aventureiros está provavelmente pensando a mesma coisa. Por isso não enviaram ninguém ainda..."
                                                                },
                                                                {
                                                                    "id": "746710138",
                                                                    "speaker": "Macadell",
                                                                    "text": "O que vamos fazer? Se não tivermos os dados dos testes, não posso fazer um relatório para o Instituto..."
                                                                },
                                                                {
                                                                    "id": "746710139",
                                                                    "speaker": "Macadell",
                                                                    "text": "Viajante, se não se importa, poderia me ajudar?"
                                                                },
                                                                {
                                                                    "id": "746710140",
                                                                    "speaker": "Macadell",
                                                                    "text": "Eu garanto, meu dispositivo é totalmente confiável! Eu até fiz um monte de extensões para ele para melhorar suas várias funcionalidades.",
                                                                    "choices": [
                                                                        {
                                                                            "id": "746710141",
                                                                            "text": "E se eu não conseguir acertar o momento?",
                                                                            "response": [
                                                                                {
                                                                                    "id": "746710142",
                                                                                    "speaker": "Macadell",
                                                                                    "text": "Está tudo bem, o pior cenário é... que não tenha potência suficiente. Não vai explodir nem nada."
                                                                                },
                                                                                {
                                                                                    "id": "746710143",
                                                                                    "speaker": "Macadell",
                                                                                    "text": "Tudo que você tem que fazer é esperar que a potência chegue ao máximo, então ligar a máquina para ter a potência máxima."
                                                                                },
                                                                                {
                                                                                    "id": "746710148",
                                                                                    "speaker": "Macadell",
                                                                                    "text": "Relaxe, Viajante. Essa máquina é totalmente segura e... após o teste acabar, eu até te pago!"
                                                                                },
                                                                                {
                                                                                    "id": "746710149",
                                                                                    "speaker": "Macadell",
                                                                                    "text": "Então deixo isso com você! Meu futuro, o futuro desta máquina... E meu futuro lugar nesse projeto! Está tudo em suas mãos!"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "746710144",
                                                                            "text": "Não vai explodir na minha cara, vai?",
                                                                            "response": [
                                                                                {
                                                                                    "id": "746710145",
                                                                                    "speaker": "Macadell",
                                                                                    "text": "Isso é absolutamente impossível. Eu adicionei muitos dispositivos de monitoramento e segurança, então o pior caso seria não ter potência suficiente. Uma explosão é impossível."
                                                                                },
                                                                                {
                                                                                    "id": "746710146",
                                                                                    "speaker": "Macadell",
                                                                                    "text": "E mesmo que você perca o pico de energia, está tudo bem também."
                                                                                },
                                                                                {
                                                                                    "id": "746710147",
                                                                                    "speaker": "Macadell",
                                                                                    "text": "É só esperar que a potência chegue ao máximo, então ligar a máquina para ter a potência máxima."
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "746710135",
                                                            "text": "Não vai funcionar...",
                                                            "response": [
                                                                {
                                                                    "id": "746710136",
                                                                    "speaker": "Macadell",
                                                                    "text": "Por favor, não diga isso! É a melhor solução que tenho. Juro, é muito útil!"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "746710123",
                                            "text": "Isso não pareceu um problema.",
                                            "response": [
                                                {
                                                    "id": "746710124",
                                                    "speaker": "Macadell",
                                                    "text": "Sim, além da própria máquina, tudo funcionou perfeitamente."
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "746710107",
                            "text": "Você contratou aventureiros para proteção?",
                            "response": [
                                {
                                    "id": "746710108",
                                    "speaker": "Macadell",
                                    "text": "Não posso pagar. Eles pedem muito pelos serviços deles..."
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}