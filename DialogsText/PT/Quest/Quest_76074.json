            "dialogues": [
                {
                    "id": "760740101",
                    "speaker": "Paimon",
                    "text": "Que instrumento estranho... Não importa como Paimon toque ele, não tem som nenhum! Será que tá quebrado?",
                    "choices": [
                        {
                            "id": "760740102",
                            "text": "Vamos seguir os Seelies primeiro.",
                            "response": [
                                {
                                    "id": "760740103",
                                    "speaker": "Paimon",
                                    "text": "Sim, deixa esse instrumento pra lá por enquanto. Vamos seguir os Seelies, assim vamos encontrar o tesouro!"
                                }
                            ]
                        },
                        {
                            "id": "760740104",
                            "text": "Hã? Mas eu ouvi música agora há pouco. E alguém cantando...",
                            "response": [
                                {
                                    "id": "760740105",
                                    "speaker": "Paimon",
                                    "text": "Mesmo? Mas Paimon só ouviu o vento... espera, essa é uma daquelas situações que só quem toca o instrumento pode ouvir a música?"
                                },
                                {
                                    "id": "760740106",
                                    "speaker": "Paimon",
                                    "text": "Certo, deixa a Paimon tentar..."
                                },
                                {
                                    "id": "760740107",
                                    "speaker": "Black Screen",
                                    "text": "Paimon toca as cordas...\\n"
                                },
                                {
                                    "id": "760740108",
                                    "speaker": "Black Screen",
                                    "text": "E, mais uma vez, a melodia triste sobe, leve como uma brisa na alvorada, carregando uma música leve...\\n"
                                },
                                {
                                    "id": "760740109",
                                    "speaker": "Black Screen",
                                    "text": "Você entende cada palavra da música, cada frase, cada nota, mesmo nunca tendo ouvido a língua antes."
                                }
                            ]
                        }
                    ]
                }
