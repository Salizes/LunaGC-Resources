    "talks": [
        {
            "id": "7220301",
            "objective": "",
            "dialogues": [
                {
                    "id": "722030101",
                    "speaker": "Nonno",
                    "text": "Uau, me pegou!"
                },
                {
                    "id": "722030102",
                    "speaker": "Nonno",
                    "text": "Venha jogar comigo na próxima vez!"
                }
            ]
        },
        {
            "id": "7220302",
            "objective": "",
            "dialogues": [
                {
                    "id": "722030201",
                    "speaker": "Nonno",
                    "text": "Você me encontrou de novo, que incrível!"
                },
                {
                    "id": "722030202",
                    "speaker": "Nonno",
                    "text": "Você nunca vai me pegar de novo."
                }
            ]
        },
        {
            "id": "7220303",
            "objective": "",
            "dialogues": [
                {
                    "id": "722030301",
                    "speaker": "Nonno",
                    "text": "Olha, não me escondi bem dessa vez."
                },
                {
                    "id": "722030302",
                    "speaker": "Nonno",
                    "text": "De novo! Vamos de novo!"
                }
            ]
        },
        {
            "id": "7220304",
            "objective": "",
            "dialogues": [
                {
                    "id": "722030401",
                    "speaker": "Nonno",
                    "text": "Ah, se eles também fossem tão incríveis como você!"
                },
                {
                    "id": "722030402",
                    "speaker": "Nonno",
                    "text": "Somos amigos, não é?"
                }
            ]
        },
        {
            "id": "7220305",
            "objective": "",
            "dialogues": [
                {
                    "id": "722030501",
                    "speaker": "Nonno",
                    "text": "Haha, você me encontrou de novo!"
                },
                {
                    "id": "722030502",
                    "speaker": "Nonno",
                    "text": "Sabe, eu sentirei sua falta, mas... Desta vez tenho que me despedir. O tio dourado disse que nós temos que ir..."
                },
                {
                    "id": "722030503",
                    "speaker": "Nonno",
                    "text": "Mas não se preocupe comigo! Há muitas pessoas que podem brincar disso comigo no lugar que estou indo! Gostaria que você pudesse vir também, mas o tio dourado disse que ainda não é essa hora..."
                },
                {
                    "id": "722030504",
                    "speaker": "Nonno",
                    "text": "Mas não se preocupe. Eu ficarei esperando você. Se um dia eu me cansar de esperar, eu me tornarei em pedacinhos de luz brilhante e entrarei nos seus sonhos para lhe procurar!"
                },
                {
                    "id": "722030505",
                    "speaker": "Player",
                    "text": "Boa Viagem!"
                },
                {
                    "id": "722030506",
                    "speaker": "Nonno",
                    "text": "Fiquei muito feliz de brincar com você, obrigado!"
                },
                {
                    "id": "722030507",
                    "speaker": "Nonno",
                    "text": "Nunca ficarei sozinho de novo... Que ótimo!"
                }
            ]
        },
