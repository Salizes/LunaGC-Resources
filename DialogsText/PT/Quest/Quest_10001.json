    "talks": [
        {
            "id": "100010",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "10001001",
                    "speaker": "Infiltração do Terraço de Yujing AI1",
                    "text": "Alguém assassinou Rex Lapis! Por favor, cooperem com nossas investigações."
                },
                {
                    "id": "10001002",
                    "speaker": "Infiltração do Terraço de Yujing AI2",
                    "text": "Quem ousaria machucar Rex Lapis?! Eu não posso acreditar!"
                },
                {
                    "id": "10001003",
                    "speaker": "Infiltração do Terraço de Yujing AI3",
                    "text": "O que foi que aconteceu exatamente?!"
                },
                {
                    "id": "10001004",
                    "speaker": "Infiltração do Terraço de Yujing AI4",
                    "text": "Em plena luz do dia! Que tipo de magia negra é essa?"
                },
                {
                    "id": "10001021",
                    "speaker": "Público",
                    "text": "Eu... Eu não sei nada... Eu juro..."
                },
                {
                    "id": "10001022",
                    "speaker": "Público",
                    "text": "A fumaça é muito densa... eu não consigo enxergar..."
                },
                {
                    "id": "10001023",
                    "speaker": "Público",
                    "text": "A culpa não foi minha, por favor tenha piedade de mim"
                },
                {
                    "id": "10001024",
                    "speaker": "Público",
                    "text": "Rex Lapis... Rex Lapis... como é possível?"
                },
                {
                    "id": "10001051",
                    "speaker": "Paimon",
                    "text": "Estamos em um local muito chamativo."
                }
            ]
        },
        {
            "id": "100012",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "10001201",
                    "speaker": "Infiltração do Terraço de Yujing AI1",
                    "text": "Não tem para onde fugir!"
                },
                {
                    "id": "10001202",
                    "speaker": "Childe",
                    "text": "#Ei amig{M#o}{F#a} - Não se mexa!"
                },
                {
                    "id": "10001203",
                    "speaker": "Player",
                    "text": "Uh?"
                },
                {
                    "id": "10001204",
                    "speaker": "Childe",
                    "text": "Venha comigo."
                },
                {
                    "id": "10001205",
                    "speaker": "Infiltração do Terraço de Yujing AI1",
                    "text": "#{F#Elas}{M#Eles} estão ali!"
                },
                {
                    "id": "10001206",
                    "speaker": "Infiltração do Terraço de Yujing AI1",
                    "text": "#Peguem {F#elas}{M#eles}!"
                },
                {
                    "id": "10001207",
                    "speaker": "Infiltração do Terraço de Yujing AI1",
                    "text": "Vamos, vamos!"
                }
            ]
        },
        {
            "id": "100015",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "10001521",
                    "speaker": "Paimon",
                    "text": "#Ah, não... {NICKNAME} tem uma grande variedade de soldados lá fora também!"
                },
                {
                    "id": "10001522",
                    "speaker": "Paimon",
                    "text": "Sua identidade... Você pode não ser o assassino, mas não podemos deixá-los pegá-lo!"
                },
                {
                    "id": "10001523",
                    "speaker": "Paimon",
                    "text": "Mas... Vamos conseguir sair daqui com segurança?"
                }
            ]
        }
