    "talks": [
        {
            "id": "37201",
            "objective": "Encontre a pessoa de verde",
            "dialogues": [
                {
                    "id": "3720101",
                    "speaker": "Rapaz de Verde",
                    "text": "Ah, vocês são..."
                },
                {
                    "id": "3720102",
                    "speaker": "Rapaz de Verde",
                    "text": "Oh, isso mesmo! Vocês são aqueles que assustaram Dvalin."
                },
                {
                    "id": "3720103",
                    "speaker": "Paimon",
                    "text": "Dvalin? Quem é esse?",
                    "choices": [
                        {
                            "id": "3720104",
                            "text": "O verdadeiro nome do Stormterror.",
                            "response": [
                                {
                                    "id": "3720106",
                                    "speaker": "Paimon",
                                    "text": "Hum? Ah, sim. A maioria das pessoas o chamam de \"Stormterror\"..."
                                },
                                {
                                    "id": "3720107",
                                    "speaker": "Paimon",
                                    "text": "Por que você chama ele assim? Vocês se conhecem?"
                                },
                                {
                                    "id": "3720108",
                                    "speaker": "Rapaz de Verde",
                                    "text": "Adivinha..."
                                },
                                {
                                    "id": "3720109",
                                    "speaker": "Paimon",
                                    "text": "#Ei, {NICKNAME}, eu acho esse cara um pouco estranho...",
                                    "choices": [
                                        {
                                            "id": "3720110",
                                            "text": "Desculpe incomodar.",
                                            "response": [
                                                {
                                                    "id": "3720111",
                                                    "speaker": "Rapaz de Verde",
                                                    "text": "Bom dia, forasteiro. Nós já nos encontramos antes."
                                                },
                                                {
                                                    "id": "3720113",
                                                    "speaker": "Venti",
                                                    "text": "Eu sou Venti, o Bardo."
                                                },
                                                {
                                                    "id": "3720114",
                                                    "speaker": "Venti",
                                                    "text": "Tricampeão do Bardo Mais Popular de Mondstadt, para ser mais preciso."
                                                },
                                                {
                                                    "id": "3720115",
                                                    "speaker": "Venti",
                                                    "text": "O que vocês precisam de mim?"
                                                },
                                                {
                                                    "id": "3720116",
                                                    "speaker": "Paimon",
                                                    "text": "Já que você nos reconheceu, Paimon acha que não precisamos dar mais explicações, certo?"
                                                },
                                                {
                                                    "id": "3720117",
                                                    "speaker": "Paimon",
                                                    "text": "É sobre o Stormterror, é claro."
                                                },
                                                {
                                                    "id": "3720118",
                                                    "speaker": "Venti",
                                                    "text": "Hum?"
                                                },
                                                {
                                                    "id": "3720119",
                                                    "speaker": "Paimon",
                                                    "text": "Não finja que perdeu a memória!"
                                                },
                                                {
                                                    "id": "3720120",
                                                    "speaker": "Paimon",
                                                    "text": "#{NICKNAME}, você poderia mostrar a ele?"
                                                },
                                                {
                                                    "id": "3720121",
                                                    "speaker": "Venti",
                                                    "text": "Oh! Isso é..."
                                                },
                                                {
                                                    "id": "3720122",
                                                    "speaker": "Paimon",
                                                    "text": "O quê? O cristal foi purificado? Desde quando?",
                                                    "choices": [
                                                        {
                                                            "id": "3720123",
                                                            "text": "Não tenho certeza de quando isso aconteceu.",
                                                            "response": [
                                                                {
                                                                    "id": "3720125",
                                                                    "speaker": "Venti",
                                                                    "text": "Dvalin, ele..."
                                                                },
                                                                {
                                                                    "id": "3720126",
                                                                    "speaker": "Venti",
                                                                    "text": "É uma lágrima de sofrimento."
                                                                },
                                                                {
                                                                    "id": "3720127",
                                                                    "speaker": "Paimon",
                                                                    "text": "Lágrimas...?"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "3720124",
                                                            "text": "A última vez que o vi, estava cheio de impurezas."
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "3720112",
                                            "text": "Desculpe, mas quem é você?"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "3720105",
                            "text": "Lisa nos disse já, você não estava ouvindo?"
                        }
                    ]
                }
            ]
        },
        {
            "id": "37202",
            "objective": "Ouça a apresentação do Bardo",
            "dialogues": [
                {
                    "id": "3720201",
                    "speaker": "Venti",
                    "text": "Ele também foi uma criança calma. Veja o quão maldoso acabou se tornando..."
                },
                {
                    "id": "3720202",
                    "speaker": "Player",
                    "text": "..."
                },
                {
                    "id": "3720203",
                    "speaker": "Venti",
                    "text": "Eu também tenho um Cristal de Lágrima aqui."
                },
                {
                    "id": "3720204",
                    "speaker": "Venti",
                    "text": "Você pode purificá-lo?"
                },
                {
                    "id": "3720205",
                    "speaker": "Player",
                    "text": "*Acenando com a cabeça*"
                }
            ]
        },
        {
            "id": "37203",
            "objective": "Fale com o bardo misterioso",
            "dialogues": []
        },
        {
            "id": "37205",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "3720501",
                    "speaker": "Paimon",
                    "text": "Quêêêêê!?"
                },
                {
                    "id": "3720502",
                    "speaker": "Venti",
                    "text": "Você... Realmente tem umas habilidades incríveis."
                },
                {
                    "id": "3720503",
                    "speaker": "Venti",
                    "text": "Uma pessoa como você vai acabar aparecendo em algum poema de um bardo."
                },
                {
                    "id": "3720504",
                    "speaker": "Venti",
                    "text": "#{M#Um herói} {F#Uma heroína} deve estar do lado da luz, porque se estiver do lado escuro, o desastre será de grande magnitude."
                },
                {
                    "id": "3720505",
                    "speaker": "Venti",
                    "text": "Ah... Eu realmente não tenho tempo para compor uma melodia para você neste momento."
                },
                {
                    "id": "3720506",
                    "speaker": "Venti",
                    "text": "Mesmo se Dvalin não for derrotado, sua vida irá desaparecer na brisa..."
                },
                {
                    "id": "3720507",
                    "speaker": "Venti",
                    "text": "Ele vai queimar de fúria...",
                    "choices": [
                        {
                            "id": "3720508",
                            "text": "Eu também sinto compaixão por Dvalin...",
                            "response": [
                                {
                                    "id": "3720509",
                                    "speaker": "Venti",
                                    "text": "Obrigado, e também agradeço por purificar o Cristal da Lágrima."
                                },
                                {
                                    "id": "3720510",
                                    "speaker": "Venti",
                                    "text": "Agora é a minha vez."
                                },
                                {
                                    "id": "3720517",
                                    "speaker": "Paimon",
                                    "text": "Hum? E qual é o plano?"
                                },
                                {
                                    "id": "3720518",
                                    "speaker": "Venti",
                                    "text": "Ao ver esta lágrima, me trouxe uma recordação de um velho amigo..."
                                },
                                {
                                    "id": "3720519",
                                    "speaker": "Paimon",
                                    "text": "Amigo?"
                                },
                                {
                                    "id": "3720520",
                                    "speaker": "Venti",
                                    "text": "Hehe, eu tenho que ir."
                                },
                                {
                                    "id": "3720521",
                                    "speaker": "Paimon",
                                    "text": "Ei! Aonde você vai?"
                                },
                                {
                                    "id": "3720522",
                                    "speaker": "Venti",
                                    "text": "Para a \"Um Símbolo do Herói de Mondstadt\". Tchau!"
                                },
                                {
                                    "id": "3720523",
                                    "speaker": "Paimon",
                                    "text": "#Hum... {NICKNAME}, o que você acha que devíamos fazer?"
                                },
                                {
                                    "id": "3720524",
                                    "speaker": "Player",
                                    "text": "É um sujeito estranho, temos que ficar de olho."
                                },
                                {
                                    "id": "3720525",
                                    "speaker": "Paimon",
                                    "text": "Para ele, você também é um sujeito estranho."
                                },
                                {
                                    "id": "3720526",
                                    "speaker": "Player",
                                    "text": "Sabe..."
                                },
                                {
                                    "id": "3720527",
                                    "speaker": "Paimon",
                                    "text": "Sabe, o quê?"
                                },
                                {
                                    "id": "3720528",
                                    "speaker": "Player",
                                    "text": "Sua voz me parece familiar..."
                                }
                            ]
                        },
                        {
                            "id": "3720511",
                            "text": "Posso ajudar de alguma maneira?",
                            "response": [
                                {
                                    "id": "3720512",
                                    "speaker": "Venti",
                                    "text": "Você já ajudou muito purificando o Cristal de Lágrima. Muito obrigado."
                                },
                                {
                                    "id": "3720513",
                                    "speaker": "Venti",
                                    "text": "Mas agora, eu já tenho os meus próprios planos."
                                }
                            ]
                        },
                        {
                            "id": "3720514",
                            "text": "Como um cavaleiro, eu sugiro que você se entregue juntamente com o dragão.",
                            "response": [
                                {
                                    "id": "3720515",
                                    "speaker": "Venti",
                                    "text": "Uau, precisa mesmo falar assim?"
                                },
                                {
                                    "id": "3720516",
                                    "speaker": "Venti",
                                    "text": "Não tenho interesse em me entregar agora... Tenho outros planos."
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
