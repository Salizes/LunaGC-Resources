    "talks": [
        {
            "id": "7328201",
            "objective": "",
            "dialogues": [
                {
                    "id": "732820101",
                    "speaker": "Masseira",
                    "text": "Ah, você chegou. Por favor, pare onde está. Acredito que esta é a última vez que vou te pedir um favor.",
                    "choices": [
                        {
                            "id": "732820102",
                            "text": "Bem, no que você precisa de ajuda?",
                            "response": [
                                {
                                    "id": "732820103",
                                    "speaker": "Masseira",
                                    "text": "É Tadhla. Ela quer falar com você."
                                },
                                {
                                    "id": "732820106",
                                    "speaker": "Paimon",
                                    "text": "Hã? Como assim? Por que tanta formalidade?"
                                },
                                {
                                    "id": "732820107",
                                    "speaker": "Masseira",
                                    "text": "Ruínas ao norte... Perto do lugar onde vocês se conheceram na primeira vez...",
                                    "choices": [
                                        {
                                            "id": "732820108",
                                            "text": "O que você disse?",
                                            "response": [
                                                {
                                                    "id": "732820109",
                                                    "speaker": "Masseira",
                                                    "text": "Ruínas ao norte... Perto do lugar onde vocês se conheceram na primeira vez... Não se esqueçam."
                                                }
                                            ]
                                        },
                                        {
                                            "id": "732820110",
                                            "text": "Entendi.",
                                            "response": [
                                                {
                                                    "id": "732820111",
                                                    "speaker": "Masseira",
                                                    "text": "Sim, cuidem dela bem."
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "732820104",
                            "text": "#Estou ocupad{F#a}{M#o} com algo...",
                            "response": [
                                {
                                    "id": "732820105",
                                    "speaker": "Masseira",
                                    "text": "Por favor, você precisa me ouvir... Tadhla quer muito falar com você."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7328202",
            "objective": "Vá para onde Tadhla está esperando",
            "dialogues": [
                {
                    "id": "732820201",
                    "speaker": "Masseira",
                    "text": "Ruínas ao norte... Perto do lugar onde vocês se conheceram na primeira vez..."
                },
                {
                    "id": "732820202",
                    "speaker": "Masseira",
                    "text": "Foi a escolha dela... Espero que você possa respeitá-la."
                }
            ]
        },
        {
            "id": "7328204",
            "objective": "Fale com Tadhla",
            "dialogues": [
                {
                    "id": "732820401",
                    "speaker": "Tadhla",
                    "text": "Você veio, como eu esperava. Fico feliz.",
                    "choices": [
                        {
                            "id": "732820402",
                            "text": "Eu soube que você estava me procurando.",
                            "response": [
                                {
                                    "id": "732820404",
                                    "speaker": "Tadhla",
                                    "text": "Eu sempre pensei que esse deserto eterno é lindo. Gosto muito dele."
                                },
                                {
                                    "id": "732820405",
                                    "speaker": "Tadhla",
                                    "text": "#Mas, é uma pena... Eu nunca tive a chance de ver o pôr do sol com um{F#a} amig{M#o}{F#a} aqui."
                                },
                                {
                                    "id": "732820406",
                                    "speaker": "Paimon",
                                    "text": "Sim. Todo o deserto tem uma cor avermelhada... é lindo, muito calmo."
                                },
                                {
                                    "id": "732820407",
                                    "speaker": "Paimon",
                                    "text": "Mas, Tadhla, por que você nos chamou para vir para cá?"
                                },
                                {
                                    "id": "732820408",
                                    "speaker": "Tadhla",
                                    "text": "..."
                                },
                                {
                                    "id": "732820409",
                                    "speaker": "Tadhla",
                                    "text": "#Para Tanit, você é {F#uma}{M#um} visitante. Já para Falcão, você é uma presa em potencial... Eu espero que você sobreviva."
                                },
                                {
                                    "id": "732820410",
                                    "speaker": "Player",
                                    "text": "..."
                                },
                                {
                                    "id": "732820411",
                                    "speaker": "Tadhla",
                                    "text": "Por isso, sinto muito."
                                }
                            ]
                        },
                        {
                            "id": "732820403",
                            "text": "Como você está ultimamente?"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7328205",
            "objective": "Derrote Tadhla",
            "dialogues": []
        },
        {
            "id": "7328206",
            "objective": "Confronte Masseira",
            "dialogues": [
                {
                    "id": "732820601",
                    "speaker": "Paimon",
                    "text": "Droga... Masseira sumiu!"
                },
                {
                    "id": "732820602",
                    "speaker": "Liloupar",
                    "text": "Ele deixou esse bilhete para trás... Argh, ele é esperto como uma raposa."
                },
                {
                    "id": "732820603",
                    "speaker": "Anotação Arrumada",
                    "text": "Se você está vendo esse bilhete, isso quer dizer que eu já fugi para as profundezas do vale.\\nSe sua cabeça decepada ainda está entre os dois ombros, não fique triste pela escolha dose Tanit.\\n\\nEssa caçada ainda não terminou, ela é o começo de uma tempestade.\\nAncião dos Tanit, Caçador Masseira, enviem este aviso."
                },
                {
                    "id": "732820604",
                    "speaker": "Paimon",
                    "text": "Paimon não entendeu bem sobre o que ele está falando..."
                },
                {
                    "id": "732820605",
                    "speaker": "Liloupar",
                    "text": "Parece que como ele estava sob algum tipo de pressão, decidiu partir da tribo... E deixou esse aviso para você. Hunf, Tanit... É como uma tempestade que aparece do nada."
                }
            ]
        },
        {
            "id": "7328228",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "732822801",
                    "speaker": "Tadhla",
                    "text": "(Tadhla desvia o olhar e abaixa a cabeça nervosamente.)",
                    "choices": [
                        {
                            "id": "732822802",
                            "text": "Você está bem?",
                            "response": [
                                {
                                    "id": "732822803",
                                    "speaker": "Tadhla",
                                    "text": "Eu sinto muito. A caça terminou. Eu sou o Falcão de meu pai."
                                },
                                {
                                    "id": "732822804",
                                    "speaker": "Tadhla",
                                    "text": "Mas... Eu estou bem, não se preocupe.",
                                    "choices": [
                                        {
                                            "id": "732822808",
                                            "text": "Tão extremo assim?",
                                            "response": [
                                                {
                                                    "id": "732822809",
                                                    "speaker": "Tadhla",
                                                    "text": "Extremo...? Eu não sei. Eu sempre vivi assim."
                                                },
                                                {
                                                    "id": "732822814",
                                                    "speaker": "Tadhla",
                                                    "text": "Ah... mas, a história de você e de Paimon, a sua jornada..."
                                                },
                                                {
                                                    "id": "732822815",
                                                    "speaker": "Tadhla",
                                                    "text": "Se houver uma chance, eu gostaria muito de ouvi-la."
                                                },
                                                {
                                                    "id": "732822816",
                                                    "speaker": "Paimon",
                                                    "text": "Sim! Nós temos muitas, muitas histórias!",
                                                    "choices": [
                                                        {
                                                            "id": "732822817",
                                                            "text": "Sim, eu contarei.",
                                                            "response": [
                                                                {
                                                                    "id": "732822819",
                                                                    "speaker": "Tadhla",
                                                                    "text": "*Choro*..."
                                                                },
                                                                {
                                                                    "id": "732822820",
                                                                    "speaker": "Tadhla",
                                                                    "text": "Ahem, não é nada, eu só estou muito feliz... Obrigada..."
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "732822818",
                                                            "text": "Posso contá-las sempre que você quiser ouvir..."
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "732822810",
                                            "text": "Você não pensou em viver para si mesma?",
                                            "response": [
                                                {
                                                    "id": "732822811",
                                                    "speaker": "Tadhla",
                                                    "text": "..."
                                                },
                                                {
                                                    "id": "732822812",
                                                    "speaker": "Tadhla",
                                                    "text": "... Não, não pensei, nunca esperei por isso."
                                                },
                                                {
                                                    "id": "732822813",
                                                    "speaker": "Tadhla",
                                                    "text": "O deserto é muito cruel. Não há tempo para pensar em mim mesma. Sem mim, minha tribo vive igual. Entretanto, sem minha tribo, não há como eu sobreviver."
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "732822805",
                            "text": "Sobre a sua relação com Masseira...",
                            "response": [
                                {
                                    "id": "732822806",
                                    "speaker": "Tadhla",
                                    "text": "Eu disse, ele é o meu pai. Eu sou seu Falcão. Eu caço seguindo suas ordens, eu morreria por ele... Porque para mim, ele representa a vontade dos Tanit."
                                },
                                {
                                    "id": "732822807",
                                    "speaker": "Tadhla",
                                    "text": "Se em algum momento não pudesse acatar as ordens de meu pai, minha vida como Falcão terminaria.",
                                    "choices": [
                                        {
                                            "id": "732822808",
                                            "text": "Tão extremo assim?"
                                        },
                                        {
                                            "id": "732822810",
                                            "text": "Você não pensou em viver para si mesma?"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7328229",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "732822901",
                    "speaker": "Masseira",
                    "text": "#Ah, você veio. Estimad{F#a}{M#o} Mestre das Jinni, do que precisa?",
                    "choices": [
                        {
                            "id": "732822902",
                            "text": "Sobre Tadhla...",
                            "response": [
                                {
                                    "id": "732822903",
                                    "speaker": "Masseira",
                                    "text": "Ela gosta muito de você. Consigo ver isso."
                                },
                                {
                                    "id": "732822904",
                                    "speaker": "Masseira",
                                    "text": "Não se preocupe, eu vou deixar ela em paz. Ah, ser jovem... Não é mesmo?"
                                },
                                {
                                    "id": "732822905",
                                    "speaker": "Masseira",
                                    "text": "Vou encorajar ela a expressar seus sentimentos. Como alguém mais velho e como pai dela, com certeza farei isso. Então, por favor, não se preocupe com ela."
                                }
                            ]
                        },
                        {
                            "id": "732822906",
                            "text": "Sobre o Ritual de Maioridade...",
                            "response": [
                                {
                                    "id": "732822907",
                                    "speaker": "Masseira",
                                    "text": "Obrigado por ajudar ela a completar seu Ritual de Maioridade. Eu estava certo em confiar em você."
                                },
                                {
                                    "id": "732822908",
                                    "speaker": "Masseira",
                                    "text": "A seguir, ela vai aceitar sua primeira missão de caça como um Falcão qualificado."
                                },
                                {
                                    "id": "732822909",
                                    "speaker": "Masseira",
                                    "text": "Até lá... Hehe, por favor, testemunhe o crescimento dela pessoalmente."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7328299",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "732829901",
                    "speaker": "Paimon",
                    "text": "Tadhla? Tadhla! Ah, ela—"
                },
                {
                    "id": "732829902",
                    "speaker": "Liloupar",
                    "text": "Essa é a vontade dela: não mais viver como um Falcão, e sim como uma amiga."
                }
            ]
        }
    ]
}