    "talks": [
        {
            "id": "7668001",
            "objective": "Fale com Raio Azul",
            "dialogues": [
                {
                    "id": "766800101",
                    "speaker": "Raio Azul",
                    "text": "#Oh, olá {NICKNAME} e Paimon!"
                },
                {
                    "id": "766800102",
                    "speaker": "Raio Azul",
                    "text": "Já que nos encontramos, quer ver meu furão, Cebola? Ele tá aqui comigo, e é super simpático!"
                },
                {
                    "id": "766800103",
                    "speaker": "Cebola",
                    "text": "... Miau?"
                },
                {
                    "id": "766800104",
                    "speaker": "Raio Azul",
                    "text": "#Ei, você não deve soar assim, Cebola! Eu não acho que {F#elas}{M#eles} entendem a língua de Lorde Ashru."
                },
                {
                    "id": "766800105",
                    "speaker": "Cebola",
                    "text": "... Piu?"
                },
                {
                    "id": "766800106",
                    "speaker": "Raio Azul",
                    "text": "Não, falar como um passarinho também não serve. A Srta. Basima já deve ter retornado para Sumeru para se recuperar."
                },
                {
                    "id": "766800107",
                    "speaker": "Raio Azul",
                    "text": "Desculpem, Cebola está um pouco confuso depois de passar um tempo com tantos outros animais. Parece ter perdido sua frequência, hehe..."
                },
                {
                    "id": "766800108",
                    "speaker": "Raio Azul",
                    "text": "Vou deixá-lo descansar por um tempo...",
                    "choices": [
                        {
                            "id": "766800109",
                            "text": "Você é uma especialista em animais também?",
                            "response": [
                                {
                                    "id": "766800111",
                                    "speaker": "Paimon",
                                    "text": "#Hmm... Por que Paimon tá com a sensação que você tá falando com a gente como se fôssemos velh{M#o}{F#a}s amig{M#o}{F#a}s? Você por acaso investigou a gente?"
                                },
                                {
                                    "id": "766800112",
                                    "speaker": "Raio Azul",
                                    "text": "Relaxe, relaxe... eu estou com vocês..."
                                },
                                {
                                    "id": "766800113",
                                    "speaker": "Raio Azul",
                                    "text": "#Eu trabalho para a Srta. Yelan, e eu entendo que vocês são convidad{F#as}{M#os} importantes dela. Não preciso explicar como estou do seu lado, preciso?",
                                    "choices": [
                                        {
                                            "id": "766800114",
                                            "text": "Sim, isso faz de você uma de nós.",
                                            "response": [
                                                {
                                                    "id": "766800116",
                                                    "speaker": "Paimon",
                                                    "text": "Tsc, você devia ter dito isso de cara! Você nem imagina quão ansiosa Paimon ficou..."
                                                },
                                                {
                                                    "id": "766800117",
                                                    "speaker": "Paimon",
                                                    "text": "Enfim, o que vocês estão fazendo aqui no meio do nada com Cebola?"
                                                },
                                                {
                                                    "id": "766800118",
                                                    "speaker": "Raio Azul",
                                                    "text": "Estamos de guarda... ou melhor, checando se a Unidade de Guarda do Portão sabe trabalhar.",
                                                    "choices": [
                                                        {
                                                            "id": "766800119",
                                                            "text": "Vigiar o portão?",
                                                            "response": [
                                                                {
                                                                    "id": "766800121",
                                                                    "speaker": "Raio Azul",
                                                                    "text": "#Bem, como somos {M#bons}{F#boas} amig{M#o}{F#a}s, acho que não faz mal contar..."
                                                                },
                                                                {
                                                                    "id": "766800122",
                                                                    "speaker": "Raio Azul",
                                                                    "text": "Eu tenho um local de suprimentos escondido aqui por perto. Entretanto, ele costuma ser roubado por vários tipos de monstros."
                                                                },
                                                                {
                                                                    "id": "766800123",
                                                                    "speaker": "Raio Azul",
                                                                    "text": "Por isso, eu fiz várias mudanças, e pedi que a criança lá da Oficina de Rolinho de Ovo Trilimlim fizesse minha unidade de guarda."
                                                                },
                                                                {
                                                                    "id": "766800124",
                                                                    "speaker": "Raio Azul",
                                                                    "text": "Ahem, para ser mais precisa, tá mais pra um sistema de segurança. Um que seja capaz de identificar locais de despacho, com múltiplas funções que possam ser combinadas de várias formas."
                                                                },
                                                                {
                                                                    "id": "766800125",
                                                                    "speaker": "Raio Azul",
                                                                    "text": "Essa criança tava pra ir pra uma conferência com suas criações, por isso eu tive sorte em conseguir essa unidade a tempo. Acho que posso ver isso como um protótipo."
                                                                },
                                                                {
                                                                    "id": "766800126",
                                                                    "speaker": "Raio Azul",
                                                                    "text": "Fiz uma série de defesas para o ponto de suprimentos, e agora qualquer um... quero dizer, qualquer monstro, vai cair na armadilha."
                                                                },
                                                                {
                                                                    "id": "766800127",
                                                                    "speaker": "Raio Azul",
                                                                    "text": "Assim, não só podemos testar a eficácia das várias modalidades de defesa para o ponto de suprimentos, mas também podemos obter muitos dados para referências futuras daquela criança.",
                                                                    "choices": [
                                                                        {
                                                                            "id": "766800128",
                                                                            "text": "Então você conseguiu uma criação da Aino.",
                                                                            "response": [
                                                                                {
                                                                                    "id": "766800130",
                                                                                    "speaker": "Raio Azul",
                                                                                    "text": "Quer tentar? Eu já usei para repelir vários monstros. É terapêutico."
                                                                                },
                                                                                {
                                                                                    "id": "766800131",
                                                                                    "speaker": "Raio Azul",
                                                                                    "text": "Venha, experimente. Você pode espairecer, e eu posso aprender algo também com o jeito que você o manuseará."
                                                                                },
                                                                                {
                                                                                    "id": "766800132",
                                                                                    "speaker": "Raio Azul",
                                                                                    "text": "#Claro, você será bem remunerad{F#a}{M#o}. Como somos {M#bons amigos}{F#boas amigas} aqui, você receberá o dobro que a taxa comum de consulta.",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "766800133",
                                                                                            "text": "Claro. Você deveria pagar o dobro para nós, já que nos damos tão bem!",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "766800135",
                                                                                                    "speaker": "Paimon",
                                                                                                    "text": "Para Paimon sim! Especialmente como você ajudou Yelan, e por isso, todos nós nos beneficiamos..."
                                                                                                },
                                                                                                {
                                                                                                    "id": "766800136",
                                                                                                    "speaker": "Paimon",
                                                                                                    "text": "Certo, então vou mostrar a vocês como é essa experiência na prática!"
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "766800134",
                                                                                            "text": "Hehe, não precisava..."
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "766800129",
                                                                            "text": "Isso é bem interessante."
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "766800120",
                                                            "text": "Unidade de Guarda?"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "766800115",
                                            "text": "Qualquer amiga de Yelan é amiga nossa também."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "766800110",
                            "text": "Você é amiga dos animais?"
                        }
                    ]
                }
            ]
        }
    ]
}