    "talks": [
        {
            "id": "1909501",
            "objective": "Vá até o Quartel-General dos Cavaleiros de Favonius.",
            "dialogues": []
        },
        {
            "id": "1909502",
            "objective": "Entre no escritório da Grande Mestre Intendente",
            "dialogues": [
                {
                    "id": "190950201",
                    "speaker": "Albedo",
                    "text": "..."
                },
                {
                    "id": "190950202",
                    "speaker": "Kaeya",
                    "text": "..."
                },
                {
                    "id": "190950203",
                    "speaker": "Albedo",
                    "text": "Bem-vindos de volta, pessoal... Klee sempre acha que Kaeya também está sendo mantido em confinamento. Agora posso explicar a questão a ela."
                },
                {
                    "id": "190950204",
                    "speaker": "Kaeya",
                    "text": "Qual é a questão, exatamente?"
                },
                {
                    "id": "190950205",
                    "speaker": "Albedo",
                    "text": "...Explosão de caldeirão."
                },
                {
                    "id": "190950206",
                    "speaker": "Kaeya",
                    "text": "Só um?"
                },
                {
                    "id": "190950207",
                    "speaker": "Albedo",
                    "text": "Não, todos eles, na verdade, e levaram o Balcão de Síntese junto. Havia... muita fumaça?"
                },
                {
                    "id": "190950208",
                    "speaker": "Kaeya",
                    "text": "Ah. É por isso que Jean estava te procurando.",
                    "choices": [
                        {
                            "id": "190950299",
                            "text": "Parece que vocês têm experiência.",
                            "response": [
                                {
                                    "id": "190950209",
                                    "speaker": "Kaeya",
                                    "text": "Bem, espero que você tenha uma resposta com mais prática da próxima vez."
                                },
                                {
                                    "id": "190950210",
                                    "speaker": "Kaeya",
                                    "text": "Se algo assim acontecer novamente, chame a mim e Albedo. Será mais fácil se formos nos desculpar com Jean e os afetados juntos, certo?"
                                },
                                {
                                    "id": "190950212",
                                    "speaker": "Albedo",
                                    "text": "Acho que você pode adivinhar o resto. Perdão por arrastá-lo para isso assim que você voltou."
                                },
                                {
                                    "id": "190950213",
                                    "speaker": "Kaeya",
                                    "text": "Não há de quê."
                                },
                                {
                                    "id": "190950297",
                                    "speaker": "Player",
                                    "text": "Não se preocupe com a gente, Albedo."
                                },
                                {
                                    "id": "190950214",
                                    "speaker": "Albedo",
                                    "text": "Receio que o tempo esteja curto, então os presentes terão que esperar até mais tarde. Pedirei para Klee te procurar quando ela sair."
                                },
                                {
                                    "id": "190950215",
                                    "speaker": "Kaeya",
                                    "text": "Tudo bem, claro. Só foque em limpar a oficina. Conversamos depois."
                                },
                                {
                                    "id": "190950216",
                                    "speaker": "Kaeya",
                                    "text": "Bem, Albedo se foi. Acho que é nossa hora de partir também."
                                }
                            ]
                        },
                        {
                            "id": "190950298",
                            "text": "Um pouco grande demais.",
                            "response": [
                                {
                                    "id": "190950211",
                                    "speaker": "Albedo",
                                    "text": "Todo mundo em Mondstadt viu a fumaça saindo da oficina naquele dia."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
