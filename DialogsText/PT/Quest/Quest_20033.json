    "talks": [
        {
            "id": "2003301",
            "objective": "Fale com Anna",
            "dialogues": [
                {
                    "id": "200330101",
                    "speaker": "Anna",
                    "text": "Viajante! Veja só! Que tal minha roupa? Ficou bom?"
                },
                {
                    "id": "200330102",
                    "speaker": "Player",
                    "text": "Essa roupa... não me diga que...!"
                },
                {
                    "id": "200330103",
                    "speaker": "Anna",
                    "text": "Sim! Passei no exame da Guilda de Aventureiros, já sou oficialmente uma aventureira!",
                    "choices": [
                        {
                            "id": "200330104",
                            "text": "Impressionante!",
                            "response": [
                                {
                                    "id": "200330106",
                                    "speaker": "Anna",
                                    "text": "Hehe obrigada. Eu queria que meu irmão tentasse também, mas ele se recusou firmemente..."
                                },
                                {
                                    "id": "200330107",
                                    "speaker": "Anthony",
                                    "text": "Já lhe disse que não estou interessado em aventuras... Além do mais, quem vai cuidar da mamãe e do papai se nós dois somos aventureiros?"
                                },
                                {
                                    "id": "200330108",
                                    "speaker": "Anna",
                                    "text": "Então, poderíamos levá-los conosco e viajar pelo mundo juntos!"
                                },
                                {
                                    "id": "200330109",
                                    "speaker": "Anthony",
                                    "text": "*Suspira* Ok... Agora que você se tornou uma aventureira, faça o que tem que fazer. Eu vou ficar cuidando da família."
                                },
                                {
                                    "id": "200330110",
                                    "speaker": "Anthony",
                                    "text": "Mas tenha cuidado! Não se machuque e não se canse demais..."
                                },
                                {
                                    "id": "200330111",
                                    "speaker": "Anna",
                                    "text": "Eu sei, eu sei! Tenho de ir, tenho uma missão por cumprir!"
                                },
                                {
                                    "id": "200330112",
                                    "speaker": "Anna",
                                    "text": "Viajante, você quer me acompanhar? Ainda tenho muitas perguntas que gostaria de lhe fazer.",
                                    "choices": [
                                        {
                                            "id": "200330113",
                                            "text": "Sem problemas.",
                                            "response": [
                                                {
                                                    "id": "200330115",
                                                    "speaker": "Anna",
                                                    "text": "Muito bem, vejamos... a missão de hoje é..."
                                                },
                                                {
                                                    "id": "200330116",
                                                    "speaker": "Anna",
                                                    "text": "Escoltar um Balão de Transporte!"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "200330114",
                                            "text": "Vamos!"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "200330105",
                            "text": "Parabéns!"
                        }
                    ]
                }
            ]
        },
        {
            "id": "2003302",
            "objective": "Complete a comissão da Guilda de Aventureiros com Anna",
            "dialogues": [
                {
                    "id": "200330201",
                    "speaker": "Anna",
                    "text": "Prontinho! Obrigada, Viajante! Terminamos nossa missão."
                },
                {
                    "id": "200330202",
                    "speaker": "Anna",
                    "text": "Mas... todas as missões são assim?",
                    "choices": [
                        {
                            "id": "200330203",
                            "text": "Existem outros tipos de missões.",
                            "response": [
                                {
                                    "id": "200330204",
                                    "speaker": "Paimon",
                                    "text": "Você não parece muito convincente..."
                                },
                                {
                                    "id": "200330207",
                                    "speaker": "Anna",
                                    "text": "Entendo... Está bom! Vou continuar tentando!"
                                },
                                {
                                    "id": "200330208",
                                    "speaker": "Anna",
                                    "text": "Quando eu tiver dinheiro suficiente, vou levar meu irmão e meus pais para uma viagem!"
                                },
                                {
                                    "id": "200330209",
                                    "speaker": "Anna",
                                    "text": "Meu irmão sempre quis viajar, mas... como eu fiquei doente, ele teve que ficar para cuidar de mim."
                                },
                                {
                                    "id": "200330210",
                                    "speaker": "Anna",
                                    "text": "Agora já me sinto melhor e até me tornei uma aventureira!"
                                },
                                {
                                    "id": "200330211",
                                    "speaker": "Anna",
                                    "text": "Hehe, é hora de realizar os sonhos do meu irmão."
                                }
                            ]
                        },
                        {
                            "id": "200330205",
                            "text": "Aos poucos você vai perceber...",
                            "response": [
                                {
                                    "id": "200330206",
                                    "speaker": "Anna",
                                    "text": "Ei, não diga isso com essa cara de cansaço..."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2003303",
            "objective": "Complete a comissão da Guilda de Aventureiros com Anna",
            "dialogues": [
                {
                    "id": "200330301",
                    "speaker": "Anthony",
                    "text": "Viajante, por favor, cuide a Anna. Ela está eufórica..."
                },
                {
                    "id": "200330302",
                    "speaker": "Player",
                    "text": "Você não quer que ela seja uma aventureira?"
                },
                {
                    "id": "200330303",
                    "speaker": "Anthony",
                    "text": "..."
                },
                {
                    "id": "200330304",
                    "speaker": "Anthony",
                    "text": "Eu respeito o sonho da minha irmã."
                },
                {
                    "id": "200330305",
                    "speaker": "Anthony",
                    "text": "Ela conseguiu se recuperar de sua doença, e agora tem finalmente a oportunidade de perseguir seus sonhos."
                },
                {
                    "id": "200330306",
                    "speaker": "Anthony",
                    "text": "Como seu irmão, eu... Vou apoiá-la incondicionalmente."
                },
                {
                    "id": "200330307",
                    "speaker": "Anthony",
                    "text": "É isso."
                }
            ]
        },
