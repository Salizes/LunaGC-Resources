        },
        {
            "id": "7180003",
            "objective": "",
            "dialogues": [
                {
                    "id": "718000301",
                    "speaker": "Madame Ping",
                    "text": "",
                    "choices": [
                        {
                            "id": "718000302",
                            "text": "Minhas roupas estão todas encharcadas...",
                            "response": [
                                {
                                    "id": "718000303",
                                    "speaker": "Madame Ping",
                                    "text": "Mil perdões, minha criança, que descuido de minha parte. Eu achava que tinha apenas um pouco de água aqui dentro."
                                },
                                {
                                    "id": "718000304",
                                    "speaker": "Madame Ping",
                                    "text": "Pelo menos essa chaleira está mais ou menos limpa agora. Ainda tem alguns cantinhos aqui e ali para cuidar, mas está muito melhor."
                                },
                                {
                                    "id": "718000307",
                                    "speaker": "Paimon",
                                    "text": "Vovó, você colocou todo o Rio Bishui aqui dentro ou o que!?"
                                },
                                {
                                    "id": "718000308",
                                    "speaker": "Madame Ping",
                                    "text": "Criança tola, eu não sonharia em fazer tal coisa - de onde as pobres pessoas da cidade tirariam água se eu fizesse isso? Não, eu tive o cuidado de usar apenas metade da água do rio."
                                },
                                {
                                    "id": "718000309",
                                    "speaker": "Madame Ping",
                                    "text": "Desculpe-me causar um pequeno incômodo a você numa ocasião como esta. Por favor, aceite isto como agradecimento por sua ajuda."
                                },
                                {
                                    "id": "718000310",
                                    "speaker": "Madame Ping",
                                    "text": "Oh, eu não posso esquecer de devolver a água da chaleira de volta ao rio alguma hora..."
                                }
                            ]
                        },
                        {
                            "id": "718000305",
                            "text": "A esta altura já deve estar bom o suficiente.",
                            "response": [
                                {
                                    "id": "718000306",
                                    "speaker": "Madame Ping",
                                    "text": "Bem, na maior parte pelo menos, ainda tem alguns cantinhos aqui e ali para cuidar, mas aquele ali alguém teria que entrar e limpar."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7180007",
            "objective": "",
            "dialogues": [
                {
                    "id": "718000701",
                    "speaker": "Madame Ping",
                    "text": "*Suspiro* Minha pobre chaleira..."
                }
            ]
        },
        {
