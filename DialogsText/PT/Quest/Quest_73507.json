    "talks": [
        {
            "id": "7350701",
            "objective": "Fale com as duas pessoas ao lado da barraca",
            "dialogues": [
                {
                    "id": "735070101",
                    "speaker": "Haniyyah",
                    "text": "#Cometa Dourado {NICKNAME} e Parceira de Prata... Nos encontramos novamente."
                },
                {
                    "id": "735070102",
                    "speaker": "Haniyyah",
                    "text": "#Animad{M#os}{F#as} como sempre, como posso ver!",
                    "choices": [
                        {
                            "id": "735070103",
                            "text": "Você parece bastante animada também.",
                            "response": [
                                {
                                    "id": "735070104",
                                    "speaker": "Paimon",
                                    "text": "H-Haniyyah! E você também, Balfour?"
                                },
                                {
                                    "id": "735070105",
                                    "speaker": "Paimon",
                                    "text": "Que prazer encontrar vocês aqui!"
                                },
                                {
                                    "id": "735070114",
                                    "speaker": "Paimon",
                                    "text": "Bem, de volta ao ponto. O que vocês estão fazendo por aqui? Se Paimon ainda se lembra bem, era aqui que podíamos pegar aquelas Geleias Florais..."
                                },
                                {
                                    "id": "735070115",
                                    "speaker": "Balfour",
                                    "text": "#Ah, {M#nossos dois grandes heróis}{F#nossas duas grandes heroínas}! Apenas suas vozes já me enchem de confiança."
                                },
                                {
                                    "id": "735070116",
                                    "speaker": "Balfour",
                                    "text": "Por enquanto, eu continuarei fazendo meu relatório sobre os resultados de nosso trabalho."
                                },
                                {
                                    "id": "735070117",
                                    "speaker": "Balfour",
                                    "text": "Anteriormente, vocês declararam que a Copa Nilotpala de Domadores de Feras deveria ser suspensa por um tempo enquanto a Academia melhorava o projeto do Orbe da Sabedoria."
                                },
                                {
                                    "id": "735070118",
                                    "speaker": "Balfour",
                                    "text": "Eu acredito que vocês ainda estão aguardando notícias relacionadas a isso, certo?"
                                },
                                {
                                    "id": "735070119",
                                    "speaker": "Paimon",
                                    "text": "Sim, isso mesmo! Layla, Cyno ou os pesquisadores responsáveis deveriam nos informar se houvesse qualquer progresso, não é?",
                                    "choices": [
                                        {
                                            "id": "735070120",
                                            "text": "Não que você fosse entender o jargão técnico deles.",
                                            "response": [
                                                {
                                                    "id": "735070122",
                                                    "speaker": "Paimon",
                                                    "text": "Bem, é mais ou menos isso mesmo. Nós não seríamos de muita ajuda. Provavelmente acabaríamos atrapalhando, para falar a verdade..."
                                                },
                                                {
                                                    "id": "735070123",
                                                    "speaker": "Balfour",
                                                    "text": "Ah, que meticuloso, que tolerante de sua parte. Eu, por exemplo, praticamente explodo de animação quando penso nos grandes momentos do torneio anterior..."
                                                },
                                                {
                                                    "id": "735070124",
                                                    "speaker": "Balfour",
                                                    "text": "Assim, eu tentei perguntar a alguns membros relacionados dos funcionários da Academia recentemente para conseguir alguns detalhes..."
                                                },
                                                {
                                                    "id": "735070125",
                                                    "speaker": "Balfour",
                                                    "text": "No momento, melhorias ao Orbe da Sabedoria ainda estão sendo implementadas através de seus campos teóricos. Assim, qualquer produção prática ainda levará algum tempo."
                                                },
                                                {
                                                    "id": "735070126",
                                                    "speaker": "Balfour",
                                                    "text": "Contudo, o debate ao redor da primeira iteração do torneio está diminuindo a cada dia, e está sendo esquecido, mesmo que lentamente. Nós não podemos permitir que a influência do evento anterior seja desperdiçada."
                                                },
                                                {
                                                    "id": "735070127",
                                                    "speaker": "Balfour",
                                                    "text": "Assim, eu me uni a Srta. Haniyyah para organizar um \"evento temático\"."
                                                },
                                                {
                                                    "id": "735070128",
                                                    "speaker": "Player",
                                                    "text": "O que \"evento temático\" quer dizer, exatamente?"
                                                },
                                                {
                                                    "id": "735070129",
                                                    "speaker": "Paimon",
                                                    "text": "Então é para isso que essas peças de jogo com formato de cogumelo na mesa servem?"
                                                },
                                                {
                                                    "id": "735070130",
                                                    "speaker": "Haniyyah",
                                                    "text": "Isso mesmo."
                                                },
                                                {
                                                    "id": "735070131",
                                                    "speaker": "Haniyyah",
                                                    "text": "O Sr. Balfour tem procurado por patrocinadores como parte da organização do próximo evento e ele até procurou aprender algumas técnicas publicitárias de Liyue."
                                                },
                                                {
                                                    "id": "735070132",
                                                    "speaker": "Haniyyah",
                                                    "text": "Enquanto fazia isso, ele encontrou um certo tipo de jogo conhecido como Teatro Mechanicus."
                                                },
                                                {
                                                    "id": "735070133",
                                                    "speaker": "Haniyyah",
                                                    "text": "Em seguida, ele comprou os direitos de franquia de Sumeru para aquele jogo e preparou um jogo completamente novo comigo como consultora."
                                                },
                                                {
                                                    "id": "735070134",
                                                    "speaker": "Haniyyah",
                                                    "text": "Nós o chamamos de \"Fungo Mechanicus\"."
                                                },
                                                {
                                                    "id": "735070135",
                                                    "speaker": "Paimon",
                                                    "text": "Fungo Mechanicus, hein?"
                                                },
                                                {
                                                    "id": "735070136",
                                                    "speaker": "Paimon",
                                                    "text": "Deixe Paimon adivinhar... Então nós vamos comandar vários cogumelos para batalhar com algumas máquinas?"
                                                },
                                                {
                                                    "id": "735070137",
                                                    "speaker": "Balfour",
                                                    "text": "Haha! Você é de fato esperta, Parceira de Prata. Entendeu rapidinho!"
                                                },
                                                {
                                                    "id": "735070138",
                                                    "speaker": "Balfour",
                                                    "text": "Eu acredito que este jogo é fácil de entender e promover, além de possuir um grande potencial que vale a pena ser explorado."
                                                },
                                                {
                                                    "id": "735070139",
                                                    "speaker": "Balfour",
                                                    "text": "Se pudermos comercializá-lo com sucesso como um derivado do Torneio de Domadores de Feras, nós podemos fazer o torneio continuar fresco na mente das pessoas a longo-prazo."
                                                },
                                                {
                                                    "id": "735070140",
                                                    "speaker": "Balfour",
                                                    "text": "Dessa forma, o próximo torneio que realizarmos atrairá um público ainda maior e ainda mais competidores."
                                                },
                                                {
                                                    "id": "735070141",
                                                    "speaker": "Balfour",
                                                    "text": "Claro, isso só pode seguir com sua permissão. Afinal, você tem a última palavra sobre como o torneio será organizado.",
                                                    "choices": [
                                                        {
                                                            "id": "735070142",
                                                            "text": "Eu acho que vale a tentativa.",
                                                            "response": [
                                                                {
                                                                    "id": "735070144",
                                                                    "speaker": "Paimon",
                                                                    "text": "#Hmm, bem, nem {NICKNAME}, nem Paimon sabe muito sobre negócios, mas Paimon acha que você tem um bom ponto, Balfour!"
                                                                },
                                                                {
                                                                    "id": "735070145",
                                                                    "speaker": "Paimon",
                                                                    "text": "Você e Haniyyah têm trabalhado nisso juntos e Paimon acredita em vocês, então podem seguir!"
                                                                },
                                                                {
                                                                    "id": "735070146",
                                                                    "speaker": "Paimon",
                                                                    "text": "Nós não jogamos o jogo ainda, mas Paimon pode apostar que um monte de gente vai amar!"
                                                                },
                                                                {
                                                                    "id": "735070147",
                                                                    "speaker": "Balfour",
                                                                    "text": "Maravilha! Já que vocês concordam, eu posso prosseguir e promover o Fungo Mechanicus."
                                                                },
                                                                {
                                                                    "id": "735070148",
                                                                    "speaker": "Balfour",
                                                                    "text": "O jogo está em fase de testes no momento, então ainda precisamos convidar pessoas para testar e coletar o relatório deles para podermos fazer mais melhorias."
                                                                },
                                                                {
                                                                    "id": "735070149",
                                                                    "speaker": "Balfour",
                                                                    "text": "E eu tenho certeza que você, quem certamente encontrou todos os tipos de jogos populares por todo Teyvat, terá as melhores sugestões de todos!"
                                                                },
                                                                {
                                                                    "id": "735070150",
                                                                    "speaker": "Paimon",
                                                                    "text": "#Hehe, vamos nessa, {NICKNAME}! Esse é um dos seus pontos fortes, afinal!",
                                                                    "choices": [
                                                                        {
                                                                            "id": "735070151",
                                                                            "text": "Por que eu tenho a sensação que você está me comandando a...",
                                                                            "response": [
                                                                                {
                                                                                    "id": "735070153",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "Dito isso, Paimon tem uma pergunta para você, Haniyyah..."
                                                                                },
                                                                                {
                                                                                    "id": "735070154",
                                                                                    "speaker": "Haniyyah",
                                                                                    "text": "Você quer saber de Cabeça de Bongô e dos outros?"
                                                                                },
                                                                                {
                                                                                    "id": "735070155",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "Isso mesmo! Paimon sente falta de nossos cogumigos. Como eles estão indo?"
                                                                                },
                                                                                {
                                                                                    "id": "735070156",
                                                                                    "speaker": "Haniyyah",
                                                                                    "text": "Não se preocupe, eles estão muito bem... vivendo uma vida muito tranquila!"
                                                                                },
                                                                                {
                                                                                    "id": "735070157",
                                                                                    "speaker": "Haniyyah",
                                                                                    "text": "Ioiozinho e Blitzor estão atualmente ficando na minha <color=#00E1FFFF>residência temporária no norte de Porto Ormos</color>. Um dos competidores anteriores está cuidando deles."
                                                                                },
                                                                                {
                                                                                    "id": "735070158",
                                                                                    "speaker": "Haniyyah",
                                                                                    "text": "Cabeça de Bongô e Pyroalegria estão por perto. Se quiser, Parceira de Prata, você pode ir brincar com eles."
                                                                                },
                                                                                {
                                                                                    "id": "735070159",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "#Por perto, né? Muito bem, {NICKNAME}, Paimon vai procurar por Cabeça de Bongô enquanto você testa o jogo mais tarde, certo?",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "735070160",
                                                                                            "text": "Pode ir!",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "735070162",
                                                                                                    "speaker": "Balfour",
                                                                                                    "text": "Muito bem, não vamos perder mais tempo. Venha, Cometa Dourado, a versão inicial de testes do Fungo Mechanicus está pronta para você!"
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "735070161",
                                                                                            "text": "Eu me juntarei a você em breve."
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "735070152",
                                                                            "text": "#Isso aí! Cometa Dourado, {M#pronto}{F#pronta} para a batalha!"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "735070143",
                                                            "text": "Você se esforçou mesmo, não é?"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "735070121",
                                            "text": "Não que eu fosse ter muitas sugestões para eles."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "735070106",
                            "text": "Quem são vocês mesmo?",
                            "response": [
                                {
                                    "id": "735070107",
                                    "speaker": "Paimon",
                                    "text": "#Ah, qual é, {NICKNAME}, do que você está falando?"
                                },
                                {
                                    "id": "735070108",
                                    "speaker": "Paimon",
                                    "text": "Nós participamos da Copa Nilotpala de Domadores de Feras, não participamos? Foi ótimo curtir com nossos cogumigos!"
                                },
                                {
                                    "id": "735070109",
                                    "speaker": "Paimon",
                                    "text": "Nós conhecemos Haniyyah lá, e Balfour era o membro da equipe de produção mais responsável do evento anterior."
                                },
                                {
                                    "id": "735070110",
                                    "speaker": "Paimon",
                                    "text": "Espera, você esqueceu de Cabeça de Bongô e Ioiozinho também?",
                                    "choices": [
                                        {
                                            "id": "735070111",
                                            "text": "Ah, eu me lembro agora!",
                                            "response": [
                                                {
                                                    "id": "735070113",
                                                    "speaker": "Paimon",
                                                    "text": "O quê? Qual é! Paimon estava quase indo atrás de um médico!"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "735070112",
                                            "text": "Hehe, eu estava brincando com você."
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7350706",
            "objective": "",
            "dialogues": [
                {
                    "id": "735070501",
                    "speaker": "Paimon",
                    "text": "Vamos lá, Cabeça de Bongô, vamos brincar de bater palmas!"
                },
                {
                    "id": "735070502",
                    "speaker": "Paimon",
                    "text": "Vamos lá, Pyroalegria, vamos dançar com Cabeça de Bongô!"
                },
                {
                    "id": "735070503",
                    "speaker": "Paimon",
                    "text": "Hmm... Nós nos tornamos bem familiares com Pyroalegria, mas ainda não podemos nos comunicar tão bem quanto fazemos com Cabeça de Bongô...",
                    "choices": [
                        {
                            "id": "735070504",
                            "text": "Você é um poço de alegria, hein Paimon?",
                            "response": [
                                {
                                    "id": "735070506",
                                    "speaker": "Paimon",
                                    "text": "#{NICKNAME}, você está aqui!"
                                },
                                {
                                    "id": "735070507",
                                    "speaker": "Paimon",
                                    "text": "Como vão as coisas com os testes do Fungo Mechanicus?",
                                    "choices": [
                                        {
                                            "id": "735070508",
                                            "text": "O período de testes ainda vai durar por algum tempo.",
                                            "response": [
                                                {
                                                    "id": "735070510",
                                                    "speaker": "Paimon",
                                                    "text": "Ooh, então Haniyyah e nossos cogumigos estarão aqui por um tempo, hein? Isso é ótimo!"
                                                },
                                                {
                                                    "id": "735070511",
                                                    "speaker": "Paimon",
                                                    "text": "Paimon estava planejando pedir a você para ficar aqui mais um dia para a gente poder passar mais tempo com os Cogumelos."
                                                },
                                                {
                                                    "id": "735070512",
                                                    "speaker": "Paimon",
                                                    "text": "Mas parece que nós poderemos matar dois unagis com uma espadada só... testando Fungo Mechanicus e brincando com nossos cogumigos ao mesmo tempo!"
                                                },
                                                {
                                                    "id": "735070513",
                                                    "speaker": "Black Screen",
                                                    "text": "Você passa um tempo de qualidade e relaxa com Paimon, Cabeça de Bongô e Pyroalegria, e dá as Geleias Maravilhosas a eles.\\nPaimon e seus cogumigos se divertem bastante."
                                                },
                                                {
                                                    "id": "735070514",
                                                    "speaker": "Paimon",
                                                    "text": "Hehe, foi ótimo! Está tão quentinho e bom — como se as preocupações de Paimon tivessem desaparecido!"
                                                },
                                                {
                                                    "id": "735070515",
                                                    "speaker": "Paimon",
                                                    "text": "Bem, Cabeça de Bongô, Pyroalegria... Vejo vocês amanhã!"
                                                },
                                                {
                                                    "id": "735070516",
                                                    "speaker": "Cabeça de Bongô",
                                                    "text": "♪~"
                                                },
                                                {
                                                    "id": "735070517",
                                                    "speaker": "Pyro-1",
                                                    "text": "?"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "735070509",
                                            "text": "Podemos brincar com eles todos os dias."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "735070505",
                            "text": "Eu também estou adorando isso."
                        }
                    ]
                }
            ]
        },
        {
            "id": "7350702",
            "objective": "Procure por Balfour para experimentar o Fungo Mechanicus",
            "dialogues": []
        },
        {
            "id": "7350704",
            "objective": "Experimente o Fungo Mechanicus",
            "dialogues": [
                {
                    "id": "735070401",
                    "speaker": "Balfour",
                    "text": "Bem, não vamos perder mais tempo. Venha, Cometa Dourado, a versão de teste interna de Fungo Mechanicus está pronta para você!"
                }
            ]
        },
        {
            "id": "7350703",
            "objective": "Fale com Haniyyah e Balfour",
            "dialogues": [
                {
                    "id": "735070301",
                    "speaker": "Balfour",
                    "text": "Como foi, Cometa Dourado? Como foi o seu primeiro gostinho da jogabilidade do Fungo Mechanicus?"
                },
                {
                    "id": "735070302",
                    "speaker": "Haniyyah",
                    "text": "Julgando pela sua expressão, eu acho que você ainda não chegou a uma conclusão.",
                    "choices": [
                        {
                            "id": "735070303",
                            "text": "Eu só joguei uma rodada, afinal de contas.",
                            "response": [
                                {
                                    "id": "735070305",
                                    "speaker": "Balfour",
                                    "text": "Isso é verdade. Com esse pequeno conteúdo de teste, é de fato difícil julgar as forças e defeitos do Fungo Mechanicus."
                                },
                                {
                                    "id": "735070306",
                                    "speaker": "Balfour",
                                    "text": "Não se preocupe. Srta. Haniyyah e eu estaremos aqui por um tempo e teremos uma nova fase Mechanicus para você todo dia, sete no total."
                                },
                                {
                                    "id": "735070307",
                                    "speaker": "Balfour",
                                    "text": "Venha aqui sempre que tiver tempo, e você terá oportunidade de testar essas fases!"
                                },
                                {
                                    "id": "735070308",
                                    "speaker": "Balfour",
                                    "text": "#Apesar de você ser {F#a}{M#o} supervis{F#ora}{M#or} geral destas questões, este jogo foi algo que a Srta. Haniyyah e eu elaboramos sozinhos, então essa dedicação de tempo está fora de seus planos."
                                },
                                {
                                    "id": "735070309",
                                    "speaker": "Balfour",
                                    "text": "Assim, uma taxa será fornecida a você pelos serviços prestados!",
                                    "choices": [
                                        {
                                            "id": "735070310",
                                            "text": "Haha, bem, eu não vou recusar isso.",
                                            "response": [
                                                {
                                                    "id": "735070312",
                                                    "speaker": "Balfour",
                                                    "text": "Haha, direto ao ponto! Eu gosto!"
                                                },
                                                {
                                                    "id": "735070313",
                                                    "speaker": "Haniyyah",
                                                    "text": "Eu solicitei privilégios de residência dos dois Cogumelos, então eles estarão em Porto Ormos durante o teste do Fungo Mechanicus."
                                                },
                                                {
                                                    "id": "735070314",
                                                    "speaker": "Haniyyah",
                                                    "text": "Sua Parceira de Prata pode passar mais tempo com Cabeça de Bongô.",
                                                    "choices": [
                                                        {
                                                            "id": "735070315",
                                                            "text": "Bom para Paimon!",
                                                            "response": [
                                                                {
                                                                    "id": "735070317",
                                                                    "speaker": "Haniyyah",
                                                                    "text": "Hehe, sim, você deveria ir ver Cabeça de Bongô também. Ele sente sua falta, sabia?"
                                                                },
                                                                {
                                                                    "id": "735070318",
                                                                    "speaker": "Haniyyah",
                                                                    "text": "Leve isso com você. Você pode alimentar Cabeça de Bongô e Pyroalegria. É o favorito deles."
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "735070316",
                                                            "text": "Eu também mal posso esperar."
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "735070311",
                                            "text": "Você verá essa Mora de volta da próxima vez que realizarmos este torneio!"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "735070304",
                            "text": "Eu precisarei fazer mais testes."
                        }
                    ]
                }
            ]
        },
        {
            "id": "7350705",
            "objective": "Fale com seu cogumigo",
            "dialogues": []
        },
        {
            "id": "7350713",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "735071301",
                    "speaker": "Haniyyah",
                    "text": "Faça uma visita logo ao Cabeça de Bongô também. Ele sente sua falta, sabia?"
                }
            ]
        },
        {
            "id": "7350719",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "735071901",
                    "speaker": "Paimon",
                    "text": "Olá, Cabeça de Bongô, Pyroalegria! Do que vamos brincar hoje?"
                },
                {
                    "id": "735071902",
                    "speaker": "Cabeça de Bongô",
