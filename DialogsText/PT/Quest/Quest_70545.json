            "dialogues": [
                {
                    "id": "705450101",
                    "speaker": "Amber",
                    "text": "Miau, miau miau-miaaauuuu~~"
                },
                {
                    "id": "705450102",
                    "speaker": "Coelhinho",
                    "text": "Miau! Miau miau miau!"
                },
                {
                    "id": "705450103",
                    "speaker": "Paimon",
                    "text": "Hmm... Tanto Coelhinho e Amber tem um bom ponto..."
                },
                {
                    "id": "705450104",
                    "speaker": "Paimon",
                    "text": "Oh, então é isso...",
                    "choices": [
                        {
                            "id": "705450105",
                            "text": "Uma observação astuta.",
                            "response": [
                                {
                                    "id": "705450107",
                                    "speaker": "Paimon",
                                    "text": "Na verdade, Paimon também não entende, mas ela consegue perceber que Amber e Coelhinho chegaram a um acordo!"
                                },
                                {
                                    "id": "705450108",
                                    "speaker": "Amber",
                                    "text": "#{NICKNAME}, Paimon! Vocês estão aqui! Eu estava pensando em voltar para procurar vocês!"
                                },
                                {
                                    "id": "705450109",
                                    "speaker": "Amber",
                                    "text": "Eu já ouvi tudo sobre como você está ajudando Valerina com a Fortaleza Felina Fofinha!"
                                },
                                {
                                    "id": "705450110",
                                    "speaker": "Amber",
                                    "text": "#Ess{M#e}{F#a} é {M#o}{F#a} Viajante e a Paimon! No segundo que voltaram a Mondstadt, já começaram a ser uma grande ajuda!",
                                    "choices": [
                                        {
                                            "id": "705450111",
                                            "text": "#Eu, {M#o}{F#a} Cavaleir{F#a}{M#o} Honorável, irei honrar minha missão, não importa como.",
                                            "response": [
                                                {
                                                    "id": "705450113",
                                                    "speaker": "Paimon",
                                                    "text": "Falando nisso, o que você e Coelhinho estavam discutindo agora há pouco? Vocês pareciam estar tendo uma conversa bem divertida."
                                                },
                                                {
                                                    "id": "705450114",
                                                    "speaker": "Coelhinho",
                                                    "text": "Miau, miau miau?"
                                                },
                                                {
                                                    "id": "705450115",
                                                    "speaker": "Amber",
                                                    "text": "Oh! Eu só estava perguntando ao Coelhinho sobre o tempo, e se ia ou não chover."
                                                },
                                                {
                                                    "id": "705450116",
                                                    "speaker": "Paimon",
                                                    "text": "Hã? Gatos sabem desse tipo de coisa?"
                                                },
                                                {
                                                    "id": "705450117",
                                                    "speaker": "Amber",
                                                    "text": "Hehe, Lisa disse algo sobre isso!"
                                                },
                                                {
                                                    "id": "705450118",
                                                    "speaker": "Amber",
                                                    "text": "Segundo o livro que ela leu, gatos são muito sensíveis à umidade e não gostam da sensação de estar molhados."
                                                },
                                                {
                                                    "id": "705450119",
                                                    "speaker": "Amber",
                                                    "text": "Então, se eles perceberem um aumento na umidade, vão começar a esfregar o rosto e se lamber repetidamente."
                                                },
                                                {
                                                    "id": "705450120",
                                                    "speaker": "Amber",
                                                    "text": "Quando um gato faz algo assim, é um sinal que uma chuva forte está provavelmente a caminho."
                                                },
                                                {
                                                    "id": "705450121",
                                                    "speaker": "Paimon",
                                                    "text": "Eita, Paimon não fazia ideia, isso é tão legal! Paimon acha que acabamos de aprender uma coisa maneira por acaso!"
                                                },
                                                {
                                                    "id": "705450122",
                                                    "speaker": "Paimon",
                                                    "text": "#Nesse caso, {NICKNAME}, vamos prestar mais atenção durante nossas viagens! Assim, a gente não... vai ficar encharcad{M#o}{F#a} com as grandes chuvas daquelas nuvens pretas gigantes!",
                                                    "choices": [
                                                        {
                                                            "id": "705450123",
                                                            "text": "Acho que teremos que prestar mais atenção no futuro.",
                                                            "response": [
                                                                {
                                                                    "id": "705450125",
                                                                    "speaker": "Amber",
                                                                    "text": "Vim aqui originalmente perguntar uma coisa a Valerina."
                                                                },
                                                                {
                                                                    "id": "705450126",
                                                                    "speaker": "Amber",
                                                                    "text": "Mas enquanto estava falando com ela, esse gatinho se deitou pertinho de mim e bocejou tão alto! Foi fofo demais!"
                                                                },
                                                                {
                                                                    "id": "705450127",
                                                                    "speaker": "Amber",
                                                                    "text": "Já que ela foi tão carinhosa comigo, então... Bem, então preciso mostrar como sou amigável também!"
                                                                },
                                                                {
                                                                    "id": "705450128",
                                                                    "speaker": "Amber",
                                                                    "text": "Foi aí que lembrei do que Lisa me disse, então perguntei a Coelhinho sobre o tempo."
                                                                },
                                                                {
                                                                    "id": "705450129",
                                                                    "speaker": "Amber",
                                                                    "text": "Mas ela respondeu esfregando a cara, balançando o rabo, então se deitou no chão se esfregando na minha mão..."
                                                                },
                                                                {
                                                                    "id": "705450130",
                                                                    "speaker": "Amber",
                                                                    "text": "*Suspiro* Então vai chover ou não nos próximos dias...?"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "705450124",
                                                            "text": "Desde quando eu não presto atenção em gatinhos fofinhos?"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "705450112",
                                            "text": "A defesa dos gatos de Mondstadt é uma de minhas muitas responsabilidades."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "705450106",
                            "text": "#Espera aí, estou um pouco perdid{M#o}{F#a}."
                        }
                    ]
                }
            ]
        }
    ]
