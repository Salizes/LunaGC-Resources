        {
            "id": "7415702",
            "objective": "Fale com Moli",
            "dialogues": [
                {
                    "id": "741570201",
                    "speaker": "Informações de Venda de Imóvel",
                    "text": "Essa casa está à venda. Por um preço bem razoável, compre antes que seja tarde demais!"
                },
                {
                    "id": "741570202",
                    "speaker": "Moli",
                    "text": "#{M#Sr.}{F#Srta.} {NICKNAME}, Srta. Paimon, parece que o Sr. Leroy não vive mais aqui! Vocês viram ele?"
                },
                {
                    "id": "741570203",
                    "speaker": "Paimon",
                    "text": "(Ei, você quer dizer a verdade?)",
                    "choices": [
                        {
                            "id": "741570204",
                            "text": "Nos deparamos com ele.",
                            "response": [
                                {
                                    "id": "741570205",
                                    "speaker": "Moli",
                                    "text": "Então você viu ele! Você disse a ele que os lanchinhos estavam deliciosos?",
                                    "choices": [
                                        {
                                            "id": "741570206",
                                            "text": "Dissemos.",
                                            "response": [
                                                {
                                                    "id": "741570207",
                                                    "speaker": "Moli",
                                                    "text": "#Eu sabia que {M#o Sr.}{F#a Srta.} {NICKNAME} era confiável! Você é {M#o}{F#a} melhor. Eu trouxe algumas Frutas Bulle, vamos comer junt{M#o}{F#a}s!"
                                                },
                                                {
                                                    "id": "741570214",
                                                    "speaker": "Black Screen",
                                                    "text": "Moli suspira e acena, e assim que ela está prestes a sair..."
                                                },
                                                {
                                                    "id": "741570215",
                                                    "speaker": "Black Screen",
                                                    "text": "A porta abre e Autumn e Atos saem."
                                                },
                                                {
                                                    "id": "741570216",
                                                    "speaker": "Autumn",
                                                    "text": "Então foram as vozes de vocês que ouvimos do lado de fora! É alguma coisa?",
                                                    "choices": [
                                                        {
                                                            "id": "741570217",
                                                            "text": "Só estávamos de passagem.",
                                                            "response": [
                                                                {
                                                                    "id": "741570218",
                                                                    "speaker": "Atos",
                                                                    "text": "Sério? Mundo pequeno. Autumn e eu estávamos de saída."
                                                                },
                                                                {
                                                                    "id": "741570219",
                                                                    "speaker": "Player",
                                                                    "text": "E Benoit?"
                                                                },
                                                                {
                                                                    "id": "741570220",
                                                                    "speaker": "Atos",
                                                                    "text": "Oh, ele já foi para algum outro lugar. Um lugar que iremos apenas depois de mais algumas décadas. Não acho que você o verá tão cedo."
                                                                },
                                                                {
                                                                    "id": "741570221",
                                                                    "speaker": "Atos",
                                                                    "text": "Embora seja difícil de dizer. O que virá primeiro, o amanhã ou o fim? Quem sabe?"
                                                                },
                                                                {
                                                                    "id": "741570225",
                                                                    "speaker": "Atos",
                                                                    "text": "Essa não é a menina que está sempre procurando por Benoit?"
                                                                },
                                                                {
                                                                    "id": "741570226",
                                                                    "speaker": "Autumn",
                                                                    "text": "..."
                                                                },
                                                                {
                                                                    "id": "741570227",
                                                                    "speaker": "Moli",
                                                                    "text": "Oi, moça!"
                                                                },
                                                                {
                                                                    "id": "741570228",
                                                                    "speaker": "Autumn",
                                                                    "text": "...Parecem demais, e você até tem os olhos violetas..."
                                                                },
                                                                {
                                                                    "id": "741570229",
                                                                    "speaker": "Moli",
                                                                    "text": "M-Moça, posso te ajudar...?"
                                                                },
                                                                {
                                                                    "id": "741570230",
                                                                    "speaker": "Autumn",
                                                                    "text": "Qual é a sua idade?"
                                                                },
                                                                {
                                                                    "id": "741570231",
                                                                    "speaker": "Moli",
                                                                    "text": "Tenho nove!"
                                                                },
                                                                {
                                                                    "id": "741570232",
                                                                    "speaker": "Autumn",
                                                                    "text": "Quais são os nomes dos seus pais?"
                                                                },
                                                                {
                                                                    "id": "741570233",
                                                                    "speaker": "Moli",
                                                                    "text": "Uh... você está bem, senhora?"
                                                                },
                                                                {
                                                                    "id": "741570234",
                                                                    "speaker": "Atos",
                                                                    "text": "Sua expressão... tem algo errado com a criança? ...Espere, isso não pode ser uma coincidência, pode?"
                                                                },
                                                                {
                                                                    "id": "741570235",
                                                                    "speaker": "Autumn",
                                                                    "text": "Você é adotada? Me diga! Agora!"
                                                                },
                                                                {
                                                                    "id": "741570236",
                                                                    "speaker": "Moli",
                                                                    "text": "#...{M#Sr.}{F#Srta.} {NICKNAME}, você conhece essa moça? O que ela está fazendo...?"
                                                                },
                                                                {
                                                                    "id": "741570237",
                                                                    "speaker": "Atos",
                                                                    "text": "Quem faz perguntas assim? Permita-me."
                                                                },
                                                                {
                                                                    "id": "741570238",
                                                                    "speaker": "Atos",
                                                                    "text": "Jovenzinha, eu me lembro que você é bem próxima do nosso pai, certo?"
                                                                },
                                                                {
                                                                    "id": "741570239",
                                                                    "speaker": "Moli",
                                                                    "text": "Sim! O Sr. Leroy cuida muito bem de mim. Sr. Genro, ele não vive mais aqui?"
                                                                },
                                                                {
                                                                    "id": "741570240",
                                                                    "speaker": "Atos",
                                                                    "text": "Isso mesmo, ele foi para um lugar bem longe, e não voltará novamente."
                                                                },
                                                                {
                                                                    "id": "741570241",
                                                                    "speaker": "Atos",
                                                                    "text": "Sobre o que o nosso pai fala normalmente com você? Você pode me dizer? Quando eu voltar, eu posso dizer a ele que você sente muita falta mesmo dele."
                                                                },
                                                                {
                                                                    "id": "741570242",
                                                                    "speaker": "Moli",
                                                                    "text": "Sr. Leroy sempre me dá lanchinhos, me deixa fazer carinho na Nana, e diz que meus olhos são bonitos!"
                                                                },
                                                                {
                                                                    "id": "741570243",
                                                                    "speaker": "Atos",
                                                                    "text": "Mais alguma coisa?"
                                                                },
                                                                {
                                                                    "id": "741570244",
                                                                    "speaker": "Moli",
                                                                    "text": "Ele costuma me dizer para dar oi para minha mãe e meu pai por ele, mas eles realmente não gostam disso..."
                                                                },
                                                                {
                                                                    "id": "741570245",
                                                                    "speaker": "Moli",
                                                                    "text": "O papai fica bem bravo, e diz que o Sr. Leroy é uma pessoa ruim, e que está \"chantageando\" eles."
                                                                },
                                                                {
                                                                    "id": "741570246",
                                                                    "speaker": "Moli",
                                                                    "text": "Embora eles me proíbam de vir aqui, eu fiz um acordo com o Sr. Leroy de vir escondida. Por favor, não diga ao meu pai, moço!"
                                                                },
                                                                {
                                                                    "id": "741570247",
                                                                    "speaker": "Autumn",
                                                                    "text": "É bem a cara dele. Ele não vai parar de apertar até que tenha conseguido até a última gota de valor."
                                                                },
                                                                {
                                                                    "id": "741570248",
                                                                    "speaker": "Atos",
                                                                    "text": "...Aquele maldito... Desculpe. Estávamos falando de outra coisa agora pouco."
                                                                },
                                                                {
                                                                    "id": "741570249",
                                                                    "speaker": "Moli",
                                                                    "text": "Moço, moça, mais alguma coisa? Se não, então e-eu irei para casa agora."
                                                                },
                                                                {
                                                                    "id": "741570250",
                                                                    "speaker": "Autumn",
                                                                    "text": "...Seu pai e sua mãe te amam?"
                                                                },
                                                                {
                                                                    "id": "741570251",
                                                                    "speaker": "Moli",
                                                                    "text": "Eles são os melhores pais do mundo todo."
                                                                },
                                                                {
                                                                    "id": "741570252",
                                                                    "speaker": "Autumn",
                                                                    "text": "..."
                                                                },
                                                                {
                                                                    "id": "741570253",
                                                                    "speaker": "Autumn",
                                                                    "text": "Isso é bom."
                                                                },
                                                                {
                                                                    "id": "741570254",
                                                                    "speaker": "Moli",
                                                                    "text": "Estou indo para casa agora! Tchau, moça! Tchau, moço!"
                                                                },
                                                                {
                                                                    "id": "741570255",
                                                                    "speaker": "Autumn",
                                                                    "text": "Adeus.",
                                                                    "choices": [
                                                                        {
                                                                            "id": "741570256",
                                                                            "text": "Está realmente tudo bem?",
                                                                            "response": [
                                                                                {
                                                                                    "id": "741570258",
                                                                                    "speaker": "Autumn",
                                                                                    "text": "Eu imaginei essa cena de novo e de novo... mas nada é melhor do que saber que ela está feliz. Isso é o suficiente para mim."
                                                                                },
                                                                                {
                                                                                    "id": "741570259",
                                                                                    "speaker": "Autumn",
                                                                                    "text": "Eu... não sou o meu pai. Eu não quero causar problema para a família atual dela."
                                                                                },
                                                                                {
                                                                                    "id": "741570260",
                                                                                    "speaker": "Atos",
                                                                                    "text": "Eu não quero ser \"aquele\" cara, mas, você não comprou uma caixinha de música para ela? Você não vai mais dar para ela?"
                                                                                },
                                                                                {
                                                                                    "id": "741570261",
                                                                                    "speaker": "Autumn",
                                                                                    "text": "..."
                                                                                },
                                                                                {
                                                                                    "id": "741570262",
                                                                                    "speaker": "Autumn",
                                                                                    "text": "Não, não há necessidade. Ela... não parece que falta coisas assim para ela."
                                                                                },
                                                                                {
                                                                                    "id": "741570263",
                                                                                    "speaker": "Autumn",
                                                                                    "text": "Vou pensar em formas de continuar visitando ela no futuro. Seja o que ela precisar, encontrarei uma forma."
                                                                                },
                                                                                {
                                                                                    "id": "741570264",
                                                                                    "speaker": "Autumn",
                                                                                    "text": "...Vou dar a caixinha de música para outra pessoa. Afinal de contas, passei muito tempo e esforço escolhendo."
                                                                                },
                                                                                {
                                                                                    "id": "741570265",
                                                                                    "speaker": "Autumn",
                                                                                    "text": "Com licença, pequena garotinha de cabelos brancos... você gosta de presentes?"
                                                                                },
                                                                                {
                                                                                    "id": "741570266",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "Você quer dizer, Paimon? Espera, você quer dar isso a Paimon?"
                                                                                },
                                                                                {
                                                                                    "id": "741570267",
                                                                                    "speaker": "Autumn",
                                                                                    "text": "Sim. É um presente, então, por favor, espero que goste. Espero que tenha um pouco de valor para você."
                                                                                },
                                                                                {
                                                                                    "id": "741570268",
                                                                                    "speaker": "Autumn",
                                                                                    "text": "Desculpe, Atos, acho que teremos que ficar um pouco mais na Corte de Fontaine."
                                                                                },
                                                                                {
                                                                                    "id": "741570269",
                                                                                    "speaker": "Atos",
                                                                                    "text": "Não se preocupe, dá no mesmo para mim. Vamos lá."
                                                                                },
                                                                                {
                                                                                    "id": "741570270",
                                                                                    "speaker": "Black Screen",
                                                                                    "text": "Conforme você vê os dois indo embora, e deixando aquela rua para trás, a história da família Leroy chega ao fim."
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "741570257",
                                                                            "text": "Você não planeja contar a ela?"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "741570219",
                                                            "text": "E Benoit?"
                                                        },
                                                        {
                                                            "id": "741570222",
                                                            "text": "Como está Benoit?",
                                                            "response": [
                                                                {
                                                                    "id": "741570223",
                                                                    "speaker": "Atos",
                                                                    "text": "Esse mundo está cheio de desequilíbrios, extrema pobreza e extrema ganância. As punições que as leis de Fontaine falham em aplicar, nós a aplicaremos no seu lugar."
                                                                },
                                                                {
                                                                    "id": "741570224",
                                                                    "speaker": "Atos",
                                                                    "text": "Eu quero dizer, ele foi para onde ele deveria estar."
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "741570208",
                                            "text": "Esquecemos.",
                                            "response": [
                                                {
                                                    "id": "741570209",
                                                    "speaker": "Moli",
                                                    "text": "Ah, sério? Que pena. Acho que nunca vou ter a chance de contar para o Sr. Leroy. Quanto às Frutas Bulle que trouxe... acho que deveria dar elas para você."
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "741570210",
                            "text": "Não nos deparamos com ele.",
                            "response": [
                                {
                                    "id": "741570211",
                                    "speaker": "Moli",
                                    "text": "Oh, que pena. Acho que nunca terei a chance de ver o Sr. Leroy de novo."
                                },
                                {
                                    "id": "741570212",
                                    "speaker": "Moli",
                                    "text": "Eu trouxe algumas Fruta Bulle e estava planejando dá-las a ele caso eu o visse... mas já que ele não vive mais aqui, por que você não fica com elas?"
                                },
                                {
                                    "id": "741570213",
                                    "speaker": "Moli",
                                    "text": "Mas, independente de tudo, acho que sempre me lembrarei do Sr. Leroy! Tchau-tchau!"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7415703",
            "objective": "",
            "dialogues": [
                {
                    "id": "741570301",
                    "speaker": "Informações de Venda de Imóvel",
                    "text": "Essa casa está à venda. Por um preço bem razoável, compre antes que seja tarde demais!"
                },
                {
                    "id": "741570302",
                    "speaker": "Moli",
                    "text": "#{M#Sr.}{F#Srta.} {NICKNAME} e Srta. Paimon! Vocês estão aqui para falar com o Sr. Leroy?",
                    "choices": [
                        {
                            "id": "741570303",
                            "text": "Benoit está em casa?",
                            "response": [
                                {
                                    "id": "741570304",
                                    "speaker": "Moli",
                                    "text": "Ele não está aqui. Pai disse que o Sr. Leroy nunca mais vai viver aqui, ele foi viver lá embaixo."
                                },
                                {
                                    "id": "741570308",
                                    "speaker": "Player",
                                    "text": "No Fleuve Cendre?"
                                },
                                {
                                    "id": "741570309",
                                    "speaker": "Paimon",
                                    "text": "É o mesmo Fleuve Cendre para onde fomos antes?"
                                },
                                {
                                    "id": "741570310",
                                    "speaker": "Moli",
                                    "text": "Se for, então não, aquele lugar não. Pai disse que é muito mais lá embaixo."
                                },
                                {
                                    "id": "741570311",
                                    "speaker": "Moli",
                                    "text": "O Pássaro a Vapor disse que o Sr. Leroy caiu de um lugar muito alto quando ele estava subindo uma montanha e saiu tombando."
                                },
                                {
                                    "id": "741570312",
                                    "speaker": "Moli",
                                    "text": "Embora, para ser sincera, eu não faço ideia do que cair e se mudar tenham a ver..."
                                },
                                {
                                    "id": "741570313",
                                    "speaker": "Moli",
                                    "text": "A propósito, eu vi o genro do Sr. Leroy! E tinha uma senhora muito legal também."
                                },
                                {
                                    "id": "741570314",
                                    "speaker": "Moli",
                                    "text": "A senhora gostou realmente de mim, e ela tem os olhos da mesma cor que os meus! Ambos são violetas."
                                },
                                {
                                    "id": "741570315",
                                    "speaker": "Moli",
                                    "text": "Ela até perguntou onde eu morava e disse que viria aqui se tivesse um tempo, para sermos amigas! Acho que todos da família Leroy são boas pessoas!"
                                },
                                {
                                    "id": "741570316",
                                    "speaker": "Moli",
                                    "text": "*Suspira* Eu até comprei algumas Fruta Bulle para o Sr. Leroy, mas já que ele não está aqui..."
                                },
                                {
                                    "id": "741570317",
                                    "speaker": "Moli",
                                    "text": "Posso dar elas a você?"
                                },
                                {
                                    "id": "741570318",
                                    "speaker": "Paimon",
                                    "text": "Obrigada, Moli!"
                                },
                                {
                                    "id": "741570319",
                                    "speaker": "Moli",
                                    "text": "Por nada! Papai e mamãe sempre dizem que devemos ser generosos com nossos amigos."
                                },
                                {
                                    "id": "741570320",
                                    "speaker": "Moli",
                                    "text": "Eu fiz outra coisa boa hoje! Eu vou voltar e escrever em meu diário, viva!"
                                },
                                {
                                    "id": "741570321",
                                    "speaker": "Black Screen",
                                    "text": "Conforme você vê Moli indo embora, e deixando aquela rua para trás, a história da família Leroy chega ao fim."
                                }
                            ]
                        },
                        {
                            "id": "741570305",
                            "text": "Só estávamos de passagem.",
                            "response": [
                                {
                                    "id": "741570306",
                                    "speaker": "Moli",
                                    "text": "Eu estava pensando se deveria te dizer que o Sr. Leroy se mudou."
                                },
                                {
                                    "id": "741570307",
                                    "speaker": "Moli",
                                    "text": "Pai disse que o Sr. Leroy nunca mais vai viver aqui, ele foi viver lá embaixo."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
