    "talks": [
        {
            "id": "7603501",
            "objective": "Encontre-se com Damselette",
            "dialogues": [
                {
                    "id": "760350101",
                    "speaker": "Player",
                    "text": "(Será que Columbina não tá aqui...?)"
                },
                {
                    "id": "760350102",
                    "speaker": "Damselette",
                    "text": "Você está me procurando?"
                },
                {
                    "id": "760350103",
                    "speaker": "Paimon",
                    "text": "Aaaah!",
                    "choices": [
                        {
                            "id": "760350104",
                            "text": "Você quase me mata de susto...",
                            "response": [
                                {
                                    "id": "760350106",
                                    "speaker": "Damselette",
                                    "text": "Ao sentir sua presença, queria ver quanto eu conseguiria me aproximar pelas suas costas."
                                },
                                {
                                    "id": "760350107",
                                    "speaker": "Paimon",
                                    "text": "Você parece ser bem desocupada..."
                                },
                                {
                                    "id": "760350108",
                                    "speaker": "Damselette",
                                    "text": "Hã... É isso que parece? As coisas eram meio diferentes quando eu estava com os Fatui. Nunca havia muita coisa para eu fazer."
                                },
                                {
                                    "id": "760350109",
                                    "speaker": "Damselette",
                                    "text": "A Tsaritsa apenas queria o poder das Deusas da Lua. Nunca fui enviada para pegar uma Gnosis, ou algo do tipo."
                                },
                                {
                                    "id": "760350110",
                                    "speaker": "Player",
                                    "text": "Então o que você costuma fazer?"
                                },
                                {
                                    "id": "760350111",
                                    "speaker": "Damselette",
                                    "text": "Caminhar, olhar a lua, e às vezes cantar, mas passei a cantar menos depois que Sandrone proibiu."
                                },
                                {
                                    "id": "760350112",
                                    "speaker": "Paimon",
                                    "text": "Hã? Ela não gosta de você cantando?"
                                },
                                {
                                    "id": "760350113",
                                    "speaker": "Damselette",
                                    "text": "Não, pelo contrário, ela elogiou. Mas eu tinha acabado de entrar nos Fatui, e ela disse que os outros ficariam nervosos ao me ouvirem."
                                },
                                {
                                    "id": "760350114",
                                    "speaker": "Damselette",
                                    "text": "E para aqueles que não me conhecem, pareceria que eu estaria prestes a usar algum tipo de poder."
                                },
                                {
                                    "id": "760350115",
                                    "speaker": "Paimon",
                                    "text": "Ah, faz sentido, mais ou menos."
                                },
                                {
                                    "id": "760350116",
                                    "speaker": "Damselette",
                                    "text": "Ah sim. Mas há outra razão. Ela disse que estaria pesquisando de noite, e que se eu cantasse de dia, estaria interrompendo o sono dela."
                                },
                                {
                                    "id": "760350117",
                                    "speaker": "Player",
                                    "text": "(Tenho certeza que a razão foi essa!)"
                                },
                                {
                                    "id": "760350118",
                                    "speaker": "Damselette",
                                    "text": "Por isso, eu passei a cantar ao lado da porta dela de noite. E ela me expulsou..."
                                },
                                {
                                    "id": "760350119",
                                    "speaker": "Paimon",
                                    "text": "..."
                                },
                                {
                                    "id": "760350120",
                                    "speaker": "Player",
                                    "text": "Você se dá bem com outras pessoas?"
                                },
                                {
                                    "id": "760350121",
                                    "speaker": "Damselette",
                                    "text": "Me dar bem? Hmm, quando nos conhecemos, Arlecchino parecia querer se dar bem comigo."
                                },
                                {
                                    "id": "760350122",
                                    "speaker": "Damselette",
                                    "text": "Ela costumava aparecer atrás de mim, como eu fiz com você. Falava sobre me testar."
                                },
                                {
                                    "id": "760350123",
                                    "speaker": "Damselette",
                                    "text": "Eu tentei jogar o mesmo jogo com ela, mas ela sempre se virava quando eu ainda estava muito longe."
                                },
                                {
                                    "id": "760350124",
                                    "speaker": "Damselette",
                                    "text": "Isso durou até um dia eu ter sido forçada a usar o kuuvahki. Consegui dar um susto enorme ela. Depois disso, nunca mais brincou comigo."
                                },
                                {
                                    "id": "760350125",
                                    "speaker": "Paimon",
                                    "text": "(A Serva provavelmente nunca achou que isso fosse uma brincadeira...)"
                                },
                                {
                                    "id": "760350126",
                                    "speaker": "Damselette",
                                    "text": "Dottore também me pedia para ajudá-lo na sua pesquisa relacionada ao Reino da Luz."
                                },
                                {
                                    "id": "760350127",
                                    "speaker": "Damselette",
                                    "text": "Eu o ajudei algumas vezes, mas na maioria delas, era muito chato. Use o kuuvahki para atingir isso, use o kuuvahki para controlar aqui... Parei de ir depois de um tempo.",
                                    "choices": [
                                        {
                                            "id": "760350128",
                                            "text": "Parece que você está de bom humor hoje...",
                                            "response": [
                                                {
                                                    "id": "760350130",
                                                    "speaker": "Damselette",
                                                    "text": "Sim. Apesar de eu ter \"fugido de casa\", eu tenho algumas memórias preciosas dela."
                                                },
                                                {
                                                    "id": "760350131",
                                                    "speaker": "Damselette",
                                                    "text": "Arlecchino e Sandrone cuidaram bem de mim, junto com..."
                                                },
                                                {
                                                    "id": "760350132",
                                                    "speaker": "Damselette",
                                                    "text": "..."
                                                },
                                                {
                                                    "id": "760350133",
                                                    "speaker": "Player",
                                                    "text": "(Essa expressão... Queria saber sobre quem ela tá pensando...)"
                                                },
                                                {
                                                    "id": "760350134",
                                                    "speaker": "Damselette",
                                                    "text": "Me dê a sua mão.",
                                                    "choices": [
                                                        {
                                                            "id": "760350135",
                                                            "text": "...Hã?",
                                                            "response": [
                                                                {
                                                                    "id": "760350137",
                                                                    "speaker": "Damselette",
                                                                    "text": "Rosalyne me ensinou que... É importante sempre expressar gratidão aos outros."
                                                                },
                                                                {
                                                                    "id": "760350138",
                                                                    "speaker": "Damselette",
                                                                    "text": "Obrigada por me ouvir hoje."
                                                                },
                                                                {
                                                                    "id": "760350139",
                                                                    "speaker": "Player",
                                                                    "text": "Não foi nada..."
                                                                },
                                                                {
                                                                    "id": "760350140",
                                                                    "speaker": "Player",
                                                                    "text": "(Será que isso... é a Graça da Deusa da Lua?)"
                                                                },
                                                                {
                                                                    "id": "760350141",
                                                                    "speaker": "Damselette",
                                                                    "text": "Isso basta por hoje."
                                                                },
                                                                {
                                                                    "id": "760350142",
                                                                    "speaker": "Paimon",
                                                                    "text": "Uau, que final repetino!",
                                                                    "choices": [
                                                                        {
                                                                            "id": "760350143",
                                                                            "text": "Shh... Paimon...",
                                                                            "response": [
                                                                                {
                                                                                    "id": "760350145",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "Você tem razão. Não vamos mais incomodá-la."
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "760350144",
                                                                            "text": "Ela lembrou de algumas coisas..."
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "760350136",
                                                            "text": "...Por quê?"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "760350129",
                                            "text": "Você falou bastante sobre o seu passado..."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "760350105",
                            "text": "Você realmente tinha que vir assim pelas costas?"
                        }
                    ]
                }
            ]
        }
    ]
}