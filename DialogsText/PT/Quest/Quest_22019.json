    "talks": [
        {
            "id": "2201901",
            "objective": "Fale com Sango",
            "dialogues": [
                {
                    "id": "220190101",
                    "speaker": "Sango",
                    "text": "... Então, posso contar com vocês?"
                },
                {
                    "id": "220190102",
                    "speaker": "Andou",
                    "text": "Não se preocupe, pode deixar com a gente, Sango."
                },
                {
                    "id": "220190103",
                    "speaker": "Amano",
                    "text": "Não acredito que durante todo esse tempo ele estava escondido aqui debaixo do nosso nariz, que atrevido!"
                },
                {
                    "id": "220190104",
                    "speaker": "Amano",
                    "text": "Ainda mais usando uma identidade daquelas..."
                },
                {
                    "id": "220190105",
                    "speaker": "Sango",
                    "text": "De qualquer maneira, seus dias de criminoso chegaram ao fim. Ryuuji, não se esqueça do que te passei pra fazer!"
                },
                {
                    "id": "220190106",
                    "speaker": "Ryuuji",
                    "text": "Pode deixar, diretora."
                },
                {
                    "id": "220190107",
                    "speaker": "Sango",
                    "text": "Então tá bom... Oh, Viajante! Que bom que você está aqui também.",
                    "choices": [
                        {
                            "id": "220190108",
                            "text": "Estamos indo prender o criminoso?",
                            "response": [
                                {
                                    "id": "220190111",
                                    "speaker": "Sango",
                                    "text": "Conseguimos provas suficientes e também já entendi como esse criminoso age."
                                },
                                {
                                    "id": "220190112",
                                    "speaker": "Sango",
                                    "text": "Viajante, preciso que você vá com o Ryuuji, Andou e o Amano e que vocês se encarreguem desse criminoso."
                                },
                                {
                                    "id": "220190113",
                                    "speaker": "Sango",
                                    "text": "Esse cara deve ter vários cúmplices, mas com você teremos mais chances de sucesso.",
                                    "choices": [
                                        {
                                            "id": "220190114",
                                            "text": "O que devo fazer?",
                                            "response": [
                                                {
                                                    "id": "220190115",
                                                    "speaker": "Sango",
                                                    "text": "Apenas use essa sua aura invencível para assustar o criminoso e evitar que ele faça mais alguma besteira."
                                                },
                                                {
                                                    "id": "220190116",
                                                    "speaker": "Sango",
                                                    "text": "Embora eu não ache que um ladrão furtivo como este teria a capacidade de fazer algo muito ousado."
                                                },
                                                {
                                                    "id": "220190121",
                                                    "speaker": "Sango",
                                                    "text": "Acredito que esse cara já deve ter ido para natureza enterrar seus novos objetos roubados."
                                                },
                                                {
                                                    "id": "220190122",
                                                    "speaker": "Sango",
                                                    "text": "Se vocês forem agora atrás dele, provavelmente pegarão ele em flagrante. Se apressem, estarei aqui esperando por vocês."
                                                }
                                            ]
                                        },
                                        {
                                            "id": "220190117",
                                            "text": "Você não vem junto?",
                                            "response": [
                                                {
                                                    "id": "220190118",
                                                    "speaker": "Sango",
                                                    "text": "Para mim, este caso já está encerrado, o resto eu deixo para vocês."
                                                },
                                                {
                                                    "id": "220190119",
                                                    "speaker": "Sango",
                                                    "text": "Viajante, use a sua aura invencível para assustar o criminoso e evitar que ele faça mais alguma besteira."
                                                },
                                                {
                                                    "id": "220190120",
                                                    "speaker": "Sango",
                                                    "text": "Embora eu não ache que um ladrão furtivo como este teria a capacidade de fazer algo muito ousado."
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "220190109",
                            "text": "Estamos encerrando o caso?",
                            "response": [
                                {
                                    "id": "220190110",
                                    "speaker": "Sango",
                                    "text": "Sim, se tudo ocorrer como o planejado, estaremos encerrando o caso ainda hoje."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2201902",
            "objective": "Vá até o local em que os criminosos estão",
            "dialogues": [
                {
                    "id": "220190201",
                    "speaker": "Ryuuji",
                    "text": "Aqui está ele, enterrando os objetos roubados...",
                    "choices": [
                        {
                            "id": "220190202",
                            "text": "Vamos!",
                            "response": [
                                {
                                    "id": "220190203",
                                    "speaker": "Ryuuji",
                                    "text": "Calma, Viajante, ainda não é o momento."
                                },
                                {
                                    "id": "220190206",
                                    "speaker": "Ryuuji",
                                    "text": "Só mais um pouco... E... Acho que agora..."
                                },
                                {
                                    "id": "220190207",
                                    "speaker": "Andou",
                                    "text": "Você! O que você está fazendo?!"
                                },
                                {
                                    "id": "220190208",
                                    "speaker": "Amano",
                                    "text": "Largue as coisas de lado e não se mova!"
                                },
                                {
                                    "id": "220190209",
                                    "speaker": "Ishikawa Hachirou",
                                    "text": "Co-como que vocês...?"
                                },
                                {
                                    "id": "220190210",
                                    "speaker": "Ishikawa Hachirou",
                                    "text": "Malditos, parem de ficar apenas olhando! Lidem logo com esses dois para que saiamos logo daqui!"
                                },
                                {
                                    "id": "220190211",
                                    "speaker": "Amano",
                                    "text": "Meros Ladrões de Tesouro, como ousam..."
                                },
                                {
                                    "id": "220190212",
                                    "speaker": "Ryuuji",
                                    "text": "Andou, Amano, viemos para ajudar!"
                                },
                                {
                                    "id": "220190213",
                                    "speaker": "Andou",
                                    "text": "Oh, bem na hora!"
                                },
                                {
                                    "id": "220190214",
                                    "speaker": "Ryuuji",
                                    "text": "Viajante, agora!"
                                },
                                {
                                    "id": "220190215",
                                    "speaker": "Player",
                                    "text": "Para quê tanta enrolação..."
                                },
                                {
                                    "id": "220190216",
                                    "speaker": "Ryuuji",
                                    "text": "São ordens da diretora."
                                },
                                {
                                    "id": "220190217",
                                    "speaker": "Ryuuji",
                                    "text": "Agora, vamos!"
                                }
                            ]
                        },
                        {
                            "id": "220190204",
                            "text": "E agora, podemos?",
                            "response": [
                                {
                                    "id": "220190205",
                                    "speaker": "Ryuuji",
                                    "text": "Espera mais um pouco, ainda não chegamos no momento certo."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2201903",
            "objective": "Fale com Ryuuji",
            "dialogues": []
        },
        {
            "id": "2201904",
            "objective": "Derrote os Ladrões de Tesouro",
            "dialogues": [
                {
                    "id": "220190401",
                    "speaker": "Ryuuji",
                    "text": "...o Andou e o Amano devem ter chegado já na Comissão com o criminoso. E foi basicamente isso, diretora."
                },
                {
                    "id": "220190402",
                    "speaker": "Sango",
                    "text": "Ok, perfeito. Caso resolvido então."
                },
                {
                    "id": "220190403",
                    "speaker": "Sango",
                    "text": "Viajante, você também voltou! Bom trabalho!",
                    "choices": [
                        {
                            "id": "220190404",
                            "text": "...É só isso? Resolvemos o caso?",
                            "response": [
                                {
                                    "id": "220190406",
                                    "speaker": "Sango",
                                    "text": "É normal que se sinta assim, afinal, o criminoso foi levado pelo Amano e pelo Andou. Leve isto como recompensa, talvez assim você sinta de fato que o caso foi resolvido.",
                                    "choices": [
                                        {
                                            "id": "220190407",
                                            "text": "Mas e a sua recompensa?",
                                            "response": [
                                                {
                                                    "id": "220190408",
                                                    "speaker": "Sango",
                                                    "text": "Minha? Poder ajudar a Comissão a investigar o caso e fazer com que a rua volte a ter paz de antes é a minha maior recompensa"
                                                },
                                                {
                                                    "id": "220190412",
                                                    "speaker": "Sango",
                                                    "text": "Mas, pra falar a verdade, desta vez, eu realmente não \"ganhei\" nada."
                                                },
                                                {
                                                    "id": "220190413",
                                                    "speaker": "Sango",
                                                    "text": "Não presenciei um método novo de cometer crimes, muito menos tive a oportunidade de ouvir novos conceitos criminais."
                                                },
                                                {
                                                    "id": "220190414",
                                                    "speaker": "Sango",
                                                    "text": "Foi apenas um crime comum e sem graça, que felizmente não investimos muito tempo e esforço.",
                                                    "choices": [
                                                        {
                                                            "id": "220190415",
                                                            "text": "Diretora Sango...",
                                                            "response": [
                                                                {
                                                                    "id": "220190416",
                                                                    "speaker": "Sango",
                                                                    "text": "Que foi? É a primeira vez que você conhece alguém interessado em crimes como eu?"
                                                                },
                                                                {
                                                                    "id": "220190419",
                                                                    "speaker": "Sango",
                                                                    "text": "E foi exatamente por causa disso que me tornei uma detetive."
                                                                },
                                                                {
                                                                    "id": "220190420",
                                                                    "speaker": "Player",
                                                                    "text": "...Mas você sente vontade de cometer crimes?"
                                                                },
                                                                {
                                                                    "id": "220190421",
                                                                    "speaker": "Sango",
                                                                    "text": "Claro, eu sinto é muita vontade. Eu queria é poder cometer um crime perfeito sem deixar nenhuma evidência."
                                                                },
                                                                {
                                                                    "id": "220190422",
                                                                    "speaker": "Sango",
                                                                    "text": "Mas pena que... Na maioria dos casos, é quase impossível um humano cometer um crime sem deixar nenhuma evidência, ou seja, cedo ou tarde detetives irão descobrir a verdade",
                                                                    "choices": [
                                                                        {
                                                                            "id": "220190423",
                                                                            "text": "E se o crime não for cometido por uma pessoa?",
                                                                            "response": [
                                                                                {
                                                                                    "id": "220190426",
                                                                                    "speaker": "Sango",
                                                                                    "text": "Viu? Você também se interessou por crimes, não é?"
                                                                                },
                                                                                {
                                                                                    "id": "220190427",
                                                                                    "speaker": "Sango",
                                                                                    "text": "Não se preocupe, você só parou para refletir um pouco mais sobre crimes."
                                                                                },
                                                                                {
                                                                                    "id": "220190428",
                                                                                    "speaker": "Sango",
                                                                                    "text": "Eu também paro muito pra pensar sobre crimes, por exemplo, sobre métodos de crime ou motivos que podem levar uma pessoa a cometer um crime..."
                                                                                },
                                                                                {
                                                                                    "id": "220190429",
                                                                                    "speaker": "Player",
                                                                                    "text": "Por que você para pra pensar sobre isso?"
                                                                                },
                                                                                {
                                                                                    "id": "220190430",
                                                                                    "speaker": "Sango",
                                                                                    "text": "Para melhorar as minhas técnicas de investigação, é claro. Eu tenho recebido vários casos bem complexos de investigação ultimamente, e ando quebrando a minha cabeça para tentar resolvê-las."
                                                                                },
                                                                                {
                                                                                    "id": "220190431",
                                                                                    "speaker": "Sango",
                                                                                    "text": "Se bem que, desses casos, nenhum pode ser considerado como um \"Crime Perfeito\"."
                                                                                },
                                                                                {
                                                                                    "id": "220190432",
                                                                                    "speaker": "Player",
                                                                                    "text": "Mas você já presenciou algum \"Crime Perfeito\"?"
                                                                                },
                                                                                {
                                                                                    "id": "220190433",
                                                                                    "speaker": "Sango",
                                                                                    "text": "Já, e até hoje não consegui encontrar o criminoso daquele \"Crime Perfeito\"."
                                                                                },
                                                                                {
                                                                                    "id": "220190434",
                                                                                    "speaker": "Sango",
                                                                                    "text": "Mas mesmo assim continuo acreditando que não existe um \"crime perfeito\", qualquer crime cometido por humanos deixará rastros... É apenas questão de tempo até achar as evidências."
                                                                                },
                                                                                {
                                                                                    "id": "220190435",
                                                                                    "speaker": "Sango",
                                                                                    "text": "Enfim, leve essas recompensas e muito obrigada pela ajuda, Viajante!"
                                                                                },
                                                                                {
                                                                                    "id": "220190436",
                                                                                    "speaker": "Sango",
                                                                                    "text": "E venha sempre nos visitar caso tenha tempo, mas, se não tiver, tudo bem também..."
                                                                                },
                                                                                {
                                                                                    "id": "220190437",
                                                                                    "speaker": "Sango",
                                                                                    "text": "Algo me diz que futuramente ainda teremos chances de trabalhar juntos."
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "220190424",
                                                                            "text": "E se não existe um criminoso?"
                                                                        },
                                                                        {
                                                                            "id": "220190425",
                                                                            "text": "Como o criminoso deve fazer para apagar todos os rastros?"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "220190417",
                                                            "text": "Então é assim que são os detetives?",
                                                            "response": [
                                                                {
                                                                    "id": "220190418",
                                                                    "speaker": "Sango",
                                                                    "text": "Não podemos generalizar, mas no meu caso, sim, me interesso muito por crimes."
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "220190409",
                                            "text": "Você não quer nada mesmo?",
                                            "response": [
                                                {
                                                    "id": "220190410",
                                                    "speaker": "Sango",
                                                    "text": "Minha recompensa foi que a justiça foi feita. Tirando isso, também não preciso de mais nada."
                                                },
                                                {
                                                    "id": "220190411",
                                                    "speaker": "Sango",
                                                    "text": "... Talvez eu deva dizer isso, não é?"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "220190405",
                            "text": "Não consigo sentir como se tivéssemos encerrado o caso de fato..."
                        }
                    ]
                }
            ]
        },
        {
            "id": "2201905",
            "objective": "Fale com Ryuuji",
            "dialogues": [
                {
                    "id": "220190301",
                    "speaker": "Andou",
                    "text": "Agora sim pegamos o criminoso em flagrante. Obrigado, Ryuuji, e a você também, Viajante, bom trabalho!"
                },
                {
                    "id": "220190302",
                    "speaker": "Andou",
                    "text": "Amano e eu estaremos levando esses Ladrões de Tesouro de volta para a Comissão, pode deixar o resto com a gente."
                },
                {
                    "id": "220190303",
                    "speaker": "Amano",
                    "text": "Mas eu realmente fico impressionado com a Sango, como que ela consegue adivinhar com tanta exatidão a localização do criminoso..."
                },
                {
                    "id": "220190304",
                    "speaker": "Andou",
                    "text": "Afinal de contas, estamos falando da Sango, para ela isso não é nada."
                },
                {
                    "id": "220190305",
                    "speaker": "Andou",
                    "text": "Estamos indo então, Ryuuji. Depois que resolvermos o caso desse malandro, passaremos para dar oi."
                },
                {
                    "id": "220190306",
                    "speaker": "Ryuuji",
                    "text": "Não se preocupem, e tomem cuidado ao voltar!"
                },
                {
                    "id": "220190307",
                    "speaker": "Ryuuji",
                    "text": "Vamos, Viajante, precisamos informar isso para a diretora também."
                }
            ]
        },
        {
            "id": "2201906",
            "objective": "Fale com Sango",
            "dialogues": []
        },
        {
            "id": "2201906",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "220190601",
                    "speaker": "Sango",
                    "text": "Se vocês forem agora atrás dele, provavelmente pegarão ele em flagrante. Se apressem, estarei aqui esperando por vocês."
                },
                {
                    "id": "220190602",
                    "speaker": "Sango",
                    "text": "Precisa de mais alguma coisa, Viajante?",
                    "choices": [
                        {
                            "id": "220190603",
                            "text": "Você não parece estar muito contente.",
                            "response": [
                                {
                                    "id": "220190604",
                                    "speaker": "Sango",
                                    "text": "Um crime sem graça, um criminoso comum com técnicas criminosas simples, mas dando uma de espertinho."
                                },
                                {
                                    "id": "220190605",
                                    "speaker": "Sango",
                                    "text": "Se eu tivesse que descrever esse caso em uma só palavra, provavelmente usaria a palavra \"tédio\"."
                                },
                                {
                                    "id": "220190606",
                                    "speaker": "Sango",
                                    "text": "Mas de qualquer forma, ainda é um caso que precisamos resolver, né?"
                                }
                            ]
                        },
                        {
                            "id": "220190607",
                            "text": "Você não vem junto?",
                            "response": [
                                {
                                    "id": "220190608",
                                    "speaker": "Sango",
                                    "text": "Para mim, este caso já está encerrado, o resto eu deixo para vocês."
                                },
                                {
                                    "id": "220190609",
                                    "speaker": "Sango",
                                    "text": "Além do mais, com essa minha estrutura física e habilidade de combate, seria um desastre se o criminoso me sequestrasse e me usasse como refém."
                                },
                                {
                                    "id": "220190610",
                                    "speaker": "Sango",
                                    "text": "Me conheço muito bem, por isso, melhor eu deixar que vocês cuidem do criminoso mesmo."
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}