        {
            "id": "7002301",
            "objective": "Fale com o outro Hilichurl disposto a conversar",
            "dialogues": [
                {
                    "id": "700230101",
                    "speaker": "Hilichurl Diligente",
                    "text": "Ya!"
                },
                {
                    "id": "700230102",
                    "speaker": "Ella Musk",
                    "text": "Mimi ika yaya nye! Mimi tomo, mimi mani ye."
                },
                {
                    "id": "700230103",
                    "speaker": "Hilichurl Diligente",
                    "text": "Mani. Mi muhe mani. Unu du mani! Hahahahaha."
                },
                {
                    "id": "700230104",
                    "speaker": "Ella Musk",
                    "text": "Ele contou uma piada sobre os Hilichurls, e ficou rindo sozinho. A mente deles é muito simples, me dá pena."
                },
                {
                    "id": "700230105",
                    "speaker": "Hilichurl Diligente",
                    "text": "Mi muhe <color=#00E1FFFF>kucha gusha</color>. Kucha gusha dada. Unu gusha dada!"
                },
                {
                    "id": "700230106",
                    "speaker": "Ella Musk",
                    "text": "Ele quer... Uh, deixe para lá. Veja minhas anotações para encontrar!"
                }
            ]
        },
        {
            "id": "7002302",
            "objective": "Troque itens com o Hilichurl",
            "dialogues": [
                {
                    "id": "700230301",
                    "speaker": "Hilichurl Diligente",
                    "text": "Yeye dada! Mosi mita!"
                },
                {
                    "id": "700230302",
                    "speaker": "Hilichurl Diligente",
                    "text": "Hahahaha, kucha gusha unu gusha. Unu kucha si!"
                },
                {
                    "id": "700230303",
                    "speaker": "Hilichurl Diligente",
                    "text": "Wei? Odomu tomo zido mi! <color=#00E1FFFF>Mosi aba nunu</color>！"
                },
                {
                    "id": "700230304",
                    "speaker": "Paimon",
                    "text": "<color=#00E1FFFF>Mosi aba nunu</color>... As anotações dizem o que essa frase significa?",
                    "choices": [
                        {
                            "id": "700230305",
                            "text": "Mosi mita dada!",
                            "response": [
                                {
                                    "id": "700230307",
                                    "speaker": "Hilichurl Diligente",
                                    "text": "Valo, mi tomo!"
                                }
                            ]
                        },
                        {
                            "id": "700230306",
                            "text": "Tomo, valo!"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7002304",
