    "talks": [
        {
            "id": "7067901",
            "objective": "",
            "dialogues": [
                {
                    "id": "706790101",
                    "speaker": "Gygax",
                    "text": "Olá, olá! Nos encontramos de novo! Que coincidência!",
                    "choices": [
                        {
                            "id": "706790102",
                            "text": "Foi mal, mas quem é você mesmo...?",
                            "response": [
                                {
                                    "id": "706790103",
                                    "speaker": "Gygax",
                                    "text": "Gygax! Sou Gygax! Sabe, do Labirinto de Vento? Lembrou?"
                                },
                                {
                                    "id": "706790106",
                                    "speaker": "Paimon",
                                    "text": "Ah, é você!"
                                },
                                {
                                    "id": "706790107",
                                    "speaker": "Player",
                                    "text": "Lembrei agora!"
                                },
                                {
                                    "id": "706790108",
                                    "speaker": "Gygax",
                                    "text": "Você não lembrou nada, não foi...?"
                                },
                                {
                                    "id": "706790109",
                                    "speaker": "Gygax",
                                    "text": "Enfim, olhe aqui. Você deve lembrar do Labirinto de Vento, não?"
                                },
                                {
                                    "id": "706790110",
                                    "speaker": "Gygax",
                                    "text": "Você não me deu um monte de sugestões depois de testar? Foram grandes ideias, incorporei todas."
                                },
                                {
                                    "id": "706790111",
                                    "speaker": "Gygax",
                                    "text": "Revisei as regras e a jogabilidade uma... várias vezes.",
                                    "choices": [
                                        {
                                            "id": "706790112",
                                            "text": "Não vão ser difíceis demais de entender?",
                                            "response": [
                                                {
                                                    "id": "706790114",
                                                    "speaker": "Gygax",
                                                    "text": "Oh, não se preocupe. Tenho certeza que você vai adorar as coisas novas. Deixe-me explicar."
                                                },
                                                {
                                                    "id": "706790115",
                                                    "speaker": "Gygax",
                                                    "text": "Primeiro, nesse novo Labirinto de Vento, acrescentei algo chamado \"Dispositivo de Sinalização\"."
                                                },
                                                {
                                                    "id": "706790116",
                                                    "speaker": "Gygax",
                                                    "text": "Os cavaleiros Errantes só precisam ativar o Dispositivos de Sinalização 4 vezes, e assim podem derrotar o caçador e ganhar!"
                                                },
                                                {
                                                    "id": "706790117",
                                                    "speaker": "Gygax",
                                                    "text": "E quanto ao caçador... continua igual. Só precisa pegar todos os cavaleiros para ganhar."
                                                },
                                                {
                                                    "id": "706790118",
                                                    "speaker": "Gygax",
                                                    "text": "Mas dessa vez, quando um cavaleiro for pego pelo caçador, não vai imediatamente sair da partida, mas vai parar num lugar chamado \"Zona de Observação\"."
                                                },
                                                {
                                                    "id": "706790119",
                                                    "speaker": "Gygax",
                                                    "text": "Depois de um tempo, ou se outro cavaleiro ajudar, quem foi pego vai poder sair da Zona de Observação e continuar lutando contra o caçador."
                                                },
                                                {
                                                    "id": "706790120",
                                                    "speaker": "Gygax",
                                                    "text": "Entretanto, se quem foi pego antes for pego novamente... vai ser eliminado mesmo.",
                                                    "choices": [
                                                        {
                                                            "id": "706790121",
                                                            "text": "Parece complicado...",
                                                            "response": [
                                                                {
                                                                    "id": "706790123",
                                                                    "speaker": "Gygax",
                                                                    "text": "Não se preocupe. Parece complicado, mas você vai pegar o jeito depois de umas rodadas.",
                                                                    "choices": [
                                                                        {
                                                                            "id": "706790124",
                                                                            "text": "Claro, vou tentar.",
                                                                            "response": [
                                                                                {
                                                                                    "id": "706790125",
                                                                                    "speaker": "Gygax",
                                                                                    "text": "Certo, venha por aqui..."
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "706790126",
                                                                            "text": "Ainda tenho outro assunto para tratar.",
                                                                            "response": [
                                                                                {
                                                                                    "id": "706790127",
                                                                                    "speaker": "Gygax",
                                                                                    "text": "Tudo bem, venha quando tiver livre, ainda vou passar um tempo por aqui."
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "706790122",
                                                            "text": "Quantas regras novas..."
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "706790113",
                                            "text": "Você não adicionou nenhuma jogabilidade estranha não, né?"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "706790104",
                            "text": "Você é... o cara do Labirinto de Vento?",
                            "response": [
                                {
                                    "id": "706790105",
                                    "speaker": "Gygax",
                                    "text": "#Gygax! Mas você não está errad{F#a}{M#o}... e não é como se eu ficasse irritado porque o Labirinto de Vento é mais famoso que eu."
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}