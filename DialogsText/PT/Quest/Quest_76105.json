        {
            "id": "7610501",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "761050101",
                    "speaker": "Malta",
                    "text": "#{M#Moço}{F#Moça}, você viu aqueles Caranguejos de Pedra? Acho que eles tão fazendo algum tipo de ritual."
                },
                {
                    "id": "761050102",
                    "speaker": "Player",
                    "text": "Acho que é só como eles são."
                },
                {
                    "id": "761050103",
                    "speaker": "Malta",
                    "text": "Sério? Ah... Acho que entendi."
                },
                {
                    "id": "761050104",
                    "speaker": "Malta",
                    "text": "Tem muita gente na Cidade de Nasha como aqueles Caranguejos de Pedra. Alguns andam de braços dados, enquanto outros se cumprimentam com socos e chutes antes de se separarem."
                },
                {
                    "id": "761050105",
                    "speaker": "Malta",
                    "text": "Acho que é só o jeito das pessoas na Cidade de Nasha também!",
                    "choices": [
                        {
                            "id": "761050106",
                            "text": "Exatamente. Você pega as coisas rápido.",
                            "response": [
                                {
                                    "id": "761050108",
                                    "speaker": "Malta",
                                    "text": "#{M#Moço}{F#Moça}, você consegue fazer todos esses Caranguejos de Pedra entrarem no lago?"
                                },
                                {
                                    "id": "761050109",
                                    "speaker": "Malta",
                                    "text": "Hmm... tipo chamar todos os caçadores de tesouro pro Navio-Chefe? Seria tão divertido de assistir!"
                                },
                                {
                                    "id": "761051501",
                                    "speaker": "Malta",
                                    "text": "#Eu quero muito ver o que acontece quando todos os Caranguejos de Pedra se juntam... Hmm, {M#moço}{F#moça}, você tá livre agora?"
                                }
                            ]
                        },
                        {
                            "id": "761050107",
                            "text": "Parece que tem uma diferença pequena, mas tanto faz."
                        }
                    ]
                }
            ]
        },
        {
            "id": "7610503",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "761050301",
                    "speaker": "Player",
                    "text": "#Tô meio ocupad{M#o}{F#a}..."
