    "talks": [
        {
            "id": "7651001",
            "objective": "Fale com Edler e Wislawa",
            "dialogues": [
                {
                    "id": "765100101",
                    "speaker": "Edler",
                    "text": "Isso deve ser suficiente para provar que isso não é algum tipo de arma secreta."
                },
                {
                    "id": "765100102",
                    "speaker": "Wislawa",
                    "text": "Hmm... Sim, agora só precisa deixar mais resistente, e talvez assim seja uma ameaça para adultos também."
                },
                {
                    "id": "765100103",
                    "speaker": "Paimon",
                    "text": "Uau! A atmosfera tá toda tensa de novo, você não acha que elas..."
                },
                {
                    "id": "765100104",
                    "speaker": "Player",
                    "text": "Vão brigar?"
                },
                {
                    "id": "765100105",
                    "speaker": "Wislawa",
                    "text": "#Sim... Ei, {NICKNAME}, como você tá aqui, que tal nos ajudar sendo árbitro da luta?"
                },
                {
                    "id": "765100106",
                    "speaker": "Edler",
                    "text": "*Suspiro* Não sei de onde essa obsessão com lutas saiu. É por que eu venci você tão facilmente na última vez? Se é sobre isso, então só supere isso."
                },
                {
                    "id": "765100107",
                    "speaker": "Edler",
                    "text": "#{NICKNAME}, fique com seus olhos abertos e veja quem pisca primeiro!"
                },
                {
                    "id": "765100108",
                    "speaker": "Wislawa",
                    "text": "Hunf! Todas essas palavras vazias não vão te salvar!",
                    "choices": [
                        {
                            "id": "765100109",
                            "text": "Edler parece mais forte...",
                            "response": [
                                {
                                    "id": "765100111",
                                    "speaker": "Edler",
                                    "text": "..."
                                },
                                {
                                    "id": "765100112",
                                    "speaker": "Wislawa",
                                    "text": "..."
                                },
                                {
                                    "id": "765100113",
                                    "speaker": "Player",
                                    "text": "...!"
                                },
                                {
                                    "id": "765100114",
                                    "speaker": "Paimon",
                                    "text": "Uau! Elas não deviam estar só num amistoso?"
                                },
                                {
                                    "id": "765100115",
                                    "speaker": "Edler",
                                    "text": "Não é tarde demais para admitir sua derrota! Eu te dou três segundos..."
                                },
                                {
                                    "id": "765100116",
                                    "speaker": "Edler",
                                    "text": "Três, dois, um..."
                                },
                                {
                                    "id": "765100117",
                                    "speaker": "Paimon",
                                    "text": "Uau!"
                                },
                                {
                                    "id": "765100118",
                                    "speaker": "Black Screen",
                                    "text": "Há um barulho metálico seguido por um silêncio..."
                                },
                                {
                                    "id": "765100119",
                                    "speaker": "Edler",
                                    "text": "Tá tudo bem, Paimon, você pode abrir seus olhos..."
                                },
                                {
                                    "id": "765100120",
                                    "speaker": "Wislawa",
                                    "text": "Parece que a pessoa mais tensa aqui era você..."
                                },
                                {
                                    "id": "765100121",
                                    "speaker": "Paimon",
                                    "text": "O— O quê? Wislawa, você não se machucou!?",
                                    "choices": [
                                        {
                                            "id": "765100122",
                                            "text": "Edler apenas disparou um tiro de aviso.",
                                            "response": [
                                                {
                                                    "id": "765100124",
                                                    "speaker": "Edler",
                                                    "text": "Claro, não quero ficar presa em alguma prisão desconhecida..."
                                                },
                                                {
                                                    "id": "765100125",
                                                    "speaker": "Edler",
                                                    "text": "Eu tive que fazer um show. Mostrar a ela que não sou uma comerciante covarde que ela pode manipular facilmente."
                                                },
                                                {
                                                    "id": "765100126",
                                                    "speaker": "Edler",
                                                    "text": "Assim, da próxima vez que nos encontrarmos, ela vai parar para pensar duas vezes antes de causar problemas para mim."
                                                },
                                                {
                                                    "id": "765100127",
                                                    "speaker": "Paimon",
                                                    "text": "#Mas, {NICKNAME}, como você percebeu o que estava acontecendo? Você não parece nem um pouco nervos{F#a}{M#o}!",
                                                    "choices": [
                                                        {
                                                            "id": "765100128",
                                                            "text": "A expressão de Edler estava muito relaxada.",
                                                            "response": [
                                                                {
                                                                    "id": "765100130",
                                                                    "speaker": "Wislawa",
                                                                    "text": "Você é perspicaz. Uma ameaça bem colocada é o jeito mais rápido de fazer alguém se render. É uma pena que atalhos raramente são tão fáceis de pegar."
                                                                },
                                                                {
                                                                    "id": "765100131",
                                                                    "speaker": "Wislawa",
                                                                    "text": "#Sem falar que {NICKNAME} está aqui... Enfim, ainda estou de pé."
                                                                },
                                                                {
                                                                    "id": "765100132",
                                                                    "speaker": "Wislawa",
                                                                    "text": "Eu só espero que da próxima vez que nós nos encontrarmos, eu tenha a chance de..."
                                                                },
                                                                {
                                                                    "id": "765100133",
                                                                    "speaker": "Edler",
                                                                    "text": "Não comece com isso novamente. Quantas chances você acha que teremos de nos encontrar?"
                                                                },
                                                                {
                                                                    "id": "765100134",
                                                                    "speaker": "Edler",
                                                                    "text": "Se da próxima vez que eu te encontrar, você estiver de serviço, serei obrigada a responder apropriadamente a quaisquer ações que você fizer."
                                                                },
                                                                {
                                                                    "id": "765100135",
                                                                    "speaker": "Edler",
                                                                    "text": "Mas se você estiver de férias novamente, vamos jogar mais um ou dois Jogos de Guerra — pelo bem dos meus negócios."
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "765100129",
                                                            "text": "A própria Edler disse: \"Vamos ver quem pisca primeiro.\""
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "765100123",
                                            "text": "Não havia balas no mosquete."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "765100110",
                            "text": "Wislawa parece maior..."
                        }
                    ]
                }
            ]
        }
    ]
