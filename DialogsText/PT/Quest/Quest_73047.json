    "talks": [
        {
            "id": "7304701",
            "objective": "",
            "dialogues": [
                {
                    "id": "730470101",
                    "speaker": "Araja",
                    "text": "#Nara {NICKNAME}, Paimon, voltamos a encontrar..."
                },
                {
                    "id": "730470102",
                    "speaker": "Paimon",
                    "text": "Parece que Araja está muito contente!"
                },
                {
                    "id": "730470103",
                    "speaker": "Araja",
                    "text": "Ohhhh... eu estou tão feliz por ver Vanarana tão animada e tantos Aranaras voltaram para casa. Infelizmente, nunca pensei poder participar do Festival Utsava pessoalmente...",
                    "choices": [
                        {
                            "id": "730470104",
                            "text": "Nunca participou?",
                            "response": [
                                {
                                    "id": "730470107",
                                    "speaker": "Araja",
                                    "text": "As histórias dizem que participei sim. Foi há muito, muito tempo atrás..."
                                },
                                {
                                    "id": "730470108",
                                    "speaker": "Araja",
                                    "text": "Eu, Aramuhukunda, Arana, Araji... Muitos nós Aranara juntamente com Nara Varuna celebrávamos o Festival Utsava."
                                },
                                {
                                    "id": "730470109",
                                    "speaker": "Araja",
                                    "text": "Eram tempos difíceis. Mas durante o Festival Utsava, ríamos e cantávamos. Eu gosto dessa história."
                                },
                                {
                                    "id": "730470110",
                                    "speaker": "Paimon",
                                    "text": "Mas Araja nunca participou...?"
                                },
                                {
                                    "id": "730470111",
                                    "speaker": "Araja",
                                    "text": "Participei mesmo, segundo as histórias. Mas eu já não me lembro. Essas histórias foram todas contadas por Arana e os outros depois."
                                },
                                {
                                    "id": "730470112",
                                    "speaker": "Paimon",
                                    "text": "Hmmm.... parece que Araja está falando como um vovô, provavelmente porque é velho demais para se lembrar!"
                                },
                                {
                                    "id": "730470113",
                                    "speaker": "Araja",
                                    "text": "#Talvez isso também seja bom... Seja como for, Nara {NICKNAME}, Paimon, gostariam de levar isto?"
                                },
                                {
                                    "id": "730470114",
                                    "speaker": "Paimon",
                                    "text": "Esta pequena flor..."
                                },
                                {
                                    "id": "730470115",
                                    "speaker": "Araja",
                                    "text": "Que esta flor permaneça com você em sua futura viagem.",
                                    "choices": [
                                        {
                                            "id": "730470116",
                                            "text": "Eu aceito.",
                                            "response": [
                                                {
                                                    "id": "730470118",
                                                    "speaker": "Araja",
                                                    "text": "O tempo de Nara é muito mais precioso do que o de Aranara, por isso não vou mais atrapalhá-los, aproveitem. Mais tarde, procurem por Arakavi, ele também está se preparando para os rituais do Festival Utsava."
                                                }
                                            ]
                                        },
                                        {
                                            "id": "730470117",
                                            "text": "#Obrigad{M#o}{F#a}."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "730470105",
                            "text": "Também estou feliz.",
                            "response": [
                                {
                                    "id": "730470106",
                                    "speaker": "Paimon",
                                    "text": "Também estou feliz! Mas Araja nunca participou do Festival Utsava?"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
