                    "speaker": "Qucussauro",
                    "text": "..."
                },
                {
                    "id": "750280602",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "Rawr... Rawr!"
                },
                {
                    "id": "750280603",
                    "speaker": "Paimon",
                    "text": "Parece meio revigorado?"
                },
                {
                    "id": "750280605",
                    "speaker": "Paimon",
                    "text": "Heh. Voou rapidinho... Paimon acha que ainda não confia na gente, né?",
                    "choices": [
                        {
                            "id": "750280606",
                            "text": "Coisas como confiança não se constroem do dia para a noite.",
                            "response": [
                                {
                                    "id": "750280607",
                                    "speaker": "Paimon",
                                    "text": "#Verdade. A gente teve que dar duro para chegar onde estamos com {REALNAME[ID(2)|SHOWHOST(true)]} também!"
                                },
                                {
                                    "id": "750280610",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "Rawr! Rawr rawr!"
                                },
                                {
                                    "id": "750280611",
                                    "speaker": "Paimon",
                                    "text": "#E não é como se a gente tivesse feito isso pela gratidão dele ou nada, não acha, {REALNAME[ID(2)|SHOWHOST(true)]}?"
                                },
                                {
                                    "id": "750280612",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "Rawr!"
                                },
                                {
                                    "id": "750280613",
                                    "speaker": "Paimon",
                                    "text": "#Hehe, você é um Saurianinho generoso, não é? Exatamente como {NICKNAME}!"
                                }
                            ]
                        },
                        {
                            "id": "750280608",
                            "text": "Parece que vai voar com as próprias energias de boa.",
                            "response": [
                                {
                                    "id": "750280609",
                                    "speaker": "Paimon",
                                    "text": "#Vai mesmo. Ótima ideia, {REALNAME[ID(2)|SHOWHOST(true)]}!"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
