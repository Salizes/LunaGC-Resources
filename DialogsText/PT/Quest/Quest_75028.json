        },
        {
            "id": "7502804",
            "objective": "Veja o que seu amigo Sauriano encontrou",
            "dialogues": [
                {
                    "id": "750280401",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "Raawr! Rawr!"
                },
                {
                    "id": "750280402",
                    "speaker": "Paimon",
                    "text": "Você acha que Flores Núcleo de Brasas vão ajudar?"
                },
                {
                    "id": "750280403",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "Rawr!"
                },
                {
                    "id": "750280404",
