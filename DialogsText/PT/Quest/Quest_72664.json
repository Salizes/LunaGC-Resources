    "talks": [
        {
            "id": "7266401",
            "objective": "Fale com Linyang",
            "dialogues": [
                {
                    "id": "726640101",
                    "speaker": "Linyang",
                    "text": "Hmm... Preciso colocar outro lote de baús do tesouro, não é..."
                },
                {
                    "id": "726640102",
                    "speaker": "Player",
                    "text": "Ouvi alguém dizer, \"baús do tesouro\"?"
                },
                {
                    "id": "726640103",
                    "speaker": "Linyang",
                    "text": "Hã? Oh, é... É você, Viajante! Você está aqui para participar do Festival da Caça à Lua também?"
                },
                {
                    "id": "726640104",
                    "speaker": "Player",
                    "text": "Pode-se dizer que sim."
                },
                {
                    "id": "726640105",
                    "speaker": "Linyang",
                    "text": "Então você chegou na hora certa! A Guilda de Aventureiros está organizando um evento para celebrar o festival."
                },
                {
                    "id": "726640106",
                    "speaker": "Linyang",
                    "text": "Gostaria de saber mais?",
                    "choices": [
                        {
                            "id": "726640107",
                            "text": "De que atividades estamos falando?",
                            "response": [
                                {
                                    "id": "726640110",
                                    "speaker": "Linyang",
                                    "text": "Durante o Festival da Caça à Lua, a Guilda colocou vários Amuletos de Caça à Lua por vários lugares."
                                },
                                {
                                    "id": "726640111",
                                    "speaker": "Linyang",
                                    "text": "Aqueles que encontram estes Amuletos podem trazê-los de volta para nós em troca de várias recompensas."
                                },
                                {
                                    "id": "726640112",
                                    "speaker": "Linyang",
                                    "text": "Também despachamos um grupo de aventureiros para colocar um grande lote de baús especiais de tesouros espalhados pela natureza."
                                },
                                {
                                    "id": "726640113",
                                    "speaker": "Linyang",
                                    "text": "Estes baús especiais do tesouro virão cheios de todo tipo de coisas boas, que nós preparamos justamente para esta ocasião!"
                                },
                                {
                                    "id": "726640114",
                                    "speaker": "Linyang",
                                    "text": "Além dessas duas atividades, temos também alguns desafios difíceis preparados para os aventureiros de elite!"
                                },
                                {
                                    "id": "726640115",
                                    "speaker": "Linyang",
                                    "text": "Quanto aos detalhes, é... Bem, envolve invadir uma série de acampamentos de monstros...",
                                    "choices": [
                                        {
                                            "id": "726640116",
                                            "text": "E o que isso tem a ver com o festival?",
                                            "response": [
                                                {
                                                    "id": "726640118",
                                                    "speaker": "Linyang",
                                                    "text": "Aha... Ahaha... Bem, uh, você não precisa dizer dessa forma..."
                                                },
                                                {
                                                    "id": "726640119",
                                                    "speaker": "Linyang",
                                                    "text": "Há prêmios a serem ganhos por derrotar esses monstros!"
                                                },
                                                {
                                                    "id": "726640120",
                                                    "speaker": "Player",
                                                    "text": "Isso não é muito diferente das comissões normais, qual é..."
                                                },
                                                {
                                                    "id": "726640121",
                                                    "speaker": "Linyang",
                                                    "text": "...Por favor, nos ajude! A maioria de nossos aventureiros já partiu para aproveitar o festival, e muitas de nossas comissões estão ali paradas, sem ninguém para fazê-las."
                                                },
                                                {
                                                    "id": "726640122",
                                                    "speaker": "Linyang",
                                                    "text": "Apenas nos dê uma mãozinha! Com suas habilidades, será facílimo, não é mesmo?",
                                                    "choices": [
                                                        {
                                                            "id": "726640123",
                                                            "text": "Oh, tudo bem...",
                                                            "response": [
                                                                {
                                                                    "id": "726640125",
                                                                    "speaker": "Linyang",
                                                                    "text": "#Cl-Claro, você será recompensad{M#o}{F#a} apropriadamente, Viajante, não se preocupe!"
                                                                },
                                                                {
                                                                    "id": "726640126",
                                                                    "speaker": "Linyang",
                                                                    "text": "Estarei aqui durante todo o Festival da Caça à Lua. Se você tiver alguma pergunta, basta me fazer diretamente."
                                                                },
                                                                {
                                                                    "id": "726640127",
                                                                    "speaker": "Linyang",
                                                                    "text": "Estamos contando com você, Viajante. Bem, então... Aproveite o festival!"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "726640124",
                                                            "text": "É melhor já ter o pagamento pronto."
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "726640117",
                                            "text": "Isso não tem nada a ver com o Festival da Caça à Lua!"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "726640108",
                            "text": "Oh não, as diárias não. Tudo menos as diárias...",
                            "response": [
                                {
                                    "id": "726640109",
                                    "speaker": "Linyang",
                                    "text": "Não, não! Essa atividade é tipo uma aventura!"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
