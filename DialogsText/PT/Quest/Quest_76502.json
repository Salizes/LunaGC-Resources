    "talks": [
        {
            "id": "7650201",
            "objective": "",
            "dialogues": [
                {
                    "id": "765020101",
                    "speaker": "Aino",
                    "text": "#Ei, é você, {NICKNAME}! E Paimon também! E aí? Tudo bem? Precisam da minha genialidade para alguma super hiper mega comissão?"
                },
                {
                    "id": "765020102",
                    "speaker": "Aino",
                    "text": "Olha só, vou te dar um descontinho de amiga de vinte por cento pelos meus serviços! É só me trazer uns lanchinhos... Ah, e não conta isso pra Ineffa, tá bom?",
                    "choices": [
                        {
                            "id": "765020103",
                            "text": "Nós só estamos dando uma olhada.",
                            "response": [
                                {
                                    "id": "765020105",
                                    "speaker": "Aino",
                                    "text": "Hehe, então você veio pro lugar mais certíssimo de todos! Minha oficina é cento e dez por cento brilhante-maravilhinda em massa. Duvido que ache outra melhor por aí, pode apostar sua última Mora!"
                                },
                                {
                                    "id": "765020106",
                                    "speaker": "Aino",
                                    "text": "Só cuidado por onde pisa e tal, senão alguma peça ou outra pode te fazer dar de cara no chão, viu.",
                                    "choices": [
                                        {
                                            "id": "765020107",
                                            "text": "Esse robô parece bem... único.",
                                            "response": [
                                                {
                                                    "id": "765020109",
                                                    "speaker": "Aino",
                                                    "text": "Hehe! Que achou? Marreco Marreta, é o nome dele. Criei ele pra separar lixo e sucata."
                                                },
                                                {
                                                    "id": "765020110",
                                                    "speaker": "Aino",
                                                    "text": "Mas, ah, acabei fazendo ele resistente demais, e os braços de alavanca, mega ágeis. Aí pensei: \"Eh, por que não dar defesas ultra-mega-turbinadas também?\""
                                                },
                                                {
                                                    "id": "765020111",
                                                    "speaker": "Aino",
                                                    "text": "Assim, qualquer malandrinho que tentar dar uma de espertinho na minha oficina vira lixo não reciclável, facinho!"
                                                },
                                                {
                                                    "id": "765020112",
                                                    "speaker": "Paimon",
                                                    "text": "Suas ideias continuam tão malucas quanto sempre, né?",
                                                    "choices": [
                                                        {
                                                            "id": "765020113",
                                                            "text": "Bem, já que a oportunidade apareceu...",
                                                            "response": [
                                                                {
                                                                    "id": "765020115",
                                                                    "speaker": "Aino",
                                                                    "text": "M-Minha? Com o Marreco Marreta? B—Bom, uh, o pessoal geralmente se interessa pelas minhas invenções. Não tiram muitas fotos minhas, na real..."
                                                                },
                                                                {
                                                                    "id": "765020116",
                                                                    "speaker": "Aino",
                                                                    "text": "Mas se quiser capturar essa jovem prodígio e sua melhor e imbatível robô de batalha em ação com seu Aparelho Fotográfico, pode... É, pode super fazer isso!"
                                                                },
                                                                {
                                                                    "id": "765020117",
                                                                    "speaker": "Aino",
                                                                    "text": "É só que... eu não costumo tirar fotos de mim mesma, então não manjo muito dessas coisas de parecer estilosa e tal... Não sei se as fotos vão ficar boas, sabe...",
                                                                    "choices": [
                                                                        {
                                                                            "id": "765020118",
                                                                            "text": "Apenas seja você mesma.",
                                                                            "response": [
                                                                                {
                                                                                    "id": "765020120",
                                                                                    "speaker": "Aino",
                                                                                    "text": "Ótimo! Então é contigo! Não esquece de pegar o Marreco Marreta no auge da sua imponência também!"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "765020119",
                                                                            "text": "Vou garantir apertar o botão na hora em que você estiver no seu melhor!"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "765020114",
                                                            "text": "Podemos tirar uma foto sua?"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "765020108",
                                            "text": "É um dos seus?"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "765020104",
                            "text": "E procurando algum material para fotos enquanto estamos nisso."
                        }
                    ]
                }
            ]
        },
        {
            "id": "7650204",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "765020401",
                    "speaker": "Aino",
                    "text": "Ei, ei, já vamos começar? Eu, uh... Ugh. Anda, coração, para de tentar pular do meu peito!"
                }
            ]
        },
        {
            "id": "7650205",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "765020501",
                    "speaker": "Player",
                    "text": "Tudo pronto. Que comece a sessão de fotos!"
                }
            ]
        },
        {
            "id": "7650206",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "765020601",
                    "speaker": "Player",
                    "text": "Um momento. A inspiração ainda não chegou..."
                }
            ]
        },
        {
            "id": "7650207",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "765020701",
                    "speaker": "Aino",
                    "text": "#Ei, é você, {NICKNAME}! E Paimon também! E aí? Tudo bem? Precisam da minha genialidade para alguma super hiper mega comissão?",
                    "choices": [
                        {
                            "id": "765020702",
                            "text": "Nós só estamos dando uma olhada.",
                            "response": [
                                {
                                    "id": "765020704",
                                    "speaker": "Aino",
                                    "text": "Claro! Minha oficina está cheia de coisas brilhantes! Mas, onde está o seu Aparelho Fotográfico? Você esqueceu ele em algum lugar?"
                                }
                            ]
                        },
                        {
                            "id": "765020703",
                            "text": "E procurando algum material para fotos enquanto estamos nisso."
                        }
                    ]
                }
            ]
        },
        {
            "id": "7650208",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "765020801",
                    "speaker": "Aino",
                    "text": "Como vai? Encontrou algo que queira fotografar? Se não, precisa de sugestões?",
                    "choices": [
                        {
                            "id": "765020803",
                            "text": "Tudo pronto. Que comece a sessão de fotos!",
                            "response": [
                                {
                                    "id": "765020804",
                                    "speaker": "Aino",
                                    "text": "Legal! Mas, uh, cade seu Aparelho Fotográfico? Você esqueceu de trazer ele?"
                                }
                            ]
                        },
                        {
                            "id": "765020802",
                            "text": "Um momento. A inspiração ainda não chegou..."
                        }
                    ]
                }
            ]
