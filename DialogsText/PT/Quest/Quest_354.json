        {
            "id": "35402",
            "objective": "Fale com a garota alegre",
            "dialogues": [
                {
                    "id": "3540401",
                    "speaker": "???",
                    "text": "#Que o Arconte Anemo proteja você, forasteir{F#a}{M#o}!"
                },
                {
                    "id": "3540402",
                    "speaker": "Amber",
                    "text": "Eu sou a Amber, a Aventureira dos Cavaleiros de Favonius."
                },
                {
                    "id": "3540403",
                    "speaker": "Amber",
                    "text": "Vocês não parecem cidadãos de Mondstadt. Apresentem-se!"
                },
                {
                    "id": "3540404",
                    "speaker": "Paimon",
                    "text": "Calma, não estamos aqui para causar problemas."
                },
                {
                    "id": "3540405",
                    "speaker": "Amber",
                    "text": "Isso é o que pessoas suspeitas sempre falam."
                },
                {
                    "id": "3540406",
                    "speaker": "Player",
                    "text": "#Olá, eu me chamo {NICKNAME}."
                },
                {
                    "id": "3540407",
                    "speaker": "Amber",
                    "text": "... Isso não me soa um nome local."
                },
                {
                    "id": "3540408",
                    "speaker": "Amber",
                    "text": "E... Essa mascote? Quem é ela?",
                    "choices": [
                        {
                            "id": "3540409",
                            "text": "#Nós somos amig{M#o}{F#a}s.",
                            "response": [
                                {
                                    "id": "3540410",
                                    "speaker": "Paimon",
                                    "text": "#Digo, temos viajado junt{M#o}{F#a}s há 2 meses, mas..."
                                },
                                {
                                    "id": "3540411",
                                    "speaker": "Paimon",
                                    "text": "#Já viramos melhores {F#amigas}{M#amigos}!"
                                },
                                {
                                    "id": "3540414",
                                    "speaker": "Amber",
                                    "text": "De qualquer forma, são viajantes, certo?"
                                },
                                {
                                    "id": "3540415",
                                    "speaker": "Amber",
                                    "text": "Há um dragão gigante que foi visto ao redor de Mondstadt recentemente. É melhor vocês entrarem na cidade o mais rápido possível."
                                },
                                {
                                    "id": "3540416",
                                    "speaker": "Amber",
                                    "text": "#Não é muito longe daqui, vou escoltá-{F#las}{M#los} até lá."
                                },
                                {
                                    "id": "3540417",
                                    "speaker": "Paimon",
                                    "text": "Hum? Você não saiu da cidade para resolver outras coisas?"
                                },
                                {
                                    "id": "3540418",
                                    "speaker": "Amber",
                                    "text": "Sim, mas não se preocupem. Eu posso manter a segurança de vocês enquanto faço outras coisas também."
                                },
                                {
                                    "id": "3540419",
                                    "speaker": "Amber",
                                    "text": "Além disso... Eu ainda não tenho certeza se posso confiar em vocês.",
                                    "choices": [
                                        {
                                            "id": "3540420",
                                            "text": "Parece que você não confia em nós ainda.",
                                            "response": [
                                                {
                                                    "id": "3540422",
                                                    "speaker": "Amber",
                                                    "text": "Err... Desculpe! Isso provavelmente não é algo que eu devia falar como uma cavaleira."
                                                },
                                                {
                                                    "id": "3540423",
                                                    "speaker": "Amber",
                                                    "text": "#Me desculpem, ugh... Viajantes {M#estrangeiros}{F#estrangeiras}, porém de respeito."
                                                },
                                                {
                                                    "id": "3540424",
                                                    "speaker": "Paimon",
                                                    "text": "Isso foi tão falso!"
                                                },
                                                {
                                                    "id": "3540425",
                                                    "speaker": "Amber",
                                                    "text": "Você tem algo contra com a linguagem usada entre os Cavaleiros de Favonius?!"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "3540421",
                                            "text": "Essa não é a melhor forma de dar boas-vindas aos visitantes."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "3540412",
                            "text": "Comida de emergência.",
                            "response": [
                                {
                                    "id": "3540413",
                                    "speaker": "Paimon",
                                    "text": "Ei! Isso é pior do que ser a sua mascote!"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
