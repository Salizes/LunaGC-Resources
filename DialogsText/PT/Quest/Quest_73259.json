            "dialogues": [
                {
                    "id": "732590201",
                    "speaker": "Player",
                    "text": "Certo. Do que vamos brincar?"
                },
                {
                    "id": "732590202",
                    "speaker": "Aragita",
                    "text": "Aragita escondeu todos os tipos de pinturas sob os baús de madeira para ver se Nara tem a habilidade de \"nunca esquecer.\" Lembra <color=#00E1FFFF>da pintura com mais pinceladas</color>?"
                },
                {
                    "id": "732590203",
                    "speaker": "Player",
                    "text": "Beleza, vamos nessa."
                }
            ]
        },
        {
            "id": "7325903",
            "objective": "",
            "dialogues": [
                {
                    "id": "732590301",
                    "speaker": "Player",
                    "text": "Não é o momento certo."
                },
                {
                    "id": "732590302",
                    "speaker": "Aragita",
                    "text": "Aragita não vai se apressar. Vai esperar pelo \"momento certo\"."
                }
            ]
        },
        {
            "id": "7325904",
            "objective": "",
            "dialogues": [
                {
                    "id": "732590401",
                    "speaker": "Aragita",
                    "text": "#Grama e árvores se lembram, assim como Nara. Nara é amig{F#a}{M#o} de Aranara e amig{F#a}{M#o} da grama e das árvores também."
                }
            ]
        },
        {
            "id": "7325905",
            "objective": "",
            "dialogues": [
                {
                    "id": "732590501",
                    "speaker": "Aragita",
                    "text": "Nara errou, mas não importa. Há um monte de \"próxima vez\". Qualquer momento jogando com Nara é \"o momento certo\" para Aragita."
                }
            ]
        },
        {
            "id": "7325901",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "732590101",
                    "speaker": "Aragita",
                    "text": "#Aragita esperou muito tempo pel{F#a}{M#o} Nara dourad{F#a}{M#o} e você finalmente chegou. Não posso deixar essa oportunidade escapar. Vamos brincar?"
                }
            ]
        }
    ]
