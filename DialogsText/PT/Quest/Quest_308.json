    "talks": [
        {
            "id": "30800",
            "objective": "Encontre a Lisa no templo.",
            "dialogues": []
        },
        {
            "id": "30801",
            "objective": "Fale com a Lisa",
            "dialogues": [
                {
                    "id": "3081101",
                    "speaker": "Lisa",
                    "text": "Olá, fofura."
                },
                {
                    "id": "3081102",
                    "speaker": "Lisa",
                    "text": "Você vai me ajudar também? Muito gentil da sua parte."
                },
                {
                    "id": "3081103",
                    "speaker": "Lisa",
                    "text": "Não hesite em me procurar para o que precisar.",
                    "choices": [
                        {
                            "id": "3081104",
                            "text": "Que tipo de coisas uma bibliotecária faz?",
                            "response": [
                                {
                                    "id": "3081105",
                                    "speaker": "Lisa",
                                    "text": "Essa é uma boa pergunta."
                                },
                                {
                                    "id": "3081106",
                                    "speaker": "Lisa",
                                    "text": "Basicamente, são trabalhos que não exigem esforço físico e mental."
                                },
                                {
                                    "id": "3081107",
                                    "speaker": "Paimon",
                                    "text": "Então, o que está faltando?"
                                },
                                {
                                    "id": "3081111",
                                    "speaker": "Lisa",
                                    "text": "Por isso, você também deveria."
                                }
                            ]
                        },
                        {
                            "id": "3081108",
                            "text": "Por que uma bibliotecária estaria nas ruínas...?",
                            "response": [
                                {
                                    "id": "3081109",
                                    "speaker": "Lisa",
                                    "text": "Essa é uma boa pergunta."
                                },
                                {
                                    "id": "3081110",
                                    "speaker": "Lisa",
                                    "text": "Bem, porque a Jean confia em mim."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "30802",
            "objective": "Entre no templo.",
            "dialogues": []
        },
        {
            "id": "30810",
            "objective": "Fale com a Lisa",
            "dialogues": [
                {
                    "id": "3081201",
                    "speaker": "Lisa",
                    "text": "Vou tentar levar isso um pouco mais a sério."
                }
            ]
        },
        {
            "id": "30803",
            "objective": "Explore as profundezas do templo.",
            "dialogues": []
        },
        {
            "id": "30814",
            "objective": "",
            "dialogues": [
                {
                    "id": "3081401",
                    "speaker": "Lisa",
                    "text": "O Dragão do Leste, o Leão do Sul, o Lobo do Norte, o Falcão do Oeste..."
                },
                {
                    "id": "3081402",
                    "speaker": "Lisa",
                    "text": "Eles são os Quatro Ventos de Mondstadt, afiliados ao Barbatos, o Deus Anemo."
                },
                {
                    "id": "3081403",
                    "speaker": "Lisa",
                    "text": "Dvalin. É o nome verdadeiro do Stormterror."
                },
                {
                    "id": "3081404",
                    "speaker": "Lisa",
                    "text": "Antes de todo mundo chamá-lo de \"Stormterror\", ele era conhecido como o Dragão do Leste."
                },
                {
                    "id": "3081405",
                    "speaker": "Lisa",
                    "text": "Então, agora você sabe por que o Dvalin é capaz apenas de canalizar três dos poderes dos Quatro Ventos."
                },
                {
                    "id": "3081406",
                    "speaker": "Lisa",
                    "text": "Porque desde o começo ele estava se consumindo.",
                    "choices": [
                        {
                            "id": "3081407",
                            "text": "Por quê?",
                            "response": [
                                {
                                    "id": "3081409",
                                    "speaker": "Lisa",
                                    "text": "Eu acho que é devido a sua raiva."
                                },
                                {
                                    "id": "3081410",
                                    "speaker": "Paimon",
                                    "text": "Raiva...?"
                                },
                                {
                                    "id": "3081411",
                                    "speaker": "Lisa",
                                    "text": "Raiva de Mondstadt."
                                },
                                {
                                    "id": "3081412",
                                    "speaker": "Lisa",
                                    "text": "A raiva o tornou em algo mais poderoso que o próprio vento - tornando-se em Stormterror."
                                },
                                {
                                    "id": "3081413",
                                    "speaker": "Paimon",
                                    "text": "Mas porque um dos Quatro Ventos..."
                                },
                                {
                                    "id": "3081414",
                                    "speaker": "Paimon",
                                    "text": "Odiaria a cidade que devia proteger?"
                                },
                                {
                                    "id": "3081415",
                                    "speaker": "Lisa",
                                    "text": "..."
                                },
                                {
                                    "id": "3081416",
                                    "speaker": "Lisa",
                                    "text": "Como habitante de Mondstadt, é difícil falar desse assunto."
                                },
                                {
                                    "id": "3081417",
                                    "speaker": "Lisa",
                                    "text": "Pegue isto. É uma história que aconteceu muito tempo atrás."
                                }
                            ]
                        },
                        {
                            "id": "3081408",
                            "text": "Por que ele chegaria até este ponto?"
                        }
                    ]
                }
            ]
        },
        {
            "id": "30804",
            "objective": "Sair do Domínio",
            "dialogues": []
        },
        {
            "id": "30813",
