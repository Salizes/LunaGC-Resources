            "dialogues": [
                {
                    "id": "3081301",
                    "speaker": "Lisa",
                    "text": "Mesmo que esteja aqui fora, posso sentir uma perturbação no fluxo elemental lá dentro."
                },
                {
                    "id": "3081302",
                    "speaker": "Lisa",
                    "text": "Vamos retornar este templo ao seu estado normal para eu poder ficar mais tranquila."
                }
