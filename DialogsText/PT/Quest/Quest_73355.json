    "talks": [
        {
            "id": "7335501",
            "objective": "Vá para o Porto Bada",
            "dialogues": [
                {
                    "id": "733550101",
                    "speaker": "Paimon",
                    "text": "Ei, um Cogumelo acabou de passar voando. Você tem certeza que não tem problema?"
                },
                {
                    "id": "733550102",
                    "speaker": "Paimon",
                    "text": "Geralmente, ter um Cogumelo flutuando pela cidade é bem perigoso! A não ser que seja um especial que tenha sido treinado..."
                },
                {
                    "id": "733550103",
                    "speaker": "Paimon",
                    "text": "Espera, por que isso parece familiar? A gente já passou por algo assim antes?",
                    "choices": [
                        {
                            "id": "733550104",
                            "text": "Espera, é o Cabeça de Bongô?",
                            "response": [
                                {
                                    "id": "733550105",
                                    "speaker": "Paimon",
                                    "text": "Isso mesmo! Cabeça de Bongô! Nosso cogumigo de Sumeru!"
                                },
                                {
                                    "id": "733550106",
                                    "speaker": "Paimon",
                                    "text": "Aaaaah! Há quanto tempo a gente não se vê! Vamos dar um oi!"
                                }
                            ]
                        },
                        {
                            "id": "733550107",
                            "text": "Quais especiais?",
                            "response": [
                                {
                                    "id": "733550108",
                                    "speaker": "Paimon",
                                    "text": "Eu acho que o Cabeça de Bongô? Nosso cogumigo de Sumeru!"
                                },
                                {
                                    "id": "733550109",
                                    "speaker": "Paimon",
                                    "text": "Aaaaah! Há quanto tempo a gente não se vê! Vamos dar um oi!"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7335502",
            "objective": "Fale com Haniyyah",
            "dialogues": [
                {
                    "id": "733550201",
                    "speaker": "Haniyyah",
                    "text": "Hmm? Parece que não preciso deixar uma mensagem na Guilda de Aventureiros. O destino sempre nos reunirá."
                },
                {
                    "id": "733550202",
                    "speaker": "Haniyyah",
                    "text": "Finalmente, nos encontramos novamente, Cometa Dourado, Parceira de Prata."
                },
                {
                    "id": "733550203",
                    "speaker": "Haniyyah",
                    "text": "#Ver vocês radiantes e chei{F#as}{M#os} de energia me dá uma ótima sensação de que o tempo parou.",
                    "choices": [
                        {
                            "id": "733550204",
                            "text": "Há quanto tempo, Haniyyah!",
                            "response": [
                                {
                                    "id": "733550205",
                                    "speaker": "Paimon",
                                    "text": "Haniyyah, Cabeça de Bongô, são vocês!"
                                },
                                {
                                    "id": "733550206",
                                    "speaker": "Paimon",
                                    "text": "Não foi à toa que Paimon achou que isso era familiar... isso quer dizer que o laço entre Paimon e Cabeça de Bongô ainda existe!"
                                },
                                {
                                    "id": "733550207",
                                    "speaker": "Cabeça de Bongô",
                                    "text": "♪~"
                                },
                                {
                                    "id": "733550212",
                                    "speaker": "Haniyyah",
                                    "text": "Imaginei muitos jeitos que poderíamos nos reencontrar. Um grande banquete, uma festa de boas-vindas criativa, ou algo que realmente surpreendesse vocês."
                                },
                                {
                                    "id": "733550213",
                                    "speaker": "Haniyyah",
                                    "text": "#Mas, no final, tudo parecia meio formal. Vocês estavam ocupad{F#as}{M#os}, e eu fiquei preocupada que poderia tomar muito de seu tempo."
                                },
                                {
                                    "id": "733550214",
                                    "speaker": "Haniyyah",
                                    "text": "Além disso, nossos cogumigos gostam de ambientes calmos. Por isso, vamos nos reencontrar de um jeito relaxado."
                                },
                                {
                                    "id": "733550215",
                                    "speaker": "Souka",
                                    "text": "Isso mesmo! A prosa de Haniyyah finalmente valeu a pena. Uma calma mental é ótimo para a vida!"
                                },
                                {
                                    "id": "733550216",
                                    "speaker": "Souka",
                                    "text": "Jogar conversa fora é o melhor jeito de ir levando a vida."
                                },
                                {
                                    "id": "733550217",
                                    "speaker": "Pyroalegria",
                                    "text": "♫~"
                                },
                                {
                                    "id": "733550218",
                                    "speaker": "Paimon",
                                    "text": "Souka está aqui também, e Pyroalegria... e quem é esse?"
                                },
                                {
                                    "id": "733550219",
                                    "speaker": "Souka",
                                    "text": "Esse aqui é o meu cogumigo Dançarino da Brisa. Vocês e o Cabeça de Bongô nos derrotaram nas classificatórias."
                                },
                                {
                                    "id": "733550220",
                                    "speaker": "Paimon",
                                    "text": "Hehehe, você lembra bem...",
                                    "choices": [
                                        {
                                            "id": "733550221",
                                            "text": "Parece cada vez mais familiar...",
                                            "response": [
                                                {
                                                    "id": "733550223",
                                                    "speaker": "Souka",
                                                    "text": "Enfim, como vocês podem ver, não tivemos tempo de organizar o espaço para nosso próximo encontro..."
                                                },
                                                {
                                                    "id": "733550224",
                                                    "speaker": "Souka",
                                                    "text": "Eu e Haniyyah compramos esse distrito comercial e o transformamos no Parque de Diversões dos Cogumigos!"
                                                },
                                                {
                                                    "id": "733550225",
                                                    "speaker": "Paimon",
                                                    "text": "Espera, então você tá dizendo que essas instalações daqui não são alugadas para o novo jogo de mesa, mas..."
                                                },
                                                {
                                                    "id": "733550226",
                                                    "speaker": "Haniyyah",
                                                    "text": "Isso mesmo. De agora em diante, vamos viver no Porto Bada, e vamos promover o jogo de mesa dos cogumelos, bem como compartilhar nossa teoria de como se comunicar com animais."
                                                },
                                                {
                                                    "id": "733550227",
                                                    "speaker": "Haniyyah",
                                                    "text": "Fique à vontade para aparecer por aqui e brincar com os Cogumigos quando estiver livre!"
                                                },
                                                {
                                                    "id": "733550228",
                                                    "speaker": "Cabeça de Bongô",
                                                    "text": "♪~",
                                                    "choices": [
                                                        {
                                                            "id": "733550229",
                                                            "text": "Uhul! Cogumigos!",
                                                            "response": [
                                                                {
                                                                    "id": "733550231",
                                                                    "speaker": "Paimon",
                                                                    "text": "Isso é uma das melhores coisas que Paimon ouviu hoje!"
                                                                },
                                                                {
                                                                    "id": "733550232",
                                                                    "speaker": "Paimon",
                                                                    "text": "Depois do primeiro Torneio de Cogumelos, Paimon pensou em tantas ideias para se divertir com o Cabeça de Bongô. Agora vamos poder realizar todas!"
                                                                },
                                                                {
                                                                    "id": "733550233",
                                                                    "speaker": "Paimon",
                                                                    "text": "É só uma pena que não trouxemos nenhum lanche para os Cogumigos... Seria tão legal se pudéssemos sentar na mesa com eles para comer um monte!"
                                                                },
                                                                {
                                                                    "id": "733550234",
                                                                    "speaker": "Haniyyah",
                                                                    "text": "Não precisa se preocupar com isso. No meu estudo \"Sobre Comunidades de Cogumelos\", pesquisei até os fundamentos de que tipos de comidas os cogumelos gostam."
                                                                },
                                                                {
                                                                    "id": "733550235",
                                                                    "speaker": "Haniyyah",
                                                                    "text": "Meu objetivo é identificar ingredientes que tanto humanos como cogumelos possam comer, assim nossos cogumigos não vão precisar passar o ano inteiro comendo só Geleia Maravilhosa."
                                                                },
                                                                {
                                                                    "id": "733550236",
                                                                    "speaker": "Haniyyah",
                                                                    "text": "Um dia, descobrirei os ingredientes que satisfazem tanto os gostos humanos e de cogumelos, e farei pratos deliciosos que todos nós podemos aproveitar juntos!"
                                                                },
                                                                {
                                                                    "id": "733550237",
                                                                    "speaker": "Souka",
                                                                    "text": "E quanto se trata de colocar a teoria na prática, eu posso lidar com a comida sozinho. Só em caso de Haniyyah acabar destruindo nossa décima primeira panela."
                                                                },
                                                                {
                                                                    "id": "733550238",
                                                                    "speaker": "Paimon",
                                                                    "text": "Parece que o dia que sentaremos num círculo e comeremos com nossos cogumigos não está tão longe assim, né?",
                                                                    "choices": [
                                                                        {
                                                                            "id": "733550239",
                                                                            "text": "Vamos esperar notícias suas, Haniyyah!",
                                                                            "response": [
                                                                                {
                                                                                    "id": "733550241",
                                                                                    "speaker": "Haniyyah",
                                                                                    "text": "Nesse caso, lembrem-se de voltar e visitar o Parque de Diversões dos Cogumigos quando tiverem tempo! Nós e os cogumigos vamos estar sempre aqui!"
                                                                                },
                                                                                {
                                                                                    "id": "733550242",
                                                                                    "speaker": "Souka",
                                                                                    "text": "E quem sabe, talvez a surpresa chegue mais cedo do que vocês imaginam!"
                                                                                },
                                                                                {
                                                                                    "id": "733550243",
                                                                                    "speaker": "Cabeça de Bongô",
                                                                                    "text": "♪!"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "733550240",
                                                                            "text": "Mal posso esperar pelo banquete de Souka!"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "733550230",
                                                            "text": "Agora podemos nos ver sempre!"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "733550222",
                                            "text": "Essa atmosfera calorosa e de boas-vindas tá me relaxando..."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "733550208",
                            "text": "Eu não me lembro bem, mas... olá!",
                            "response": [
                                {
                                    "id": "733550209",
                                    "speaker": "Paimon",
                                    "text": "São Haniyyah e Cabeça de Bongô! Nos conhecemos na Copa Nilotpala de Domadores de Feras! São nossos amigos de longa data!"
                                },
                                {
                                    "id": "733550210",
                                    "speaker": "Paimon",
                                    "text": "Depois disso, Paimon se lembra que nos encontramos de novo no Porto Ormos, e na Corte de Fontaine. Já faz tanto tempo..."
                                },
                                {
                                    "id": "733550211",
                                    "speaker": "Cabeça de Bongô",
                                    "text": "♪~"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}