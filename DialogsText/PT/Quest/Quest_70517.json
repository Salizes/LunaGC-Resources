            "objective": "Vá para o local mencionado por Paimon",
            "dialogues": [
                {
                    "id": "705170101",
                    "speaker": "Paimon",
                    "text": "Esse lugar daqui parece muito ordinário."
                },
                {
                    "id": "705170102",
                    "speaker": "Paimon",
                    "text": "Não tem nada de comer por aqui...",
                    "choices": [
                        {
                            "id": "705170103",
                            "text": "Paimon, se controle.",
                            "response": [
                                {
                                    "id": "705170105",
                                    "speaker": "Paimon",
                                    "text": "*Cof* *Cof* Bem, é necessário comer durante uma investigação secreta! Isso é senso comum!"
                                },
                                {
                                    "id": "705170106",
                                    "speaker": "Paimon",
                                    "text": "#Além disso, ultimamente nós só comemos coisas grelhadas para nos poupar de muito trabalho. Você não está cansad{F#a}{M#o} disso?"
                                },
                                {
                                    "id": "705170107",
                                    "speaker": "Paimon",
                                    "text": "Se pudermos coletar conchas ou búzios na praia, podemos fazer uma sopa deles com frutas para comer!"
                                },
                                {
                                    "id": "705170108",
                                    "speaker": "Paimon",
                                    "text": "Uma sopa fresquinha, doce, primaveril... Hmm...",
                                    "choices": [
                                        {
                                            "id": "705170109",
                                            "text": "Isso não parece gostoso, não quero.",
                                            "response": [
                                                {
                                                    "id": "705170110",
                                                    "speaker": "Paimon",
                                                    "text": "Vamos, prove! Talvez você abra a porta para um novo mundo de sabores!"
                                                },
                                                {
                                                    "id": "705170113",
                                                    "speaker": "Paimon",
                                                    "text": "#{NICKNAME}, espere, olhe ali!"
                                                },
                                                {
                                                    "id": "705170114",
                                                    "speaker": "Paimon",
                                                    "text": "Aquele mecanismo apareceu do nada... Que estranho."
                                                },
                                                {
                                                    "id": "705170115",
                                                    "speaker": "Paimon",
                                                    "text": "E ainda há algumas cargas perto. Será que são coisas dos Fatui?"
                                                },
                                                {
                                                    "id": "705170116",
                                                    "speaker": "Player",
                                                    "text": "Você acertou na mosca, Paimon."
                                                },
                                                {
                                                    "id": "705170117",
                                                    "speaker": "Paimon",
                                                    "text": "A intuição de Paimon é sempre certeira! Uhul!..."
                                                },
                                                {
                                                    "id": "705170118",
                                                    "speaker": "Paimon",
                                                    "text": "Espera, uhul o quê?! Nós temos um problema em nossas mãos!"
                                                },
                                                {
                                                    "id": "705170119",
                                                    "speaker": "Paimon",
                                                    "text": "Já que é algo que está relacionado aos Fatui e que apareceu aqui, deve significar que eles estão tramando algo!"
                                                },
                                                {
                                                    "id": "705170120",
                                                    "speaker": "Paimon",
                                                    "text": "Se ignorarmos isso, se tornará num problema enorme!"
                                                },
                                                {
                                                    "id": "705170121",
                                                    "speaker": "Paimon",
                                                    "text": "Enfim, que tal primeiro tentarmos lidar com esse mecanismo? Se você achar necessário, vamos investigar a carga dos Fatui."
                                                },
                                                {
                                                    "id": "705170122",
                                                    "speaker": "Paimon",
                                                    "text": "#{NICKNAME}, vamos resolver isso primeiro! Depois que acabarmos, nossa busca por comida poderá continuar calmamente!"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "705170111",
                                            "text": "Isso parece um sabor que você teria.",
                                            "response": [
                                                {
                                                    "id": "705170112",
                                                    "speaker": "Paimon",
                                                    "text": "Ei! Paimon não é um fruto do mar!"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "705170104",
                            "text": "Não é à toa que você está tão animada."
                        }
                    ]
                }
            ]
        }
    ]
