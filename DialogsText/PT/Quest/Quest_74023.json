        },
        {
            "id": "7402303",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "740230301",
                    "speaker": "Sacha",
                    "text": "#Olá, {NICKNAME} e Paimon!",
                    "choices": [
                        {
                            "id": "740230302",
                            "text": "Você conseguiu recrutar novos membros para a aliança?",
                            "response": [
                                {
                                    "id": "740230303",
                                    "speaker": "Sacha",
                                    "text": "Eu encontrei membros promissores que desejam participar, mas eu preciso realizar uma avaliação rigorosa para garantir que eles terão as qualificações corretas. Afinal, é o futuro de Fontaine que está em risco."
                                }
                            ]
                        },
                        {
                            "id": "740230304",
                            "text": "Não vai sair correndo voltando para casa hoje?",
                            "response": [
                                {
                                    "id": "740230305",
                                    "speaker": "Sacha",
                                    "text": "Eu terminei minha tarefa de casa, por isso pensei em ficar mais um tempo antes de voltar pra casa..."
                                }
                            ]
                        }
                    ]
                }
