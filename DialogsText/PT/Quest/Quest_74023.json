    "talks": [
        {
            "id": "7402301",
            "objective": "",
            "dialogues": [
                {
                    "id": "740230101",
                    "speaker": "Paimon",
                    "text": "Ufa! Isso está parecendo bem melhor. Sacha ficaria orgulhosa se visse isso, não acha, Viajante?"
                },
                {
                    "id": "740230102",
                    "speaker": "???",
                    "text": "#Ladr{F#as}{M#ões}! Ladr{F#as}{M#ões} em plena luz do dia!"
                },
                {
                    "id": "740230103",
                    "speaker": "Paimon",
                    "text": "#Hã?! Ladr{F#as}{M#ões}? Onde?!"
                },
                {
                    "id": "740230104",
                    "speaker": "???",
                    "text": "Eu estou falando de vocês! Vocês não só destruíram minha obra prima, ainda levaram o baú embora...",
                    "choices": [
                        {
                            "id": "740230105",
                            "text": "Uau, então foi mesmo alguém da Guilda de Aventureiros que fez...",
                            "response": [
                                {
                                    "id": "740230106",
                                    "speaker": "???",
                                    "text": "O que eu fiz?! Eu que deveria estar perguntando a vocês!"
                                },
                                {
                                    "id": "740230109",
                                    "speaker": "Paimon",
                                    "text": "Você chama essas coisas horrendas de obras-primas?"
                                },
                                {
                                    "id": "740230110",
                                    "speaker": "???",
                                    "text": "Que audácia! O que raios você está chamando de \"horrenda\"?! Nunca ouviu falar de uma instalação artística na sua vida?!"
                                },
                                {
                                    "id": "740230111",
                                    "speaker": "???",
                                    "text": "Parece que a formação artística de Fontaine ainda tem um longo caminho pela frente... Oh, mas vocês não parecem ser de Fontaine..."
                                },
                                {
                                    "id": "740230112",
                                    "speaker": "Paimon",
                                    "text": "#Isso é porque a gente não é de Fontaine! Paimon é Paimon, e {F#ela}{M#ele} é {F#a}{M#o} {NICKNAME}, também somos membros da Guilda de Aventureiros.",
                                    "choices": [
                                        {
                                            "id": "740230113",
                                            "text": "Buááááá! Somos membros de uma organização maléfica...",
                                            "response": [
                                                {
                                                    "id": "740230114",
                                                    "speaker": "Paimon",
                                                    "text": "Sim, mas a gente não precisa usar uniformes. Por isso não somos caras malvados de verde! Uhul!"
                                                },
                                                {
                                                    "id": "740230117",
                                                    "speaker": "Ubu",
                                                    "text": "Eu sou Ubu, um aventureiro e artista de instalação. Como vocês estão falando coisas sem pé nem cabeça, só me resta supor que estão prestes a fazer alguma coisa doida... não vou mais insistir nisso."
                                                },
                                                {
                                                    "id": "740230118",
                                                    "speaker": "Paimon",
                                                    "text": "Hã? Na verdade..."
                                                },
                                                {
                                                    "id": "740230119",
                                                    "speaker": "Ubu",
                                                    "text": "O quê? Eu preciso restaurar a obra, por isso, se vieram aqui agradecer, sejam breves."
                                                },
                                                {
                                                    "id": "740230120",
                                                    "speaker": "Sacha",
                                                    "text": "Eu não tenho nada a te agradecer, mas tenho um milhão de coisas para gritar na sua cara!"
                                                },
                                                {
                                                    "id": "740230121",
                                                    "speaker": "Paimon",
                                                    "text": "Sacha!"
                                                },
                                                {
                                                    "id": "740230122",
                                                    "speaker": "Sacha",
                                                    "text": "Comigo ao seu lado, você não tem nada com o que se preocupar, irmãzinha Paimon!"
                                                },
                                                {
                                                    "id": "740230123",
                                                    "speaker": "Sacha",
                                                    "text": "Cara malvado de verde, destruímos todas as suas armadilhas! Pare de tentar arruinar nossa belíssima Fontaine com suas armadilhas sinistras!"
                                                },
                                                {
                                                    "id": "740230124",
                                                    "speaker": "Ubu",
                                                    "text": "Arruinar? Espere, \"destruímos todas\"?... Vocês destruíram todas as minhas obras de arte!?"
                                                },
                                                {
                                                    "id": "740230125",
                                                    "speaker": "Paimon",
                                                    "text": "Hmmm, não exatamente... Nós apenas... reorganizamos elas para que pudessem se adequar melhor à paisagem..."
                                                },
                                                {
                                                    "id": "740230126",
                                                    "speaker": "Ubu",
                                                    "text": "Seus... seus pestinhas plebeus! Como vocês esperavam entender a arte!? Transformando minha arte de dispositivo, minhas grandiosas obras em algo tão medíocre e mundano..."
                                                },
                                                {
                                                    "id": "740230127",
                                                    "speaker": "Paimon",
                                                    "text": "Mas isso realmente é arte? Paimon não entende muito sobre, mas você realmente poderia chamar algo tão destoante de arte?"
                                                },
                                                {
                                                    "id": "740230128",
                                                    "speaker": "Ubu",
                                                    "text": "Claro, as fronteiras da arte são definidas pelo artista. Uma obra criada por um artista é naturalmente chamada de obra de arte."
                                                },
                                                {
                                                    "id": "740230129",
                                                    "speaker": "Sacha",
                                                    "text": "E quem seria o artista?"
                                                },
                                                {
                                                    "id": "740230130",
                                                    "speaker": "Ubu",
                                                    "text": "Sou eu, Ubu, o extraordinário artista de dispositivos."
                                                },
                                                {
                                                    "id": "740230131",
                                                    "speaker": "Sacha",
                                                    "text": "Neste caso, como fundadora da \"Aliança de Artistas para Derrubar a Organização Maligna e Proteger o Futuro de Fontaine\", eu declaro que não reconheço seu trabalho como arte."
                                                },
                                                {
                                                    "id": "740230132",
                                                    "speaker": "Ubu",
                                                    "text": "\"Derrubar a-\"... O quê?",
                                                    "choices": [
                                                        {
                                                            "id": "740230133",
                                                            "text": "Derrubar a Organização Maligna",
                                                            "response": [
                                                                {
                                                                    "id": "740230134",
                                                                    "speaker": "Paimon",
                                                                    "text": "Refere-se à Guilda de Aventureiros que está arruinando a paisagem com... hmmm, arte de dispositivos..."
                                                                },
                                                                {
                                                                    "id": "740230136",
                                                                    "speaker": "Ubu",
                                                                    "text": "Que piada! Nunca ouvi falar dessa tal de aliança. Pirralha, o que te dá o direito de dizer que as minhas obras não são arte?"
                                                                },
                                                                {
                                                                    "id": "740230137",
                                                                    "speaker": "Sacha",
                                                                    "text": "Eu sou uma pintora, então você poderia dizer que sou uma artista. Claro que sou qualificada."
                                                                },
                                                                {
                                                                    "id": "740230138",
                                                                    "speaker": "Ubu",
                                                                    "text": "Hã? Olha só, pirralha, ser artista não é brincadeira de criança. Você não é uma artista só porque deseja se tornar uma. Você precisa ter obras reconhecidas pelas pessoas..."
                                                                },
                                                                {
                                                                    "id": "740230139",
                                                                    "speaker": "Sacha",
                                                                    "text": "Então o que faz de você qualificado? Suas obras, a arte de dispositivos que tanto fala... Aquelas armadilhas malignas? As pessoas aplaudem quando veem elas?"
                                                                },
                                                                {
                                                                    "id": "740230140",
                                                                    "speaker": "Ubu",
                                                                    "text": "Isso é porque existem muitos plebeus que não entendem o apelo das minhas obras. A verdadeira arte é pouco compreendida...",
                                                                    "choices": [
                                                                        {
                                                                            "id": "740230141",
                                                                            "text": "Você deveria começar a fazer arte que as pessoas possam entender.",
                                                                            "response": [
                                                                                {
                                                                                    "id": "740230142",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "Pois é, se ninguém entende, ou você está muito à frente do seu tempo, ou simplesmente..."
                                                                                },
                                                                                {
                                                                                    "id": "740230145",
                                                                                    "speaker": "Ubu",
                                                                                    "text": "Não... não pode ser! Minhas obras são perfeitas! Não há absolutamente nada de errado com elas! Vocês só não conseguem entender! As pessoas não conseguem entender..."
                                                                                },
                                                                                {
                                                                                    "id": "740230146",
                                                                                    "speaker": "Ubu",
                                                                                    "text": "Droga, eu não vou desistir! Isso não acabou ainda!"
                                                                                },
                                                                                {
                                                                                    "id": "740230147",
                                                                                    "speaker": "Black Screen",
                                                                                    "text": "Ubu cambaleou para longe..."
                                                                                },
                                                                                {
                                                                                    "id": "740230148",
                                                                                    "speaker": "Sacha",
                                                                                    "text": "Que inimigo teimoso! Mas eu também não vou desistir! O futuro da arte de Fontaine está em minhas mãos!"
                                                                                },
                                                                                {
                                                                                    "id": "740230149",
                                                                                    "speaker": "Player",
                                                                                    "text": "Todos temos objetivos pelos quais precisamos nos esforçar."
                                                                                },
                                                                                {
                                                                                    "id": "740230150",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "Isso é uma coisa boa, não é?"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "740230143",
                                                                            "text": "Simplificando, ninguém consegue entender.",
                                                                            "response": [
                                                                                {
                                                                                    "id": "740230144",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "Isso soa como um fracasso..."
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "740230135",
                                                            "text": "Basicamente, precisamos derrotar você."
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "740230115",
                                            "text": "Opa, olá, parça.",
                                            "response": [
                                                {
                                                    "id": "740230116",
                                                    "speaker": "Paimon",
                                                    "text": "Paimon não acha que você pode chamar alguém de parça sem nem saber o nome..."
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "740230107",
                            "text": "Espera! É o cara de verde do mal!",
                            "response": [
                                {
                                    "id": "740230108",
                                    "speaker": "???",
                                    "text": "#Haha, temos {F#uma}{M#um} ladr{F#a}{M#ão} aqui falando loucuras. Hoje é o meu dia!"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
