    "talks": [
        {
            "id": "7603601",
            "objective": "Encontre-se com Damselette",
            "dialogues": [
                {
                    "id": "760360101",
                    "speaker": "Damselette",
                    "text": "Não era esse azul, então?"
                },
                {
                    "id": "760360102",
                    "speaker": "Kuuhenki",
                    "text": "...",
                    "choices": [
                        {
                            "id": "760360103",
                            "text": "Columbina?",
                            "response": [
                                {
                                    "id": "760360105",
                                    "speaker": "Damselette",
                                    "text": "Ah? São vocês."
                                },
                                {
                                    "id": "760360106",
                                    "speaker": "Damselette",
                                    "text": "#Podem me ajudar? Fiquem tranquil{M#o}{F#a}s, eu retribuirei."
                                },
                                {
                                    "id": "760360107",
                                    "speaker": "Paimon",
                                    "text": "Hmm... Quando você vai deixar esse hábito pra trás...?",
                                    "choices": [
                                        {
                                            "id": "760360108",
                                            "text": "Você ajudou muito a gente antes também...",
                                            "response": [
                                                {
                                                    "id": "760360110",
                                                    "speaker": "Paimon",
                                                    "text": "É. A gente ia te ajudar mesmo que não tivesse nada para nos dar."
                                                },
                                                {
                                                    "id": "760360111",
                                                    "speaker": "Paimon",
                                                    "text": "Então, que tipo de ajuda você precisa?"
                                                },
                                                {
                                                    "id": "760360112",
                                                    "speaker": "Damselette",
                                                    "text": "Bem... Para ser precisa, essa criatura que precisa de ajuda."
                                                },
                                                {
                                                    "id": "760360113",
                                                    "speaker": "Kuuhenki",
                                                    "text": "..."
                                                },
                                                {
                                                    "id": "760360114",
                                                    "speaker": "Paimon",
                                                    "text": "O kuuhenki?"
                                                },
                                                {
                                                    "id": "760360115",
                                                    "speaker": "Damselette",
                                                    "text": "Essa criança conseguiu um pincel de alguma fonte desconhecida e, ao retornar ao meu lado, ficou balançando ele alegremente por aí."
                                                },
                                                {
                                                    "id": "760360116",
                                                    "speaker": "Damselette",
                                                    "text": "Encontrei algumas telas e tintas, mas mesmo com um pouco de tempo passando, suas tentativas de misturar as cores que deseja não tiveram muito sucesso."
                                                },
                                                {
                                                    "id": "760360117",
                                                    "speaker": "Luonnotar",
                                                    "text": "...!"
                                                },
                                                {
                                                    "id": "760360118",
                                                    "speaker": "Paimon",
                                                    "text": "Ei, olha só quem apareceu!"
                                                },
                                                {
                                                    "id": "760360119",
                                                    "speaker": "Luonnotar",
                                                    "text": "!!!"
                                                },
                                                {
                                                    "id": "760360120",
                                                    "speaker": "Kuuhenki",
                                                    "text": "??"
                                                },
                                                {
                                                    "id": "760360121",
                                                    "speaker": "Luonnotar",
                                                    "text": "...!"
                                                },
                                                {
                                                    "id": "760360122",
                                                    "speaker": "Paimon",
                                                    "text": "Ei, ei, não esqueça, não entendemos gesticulações..."
                                                },
                                                {
                                                    "id": "760360123",
                                                    "speaker": "Luonnotar",
                                                    "text": "..."
                                                },
                                                {
                                                    "id": "760360124",
                                                    "speaker": "Luonnotar",
                                                    "text": "!!!"
                                                },
                                                {
                                                    "id": "760360125",
                                                    "speaker": "Kuuhenki",
                                                    "text": "!!!"
                                                },
                                                {
                                                    "id": "760360126",
                                                    "speaker": "Paimon",
                                                    "text": "Hmm, parece que ele se interessou pela sua mochila."
                                                },
                                                {
                                                    "id": "760360127",
                                                    "speaker": "Damselette",
                                                    "text": "Você carrega cores adequadas consigo?"
                                                },
                                                {
                                                    "id": "760360128",
                                                    "speaker": "Paimon",
                                                    "text": "Hmm, a gente não carrega esse tipo de coisa geralmente... Falando nisso, onde você encontrou as tintas? Sem ofensa, mas, hmm, você não parece ser uma pintora."
                                                },
                                                {
                                                    "id": "760360129",
                                                    "speaker": "Damselette",
                                                    "text": "Esta criança estava ficando muito impaciente, então fiz algumas tintas para ela usando algumas flores coloridas próximas."
                                                },
                                                {
                                                    "id": "760360130",
                                                    "speaker": "Paimon",
                                                    "text": "Hmm, será que Luonnotar tá procurando por outras coisas com cores vibrantes para fazer tintas, então?"
                                                },
                                                {
                                                    "id": "760360131",
                                                    "speaker": "Paimon",
                                                    "text": "Vem, vamos ver o que temos nas nossas bolsas."
                                                }
                                            ]
                                        },
                                        {
                                            "id": "760360109",
                                            "text": "Você já nos ajudou bastante..."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "760360104",
                            "text": "O que tá acontecendo?"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7603602",
            "objective": "Dê alguns objetos de cores vivas para os Kuuhenki",
            "dialogues": [
                {
                    "id": "760360201",
                    "speaker": "Kuuhenki",
                    "text": "!!!"
                },
                {
                    "id": "760360202",
                    "speaker": "Paimon",
                    "text": "Certo, relaxe, não se preocupe, estamos procurando. Plantas coloridas e Nod-Krai são a primeira opção, né?"
                }
            ]
        },
        {
            "id": "7603603",
            "objective": "Fale com o Kuuhenki",
            "dialogues": [
                {
                    "id": "760360301",
                    "speaker": "Paimon",
                    "text": "Essas bastam?"
                },
                {
                    "id": "760360302",
                    "speaker": "Damselette",
                    "text": "Sim. O kuuhenki parece bem satisfeito."
                },
                {
                    "id": "760360303",
                    "speaker": "Maalaus",
                    "text": "!"
                },
                {
                    "id": "760360304",
                    "speaker": "Paimon",
                    "text": "Paimon nunca imaginou que os kuuhenki podiam pintar."
                },
                {
                    "id": "760360305",
                    "speaker": "Damselette",
                    "text": "São como nós, na verdade. Cada um possui uma personalidade, e seus passatempos."
                },
                {
                    "id": "760360306",
                    "speaker": "Paimon",
                    "text": "Espera, então você consegue reconhecer todos os kuuhenki de Nod-Krai?"
                },
                {
                    "id": "760360307",
                    "speaker": "Damselette",
                    "text": "Os que eu já conheço, sim."
                },
                {
                    "id": "760360308",
                    "speaker": "Paimon",
                    "text": "Uau, que impressionante! Especialmente porque fora Luonnotar, todos os outros kuuhenki são meio parecidos..."
                },
                {
                    "id": "760360309",
                    "speaker": "Paimon",
                    "text": "Qual é o nome desse pintorzinho daqui?"
                },
                {
                    "id": "760360310",
                    "speaker": "Damselette",
                    "text": "Nome...?"
                },
                {
                    "id": "760360311",
                    "speaker": "Paimon",
                    "text": "Espera, você não deu nome pra eles?"
                },
                {
                    "id": "760360312",
                    "speaker": "Damselette",
                    "text": "Eu reconheço eles, e eles me reconhecem. Os nomes não são necessários... Eu mesma não tenho um."
                },
                {
                    "id": "760360313",
                    "speaker": "Paimon",
                    "text": "Isso não é razão para perpetuar más tradições!"
                },
                {
                    "id": "760360314",
                    "speaker": "Paimon",
                    "text": "Hmm... nesse caso, Luonnotar significa \"uma criatura nascida sob a bênção da Deusa da Lua\"..."
                },
                {
                    "id": "760360315",
                    "speaker": "Paimon",
                    "text": "Como se fala pintura na língua dos Filhos da Lua Gelada?"
                },
                {
                    "id": "760360316",
                    "speaker": "Damselette",
                    "text": "Acho que é... Maa... raus? Maalaus? Sim. Maalaus."
                },
                {
                    "id": "760360317",
                    "speaker": "Paimon",
                    "text": "Oh, parece bem legal! Vamos chamar você de Maalaus!"
                },
                {
                    "id": "760360318",
                    "speaker": "Maalaus",
                    "text": "??"
                },
                {
                    "id": "760360319",
                    "speaker": "Paimon",
                    "text": "O que foi, Maalaus? Terminou sua pintura?"
                },
                {
                    "id": "760360320",
                    "speaker": "Maalaus",
                    "text": "!!!"
                },
                {
                    "id": "760360321",
                    "speaker": "Paimon",
                    "text": "Oh, vamos ver! Vamos ver! Hã, isso aqui é...!"
                },
                {
                    "id": "760360322",
                    "speaker": "Player",
                    "text": "O que foi?"
                },
                {
                    "id": "760360323",
                    "speaker": "Paimon",
                    "text": "Isso aqui é incrível! Tipo, super incrível!"
                },
                {
                    "id": "760360324",
                    "speaker": "Paimon",
                    "text": "Paimon tava esperando um aspecto mais infantil... ou, sabe, uma pegada mais Melusine?"
                },
                {
                    "id": "760360325",
                    "speaker": "Damselette",
                    "text": "Os kuuhenki são especialistas em sentir os arredores e, ao recriar o que veem, eles tendem a registrar seus sentimentos exatamente como são."
                },
                {
                    "id": "760360326",
                    "speaker": "Player",
                    "text": "Hmm... Essa que você desenhou é Columbina, Maalaus?"
                },
                {
                    "id": "760360327",
                    "speaker": "Maalaus",
                    "text": "!!!"
                },
                {
                    "id": "760360328",
                    "speaker": "Damselette",
                    "text": "Hã...?"
                },
                {
                    "id": "760360329",
                    "speaker": "Paimon",
                    "text": "...Parece Columbina quando ela nasceu."
                },
                {
                    "id": "760360330",
                    "speaker": "Damselette",
                    "text": "Hã?"
                },
                {
                    "id": "760360331",
                    "speaker": "Paimon",
                    "text": "Paimon lembra de Lauma dizendo que seu nascimento foi registrado pelos Filhos da Lua Gelada... embora essa pintura pareça um pouco diferente.",
                    "choices": [
                        {
                            "id": "760360332",
                            "text": "E kuuhenki...",
                            "response": [
                                {
                                    "id": "760360334",
                                    "speaker": "Damselette",
                                    "text": "Esse pequenino... Maalaus, foi um dos primeiros kuuhenki que nasceram. Pode ter usado uma combinação de suas percepções para visualizar como as coisas eram naquela época."
                                },
                                {
                                    "id": "760360335",
                                    "speaker": "Paimon",
                                    "text": "Parece que você tá tentando ajudar a gente a conhecer melhor sua deusa, hein, Maalaus?"
                                },
                                {
                                    "id": "760360336",
                                    "speaker": "Maalaus",
                                    "text": "!"
                                },
                                {
                                    "id": "760360337",
                                    "speaker": "Damselette",
                                    "text": "..."
                                },
                                {
                                    "id": "760360338",
                                    "speaker": "Paimon",
                                    "text": "Não se preocupe, Maalaus. Vamos nos dar muito bem com Columbina, você vai ver!"
                                },
                                {
                                    "id": "760360339",
                                    "speaker": "Maalaus",
                                    "text": "!!!"
                                },
                                {
                                    "id": "760360340",
                                    "speaker": "Paimon",
                                    "text": "Caramba, isso foi rápido. Você já terminou outra pintura?"
                                },
                                {
                                    "id": "760360341",
                                    "speaker": "Damselette",
                                    "text": "...?"
                                },
                                {
                                    "id": "760360342",
                                    "speaker": "Paimon",
                                    "text": "Isso... deve mostrar os Filhos da Lua Gelada venerando Columbina como deusa deles."
                                },
                                {
                                    "id": "760360343",
                                    "speaker": "Paimon",
                                    "text": "Hã? O que ela tá fazendo perto do altar? Os detalhes são um pouco pequenos demais para entender."
                                },
                                {
                                    "id": "760360344",
                                    "speaker": "Maalaus",
                                    "text": "!"
                                },
                                {
                                    "id": "760360345",
                                    "speaker": "Paimon",
                                    "text": "Ah, ela estava comendo as oferendas!"
                                },
                                {
                                    "id": "760360346",
                                    "speaker": "Damselette",
                                    "text": "...Não podia?"
                                },
                                {
                                    "id": "760360347",
                                    "speaker": "Paimon",
                                    "text": "Não tem nenhuma lei contra isso. Foi só, hmm, inesperado?"
                                },
                                {
                                    "id": "760360348",
                                    "speaker": "Player",
                                    "text": "Parece que você se divertiu..."
                                },
                                {
                                    "id": "760360349",
                                    "speaker": "Damselette",
                                    "text": "Bem... Elas estavam deliciosas..."
                                },
                                {
                                    "id": "760360350",
                                    "speaker": "Paimon",
                                    "text": "Paimon te entende..."
                                },
                                {
                                    "id": "760360351",
                                    "speaker": "Maalaus",
                                    "text": "!"
                                },
                                {
                                    "id": "760360352",
                                    "speaker": "Damselette",
                                    "text": "Sim, eu entendo."
                                },
                                {
                                    "id": "760360353",
                                    "speaker": "Damselette",
                                    "text": "Me dê a sua mão.",
                                    "choices": [
                                        {
                                            "id": "760360354",
                                            "text": "Hmm, não precisamos de nada \"em troca\"...",
                                            "response": [
                                                {
                                                    "id": "760360356",
                                                    "speaker": "Damselette",
                                                    "text": "Não. Essa é a prova que estamos nos \"dando bem\"."
                                                }
                                            ]
                                        },
                                        {
                                            "id": "760360355",
                                            "text": "Desculpe, você não pode comer isso..."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "760360333",
                            "text": "...Deveriam ter nascido após o nascimento da Deusa da Lua..."
                        }
                    ]
                }
            ]
        },
        {
            "id": "7603699",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "760369901",
                    "speaker": "Paimon",
                    "text": "Da última vez, Columbina nos contou muito sobre os Fatui. Paimon queria saber que tipo de coisa ela vai falar hoje... Tomara que ela esteja a fim de compartilhar!"
                },
                {
                    "id": "760369902",
                    "speaker": "Paimon",
                    "text": "Columbina?"
                },
                {
                    "id": "760369903",
                    "speaker": "Paimon",
                    "text": "Hmm, parece que tem alguma coisa incomodando ela!"
                },
                {
                    "id": "760369904",
                    "speaker": "Damselette",
                    "text": "É isso?"
                },
                {
                    "id": "760369905",
                    "speaker": "Damselette",
                    "text": "Não é isso também, então?"
                },
                {
                    "id": "760369906",
                    "speaker": "Damselette",
                    "text": "E isso aqui?"
                }
            ]
        }
    ]
