    "talks": [
        {
            "id": "7550801",
            "objective": "Vá ao Povo das Termas",
            "dialogues": [
                {
                    "id": "755080101",
                    "speaker": "Mualani",
                    "text": "Ei!"
                },
                {
                    "id": "755080102",
                    "speaker": "Mualani",
                    "text": "#Noss{F#a}{M#o} convidad{F#a}{M#o} mais importante chegou, o que significa que a atmosfera está prestes a ficar no máximo!"
                },
                {
                    "id": "755080103",
                    "speaker": "Paimon",
                    "text": "Mualani, olá! Xilonen também está aqui?"
                },
                {
                    "id": "755080104",
                    "speaker": "Paimon",
                    "text": "E Mizuki? Você veio de Inazuma?"
                },
                {
                    "id": "755080105",
                    "speaker": "Yumemizuki Mizuki",
                    "text": "Isso mesmo! Os amigos de Natlan me tratam como família, o \"Povo das Termas\" é como um lar para mim em terras estrangeiras."
                },
                {
                    "id": "755080106",
                    "speaker": "Yumemizuki Mizuki",
                    "text": "Eu também preciso cuidar bem da filial, para poder oferecer toda a ajuda possível para o pessoal de Natlan."
                },
                {
                    "id": "755080107",
                    "speaker": "Xilonen",
                    "text": "Bem dito, a atitude profissional da Senhorita Mizuki é realmente impecável."
                },
                {
                    "id": "755080108",
                    "speaker": "Xilonen",
                    "text": "Até mesmo prestadores de serviços lendários não chegam aos pés dela...",
                    "choices": [
                        {
                            "id": "755080109",
                            "text": "Então, Xilonen também é cliente de Mizuki?",
                            "response": [
                                {
                                    "id": "755080111",
                                    "speaker": "Xilonen",
                                    "text": "Ultimamente, tive alguns sonhos estranhos, como... um cliente reduzindo o prazo de um pedido de quatro semanas para apenas uma."
                                },
                                {
                                    "id": "755080112",
                                    "speaker": "Xilonen",
                                    "text": "Ou então receber um pedido como: \"Um acessório com formato arredondado, mas que também transmita uma sensação de perigo\", também com urgência quadruplicada...",
                                    "choices": [
                                        {
                                            "id": "755080113",
                                            "text": "Eu conheço esse. Slimes e Cogumelos.",
                                            "response": [
                                                {
                                                    "id": "755080115",
                                                    "speaker": "Paimon",
                                                    "text": "Reagindo tão rápido assim, não foi você que deu um jeito de aparecer nos sonhos da Xilonen para fazer o pedido, foi?"
                                                },
                                                {
                                                    "id": "755080116",
                                                    "speaker": "Xilonen",
                                                    "text": "Essas duas criaturas... são perigosas?"
                                                },
                                                {
                                                    "id": "755080117",
                                                    "speaker": "Xilonen",
                                                    "text": "Hmm, o prazo não é o principal problema. O verdadeiro desafio está nos padrões circulares, que são trabalhosos de elaborar. Quando há urgência, o resultado final pode não ser tão perfeito."
                                                },
                                                {
                                                    "id": "755080118",
                                                    "speaker": "Xilonen",
                                                    "text": "Tive vários pedidos problemáticos assim nos meus sonhos. Senti que algo estava errado, então terminei as encomendas pendentes e resolvi visitar a loja da Senhorita Mizuki para testar..."
                                                },
                                                {
                                                    "id": "755080119",
                                                    "speaker": "Xilonen",
                                                    "text": "E funcionou! Na soneca daquela tarde, não tive mais sonhos estranhos."
                                                },
                                                {
                                                    "id": "755080120",
                                                    "speaker": "Yumemizuki Mizuki",
                                                    "text": "É uma honra poder aliviar os incômodos da Senhora Xilonen."
                                                },
                                                {
                                                    "id": "755080121",
                                                    "speaker": "Yumemizuki Mizuki",
                                                    "text": "Mas, na minha opinião, o mérito principal para que os sonhos estranhos da Senhora Xilonen desaparecessem ainda é todo seu..."
                                                },
                                                {
                                                    "id": "755080122",
                                                    "speaker": "Mualani",
                                                    "text": "Resumindo, agora que todos estão com o estado de espírito ótimo, é o momento perfeito para relaxar..."
                                                },
                                                {
                                                    "id": "755080123",
                                                    "speaker": "Mualani",
                                                    "text": "O \"Povo das Termas\" vai reiniciar a tradição das festas aquáticas, para que todos se divirtam ao máximo!",
                                                    "choices": [
                                                        {
                                                            "id": "755080124",
                                                            "text": "Festa aquática~!",
                                                            "response": [
                                                                {
                                                                    "id": "755080126",
                                                                    "speaker": "Paimon",
                                                                    "text": "Isso aí, vamos nos divertir ao máximo!"
                                                                },
                                                                {
                                                                    "id": "755080127",
                                                                    "speaker": "Paimon",
                                                                    "text": "...Mas, Paimon nunca participou de um evento assim antes, Paimon só sabe que há comidas deliciosas e bebidas maravilhosas..."
                                                                },
                                                                {
                                                                    "id": "755080128",
                                                                    "speaker": "Paimon",
                                                                    "text": "O que os habitantes de Natlan geralmente fazem em uma festa dessas?",
                                                                    "choices": [
                                                                        {
                                                                            "id": "755080129",
                                                                            "text": "Surfar em alta velocidade puxados por um Koholassauro?",
                                                                            "response": [
                                                                                {
                                                                                    "id": "755080132",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "Paimon... Pode participar disso?"
                                                                                },
                                                                                {
                                                                                    "id": "755080133",
                                                                                    "speaker": "Mualani",
                                                                                    "text": "Ah, vocês já são praticantes experientes de esportes radicais! Eu também pensei em deixar os convidados experimentarem isso logo de cara!"
                                                                                },
                                                                                {
                                                                                    "id": "755080134",
                                                                                    "speaker": "Mualani",
                                                                                    "text": "Mas a Amina falou muito seriamente... cof cof... \"Para pessoas comuns, atividades assim são um pouco exageradas!\""
                                                                                },
                                                                                {
                                                                                    "id": "755080135",
                                                                                    "speaker": "Mualani",
                                                                                    "text": "\"Mesmo em algo tão simples quanto vôlei de praia, alguns convidados podem não controlar a força e acabar machucando os colegas!\""
                                                                                },
                                                                                {
                                                                                    "id": "755080136",
                                                                                    "speaker": "Mualani",
                                                                                    "text": "\"Se durante a festa, alguém, por descuido, não conseguir se divertir e acabar ficando com algum trauma, no fim das contas, isso só vai aumentar a carga de trabalho da Senhorita Mizuki!\""
                                                                                },
                                                                                {
                                                                                    "id": "755080137",
                                                                                    "speaker": "Yumemizuki Mizuki",
                                                                                    "text": "Eu não me importo em ajudar mais pessoas a resolver seus problemas, mas isso não inclui lidar com pacientes criados por mim mesma, então é melhor evitar que os convidados se machuquem."
                                                                                },
                                                                                {
                                                                                    "id": "755080138",
                                                                                    "speaker": "Mualani",
                                                                                    "text": "Hehe, é por isso que procurei você para uma boa consulta!"
                                                                                },
                                                                                {
                                                                                    "id": "755080139",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "Parece que vocês já chegaram a uma boa solução?"
                                                                                },
                                                                                {
                                                                                    "id": "755080140",
                                                                                    "speaker": "Yumemizuki Mizuki",
                                                                                    "text": "Isso mesmo, chegamos a um consenso: esperamos que mais convidados sem experiência em esportes radicais participem da festa, em vez de ficarem intimidados ao assistir atividades emocionantes."
                                                                                },
                                                                                {
                                                                                    "id": "755080141",
                                                                                    "speaker": "Yumemizuki Mizuki",
                                                                                    "text": "Enquanto conversava comigo, a senhorita Mualani ouviu falar do \"Festival da Flor Mikawa\" de Inazuma e demonstrou grande interesse pelos jogos descontraídos realizados nos festivais ao longo dos anos."
                                                                                },
                                                                                {
                                                                                    "id": "755080142",
                                                                                    "speaker": "Yumemizuki Mizuki",
                                                                                    "text": "Assim, surgiu uma ideia: combinar o \"Akitsu Haneasobi\" com a atmosfera de Natlan, criando um jogo que fosse relaxante e divertido, mas também emocionante – o \"Bilhar Rítmico\"."
                                                                                },
                                                                                {
                                                                                    "id": "755080143",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "Um jogo de Inazuma... com a atmosfera de Natlan... essa é realmente uma combinação que Paimon nunca tinha imaginado antes!",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "755080144",
                                                                                            "text": "Eu vi o \"Palco da Dança Ritmada\" dos \"Filhos dos Ecos\".",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "755080146",
                                                                                                    "speaker": "Xilonen",
                                                                                                    "text": "Ah, o \"Palco da Dança Ritmada\" nem aumentou o volume ainda, mas parece que você é bem sensível ao baixo e às batidas do tambor..."
                                                                                                },
                                                                                                {
                                                                                                    "id": "755080147",
                                                                                                    "speaker": "Xilonen",
                                                                                                    "text": "O jogo principal desta vez, o \"Bilhar Rítmico\", consiste em seguir a música vibrante, jogar com as bolas e destruir todos os blocos."
                                                                                                },
                                                                                                {
                                                                                                    "id": "755080148",
                                                                                                    "speaker": "Xilonen",
                                                                                                    "text": "Siga seus instintos, liberte-se, sem precisar se preocupar com técnicas complicadas ou questões de segurança – qualquer pessoa pode se divertir à vontade."
                                                                                                },
                                                                                                {
                                                                                                    "id": "755080149",
                                                                                                    "speaker": "Xilonen",
                                                                                                    "text": "#Claro, para alguém como {NICKNAME}, com um talento inato, deve ser possível alcançar efeitos com... ritmos e camadas especiais."
                                                                                                },
                                                                                                {
                                                                                                    "id": "755080150",
                                                                                                    "speaker": "Xilonen",
                                                                                                    "text": "Nas mãos de diferentes DJs, uma música pode apresentar estilos completamente distintos, e o mesmo vale para jogos com um foco rítmico."
                                                                                                },
                                                                                                {
                                                                                                    "id": "755080151",
                                                                                                    "speaker": "Xilonen",
                                                                                                    "text": "Quem sabe... a música base em estilo \"Chill Out\", após o seu toque, possa revelar ritmos interessantes, como algo próximo de \"Trance\" ou \"Hardcore\"."
                                                                                                },
                                                                                                {
                                                                                                    "id": "755080152",
                                                                                                    "speaker": "Xilonen",
                                                                                                    "text": "Estou um pouco ansiosa para ver isso."
                                                                                                },
                                                                                                {
                                                                                                    "id": "755080153",
                                                                                                    "speaker": "Paimon",
                                                                                                    "text": "#Hã... Paimon entendeu nadica de nada! Mas parece algo que {NICKNAME} conseguiria fazer...",
                                                                                                    "choices": [
                                                                                                        {
                                                                                                            "id": "755080154",
                                                                                                            "text": "Então, vou interpretar o gênio da música e dos jogos!",
                                                                                                            "response": [
                                                                                                                {
                                                                                                                    "id": "755080156",
                                                                                                                    "speaker": "Mualani",
                                                                                                                    "text": "Exatamente, é esse o espírito! Entre as nossas expectativas, quem com certeza vai se divertir mais são você e a Paimon!"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "755080157",
                                                                                                                    "speaker": "Mualani",
                                                                                                                    "text": "Daqui a pouco, vou pegar um monte de petiscos e bebidas para assistir tudo feliz da vida do lado."
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "755080158",
                                                                                                                    "speaker": "Yumemizuki Mizuki",
                                                                                                                    "text": "Mas, claro, não se empolguem demais, tá?"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "755080159",
                                                                                                                    "speaker": "Yumemizuki Mizuki",
                                                                                                                    "text": "Pode ser que, antes de dormir à noite, a música do \"Palco da Dança Ritmada\" ainda esteja tocando repetidamente na sua cabeça, sem parar."
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "755080160",
                                                                                                                    "speaker": "Paimon",
                                                                                                                    "text": "Obrigada a todos! A gente com certeza vai se divertir muito!"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "755080161",
                                                                                                                    "speaker": "Paimon",
                                                                                                                    "text": "Falando nisso, Paimon lembra que a Xilonen é ótima em escolher músicas, então, mesmo que repitam nos sonhos... não deve ser um problema, né?"
                                                                                                                }
                                                                                                            ]
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "755080155",
                                                                                                            "text": "Não é para tanto, vou fazer o meu melhor!"
                                                                                                        }
                                                                                                    ]
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "755080145",
                                                                                            "text": "Meu corpo sentiu o ritmo da música..."
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "755080130",
                                                                            "text": "Qucussauros lançando jogadores do alto para saltos de alta altitude?"
                                                                        },
                                                                        {
                                                                            "id": "755080131",
                                                                            "text": "Yumkassauros sem corda fazendo bungee jump... Isso já foi testado."
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "755080125",
                                                            "text": "Divertir-se ao máximo~!"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "755080114",
                                            "text": "Você tá falando de Espectros e Polvos de Bola?"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "755080110",
                            "text": "Mizuki e Xilonen estão do mesmo lado agora?"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7550899",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "755089901",
                    "speaker": "Paimon",
                    "text": "Oh, que surpresa! Uma carta de Mualani!"
                },
                {
                    "id": "755089902",
                    "speaker": "Paimon",
                    "text": "Ela diz que o \"Povo das Termas\" está organizando... uma festa musical?"
                },
                {
                    "id": "755089903",
                    "speaker": "Paimon",
                    "text": "Parece bem divertido, vamos dar uma olhada!"
                }
            ]
        }
    ]
}