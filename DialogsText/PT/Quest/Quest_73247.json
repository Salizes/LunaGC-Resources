            "dialogues": [
                {
                    "id": "732470201",
                    "speaker": "Player",
                    "text": "Claro, vamos brincar de quê?"
                },
                {
                    "id": "732470202",
                    "speaker": "Arapratap",
                    "text": "#Arapratap coletou \"coisinhas\", vou mostrá-las para {F#a}{M#o} amig{F#a}{M#o} Nara por um momento, mas depois irei guardar as \"coisinhas\"..."
                },
                {
                    "id": "732470203",
                    "speaker": "Arapratap",
                    "text": "Nara tem boa memória. Quantas \"coisinhas\" Arapratap mostrou, Nara sabe, não?"
                },
                {
                    "id": "732470204",
                    "speaker": "Arapratap",
                    "text": "#Você está pront{F#a}{M#o}, {F#boa}{M#bom} Nara?"
                },
                {
                    "id": "732470205",
                    "speaker": "Player",
                    "text": "Vamos nessa."
                }
            ]
        },
        {
            "id": "7324703",
            "objective": "",
            "dialogues": [
                {
                    "id": "732470301",
                    "speaker": "Player",
                    "text": "Da próxima vez eu consigo."
                },
                {
                    "id": "732470302",
                    "speaker": "Arapratap",
                    "text": "Arapratap irá esperar pacientemente!"
                }
            ]
        },
        {
            "id": "7324704",
            "objective": "",
            "dialogues": [
                {
                    "id": "732470501",
                    "speaker": "Player",
                    "text": "Três."
                },
                {
                    "id": "732470502",
                    "speaker": "Arapratap",
                    "text": "#Nara dourad{F#a}{M#o}, como esperado, não se esqueceu!"
                },
                {
                    "id": "732470503",
                    "speaker": "Arapratap",
                    "text": "#Nara dourad{F#a}{M#o} é poderos{F#a}{M#o}! Arapratap tem um belo presente para {F#a}{M#o} poderos{F#a}{M#o} Nara!"
                }
            ]
        },
        {
            "id": "7324701",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "732470101",
                    "speaker": "Arapratap",
                    "text": "#Amig{F#a}{M#o} Nara! Venha brincar com Arapratap!"
                }
            ]
        },
        {
            "id": "7324704",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "732470401",
                    "speaker": "Arapratap",
                    "text": "#Amig{M#o}{F#a} Nara, o que Arapratap tem em mente é <color=#00E1FFFF>cristal brilhante Dendro</color>! Quantos Nara viu?"
                }
            ]
        },
        {
            "id": "7324706",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "732470601",
                    "speaker": "Player",
                    "text": "Dois."
                },
                {
                    "id": "732470602",
                    "speaker": "Arapratap",
                    "text": "#Nara estupid{F#a}{M#o} não prestou atenção!"
                },
                {
                    "id": "732470603",
                    "speaker": "Arapratap",
                    "text": "#Arapratap tem muitas \"chances\" para dar {F#à}{M#ao} Nara. Volte para Arapratap se você estiver {M#pronto}{F#pronta} para o desafio!"
                }
            ]
        },
        {
            "id": "7324707",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "732470701",
                    "speaker": "Player",
                    "text": "Um."
                },
                {
                    "id": "732470702",
                    "speaker": "Arapratap",
                    "text": "#Nara estupid{F#a}{M#o} não prestou atenção!"
                },
                {
                    "id": "732470703",
                    "speaker": "Arapratap",
                    "text": "#Arapratap tem muitas \"chances\" para dar {F#à}{M#ao} Nara. Volte para Arapratap se você estiver {M#pronto}{F#pronta} para o desafio!"
                }
            ]
        }
