    "talks": [
        {
            "id": "7451001",
            "objective": "Fale com as duas pessoas na barraca",
            "dialogues": [
                {
                    "id": "745100101",
                    "speaker": "Paimon",
                    "text": "Vencemos! Nossos cogumigos ganharam!"
                },
                {
                    "id": "745100102",
                    "speaker": "Haniyyah",
                    "text": "Parabéns para vocês!"
                },
                {
                    "id": "745100103",
                    "speaker": "Haniyyah",
                    "text": "Seus talentos de doma são além do comum, os Cogumelos permanecem invictos sob seu comando até enfrentando inimigos que desafiam a razão!",
                    "choices": [
                        {
                            "id": "745100104",
                            "text": "Uau, elogios de Haniyyah!",
                            "response": [
                                {
                                    "id": "745100106",
                                    "speaker": "Paimon",
                                    "text": "Paimon lembra de ver o Grande Rei Javali da Neve e Maguu Kenki antes, mas dessa vez, você até trouxe um \"Cãozinho de Espada\"."
                                },
                                {
                                    "id": "745100107",
                                    "speaker": "Paimon",
                                    "text": "Você foi com tudo mesmo quando preparou aquela formação, hein?"
                                },
                                {
                                    "id": "745100108",
                                    "speaker": "Souka",
                                    "text": "Bem, esses inimigos são todos lendas em histórias de aventureiros de todo o mundo! Nossos jogadores definitivamente vão se conectar com eles."
                                },
                                {
                                    "id": "745100109",
                                    "speaker": "Souka",
                                    "text": "Como escritora, sou uma grande fã de personagens de obras diferentes batalhando entre si. Fico animada só de pensar nisso!"
                                },
                                {
                                    "id": "745100110",
                                    "speaker": "Souka",
                                    "text": "Enfim, caras Estrelas Gêmeas do Valor Brilhante, vocês jogaram todas as fases em nosso jogo. O que acham?",
                                    "choices": [
                                        {
                                            "id": "745100111",
                                            "text": "Não tem fases suficientes.",
                                            "response": [
                                                {
                                                    "id": "745100112",
                                                    "speaker": "Haniyyah",
                                                    "text": "Isso se encaixa com nossa segunda previsão. Acho que teremos que fazer mais fases baseadas nos padrões mais altos para o próximo evento de prévia."
                                                },
                                                {
                                                    "id": "745100117",
                                                    "speaker": "Haniyyah",
                                                    "text": "Enfim, Souka fará mais pesquisa e desenvolverá mais inimigos interessantes e formidáveis para o jogo cair no gosto de Fontaine."
                                                },
                                                {
                                                    "id": "745100118",
                                                    "speaker": "Haniyyah",
                                                    "text": "Assim, Fonta, nosso patrocinador, se sentirá confiante em continuar nos financiando."
                                                },
                                                {
                                                    "id": "745100119",
                                                    "speaker": "Haniyyah",
                                                    "text": "Quando tivermos dinheiro suficiente, podemos sediar um torneio exatamente igual à Copa Nilotpala..."
                                                },
                                                {
                                                    "id": "745100120",
                                                    "speaker": "Haniyyah",
                                                    "text": "Não, algo ainda maior! E vamos melhorar o sistema tanto que vai ser o mais emocionante e interessante possível!"
                                                },
                                                {
                                                    "id": "745100121",
                                                    "speaker": "Paimon",
                                                    "text": "Oh, Paimon tá ficando animada só de pensar nisso!",
                                                    "choices": [
                                                        {
                                                            "id": "745100122",
                                                            "text": "Me falem se precisarem de ajuda!",
                                                            "response": [
                                                                {
                                                                    "id": "745100124",
                                                                    "speaker": "Haniyyah",
                                                                    "text": "Esse é um plano de longo prazo, por isso não estamos tão preocupadas assim com nosso progresso no curto prazo."
                                                                },
                                                                {
                                                                    "id": "745100125",
                                                                    "speaker": "Haniyyah",
                                                                    "text": "Com a orientação de Souka e Balfour, posso dizer com segurança que também estou nos negócios. Por isso, não se preocupem, não vamos encher o saco de vocês com os detalhes!"
                                                                },
                                                                {
                                                                    "id": "745100126",
                                                                    "speaker": "Haniyyah",
                                                                    "text": "Mesmo quando o evento prévio e as negociações acabarem, eu e Souka vamos ficar em Fontaine por um tempo, viajando com os Cogumelos."
                                                                },
                                                                {
                                                                    "id": "745100127",
                                                                    "speaker": "Haniyyah",
                                                                    "text": "Gostaríamos de enviar cartas para vocês periodicamente para te manter por dentro do projeto, e também para vocês saberem como os Cogumelos estão."
                                                                },
                                                                {
                                                                    "id": "745100128",
                                                                    "speaker": "Haniyyah",
                                                                    "text": "Mas pra isso, vamos precisar de um endereço de contato, ou não vamos ter como falar com vocês, tipo da última vez..."
                                                                },
                                                                {
                                                                    "id": "745100129",
                                                                    "speaker": "Paimon",
                                                                    "text": "Um endereço de contato?",
                                                                    "choices": [
                                                                        {
                                                                            "id": "745100130",
                                                                            "text": "Tipo um lugar que vamos a cada alguns dias.",
                                                                            "response": [
                                                                                {
                                                                                    "id": "745100132",
                                                                                    "speaker": "Souka",
                                                                                    "text": "Perfeito! Então, em nome de Haniyyah e dos Cogumelos, vou escrever para vocês regularmente!"
                                                                                },
                                                                                {
                                                                                    "id": "745100133",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "Tá combinado!"
                                                                                },
                                                                                {
                                                                                    "id": "745100134",
                                                                                    "speaker": "Haniyyah",
                                                                                    "text": "Nosso jogo ainda tá bem popular, por isso o evento vai durar um bom tempo."
                                                                                },
                                                                                {
                                                                                    "id": "745100135",
                                                                                    "speaker": "Haniyyah",
                                                                                    "text": "#Se vocês não estiverem muito ocupad{M#os}{F#as}, voltem para jogar a qualquer momento.",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "745100136",
                                                                                            "text": "Beleza!",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "745100138",
                                                                                                    "speaker": "Paimon",
                                                                                                    "text": "Hehe, Paimon tá se sentindo bem melhor. Agora que Haniyyah, Souka e os Cogumelos não vão mais estar tão longe, e não vamos mais ficar tão separados."
                                                                                                },
                                                                                                {
                                                                                                    "id": "745100139",
                                                                                                    "speaker": "Paimon",
                                                                                                    "text": "Paimon está muito animada para o próximo torneio. Como será que as coisas vão acontecer dessa vez?"
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "745100137",
                                                                                            "text": "Tempo é o que eu mais tenho!"
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "745100131",
                                                                            "text": "Tipo... a Guilda de Aventureiros?"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "745100123",
                                                            "text": "Sabemos um pouco sobre gestão!"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "745100113",
                                            "text": "O número de fases é perfeito.",
                                            "response": [
                                                {
                                                    "id": "745100114",
                                                    "speaker": "Haniyyah",
                                                    "text": "#Obrigada! Mas também pode ser que você estava muito ocupad{M#o}{F#a} e não tinha muito tempo para isso. Vamos preparar mais fases reserva, para uma eventual necessidade."
                                                }
                                            ]
                                        },
                                        {
                                            "id": "745100115",
                                            "text": "Adoro tudo que vocês bolarem, contanto que nossos Cogumigos apareçam mais!",
                                            "response": [
                                                {
                                                    "id": "745100116",
                                                    "speaker": "Haniyyah",
                                                    "text": "#Ha, você não mudou. Como Souka disse, você é noss{M#o}{F#a} chefe agora. Se houver algo que queria ver no jogo, só avisar."
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "745100105",
                            "text": "Você também foi bem formidável!"
                        }
                    ]
                }
            ]
        },
