    "talks": [
        {
            "id": "7566001",
            "objective": "",
            "dialogues": [
                {
                    "id": "756600101",
                    "speaker": "Xilonen",
                    "text": "Ufa... Com certeza o tempo está ótimo. Esta viagem realmente valeu a pena."
                },
                {
                    "id": "756600102",
                    "speaker": "Xilonen",
                    "text": "Hmm? Meus olhos me enganam, ou estou vendo \"Tuma{RUBY#[S]Esperança}ini\"?",
                    "choices": [
                        {
                            "id": "756600103",
                            "text": "Que coincidência, Xilonen.",
                            "response": [
                                {
                                    "id": "756600105",
                                    "speaker": "Black Screen",
                                    "text": "Você conta a Xilonen sobre Irade e as etapas do exame..."
                                },
                                {
                                    "id": "756600106",
                                    "speaker": "Xilonen",
                                    "text": "Ah, entendo... Quase esqueci. Eu realmente dei uma mão para ela antes. Na verdade, a etapa da nossa tribo está aqui perto."
                                },
                                {
                                    "id": "756600107",
                                    "speaker": "Xilonen",
                                    "text": "No início, ela só contou com a ajuda de \"Calamidade de Tetlahuitl\", Nkunga, e da \"Lâmina de Areia de Setiada\", Amuru."
                                },
                                {
                                    "id": "756600108",
                                    "speaker": "Xilonen",
                                    "text": "Mas esses dois não são muito adeptos de \"mobilidade\", preferindo confrontos diretos, então o retorno resultante ficou enviesado."
                                },
                                {
                                    "id": "756600109",
                                    "speaker": "Xilonen",
                                    "text": "A primeira coisa que Pacal fez ao ouvir isso foi me pedir para dar algumas sugestões.",
                                    "choices": [
                                        {
                                            "id": "756600110",
                                            "text": "Então, a etapa atual é obra sua?",
                                            "response": [
                                                {
                                                    "id": "756600111",
                                                    "speaker": "Xilonen",
                                                    "text": "Mais ou menos. Pacal, Irade e eu fizemos algumas modificações após algumas discussões."
                                                },
                                                {
                                                    "id": "756600112",
                                                    "speaker": "Xilonen",
                                                    "text": "Agora, as etapas são mais sobre posicionar-se rapidamente em terreno vantajoso e gerenciar um ponto de apoio móvel no calor da batalha.",
                                                    "choices": [
                                                        {
                                                            "id": "756600116",
                                                            "text": "Permita-me aceitar seu desafio, então!",
                                                            "response": [
                                                                {
                                                                    "id": "756600118",
                                                                    "speaker": "Xilonen",
                                                                    "text": "Por favor, todos em Natlan já presenciaram sua força. Duvido que qualquer desafio consiga derrotar você."
                                                                },
                                                                {
                                                                    "id": "756600119",
                                                                    "speaker": "Xilonen",
                                                                    "text": "De qualquer forma, a arena está ali. Experimente, se estiver a fim."
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "756600117",
                                                            "text": "Vamos torcer para que você não tenha tornado isso difícil demais..."
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "756600113",
                                            "text": "Você... realmente consegue fazer praticamente qualquer coisa, não é...",
                                            "response": [
                                                {
                                                    "id": "756600114",
                                                    "speaker": "Xilonen",
                                                    "text": "Eh, só alguns dispositivos simples. Não foi tão difícil construí-los."
                                                },
                                                {
                                                    "id": "756600115",
                                                    "speaker": "Xilonen",
                                                    "text": "Um esforço único da minha parte para o desenvolvimento de guerreiros mais fortes para a nossa tribo? Esse é um bom negócio — especialmente porque posso usar esse tempo livre extra para dar conta da minha fila de comissões...",
                                                    "choices": [
                                                        {
                                                            "id": "756600116",
                                                            "text": "Permita-me aceitar seu desafio, então!"
                                                        },
                                                        {
                                                            "id": "756600117",
                                                            "text": "Vamos torcer para que você não tenha tornado isso difícil demais..."
                                                        }
                                                    ]
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "756600104",
                            "text": "Aceitei a comissão de Irade."
                        }
                    ]
                }
            ]
        }
    ]
}