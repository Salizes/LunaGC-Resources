    "talks": [
        {
            "id": "7224901",
            "objective": "",
            "dialogues": [
                {
                    "id": "722490101",
                    "speaker": "Aberaku",
                    "text": "#Viajante, você está pront{M#o}{F#a}?"
                }
            ]
        },
        {
            "id": "7224905",
            "objective": "",
            "dialogues": [
                {
                    "id": "722490301",
                    "speaker": "Aberaku",
                    "text": "Meu nome é..."
                },
                {
                    "id": "722490302",
                    "speaker": "Aberaku",
                    "text": "Aberaku, criador de Helios!"
                },
                {
                    "id": "722490303",
                    "speaker": "Paimon",
                    "text": "Hã, o que é Helios?"
                },
                {
                    "id": "722490304",
                    "speaker": "Paimon",
                    "text": "É algo impressionante?"
                },
                {
                    "id": "722490305",
                    "speaker": "Aberaku",
                    "text": "Claro que sim! Fui eu quem organizou a construção de Helios com a determinação de toda uma nação. Só assim poderíamos resistir ao Dragão Herdeiro das Profundezas."
                },
                {
                    "id": "722490306",
                    "speaker": "Aberaku",
                    "text": "Esse feito insuperável não poderia ter sido feito por ninguém no Reino de Byakuya, somente eu!"
                },
                {
                    "id": "722490307",
                    "speaker": "Paimon",
                    "text": "Hã. Paimon acha que isso é bem impressionante."
                },
                {
                    "id": "722490308",
                    "speaker": "Paimon",
                    "text": "Mas por que uma pessoa tão importante assim estaria trancada aqui?"
                },
                {
                    "id": "722490309",
                    "speaker": "Aberaku",
                    "text": "Eu... eu fui traído..."
                },
                {
                    "id": "722490310",
                    "speaker": "Aberaku",
                    "text": "Quando o reino dos céus caiu nas profundezas, o povo foi atacado por dragões. E assim, eu — sim, eu — iniciei a construção de Helios para nos salvar de nosso destino."
                },
                {
                    "id": "722490311",
                    "speaker": "Aberaku",
                    "text": "Mas aqueles malditos gananciosos! No momento que suas vidas não estavam mais em perigo, começaram a enganar. Eles até mesmo defenderam colocar crianças no trono. Ridículos!"
                },
                {
                    "id": "722490312",
                    "speaker": "Aberaku",
                    "text": "Até eu me tornei alvo de seus esquemas, e me puseram na cadeia!"
                },
                {
                    "id": "722490313",
                    "speaker": "Aberaku",
                    "text": "Malditos! Desgraçados!"
                },
                {
                    "id": "722490314",
                    "speaker": "Aberaku",
                    "text": "Sim, você.",
                    "choices": [
                        {
                            "id": "722490315",
                            "text": "Eu?",
                            "response": [
                                {
                                    "id": "722490316",
                                    "speaker": "Paimon",
                                    "text": "É você."
                                },
                                {
                                    "id": "722490320",
                                    "speaker": "Aberaku",
                                    "text": "Só pode ser você!"
                                },
                                {
                                    "id": "722490321",
                                    "speaker": "Aberaku",
                                    "text": "Minhas roupas sagradas foram antes colocadas, mas todas elas se deterioraram com o passar dos anos, e agora não podem mais ser usadas."
                                },
                                {
                                    "id": "722490322",
                                    "speaker": "Aberaku",
                                    "text": "Mas se você puder passar no teste, lhe entregarei as oferendas com meus pensamentos."
                                },
                                {
                                    "id": "722490323",
                                    "speaker": "Aberaku",
                                    "text": "Espero que você tenha... Sucesso..."
                                },
                                {
                                    "id": "722490324",
                                    "speaker": "Aberaku",
                                    "text": "#Este é um assunto perigoso. Viajante, diga-me quando estiver pront{M#o}{F#a}."
                                }
                            ]
                        },
                        {
                            "id": "722490317",
                            "text": "Paimon, acho que ele está falando com você.",
                            "response": [
                                {
                                    "id": "722490318",
                                    "speaker": "Paimon",
                                    "text": "Não, ele claramente está olhando para você."
                                },
                                {
                                    "id": "722490319",
                                    "speaker": "Paimon",
                                    "text": "(E com uma olhada muito intimidante)."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7224902",
            "objective": "Começar o julgamento do espírito",
            "dialogues": [
                {
                    "id": "722490501",
                    "speaker": "Player",
                    "text": "#Estou pront{M#o}{F#a}."
                },
                {
                    "id": "722490502",
                    "speaker": "Aberaku",
                    "text": "Então, boa sorte para você."
                }
            ]
        },
        {
            "id": "7224904",
            "objective": "Obtenha as oferendas do espírito",
            "dialogues": [
                {
                    "id": "722490201",
                    "speaker": "Aberaku",
                    "text": "In—Incrível! Talvez você seja capaz de fazer isso..."
                },
                {
                    "id": "722490202",
                    "speaker": "Aberaku",
                    "text": "Por favor, lhe imploro, leve essas oferendas... Essas oferendas... Certamente..."
                },
                {
                    "id": "722490203",
                    "speaker": "Aberaku",
                    "text": "Você deve levá-las..."
                },
                {
                    "id": "722490204",
                    "speaker": "Aberaku",
                    "text": "Levá-las para..."
                },
                {
                    "id": "722490205",
                    "speaker": "Paimon",
                    "text": "O que foi?"
                },
                {
                    "id": "722490206",
                    "speaker": "Paimon",
                    "text": "Oh, não! Suas palavras estão ficando cada vez menos claras!"
                },
                {
                    "id": "722490207",
                    "speaker": "Aberaku",
                    "text": "Levem-nas para o local da oferenda... Ordenar as partes de minha alma para..."
                },
                {
                    "id": "722490208",
                    "speaker": "Paimon",
                    "text": "Olá? Senhor Espírito?"
                },
                {
                    "id": "722490209",
                    "speaker": "Aberaku",
                    "text": "Para eu poder..."
                },
                {
                    "id": "722490210",
                    "speaker": "Paimon",
                    "text": "Para fazer o quê?"
                },
                {
                    "id": "722490211",
                    "speaker": "Aberaku",
                    "text": "Para..."
                },
                {
                    "id": "722490212",
                    "speaker": "Paimon",
                    "text": "Argh, não há como entendermos esse senhor! Mas parece que devemos levar essas oferendas para algum lugar — pelo menos foi isso que Paimon entendeu."
                },
                {
                    "id": "722490213",
                    "speaker": "Paimon",
                    "text": "Essas oferendas estiveram aqui por muito tempo. Quem sabe se há algo de comestível por aqui..."
                },
                {
                    "id": "722490214",
                    "speaker": "Player",
                    "text": "Melhor não comê-las, Paimon..."
                },
                {
                    "id": "722490215",
                    "speaker": "Paimon",
                    "text": "Ei! Paimon não sai por aí comendo qualquer coisa!"
                },
                {
                    "id": "722490216",
                    "speaker": "Paimon",
                    "text": "#Bem, vamos levar essas oferendas conosco, {NICKNAME}."
                }
            ]
        },
        {
            "id": "7224906",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "722490601",
                    "speaker": "Player",
                    "text": "Não, preciso de mais um pouco de tempo."
                },
                {
                    "id": "722490602",
                    "speaker": "Aberaku",
                    "text": "Então ficarei esperando por você."
                }
            ]
        }
    ]
}