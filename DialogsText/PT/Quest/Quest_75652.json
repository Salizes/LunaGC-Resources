    "talks": [
        {
            "id": "7565201",
            "objective": "",
            "dialogues": [
                {
                    "id": "756520201",
                    "speaker": "Amber",
                    "text": "#Ei, é você, {NICKNAME}! Que surpresa te encontrar no Bosque Sussurrante novamente. Quais são as chances?"
                },
                {
                    "id": "756520202",
                    "speaker": "Amber",
                    "text": "#Já faz um tempo, não é? Com o que você anda ocupad{M#o}{F#a} ultimamente?",
                    "choices": [
                        {
                            "id": "756520203",
                            "text": "Mantendo registros dos lugares que fomos com fotos.",
                            "response": [
                                {
                                    "id": "756520205",
                                    "speaker": "Amber",
                                    "text": "Haha, faz sentido! A beleza e serenidade daqui realmente proporciona ótimas fotos."
                                },
                                {
                                    "id": "756520206",
                                    "speaker": "Amber",
                                    "text": "Esse é o meu segmento de patrulha favorito quando saio em missões de reconhecimento."
                                },
                                {
                                    "id": "756520207",
                                    "speaker": "Amber",
                                    "text": "Aqui também foi onde nos conhecemos pela primeira vez. Lembra que eu achei que você era uma pessoa suspeita naquela época? Ah, isso traz memórias vergonhosas a mente..."
                                },
                                {
                                    "id": "756520208",
                                    "speaker": "Amber",
                                    "text": "Afinal de contas, foi graças a sua ajuda que conseguimos resolver a crise com Dvalin, e restauramos a paz para Mondstadt."
                                },
                                {
                                    "id": "756520209",
                                    "speaker": "Amber",
                                    "text": "#Mas, quanto {M#a sua irmã}{F#ao seu irmão}... Infelizmente nenhum dos milhares de pôsteres de pessoa desaparecida ajudou...",
                                    "choices": [
                                        {
                                            "id": "756520210",
                                            "text": "Está tudo bem, Amber.",
                                            "response": [
                                                {
                                                    "id": "756520212",
                                                    "speaker": "Amber",
                                                    "text": "Obrigada. Mesmo assim, sinta-se livre para me avisar se houver qualquer coisa em que posso ajudar."
                                                },
                                                {
                                                    "id": "756520213",
                                                    "speaker": "Amber",
                                                    "text": "Afinal, sou Amber, a Aventureira dos Cavaleiros de Favonius, Campeã Voadora de Mondstadt — e sua amiga."
                                                },
                                                {
                                                    "id": "756520214",
                                                    "speaker": "Player",
                                                    "text": "Nesse caso, chega junto para a foto, por favor!"
                                                },
                                                {
                                                    "id": "756520215",
                                                    "speaker": "Amber",
                                                    "text": "Claro. Que tipo de pose eu deveria fazer?",
                                                    "choices": [
                                                        {
                                                            "id": "756520216",
                                                            "text": "Vamos tentar uma pose legal!",
                                                            "response": [
                                                                {
                                                                    "id": "756520219",
                                                                    "speaker": "Amber",
                                                                    "text": "Certo. Assim serve?",
                                                                    "choices": [
                                                                        {
                                                                            "id": "756520220",
                                                                            "text": "Perfeito. Diga xiiiis!",
                                                                            "response": [
                                                                                {
                                                                                    "id": "756520221",
                                                                                    "speaker": "Amber",
                                                                                    "text": "Tudo pronto."
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "756520222",
                                                                            "text": "A pose divertida deve servir melhor.",
                                                                            "response": [
                                                                                {
                                                                                    "id": "756520223",
                                                                                    "speaker": "Amber",
                                                                                    "text": "Tudo bem!"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "756520224",
                                                                            "text": "Aliás, vamos com a pose elegante.",
                                                                            "response": [
                                                                                {
                                                                                    "id": "756520225",
                                                                                    "speaker": "Amber",
                                                                                    "text": "Tudo bem!"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "756520226",
                                                                            "text": "Na verdade, vamos com a pose legal."
                                                                        },
                                                                        {
                                                                            "id": "756520227",
                                                                            "text": "Deixe-me pensar um pouco mais."
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "756520217",
                                                            "text": "Vamos tentar uma pose divertida!"
                                                        },
                                                        {
                                                            "id": "756520218",
                                                            "text": "Uma pose elegante."
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "756520211",
                                            "text": "Você fez o seu máximo."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "756520204",
                            "text": "Tirando fotos para lembrar de minha carreira lendária."
