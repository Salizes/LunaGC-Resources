            "dialogues": [
                {
                    "id": "719330101",
                    "speaker": "Player",
                    "text": "Não é inconveniente andar por aí à noite?"
                },
                {
                    "id": "719330102",
                    "speaker": "Ziwei",
                    "text": "Na verdade, um pouco."
                },
                {
                    "id": "719330103",
                    "speaker": "Ziwei",
                    "text": "Mas as estrelas só aparecem no céu noturno, por isso não há como evitar. Desenvolvi também uma medida preventiva."
                },
                {
                    "id": "719330104",
                    "speaker": "Ziwei",
                    "text": "É conhecido como Lâmpada de Grama, que brilha no escuro. Não é muito clara, mas te dá uma sensação de segurança."
                },
                {
                    "id": "719330105",
                    "speaker": "Ziwei",
                    "text": "Se você constantemente viaja no escuro, considere trazer alguns destes."
