    "talks": [
        {
            "id": "7066401",
            "objective": "Fale com Honglang",
            "dialogues": [
                {
                    "id": "706640101",
                    "speaker": "Honglang",
                    "text": "Toda vez que acontece algum problema, me enviam para resolvê-lo...",
                    "choices": [
                        {
                            "id": "706640102",
                            "text": "Hã? Você é...",
                            "response": [
                                {
                                    "id": "706640104",
                                    "speaker": "Honglang",
                                    "text": "É você! Que coincidência, eu nunca imaginei que encontraria com você aqui."
                                },
                                {
                                    "id": "706640105",
                                    "speaker": "Player",
                                    "text": "O que você está fazendo aqui?"
                                },
                                {
                                    "id": "706640106",
                                    "speaker": "Honglang",
                                    "text": "*Suspiro* Nem me fale. Você ainda se lembra daquele domínio estranho da última vez? É aquele... Aquele domínio cuja estrutura interna se alterava de acordo com as nossas intenções?"
                                },
                                {
                                    "id": "706640107",
                                    "speaker": "Honglang",
                                    "text": "Graças a sua ajuda para explorar aquele Domínio, eu obtive muitas informações. Depois que aquele Domínio desapareceu, eu voltei para reportar para Lan."
                                },
                                {
                                    "id": "706640108",
                                    "speaker": "Honglang",
                                    "text": "Eu repeti para ela várias vezes: isso tudo foi graças à você. Eu só dei uma quantidade insignificante de apoio."
                                },
                                {
                                    "id": "706640109",
                                    "speaker": "Honglang",
                                    "text": "Mas Lan não me deu ouvidos. Elogiou meu trabalho, e logo em seguida me passou a responsabilidade de liderar uma equipe para explorar mas Domínios desconhecidos como aquele.",
                                    "choices": [
                                        {
                                            "id": "706640110",
                                            "text": "Parece ótimo.",
                                            "response": [
                                                {
                                                    "id": "706640112",
                                                    "speaker": "Honglang",
                                                    "text": "Bom como? Eu era um Aventureiro comum, livre, que não ficava preso a regras, fazia o que gostava."
                                                },
                                                {
                                                    "id": "706640113",
                                                    "speaker": "Honglang",
                                                    "text": "Apesar de antes ganhar pouca Mora, eu tinha liberdade. Agora Lan me deu esse fardo para carregar, e eu não consigo mais suportá-lo... *Suspiro*"
                                                },
                                                {
                                                    "id": "706640114",
                                                    "speaker": "Honglang",
                                                    "text": "Mas chega desse assunto, vamos falar de algo importante. Está vendo esse portal? Por trás dele há outro Domínio estranho."
                                                },
                                                {
                                                    "id": "706640115",
                                                    "speaker": "Honglang",
                                                    "text": "E esse Domínio está cheio de correntes de vento."
                                                },
                                                {
                                                    "id": "706640116",
                                                    "speaker": "Player",
                                                    "text": "São as correntes de vento que estou pensando?"
                                                },
                                                {
                                                    "id": "706640117",
                                                    "speaker": "Honglang",
                                                    "text": "Sim, aquelas que você encontra na natureza, vuush para lá e para cá.... São as correntes de vento que os Aventureiros usam para voarem até lugares altos em seus Planadores."
                                                },
                                                {
                                                    "id": "706640118",
                                                    "speaker": "Honglang",
                                                    "text": "Mas a distribuição das correntes de vento dentro deste domínio é um caos. Algumas correntes de vento sopram umas contra as outras, formando áreas que é impossível voar."
                                                },
                                                {
                                                    "id": "706640119",
                                                    "speaker": "Honglang",
                                                    "text": "Eu convidei alguns aventureiros habilidosos para fazerem uma investigação, mas eles não conseguiram explorar muito longe e foram forçados a voltar."
                                                },
                                                {
                                                    "id": "706640120",
                                                    "speaker": "Honglang",
                                                    "text": "Segundo eles, há alguns mecanismos no interior desse Domínio que após ativados afetam algumas dessas correntes de vento..."
                                                },
                                                {
                                                    "id": "706640121",
                                                    "speaker": "Honglang",
                                                    "text": "Mas antes que eles pudessem entender o uso específico desses mecanismos, um monte de monstros apareceram do nada, por isso tiveram que sair."
                                                },
                                                {
                                                    "id": "706640122",
                                                    "speaker": "Honglang",
                                                    "text": "Depois de discutirmos, chegamos à conclusão de que se pudéssemos utilizar esses mecanismos talvez conseguíssemos explorar com sucesso esse domínio...",
                                                    "choices": [
                                                        {
                                                            "id": "706640123",
                                                            "text": "Você entrou para explorar?",
                                                            "response": [
                                                                {
                                                                    "id": "706640125",
                                                                    "speaker": "Honglang",
                                                                    "text": "Ah, qual é, você sabe... eu... eu não tenho muita resistência física, e não sou muito bom com um planador."
                                                                },
                                                                {
                                                                    "id": "706640126",
                                                                    "speaker": "Honglang",
                                                                    "text": "Eu consigo voar em condições normais, mas com a situação nesse Domínio..."
                                                                },
                                                                {
                                                                    "id": "706640127",
                                                                    "speaker": "Honglang",
                                                                    "text": "Se eu entrasse para explorar, com certeza o vento me faria voar para todo lado como uma folha, me jogando contra um monte de monstros."
                                                                },
                                                                {
                                                                    "id": "706640128",
                                                                    "speaker": "Honglang",
                                                                    "text": "Viajante, eu já presenciei sua capacidade antes. Sua resistência física é boa, e você também é inteligente..."
                                                                },
                                                                {
                                                                    "id": "706640129",
                                                                    "speaker": "Honglang",
                                                                    "text": "Você aceitaria me ajudar a explorar esse Domínio?"
                                                                },
                                                                {
                                                                    "id": "706640130",
                                                                    "speaker": "Honglang",
                                                                    "text": "Quanto a pagamento, não se preocupe. Eu garanto sua recompensa.",
                                                                    "choices": [
                                                                        {
                                                                            "id": "706640131",
                                                                            "text": "Bem, acho que vou tentar.",
                                                                            "response": [
                                                                                {
                                                                                    "id": "706640132",
                                                                                    "speaker": "Honglang",
                                                                                    "text": "Ótimo, muito obrigado!"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "706640133",
                                                                            "text": "Há tesouros dentro?",
                                                                            "response": [
                                                                                {
                                                                                    "id": "706640134",
                                                                                    "speaker": "Honglang",
                                                                                    "text": "Eu não tenho certeza, pois nunca exploramos profundamente esse Domínio..."
                                                                                },
                                                                                {
                                                                                    "id": "706640135",
                                                                                    "speaker": "Honglang",
                                                                                    "text": "Mas... Não se preocupe! Você pode ficar com qualquer tesouro que descobrir enquanto explorar!"
                                                                                },
                                                                                {
                                                                                    "id": "706640136",
                                                                                    "speaker": "Honglang",
                                                                                    "text": "Bem, conto com você, Viajante."
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "706640124",
                                                            "text": "Você não liderou o grupo?"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "706640111",
                                            "text": "Deve ser algo bom."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "706640103",
                            "text": "Nos encontramos novamente."
                        }
                    ]
                }
            ]
        }
    ]
}