    "talks": [
        {
            "id": "7469701",
            "objective": "Fale com Yumemizuki Mizuki",
            "dialogues": [
                {
                    "id": "746970101",
                    "speaker": "Paimon",
                    "text": "Ei? Não é Mizuki e seus dois Mini Bakus? Já estão conversando com Barbeloth?"
                },
                {
                    "id": "746970102",
                    "speaker": "Yumemizuki Mizuki",
                    "text": "#{NICKNAME} e Paimon...? Acabei de ouvir a Srta. Barbeloth falar de vocês, e fiquei me perguntando se teria a chance de encontrá-l{F#a}{M#o}s por acaso."
                },
                {
                    "id": "746970103",
                    "speaker": "Yumemizuki Mizuki",
                    "text": "Heh... parece que o destino já havia determinado o lugar onde nos encontraríamos."
                },
                {
                    "id": "746970104",
                    "speaker": "Player",
                    "text": "Você está aqui de férias, Mizuki?"
                },
                {
                    "id": "746970105",
                    "speaker": "Yumemizuki Mizuki",
                    "text": "Hmmm... pode-se dizer que sim. Se os preparativos para esse filme educacional sobre psicologia correr bem, terei tempo para descansar. Até lá, ainda preciso focar no meu trabalho.",
                    "choices": [
                        {
                            "id": "746970106",
                            "text": "Um filme sobre psicologia?",
                            "response": [
                                {
                                    "id": "746970108",
                                    "speaker": "Paimon",
                                    "text": "Uau, filmes podem fazer isso? Incrível!"
                                },
                                {
                                    "id": "746970109",
                                    "speaker": "Yumemizuki Mizuki",
                                    "text": "Sim, é uma ideia nova que tive. Quando eu estava promovendo os Banhos de Aisa, me inspirei no cinema de Fontaine, e gravei alguns episódios para um show de variedades."
                                },
                                {
                                    "id": "746970110",
                                    "speaker": "Yumemizuki Mizuki",
                                    "text": "As pessoas adoraram. Não só assistiram a todos os episódios, como também memorizaram todos os conceitos psicológicos que apresentamos."
                                },
                                {
                                    "id": "746970111",
                                    "speaker": "Yumemizuki Mizuki",
                                    "text": "Então pensei: por que não fazer alguns filmes sobre transtornos mentais como uma forma divertida e educativa de explicar conceitos psicológicos básicos?"
                                },
                                {
                                    "id": "746970112",
                                    "speaker": "Yumemizuki Mizuki",
                                    "text": "...Se eu conseguir aumentar a conscientização básica de todos, talvez as pessoas possam desenvolver uma compreensão mais objetiva sobre o que são os transtornos mentais."
                                },
                                {
                                    "id": "746970157",
                                    "speaker": "Yumemizuki Mizuki",
                                    "text": "...Talvez eu consiga impedir que as pessoas descartem essas condições como bobagens inventadas, ou que as tratem como um bicho-papão aterrorizante."
                                },
                                {
                                    "id": "746970113",
                                    "speaker": "Yumemizuki Mizuki",
                                    "text": "E talvez minhas futuras sessões de terapia sejam um pouco mais tranquilas...",
                                    "choices": [
                                        {
                                            "id": "746970114",
                                            "text": "Você pensou bastante nisso...",
                                            "response": [
                                                {
                                                    "id": "746970116",
                                                    "speaker": "Yumemizuki Mizuki",
                                                    "text": "Claro. Afinal, as doenças da mente são invisíveis, e difíceis de pegar... Até mesmo detectá-las é difícil..."
                                                },
                                                {
                                                    "id": "746970117",
                                                    "speaker": "Yumemizuki Mizuki",
                                                    "text": "Hehe... Mas nem eu sei como fazer elas caberem em um roteiro..."
                                                },
                                                {
                                                    "id": "746970118",
                                                    "speaker": "Yumemizuki Mizuki",
                                                    "text": "É constrangedor admitir isso, mas apesar de eu já ter escrito muitos artigos sobre saúde mental, não consigo escrever um roteiro de cinema."
                                                },
                                                {
                                                    "id": "746970119",
                                                    "speaker": "Yumemizuki Mizuki",
                                                    "text": "Às vezes, me tranco no meu quarto um dia inteiro, revisando o tempo todo algumas linhas de diálogo, ou alguns segundos de trama... Ainda assim, no final não tenho nada para mostrar.",
                                                    "choices": [
                                                        {
                                                            "id": "746970120",
                                                            "text": "Isso parece exaustivo...",
                                                            "response": [
                                                                {
                                                                    "id": "746970122",
                                                                    "speaker": "Paimon",
                                                                    "text": "#Talvez você precise de inspiração. Quando Paimon e {NICKNAME} estão empacad{F#as}{M#os} com algo, vamos fazer outra coisa. Talvez seja isso que você precise para encontrar sua musa!"
                                                                },
                                                                {
                                                                    "id": "746970123",
                                                                    "speaker": "Yumemizuki Mizuki",
                                                                    "text": "Sim, eu concordo com você, Paimon. É por isso que assim que cheguei aqui, quis experimentar esse tal de Rolinho da Sorte. É uma forma bem peculiar de fazer adivinhações para sua sorte."
                                                                },
                                                                {
                                                                    "id": "746970124",
                                                                    "speaker": "Yumemizuki Mizuki",
                                                                    "text": "Espero que esses Arcanos Lunares da bruxa me inspirem."
                                                                },
                                                                {
                                                                    "id": "746970125",
                                                                    "speaker": "Barbeloth",
                                                                    "text": "Inspiração... Anya disse uma vez que ela queria escrever um conto de fadas para todas as cartas do Arcano Lunar. Mas ela queria escrever tantas histórias, e tinha tão pouco tempo..."
                                                                },
                                                                {
                                                                    "id": "746970126",
                                                                    "speaker": "Barbeloth",
                                                                    "text": "Já que você tá procurando por inspiração, tire uma carta, Srta. Youkai. Espero que esse conto de fadas incompleto daquela bruxa possa lhe inspirar."
                                                                },
                                                                {
                                                                    "id": "746970127",
                                                                    "speaker": "Yumemizuki Mizuki",
                                                                    "text": "Certo, Srta. Barbeloth. Mas... a maioria do que sei sobre adivinhação envolve o Grande Santuário Narukami... Essa é a primeira vez que leio a sorte com cartas..."
                                                                },
                                                                {
                                                                    "id": "746970128",
                                                                    "speaker": "Yumemizuki Mizuki",
                                                                    "text": "Se eu fizer algo que quebre a etiqueta do ritual, pode me avisar."
                                                                },
                                                                {
                                                                    "id": "746970129",
                                                                    "speaker": "Barbeloth",
                                                                    "text": "Oh, céus, a Lua Invertida..."
                                                                },
                                                                {
                                                                    "id": "746970130",
                                                                    "speaker": "Barbeloth",
                                                                    "text": "Os significados da Lua, tanto na posição reta quanto invertida, são semelhantes — \"escapismo\", \"ilusão\", e \"autoenganação\"..."
                                                                },
                                                                {
                                                                    "id": "746970158",
                                                                    "speaker": "Barbeloth",
                                                                    "text": "Como alguém viajando sob uma lua escura, que perdeu o caminho à frente mas não sabe como se libertar.",
                                                                    "choices": [
                                                                        {
                                                                            "id": "746970131",
                                                                            "text": "Isso não parece muito bom...",
                                                                            "response": [
                                                                                {
                                                                                    "id": "746970133",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "Sim, por que essa carta soa tipo um aviso? Paimon não tá com um bom pressentimento..."
                                                                                },
                                                                                {
                                                                                    "id": "746970134",
                                                                                    "speaker": "Barbeloth",
                                                                                    "text": "Entretanto, já que a Srta. Yumemizuki ainda pode ouvir essa profecia, isso quer dizer que a situação ainda não está tão crítica."
                                                                                },
                                                                                {
                                                                                    "id": "746970135",
                                                                                    "speaker": "Barbeloth",
                                                                                    "text": "Com um certo esforço, talvez você consiga sair dessa neblina que obscurece o seu caminho em frente, e encontre aquilo que você busca..."
                                                                                },
                                                                                {
                                                                                    "id": "746970136",
                                                                                    "speaker": "Yumemizuki Mizuki",
                                                                                    "text": "Escapismo, ilusão, e... mentir para si mesmo?"
                                                                                },
                                                                                {
                                                                                    "id": "746970137",
                                                                                    "speaker": "Barbeloth",
                                                                                    "text": "Bem, interpretar a carta de forma literal, sim. De um jeito mais simples..."
                                                                                },
                                                                                {
                                                                                    "id": "746970138",
                                                                                    "speaker": "Barbeloth",
                                                                                    "text": "Você está fugindo de uma resposta que está na frente de seus olhos, procurando longe quando deveria estar olhando perto."
                                                                                },
                                                                                {
                                                                                    "id": "746970139",
                                                                                    "speaker": "Yumemizuki Mizuki",
                                                                                    "text": "Você está dizendo que há alguém que pode revisar meu roteiro bem na minha frente?"
                                                                                },
                                                                                {
                                                                                    "id": "746970140",
                                                                                    "speaker": "Barbeloth",
                                                                                    "text": "Não só o roteiro, mas como você interpreta o significado por trás da carta é por sua conta."
                                                                                },
                                                                                {
                                                                                    "id": "746970141",
                                                                                    "speaker": "Yumemizuki Mizuki",
                                                                                    "text": "..."
                                                                                },
                                                                                {
                                                                                    "id": "746970142",
                                                                                    "speaker": "Yumemizuki Mizuki",
                                                                                    "text": "A resposta está bem na minha frente, mas estou procurando longe quando deveria olhar por perto... Acho que entendo o que você quer dizer."
                                                                                },
                                                                                {
                                                                                    "id": "746970143",
                                                                                    "speaker": "Yumemizuki Mizuki",
                                                                                    "text": "Hehe, falando dessa forma, acho que estive me enganando mesmo... Ou, melhor, não consigo evitar procurar longe quando deveria procurar por perto."
                                                                                },
                                                                                {
                                                                                    "id": "746970144",
                                                                                    "speaker": "Yumemizuki Mizuki",
                                                                                    "text": "Pensei em visitar a Editora Yae e perguntar a Guuji Yae por algum conselho, mas então..."
                                                                                },
                                                                                {
                                                                                    "id": "746970145",
                                                                                    "speaker": "Yumemizuki Mizuki",
                                                                                    "text": "De um ponto de vista clínico, isso conta como evitação inconsciente."
                                                                                },
                                                                                {
                                                                                    "id": "746970146",
                                                                                    "speaker": "Yumemizuki Mizuki",
                                                                                    "text": "Obrigada por sua adivinhação, Srta. Barbeloth. Você me ajudou a encontrar inspiração no final."
                                                                                },
                                                                                {
                                                                                    "id": "746970147",
                                                                                    "speaker": "Barbeloth",
                                                                                    "text": "Não precisa me agradecer. Eu não fiz nada. Você desaninhou os fios do destino sozinha. Eu apenas coloquei as pontas nas suas mãos."
                                                                                },
                                                                                {
                                                                                    "id": "746970148",
                                                                                    "speaker": "Barbeloth",
                                                                                    "text": "Entretanto, Guuji Yae também é alguém que foi forçada pelo destino."
                                                                                },
                                                                                {
                                                                                    "id": "746970149",
                                                                                    "speaker": "Barbeloth",
                                                                                    "text": "Fios entrelaçados costumam causar problemas. Com isso em mente, manter sua distância não necessariamente seria algo ruim."
                                                                                },
                                                                                {
                                                                                    "id": "746970150",
                                                                                    "speaker": "Yumemizuki Mizuki",
                                                                                    "text": "Se eu simplesmente pedir o comentário dela sobre meu roteiro, isso não quer dizer trazer o destino para o meio disso, né?"
                                                                                },
                                                                                {
                                                                                    "id": "746970151",
                                                                                    "speaker": "Barbeloth",
                                                                                    "text": "Como eu disse, como você interpreta é por sua conta, Srta. Yumemizuki. Eu não posso ver toda reviravolta no seu futuro ao ler só uma carta."
                                                                                },
                                                                                {
                                                                                    "id": "746970152",
                                                                                    "speaker": "Barbeloth",
                                                                                    "text": "Quem pode perceber todo obstáculo no caminho do destino antes de tropeçar nele?"
                                                                                },
                                                                                {
                                                                                    "id": "746970153",
                                                                                    "speaker": "Barbeloth",
                                                                                    "text": "Às vezes, é como aquela pirralha disse..."
                                                                                },
                                                                                {
                                                                                    "id": "746970154",
                                                                                    "speaker": "Barbeloth",
                                                                                    "text": "\"... O destino não pode ser mudado, nem desrespeitado, mas só aceitado, é exatamente por causa disso, o destino é chamado destino.\""
                                                                                },
                                                                                {
                                                                                    "id": "746970155",
                                                                                    "speaker": "Yumemizuki Mizuki",
                                                                                    "text": "..."
                                                                                },
                                                                                {
                                                                                    "id": "746970156",
                                                                                    "speaker": "Barbeloth",
                                                                                    "text": "Enfim, Srta. Yumemizuki, estou muito ansiosa pelo seu filme. Hahahaha..."
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "746970132",
                                                                            "text": "Isso soa um pouco negativo..."
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "746970121",
                                                            "text": "Você precisa relaxar..."
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "746970115",
                                            "text": "Você realmente pensou muito nisso..."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "746970107",
                            "text": "Isso é uma nova forma de terapia?"
                        }
                    ]
                }
            ]
        },
