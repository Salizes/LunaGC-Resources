    "talks": [
        {
            "id": "2050301",
            "objective": "",
            "dialogues": [
                {
                    "id": "205030101",
                    "speaker": "Paimon",
                    "text": "As nossas aventuras se tornarão cada vez mais perigosas. Na minha opinião... É melhor nos prepararmos."
                }
            ]
        },
        {
            "id": "2050302",
            "objective": "Fale com o Ferreiro Wagner",
            "dialogues": [
                {
                    "id": "205030201",
                    "speaker": "Wagner",
                    "text": "Do que você precisa?",
                    "choices": [
                        {
                            "id": "205030202",
                            "text": "Estou procurando por uma arma.",
                            "response": [
                                {
                                    "id": "205030203",
                                    "speaker": "Wagner",
                                    "text": "Aqui, você pode escolher. Se você precisar de algo especial, posso mandar fazer."
                                },
                                {
                                    "id": "205030207",
                                    "speaker": "Paimon",
                                    "text": "Uau, dá para pedir para fazer sob encomenda..."
                                },
                                {
                                    "id": "205030208",
                                    "speaker": "Wagner",
                                    "text": "Claro. Vender, fazer por encomenda e refinar as armas são todos os negócios de um ferreiro."
                                },
                                {
                                    "id": "205030209",
                                    "speaker": "Wagner",
                                    "text": "Tudo o que você precisa são de minérios.",
                                    "choices": [
                                        {
                                            "id": "205030210",
                                            "text": "Onde eu posso encontrar minérios?",
                                            "response": [
                                                {
                                                    "id": "205030211",
                                                    "speaker": "Wagner",
                                                    "text": "Está por toda a parte."
                                                },
                                                {
                                                    "id": "205030214",
                                                    "speaker": "Wagner",
                                                    "text": "#Você parece {M#confuso}{F#confusa}. Bem, que tal este? Eu posso contar onde que você pode encontrar pedaços de ferro ao redor."
                                                },
                                                {
                                                    "id": "205030215",
                                                    "speaker": "Wagner",
                                                    "text": "Traga os pedaços de ferro para mim e eu ajudarei a forjar o que você precisa."
                                                },
                                                {
                                                    "id": "205030216",
                                                    "speaker": "Player",
                                                    "text": "#Ótimo! Obrigad{M#o}{F#a}!"
                                                },
                                                {
                                                    "id": "205030217",
                                                    "speaker": "Wagner",
                                                    "text": "De nada, eu tenho outras coisas para fazer."
                                                }
                                            ]
                                        },
                                        {
                                            "id": "205030212",
                                            "text": "Você vende aqui?",
                                            "response": [
                                                {
                                                    "id": "205030213",
                                                    "speaker": "Wagner",
                                                    "text": "Não. Compre de outra pessoa, eu mal tenho para mim."
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "205030204",
                            "text": "Estou procurando uma arma para a Paimon.",
                            "response": [
                                {
                                    "id": "205030205",
                                    "speaker": "Paimon",
                                    "text": "Nunca ouvi falar disso! Você quer que eu fique na vanguarda?"
                                },
                                {
                                    "id": "205030206",
                                    "speaker": "Wagner",
                                    "text": "Ela é muito pequena, então precisa tem que ser feito sob medida."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2050303",
            "objective": "",
            "dialogues": [
                {
                    "id": "205030301",
                    "speaker": "Paimon",
                    "text": "Ali está o ferreiro!"
                }
            ]
        },
        {
            "id": "2050304",
            "objective": "Colete três Pedaços de Ferro e entregue ao Wagner",
            "dialogues": [
                {
                    "id": "205030401",
                    "speaker": "Paimon",
                    "text": "Ele parece ser uma pessoa de temperamento agressivo. O que devemos dizer?"
                }
            ]
        },
        {
            "id": "2050305",
            "objective": "Fale com o Ferreiro Wagner",
            "dialogues": [
                {
                    "id": "205030501",
                    "speaker": "Wagner",
                    "text": "O que você quer?",
                    "choices": [
                        {
                            "id": "205030502",
                            "text": "Eu trouxe os pedaços de ferro.",
                            "response": [
                                {
                                    "id": "205030504",
                                    "speaker": "Wagner",
                                    "text": "Ah, sim. Eu tinha me esquecido disso."
                                },
                                {
                                    "id": "205030505",
                                    "speaker": "Wagner",
                                    "text": "Aqui estão eles. Veja essa coloração, eles ainda podem ser usados."
                                },
                                {
                                    "id": "205030506",
                                    "speaker": "Wagner",
                                    "text": "Gostaria que pudesse ser feito algo."
                                }
                            ]
                        },
                        {
                            "id": "205030503",
                            "text": "Lembra... você me pediu para trazer pedaços de ferro..."
                        }
                    ]
                }
            ]
        },
        {
            "id": "2050306",
            "objective": "",
            "dialogues": [
                {
                    "id": "205030601",
                    "speaker": "Wagner",
                    "text": "Se você encontrar mineral no futuro, pode sempre vir me procurar."
                },
                {
                    "id": "205030602",
                    "speaker": "Wagner",
                    "text": "Claro, de preferência quando eu não estiver ocupado."
                },
                {
                    "id": "205030603",
                    "speaker": "Player",
                    "text": "Você parece estar de mal humor."
                },
                {
                    "id": "205030604",
                    "speaker": "Wagner",
                    "text": "O trabalho de um ferreiro requer foco e concentração. Eu não gosto de ficar jogando conversa fora."
                },
                {
                    "id": "205030605",
                    "speaker": "Wagner",
                    "text": "Quando a habilidade é boa, o negócio irá bem. É tudo uma questão de troca mútua, e qualquer coisa diferente que falarem a você, é mentira."
                },
                {
                    "id": "205030606",
                    "speaker": "Wagner",
                    "text": "Se você não tiver mais nada a dizer, eu vou voltar ao meu trabalho."
                }
            ]
        }
    ]
