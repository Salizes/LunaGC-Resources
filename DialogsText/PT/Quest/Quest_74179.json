            "dialogues": [
                {
                    "id": "741790301",
                    "speaker": "Player",
                    "text": "(Trocar a Espada da Cruz de Narcissus para Pneuma.)"
                },
                {
                    "id": "741790302",
                    "speaker": "Espada da Cruz de Narcissus",
                    "text": "(Mesmo que o sol seja extinto e a escuridão cubra o mundo, a antiga Espada Sagrada brilhará sutilmente para iluminar o caminho adiante.)"
                }
            ]
        },
        {
