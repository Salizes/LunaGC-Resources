    "talks": [
        {
            "id": "7611601",
            "objective": "",
            "dialogues": [
                {
                    "id": "761160101",
                    "speaker": "Anezka",
                    "text": "#Olha, se não são noss{M#os}{F#as} amig{M#os}{F#as}, e de Bobik também!",
                    "choices": [
                        {
                            "id": "761160102",
                            "text": "Então, o que vocês vão fazer...",
                            "response": [
                                {
                                    "id": "761160103",
                                    "speaker": "Anezka",
                                    "text": "Vamos ficar aqui por mais um tempo. Quero dizer, a porta do laboratório de Drzislav foi destruída, então temos que ficar aqui para impedir aqueles vilões de encontrarem o caminho para dentro!"
                                },
                                {
                                    "id": "761160104",
                                    "speaker": "Anezka",
                                    "text": "Quando a gente consertar a porta, ou quando Slava voltar, provavelmente vamos fazer como vocês e viajar com Bobik!"
                                }
                            ]
                        },
                        {
                            "id": "761160105",
                            "text": "Então, sobre Drzislav...",
                            "response": [
                                {
                                    "id": "761160106",
                                    "speaker": "Anezka",
                                    "text": "Não faço ideia de onde ele possa estar... Mas se você encontrar ele nas suas viagens, digam oi para ele por nós!"
                                },
                                {
                                    "id": "761160107",
                                    "speaker": "Anezka",
                                    "text": "Eu adoraria ficar a noite toda bebendo com ele no Navio-Chefe de novo!"
                                }
                            ]
                        },
                        {
                            "id": "761160108",
                            "text": "Então como vai Bobik...",
                            "response": [
                                {
                                    "id": "761160109",
                                    "speaker": "Anezka",
                                    "text": "Ooh, já tá com saudades dele? Não se preocupe, só venha aqui quando estiver livre e você pode brincar com ele!"
                                }
                            ]
                        },
                        {
                            "id": "761160110",
                            "text": "Tchau.",
                            "response": [
                                {
                                    "id": "761160111",
                                    "speaker": "Anezka",
                                    "text": "Sim. Não se preocupe, vamos nos encontrar de novo com certeza. Somos melhores amigos juntos para o que der e vier, afinal!"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
