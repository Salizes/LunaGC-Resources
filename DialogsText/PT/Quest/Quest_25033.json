    "talks": [
        {
            "id": "2503301",
            "objective": "Fale com Tlathe",
            "dialogues": [
                {
                    "id": "250330101",
                    "speaker": "Tlathe",
                    "text": "Bom garoto, bom garoto! Comeu o bastante hoje? Pronto para treinar?"
                },
                {
                    "id": "250330102",
                    "speaker": "Jika",
                    "text": "Roar~!"
                },
                {
                    "id": "250330103",
                    "speaker": "Tlathe",
                    "text": "Você está bem enérgico hoje, não é? Maravilha! Vamos lá!"
                },
                {
                    "id": "250330104",
                    "speaker": "Player",
                    "text": "É, vamos lá!"
                },
                {
                    "id": "250330106",
                    "speaker": "Tlathe",
                    "text": "Hã? Oh, olá! Estamos fazendo um pouco de treinamento de alpinismo no momento."
                },
                {
                    "id": "250330107",
                    "speaker": "Jika",
                    "text": "Roar! Roar!"
                },
                {
                    "id": "250330108",
                    "speaker": "Jika",
                    "text": "Rawwr...",
                    "choices": [
                        {
                            "id": "250330109",
                            "text": "Como está indo o treinamento?",
                            "response": [
                                {
                                    "id": "250330110",
                                    "speaker": "Tlathe",
                                    "text": "Bem... estamos \"progredindo\". Jika subiu bem mais alto dessa vez."
                                },
                                {
                                    "id": "250330111",
                                    "speaker": "Tlathe",
                                    "text": "É só que Jika não é muito familiar com como escalar montanhas, e..."
                                },
                                {
                                    "id": "250330116",
                                    "speaker": "Tlathe",
                                    "text": "A propósito, você poderia demonstrar para a gente de novo?",
                                    "choices": [
                                        {
                                            "id": "250330117",
                                            "text": "Claro.",
                                            "response": [
                                                {
                                                    "id": "250330118",
                                                    "speaker": "Tlathe",
                                                    "text": "Muito obrigado! Tenho certeza que serei capaz de captar seus movimentos dessa vez."
                                                },
                                                {
                                                    "id": "250330119",
                                                    "speaker": "Tlathe",
                                                    "text": "Também fique de olhos abertos, tudo bem, Jika?"
                                                },
                                                {
                                                    "id": "250330120",
                                                    "speaker": "Jika",
                                                    "text": "Rawr!"
                                                },
                                                {
                                                    "id": "250330123",
                                                    "speaker": "Tlathe",
                                                    "text": "Estamos contando com você!"
                                                },
                                                {
                                                    "id": "250330124",
                                                    "speaker": "Tlathe",
                                                    "text": "Então o que faremos é cronometrar enquanto você sobe."
                                                },
                                                {
                                                    "id": "250330125",
                                                    "speaker": "Jika",
                                                    "text": "Rawr..."
                                                }
                                            ]
                                        },
                                        {
                                            "id": "250330121",
                                            "text": "Assista com atenção dessa vez, tudo bem?",
                                            "response": [
                                                {
                                                    "id": "250330122",
                                                    "speaker": "Tlathe",
                                                    "text": "É claro! Jika e eu não vamos perder nadinha dessa vez!"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "250330112",
                            "text": "Parece que ele está se recuperando bem.",
                            "response": [
                                {
                                    "id": "250330113",
                                    "speaker": "Tlathe",
                                    "text": "Isso mesmo. A mamãe disse que estou ficando muito bom em cuidar dele."
                                },
                                {
                                    "id": "250330114",
                                    "speaker": "Tlathe",
                                    "text": "Jika melhorou muito. Ele consegue subir bem mais alto do que podia da última vez."
                                },
                                {
                                    "id": "250330115",
                                    "speaker": "Tlathe",
                                    "text": "É só que Jika não é muito familiar com como você escala montanhas, e..."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2503302",
            "objective": "Escale até o topo da montanha",
            "dialogues": [
                {
                    "id": "250330201",
                    "speaker": "Tlathe",
                    "text": "#Você é incrível! Você é quase tão rápid{M#o}{F#a} quanto Mayta!",
                    "choices": [
                        {
                            "id": "250330202",
                            "text": "Eu cometi alguns erros...",
                            "response": [
                                {
                                    "id": "250330204",
                                    "speaker": "Tlathe",
                                    "text": "#Heh, você já foi rápid{M#o}{F#a} o suficiente. Jika e eu não nos comparamos."
                                },
                                {
                                    "id": "250330205",
                                    "speaker": "Tlathe",
                                    "text": "*Suspira* Eu diria que treinaremos por um bom tempo antes de conseguirmos nos equiparar a você..."
                                },
                                {
                                    "id": "250330206",
                                    "speaker": "Jika",
                                    "text": "Rawr...",
                                    "choices": [
                                        {
                                            "id": "250330207",
                                            "text": "Você consegue, Jika!",
                                            "response": [
                                                {
                                                    "id": "250330209",
                                                    "speaker": "Jika",
                                                    "text": "Roar? Roar..."
                                                },
                                                {
                                                    "id": "250330210",
                                                    "speaker": "Tlathe",
                                                    "text": "Bom garoto, Jika. Lembra do que tio Yawar disse? Ficaremos fortes desde que continuemos trabalhando bastante!"
                                                },
                                                {
                                                    "id": "250330211",
                                                    "speaker": "Jika",
                                                    "text": "Roar..."
                                                },
                                                {
                                                    "id": "250330212",
                                                    "speaker": "Tlathe",
                                                    "text": "Enfim, muito obrigado pela sua ajuda. Aqui, fique com essa fruta!"
                                                },
                                                {
                                                    "id": "250330213",
                                                    "speaker": "Tlathe",
                                                    "text": "Jika acabou de colher — e sabe, ele está se movendo mais rápido do que de costume!"
                                                },
                                                {
                                                    "id": "250330214",
                                                    "speaker": "Tlathe",
                                                    "text": "Hehe, tenho certeza que ele ficou assim tão bom, pois tinha você como exemplo!"
                                                },
                                                {
                                                    "id": "250330215",
                                                    "speaker": "Jika",
                                                    "text": "Rawr, rawrrr!"
                                                },
                                                {
                                                    "id": "250330216",
                                                    "speaker": "Tlathe",
                                                    "text": "Muito bem, então, vamos voltar e procurar por Mayta. Ele deve ter voltado ao povoado da tribo no momento..."
                                                }
                                            ]
                                        },
                                        {
                                            "id": "250330208",
                                            "text": "Acredito em vocês."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "250330203",
                            "text": "Não foi perfeito..."
                        }
                    ]
                }
            ]
        },
