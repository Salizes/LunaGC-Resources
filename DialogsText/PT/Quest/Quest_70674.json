    "talks": [
        {
            "id": "7067401",
            "objective": "Fale com Honglang",
            "dialogues": [
                {
                    "id": "706740101",
                    "speaker": "Honglang",
                    "text": "Por que está em Mondstadt dessa vez...?",
                    "choices": [
                        {
                            "id": "706740102",
                            "text": "Honglang?",
                            "response": [
                                {
                                    "id": "706740104",
                                    "speaker": "Honglang",
                                    "text": "Viajante? Que coincidência! Não esperava que você estivesse aqui..."
                                },
                                {
                                    "id": "706740105",
                                    "speaker": "Honglang",
                                    "text": "Quanto à situação atual... Bem, apenas dê uma olhada nesse portal ao meu lado. Imagino que você já entendeu.",
                                    "choices": [
                                        {
                                            "id": "706740106",
                                            "text": "Então um Domínio desse tipo apareceu novamente?",
                                            "response": [
                                                {
                                                    "id": "706740108",
                                                    "speaker": "Honglang",
                                                    "text": "Isso mesmo. Obrigado pela sua ajuda na investigação daquele outro Domínio, conseguimos obter todos os tipos de dados importantes."
                                                },
                                                {
                                                    "id": "706740109",
                                                    "speaker": "Honglang",
                                                    "text": "Porém, não havia como conseguir mais nenhuma informação útil pelo lado de fora daquele Domínio. Não por falta de tentativa da Guilda, mas mesmo assim."
                                                },
                                                {
                                                    "id": "706740110",
                                                    "speaker": "Honglang",
                                                    "text": "Assim, estamos nos preparando para enviar mais pessoas dentro dele. Até mesmo chamamos pessoas de outras Guildas... mas ele sumiu."
                                                },
                                                {
                                                    "id": "706740111",
                                                    "speaker": "Honglang",
                                                    "text": "E foi a última vez que ouvi falar dele até que apareceu hoje em Mondstadt. Apenas consegui chegar a tempo graças ao rápido aviso dos nossos colegas de Mondstadt."
                                                },
                                                {
                                                    "id": "706740112",
                                                    "speaker": "Player",
                                                    "text": "Vocês já começaram a explorá-lo?"
                                                },
                                                {
                                                    "id": "706740113",
                                                    "speaker": "Honglang",
                                                    "text": "Mas é claro. Por que eu recuaria agora com a recompensa bem na minha frente?"
                                                },
                                                {
                                                    "id": "706740114",
                                                    "speaker": "Honglang",
                                                    "text": "As regras deste Domínio não mudaram muito. Ele ainda cria várias coisas baseada na imaginação daqueles que entram nele."
                                                },
                                                {
                                                    "id": "706740115",
                                                    "speaker": "Honglang",
                                                    "text": "Mas conforme nos aventuramos em suas profundezas, descobrimos que esse Domínio agora é capaz de criar alguns \"inimigos\"."
                                                },
                                                {
                                                    "id": "706740116",
                                                    "speaker": "Honglang",
                                                    "text": "Eles nos atacaram e nós realmente sentimos dor quando o fizeram."
                                                },
                                                {
                                                    "id": "706740117",
                                                    "speaker": "Honglang",
                                                    "text": "Como devo dizer isso... Não foi muito diferente de uma batalha real, o que os outros aventureiros acharam bem interessante."
                                                },
                                                {
                                                    "id": "706740118",
                                                    "speaker": "Honglang",
                                                    "text": "Porém, alguns deles invocaram inimigos que eles não conseguiam derrotar, e acabaram precisando de ajuda para derrotá-los..."
                                                },
                                                {
                                                    "id": "706740119",
                                                    "speaker": "Honglang",
                                                    "text": "#*Cof* Mas esqueça isso. Se você estiver dispost{M#o}{F#a}, Viajante, você poderia explorar esse Domínio conosco mais uma vez?",
                                                    "choices": [
                                                        {
                                                            "id": "706740120",
                                                            "text": "Sem problemas.",
                                                            "response": [
                                                                {
                                                                    "id": "706740121",
                                                                    "speaker": "Honglang",
                                                                    "text": "Hahaha, maravilhoso! Com a sua ajuda, tenho certeza de que o progresso será bem suave."
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "706740122",
                                                            "text": "Não vai ser muito perigoso, não é...?",
                                                            "response": [
                                                                {
                                                                    "id": "706740123",
                                                                    "speaker": "Honglang",
                                                                    "text": "Uh, imagino que você ficará bem. Apenas tenha cuidado!"
                                                                },
                                                                {
                                                                    "id": "706740124",
                                                                    "speaker": "Honglang",
                                                                    "text": "#De qualquer forma, se você estiver dispost{M#o}{F#a} a explorar esse Domínio conosco, tenho certeza de que o progresso será bem suave."
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "706740107",
                                            "text": "É o mesmo tipo de Domínio que o outro que você estava investigando?"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "706740103",
                            "text": "Isso é..."
                        }
                    ]
                }
            ]
        }
    ]
}