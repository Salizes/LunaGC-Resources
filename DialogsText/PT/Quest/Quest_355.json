        {
            "id": "35503",
            "objective": "Fale com a Paimon",
            "dialogues": [
                {
                    "id": "3550701",
                    "speaker": "Paimon",
                    "text": "Essa foi por pouco! Quase que fomos lançados para longe!"
                },
                {
                    "id": "3550702",
                    "speaker": "Paimon",
                    "text": "Felizmente, eu consegui segurar você pelos seus cabelos. Obrigada.",
                    "choices": [
                        {
                            "id": "3550703",
                            "text": "Ainda bem que você não arrancou os meu cabelos.",
                            "response": [
                                {
                                    "id": "3550705",
                                    "speaker": "Paimon",
                                    "text": "#O que foi aquilo? Eu pensei que iríamos ser {M#devorados}{F#devoradas}."
                                },
                                {
                                    "id": "3550706",
                                    "speaker": "Paimon",
                                    "text": "Isso com certeza deve estar relacionado com aquele cara estranho que estava conversando com o dragão...",
                                    "choices": [
                                        {
                                            "id": "3550707",
                                            "text": "Eu não acredito que existam dragões neste mundo...",
                                            "response": [
                                                {
                                                    "id": "3550708",
                                                    "speaker": "Paimon",
                                                    "text": "#Sim, a Paimon entende por que você está preocupad{M#o}{F#a}..."
                                                },
                                                {
                                                    "id": "3550711",
                                                    "speaker": "Paimon",
                                                    "text": "Hum? O que é aquilo?"
                                                },
                                                {
                                                    "id": "3550712",
                                                    "speaker": "Paimon",
                                                    "text": "Tem alguma coisa vermelha brilhante em cima daquela pedra grande ali..."
                                                },
                                                {
                                                    "id": "3550713",
                                                    "speaker": "Paimon",
                                                    "text": "Vamos dar uma olhada mais de perto."
                                                }
                                            ]
                                        },
                                        {
                                            "id": "3550709",
                                            "text": "É normal falar com os dragões?",
                                            "response": [
                                                {
                                                    "id": "3550710",
                                                    "speaker": "Paimon",
                                                    "text": "Claro que não é normal..."
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "3550704",
                            "text": "Ainda bem que o dragão não reparou na nossa presença."
                        }
                    ]
                }
            ]
        },
        {
            "id": "35504",
            "objective": "Investigue o que a Paimon encontrou.",
            "dialogues": []
        },
        {
            "id": "35505",
            "objective": "Fale com a Paimon",
            "dialogues": [
                {
                    "id": "3550601",
                    "speaker": "Paimon",
                    "text": "Nunca vi uma pedra como essa antes, então não sei dizer o que é."
                },
                {
                    "id": "3550602",
                    "speaker": "Paimon",
                    "text": "Só sei que é algo perigoso. Vamos deixar isso de lado primeiro."
                },
                {
                    "id": "3550603",
                    "speaker": "Paimon",
                    "text": "Ok, conseguimos, vamos sair daqui!"
                }
            ]
