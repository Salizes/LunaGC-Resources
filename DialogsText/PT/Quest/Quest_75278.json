    "talks": [
        {
            "id": "7527801",
            "objective": "Um Tópico para Outro Dia$HIDDEN",
            "dialogues": [
                {
                    "id": "752780101",
                    "speaker": "???",
                    "text": "E-Esperem, pessoal!"
                },
                {
                    "id": "752780102",
                    "speaker": "Paimon",
                    "text": "Como podemos ajudar você, mocinha?"
                },
                {
                    "id": "752780103",
                    "speaker": "???",
                    "text": "\"Carregue o milagre do florescer da Opúncia, e deixe a Chama Sagrada acender seu sorriso!\""
                },
                {
                    "id": "752780104",
                    "speaker": "Paimon",
                    "text": "Hã? Mas o quê..."
                },
                {
                    "id": "752780105",
                    "speaker": "???",
                    "text": "\"Em nome do Resort da Brisa Tranquila, apresento a vocês uma dança de boas-vindas! Brilhe, Ídolo Pippipan\"!"
                },
                {
                    "id": "752780106",
                    "speaker": "Paimon",
                    "text": "Ugh! Aquela fala de novo?!"
                },
                {
                    "id": "752780107",
                    "speaker": "\"Seaden\"",
                    "text": "#É, sou eu, \"Seaden\"! Hehe, há quanto tempo, Sr{F#ta}. {NICKNAME} e Srta. Paimon!"
                },
                {
                    "id": "752780108",
                    "speaker": "Paimon",
                    "text": "Ah! É só você, \"Seaden\"! Paimon achava que a gente ia encontrar alguém assustador de novo...",
                    "choices": [
                        {
                            "id": "752780109",
                            "text": "Você parece feliz. Boas notícias?",
                            "response": [
                                {
                                    "id": "752780111",
                                    "speaker": "\"Seaden\"",
                                    "text": "Hehe, adivinha só? Meu pai vai me treinar pessoalmente para virar uma artista de verdade!"
                                },
                                {
                                    "id": "752780112",
                                    "speaker": "Paimon",
                                    "text": "Viu? Ele se faz de durão, mas se importa de verdade! Embora fosse melhor se ele não te ensinasse... coisas questionáveis."
                                },
                                {
                                    "id": "752780113",
                                    "speaker": "\"Seaden\"",
                                    "text": "Oh, e isso também é para você!"
                                },
                                {
                                    "id": "752780114",
                                    "speaker": "Paimon",
                                    "text": "Espera, esse não é seu figurino de apresentação? Mas sem ele..."
                                },
                                {
                                    "id": "752780115",
                                    "speaker": "\"Seaden\"",
                                    "text": "Sem problemas! Meu pai fez um novo que veste melhor! Nada de quedas do palco para mim!"
                                },
                                {
                                    "id": "752780116",
                                    "speaker": "\"Seaden\"",
                                    "text": "Considere essa roupa antiga como uma lembrança! Por favor, aceitem, considerem um símbolo da nossa amizade!"
                                },
                                {
                                    "id": "752780117",
                                    "speaker": "\"Seaden\"",
                                    "text": "Na próxima vez que nos encontrarmos, vou usar minha roupa nova e dançar só para vocês. Prometam que vão vir me assistir!"
                                },
                                {
                                    "id": "752780118",
                                    "speaker": "Paimon",
                                    "text": "É! A gente promete!"
                                },
                                {
                                    "id": "752780119",
                                    "speaker": "Som Distante",
                                    "text": "\"Seaden\"! Hora do treino!"
                                },
                                {
                                    "id": "752780120",
                                    "speaker": "\"Seaden\"",
                                    "text": "#Ok, tenho que ir trabalhar esses músculos. Tchau tchau, Sr{F#ta}. {NICKNAME} e Srta. Paimon!"
                                },
                                {
                                    "id": "752780121",
                                    "speaker": "Paimon",
                                    "text": "Tchau-tchau!"
                                },
                                {
                                    "id": "752780122",
                                    "speaker": "Player",
                                    "text": "(Você vai mesmo?)"
                                },
                                {
                                    "id": "752780123",
                                    "speaker": "Paimon",
                                    "text": "É claro! Apesar de que... ver uma apresentação normal de ídolo seria legal também..."
                                }
                            ]
                        },
                        {
                            "id": "752780110",
                            "text": "Como estão as coisas ultimamente?"
                        }
                    ]
                }
            ]
        }
    ]
}