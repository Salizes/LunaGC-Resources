    "talks": [
        {
            "id": "4121401",
            "objective": "Procure por Albedo",
            "dialogues": [
                {
                    "id": "412140101",
                    "speaker": "Paimon",
                    "text": "De novo! Nós, novamente!"
                },
                {
                    "id": "412140102",
                    "speaker": "Albedo",
                    "text": "Viajante, Paimon. Vocês vieram."
                },
                {
                    "id": "412140103",
                    "speaker": "Paimon",
                    "text": "Nós já nos acostumamos a nos encontrar assim com Albedo.",
                    "choices": [
                        {
                            "id": "412140104",
                            "text": "Eu concluí sua missão.",
                            "response": [
                                {
                                    "id": "412140106",
                                    "speaker": "Albedo",
                                    "text": "Muito obrigado. Foi uma escolha certa procurar você."
                                },
                                {
                                    "id": "412140107",
                                    "speaker": "Player",
                                    "text": "Consegui ajudar você?"
                                },
                                {
                                    "id": "412140108",
                                    "speaker": "Albedo",
                                    "text": "É claro. Você me ajudou muito em minha pesquisa."
                                },
                                {
                                    "id": "412140109",
                                    "speaker": "Paimon",
                                    "text": "Hehe, que bom ouvir isso."
                                },
                                {
                                    "id": "412140110",
                                    "speaker": "Albedo",
                                    "text": "Irei me lembrar de sua bondade."
                                },
                                {
                                    "id": "412140111",
                                    "speaker": "Player",
                                    "text": "Essa espada é para você."
                                },
                                {
                                    "id": "412140112",
                                    "speaker": "Paimon",
                                    "text": "Deve ser forte o suficiente, né?"
                                },
                                {
                                    "id": "412140113",
                                    "speaker": "Albedo",
                                    "text": "Sim. Como se sente?"
                                },
                                {
                                    "id": "412140114",
                                    "speaker": "Player",
                                    "text": "Normal."
                                },
                                {
                                    "id": "412140115",
                                    "speaker": "Albedo",
                                    "text": "Então, ainda bem. Não tem efeitos secundários, poluição e veneno."
                                },
                                {
                                    "id": "412140116",
                                    "speaker": "Albedo",
                                    "text": "Parece que... Estava certo."
                                },
                                {
                                    "id": "412140117",
                                    "speaker": "Paimon",
                                    "text": "Você pensa que é um profeta!"
                                },
                                {
                                    "id": "412140118",
                                    "speaker": "Albedo",
                                    "text": "Você gostou da espada?",
                                    "choices": [
                                        {
                                            "id": "412140119",
                                            "text": "É uma arma boa.",
                                            "response": [
                                                {
                                                    "id": "412140121",
                                                    "speaker": "Albedo",
                                                    "text": "Ah, é? Não importa, atingiu o estado que desejada."
                                                },
                                                {
                                                    "id": "412140122",
                                                    "speaker": "Paimon",
                                                    "text": "Pegue na espada... Albedo, você quer usá-la? Não crie problemas!"
                                                },
                                                {
                                                    "id": "412140123",
                                                    "speaker": "Albedo",
                                                    "text": "Eu quero extrair a força de vida pura de dentro."
                                                },
                                                {
                                                    "id": "412140124",
                                                    "speaker": "Paimon",
                                                    "text": "A força existe fora da espada?"
                                                },
                                                {
                                                    "id": "412140125",
                                                    "speaker": "Albedo",
                                                    "text": "Talvez seja impossível para alguns, mas eu sou capaz disso."
                                                },
                                                {
                                                    "id": "412140126",
                                                    "speaker": "Albedo",
                                                    "text": "... Pronto."
                                                },
                                                {
                                                    "id": "412140127",
                                                    "speaker": "Paimon",
                                                    "text": "Uou, essa força parece uma bola de luz..."
                                                },
                                                {
                                                    "id": "412140128",
                                                    "speaker": "Paimon",
                                                    "text": "Ah! Você a colocou em uma garrafa misteriosa!"
                                                },
                                                {
                                                    "id": "412140129",
                                                    "speaker": "Albedo",
                                                    "text": "Essa espada não é uma arma divina..."
                                                },
                                                {
                                                    "id": "412140130",
                                                    "speaker": "Albedo",
                                                    "text": "...É uma recordação. Espero que possa ajudar vocês na viagem.",
                                                    "choices": [
                                                        {
                                                            "id": "412140131",
                                                            "text": "Sério?",
                                                            "response": [
                                                                {
                                                                    "id": "412140133",
                                                                    "speaker": "Albedo",
                                                                    "text": "Eu precisava apenas para meu estudo. Agora já tenho o que preciso e por isso a espada deve ficar com quem sabe usá-la."
                                                                },
                                                                {
                                                                    "id": "412140134",
                                                                    "speaker": "Albedo",
                                                                    "text": "Viajante, obrigado por me ajudar a concluir meu estudo. Adeus."
                                                                },
                                                                {
                                                                    "id": "412140135",
                                                                    "speaker": "Albedo",
                                                                    "text": "A força de vida desse dragão ressoa comigo..."
                                                                },
                                                                {
                                                                    "id": "412140136",
                                                                    "speaker": "Albedo",
                                                                    "text": "Não porque é um dragão, mas sim porque sou eu."
                                                                },
                                                                {
                                                                    "id": "412140137",
                                                                    "speaker": "Albedo",
                                                                    "text": "Rhinedottir... Mestre... Esse é o dragão gigante \"Durin\" que você criou?"
                                                                },
                                                                {
                                                                    "id": "412140138",
                                                                    "speaker": "Albedo",
                                                                    "text": "..."
                                                                },
                                                                {
                                                                    "id": "412140139",
                                                                    "speaker": "Albedo",
                                                                    "text": "O meu encontro com ele é realmente algo bom?"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "412140132",
                                                            "text": "Você não precisa?"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "412140120",
                                            "text": "Não é boa."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "412140105",
                            "text": "Eu cumpri tudo o que prometi para você."
                        }
                    ]
                }
            ]
        },
