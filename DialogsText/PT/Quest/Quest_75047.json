    "talks": [
        {
            "id": "7504702",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "750470201",
                    "speaker": "Ur",
                    "text": "Frutogrãos são deliciosos... Mas se você só comer eles, eles param de ser gostosos depois de uns dias."
                },
                {
                    "id": "750470202",
                    "speaker": "Ur",
                    "text": "É por isso que humanos... comem mato e Frutogrão ao mesmo tempo...?"
                }
            ]
        },
        {
            "id": "7504703",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "750470301",
                    "speaker": "Huluk",
                    "text": "Que sono. Quero dormir... Mas temos que ficar aqui juntos..."
                },
                {
                    "id": "750470302",
                    "speaker": "Huluk",
                    "text": "Por quê... Humanos querem ficar parados aqui o dia todo?"
                }
            ]
        },
        {
            "id": "7504704",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "750470401",
                    "speaker": "Kuki",
                    "text": "Bem, esse é o meu peso sob controle, mas... Hã? O que foi?",
                    "choices": [
                        {
                            "id": "750470402",
                            "text": "Posso perguntar seu nome?",
                            "response": [
                                {
                                    "id": "750470403",
                                    "speaker": "Kuki",
                                    "text": "Ah, certo. Sou um dos sentinelas de serviço aqui, apesar de estar no modo folga agora..."
                                },
                                {
                                    "id": "750470404",
                                    "speaker": "Kuki",
                                    "text": "Então tem algo errado, vá procurar aquele cara do meu lado, Yukam!"
                                }
                            ]
                        },
                        {
                            "id": "750470405",
                            "text": "Tá pensando em quê?",
                            "response": [
                                {
                                    "id": "750470406",
                                    "speaker": "Kuki",
                                    "text": "Bem, sabe, ganhei um pesinho nos últimos tempos, então adicionei um monte de frutas saudáveis à minha dieta normal de Frutogrão."
                                },
                                {
                                    "id": "750470407",
                                    "speaker": "Kuki",
                                    "text": "Mas por algum motivo, meu amigo Ur aprendeu comigo comendo um monte de mato... Não é um desastre, já que Saurianos são onívoros, mas me preocupo se todo aquele mato é bom para a nutrição dele, exatamente."
                                },
                                {
                                    "id": "750470408",
                                    "speaker": "Kuki",
                                    "text": "Acho que preciso ter uma conversa com ele depois."
                                }
                            ]
                        },
                        {
                            "id": "750470409",
                            "text": "Nada, sério.",
                            "response": [
                                {
                                    "id": "750470410",
                                    "speaker": "Kuki",
                                    "text": "#Claro. Boa viagem, então, forasteir{M#o}{F#a}."
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
