    "talks": [
        {
            "id": "7053601",
            "objective": "Retorne para a mesa de jogo do jardim",
            "dialogues": [
                {
                    "id": "705360101",
                    "speaker": "Klee",
                    "text": "Hehe, Dodoco derrotou muitos guerreiros peixes espinhentos do mal! Até o rei peixe espinhento não tava com nada!"
                },
                {
                    "id": "705360102",
                    "speaker": "Klee",
                    "text": "Dodoco, Bomba Saltitante e as Faíscas Explosivas de Klee são os melhores!",
                    "choices": [
                        {
                            "id": "705360103",
                            "text": "Realmente imbatíveis!",
                            "response": [
                                {
                                    "id": "705360105",
                                    "speaker": "Paimon",
                                    "text": "Esse jogo lembra Paimon do incidente acontecendo no Lago de Sidra... Lisa baseou o tema nisso?"
                                },
                                {
                                    "id": "705360106",
                                    "speaker": "Paimon",
                                    "text": "Mas pensando bem, por que todo o trabalho de encontrar as espécies invasoras quando podiam só pedir para Klee explodir todo recife suspeito?"
                                },
                                {
                                    "id": "705360107",
                                    "speaker": "Paimon",
                                    "text": "Eles podiam até nos dar umas bombas e a gente cuidava disso!",
                                    "choices": [
                                        {
                                            "id": "705360108",
                                            "text": "Você e Klee são farinha do mesmo saco.",
                                            "response": [
                                                {
                                                    "id": "705360110",
                                                    "speaker": "Lisa",
                                                    "text": "Ora ora, pelo olhar de vocês parece que estão se divertindo."
                                                },
                                                {
                                                    "id": "705360111",
                                                    "speaker": "Klee",
                                                    "text": "É Lisa!"
                                                },
                                                {
                                                    "id": "705360112",
                                                    "speaker": "Paimon",
                                                    "text": "Você finalmente voltou!"
                                                },
                                                {
                                                    "id": "705360113",
                                                    "speaker": "Paimon",
                                                    "text": "A gente amou jogar Encontro Explosivo de Dodoco! Que jogo legal você fez!"
                                                },
                                                {
                                                    "id": "705360114",
                                                    "speaker": "Lisa",
                                                    "text": "Obrigada por jogar, fico feliz que gostaram. Hmm, talvez eu devesser pensar em umas novas atualizações?"
                                                },
                                                {
                                                    "id": "705360115",
                                                    "speaker": "Klee",
                                                    "text": "Oooh, oba! Klee quer ver Dodoco indo em aventuras em todos os tipos de lugares!"
                                                },
                                                {
                                                    "id": "705360116",
                                                    "speaker": "Klee",
                                                    "text": "Não, espera... Você deve ter passado muuuuuito tempo trabalhando no jogo, deve ser cansativo! A gente não devia fazer Lisa trabalhar demais..."
                                                },
                                                {
                                                    "id": "705360117",
                                                    "speaker": "Lisa",
                                                    "text": "Awn, obrigada por ter tanta consideração."
                                                },
                                                {
                                                    "id": "705360118",
                                                    "speaker": "Lisa",
                                                    "text": "Mas se ajuda a te mander feliz enquanto você fica dentro da idade, ficarei muito contente em passar quanto tempo for necessário."
                                                },
                                                {
                                                    "id": "705360119",
                                                    "speaker": "Lisa",
                                                    "text": "Claro, entendo que você prefere sair em suas próprias aventuras sempre que quiser. O jogo é só para ser um novo jeito de passar o tempo."
                                                },
                                                {
                                                    "id": "705360120",
                                                    "speaker": "Lisa",
                                                    "text": "Enfim, também tenho ótimas notícias, eu também trouxe um presente para vocês, fofuras."
                                                },
                                                {
                                                    "id": "705360121",
                                                    "speaker": "Klee",
                                                    "text": "Um presente!"
                                                },
                                                {
                                                    "id": "705360122",
                                                    "speaker": "Klee",
                                                    "text": "#Tenho um presente para {M#o Sr.}{F#a Srta.} Cavaleir{F#a}{M#o} Honorável e Paimon também!"
                                                },
                                                {
                                                    "id": "705360123",
                                                    "speaker": "Lisa",
                                                    "text": "Chegaremos aos presentes em breve, deixe-me te contar as novidades primeiro.",
                                                    "choices": [
                                                        {
                                                            "id": "705360124",
                                                            "text": "O incidente no Lago de Sidra está resolvido?",
                                                            "response": [
                                                                {
                                                                    "id": "705360126",
                                                                    "speaker": "Lisa",
                                                                    "text": "Isso mesmo. Dois cavaleiros da Equipe de Investigação encontraram o ninho das espécies invasoras e o eliminaram."
                                                                },
                                                                {
                                                                    "id": "705360127",
                                                                    "speaker": "Lisa",
                                                                    "text": "Os cavaleiros também determinaram a causa da invasão."
                                                                },
                                                                {
                                                                    "id": "705360128",
                                                                    "speaker": "Lisa",
                                                                    "text": "As espécies foram introduzidas acidentalmente ao lago por um comerciante sem qualquer intenção maliciosa, então os Cavaleiros o deixaram ir após um esporro e emitir uma multa."
                                                                },
                                                                {
                                                                    "id": "705360129",
                                                                    "speaker": "Paimon",
                                                                    "text": "Ufa... Ainda bem que eles não causaram muitos problemas. Mas até Paimon acha que o comerciante foi descuidado demais!",
                                                                    "choices": [
                                                                        {
                                                                            "id": "705360130",
                                                                            "text": "A água no Lago de Sidra está salva!",
                                                                            "response": [
                                                                                {
                                                                                    "id": "705360132",
                                                                                    "speaker": "Klee",
                                                                                    "text": "Já é hora dos presentes? Klee pode falar primeiro?"
                                                                                },
                                                                                {
                                                                                    "id": "705360133",
                                                                                    "speaker": "Lisa",
                                                                                    "text": "Claro."
                                                                                },
                                                                                {
                                                                                    "id": "705360134",
                                                                                    "speaker": "Lisa",
                                                                                    "text": "Klee voltou para casa na hora certa todos os dias sem ninguém precisar lembrar, fiquei curiosa sobre o que você tem aprontado recentemente..."
                                                                                },
                                                                                {
                                                                                    "id": "705360135",
                                                                                    "speaker": "Klee",
                                                                                    "text": "Hehe~"
                                                                                },
                                                                                {
                                                                                    "id": "705360136",
                                                                                    "speaker": "Klee",
                                                                                    "text": "Quando eu estava em casa à noite, eu dei uma olhada no livro de síntese de Albedo e aprendi a fazer isso!"
                                                                                },
                                                                                {
                                                                                    "id": "705360137",
                                                                                    "speaker": "Klee",
                                                                                    "text": "Ta-dá!"
                                                                                },
                                                                                {
                                                                                    "id": "705360138",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "Eita, Dodoco tá arremessando uma Bomba Saltitante!"
                                                                                },
                                                                                {
                                                                                    "id": "705360139",
                                                                                    "speaker": "Klee",
                                                                                    "text": "Sim! Eu fiz um boneco que parece Dodoco do Encontro Explosivo de Dodoco!"
                                                                                },
                                                                                {
                                                                                    "id": "705360140",
                                                                                    "speaker": "Klee",
                                                                                    "text": "Mesmo que eu não consiga fazer ele atirar bombas de verdade..."
                                                                                },
                                                                                {
                                                                                    "id": "705360141",
                                                                                    "speaker": "Klee",
                                                                                    "text": "#Espero que isso lembre vocês da diversão que tivemos junt{M#os}{F#as} e exploda seus problemas e o tédio!"
                                                                                },
                                                                                {
                                                                                    "id": "705360142",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "Um grande boneco de Dodoco! Paimon ama surpresas como essa!"
                                                                                },
                                                                                {
                                                                                    "id": "705360143",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "Com isso, será como se a gente estivesse se aventurando com Klee e Dodoco onde a gente for!",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "705360144",
                                                                                            "text": "#Obrigad{M#o}{F#a} pelo presente criativo e considerado, Klee!",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "705360146",
                                                                                                    "speaker": "Klee",
                                                                                                    "text": "Hehe, fico muito feliz que vocês gostaram do meu presente! Eu dei muito duro nele!"
                                                                                                },
                                                                                                {
                                                                                                    "id": "705360147",
                                                                                                    "speaker": "Klee",
                                                                                                    "text": "Qual é o seu presente, Lisa? Quero ver!"
                                                                                                },
                                                                                                {
                                                                                                    "id": "705360148",
                                                                                                    "speaker": "Lisa",
                                                                                                    "text": "Bem, receio que meu presente é muito menos criativo que o seu."
                                                                                                },
                                                                                                {
                                                                                                    "id": "705360149",
                                                                                                    "speaker": "Lisa",
                                                                                                    "text": "É um livro de histórias sobre o Encontro Explosivo de Dodoco—"
                                                                                                },
                                                                                                {
                                                                                                    "id": "705360150",
                                                                                                    "speaker": "Klee",
                                                                                                    "text": "Uma história de aventura!"
                                                                                                },
                                                                                                {
                                                                                                    "id": "705360151",
                                                                                                    "speaker": "Paimon",
                                                                                                    "text": "Uau, um livro inteiro!"
                                                                                                },
                                                                                                {
                                                                                                    "id": "705360152",
                                                                                                    "speaker": "Lisa",
                                                                                                    "text": "As fofurinhas voltaram para Mondstadt e foram com Klee em uma aventura com Dodoco!"
                                                                                                },
                                                                                                {
                                                                                                    "id": "705360153",
                                                                                                    "speaker": "Lisa",
                                                                                                    "text": "Juntos eles derrotaram os guerreiros peixes espinhentos malvados e aproveitaram um chá da tarde..."
                                                                                                },
                                                                                                {
                                                                                                    "id": "705360154",
                                                                                                    "speaker": "Lisa",
                                                                                                    "text": "Uma ótima maneira de terminar o Encontro Explosivo de Dodoco."
                                                                                                },
                                                                                                {
                                                                                                    "id": "705360155",
                                                                                                    "speaker": "Paimon",
                                                                                                    "text": "Eita, você planejou a história toda enquanto fazia o jogo?"
                                                                                                },
                                                                                                {
                                                                                                    "id": "705360156",
                                                                                                    "speaker": "Lisa",
                                                                                                    "text": "Não. Como os protagonistas da história, você, fofura e Klee fizeram um papel importante em trazer a história à vida."
                                                                                                },
                                                                                                {
                                                                                                    "id": "705360157",
                                                                                                    "speaker": "Lisa",
                                                                                                    "text": "Eu deixei um lugar vazio no livro especificamente para ilustrações..."
                                                                                                },
                                                                                                {
                                                                                                    "id": "705360158",
                                                                                                    "speaker": "Lisa",
                                                                                                    "text": "#Mas eu acabei de pensar em uma ideia ainda melhor — já que estamos todos aqui nessa ocasião especial, por que não tiro uma foto de vocês junt{M#os}{F#as}?"
                                                                                                },
                                                                                                {
                                                                                                    "id": "705360159",
                                                                                                    "speaker": "Paimon",
                                                                                                    "text": "#Claro! A gente encontrou nossas amigas e brincamos junt{M#os}{F#as}, vale muito a pena comemorar!",
                                                                                                    "choices": [
                                                                                                        {
                                                                                                            "id": "705360160",
                                                                                                            "text": "Vamos tirar uma foto em grupo!",
                                                                                                            "response": [
                                                                                                                {
                                                                                                                    "id": "705360162",
                                                                                                                    "speaker": "Klee",
                                                                                                                    "text": "#Vamos lá, Sr{F#ta}. Cavaleir{F#a}{M#o} Honorável e Paimon! Pronta, Lisa?"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "705360163",
                                                                                                                    "speaker": "Klee",
                                                                                                                    "text": "Klee se divertiu tanto hoje! Três, dois, um... Dodoco!"
                                                                                                                }
                                                                                                            ]
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "705360161",
                                                                                                            "text": "Você tem que curtir as pequenas alegrias da vida!"
                                                                                                        }
                                                                                                    ]
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "705360145",
                                                                                            "text": "Dodoco virá com a gente em todas as nossas aventuras a partir de agora!"
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "705360131",
                                                                            "text": "A indústria de vinho de Mondstadt está salva!"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "705360125",
                                                            "text": "Klee pode brincar do lado de fora de novo?"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "705360109",
                                            "text": "Não, sem bombas para Paimon."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "705360104",
                            "text": "Tome essa, peixe do mal!"
                        }
                    ]
                }
            ]
        }
    ]
}