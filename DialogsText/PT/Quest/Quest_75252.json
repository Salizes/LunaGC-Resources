        {
            "id": "7525204",
            "objective": "Ajude Icahua a montar os alvos de tiro",
            "dialogues": [
                {
                    "id": "752520401",
                    "speaker": "Player",
                    "text": "Claro. Adeus."
                },
                {
                    "id": "752520402",
                    "speaker": "Icahua",
                    "text": "Adeus."
                }
            ]
        },
        {
            "id": "7525206",
            "objective": "",
            "dialogues": [
                {
                    "id": "752520601",
                    "speaker": "Player",
                    "text": "Você era cliente no bar. Já nos conhecemos."
                },
                {
                    "id": "752520602",
                    "speaker": "Tecuhtli",
                    "text": "Já? Acho que é por isso que você parecia familiar. Conheci muitas pessoas hoje, então não me lembro muito dos rostos... mas isso não importa agora."
                }
            ]
        },
        {
            "id": "7525205",
            "objective": "Volte para procurar Icahua",
            "dialogues": [
                {
                    "id": "752520701",
                    "speaker": "Tecuhtli",
                    "text": "Mais importante é se você viu um careca por aqui? Preciso falar com ele.",
                    "choices": [
                        {
                            "id": "752520702",
                            "text": "Essa é a pessoa que estou procurando também.",
                            "response": [
                                {
                                    "id": "752520704",
                                    "speaker": "Tecuhtli",
                                    "text": "Ah, ele estava aqui agora há pouco? Acho que deve ter me visto chegando..."
                                },
                                {
                                    "id": "752520709",
                                    "speaker": "Tecuhtli",
                                    "text": "Tsc. Você vai me pagar por isso, Icahua..."
                                },
                                {
                                    "id": "752520706",
                                    "speaker": "Tecuhtli",
                                    "text": "Como já nos encontramos antes e você parece uma boa pessoa, vou te avisar: mantenha distância daquele patife desprovido de cabelo — caso contrário, esse seu rostinho bonito pode acabar coberto de tinta vermelha e branca."
                                },
                                {
                                    "id": "752520707",
                                    "speaker": "Tecuhtli",
                                    "text": "Essas são as coisas que encontrei no acampamento dele. Acho que não teve tempo de levá-las."
                                },
                                {
                                    "id": "752520708",
                                    "speaker": "Tecuhtli",
                                    "text": "É seu. Não se preocupe, ele não tem direito de dizer o contrário."
                                },
                                {
                                    "id": "752520710",
                                    "speaker": "Tecuhtli",
                                    "text": "Mais cedo ou mais tarde, a vida dele será minha."
                                }
                            ]
                        },
                        {
                            "id": "752520703",
                            "text": "Não vimos ele, desculpa.",
                            "response": [
                                {
                                    "id": "752520705",
                                    "speaker": "Tecuhtli",
                                    "text": "Está me dizendo a verdade? Por enquanto, estou inclinada a confiar nesse seu rostinho honesto."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7525201",
