    "talks": [
        {
            "id": "7565501",
            "objective": "",
            "dialogues": [
                {
                    "id": "756550201",
                    "speaker": "Collei",
                    "text": "#Hã? Ah, é você, {NICKNAME}! Qual é o plano de hoje?",
                    "choices": [
                        {
                            "id": "756550202",
                            "text": "Estamos aqui para tirar umas fotos da Cidade de Sumeru.",
                            "response": [
                                {
                                    "id": "756550204",
                                    "speaker": "Collei",
                                    "text": "Ah, fotografia! Verdade, pesquisadores da Academia geralmente vêm aqui para tirar fotos da cidade."
                                },
                                {
                                    "id": "756550205",
                                    "speaker": "Collei",
                                    "text": "A maioria do Vahumana ou Kshahrewar, aparentemente para estudar infraestrutura urbana... e, hmm, história da arquitetura.",
                                    "choices": [
                                        {
                                            "id": "756550206",
                                            "text": "Ora ora, você conhece mesmo os Darshans, hein?",
                                            "response": [
                                                {
                                                    "id": "756550207",
                                                    "speaker": "Collei",
                                                    "text": "Na verdade... não. Eu só sei os campos de pesquisa deles e como preparam os cursos. Ainda estou muito longe de ser uma pesquisadora."
                                                },
                                                {
                                                    "id": "756550210",
                                                    "speaker": "Collei",
                                                    "text": "Mas se você quisesse que eu tentasse a prova de seleção... Hehe, duvido que passaria sequer da primeira prova escrita."
                                                },
                                                {
                                                    "id": "756550211",
                                                    "speaker": "Collei",
                                                    "text": "Queria poder alcançar o nível de um pesquisador, claro, mas ainda é um sonho no momento...",
                                                    "choices": [
                                                        {
                                                            "id": "756550212",
                                                            "text": "Você vai conseguir no futuro.",
                                                            "response": [
                                                                {
                                                                    "id": "756550214",
                                                                    "speaker": "Collei",
                                                                    "text": "#Muito obrigada, {NICKNAME}. Enfim, vou dar o meu melhor para aprender o básico primeiro!"
                                                                },
                                                                {
                                                                    "id": "756550215",
                                                                    "speaker": "Collei",
                                                                    "text": "Honestamente, fico só feliz por aprender uma coisa nova todo dia."
                                                                },
                                                                {
                                                                    "id": "756550216",
                                                                    "speaker": "Collei",
                                                                    "text": "E nesse momento, meu objetivo é ser a melhor Guarda-Florestal que puder."
                                                                },
                                                                {
                                                                    "id": "756550217",
                                                                    "speaker": "Collei",
                                                                    "text": "Guiar quem está perdido na Floresta Tropical, ajudar as pessoas que ingeriram veneno acidentalmente, proteger a flora e fauna dela..."
                                                                },
                                                                {
                                                                    "id": "756550218",
                                                                    "speaker": "Collei",
                                                                    "text": "Nós, Guardas-Florestais, fazemos muitas coisas. Todos precisam de mim, e estou mais que disposta a ajudar!"
                                                                },
                                                                {
                                                                    "id": "756550219",
                                                                    "speaker": "Collei",
                                                                    "text": "Só fiz umas coisas aqui e ali, mesmo assim, todos reconhecem meu trabalho."
                                                                },
                                                                {
                                                                    "id": "756550220",
                                                                    "speaker": "Collei",
                                                                    "text": "Acho que tenho sorte de ter todas essas pessoas que se importam comigo... e ter virado amiga de alguém tão incrível quanto você.",
                                                                    "choices": [
                                                                        {
                                                                            "id": "756550221",
                                                                            "text": "#Fico feliz que a gente é amig{M#o}{F#a}, Collei.",
                                                                            "response": [
                                                                                {
                                                                                    "id": "756550223",
                                                                                    "speaker": "Collei",
                                                                                    "text": "Haha, tudo bem. Enfim, se eu puder ajudar com alguma coisa, só falar."
                                                                                },
                                                                                {
                                                                                    "id": "756550224",
                                                                                    "speaker": "Player",
                                                                                    "text": "Queria que você me ajudasse com algumas fotos."
                                                                                },
                                                                                {
                                                                                    "id": "756550225",
                                                                                    "speaker": "Collei",
                                                                                    "text": "Claro. Que tipo de pose eu deveria fazer?",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "756550226",
                                                                                            "text": "Uma pose elegante.",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "756550228",
                                                                                                    "speaker": "Collei",
                                                                                                    "text": "Certo. Assim serve?",
                                                                                                    "choices": [
                                                                                                        {
                                                                                                            "id": "756550229",
                                                                                                            "text": "Perfeito. Diga xiiiis!",
                                                                                                            "response": [
                                                                                                                {
                                                                                                                    "id": "756550230",
                                                                                                                    "speaker": "Collei",
                                                                                                                    "text": "Tudo pronto."
                                                                                                                }
                                                                                                            ]
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "756550231",
                                                                                                            "text": "A pose divertida deve servir melhor."
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "756550232",
                                                                                                            "text": "Vamos usar a nossa pose relaxada ao invés disso.",
                                                                                                            "response": [
                                                                                                                {
                                                                                                                    "id": "756550233",
                                                                                                                    "speaker": "Collei",
                                                                                                                    "text": "Tudo bem!"
                                                                                                                }
                                                                                                            ]
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "756550234",
                                                                                                            "text": "Aliás, vamos com a pose elegante.",
                                                                                                            "response": [
                                                                                                                {
                                                                                                                    "id": "756550235",
                                                                                                                    "speaker": "Collei",
                                                                                                                    "text": "Tudo bem!"
                                                                                                                }
                                                                                                            ]
                                                                                                        }
                                                                                                    ]
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "756550227",
                                                                                            "text": "Vamos tentar uma pose divertida!"
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "756550222",
                                                                            "text": "#Nós {M#dois}{F#duas} somos incríveis. Não esqueça disso!"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "756550213",
                                                            "text": "Você consegue, Collei!"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "756550208",
                                            "text": "Teve algumas aulas nesses Darshans, por acaso?",
                                            "response": [
                                                {
                                                    "id": "756550209",
                                                    "speaker": "Collei",
                                                    "text": "Bem, ainda não sou uma estudante, então não posso frequentar aulas, mas já vi o Mestre apresentar as pesquisas deles."
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "756550203",
