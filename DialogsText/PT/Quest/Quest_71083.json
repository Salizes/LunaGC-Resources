    "talks": [
        {
            "id": "7108301",
            "objective": "",
            "dialogues": [
                {
                    "id": "710830101",
                    "speaker": "Muning",
                    "text": "Não imaginei que vocês realmente quebrariam o Selo dos Qixing. Parece que terei que escrever isso no meu relatório semanal."
                },
                {
                    "id": "710830102",
                    "speaker": "Player",
                    "text": "Faça com que soe incrível."
                },
                {
                    "id": "710830103",
                    "speaker": "Muning",
                    "text": "#*Cof*... Sejam mais séri{F#as}{M#os}, essa é uma situação grave. É tão grave que os Qixing decidiram sobre sua gravidade."
                },
                {
                    "id": "710830104",
                    "speaker": "Muning",
                    "text": "O que quer dizer que quando o relatório for enviado, talvez alguém dos Qixing velho aqui pessoalmente lhe impedir."
                },
                {
                    "id": "710830105",
                    "speaker": "Muning",
                    "text": "E nessa hora, nem mesmo eu poderei lhe salvar."
                },
                {
                    "id": "710830106",
                    "speaker": "Player",
                    "text": "(Suas advertências são óbvias demais...)"
                },
                {
                    "id": "710830107",
                    "speaker": "Muning",
                    "text": "#Está assustad{F#a}{M#o}, não é? Está bem, ainda tem alguém lhe esperando, vá logo!"
                }
            ]
        },
        {
            "id": "7108302",
            "objective": "",
            "dialogues": [
                {
                    "id": "710830201",
                    "speaker": "Muning",
                    "text": "Como está a situação lá embaixo? Algum perigo?",
                    "choices": [
                        {
                            "id": "710830202",
                            "text": "(Você descreve a situação para Muning).",
                            "response": [
                                {
                                    "id": "710830203",
                                    "speaker": "Muning",
                                    "text": "Ah, sim. Parece ser perigoso. Acho que terei de pedir a você para proteger Jinwu e Zhiqiong, nesta situação."
                                },
                                {
                                    "id": "710830204",
                                    "speaker": "Player",
                                    "text": "Você não deveria me parar?"
                                },
                                {
                                    "id": "710830205",
                                    "speaker": "Muning",
                                    "text": "É claro que essa é minha responsabilidade. Mas você corre tão rápido que eu simplesmente não consigo parar você."
                                },
                                {
                                    "id": "710830206",
                                    "speaker": "Player",
                                    "text": "Eu não corro rápido."
                                },
                                {
                                    "id": "710830207",
                                    "speaker": "Muning",
                                    "text": "Não, eu corro rápido mesmo. Foi isso que escreveram no relatório, e é um fato."
                                },
                                {
                                    "id": "710830208",
                                    "speaker": "Player",
                                    "text": "Sim, muito rápido mesmo."
                                },
                                {
                                    "id": "710830209",
                                    "speaker": "Muning",
                                    "text": "Sim, por isso, tenha cuidado."
                                }
                            ]
                        },
                        {
                            "id": "710830210",
                            "text": "Correu tudo bem.",
                            "response": [
                                {
                                    "id": "710830211",
                                    "speaker": "Muning",
                                    "text": "Ainda bem, ainda bem. Se tudo correr bem, os \"Qixing\" não terão razões para nos culpar assim..."
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
