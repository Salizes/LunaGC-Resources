    "talks": [
        {
            "id": "7166501",
            "objective": "Procure pelo cliente",
            "dialogues": [
                {
                    "id": "716650101",
                    "speaker": "Ranjit",
                    "text": "#Ah, você finalmente chegou. Você é {F#a}{M#o} protagonista, correto?",
                    "choices": [
                        {
                            "id": "716650102",
                            "text": "#Sim, sou eu mesm{F#a a}{M#o o} protagonista.",
                            "response": [
                                {
                                    "id": "716650103",
                                    "speaker": "Paimon",
                                    "text": "Paimon não tem certeza o que você quis perguntar com isso..."
                                },
                                {
                                    "id": "716650105",
                                    "speaker": "Ranjit",
                                    "text": "Ah, vejam só! Estou ansioso demais. Eles disseram para eu ser breve ao publicar a comissão."
                                },
                                {
                                    "id": "716650106",
                                    "speaker": "Ranjit",
                                    "text": "Pra resumir, eu sou Ranjit, chef de culinária criativa. Quero me dar bem com um Regisvine Pyro, mas ele não gosta da minha companhia..."
                                },
                                {
                                    "id": "716650107",
                                    "speaker": "Ranjit",
                                    "text": "Cospe bolas de fogo, e ataca o chão... não posso fazer nada sobre isso e estou contratando algum aventureiro com toque de protagonista para me ajudar.",
                                    "choices": [
                                        {
                                            "id": "716650108",
                                            "text": "Tá na mão, chefia.",
                                            "response": [
                                                {
                                                    "id": "716650109",
                                                    "speaker": "Paimon",
                                                    "text": "Ei, você vai concordar com uma comissão ridícula como essa?!"
                                                },
                                                {
                                                    "id": "716650111",
                                                    "speaker": "Paimon",
                                                    "text": "Você só pode estar brincando com a Paimon! Um chef de culinária criativa, fazendo amizade com um Regisvine Pyro? Isso não faz sentido nenhum!"
                                                },
                                                {
                                                    "id": "716650112",
                                                    "speaker": "Ranjit",
                                                    "text": "Sério? Bem, é uma planta mal-humorada, mas você só aprende tentando, né?"
                                                },
                                                {
                                                    "id": "716650113",
                                                    "speaker": "Ranjit",
                                                    "text": "E depois do Regisvine, também quero tentar com o Dragarto Primordial Geo, Terrorgumelo Emplumado e Cavalo-Marinho Perolado Milenar!"
                                                },
                                                {
                                                    "id": "716650114",
                                                    "speaker": "Paimon",
                                                    "text": "... Isso tá cada vez mais esquisito! De onde você tá tirando isso?"
                                                },
                                                {
                                                    "id": "716650115",
                                                    "speaker": "Ranjit",
                                                    "text": "Na verdade, foi por causa de minha viagem para Natlan pouco tempo atrás..."
                                                },
                                                {
                                                    "id": "716650116",
                                                    "speaker": "Ranjit",
                                                    "text": "É um lugar fantástico. Se eu tivesse como descrever, seria como a primeira vez que comi curry tão apimentado que fez chover suor."
                                                },
                                                {
                                                    "id": "716650117",
                                                    "speaker": "Ranjit",
                                                    "text": "Minha língua já não aguentava tanto estímulo degustativo, mas eu não conseguia me segurar, era uma colherada atrás da outra!"
                                                },
                                                {
                                                    "id": "716650118",
                                                    "speaker": "Ranjit",
                                                    "text": "... Falando nisso, conheci um monte de gente em Natlan. Todo mundo bem legal. Me ensinaram a escalar, e outros me levaram para as termas."
                                                },
                                                {
                                                    "id": "716650119",
                                                    "speaker": "Ranjit",
                                                    "text": "Aposto que você não sabia disso, mas as pessoas de Natlan se vestem imitando os Saurianos. E quando trajando panóplias, ficam bem corajosos!"
                                                },
                                                {
                                                    "id": "716650120",
                                                    "speaker": "Ranjit",
                                                    "text": "Eu fiz um chapéu inspirado nos meus amigos de Natlan. Irado, né?"
                                                },
                                                {
                                                    "id": "716650121",
                                                    "speaker": "Paimon",
                                                    "text": "É bem distinto, mas Paimon não consegue entender o que você tá querendo dizer com isso."
                                                },
                                                {
                                                    "id": "716650122",
                                                    "speaker": "Ranjit",
                                                    "text": "Verdade, verdade! Eu não tenho um companheiro Sauriano, né?"
                                                },
                                                {
                                                    "id": "716650123",
                                                    "speaker": "Ranjit",
                                                    "text": "*Suspiro* Seria bom se sim. Mas não sou do local, e para ser franco, eu não consigo ficar lá por muito tempo."
                                                },
                                                {
                                                    "id": "716650124",
                                                    "speaker": "Ranjit",
                                                    "text": "Por isso que pensei em arranjar um companheiro fora de Natlan que pudesse tomar o lugar de um Sauriano. Mesmo que isso não funcione, seria uma ótima história para contar!"
                                                },
                                                {
                                                    "id": "716650125",
                                                    "speaker": "Paimon",
                                                    "text": "Hã, você podia ter escolhido alvos melhores para desafiar, não?"
                                                },
                                                {
                                                    "id": "716650126",
                                                    "speaker": "Ranjit",
                                                    "text": "Hã? Vocês não acham esses bons? Eles são como os Saurianos de Natlan, e também são fortes!"
                                                },
                                                {
                                                    "id": "716650127",
                                                    "speaker": "Ranjit",
                                                    "text": "Ter um Animal de Carga como companheiro não é coisa pra se gabar. Preciso de um desafio maior se quero contar alguma história!"
                                                },
                                                {
                                                    "id": "716650128",
                                                    "speaker": "Ranjit",
                                                    "text": "A pena é que não posso ser eu mesmo o protagonista... Acalmar essas bestas não é fácil."
                                                },
                                                {
                                                    "id": "716650129",
                                                    "speaker": "Ranjit",
                                                    "text": "Mas acho que essa é a sua especialidade, correto? Claro, vou dar apoio. Redes, comida, o que quiser, pode deixar comigo!"
                                                },
                                                {
                                                    "id": "716650130",
                                                    "speaker": "Ranjit",
                                                    "text": "#Mas quanto as nossas negociações com companheiros possíveis... Os holofotes vão estar em você, {F#minha cara}{M#meu caro} protagonista!"
                                                },
                                                {
                                                    "id": "716650131",
                                                    "speaker": "Paimon",
                                                    "text": "#Por que você tá jogando essas coisas perigosas {F#na sua}{M#no seu} protagonista?",
                                                    "choices": [
                                                        {
                                                            "id": "716650132",
                                                            "text": "Espero que valha a pena...",
                                                            "response": [
                                                                {
                                                                    "id": "716650133",
                                                                    "speaker": "Ranjit",
                                                                    "text": "Claro, claro."
                                                                },
                                                                {
                                                                    "id": "716650136",
                                                                    "speaker": "Ranjit",
                                                                    "text": "Bem, já que concordamos, podemos ir agora? Minhas panelas estão prontas, e meu equipamento checado. Devemos estar prontos para ir!",
                                                                    "choices": [
                                                                        {
                                                                            "id": "716650137",
                                                                            "text": "Vamos lá."
                                                                        },
                                                                        {
                                                                            "id": "716650138",
                                                                            "text": "Tenho outras coisas para resolver. Te vejo em breve.",
                                                                            "response": [
                                                                                {
                                                                                    "id": "716650139",
                                                                                    "speaker": "Ranjit",
                                                                                    "text": "Sem problemas. Vou esperar por você aqui."
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "716650134",
                                                            "text": "Tenho certeza que podemos chegar a um acordo, se você me convencer.",
                                                            "response": [
                                                                {
                                                                    "id": "716650135",
                                                                    "speaker": "Ranjit",
                                                                    "text": "Claro, é assim que funciona."
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "716650110",
                                            "text": "Você é conciso, mas não entendi nem pé, nem cabeça."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "716650104",
                            "text": "Não tô entendendo bulhufas do que você tá falando"
                        }
                    ]
                }
            ]
        }
    ]
}