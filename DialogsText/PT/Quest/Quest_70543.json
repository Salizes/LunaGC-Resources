            "dialogues": [
                {
                    "id": "705430101",
                    "speaker": "Razor",
                    "text": "..."
                },
                {
                    "id": "705430102",
                    "speaker": "Poeirinha",
                    "text": "...Miau."
                },
                {
                    "id": "705430103",
                    "speaker": "Razor",
                    "text": "...É você. Eu, estou falando."
                },
                {
                    "id": "705430104",
                    "speaker": "Paimon",
                    "text": "Falando... Razor, você está falando com Poeirinha?"
                },
                {
                    "id": "705430105",
                    "speaker": "Poeirinha",
                    "text": "Miau, miau-miau."
                },
                {
                    "id": "705430106",
                    "speaker": "Paimon",
                    "text": "Parece que Poeirinha está tentando dizer... \"Isso mesmo\"?"
                },
                {
                    "id": "705430107",
                    "speaker": "Razor",
                    "text": "Um cheiro familiar, procurando amigos."
                },
                {
                    "id": "705430108",
                    "speaker": "Razor",
                    "text": "Está bem. Feliz."
                },
                {
                    "id": "705430109",
                    "speaker": "Poeirinha",
                    "text": "Miau, miau."
                },
                {
                    "id": "705430110",
                    "speaker": "Razor",
                    "text": "Amigos seguiram o cheiro. Você veio também, feliz. Em seu corpo, o cheiro do vento e da chuva, muito familiar... Cheiro de gatos, também familiar."
                },
                {
                    "id": "705430111",
                    "speaker": "Razor",
                    "text": "Paimon, cheiro muito doce. Cheiro bom."
                },
                {
                    "id": "705430112",
                    "speaker": "Paimon",
                    "text": "Hã!? Doce... Será que é o gosto das panquecas que Valerina deu para a gente? P-Paimon comeu tantas assim?",
                    "choices": [
                        {
                            "id": "705430113",
                            "text": "Eu te dei metade das minhas, esqueceu?",
                            "response": [
                                {
                                    "id": "705430115",
                                    "speaker": "Paimon",
                                    "text": "Sério? Paimon nem percebeu... Hmm, é tudo culpa da panqueca por ser tão gostosa!"
                                },
                                {
                                    "id": "705430116",
                                    "speaker": "Paimon",
                                    "text": "Hehe, e Paimon ainda quer comer Frango Assado com Mel, Carne e Bolinho de Batata... oh e Sidra de Maçã!"
                                },
                                {
                                    "id": "705430117",
                                    "speaker": "Paimon",
                                    "text": "#Certo, esse é o cardápio para o próximo jantar! Vamos lá, {NICKNAME}, vamos fazer nosso pedido com a Valerina! Você vem também, Razor!"
                                },
                                {
                                    "id": "705430118",
                                    "speaker": "Razor",
                                    "text": "Obri... Obrigado..."
                                },
                                {
                                    "id": "705430119",
                                    "speaker": "Razor",
                                    "text": "Poeirinha me trouxe várias... castanhas..."
                                },
                                {
                                    "id": "705430120",
                                    "speaker": "Razor",
                                    "text": "E, caixas de carne... estou bem cheio."
                                },
                                {
                                    "id": "705430121",
                                    "speaker": "Paimon",
                                    "text": "Parece que Valerina pediu entrega? Poeirinha entregou a comida para o Razor?"
                                },
                                {
                                    "id": "705430122",
                                    "speaker": "Poeirinha",
                                    "text": "Miau-miau. Miau!"
                                },
                                {
                                    "id": "705430123",
                                    "speaker": "Paimon",
                                    "text": "Paimon jamais imaginou que os gatos cuidariam dos clientes aqui na Fortaleza Felina Fofinha!"
                                },
                                {
                                    "id": "705430124",
                                    "speaker": "Paimon",
                                    "text": "Parece que o Razor realmente é o miau do gato!"
                                }
                            ]
                        },
                        {
                            "id": "705430114",
                            "text": "Sem problemas, você ainda pode comer o triplo do que comeu antes."
                        }
                    ]
                }
            ]
        }
    ]
}