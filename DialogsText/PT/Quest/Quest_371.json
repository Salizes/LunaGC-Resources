            "objective": "Saia do Quartel-General dos Cavaleiros de Favonius",
            "dialogues": [
                {
                    "id": "3710101",
                    "speaker": "Paimon",
                    "text": "Tem uma coisa que você ainda não contou a eles."
                },
                {
                    "id": "3710102",
                    "speaker": "Paimon",
                    "text": "O dragão e o cristal não foram as únicas coisas que nós vimos.",
                    "choices": [
                        {
                            "id": "3710103",
                            "text": "Eu gostaria de investigar por minha conta primeiro.",
                            "response": [
                                {
                                    "id": "3710105",
                                    "speaker": "Paimon",
                                    "text": "Então, você se lembra dele, daquele cara de verde."
                                },
                                {
                                    "id": "3710106",
                                    "speaker": "Paimon",
                                    "text": "Ele se vestia igual àquele cara ali embaixo!",
                                    "choices": [
                                        {
                                            "id": "3710107",
                                            "text": "Que curioso! É a mesma cor!",
                                            "response": [
                                                {
                                                    "id": "3710108",
                                                    "speaker": "Paimon",
                                                    "text": "Não é?"
                                                },
                                                {
                                                    "id": "3710109",
                                                    "speaker": "Paimon",
                                                    "text": "Espere um minuto... Parece que..."
                                                },
                                                {
                                                    "id": "3710110",
                                                    "speaker": "Paimon",
                                                    "text": "É a mesma pessoa?!"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "3710111",
                                            "text": "Bem... Parece que é ele mesmo...",
                                            "response": [
                                                {
                                                    "id": "3710112",
                                                    "speaker": "Paimon",
                                                    "text": "O quê!?"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "3710104",
                            "text": "Eu acho que ele não é uma pessoa ruim."
                        }
                    ]
                }
            ]
        },
