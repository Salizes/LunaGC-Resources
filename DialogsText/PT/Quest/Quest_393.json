    "talks": [
        {
            "id": "39301",
            "objective": "Ative o selo da entrada",
            "dialogues": [
                {
                    "id": "3930101",
                    "speaker": "Venti",
                    "text": "Estou pensando em escrever essas aventuras em canções depois que terminarmos...",
                    "choices": [
                        {
                            "id": "3930102",
                            "text": "Bem... Nós certamente já passamos por muitas ultimamente...",
                            "response": [
                                {
                                    "id": "3930104",
                                    "speaker": "Venti",
                                    "text": "Felizmente, essa música será cantada nos próximos anos pelo povo de Mondstadt, assim como a Lenda de Vennessa."
                                },
                                {
                                    "id": "3930105",
                                    "speaker": "Jean",
                                    "text": "Sempre gostei desta canção desde quando era pequena."
                                },
                                {
                                    "id": "3930106",
                                    "speaker": "Jean",
                                    "text": "#{NICKNAME}... Como você está se sentindo hoje?"
                                },
                                {
                                    "id": "3930107",
                                    "speaker": "Jean",
                                    "text": "Estou preparada e muito confiante de que vamos conseguir.",
                                    "choices": [
                                        {
                                            "id": "3930108",
                                            "text": "A Mestre Jean é tão confiável.",
                                            "response": [
                                                {
                                                    "id": "3930110",
                                                    "speaker": "Paimon",
                                                    "text": "Até mesmo o Mestre Diluc nos acompanhou até o fim."
                                                },
                                                {
                                                    "id": "3930111",
                                                    "speaker": "Paimon",
                                                    "text": "Apesar de apenas estar envolvido acidentalmente..."
                                                },
                                                {
                                                    "id": "3930112",
                                                    "speaker": "Paimon",
                                                    "text": "Por acidente?"
                                                },
                                                {
                                                    "id": "3930113",
                                                    "speaker": "Diluc",
                                                    "text": "Você compartilhou seus segredos comigo e eu retribuirei com a minha confiança.",
                                                    "choices": [
                                                        {
                                                            "id": "3930114",
                                                            "text": "Então, foi a \"confiança\" que trouxe Diluc até aqui.",
                                                            "response": [
                                                                {
                                                                    "id": "3930115",
                                                                    "speaker": "Paimon",
                                                                    "text": "E a para a Mestre Jean foi \"responsabilidade\"?"
                                                                },
                                                                {
                                                                    "id": "3930116",
                                                                    "speaker": "Paimon",
                                                                    "text": "E quanto ao Bardo Desafinado?"
                                                                },
                                                                {
                                                                    "id": "3930121",
                                                                    "speaker": "Venti",
                                                                    "text": "É a \"liberdade\"."
                                                                },
                                                                {
                                                                    "id": "3930122",
                                                                    "speaker": "Paimon",
                                                                    "text": "Liberdade...?"
                                                                },
                                                                {
                                                                    "id": "3930123",
                                                                    "speaker": "Venti",
                                                                    "text": "Quando você chegou a Mondstadt, ninguém lhe disse que Mondstadt é a Cidade da Liberdade?"
                                                                },
                                                                {
                                                                    "id": "3930124",
                                                                    "speaker": "Player",
                                                                    "text": "Amber..."
                                                                },
                                                                {
                                                                    "id": "3930125",
                                                                    "speaker": "Venti",
                                                                    "text": "Hahaha... Ela realmente é uma filha da liberdade!"
                                                                },
                                                                {
                                                                    "id": "3930126",
                                                                    "speaker": "Venti",
                                                                    "text": "Mondstadt é uma cidade romântica sem o reino de um rei."
                                                                },
                                                                {
                                                                    "id": "3930127",
                                                                    "speaker": "Venti",
                                                                    "text": "Seus cidadãos usufruem a liberdade entre os sete países."
                                                                },
                                                                {
                                                                    "id": "3930128",
                                                                    "speaker": "Venti",
                                                                    "text": "Espero que o dragão que protegeu Mondstadt também esteja livre em breve..."
                                                                },
                                                                {
                                                                    "id": "3930129",
                                                                    "speaker": "Venti",
                                                                    "text": "Ninguém deveria tê-lo enganado, lhe dizendo que Mondstadt o traiu."
                                                                },
                                                                {
                                                                    "id": "3930130",
                                                                    "speaker": "Venti",
                                                                    "text": "E também ninguém devia ter dito que sua missão eterna era proteger a cidade."
                                                                },
                                                                {
                                                                    "id": "3930131",
                                                                    "speaker": "Venti",
                                                                    "text": "Ele tem o direito e a liberdade de escolher o que fazer da sua vida."
                                                                },
                                                                {
                                                                    "id": "3930132",
                                                                    "speaker": "Paimon",
                                                                    "text": "Venti..."
                                                                },
                                                                {
                                                                    "id": "3930133",
                                                                    "speaker": "Venti",
                                                                    "text": "#Bem, {NICKNAME}, que o vento de Mondstadt que tem soprado por milênios esteja com você."
                                                                },
                                                                {
                                                                    "id": "3930134",
                                                                    "speaker": "Venti",
                                                                    "text": "Assim como aquela vez, eu vou canalizar o elemento Anemo para você.",
                                                                    "choices": [
                                                                        {
                                                                            "id": "3930135",
                                                                            "text": "Você disse \"aquela época\"...",
                                                                            "response": [
                                                                                {
                                                                                    "id": "3930137",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "#Então foi isso! Foi por isso que {NICKNAME} disse que sua voz era muito familiar."
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "3930136",
                                                                            "text": "Eu sabia! Foi a sua voz que ouvi!"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "3930117",
                                                            "text": "Então, é a \"responsabilidade\" o que move a Jean.",
                                                            "response": [
                                                                {
                                                                    "id": "3930118",
                                                                    "speaker": "Paimon",
                                                                    "text": "Quanto à razão de Mestre Diluc, foi a \"confiança\"?"
                                                                },
                                                                {
                                                                    "id": "3930119",
                                                                    "speaker": "Paimon",
                                                                    "text": "E quanto ao Bardo Desafinado?"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "3930120",
                                                            "text": "E o Venti?"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "3930109",
                                            "text": "#Não se preocupe, eu também estou pront{M#o}{F#a}!"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "3930103",
                            "text": "Somos praticamente velhos colegas agora."
                        }
                    ]
                }
            ]
        },
        {
            "id": "39302",
            "objective": "Volte para o topo da torre",
            "dialogues": [
                {
                    "id": "3930201",
                    "speaker": "Venti",
                    "text": "Não é uma má ideia que convertem os ventos que dão vida a ventos de aventura."
                },
                {
                    "id": "3930202",
                    "speaker": "Venti",
                    "text": "Por favor, cuida do <color=#00E1FFFF>Dvalin</color>."
