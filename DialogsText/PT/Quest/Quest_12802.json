    "talks": [
        {
            "id": "1280201",
            "objective": "",
            "dialogues": [
                {
                    "id": "698390101",
                    "speaker": "Gendou Ringo",
                    "text": "#Olá, {NICKNAME}. Você veio pegar um Rolinho da Sorte? Sinto muito, mas não é a melhor hora."
                },
                {
                    "id": "698390102",
                    "speaker": "Player",
                    "text": "A caixa não está ali?"
                },
                {
                    "id": "698390103",
                    "speaker": "Gendou Ringo",
                    "text": "Está, e os Rolinhos de Bambu também. Mas, estamos sem os Rolinhos da Sorte correspondentes. Digo, as tiras de papel com a frase da sorte.",
                    "choices": [
                        {
                            "id": "698390104",
                            "text": "Isso pode acontecer?",
                            "response": [
                                {
                                    "id": "698390106",
                                    "speaker": "Gendou Ringo",
                                    "text": "Depende da sua sorte. Estamos preparando novos rolinhos."
                                },
                                {
                                    "id": "698390107",
                                    "speaker": "Player",
                                    "text": "E como eu vejo essa sorte?"
                                },
                                {
                                    "id": "698390108",
                                    "speaker": "Gendou Ringo",
                                    "text": "Tirando um rolinho."
                                },
                                {
                                    "id": "698390109",
                                    "speaker": "Player",
                                    "text": "... E quando eu vou poder tirar um rolinho?"
                                },
                                {
                                    "id": "698390110",
                                    "speaker": "Gendou Ringo",
                                    "text": "Isso depende da sua sorte.",
                                    "choices": [
                                        {
                                            "id": "698390111",
                                            "text": "... Estamos falando em círculos.",
                                            "response": [
                                                {
                                                    "id": "698390112",
                                                    "speaker": "Gendou Ringo",
                                                    "text": "Sim, e você girou até chegar a uma grande sorte."
                                                },
                                                {
                                                    "id": "698390115",
                                                    "speaker": "Player",
                                                    "text": "Espera, como você sabia disso?"
                                                },
                                                {
                                                    "id": "698390116",
                                                    "speaker": "Yae Miko",
                                                    "text": "Oh, eu estava pensando em quem havia entrado... é você! Veio pegar um rolinho?",
                                                    "choices": [
                                                        {
                                                            "id": "698390117",
                                                            "text": "Isso mesmo.",
                                                            "response": [
                                                                {
                                                                    "id": "698390119",
                                                                    "speaker": "Yae Miko",
                                                                    "text": "Sim! Todos em Inazuma parecem estar cada vez mais ansiosos. E ninguém pensa no aumento do consumo de papel..."
                                                                },
                                                                {
                                                                    "id": "698390120",
                                                                    "speaker": "Yae Miko",
                                                                    "text": "Também nos reabastecemos mais cedo, e puf! Do nada! Acabou! Até os rolinhos de grande sorte estão quase no fim. *Suspiro* Os problemas de ser uma Guuji nunca acabam..."
                                                                },
                                                                {
                                                                    "id": "698390121",
                                                                    "speaker": "Yae Miko",
                                                                    "text": "Ainda assim, você está com sorte hoje. Aqui, Ringo. 300 novos rolinhos da sorte, escritos por mim de uma vez. Deve ser suficiente por enquanto.",
                                                                    "choices": [
                                                                        {
                                                                            "id": "698390122",
                                                                            "text": "Trezentos?!",
                                                                            "response": [
                                                                                {
                                                                                    "id": "698390124",
                                                                                    "speaker": "Yae Miko",
                                                                                    "text": "Bem... isso depende da sorte de todo mundo, é claro."
                                                                                },
                                                                                {
                                                                                    "id": "698390125",
                                                                                    "speaker": "Yae Miko",
                                                                                    "text": "#Veja, pequenin{F#a}{M#o}, você não está aqui em busca da sua? Vá, eu cobrirei seus olhos enquanto você tira um rolinho."
                                                                                },
                                                                                {
                                                                                    "id": "698390126",
                                                                                    "speaker": "Yae Miko",
                                                                                    "text": "Tire um que dê sorte também. Esses não são os rolinhos da sorte quaisquer, são os rolinhos especiais da Guuji Yae!"
                                                                                },
                                                                                {
                                                                                    "id": "698390127",
                                                                                    "speaker": "Yae Miko",
                                                                                    "text": "Viu? Ringo estava certa. A sua sorte é grande.",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "698390128",
                                                                                            "text": "Como você ouviu isso?",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "698390129",
                                                                                                    "speaker": "Yae Miko",
                                                                                                    "text": "Oh, pelos Arcontes. Você está no Grande Santuário Narukami. Por acaso é estranho que meus ouvidos possam ouvir melhor dentro dele?"
                                                                                                },
                                                                                                {
                                                                                                    "id": "698390132",
                                                                                                    "speaker": "Yae Miko",
                                                                                                    "text": "Esse Rolinho da Sorte foi escrito pessoalmente pela atual Guuji do Grande Santuário Narukami, Yae Miko, então é bem forte. Cuide bem dele, ou então vai cair nas mãos dos Tanuki ou Baku."
                                                                                                },
                                                                                                {
                                                                                                    "id": "698390133",
                                                                                                    "speaker": "Yae Miko",
                                                                                                    "text": "Enfim, como sempre, deixo o resto com você, Ringo."
                                                                                                },
                                                                                                {
                                                                                                    "id": "698390134",
                                                                                                    "speaker": "Gendou Ringo",
                                                                                                    "text": "Sim, Senhorita Guuji."
                                                                                                },
                                                                                                {
                                                                                                    "id": "698390135",
                                                                                                    "speaker": "Player",
                                                                                                    "text": "Hã? O resto?"
                                                                                                },
                                                                                                {
                                                                                                    "id": "698390136",
                                                                                                    "speaker": "Gendou Ringo",
                                                                                                    "text": "Exatamente o que ela quis dizer. Ela escreveu rolinhos de boa sorte. Os de azar ainda não estão completos."
                                                                                                },
                                                                                                {
                                                                                                    "id": "698390137",
                                                                                                    "speaker": "Yae Miko",
                                                                                                    "text": "Qualquer sorte que eu escrever será muito forte. Por que eu usaria esse poder para prever azar?"
                                                                                                },
                                                                                                {
                                                                                                    "id": "698390138",
                                                                                                    "speaker": "Yae Miko",
                                                                                                    "text": "Por isso, é melhor que Ringo escreva os rolinhos do azar. O bem-estar de nossos visitantes está em jogo!"
                                                                                                },
                                                                                                {
                                                                                                    "id": "698390139",
                                                                                                    "speaker": "Yae Miko",
                                                                                                    "text": "#Agora vou escrever algumas pequenas sortes. Aproveite sua sorte maravilhosa de hoje, pequenin{F#a}{M#o}.",
                                                                                                    "choices": [
                                                                                                        {
                                                                                                            "id": "698390140",
                                                                                                            "text": "Ela só tá tentando vagabundar por aí, né?",
                                                                                                            "response": [
                                                                                                                {
                                                                                                                    "id": "698390142",
                                                                                                                    "speaker": "Gendou Ringo",
                                                                                                                    "text": "#... Aproveite sua grande sorte de hoje, {NICKNAME}."
                                                                                                                }
                                                                                                            ]
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "698390141",
                                                                                                            "text": "Nada como uma desculpa para sair escrevendo quantas sortes quiser."
                                                                                                        }
                                                                                                    ]
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "698390130",
                                                                                            "text": "Miko, você por acaso...",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "698390131",
                                                                                                    "speaker": "Yae Miko",
                                                                                                    "text": "Ssh. Não deixe que o mundo descubra, ou os Youkai virão roubar a sua boa sorte."
                                                                                                }
                                                                                            ]
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "698390123",
                                                                            "text": "E quanto tempo vai levar pra ler todos esses?!"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "698390118",
                                                            "text": "Mas a Ringo aqui disse que eles já acabaram."
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "698390113",
                                            "text": "Por quanto tempo isso vai continuar?",
                                            "response": [
                                                {
                                                    "id": "698390114",
                                                    "speaker": "Gendou Ringo",
                                                    "text": "Até agora há... pouco. Parabéns com a sua grande sorte."
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "698390105",
                            "text": "Então, quando vou poder tirar um?"
                        }
                    ]
                }
            ]
        }
    ]
}