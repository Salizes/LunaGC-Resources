    "talks": [
        {
            "id": "7166401",
            "objective": "Vá para a Guilda de Aventureiros de Liyue",
            "dialogues": [
                {
                    "id": "716640101",
                    "speaker": "Katheryne",
                    "text": "Ah, finalmente você chegou, Viajante."
                },
                {
                    "id": "716640102",
                    "speaker": "Katheryne",
                    "text": "Recentemente a Guilda de Aventureiros recebeu uma Comissão importante. E de acordo com minha experiência, você é a escolha mais adequada.",
                    "choices": [
                        {
                            "id": "716640103",
                            "text": "Uma Comissão importante...",
                            "response": [
                                {
                                    "id": "716640105",
                                    "speaker": "Paimon",
                                    "text": "#Oh, não diga isso. Katheryne, nós já estamos acostumad{F#as}{M#os}!"
                                },
                                {
                                    "id": "716640106",
                                    "speaker": "Paimon",
                                    "text": "Se a recompensa dessa Comissão não for boa, Katheryne não nos incomodaria, não é?"
                                },
                                {
                                    "id": "716640107",
                                    "speaker": "Katheryne",
                                    "text": "#*Cof* *Cof* Bem, é verdade... Como esperado de vocês, sempre diret{F#as}{M#os}."
                                },
                                {
                                    "id": "716640108",
                                    "speaker": "Katheryne",
                                    "text": "Bem, vou direto ao ponto então. O Solicitante dessa Comissão é de uma pessoa chamada Patrice. Ele é um pesquisador que veio de Fontaine."
                                },
                                {
                                    "id": "716640109",
                                    "speaker": "Katheryne",
                                    "text": "Ele gostaria de contratar alguns ajudantes para auxiliá-lo com sua pesquisa. No momento ele está nas redondezas do Despenhadeiro fazendo algumas observações."
                                },
                                {
                                    "id": "716640110",
                                    "speaker": "Katheryne",
                                    "text": "#Apesar de nós não sabermos muitos detalhes a respeito da natureza dessa pesquisa, eu creio que você já está bem familiarizad{F#a}{M#o} com tais comissões."
                                },
                                {
                                    "id": "716640111",
                                    "speaker": "Player",
                                    "text": "É verdade..."
                                },
                                {
                                    "id": "716640112",
                                    "speaker": "Paimon",
                                    "text": "Bem, vamos fazer como sempre fizemos. Vamos para o Despenhadeiro!"
                                }
                            ]
                        },
                        {
                            "id": "716640104",
                            "text": "Isso parece familiar..."
                        }
                    ]
                }
            ]
        },
        {
            "id": "7166402",
            "objective": "Vá para a região do Despenhadeiro procurar por Patrice",
            "dialogues": [
                {
                    "id": "716640201",
                    "speaker": "Patrice",
                    "text": "Não podemos ter mais atrasos. Precisamos iniciar o estágio de verificação o mais rápido possível... Se não der, eu farei isso pessoalmente."
                },
                {
                    "id": "716640202",
                    "speaker": "Patrice",
                    "text": "\"A pesquisa foi temporariamente interrompida devido a um ferimento acidental\". Acho que isso me dará mais um tempo..."
                },
                {
                    "id": "716640203",
                    "speaker": "Patrice",
                    "text": "Desde que eu não morra, é melhor do que ser julgado!"
                },
                {
                    "id": "716640204",
                    "speaker": "Paimon",
                    "text": "#Por que ele está falando sozinho? Vamos dar um oi, {NICKNAME}."
                },
                {
                    "id": "716640205",
                    "speaker": "Player",
                    "text": "Olá, você é Patrice?"
                },
                {
                    "id": "716640206",
                    "speaker": "Patrice",
                    "text": "AH! Que susto! De onde vocês saíram? E como vocês sabem o meu nome?"
                },
                {
                    "id": "716640207",
                    "speaker": "Patrice",
                    "text": "Espere, vocês não são Millelith à paisana, não é? Estão aqui para me expulsar? Eu já lhes mostrei minha permissão para fazer uma inspeção no local!"
                },
                {
                    "id": "716640208",
                    "speaker": "Patrice",
                    "text": "Eu lhes garanto que não entrei em nenhuma área restrita! Se não acreditam em mim, perguntem àquela mulher ali de cabelo preto e cara feroz!"
                },
                {
                    "id": "716640209",
                    "speaker": "Paimon",
                    "text": "Hã, Paimon não sabe de quem você está falando, mas você pode relaxar."
                },
                {
                    "id": "716640210",
                    "speaker": "Paimon",
                    "text": "#Somos Aventureir{F#as}{M#os} amigáveis. Recebemos uma Comissão da Guilda, e viemos lhe ajudar a resolver seus problemas."
                },
                {
                    "id": "716640211",
                    "speaker": "Patrice",
                    "text": "Oh, então vocês são reforços? Fantástico! Agora que vocês estão aqui, minha pesquisa pode ser salva! Se não fosse por isso, eu acabaria morto aqui mais cedo ou mais tarde..."
                },
                {
                    "id": "716640212",
                    "speaker": "Paimon",
                    "text": "Sua pesquisa parece uma tortura..."
                },
                {
                    "id": "716640213",
                    "speaker": "Patrice",
                    "text": "Não, não! Pesquisa é uma coisa sagrada! A única coisa que está em meu caminho é um \"fator adicional\"."
                },
                {
                    "id": "716640214",
                    "speaker": "Paimon",
                    "text": "\"Fator adicional\"? Tipo o quê?"
                },
                {
                    "id": "716640215",
                    "speaker": "Patrice",
                    "text": "Tipo eu morrer caso minha pesquisa fracasse."
                },
                {
                    "id": "716640216",
                    "speaker": "Paimon",
                    "text": "...?",
                    "choices": [
                        {
                            "id": "716640217",
                            "text": "... Você parece um derrotista.",
                            "response": [
                                {
                                    "id": "716640219",
                                    "speaker": "Patrice",
                                    "text": "*Suspiro* Eu não estou brincando."
                                },
                                {
                                    "id": "716640220",
                                    "speaker": "Patrice",
                                    "text": "Pesquisadores independentes precisam solicitar financiamento, mas para usar esse financiamento é necessário assumir a responsabilidade social que vem junto com seu uso em Fontaine."
                                },
                                {
                                    "id": "716640221",
                                    "speaker": "Patrice",
                                    "text": "Gastar muito dinheiro e não ter resultados não lhe faz diferente de um criminoso merecedor de um julgamento!"
                                },
                                {
                                    "id": "716640222",
                                    "speaker": "Patrice",
                                    "text": "Se eu voltar de mãos abanando, com certeza sofrerei várias acusações, como \"desperdício de dinheiro público\", mas também \"má aplicação de recursos acadêmicos\" e outras coisas!"
                                },
                                {
                                    "id": "716640223",
                                    "speaker": "Patrice",
                                    "text": "Tais crimes me renderão uma pena severa... Não importa se eu estarei quebrado ou o meu nome estará manchado. Se eu for julgado, realmente posso morrer!"
                                },
                                {
                                    "id": "716640224",
                                    "speaker": "Paimon",
                                    "text": "Hã? Isso parece um absurdo!"
                                },
                                {
                                    "id": "716640225",
                                    "speaker": "Paimon",
                                    "text": "É por isso que você gastou tantas Mora para ter assistentes para lhe ajudarem?",
                                    "choices": [
                                        {
                                            "id": "716640226",
                                            "text": "Fontaine parece um lugar assustador.",
                                            "response": [
                                                {
                                                    "id": "716640227",
                                                    "speaker": "Patrice",
                                                    "text": "Não, minha linda terra natal é inocente! Tudo é culpa dos \"fatores adicionais\"!"
                                                },
                                                {
                                                    "id": "716640230",
                                                    "speaker": "Paimon",
                                                    "text": "Certo, se acalme, nós entendemos que a situação é séria. Essa pesquisa é relacionada ao seu futuro e até a sua vida, não é?"
                                                },
                                                {
                                                    "id": "716640231",
                                                    "speaker": "Paimon",
                                                    "text": "Deixe conosco! Nós lhe ajudaremos a resolver isso!"
                                                },
                                                {
                                                    "id": "716640232",
                                                    "speaker": "Patrice",
                                                    "text": "Em minha situação atual, eu só posso contar com vocês.",
                                                    "choices": [
                                                        {
                                                            "id": "716640233",
                                                            "text": "O que você precisa que nós façamos?",
                                                            "response": [
                                                                {
                                                                    "id": "716640235",
                                                                    "speaker": "Patrice",
                                                                    "text": "Sim, vamos falar dele. Meu projeto de pesquisa é sobre Vibração Ressonante de Cristais."
                                                                },
                                                                {
                                                                    "id": "716640236",
                                                                    "speaker": "Patrice",
                                                                    "text": "Em termos simples, é um processo de estimular energia elemental em gemas e cristais para então usar ela como uma fonte de energia."
                                                                },
                                                                {
                                                                    "id": "716640237",
                                                                    "speaker": "Paimon",
                                                                    "text": "Isso soa muito conveniente! Paimon pode visualizar isso sendo usado para fazer máquinas práticas e incríveis!"
                                                                },
                                                                {
                                                                    "id": "716640238",
                                                                    "speaker": "Paimon",
                                                                    "text": "Mas o que essas gemas tem a ver com essa coisa de vibração, ressonância e tal que você está falando?"
                                                                },
                                                                {
                                                                    "id": "716640239",
                                                                    "speaker": "Player",
                                                                    "text": "Essas gemas são os \"Cristais Vibrantes\"."
                                                                },
                                                                {
                                                                    "id": "716640240",
                                                                    "speaker": "Patrice",
                                                                    "text": "Exatamente! Pouco tempo atrás, quando alguém tentou ativar as gemas, descobriu que uma ressonância podia ocorrer entre um tipo especial de gema."
                                                                },
                                                                {
                                                                    "id": "716640241",
                                                                    "speaker": "Patrice",
                                                                    "text": "E então essas gemas foram chamadas de \"Cristais Vibrantes\"."
                                                                },
                                                                {
                                                                    "id": "716640242",
                                                                    "speaker": "Patrice",
                                                                    "text": "Quando o Cristal Transmissor do Cristal Vibrante é estimulado de uma certa forma, ele soltará energia que ressoará com o Cristal Receptor."
                                                                },
                                                                {
                                                                    "id": "716640243",
                                                                    "speaker": "Patrice",
                                                                    "text": "Os dois tipos de energia liberadas pelo Cristal Vibrante se acumularão e multiplicarão várias vezes! Eu chamei essa ressonância de \"Irradiação\"."
                                                                },
                                                                {
                                                                    "id": "716640244",
                                                                    "speaker": "Patrice",
                                                                    "text": "Atualmente eu estou em um estágio crítico de minha pesquisa — verificar a minha hipótese dessa \"interirradiação\".",
                                                                    "choices": [
                                                                        {
                                                                            "id": "716640245",
                                                                            "text": "Estou com uma certa sensação...",
                                                                            "response": [
                                                                                {
                                                                                    "id": "716640247",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "Deixe Paimon adivinhar: você quer que nós testemos sua hipótese usando o poder desses Cristais Vibrantes para derrotar monstros e provar o que você chama de \"Interirradiação\"..."
                                                                                },
                                                                                {
                                                                                    "id": "716640248",
                                                                                    "speaker": "Patrice",
                                                                                    "text": "Isso mesmo! Que grande percepção!"
                                                                                },
                                                                                {
                                                                                    "id": "716640249",
                                                                                    "speaker": "Patrice",
                                                                                    "text": "#Eu escolhi uma área adequada que possui monumentos com conjuntos de Cristais Vibrantes. Quando você estiver pront{F#a}{M#o}, basta me falar."
                                                                                },
                                                                                {
                                                                                    "id": "716640250",
                                                                                    "speaker": "Patrice",
                                                                                    "text": "Eu lhes explicarei em detalhes o que precisa ser comprovado para a pesquisa. Basta vocês lutarem de acordo com minhas instruções que tudo vai dar certo."
                                                                                },
                                                                                {
                                                                                    "id": "716640251",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "#Argh, esse é o tipo de trabalho que nós somos mais familiarizad{F#as}{M#os}, até mesmo achamos chato.",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "716640252",
                                                                                            "text": "#Eu estou interessad{F#a}{M#o}...",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "716640253",
                                                                                                    "speaker": "Paimon",
                                                                                                    "text": "Você já venceu inimigos muito mais fortes ao ponto de ser impossível contar! Claro que uma Comissão como essa é mamão com açúcar!"
                                                                                                },
                                                                                                {
                                                                                                    "id": "716640256",
                                                                                                    "speaker": "Patrice",
                                                                                                    "text": "#Impressionante! Liyue é realmente um lugar excelente, não apenas produz minérios de alta qualidade, mas também possui Aventureir{F#as}{M#os} muito confiáveis!"
                                                                                                },
                                                                                                {
                                                                                                    "id": "716640257",
                                                                                                    "speaker": "Patrice",
                                                                                                    "text": "Ah, acho que vir até aqui para poupar custos foi uma decisão acertada."
                                                                                                },
                                                                                                {
                                                                                                    "id": "716640258",
                                                                                                    "speaker": "Patrice",
                                                                                                    "text": "#Eu originalmente estava preocupado que acabaria estourando meu orçamento, mas acho que manterei 20% de meus fundos mesmo depois de pagar a comissão de vocês {F#duas}{M#dois}."
                                                                                                },
                                                                                                {
                                                                                                    "id": "716640259",
                                                                                                    "speaker": "Patrice",
                                                                                                    "text": "Quando terminamos isso, eu devo usar a quantidade restante para contratar um articulista para publicar meus resultados. Afinal, é bom que meus resultados sejam divulgados."
                                                                                                },
                                                                                                {
                                                                                                    "id": "716640260",
                                                                                                    "speaker": "Patrice",
                                                                                                    "text": "Já consigo ver o título! \"Contemplem! A história verdadeira dos Cristais Vibrantes de Patrice!\""
                                                                                                },
                                                                                                {
                                                                                                    "id": "716640261",
                                                                                                    "speaker": "Paimon",
                                                                                                    "text": "Sério? Isso não parece nem um pouco com um título de um artigo acadêmico!"
                                                                                                },
                                                                                                {
                                                                                                    "id": "716640262",
                                                                                                    "speaker": "Patrice",
                                                                                                    "text": "Mas títulos têm que ser estranhos para atrair a atenção do público e investimento! Quando isso acontece, nós podemos até mesmo discutir bônus!"
                                                                                                },
                                                                                                {
                                                                                                    "id": "716640263",
                                                                                                    "speaker": "Paimon",
                                                                                                    "text": "Bônus? Paimon não está entendendo o que você quer dizer..."
                                                                                                },
                                                                                                {
                                                                                                    "id": "716640264",
                                                                                                    "speaker": "Patrice",
                                                                                                    "text": "Se a teoria da Vibração Ressonante de Cristais for usada na criação de produtos comerciais, eu receberei uma parte do lucro por causa da propriedade intelectual, e vocês também receberão um pouco de minha parte."
                                                                                                },
                                                                                                {
                                                                                                    "id": "716640265",
                                                                                                    "speaker": "Patrice",
                                                                                                    "text": "Claro, isso depende do progresso de nossa pesquisa..."
                                                                                                },
                                                                                                {
                                                                                                    "id": "716640266",
                                                                                                    "speaker": "Paimon",
                                                                                                    "text": "Oh, é assim que funciona? Agora Paimon está animada! Você pode usar o título que quiser, não importa!",
                                                                                                    "choices": [
                                                                                                        {
                                                                                                            "id": "716640267",
                                                                                                            "text": "Paimon...",
                                                                                                            "response": [
                                                                                                                {
                                                                                                                    "id": "716640269",
                                                                                                                    "speaker": "Paimon",
                                                                                                                    "text": "#Enfim, {NICKNAME}, vamos começar a trabalhar, quanto mais rápido melhor!"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "716640270",
                                                                                                                    "speaker": "Paimon",
                                                                                                                    "text": "Depois disso podemos discutir sobre esse bônus com Patrice, hehe..."
                                                                                                                }
                                                                                                            ]
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "716640268",
                                                                                                            "text": "Paimon, você está babando..."
                                                                                                        }
                                                                                                    ]
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "716640254",
                                                                                            "text": "Que tal você tentar então?",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "716640255",
                                                                                                    "speaker": "Paimon",
                                                                                                    "text": "Hããã, Paimon? Paimon só queria que você aceitasse comissões interessantes e desafiadoras... Paimon não está reclamando!"
                                                                                                }
                                                                                            ]
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "716640246",
                                                                            "text": "Eu já entendi..."
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "716640234",
                                                            "text": "Por favor, nos explique seu projeto de pesquisa."
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "716640228",
                                            "text": "Esses \"fatores adicionais\" soam amedrontadores.",
                                            "response": [
                                                {
                                                    "id": "716640229",
                                                    "speaker": "Patrice",
                                                    "text": "Mas eles são úteis. Desde que você não seja considerado culpado, é possível usufruir de várias conveniências. Nós, de Fontaine, já nos beneficiamos muito desse sistema no passado."
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "716640218",
                            "text": "Oh, você é engraçado."
                        }
                    ]
                }
            ]
        }
    ]
}