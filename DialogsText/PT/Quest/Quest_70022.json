            "objective": "Fale com o outro Hilichurl disposto a conversar",
            "dialogues": [
                {
                    "id": "700220101",
                    "speaker": "Hilichurl Curioso",
                    "text": "Odomu tomo? Kundala? Mosi mita?"
                },
                {
                    "id": "700220102",
                    "speaker": "Ella Musk",
                    "text": "Mimi tomo! Mosi mita!"
                },
                {
                    "id": "700220103",
                    "speaker": "Hilichurl Curioso",
                    "text": "Tomo mosi mita! Tomo mani mimi?"
                },
                {
                    "id": "700220104",
                    "speaker": "Ella Musk",
                    "text": "Mimi mani ye! Plata yaya ika?"
                },
                {
                    "id": "700220105",
                    "speaker": "Hilichurl Curioso",
                    "text": "Plata ika odomu! Zido mi! mi muhe yeye! Mi mita yeye!"
                },
                {
                    "id": "700220106",
                    "speaker": "Paimon",
                    "text": "Paimon não sabe como, mas eles parecem estar se dando bem.",
                    "choices": [
                        {
                            "id": "700220107",
                            "text": "Então isso é o que significa ser uma estudiosa dos Hilichurls?",
                            "response": [
                                {
                                    "id": "700220109",
                                    "speaker": "Ella Musk",
                                    "text": "Ele quer fazer amizade conosco, mas precisa que ajudemos com algo..."
                                },
                                {
                                    "id": "700220110",
                                    "speaker": "Ella Musk",
                                    "text": "Precisamos ajudá-lo com um inimigo difícil de se lidar. Ele marcou sua localização no mapa."
                                },
                                {
                                    "id": "700220111",
                                    "speaker": "Hilichurl Curioso",
                                    "text": "Dada, Valo!"
                                },
                                {
                                    "id": "700220112",
                                    "speaker": "Ella Musk",
                                    "text": "Valo!"
                                }
                            ]
                        },
                        {
                            "id": "700220108",
                            "text": "O ambiente ficou mais animado..."
                        }
                    ]
                }
            ]
        },
        {
