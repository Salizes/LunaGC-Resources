    "talks": [
        {
            "id": "4010603",
            "objective": "",
            "dialogues": [
                {
                    "id": "401060301",
                    "speaker": "Dori",
                    "text": "Bem, como foi? Suponho que a ajuda de Lorde Sangemah Bay ajudou vocês a descobrirem algo, correto?"
                },
                {
                    "id": "401060302",
                    "speaker": "Paimon",
                    "text": "Você quer dizer..."
                },
                {
                    "id": "401060303",
                    "speaker": "Dori",
                    "text": "Sachin não era uma boa pessoa, e definitivamente tem algo errado com o Diadema do Conhecimento!",
                    "choices": [
                        {
                            "id": "401060304",
                            "text": "De fato.",
                            "response": [
                                {
                                    "id": "401060306",
                                    "speaker": "Dori",
                                    "text": "Então, nesse caso, você não deveria estar fazendo algo sobre isso?"
                                },
                                {
                                    "id": "401060307",
                                    "speaker": "Dori",
                                    "text": "Por exemplo, dizendo à Academia que eles deveriam entregar o Diadem—"
                                },
                                {
                                    "id": "401060308",
                                    "speaker": "Paimon",
                                    "text": "Já contamos para a Academia, mas..."
                                },
                                {
                                    "id": "401060309",
                                    "speaker": "Dori",
                                    "text": "Mas o quê?"
                                },
                                {
                                    "id": "401060310",
                                    "speaker": "Paimon",
                                    "text": "Kaveh destruiu o diadema."
                                },
                                {
                                    "id": "401060311",
                                    "speaker": "Dori",
                                    "text": "O quêeeeeeeeeeee!?"
                                },
                                {
                                    "id": "401060312",
                                    "speaker": "Paimon",
                                    "text": "Acalme-se, Dori! Por que você está ficando tão agoniada?"
                                },
                                {
                                    "id": "401060313",
                                    "speaker": "Dori",
                                    "text": "..."
                                },
                                {
                                    "id": "401060314",
                                    "speaker": "Dori",
                                    "text": "Meu diadema... meu lindo diadema..."
                                },
                                {
                                    "id": "401060315",
                                    "speaker": "Dori",
                                    "text": "Ah, isso deveria ter sido o plano perfeito! Eu te dava a informação, você descobre o problema com o diadema, e então eu apenas espero até que a Academia venda por um preço baixo..."
                                },
                                {
                                    "id": "401060316",
                                    "speaker": "Dori",
                                    "text": "E agora foi tudo por nada! Grrr, maldito Kaveh! O juros da Mora que ele me deve estão prestes a ficar muito mais altos!"
                                },
                                {
                                    "id": "401060317",
                                    "speaker": "Paimon",
                                    "text": "Oooh, então foi por isso que você nos contou sobre isso. Paimon bem que achou que você estava sendo estranhamente generosa..."
                                },
                                {
                                    "id": "401060318",
                                    "speaker": "Dori",
                                    "text": "Meu diadema! Argh, estou furiosa! É isto, sem extensão do prazo do pagamento dele deste mês, não importa qual desculpa ele dê!"
                                }
                            ]
                        },
                        {
                            "id": "401060305",
                            "text": "Também descobrimos isso."
                        }
                    ]
                }
            ]
        },
        {
            "id": "4010299",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "401029905",
                    "speaker": "Kaveh",
                    "text": "(Ele deixou as anotações aqui de propósito, ou foi mera coincidência? Não... Mas se não foi uma coincidência, então...)"
                }
            ]
        },
        {
            "id": "4010604",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "401060401",
                    "speaker": "Kaveh",
                    "text": "\"Pequenas decisões\"? O que será que estava passando na cabeça dele quando escreveu isso..."
                }
            ]
        }
    ]
