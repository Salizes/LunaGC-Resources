    "talks": [
        {
            "id": "7002001",
            "objective": "Fale com o outro Hilichurl disposto a conversar",
            "dialogues": [
                {
                    "id": "700200102",
                    "speaker": "Hilichurl Abandonado",
                    "text": "Odomu! Ya dala?"
                },
                {
                    "id": "700200103",
                    "speaker": "Ella Musk",
                    "text": "Espere, deixe-me cuidar disso."
                },
                {
                    "id": "700200104",
                    "speaker": "Ella Musk",
                    "text": "Mimi tomo, Odomu nye! Muhe mani?"
                },
                {
                    "id": "700200105",
                    "speaker": "Hilichurl Abandonado",
                    "text": "Mani? Mani! Yoyo mani mi?"
                },
                {
                    "id": "700200106",
                    "speaker": "Ella Musk",
                    "text": "Dada!"
                },
                {
                    "id": "700200107",
                    "speaker": "Hilichurl Abandonado",
                    "text": "Dada!",
                    "choices": [
                        {
                            "id": "700200108",
                            "text": "Parece que tudo está correndo bem.",
                            "response": [
                                {
                                    "id": "700200110",
                                    "speaker": "Ella Musk",
                                    "text": "Estou perguntando se ele precisa de ajuda. Pela sua aparência, parece que sim."
                                },
                                {
                                    "id": "700200111",
                                    "speaker": "Hilichurl Abandonado",
                                    "text": "Dada odomu! Kundala dada! Kundala zido, mi dada! Muhe yeye!"
                                },
                                {
                                    "id": "700200112",
                                    "speaker": "Ella Musk",
                                    "text": "Oh... O que ele quer dizer é que precisa que nós o ajudemos a derrotar um inimigo... Muito forte."
                                },
                                {
                                    "id": "700200113",
                                    "speaker": "Ella Musk",
                                    "text": "Ya zido? Ye? Mi?"
                                },
                                {
                                    "id": "700200114",
                                    "speaker": "Hilichurl Abandonado",
                                    "text": "Mi! Mi!"
                                },
                                {
                                    "id": "700200115",
                                    "speaker": "Ella Musk",
                                    "text": "Certo, a localização dele está marcada no mapa. Deixarei o resto com você!"
                                },
                                {
                                    "id": "700200116",
                                    "speaker": "Hilichurl Abandonado",
                                    "text": "Dada, Valo!"
                                }
                            ]
                        },
                        {
                            "id": "700200109",
                            "text": "O que vocês estão falando?"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7002002",
            "objective": "Vá até o local designado para um combate",
            "dialogues": [
                {
                    "id": "700200201",
                    "speaker": "Hilichurl Abandonado",
                    "text": "Yeye dada! Mosi mita!"
                },
                {
                    "id": "700200202",
                    "speaker": "Hilichurl Abandonado",
                    "text": "Odomu tomo zido mi! Mi mani yeye! <color=#00E1FFFF>Unta nunu</color>！"
                },
                {
                    "id": "700200203",
                    "speaker": "Paimon",
                    "text": "<color=#00E1FFFF>Unta nunu</color>... Paimon acha que isso tem a ver com o tempo. É melhor você verificar as anotações.",
                    "choices": [
                        {
                            "id": "700200204",
                            "text": "#Uh... Obrigad{F#a}{M#o}?",
                            "response": [
                                {
                                    "id": "700200206",
                                    "speaker": "Hilichurl Abandonado",
                                    "text": "Valo, tomo!"
                                },
                                {
                                    "id": "700200207",
                                    "speaker": "Paimon",
                                    "text": "Hehe, valo!"
                                }
                            ]
                        },
                        {
                            "id": "700200205",
                            "text": "Tomo, valo!"
                        }
                    ]
                }
            ]
        },
