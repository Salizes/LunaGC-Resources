    "talks": [
        {
            "id": "7406501",
            "objective": "",
            "dialogues": [
                {
                    "id": "740650101",
                    "speaker": "Decembre",
                    "text": "#Ei! Dê uma olhada, ali não é {NICKNAME} e Paimon?",
                    "choices": [
                        {
                            "id": "740650102",
                            "text": "A gente te conhece?",
                            "response": [
                                {
                                    "id": "740650104",
                                    "speaker": "Decembre",
                                    "text": "#Não seja tão fri{M#o}{F#a}. Eu nunca vou esquecer o que fizeram por mim naquele dia."
                                },
                                {
                                    "id": "740650105",
                                    "speaker": "Paimon",
                                    "text": "Naquele dia... Ah! Ainda temos muito que perguntar!"
                                },
                                {
                                    "id": "740650106",
                                    "speaker": "Decembre",
                                    "text": "É-É mesmo? Ugh, oh, o que é isso? Minha memória está me zoando de novo! O que aconteceu antes? Eu não consigo lembrar de nada!"
                                },
                                {
                                    "id": "740650107",
                                    "speaker": "Decembre",
                                    "text": "Os sábios dizem que é melhor olhar para o futuro do que observar o passado. Então vamos falar sobre nossa futura colaboração e esquecer o passado!"
                                },
                                {
                                    "id": "740650108",
                                    "speaker": "Decembre",
                                    "text": "Tenho alguns trabalhos em mão que pagam muito bem, mas não tenho ninguém para ajudar. Se estiverem livres, querem tentar?"
                                },
                                {
                                    "id": "740650109",
                                    "speaker": "Paimon",
                                    "text": "Hunf! Não vá pensando que a gente é fácil de enganar..."
                                },
                                {
                                    "id": "740650110",
                                    "speaker": "Player",
                                    "text": "E a recompensa é boa?"
                                },
                                {
                                    "id": "740650111",
                                    "speaker": "Paimon",
                                    "text": "Ei!"
                                },
                                {
                                    "id": "740650112",
                                    "speaker": "Decembre",
                                    "text": "#É por isso que gosto tanto de falar de negócios com gente como {M#o Sr.}{F#a Srta.} {NICKNAME}. Como eles falam? Ah, pegar as coisas no ar!"
                                },
                                {
                                    "id": "740650113",
                                    "speaker": "Decembre",
                                    "text": "Que tal eu dizer um número garantido de te satisfazer?"
                                },
                                {
                                    "id": "740650114",
                                    "speaker": "Decembre",
                                    "text": "Cem Cupons! O que acha?"
                                },
                                {
                                    "id": "740650115",
                                    "speaker": "Paimon",
                                    "text": "Cem!?"
                                },
                                {
                                    "id": "740650116",
                                    "speaker": "Decembre",
                                    "text": "Uhum, vejo que você está comovida pela minha generosidade.",
                                    "choices": [
                                        {
                                            "id": "740650117",
                                            "text": "Isso não é suficiente nem para comprar uma rolha.",
                                            "response": [
                                                {
                                                    "id": "740650118",
                                                    "speaker": "Paimon",
                                                    "text": "É! Paimon não consegue acreditar que você teve a ousadia de fazer essa oferta!"
                                                },
                                                {
                                                    "id": "740650121",
                                                    "speaker": "Decembre",
                                                    "text": "Não estou sendo generoso suficiente? Vocês jovens são tão... vocês não sabem o que é bom para vocês!"
                                                },
                                                {
                                                    "id": "740650122",
                                                    "speaker": "Decembre",
                                                    "text": "Vocês deveriam saber, existem muitas pessoas pobres que adorariam um trabalho fácil e lucrativo como esse..."
                                                },
                                                {
                                                    "id": "740650123",
                                                    "speaker": "Maupoil",
                                                    "text": "Decembre, sua fraude escorregadia, eu finalmente te peguei! Na última vez que eu te vi aqui na Sala do Correio, você estava fazendo novatos aceitarem comissões por uma fração do valor real..."
                                                },
                                                {
                                                    "id": "740650124",
                                                    "speaker": "Maupoil",
                                                    "text": "#{NICKNAME} e Paimon? Vocês não caíram nas mentiras dele, caíram?",
                                                    "choices": [
                                                        {
                                                            "id": "740650125",
                                                            "text": "#Estou devastad{M#o}{F#a}... Já fomos engand{M#os}{F#as} uma vez!",
                                                            "response": [
                                                                {
                                                                    "id": "740650126",
                                                                    "speaker": "Maupoil",
                                                                    "text": "*Suspiro* Então cheguei tarde demais."
                                                                },
                                                                {
                                                                    "id": "740650130",
                                                                    "speaker": "Maupoil",
                                                                    "text": "Enfim, não acredite em uma palavra que ele disser. Ele vai atrás de iniciantes ou qualquer um que não conheça as regras para aplicar um golpe. Já tem uma lista longa de vítimas."
                                                                },
                                                                {
                                                                    "id": "740650131",
                                                                    "speaker": "Decembre",
                                                                    "text": "Minha nossa, aplicar golpe?! Você faz parecer tão ruim. Tem alguma diferença entre nós? Vocês guardas não usam Cupons para fazer pessoas fazerem trabalhos diversos para vocês também?"
                                                                },
                                                                {
                                                                    "id": "740650132",
                                                                    "speaker": "Maupoil",
                                                                    "text": "Não ficamos com uma parte do pagamento deles."
                                                                },
                                                                {
                                                                    "id": "740650133",
                                                                    "speaker": "Decembre",
                                                                    "text": "O que você está insinuando? Não me difame sem nenhuma prova!"
                                                                },
                                                                {
                                                                    "id": "740650134",
                                                                    "speaker": "Maupoil",
                                                                    "text": "Oh, você quer ver provas? Então vamos lá. A solitária é quieta e espaçosa, é perfeita para você procurar por todas as provas que quiser. Sinceramente, eu ainda tenho problemas para lidar no Poço da Mina de Geodes depois disso..."
                                                                },
                                                                {
                                                                    "id": "740650135",
                                                                    "speaker": "Maupoil",
                                                                    "text": "#Oh, {NICKNAME} e Paimon. Se possível, poderiam me ajudar..."
                                                                },
                                                                {
                                                                    "id": "740650136",
                                                                    "speaker": "Paimon",
                                                                    "text": "Ei, não é como se a gente tivesse todo tempo do mundo!"
                                                                },
                                                                {
                                                                    "id": "740650137",
                                                                    "speaker": "Player",
                                                                    "text": "Deve pagar muito bem, então farei."
                                                                },
                                                                {
                                                                    "id": "740650138",
                                                                    "speaker": "Paimon",
                                                                    "text": "Ei!"
                                                                },
                                                                {
                                                                    "id": "740650139",
                                                                    "speaker": "Maupoil",
                                                                    "text": "Haha! O pagamento será feito de acordo com as regulamentações, é claro. Tenho certeza que você conhece o padrão e você sabe que não tentarei te enganar."
                                                                },
                                                                {
                                                                    "id": "740650140",
                                                                    "speaker": "Maupoil",
                                                                    "text": "Enfim, algumas Aberrações Primordiais foram vistas no Poço da Mina de Geodes... elas podem se representar ameaças se não forem contidas, então vocês precisam lidar com isso o mais rápido possível."
                                                                },
                                                                {
                                                                    "id": "740650141",
                                                                    "speaker": "Maupoil",
                                                                    "text": "Levarei esse sujeito para o confinamento solitário primeiro. Levar ele para os meus colegas levará um tempo... me encontrarei com vocês assim que eu terminar."
                                                                },
                                                                {
                                                                    "id": "740650142",
                                                                    "speaker": "Paimon",
                                                                    "text": "Muito bem, mas não leve muito tempo."
                                                                },
                                                                {
                                                                    "id": "740650143",
                                                                    "speaker": "Maupoil",
                                                                    "text": "Farei o meu melhor. Mas a papelada... não é algo que eu posso apressar. Deixarei isso com vocês."
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "740650127",
                                                            "text": "Mas não dessa vez.",
                                                            "response": [
                                                                {
                                                                    "id": "740650128",
                                                                    "speaker": "Maupoil",
                                                                    "text": "Dessa vez?"
                                                                },
                                                                {
                                                                    "id": "740650129",
                                                                    "speaker": "Paimon",
                                                                    "text": "Hmm... Coisas aconteceram antes disso..."
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "740650119",
                                            "text": "Te pagarei 100, você trabalha e eu lucrarei.",
                                            "response": [
                                                {
                                                    "id": "740650120",
                                                    "speaker": "Paimon",
                                                    "text": "Uau! É isso que você está planejando!?"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "740650103",
                            "text": "Tenho um mau pressentimento quanto a isso..."
                        }
                    ]
                }
            ]
        },
        {
            "id": "7406502",
            "objective": "Derrote as Aberrações Primordiais que estão vagando pelo Poço da Mina de Geodes",
            "dialogues": []
        },
        {
            "id": "7406503",
            "objective": "Reporte para Maupoil",
            "dialogues": [
                {
                    "id": "740650301",
                    "speaker": "Paimon",
                    "text": "Você só está chegando agora? Mas nós já espantamos todas as Aberrações Primordiais."
                },
                {
                    "id": "740650302",
                    "speaker": "Maupoil",
                    "text": "Então, finalmente aconteceu comigo."
                },
                {
                    "id": "740650303",
                    "speaker": "Paimon",
                    "text": "O que finalmente aconteceu?"
                },
                {
                    "id": "740650304",
                    "speaker": "Maupoil",
                    "text": "Chegando ao local e descobrindo que todo trabalho foi feito por outra pessoa, é claro! Quanto a mim? Não há nada para eu fazer."
                },
                {
                    "id": "740650305",
                    "speaker": "Maupoil",
                    "text": "Isso é para você. Muito obrigado! Eu certamente terei uma boa noite de sono essa noite!"
                }
            ]
        }
    ]
}