            "dialogues": [
                {
                    "id": "745300201",
                    "speaker": "Player",
                    "text": "Vamos continuar com a sessão de fotos!"
                }
            ]
        },
        {
            "id": "7453003",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "745300301",
                    "speaker": "Player",
                    "text": "Me dê um momento para pensar."
                }
            ]
        },
        {
            "id": "7453004",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "745300401",
                    "speaker": "Kachina",
                    "text": "Ah, você voltou!",
                    "choices": [
                        {
                            "id": "745300402",
                            "text": "Como você está animada, Kachina.",
                            "response": [
                                {
                                    "id": "745300404",
                                    "speaker": "Kachina",
                                    "text": "Hehe, eu encontrei uns minérios legais durante essa escavação!"
                                },
                                {
                                    "id": "745300405",
                                    "speaker": "Kachina",
                                    "text": "Se forem polidos adequadamente, eles podem virar uma gema gigante brilhante!"
                                },
                                {
                                    "id": "745300406",
                                    "speaker": "Player",
                                    "text": "Que legal!"
                                },
                                {
                                    "id": "745300407",
                                    "speaker": "Kachina",
                                    "text": "Né? Para falar a verdade, a mineração não tinha ido bem até agora, e eu estava quase voltando para casa de mãos abanando."
                                },
                                {
                                    "id": "745300408",
                                    "speaker": "Kachina",
                                    "text": "Mas eu pensei que devia insistir por mais um tempo. Por isso insisti mais um pouco, e depois mais um pouquinho..."
                                },
                                {
                                    "id": "745300409",
                                    "speaker": "Kachina",
                                    "text": "Não sei quantas vezes repeti isso, mas consegui no final!"
                                },
                                {
                                    "id": "745300410",
                                    "speaker": "Kachina",
                                    "text": "Eu só percebi que o sol estava se pondo quando saí... se não tomasse cuidado, teria passado o dia cavando.",
                                    "choices": [
                                        {
                                            "id": "745300411",
                                            "text": "Como esperado de você, Kachina.",
                                            "response": [
                                                {
                                                    "id": "745300413",
                                                    "speaker": "Kachina",
                                                    "text": "Mesmo? Eu... eu... eu tenho vergonha de aparecer na frente de câmeras... eu não sei se isso vai sair bem..."
                                                },
                                                {
                                                    "id": "745300414",
                                                    "speaker": "Kachina",
                                                    "text": "Mas, eu vou dar meu melhor!",
                                                    "choices": [
                                                        {
                                                            "id": "745300415",
                                                            "text": "Você já está dando seu melhor!",
                                                            "response": [
                                                                {
                                                                    "id": "745300417",
                                                                    "speaker": "Kachina",
                                                                    "text": "Certo! Vou deixar isso com você então!"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "745300416",
                                                            "text": "Você é ótima do jeito que é."
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "745300412",
                                            "text": "Que tal tirar uma foto sua nesse momento de glória?"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "745300403",
                            "text": "Algo bom aconteceu?"
                        }
                    ]
                }
            ]
        }
    ]
