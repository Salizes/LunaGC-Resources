    "talks": [
        {
            "id": "7509402",
            "objective": "Investigue a sala secreta",
            "dialogues": [
                {
                    "id": "751260601",
                    "speaker": "Paimon",
                    "text": "Pensar que essas coisas aconteceram... Milchi, e a pessoa que deixou essas anotações... Todos foram tão corajosos..."
                },
                {
                    "id": "751260602",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "Rawr!"
                },
                {
                    "id": "751260603",
                    "speaker": "Paimon",
                    "text": "Isso é... Isso é o ovo de Sauriano adormecido mencionado naquelas notas!"
                },
                {
                    "id": "751260604",
                    "speaker": "Paimon",
                    "text": "#Você está tentando dizer que deveríamos usar a incubadora para chocá-lo, {REALNAME[ID(2)|SHOWHOST(true)]}?"
                },
                {
                    "id": "751260605",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "Rawr! Rawr!"
                },
                {
                    "id": "751260606",
                    "speaker": "Paimon",
                    "text": "Hmm, realmente parece estar em bom estado, e tem um manual para a incubadora. Vamos fazer uma tentativa!",
                    "choices": [
                        {
                            "id": "751260607",
                            "text": "Sem ideia se vai funcionar, mas podemos tentar.",
                            "response": [
                                {
                                    "id": "751260609",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "Rawr!"
                                }
                            ]
                        },
                        {
                            "id": "751260608",
                            "text": "Legal, estamos prestes a conseguir um novo amigo para nosso amiguinho!"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7509405",
            "objective": "Investigue a sala secreta",
            "dialogues": []
        },
        {
            "id": "7509404",
            "objective": "Investigue a sala secreta",
            "dialogues": []
        },
        {
            "id": "7509406",
            "objective": "Ative a incubadora",
            "dialogues": [
                {
                    "id": "750940601",
                    "speaker": "Paimon",
                    "text": "Ufa... Isso assustou Paimon! Os monstros atacaram do nada. Por sorte, Paimon é super forte!",
                    "choices": [
                        {
                            "id": "750940602",
                            "text": "Então, contarei com a Paimon da próxima vez.",
                            "response": [
                                {
                                    "id": "750940603",
                                    "speaker": "Paimon",
                                    "text": "Hã? Não, não, não, você não pode contar com a Paimon! Paimon não vai lutar contra esses monstros horríveis de novo!"
                                },
                                {
                                    "id": "750940606",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "Rawr! Rawr!"
                                },
                                {
                                    "id": "750940607",
                                    "speaker": "Paimon",
                                    "text": "#{NICKNAME}, o pequenino está ficando inquieto. Vamos apenas encontrar uma forma de chocar o ovo primeiro!"
                                },
                                {
                                    "id": "750940608",
                                    "speaker": "Player",
                                    "text": "Ativar a incubadora."
                                },
                                {
                                    "id": "750940609",
                                    "speaker": "Black Screen",
                                    "text": "A incubadora voltou a funcionar novamente...\\nTudo que vocês fazem é esperar...\\nHoras se passaram, mas nada aconteceu com o ovo de dragão. Nada mudou..."
                                },
                                {
                                    "id": "750940610",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "Err... Err?"
                                },
                                {
                                    "id": "750940611",
                                    "speaker": "Paimon",
                                    "text": "Estranho. Não parece ter acontecido nada. Talvez fizemos algo errado? Vamos tentar de novo!",
                                    "choices": [
                                        {
                                            "id": "750940612",
                                            "text": "Tentar de novo...",
                                            "response": [
                                                {
                                                    "id": "750940613",
                                                    "speaker": "Black Screen",
                                                    "text": "Você reinicia a incubadora conforme as instruções...\\nMas assim como a tentativa anterior, nada aconteceu com o ovo de dragão..."
                                                },
                                                {
                                                    "id": "750940614",
                                                    "speaker": "Paimon",
                                                    "text": "Aw... Por quanto tempo temos que esperar, os olhos de Paimon já estão começando a fechar... A cabeça de Paimon está tonta, e o estômago de Paimon também está faminto..."
                                                },
                                                {
                                                    "id": "750940615",
                                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                                    "text": "Aww... Gurr..."
                                                },
                                                {
                                                    "id": "750940616",
                                                    "speaker": "Paimon",
                                                    "text": "Hã!? O quê!? Espera! O ovo se moveu!",
                                                    "choices": [
                                                        {
                                                            "id": "750940617",
                                                            "text": "Que tal esperarmos mais alguns minutinhos...?",
                                                            "response": [
                                                                {
                                                                    "id": "750940618",
                                                                    "speaker": "Black Screen",
                                                                    "text": "Após uma longa espera...\\nO ovo de dragão continuou sem mudanças, sem reações e nem sinais de chocar."
                                                                },
                                                                {
                                                                    "id": "750940619",
                                                                    "speaker": "Paimon",
                                                                    "text": "Ainda sem reação... Será que a incubadora tá quebrada? Mas as luzes estão acesas! Talvez o problema seja o ovo?"
                                                                },
                                                                {
                                                                    "id": "750940620",
                                                                    "speaker": "Paimon",
                                                                    "text": "...Hmm, esperar não parece ajudar... Talvez a gente devesse levar o ovo conosco?",
                                                                    "choices": [
                                                                        {
                                                                            "id": "750940621",
                                                                            "text": "Não importa quão faminta você fique, nem pense em comer aquele ovo de dragão...",
                                                                            "response": [
                                                                                {
                                                                                    "id": "750940622",
                                                                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                                                                    "text": "Uaaah! Uaah!"
                                                                                },
                                                                                {
                                                                                    "id": "750940623",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "#Claro que Paimon não ia comer! Não dê nenhuma ideia esquisita a {REALNAME[ID(2)|SHOWHOST(true)]}!"
                                                                                },
                                                                                {
                                                                                    "id": "750940626",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "Pequenino, Paimon quis dizer... se o problema está mesmo no ovo, então talvez nunca..."
                                                                                },
                                                                                {
                                                                                    "id": "750940634",
                                                                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                                                                    "text": "Aw..."
                                                                                },
                                                                                {
                                                                                    "id": "750940635",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "#Não fica triste, {REALNAME[ID(2)|SHOWHOST(true)]}. Não tem nada que a gente possa fazer...",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "750940636",
                                                                                            "text": "Talvez o ambiente não seja adequado...",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "750940638",
                                                                                                    "speaker": "Paimon",
                                                                                                    "text": "Tem razão! Talvez o ovo não esteja nascendo porque ainda acha que Natlan é a mesma de antes e não serve para ser a casa dele!"
                                                                                                },
                                                                                                {
                                                                                                    "id": "750940639",
                                                                                                    "speaker": "Paimon",
                                                                                                    "text": "Afinal, está escondido aqui dentro por tanto tempo, não consegue saber como Natlan é um lugar maravilhoso!"
                                                                                                },
                                                                                                {
                                                                                                    "id": "750940640",
                                                                                                    "speaker": "Paimon",
                                                                                                    "text": "Então, vamos levar ele de volta e cuidar bem dele! Todo dia vamos contar histórias das belas paisagens, aventuras emocionantes e todas as pessoas maravilhosas que conhecemos!"
                                                                                                },
                                                                                                {
                                                                                                    "id": "750940641",
                                                                                                    "speaker": "Paimon",
                                                                                                    "text": "Resumindo, vamos explicar como Natlan é incrível agora! Quando estiver intrigado, com certeza vai nascer sozinho!"
                                                                                                },
                                                                                                {
                                                                                                    "id": "750940642",
                                                                                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                                                                                    "text": "...Rawr."
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "750940637",
                                                                                            "text": "Ou talvez... o ovo ache que não seja a hora certa ainda..."
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "750940624",
                                                                            "text": "#{REALNAME[ID(2)|SHOWHOST(true)]}, o que você acha?",
                                                                            "response": [
                                                                                {
                                                                                    "id": "750940625",
                                                                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                                                                    "text": "Hmm... Hmm?"
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "750940627",
                                                            "text": "Não é nada assim.",
                                                            "response": [
                                                                {
                                                                    "id": "750940628",
                                                                    "speaker": "Paimon",
                                                                    "text": "#Hã?! Mas... ainda agora... Paimon tava imaginando as coisas? Não, não pode ser. Você viu, {REALNAME[ID(2)|SHOWHOST(true)]}?"
                                                                },
                                                                {
                                                                    "id": "750940629",
                                                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                                                    "text": "Hmm... Hmm?"
                                                                },
                                                                {
                                                                    "id": "750940630",
                                                                    "speaker": "Paimon",
                                                                    "text": "#Ah... O Pequenino não viu também? Foi só imaginação de Paimon mesmo? Então, o que a gente faz, {NICKNAME}? Vamos só esperar?"
                                                                },
                                                                {
                                                                    "id": "750940631",
                                                                    "speaker": "Paimon",
                                                                    "text": "Ou... será que o problema poderia mesmo ser com o ovo? M-mas, se esse for o caso, isso quer dizer que nunca vai nascer?"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "750940632",
                                            "text": "O problema deve ser o ovo.",
                                            "response": [
                                                {
                                                    "id": "750940633",
                                                    "speaker": "Paimon",
                                                    "text": "Hã? Então... quer dizer que nunca vai nascer?"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "750940604",
                            "text": "Hnf, não foi nada de mais.",
                            "response": [
                                {
                                    "id": "750940605",
                                    "speaker": "Paimon",
                                    "text": "Exatamente! Com aquela aparência assustadora, Paimon achou que era algum tipo de monstro super poderoso! Que desapontante. Os ataques deles nem eram tão poderosos quanto o do pequenino!"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
