            "dialogues": [
                {
                    "id": "4260101",
                    "speaker": "Paimon",
                    "text": "Descanse um pouco. Qual é o seu plano?",
                    "choices": [
                        {
                            "id": "4260102",
                            "text": "Estava pensando em fazer uma missão.",
                            "response": [
                                {
                                    "id": "4260103",
                                    "speaker": "Paimon",
                                    "text": "Isso é fácil! Apenas clique na marca de exclamação no canto superior esquerdo da tela e você poderá ver as missões que você aceitou até agora."
                                },
                                {
                                    "id": "4260104",
                                    "speaker": "Paimon",
                                    "text": "Algumas missões são muito difíceis e algumas delas você não poderá fazer até que atinja o nível requerido."
                                },
                                {
                                    "id": "4260117",
                                    "speaker": "Paimon",
                                    "text": "Mais alguma coisa?",
                                    "choices": [
                                        {
                                            "id": "4260102",
                                            "text": "Estava pensando em fazer uma missão."
                                        },
                                        {
                                            "id": "4260105",
                                            "text": "Talvez você devesse dar mais uma olhada ao redor.",
                                            "response": [
                                                {
                                                    "id": "4260106",
                                                    "speaker": "Paimon",
                                                    "text": "Algumas áreas são muito mais poderosas que outras."
                                                },
                                                {
                                                    "id": "4260107",
                                                    "speaker": "Paimon",
                                                    "text": "Você deve treinar em algumas áreas mais fáceis primeiro para que não façam picadinho de você."
                                                },
                                                {
                                                    "id": "4260108",
                                                    "speaker": "Paimon",
                                                    "text": "Alfry da Guilda de Aventureiros conhece Teyvat na palma de sua mão."
                                                },
                                                {
                                                    "id": "4260109",
                                                    "speaker": "Paimon",
                                                    "text": "Ela vive no centro de Mondstadt, não muito longe do portão. Você devia perguntá-la quais áreas são mais adequadas para você."
                                                }
                                            ]
                                        },
                                        {
                                            "id": "4260110",
                                            "text": "Eu acho que preciso ficar mais forte.",
                                            "response": [
                                                {
                                                    "id": "4260111",
                                                    "speaker": "Paimon",
                                                    "text": "Bem, você não conseguirá ficar mais forte sem armas ou artefatos raros."
                                                },
                                                {
                                                    "id": "4260112",
                                                    "speaker": "Paimon",
                                                    "text": "Eu ouvi falar muito das masmorras, mas elas são locais perigosos. Você provavelmente pode se machucar."
                                                },
                                                {
                                                    "id": "4260113",
                                                    "speaker": "Paimon",
                                                    "text": "Mas... se você não tiver coragem para conquistá-los, você pode comprar aqui em Mondstadt."
                                                },
                                                {
                                                    "id": "4260114",
                                                    "speaker": "Paimon",
                                                    "text": "As Armas e os Artefatos podem ser fortalecidas ou avançadas."
                                                },
                                                {
                                                    "id": "4260115",
                                                    "speaker": "Paimon",
                                                    "text": "#Mas você terá que descobrir o resto sozinh{F#a}{M#o}."
                                                },
                                                {
                                                    "id": "4260116",
                                                    "speaker": "Paimon",
                                                    "text": "Ah sim, suponho que o seu próprio nível também seja importante."
                                                }
                                            ]
                                        },
                                        {
                                            "id": "4260118",
                                            "text": "Eu não tenho certeza ainda... Eu acho que tenho de pensar um pouco mais.",
                                            "response": [
                                                {
                                                    "id": "4260119",
                                                    "speaker": "Paimon",
                                                    "text": "Está certo."
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
