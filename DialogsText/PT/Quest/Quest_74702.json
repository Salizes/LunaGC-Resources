    "talks": [
        {
            "id": "7470201",
            "objective": "Fale com Sandrone",
            "dialogues": [
                {
                    "id": "747020101",
                    "speaker": "Marionette",
                    "text": "Ah, vocês têm trazido tantos peixes ultimamente. O aquário está começando a parecer um verdadeiro habitat oceânico."
                },
                {
                    "id": "747020102",
                    "speaker": "Paimon",
                    "text": "#Hehe, a gente já é praticamente pescador{M#es}{F#as} profissionais!"
                },
                {
                    "id": "747020103",
                    "speaker": "Marionette",
                    "text": "Vocês parecem ter muito orgulho do seu trabalho."
                },
                {
                    "id": "747020104",
                    "speaker": "Paimon",
                    "text": "Pode apostar! Mas por trás da sensação de realização, tem mais alguma coisa... algo tipo...",
                    "choices": [
                        {
                            "id": "747020105",
                            "text": "Arrependimento?",
                            "response": [
                                {
                                    "id": "747020107",
                                    "speaker": "Paimon",
                                    "text": "É isso! É exatamente assim que Paimon tá se sentindo."
                                },
                                {
                                    "id": "747020108",
                                    "speaker": "Marionette",
                                    "text": "Por que isso?"
                                },
                                {
                                    "id": "747020109",
                                    "speaker": "Paimon",
                                    "text": "Paimon não tem certeza... É só que parece que tá faltando alguma coisa...",
                                    "choices": [
                                        {
                                            "id": "747020110",
                                            "text": "Talvez um restaurante?",
                                            "response": [
                                                {
                                                    "id": "747020111",
                                                    "speaker": "Paimon",
                                                    "text": "Ei! Não fale uma coisa dessas! Como alguém poderia ter coragem de comer peixinhos tão lindos!?"
                                                },
                                                {
                                                    "id": "747020114",
                                                    "speaker": "Paimon",
                                                    "text": "Estamos sem visitantes para vir e admirar nosso trabalho incrível!"
                                                },
                                                {
                                                    "id": "747020115",
                                                    "speaker": "Marionette",
                                                    "text": "Você está querendo dizer... que quer abrir o aquário para visitantes?"
                                                },
                                                {
                                                    "id": "747020116",
                                                    "speaker": "Paimon",
                                                    "text": "Isso não seria bom?",
                                                    "choices": [
                                                        {
                                                            "id": "747020117",
                                                            "text": "Tá preocupada que fique barulhento demais?",
                                                            "response": [
                                                                {
                                                                    "id": "747020119",
                                                                    "speaker": "Paimon",
                                                                    "text": "Se é esse o caso, pode deixar tudo com a gente! Nós cuidamos da divulgação e de todo o trabalho cotidiano, você só precisa focar no seu próprio trabalho."
                                                                },
                                                                {
                                                                    "id": "747020120",
                                                                    "speaker": "Marionette",
                                                                    "text": "Se é isso que vocês querem..."
                                                                },
                                                                {
                                                                    "id": "747020121",
                                                                    "speaker": "Player",
                                                                    "text": "Podemos dividir os ganhos 30/70!"
                                                                },
                                                                {
                                                                    "id": "747020122",
                                                                    "speaker": "Paimon",
                                                                    "text": "Hã...? A gente só fica com 70%?"
                                                                },
                                                                {
                                                                    "id": "747020123",
                                                                    "speaker": "Player",
                                                                    "text": "Não, Sandrone fica com 70%."
                                                                },
                                                                {
                                                                    "id": "747020124",
                                                                    "speaker": "Paimon",
                                                                    "text": "Ah, certo, claro... Foi Sandrone que alugou esse barco, né..."
                                                                },
                                                                {
                                                                    "id": "747020125",
                                                                    "speaker": "Marionette",
                                                                    "text": "Ugh, vocês tão me fazendo parecer algum tipo de senhoria tirana. Vocês tão fazendo o trabalho, então deveriam ficar com a maior parte. Eu não sou mão de vaca que nem Pantalone."
                                                                },
                                                                {
                                                                    "id": "747020126",
                                                                    "speaker": "Paimon",
                                                                    "text": "Então isso significa... que você tá nos dando sua aprovação?"
                                                                },
                                                                {
                                                                    "id": "747020127",
                                                                    "speaker": "Marionette",
                                                                    "text": "Claro, vocês têm minha permissão. Desde que não atrapalhe minha pesquisa."
                                                                },
                                                                {
                                                                    "id": "747020128",
                                                                    "speaker": "Paimon",
                                                                    "text": "Uhuuul! O Aquário da Diversão Glub-Glub Wingalet tá oficialmente aberto!"
                                                                },
                                                                {
                                                                    "id": "747020129",
                                                                    "speaker": "Marionette",
                                                                    "text": "*Suspiro* Claro que você já pensou em um nome..."
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "747020118",
                                                            "text": "Tá preocupada que cause problemas demais?"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "747020112",
                                            "text": "Talvez visitantes?",
                                            "response": [
                                                {
                                                    "id": "747020113",
                                                    "speaker": "Paimon",
                                                    "text": "Ah! É isso!"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "747020106",
                            "text": "Solidão?"
                        }
                    ]
                }
            ]
        }
    ]
