    "talks": [
        {
            "id": "7319701",
            "objective": "",
            "dialogues": [
                {
                    "id": "731970101",
                    "speaker": "Tabela de Provérbios do Bimarstan",
                    "text": "Aqui está a tabela de provérbios que reúne os provérbios dos pesquisadores anteriores da Academia. Somente seguindo os passos dos pioneiros podemos alcançar a luz da sabedoria."
                },
                {
                    "id": "731970102",
                    "speaker": "Tabela de Provérbios do Bimarstan",
                    "text": "Como diz o ditado, \"nada de novo sob o sol.\""
                }
            ]
        },
        {
            "id": "7319702",
            "objective": "",
            "dialogues": [
                {
                    "id": "731970201",
                    "speaker": "Pursina",
                    "text": "\"Um corpo saudável faz uma alma saudável, e uma alma saudável garante um corpo saudável.\""
                }
            ]
        },
        {
            "id": "7319703",
            "objective": "",
            "dialogues": [
                {
                    "id": "731970301",
                    "speaker": "Suhrawardi",
                    "text": "\"Os pesquisadores são os guardiões do corpo e da alma.\""
                }
            ]
        },
        {
            "id": "7319704",
            "objective": "",
            "dialogues": [
                {
                    "id": "731970401",
                    "speaker": "Albiruni",
                    "text": "\"Busque a sabedoria, não o conhecimento.\""
                }
            ]
        },
        {
            "id": "7319705",
            "objective": "",
            "dialogues": [
                {
                    "id": "731970501",
                    "speaker": "Hipakretisa",
                    "text": "\"Um médico que não sabe nada de astrologia não tem o direito de se chamar médico.\""
                }
            ]
        },
        {
            "id": "7319706",
            "objective": "",
            "dialogues": [
                {
                    "id": "731970601",
                    "speaker": "Alva Nikolay",
                    "text": "\"A solidão é o guia para novos conhecimentos.\""
                }
            ]
        },
        {
            "id": "7319707",
            "objective": "",
            "dialogues": [
                {
                    "id": "731970701",
                    "speaker": "Masudi",
                    "text": "\"A verdade do mundo está no tabuleiro de xadrez, e a beleza das estrelas dança com as peças.\""
                }
            ]
        },
        {
            "id": "7319708",
            "objective": "",
            "dialogues": [
                {
                    "id": "731970801",
                    "speaker": "Ayesha",
                    "text": "\"Sabemos mais do que podemos dizer.\""
                }
            ]
        },
        {
            "id": "7319709",
            "objective": "",
            "dialogues": [
                {
                    "id": "731970901",
                    "speaker": "Fadhlan",
                    "text": "\"Mesmo os sete Arcontes que vivem lado a lado no mundo mortal, às vezes seus caminhos divergem e até vão um contra o outro.\""
                }
            ]
        },
        {
            "id": "7319710",
            "objective": "",
            "dialogues": [
                {
                    "id": "731971001",
                    "speaker": "Pursina",
                    "text": "\"Mesmo o mais fraco dos jovens Dragartos tem potencial para se tornar um dragão.\""
                }
            ]
        },
        {
            "id": "7319711",
            "objective": "",
            "dialogues": [
                {
                    "id": "731971101",
                    "speaker": "Iskandar",
                    "text": "\"Aquele que confia na espada será ferido pela espada.\""
                }
            ]
        },
        {
            "id": "7319712",
            "objective": "",
            "dialogues": [
                {
                    "id": "731971201",
                    "speaker": "Vistahm",
                    "text": "\"Os fatos falam mais alto que as palavras.\""
                }
            ]
        },
        {
            "id": "7319713",
            "objective": "",
            "dialogues": [
                {
                    "id": "731971301",
                    "speaker": "Pir Nagar",
                    "text": "\"Não há cura para o amor...\""
                }
            ]
        },
        {
            "id": "7319714",
            "objective": "",
            "dialogues": [
                {
                    "id": "731971401",
                    "speaker": "Pir Kavikavus",
                    "text": "\"Foi provado que o Akasha não tem sinal na Montanha Devantaka.\""
                }
            ]
        },
        {
            "id": "7319715",
            "objective": "",
            "dialogues": [
                {
                    "id": "731971501",
                    "speaker": "Mahitab",
                    "text": "\"Os Animais de Carga não choram quando os humanos suspiram.\""
                }
            ]
        },
        {
            "id": "7319716",
            "objective": "",
            "dialogues": [
                {
                    "id": "731971601",
                    "speaker": "Cyrus",
                    "text": "\"Nada neste mundo é para sempre.\""
                }
            ]
        },
        {
            "id": "7319717",
            "objective": "",
            "dialogues": [
                {
                    "id": "731971701",
                    "speaker": "Imhotep",
                    "text": "\"Eu gostaria de ir para o paraíso dos gatos quando eu deixar o mundo...\""
                }
            ]
        }
    ]
}