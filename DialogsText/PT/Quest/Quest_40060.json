        "total_dialogue_lines": 80,
        "total_speaker_counts": {
            "Paimon": 13,
            "Player": 14,
            "Tsuyuko": 53
        }
    },
    "talks": [
        {
            "id": "4006001",
            "objective": "Fale com Tsuyuko",
            "dialogues": [
                {
                    "id": "721430101",
                    "speaker": "Tsuyuko",
                    "text": "#Olá, convidad{M#o}{F#a}s de Terras Distantes. Meu nome é Tsuyuko e sou uma Sacerdotisa do Santuário de Sangonomiya. Você está aqui para ajudar?"
                },
                {
                    "id": "721430102",
                    "speaker": "Player",
                    "text": "Ajudar...?"
                },
                {
                    "id": "721430103",
                    "speaker": "Paimon",
                    "text": "Como pode alguém já chegar pedindo favores, a gente mal se conheceu!"
                },
                {
                    "id": "721430104",
                    "speaker": "Tsuyuko",
                    "text": "Haha, peço desculpas por isso..."
                },
                {
                    "id": "721430105",
                    "speaker": "Tsuyuko",
                    "text": "Mas é que eu tinha feito um pedido antes, e de acordo com o rolinho, ajudas aparecerão quando eu precisar."
                },
                {
                    "id": "721430106",
                    "speaker": "Tsuyuko",
                    "text": "#Então est{F#a}{M#e} fidalg{F#a}{M#o} prestativ{F#a}{M#o} deve ter vindo aqui para me ajudar, não é?",
                    "choices": [
                        {
                            "id": "721430107",
                            "text": "Você está inventando isso, não está?",
                            "response": [
                                {
                                    "id": "721430108",
                                    "speaker": "Paimon",
                                    "text": "Bom, seja lá como for, acho que podemos ouvir primeiro o que ela tem a dizer..."
                                },
                                {
                                    "id": "721430111",
                                    "speaker": "Tsuyuko",
                                    "text": "Muito obrigada. Bom, acho que devo começar te explicando desde o começo então."
                                },
                                {
                                    "id": "721430112",
                                    "speaker": "Tsuyuko",
                                    "text": "O profundo poço em frente ao Santuário Sangonomiya é a entrada para Enkanomiya. Diz a lenda também que este foi o lugar onde se originou o povo Watatsumi."
                                },
                                {
                                    "id": "721430113",
                                    "speaker": "Tsuyuko",
                                    "text": "As \"belezas de Watatsumi\" eram muito conhecidas na antiguidade. Sua pele era tão perfeita, que diziam cintilar como estrelas."
                                },
                                {
                                    "id": "721430114",
                                    "speaker": "Tsuyuko",
                                    "text": "Essa lenda se originou também pelo fato dos nossos antepassados em Enkanomiya não sofrerem de nenhum dano na pele causada pela luz solar...",
                                    "choices": [
                                        {
                                            "id": "721430115",
                                            "text": "Cof cof.",
                                            "response": [
                                                {
                                                    "id": "721430117",
                                                    "speaker": "Tsuyuko",
                                                    "text": "Oh, desculpa. Como eu trabalhava antes como guia, fazendo excursões para os viajantes que vinham para a Ilha Watatsumi, eu sem querer me deixei levar..."
                                                },
                                                {
                                                    "id": "721430118",
                                                    "speaker": "Tsuyuko",
                                                    "text": "A fim de comemorar Watatsumi Omikami e nossos ancestrais, trazemos oferendas que deixamos afundarem até Enkanomiya."
                                                },
                                                {
                                                    "id": "721430119",
                                                    "speaker": "Tsuyuko",
                                                    "text": "Diz a história e de acordo com o que está registrado em nossos escritos antigos, os nossos ancestrais se originaram no \"Reino de Byakuya\", onde eles contavam com a escassa luz do Dainichi Mikoshi para sobreviver às afiadas garras do Dragão Herdeiro das Profundezas."
                                                },
                                                {
                                                    "id": "721430120",
                                                    "speaker": "Tsuyuko",
                                                    "text": "Isso foi há alguns milhares de anos, quando Watatsumi Omikami veio e derrotou o Dragão do Oceano e nos levou de volta à terra seca. Seria lá que construiríamos nossa nova casa na Ilha Watatsumi - Sangonomiya."
                                                },
                                                {
                                                    "id": "721430121",
                                                    "speaker": "Tsuyuko",
                                                    "text": "E foi assim que o subaquático Reino de Byakuya passou a ser conhecido como Enkanomiya, em justaposição ao nosso novo lar, Sangonomiya, na superfície da terra."
                                                },
                                                {
                                                    "id": "721430122",
                                                    "speaker": "Tsuyuko",
                                                    "text": "É claro que lendas são apenas lendas, assim como as do povo de Narukami conta sobre os deuses dominados pelo Shogunato..."
                                                },
                                                {
                                                    "id": "721430123",
                                                    "speaker": "Tsuyuko",
                                                    "text": "O tema do sacrifício e da lembrança é uma arma com a qual nos protegemos."
                                                },
                                                {
                                                    "id": "721430124",
                                                    "speaker": "Paimon",
                                                    "text": "Isso é algo que uma Sacerdotisa deveria estar dizendo...?"
                                                },
                                                {
                                                    "id": "721430125",
                                                    "speaker": "Tsuyuko",
                                                    "text": "Claro que como Sacerdotisa, eu não deveria estar dizendo algo assim, mas como ser humano, eu acredito que devemos olhar a história e o folclore de uma forma crítica."
                                                },
                                                {
                                                    "id": "721430126",
                                                    "speaker": "Tsuyuko",
                                                    "text": "Enfim, peço desculpas por ter fugido do assunto de novo... Mas resumindo, o problema do \"Solo Sagrado\" da Ilha Watatsumi tem piorado e muito ultimamente."
                                                },
                                                {
                                                    "id": "721430127",
                                                    "speaker": "Player",
                                                    "text": "\"Solo Sagrado\"... O que é isso?"
                                                },
                                                {
                                                    "id": "721430128",
                                                    "speaker": "Tsuyuko",
                                                    "text": "Assim como a água sempre desce pela encosta, o espírito da Ilha Watatsumi sente constantemente o chamado de Enkanomiya, nas profundezas da água."
                                                },
                                                {
                                                    "id": "721430129",
                                                    "speaker": "Tsuyuko",
                                                    "text": "Como resultado, nosso solo está se clareando lentamente, ou seja, tornando-se um solo sagrado. E, se isto continuar, a Ilha Watatsumi se tornará um dia um deserto tão branco quanto a luz da lua.",
                                                    "choices": [
                                                        {
                                                            "id": "721430130",
                                                            "text": "Isso parece ser assustador...",
                                                            "response": [
                                                                {
                                                                    "id": "721430131",
                                                                    "speaker": "Tsuyuko",
                                                                    "text": "Você acha? Bom, para mim, isso nada mais é do que uma superstição espalhada pelos idosos. Embora contenha partes que fazem sentido, ainda acho que faltam conexões lógicas credíveis nessa teoria toda."
                                                                },
                                                                {
                                                                    "id": "721430133",
                                                                    "speaker": "Tsuyuko",
                                                                    "text": "Conforme a tradição, devemos aproveitar o momento em que as veias espirituais fluem suavemente para quebrar a barreira que bloqueia a conexão entre Enkanomiya e Sangonomiya, porém esse evento só ocorre uma vez em séculos..."
                                                                },
                                                                {
                                                                    "id": "721430134",
                                                                    "speaker": "Tsuyuko",
                                                                    "text": "Ou seja, precisaremos mergulhar até Enkanomiya e recuperar o Galho de Coral de Jade deixado pelo Omikami, usado para suprimir o Dragão Herdeiro das Profundezas."
                                                                },
                                                                {
                                                                    "id": "721430135",
                                                                    "speaker": "Tsuyuko",
                                                                    "text": "Para então utilizar o Galho de Coral de Jade para realizar a Cerimônia de Oferendas de Watatsumi, fazendo com que o \"espírito\" submerso retorne, impedindo assim a erosão do Solo Sagrado."
                                                                },
                                                                {
                                                                    "id": "721430136",
                                                                    "speaker": "Player",
                                                                    "text": "Espere, mas se a gente for tirar a coisa que está suprimindo o Dragão Herdeiro das Profundezas..."
                                                                },
                                                                {
                                                                    "id": "721430137",
                                                                    "speaker": "Tsuyuko",
                                                                    "text": "Esta é uma observação perspicaz."
                                                                },
                                                                {
                                                                    "id": "721430138",
                                                                    "speaker": "Tsuyuko",
                                                                    "text": "Temos muitos Galhos de Coral de Jade que podem ser usados para esta supressão, mas se isto continuar, o Dragão do Oceano pode um dia romper a barreira e invadir Watatsumi na superfície."
                                                                },
                                                                {
                                                                    "id": "721430139",
                                                                    "speaker": "Tsuyuko",
                                                                    "text": "Então, gostaria de perguntar se você poderia...",
                                                                    "choices": [
                                                                        {
                                                                            "id": "721430140",
                                                                            "text": "Recuperar o Galho de Coral de Jade?",
                                                                            "response": [
                                                                                {
                                                                                    "id": "721430141",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "#{M#O}{F#A} {NICKNAME} é ótim{M#o}{F#a} em procurar coisas!"
                                                                                },
                                                                                {
                                                                                    "id": "721430144",
                                                                                    "speaker": "Tsuyuko",
                                                                                    "text": "Não exatamente, bom, pelo menos por enquanto..."
                                                                                },
                                                                                {
                                                                                    "id": "721430145",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "Você quer dizer que vai precisar de mais ajuda ainda?"
                                                                                },
                                                                                {
                                                                                    "id": "721430146",
                                                                                    "speaker": "Tsuyuko",
                                                                                    "text": "Hmmm, talvez, mais tarde... Bem, depende, eu acho?"
                                                                                },
                                                                                {
                                                                                    "id": "721430147",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "Depende do quê? Seu próximo rolinho da sorte!?"
                                                                                },
                                                                                {
                                                                                    "id": "721430148",
                                                                                    "speaker": "Tsuyuko",
                                                                                    "text": "*Cof* Bom, se não for de muito incomodo, eu queria que você fosse para até as Rochas Goshou na Ilha Watatsumi."
                                                                                },
                                                                                {
                                                                                    "id": "721430149",
                                                                                    "speaker": "Tsuyuko",
                                                                                    "text": "As Rochas Goshou são cinco selos da barreira que separam Sangonomiya de Enkanomiya. Elas foram criadas pelo clero fundador de Sangonomiya junto com o Omikami."
                                                                                },
                                                                                {
                                                                                    "id": "721430150",
                                                                                    "speaker": "Tsuyuko",
                                                                                    "text": "Se você quiser remover a barreira e entrar em Enkanomiya, você terá que quebrar estes cinco selos."
                                                                                },
                                                                                {
                                                                                    "id": "721430151",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "Parece perigoso..."
                                                                                },
                                                                                {
                                                                                    "id": "721430152",
                                                                                    "speaker": "Tsuyuko",
                                                                                    "text": "De fato, seria muito arriscado quebrar os selos de forma precipitada. Afinal de contas, muitos anos se passaram e realmente ninguém da nossa geração sabe quais são os perigos que se escondem por trás dos selos."
                                                                                },
                                                                                {
                                                                                    "id": "721430153",
                                                                                    "speaker": "Tsuyuko",
                                                                                    "text": "São poucos os registros nos quais vale a pena confiar, e a maioria deles são textos antigos com detalhes incompletos e pouco valor de referência."
                                                                                },
                                                                                {
                                                                                    "id": "721430154",
                                                                                    "speaker": "Tsuyuko",
                                                                                    "text": "Talvez o Dragão Herdeiro das Profundezas esteja só esperando por uma chance de atacar... Ou quem sabe? Pode até haver um monstro mais perigoso ainda do que o Dragão Herdeiro das Profundezas que se infiltrou lá dentro, esperando apenas pela quebra dos selos?"
                                                                                },
                                                                                {
                                                                                    "id": "721430155",
                                                                                    "speaker": "Tsuyuko",
                                                                                    "text": "Ou talvez as ruínas do passado tenham sido enterradas sob corais e esponjas, para nunca mais serem encontradas?"
                                                                                },
                                                                                {
                                                                                    "id": "721430156",
                                                                                    "speaker": "Tsuyuko",
                                                                                    "text": "Ou pior ainda, se isso tudo for na verdade apenas um mito onde não existe nada lá embaixo além de uma caverna vazia com água do mar?"
                                                                                },
                                                                                {
                                                                                    "id": "721430157",
                                                                                    "speaker": "Tsuyuko",
                                                                                    "text": "De qualquer forma, não temos como prever as diferentes possibilidades que nos aguardam sem de fato ir até lá."
                                                                                },
                                                                                {
                                                                                    "id": "721430158",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "Embora você tenha toda a razão, parece que seremos nós que faremos todo o trabalho."
                                                                                },
                                                                                {
                                                                                    "id": "721430159",
                                                                                    "speaker": "Tsuyuko",
                                                                                    "text": "Mas como Enkanomiya está abandonada faz anos, talvez alguns tesouros deixados pelos antepassados ainda estejam lá."
                                                                                },
                                                                                {
                                                                                    "id": "721430160",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "#Tesou- *Cof* {NICKNAME}, Paimon acha que ajudar os locais a resolver seus problemas é causa suficiente para agirmos!"
                                                                                },
                                                                                {
                                                                                    "id": "721430161",
                                                                                    "speaker": "Player",
                                                                                    "text": "...Você sabe como convencer as pessoas, Srta. Tsuyuko."
                                                                                },
                                                                                {
                                                                                    "id": "721430162",
                                                                                    "speaker": "Tsuyuko",
                                                                                    "text": "Você me lisonjeia. Então, vamos direto ao ponto. Há cinco locais nas Rochas Goshou, no caso: \"olho\", \"presa\", \"barbatana\", \"cauda\" e \"coração\"."
                                                                                },
                                                                                {
                                                                                    "id": "721430163",
                                                                                    "speaker": "Tsuyuko",
                                                                                    "text": "O primeiro selo é conhecido como o \"olho\" e fica na <color=#00E1FFFF>ilha a oeste</color>. Veja, está bem ali."
                                                                                },
                                                                                {
                                                                                    "id": "721430164",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "Então por que você não vai você mesma?"
                                                                                },
                                                                                {
                                                                                    "id": "721430165",
                                                                                    "speaker": "Tsuyuko",
                                                                                    "text": "Hehe..."
                                                                                },
                                                                                {
                                                                                    "id": "721430166",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "O que você quer dizer com \"hehe\"!?"
                                                                                },
                                                                                {
                                                                                    "id": "721430167",
                                                                                    "speaker": "Tsuyuko",
                                                                                    "text": "O selo em si já existe há muito tempo, sem falar que o ritual para quebrá-lo também é desconhecido pela maioria das pessoas..."
                                                                                },
                                                                                {
                                                                                    "id": "721430168",
                                                                                    "speaker": "Tsuyuko",
                                                                                    "text": "Além disso, devido à situação atual, fica difícil para a Sacerdotisa Divina arranjar tempo suficiente para realizar uma grande cerimônia que possa quebrar os cinco selos."
                                                                                },
                                                                                {
                                                                                    "id": "721430169",
                                                                                    "speaker": "Tsuyuko",
                                                                                    "text": "#É realmente embaraçoso expor nossos problemas para forasteir{F#as}{M#os}, mas... A única pessoa em quem posso confiar é alguém {F#conhecedora}{M#conhecedor} e com informações, como você."
                                                                                },
                                                                                {
                                                                                    "id": "721430170",
                                                                                    "speaker": "Tsuyuko",
                                                                                    "text": "#Mesmo se errarmos, podemos usar sua identidade como {F#uma forasteira}{M#um forasteiro} para..."
                                                                                },
                                                                                {
                                                                                    "id": "721430171",
                                                                                    "speaker": "Player",
                                                                                    "text": "Assumir a culpa?"
                                                                                },
                                                                                {
                                                                                    "id": "721430172",
                                                                                    "speaker": "Tsuyuko",
                                                                                    "text": "Não, imagina. Eu chamaria isso de um caso em que \"a ignorância absolve a culpa\"."
                                                                                },
                                                                                {
                                                                                    "id": "721430173",
                                                                                    "speaker": "Tsuyuko",
                                                                                    "text": "Se o <color=#00E1FFFF>Santuário de Sangonomiya</color> for usado como base de orientação, então a \"presa\" está localizada no <color=#00E1FFFF>noroeste</color> e a \"barbatana\" está localizada <color=#00E1FFFF>ao norte</color>."
                                                                                },
                                                                                {
                                                                                    "id": "721430174",
                                                                                    "speaker": "Tsuyuko",
                                                                                    "text": "Por último, temos a \"cauda\" no <color=#00E1FFFF>banco de areia ao leste</color>."
                                                                                },
                                                                                {
                                                                                    "id": "721430175",
                                                                                    "speaker": "Tsuyuko",
                                                                                    "text": "Perto de cada um dos quatro selos existe uma placa de pedra com informações inscritas sobre o ritual... Mas depois de tantos anos, elas devem estar provavelmente ilegíveis agora."
                                                                                },
                                                                                {
                                                                                    "id": "721430176",
                                                                                    "speaker": "Tsuyuko",
                                                                                    "text": "E só depois de obter a \"Pérola do Espírito\" dos quatro primeiros selos, que será possível desbloquear o quinto selo - o \"coração\"."
                                                                                },
                                                                                {
                                                                                    "id": "721430177",
                                                                                    "speaker": "Player",
                                                                                    "text": "Parece complicado..."
                                                                                },
                                                                                {
                                                                                    "id": "721430178",
                                                                                    "speaker": "Tsuyuko",
                                                                                    "text": "Não se preocupe. Se você esquecer de algo, procure por mim no Santuário Sangonomiya, para eu te repassar as etapas novamente."
                                                                                },
                                                                                {
                                                                                    "id": "721430179",
                                                                                    "speaker": "Tsuyuko",
                                                                                    "text": "Por último, sei que é falta de educação minha lhe pedir para fazer algo tão importante. Por favor, aceite minhas profundas desculpas por isso."
                                                                                },
                                                                                {
                                                                                    "id": "721430180",
                                                                                    "speaker": "Tsuyuko",
                                                                                    "text": "Mas de qualquer maneira, você sabe o quão importante isso é para a Ilha Watatsumi... O Santuário Sangonomiya ficará muito grato pela sua ajuda."
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "721430142",
                                                                            "text": "Eliminar o Dragão do Oceano?",
                                                                            "response": [
                                                                                {
                                                                                    "id": "721430143",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "#Falou em lutar é com {M#o}{F#a} {NICKNAME} mesmo!"
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "721430132",
                                                            "text": "Então, como podemos resolver esse problema?"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "721430116",
                                            "text": "Quanto ao motivo pelo qual você precisa da nossa ajuda..."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "721430109",
                            "text": "De acordo.",
                            "response": [
                                {
                                    "id": "721430110",
                                    "speaker": "Paimon",
                                    "text": "Que desculpa mais esfarrapada para pedir por ajuda..."
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}