    "talks": [
        {
            "id": "7621302",
            "objective": "",
            "dialogues": [
                {
                    "id": "762130101",
                    "speaker": "Paimon",
                    "text": "Hã? Parece que os livros estão atrapalhando aqui..."
                },
                {
                    "id": "762130102",
                    "speaker": "Congshen",
                    "text": "Está procurando um livro?"
                },
                {
                    "id": "762130103",
                    "speaker": "Paimon",
                    "text": "Hm... Não exatamente. Só estamos um tiquinho, tiquinho curiosos sobre o que tem aí dentro..."
                },
                {
                    "id": "762130104",
                    "speaker": "Player",
                    "text": "Acho que dá para a gente entrar por lá, pelo lado?"
                },
                {
                    "id": "762130105",
                    "speaker": "Congshen",
                    "text": "Vocês não podem entrar aí."
                },
                {
                    "id": "762130106",
                    "speaker": "Congshen",
                    "text": "Eu movo os livros, e movo os livros. Se não fizer isso, ainda não vai estar completo.",
                    "choices": [
                        {
                            "id": "762130107",
                            "text": "Eu não entendi...",
                            "response": [
                                {
                                    "id": "762130108",
                                    "speaker": "Congshen",
                                    "text": "Eu movo os livros."
                                }
                            ]
                        },
                        {
                            "id": "762130109",
                            "text": "E o que você quer dizer com \"mover os livros\"?",
                            "response": [
                                {
                                    "id": "762130110",
                                    "speaker": "Congshen",
                                    "text": "Se os livros não estão aqui, então devem ter sido movidos. Tudo o que eu faço é bater o olho neles."
                                },
                                {
                                    "id": "762130111",
                                    "speaker": "Player",
                                    "text": "Então deixa eu tentar com o Dex."
                                },
                                {
                                    "id": "762130112",
                                    "speaker": "Congshen",
                                    "text": "Vá direto."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7621302",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "762130201",
                    "speaker": "Congshen",
                    "text": "Sonhos, ilusões, bolhas e sombras, por que se esforçar para alcançá-los? Mesmo que você estude os princípios por mil anos, se mantiver a mente completamente imóvel e \"não nascida\", você simplesmente não vai entender.",
                    "choices": [
                        {
                            "id": "762130202",
                            "text": "Então... você está procurando um livro?",
                            "response": [
                                {
                                    "id": "762130203",
                                    "speaker": "Congshen",
                                    "text": "Você já esteve aqui antes?",
                                    "choices": [
                                        {
                                            "id": "762130204",
                                            "text": "Hã?",
                                            "response": [
                                                {
                                                    "id": "762130207",
                                                    "speaker": "Congshen",
                                                    "text": "Então você entende.",
                                                    "choices": [
                                                        {
                                                            "id": "762130208",
                                                            "text": "Entende... entende o quê?",
                                                            "response": [
                                                                {
                                                                    "id": "762130210",
                                                                    "speaker": "Congshen",
                                                                    "text": "Quando precisar dormir, durma. Quando precisar entender, entenda."
                                                                },
                                                                {
                                                                    "id": "762130211",
                                                                    "speaker": "Congshen",
                                                                    "text": "É melhor você voltar agora. Quando o mundo acabar, apenas acompanhe."
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "762130209",
                                                            "text": "E como eu poderia entender isso?"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "762130205",
                                            "text": "Sim."
                                        },
                                        {
                                            "id": "762130206",
                                            "text": "Não."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "762130212",
                            "text": "Eu não entendo uma palavra do que você está dizendo. Adeus.",
                            "response": [
                                {
                                    "id": "762130213",
                                    "speaker": "Congshen",
                                    "text": "Vá em frente."
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}