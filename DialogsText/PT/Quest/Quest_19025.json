            "objective": "Fale com Dalong e Pequena Le",
            "dialogues": [
                {
                    "id": "190250501",
                    "speaker": "Chongyun",
                    "text": "Não pensei que você me encontraria tão facilmente...",
                    "choices": [
                        {
                            "id": "190250502",
                            "text": "É apenas sua primeira vez.",
                            "response": [
                                {
                                    "id": "190250504",
                                    "speaker": "Chongyun",
                                    "text": "Pensei que este seria o lugar perfeito."
                                },
                                {
                                    "id": "190250505",
                                    "speaker": "Chongyun",
                                    "text": "Na verdade, conheço muito bem os métodos para localizar os espíritos malignos e tenho muita experiência em rastrear seus esconderijos."
                                },
                                {
                                    "id": "190250506",
                                    "speaker": "Chongyun",
                                    "text": "Este lugar está empoeirado, tem muitas formas retilíneas e está longe da luz. Os espíritos malignos geralmente preferem lugares assim.",
                                    "choices": [
                                        {
                                            "id": "190250507",
                                            "text": "Você está tentando usar a taumaturgia para brincar de esconde-esconde...",
                                            "response": [
                                                {
                                                    "id": "190250508",
                                                    "speaker": "Chongyun",
                                                    "text": "Sim, acho que minha experiência como exorcista não se aplica aqui."
                                                },
                                                {
                                                    "id": "190250511",
                                                    "speaker": "Chongyun",
                                                    "text": "Como você me encontrou, devo admitir minha derrota."
                                                },
                                                {
                                                    "id": "190250512",
                                                    "speaker": "Chongyun",
                                                    "text": "É um jogo simples, mas muito intrigante quando você começa a jogar.",
                                                    "choices": [
                                                        {
                                                            "id": "190250513",
                                                            "text": "Podemos jogá-lo de novo outro dia.",
                                                            "response": [
                                                                {
                                                                    "id": "190250514",
                                                                    "speaker": "Chongyun",
                                                                    "text": "Claro, poderíamos convidar mais amigos."
                                                                },
                                                                {
                                                                    "id": "190250517",
                                                                    "speaker": "Chongyun",
                                                                    "text": "Vamos lá."
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "190250515",
                                                            "text": "Que bom que você não era o fantasma.",
                                                            "response": [
                                                                {
                                                                    "id": "190250516",
                                                                    "speaker": "Chongyun",
                                                                    "text": "Hehe, tem razão. Eu levaria horas para encontrar alguém."
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "190250509",
                                            "text": "Mas você pode ser facilmente visto aqui.",
                                            "response": [
                                                {
                                                    "id": "190250510",
                                                    "speaker": "Chongyun",
                                                    "text": "Hmm, acho que estava tão nervoso que esqueci a coisa mais importante."
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "190250503",
                            "text": "...Por que você se escondeu aqui?"
                        }
                    ]
                }
            ]
