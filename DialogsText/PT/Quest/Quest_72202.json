    "talks": [
        {
            "id": "7220201",
            "objective": "",
            "dialogues": [
                {
                    "id": "722020101",
                    "speaker": "Chise",
                    "text": "Pássaro do Trovão, você me abandonou?",
                    "choices": [
                        {
                            "id": "722020102",
                            "text": "Olá?",
                            "response": [
                                {
                                    "id": "722020104",
                                    "speaker": "Chise",
                                    "text": "Pássaro do Trovão, não fique irritada."
                                },
                                {
                                    "id": "722020105",
                                    "speaker": "Chise",
                                    "text": "Eu farei o meu melhor para ler a sua vontade e seus ensinamentos... mas... mas..."
                                },
                                {
                                    "id": "722020106",
                                    "speaker": "Chise",
                                    "text": "Mas por que você me recusou? Por quê?"
                                },
                                {
                                    "id": "722020107",
                                    "speaker": "Chise",
                                    "text": "Por que eu não consigo entrar no seu nevoeiro?",
                                    "choices": [
                                        {
                                            "id": "722020108",
                                            "text": "Ler? O que você quer dizer?",
                                            "response": [
                                                {
                                                    "id": "722020109",
                                                    "speaker": "Chise",
                                                    "text": "As Pedras do Trovão que você deixou... Eu vou pensar em uma maneira... O barco prateado já chegou, não tenho mais muito tempo..."
                                                },
                                                {
                                                    "id": "722020110",
                                                    "speaker": "Player",
                                                    "text": "Pedras do Trovão... o que são?"
                                                },
                                                {
                                                    "id": "722020111",
                                                    "speaker": "Chise",
                                                    "text": "Pedras do Trovão da Planície Autake... só poderão ser revividas por aqueles que manipulam o Electro... E apenas aqueles que encontram um caminho na névoa poderão encontrá-las."
                                                },
                                                {
                                                    "id": "722020112",
                                                    "speaker": "Chise",
                                                    "text": "Como se a Pássaro do Trovão estivesse de pé e abrisse as suas asas."
                                                }
                                            ]
                                        },
                                        {
                                            "id": "722020113",
                                            "text": "Mas o nevoeiro já se dissipou, não é?"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "722020103",
                            "text": "Precisa de alguma ajuda?"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7220202",
            "objective": "",
            "dialogues": [
                {
                    "id": "722020201",
                    "speaker": "Chise",
                    "text": "Ah, ó Grande Pássaro do Trovão, você me perdoou?"
                }
            ]
        },
        {
            "id": "7220203",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "722020301",
