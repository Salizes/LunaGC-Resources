    "talks": [
        {
            "id": "2210501",
            "objective": "Fale com Verr Goldet",
            "dialogues": [
                {
                    "id": "221050101",
                    "speaker": "Verr Goldet",
                    "text": "Que estressante..."
                },
                {
                    "id": "221050102",
                    "speaker": "Player",
                    "text": "Qual o problema?"
                },
                {
                    "id": "221050103",
                    "speaker": "Verr Goldet",
                    "text": "Tem algo de estranho ao redor dessa pousada, mas não consigo explicar..."
                },
                {
                    "id": "221050104",
                    "speaker": "Verr Goldet",
                    "text": "Sem mencionar que todos os nossos hóspedes pareçam ser pessoas muito sensitivas..."
                },
                {
                    "id": "221050105",
                    "speaker": "Verr Goldet",
                    "text": "Se houver a menor interferência acabamos com janelas e portas quebradas, às vezes também com tábuas quebradas."
                },
                {
                    "id": "221050106",
                    "speaker": "Verr Goldet",
                    "text": "Os hóspedes estão dispostos a pagar pelas peças, mas as peças estão por toda parte, é horrível."
                },
                {
                    "id": "221050107",
                    "speaker": "Verr Goldet",
                    "text": "Você poderia dar uma olhada do lado de fora do Albergue? Se você encontrar algo de esquisito, descubra o que é! Eu ainda preciso cuidar dos fregueses.",
                    "choices": [
                        {
                            "id": "221050108",
                            "text": "Entendi.",
                            "response": [
                                {
                                    "id": "221050110",
                                    "speaker": "Verr Goldet",
                                    "text": "Conto contigo."
                                }
                            ]
                        },
                        {
                            "id": "221050109",
                            "text": "Qual é o problema dessas pessoas...",
                            "response": [
                                {
                                    "id": "221050111",
                                    "speaker": "Verr Goldet",
                                    "text": "Os clientes? Ah, não se preocupe, eles estão acostumados a estarem em modo de sobrevivência na natureza. Você não pode culpá-los por sempre estarem em alerta."
                                },
                                {
                                    "id": "221050112",
                                    "speaker": "Verr Goldet",
                                    "text": "Por favor, só dá uma olhada lá fora, não deve acontecer nada!"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2210502",
            "objective": "Vá investigar o lugar suspeito",
            "dialogues": [
                {
                    "id": "221050201",
                    "speaker": "Verr Goldet",
                    "text": "Está tudo resolvido?"
                },
                {
                    "id": "221050202",
                    "speaker": "Player",
                    "text": "Ainda não..."
                },
                {
                    "id": "221050203",
                    "speaker": "Verr Goldet",
                    "text": "Não demore muito. É mais provável que os convidados reajam exageradamente a qualquer distúrbio assim que a noite chegar."
                }
            ]
        },
        {
            "id": "2210503",
            "objective": "Elimine todos os Monstros",
            "dialogues": [
                {
                    "id": "221050301",
                    "speaker": "Verr Goldet",
                    "text": "Está tudo resolvido?"
                },
                {
                    "id": "221050302",
                    "speaker": "Player",
                    "text": "Sim."
                },
                {
                    "id": "221050303",
                    "speaker": "Verr Goldet",
                    "text": "Perfeito. Nesta noite poderemos dormir tranquilos."
                },
                {
                    "id": "221050304",
                    "speaker": "Verr Goldet",
                    "text": "Por favor, aceite-os como compensação pelos seus problemas."
                }
            ]
        },
