    "talks": [
        {
            "id": "2204301",
            "objective": "Fale com Ooshima Junpei",
            "dialogues": [
                {
                    "id": "220430101",
                    "speaker": "Ooshima Junpei",
                    "text": "Hã, como eu fiquei sem madeira...?"
                },
                {
                    "id": "220430102",
                    "speaker": "Ooshima Junpei",
                    "text": "Ei, Viajante! Você chegou bem na hora certa, tem como você me ajudar com algo?",
                    "choices": [
                        {
                            "id": "220430103",
                            "text": "Com o quê?",
                            "response": [
                                {
                                    "id": "220430105",
                                    "speaker": "Ooshima Junpei",
                                    "text": "Tenho tentado fazer entalhes pequenos em madeira de nossa sacerdotisa chefe provisória."
                                },
                                {
                                    "id": "220430106",
                                    "speaker": "Ooshima Junpei",
                                    "text": "Estive pensando em levar um lote destes para a Ilha Narukami para ver se eles vendem..."
                                },
                                {
                                    "id": "220430107",
                                    "speaker": "Ooshima Junpei",
                                    "text": "Se venderem, me proporcionarão uma fonte de renda consistente.",
                                    "choices": [
                                        {
                                            "id": "220430108",
                                            "text": "Oh, tenho certeza que venderão.",
                                            "response": [
                                                {
                                                    "id": "220430109",
                                                    "speaker": "Ooshima Junpei",
                                                    "text": "Hahaha. Obrigado pelos seus votos de sucesso."
                                                },
                                                {
                                                    "id": "220430110",
                                                    "speaker": "Ooshima Junpei",
                                                    "text": "Dito isto, acho que tenho fé no carisma de nossa Senhorita Neko."
                                                },
                                                {
                                                    "id": "220430118",
                                                    "speaker": "Ooshima Junpei",
                                                    "text": "Bem, não importa isso por enquanto. Vamos falar sobre o assunto em questão..."
                                                },
                                                {
                                                    "id": "220430119",
                                                    "speaker": "Ooshima Junpei",
                                                    "text": "Então, a questão é que estou ficando sem a madeira que estava usando para praticar."
                                                },
                                                {
                                                    "id": "220430120",
                                                    "speaker": "Ooshima Junpei",
                                                    "text": "Você poderia me ajudar a coletar 10 blocos de Madeira Otogi, Traveler?",
                                                    "choices": [
                                                        {
                                                            "id": "220430121",
                                                            "text": "Deixe comigo.",
                                                            "response": [
                                                                {
                                                                    "id": "220430122",
                                                                    "speaker": "Ooshima Junpei",
                                                                    "text": "Deixarei isso com você, então. Você é realmente de uma grande ajuda."
                                                                },
                                                                {
                                                                    "id": "220430126",
                                                                    "speaker": "Ooshima Junpei",
                                                                    "text": "Traga aqueles blocos de Madeira Otogi para mim quando tiver terminado."
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "220430123",
                                                            "text": "Você realmente precisa de tantos assim?",
                                                            "response": [
                                                                {
                                                                    "id": "220430124",
                                                                    "speaker": "Ooshima Junpei",
                                                                    "text": "Bem, eu só agora comecei a praticar, então é melhor estar do lado prudente e preparar mais material."
                                                                },
                                                                {
                                                                    "id": "220430125",
                                                                    "speaker": "Ooshima Junpei",
                                                                    "text": "Bem, conto com você, Viajante."
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "220430111",
                                            "text": "Qual a das esculturas de madeira de repente?",
                                            "response": [
                                                {
                                                    "id": "220430112",
                                                    "speaker": "Ooshima Junpei",
                                                    "text": "Ah, bem... Você sabe qual tem sido, até agora, meu pagamento por parte de nossa sacerdotisa chefe?"
                                                },
                                                {
                                                    "id": "220430113",
                                                    "speaker": "Ooshima Junpei",
                                                    "text": "Geralmente são estas... Garrafas, copos, pratos e coisas assim."
                                                },
                                                {
                                                    "id": "220430114",
                                                    "speaker": "Ooshima Junpei",
                                                    "text": "Elas parecem um pouco velhas, mas quando fui avaliá-las, descobrimos que essas coisas são de fato um pouco \"antigas\"... E valiosas, também."
                                                },
                                                {
                                                    "id": "220430115",
                                                    "speaker": "Ooshima Junpei",
                                                    "text": "Mas, para dizer a verdade, era bastante problemático e cansativo conseguir vendê-las sempre."
                                                },
                                                {
                                                    "id": "220430116",
                                                    "speaker": "Ooshima Junpei",
                                                    "text": "Além disso, isto realmente não faz uma renda particularmente estável... Se a sacerdotisa chefe ficasse sem essas coisas um dia, isso basicamente não me deixaria sem emprego?"
                                                },
                                                {
                                                    "id": "220430117",
                                                    "speaker": "Ooshima Junpei",
                                                    "text": "Dessa forma, decidi buscar um novo empreendimento comercial."
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "220430104",
                            "text": "O que você está fazendo?"
                        }
                    ]
                }
            ]
        },
        {
            "id": "2204302",
            "objective": "Entregue 10 Madeiras Otogi para Ooshima Junpei",
            "dialogues": [
                {
                    "id": "220430201",
                    "speaker": "Ooshima Junpei",
                    "text": "Você encontrou aqueles 10 blocos de Madeira Otogi?"
                }
            ]
        },
        {
            "id": "2204303",
            "objective": "Fale com Ooshima Junpei",
            "dialogues": [
                {
                    "id": "220430301",
                    "speaker": "Ooshima Junpei",
                    "text": "Hmm, sim, estes servem, eu acho. Desculpe por pedir-lhe ajuda depois de ter feito todo este caminho para chegar ao santuário... Por favor, pegue isto."
                },
                {
                    "id": "220430302",
                    "speaker": "Ooshima Junpei",
                    "text": "Uma vez que eu tenha realizado meu trabalho de escultura em madeira, eu também lhe enviarei meu melhor trabalho!"
                },
                {
                    "id": "220430303",
                    "speaker": "Ooshima Junpei",
                    "text": "Hmm, que pose devo esculpir para a sacerdotisa chefe provisória desta vez...?"
                }
            ]
        }
    ]
}