    "talks": [
        {
            "id": "2204501",
            "objective": "Fale com Ooshima Junpei",
            "dialogues": [
                {
                    "id": "220450101",
                    "speaker": "Ooshima Junpei",
                    "text": "Hmm, isto ainda não parece muito certo..."
                },
                {
                    "id": "220450102",
                    "speaker": "Player",
                    "text": "Qual o problema?"
                },
                {
                    "id": "220450103",
                    "speaker": "Ooshima Junpei",
                    "text": "Ah, Viajante, você chegou em um bom momento!"
                },
                {
                    "id": "220450104",
                    "speaker": "Ooshima Junpei",
                    "text": "Recentemente, tive a sensação de que as esculturas em madeira que tenho feito... não têm... você sabe, a vida.",
                    "choices": [
                        {
                            "id": "220450105",
                            "text": "Bem, elas são feitas de madeira.",
                            "response": [
                                {
                                    "id": "220450106",
                                    "speaker": "Ooshima Junpei",
                                    "text": "Oh, não é isso que eu quero dizer..."
                                },
                                {
                                    "id": "220450108",
                                    "speaker": "Ooshima Junpei",
                                    "text": "Hmm. Como posso explicar isto? O que eu estou procurando é..."
                                },
                                {
                                    "id": "220450109",
                                    "speaker": "Ooshima Junpei",
                                    "text": "Sabe, nossa sacerdotisa chefe provisória está quase sempre dormindo, mas, às vezes, ela acorda e caminha."
                                },
                                {
                                    "id": "220450110",
                                    "speaker": "Ooshima Junpei",
                                    "text": "Enquanto caminha, ela roda ou saltita, pula em algumas folhas caídas, ou se estica, e coisas assim..."
                                },
                                {
                                    "id": "220450111",
                                    "speaker": "Ooshima Junpei",
                                    "text": "Quero captar isso em movimento. Quero fazer esculturas usando estas ações como base. Isso é o que quero dizer com \"vida\".",
                                    "choices": [
                                        {
                                            "id": "220450112",
                                            "text": "Vá ver por si mesmo, então...",
                                            "response": [
                                                {
                                                    "id": "220450114",
                                                    "speaker": "Ooshima Junpei",
                                                    "text": "Bem, eu, uh... Estou com um pouco de vergonha de fazer isso."
                                                },
                                                {
                                                    "id": "220450115",
                                                    "speaker": "Ooshima Junpei",
                                                    "text": "Digamos o que dissermos, ela é minha chefe. Sinto que se eu me agachasse ao lado dela e observasse, talvez a fizesse infeliz."
                                                },
                                                {
                                                    "id": "220450116",
                                                    "speaker": "Ooshima Junpei",
                                                    "text": "Seu relacionamento, por outro lado, deveria ser muito melhor. Então, você poderia me ajudar a tirar algumas fotos para usar como material de referência?",
                                                    "choices": [
                                                        {
                                                            "id": "220450117",
                                                            "text": "Tudo bem, então.",
                                                            "response": [
                                                                {
                                                                    "id": "220450121",
                                                                    "speaker": "Ooshima Junpei",
                                                                    "text": "Muito obrigado, Viajante. Apenas me traga essas fotos quando terminar de tirá-las."
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "220450118",
                                                            "text": "Se não conseguir capturar as ações desejadas...",
                                                            "response": [
                                                                {
                                                                    "id": "220450119",
                                                                    "speaker": "Ooshima Junpei",
                                                                    "text": "Não há problema. Você não tem que ir para esses grandes movimentos. Não acho que minha técnica de esculpir pudesse acompanhar isso no momento."
                                                                },
                                                                {
                                                                    "id": "220450120",
                                                                    "speaker": "Ooshima Junpei",
                                                                    "text": "Basta capturar algumas poses. Acho que isso serve, por enquanto."
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "220450113",
                                            "text": "Bem, a Neko está ali..."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "220450107",
                            "text": "Que tipo de \"vida\" você está procurando injetar em sua arte?"
                        }
                    ]
                }
            ]
        },
        {
            "id": "2204502",
            "objective": "Fotografe Neko do lado direito",
            "dialogues": [
                {
                    "id": "220450201",
                    "speaker": "Ooshima Junpei",
                    "text": "Vou deixar o negócio de tirar fotos para você. Basta trazê-las até mim assim que terminar."
                }
            ]
        },
        {
            "id": "2204503",
            "objective": "Fotografe Neko do lado esquerdo",
            "dialogues": [
                {
                    "id": "220450301",
                    "speaker": "Neko",
                    "text": "Mm? O que você está fazendo?"
                },
                {
                    "id": "220450302",
                    "speaker": "Player",
                    "text": "Tirando fotos!"
                },
                {
                    "id": "220450303",
                    "speaker": "Neko",
                    "text": "#...E o que são esses? Você é realmente estranh{M#o}{F#a}."
                },
                {
                    "id": "220450304",
                    "speaker": "Neko",
                    "text": "Eh, isso não importa. Continue como estava - basta não bagunçar o santuário."
                }
            ]
        },
        {
            "id": "2204504",
            "objective": "Entregue as fotos para Ooshima Junpei",
            "dialogues": [
                {
                    "id": "220450401",
                    "speaker": "Ooshima Junpei",
                    "text": "Como foi? Conseguiu as fotos?"
                },
                {
                    "id": "220450402",
                    "speaker": "Player",
                    "text": "Não foi tão difícil."
                },
                {
                    "id": "220450403",
                    "speaker": "Ooshima Junpei",
                    "text": "Deixe-me ver... Ooh! Este ângulo... Esta pose... Bastante bom! Bastante bom mesmo!",
                    "choices": [
                        {
                            "id": "220450404",
                            "text": "Bem... você parece animado...",
                            "response": [
                                {
                                    "id": "220450406",
                                    "speaker": "Ooshima Junpei",
                                    "text": "Claro que serve! Elas são boas demais como material de referência."
                                },
                                {
                                    "id": "220450407",
                                    "speaker": "Ooshima Junpei",
                                    "text": "Muito obrigado, Viajante. Por favor, tome estes. Começarei a praticar daqui a pouco!"
                                },
                                {
                                    "id": "220450408",
                                    "speaker": "Ooshima Junpei",
                                    "text": "Oh, isto é muito bom..."
                                }
                            ]
                        },
                        {
                            "id": "220450405",
                            "text": "Será que isso serve?"
                        }
                    ]
                }
            ]
        }
