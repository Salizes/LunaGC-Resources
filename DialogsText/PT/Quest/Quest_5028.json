            "objective": "Continue a \"sua\" jornada",
            "dialogues": [
                {
                    "id": "50280501",
                    "speaker": "Voz no Vazio",
                    "text": "As vidas dos Descidos são mais valiosas do que você pode imaginar."
                },
                {
                    "id": "50280502",
                    "speaker": "Voz no Vazio",
                    "text": "Você destruiu a esperança deste mundo com suas próprias mãos."
                },
                {
                    "id": "50280503",
                    "speaker": "Mavuika",
                    "text": "Se eu estava destinada a falhar, então por que você teme?"
                },
                {
                    "id": "50280504",
                    "speaker": "Voz no Vazio",
                    "text": "..."
                },
                {
                    "id": "50280505",
                    "speaker": "Mavuika",
                    "text": "(Um anseio interior nos levou a embarcar em uma peregrinação.)"
                },
                {
                    "id": "50280506",
                    "speaker": "Mavuika",
                    "text": "(Nós nos unimos e lutamos, pela chance de sermos chamados de os mais fortes.)"
                },
                {
                    "id": "50280507",
                    "speaker": "Mavuika",
                    "text": "(Por causa de nossos sonhos, queimamos intensamente até não queimarmos mais...)"
                },
                {
                    "id": "50280508",
                    "speaker": "Mavuika",
                    "text": "(E assim esse ciclo continuou, vez após vez...)"
                }
            ]
        },
