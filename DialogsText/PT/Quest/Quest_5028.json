        {
            "id": "502802",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "50280202",
                    "speaker": "Ororon",
                    "text": "#Sua alma é nobre e pura. {M#\"Herói\"}{F#\"Heroína\"} é apenas o ponto de partida {M#dele}{F#dela}."
                },
                {
                    "id": "50280207",
                    "speaker": "Chasca",
                    "text": "#Eu desejo voar com {M#ele}{F#ela} e ver o mundo além do céu."
                },
                {
                    "id": "50280208",
                    "speaker": "Iansan",
                    "text": "#Onde quer que {M#ele}{F#ela} chame de lar... certamente é um lugar de liberdade e calor."
                },
                {
                    "id": "50280211",
                    "speaker": "Xilonen",
                    "text": "#Eu admiro sua sabedoria, como {M#ele}{F#ela} sempre vive o momento."
                },
                {
                    "id": "50280212",
                    "speaker": "Mualani",
                    "text": "#Ser amigo {M#dele}{F#dela} me deixa tão feliz!"
                }
            ]
        },
        {
            "id": "502803",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "50280302",
                    "speaker": "Xbalanque",
                    "text": "Anjos malditos, banidos ■■ — vocês já deveriam ter ■■■■ há muito tempo!"
                }
            ]
        },
        {
            "id": "502899",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "50289901",
                    "speaker": "Cochanina",
                    "text": "Eu testemunhei a luz desta chama dezenas de vezes. Uma vez que a madeira se esgota, a noite retorna."
                },
                {
                    "id": "50289902",
                    "speaker": "Cochanina",
                    "text": "Fracasso, fracasso, fracasso, fracasso, fracasso..."
                }
            ]
