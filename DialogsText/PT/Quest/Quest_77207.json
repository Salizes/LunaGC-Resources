            "dialogues": [
                {
                    "id": "772070101",
                    "speaker": "Vanya",
                    "text": "Uff... Água de Fogo... Urgh. Mais um copo! ...Não, não... Só... mais um..."
                },
                {
                    "id": "772070102",
                    "speaker": "Paimon",
                    "text": "Hmm. Olha aquele bêbado desmaiado no chão. Como alguém vai passar se ele está bloqueando o caminho desse jeito..."
                },
                {
                    "id": "772070103",
                    "speaker": "Paimon",
                    "text": "#Temos que acordá-lo, {NICKNAME}... Talvez uma dose de Energia Elemental resolva? Ou algo mais... direto no rosto?",
                    "choices": [
                        {
                            "id": "772070104",
                            "text": "(Use Anemo para acordá-lo...)",
                            "response": [
                                {
                                    "id": "772070105",
                                    "speaker": "Vanya",
                                    "text": "Hã...? Hum... Quem são vocês? E, ahn... o que eu estou fazendo aqui?"
                                },
                                {
                                    "id": "772070108",
                                    "speaker": "Paimon",
                                    "text": "Você desmaiou depois de beber tudo aquilo! Logo aqui fora!"
                                },
                                {
                                    "id": "772070109",
                                    "speaker": "Vanya",
                                    "text": "Ah. Obrigado, obrigado... Eu teria pegado um resfriado terrível se tivesse ficado deitado aqui por mais tempo. Obrigado..."
                                }
                            ]
                        },
                        {
                            "id": "772070106",
                            "text": "(Acorde-o com tapinhas leves no rosto...)",
                            "response": [
                                {
                                    "id": "772070107",
                                    "speaker": "Vanya",
                                    "text": "Hã...? Hum... Quem são vocês? E, ahn... o que eu estou fazendo aqui?"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7720702",
            "objective": "",
            "dialogues": [
                {
                    "id": "772070201",
                    "speaker": "Vanya",
                    "text": "Hmph... Vocês não sabem com quem estão se metendo... Só preciso de um soco... um soco..."
                },
                {
                    "id": "772070202",
                    "speaker": "Paimon",
                    "text": "Sério? Outro bêbado bloqueando o caminho??? Espera, não é o beberrão que encontramos da outra vez!?"
                },
                {
                    "id": "772070203",
                    "speaker": "Paimon",
                    "text": "Vamos acordá-lo de novo... com Energia Elemental, ou uns tapinhas de leve!",
                    "choices": [
                        {
                            "id": "772070204",
                            "text": "(Use Hydro para acordá-lo...)",
                            "response": [
                                {
                                    "id": "772070205",
                                    "speaker": "Vanya",
                                    "text": "...Uhhhh... o que está acontecendo... Eu... estou meio tonto... Urgh..."
                                },
                                {
                                    "id": "772070208",
                                    "speaker": "Paimon",
                                    "text": "Você desmaiou no chão de novo!"
                                },
                                {
                                    "id": "772070209",
                                    "speaker": "Vanya",
                                    "text": "Ah, foi mesmo? Hehe... Me desculpem. E obrigado de novo por me acordarem antes que uma patrulha do Druzhna me pegasse ou coisa assim..."
                                }
                            ]
                        },
                        {
                            "id": "772070206",
                            "text": "(Dê um tapa no rosto dele...)",
                            "response": [
                                {
                                    "id": "772070207",
                                    "speaker": "Vanya",
                                    "text": "...Uhhhh... o que está acontecendo... Eu... estou meio tonto... Urgh..."
                                }
                            ]
