    "talks": [
        {
            "id": "2303901",
            "objective": "Falar com Ebeid",
            "dialogues": [
                {
                    "id": "230390101",
                    "speaker": "Ebeid",
                    "text": "#{M#Irmãozão}{F#Irmãzona}! Espera um pouco!"
                },
                {
                    "id": "230390102",
                    "speaker": "Ebeid",
                    "text": "#Com licença... Você é {M#um}{F#uma} Aventureir{M#o}{F#a}? Daquel{M#es}{F#as} que se aventuram por diversos lugares e são muito fortes?",
                    "choices": [
                        {
                            "id": "230390103",
                            "text": "Pode-se dizer que sim.",
                            "response": [
                                {
                                    "id": "230390105",
                                    "speaker": "Ebeid",
                                    "text": "#Olhe! Hilmi, bem que eu disse que {M#o irmãozão}{F#a irmãzona} era {M#um}{F#uma} Aventureir{M#o}{F#a}!"
                                },
                                {
                                    "id": "230390106",
                                    "speaker": "Hilmi",
                                    "text": "Mas os Aventureiros não vestem aquelas roupas verdes?",
                                    "choices": [
                                        {
                                            "id": "230390107",
                                            "text": "Como eu sou muito forte, não preciso me vestir assim.",
                                            "response": [
                                                {
                                                    "id": "230390109",
                                                    "speaker": "Hilmi",
                                                    "text": "Oh..."
                                                },
                                                {
                                                    "id": "230390110",
                                                    "speaker": "Ebeid",
                                                    "text": "Oh..."
                                                },
                                                {
                                                    "id": "230390111",
                                                    "speaker": "Ebeid",
                                                    "text": "#Então, {M#irmãozão}{F#irmãzona}! Você com certeza pode nos ajudar!"
                                                },
                                                {
                                                    "id": "230390112",
                                                    "speaker": "Ebeid",
                                                    "text": "Você viu aquele grande armazém do vilarejo, não é? O irmão Habachi disse que lá dentro tem muita coisa importante guardada, e que devem ser bem protegidas."
                                                },
                                                {
                                                    "id": "230390113",
                                                    "speaker": "Hilmi",
                                                    "text": "Ele ainda me disse que, se algum bandido atacasse o vilarejo, primeiro ele deveria suspender o funcionamento do elevador, então, cortar a ponte levadiça..."
                                                },
                                                {
                                                    "id": "230390114",
                                                    "speaker": "Ebeid",
                                                    "text": "Só que tem uma certa distância entre o armazém e o elevador, certo? Se o irmão Habachi quiser suspender o funcionamento do elevador, terá que correr muito e muito rápido."
                                                },
                                                {
                                                    "id": "230390115",
                                                    "speaker": "Ebeid",
                                                    "text": "Então eu tive uma ideia, queremos ajudar o irmão Habachi a praticar, mas ele não nos dá atenção..."
                                                },
                                                {
                                                    "id": "230390116",
                                                    "speaker": "Hilmi",
                                                    "text": "Toda vez que queremos brincar de quicar pedras na água ele tem uma reação muito exagerada, tsc..."
                                                },
                                                {
                                                    "id": "230390117",
                                                    "speaker": "Ebeid",
                                                    "text": "Enfim! Se os bandidos atacassem o vilarejo, o irmão Habachi não conseguiria sair do lugar, assim nós quem teríamos que suspender o funcionamento do elevador."
                                                },
                                                {
                                                    "id": "230390118",
                                                    "speaker": "Ebeid",
                                                    "text": "#{M#Irmãozão}{F#Irmãzona}, você é {M#um}{F#uma} Aventureir{M#o}{F#a}, deve ter habilidades incríveis, por favor, nos ajude a treinar!",
                                                    "choices": [
                                                        {
                                                            "id": "230390119",
                                                            "text": "Então eu posso correr com vocês.",
                                                            "response": [
                                                                {
                                                                    "id": "230390120",
                                                                    "speaker": "Ebeid",
                                                                    "text": "#Oba! Obrigado, {M#irmãozão}{F#irmãzona}!"
                                                                },
                                                                {
                                                                    "id": "230390126",
                                                                    "speaker": "Hilmi",
                                                                    "text": "#Já escolhemos o ponto de partida, então vamos para lá, {M#irmãozão}{F#irmãzona}."
                                                                },
                                                                {
                                                                    "id": "230390127",
                                                                    "speaker": "Hilmi",
                                                                    "text": "Hehe! É a minha vez de disputar com você. Já aviso que sou muito bom em corrida!"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "230390121",
                                                            "text": "Pode confiar em Habachi...",
                                                            "response": [
                                                                {
                                                                    "id": "230390122",
                                                                    "speaker": "Ebeid",
                                                                    "text": "Hã? Vamos brincar juntos..."
                                                                },
                                                                {
                                                                    "id": "230390123",
                                                                    "speaker": "Ebeid",
                                                                    "text": "#Venha, vamos treinar juntos {M#irmãozão}{F#irmãzona}, por favor!"
                                                                },
                                                                {
                                                                    "id": "230390124",
                                                                    "speaker": "Player",
                                                                    "text": "Tudo bem..."
                                                                },
                                                                {
                                                                    "id": "230390125",
                                                                    "speaker": "Ebeid",
                                                                    "text": "#Oba! Obrigado, {M#irmãozão}{F#irmãzona}!"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "230390108",
                                            "text": "Como eu sou especial, não preciso me vestir assim."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "230390104",
                            "text": "Bem, pode se dizer que sim..."
                        }
                    ]
                }
            ]
        },
        {
            "id": "2303902",
            "objective": "Participar da corrida",
            "dialogues": []
        },
        {
            "id": "2303904",
            "objective": "Fale com Hilmi",
            "dialogues": [
                {
                    "id": "230390401",
                    "speaker": "Hilmi",
                    "text": "*Ofegante* Eu venci!",
                    "choices": [
                        {
                            "id": "230390402",
                            "text": "Pa... Parabéns!",
                            "response": [
                                {
                                    "id": "230390404",
                                    "speaker": "Hilmi",
                                    "text": "#Hehe! Falei que eu era bom em corrida. {M#O irmãozão}{F#A irmãzona}, subestimou o seu oponente, né?"
                                },
                                {
                                    "id": "230390405",
                                    "speaker": "Ebeid",
                                    "text": "Mesmo correndo tão rápido, o irmão Habachi sempre nos pega, por que será?",
                                    "choices": [
                                        {
                                            "id": "230390406",
                                            "text": "Pode ter sido um atalho.",
                                            "response": [
                                                {
                                                    "id": "230390408",
                                                    "speaker": "Ebeid",
                                                    "text": "É mesmo? Hmm... Só que não parece ter nenhum atalho por aqui..."
                                                },
                                                {
                                                    "id": "230390409",
                                                    "speaker": "Hilmi",
                                                    "text": "#Vamos convidar {M#o irmãozão}{F#a irmãzona} para brincar mais da próxima vez..."
                                                },
                                                {
                                                    "id": "230390410",
                                                    "speaker": "Hilmi",
                                                    "text": "Treine com a gente! Aquele... vamos treinar aquele \"Esconde-Esconde na Selva\"!"
                                                },
                                                {
                                                    "id": "230390411",
                                                    "speaker": "Ebeid",
                                                    "text": "Você tem razão! Se não conseguimos correr mais rápido que Habachi, então vamos dar a volta por ele..."
                                                },
                                                {
                                                    "id": "230390412",
                                                    "speaker": "Hilmi",
                                                    "text": "Já não tentamos antes? Só que não importa o que façamos, o irmão Habachi sempre encontra a gente..."
                                                }
                                            ]
                                        },
                                        {
                                            "id": "230390407",
                                            "text": "Pode ser que tenha algum segredo..."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "230390403",
                            "text": "Você co... correu muito rápido..."
                        }
                    ]
                }
            ]
        },
        {
