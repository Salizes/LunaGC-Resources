    "talks": [
        {
            "id": "7310901",
            "objective": "",
            "dialogues": [
                {
                    "id": "731090101",
                    "speaker": "Javi",
                    "text": "Isso é estranho... Deve estar por aqui. Por que não consigo encontrar?"
                },
                {
                    "id": "731090102",
                    "speaker": "Player",
                    "text": "O que você está procurando?"
                },
                {
                    "id": "731090103",
                    "speaker": "Javi",
                    "text": "#Você é... Oh você é {M#o Viajante}{F#a Viajante}, certo? Já ouvi falar de você."
                },
                {
                    "id": "731090104",
                    "speaker": "Javi",
                    "text": "Eu me chamou Javi, um... Um comerciante comum. Estou procurando pela Caixa dos Sonhos que enterrei aqui antes."
                },
                {
                    "id": "731090105",
                    "speaker": "Paimon",
                    "text": "Que nome estranho.. O que tem dentro dessa caixa?"
                },
                {
                    "id": "731090106",
                    "speaker": "Javi",
                    "text": "Hmm... Se eu tivesse como expressar, seriam \"os sonhos que ainda serão realizados\" da minha infância."
                },
                {
                    "id": "731090107",
                    "speaker": "Player",
                    "text": "Por que você faria isso?"
                },
                {
                    "id": "731090108",
                    "speaker": "Javi",
                    "text": "Hahaha, é um jogo que eu e meus amigos costumávamos jogar quando éramos crianças."
                },
                {
                    "id": "731090109",
                    "speaker": "Javi",
                    "text": "Nós escrevíamos o sonho mais precioso que tínhamos, e depois enterrávamos aqui. Então marcávamos algum tempo para voltarmos juntos e cavar essa Caixa dos Sonhos."
                },
                {
                    "id": "731090110",
                    "speaker": "Javi",
                    "text": "E a data que marcamos é hoje! Mas aparentemente sou o único que se lembrou dela."
                },
                {
                    "id": "731090111",
                    "speaker": "Javi",
                    "text": "*Suspiro* Tudo bem se eles esqueceram... O importante é que você não esqueça seus próprios sonhos."
                },
                {
                    "id": "731090112",
                    "speaker": "Javi",
                    "text": "Enfim, eu vim para escavar a minha caixa e poder finalizar o que comecei."
                },
                {
                    "id": "731090113",
                    "speaker": "Javi",
                    "text": "Mas eu procurei por todo lado e não encontrei nada. Será que alguém a pegou?",
                    "choices": [
                        {
                            "id": "731090114",
                            "text": "Você deixou alguma marca na época?",
                            "response": [
                                {
                                    "id": "731090118",
                                    "speaker": "Javi",
                                    "text": "Lembro-me que na época a enterrei ao lado de uma árvore."
                                },
                                {
                                    "id": "731090119",
                                    "speaker": "Paimon",
                                    "text": "Ao lado de uma árvore? Mas há muitas árvores por aqui!"
                                },
                                {
                                    "id": "731090120",
                                    "speaker": "Javi",
                                    "text": "Eu não esperava por algo assim quando era criança. Nós só deixamos uma pequena placa para marcar o local."
                                },
                                {
                                    "id": "731090121",
                                    "speaker": "Javi",
                                    "text": "Faz tanto tempo que a placa desapareceu e não reconheço as árvores da área..."
                                },
                                {
                                    "id": "731090122",
                                    "speaker": "Javi",
                                    "text": "Só me lembro que a caixa deve estar por aqui."
                                },
                                {
                                    "id": "731090123",
                                    "speaker": "Javi",
                                    "text": "Viajante, você pode me ajudar a procurar?",
                                    "choices": [
                                        {
                                            "id": "731090124",
                                            "text": "E onde eu procuro?",
                                            "response": [
                                                {
                                                    "id": "731090125",
                                                    "speaker": "Javi",
                                                    "text": "Enterrei a caixa perto de uma árvore, então... Comece cavando perto delas."
                                                },
                                                {
                                                    "id": "731090126",
                                                    "speaker": "Javi",
                                                    "text": "Me ajude, Viajante. Eu te recompensarei."
                                                },
                                                {
                                                    "id": "731090130",
                                                    "speaker": "Javi",
                                                    "text": "Veja como é grande esta floresta, nunca a encontrarei sozinho."
                                                },
                                                {
                                                    "id": "731090131",
                                                    "speaker": "Player",
                                                    "text": "Está bem..."
                                                },
                                                {
                                                    "id": "731090132",
                                                    "speaker": "Javi",
                                                    "text": "Hehe, obrigado. Vamos dividir. Eu procuro nesse lado, você naquele."
                                                }
                                            ]
                                        },
                                        {
                                            "id": "731090127",
                                            "text": "Seu sonho já foi embora...",
                                            "response": [
                                                {
                                                    "id": "731090128",
                                                    "speaker": "Javi",
                                                    "text": "Sim, o meu sonho saiu voando, e é por isso que estou procurando por essa caixa. Gostaria de saber qual era o meu sonho na época."
                                                },
                                                {
                                                    "id": "731090129",
                                                    "speaker": "Javi",
                                                    "text": "Por favor, Viajante, me ajude. Eu pagarei uma boa recompensa."
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "731090115",
                            "text": "Seu sonho se foi...",
                            "response": [
                                {
                                    "id": "731090116",
                                    "speaker": "Javi",
                                    "text": "Hahaha... Talvez sim. Afinal, eu sequer lembro do que escrevi..."
                                },
                                {
                                    "id": "731090117",
                                    "speaker": "Javi",
                                    "text": "Mas mesmo que meu sonho possa sair voando por aí, a caixa não."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7310902",
            "objective": "Ajude Javi a encontrar seu \"sonho\"",
            "dialogues": []
        },
        {
            "id": "7310903",
            "objective": "Entregue o \"sonho\" a Javi",
            "dialogues": [
                {
                    "id": "731090301",
                    "speaker": "Javi",
                    "text": "Oh não. Essa não é a minha Caixa dos Sonhos.",
                    "choices": [
                        {
                            "id": "731090302",
                            "text": "Nós desenterramos uma caixa.",
                            "response": [
                                {
                                    "id": "731090303",
                                    "speaker": "Javi",
                                    "text": "Haha, eu também desenterrei uma..."
                                },
                                {
                                    "id": "731090305",
                                    "speaker": "Javi",
                                    "text": "Eu até mesmo abri a Caixa dos Sonhos e encontrei uma folha de papel com o nome de Ami."
                                },
                                {
                                    "id": "731090306",
                                    "speaker": "Javi",
                                    "text": "Eu me lembro dela. Era a filha de Jahangir, sempre estava perto de alguma loja de comida."
                                },
                                {
                                    "id": "731090307",
                                    "speaker": "Javi",
                                    "text": "Ela sonhava em se tornar uma florista, e que cuidaria de muitas flores..."
                                },
                                {
                                    "id": "731090308",
                                    "speaker": "Javi",
                                    "text": "Que coisa inesperada. Sempre pensei que Jahangir passaria a loja para ela.",
                                    "choices": [
                                        {
                                            "id": "731090309",
                                            "text": "Vamos olhar para o seu sonho primeiro.",
                                            "response": [
                                                {
                                                    "id": "731090311",
                                                    "speaker": "Javi",
                                                    "text": "Oh! Sim, eu quase esqueci, tenho que dar uma olhada no meu sonho primeiro..."
                                                },
                                                {
                                                    "id": "731090312",
                                                    "speaker": "Javi",
                                                    "text": "Vamos ver..."
                                                },
                                                {
                                                    "id": "731090313",
                                                    "speaker": "Javi",
                                                    "text": "\"Espero virar um Vanara, e viver sempre na floresta...\""
                                                },
                                                {
                                                    "id": "731090314",
                                                    "speaker": "Javi",
                                                    "text": "Então esse era meu sonho de infância? Pelos arcontes, não consigo acreditar que era isso que eu queria..."
                                                },
                                                {
                                                    "id": "731090315",
                                                    "speaker": "Javi",
                                                    "text": "*Suspiro* Idiota, virar um Vanara não dá muito dinheiro.",
                                                    "choices": [
                                                        {
                                                            "id": "731090316",
                                                            "text": "Eu não vejo nada de errado.",
                                                            "response": [
                                                                {
                                                                    "id": "731090318",
                                                                    "speaker": "Javi",
                                                                    "text": "Isso é só uma ideia infantil. Para alguém da minha idade, sonhos..."
                                                                },
                                                                {
                                                                    "id": "731090319",
                                                                    "speaker": "Javi",
                                                                    "text": "..."
                                                                },
                                                                {
                                                                    "id": "731090320",
                                                                    "speaker": "Javi",
                                                                    "text": "Vale mais a pena pensar em como ganhar mais Mora. Assim posso dormir bem."
                                                                },
                                                                {
                                                                    "id": "731090321",
                                                                    "speaker": "Javi",
                                                                    "text": "Bem, vamos esquecer esse sonho inútil, melhor falarmos sobre Ami."
                                                                },
                                                                {
                                                                    "id": "731090322",
                                                                    "speaker": "Javi",
                                                                    "text": "Eu abri a Caixa dos Sonhos dela, preciso compensá-la."
                                                                },
                                                                {
                                                                    "id": "731090323",
                                                                    "speaker": "Javi",
                                                                    "text": "Hmm... Deixe-me pensar. Já que ela queria ser uma florista, a primeira coisa que se deve saber é como plantá-las."
                                                                },
                                                                {
                                                                    "id": "731090324",
                                                                    "speaker": "Javi",
                                                                    "text": "Por acaso eu tenho um vaso sobrando que posso dar para ela."
                                                                },
                                                                {
                                                                    "id": "731090325",
                                                                    "speaker": "Javi",
                                                                    "text": "Viajante, você sabe como conseguir sementes de flores?",
                                                                    "choices": [
                                                                        {
                                                                            "id": "731090326",
                                                                            "text": "Deixe comigo.",
                                                                            "response": [
                                                                                {
                                                                                    "id": "731090332",
                                                                                    "speaker": "Javi",
                                                                                    "text": "Estou contando com você para conseguir as sementes, Viajante. Vamos esperar do lado da loja de Jahangir."
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "731090327",
                                                                            "text": "Por que você está fazendo isso?",
                                                                            "response": [
                                                                                {
                                                                                    "id": "731090328",
                                                                                    "speaker": "Javi",
                                                                                    "text": "Hahaha... Pode-se dizer que estou sendo espontâneo."
                                                                                },
                                                                                {
                                                                                    "id": "731090329",
                                                                                    "speaker": "Javi",
                                                                                    "text": "Eu não posso mais realizar o meu sonho por causa dos anos que já se passaram... E o fato que não me importo mais com meu sonho também."
                                                                                },
                                                                                {
                                                                                    "id": "731090330",
                                                                                    "speaker": "Javi",
                                                                                    "text": "Mas Ami ainda é jovem, e pode tentar realizar o seu sonho."
                                                                                },
                                                                                {
                                                                                    "id": "731090331",
                                                                                    "speaker": "Javi",
                                                                                    "text": "Como um adulto entediante, não posso fazer muito para ajudá-la, mas esse vaso pode mostrar meu apoio e a encorajar."
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "731090317",
                                                            "text": "Não existem sonhos melhores ou piores."
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "731090310",
                                            "text": "Esta é a sua \"Caixa dos Sonhos\"."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "731090304",
                            "text": "Você também desenterrou uma caixa?"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7310904",
            "objective": "Colete semente das Rosas de Sumeru",
            "dialogues": []
        },
        {
            "id": "7310905",
            "objective": "Fale com Ami",
            "dialogues": [
                {
                    "id": "731090501",
                    "speaker": "Ami",
                    "text": "Isso é... para mim?"
                },
                {
                    "id": "731090502",
                    "speaker": "Ami",
                    "text": "Eu não estava falando sério sobre o que estava escrito na folha de papel na caixa! Está tudo bem, não precisa se desculpar."
                },
                {
                    "id": "731090503",
                    "speaker": "Javi",
                    "text": "Não se preocupe, esse vaso daqui não me serve de nada. Por favor, fique com ele."
                },
                {
                    "id": "731090504",
                    "speaker": "Javi",
                    "text": "#Eu pedi para alguém trazer algumas sementes, el{F#a}{M#e} já deve estar chegando...",
                    "choices": [
                        {
                            "id": "731090505",
                            "text": "Aqui estão as sementes!",
                            "response": [
                                {
                                    "id": "731090507",
                                    "speaker": "Javi",
                                    "text": "Hã? Quando você chegou? Eu nem reparei..."
                                },
                                {
                                    "id": "731090508",
                                    "speaker": "Javi",
                                    "text": "Ahem... Ami, você queria ser uma florista, não é? Pode começar plantando essas sementes."
                                },
                                {
                                    "id": "731090509",
                                    "speaker": "Ami",
                                    "text": "Agradeço... Mas se eu fizer isso perto da loja do meu pai, os insetos talvez entrem na panela..."
                                },
                                {
                                    "id": "731090510",
                                    "speaker": "Ami",
                                    "text": "Seria uma pena para os insetos na panela, e para os adultos com insetos na comida."
                                },
                                {
                                    "id": "731090511",
                                    "speaker": "Ami",
                                    "text": "Mas se eu mover as flores para mais longe posso acabar esquecendo delas. Isso também é uma pena, pois elas secariam..."
                                },
                                {
                                    "id": "731090512",
                                    "speaker": "Ami",
                                    "text": "Além disso, papai está sempre ocupado e nunca me deixa ir a lugares distantes..."
                                },
                                {
                                    "id": "731090513",
                                    "speaker": "Javi",
                                    "text": "Hum... Podemos cuidar disso juntos, se quiser. Que tal?"
                                },
                                {
                                    "id": "731090514",
                                    "speaker": "Javi",
                                    "text": "Apesar de só poder visitar depois do trabalho, eu tenho algum tempo livre."
                                },
                                {
                                    "id": "731090515",
                                    "speaker": "Ami",
                                    "text": "Excelente! Mas o papai pode dizer não..."
                                },
                                {
                                    "id": "731090516",
                                    "speaker": "Javi",
                                    "text": "O Sr. Jahangir e eu somos basicamente amigos agora. Ele deve concordar se falarmos com ele juntos."
                                },
                                {
                                    "id": "731090517",
                                    "speaker": "Ami",
                                    "text": "Certo! Eu... quero mais flores, então! Rosa de Sumeru é a minha favorita! Algum dia... Cercarei a loja do meu pai com Rosas de Sumeru!"
                                },
                                {
                                    "id": "731090518",
                                    "speaker": "Javi",
                                    "text": "Bem, isso é um lindo sonho, pequenina. Vamos fazer o nosso melhor para alcançá-lo!",
                                    "choices": [
                                        {
                                            "id": "731090519",
                                            "text": "Guarde uma para mim, por favor.",
                                            "response": [
                                                {
                                                    "id": "731090521",
                                                    "speaker": "Ami",
                                                    "text": "#Eu irei! Obrigada, {M#senhor}{F#senhora}. Deixe-me pensar... eu também quero uma Flor Doce, e o que mais..."
                                                },
                                                {
                                                    "id": "731090522",
                                                    "speaker": "Javi",
                                                    "text": "Então ela gosta muito de flores. Espero que ela possa manter esse sonho..."
                                                },
                                                {
                                                    "id": "731090523",
                                                    "speaker": "Javi",
                                                    "text": "Hehe... Espero que não cresça como eu, um cara comum e chato."
                                                },
                                                {
                                                    "id": "731090524",
                                                    "speaker": "Javi",
                                                    "text": "Ahem! Obrigado pela ajuda, Viajante. Por favor, tome isso como compensação pelo seu trabalho.",
                                                    "choices": [
                                                        {
                                                            "id": "731090525",
                                                            "text": "Viver com todo o coração é muito mais do que ser comum.",
                                                            "response": [
                                                                {
                                                                    "id": "731090527",
                                                                    "speaker": "Javi",
                                                                    "text": "Obrigado. No entanto, não estou reclamando."
                                                                },
                                                                {
                                                                    "id": "731090528",
                                                                    "speaker": "Javi",
                                                                    "text": "Eu estava apenas... Tendo alguns pensamentos depois de ver os \"sonhos\" que eu havia enterrado."
                                                                },
                                                                {
                                                                    "id": "731090529",
                                                                    "speaker": "Javi",
                                                                    "text": "Tudo bem, eu deveria sair agora. Obrigado por sua ajuda hoje, Viajante."
                                                                },
                                                                {
                                                                    "id": "731090530",
                                                                    "speaker": "Javi",
                                                                    "text": "Talvez eu devesse... Escrever outro \"sonho\" e enterrá-lo lá..."
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "731090526",
                                                            "text": "Viver com todo o coração é muito mais do que ser chato."
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "731090520",
                                            "text": "Você consegue!"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "731090506",
                            "text": "Essas sementes são para você."
                        }
                    ]
                }
            ]
        },
        {
            "id": "7310930",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "731093001",
                    "speaker": "Javi",
                    "text": "Aqui também não tem nada..."
                },
                {
                    "id": "731093002",
                    "speaker": "Javi",
                    "text": "*Suspira* Vamos, aquela caixa não pode ter ganhado pernas..."
                }
            ]
        },
        {
            "id": "7310999",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "731099901",
                    "speaker": "Paimon",
                    "text": "Não há nada aqui... Vamos para a próxima árvore."
                },
                {
                    "id": "731099902",
                    "speaker": "Paimon",
                    "text": "Não, nada. Alguém pode ter levado."
                },
                {
                    "id": "731099903",
                    "speaker": "Paimon",
                    "text": "Hã? Paimon encontrou uma caixa aqui. Vamos levá-la."
                }
            ]
        }
    ]
}