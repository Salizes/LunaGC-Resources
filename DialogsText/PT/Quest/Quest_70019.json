        {
            "id": "7001901",
            "objective": "Fale com o outro Hilichurl disposto a conversar",
            "dialogues": [
                {
                    "id": "700190101",
                    "speaker": "Hilichurl com Insônia",
                    "text": "Yoyo dala si?"
                },
                {
                    "id": "700190102",
                    "speaker": "Ella Musk",
                    "text": "Mimi tomo. Mimi mani ye."
                },
                {
                    "id": "700190103",
                    "speaker": "Hilichurl com Insônia",
                    "text": "Yoyo mani mi? Mi muhe Upa Celi nini. Mi muhe mi nunu si, mi muhe mi nye."
                },
                {
                    "id": "700190104",
                    "speaker": "Ella Musk",
                    "text": "Ele disse que não quer mais ver o sol, quer dormir e não acordar, quer morrer. O que será que fez ele sofrer tanto para ficar assim?"
                },
                {
                    "id": "700190105",
                    "speaker": "Hilichurl com Insônia",
                    "text": "Biat. Mi muhe <color=#00E1FFFF>celi lata</color>. Mi nunu nye."
                },
                {
                    "id": "700190106",
                    "speaker": "Ella Musk",
                    "text": "É melhor nós darmos o que ele quer para consolá-lo."
                }
            ]
        },
        {
            "id": "7001902",
            "objective": "Troque itens com o Hilichurl",
            "dialogues": [
                {
                    "id": "700190301",
                    "speaker": "Hilichurl com Insônia",
                    "text": "Yeye dada."
                },
                {
                    "id": "700190302",
                    "speaker": "Hilichurl com Insônia",
                    "text": "Wei? Du odomu tomo zido mi si, du zido <color=#00E1FFFF>unta nunu</color>!"
                },
                {
                    "id": "700190303",
                    "speaker": "Paimon",
                    "text": "<color=#00E1FFFF>Unta nunu</color>... Ele está falando sobre o tempo para nós?",
                    "choices": [
                        {
                            "id": "700190304",
                            "text": "Mosi mita dada!",
                            "response": [
                                {
                                    "id": "700190306",
                                    "speaker": "Hilichurl com Insônia",
                                    "text": "Valo, mi tomo!"
                                },
                                {
                                    "id": "700190307",
                                    "speaker": "Paimon",
                                    "text": "Valo!"
                                }
                            ]
                        },
                        {
                            "id": "700190305",
                            "text": "Tomo, valo!"
                        }
                    ]
                }
            ]
        },
