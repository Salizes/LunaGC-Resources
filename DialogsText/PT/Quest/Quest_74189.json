    "talks": [
        {
            "id": "7418905",
            "objective": "",
            "dialogues": [
                {
                    "id": "741890501",
                    "speaker": "Permingeat",
                    "text": "Um momento, por favor. Você gostaria de saber um segredo sobre o tesouro?"
                },
                {
                    "id": "741890502",
                    "speaker": "Player",
                    "text": "Que segredo?"
                },
                {
                    "id": "741890503",
                    "speaker": "Permingeat",
                    "text": "Tem a ver com o tesouro e a chave para abrir o portão. Como isso soa? Interessado?",
                    "choices": [
                        {
                            "id": "741890504",
                            "text": "Você não tá me pedindo para lutar contra monstros de novo, tá?",
                            "response": [
                                {
                                    "id": "741890506",
                                    "speaker": "Permingeat",
                                    "text": "Claro que não! Não sonharíamos em pedir que clientes da taverna fizessem serviços."
                                },
                                {
                                    "id": "741890507",
                                    "speaker": "Permingeat",
                                    "text": "Vê essa artilharia naval ao meu lado e os entulhos na direção dela??"
                                },
                                {
                                    "id": "741890508",
                                    "speaker": "Permingeat",
                                    "text": "Ative o canhão e exploda essas pedras, qualquer tesouro que você descobrir é seu."
                                },
                                {
                                    "id": "741890509",
                                    "speaker": "Player",
                                    "text": "Quem em Tevyat deu nome a esse canhão?"
                                },
                                {
                                    "id": "741890510",
                                    "speaker": "Permingeat",
                                    "text": "O timoneiro. Não tenho certeza de onde ele tirou isso.",
                                    "choices": [
                                        {
                                            "id": "741890511",
                                            "text": "Pode falar. Quais componentes estão faltando?",
                                            "response": [
                                                {
                                                    "id": "741890513",
                                                    "speaker": "Permingeat",
                                                    "text": "#Acho que você entendeu errado, amig{M#o}{F#a}. O canhão está inteiramente intacto e totalmente energizado. Cuido dele todo dia."
                                                },
                                                {
                                                    "id": "741890514",
                                                    "speaker": "Permingeat",
                                                    "text": "Mas antes que você ative o canhão, eu gostaria que você respondesse várias perguntas."
                                                },
                                                {
                                                    "id": "741890515",
                                                    "speaker": "Permingeat",
                                                    "text": "É a pedido do timoneiro. Ele disse que era uma boa fonte de diversão para os clientes da taverna, algo para frear a bebida deles e mantê-los aqui por mais tempo."
                                                },
                                                {
                                                    "id": "741890516",
                                                    "speaker": "Player",
                                                    "text": "Não tenho certeza disso, mas pode perguntar."
                                                },
                                                {
                                                    "id": "741890517",
                                                    "speaker": "Permingeat",
                                                    "text": "Pergunta 1: Quantas mesas existem no Leme Enferrujado?"
                                                },
                                                {
                                                    "id": "741890518",
                                                    "speaker": "Permingeat",
                                                    "text": "Pergunta 2: Quantos trabalhadores temos no Leme Enferrujado?"
                                                },
                                                {
                                                    "id": "741890519",
                                                    "speaker": "Permingeat",
                                                    "text": "Pergunta 3: O que não é servido no Leme Enferrujado?"
                                                },
                                                {
                                                    "id": "741890520",
                                                    "speaker": "Permingeat",
                                                    "text": "É isso. Você só precisa responder essas três perguntas corretamente para ativar o canhão, explodir os entulhos e pegar o tesouro."
                                                },
                                                {
                                                    "id": "741890521",
                                                    "speaker": "Player",
                                                    "text": "O que vai acontecer depois que eu pegar o tesouro?"
                                                },
                                                {
                                                    "id": "741890522",
                                                    "speaker": "Permingeat",
                                                    "text": "Em seguida, vou achar o momento certo para colocar outro prêmio adequado na caverna e selá-lo com entulho."
                                                },
                                                {
                                                    "id": "741890523",
                                                    "speaker": "Permingeat",
                                                    "text": "O tesouro está aguardando para ser reivindicado quando nosso próximo convidado ativar a artilharia.",
                                                    "choices": [
                                                        {
                                                            "id": "741890524",
                                                            "text": "Isso é muito trabalho para você.",
                                                            "response": [
                                                                {
                                                                    "id": "741890528",
                                                                    "speaker": "Permingeat",
                                                                    "text": "Isso é tudo. Vocês podem procurar as respostas agora. Enquanto isso, ficarei aqui esperando vocês."
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "741890525",
                                                            "text": "Pense num chefe terrível.",
                                                            "response": [
                                                                {
                                                                    "id": "741890526",
                                                                    "speaker": "Permingeat",
                                                                    "text": "Eu acho difícil descordar de seu comentário, mas ainda tenho que encontrar um jeito de apontar o canhão ao timoneiro sem que ele perceba."
                                                                },
                                                                {
                                                                    "id": "741890527",
                                                                    "speaker": "Permingeat",
                                                                    "text": "Além disso, disparar na direção errada pode prejudicar outros clientes na taverna, entrando em conflito com meus princípios morais."
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "741890512",
                                            "text": "Pode falar. Como ele é energizado?"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "741890505",
                            "text": "Você não tá me pedindo para encontrar algo ou alguém para você de novo, tá?"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7418903",
            "objective": "",
            "dialogues": [
                {
                    "id": "741890301",
                    "speaker": "Permingeat",
                    "text": "Tudo certo, parabéns! Você pode ir ativar o canhão agora."
                },
                {
                    "id": "741890302",
                    "speaker": "Permingeat",
                    "text": "Espere um segundo, deixe-me cobrir meus ouvidos primeiro."
                }
            ]
        },
        {
            "id": "7418904",
            "objective": "",
            "dialogues": [
                {
                    "id": "741890401",
                    "speaker": "Permingeat",
                    "text": "Você encontrou as respostas para as perguntas? Deixe-me te lembrar sobre a pergunta primeiro."
                },
                {
                    "id": "741890402",
                    "speaker": "Permingeat",
                    "text": "Pergunta 1: Quantas mesas existem no Leme Enferrujado?"
