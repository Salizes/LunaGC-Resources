                    "text": "Pergunta 3: O que não é servido no Leme Enferrujado?"
                },
                {
                    "id": "741890405",
                    "speaker": "Permingeat",
                    "text": "#Você está pront{M#o}{F#a} para responder as perguntas?",
                    "choices": [
                        {
                            "id": "741890406",
                            "text": "#Estamos pront{M#o}{F#a}s.",
                            "response": [
                                {
                                    "id": "741890409",
                                    "speaker": "Permingeat",
                                    "text": "Então, vamos começar. Primeira pergunta. Quantas mesas existem no Leme Enferrujado?",
                                    "choices": [
                                        {
                                            "id": "741890410",
                                            "text": "Três.",
                                            "response": [
                                                {
                                                    "id": "741890411",
                                                    "speaker": "Permingeat",
                                                    "text": "Correto! Mais um passo perto de ativar o canhão."
                                                },
                                                {
                                                    "id": "741890414",
                                                    "speaker": "Permingeat",
                                                    "text": "Pergunta 2: Quantos trabalhadores temos no Leme Enferrujado?",
                                                    "choices": [
                                                        {
                                                            "id": "741890417",
                                                            "text": "Um.",
                                                            "response": [
                                                                {
                                                                    "id": "741890425",
                                                                    "speaker": "Permingeat",
                                                                    "text": "Desculpe ter que dizer, mas essa resposta está errada. Quer tentar novamente?",
                                                                    "choices": [
                                                                        {
                                                                            "id": "741890426",
                                                                            "text": "Vou tentar de novo."
                                                                        },
                                                                        {
                                                                            "id": "741890427",
                                                                            "text": "Deixe-me pensar mais um pouco...",
                                                                            "response": [
                                                                                {
                                                                                    "id": "741890428",
                                                                                    "speaker": "Permingeat",
                                                                                    "text": "#Então ficarei esperando pelas suas respostas às minhas perguntas! Você pode me encontrar bem aqui quando estiver pront{M#o}{F#a}."
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "741890415",
                                                            "text": "Três.",
                                                            "response": [
                                                                {
                                                                    "id": "741890416",
                                                                    "speaker": "Permingeat",
                                                                    "text": "Correto! Mais um passo perto de ativar o canhão."
                                                                },
                                                                {
                                                                    "id": "741890419",
                                                                    "speaker": "Permingeat",
                                                                    "text": "Pergunta 3: O que não é servido no Leme Enferrujado?",
                                                                    "choices": [
                                                                        {
                                                                            "id": "741890420",
                                                                            "text": "Queijo."
                                                                        },
                                                                        {
                                                                            "id": "741890421",
                                                                            "text": "Flor Rociomarinha.",
                                                                            "response": [
                                                                                {
                                                                                    "id": "741890422",
                                                                                    "speaker": "Permingeat",
                                                                                    "text": "Tudo certo, parabéns! Você pode ir ativar o canhão agora."
                                                                                },
                                                                                {
                                                                                    "id": "741890423",
                                                                                    "speaker": "Permingeat",
                                                                                    "text": "Espere um segundo, deixe-me cobrir meus ouvidos primeiro."
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "741890424",
                                                                            "text": "Leite."
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "741890418",
                                                            "text": "#Eu sou {M#seu empregado}{F#sua empregada}."
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "741890412",
