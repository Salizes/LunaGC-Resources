    "talks": [
        {
            "id": "2050401",
            "objective": "Fale com a dona da loja, Marjorie",
            "dialogues": [
                {
                    "id": "205040101",
                    "speaker": "Marjorie",
                    "text": "Sejam bem-vindos. Cada tesouro aqui é único."
                },
                {
                    "id": "205040102",
                    "speaker": "Paimon",
                    "text": "Há muitas coisas que a Paimon nunca tinha visto."
                },
                {
                    "id": "205040103",
                    "speaker": "Marjorie",
                    "text": "Haha, claro... São tesouros raros trazidos de volta dos aventureiros de todos os cantos do mundo."
                },
                {
                    "id": "205040104",
                    "speaker": "Marjorie",
                    "text": "Tem alguma coisa que chama a sua atenção?",
                    "choices": [
                        {
                            "id": "205040105",
                            "text": "Isso é tudo tão estranho...",
                            "response": [
                                {
                                    "id": "205040107",
                                    "speaker": "Marjorie",
                                    "text": "Não é preciso. Me esqueci de dizer. Eu opero com base em trocas. Troco alguns artigos por outros. Eu não aceito Mora."
                                },
                                {
                                    "id": "205040108",
                                    "speaker": "Marjorie",
                                    "text": "Eu tenho tentado fazer algo especial recentemente, e eu preciso de bastante <color=#00E1FFFF>Selos Anemo</color> para usar como decoração."
                                },
                                {
                                    "id": "205040109",
                                    "speaker": "Marjorie",
                                    "text": "Você tem <color=#00E1FFFF>Selos Anemo</color> com você?",
                                    "choices": [
                                        {
                                            "id": "205040110",
                                            "text": "Encontramos algumas.",
                                            "response": [
                                                {
                                                    "id": "205040111",
                                                    "speaker": "Marjorie",
                                                    "text": "Haha, parece que o Arconte Anemo aprova suas aventuras então."
                                                },
                                                {
                                                    "id": "205040114",
                                                    "speaker": "Marjorie",
                                                    "text": "Enfim, pode trocar qualquer produto na minha loja por um <color=#00E1FFFF>Selo Anemo</color>."
                                                },
                                                {
                                                    "id": "205040115",
                                                    "speaker": "Player",
                                                    "text": "Escolher produtos."
                                                }
                                            ]
                                        },
                                        {
                                            "id": "205040112",
                                            "text": "O que é aquilo?",
                                            "response": [
                                                {
                                                    "id": "205040113",
                                                    "speaker": "Marjorie",
                                                    "text": "É como um selo ou emblema que o Arconte Anemo dá aos aventureiros como uma forma de reconhecimento."
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "205040106",
                            "text": "Eu não me atrevo a perguntar pelo preço!"
                        }
                    ]
                }
            ]
        },
        {
            "id": "2050402",
            "objective": "",
            "dialogues": [
                {
                    "id": "205040201",
                    "speaker": "Paimon",
                    "text": "Veja! Aquela loja não parece interessante?"
                }
            ]
        },
        {
            "id": "2050403",
            "objective": "",
            "dialogues": [
                {
                    "id": "205040301",
                    "speaker": "Marjorie",
                    "text": "As <color=#00E1FFFF>Selo Anemo</color> aparecem por todo canto de Mondstadt. Se você estiver com falta, apenas continua procurando."
                },
                {
                    "id": "205040302",
                    "speaker": "Player",
                    "text": "São realmente apenas para decoração?"
                },
                {
                    "id": "205040303",
                    "speaker": "Paimon",
                    "text": "Com certeza, o que mais poderia ser mais belo que um presente do Arconte Anemo?"
                },
                {
                    "id": "205040304",
                    "speaker": "Marjorie",
                    "text": "Hahaha, muito bem, muito bem."
                },
                {
                    "id": "205040305",
                    "speaker": "Marjorie",
                    "text": "Na verdade, é mais complicado do que isso, mas é mais fácil para as pessoas entenderem se eu apenas disser que é para decoração."
                },
                {
                    "id": "205040306",
                    "speaker": "Marjorie",
                    "text": "Obviamente, a razão de eu precisar de <color=#00E1FFFF>Selos Anemo</color> é porque eles possuem propriedades que os outros materiais não têm.",
                    "choices": [
                        {
                            "id": "205040307",
                            "text": "Deixe-me ver quando estiver pronto.",
                            "response": [
                                {
                                    "id": "205040308",
                                    "speaker": "Marjorie",
                                    "text": "Haha, claro! Eu garanto que você se surpreenderá com o resultado."
                                },
                                {
                                    "id": "205040312",
                                    "speaker": "Marjorie",
                                    "text": "Volte sempre, e me traga muitos, muitos <color=#00E1FFFF>Selos Anemo</color> da próxima vez!"
                                },
                                {
                                    "id": "205040313",
                                    "speaker": "Marjorie",
                                    "text": "Qualquer tesouro raro, lembre-se de trazer para cá!"
                                }
                            ]
                        },
                        {
                            "id": "205040309",
                            "text": "Eu acho que você está fazendo isso mais misterioso do que realmente é.",
                            "response": [
                                {
                                    "id": "205040310",
                                    "speaker": "Paimon",
                                    "text": "Está funcionando... Estou curiosa agora!"
                                },
                                {
                                    "id": "205040311",
                                    "speaker": "Marjorie",
                                    "text": "Haha, não seria uma grande surpresa se eu falasse tudo, certo?"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}