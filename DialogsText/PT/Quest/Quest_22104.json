        {
            "id": "2210401",
            "objective": "Fale com Verr Goldet",
            "dialogues": [
                {
                    "id": "221040101",
                    "speaker": "Verr Goldet",
                    "text": "Isso está ficando tão estressante..."
                },
                {
                    "id": "221040102",
                    "speaker": "Player",
                    "text": "Qual o problema?"
                },
                {
                    "id": "221040103",
                    "speaker": "Verr Goldet",
                    "text": "Oh, desculpa! Quando você chegou aqui?"
                },
                {
                    "id": "221040104",
                    "speaker": "Verr Goldet",
                    "text": "A presença de monstros nesta área está crescendo constantemente, e embora meu marido insista que eles não ousariam pôr os pés no albergue..."
                },
                {
                    "id": "221040105",
                    "speaker": "Verr Goldet",
                    "text": "Mas ele é o único que está preparado o suficiente para atacar de volta... Isso me inquieta."
                },
                {
                    "id": "221040106",
                    "speaker": "Verr Goldet",
                    "text": "Se você estiver disposta, pode por favor ir ver no albergue?",
                    "choices": [
                        {
                            "id": "221040107",
                            "text": "Entendi.",
                            "response": [
                                {
                                    "id": "221040109",
                                    "speaker": "Verr Goldet",
                                    "text": "#Muito obrigada. Você é muito simpátic{M#o}{F#a}."
                                },
                                {
                                    "id": "221040113",
                                    "speaker": "Verr Goldet",
                                    "text": "Sou grato por sua ajuda. Você será adequadamente recompensado."
                                }
                            ]
                        },
                        {
                            "id": "221040108",
                            "text": "Este albergue...",
                            "response": [
                                {
                                    "id": "221040110",
                                    "speaker": "Verr Goldet",
                                    "text": "Hã? Não há nada fora do comum na pousada. Está apenas com um pouco mais de tráfego do que o usual."
                                },
                                {
                                    "id": "221040111",
                                    "speaker": "Verr Goldet",
                                    "text": "Mas vale a pena. Os viajantes que enfrentam o deserto precisam de um lugar para ter uma boa noite de sono e comer uma refeição adequada."
                                },
                                {
                                    "id": "221040112",
                                    "speaker": "Verr Goldet",
                                    "text": "É o que eu e o meu marido pensamos, é simplesmente assim."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2210402",
            "objective": "Vá investigar o lugar suspeito",
            "dialogues": [
                {
                    "id": "221040201",
                    "speaker": "Verr Goldet",
                    "text": "Está tudo resolvido?"
                },
                {
                    "id": "221040202",
                    "speaker": "Player",
                    "text": "Ainda não..."
                },
                {
                    "id": "221040203",
                    "speaker": "Verr Goldet",
                    "text": "Por favor, preste mais atenção, sempre me sinto meio estranho aqui ao lado."
                }
            ]
        },
        {
            "id": "2210403",
            "objective": "Elimine todos os Monstros",
            "dialogues": [
                {
                    "id": "221040301",
