    "talks": [
        {
            "id": "7367401",
            "objective": "Fale com Ulman",
            "dialogues": [
                {
                    "id": "736740101",
                    "speaker": "Ulman",
                    "text": "Pequenino, você não me trouxe aqui? Vamos, continue andando."
                },
                {
                    "id": "736740102",
                    "speaker": "Ulman",
                    "text": "Não importa, é melhor você ficar aqui...",
                    "choices": [
                        {
                            "id": "736740103",
                            "text": "O que você está fazendo?",
                            "response": [
                                {
                                    "id": "736740106",
                                    "speaker": "Ulman",
                                    "text": "Infelizmente, fui enganado por esse \"carinha\" de novo... Vou contar brevemente desde o início."
                                },
                                {
                                    "id": "736740107",
                                    "speaker": "Ulman",
                                    "text": "Para começar, você pode não acreditar que os Seelies são de alguma forma facilmente atraídos por mim."
                                },
                                {
                                    "id": "736740108",
                                    "speaker": "Ulman",
                                    "text": "Entre os Seelies que vieram me seguir, encontrei um tipo que é particularmente interessado em buscar tesouros."
                                },
                                {
                                    "id": "736740109",
                                    "speaker": "Ulman",
                                    "text": "Eu também não sei como nomeá-las, então eu apenas os chamo de \"Seelies dos Tesouros\"."
                                },
                                {
                                    "id": "736740110",
                                    "speaker": "Ulman",
                                    "text": "Eles são muito bons em caçar tesouros. Com a ajuda deles, desenterrei muitos tesouros e encontrei muitas riquezas."
                                },
                                {
                                    "id": "736740111",
                                    "speaker": "Ulman",
                                    "text": "Mas às vezes eles começam a me ignorar, não sei se estão cansados de caçar tesouros, ou acham que eu sou muito chato..."
                                },
                                {
                                    "id": "736740112",
                                    "speaker": "Ulman",
                                    "text": "Nessa época, costumo procurar um ajudante que possa parecer interessante para os Seelies."
                                },
                                {
                                    "id": "736740113",
                                    "speaker": "Ulman",
                                    "text": "Ele fica encarregado de caçar tesouros com o \"Seelie dos Tesouros\" e eu... Sou responsável por vender esses tesouros."
                                },
                                {
                                    "id": "736740114",
                                    "speaker": "Ulman",
                                    "text": "Dizem que ruínas e antiguidades estão por toda parte em Sumeru. Então vim buscar minha fortuna."
                                },
                                {
                                    "id": "736740115",
                                    "speaker": "Ulman",
                                    "text": "Quando vim, eu realmente atraí um monte de Seelie, e vários dos \"Seelie dos Tesouros\" me trouxeram aqui."
                                },
                                {
                                    "id": "736740116",
                                    "speaker": "Ulman",
                                    "text": "Mas eu nem sequer comecei a cavar quando eles começaram a me ignorar de novo..."
                                },
                                {
                                    "id": "736740117",
                                    "speaker": "Ulman",
                                    "text": "Hã? Por que de repente começou a se mover? Poderia ser..."
                                },
                                {
                                    "id": "736740118",
                                    "speaker": "Ulman",
                                    "text": "#Viajante, você está interessad{M#o}{F#a} em caçar tesouros com os Seelies?",
                                    "choices": [
                                        {
                                            "id": "736740119",
                                            "text": "Eu?",
                                            "response": [
                                                {
                                                    "id": "736740121",
                                                    "speaker": "Ulman",
                                                    "text": "Isso não será necessário. Basta segui-lo e cavar onde ele parar."
                                                },
                                                {
                                                    "id": "736740122",
                                                    "speaker": "Ulman",
                                                    "text": "O que você acha? Apenas tente... Se você pegar algum tesouro, eu só quero as \"Moedas de Ferro Antigas\" se houver alguma. O resto é todo seu!"
                                                },
                                                {
                                                    "id": "736740123",
                                                    "speaker": "Ulman",
                                                    "text": "E se você me ajudar a encontrar algumas dessas moedas, eu pagarei por elas a um preço justo.",
                                                    "choices": [
                                                        {
                                                            "id": "736740124",
                                                            "text": "Posso tentar...",
                                                            "response": [
                                                                {
                                                                    "id": "736740125",
                                                                    "speaker": "Ulman",
                                                                    "text": "Claro! Eu gosto de pessoas como você!"
                                                                },
                                                                {
                                                                    "id": "736740130",
                                                                    "speaker": "Ulman",
                                                                    "text": "Resumindo, agora estamos em parceria!"
                                                                },
                                                                {
                                                                    "id": "736740131",
                                                                    "speaker": "Ulman",
                                                                    "text": "Pegue este caderno. Gravei nele alguns locais de tesouros escondidos que encontrei antes, mas não tive a chance de cavar."
                                                                },
                                                                {
                                                                    "id": "736740132",
                                                                    "speaker": "Ulman",
                                                                    "text": "Conto com você então, Viajante. Volte e me traga as \"Moedas de Ferro Antigas\" se você encontrar alguma."
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "736740126",
                                                            "text": "O que é a \"Moeda de Ferro Antiga\"?",
                                                            "response": [
                                                                {
                                                                    "id": "736740127",
                                                                    "speaker": "Ulman",
                                                                    "text": "Simplificando, é uma espécie de antiguidade."
                                                                },
                                                                {
                                                                    "id": "736740128",
                                                                    "speaker": "Ulman",
                                                                    "text": "Com boas conexões, poderei trocar as moedas por coisas decentes."
                                                                },
                                                                {
                                                                    "id": "736740129",
                                                                    "speaker": "Ulman",
                                                                    "text": "Embora... Eu ainda não tenha encontrado boas conexões..."
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "736740120",
                                            "text": "Eu não sei como falar com um Seelie..."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "736740104",
                            "text": "Esse é... um Seelie?",
                            "response": [
                                {
                                    "id": "736740105",
                                    "speaker": "Ulman",
                                    "text": "Você diz esse rapazinho? Ah... Mesmo que fosse..."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7367403",
            "objective": "",
            "dialogues": [
                {
                    "id": "736740301",
                    "speaker": "Ulman",
                    "text": "Pequenino, você não me trouxe aqui? Vamos, continue andando."
                },
                {
                    "id": "736740302",
                    "speaker": "Ulman",
                    "text": "Não importa, é melhor você ficar aqui...",
                    "choices": [
                        {
                            "id": "736740303",
                            "text": "Ulman?",
                            "response": [
                                {
                                    "id": "736740305",
                                    "speaker": "Ulman",
                                    "text": "Viajante? Há quanto tempo!"
                                },
                                {
                                    "id": "736740306",
                                    "speaker": "Ulman",
                                    "text": "#Você ainda está viajando pelo mundo? Ouvi muito dos seus feitos incríveis, você é realmente extraordinári{M#o}{F#a}."
                                },
                                {
                                    "id": "736740307",
                                    "speaker": "Ulman",
                                    "text": "Ei! Que problema você veio resolver em Sumeru desta vez?",
                                    "choices": [
                                        {
                                            "id": "736740308",
                                            "text": "Ei! Vire essa boca para lá!",
                                            "response": [
                                                {
                                                    "id": "736740309",
                                                    "speaker": "Ulman",
                                                    "text": "Muito bem, vamos ao que interessa. Viajante, que tal trabalharmos juntos novamente?"
                                                },
                                                {
                                                    "id": "736740313",
                                                    "speaker": "Ulman",
                                                    "text": "A terra de Sumeru está repleta de tesouros. Tem Mora em todos os lugares."
                                                },
                                                {
                                                    "id": "736740314",
                                                    "speaker": "Ulman",
                                                    "text": "Seelies são atraídos para mim como de costume. E os Seelie dos Tesouros com os quais nos familiarizamos também estão entre eles."
                                                },
                                                {
                                                    "id": "736740315",
                                                    "speaker": "Ulman",
                                                    "text": "O mesmo de antes. Você e os Seelies procuram tesouros, e eu preparo seu pagamento."
                                                },
                                                {
                                                    "id": "736740316",
                                                    "speaker": "Ulman",
                                                    "text": "Trabalhando juntos, definitivamente podemos ganhar muito dinheiro!",
                                                    "choices": [
                                                        {
                                                            "id": "736740317",
                                                            "text": "\"Moedas de Ferro\" outra vez?",
                                                            "response": [
                                                                {
                                                                    "id": "736740318",
                                                                    "speaker": "Ulman",
                                                                    "text": "Não. Desta vez estou procurando por \"Moedas de Ferro Antigas\", que valem mais."
                                                                },
                                                                {
                                                                    "id": "736740319",
                                                                    "speaker": "Player",
                                                                    "text": "Parece que a diferença é só de uma palavra!"
                                                                },
                                                                {
                                                                    "id": "736740320",
                                                                    "speaker": "Ulman",
                                                                    "text": "Não é! As antigas vendem por mais Mora."
                                                                },
                                                                {
                                                                    "id": "736740326",
                                                                    "speaker": "Ulman",
                                                                    "text": "Então este assunto está resolvido, vamos trabalhar juntos como antes e lucrar muito!"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "736740321",
                                                            "text": "Você não consegue encontrar ninguém além de mim?",
                                                            "response": [
                                                                {
                                                                    "id": "736740322",
                                                                    "speaker": "Ulman",
                                                                    "text": "#Bem... Quando você escolhe {M#um}{F#uma} parceir{M#o}{F#a}, é claro que tem que escolher a pessoa com quem está mais familiarizado."
                                                                },
                                                                {
                                                                    "id": "736740323",
                                                                    "speaker": "Ulman",
                                                                    "text": "Além disso, nós somos amigos. Eu não iria deixar uma oportunidade dessas cair no colo de uma pessoa qualquer."
                                                                },
                                                                {
                                                                    "id": "736740324",
                                                                    "speaker": "Player",
                                                                    "text": "Da última vez que nos encontramos, você não tinha essa lábia toda."
                                                                },
                                                                {
                                                                    "id": "736740325",
                                                                    "speaker": "Ulman",
                                                                    "text": "Hehe, é só assim que você consegue persuadir os seus clientes."
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "736740310",
                                            "text": "Vou \"dar um jeito\" em você primeiro.",
                                            "response": [
                                                {
                                                    "id": "736740311",
                                                    "speaker": "Ulman",
                                                    "text": "Haha, melhor não. Eu não seria forte o suficiente para aguentar os seus socos."
                                                },
                                                {
                                                    "id": "736740312",
                                                    "speaker": "Ulman",
                                                    "text": "Sério, Viajante! Que tal trabalharmos juntos novamente?"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "736740304",
                            "text": "O que te traz aqui?"
                        }
                    ]
                }
            ]
        }
    ]
}