        {
            "id": "7210423",
            "objective": "",
            "dialogues": [
                {
                    "id": "721043801",
                    "speaker": "Player",
                    "text": "Senhorita Gendou, você parece estar de bom humor hoje."
                },
                {
                    "id": "721043802",
                    "speaker": "Gendou Ringo",
                    "text": "Hmm? O que foi?"
                },
                {
                    "id": "721043803",
                    "speaker": "Player",
                    "text": "Você não parece consigo mesma..."
                },
                {
                    "id": "721043804",
                    "speaker": "Gendou Ringo",
                    "text": "Oh? Você acha? Vou lembrar disso."
                },
                {
                    "id": "721043805",
                    "speaker": "Gendou Ringo",
                    "text": "Talvez eu só esteja de bom humor hoje... Quero dizer, eu acabei de tirar uma \"Sorte Grande\" e tudo! Só queria compartilhar ela com você, sabe?"
                },
                {
                    "id": "721043806",
                    "speaker": "Gendou Ringo",
                    "text": "Mesmo assim, o que alguns chamam de \"Sorte Grande\" pode ser \"Grande Azar\" para outros."
                },
                {
                    "id": "721043807",
                    "speaker": "Gendou Ringo",
                    "text": "Para aqueles que receberam \"grande azar\"... Me pergunto o que será que os espera no Pendurador de Rolinhos da Sorte?"
                },
                {
                    "id": "721043808",
                    "speaker": "Gendou Ringo",
                    "text": "Que sorte interessante! Até mais."
                }
            ]
        },
        {
            "id": "7210416",
            "objective": "",
            "dialogues": [
                {
                    "id": "721041601",
                    "speaker": "Player",
                    "text": "(Entrega o Rolinho da Sorte) No meio da noite nebulosa."
                },
                {
                    "id": "721041602",
                    "speaker": "Gendou Ringo",
                    "text": "\"Névoa.\""
                },
                {
                    "id": "721041603",
                    "speaker": "Gendou Ringo",
                    "text": "Muito bem, pegue seu Rolinho da Sorte."
                }
            ]
        },
        {
            "id": "7210417",
            "objective": "",
            "dialogues": [
                {
                    "id": "721041701",
                    "speaker": "Player",
                    "text": "(Entrega o Rolinho da Sorte) No meio da noite nebulosa."
                },
                {
                    "id": "721041702",
                    "speaker": "Gendou Ringo",
                    "text": "\"Névoa.\""
                },
                {
                    "id": "721041703",
                    "speaker": "Gendou Ringo",
                    "text": "Ok. Pegue seu Rolinho da Sorte."
                },
                {
                    "id": "721041704",
                    "speaker": "Gendou Ringo",
                    "text": "Você completou muito bem a tarefa anterior. Por favor, continue exercendo a mesma diligência no futuro."
                }
            ]
        },
        {
            "id": "7210418",
            "objective": "",
            "dialogues": [
                {
                    "id": "721041801",
                    "speaker": "Player",
                    "text": "(Entrega o Rolinho da Sorte) No meio da noite nebulosa."
                },
                {
                    "id": "721041802",
                    "speaker": "Gendou Ringo",
                    "text": "\"Névoa.\""
                },
                {
                    "id": "721041803",
                    "speaker": "Gendou Ringo",
                    "text": "Ok. Pegue seu Rolinho da Sorte."
                },
                {
                    "id": "721041804",
                    "speaker": "Gendou Ringo",
                    "text": "Sua ajuda anterior foi muito apreciada. Espero ansiosamente por seu sucesso também desta vez."
                }
            ]
        },
        {
            "id": "7210435",
            "objective": "",
            "dialogues": [
                {
                    "id": "721043501",
                    "speaker": "Gendou Ringo",
                    "text": "Quando que aquela pessoa vai chegar..."
                },
                {
                    "id": "721043502",
                    "speaker": "Player",
                    "text": "Senhora Gendou..."
                },
                {
                    "id": "721043503",
                    "speaker": "Gendou Ringo",
                    "text": "Oh, olá! Você finalmente... Uh, digo, você está aqui para decifrar seu rolinho da sorte hoje?"
                }
            ]
        },
        {
            "id": "7210436",
            "objective": "",
            "dialogues": [
                {
                    "id": "721043601",
                    "speaker": "Gendou Ringo",
                    "text": "Olá."
                }
            ]
        },
        {
            "id": "7210437",
            "objective": "",
            "dialogues": [
                {
                    "id": "721043701",
                    "speaker": "Gendou Ringo",
                    "text": "#Olá, {NICKNAME}! Você está aqui para decifrar seu Rolinho da Sorte hoje?"
                }
            ]
        },
        {
            "id": "7210401",
            "objective": "",
            "dialogues": [
                {
                    "id": "721040101",
                    "speaker": "Player",
                    "text": "Quero decifrar o rolinho da sorte..."
                },
                {
                    "id": "721040102",
                    "speaker": "Gendou Ringo",
                    "text": "Ok, me dê seu Rolinho de Bambu."
                }
            ]
        },
