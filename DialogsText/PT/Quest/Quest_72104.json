        {
            "id": "7210439",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "721043901",
                    "speaker": "Player",
                    "text": "Senhorita Gendou, há algo com você hoje?"
                },
                {
                    "id": "721043902",
                    "speaker": "Gendou Ringo",
                    "text": "Eu... hã? Eh? Você está me perguntando?"
                },
                {
                    "id": "721043903",
                    "speaker": "Gendou Ringo",
                    "text": "Isso... bem... ah... tenho andado bastante ocupada ultimamente! Mas se você quiser, eu vou ver se consigo...",
                    "choices": [
                        {
                            "id": "721043904",
                            "text": "Você está enganada...",
                            "response": [
                                {
                                    "id": "721043906",
                                    "speaker": "Gendou Ringo",
                                    "text": "Oh, entendo, eu pensei que hoje finalmente..."
                                }
                            ]
                        },
                        {
                            "id": "721043905",
                            "text": "Parece que você está em outro lugar..."
                        }
                    ]
                }
            ]
        },
        {
            "id": "7210440",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "721044001",
                    "speaker": "Player",
                    "text": "Como você sabe meu nome?"
                },
                {
                    "id": "721044002",
                    "speaker": "Gendou Ringo",
                    "text": "Hã? Você já disse isso antes, não foi?"
                },
                {
                    "id": "721044003",
                    "speaker": "Player",
                    "text": "Eu disse?"
                },
                {
                    "id": "721044004",
                    "speaker": "Gendou Ringo",
                    "text": "#Hã? Você conseguiu. Quero dizer, é cl-claro que você conseguiu. Enfim, {NICKNAME} é um belo nome, não é?"
                }
            ]
