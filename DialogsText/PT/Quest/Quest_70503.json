            "objective": "Fale com Luka, e entre na Taverna",
            "dialogues": [
                {
                    "id": "705030101",
                    "speaker": "Eula",
                    "text": "#Um copo pequeno de Recife Espumante, por favor... Obrigad{M#o}{F#a}.",
                    "choices": [
                        {
                            "id": "705030102",
                            "text": "Eula?",
                            "response": [
                                {
                                    "id": "705030104",
                                    "speaker": "Eula",
                                    "text": "Eu... estou bem."
                                },
                                {
                                    "id": "705030105",
                                    "speaker": "Paimon",
                                    "text": "Hã... Tem algo estranho com a Eula. Será que ela já estava bebendo antes de vir aqui?"
                                },
                                {
                                    "id": "705030106",
                                    "speaker": "Paimon",
                                    "text": "Recife Espumante contém café. Será que não vai cair mal no estômago dela de beber café depois de licor?"
                                },
                                {
                                    "id": "705030107",
                                    "speaker": "Paimon",
                                    "text": "Pelo bem da barriga dela, vamos deixar mais aguado antes de servir a ela!"
                                }
                            ]
                        },
                        {
                            "id": "705030103",
                            "text": "Está tudo bem com você?"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7050305",
            "objective": "Vá para o balcão e complete os preparativos para os negócios",
            "dialogues": []
