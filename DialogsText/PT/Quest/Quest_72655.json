    "talks": [
        {
            "id": "7265501",
            "objective": "Fale com Muzhen",
            "dialogues": [
                {
                    "id": "726550101",
                    "speaker": "Muzhen",
                    "text": "Bem, parece que finalmente localizamos nossos alvos! Ótimo! Acho que já posso voltar ao navio para dormir, né?"
                },
                {
                    "id": "726550102",
                    "speaker": "Paimon",
                    "text": "O quêêê? Está deixando todo o resto para a gente?"
                },
                {
                    "id": "726550103",
                    "speaker": "Muzhen",
                    "text": "Bem, ah... Quero dizer, já que estamos quase na linha de chegada, vamos agora mesmo e capturar as máquina de ruínas!"
                },
                {
                    "id": "726550104",
                    "speaker": "Paimon",
                    "text": "Hum, a Paimon achou que você ia voltar para o navio!"
                },
                {
                    "id": "726550105",
                    "speaker": "Paimon",
                    "text": "*Suspiro* Bem, não importa. Vamos segui-la!"
                }
            ]
        },
        {
            "id": "7265502",
            "objective": "Vá até às ruínas",
            "dialogues": [
                {
                    "id": "726550201",
                    "speaker": "Muzhen",
                    "text": "Haha, é aqui mesmo!"
                },
                {
                    "id": "726550202",
                    "speaker": "Muzhen",
                    "text": "Então aqui também haveria ruínas subterrâneas... Ugh",
                    "choices": [
                        {
                            "id": "726550203",
                            "text": "O que aconteceu?",
                            "response": [
                                {
                                    "id": "726550205",
                                    "speaker": "Muzhen",
                                    "text": "Não..."
                                },
                                {
                                    "id": "726550206",
                                    "speaker": "Paimon",
                                    "text": "Você não parece muito bem. Está tudo bem com você?"
                                },
                                {
                                    "id": "726550207",
                                    "speaker": "Muzhen",
                                    "text": "Haha. Eu normalmente não saio do navio, então esta entrada de ruínas é... Bem, uma visão e tanto."
                                },
                                {
                                    "id": "726550208",
                                    "speaker": "Paimon",
                                    "text": "Sério? Paimon não acha mesmo."
                                },
                                {
                                    "id": "726550209",
                                    "speaker": "Muzhen",
                                    "text": "#Ainda é preciso completar o pedido da Capitã. Viajante, tenho certeza de que você está realmente curios{M#o}{F#a} sobre quais tesouros estão dentro das ruínas também, não está?"
                                },
                                {
                                    "id": "726550210",
                                    "speaker": "Muzhen",
                                    "text": "#Então, eu poderia convidá-l{M#o}{F#a}, experiente e habilidos{M#}{F#a} Viajante, a assumir a liderança?"
                                },
                                {
                                    "id": "726550211",
                                    "speaker": "Player",
                                    "text": "Estou sem mais alternativas..."
                                },
                                {
                                    "id": "726550212",
                                    "speaker": "Paimon",
                                    "text": "Não tem mais jeito... Vamos lá então."
                                }
                            ]
                        },
                        {
                            "id": "726550204",
                            "text": "Encontrou algo novo?"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7265503",
            "objective": "Fale com Muzhen",
            "dialogues": []
        },
        {
            "id": "7265504",
            "objective": "Explore essas ruínas",
            "dialogues": []
        },
        {
            "id": "7265503",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "726550301",
                    "speaker": "Muzhen",
                    "text": "Hmm? Você precisa fazer alguns preparativos?",
                    "choices": [
                        {
                            "id": "726550302",
                            "text": "Sobre as ruínas",
                            "response": [
                                {
                                    "id": "726550304",
                                    "speaker": "Muzhen",
                                    "text": "Bem, eu sou uma oficial técnica, portanto não estou muito familiarizada com a história do continente."
                                },
                                {
                                    "id": "726550305",
                                    "speaker": "Muzhen",
                                    "text": "No entanto, acredito que estas ruínas estejam relacionadas ao grande desastre que ocorreu há quinhentos anos."
                                },
                                {
                                    "id": "726550306",
                                    "speaker": "Muzhen",
                                    "text": "Eu cresci ouvindo velhos marinheiros contarem essa história, sabe? Eles diziam que nem a terra nem o mar podiam escapar do alcance do Abismo."
                                },
                                {
                                    "id": "726550307",
                                    "speaker": "Muzhen",
                                    "text": "Mas para mim, essas não eram diferentes das histórias de fantasmas que eles contam para assustar as crianças."
                                },
                                {
                                    "id": "726550308",
                                    "speaker": "Muzhen",
                                    "text": "Afinal de contas, só o terror que você pode ver é verdadeiro!"
                                }
                            ]
                        },
                        {
                            "id": "726550303",
                            "text": "Sobre o mecanismo misterioso..."
                        }
                    ]
                }
            ]
        }
    ]
