    "talks": [
        {
            "id": "7114901",
            "objective": "Fale com Pingxi",
            "dialogues": [
                {
                    "id": "711490101",
                    "speaker": "Pingxi",
                    "text": "Os preparativos deste ano devem estar em ordem. Ufa... Pelo menos não vou precisar incomodar a Srta. Keqing para vir revisar as contas pessoalmente."
                },
                {
                    "id": "711490116",
                    "speaker": "Pingxi",
                    "text": "Aff! Eu não posso pensar em coisas assim! Eu sou o Deus da Fortuna, eu sou o Deus da Fortuna, eu sou o Deus da Fortuna..."
                },
                {
                    "id": "711490103",
                    "speaker": "Player",
                    "text": "E você é...?"
                },
                {
                    "id": "711490117",
                    "speaker": "Pingxi",
                    "text": "Eu sou o Deus da Fortuna!",
                    "choices": [
                        {
                            "id": "711490118",
                            "text": "Eu... Eu notei...",
                            "response": [
                                {
                                    "id": "711490120",
                                    "speaker": "Pingxi",
                                    "text": "#Hã? Não é {NICKNAME}? Nossa, se eu soubesse que era você que vinha, não teria decorado tantas falas..."
                                },
                                {
                                    "id": "711490121",
                                    "speaker": "Pingxi",
                                    "text": "E, pelo que estou vendo, imagino que você veio celebrar o Ritual de Lanternas?"
                                },
                                {
                                    "id": "711490122",
                                    "speaker": "Pingxi",
                                    "text": "Já era hora de você aparecer! Olha só o clima, não está bem mais animado que o do Ritual de Lanternas do ano passado?",
                                    "choices": [
                                        {
                                            "id": "711490123",
                                            "text": "Todo Ritual de Lanternas...",
                                            "response": [
                                                {
                                                    "id": "711490125",
                                                    "speaker": "Pingxi",
                                                    "text": "Claro! Você sabe o que dizem, \"Lanternas Celestes sobem e preenchem a noite, passo a passo buscamos novas alturas!\" Temos que melhorar em tudo o que fazemos."
                                                },
                                                {
                                                    "id": "711490126",
                                                    "speaker": "Pingxi",
                                                    "text": "Ai, vamos não ficar pensando nisso bem no meio da festa. Venha, venha, deixa eu te mostrar onde está a diversão."
                                                },
                                                {
                                                    "id": "711490127",
                                                    "speaker": "Pingxi",
                                                    "text": "Deixe-me pensar... Hm... Já sei! Primeiro de tudo, você tem que soltar Lanternas Celestes, claro. Afinal, é o Ritual de Lanternas."
                                                },
                                                {
                                                    "id": "711490128",
                                                    "speaker": "Pingxi",
                                                    "text": "E então, também montamos um monte de Árvores de Tesouro da Fortuna espalhadas pelo Porto de Liyue. Se você podar os galhos direitinho, as Moedas da Fortuna lá dentro são suas."
                                                },
                                                {
                                                    "id": "711490129",
                                                    "speaker": "Pingxi",
                                                    "text": "Quantas árvores foram mesmo que nós... Eram 21? Isso, 21 árvores."
                                                },
                                                {
                                                    "id": "711490130",
                                                    "speaker": "Pingxi",
                                                    "text": "Na verdade, tem uma Árvore do Tesouro Fortuito não muito longe daqui! Se você tiver interesse, pode ajudar a podar. Não se preocupe, é bem simples."
                                                },
                                                {
                                                    "id": "711490131",
                                                    "speaker": "Pingxi",
                                                    "text": "E, por fim, você também pode dar uma olhada no Quadro de Avisos. Ele fica bem aqui ao meu lado."
                                                },
                                                {
                                                    "id": "711490132",
                                                    "speaker": "Pingxi",
                                                    "text": "Muitos turistas de outras nações têm vindo participar do Ritual de Lanternas nos últimos anos, então o Ministério dos Assuntos Civis preparou um Quadro de Avisos especial para eles."
                                                },
                                                {
                                                    "id": "711490102",
                                                    "speaker": "Pingxi",
                                                    "text": "Seja qual for o problema que tiverem, ou qualquer questão que precisem resolver, eles podem escrever e afixar no Quadro de Avisos."
                                                },
                                                {
                                                    "id": "711490133",
                                                    "speaker": "Pingxi",
                                                    "text": "Nós, do Ministério dos Assuntos Civis, prometemos que todos que celebrarem o Ritual de Lanternas em Liyue vão voltar para casa sorrindo, hehe!",
                                                    "choices": [
                                                        {
                                                            "id": "711490134",
                                                            "text": "O Ministério dos Assuntos Civis é mesmo confiável!",
                                                            "response": [
                                                                {
                                                                    "id": "711490136",
                                                                    "speaker": "Pingxi",
                                                                    "text": "Ah, claro!"
                                                                },
                                                                {
                                                                    "id": "711490137",
                                                                    "speaker": "Pingxi",
                                                                    "text": "#Enfim, {NICKNAME}, eu lembro que você manda muito bem tirando fotos, não manda?",
                                                                    "choices": [
                                                                        {
                                                                            "id": "711490138",
                                                                            "text": "Eu entendo um pouco do assunto.",
                                                                            "response": [
                                                                                {
                                                                                    "id": "711490140",
                                                                                    "speaker": "Pingxi",
                                                                                    "text": "Hahaha, não se menospreze assim. Eu só queria... te pedir um pequeno favor."
                                                                                },
                                                                                {
                                                                                    "id": "711490141",
                                                                                    "speaker": "Pingxi",
                                                                                    "text": "É super simples, eu prometo! Tudo o que você precisa fazer é tirar uma foto comemorativa para alguns turistas."
                                                                                },
                                                                                {
                                                                                    "id": "711490142",
                                                                                    "speaker": "Pingxi",
                                                                                    "text": "Nós até contratamos alguns fotógrafos para tirar fotos comemorativas para todo mundo, mas não esperávamos que houvesse tantos turistas este ano. De repente, não havia fotógrafos suficientes para dar conta de todos."
                                                                                },
                                                                                {
                                                                                    "id": "711490143",
                                                                                    "speaker": "Pingxi",
                                                                                    "text": "#Já é tarde demais para contratar novos fotógrafos... Você é a única pessoa em quem posso confiar, {NICKNAME}!"
                                                                                },
                                                                                {
                                                                                    "id": "711490144",
                                                                                    "speaker": "Pingxi",
                                                                                    "text": "Por favor! Pelos turistas, pelo Ritual de Lanternas, por Liyue! Você é a única pessoa que pode nos ajudar!",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "711490145",
                                                                                            "text": "Deixa comigo!",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "711490147",
                                                                                                    "speaker": "Pingxi",
                                                                                                    "text": "#Você salvou minha pele, {NICKNAME}! Vou te passar os nomes dos turistas e dos locais combinados agora mesmo."
                                                                                                },
                                                                                                {
                                                                                                    "id": "711490148",
                                                                                                    "speaker": "Pingxi",
                                                                                                    "text": "Vou deixar isso por sua conta! Com a sua ajuda, o Ritual de Lanternas deste ano vai ser perfeito."
                                                                                                },
                                                                                                {
                                                                                                    "id": "711490149",
                                                                                                    "speaker": "Pingxi",
                                                                                                    "text": "Estas Lanternas Celestes são para você! Hehe, feliz Ritual de Lanternas!"
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "711490146",
                                                                                            "text": "Pelo Ritual de Lanternas!"
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "711490139",
                                                                            "text": "Eu não entendo nada disso."
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "711490135",
                                                            "text": "Liyue é mesmo confiável..."
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "711490124",
                                            "text": "Parece mais impressionante que o do ano anterior..."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "711490119",
                            "text": "Essa é uma roupa bem auspiciosa..."
                        }
                    ]
                }
            ]
        }
    ]
