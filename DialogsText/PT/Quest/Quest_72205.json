    "talks": [
        {
            "id": "7220501",
            "objective": "",
            "dialogues": [
                {
                    "id": "722050101",
                    "speaker": "Kito",
                    "text": "Hã. Engraçado. Eu tinha certeza que estava em meu bolso...",
                    "choices": [
                        {
                            "id": "722050102",
                            "text": "Olá.",
                            "response": [
                                {
                                    "id": "722050104",
                                    "speaker": "Kina",
                                    "text": "Isso não vai servir, deveríamos levar à vovó Una..."
                                },
                                {
                                    "id": "722050105",
                                    "speaker": "Kito",
                                    "text": "Ela já está bem idosa e não consegue mais se lembrar claramente de muita coisa. Recentemente, ela começou a falar das coisas que aconteceram com ela quando ainda era jovem."
                                },
                                {
                                    "id": "722050106",
                                    "speaker": "Kina",
                                    "text": "Ela sempre está falando sobre flores isto e flores aquilo... Ela até disse que eram flores do além do Mar de Névoa, que eram ao mesmo tempo diferentes e muito bonitas..."
                                },
                                {
                                    "id": "722050107",
                                    "speaker": "Kito",
                                    "text": "Mas então um dia tive um sonho ... Sonhei que o nevoeiro da ilha desapareceu. \"Uau\", disse a mim mesmo, enquanto do outro lado do mar se erguia uma gigantesca e bela casa. Mas essa casa não era de madeira, nem de ouro..."
                                },
                                {
                                    "id": "722050108",
                                    "speaker": "Kina",
                                    "text": "Eu também, eu também!"
                                },
                                {
                                    "id": "722050109",
                                    "speaker": "Kito",
                                    "text": "Nesse sonho, eu escalava uma montanha muito alta, e depois escalava uma árvore enorme para colher muitas flores... Nunca vi as flores de que a vovó Una falou, mas tenho certeza de que eram aquelas..."
                                },
                                {
                                    "id": "722050110",
                                    "speaker": "Kito",
                                    "text": "Mas as flores eram pesadas demais e eu caí da árvore. Caí sem parar... até que acordei do sonho."
                                },
                                {
                                    "id": "722050111",
                                    "speaker": "Kina",
                                    "text": "Unf! Isso porque você é muito ganancioso! Eu disse várias vezes que era o suficiente, por sua culpa caí com você..."
                                },
                                {
                                    "id": "722050112",
                                    "speaker": "Kito",
                                    "text": "A bolsa está vazia... Não temos absolutamente nada. Como podemos voltar para a vovó Una de mãos vazias?"
                                }
                            ]
                        },
                        {
                            "id": "722050103",
                            "text": "Precisa de alguma ajuda?"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7220502",
            "objective": "",
            "dialogues": [
                {
                    "id": "722050201",
                    "speaker": "Kito",
                    "text": "O que faremos agora...?"
                },
                {
                    "id": "722050202",
                    "speaker": "Kina",
                    "text": "Pensaremos em algo..."
                }
            ]
        },
        {
            "id": "7220503",
            "objective": "",
            "dialogues": [
                {
                    "id": "722051301",
                    "speaker": "Kito",
                    "text": "São essas flores daqui! São iguais as do meu sonho!"
                },
                {
                    "id": "722051302",
                    "speaker": "Kina",
                    "text": "#Obrigada, {NICKNAME}!"
                },
                {
                    "id": "722051303",
                    "speaker": "Kina",
                    "text": "Kito, quando formos ver como a Vovó Una está, vamos para a praia do leste para brincar! Nós podemos ver o santuário claramente de lá!"
                },
                {
                    "id": "722051304",
                    "speaker": "Kito",
                    "text": "É o Santuário Chirai..."
                }
            ]
        },
        {
            "id": "7220512",
            "objective": "",
            "dialogues": [
                {
                    "id": "722050301",
                    "speaker": "Kito",
                    "text": "#Olá, {NICKNAME}!",
                    "choices": [
                        {
                            "id": "722050302",
                            "text": "Olá.",
                            "response": [
                                {
                                    "id": "722050304",
                                    "speaker": "Kito",
                                    "text": "Obrigado por escolher aquelas flores para mim da última vez! Mas... sempre sinto algo estranho perto de mim..."
                                },
                                {
                                    "id": "722050305",
                                    "speaker": "Kina",
                                    "text": "Sim, eu também sinto..."
                                },
                                {
                                    "id": "722050306",
                                    "speaker": "Kito",
                                    "text": "Onde quer que eu vá, sempre encontro pessoas infelizes, como se não pudessem ouvir o que os outros estão dizendo..."
                                },
                                {
                                    "id": "722050307",
                                    "speaker": "Kina",
                                    "text": "Além disso, sempre que encontro uma flor bonita e a coloco na minha bolsa, ela desaparece instantaneamente...",
                                    "choices": [
                                        {
                                            "id": "722050308",
                                            "text": "Isso é porque...",
                                            "response": [
                                                {
                                                    "id": "722050310",
                                                    "speaker": "Kito",
                                                    "text": "Mesmo? Eu não entendi muito bem..."
                                                },
                                                {
                                                    "id": "722050311",
                                                    "speaker": "Kina",
                                                    "text": "Vamos partir?"
                                                },
                                                {
                                                    "id": "722050312",
                                                    "speaker": "Kito",
                                                    "text": "Aquele tio dourado também disse algo assim... Mas nós ainda não podemos ir com ele."
                                                },
                                                {
                                                    "id": "722050313",
                                                    "speaker": "Kina",
                                                    "text": "Ainda temos que ir levar uma flor bonita para a Vovó Una!"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "722050309",
                                            "text": "É hora de partir."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "722050303",
                            "text": "Parecem muito animados."
                        }
                    ]
                }
            ]
        },
        {
            "id": "7220504",
            "objective": "",
            "dialogues": [
                {
                    "id": "722050401",
                    "speaker": "Kito",
                    "text": "Eu ainda não posso partir."
                },
                {
                    "id": "722050402",
                    "speaker": "Kina",
                    "text": "Se Kito vai ficar, eu também não quero partir."
                }
            ]
        },
        {
            "id": "7220505",
            "objective": "",
            "dialogues": [
                {
                    "id": "722051501",
                    "speaker": "Kito",
                    "text": "Obrigado! Vamos levar essas flores daqui para a Vovó Una."
                },
                {
                    "id": "722051502",
                    "speaker": "Kina",
                    "text": "Kito, divida metade delas comigo!"
                },
                {
                    "id": "722051503",
                    "speaker": "Kito",
                    "text": "Vamos para um dos lados da montanha! Eu sei de um lugar divertido ali na Planície Autake!"
                },
                {
                    "id": "722051504",
                    "speaker": "Kina",
                    "text": "Chise vai ficar tão irritado com a gente... Mas tanto faz, eu quero ir também!"
                }
            ]
        },
        {
            "id": "7220513",
            "objective": "",
            "dialogues": [
                {
                    "id": "722050501",
                    "speaker": "Kito",
                    "text": "Nos encontramos aqui novamente!"
                },
                {
                    "id": "722050502",
                    "speaker": "Kina",
                    "text": "Nos encontramos novamente!",
                    "choices": [
                        {
                            "id": "722050503",
                            "text": "Olá!",
                            "response": [
                                {
                                    "id": "722050505",
                                    "speaker": "Kito",
                                    "text": "#Hehe, eu ainda estou aqui sim! Falando nisso, {F#tia}{M#tio}, você sabe para o que se usam essas pedras?"
                                },
                                {
                                    "id": "722050506",
                                    "speaker": "Kina",
                                    "text": "Hmph, Kito sabe de tudo!",
                                    "choices": [
                                        {
                                            "id": "722050507",
                                            "text": "Não sei.",
                                            "response": [
                                                {
                                                    "id": "722050509",
                                                    "speaker": "Kito",
                                                    "text": "Ouvi Vovô Tasuku dizer que essas são lápides usadas para atrair os espíritos dos mortos... Aqueles que se perderam após morrerem e ficaram aqui serão atraídos por essas pedras e acordarão de seu sonho aqui."
                                                },
                                                {
                                                    "id": "722050510",
                                                    "speaker": "Kito",
                                                    "text": "Depois, vagueiam pela ilha... em busca de alguém que possa ajudar eles a concretizarem seus desejos. Assim que encontram esse alguém, eles o seguem até que seus desejos sejam realizados para então o barqueiro finalmente os levar embora..."
                                                },
                                                {
                                                    "id": "722050511",
                                                    "speaker": "Kito",
                                                    "text": "Alguns espíritos são bons e outros maus... Então, quem perambula na névoa à noite deve revelar seu nome e seu clã em voz alta na frente da pedra!"
                                                },
                                                {
                                                    "id": "722050512",
                                                    "speaker": "Kito",
                                                    "text": "Afinal de contas, aqueles que sabem quem são seus antepassados podem ter muito mais confiança do que alguns fantasmas solitários. Quando souberem de onde você veio, eles se afastarão silenciosamente e não te incomodarão mais!"
                                                },
                                                {
                                                    "id": "722050513",
                                                    "speaker": "Kito",
                                                    "text": "#Uh... O problema é que, você é {M#um forasteiro}{F#uma forasteira} não é? Eu não acho que você tenha nenhum clã para anunciar..."
                                                },
                                                {
                                                    "id": "722050514",
                                                    "speaker": "Kina",
                                                    "text": "Uh oh, isso é verdade. O que você vai fazer se encontrar um espírito ruim?"
                                                },
                                                {
                                                    "id": "722050515",
                                                    "speaker": "Kito",
                                                    "text": "Hehe, não tem problema. Não há porque ter medo, eu lhe protegerei!"
                                                },
                                                {
                                                    "id": "722050516",
                                                    "speaker": "Kina",
                                                    "text": "Kina também estará junto para assustar os espíritos maus!"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "722050508",
                                            "text": "Para que elas servem?"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "722050504",
                            "text": "Você ainda está na ilha."
                        }
                    ]
                }
            ]
        },
        {
            "id": "7220506",
            "objective": "",
            "dialogues": [
                {
                    "id": "722050601",
                    "speaker": "Kito",
                    "text": "Também existem grandes cogumelos fluorescentes em outras ilhas?"
                },
                {
                    "id": "722050602",
                    "speaker": "Kina",
                    "text": "Eles com certeza não são bonitos que nem os que plantamos em nossa casa!"
                }
            ]
        },
        {
            "id": "7220507",
            "objective": "",
            "dialogues": [
                {
                    "id": "722051701",
                    "speaker": "Kito",
                    "text": "Oh, você lembrou! Obrigado!"
                },
                {
                    "id": "722051702",
                    "speaker": "Kina",
                    "text": "Obrigada!"
                },
                {
                    "id": "722051703",
                    "speaker": "Kina",
                    "text": "Vamos para o rio do sul para pegar algumas conchas! Até mais!"
                },
                {
                    "id": "722051704",
                    "speaker": "Kito",
                    "text": "Kina, não mergulhe no rio! É muito perigoso!"
                }
            ]
        },
        {
            "id": "7220514",
            "objective": "",
            "dialogues": [
                {
                    "id": "722050701",
                    "speaker": "Kito",
                    "text": "#{F#Tia}{M#Tio}, nos encontramos de novo."
                },
                {
                    "id": "722050702",
                    "speaker": "Kina",
                    "text": "Se Kito não quiser falar hoje...",
                    "choices": [
                        {
                            "id": "722050703",
                            "text": "Qual o problema?",
                            "response": [
                                {
                                    "id": "722050705",
                                    "speaker": "Kito",
                                    "text": "Não é nada... Só estou brincando sozinho, não precisa se preocupar comigo."
                                },
                                {
                                    "id": "722050706",
                                    "speaker": "Kina",
                                    "text": "#{F#Tia}{M#Tio}, é que... Ele está assim de novo... Irritado sozinho.",
                                    "choices": [
                                        {
                                            "id": "722050707",
                                            "text": "O que aconteceu?",
                                            "response": [
                                                {
                                                    "id": "722050709",
                                                    "speaker": "Kina",
                                                    "text": "#Kito, não fique irritado com {F#uma forasteira}{M#um forasteiro}..."
                                                },
                                                {
                                                    "id": "722050710",
                                                    "speaker": "Kito",
                                                    "text": "..."
                                                },
                                                {
                                                    "id": "722050711",
                                                    "speaker": "Kito",
                                                    "text": "Me desculpe, eu não deveria ficar irritado com você.",
                                                    "choices": [
                                                        {
                                                            "id": "722050712",
                                                            "text": "Não tem problema.",
                                                            "response": [
                                                                {
                                                                    "id": "722050714",
                                                                    "speaker": "Kito",
                                                                    "text": "Esse tio dourado está nos importunando de novo para embarcar... Disse que é para ir para um local sem nevoeiro e com uma casa dourada brilhante. Eu não quero ir, quero ficar com a Vovó Una!"
                                                                },
                                                                {
                                                                    "id": "722050715",
                                                                    "speaker": "Kina",
                                                                    "text": "Ele não quer brincar com a gente, e não fala nada de interessante, só fica nos dizendo para irmos... Que irritante..."
                                                                },
                                                                {
                                                                    "id": "722050716",
                                                                    "speaker": "Kito",
                                                                    "text": "Não é que não possamos ir... Só temos medo que a Vovó Una se preocupe..."
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "722050713",
                                                            "text": "Diga-me o que está acontecendo."
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "722050708",
                                            "text": "Posso ajudar?"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "722050704",
                            "text": "Você não parece muito feliz."
                        }
                    ]
                }
            ]
        },
        {
            "id": "7220508",
            "objective": "",
            "dialogues": [
                {
                    "id": "722050801",
                    "speaker": "Kito",
                    "text": "Mas não tem problema para mim, não tem nada de errado brincar sozinho."
                },
                {
                    "id": "722050802",
                    "speaker": "Kina",
                    "text": "Hehe, eu também estou aqui!"
                }
            ]
        },
        {
            "id": "7220509",
            "objective": "",
            "dialogues": [
                {
                    "id": "722051901",
                    "speaker": "Kito",
                    "text": "#Obrigado, {F#tia}{M#tio}!"
                },
                {
                    "id": "722051902",
                    "speaker": "Kina",
                    "text": "Muto obrigada!"
                },
                {
                    "id": "722051903",
                    "speaker": "Kina",
                    "text": "Vamos lá, Kito, eu conheço um ótimo lugar onde podemos ir nos aventurar! Há um buraco na montanha ao lado norte do Monte Senna. É um segredo e tudo mais!"
                },
                {
                    "id": "722051904",
                    "speaker": "Kito",
                    "text": "Se chama Monte Kanna..."
                }
            ]
        },
        {
            "id": "7220515",
            "objective": "",
            "dialogues": [
                {
                    "id": "722050901",
                    "speaker": "Kito",
                    "text": "#Oh, olá, {F#tia}{M#tio} {NICKNAME}!"
                },
                {
                    "id": "722050902",
                    "speaker": "Kina",
                    "text": "#Olá, {NICKNAME}!",
                    "choices": [
                        {
                            "id": "722050903",
                            "text": "Olá, Kito e Kina!",
                            "response": [
                                {
                                    "id": "722050905",
                                    "speaker": "Kito",
                                    "text": "Obrigado, mas não preciso de nada desta vez... Nós vamos sair daqui e ir para um local que não tem nevoeiro."
                                },
                                {
                                    "id": "722050906",
                                    "speaker": "Kina",
                                    "text": "Para uma grande casa dourada brilhante! Vamos embarcar no navio e zarpar!"
                                },
                                {
                                    "id": "722050907",
                                    "speaker": "Kito",
                                    "text": "Mas antes de irmos, quero lhe agradecer... Se não for um incômodo, por favor, entregue isso para a Vovó Una."
                                },
                                {
                                    "id": "722050908",
                                    "speaker": "Kina",
                                    "text": "Basta levar isso para ela, ela relaxará e virá conosco!"
                                },
                                {
                                    "id": "722050909",
                                    "speaker": "Kito",
                                    "text": "#É a última vez que lhe peço algo, {F#tia}{M#tio}!"
                                },
                                {
                                    "id": "722050910",
                                    "speaker": "Kina",
                                    "text": "#Obrigada, {NICKNAME}."
                                }
                            ]
                        },
                        {
                            "id": "722050904",
                            "text": "Você ainda precisa de Pétalas da Flor de Sakura?"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7220512",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "722051201",
                    "speaker": "Kito",
                    "text": "#{NICKNAME}, você voltou!"
                },
                {
                    "id": "722051202",
                    "speaker": "Player",
                    "text": "Essas flores daqui são suficientes?"
                }
            ]
        },
        {
            "id": "7220514",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "722051401",
                    "speaker": "Kito",
                    "text": "Ainda não posso partir..."
                },
                {
                    "id": "722051402",
                    "speaker": "Player",
                    "text": "São essas as flores que você quer?"
                }
            ]
        },
        {
            "id": "7220516",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "722051601",
                    "speaker": "Kito",
                    "text": "A parte próxima do rio, hey! O carvalho dourado está lá, hoi! O dourado... Uh, o que era mais que era dourado mesmo..."
                },
                {
                    "id": "722051602",
                    "speaker": "Kina",
                    "text": "Um peixe dourado...? Porque peixe é muito gostoso..."
                },
                {
                    "id": "722051603",
                    "speaker": "Player",
                    "text": "Eu trouxe a flor que você queria."
                }
            ]
        },
        {
            "id": "7220518",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "722051801",
                    "speaker": "Kito",
                    "text": "Você precisa de algo?"
                },
                {
                    "id": "722051802",
                    "speaker": "Kina",
                    "text": "#{F#Tia}{M#Tio}, você trouxe algo legal?"
                },
                {
                    "id": "722051803",
                    "speaker": "Player",
                    "text": "São essas as flores que você quer?"
                }
            ]
        }
    ]
