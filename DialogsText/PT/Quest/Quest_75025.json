    "talks": [
        {
            "id": "7502501",
            "objective": "",
            "dialogues": [
                {
                    "id": "750250101",
                    "speaker": "Paimon",
                    "text": "Eita, que lugar misterioso é esse? Tantos pequenos Tepetlissauros..."
                },
                {
                    "id": "750250102",
                    "speaker": "Paimon",
                    "text": "Poderia ser algum tipo de... local de reunião de Tepetlissauros?"
                },
                {
                    "id": "750250103",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "Rawr! ...Rrrawr?"
                },
                {
                    "id": "750250104",
                    "speaker": "Paimon",
                    "text": "#{REALNAME[ID(2)|SHOWHOST(true)]} parece tão animado! Não é sempre que você pode conhecer tantos companheiros de uma vez, né?"
                },
                {
                    "id": "750250105",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "Rawr?"
                },
                {
                    "id": "750250106",
                    "speaker": "Paimon",
                    "text": "#Oh, você quer dizer que quer ir lá brincar com eles? Pensando nisso, {REALNAME[ID(2)|SHOWHOST(true)]} dificilmente anda com outros Tepetlissauros..",
                    "choices": [
                        {
                            "id": "750250107",
                            "text": "Tenha cuidado, certo?",
                            "response": [
                                {
                                    "id": "750250109",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "Rawr!"
                                },
                                {
                                    "id": "750250110",
                                    "speaker": "Paimon",
                                    "text": "#Uh, Paimon ainda tá um pouco preocupada... Enfim, vamos encontrar um lugar para relaxar e comer algo enquanto esperamos {REALNAME[ID(2)|SHOWHOST(true)]}."
                                },
                                {
                                    "id": "750250111",
                                    "speaker": "Black Screen",
                                    "text": "#Você e Paimon encontram um lugar confortável para descansar enquanto {REALNAME[ID(2)|SHOWHOST(true)]} termina de brincar."
                                },
                                {
                                    "id": "750250112",
                                    "speaker": "Black Screen",
                                    "text": "Mas vocês acabam esperando mais do que esperado..."
                                },
                                {
                                    "id": "750250113",
                                    "speaker": "Paimon",
                                    "text": "#Estranho... Como que {REALNAME[ID(2)|SHOWHOST(true)]} ainda não voltou?"
                                },
                                {
                                    "id": "750250114",
                                    "speaker": "Paimon",
                                    "text": "Paimon espera mesmo que nada ruim tenha acontecido..."
                                },
                                {
                                    "id": "750250115",
                                    "speaker": "Player",
                                    "text": "Talvez se deixaram levar na diversão?"
                                },
                                {
                                    "id": "750250116",
                                    "speaker": "Paimon",
                                    "text": "Se for o caso, temos que dar um belo sermão nele. O sol está quase se pondo!"
                                },
                                {
                                    "id": "750250117",
                                    "speaker": "Paimon",
                                    "text": "Urg... Vamos procurar por ele antes que fique tão escuro que não conseguimos ver."
                                }
                            ]
                        },
                        {
                            "id": "750250108",
                            "text": "Não suma por muito tempo!"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7502504",
            "objective": "Vá procurar o parceiro Sauriano que ainda não voltou",
            "dialogues": []
        },
        {
            "id": "7502506",
            "objective": "",
            "dialogues": [
                {
                    "id": "750250601",
                    "speaker": "Paimon",
                    "text": "#Oi! Você não viu {REALNAME[ID(2)|SHOWHOST(true)]} por aqui, não é? Sabe, o novo no pedaço...?"
                },
                {
                    "id": "750250602",
                    "speaker": "Paimon",
                    "text": "Tem uma marca em sua cabeça e um lenço na sua cauda..."
                },
                {
                    "id": "750250603",
                    "speaker": "Tepetlissauro Tonto Pequeno",
                    "text": "Rrrawr?"
                },
                {
                    "id": "750250604",
                    "speaker": "Paimon",
                    "text": "Hmm, parece que ele não entende o que estamos dizendo."
                },
                {
                    "id": "750250605",
                    "speaker": "Paimon",
                    "text": "Parece que não temos escolha senão passar um por um..."
                }
            ]
        },
        {
            "id": "7502507",
            "objective": "",
            "dialogues": [
                {
                    "id": "750250701",
                    "speaker": "Paimon",
                    "text": "Dê uma olhada nesse pequeno Tepetlissauro... Esse certamente sabe escolher um lugar para si!"
                },
                {
                    "id": "750250702",
                    "speaker": "Paimon",
                    "text": "#Não, não deve ser {REALNAME[ID(2)|SHOWHOST(true)]} também. Não tem um lenço na sua cauda."
                },
                {
                    "id": "750250703",
                    "speaker": "Tepetlissauro Escalador de Árvore Pequeno",
                    "text": "Rrrawr?"
                }
            ]
        },
        {
            "id": "7502508",
            "objective": "",
            "dialogues": [
                {
                    "id": "750250801",
                    "speaker": "Paimon",
                    "text": "Ei, se por acaso você viu..."
                },
                {
                    "id": "750250802",
                    "speaker": "Black Screen",
                    "text": "#Paimon conta ao pequeno Tepetlissauro de aparência inteligente como {REALNAME[ID(2)|SHOWHOST(true)]} se parece."
                },
                {
                    "id": "750250803",
                    "speaker": "Tepetlissauro Inteligente Pequeno",
                    "text": "Rawr!"
                },
                {
                    "id": "750250804",
                    "speaker": "Tepetlissauro Inteligente Pequeno",
                    "text": "Rawr!!"
                },
                {
                    "id": "750250805",
                    "speaker": "Paimon",
                    "text": "#Espera um minuto, isso significa que você sabe que estamos procurando por {REALNAME[ID(2)|SHOWHOST(true)]}? Você realmente é bem sabichão, hein?"
                },
                {
                    "id": "750250806",
                    "speaker": "Paimon",
                    "text": "Vamos, vamos alcançá-lo!"
                }
            ]
        },
        {
            "id": "7502514",
            "objective": "",
            "dialogues": [
                {
                    "id": "750250501",
                    "speaker": "Paimon",
                    "text": "#Uau, tantas bagas... Obrigada! Espera aí, estamos procurando por {REALNAME[ID(2)|SHOWHOST(true)]}, não bagas!"
                },
                {
                    "id": "750250502",
                    "speaker": "Tepetlissauro Inteligente Pequeno",
                    "text": "Rrrawr?",
                    "choices": [
                        {
                            "id": "750250503",
                            "text": "Enfim, agradecemos!",
                            "response": [
                                {
                                    "id": "750250505",
                                    "speaker": "Tepetlissauro Inteligente Pequeno",
                                    "text": "Rawr!"
                                },
                                {
                                    "id": "750250506",
                                    "speaker": "Paimon",
                                    "text": "#Bem, receber bagas nunca é algo ruim, mas parece que {REALNAME[ID(2)|SHOWHOST(true)]} não está aqui. Vamos continuar procurando!"
                                }
                            ]
                        },
                        {
                            "id": "750250504",
                            "text": "Não somos do tipo de recusar bagas!"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7502509",
            "objective": "",
            "dialogues": [
                {
                    "id": "750250901",
                    "speaker": "Paimon",
                    "text": "Tudo bem, parece que temos um pequeno Tepetlissauro cavando pelo subsolo. Isso tem que ser—"
                },
                {
                    "id": "750250902",
                    "speaker": "Tepetlissauro em Treino Pequeno",
                    "text": "?"
                },
                {
                    "id": "750250903",
                    "speaker": "Paimon",
                    "text": "#Argh, isso também não é {REALNAME[ID(2)|SHOWHOST(true)]}..."
                },
                {
                    "id": "750250904",
                    "speaker": "Paimon",
                    "text": "#Urg, como é que tem tantos pequenos Tepetlissauros por aqui... Onde {REALNAME[ID(2)|SHOWHOST(true)]} foi parar?"
                }
            ]
        },
        {
            "id": "7502510",
            "objective": "",
            "dialogues": [
                {
                    "id": "750251001",
                    "speaker": "Paimon",
                    "text": "Olá, como você..."
                },
                {
                    "id": "750251002",
                    "speaker": "Paimon",
                    "text": "Hmm, espera um segundo... Por que Paimon começou a falar com o Tepetlissauro pequeno assim do nada?"
                },
                {
                    "id": "750251003",
                    "speaker": "Tepetlissauro Animado Pequeno",
                    "text": "Rawr! Rawr!"
                },
                {
                    "id": "750251004",
                    "speaker": "Player",
                    "text": "Que Paimon educada!"
                },
                {
                    "id": "750251005",
                    "speaker": "Paimon",
                    "text": "Hehe, obrigada..."
                },
                {
                    "id": "750251006",
                    "speaker": "Paimon",
                    "text": "#Mas, voltando ao assunto, esse Tepetlissauro pequeno claramente não é {REALNAME[ID(2)|SHOWHOST(true)]}..."
                },
                {
                    "id": "750251007",
                    "speaker": "Paimon",
                    "text": "#Bem, vamos só esperar que {REALNAME[ID(2)|SHOWHOST(true)]} esteja se divertindo tanto quanto esse carinha."
                }
            ]
        },
        {
            "id": "7502511",
            "objective": "",
            "dialogues": [
                {
                    "id": "750251101",
                    "speaker": "Paimon",
                    "text": "Aha! Então você tava aqui só no cochilo! Por isso a gente não conseguia te encontrar esse tempo todo..."
                },
                {
                    "id": "750251102",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "Wrroh..."
                },
                {
                    "id": "750251103",
                    "speaker": "Paimon",
                    "text": "Parece que você se divertiu tanto que se cansou completamente."
                },
                {
                    "id": "750251104",
                    "speaker": "Paimon",
                    "text": "Mas o mundo é um lugar perigoso, sabe! Se você começar a sentir sono ou precisar descansar, tem que vir encontrar a gente primeiro...",
                    "choices": [
                        {
                            "id": "750251105",
                            "text": "Eu te disse para ter cuidado...",
                            "response": [
                                {
                                    "id": "750251107",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "Rowr..."
                                },
                                {
                                    "id": "750251108",
                                    "speaker": "Paimon",
                                    "text": "Tá bom, tá bom... Não há nada de errado em se divertir de vez em quando. Mas tenha mais cuidado no futuro, ouviu?"
                                },
                                {
                                    "id": "750251109",
                                    "speaker": "Paimon",
                                    "text": "Enfim, por que não vamos dar oi para aquele Tepetlissauro grandão ali? Quem sabe, podemos ter outra chance de andar com eles em outro lugar no futuro!"
                                },
                                {
                                    "id": "750251110",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "Rawr!"
                                }
                            ]
                        },
                        {
                            "id": "750251106",
                            "text": "Eu disse para não sumir por tanto tempo..."
                        }
                    ]
                }
            ]
        },
        {
            "id": "7502512",
            "objective": "Despeça-se do Grande Tepetlissauro",
            "dialogues": [
                {
                    "id": "750251201",
                    "speaker": "Tepetlissauro Fraternal Grande",
                    "text": "Rrrawr?"
                },
                {
                    "id": "750251202",
                    "speaker": "Paimon",
                    "text": "#Obrigada por cuidar de {REALNAME[ID(2)|SHOWHOST(true)]} esse tempo todo!"
                },
                {
                    "id": "750251203",
                    "speaker": "Tepetlissauro Fraternal Grande",
                    "text": "Rowr..."
                },
                {
                    "id": "750251204",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "Rawr!"
                },
                {
                    "id": "750251205",
                    "speaker": "Paimon",
                    "text": "Hmmm, bem... O que quer que eles tenham dito, Paimon entendeu foi nada."
                },
                {
                    "id": "750251206",
                    "speaker": "Paimon",
                    "text": "#De qualquer forma, está na hora de partirmos. Diga adeus, {REALNAME[ID(2)|SHOWHOST(true)]}!"
                },
                {
                    "id": "750251207",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "Rowr..."
                },
                {
                    "id": "750251208",
                    "speaker": "Player",
                    "text": "Não fique triste, a gente vai ver eles de novo!"
                },
                {
                    "id": "750251209",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "Rowrrr... Rawr!"
                },
                {
                    "id": "750251210",
                    "speaker": "Tepetlissauro Fraternal Grande",
                    "text": "Wrroh..."
                },
                {
                    "id": "750251211",
                    "speaker": "Tepetlissauro Fraternal Grande",
                    "text": "Raaaarrr—"
                },
                {
                    "id": "750251212",
                    "speaker": "Tepetlissauro Pequeno",
                    "text": "Rawr!"
                },
                {
                    "id": "750251213",
                    "speaker": "Tepetlissauro Pequeno",
                    "text": "Rawr, rrwar..."
                },
                {
                    "id": "750251214",
                    "speaker": "Tepetlissauro Fraternal Grande",
                    "text": "Wrroh..."
                },
                {
                    "id": "750251215",
                    "speaker": "Black Screen",
                    "text": "Parece que chegou a hora dos Saurianos voltarem para o ninho. O Grande Tepetlissauro se virou... \\nE os Tepetlissauros pequenos o seguiram, indo embora juntos."
                },
                {
                    "id": "750251216",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "Rawrrr..."
                },
                {
                    "id": "750251217",
                    "speaker": "Paimon",
                    "text": "#Awn, você não está se sentindo sozinho, né, {REALNAME[ID(2)|SHOWHOST(true)]}?"
                },
                {
                    "id": "750251218",
                    "speaker": "Paimon",
                    "text": "Hehe, não esqueça que estamos aqui do seu lado!"
                },
                {
                    "id": "750251219",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "Rowrr, rawr!"
                }
            ]
        },
        {
