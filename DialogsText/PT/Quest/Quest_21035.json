    "talks": [
        {
            "id": "2103501",
            "objective": "Fale com Sun Yu",
            "dialogues": [
                {
                    "id": "210350101",
                    "speaker": "Sun Yu",
                    "text": "*Suspiro* Que'er...",
                    "choices": [
                        {
                            "id": "210350102",
                            "text": "Sun Yu?",
                            "response": [
                                {
                                    "id": "210350104",
                                    "speaker": "Sun Yu",
                                    "text": "Viajante? Que coincidência! Eu não esperava te ver por aqui..."
                                },
                                {
                                    "id": "210350105",
                                    "speaker": "Sun Yu",
                                    "text": "Eu... eu estou treinando por aqui, e estou prestes a sair de Liyue para viajar pelo exterior.",
                                    "choices": [
                                        {
                                            "id": "210350106",
                                            "text": "Qual é a da viagem do nada?",
                                            "response": [
                                                {
                                                    "id": "210350108",
                                                    "speaker": "Sun Yu",
                                                    "text": "*Suspira*. Bem, isso é meio vergonhoso... Vivi falando sobre reviver o Clã de Guhua, mas o que estive fazendo esse tempo todo... Esse tão chamado \"buscando a orientação dos adepti\" é basicamente apenas eu ficando à toa pelo Relevo de Jueyun..."
                                                },
                                                {
                                                    "id": "210350109",
                                                    "speaker": "Sun Yu",
                                                    "text": "Embora eu seja grato pela companhia da Que'er, lá no fundo, eu sei que esse comportamento não significa nada para reviver o Clã de Guhua..."
                                                },
                                                {
                                                    "id": "210350110",
                                                    "speaker": "Sun Yu",
                                                    "text": "Um tempo atrás, quando eu estava fazendo compras na cidade, acabei tendo uma conversa com um comerciante de Fontaine."
                                                },
                                                {
                                                    "id": "210350111",
                                                    "speaker": "Sun Yu",
                                                    "text": "Ele disse para mim: \"Você não pode encontrar a solução para um problema no local em que ele ocorreu.\""
                                                },
                                                {
                                                    "id": "210350112",
                                                    "speaker": "Sun Yu",
                                                    "text": "Pensei sobre essas palavras por um bom tempo. Talvez, esse comerciante de Fontaine estivesse sugerindo que eu viajasse por lugares além de Liyue.",
                                                    "choices": [
                                                        {
                                                            "id": "210350113",
                                                            "text": "Viajar pode ampliar os horizontes.",
                                                            "response": [
                                                                {
                                                                    "id": "210350115",
                                                                    "speaker": "Sun Yu",
                                                                    "text": "É exatamente o que pensei! Mas... Que'er não quer deixar Liyue."
                                                                },
                                                                {
                                                                    "id": "210350116",
                                                                    "speaker": "Sun Yu",
                                                                    "text": "Normalmente, suas crises de temperamento não são sérias e muitas vezes podem até mesmo ser brincadeiras. Não é preciso muito para eu apaziguá-la."
                                                                },
                                                                {
                                                                    "id": "210350117",
                                                                    "speaker": "Sun Yu",
                                                                    "text": "Mas dessa vez, ela parecia estar muito enfurecida. Não importava o que eu falasse, ela se recusava a ouvir, e até correu de volta para a cidade, sozinha... *Suspira*."
                                                                },
                                                                {
                                                                    "id": "210350118",
                                                                    "speaker": "Sun Yu",
                                                                    "text": "Mas eu não vou te entediar mais com essas coisas triviais. Tirando isso, Viajante, posso te pedir um favor?"
                                                                },
                                                                {
                                                                    "id": "210350119",
                                                                    "speaker": "Sun Yu",
                                                                    "text": "Embora eu tenha aprendido algumas técnicas de defesa antes, eu mal pude testar minhas habilidades. Se irei viajar pelo exterior, definitivamente irei me deparar com algum tipo de luta cedo ou tarde..."
                                                                },
                                                                {
                                                                    "id": "210350120",
                                                                    "speaker": "Sun Yu",
                                                                    "text": "Viajante, ouvi diversas histórias sobre suas aventuras por todo o mundo, e você deve saber de várias formas de lidar com monstros."
                                                                },
                                                                {
                                                                    "id": "210350121",
                                                                    "speaker": "Sun Yu",
                                                                    "text": "Você poderia me acompanhar para encontrar alguns monstros por aí e lutar contra eles? Sabe, e também me dar alguma orientação ao longo do caminho?",
                                                                    "choices": [
                                                                        {
                                                                            "id": "210350122",
                                                                            "text": "Sem problemas.",
                                                                            "response": [
                                                                                {
                                                                                    "id": "210350125",
                                                                                    "speaker": "Sun Yu",
                                                                                    "text": "Vamos ver... Tem um lugar que os monstros se juntam bem à frente. Vamos dar um pulo lá primeiro, tudo bem?"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "210350123",
                                                                            "text": "Temo que você não conseguirá ver meus movimentos com clareza.",
                                                                            "response": [
                                                                                {
                                                                                    "id": "210350124",
                                                                                    "speaker": "Sun Yu",
                                                                                    "text": "#V-você é realmente tão habilidos{M#o}{F#a} assim? Hahahaha, então, por favor, me faça outro favor e seja um pouco mais devagar."
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "210350114",
                                                            "text": "Veja isso apenas como uma distração."
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "210350107",
                                            "text": "Você não vai reviver o Clã de Guhua?"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "210350103",
                            "text": "O que você está fazendo?"
                        }
                    ]
                }
            ]
        },
        {
            "id": "2103502",
            "objective": "Derrote todos os monstros",
            "dialogues": [
                {
                    "id": "210350201",
                    "speaker": "Sun Yu",
                    "text": "Ufff... Essa foi difícil..."
                },
                {
                    "id": "210350202",
                    "speaker": "Sun Yu",
                    "text": "Me desculpe. Olhe só para mim, fazendo papel de bobo. Não esperava que ficaria tão nervoso ao enfrentar monstros de verdade..."
                },
                {
                    "id": "210350203",
                    "speaker": "Sun Yu",
                    "text": "Não é nem preciso dizer que ainda tenho que treinar mais. Enfim, muito obrigado, Viajante. Por favor, fique com isso como sua recompensa."
                },
                {
                    "id": "210350204",
                    "speaker": "Player",
                    "text": "Você realmente está indo embora?"
                },
                {
                    "id": "210350205",
                    "speaker": "Sun Yu",
                    "text": "Ainda não me decidi totalmente. Ainda preciso de um tempo para pensar. Enquanto isso, verei se consigo convencer a Que'er a ir comigo..."
                }
            ]
        },
        {
            "id": "2103503",
            "objective": "Fale com Sun Yu",
