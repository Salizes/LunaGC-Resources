    "talks": [
        {
            "id": "7220601",
            "objective": "",
            "dialogues": [
                {
                    "id": "722060101",
                    "speaker": "Abe",
                    "text": "Ei! Eu ainda estou aqui!"
                },
                {
                    "id": "722060102",
                    "speaker": "Abe",
                    "text": "Esses jovens de hoje em dia não possuem educação alguma!",
                    "choices": [
                        {
                            "id": "722060103",
                            "text": "D-desculpe!",
                            "response": [
                                {
                                    "id": "722060104",
                                    "speaker": "Abe",
                                    "text": "Hnf! Assim é melhor. Quanto àqueles cogumelos, vamos chamar isso de um presente meu... Mas não toquem no resto!"
                                }
                            ]
                        },
                        {
                            "id": "722060105",
                            "text": "Esses são os seus cogumelos?",
                            "response": [
                                {
                                    "id": "722060106",
                                    "speaker": "Abe",
                                    "text": "Não é da sua conta! Pare de sair pegando eles a vontade e saia daqui!"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7220603",
            "objective": "",
            "dialogues": [
                {
                    "id": "722060201",
                    "speaker": "Paimon",
                    "text": "Eita! Esse sujeito... Você viu isso!?",
                    "choices": [
                        {
                            "id": "722060202",
                            "text": "Não vi.",
                            "response": [
                                {
                                    "id": "722060204",
                                    "speaker": "Paimon",
                                    "text": "Uhh, isso foi muito assustador. Vamos só pegar alguns cogumelos e sair daqui, beleza?"
                                }
                            ]
                        },
                        {
                            "id": "722060203",
                            "text": "Deve ser imaginação."
                        }
                    ]
                }
            ]
        },
        {
            "id": "7220604",
            "objective": "",
            "dialogues": [
                {
                    "id": "722060401",
                    "speaker": "Abe",
                    "text": "Como está indo? Estou pronto e esperando para ter meus horizontes expandidos!"
                },
                {
                    "id": "722060402",
                    "speaker": "Player",
                    "text": "Esses são os cogumelos que você queria?"
                }
            ]
        },
        {
            "id": "7220605",
            "objective": "",
            "dialogues": [
                {
                    "id": "722060301",
                    "speaker": "Abe",
                    "text": "Ei! Ei! Eu não te avisei antes!? Você tem problema de audição, ou simplesmente não tem ouvidos, hã?"
                },
                {
                    "id": "722060302",
                    "speaker": "Player",
                    "text": "Oh, veja, um fantasma!"
                },
                {
                    "id": "722060303",
                    "speaker": "Abe",
                    "text": "Eita! Fantasma? Onde? Onde!?",
                    "choices": [
                        {
                            "id": "722060304",
                            "text": "É aqui mesmo.",
                            "response": [
                                {
                                    "id": "722060306",
                                    "speaker": "Abe",
                                    "text": "Aaarrg! Sai! Xô! Sai daqui espírito ruim! Pelo nome de meu clã, eu, Abe, ordeno que você saia desse lugar!!!"
                                },
                                {
                                    "id": "722060307",
                                    "speaker": "Abe",
                                    "text": "...O quê? N-não! Não pode ser! E-Eu nunca... Eu nunca encontrei um espírito tão maligno em todos os meus anos! Po-Por que não está indo embora?"
                                },
                                {
                                    "id": "722060308",
                                    "speaker": "Player",
                                    "text": "Eu vim de fora da ilha."
                                },
                                {
                                    "id": "722060309",
                                    "speaker": "Abe",
                                    "text": "Um espírito maligno do além do Mar de Névoa? E-Eu não tenho medo de você! Espera só! A gr-grande Pássaro do Trovão vai exorcizar você!",
                                    "choices": [
                                        {
                                            "id": "722060310",
                                            "text": "A Pássaro do Trovão não voltará mais.",
                                            "response": [
                                                {
                                                    "id": "722060312",
                                                    "speaker": "Abe",
                                                    "text": "O que você disse...?",
                                                    "choices": [
                                                        {
                                                            "id": "722060313",
                                                            "text": "Todos se foram.",
                                                            "response": [
                                                                {
                                                                    "id": "722060315",
                                                                    "speaker": "Abe",
                                                                    "text": "O que... O que você está dizendo? N-Não me assuste deste jeito. Oooh, já estou ficando todo arrepiado..."
                                                                },
                                                                {
                                                                    "id": "722060316",
                                                                    "speaker": "Abe",
                                                                    "text": "Ainda assim, tem havido cada vez menos pessoas na ilha ultimamente. Kina também me disse que todos estavam entrando a bordo do barco... *Suspira* Quem sabe para onde aquela criança foi agora..."
                                                                },
                                                                {
                                                                    "id": "722060317",
                                                                    "speaker": "Abe",
                                                                    "text": "Espere um momento. Espírito do além desta ilha... Você não vai sair também? No barco prateado à beira-mar?",
                                                                    "choices": [
                                                                        {
                                                                            "id": "722060318",
                                                                            "text": "Eu não vi barco algum.",
                                                                            "response": [
                                                                                {
                                                                                    "id": "722060320",
                                                                                    "speaker": "Abe",
                                                                                    "text": "Hã... Eu sabia! Eu sabia que forasteiros não conseguiam ver o barco..."
                                                                                },
                                                                                {
                                                                                    "id": "722060321",
                                                                                    "speaker": "Abe",
                                                                                    "text": "Ainda assim, obrigado por me dizer para embarcar, espírito maligno. É... É que eu vivo aqui há tanto tempo, e ainda há tanto que eu ainda não vi nem fiz... Não posso simplesmente deixar este lugar!"
                                                                                },
                                                                                {
                                                                                    "id": "722060322",
                                                                                    "speaker": "Player",
                                                                                    "text": "Do que você precisa?"
                                                                                },
                                                                                {
                                                                                    "id": "722060323",
                                                                                    "speaker": "Abe",
                                                                                    "text": "Do que eu preciso? Haha, pode-se dizer que não preciso de nada... Só estou vendo coisas novas..."
                                                                                },
                                                                                {
                                                                                    "id": "722060324",
                                                                                    "speaker": "Abe",
                                                                                    "text": "Quando eu era muito, muito pequeno, fiz uma aposta com Una... Eu disse que com certeza existia um cogumelo diferente fora da ilha, e ela não acreditou em mim."
                                                                                },
                                                                                {
                                                                                    "id": "722060325",
                                                                                    "speaker": "Abe",
                                                                                    "text": "Mais tarde, seu marido saiu para o mar, partindo para terras onde vivem os forasteiros. Ele nunca voltou, e dizem que seu espírito vagueia pelas terras... Pobre sujeito."
                                                                                },
                                                                                {
                                                                                    "id": "722060326",
                                                                                    "speaker": "Abe",
                                                                                    "text": "Desde então, Una tem vivido sozinha. Sempre que penso nisso, eu... *Suspira*.",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "722060327",
                                                                                            "text": "Não se preocupe com os outros.",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "722060329",
                                                                                                    "speaker": "Abe",
                                                                                                    "text": "Eu até implorei ao sacerdote, sabe? No mínimo, tínhamos que dar a alguém um lugar para ficar... Ah, certo, certo! Os cogumelos!"
                                                                                                },
                                                                                                {
                                                                                                    "id": "722060330",
                                                                                                    "speaker": "Abe",
                                                                                                    "text": "Cof. Bem, em breve embarcarei no barco e não tenho tantos arrependimentos assim... Eu só nunca vi nada que esteja além da nossa ilha. Ainda assim, o que mais me preocupa são aqueles cogumelos que cuido todos os dias..."
                                                                                                },
                                                                                                {
                                                                                                    "id": "722060331",
                                                                                                    "speaker": "Abe",
                                                                                                    "text": "Por favor, ajude-me a trazer de volta alguns cogumelos de além do Mar de Névoa. Eu adoraria ver como eles são!"
                                                                                                },
                                                                                                {
                                                                                                    "id": "722060332",
                                                                                                    "speaker": "Abe",
                                                                                                    "text": "Por favor, me ajude, espírito maligno forasteiro!"
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "722060328",
                                                                                            "text": "Sobre cogumelos..."
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "722060319",
                                                                            "text": "Este barco não é para mim."
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "722060314",
                                                            "text": "É hora de se despedir."
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "722060311",
                                            "text": "A neblina desapareceu."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "722060305",
                            "text": "Sou eu."
                        }
                    ]
                }
            ]
        },
        {
            "id": "7220607",
            "objective": "",
            "dialogues": [
                {
                    "id": "722060501",
                    "speaker": "Abe",
                    "text": "Ooh! Haha... Uau, eles têm uma forma tão estranha! Será que eles também têm alma? Eles contêm as memórias das pessoas?"
                },
                {
                    "id": "722060502",
                    "speaker": "Abe",
                    "text": "E essas coisinhas macias que parecem asas... Eles conseguem voar?"
                },
                {
                    "id": "722060503",
                    "speaker": "Abe",
                    "text": "Ah, eu e minha infinita curiosidade! O barqueiro está ficando irritado, creio eu. Sinto muito, mas acho que devo ir. Sim, eu devo..."
                }
            ]
        }
    ]
}