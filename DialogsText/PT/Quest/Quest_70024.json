    "talks": [
        {
            "id": "7002401",
            "objective": "Vá até a Guilda de Aventureiros",
            "dialogues": [
                {
                    "id": "700240101",
                    "speaker": "Katheryne",
                    "text": "Viajante, venha aqui!"
                },
                {
                    "id": "700240102",
                    "speaker": "Katheryne",
                    "text": "Desculpe-me por tomar um pouco do seu tempo, mas você teria interesse em aceitar uma nova missão?",
                    "choices": [
                        {
                            "id": "700240103",
                            "text": "Pode falar.",
                            "response": [
                                {
                                    "id": "700240105",
                                    "speaker": "Katheryne",
                                    "text": "De acordo com os relatórios recentes de inteligência da Guilda, os Hilichurls estão se reunindo e atacando as rotas comerciais."
                                },
                                {
                                    "id": "700240106",
                                    "speaker": "Katheryne",
                                    "text": "Devido a isso, nós enviamos muitos aventureiros para lidar com a situação..."
                                },
                                {
                                    "id": "700240107",
                                    "speaker": "Katheryne",
                                    "text": "Mas de acordo com esses aventureiros, entre os Hilichurls que estavam se reunindo havia um Hilichurl Estranho..."
                                },
                                {
                                    "id": "700240108",
                                    "speaker": "Katheryne",
                                    "text": "Nós supomos que esse Hilichurl estranho esteja relacionado a esse problema atual..."
                                },
                                {
                                    "id": "700240114",
                                    "speaker": "Katheryne",
                                    "text": "Precisamos que alguém o capture, ou pelo menos expulse esse Hilichurl Estranho."
                                },
                                {
                                    "id": "700240109",
                                    "speaker": "Katheryne",
                                    "text": "Viajante, você tem interesse em aceitar essa missão?",
                                    "choices": [
                                        {
                                            "id": "700240110",
                                            "text": "Sem problemas.",
                                            "response": [
                                                {
                                                    "id": "700240112",
                                                    "speaker": "Katheryne",
                                                    "text": "Obrigada. Eu já marquei alguns locais em seu mapa!"
                                                },
                                                {
                                                    "id": "700240113",
                                                    "speaker": "Katheryne",
                                                    "text": "Todos eles possuem Hilichurls que ficam rondando. Comece sua investigação nesses locais."
                                                },
                                                {
                                                    "id": "700240115",
                                                    "speaker": "Katheryne",
                                                    "text": "Se você encontrar esse Hilichurl Estranho, tome muito cuidado."
                                                }
                                            ]
                                        },
                                        {
                                            "id": "700240111",
                                            "text": "Vou me lembrar."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "700240104",
                            "text": "Que missão?"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7002402",
            "objective": "Vá para a natureza para investigar",
            "dialogues": [
                {
                    "id": "700240201",
                    "speaker": "Ella Musk",
                    "text": "*Ofegante* Foi por pouco. Muito obrigada...",
                    "choices": [
                        {
                            "id": "700240202",
                            "text": "Chegamos na hora certa...",
                            "response": [
                                {
                                    "id": "700240204",
                                    "speaker": "Ella Musk",
                                    "text": "*Suspiro*"
                                },
                                {
                                    "id": "700240205",
                                    "speaker": "Ella Musk",
                                    "text": "Estava tudo indo bem até agora há pouco... Afinal de contas, que frase estava errada?"
                                },
                                {
                                    "id": "700240206",
                                    "speaker": "Ella Musk",
                                    "text": "Não importa... Obrigada, vocês me salvaram na hora certa..."
                                },
                                {
                                    "id": "700240207",
                                    "speaker": "Paimon",
                                    "text": "Ela parece muito triste."
                                },
                                {
                                    "id": "700240208",
                                    "speaker": "Ella Musk",
                                    "text": "Vocês também viram o que acabou de acontecer."
                                },
                                {
                                    "id": "700240223",
                                    "speaker": "Ella Musk",
                                    "text": "Se eu tentar me comunicar com os Hilichurls sozinha pode ser muito perigoso..."
                                },
                                {
                                    "id": "700240209",
                                    "speaker": "Ella Musk",
                                    "text": "Mas não é por causa disso que desistirei das minhas chances de me comunicar com os Hilichurls...",
                                    "choices": [
                                        {
                                            "id": "700240210",
                                            "text": "Entendo...",
                                            "response": [
                                                {
                                                    "id": "700240212",
                                                    "speaker": "Ella Musk",
                                                    "text": "Desse jeito, a compilação do dicionário será atrasada..."
                                                },
                                                {
                                                    "id": "700240224",
                                                    "speaker": "Ella Musk",
                                                    "text": "Será melhor se houver pessoas que possam testar em meu lugar se o que eu escrevi no livro está correto ou não."
                                                },
                                                {
                                                    "id": "700240213",
                                                    "speaker": "Player",
                                                    "text": "Eu posso ajudar."
                                                },
                                                {
                                                    "id": "700240214",
                                                    "speaker": "Ella Musk",
                                                    "text": "Mesmo? Ótimo! Então, lembrem-se de levar esse livro com vocês!"
                                                },
                                                {
                                                    "id": "700240215",
                                                    "speaker": "Paimon",
                                                    "text": "Uau... Em um instante você já passou a dar ordens..."
                                                },
                                                {
                                                    "id": "700240216",
                                                    "speaker": "Ella Musk",
                                                    "text": "Se você tiver algum problema enquanto estiver se comunicando, só precisa olhar o dicionário... Pelo menos é assim, teoricamente."
                                                },
                                                {
                                                    "id": "700240217",
                                                    "speaker": "Player",
                                                    "text": "Teoricamente...?"
                                                },
                                                {
                                                    "id": "700240218",
                                                    "speaker": "Paimon",
                                                    "text": "Isso quer dizer que Ella Musk também não sabe o que ela escreveu!"
                                                },
                                                {
                                                    "id": "700240219",
                                                    "speaker": "Ella Musk",
                                                    "text": "Por que os amadores sempre falam isso?! Se uma pesquisa científica não é posta à prova na realidade, como saber se a lógica está correta?!"
                                                },
                                                {
                                                    "id": "700240225",
                                                    "speaker": "Ella Musk",
                                                    "text": "Ah... Esqueça. De qualquer maneira, você não precisa entender tudo. Enfim, estou muito agradecida por vocês terem me salvado."
                                                },
                                                {
                                                    "id": "700240220",
                                                    "speaker": "Ella Musk",
                                                    "text": "Se não se importarem, gostaria que me deixassem ir com vocês para me comunicar com os Hilichurls."
                                                }
                                            ]
                                        },
                                        {
                                            "id": "700240211",
                                            "text": "Posso ajudar com algo?"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "700240203",
                            "text": "Você está bem?"
                        }
                    ]
                }
            ]
        },
        {
