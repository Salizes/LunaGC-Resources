            "dialogues": [
                {
                    "id": "733280101",
                    "speaker": "Paimon",
                    "text": "É você, Jeeeeeht!"
                },
                {
                    "id": "733280102",
                    "speaker": "Jeht",
                    "text": "#{NICKNAME}? E a pequena Paimon?"
                },
                {
                    "id": "733280103",
                    "speaker": "Benben",
                    "text": "Bip bip!"
                },
                {
                    "id": "733280104",
                    "speaker": "Jeht",
                    "text": "Haha, viu o que eu disse? Nós nos encontraremos novamente!"
                },
                {
                    "id": "733280105",
                    "speaker": "Player",
                    "text": "O que você está fazendo aqui?"
                },
                {
                    "id": "733280106",
                    "speaker": "Jeht",
                    "text": "Ora, esse é o segredo de uma dama."
                },
                {
                    "id": "733280107",
                    "speaker": "Paimon",
                    "text": "?"
                },
                {
                    "id": "733280108",
                    "speaker": "Jeht",
                    "text": "#{M#Isso significa não se intrometa! Até eu posso querer manter algo em segredo, sabe...}{F#Encontre um bar e me divirta e talvez eu te conte um segredo ou outro... Não me diga que eu vou ter que fazer tudo, hein?}"
                },
                {
                    "id": "733280109",
                    "speaker": "Jeht",
                    "text": "#{M#Pfft, perdão, mas de acordo com as regras dos guardas, eu não posso de contar nada.}{F#E-Eu só estou brincando! Há algumas regras que devemos seguir... Não devemos dizer uma palavra sequer sobre os produtos sendo escoltados. Minhas desculpas.}"
                },
                {
                    "id": "733280110",
                    "speaker": "Paimon",
                    "text": "Hmph, você está tão cheia de segredos!"
                },
                {
                    "id": "733280111",
                    "speaker": "Jeht",
                    "text": "Então... Como vocês têm passado?",
                    "choices": [
                        {
                            "id": "733280112",
                            "text": "Nada mal.",
                            "response": [
                                {
                                    "id": "733280114",
                                    "speaker": "Jeht",
                                    "text": "É... Comigo também."
                                },
                                {
                                    "id": "733280115",
                                    "speaker": "Jeht",
                                    "text": "Certo, eu não vou te segurar mais. *Suspiro* Eu tenho meus próprios assuntos para resolver."
                                },
                                {
                                    "id": "733280116",
                                    "speaker": "Paimon",
                                    "text": "Hã, você é tão ocupada, Jeht. Você não era assim antes."
                                },
                                {
                                    "id": "733280117",
                                    "speaker": "Jeht",
                                    "text": "Pfft... Bem, isso que é um emprego \"estável\", apesar do que eu faço ser praticamente o mesmo."
                                },
                                {
                                    "id": "733280118",
                                    "speaker": "Jeht",
                                    "text": "Não demorou muito para eu começar a sentir falta dos meus antigos dias despreocupados..."
                                },
                                {
                                    "id": "733280119",
                                    "speaker": "Jeht",
                                    "text": "Eu não sei o que vocês têm feito recentemente, mas eu sempre espero ansiosamente ouvir suas histórias. Eu tenho várias para contar também."
                                },
                                {
                                    "id": "733280120",
                                    "speaker": "Jeht",
                                    "text": "Mas sem pressa por ora. Boas histórias são como vinho. Nós devemos deixá-las fermentar adequadamente. Viajantes no deserto costumavam viver por essas histórias no passado, hehe!"
                                },
                                {
                                    "id": "733280121",
                                    "speaker": "Jeht",
                                    "text": "Hmm... Enfim, cuidem-se."
                                },
                                {
                                    "id": "733280122",
                                    "speaker": "Player",
                                    "text": "Você também, Jeht."
                                },
                                {
                                    "id": "733280123",
                                    "speaker": "Jeht",
                                    "text": "Sim, deixa eu te dar mil abraços, e eu vou continuar rezando por vocês."
                                },
                                {
                                    "id": "733280124",
                                    "speaker": "Benben",
                                    "text": "Bip!"
                                },
                                {
                                    "id": "733280125",
                                    "speaker": "Jeht",
                                    "text": "Haha, eu não vou perder Benben!"
                                }
                            ]
                        },
                        {
                            "id": "733280113",
                            "text": "Estou ok..."
                        }
                    ]
                }
            ]
        },
        {
            "id": "7332802",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "733280201",
                    "speaker": "Jeht",
                    "text": "Aqui estão mil abraços! Até a próxima!",
                    "choices": [
                        {
                            "id": "733280202",
                            "text": "Onde nos encontraremos novamente?",
                            "response": [
                                {
                                    "id": "733280203",
                                    "speaker": "Jeht",
                                    "text": "Quem sabe? Talvez Celestia?"
                                },
                                {
                                    "id": "733280204",
                                    "speaker": "Jeht",
                                    "text": "Hahahahaha! Eu estava brincando! Mas se você quiser me ver lá, eu definitivamente estarei lá."
                                },
                                {
                                    "id": "733280205",
                                    "speaker": "Jeht",
                                    "text": "Não me pergunte o motivo. Eu apenas sei."
                                },
                                {
                                    "id": "733280208",
                                    "speaker": "Jeht",
                                    "text": "Enfim, até a próxima!"
                                }
                            ]
                        },
                        {
                            "id": "733280206",
                            "text": "Mil abraços para você também.",
                            "response": [
                                {
                                    "id": "733280207",
