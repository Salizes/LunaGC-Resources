    "talks": [
        {
            "id": "7215901",
            "objective": "",
            "dialogues": [
                {
                    "id": "721590101",
                    "speaker": "\"Masanori\"",
                    "text": "Você chegou."
                },
                {
                    "id": "721590102",
                    "speaker": "\"Masanori\"",
                    "text": "Vamos duelar?"
                }
            ]
        },
        {
            "id": "7215902",
            "objective": "",
            "dialogues": [
                {
                    "id": "721590201",
                    "speaker": "Player",
                    "text": "Tudo bem, então. Vamos lá."
                },
                {
                    "id": "721590202",
                    "speaker": "\"Masanori\"",
                    "text": "Ótimo, ataque-me."
                }
            ]
        },
        {
            "id": "7215903",
            "objective": "",
            "dialogues": [
                {
                    "id": "721590301",
                    "speaker": "Player",
                    "text": "Gostaria de falar com você."
                },
                {
                    "id": "721590302",
                    "speaker": "\"Masanori\"",
                    "text": "Eu reneguei o meu passado. Não há nada para ser dito entre eu e este mundo."
                },
                {
                    "id": "721590303",
                    "speaker": "\"Masanori\"",
                    "text": "Se você está procurando por alguém para conversar, essa pessoa não sou eu."
                },
                {
                    "id": "721590304",
                    "speaker": "\"Masanori\"",
                    "text": "Por favor, saia."
                }
            ]
        },
        {
            "id": "7215904",
            "objective": "",
            "dialogues": [
                {
                    "id": "721590501",
                    "speaker": "\"Masanori\"",
                    "text": "Parece que você negligenciou o seu treinamento."
                },
                {
                    "id": "721590502",
                    "speaker": "\"Masanori\"",
                    "text": "Um único dia de preguiça desperdiçará dez do trabalho de um guerreiro. Suponho que você conheça esse princípio."
                },
                {
                    "id": "721590503",
                    "speaker": "\"Masanori\"",
                    "text": "Continue treinando, não acredito que isso é o seu máximo."
                }
            ]
        },
        {
            "id": "7215905",
            "objective": "",
            "dialogues": [
                {
                    "id": "721590401",
                    "speaker": "\"Masanori\"",
                    "text": "Haha, ainda não sou páreo para você."
                },
                {
                    "id": "721590402",
                    "speaker": "\"Masanori\"",
                    "text": "Eu deveria ter esperado isso. Você sempre está progredindo, e os limites de minha natureza me impedem de fazer uma ruptura similar."
                },
                {
                    "id": "721590403",
                    "speaker": "\"Masanori\"",
                    "text": "De qualquer maneira, se você aprender novas técnicas, seria um prazer meu vê-las."
                },
                {
                    "id": "721590404",
                    "speaker": "\"Masanori\"",
                    "text": "Bem, até o nosso próximo encontro."
                }
            ]
        }
    ]
}