    "talks": [
        {
            "id": "7065701",
            "objective": "Fale com Lizzie",
            "dialogues": [
                {
                    "id": "706570101",
                    "speaker": "Lizzie",
                    "text": "Olá, sou a Lizzie dos Cavaleiros de Favonius. Você deve já ter ouvido que muitas atividades divertidas serão realizadas durante o Festival da Brisa Florescente!",
                    "choices": [
                        {
                            "id": "706570102",
                            "text": "Já ouvi falar...",
                            "response": [
                                {
                                    "id": "706570104",
                                    "speaker": "Lizzie",
                                    "text": "Meu trabalho é receber os visitantes de Mondstadt, permitindo que todos desfrutem da diversão desse festival!"
                                },
                                {
                                    "id": "706570105",
                                    "speaker": "Lizzie",
                                    "text": "Uma vez que o local do evento pode não ser dentro da cidade, se ninguém fizer as apresentações, os visitantes perderão a oportunidade de participar em muitos jogos divertidos."
                                },
                                {
                                    "id": "706570106",
                                    "speaker": "Lizzie",
                                    "text": "Agora, o que quero apresentar majestosamente a vocês é a \"Mira Certeira\"!"
                                },
                                {
                                    "id": "706570107",
                                    "speaker": "Lizzie",
                                    "text": "#Como diz o nome, dispare em alvos no céu! Se você for rápid{F#a}{M#o} e precis{F#a}{M#o}, obterá uma pontuação alta!",
                                    "choices": [
                                        {
                                            "id": "706570108",
                                            "text": "Parece bem interessante.",
                                            "response": [
                                                {
                                                    "id": "706570110",
                                                    "speaker": "Lizzie",
                                                    "text": "Não tem problema. Marcarei a localização para você no seu mapa para ir até lá tentar."
                                                },
                                                {
                                                    "id": "706570111",
                                                    "speaker": "Lizzie",
                                                    "text": "De acordo com os pontos obtidos, também poderá obter recompensas valiosas! Independentemente de apenas jogar às vezes ou ser um perfeccionista, sempre será divertido!",
                                                    "choices": [
                                                        {
                                                            "id": "706570112",
                                                            "text": "Isso despertou meu interesse.",
                                                            "response": [
                                                                {
                                                                    "id": "706570114",
                                                                    "speaker": "Lizzie",
                                                                    "text": "Hehe, vá dar uma olhada primeiro! Se quiser saber mais sobre outros eventos divertidos, podem me procurar!"
                                                                },
                                                                {
                                                                    "id": "706570115",
                                                                    "speaker": "Lizzie",
                                                                    "text": "Divirta-se!"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "706570113",
                                                            "text": "#Obrigad{F#a}{M#o} pela apresentação."
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "706570109",
                                            "text": "Parece um pouco difícil."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "706570103",
                            "text": "Primeira vez que ouço falar..."
                        }
                    ]
                }
            ]
        }
    ]
