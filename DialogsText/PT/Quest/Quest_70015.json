    "talks": [
        {
            "id": "7001501",
            "objective": "Fale com o outro Hilichurl disposto a conversar",
            "dialogues": [
                {
                    "id": "700150101",
                    "speaker": "Hilichurl Pensativo",
                    "text": "Emmm… Yoyo, ika? Tomo?"
                },
                {
                    "id": "700150102",
                    "speaker": "Ella Musk",
                    "text": "Mimi tomo."
                },
                {
                    "id": "700150103",
                    "speaker": "Hilichurl Pensativo",
                    "text": "Tomo tomo. Tomo dala si? Domu nye, ika nye."
                },
                {
                    "id": "700150104",
                    "speaker": "Ella Musk",
                    "text": "Ye muhe dala? Mimi mani ye."
                },
                {
                    "id": "700150105",
                    "speaker": "Hilichurl Pensativo",
                    "text": "Ya tomo mani, mani yaya tome nye… Mi muhe du, du <color=#00E1FFFF>lata boya sada</color> si."
                },
                {
                    "id": "700150106",
                    "speaker": "Ella Musk",
                    "text": "O que será que ele quer? Minhas anotações devem ter algum registro, poderia dar uma olhada nelas?"
                }
            ]
        },
        {
            "id": "7001502",
            "objective": "Troque itens com o Hilichurl",
            "dialogues": [
                {
                    "id": "700150301",
                    "speaker": "Hilichurl Pensativo",
                    "text": "Mosi mita, yoyo tomo, mimi tomo."
                },
                {
                    "id": "700150302",
                    "speaker": "Hilichurl Pensativo",
                    "text": "Odomu tomo zido mi! <color=#00E1FFFF>Unta mosi dada</color>"
                },
                {
                    "id": "700150303",
                    "speaker": "Paimon",
                    "text": "<color=#00E1FFFF>Unta mosi dada</color>... Paimon acha que já ouviu essa frase antes... Que tal darmos uma olhada nas anotações?",
                    "choices": [
                        {
                            "id": "700150304",
                            "text": "Mosi mita dada!",
                            "response": [
                                {
                                    "id": "700150306",
                                    "speaker": "Hilichurl Pensativo",
                                    "text": "Valo, mi tomo!"
                                },
                                {
                                    "id": "700150307",
                                    "speaker": "Paimon",
                                    "text": "Valo!"
                                }
                            ]
                        },
                        {
                            "id": "700150305",
                            "text": "Tomo, valo!"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7001504",
            "objective": "",
            "dialogues": [
                {
                    "id": "700150401",
                    "speaker": "Hilichurl Pensativo",
                    "text": "Domu movo si, Eleka nini si, tomo tomo. Tomo dala si?"
                },
                {
                    "id": "700150402",
                    "speaker": "Ella Musk",
                    "text": "Sua família pode mudar, a tribo pode desaparecer. Amigos, amigos. Afinal de contas, o que são amigos?"
                },
                {
                    "id": "700150403",
                    "speaker": "Paimon",
                    "text": "Apenas entregamos o objeto errado, não precisa ter tanta desconfiança."
                }
            ]
        },
        {
            "id": "7001502",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "700150201",
                    "speaker": "Hilichurl Pensativo",
                    "text": "Mi muhe du, du <color=#00E1FFFF>lata boya sada</color> si."
                },
                {
