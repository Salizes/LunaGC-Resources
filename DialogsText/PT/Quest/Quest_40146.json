    "talks": [
        {
            "id": "4014603",
            "objective": "Espere até dois dias depois",
            "dialogues": []
        },
        {
            "id": "4014601",
            "objective": "Volte para a loja",
            "dialogues": [
                {
                    "id": "401460801",
                    "speaker": "Black Screen",
                    "text": "Com o tempo, seus negócios continuam a crescer e expandir. Seu sucesso constante significa uma oportunidade completamente nova de negócios pode estar no horizonte..."
                },
                {
                    "id": "401460802",
                    "speaker": "Paimon",
                    "text": "Oh, uma comerciante está aqui. Hã, Paimon não tem certeza se ela é de Mondstadt. Vamos dar uma olhada."
                }
            ]
        },
        {
            "id": "4014602",
            "objective": "Fale com a comerciante",
            "dialogues": [
                {
                    "id": "401460101",
                    "speaker": "Atefeh",
                    "text": "Olá! Meu nome é Atefeh. Sou uma comerciante viajante de Sumeru. Prazer te conhecer!"
                },
                {
                    "id": "401460102",
                    "speaker": "Paimon",
                    "text": "Uau, você fez uma bela de uma jornada! Parece que notícias de nossa humilde loja já se espalhou por todos os cantos de Teyvat!",
                    "choices": [
                        {
                            "id": "401460103",
                            "text": "E é tudo graças a você, Paimon.",
                            "response": [
                                {
                                    "id": "401460104",
                                    "speaker": "Paimon",
                                    "text": "Paimon é praticamente uma especialista em vendas. Ela conseguiria vender água a um peixe, hehe!"
                                },
                                {
                                    "id": "401460106",
                                    "speaker": "Atefeh",
                                    "text": "Haha, tenho que concordar! Esse seu empreendimento está se tornando bem conhecido. Na verdade, vários comerciantes bem informados ouviram falar de seu negócio de venda de poções."
                                },
                                {
                                    "id": "401460107",
                                    "speaker": "Atefeh",
                                    "text": "Mas a maioria das pessoas ainda não estão dispostas a se arriscar por uma mercadoria tão rara."
                                },
                                {
                                    "id": "401460108",
                                    "speaker": "Atefeh",
                                    "text": "Mas se você me perguntar, quando a oportunidade aparece, você precisa estar pronto para agarrá-la. É assim que se faz bastante Mora."
                                },
                                {
                                    "id": "401460109",
                                    "speaker": "Atefeh",
                                    "text": "Embora o público ainda não saiba muito sobre poções alquímicas no momento, com um pouco de esforço e propaganda do seu lado, você consegue um belo espaço no mercado para si. Uma vez que isso acontecer, a Mora não vai parar de fluir!"
                                },
                                {
                                    "id": "401460110",
                                    "speaker": "Atefeh",
                                    "text": "Uma vez que você tenha gerado demanda o suficiente, você pode até aumentar os seus preços em dez vezes... Hehe, com esse tipo de lucro, você poderia até tirar o resto do ano de descanso se quisesse."
                                },
                                {
                                    "id": "401460111",
                                    "speaker": "Paimon",
                                    "text": "Dez vezes! Tá falando sério!?"
                                },
                                {
                                    "id": "401460112",
                                    "speaker": "Atefeh",
                                    "text": "Hehe, desde que exista demanda, as pessoas pagarão qualquer coisa. Você poderia dizer que é um tipo de acordo entre consumidor e fornecedor."
                                },
                                {
                                    "id": "401460113",
                                    "speaker": "Paimon",
                                    "text": "Da forma que você fala, Paimon não consegue evitar de lembrar de outra comerciante obcecada por Mora..."
                                },
                                {
                                    "id": "401460114",
                                    "speaker": "Paimon",
                                    "text": "Espera, você disse que era de Sumeru. Talvez você conheça ela. Sabe da Dori?"
                                },
                                {
                                    "id": "401460115",
                                    "speaker": "Atefeh",
                                    "text": "Espera, você está falando da Lorde Sangemah Bay? Uma das comerciantes mais famosas de toda Sumeru? Essa Dori? Você conhece ela?",
                                    "choices": [
                                        {
                                            "id": "401460116",
                                            "text": "Ela é uma amiga minha.",
                                            "response": [
                                                {
                                                    "id": "401460118",
                                                    "speaker": "Atefeh",
                                                    "text": "Uau! Lorde Sangemah Bay é uma das minhas maiores ídolos. Seu senso de negócio e dedicação em fazer Mora sempre foi uma das maiores inspirações!"
                                                },
                                                {
                                                    "id": "401460119",
                                                    "speaker": "Atefeh",
                                                    "text": "Eu tive sorte o suficiente de visitar o Palácio de Alcazarzaray uma vez. É realmente magnífico."
                                                },
                                                {
                                                    "id": "401460120",
                                                    "speaker": "Atefeh",
                                                    "text": "Um dia, eu espero ser igual a ela — coberta até as orelhas de mais Mora do que consigo contar, hehe..."
                                                },
                                                {
                                                    "id": "401460121",
                                                    "speaker": "Paimon",
                                                    "text": "Uhh... parece que ela ficou doidinha... Será que Paimon deveria acordar ela pra vida, ou...?",
                                                    "choices": [
                                                        {
                                                            "id": "401460122",
                                                            "text": "Te desejo tudo de bom!",
                                                            "response": [
                                                                {
                                                                    "id": "401460123",
                                                                    "speaker": "Atefeh",
                                                                    "text": "Obrigada, isso significa muito!"
                                                                },
                                                                {
                                                                    "id": "401460126",
                                                                    "speaker": "Atefeh",
                                                                    "text": "#De volta a onde estávamos, então. Eu acredito que estava te contando como poderíamos fazer muita Mora junt{M#o}{F#a}s."
                                                                },
                                                                {
                                                                    "id": "401460127",
                                                                    "speaker": "Atefeh",
                                                                    "text": "A ideia, na verdade, é bem simples. Você faz poções, me fornece um suprimento regular, e eu te ajudarei a vender por todo Teyvat!"
                                                                },
                                                                {
                                                                    "id": "401460128",
                                                                    "speaker": "Atefeh",
                                                                    "text": "Se isso parece bom para você, então deveríamos falar mais sobre que tipo de poções vender dessa vez.",
                                                                    "choices": [
                                                                        {
                                                                            "id": "401460129",
                                                                            "text": "Checar requerimentos de poções...",
                                                                            "response": [
                                                                                {
                                                                                    "id": "401460130",
                                                                                    "speaker": "Atefeh",
                                                                                    "text": "De acordo com meu senso aguçado de mercado, essas são os tipos de poções que atualmente estão em demanda."
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "401460131",
                                                                            "text": "Talvez mais tarde...",
                                                                            "response": [
                                                                                {
                                                                                    "id": "401460132",
                                                                                    "speaker": "Atefeh",
                                                                                    "text": "Hmm, ok. Mas não espere muito. Quando se trata de Mora, você precisa agir rápido!"
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "401460124",
                                                            "text": "Vamos voltar aos negócios.",
                                                            "response": [
                                                                {
                                                                    "id": "401460125",
                                                                    "speaker": "Atefeh",
                                                                    "text": "*Ahem* Você tem razão. Pareço ter saído um pouco do assunto."
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "401460117",
                                            "text": "Nos encontramos algumas vezes."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "401460105",
                            "text": "Todo nosso trabalho duro está se pagando!"
                        }
                    ]
                }
            ]
        }
    ]
}