        {
            "id": "1104103",
            "objective": "Use a Visão Elemental para procurar os rastros de Albedo",
            "dialogues": []
        },
        {
            "id": "1104104",
            "objective": "Chegou ao local que Albedo está",
            "dialogues": [
                {
                    "id": "110410401",
                    "speaker": "Paimon",
                    "text": "Aquele é Albedo? Por que ele ficaria em um lugar como este?"
                },
                {
                    "id": "110410402",
                    "speaker": "Rosaria",
                    "text": "Dizem que ele adora desenhar. Ele fica em qualquer lugar que tenha uma boa paisagem."
                },
                {
                    "id": "110410403",
                    "speaker": "Rosaria",
                    "text": "As vistas e o cenário aqui são muito bons, há inspiração para todos os lados."
                },
                {
                    "id": "110410404",
                    "speaker": "Paimon",
                    "text": "Mas... Ele não está vendo aqueles Hilichurls? Ele não está em perigo?"
                },
                {
                    "id": "110410405",
                    "speaker": "Paimon",
                    "text": "Oh não!"
                }
            ]
        },
        {
            "id": "1104105",
            "objective": "Derrote os Hilichurls assustados",
            "dialogues": []
        },
        {
            "id": "1104106",
            "objective": "Fale com Albedo",
            "dialogues": [
                {
                    "id": "110410601",
                    "speaker": "Albedo",
                    "text": "Quem são vocês? Por que os afugentaram?"
                },
                {
                    "id": "110410602",
                    "speaker": "Albedo",
                    "text": "Graças aos deuses eu já tinha acabado meu desenho. Teria sido uma pena deixar esses Hilichurls inacabados.",
                    "choices": [
                        {
                            "id": "110410603",
                            "text": "Você estava desenhando Hilichurls?",
                            "response": [
                                {
                                    "id": "110410605",
                                    "speaker": "Paimon",
                                    "text": "Qual a dificuldade em desenhar Hilichurls? Eles não são todos iguais?"
                                },
                                {
                                    "id": "110410606",
                                    "speaker": "Albedo",
                                    "text": "Hmm, receio que a resposta não seja fácil de explicar. Se der uma olhada no meu desenho, pode ter uma ideia.",
                                    "choices": [
                                        {
                                            "id": "110410607",
                                            "text": "Isso...",
                                            "response": [
                                                {
                                                    "id": "110410609",
                                                    "speaker": "Paimon",
                                                    "text": "Uau, vejam os detalhes! Mas algumas coisas parecem ter sido feitas às pressas."
                                                },
                                                {
                                                    "id": "110410610",
                                                    "speaker": "Albedo",
                                                    "text": "Podemos encontrar esses Hilichurls em qualquer lugar, muito entediante na verdade. Não merecem uma atenção mais detalhada."
                                                },
                                                {
                                                    "id": "110410611",
                                                    "speaker": "Albedo",
                                                    "text": "Mas dê uma olhada neste espécime. A forma, o colete... Há uma força distinta em ação aqui."
                                                },
                                                {
                                                    "id": "110410612",
                                                    "speaker": "Albedo",
                                                    "text": "Nas vidas cíclicas dessas comunidades primitivas, esses atributos únicos indicam a evolução em ação. Evolução, a transição do nada para a existência, do conhecido para o des-"
                                                },
                                                {
                                                    "id": "110410613",
                                                    "speaker": "Rosaria",
                                                    "text": "Esperem um minuto. Algo me diz que estou a caminho de uma tese, mas não tenho energia."
                                                },
                                                {
                                                    "id": "110410614",
                                                    "speaker": "Rosaria",
                                                    "text": "Encontramos seu homem, estou voltando."
                                                },
                                                {
                                                    "id": "110410615",
                                                    "speaker": "Paimon",
                                                    "text": "O quê!? Você não tem perguntas para ele? Ei!"
                                                },
                                                {
                                                    "id": "110410616",
                                                    "speaker": "Paimon",
                                                    "text": "Ugh, que estranho."
                                                },
                                                {
                                                    "id": "110410617",
                                                    "speaker": "Albedo",
                                                    "text": "Então a Irmã Rosaria trouxe você? Surpreendente. E não tive tempo de agradecer a ela."
                                                },
                                                {
                                                    "id": "110410618",
                                                    "speaker": "Albedo",
                                                    "text": "Mas de volta ao assunto. Pelas palavras dela, parece que você estava procurando por mim?"
                                                },
                                                {
                                                    "id": "110410619",
                                                    "speaker": "Paimon",
                                                    "text": "Uhum, conhecemos uma garota em Mondstadt, Sucrose! Ela disse que você está com problemas em sua pesquisa."
                                                },
                                                {
                                                    "id": "110410620",
                                                    "speaker": "Albedo",
                                                    "text": "Entendo, então Sucrose mandou vocês virem aqui."
                                                },
                                                {
                                                    "id": "110410621",
                                                    "speaker": "Albedo",
                                                    "text": "#Então, se não me engano, você deve ser {M#o Cavaleiro}{F#a Cavaleira} Honorável. Não se fala de outra coisa em Mondstadt."
                                                },
                                                {
                                                    "id": "110410622",
                                                    "speaker": "Albedo",
                                                    "text": "Ouvi um pouco de tudo, suas ações durante o ataque do Stormterror, seu controle elemental e outras coisas misteriosas..."
                                                },
                                                {
                                                    "id": "110410623",
                                                    "speaker": "Albedo",
                                                    "text": "Vou pular para a conclusão, só há uma possibilidade, afinal. Você veio de longe - de outro mundo. Certo?",
                                                    "choices": [
                                                        {
                                                            "id": "110410624",
                                                            "text": "Certo.",
                                                            "response": [
                                                                {
                                                                    "id": "110410626",
                                                                    "speaker": "Albedo",
                                                                    "text": "Excelente. Acho que minha pesquisa se beneficiaria enormemente com sua ajuda.",
                                                                    "choices": [
                                                                        {
                                                                            "id": "110410627",
                                                                            "text": "Sua pesquisa?",
                                                                            "response": [
                                                                                {
                                                                                    "id": "110410629",
                                                                                    "speaker": "Albedo",
                                                                                    "text": "Ah, me perdoe. Isso deve ser confuso. Por onde devo começar? Hmm... A essência da vida?"
                                                                                },
                                                                                {
                                                                                    "id": "110410630",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "Espere um pouco, você quer começar por isso!?"
                                                                                },
                                                                                {
                                                                                    "id": "110410631",
                                                                                    "speaker": "Albedo",
                                                                                    "text": "Hmm... Você tem razão. Fazer uma demonstração seria melhor do que tentar explicar."
                                                                                },
                                                                                {
                                                                                    "id": "110410632",
                                                                                    "speaker": "Albedo",
                                                                                    "text": "Por exemplo, despertar a vida. Reviver folhas caídas."
                                                                                },
                                                                                {
                                                                                    "id": "110410634",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "Você pode fazer isso!?",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "110410635",
                                                                                            "text": "A alquimia é realmente milagrosa.",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "110410637",
                                                                                                    "speaker": "Albedo",
                                                                                                    "text": "No entanto, tenho uma semente específica em minha posse. O método de que estou falando não produziu resultados."
                                                                                                },
                                                                                                {
                                                                                                    "id": "110410639",
                                                                                                    "speaker": "Albedo",
                                                                                                    "text": "Assim como você, ela veio de outro mundo. Ajudá-la a crescer - a florescer... Esse é o problema que estou tendo na minha pesquisa. É por isso que preciso de sua ajuda."
                                                                                                },
                                                                                                {
                                                                                                    "id": "110410640",
                                                                                                    "speaker": "Paimon",
                                                                                                    "text": "Se você não consegue descobrir, Paimon não tem certeza se vamos ajudar muito."
                                                                                                },
                                                                                                {
                                                                                                    "id": "110410641",
                                                                                                    "speaker": "Albedo",
                                                                                                    "text": "Discordo. Não compreendo as complexidades da vida fora do mundo conhecido."
                                                                                                },
                                                                                                {
                                                                                                    "id": "110410642",
                                                                                                    "speaker": "Albedo",
                                                                                                    "text": "Mas você não é do mundo conhecido. Observando e investigando você, talvez eu encontre um jeito de fazer a semente brotar."
                                                                                                },
                                                                                                {
                                                                                                    "id": "110410643",
                                                                                                    "speaker": "Player",
                                                                                                    "text": "Então eu sou um... Um objeto de pesquisa?"
                                                                                                },
                                                                                                {
                                                                                                    "id": "110410644",
                                                                                                    "speaker": "Paimon",
                                                                                                    "text": "#Uh... O que fazemos, {NICKNAME}? Isso soa um pouco estranho.",
                                                                                                    "choices": [
                                                                                                        {
                                                                                                            "id": "110410645",
                                                                                                            "text": "Há algum perigo?",
                                                                                                            "response": [
                                                                                                                {
                                                                                                                    "id": "110410646",
                                                                                                                    "speaker": "Albedo",
                                                                                                                    "text": "É possível. Mas farei tudo que estiver ao meu alcance para garantir sua segurança."
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "110410649",
                                                                                                                    "speaker": "Albedo",
                                                                                                                    "text": "Hora de mudar de ambiente, devemos ir. Há pesquisas para fazer!"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "110410650",
                                                                                                                    "speaker": "Rosaria",
                                                                                                                    "text": ""
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "110410651",
                                                                                                                    "speaker": "Rosaria",
                                                                                                                    "text": "#Albedo e {M#aquele}{F#aquela} Viajante parecem ter se dado bem."
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "110410652",
                                                                                                                    "speaker": "Rosaria",
                                                                                                                    "text": "Acho que uma pessoa estranha reconhece outras. Eu me pergunto... Isso representa um risco para Mondstadt?"
                                                                                                                }
                                                                                                            ]
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "110410647",
                                                                                                            "text": "O que ganharei em troca?",
                                                                                                            "response": [
                                                                                                                {
                                                                                                                    "id": "110410648",
                                                                                                                    "speaker": "Albedo",
                                                                                                                    "text": "Mora, conhecimento. E a resposta para a pergunta que você está procurando. É uma resposta que posso dar. O que acha?"
                                                                                                                }
                                                                                                            ]
                                                                                                        }
                                                                                                    ]
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "110410636",
                                                                                            "text": "A alquimia é muito útil."
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "110410628",
                                                                            "text": "Acho que não entendi."
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "110410625",
                                                            "text": "Sua reputação acadêmica precede você."
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "110410608",
                                            "text": "Muito... Avant-garde."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "110410604",
                            "text": "Pensei que você estava desenhando uma paisagem."
                        }
                    ]
                }
            ]
        }
    ]
}