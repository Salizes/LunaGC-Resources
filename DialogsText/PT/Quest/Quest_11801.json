    "talks": [
        {
            "id": "1180101",
            "objective": "",
            "dialogues": [
                {
                    "id": "698350101",
                    "speaker": "Kamisato Ayato",
                    "text": "... Esse estilo tem um charme descontraído. Acredito que Ayaka gostaria dele."
                },
                {
                    "id": "698350102",
                    "speaker": "Player",
                    "text": "Tá fazendo um banho de loja, Ayato?"
                },
                {
                    "id": "698350103",
                    "speaker": "Kamisato Ayato",
                    "text": "#Ah, que coincidência, {NICKNAME}. Eu havia pedido um lote de tecidos da Tecidos & Kimonos Ogura, e eles geralmente mandavam entregar para a Mansão Kamisato para que pudéssemos fazer uma seleção."
                },
                {
                    "id": "698350104",
                    "speaker": "Kamisato Ayato",
                    "text": "Entretanto, como eu já estava no Tenshukaku para discutir com a Toda-Poderosa Shogun, pensei em dar uma passada e olhar os tecidos pessoalmente.",
                    "choices": [
                        {
                            "id": "698350105",
                            "text": "Então você escolheu esses tecidos pessoalmente...",
                            "response": [
                                {
                                    "id": "698350107",
                                    "speaker": "Kamisato Ayato",
                                    "text": "Se fossem para um uso qualquer, então quem cuidaria deles, de fato, seriam os funcionários."
                                },
                                {
                                    "id": "698350108",
                                    "speaker": "Kamisato Ayato",
                                    "text": "Mas, consideração para tecidos que serão utilizados em funções oficiais começa com a escolha do próprio tecido, e suas cores. Nesses casos, cuido disso pessoalmente."
                                },
                                {
                                    "id": "698350109",
                                    "speaker": "Kamisato Ayato",
                                    "text": "Afinal... dado o papel do Clã Kamisato na Comissão Yashiro, supervisionando os assuntos culturais e civis, até mesmo escolhas menores a respeito dos padrões têxteis é razão para escrutínio público."
                                },
                                {
                                    "id": "698350110",
                                    "speaker": "Kamisato Ayato",
                                    "text": "Muitos comerciantes vendem seus produtos usando as etiquetas \"aprovado pela Comissão Yashiro\" após nossos pedidos anuais."
                                },
                                {
                                    "id": "698350111",
                                    "speaker": "Kamisato Ayato",
                                    "text": "Uma vez, eu cheguei a delegar essa tarefa... mas os vendedores ofereceram subornos ao meu representante, e ele acabou caindo na tentação... não foi nada fácil resolver esse problema."
                                },
                                {
                                    "id": "698350112",
                                    "speaker": "Kamisato Ayato",
                                    "text": "Eu já supervisionei tais questões antes. Mais vale a pena prevenir do que remediar.",
                                    "choices": [
                                        {
                                            "id": "698350113",
                                            "text": "Isso parece... exaustivo...",
                                            "response": [
                                                {
                                                    "id": "698350115",
                                                    "speaker": "Kamisato Ayato",
                                                    "text": "Hehe, os deveres da Comissão Yashiro nunca são simples. Já estou acostumado."
                                                },
                                                {
                                                    "id": "698350116",
                                                    "speaker": "Kamisato Ayato",
                                                    "text": "#Eu já afunilei até dois candidatos, mas continuo hesitando entre eles... {NICKNAME}, você me ajudaria a julgar qual seria mais adequado?",
                                                    "choices": [
                                                        {
                                                            "id": "698350117",
                                                            "text": "Hã, isso é bem importante...",
                                                            "response": [
                                                                {
                                                                    "id": "698350119",
                                                                    "speaker": "Kamisato Ayato",
                                                                    "text": "#Você é um{F#a} {F#das}{M#dos} noss{F#as}{M#os} mais estimad{F#as}{M#os} convidad{F#as}{M#os}. Você também é um{F#a} amig{F#a}{M#o} próxim{F#a}{M#o} de Ayaka. Não só é uma boa decisão, como não existe alguém melhor para ela."
                                                                },
                                                                {
                                                                    "id": "698350120",
                                                                    "speaker": "Kamisato Ayato",
                                                                    "text": "De qualquer forma, seu jeito de se portar, bem como a sua sofisticação, garantem-me o seu excelente gosto em tecidos.",
                                                                    "choices": [
                                                                        {
                                                                            "id": "698350121",
                                                                            "text": "Então... escolho o da esquerda.",
                                                                            "response": [
                                                                                {
                                                                                    "id": "698350123",
                                                                                    "speaker": "Kamisato Ayato",
                                                                                    "text": "Hmm, uma boa escolha. Com licença, esse daqui. Prepare cinco pacotes para serem entregues na Mansão Kamisato."
                                                                                },
                                                                                {
                                                                                    "id": "698350124",
                                                                                    "speaker": "Kamisato Ayato",
                                                                                    "text": "#Meus sinceros agradecimentos, {NICKNAME}. Eu estava e um profundo imbróglio."
                                                                                },
                                                                                {
                                                                                    "id": "698350125",
                                                                                    "speaker": "Kamisato Ayato",
                                                                                    "text": "Ainda tenho outras questões para resolver. Venha visitar-nos quando os tecidos estiverem prontos.",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "698350126",
                                                                                            "text": "Eu vou.",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "698350129",
                                                                                                    "speaker": "Kamisato Ayato",
                                                                                                    "text": "#Adeus por ora, {NICKNAME}. Até o nosso próximo encontro."
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "698350127",
                                                                                            "text": "Espero que as roupas fiquem lindas.",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "698350128",
                                                                                                    "speaker": "Kamisato Ayato",
                                                                                                    "text": "Com o tecido de alta qualidade que você escolheu, a beleza está mais que garantida."
                                                                                                }
                                                                                            ]
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "698350122",
                                                                            "text": "Então... escolho o da direita."
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "698350118",
                                                            "text": "Você tem certeza que é uma boa decisão deixar isso comigo?"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "698350114",
                                            "text": "Nunca imaginei que roupas fossem um assunto tão complicado..."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "698350106",
                            "text": "Pensei que você deixaria isso nas mãos de seus subordinados."
                        }
                    ]
                }
            ]
        }
    ]
}