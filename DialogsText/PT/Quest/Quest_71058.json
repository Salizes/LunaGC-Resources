    "talks": [
        {
            "id": "7105801",
            "objective": "",
            "dialogues": [
                {
                    "id": "710580101",
                    "speaker": "???",
                    "text": "*Cof* *Cof*... Espere, pare...! Quem é você? Por que você está aqui?"
                },
                {
                    "id": "710580102",
                    "speaker": "???",
                    "text": "E por que está me atacando?"
                },
                {
                    "id": "710580103",
                    "speaker": "Paimon",
                    "text": "Nós é que temos que lhe perguntar! Por que você está vagando por aqui?!"
                },
                {
                    "id": "710580104",
                    "speaker": "Player",
                    "text": "Você é uma pessoa má, fale primeiro."
                },
                {
                    "id": "710580105",
                    "speaker": "???",
                    "text": "Eu sou Katarina... Katarina Snezhevna."
                },
                {
                    "id": "710580106",
                    "speaker": "Katarina",
                    "text": "O nome é a informação que menos merece ser protegida, só posso lhe revelar isso, me desculpe."
                },
                {
                    "id": "710580107",
                    "speaker": "Paimon",
                    "text": "Hã... Nós só queríamos saber sobre a situação, não queremos fazer um interrogatório!"
                },
                {
                    "id": "710580108",
                    "speaker": "Katarina",
                    "text": "Me desculpe, mas essa é toda informação que posso revelar."
                },
                {
                    "id": "710580109",
                    "speaker": "Player",
                    "text": "O que os Fatui estão fazendo aqui?"
                },
                {
                    "id": "710580110",
                    "speaker": "Katarina",
                    "text": "Segredo."
                },
                {
                    "id": "710580111",
                    "speaker": "Player",
                    "text": "..."
                },
                {
                    "id": "710580112",
                    "speaker": "Paimon",
                    "text": "O quê?! Pessoas más sempre são suspeitas!"
                },
                {
                    "id": "710580113",
                    "speaker": "Katarina",
                    "text": "Haha, sim, nós somos maus."
                },
                {
                    "id": "710580114",
                    "speaker": "Katarina",
                    "text": "#Bem, o tempo {F#das garotinhas}{M#dos garotinhos} curios{F#as}{M#os} acabou... Nós temos o que fazer."
                }
            ]
        },
        {
            "id": "7105802",
            "objective": "Parece que a feiticeira Fatui derrotada tem algo a dizer",
            "dialogues": []
        },
        {
            "id": "7105803",
            "objective": "Derrote os Cogumelos Flutuantes que apareceram",
            "dialogues": []
        },
        {
            "id": "7105804",
            "objective": "Continue a conversa interrompida com a feiticeira Fatui",
            "dialogues": [
                {
                    "id": "710580201",
                    "speaker": "Katarina",
                    "text": "Obrigada... Eu estou muito feliz que você não aproveitou a chance para me esfaquear pelas minhas costas.",
                    "choices": [
                        {
                            "id": "710580202",
                            "text": "Isso é algo que eu deveria dizer.",
                            "response": [
                                {
                                    "id": "710580204",
                                    "speaker": "Katarina",
                                    "text": "Não sei que preconceito você possui com os Fatui, mas um lugar como esse não é nem um pouco romântico para se ter uma conversa... Se você tiver algo a dizer, venha até meu esconderijo."
                                },
                                {
                                    "id": "710580207",
                                    "speaker": "Black Screen",
                                    "text": "Katarina partiu."
                                },
                                {
                                    "id": "710580205",
                                    "speaker": "Paimon",
                                    "text": "Hã? Ela é uma Fatuus! Nós vamos deixar ela ir embora assim? Não deveríamos entregá-la para os Millelith?"
                                },
                                {
                                    "id": "710580206",
                                    "speaker": "Paimon",
                                    "text": "Hmm... Paimon entende, vamos deixar para lá. De qualquer forma, ela não nos feriu, por isso pode-se dizer que poupamos sua vida!"
                                }
                            ]
                        },
                        {
                            "id": "710580203",
                            "text": "Os Fatui são assim suspeitos com todas as outras pessoas?"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7105805",
            "objective": "Vá para o acampamento que a feiticeira Fatui está se escondendo",
            "dialogues": [
                {
                    "id": "710580501",
                    "speaker": "Katarina",
                    "text": "Oh, vocês vieram. Por favor, descansem um pouco."
                },
                {
                    "id": "710580502",
                    "speaker": "Katarina",
                    "text": "Eu tenho um pouco de... Hã... Chá preto... Não, não tenho... Açúcar... Também não... Hmm, leite... Estragou... — Eu vou jogar fora depois, me desculpem."
                },
                {
                    "id": "710580503",
                    "speaker": "Katarina",
                    "text": "Mas tem Água de Fogo o suficiente, além de biscoito seco e geleia azeda — o suficiente para uma festinha do chá."
                },
                {
                    "id": "710580504",
                    "speaker": "Paimon",
                    "text": "Eita...! Vocês realmente consideram que Água de Fogo é algo comum para festas do chá?"
                },
                {
                    "id": "710580505",
                    "speaker": "Katarina",
                    "text": "Sim, é estranho?",
                    "choices": [
                        {
                            "id": "710580506",
                            "text": "Uhh... Não parece ser uma boa ideia.",
                            "response": [
                                {
                                    "id": "710580507",
                                    "speaker": "Katarina",
                                    "text": "O quê? Hehe, ninguém vai te julgar por beber aqui. Apenas fique a vontade!",
                                    "choices": [
                                        {
                                            "id": "710580510",
                                            "text": "O que você está fazendo aqui?",
                                            "response": [
                                                {
                                                    "id": "710580512",
                                                    "speaker": "Katarina",
                                                    "text": "\"Compartilhar certas informações e comida pode silenciar a boca dos curiosos\"."
                                                },
                                                {
                                                    "id": "710580513",
                                                    "speaker": "Katarina",
                                                    "text": "... É isso que nosso manual diz."
                                                },
                                                {
                                                    "id": "710580514",
                                                    "speaker": "Player",
                                                    "text": "Mas onde está a informação?"
                                                },
                                                {
                                                    "id": "710580515",
                                                    "speaker": "Katarina",
                                                    "text": "Hã? Foi isso."
                                                },
                                                {
                                                    "id": "710580516",
                                                    "speaker": "Paimon",
                                                    "text": "Hã? O que você disse?"
                                                },
                                                {
                                                    "id": "710580517",
                                                    "speaker": "Katarina",
                                                    "text": "Anexo 4-4, artigo 32 do \"Manual de Treinamento da Equipe-Vanguarda Fatui\": \"Compartilhar certas informações e comida pode silenciar a boca dos curiosos\"."
                                                },
                                                {
                                                    "id": "710580518",
                                                    "speaker": "Katarina",
                                                    "text": "Eu compartilhei com você o conteúdo secreto de nosso manual de treinamento como compensação por ter salvo minha vida! O que você acha dessa minha sinceridade?"
                                                },
                                                {
                                                    "id": "710580519",
                                                    "speaker": "Paimon",
                                                    "text": "E qual a utilidade de nos revelar isso?!"
                                                },
                                                {
                                                    "id": "710580520",
                                                    "speaker": "Katarina",
                                                    "text": "Haha, só estou brincando com vocês... Mas sendo franca, muito obrigada pela sua ajuda, não me entendam mal."
                                                },
                                                {
                                                    "id": "710580521",
                                                    "speaker": "Paimon",
                                                    "text": "*Suspiro* Tendo em vista todas as coisas ruins que vocês fizeram antes, é difícil acreditar que os Fatui possuem boas intenções..."
                                                },
                                                {
                                                    "id": "710580522",
                                                    "speaker": "Player",
                                                    "text": "O que você está tramando?"
                                                },
                                                {
                                                    "id": "710580523",
                                                    "speaker": "Katarina",
                                                    "text": "Não me surpreende que os forasteiros não consigam entender a causa dos Fatui. Mas quando não estamos falando do que buscamos ou de que lado estamos, somos apenas um bando de pessoas comuns."
                                                },
                                                {
                                                    "id": "710580524",
                                                    "speaker": "Katarina",
                                                    "text": "...Além disso, sejam quais forem os nossos propósitos, estamos apenas nos preparando para a batalha final."
                                                },
                                                {
                                                    "id": "710580525",
                                                    "speaker": "Player",
                                                    "text": "Batalha final...?"
                                                },
                                                {
                                                    "id": "710580526",
                                                    "speaker": "Katarina",
                                                    "text": "Sim. No fim, todos enfrentaremos um inimigo em comum e as inescapáveis longas noites... Todos em Snezhnaya foram avisados."
                                                },
                                                {
                                                    "id": "710580527",
                                                    "speaker": "Katarina",
                                                    "text": "Então, pelo bem deste mundo cruel, todas as gotas de lágrimas e sangue da humanidade... não serão derramadas em vão."
                                                },
                                                {
                                                    "id": "710580528",
                                                    "speaker": "Katarina",
                                                    "text": "Vamos brindar! Não? Hunf, como quiser...",
                                                    "choices": [
                                                        {
                                                            "id": "710580529",
                                                            "text": "É assim que você justifica o mal que você fez?",
                                                            "response": [
                                                                {
                                                                    "id": "710580530",
                                                                    "speaker": "Katarina",
                                                                    "text": "Talvez você tenha razão... eu não sei, nem me importo em saber. Você quis uma explicação, eu te dei uma. Mas você pode não ter gostado. Só isso."
                                                                },
                                                                {
                                                                    "id": "710580534",
                                                                    "speaker": "Paimon",
                                                                    "text": "Urg... Paimon não está acostumada a ter que pensar em coisas tão sérias e profundas..."
                                                                },
                                                                {
                                                                    "id": "710580535",
                                                                    "speaker": "Katarina",
                                                                    "text": "A propósito, eu me apresentei, porém, ainda não sei o seu nome.",
                                                                    "choices": [
                                                                        {
                                                                            "id": "710580536",
                                                                            "text": "#{NICKNAME}.",
                                                                            "response": [
                                                                                {
                                                                                    "id": "710580538",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "Sou Paimon! Você deve ter ouvido falar deste nome também!"
                                                                                },
                                                                                {
                                                                                    "id": "710580539",
                                                                                    "speaker": "Katarina",
                                                                                    "text": "Oh! Seu nome...!"
                                                                                },
                                                                                {
                                                                                    "id": "710580540",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "Hunf! Que tal? Deve ser muito bem conhecido por todo Teyvat, não é?"
                                                                                },
                                                                                {
                                                                                    "id": "710580541",
                                                                                    "speaker": "Katarina",
                                                                                    "text": "Me desculpe, nunca ouvi falar de vocês. Nem uma vez sequer."
                                                                                },
                                                                                {
                                                                                    "id": "710580542",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "Hã?"
                                                                                },
                                                                                {
                                                                                    "id": "710580543",
                                                                                    "speaker": "Katarina",
                                                                                    "text": "Por favor, não leve para o lado pessoal — fui enviada para cá há muito tempo. Eu mal sei o que tem acontecido na superfície além do que é dito pelas notícias da linha de fornecimento..."
                                                                                },
                                                                                {
                                                                                    "id": "710580544",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "Hã... Isso não quer dizer que..."
                                                                                },
                                                                                {
                                                                                    "id": "710580545",
                                                                                    "speaker": "Player",
                                                                                    "text": "Que a linha de suprimentos de vocês já deixou de funcionar há muito tempo?"
                                                                                },
                                                                                {
                                                                                    "id": "710580546",
                                                                                    "speaker": "Katarina",
                                                                                    "text": "..."
                                                                                },
                                                                                {
                                                                                    "id": "710580547",
                                                                                    "speaker": "Katarina",
                                                                                    "text": "A festa de chá acabou! Eu preciso descansar, me desculpem!"
                                                                                },
                                                                                {
                                                                                    "id": "710580548",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "Ei! A gente ainda nem começou a comer!"
                                                                                },
                                                                                {
                                                                                    "id": "710580549",
                                                                                    "speaker": "Katarina",
                                                                                    "text": "Saia logo daqui! Você não falou mal da minha Água de Fogo!?"
                                                                                },
                                                                                {
                                                                                    "id": "710580550",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "É porque Paimon não fazia ideia de que isso sequer era comestível!",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "710580551",
                                                                                            "text": "Ok, Paimon...",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "710580553",
                                                                                                    "speaker": "Paimon",
                                                                                                    "text": "Hunf!"
                                                                                                },
                                                                                                {
                                                                                                    "id": "710580554",
                                                                                                    "speaker": "Katarina",
                                                                                                    "text": "#A propósito, {NICKNAME}. Por favor, espere um momento..."
                                                                                                },
                                                                                                {
                                                                                                    "id": "710580555",
                                                                                                    "speaker": "Katarina",
                                                                                                    "text": "Hã, não é nada, é só que, se fosse você..."
                                                                                                },
                                                                                                {
                                                                                                    "id": "710580556",
                                                                                                    "speaker": "Katarina",
                                                                                                    "text": "Por favor, volte outro dia... Se lhe for conveniente."
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "710580552",
                                                                                            "text": "As pessoas têm diferentes preferencias em comidas, sabe..."
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "710580537",
                                                                            "text": "#Você deve ter ouvido falar de mim. Sou {M#o}{F#a} {NICKNAME}."
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "710580531",
                                                            "text": "Essa é uma explicação bem meia boca...",
                                                            "response": [
                                                                {
                                                                    "id": "710580532",
                                                                    "speaker": "Katarina",
                                                                    "text": "Ha...! Você deveria experimentar o licor e a geleia de Snezhnaya."
                                                                },
                                                                {
                                                                    "id": "710580533",
                                                                    "speaker": "Katarina",
                                                                    "text": "#Você está sendo séri{M#o}{F#a} demais. Não pense muito nisso. Apenas acredite no que quiser acreditar. É isso que chamamos \"fé\"."
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "710580511",
                                            "text": "O que raios você está fazendo aqui?"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "710580508",
                            "text": "Nós não viemos aqui para tomar chá...",
                            "response": [
                                {
                                    "id": "710580509",
                                    "speaker": "Katarina",
                                    "text": "#Eu sei, eu sei... Não fique alterad{F#a}{M#o}.",
                                    "choices": [
                                        {
                                            "id": "710580510",
                                            "text": "O que você está fazendo aqui?"
                                        },
                                        {
                                            "id": "710580511",
                                            "text": "O que raios você está fazendo aqui?"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                }
            ]
        },
