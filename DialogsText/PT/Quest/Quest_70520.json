    "talks": [
        {
            "id": "7052001",
            "objective": "Retorne para a loja e cheque como o evento beneficente está indo",
            "dialogues": [
                {
                    "id": "705200101",
                    "speaker": "Bernhard",
                    "text": "#Cavaleir{F#a}{M#o} Honorável, Paimon! Boas notícias! Temos novos ajudantes!"
                },
                {
                    "id": "705200102",
                    "speaker": "Bernhard",
                    "text": "Estes dois lojistas ouviram falar de nossa venda beneficente e quiseram se juntar a nós, doando seus ganhos."
                },
                {
                    "id": "705200103",
                    "speaker": "Paimon",
                    "text": "O quê? Eles querem doar seus lucros? É sério?"
                },
                {
                    "id": "705200104",
                    "speaker": "Mats",
                    "text": "É claro!"
                },
                {
                    "id": "705200105",
                    "speaker": "Mats",
                    "text": "Quanto mais lucrarmos, mais pessoas receberão a ajuda que necessitam. Tanto Pauline quanto eu achamos que isso é muito mais significativo do que simplesmente ganhar dinheiro."
                },
                {
                    "id": "705200106",
                    "speaker": "Pauline",
                    "text": "Esse Festvinho está muito mais animado que o de anos anteriores. Já atingimos nossa meta de lucros antes do previsto e estamos realmente satisfeitos."
                },
                {
                    "id": "705200107",
                    "speaker": "Pauline",
                    "text": "#Não podemos deixar vocês lidarem com as crianças e idosos sozinh{F#as}{M#os}. Queremos fazer o que pudermos para ajudar também. Por favor, não se esforcem demais."
                },
                {
                    "id": "705200108",
                    "speaker": "Player",
                    "text": "Estamos muito agradecidos."
                },
                {
                    "id": "705200109",
                    "speaker": "Paimon",
                    "text": "Sim, Paimon está sentindo um calorzinho no coração..."
                },
                {
                    "id": "705200110",
                    "speaker": "Paimon",
                    "text": "Bem, agora teremos que mudar o nome da loja! Pode ser... \"Aliança Beneficente do Ventão de Favonius\"!",
                    "choices": [
                        {
                            "id": "705200111",
                            "text": "Bem, o vento está mesmo ficando mais forte.",
                            "response": [
                                {
                                    "id": "705200113",
                                    "speaker": "Paimon",
                                    "text": "Vamos dar o nosso melhor e tornar essas vendas beneficentes um sucesso!"
                                },
                                {
                                    "id": "705200114",
                                    "speaker": "Black Screen",
                                    "text": "Os dois lojistas se juntaram à equipe. As vendas beneficentes foram ampliadas..."
                                },
                                {
                                    "id": "705200115",
                                    "speaker": "Paimon",
                                    "text": "Venham dar uma olhada nos aperitivos especiais da \"Aliança Beneficente do Ventão de Favonius\"..."
                                },
                                {
                                    "id": "705200116",
                                    "speaker": "Paimon",
                                    "text": "Hã? Vejam! É Albedo!"
                                },
                                {
                                    "id": "705200117",
                                    "speaker": "Albedo",
                                    "text": "#Olá {NICKNAME} e Paimon.",
                                    "choices": [
                                        {
                                            "id": "705200118",
                                            "text": "Seja bem-vindo.",
                                            "response": [
                                                {
                                                    "id": "705200120",
                                                    "speaker": "Paimon",
                                                    "text": "Albedo, quer comprar alguma coisa?"
                                                },
                                                {
                                                    "id": "705200121",
                                                    "speaker": "Albedo",
                                                    "text": "Eu não estou precisando de nada. Acabei de saber que vocês que estão gerenciando a loja dos Cavaleiros de Favonius."
                                                },
                                                {
                                                    "id": "705200122",
                                                    "speaker": "Albedo",
                                                    "text": "Por coincidência, eu e Timaeus fizemos progresso em nossas pesquisas e quisemos trazer para vocês um lote de nossos produtos. Vocês podem ver como um patrocínio para a venda beneficente."
                                                },
                                                {
                                                    "id": "705200123",
                                                    "speaker": "Paimon",
                                                    "text": "Então você veio especialmente para nos ajudar? Que legal!"
                                                },
                                                {
                                                    "id": "705200124",
                                                    "speaker": "Paimon",
                                                    "text": "Deixa Paimon ver o que tem nessa garrafa..."
                                                },
                                                {
                                                    "id": "705200125",
                                                    "speaker": "Albedo",
                                                    "text": "É uma Poção de Sobriedade Extraforte. Ela ajuda as pessoas a ficarem sóbrias, e alivia os efeitos da ressaca."
                                                },
                                                {
                                                    "id": "705200126",
                                                    "speaker": "Albedo",
                                                    "text": "Por favor, distribuam ela gratuitamente às pessoas necessitadas. Usar elas como brindes pode ajudar a atrair mais clientes."
                                                },
                                                {
                                                    "id": "705200127",
                                                    "speaker": "Paimon",
                                                    "text": "Fazer algo tão útil assim deve ter tomado muito do seu tempo, não é?"
                                                },
                                                {
                                                    "id": "705200128",
                                                    "speaker": "Albedo",
                                                    "text": "Oh? Será que já faz tanto tempo assim que eu não mostro minhas habilidades?"
                                                },
                                                {
                                                    "id": "705200129",
                                                    "speaker": "Albedo",
                                                    "text": "Antes, eu provavelmente não me importaria com uma pesquisa como essa."
                                                },
                                                {
                                                    "id": "705200130",
                                                    "speaker": "Albedo",
                                                    "text": "Mas os produtos alquímicos poderem melhorar a vida das pessoas é uma coisa maravilhosa."
                                                },
                                                {
                                                    "id": "705200131",
                                                    "speaker": "Paimon",
                                                    "text": "Sim! Embora Paimon nunca tenha ficado bêbada, ela pode imaginar como isso poderia ajudar as pessoas."
                                                },
                                                {
                                                    "id": "705200132",
                                                    "speaker": "Paimon",
                                                    "text": "Seria uma pena se alguém caísse em um lago ou tropeçasse em uma pedra depois de apenas desfrutar de uma taça de vinho, não é mesmo?"
                                                },
                                                {
                                                    "id": "705200133",
                                                    "speaker": "Player",
                                                    "text": "Não podemos aceitar sem oferecer nada em troca."
                                                },
                                                {
                                                    "id": "705200134",
                                                    "speaker": "Paimon",
                                                    "text": "É mesmo. Albedo, leve alguns aperitivos e divida com a Klee. É por nossa conta!"
                                                },
                                                {
                                                    "id": "705200135",
                                                    "speaker": "Albedo",
                                                    "text": "Tudo bem, eu não posso recusar."
                                                },
                                                {
                                                    "id": "705200136",
                                                    "speaker": "Albedo",
                                                    "text": "Não imaginei que vocês tivessem um senso empresarial tão bom."
                                                },
                                                {
                                                    "id": "705200137",
                                                    "speaker": "Albedo",
                                                    "text": "A localização da lanchonete é boa. Não apenas combina com a atmosfera festiva, mas a divisão de trabalho também combina com a personalidade de vocês."
                                                },
                                                {
                                                    "id": "705200138",
                                                    "speaker": "Albedo",
                                                    "text": "Se a loja estivesse sendo gerida por algum outro Cavaleiro qualquer, ela provavelmente teria acabado como uma loja de produtos genéricos."
                                                },
                                                {
                                                    "id": "705200139",
                                                    "speaker": "Paimon",
                                                    "text": "Uau, os elogios de Albedo estão fazendo Paimon sentir como se tivesse tomado uma daquelas sopas para ressaca!"
                                                },
                                                {
                                                    "id": "705200140",
                                                    "speaker": "Paimon",
                                                    "text": "Hmm, parece que você conhece muito sobre vendas beneficentes, Albedo!"
                                                },
                                                {
                                                    "id": "705200141",
                                                    "speaker": "Albedo",
                                                    "text": "Sim, quando os Cavaleiros de Favonius fazem vendas beneficentes, eu costumo fornecer umas dez pinturas paisagísticas para eles venderem."
                                                },
                                                {
                                                    "id": "705200142",
                                                    "speaker": "Paimon",
                                                    "text": "Uau, as pinturas de Albedo devem ser super valiosas!"
                                                },
                                                {
                                                    "id": "705200143",
                                                    "speaker": "Albedo",
                                                    "text": "Seus pensamentos são iguais aos da maioria dos comerciantes."
                                                },
                                                {
                                                    "id": "705200144",
                                                    "speaker": "Albedo",
                                                    "text": "Algumas pessoas realmente acham que meu estilo artístico é de fato uma mercadoria rara que vale a pena investir. Por isso, gastam fortunas comprando elas."
                                                },
                                                {
                                                    "id": "705200145",
                                                    "speaker": "Albedo",
                                                    "text": "Além disso, os lucros obtidos com o leiloamento de meus rascunhos foram consideráveis... Foi nesse momento que a Senhorita Alice reparou em algo."
                                                },
                                                {
                                                    "id": "705200146",
                                                    "speaker": "Albedo",
                                                    "text": "Ela usou suas conexões pessoais para solicitar um tipo de certificação para a minha arte... acho que é algo chamado \"Patente\"."
                                                },
                                                {
                                                    "id": "705200147",
                                                    "speaker": "Albedo",
                                                    "text": "Muitos artistas começaram a imitar minhas pinturas paisagísticas. O estilo tornou-se comum em Mondstadt.",
                                                    "choices": [
                                                        {
                                                            "id": "705200148",
                                                            "text": "Isso me é familiar...",
                                                            "response": [
                                                                {
                                                                    "id": "705200150",
                                                                    "speaker": "Albedo",
                                                                    "text": "De acordo com as regras da \"patente\" que a Sra. Alice solicitou, os artistas são obrigados a me pagar uma porcentagem de cada pintura paisagística vendida."
                                                                },
                                                                {
                                                                    "id": "705200151",
                                                                    "speaker": "Albedo",
                                                                    "text": "A riqueza nunca foi o meu alvo. Eu realmente não me importo para onde o dinheiro vai, então confiei sua gestão aos Cavaleiros de Favonius."
                                                                },
                                                                {
                                                                    "id": "705200152",
                                                                    "speaker": "Albedo",
                                                                    "text": "Se dependesse de mim... hmm, acho que seria muito apropriado usá-lo para pagar pela destruição que a Srta. Alice causou."
                                                                },
                                                                {
                                                                    "id": "705200153",
                                                                    "speaker": "Albedo",
                                                                    "text": "Mas ouvi dizer que eles gastaram tudo em caridade.",
                                                                    "choices": [
                                                                        {
                                                                            "id": "705200154",
                                                                            "text": "Você nunca participou de uma venda beneficente...",
                                                                            "response": [
                                                                                {
                                                                                    "id": "705200156",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "Albedo, você impressionante..."
                                                                                },
                                                                                {
                                                                                    "id": "705200157",
                                                                                    "speaker": "Albedo",
                                                                                    "text": "Embora não fosse a minha intenção, aos poucos estou aprendendo a aceitar que algo maravilhoso e inesperado surgiu de tudo aquilo.",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "705200158",
                                                                                            "text": "Fico feliz por você.",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "705200159",
                                                                                                    "speaker": "Albedo",
                                                                                                    "text": "#Obrigado, {NICKNAME}."
                                                                                                },
                                                                                                {
                                                                                                    "id": "705200162",
                                                                                                    "speaker": "Albedo",
                                                                                                    "text": "Bem, agora vou voltar para a oficina. Desejo boa sorte a você e aos seus negócios."
                                                                                                },
                                                                                                {
                                                                                                    "id": "705200163",
                                                                                                    "speaker": "Paimon",
                                                                                                    "text": "Paimon agradece seu patrocínio, Albedo. Boa sorte com sua pesquisa também!"
                                                                                                },
                                                                                                {
                                                                                                    "id": "705200164",
                                                                                                    "speaker": "Black Screen",
                                                                                                    "text": "Você levou um tempo para preparar os aperitivos para Albedo levar..."
                                                                                                },
                                                                                                {
                                                                                                    "id": "705200165",
                                                                                                    "speaker": "Paimon",
                                                                                                    "text": "Volte quando estiver livre!"
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "705200160",
                                                                                            "text": "Quero aprender a pintar.",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "705200161",
                                                                                                    "speaker": "Albedo",
                                                                                                    "text": "Claro, ficarei feliz em compartilhar minhas experiências com você. No entanto... hã, vamos dizer que você ainda precisa praticar muito."
                                                                                                }
                                                                                            ]
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "705200155",
                                                                            "text": "Mas alcançou o mesmo objetivo..."
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "705200149",
                                                            "text": "Então as pinturas eram suas..."
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "705200119",
                                            "text": "Quanto tempo."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "705200112",
                            "text": "Vuuuush!"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7052002",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "705200201",
                    "speaker": "Bernhard",
                    "text": "#Cavaleir{F#a}{M#o} Honorável, Paimon, dois lojistas desejam se juntar a nós. A escala de nossa venda beneficente está crescendo!"
                },
                {
                    "id": "705200202",
                    "speaker": "Black Screen",
                    "text": "Você se encontra com os dois lojistas que se juntaram a vocês..."
                },
                {
                    "id": "705200203",
                    "speaker": "Bernhard",
                    "text": "Bem, eu vou incomodar vocês com mais uma coisa. Por favor, façam a gestão de nossas três lojas e continuem essa venda beneficente!"
                }
            ]
        }
    ]
}