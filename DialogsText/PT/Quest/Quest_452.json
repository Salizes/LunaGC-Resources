    "talks": [
        {
            "id": "45201",
            "objective": "Encontre a Amber e pergunte sobre o garoto do Reino dos Lobos",
            "dialogues": [
                {
                    "id": "4520101",
                    "speaker": "Amber",
                    "text": "#Olá, Paimon e {NICKNAME}! No que posso ajudar?"
                },
                {
                    "id": "4520102",
                    "speaker": "Paimon",
                    "text": "Olá, Amber!",
                    "choices": [
                        {
                            "id": "4520103",
                            "text": "Amber, aconteceu uma coisa...",
                            "response": [
                                {
                                    "id": "4520104",
                                    "speaker": "Paimon",
                                    "text": "Você conhece um menino lobo do Reino dos Lobos?"
                                },
                                {
                                    "id": "4520105",
                                    "speaker": "Amber",
                                    "text": "Hã?"
                                },
                                {
                                    "id": "4520106",
                                    "speaker": "Paimon",
                                    "text": "Ele disse que vocês se deram bem como uma montanha em chamas..."
                                },
                                {
                                    "id": "4520107",
                                    "speaker": "Amber",
                                    "text": "Do que diabos você está falando?"
                                },
                                {
                                    "id": "4520108",
                                    "speaker": "Paimon",
                                    "text": "Estranho... Ele disse que esperaria por você no lugar de sempre. Você perdeu a memória ou algo assim?"
                                },
                                {
                                    "id": "4520109",
                                    "speaker": "Amber",
                                    "text": "Minha memória está bem. Mas você tem comido cogumelo mágico de novo, não é mesmo Paimon?"
                                },
                                {
                                    "id": "4520110",
                                    "speaker": "Amber",
                                    "text": "Não faço a menor ideia do que você está falando."
                                },
                                {
                                    "id": "4520111",
                                    "speaker": "Paimon",
                                    "text": "Cogumelo mágico... Me lembre de que cor eles são mesmo?"
                                },
                                {
                                    "id": "4520112",
                                    "speaker": "Amber",
                                    "text": "Roxo."
                                },
                                {
                                    "id": "4520113",
                                    "speaker": "Paimon",
                                    "text": "... Paimon deve ter comido alguns outro dia."
                                },
                                {
                                    "id": "4520114",
                                    "speaker": "Paimon",
                                    "text": "Mas esse não é o ponto! Paimon não está alucinando!"
                                },
                                {
                                    "id": "4520115",
                                    "speaker": "Paimon",
                                    "text": "Você realmente não conhece aquele menino que vive com os lobos?"
                                },
                                {
                                    "id": "4520116",
                                    "speaker": "Amber",
                                    "text": "Eu. Não. Sei. Do. Que. Você. Está. Falando!"
                                },
                                {
                                    "id": "4520117",
                                    "speaker": "Amber",
                                    "text": "Mas sobre os lobos, eu tenho investigado algo recentemente."
                                },
                                {
                                    "id": "4520118",
                                    "speaker": "Amber",
                                    "text": "No passado, os lobos não se atreviam a se aventurar fora do Reino do Lobo, mas agora eles estão mais atrevidos."
                                },
                                {
                                    "id": "4520119",
                                    "speaker": "Amber",
                                    "text": "Ouvi falar que eles atacaram uma caravana perto do Desfiladeiro dos Bêbados."
                                },
                                {
                                    "id": "4520120",
                                    "speaker": "Amber",
                                    "text": "Se você estiver com tempo, você poderia me ajudar a ver a situação?",
                                    "choices": [
                                        {
                                            "id": "4520121",
                                            "text": "Sem problemas.",
                                            "response": [
                                                {
                                                    "id": "4520123",
                                                    "speaker": "Amber",
                                                    "text": "Ótimo! Eu sabia que podia contar com você. Vamos lá!"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "4520122",
                                            "text": "Vamos lá."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "4520124",
                            "text": "Ei, Amber, o que foi?",
                            "response": [
                                {
                                    "id": "4520125",
                                    "speaker": "Amber",
                                    "text": "Oi... Você parece que não tem muito o que fazer no momento."
                                },
                                {
                                    "id": "4520126",
                                    "speaker": "Paimon",
                                    "text": "Uh oh, lá vem..."
                                },
                                {
                                    "id": "4520127",
                                    "speaker": "Amber",
                                    "text": "Ultimamente tenho estado muito ocupada. Os deveres de uma Aventureira nunca terminam... você não quer ajudar?"
                                },
                                {
                                    "id": "4520129",
                                    "speaker": "Paimon",
                                    "text": "Eu te disse!",
                                    "choices": [
                                        {
                                            "id": "4520130",
                                            "text": "Sem problemas.",
                                            "response": [
                                                {
                                                    "id": "4520132",
                                                    "speaker": "Amber",
                                                    "text": "Recentemente, os lobos têm atacado as carroças do Desfiladeiro dos Bêbados."
                                                },
                                                {
                                                    "id": "4520133",
                                                    "speaker": "Amber",
                                                    "text": "Como você sabe, os lobos são perigosos, mas eles possuem as suas próprias regras."
                                                },
                                                {
                                                    "id": "4520134",
                                                    "speaker": "Amber",
                                                    "text": "Os lobos de Mondstadt normalmente não saem das Montanhas da Coroa Brilhante e do Reino dos Lobos."
                                                },
                                                {
                                                    "id": "4520135",
                                                    "speaker": "Paimon",
                                                    "text": "Sim, Paimon ouviu alguém falar que aquelas áreas possuem suas próprias regras, apesar de serem selvagens e intocados pelos humanos."
                                                },
                                                {
                                                    "id": "4520136",
                                                    "speaker": "Amber",
                                                    "text": "Isso mesmo. Então não é normal os lobos aparecerem no Desfiladeiro dos Bêbados."
                                                },
                                                {
                                                    "id": "4520137",
                                                    "speaker": "Paimon",
                                                    "text": "Por falar em lobos, você conhece por acaso um menino lobo do Reino dos Lobos?"
                                                },
                                                {
                                                    "id": "4520138",
                                                    "speaker": "Amber",
                                                    "text": "Quem? Nunca ouvi falar de ninguém assim em Mondstadt."
                                                },
                                                {
                                                    "id": "4520139",
                                                    "speaker": "Paimon",
                                                    "text": "Ei?"
                                                },
                                                {
                                                    "id": "4520140",
                                                    "speaker": "Paimon",
                                                    "text": "\"A garota vermelha e flamejante\"... Não é você?"
                                                },
                                                {
                                                    "id": "4520141",
                                                    "speaker": "Amber",
                                                    "text": "Flamejante...? Do que você está falando?"
                                                },
                                                {
                                                    "id": "4520142",
                                                    "speaker": "Amber",
                                                    "text": "Enfim, estou indo para o Desfiladeiro dos Bêbados investigar."
                                                },
                                                {
                                                    "id": "4520143",
                                                    "speaker": "Amber",
                                                    "text": "Venha comigo!"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "4520131",
                                            "text": "Qual é o problema?"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "45202",
            "objective": "Vá até o Desfiladeiro dos Bêbados",
            "dialogues": [
                {
                    "id": "4520201",
                    "speaker": "Amber",
                    "text": "Olhe, lá na frente! Algo está acontecendo."
                },
                {
                    "id": "4520202",
                    "speaker": "Paimon",
                    "text": "Não é uma alcateia... Parece que são os Hilichurls que estão atacando as carroças no fim das contas."
                },
                {
                    "id": "4520203",
                    "speaker": "Amber",
                    "text": "Hum... No fim das contas, não é nenhum mistério."
                },
                {
                    "id": "4520204",
                    "speaker": "Amber",
                    "text": "Chega de conversa fiada! Vamos ajudar!"
                }
            ]
        },
        {
            "id": "45203",
            "objective": "Fale com a Amber sobre a movimentação à frente",
            "dialogues": []
        },
        {
            "id": "45206",
            "objective": "Elimine os Hilichurls",
            "dialogues": []
        },
        {
            "id": "45204",
            "objective": "Elimine os Hilichurls",
            "dialogues": [
                {
                    "id": "4520401",
                    "speaker": "Amber",
                    "text": "Rápido, vamos lá ajudar!"
                }
            ]
        },
        {
            "id": "45205",
            "objective": "Fale com Siegfria",
            "dialogues": [
                {
                    "id": "4520301",
                    "speaker": "Siegfria",
                    "text": "Obrigada, muito obrigada!"
                },
                {
                    "id": "4520302",
                    "speaker": "Paimon",
                    "text": "Mamão com açúcar!"
                },
                {
                    "id": "4520303",
                    "speaker": "Amber",
                    "text": "Então, os Hilichurls aproveitaram a oportunidade do pânico dos lobos para atacar."
                },
                {
                    "id": "4520304",
                    "speaker": "Siegfria",
                    "text": "Isso mesmo. Mas tenho que dizer, se você acha que os Hilichurls dão trabalho, os lobos são piores."
                },
                {
                    "id": "4520305",
                    "speaker": "Siegfria",
                    "text": "Eles... Atacaram o Vale Termal nesta manhã."
                },
                {
                    "id": "4520306",
                    "speaker": "Amber",
                    "text": "Vale Termal? Isso é loucura!"
                },
                {
                    "id": "4520307",
                    "speaker": "Siegfria",
                    "text": "É algo inédito."
                },
                {
                    "id": "4520308",
                    "speaker": "Siegfria",
                    "text": "Eu pensei em me arriscar na estrada depois que os lobos tivessem terminado de brincar... Eu nunca pensei que os Hilichurls apareceriam também."
                },
                {
                    "id": "4520309",
                    "speaker": "Amber",
                    "text": "Temos que avançar rápido para ver o quão ruim está a situação."
                },
                {
                    "id": "4520310",
                    "speaker": "Amber",
                    "text": "Mas primeiro, você precisa examinar os danos da sua carroça. Ela ainda está funcionando?"
                },
                {
                    "id": "4520311",
                    "speaker": "Siegfria",
                    "text": "Darei uma olhada."
                }
            ]
        }
    ]
}