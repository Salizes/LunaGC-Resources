            "dialogues": [
                {
                    "id": "771270301",
                    "speaker": "Paimon",
                    "text": "Ei, você está bem?"
                },
                {
                    "id": "771270302",
                    "speaker": "Geladinho Melancólico",
                    "text": "Ohhh... Ya-ho..."
                },
                {
                    "id": "771270303",
                    "speaker": "Black Screen",
                    "text": "O Geladinho melancólico aponta para a própria cabeça..."
                },
                {
                    "id": "771270304",
                    "speaker": "Paimon",
                    "text": "Ah... Paimon entendeu agora! Você está triste porque todo mundo tem um chapéu, menos você!"
                },
                {
                    "id": "771270305",
                    "speaker": "Geladinho Melancólico",
                    "text": "Ya-ho, Ya-ho...",
                    "choices": [
                        {
                            "id": "771270306",
                            "text": "Ah, coitadinho...",
                            "response": [
                                {
                                    "id": "771270307",
                                    "speaker": "Paimon",
                                    "text": "É verdade..."
                                },
                                {
                                    "id": "771270310",
                                    "speaker": "Paimon",
                                    "text": "Vamos ver... Se esse pequenino só está triste porque não tem um chapéu, por que não procuramos um para ele?"
                                },
                                {
                                    "id": "771270311",
                                    "speaker": "Geladinho Melancólico",
                                    "text": "Ya-ho ya-ho!"
                                },
                                {
                                    "id": "771270312",
                                    "speaker": "Paimon",
                                    "text": "Mas onde vamos encontrar um?"
                                },
                                {
                                    "id": "771270313",
                                    "speaker": "Geladinho Melancólico",
                                    "text": "Ya-ho, Ya-ho!"
                                },
                                {
                                    "id": "771270314",
                                    "speaker": "Paimon",
                                    "text": "Ah, você sabe onde tem um?"
                                },
                                {
                                    "id": "771270315",
                                    "speaker": "Geladinho Melancólico",
                                    "text": "Ya-ho..."
                                },
                                {
                                    "id": "771270316",
                                    "speaker": "Paimon",
                                    "text": "Ah... Então é isso! Tem um chapéu <color=#00E1FFFF>lá embaixo naquele poço</color>... Ou melhor, ele provavelmente só caiu lá por acidente, não foi?"
                                },
                                {
                                    "id": "771270317",
                                    "speaker": "Paimon",
                                    "text": "Vamos descer e pegá-lo para você!"
                                },
                                {
                                    "id": "771270318",
                                    "speaker": "Geladinho Melancólico",
                                    "text": "Ya-ho! Ya-ho!"
                                }
                            ]
                        },
                        {
                            "id": "771270308",
                            "text": "Não deixe essa comparação sem sentido abalar você.",
                            "response": [
                                {
                                    "id": "771270309",
                                    "speaker": "Paimon",
                                    "text": "Paimon duvida que ele tenha entendido o que você quis dizer."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7712702",
            "objective": "",
            "dialogues": [
