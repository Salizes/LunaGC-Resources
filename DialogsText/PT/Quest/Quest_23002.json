    "talks": [
        {
            "id": "2300201",
            "objective": "Fale com Hanbei",
            "dialogues": [
                {
                    "id": "230020101",
                    "speaker": "Hanbei",
                    "text": "Os cogumelos aqui não parecem tão ruins. Vou colocar na minha lista de compras..."
                },
                {
                    "id": "230020102",
                    "speaker": "Paimon",
                    "text": "Hanbei? Esse é um nome familiar. Paimon já ouviu em algum lugar...",
                    "choices": [
                        {
                            "id": "230020103",
                            "text": "É... é aquela pessoa de Tatarasuna...",
                            "response": [
                                {
                                    "id": "230020105",
                                    "speaker": "Paimon",
                                    "text": "Uau! Ele é o cara que fez uma bagunça completa na \"Fornalha Mikage\"!",
                                    "choices": [
                                        {
                                            "id": "230020106",
                                            "text": "Acho que ele está aqui como representante estrangeiro...",
                                            "response": [
                                                {
                                                    "id": "230020108",
                                                    "speaker": "Paimon",
                                                    "text": "Então ele está realmente aqui em Sumeru. Paimon achava que aquilo tudo de representante estrangeiro era só uma brincadeira..."
                                                },
                                                {
                                                    "id": "230020109",
                                                    "speaker": "Hanbei",
                                                    "text": "Hã? Cabelo loiro... e uma coisinha voadora..."
                                                },
                                                {
                                                    "id": "230020110",
                                                    "speaker": "Hanbei",
                                                    "text": "#Você é {F#a}{M#o} Viajante?",
                                                    "choices": [
                                                        {
                                                            "id": "230020111",
                                                            "text": "Sim, sou eu.",
                                                            "response": [
                                                                {
                                                                    "id": "230020114",
                                                                    "speaker": "Hanbei",
                                                                    "text": "Haha, realmente é você. A carta de Yousuke mencionava como você ajudou o Sr. Xavier a lidar com a \"Fornalha Mikage\"."
                                                                },
                                                                {
                                                                    "id": "230020115",
                                                                    "speaker": "Hanbei",
                                                                    "text": "*Suspiro* Eu me sinto tão envergonhado. Eu estava ocupado com o trabalho administrativo quando você e Senhor Xavier estavam consertando a Fornalha Mikage."
                                                                },
                                                                {
                                                                    "id": "230020116",
                                                                    "speaker": "Player",
                                                                    "text": "Papelada é mais importante que a Fornalha Mikage?"
                                                                },
                                                                {
                                                                    "id": "230020117",
                                                                    "speaker": "Paimon",
                                                                    "text": "Suas prioridades estão todas erradas!"
                                                                },
                                                                {
                                                                    "id": "230020118",
                                                                    "speaker": "Hanbei",
                                                                    "text": "Veja bem, sem a papelada administrativa, a manutenção da Fornalha Mikage não estaria correndo tão bem."
                                                                },
                                                                {
                                                                    "id": "230020119",
                                                                    "speaker": "Hanbei",
                                                                    "text": "Eu estava evacuando as pessoas próximas, preparando os materiais para os reparos, redirecionando a mão de obra necessária, e até mesmo coordenando a produção..."
                                                                },
                                                                {
                                                                    "id": "230020120",
                                                                    "speaker": "Hanbei",
                                                                    "text": "Sem meu trabalho administrativo, tudo seria um caos."
                                                                },
                                                                {
                                                                    "id": "230020121",
                                                                    "speaker": "Player",
                                                                    "text": "É como Toranosuke disse..."
                                                                },
                                                                {
                                                                    "id": "230020122",
                                                                    "speaker": "Paimon",
                                                                    "text": "Você faz jus à sua reputação..."
                                                                },
                                                                {
                                                                    "id": "230020123",
                                                                    "speaker": "Hanbei",
                                                                    "text": "Toranosuke... Ele despreza trabalho administrativo. Sempre acabo tendo que trabalhar mais quando tenho que fazer algo com ele."
                                                                },
                                                                {
                                                                    "id": "230020124",
                                                                    "speaker": "Hanbei",
                                                                    "text": "Mas eu não estou mais no comando da Fornalha Mikage. Estou servindo como representante estrangeiro em Sumeru agora e administro o comércio de cogumelos."
                                                                },
                                                                {
                                                                    "id": "230020125",
                                                                    "speaker": "Hanbei",
                                                                    "text": "Oh, Viajante, Yousuke me contou os seus feitos. Creio que você seja uma pessoa confiável."
                                                                },
                                                                {
                                                                    "id": "230020126",
                                                                    "speaker": "Hanbei",
                                                                    "text": "Se você não se importar, posso pedir um favor?"
                                                                },
                                                                {
                                                                    "id": "230020127",
                                                                    "speaker": "Hanbei",
                                                                    "text": "Estou procurando um fornecedor confiável de cogumelos, e encontrei muitos comerciantes aqui."
                                                                },
                                                                {
                                                                    "id": "230020128",
                                                                    "speaker": "Hanbei",
                                                                    "text": "Mas eles sempre selecionam apenas os melhores para exibir..."
                                                                },
                                                                {
                                                                    "id": "230020129",
                                                                    "speaker": "Hanbei",
                                                                    "text": "Acho que uma visita às suas fazendas é necessária para avaliar a qualidade do seu abastecimento."
                                                                },
                                                                {
                                                                    "id": "230020130",
                                                                    "speaker": "Hanbei",
                                                                    "text": "Mas, como você pode ver, não tenho experiência em conduzir pesquisas na natureza. E acho que não conseguirei sair vivo da floresta se for sozinho."
                                                                },
                                                                {
                                                                    "id": "230020131",
                                                                    "speaker": "Hanbei",
                                                                    "text": "Então, eu gostaria que você fosse lá e pegasse alguns cogumelos para mim...",
                                                                    "choices": [
                                                                        {
                                                                            "id": "230020132",
                                                                            "text": "Bom, eu posso fazer isso...",
                                                                            "response": [
                                                                                {
                                                                                    "id": "230020134",
                                                                                    "speaker": "Hanbei",
                                                                                    "text": "Você vai fazer isso? Maravilhoso! Não se preocupe com o seu pagamento, eu até preparei a documentação de contrato."
                                                                                },
                                                                                {
                                                                                    "id": "230020135",
                                                                                    "speaker": "Hanbei",
                                                                                    "text": "Dê uma olhada nesse documento daqui. Este é o seu contrato, remuneração e um acordo de divulgação e confidencialidade. Ah, quase esqueci, este é o mapa daquela fazenda de cogumelos..."
                                                                                },
                                                                                {
                                                                                    "id": "230020136",
                                                                                    "speaker": "Black Screen",
                                                                                    "text": "#Você está exaust{F#a}{M#o} após examinar cuidadosamente todos os documentos com Hanbei..."
                                                                                },
                                                                                {
                                                                                    "id": "230020137",
                                                                                    "speaker": "Hanbei",
                                                                                    "text": "#Bom, agora você está totalmente informad{F#a}{M#o}. Enviarei um relatório ao Shogunato, e podemos finalizar tudo assim que tivermos a aprovação do Shogunato."
                                                                                },
                                                                                {
                                                                                    "id": "230020138",
                                                                                    "speaker": "Hanbei",
                                                                                    "text": "Mas eu pagarei do meu próprio bolso até lá. Afinal, não posso mais adiar isso."
                                                                                },
                                                                                {
                                                                                    "id": "230020139",
                                                                                    "speaker": "Hanbei",
                                                                                    "text": "Claro, enviarei os documentos necessários para isso também. Sua remuneração também vem com implicações fiscais."
                                                                                },
                                                                                {
                                                                                    "id": "230020140",
                                                                                    "speaker": "Player",
                                                                                    "text": "Eu... vou colher os cogumelos agora!"
                                                                                },
                                                                                {
                                                                                    "id": "230020141",
                                                                                    "speaker": "Hanbei",
                                                                                    "text": "Hã? Ah, estou contando com você!"
                                                                                },
                                                                                {
                                                                                    "id": "230020142",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "Não vamos acabar nos envolvendo nos problemas de novo, não é?",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "230020143",
                                                                                            "text": "Estou de olho nele.",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "230020144",
                                                                                                    "speaker": "Paimon",
                                                                                                    "text": "Sério? Certo, você tem razão..."
                                                                                                },
                                                                                                {
                                                                                                    "id": "230020147",
                                                                                                    "speaker": "Hanbei",
                                                                                                    "text": "Hã? Por que você está com essa cara de dúvida? Não se preocupe, agora tudo está preparado, então não haverá nenhum problema durante este processo."
                                                                                                },
                                                                                                {
                                                                                                    "id": "230020148",
                                                                                                    "speaker": "Paimon",
                                                                                                    "text": "Não estamos falando sobre esse tipo de problema... *Suspiro* Enfim, vamos só pegar os cogumelos dele."
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "230020145",
                                                                                            "text": "Eu me pergunto que tipo de problema ele vai causar desta vez.",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "230020146",
                                                                                                    "speaker": "Paimon",
                                                                                                    "text": "Ei! Se isso realmente acontecer, não temos ninguém para nos ajudar aqui!"
                                                                                                }
                                                                                            ]
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "230020133",
                                                                            "text": "Mas vamos falar sobre o meu pagamento primeiro..."
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "230020112",
                                                            "text": "Esta é Paimon...",
                                                            "response": [
                                                                {
                                                                    "id": "230020113",
                                                                    "speaker": "Paimon",
                                                                    "text": "É Paimon! Não uma \"coisinha voadora\"!"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "230020107",
                                            "text": "Acho que ele está aqui pelos cogumelos..."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "230020104",
                            "text": "Toranosuke e Yousuke o mencionaram..."
                        }
                    ]
                }
            ]
        },
        {
            "id": "2300202",
            "objective": "Vá colher cogumelos",
            "dialogues": [
                {
                    "id": "230020201",
                    "speaker": "Hanbei",
                    "text": "E então? Você conseguiu pegar os cogumelos?"
                }
            ]
        },
        {
            "id": "2300203",
            "objective": "Colha cogumelos",
            "dialogues": [
                {
                    "id": "230020301",
                    "speaker": "Hanbei",
                    "text": "Maravilhoso, esses são suficientes. Parecem ótimos também..."
                },
                {
                    "id": "230020302",
                    "speaker": "Hanbei",
                    "text": "Aqui está a sua compensação, obrigado pela ajuda."
                },
                {
                    "id": "230020303",
                    "speaker": "Player",
                    "text": "Isso é antes ou depois dos impostos?"
                },
                {
                    "id": "230020304",
                    "speaker": "Hanbei",
                    "text": "Depois dos impostos, é claro. Não se preocupe, eu não faria você voltar para Inazuma só para pagar impostos atrasados."
                },
                {
                    "id": "230020305",
                    "speaker": "Hanbei",
                    "text": "Mas, não posso garantir que não houve nenhuma mudança nas políticas fiscais do Shogunato..."
                },
                {
                    "id": "230020306",
                    "speaker": "Hanbei",
                    "text": "Hmm... Escrever uma carta para Yousuke sobre isso parece uma boa ideia."
                }
            ]
        },
        {
            "id": "2300204",
            "objective": "Traga os cogumelos para Hanbei.",
            "dialogues": [
                {
                    "id": "230020401",
                    "speaker": "Hanbei",
                    "text": "Maravilhoso, esses são suficientes. Parecem ótimos também..."
                },
                {
                    "id": "230020402",
                    "speaker": "Player",
                    "text": "Eu até peguei alguns cogumelos extras."
                },
                {
                    "id": "230020403",
                    "speaker": "Hanbei",
                    "text": "Haha, que ótimo! Por favor, me dê eles. Vou adicioná-los ao seu pagamento."
                },
                {
                    "id": "230020404",
                    "speaker": "Hanbei",
                    "text": "Aqui está a sua compensação, obrigado pela ajuda."
                },
                {
                    "id": "230020405",
                    "speaker": "Player",
                    "text": "Isso é antes ou depois dos impostos?"
                },
                {
                    "id": "230020406",
                    "speaker": "Hanbei",
                    "text": "Depois dos impostos, é claro. Não se preocupe, eu não faria você voltar para Inazuma só para pagar impostos atrasados."
                },
                {
                    "id": "230020407",
                    "speaker": "Hanbei",
                    "text": "Mas, não posso garantir que não houve nenhuma mudança nas políticas fiscais do Shogunato..."
                },
                {
                    "id": "230020408",
                    "speaker": "Hanbei",
                    "text": "Hmm... Deveria escrever uma carta para Yousuke para perguntar sobre isso."
                }
            ]
        },
        {
            "id": "2300206",
            "objective": "Fale com Hanbei",
            "dialogues": []
        },
        {
            "id": "2300205",
            "objective": "Fale com Hanbei",
            "dialogues": []
        },
        {
            "id": "2300205",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "230020501",
                    "speaker": "Hanbei",
                    "text": "Este vendedor de cogumelos não me parece muito confiável..."
                },
                {
                    "id": "230020502",
                    "speaker": "Paimon",
                    "text": "Por que ele parece tão preocupado? Será que se meteu em algum problema de novo?"
                },
                {
                    "id": "230020503",
                    "speaker": "Hanbei",
                    "text": "Viajante, você está aqui. A qualidade dos cogumelos que você coletou foi muito boa."
                },
                {
                    "id": "230020504",
                    "speaker": "Hanbei",
                    "text": "Posso lhe pedir para me trazer mais alguns? Pretendo compará-los com os cogumelos de outros fornecedores.",
                    "choices": [
                        {
                            "id": "230020505",
                            "text": "Deixe comigo.",
                            "response": [
                                {
                                    "id": "230020506",
                                    "speaker": "Hanbei",
                                    "text": "Obrigado."
                                }
                            ]
                        },
                        {
                            "id": "230020507",
                            "text": "Com quantos fornecedores você se encontrou?",
                            "response": [
                                {
                                    "id": "230020508",
                                    "speaker": "Hanbei",
                                    "text": "Hmm, cinco ou seis. Mas seu fornecimento não parece muito confiável. Isso me deixa bastante incomodado."
                                },
                                {
                                    "id": "230020509",
                                    "speaker": "Hanbei",
                                    "text": "Vou continuar procurando outros fornecedores, enquanto isso, deixarei a coleta de cogumelos com você."
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}