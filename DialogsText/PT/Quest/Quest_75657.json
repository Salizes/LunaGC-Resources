    "talks": [
        {
            "id": "7565701",
            "objective": "",
            "dialogues": [
                {
                    "id": "756570201",
                    "speaker": "Paimon",
                    "text": "#Por aqui, {NICKNAME}, por aqui!"
                },
                {
                    "id": "756570202",
                    "speaker": "Paimon",
                    "text": "Se lembra deste lugar? Foi onde nossa jornada começou."
                },
                {
                    "id": "756570203",
                    "speaker": "Paimon",
                    "text": "Antes mesmo de perceber, estivemos em tantos lugares! Só de pensar nisso deixa Paimon meio emocionada. Ooh, ela poderia escrever um poema agora mesmo!",
                    "choices": [
                        {
                            "id": "756570204",
                            "text": "Então, por favor, ó grande barda Paimon!",
                            "response": [
                                {
                                    "id": "756570207",
                                    "speaker": "Paimon",
                                    "text": "Ah, Teyvat vasto!"
                                },
                                {
                                    "id": "756570208",
                                    "speaker": "Paimon",
                                    "text": "O quão longe viajamos e ainda não o vimos por completo!",
                                    "choices": [
                                        {
                                            "id": "756570209",
                                            "text": "(Permanecer em silêncio.)",
                                            "response": [
                                                {
                                                    "id": "756570211",
                                                    "speaker": "Paimon",
                                                    "text": "Ah! Ah... Uh, e o pensamento se foi.",
                                                    "choices": [
                                                        {
                                                            "id": "756570212",
                                                            "text": "Hahahaha!",
                                                            "response": [
                                                                {
                                                                    "id": "756570213",
                                                                    "speaker": "Paimon",
                                                                    "text": "É, é, ria a vontade. Paimon já está acostumada."
                                                                },
                                                                {
                                                                    "id": "756570216",
                                                                    "speaker": "Paimon",
                                                                    "text": "Mas sério, é fácil esquecer onde a gente começou depois de viajar por tanto tempo."
                                                                },
                                                                {
                                                                    "id": "756570217",
                                                                    "speaker": "Paimon",
                                                                    "text": "Por exemplo, Paimon não consegue lembrar qual é o sabor de Frango Assado com Mel hoje em dia, e aquele era um dos pratos favoritos de Paimon..."
                                                                },
                                                                {
                                                                    "id": "756570218",
                                                                    "speaker": "Paimon",
                                                                    "text": "Por isso Paimon comprou esse álbum pra começo de conversa, para tirar fotos dos lugares que fomos e pessoas que conhecemos."
                                                                },
                                                                {
                                                                    "id": "756570219",
                                                                    "speaker": "Paimon",
                                                                    "text": "\"O fim fica próximo assim que voltarmos para onde começamos.\" Isso sempre acontece em light novels e filmes, né?"
                                                                },
                                                                {
                                                                    "id": "756570220",
                                                                    "speaker": "Paimon",
                                                                    "text": "É por isso que estamos tirando uma foto aqui. Não pra gente ficar triste e tal, mas porque a gente espera lembrar sempre da estrada que tomamos, para trilhar melhor a estrada à frente...",
                                                                    "choices": [
                                                                        {
                                                                            "id": "756570221",
                                                                            "text": "Você tava ouvindo a minha conversa com Kazuha?",
                                                                            "response": [
                                                                                {
                                                                                    "id": "756570224",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "Qual é, a gente tava tentando criar uma atmosfera aqui — e agora se foi."
                                                                                },
                                                                                {
                                                                                    "id": "756570225",
                                                                                    "speaker": "Player",
                                                                                    "text": "Não se preocupe, entendo o que você quer dizer."
                                                                                },
                                                                                {
                                                                                    "id": "756570226",
                                                                                    "speaker": "Player",
                                                                                    "text": "Vamos continuar avançando."
                                                                                },
                                                                                {
                                                                                    "id": "756570227",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "Hehe, claro, contanto que você entenda."
                                                                                },
                                                                                {
                                                                                    "id": "756570228",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "Tudo bem! Sua modelo para essa foto vai ser a guia número de Teyvat! Então, que pose quer escolher?",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "756570229",
                                                                                            "text": "Vamos tentar uma pose divertida!",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "756570232",
                                                                                                    "speaker": "Paimon",
                                                                                                    "text": "Certo. Assim serve?",
                                                                                                    "choices": [
                                                                                                        {
                                                                                                            "id": "756570233",
                                                                                                            "text": "Perfeito. Diga xiiiis!",
                                                                                                            "response": [
                                                                                                                {
                                                                                                                    "id": "756570234",
                                                                                                                    "speaker": "Paimon",
                                                                                                                    "text": "Paimon tá pronta!"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "756570239",
                                                                                                                    "speaker": "Player",
                                                                                                                    "text": "A pose divertida deve servir melhor."
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "756570240",
                                                                                                                    "speaker": "Paimon",
                                                                                                                    "text": "Tudo bem!"
                                                                                                                }
                                                                                                            ]
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "756570235",
                                                                                                            "text": "Aliás, vamos com a pose elegante.",
                                                                                                            "response": [
                                                                                                                {
                                                                                                                    "id": "756570236",
                                                                                                                    "speaker": "Paimon",
                                                                                                                    "text": "Tudo bem!"
                                                                                                                }
                                                                                                            ]
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "756570237",
                                                                                                            "text": "Vamos usar a nossa pose relaxada ao invés disso.",
                                                                                                            "response": [
                                                                                                                {
                                                                                                                    "id": "756570238",
                                                                                                                    "speaker": "Paimon",
                                                                                                                    "text": "Tudo bem!"
                                                                                                                }
                                                                                                            ]
                                                                                                        }
                                                                                                    ]
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "756570230",
                                                                                            "text": "Uma pose elegante."
                                                                                        },
                                                                                        {
                                                                                            "id": "756570231",
                                                                                            "text": "Uma pose... relaxada."
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "756570222",
                                                                            "text": "Como é? Paimon está evoluindo!",
                                                                            "response": [
                                                                                {
                                                                                    "id": "756570223",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "Bem... É, Paimon tava escutando quando você e Kazuha estavam conversando."
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "756570214",
                                                            "text": "Você quer refletir sobre como a jornada tem sido difícil?",
                                                            "response": [
                                                                {
                                                                    "id": "756570215",
                                                                    "speaker": "Paimon",
                                                                    "text": "Isso mesmo! Hehe, você conhece Paimon muito bem."
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "756570210",
                                            "text": "Isso não rimou nem um pouco."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "756570205",
                            "text": "Pfff.",
                            "response": [
                                {
                                    "id": "756570206",
                                    "speaker": "Paimon",
                                    "text": "Oh, não interrompa. Deixa Paimon pensar..."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
