    "talks": [
        {
            "id": "2301101",
            "objective": "Fale com Viktor",
            "dialogues": [
                {
                    "id": "230110101",
                    "speaker": "Viktor",
                    "text": "Hmm... Como vou esculpir isso...",
                    "choices": [
                        {
                            "id": "230110102",
                            "text": "Oi!",
                            "response": [
                                {
                                    "id": "230110104",
                                    "speaker": "Viktor",
                                    "text": "Argh, quem é? Pare de me incomodar, eu..."
                                },
                                {
                                    "id": "230110105",
                                    "speaker": "Viktor",
                                    "text": "Hã?! Viajante? O que você está fazendo em Sumeru?"
                                },
                                {
                                    "id": "230110106",
                                    "speaker": "Viktor",
                                    "text": "Oh, qual é. Rudolf não mandou você aqui para me dar uma surra, né? Eu só mandei um presente para Lily!",
                                    "choices": [
                                        {
                                            "id": "230110107",
                                            "text": "Só estou de passagem...",
                                            "response": [
                                                {
                                                    "id": "230110108",
                                                    "speaker": "Viktor",
                                                    "text": "Você ainda está viajando... Que energia..."
                                                },
                                                {
                                                    "id": "230110112",
                                                    "speaker": "Viktor",
                                                    "text": "Mas eu não esperava encontrar você aqui em Sumeru..."
                                                },
                                                {
                                                    "id": "230110113",
                                                    "speaker": "Viktor",
                                                    "text": "Minhas ordens originais eram para retornar de Mondstadt para Snezhnaya."
                                                },
                                                {
                                                    "id": "230110114",
                                                    "speaker": "Viktor",
                                                    "text": "Mas outra ordem chegou e fui enviado para a Cidade de Sumeru para ajudar o Sr. Vsevolod. Além disso, me disseram que eu fui transferido para o comando do Mestre Pulcinella.",
                                                    "choices": [
                                                        {
                                                            "id": "230110115",
                                                            "text": "Pulcinella?",
                                                            "response": [
                                                                {
                                                                    "id": "230110117",
                                                                    "speaker": "Viktor",
                                                                    "text": "Sim... Bem, não. Eu não vou falar mais nada, ou o Sr. Vsevolod criticará minha falta de sensibilidade envolvendo questões de confidencialidade."
                                                                },
                                                                {
                                                                    "id": "230110118",
                                                                    "speaker": "Viktor",
                                                                    "text": "*Suspiro* Mas o nome dos Mensageiros sequer é um segredo. Nunca vou entender o motivo de ele ficar tão nervoso."
                                                                },
                                                                {
                                                                    "id": "230110119",
                                                                    "speaker": "Player",
                                                                    "text": "Então... O que você está fazendo em Sumeru?"
                                                                },
                                                                {
                                                                    "id": "230110120",
                                                                    "speaker": "Viktor",
                                                                    "text": "Oh, eu e o Sr. Vsevolod somos responsáveis principalmente por apoio logístico e coordenação. Em resumo, fazemos muitas compras."
                                                                },
                                                                {
                                                                    "id": "230110121",
                                                                    "speaker": "Viktor",
                                                                    "text": "Não parece grande coisa, mas é melhor do que ficar parado sem fazer nada na Catedral de Mondstadt."
                                                                },
                                                                {
                                                                    "id": "230110122",
                                                                    "speaker": "Viktor",
                                                                    "text": "Hehe, e com esse meu trabalho, tenho muito tempo livre, e ninguém fica de olho em mim..."
                                                                },
                                                                {
                                                                    "id": "230110123",
                                                                    "speaker": "Viktor",
                                                                    "text": "Eu até voltei a fazer meu passatempo de infância de entalhar madeira... E quem diria, Sumeru é uma terra cheia de madeira. É perfeito para praticar!"
                                                                },
                                                                {
                                                                    "id": "230110124",
                                                                    "speaker": "Viktor",
                                                                    "text": "Eu nunca imaginaria que minhas esculturas de madeira seriam populares entre as crianças. Elas ficam sempre me perguntando por elas, por isso prometi que faria uma para todos.",
                                                                    "choices": [
                                                                        {
                                                                            "id": "230110125",
                                                                            "text": "Mas você não é um Fatui?",
                                                                            "response": [
                                                                                {
                                                                                    "id": "230110126",
                                                                                    "speaker": "Viktor",
                                                                                    "text": "Sou sim, e daí? Quem disse que um Fatui não pode fazer brinquedos para crianças?"
                                                                                },
                                                                                {
                                                                                    "id": "230110127",
                                                                                    "speaker": "Viktor",
                                                                                    "text": "Além disso, eu sou apenas um cara da logística. As coisas importantes ficam todas nas mãos dos meus superiores."
                                                                                },
                                                                                {
                                                                                    "id": "230110130",
                                                                                    "speaker": "Viktor",
                                                                                    "text": "Resumindo, essa é a minha situação. Apesar de não ter voltado para Snezhnaya, estou gostando bastante de Sumeru. Aqui tem comida, é divertido, o ambiente também é bom."
                                                                                },
                                                                                {
                                                                                    "id": "230110131",
                                                                                    "speaker": "Viktor",
                                                                                    "text": "Depois do trabalho, eu compro algo para comer e procuro por um lugar com bastante sol para trabalhar com madeira."
                                                                                },
                                                                                {
                                                                                    "id": "230110132",
                                                                                    "speaker": "Viktor",
                                                                                    "text": "Entretanto... Haha, todos olham para mim com desconfiança, como você na primeira vez que conversamos."
                                                                                },
                                                                                {
                                                                                    "id": "230110133",
                                                                                    "speaker": "Viktor",
                                                                                    "text": "Mas não posso fazer nada, afinal, eu sou um Fatui.",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "230110134",
                                                                                            "text": "Eu ainda não confio em você.",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "230110136",
                                                                                                    "speaker": "Viktor",
                                                                                                    "text": "Tudo bem... Enfim, eu estou feliz com minha vida agora. Até consegui poupar um pouco de dinheiro."
                                                                                                },
                                                                                                {
                                                                                                    "id": "230110137",
                                                                                                    "speaker": "Viktor",
                                                                                                    "text": "Se isso continuar por mais alguns anos, eu talvez fique aqui em Sumeru definitivamente..."
                                                                                                },
                                                                                                {
                                                                                                    "id": "230110138",
                                                                                                    "speaker": "Viktor",
                                                                                                    "text": "#Ahem! Bem, já chega disso. Como você está aqui em Sumeru, caso esteja interessad{F#a}{M#o}, vamos continuar com nossa \"troca equivalente\"."
                                                                                                },
                                                                                                {
                                                                                                    "id": "230110139",
                                                                                                    "speaker": "Viktor",
                                                                                                    "text": "Entretanto, dessa vez não tenho nenhuma história para lhe contar. Seu pagamento dessa vez será apenas de Mora.",
                                                                                                    "choices": [
                                                                                                        {
                                                                                                            "id": "230110140",
                                                                                                            "text": "Prefiro.",
                                                                                                            "response": [
                                                                                                                {
                                                                                                                    "id": "230110143",
                                                                                                                    "speaker": "Viktor",
                                                                                                                    "text": "Tudo bem, deixe-me lhe descrever sobre o que esta comissão se trata."
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "230110144",
                                                                                                                    "speaker": "Viktor",
                                                                                                                    "text": "Encomendei um lote de madeira a Hamawi, mas ainda não foi entregue."
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "230110145",
                                                                                                                    "speaker": "Viktor",
                                                                                                                    "text": "Não posso falar com ele diretamente enquanto estou no meu expediente, ou então o Sr. Vsevolod vai me dar uma sermão..."
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "230110146",
                                                                                                                    "speaker": "Viktor",
                                                                                                                    "text": "Viajante, você pode me ajudar perguntando a Hamawi sobre meu lote de madeira?",
                                                                                                                    "choices": [
                                                                                                                        {
                                                                                                                            "id": "230110147",
                                                                                                                            "text": "Quero meu pagamento pronto.",
                                                                                                                            "response": [
                                                                                                                                {
                                                                                                                                    "id": "230110148",
                                                                                                                                    "speaker": "Viktor",
                                                                                                                                    "text": "Oh, não se preocupe. Já está pronto."
                                                                                                                                },
                                                                                                                                {
                                                                                                                                    "id": "230110151",
                                                                                                                                    "speaker": "Viktor",
                                                                                                                                    "text": "Ah, não importa, estou contando com você, Viajante."
                                                                                                                                }
                                                                                                                            ]
                                                                                                                        },
                                                                                                                        {
                                                                                                                            "id": "230110149",
                                                                                                                            "text": "Você não está tramando nada mesmo, né?",
                                                                                                                            "response": [
                                                                                                                                {
                                                                                                                                    "id": "230110150",
                                                                                                                                    "speaker": "Viktor",
                                                                                                                                    "text": "Oh, qual é, quando eu fiz algo assim? Não se preocupe, não estou com vontade de fazer nada assim... O que tem de errado em eu levar uma vida simples?"
                                                                                                                                }
                                                                                                                            ]
                                                                                                                        }
                                                                                                                    ]
                                                                                                                }
                                                                                                            ]
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "230110141",
                                                                                                            "text": "Eu estou fazendo uma comissão para os Fatui?",
                                                                                                            "response": [
                                                                                                                {
                                                                                                                    "id": "230110142",
                                                                                                                    "speaker": "Viktor",
                                                                                                                    "text": "Oh, mas é claro que não. Isso é uma comissão para mim, Viktor."
                                                                                                                }
                                                                                                            ]
                                                                                                        }
                                                                                                    ]
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "230110135",
                                                                                            "text": "E quem confiaria em você? Não tente fingir que nos damos bem."
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "230110128",
                                                                            "text": "Você não tá tentando se aproveitar das crianças para conseguir informações, né?",
                                                                            "response": [
                                                                                {
                                                                                    "id": "230110129",
                                                                                    "speaker": "Viktor",
                                                                                    "text": "Ei! Eu não faria uma coisa dessas! Que estereótipo horrível você tem dos Fatui!"
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "230110116",
                                                            "text": "É outro Mensageiro?"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "230110109",
                                            "text": "Sim, volte para Mondstadt comigo!",
                                            "response": [
                                                {
                                                    "id": "230110110",
                                                    "speaker": "Viktor",
                                                    "text": "Hahaha, vai nessa! Você vai me levar algemado de volta?"
                                                },
                                                {
                                                    "id": "230110111",
                                                    "speaker": "Viktor",
                                                    "text": "Bem, bem, chega de brincadeira. Eu tenho algo para fazer."
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "230110103",
                            "text": "Vi—Viktor?"
                        }
                    ]
                }
            ]
        },
        {
            "id": "2301102",
            "objective": "Fale com Hamawi",
            "dialogues": [
                {
                    "id": "230110301",
                    "speaker": "Hamawi",
                    "text": "Mas que azar..."
                },
                {
                    "id": "230110302",
                    "speaker": "Player",
                    "text": "Sobre o lote de madeiras de Viktor..."
                },
                {
                    "id": "230110303",
                    "speaker": "Hamawi",
                    "text": "Oh, você está falando da madeira que aquele Fatui pediu?"
                },
                {
                    "id": "230110304",
                    "speaker": "Hamawi",
                    "text": "*Suspiro* Eu sabia que fazer negócios com os Fatui não seria bom..."
                },
                {
                    "id": "230110305",
                    "speaker": "Hamawi",
                    "text": "Monstros atacaram enquanto estávamos transportando. Conseguimos voltar com vida, mas nossa carroça foi destruída. Fomos forçados a deixar a madeira pelo caminho."
                },
                {
                    "id": "230110306",
                    "speaker": "Hamawi",
                    "text": "Se vocês estão com pressa, podem ir lá para procurarem pessoalmente. Eu que não me atrevo a ir, nem encontro ninguém para eliminar esses monstros por mim..."
                },
                {
                    "id": "230110308",
                    "speaker": "Player",
                    "text": "#Eu não sou {F#uma}{M#um} Fatui..."
                },
                {
                    "id": "230110309",
                    "speaker": "Hamawi",
                    "text": "#Você não é {F#uma}{M#um} Fatui? Então por que está ajudando um?"
                },
                {
                    "id": "230110310",
                    "speaker": "Hamawi",
                    "text": "Enfim, apenas posso deixar meu carrinho por lá enquanto vejo se consigo contratar alguém para lidar com a situação."
                },
                {
                    "id": "230110311",
                    "speaker": "Hamawi",
                    "text": "Se você está com tanta pressa de pegar madeira, vou marcar a localização aproximada do carrinho no mapa para você, então você pode dar uma olhada por conta própria."
                },
                {
                    "id": "230110312",
                    "speaker": "Hamawi",
                    "text": "*Suspiro* Se associar com os Fatui não traz nada de bom..."
                }
            ]
        },
        {
            "id": "2301107",
            "objective": "",
            "dialogues": [
                {
                    "id": "230110701",
                    "speaker": "Viktor",
                    "text": "E aí? Minha madeira chegou?"
                },
                {
                    "id": "230110702",
                    "speaker": "Black Screen",
                    "text": "Você contou para Viktor o que aconteceu..."
                },
                {
                    "id": "230110703",
                    "speaker": "Viktor",
                    "text": "Foram os monstros de novo? Argh, sou só eu, ou parece que toda carroça no mundo está sendo atacada por monstros?"
                },
                {
                    "id": "230110704",
                    "speaker": "Viktor",
                    "text": "Ah, não importa, só quero que minha madeira chegue."
                },
                {
                    "id": "230110705",
                    "speaker": "Viktor",
                    "text": "Oh, sim. Aqui está o pagamento que prometi. Pode contar."
                },
                {
                    "id": "230110706",
                    "speaker": "Viktor",
                    "text": "E, mais uma coisa... Lily, ela, uh... Ela está bem?"
                },
                {
                    "id": "230110707",
                    "speaker": "Viktor",
                    "text": "Eu não me despedi dela quando parti. Ela não ficou brava, não é?",
                    "choices": [
                        {
                            "id": "230110708",
                            "text": "Ela está bem.",
                            "response": [
                                {
                                    "id": "230110709",
                                    "speaker": "Viktor",
                                    "text": "Bom, bom... Ahem! Oh, qual é, por que está olhando assim para mim? Eu só estava preocupado!"
                                },
                                {
                                    "id": "230110714",
                                    "speaker": "Viktor",
                                    "text": "Enfim, conte seu pagamento. Eu preparei a quantidade exata, nem uma Mora a mais ou a menos."
                                }
                            ]
                        },
                        {
                            "id": "230110710",
                            "text": "Você pode voltar e visitá-la pessoalmente.",
                            "response": [
                                {
                                    "id": "230110711",
                                    "speaker": "Viktor",
                                    "text": "O Sr. Vsevolod daria um chute para longe. Nem pensar."
                                },
                                {
                                    "id": "230110712",
                                    "speaker": "Viktor",
                                    "text": "E eu não tenho coragem de mandar uma carta diretamente também."
                                },
                                {
                                    "id": "230110713",
                                    "speaker": "Viktor",
                                    "text": "Receber uma carta de um Fatuus parece algo ruim, hahaha..."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
