    "talks": [
        {
            "id": "4020001",
            "objective": "Vá para a Corte de Fontaine com Yelan",
            "dialogues": [
                {
                    "id": "402000101",
                    "speaker": "Yelan",
                    "text": "A vista durante a noite é bem bonita..."
                },
                {
                    "id": "402000102",
                    "speaker": "Yelan",
                    "text": "O perfume fresco das Flores Rociomarinha, a fragrância da loja de perfumes na esquina e o aroma rico dos grãos de café se misturam na brisa da noite, criando uma atmosfera bem relaxante."
                },
                {
                    "id": "402000103",
                    "speaker": "Yelan",
                    "text": "Se conseguirmos encontrar um barzinho com terraço no telhado e tomarmos duas taças de vinho frisante, teremos uma experiência de leve embriaguez incrível...",
                    "choices": [
                        {
                            "id": "402000104",
                            "text": "Estamos de férias, não é? Então, vamos beber!",
                            "response": [
                                {
                                    "id": "402000106",
                                    "speaker": "Yelan",
                                    "text": "Ah, ótimo... então me acompanhe na busca. Será que esse bar escondido na cidade tem um cardápio surpreendente?"
                                },
                                {
                                    "id": "402000107",
                                    "speaker": "Yelan",
                                    "text": "#Mas, antes disso, enquanto a Confrerie de Cabriere ainda está aberta, que tal irmos junt{F#as}{M#os} escolher alguns perfumes para combinar com esta roupa?"
                                },
                                {
                                    "id": "402000108",
                                    "speaker": "Yelan",
                                    "text": "Ainda há relógios precisos, curiosos mecanismos com molas e joias de artesanato único. Há muitas lembranças que valem a pena conferir.",
                                    "choices": [
                                        {
                                            "id": "402000109",
                                            "text": "Quanto mais você trabalha, mais você quer gastar dinheiro?",
                                            "response": [
                                                {
                                                    "id": "402000111",
                                                    "speaker": "Yelan",
                                                    "text": "#Com {M#o}{F#a} Viajante mais {M#conhecedor}{F#conhecedora} e de melhor gosto de Teyvat me acompanhando, é claro que quero aproveitar essa oportunidade. Por favor, seja {M#meu conselheiro}{F#minha conselheira} desta vez..."
                                                },
                                                {
                                                    "id": "402000112",
                                                    "speaker": "Yelan",
                                                    "text": "Hmm... Estou satisfeita. Essa foi uma ótima jornada."
                                                },
                                                {
                                                    "id": "402000113",
                                                    "speaker": "Yelan",
                                                    "text": "Se pudermos estender o tempo e aproveitar a viagem por três a cinco dias, poderemos evitar o arrependimento causado pela pressa.",
                                                    "choices": [
                                                        {
                                                            "id": "402000114",
                                                            "text": "Você não disse que queria relaxar?",
                                                            "response": [
                                                                {
                                                                    "id": "402000116",
                                                                    "speaker": "Yelan",
                                                                    "text": "Não tem jeito, o próximo trabalhou chegou."
                                                                },
                                                                {
                                                                    "id": "402000117",
                                                                    "speaker": "Yelan",
                                                                    "text": "Além de escrever um relatório formal sobre este caso e ajudar a construir um sistema de liberação de mercadorias mais eficiente, também preciso me preparar para partir para o próximo local de missão..."
                                                                },
                                                                {
                                                                    "id": "402000118",
                                                                    "speaker": "Yelan",
                                                                    "text": "Nod-Krai.",
                                                                    "choices": [
                                                                        {
                                                                            "id": "402000119",
                                                                            "text": "É onde Paimon e eu iremos em seguida.",
                                                                            "response": [
                                                                                {
                                                                                    "id": "402000121",
                                                                                    "speaker": "Yelan",
                                                                                    "text": "Não se preocupe, é apenas um encontro com um parceiro de inteligência para definir um plano de benefícios mútuos e também estabelecer limites de não-interferência."
                                                                                },
                                                                                {
                                                                                    "id": "402000122",
                                                                                    "speaker": "Yelan",
                                                                                    "text": "#Vamos discutir isso mais tarde. Que tal tirarmos uma foto junt{M#os}{F#as} para celebrar essa viagem fantástica para Fontaine?",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "402000123",
                                                                                            "text": "Também para celebrar que você me colocou no caminho.",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "402000125",
                                                                                                    "speaker": "Yelan",
                                                                                                    "text": "#Isso mesmo, posso confiar plenamente em você, nova agente estrela {NICKNAME}."
                                                                                                },
                                                                                                {
                                                                                                    "id": "402000126",
                                                                                                    "speaker": "Yelan",
                                                                                                    "text": "Vamos usar o Dispositivo de Imagem Forense para tirar essa foto tão importante."
                                                                                                },
                                                                                                {
                                                                                                    "id": "402000127",
                                                                                                    "speaker": "Yelan",
                                                                                                    "text": "Espero que, quando nos encontrarmos novamente em Nod-Krai, possamos cooperar tão perfeitamente quanto desta vez."
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "402000124",
                                                                                            "text": "Também para celebrar nossa parceria bem-sucedida."
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "402000120",
                                                                            "text": "Algo inesperado te perturba?"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "402000115",
                                                            "text": "Parece que estamos voltando ao trabalho de novo..."
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "402000110",
                                            "text": "A hora de comprar coisas é agora!"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "402000105",
                            "text": "Acabamos de concluir um grande caso. Beba o quanto quiser!"
                        }
                    ]
                }
            ]
        },
        {
            "id": "4020002",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "402000201",
                    "speaker": "Paimon",
                    "text": "Então você está dizendo que o Oficial Fonck vai nos levar ao lugar onde os bandidos estão sendo interrogados, né?"
                },
                {
                    "id": "402000202",
                    "speaker": "Edler",
                    "text": "Isso mesmo. Estamos dando a chance a vocês de conferirem nossa base secreta..."
                },
                {
                    "id": "402000203",
                    "speaker": "Edler",
                    "text": "Haha, só estou brincando. Para garantir que não incomodemos o trabalho cotidiano de ninguém, preparamos um local de trabalho em uma casa remota. Quando partirmos, é melhor ficarem perto de mim, ok?"
                },
                {
                    "id": "402000204",
                    "speaker": "Paimon",
                    "text": "#Não se preocupe! A Paimon é uma guia super experiente — ela e {NICKNAME} já passaram por todos os tipos de lugares confusos, não tem chance de ela se perder em Fontaine!"
                },
                {
                    "id": "402000205",
                    "speaker": "Paimon",
                    "text": "#Ah, {NICKNAME} chegou."
                },
                {
                    "id": "402000206",
                    "speaker": "Paimon",
                    "text": "Que rápido! A Yelan é do tipo fecha-os-olhos-por-um-segundo-e-pronto-já-descansou-vamos-voltar-ao-trabalho, é?",
                    "choices": [
                        {
                            "id": "402000207",
                            "text": "Ainda nem começamos nossas férias.",
                            "response": [
                                {
                                    "id": "402000209",
                                    "speaker": "Paimon",
                                    "text": "Hehe, a Paimon está bem, não precisa se preocupar. Você não é o único que pode crescer!"
                                },
                                {
                                    "id": "402000210",
                                    "speaker": "Paimon",
                                    "text": "Está tudo resolvido, vocês dois podem ir e aproveitar as férias!"
                                },
                                {
                                    "id": "402000211",
                                    "speaker": "Paimon",
                                    "text": "Deixem todas as preocupações de lado e aproveitem de verdade esse tempo longe!"
                                },
                                {
                                    "id": "402000212",
                                    "speaker": "Edler",
                                    "text": "E da minha parte, vou garantir que a Inspetora Paimon seja bem cuidada. Tudo o que ela quiser aprender, tudo o que quiser comer — vamos atender a todas as suas necessidades!",
                                    "choices": [
                                        {
                                            "id": "402000213",
                                            "text": "Vou nessa, então!",
                                            "response": [
                                                {
                                                    "id": "402000215",
                                                    "speaker": "Paimon",
                                                    "text": "A Paimon vai ser uma ótima inspetora estagiária!"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "402000214",
                                            "text": "Boa sorte, Paimon!"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "402000208",
                            "text": "Fiquei um pouco preocupada, então vim dar uma olhadinha em vocês."
                        }
                    ]
                }
            ]
        }
    ]
}