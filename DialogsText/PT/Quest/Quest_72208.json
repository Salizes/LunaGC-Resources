    "talks": [
        {
            "id": "7220801",
            "objective": "",
            "dialogues": [
                {
                    "id": "722080101",
                    "speaker": "Ipe",
                    "text": "Hehe, embora suas habilidades de pesca já sejam boas, ainda há espaço para melhorar.",
                    "choices": [
                        {
                            "id": "722080102",
                            "text": "Hã?!",
                            "response": [
                                {
                                    "id": "722080104",
                                    "speaker": "Ipe",
                                    "text": "Ai desculpe, desculpe... eu sempre esqueço de dizer olá e acabo assustando as pessoas... hehe."
                                },
                                {
                                    "id": "722080105",
                                    "speaker": "Player",
                                    "text": "Mas parece que você gosta disso..."
                                },
                                {
                                    "id": "722080106",
                                    "speaker": "Ipe",
                                    "text": "Não posso evitar. De vez em quando é divertido assustar as crianças..."
                                },
                                {
                                    "id": "722080107",
                                    "speaker": "Ipe",
                                    "text": "*Aham*, voltemos ao tema da pesca.",
                                    "choices": [
                                        {
                                            "id": "722080108",
                                            "text": "Você está falando sério?",
                                            "response": [
                                                {
                                                    "id": "722080110",
                                                    "speaker": "Ipe",
                                                    "text": "É um pouco constrangedor dizer isso, mas a situação é a seguinte... Enquanto eu pescava, deixei cair o Amuleto que Makiri me deu na água. Dentro do amuleto está sua alma, bem como a bênção da grande Pássaro do Trovão."
                                                },
                                                {
                                                    "id": "722080111",
                                                    "speaker": "Ipe",
                                                    "text": "Quando eu subir no barco e ela descobrir que perdi algo tão importante será terrível..."
                                                },
                                                {
                                                    "id": "722080112",
                                                    "speaker": "Ipe",
                                                    "text": "O homem do barco dourado concordou em arranjar alguém para me ajudar a procurá-lo, mas até agora não há sinal dele... Então, agora que você está aqui, pode me ajudar!",
                                                    "choices": [
                                                        {
                                                            "id": "722080113",
                                                            "text": "Antes eu ainda achava você confiável...",
                                                            "response": [
                                                                {
                                                                    "id": "722080115",
                                                                    "speaker": "Ipe",
                                                                    "text": "O lugar onde eu costumo pescar é para lá, mas minha memória está ficando cada vez mais tênue. Talvez você deva ampliar sua área de pesquisa...",
                                                                    "choices": [
                                                                        {
                                                                            "id": "722080116",
                                                                            "text": "Bem, é uma lembrança antiga...",
                                                                            "response": [
                                                                                {
                                                                                    "id": "722080118",
                                                                                    "speaker": "Ipe",
                                                                                    "text": "Hmm? O que você disse? É assim que os forasteiros procuram as coisas...?"
                                                                                },
                                                                                {
                                                                                    "id": "722080119",
                                                                                    "speaker": "Ipe",
                                                                                    "text": "*Suspiro* Enfim, se você encontrar um lugar apropriado, só precisa procurar nele diretamente."
                                                                                },
                                                                                {
                                                                                    "id": "722080120",
                                                                                    "speaker": "Player",
                                                                                    "text": "Como que eu devo procurar?"
                                                                                },
                                                                                {
                                                                                    "id": "722080121",
                                                                                    "speaker": "Ipe",
                                                                                    "text": "Hã... Usando uma vara de pesca?"
                                                                                },
                                                                                {
                                                                                    "id": "722080122",
                                                                                    "speaker": "Player",
                                                                                    "text": "... Certo..."
                                                                                },
                                                                                {
                                                                                    "id": "722080123",
                                                                                    "speaker": "Ipe",
                                                                                    "text": "#A grande Pássaro do Trovão e os ancestrais irão protegê-l{F#a}{M#o}! Imploro-lhe, amig{F#a}{M#o} forasteir{F#a}{M#o}!"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "722080117",
                                                                            "text": "Acho que devo encontrar se usar a pena..."
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "722080114",
                                                            "text": "Estou sem mais alternativas...",
                                                            "response": [
                                                                {
                                                                    "id": "722080199",
                                                                    "speaker": "Ipe",
                                                                    "text": "A oeste da Planície Autake, há uma ilhota em frente a três cachoeiras... Fica ao largo da costa a oeste da ilhota..."
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "722080109",
                                            "text": "Como você pode continuar pensando em pescar...?"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "722080103",
                            "text": "Seria bom cumprimentar antes!"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7220803",
            "objective": "",
            "dialogues": [
                {
                    "id": "722080301",
                    "speaker": "Ipe",
                    "text": "Você voltou!"
                },
                {
                    "id": "722080302",
                    "speaker": "Player",
                    "text": "É isso o que você quer?"
                }
            ]
        },
        {
            "id": "7220804",
            "objective": "",
            "dialogues": [
                {
                    "id": "722080401",
                    "speaker": "Ipe",
                    "text": "Você voltou! Encontrou o amuleto protetor?"
                },
                {
                    "id": "722080402",
                    "speaker": "Player",
                    "text": "Estou tentando."
                },
                {
                    "id": "722080403",
                    "speaker": "Ipe",
                    "text": "#Oh, entendo. Não tenha pressa, e tome cuidado com sua segurança, amig{F#a}{M#o} que veio de fora da ilha."
                },
                {
                    "id": "722080404",
                    "speaker": "Ipe",
                    "text": "A oeste da Planície Autake, há uma ilhota em frente a três cachoeiras... Aquilo que preciso está ao largo da costa a oeste da ilhota..."
                }
            ]
        },
        {
            "id": "7220806",
            "objective": "",
            "dialogues": [
                {
                    "id": "722080201",
                    "speaker": "Ipe",
                    "text": "Obrigado! Eu agora finalmente posso embarcar despreocupado..."
                },
                {
                    "id": "722080202",
                    "speaker": "Player",
                    "text": "Para onde esse barco vai?"
                },
                {
                    "id": "722080203",
                    "speaker": "Ipe",
                    "text": "#Para uma terra dourada, uma terra dos sonhos. Um país que não tem neblina... Nós nos encontraremos em nossos sonhos, amig{F#a}{M#o}."
                }
            ]
        }
    ]
