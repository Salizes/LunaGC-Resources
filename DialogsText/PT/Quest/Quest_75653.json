    "talks": [
        {
            "id": "7565301",
            "objective": "",
            "dialogues": [
                {
                    "id": "756530201",
                    "speaker": "Xiangling",
                    "text": "#{NICKNAME}, é você! Quanto tempo! Engraçado, mencionei sobre você para Guoba ontem mesmo, e cá estamos."
                },
                {
                    "id": "756530202",
                    "speaker": "Xiangling",
                    "text": "Acho que isso é o que chamam de \"destino\", hein?"
                },
                {
                    "id": "756530203",
                    "speaker": "Xiangling",
                    "text": "Ah, certo. Para onde você está indo?",
                    "choices": [
                        {
                            "id": "756530204",
                            "text": "Eu estava indo tirar uma foto dessa ponte.",
                            "response": [
                                {
                                    "id": "756530206",
                                    "speaker": "Xiangling",
                                    "text": "Tirar fotos? Ooh, que coincidência. Ultimamente me interessei por isso."
                                },
                                {
                                    "id": "756530207",
                                    "speaker": "Xiangling",
                                    "text": "Usamos o mesmo pôster no restaurante há tanto tempo. Já passou da hora de termos um novo."
                                },
                                {
                                    "id": "756530208",
                                    "speaker": "Xiangling",
                                    "text": "Ando pensando que poderíamos atrair os transeuntes mais facilmente com algumas fotos bonitas de nossos pratos."
                                },
                                {
                                    "id": "756530209",
                                    "speaker": "Xiangling",
                                    "text": "Como diz o ditado: \"Um bom prato possui três partes de cores, três partes de aromas, três partes de sabor e uma parte de propaganda\"."
                                },
                                {
                                    "id": "756530210",
                                    "speaker": "Xiangling",
                                    "text": "...Digo isso, mas fui eu quem adicionou essa última parte."
                                },
                                {
                                    "id": "756530211",
                                    "speaker": "Xiangling",
                                    "text": "Meu pai sempre fala sobre os três primeiros — é uma sabedoria culinária comum.",
                                    "choices": [
                                        {
                                            "id": "756530212",
                                            "text": "Trabalhadora como sempre, hein, Xiangling?",
                                            "response": [
                                                {
                                                    "id": "756530213",
                                                    "speaker": "Xiangling",
                                                    "text": "Hehe. Obrigada!"
                                                },
                                                {
                                                    "id": "756530216",
                                                    "speaker": "Xiangling",
                                                    "text": "Encontrar ingredientes raros, criar novos pratos, aprender como fazer propaganda... Ainda tenho um longo caminho a percorrer em minha jornada culinária."
                                                },
                                                {
                                                    "id": "756530217",
                                                    "speaker": "Xiangling",
                                                    "text": "Haha, agora que você comentou, já faz um bom tempo desde que nos conhecemos, não é?"
                                                },
                                                {
                                                    "id": "756530218",
                                                    "speaker": "Xiangling",
                                                    "text": "Mas, muitas coisas também continuaram as mesmas, não é? Você ainda está viajando e eu continuo criando novos pratos."
                                                },
                                                {
                                                    "id": "756530219",
                                                    "speaker": "Xiangling",
                                                    "text": "Meu objetivo é manter o Restaurante Wanmin funcionando e torná-lo cada vez melhor."
                                                },
                                                {
                                                    "id": "756530220",
                                                    "speaker": "Xiangling",
                                                    "text": "Então, enquanto eu tiver forças em meus braços, eu estarei fritando e sacudindo meu wok mesmo quando eu já for uma vovózinha, entregando pratos deliciosos, super quentinhos, da panela para o prato."
                                                },
                                                {
                                                    "id": "756530221",
                                                    "speaker": "Xiangling",
                                                    "text": "Lembre-se de vir e comer com mais frequência, tudo bem?",
                                                    "choices": [
                                                        {
                                                            "id": "756530222",
                                                            "text": "Irei.",
                                                            "response": [
                                                                {
                                                                    "id": "756530223",
                                                                    "speaker": "Xiangling",
                                                                    "text": "Beleza, é um trato!"
                                                                },
                                                                {
                                                                    "id": "756530227",
                                                                    "speaker": "Xiangling",
                                                                    "text": "Ah, certo. Estou saindo do assunto. Você estava falando sobre tirar fotos, certo? Precisa de ajuda?"
                                                                },
                                                                {
                                                                    "id": "756530228",
                                                                    "speaker": "Player",
                                                                    "text": "Sim, chega junto para a foto, por favor!"
                                                                },
                                                                {
                                                                    "id": "756530229",
                                                                    "speaker": "Xiangling",
                                                                    "text": "Ah, tudo bem, claro! Que tipo de pose você gostaria que eu fizesse?",
                                                                    "choices": [
                                                                        {
                                                                            "id": "756530230",
                                                                            "text": "Uma pose elegante.",
                                                                            "response": [
                                                                                {
                                                                                    "id": "756530233",
                                                                                    "speaker": "Xiangling",
                                                                                    "text": "Assim?",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "756530234",
                                                                                            "text": "Perfeito. Diga xiiiis!",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "756530235",
                                                                                                    "speaker": "Xiangling",
                                                                                                    "text": "Tudo pronto."
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "756530236",
                                                                                            "text": "A pose divertida deve servir melhor.",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "756530237",
                                                                                                    "speaker": "Xiangling",
                                                                                                    "text": "Claro, vamos fazer assim então!"
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "756530238",
                                                                                            "text": "Acho melhor irmos com a pose alegre.",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "756530239",
                                                                                                    "speaker": "Xiangling",
                                                                                                    "text": "Claro, vamos fazer assim então!"
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "756530240",
                                                                                            "text": "Aliás, vamos com a pose elegante.",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "756530241",
                                                                                                    "speaker": "Xiangling",
                                                                                                    "text": "Claro!"
                                                                                                }
                                                                                            ]
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "756530231",
                                                                            "text": "Vamos tentar uma pose divertida!"
                                                                        },
                                                                        {
                                                                            "id": "756530232",
                                                                            "text": "Uma pose alegre."
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "756530224",
                                                            "text": "Veremos.",
                                                            "response": [
                                                                {
                                                                    "id": "756530225",
                                                                    "speaker": "Xiangling",
                                                                    "text": "#Haha, você está preocupad{M#o}{F#a} que não vai conseguir andar até lá?"
                                                                },
                                                                {
                                                                    "id": "756530226",
                                                                    "speaker": "Xiangling",
                                                                    "text": "Se esse for o caso, apenas escreva para mim — te mandarei comida que dá para guardar com facilidade."
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "756530214",
                                            "text": "As coisas não andam muito cansativas, né, Xiangling?",
                                            "response": [
                                                {
                                                    "id": "756530215",
                                                    "speaker": "Xiangling",
                                                    "text": "De jeito nenhum — na verdade, minha motivação cresce quanto mais faço coisas que gosto."
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "756530205",
                            "text": "Estou procurando por pessoas para tirar fotos."
                        }
                    ]
                }
            ]
        }
    ]
