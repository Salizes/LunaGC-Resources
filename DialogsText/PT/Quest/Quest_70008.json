    "talks": [
        {
            "id": "7000801",
            "objective": "",
            "dialogues": [
                {
                    "id": "700080101",
                    "speaker": "Margaret",
                    "text": "Afinal de contas, temos que lançar uma nova bebida..."
                },
                {
                    "id": "700080102",
                    "speaker": "Player",
                    "text": "Qual o problema?"
                },
                {
                    "id": "700080103",
                    "speaker": "Margaret",
                    "text": "Ah, é você. Na verdade, eu estava pensando em criar uma nova bebida especial com o tema do Festival da Brisa Florescente."
                },
                {
                    "id": "700080104",
                    "speaker": "Margaret",
                    "text": "Durante o período do Festival da Brisa Florescente, todos podem se divertir, comer e beber à vontade."
                },
                {
                    "id": "700080105",
                    "speaker": "Margaret",
                    "text": "Só que... Se continuarem bebendo, podem ficar bastante bêbados. E se ficarem bêbados demais, podem acabar sendo levados pelos Cavaleiros de Favonius para recuperar a sobriedade..."
                },
                {
                    "id": "700080106",
                    "speaker": "Margaret",
                    "text": "Por outro lado, o excesso de álcool poderia afetar a atmosfera festiva."
                },
                {
                    "id": "700080107",
                    "speaker": "Player",
                    "text": "Hmm. É sério?"
                },
                {
                    "id": "700080108",
                    "speaker": "Margaret",
                    "text": "Apesar disso... Eu também já ouvi falar que tem gente que adora esse ambiente cheio do aroma do vinho, mas ficar bêbado na rua, durante o Festival, não é uma boa opção, no final das contas."
                },
                {
                    "id": "700080109",
                    "speaker": "Margaret",
                    "text": "Então, eu estou pensando em fazer uma bebida não alcoólica à base de leite e com sabor do vento."
                },
                {
                    "id": "700080110",
                    "speaker": "Margaret",
                    "text": "Para enaltecer o sabor do vento, pensei em usar dois ingredientes especiais: Dandelions e Margaridas Voadoras."
                },
                {
                    "id": "700080111",
                    "speaker": "Margaret",
                    "text": "Mas se eu coletar sozinha, vai demorar muito... Viajante, você pode me ajudar a coletar um ingrediente?",
                    "choices": [
                        {
                            "id": "700080112",
                            "text": "Vou procurar Dandelions.",
                            "response": [
                                {
                                    "id": "700080113",
                                    "speaker": "Margaret",
                                    "text": "Então eu vou deixar com você! Os Dandelions no Penhasco das Estrelas são de boa qualidade. Então posso pedir-lhe para coletar alguns lá?"
                                },
                                {
                                    "id": "700080114",
                                    "speaker": "Margaret",
                                    "text": "Também posso ir coletar algumas Margaridas Voadoras, quando você coletar os materiais, nos encontramos aqui."
                                },
                                {
                                    "id": "700080115",
                                    "speaker": "Margaret",
                                    "text": "Depois de preparar a bebida aqui, procurarei alguma pessoa para prová-la..."
                                }
                            ]
                        },
                        {
                            "id": "700080116",
                            "text": "Vou procurar Margaridas Voadoras.",
                            "response": [
                                {
                                    "id": "700080117",
                                    "speaker": "Margaret",
                                    "text": "Por favor, você poderia ir até a Origem do Vento e colher algumas Margaridas Voadoras? A qualidade delas é muito boa."
                                },
                                {
                                    "id": "700080118",
                                    "speaker": "Margaret",
                                    "text": "Também vou coletar algumas Sementes de Dandelion. Depois de você coletar os materiais, nos encontramos aqui."
                                },
                                {
                                    "id": "700080119",
                                    "speaker": "Margaret",
                                    "text": "Depois de preparar a bebida aqui, procurarei alguma pessoa para prová-la..."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
