    "talks": [
        {
            "id": "7650701",
            "objective": "Vá à Cidade de Nasha",
            "dialogues": [
                {
                    "id": "765070101",
                    "speaker": "Paimon",
                    "text": "#Uau, {NICKNAME}, olha só! Parece que a gente acabou de pegar esse álbum ontem, e já enchemos ele tão rápido! E todas as fotos ficaram tão lindas!",
                    "choices": [
                        {
                            "id": "765070102",
                            "text": "O tempo voa quando estamos nos divertindo.",
                            "response": [
                                {
                                    "id": "765070104",
                                    "speaker": "Paimon",
                                    "text": "Hehe, a Paimon nunca imaginou que a gente encontraria tantos lugares lindos e tiraria tantas fotos dos nossos amigos..."
                                },
                                {
                                    "id": "765070105",
                                    "speaker": "Paimon",
                                    "text": "Ooh, e olha essa aqui! A gente se esforçou pra achar o ângulo perfeito, e o resultado ficou super incrível!",
                                    "choices": [
                                        {
                                            "id": "765070106",
                                            "text": "Tudo graças a você por nos guiar até lá, Paimon.",
                                            "response": [
                                                {
                                                    "id": "765070108",
                                                    "speaker": "Paimon",
                                                    "text": "Hehe, é claro! A Paimon é a melhor guia que existe!"
                                                },
                                                {
                                                    "id": "765070109",
                                                    "speaker": "Paimon",
                                                    "text": "E tudo o que ela precisa como pagamento são centenas de memórias felizes... Não, milhares!"
                                                },
                                                {
                                                    "id": "765070110",
                                                    "speaker": "Paimon",
                                                    "text": "#{NICKNAME}, como você se sente tirando fotos com esse Aparelho Fotográfico? Acha que suas habilidades melhoraram bastante? Será que estamos mais perto de superar o lendário Pierre Leblanc?",
                                                    "choices": [
                                                        {
                                                            "id": "765070111",
                                                            "text": "Minhas habilidades...? Bem, ainda tenho um longo caminho pela frente.",
                                                            "response": [
                                                                {
                                                                    "id": "765070113",
                                                                    "speaker": "Paimon",
                                                                    "text": "Hehe, você tem razão! Ser feliz é o mais importante de tudo! Além disso, a Paimon acha que as fotos que você tirou não ficam devendo nada para as de um fotógrafo mestre."
                                                                },
                                                                {
                                                                    "id": "765070114",
                                                                    "speaker": "Paimon",
                                                                    "text": "Porque cada uma delas guarda histórias que vivemos juntos. Para a Paimon, isso é algo insubstituível."
                                                                },
                                                                {
                                                                    "id": "765070115",
                                                                    "speaker": "Paimon",
                                                                    "text": "No futuro, quando a gente... Uhm, quando formos para outros lugares em novas aventuras e lembrarmos de todas essas memórias lindas... A Paimon acha que isso vai ser super legal."
                                                                },
                                                                {
                                                                    "id": "765070116",
                                                                    "speaker": "Player",
                                                                    "text": "Vamos tirar mais fotos juntos no futuro."
                                                                },
                                                                {
                                                                    "id": "765070117",
                                                                    "speaker": "Paimon",
                                                                    "text": "É! Combinado, então! Nosso próximo álbum vai ser maior, melhor e cheio de memórias ainda mais especiais!"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "765070112",
                                                            "text": "O importante é curtir o processo."
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "765070107",
                                            "text": "Foi tudo graças ao seu fundo de emergência, Paimon."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "765070103",
                            "text": "Cada foto guarda uma lembrança."
                        }
                    ]
                }
            ]
        }
    ]
