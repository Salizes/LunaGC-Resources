            "dialogues": [
                {
                    "id": "771423101",
                    "speaker": "NPC#22629",
                    "text": "#Ei, loirinh{M#o}{F#a}! Nada de passar desse ponto! É uma área restrita, ouviu?"
                },
                {
                    "id": "771423102",
                    "speaker": "Player",
                    "text": "Ah, desculpa. Acho que me perdi."
                },
                {
                    "id": "771423103",
                    "speaker": "NPC#22629",
                    "text": "Se perdeu? E eu com isso!? Esse é o território dos Izmaylov."
                },
                {
                    "id": "771423104",
                    "speaker": "NPC#22630",
                    "text": "Tsc. Cai fora! Dá o fora daqui!"
                }
            ]
        },
