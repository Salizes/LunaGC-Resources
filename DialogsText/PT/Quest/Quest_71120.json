    "talks": [
        {
            "id": "7112001",
            "objective": "",
            "dialogues": [
                {
                    "id": "711200101",
                    "speaker": "Tigre Sentado",
                    "text": "Ei, sai pra lá! Isso aqui é território do chefe!"
                },
                {
                    "id": "711200102",
                    "speaker": "Paimon",
                    "text": "Nossa, quanta raiva!",
                    "choices": [
                        {
                            "id": "711200103",
                            "text": "Quem são vocês?",
                            "response": [
                                {
                                    "id": "711200104",
                                    "speaker": "Serpente Enrolada",
                                    "text": "Depende de como vocês tratarem a gente. Se vocês forem gente boa, poderemos ser amigos. Mas se vocês forem ficar xeretando, teremos que tomar alguma atitude."
                                },
                                {
                                    "id": "711200105",
                                    "speaker": "Tigre Sentado",
                                    "text": "Você devia aprender a olhar melhor, e voltar pelo caminho que veio!"
                                },
                                {
                                    "id": "711200109",
                                    "speaker": "Paimon",
                                    "text": "Vocês são muito suspeitos!"
                                },
                                {
                                    "id": "711200110",
                                    "speaker": "Serpente Enrolada",
                                    "text": "Suspeitos? Calma lá... Nós somos apenas os vigias desse lugar. Se alguém tá agindo de forma suspeita são vocês, com toda essa curiosidade!"
                                },
                                {
                                    "id": "711200111",
                                    "speaker": "Tigre Sentado",
                                    "text": "Mas tanto faz, não temos nada a dizer para vocês! Só nos deixem em paz!"
                                }
                            ]
                        },
                        {
                            "id": "711200106",
                            "text": "Quem é esse chefe que você tá falando?",
                            "response": [
                                {
                                    "id": "711200107",
                                    "speaker": "Tigre Sentado",
                                    "text": "Quem é o chefe? Há! Se eu dissesse, você ia se ajoelhar de medo!"
                                },
                                {
                                    "id": "711200108",
                                    "speaker": "Serpente Enrolada",
                                    "text": "É para o seu próprio bem, colega! Para de meter o nariz onde ninguém te chamou."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7112051",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "711205199",
                    "speaker": "Black Screen",
                    "text": "Você insere o Núcleo de carregamento dentro do local enferrujado do Guarda das Ruínas. A máquina antiga e dura começa lentamente a se mover."
                }
            ]
        },
        {
            "id": "7112091",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "711209101",
                    "speaker": "Tigre Sentado",
                    "text": "Vocês de novo?!"
                },
                {
                    "id": "711209102",
                    "speaker": "Serpente Enrolada",
                    "text": "#Parem de ficar metendo o nariz onde não foram chamad{F#as}{M#os}. Só finjam que não viram a gente, e a gente vai fingir que não vimos vocês.",
                    "choices": [
                        {
                            "id": "711209103",
                            "text": "O que vocês tão protegendo?",
                            "response": [
                                {
                                    "id": "711209104",
                                    "speaker": "Serpente Enrolada",
                                    "text": "Advinha o que estamos sendo pagos para fazer, colega."
                                },
                                {
                                    "id": "711209105",
                                    "speaker": "Paimon",
                                    "text": "Quê!? Por quê?"
                                },
                                {
                                    "id": "711209106",
                                    "speaker": "Serpente Enrolada",
                                    "text": "*Cof, cof*"
                                },
                                {
                                    "id": "711209107",
                                    "speaker": "Serpente Enrolada",
                                    "text": "#(Só vou contar para vocês {M#dois}{F#duas}, não é pra contar para ninguém... Venham cá, preciso falar baixo...)"
                                },
                                {
                                    "id": "711209108",
                                    "speaker": "Paimon",
                                    "text": "(Claro, Paimon quer saber!)"
                                },
                                {
                                    "id": "711209109",
                                    "speaker": "Serpente Enrolada",
                                    "text": "É para se livrar de pessoas como vocês!"
                                },
                                {
                                    "id": "711209110",
                                    "speaker": "Paimon",
                                    "text": "Aaaaah!"
                                }
                            ]
                        },
                        {
                            "id": "711209111",
                            "text": "Acabei de ouvir um barulho estranho vindo de dentro da caverna...",
                            "response": [
                                {
                                    "id": "711209112",
                                    "speaker": "Tigre Sentado",
                                    "text": "Eu peidei!"
                                },
                                {
                                    "id": "711209113",
                                    "speaker": "Serpente Enrolada",
                                    "text": "Ah... é. Ele peidou."
                                },
                                {
                                    "id": "711209114",
                                    "speaker": "Paimon",
                                    "text": "E-Então tá tudo nos conformes..."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7112092",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "711209201",
                    "speaker": "Tigre Sentado",
                    "text": "Eu já te avisei!"
                },
                {
                    "id": "711209202",
                    "speaker": "Serpente Enrolada",
                    "text": "Não subestime minha gratidão!"
                }
            ]
        }
    ]
