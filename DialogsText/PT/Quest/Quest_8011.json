        {
            "id": "801113",
            "objective": "Entre no interior",
            "dialogues": []
        },
        {
            "id": "801101",
            "objective": "Siga o Hilichurl",
            "dialogues": [
                {
                    "id": "80110101",
                    "speaker": "Eide",
                    "text": "Isso... isso não é Caribert.",
                    "choices": [
                        {
                            "id": "80110102",
                            "text": "Não é não...",
                            "response": [
                                {
                                    "id": "80110104",
                                    "speaker": "Eide",
                                    "text": "Certo. O lenço de Caribert foi um presente que eu dei para a mãe dele. Eu o uso agora como um tipo de marcador."
                                },
                                {
                                    "id": "80110105",
                                    "speaker": "Eide",
                                    "text": "Meus olhos devem estar... como eu não reconheci meu próprio filho? Ugh, este meu corpo decrépito... *Suspiro*",
                                    "choices": [
                                        {
                                            "id": "80110106",
                                            "text": "Mesmo assim, esse Hilichurl...",
                                            "response": [
                                                {
                                                    "id": "80110108",
                                                    "speaker": "Eide",
                                                    "text": "Sim... Não parece interessado em nós, pelo menos. Parece decidido a andar naquela direção... aonde poderia estar indo?",
                                                    "choices": [
                                                        {
                                                            "id": "80110109",
                                                            "text": "Não tenho certeza.",
                                                            "response": [
                                                                {
                                                                    "id": "80110111",
                                                                    "speaker": "Eide",
                                                                    "text": "Sim... Quanto mais soubermos sobre os Hilichurls, melhor."
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "80110110",
                                                            "text": "Vamos conferir."
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "80110107",
                                            "text": "Tem algo estranho com ele..."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "80110103",
                            "text": "Não tem lenço de seda ao redor do braço dele."
                        }
                    ]
                }
            ]
        },
        {
            "id": "801102",
            "objective": "Siga o Hilichurl",
            "dialogues": [
                {
                    "id": "80110201",
                    "speaker": "Eide",
                    "text": "Que lugar medonho... Ele sempre existiu? Eu juro que nunca havia notado antes...",
                    "choices": [
                        {
                            "id": "80110202",
                            "text": "Olhe...",
                            "response": [
                                {
                                    "id": "80110204",
                                    "speaker": "Eide",
                                    "text": "Hã? Parece que eles estão... louvando. Às vezes andando, às vezes se ajoelhando em louvor... E parece ser de coração."
                                },
                                {
                                    "id": "80110205",
                                    "speaker": "Eide",
                                    "text": "Eu nunca vi algo assim na minha vida. O que raios esse lugar esconde?"
                                },
                                {
                                    "id": "80110206",
                                    "speaker": "Eide",
                                    "text": "Só há um jeito de descobrir."
                                },
                                {
                                    "id": "80110207",
                                    "speaker": "Player",
                                    "text": "(O ar aqui e esta cena arrepiante... é estranhamente familiar...)"
                                }
                            ]
                        },
                        {
                            "id": "80110203",
                            "text": "O que aqueles Hilichurls estão fazendo?"
                        }
                    ]
                }
            ]
        },
        {
            "id": "801114",
            "objective": "Siga o Hilichurl que está entrando na caverna",
            "dialogues": []
        },
        {
            "id": "801103",
            "objective": "Siga o Hilichurl que está entrando na caverna",
            "dialogues": [
                {
                    "id": "80110301",
                    "speaker": "???",
                    "text": "Parem, humanos. O destino não lhes concedeu o direito de entrar neste lugar..."
                },
                {
                    "id": "80110302",
                    "speaker": "Player",
                    "text": "(Um Apóstolo do Abismo? Não, nunca vi alguém da Ordem do Abismo assim...)"
                },
                {
                    "id": "80110303",
                    "speaker": "???",
                    "text": "Hmm, vocês insistem em uma audiência?"
                },
                {
                    "id": "80110304",
                    "speaker": "???",
                    "text": "... Muito bem, eu concederei-lhe um Julgamento do Destino."
                }
            ]
        },
        {
            "id": "801104",
            "objective": "Fale com Eide",
            "dialogues": []
        },
        {
            "id": "801105",
            "objective": "Continue explorando",
            "dialogues": [
                {
                    "id": "80110501",
                    "speaker": "Eide",
                    "text": "Eu acho... que chegamos no final?"
                },
                {
                    "id": "80110502",
                    "speaker": "Player",
                    "text": "O que é aquilo?!"
                },
                {
                    "id": "80110503",
                    "speaker": "Player",
                    "text": "(Envolta por correntes, pendurada no ar, emanando uma aura sinistra... Não há como errar. É exatamente como a Estátua Profanada!)"
                },
                {
                    "id": "80110504",
                    "speaker": "Player",
                    "text": "(Então tem algo a ver com a Ordem do Abismo. Esses Hilichurls em louvor me lembram um muito o Grande Ladrão...)"
                },
                {
                    "id": "80110505",
                    "speaker": "Player",
                    "text": "Eide, esse lugar me dá calafrios, temos que ir!"
                },
                {
                    "id": "80110506",
                    "speaker": "Eide",
                    "text": "..."
                },
                {
                    "id": "80110507",
                    "speaker": "Player",
                    "text": "Eide?"
                },
                {
                    "id": "80110508",
                    "speaker": "Voz Dentro da Cabeça",
                    "text": "...Ó, cara criatura, por que você se curva? Por medo do desconhecido? Ou por um poder que você cobiça?"
                },
                {
                    "id": "80110509",
                    "speaker": "Player",
                    "text": "(De quem é essa voz? Deve estar vindo de dentro da minha cabeça... Eide não consegue ouvir?)"
                },
                {
                    "id": "80110510",
                    "speaker": "Voz Dentro da Cabeça",
                    "text": "...Ó, cara criatura, por que você se curva? Eu não sou nenhum deus... Sou apenas um \"Pecador\"."
                },
                {
                    "id": "80110511",
                    "speaker": "Player",
                    "text": "(Um \"Pecador\"...?)"
                },
                {
                    "id": "80110512",
                    "speaker": "Voz Dentro da Cabeça",
                    "text": "Você é como uma flor nascida em pecado, porém pura, sem manchas... Eu conheço seu destino muito bem."
                },
                {
                    "id": "80110513",
                    "speaker": "Voz Dentro da Cabeça",
                    "text": "Você não precisa mais segurar seu ressentimento, nem aceitar as incontáveis mentiras."
                },
                {
                    "id": "80110514",
                    "speaker": "Voz Dentro da Cabeça",
                    "text": "Siga em frente, se transforme em um transcendente, erga-se além do destino concedido sobre ti..."
                },
                {
                    "id": "80110515",
                    "speaker": "Voz Dentro da Cabeça",
                    "text": "E eu derramarei uma lágrima no fim dos tempos... Enquanto vislumbro sua vida."
                },
                {
                    "id": "80110516",
                    "speaker": "Player",
                    "text": "(... Quem raios é você? O que você está querendo dizer?)"
                },
                {
                    "id": "80110517",
                    "speaker": "Voz Dentro da Cabeça",
                    "text": "..."
                },
                {
                    "id": "80110518",
                    "speaker": "Player",
                    "text": "(A voz... Ela desapareceu...)"
                },
                {
                    "id": "80110519",
                    "speaker": "Player",
                    "text": "!!"
                },
                {
                    "id": "80110520",
                    "speaker": "Player",
                    "text": "... Eide?"
                },
                {
                    "id": "80110521",
                    "speaker": "Eide",
                    "text": "*Ofegante*... O que acabou de acontecer?"
                },
                {
                    "id": "80110522",
                    "speaker": "Eide",
                    "text": "Quando eu vi aquilo, meu coração imediatamente se acalmou, e fui tomado por uma sensação de deslumbramento... Ou talvez de alegria."
                },
                {
                    "id": "80110523",
                    "speaker": "Player",
                    "text": "Você está bem agora?"
                },
                {
                    "id": "80110524",
                    "speaker": "Eide",
                    "text": "Sim... Eu me sinto bem. Na verdade, me sinto melhor do que antes de vir aqui, que estranho..."
                },
                {
                    "id": "80110525",
                    "speaker": "Player",
                    "text": "Há algo de errado com esse lugar. Precisamos sair daqui."
                },
                {
                    "id": "80110526",
                    "speaker": "Eide",
                    "text": "Oh, você acha? Tudo bem, como você preferir."
                }
            ]
        },
