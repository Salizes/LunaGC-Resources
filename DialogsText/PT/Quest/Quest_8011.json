        {
            "id": "801108",
            "objective": "Fale com Eide",
            "dialogues": [
                {
                    "id": "80110401",
                    "speaker": "Eide",
                    "text": "Quem era ele? Ele era... Ele era...",
                    "choices": [
                        {
                            "id": "80110402",
                            "text": "Assustador?",
                            "response": [
                                {
                                    "id": "80110404",
                                    "speaker": "Eide",
                                    "text": "... Ele era um ser perfeito. Estou chocado."
                                },
                                {
                                    "id": "80110405",
                                    "speaker": "Player",
                                    "text": "Hã?"
                                },
                                {
                                    "id": "80110406",
                                    "speaker": "Eide",
                                    "text": "Ele tinha uma aura fantástica, um poder perigoso, mas lindo... Que mesmerizante..."
                                },
                                {
                                    "id": "80110407",
                                    "speaker": "Eide",
                                    "text": "E você foi capaz de derrotá-lo. Sua força é maior do que eu imaginava.",
                                    "choices": [
                                        {
                                            "id": "80110408",
                                            "text": "Você tem um gosto único.",
                                            "response": [
                                                {
                                                    "id": "80110410",
                                                    "speaker": "Eide",
                                                    "text": "Vamos seguir em frente. Estou cada vez mais curioso... e mais animado."
                                                }
                                            ]
                                        },
                                        {
                                            "id": "80110409",
                                            "text": "Eu só tenho muita experiência de combate."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "80110403",
                            "text": "Eu já vi figuras parecidas antes."
                        }
                    ]
                }
            ]
        },
        {
            "id": "801109",
            "objective": "Continue explorando",
            "dialogues": []
        },
        {
            "id": "801110",
            "objective": "Continue explorando",
            "dialogues": []
        },
        {
            "id": "801112",
            "objective": "",
            "dialogues": [
                {
                    "id": "80110601",
                    "speaker": "Eide",
                    "text": "Caribert! Oh, pelos céus, ele está bem.",
                    "choices": [
                        {
                            "id": "80110602",
                            "text": "Não precisamos ir para a Estátua dos Sete?",
                            "response": [
                                {
                                    "id": "80110604",
                                    "speaker": "Eide",
                                    "text": "Eu... Estou com uma sensação estranha que o que acabou de acontecer era parte do destino."
                                },
                                {
                                    "id": "80110605",
                                    "speaker": "Eide",
                                    "text": "E isso acontecer no momento que eu estava me dirigindo para venerar a Estátua dos Sete... Isso foi o destino me chamando."
                                },
                                {
                                    "id": "80110606",
                                    "speaker": "Eide",
                                    "text": "Você disse que eu me ajoelhei perante aquela coisa... Talvez isso seja tão eficaz quanto, não?",
                                    "choices": [
                                        {
                                            "id": "80110607",
                                            "text": "Isso parece uma ideia ridícula...",
                                            "response": [
                                                {
                                                    "id": "80110609",
                                                    "speaker": "Eide",
                                                    "text": "Eu tenho que tentar. Assim como você disse, eu tenho que tentar todas as alternativas, não importa como."
                                                },
                                                {
                                                    "id": "80110610",
                                                    "speaker": "Black Screen",
                                                    "text": "Outra dose do remédio é dada para o Hilichurl..."
                                                },
                                                {
                                                    "id": "80110611",
                                                    "speaker": "Eide",
                                                    "text": "Caribert...?"
                                                },
                                                {
                                                    "id": "80110612",
                                                    "speaker": "Caribert",
                                                    "text": "..."
                                                },
                                                {
                                                    "id": "80110613",
                                                    "speaker": "Caribert",
                                                    "text": "Pa... Papai...?"
                                                },
                                                {
                                                    "id": "80110614",
                                                    "speaker": "Eide",
                                                    "text": "Ah! Caribert! Pelos céus, funcionou! É um milagre! Caribert, meu querido filho!",
                                                    "choices": [
                                                        {
                                                            "id": "80110615",
                                                            "text": "Que inesperado...",
                                                            "response": [
                                                                {
                                                                    "id": "80110617",
                                                                    "speaker": "Eide",
                                                                    "text": "Você viu?! Funcionou! Caribert pode falar de novo!"
                                                                },
                                                                {
                                                                    "id": "80110618",
                                                                    "speaker": "Caribert",
                                                                    "text": "Onde está mamãe?"
                                                                },
                                                                {
                                                                    "id": "80110619",
                                                                    "speaker": "Eide",
                                                                    "text": "Mamãe, ela... Caribert, olhe para mim, você sabe quem eu sou agora?"
                                                                },
                                                                {
                                                                    "id": "80110620",
                                                                    "speaker": "Caribert",
                                                                    "text": "Claro, você é papai."
                                                                },
                                                                {
                                                                    "id": "80110621",
                                                                    "speaker": "Eide",
                                                                    "text": "Haha... Hahahaha, oh, maravilhosa salvação, sim, então essa é a sensação..."
                                                                },
                                                                {
                                                                    "id": "80110622",
                                                                    "speaker": "Eide",
                                                                    "text": "Como você está se sentindo, Caribert? Está desperto?"
                                                                },
                                                                {
                                                                    "id": "80110623",
                                                                    "speaker": "Caribert",
                                                                    "text": "Sim... Eu me sinto como se tivesse dormido muito. Sonhei que eu estava me escondendo numa sala pequena, e eu nunca tinha coragem nem vontade de sair..."
                                                                },
                                                                {
                                                                    "id": "80110624",
                                                                    "speaker": "Caribert",
                                                                    "text": "Eu..."
                                                                },
                                                                {
                                                                    "id": "80110625",
                                                                    "speaker": "Caribert",
                                                                    "text": "Meu corpo! O que aconteceu comigo?! Esse... Esse sou eu?"
                                                                },
                                                                {
                                                                    "id": "80110626",
                                                                    "speaker": "Caribert",
                                                                    "text": "Papai... O que aconteceu comigo?!"
                                                                },
                                                                {
                                                                    "id": "80110627",
                                                                    "speaker": "Eide",
                                                                    "text": "..."
                                                                },
                                                                {
                                                                    "id": "80110628",
                                                                    "speaker": "Eide",
                                                                    "text": "... Filho, não entre em pânico. É que... enquanto você dormiu, entramos em um conto de fadas."
                                                                },
                                                                {
                                                                    "id": "80110629",
                                                                    "speaker": "Eide",
                                                                    "text": "Não há mais Khaenri'ah nesse mundo, não há mais nossa casa, mas você sabe o que isso quer dizer? Não há mais céu vermelho, nem fim do mundo."
                                                                },
                                                                {
                                                                    "id": "80110630",
                                                                    "speaker": "Eide",
                                                                    "text": "Nesse mundo, você tem que ser um pequeno monstro... Mas você pode ficar junto com papai para sempre."
                                                                },
                                                                {
                                                                    "id": "80110631",
                                                                    "speaker": "Caribert",
                                                                    "text": "Eu... Eu morri?"
                                                                },
                                                                {
                                                                    "id": "80110632",
                                                                    "speaker": "Eide",
                                                                    "text": "Não, é claro que não! Veja, Caribert, você ainda está com o lenço de sua mãe no braço. Isso significa que ela está te observando, protegendo você. Como você poderia estar morto?"
                                                                },
                                                                {
                                                                    "id": "80110633",
                                                                    "speaker": "Caribert",
                                                                    "text": "Mesmo?"
                                                                },
                                                                {
                                                                    "id": "80110634",
                                                                    "speaker": "Eide",
                                                                    "text": "Sim, mesmo! Você acabou de acordar, e isso tudo deve ser muito confuso, só fique aqui descansando por enquanto, tudo vai melhorar."
                                                                },
                                                                {
                                                                    "id": "80110635",
                                                                    "speaker": "Eide",
                                                                    "text": "Oh, e... você tem que me prometer uma coisa..."
                                                                },
                                                                {
                                                                    "id": "80110636",
                                                                    "speaker": "Eide",
                                                                    "text": "Nunca tire sua máscara."
                                                                },
                                                                {
                                                                    "id": "80110637",
                                                                    "speaker": "Eide",
                                                                    "text": "Promete para mim? Não importa o que aconteça, nunca tire ela..."
                                                                },
                                                                {
                                                                    "id": "80110638",
                                                                    "speaker": "Caribert",
                                                                    "text": "Certo, papai, eu não vou tirar, prometo..."
                                                                },
                                                                {
                                                                    "id": "80110639",
                                                                    "speaker": "Black Screen",
                                                                    "text": "O pai e o filho conversam por muito tempo. Eide parece ser uma pessoa diferente depois de sua experiência religiosa..."
                                                                },
                                                                {
                                                                    "id": "80110640",
                                                                    "speaker": "Eide",
                                                                    "text": "Desde aquele dia, nunca estive tão feliz como estou agora... Não consigo acreditar que isso está acontecendo...",
                                                                    "choices": [
                                                                        {
                                                                            "id": "80110641",
                                                                            "text": "Sim...",
                                                                            "response": [
                                                                                {
                                                                                    "id": "80110643",
                                                                                    "speaker": "Eide",
                                                                                    "text": "Hunf, eu sabia que ter fé nos Sete era uma perda de tempo... Eu até mesmo venerei as estátuas deles como um tolo! Nunca me humilhei tanto..."
                                                                                },
                                                                                {
                                                                                    "id": "80110644",
                                                                                    "speaker": "Eide",
                                                                                    "text": "Uma vez assassino, sempre assassino... Foi ingenuidade minha pensar que os deuses que conspiraram contra nós nos salvariam."
                                                                                },
                                                                                {
                                                                                    "id": "80110645",
                                                                                    "speaker": "Eide",
                                                                                    "text": "Mas o deus que vimos naquela caverna... Ele sim era um deus de verdade! Totalmente diferente dos Sete!"
                                                                                },
                                                                                {
                                                                                    "id": "80110646",
                                                                                    "speaker": "Eide",
                                                                                    "text": "Aquele poder fantástico... Era encantador... Essa com certeza deve ter sido a razão para eu ter me ajoelhado, não acha?"
                                                                                },
                                                                                {
                                                                                    "id": "80110647",
                                                                                    "speaker": "Eide",
                                                                                    "text": "Hmm, bem... Quando alguém implora para um deus, e o deus responde suas preces, é necessário fazer algo para mostrar sua devoção...?"
                                                                                },
                                                                                {
                                                                                    "id": "80110648",
                                                                                    "speaker": "Eide",
                                                                                    "text": "Enfim, não sei muito sobre essa coisa de \"implorar\", mas com certeza tenho que honrar o deus que satisfez meus desejos.",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "80110649",
                                                                                            "text": "Mas... Aquilo não era um deus, Eide.",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "80110651",
                                                                                                    "speaker": "Eide",
                                                                                                    "text": "Um pecador? Não diga uma coisa absurda como essa! Você não sabe nada sobre ele! Como se atreve a falar uma blasfêmia como essa?!"
                                                                                                },
                                                                                                {
                                                                                                    "id": "80110652",
                                                                                                    "speaker": "Eide",
                                                                                                    "text": "Nós testemunhamos o poder divino dele! Quando é que os Sete fizeram um milagre como esse? Jamais! Pois ele é um deus mais poderoso do que eles! E você se atreve a chamá-lo de \"pecador\"?! Que audácia!"
                                                                                                },
                                                                                                {
                                                                                                    "id": "80110653",
                                                                                                    "speaker": "Eide",
                                                                                                    "text": "Enfim, não importa... Acredite no que você quiser, você não abalará minha fé."
                                                                                                },
                                                                                                {
                                                                                                    "id": "80110654",
                                                                                                    "speaker": "Eide",
                                                                                                    "text": "Eu vou prestar meu respeito a ele, com ou sem você.",
                                                                                                    "choices": [
                                                                                                        {
                                                                                                            "id": "80110655",
                                                                                                            "text": "Argh, esse cara...",
                                                                                                            "response": [
                                                                                                                {
                                                                                                                    "id": "80110657",
                                                                                                                    "speaker": "Player",
                                                                                                                    "text": "(A experiência de Eide o afetou consideravelmente... Ele nunca foi muito estável, mas esse fervor religioso é exagerado...)"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "80110658",
                                                                                                                    "speaker": "Player",
                                                                                                                    "text": "(Acho que não há alternativa a não ser segui-lo. Há monstros por todo lado e não posso ficar de braços cruzados deixando eles o atacarem...)"
                                                                                                                }
                                                                                                            ]
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "80110656",
                                                                                                            "text": "Como você quiser."
