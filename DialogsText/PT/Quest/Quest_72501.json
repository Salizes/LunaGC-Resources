    "talks": [
        {
            "id": "7250101",
            "objective": "Fale com Asagiri",
            "dialogues": []
        },
        {
            "id": "7250102",
            "objective": "Fale com Asagiri",
            "dialogues": [
                {
                    "id": "725010201",
                    "speaker": "Asagiri",
                    "text": "Por que a Srta. Moriko sempre me dá comissões tão estranhas?",
                    "choices": [
                        {
                            "id": "725010202",
                            "text": "Você ainda está desenhando?",
                            "response": [
                                {
                                    "id": "725010204",
                                    "speaker": "Asagiri",
                                    "text": "Ah, Viajante! O que traz você aqui? Já faz algum tempo, imaginei que você teria viajado para outros lugares."
                                },
                                {
                                    "id": "725010205",
                                    "speaker": "Asagiri",
                                    "text": "*Suspiro* Eu gostaria tanto de estar em condições melhores. Eu queria poder viajar livremente como você."
                                },
                                {
                                    "id": "725010206",
                                    "speaker": "Asagiri",
                                    "text": "Assim, não precisaria aguentar a Srta. Moriko me cobrando coisas do trabalho todos os dias..."
                                },
                                {
                                    "id": "725010207",
                                    "speaker": "Asagiri",
                                    "text": "As minhas ilustrações foram muito bem recebidas da última vez. Muitos escritores estão requisitando os meus trabalhos desde então."
                                },
                                {
                                    "id": "725010230",
                                    "speaker": "Asagiri",
                                    "text": "Apesar de a Srta. Moriko ter rejeitado muitos trabalhos meus, ainda há muitas comissões sobrando..."
                                },
                                {
                                    "id": "725010209",
                                    "speaker": "Asagiri",
                                    "text": "Eu pensava que além de Inazuma, Mondstadt e Liyue eram os cenários mais distantes que eles iriam em suas histórias..."
                                },
                                {
                                    "id": "725010210",
                                    "speaker": "Asagiri",
                                    "text": "Eles agora escrevem sobre protagonistas que se aventuram em Sumeru, e até em Fontaine."
                                },
                                {
                                    "id": "725010216",
                                    "speaker": "Asagiri",
                                    "text": "Bom, chega de reclamar. Viajante, seu Aparelho Fotográfico ainda está funcionando?",
                                    "choices": [
                                        {
                                            "id": "725010217",
                                            "text": "Está funcionando bem, sim...",
                                            "response": [
                                                {
                                                    "id": "725010219",
                                                    "speaker": "Asagiri",
                                                    "text": "Bem, o pagamento da última vez foi bem justo, não foi?"
                                                },
                                                {
                                                    "id": "725010220",
                                                    "speaker": "Asagiri",
                                                    "text": "Então, Viajante, por favor, tire mais fotos ao redor do mundo para mim!",
                                                    "choices": [
                                                        {
                                                            "id": "725010221",
                                                            "text": "*Suspiro* Está bem, deixa comigo...",
                                                            "response": [
                                                                {
                                                                    "id": "725010222",
                                                                    "speaker": "Asagiri",
                                                                    "text": "Conto com você, então! Hehe, meu caderno já está pronto!"
                                                                },
                                                                {
                                                                    "id": "725010223",
                                                                    "speaker": "Asagiri",
                                                                    "text": "Se você não tivesse aparecido, eu teria pedido que a Srta. Moriko procurasse por você."
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "725010224",
                                                            "text": "Você sabe que basta publicar uma Comissão na Guilda de Aventureiros, não sabe?",
                                                            "response": [
                                                                {
                                                                    "id": "725010225",
                                                                    "speaker": "Asagiri",
                                                                    "text": "Ah! De jeito nenhum! Por favor, por favor, me ajude! Eu publiquei Comissões, mas não consegui achar ninguém capaz de usar o Aparelho Fotográfico."
                                                                },
                                                                {
                                                                    "id": "725010226",
                                                                    "speaker": "Asagiri",
                                                                    "text": "Só me ajuda dessa vez, pode ser? Se eu perder outro prazo, a Srta. Moriko com certeza vai bater na minha porta e ameaçar vir morar comigo!"
                                                                },
                                                                {
                                                                    "id": "725010227",
                                                                    "speaker": "Asagiri",
                                                                    "text": "Meu estômago já está me avisando que não quer mingau de Arroz com Flor de Sakura que ela vai fazer! Viajante, minha vida está nas suas mãos!"
                                                                },
                                                                {
                                                                    "id": "725010228",
                                                                    "speaker": "Player",
                                                                    "text": "Tudo bem, pode deixar comigo..."
                                                                },
                                                                {
                                                                    "id": "725010229",
                                                                    "speaker": "Asagiri",
                                                                    "text": "Ufa... Que alívio. Espere um pouco, deixe eu procurar meu caderno..."
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "725010218",
                                            "text": "Você quer que eu tire mais fotos?"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "725010203",
                            "text": "Você está sem inspiração de novo?"
                        }
                    ]
                }
            ]
        }
    ]
}