    "talks": [
        {
            "id": "7220401",
            "objective": "",
            "dialogues": [
                {
                    "id": "722040101",
                    "speaker": "Una",
                    "text": "Kito, Kina... O que vocês estão fazendo aqui?"
                },
                {
                    "id": "722040102",
                    "speaker": "Una",
                    "text": "Sério... minhas pernas não conseguem acompanhar vocês... O que vai acontecer comigo se estivermos em perigo?",
                    "choices": [
                        {
                            "id": "722040103",
                            "text": "Está... tudo bem...?",
                            "response": [
                                {
                                    "id": "722040105",
                                    "speaker": "Una",
                                    "text": "Oh! Realmente... Vocês são muito jovens, se ficarem dizendo coisas assim, vão acabar machucando o coração dessa pobre velhinha..."
                                },
                                {
                                    "id": "722040106",
                                    "speaker": "Una",
                                    "text": "Já que vocês vieram até aqui, por que não ficam e fazem companhia à vovó?",
                                    "choices": [
                                        {
                                            "id": "722040107",
                                            "text": "Me desculpe, eu...",
                                            "response": [
                                                {
                                                    "id": "722040109",
                                                    "speaker": "Una",
                                                    "text": "Até onde contei aquela história da última vez...? Ah, certo... É uma história do tempo do avô do seu avô quando ainda era criança..."
                                                },
                                                {
                                                    "id": "722040110",
                                                    "speaker": "Una",
                                                    "text": "Além do Mar de Névoa, em uma ilha cheia de forasteiros, vivia o Clã Sumari. Dizem que a matriarca deste clã era uma mulher com a aparência de uma raposa..."
                                                },
                                                {
                                                    "id": "722040111",
                                                    "speaker": "Una",
                                                    "text": "Dizem que flores com cor do trovão floresciam nesta terra, e o povo Sumari construiu casas e viveu em harmonia por lá, entre as montanhas e as planícies..."
                                                },
                                                {
                                                    "id": "722040112",
                                                    "speaker": "Una",
                                                    "text": "E então ... *Zzz*... Essas flores... *Zzz*..."
                                                },
                                                {
                                                    "id": "722040113",
                                                    "speaker": "Una",
                                                    "text": "*Ahem*... Para lá da névoa... *Zzz*...",
                                                    "choices": [
                                                        {
                                                            "id": "722040114",
                                                            "text": "Você está bem, vovó?",
                                                            "response": [
                                                                {
                                                                    "id": "722040116",
                                                                    "speaker": "Una",
                                                                    "text": "Hã... Kito? Kina? Vocês já estão indo embora? *Suspiros* ... Sinto muito, a vovó aqui adormeceu sozinha de novo..."
                                                                },
                                                                {
                                                                    "id": "722040117",
                                                                    "speaker": "Una",
                                                                    "text": "Antes de ir, não se esqueçam disso... A vovó sempre guardou para vocês... Esta linda flor vem do outro lado do mar de neblina. Não a percam, hein?"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "722040115",
                                                            "text": "(É melhor não incomodá-la...)"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "722040108",
                                            "text": "Está bem..."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "722040104",
                            "text": "Acho que você está se confundindo..."
                        }
                    ]
                }
            ]
        },
        {
            "id": "7220408",
            "objective": "",
            "dialogues": [
                {
                    "id": "722040801",
                    "speaker": "Una",
                    "text": "Será que Kito e Kina ainda estão nesta ilha...?"
                },
                {
                    "id": "722040802",
                    "speaker": "Una",
                    "text": "As crianças nunca deixam de preocupar os adultos..."
                }
            ]
        },
        {
            "id": "7220402",
            "objective": "",
            "dialogues": [
                {
                    "id": "722040301",
                    "speaker": "Una",
                    "text": "Oh... elas são cada vez menos claras... Minhas memórias são... menos claras...",
                    "choices": [
                        {
                            "id": "722040302",
                            "text": "Olá?",
                            "response": [
                                {
                                    "id": "722040304",
                                    "speaker": "Una",
                                    "text": "*Suspiro*... Minha memória vai de mal a pior. Já estou velha, me lembro cada vez de menos coisas..."
                                },
                                {
                                    "id": "722040305",
                                    "speaker": "Una",
                                    "text": "Algo não está bem... Me pergunto se Kito e Kina estão com fome... Não é seguro brincar lá fora...",
                                    "choices": [
                                        {
                                            "id": "722040306",
                                            "text": "Eles estão bem.",
                                            "response": [
                                                {
                                                    "id": "722040308",
                                                    "speaker": "Una",
                                                    "text": "Kito, Kina! Quando vocês voltaram? Não levaram nenhuma queda no caminho, não é? Não subiram nas árvores de novo, subiram?"
                                                },
                                                {
                                                    "id": "722040309",
                                                    "speaker": "Una",
                                                    "text": "Estão sempre a fazer esta pobre senhora se preocupar... Oh, o que há de errado com esta ilha ultimamente? Há cada vez menos pessoas..."
                                                },
                                                {
                                                    "id": "722040310",
                                                    "speaker": "Una",
                                                    "text": "Os nomes de que me lembro... são cada vez menos..."
                                                },
                                                {
                                                    "id": "722040311",
                                                    "speaker": "Una",
                                                    "text": "*Suspiro*... O que sua pobre vovó fará quando esquecer seus nomes...?"
                                                },
                                                {
                                                    "id": "722040312",
                                                    "speaker": "Player",
                                                    "text": "..."
                                                },
                                                {
                                                    "id": "722040313",
                                                    "speaker": "Una",
                                                    "text": "*Suspiro*... Pegue essas pétalas. Se eu me esquecer de vocês, é só me mostrarem elas..."
                                                },
                                                {
                                                    "id": "722040314",
                                                    "speaker": "Una",
                                                    "text": "Ainda tenho tantas histórias para lhes contar..."
                                                }
                                            ]
                                        },
                                        {
                                            "id": "722040307",
                                            "text": "Posso ajudar?"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "722040303",
                            "text": "Aconteceu alguma coisa?"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7220409",
            "objective": "",
            "dialogues": [
                {
                    "id": "722040901",
                    "speaker": "Una",
                    "text": "Ah, você veio... Ai, Kito e Kina, essas crianças..."
                },
                {
                    "id": "722040902",
                    "speaker": "Una",
                    "text": "Não sei para onde foram. *Suspiro*, desculpe..."
                },
                {
                    "id": "722040903",
                    "speaker": "Una",
                    "text": "É verdade... Como você se chama mesmo?",
                    "choices": [
                        {
                            "id": "722040904",
                            "text": "#{NICKNAME}, prazer em te conhecer.",
                            "response": [
                                {
                                    "id": "722040906",
                                    "speaker": "Una",
                                    "text": "Oh... eu... eu estava indo embora, certo?"
                                },
                                {
                                    "id": "722040907",
                                    "speaker": "Player",
                                    "text": "Indo embora?"
                                },
                                {
                                    "id": "722040908",
                                    "speaker": "Una",
                                    "text": "Aquele homem do barco costuma vir me ver para tentar me convencer a ir com ele."
                                },
                                {
                                    "id": "722040909",
                                    "speaker": "Una",
                                    "text": "Ele sempre vem em silêncio, vestindo um casaco de pele dourado, calças douradas e uma coroa de ouro..."
                                },
                                {
                                    "id": "722040910",
                                    "speaker": "Una",
                                    "text": "É como minha mãe, Kito e Kina me disseram... Ele vem para nos levar naquele barco brilhante..."
                                },
                                {
                                    "id": "722040911",
                                    "speaker": "Una",
                                    "text": "Ele nos conduz por um rio cintilante para a terra dos sonhos. Lá não há neblina, e haverá um grande salão dourado, com setenta berços, e depois mais setenta... E eles balançarão para frente e para trás..."
                                },
                                {
                                    "id": "722040912",
                                    "speaker": "Una",
                                    "text": "Neles dormimos pacificamente até nos tornarmos partículas de luz. E então... nos transformamos em um sonho das crianças que vivem na terra...",
                                    "choices": [
                                        {
                                            "id": "722040913",
                                            "text": "Uau...",
                                            "response": [
                                                {
                                                    "id": "722040915",
                                                    "speaker": "Una",
                                                    "text": "Esse homem do barco disse que vinha no lugar de Kito e Kina para me dar isso. Hehe, estas crianças..."
                                                },
                                                {
                                                    "id": "722040916",
                                                    "speaker": "Una",
                                                    "text": "Ainda não está na hora... ainda não..."
                                                }
                                            ]
                                        },
                                        {
                                            "id": "722040914",
                                            "text": "Quer dizer que..."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "722040905",
                            "text": "#Sou {M#o}{F#a} {NICKNAME}, claro."
                        }
                    ]
                }
            ]
        },
        {
            "id": "7220403",
            "objective": "",
            "dialogues": [
                {
                    "id": "722040501",
                    "speaker": "Una",
                    "text": "Ah, Abe. Como está sua colheita de cogumelos? Haha... Você não deveria ir mais incomodar o sacerdote. Não importa quantas vezes ele tente me convencer, eu não concordarei!"
                },
                {
                    "id": "722040502",
                    "speaker": "Una",
                    "text": "Hehe, desculpe! Mas eu tenho que cuidar dessa casa sozinha, não consigo fazer tudo, hehe. Sinto muito..."
                },
                {
                    "id": "722040503",
                    "speaker": "Una",
                    "text": "Me desculpe... *Suspiro*... Me desculpe...",
                    "choices": [
                        {
                            "id": "722040504",
                            "text": "Oi, vovó.",
                            "response": [
                                {
                                    "id": "722040506",
                                    "speaker": "Una",
                                    "text": "Ah...! É você! Entre logo antes que você nos envergonhe!",
                                    "choices": [
                                        {
                                            "id": "722040507",
                                            "text": "Eh...?",
                                            "response": [
                                                {
                                                    "id": "722040509",
                                                    "speaker": "Una",
                                                    "text": "Como correu a pesca? Você não pegou nada? Bom, não importa. O que o jardim de casa nos dá é mais que suficiente... Mas não é suficiente para a oferenda da grande Pássaro do Trovão... Hmm... O que há de errado?"
                                                },
                                                {
                                                    "id": "722040510",
                                                    "speaker": "Una",
                                                    "text": "Mas que bobagem! A cerimônia deste ano está correndo muito bem, e a do ano que vem com certeza será ótima... O sacerdote também disse que nós teremos uma criança forte e saudável..."
                                                },
                                                {
                                                    "id": "722040511",
                                                    "speaker": "Una",
                                                    "text": "Por que você está me dizendo essas coisas de repente? Você esqueceu o que aconteceu com o Clã Kama?",
                                                    "choices": [
                                                        {
                                                            "id": "722040512",
                                                            "text": "Calma!",
                                                            "response": [
                                                                {
                                                                    "id": "722040514",
                                                                    "speaker": "Una",
                                                                    "text": "Faça o que você quiser! Se você também planeja abandonar a grande Pássaro do Trovão e ser devorado pelas ondas furiosas do mar, vá em frente!"
                                                                },
                                                                {
                                                                    "id": "722040515",
                                                                    "speaker": "Una",
                                                                    "text": "Meu menino... Meu pobre menino... *Suspiro*..."
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "722040513",
                                                            "text": "Os Kama?"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "722040508",
                                            "text": "Humm..."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "722040505",
                            "text": "Você está bem?"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7220410",
            "objective": "",
            "dialogues": [
                {
                    "id": "722041001",
                    "speaker": "Una",
                    "text": "*Suspiro*... Essas crianças..."
                },
                {
                    "id": "722041002",
                    "speaker": "Player",
                    "text": "Venho em nome de Kito e Kina para entregar isso a você."
                }
            ]
        },
        {
            "id": "7220404",
            "objective": "",
            "dialogues": [
                {
                    "id": "722040701",
                    "speaker": "Una",
                    "text": "Oi, oi..."
                },
                {
                    "id": "722040702",
                    "speaker": "Una",
                    "text": "*Suspiro*... Desculpe, a cabeça desta senhora já não pensa com clareza... Quem é você? Nos conhecemos?",
                    "choices": [
                        {
                            "id": "722040703",
                            "text": "#Sou {M#o}{F#a} {NICKNAME}.",
                            "response": [
                                {
                                    "id": "722040705",
                                    "speaker": "Una",
                                    "text": "Nunca ouvi falar nesse nome antes. Você veio do lado de fora?"
                                },
                                {
                                    "id": "722040706",
                                    "speaker": "Una",
                                    "text": "Que estranho... É muito estranho... ninguém consegue andar à vontade pela ilha sem o consentimento da grande Pássaro do Trovão...",
                                    "choices": [
                                        {
                                            "id": "722040707",
                                            "text": "Faz tempo que a Pássaro do Trovão se foi...",
                                            "response": [
                                                {
                                                    "id": "722040709",
                                                    "speaker": "Una",
                                                    "text": "Ver você me faz lembrar do meu marido... Mas agora eu já nem lembro da aparência dele..."
                                                },
                                                {
                                                    "id": "722040710",
                                                    "speaker": "Una",
                                                    "text": "Ainda éramos jovens e cheios de ilusões ingênuas nesse tempo... Mas algumas pessoas simplesmente não crescem, não importa quanto tempo se passe com elas..."
                                                },
                                                {
                                                    "id": "722040711",
                                                    "speaker": "Una",
                                                    "text": "E então ele me deixou. Ele fez uma jangada com a intenção de atravessar o mar e ir para aquela ilha desconhecida... Disse que queria caçar livremente lá, e colher aquelas flores lindas que nunca tinha visto antes..."
                                                },
                                                {
                                                    "id": "722040712",
                                                    "speaker": "Una",
                                                    "text": "Desde pequeno sempre foi assim... Mas nunca cresceu."
                                                },
                                                {
                                                    "id": "722040713",
                                                    "speaker": "Una",
                                                    "text": "Eventualmente, o filho do sacerdote o encontrou na praia... Ele ficou lá, tão silencioso como conchas, e mais pálido do que a própria areia... Em suas mãos ele ainda segurava aquelas pétalas..."
                                                },
                                                {
                                                    "id": "722040714",
                                                    "speaker": "Una",
                                                    "text": "O sacerdote chorou e me disse que o barco de seus ancestrais o havia rejeitado, e que a partir de então sua alma vagaria por aquelas terras distantes..."
                                                },
                                                {
                                                    "id": "722040715",
                                                    "speaker": "Una",
                                                    "text": "Naquele momento eu havia acabado de dar à luz nosso filho... Como eu iria lhe explicar?"
                                                },
                                                {
                                                    "id": "722040716",
                                                    "speaker": "Player",
                                                    "text": "..."
                                                },
                                                {
                                                    "id": "722040717",
                                                    "speaker": "Una",
                                                    "text": "Depois disso... o meu filho também teve filhos, e depois disso... ainda tive que me despedir deles e os enviar num barco reluzente... Mas nessa altura a minha vida já estava feita aqui..."
                                                },
                                                {
                                                    "id": "722040718",
                                                    "speaker": "Una",
                                                    "text": "Agora, os únicos que me preocupam são Kito e Kina..."
                                                }
                                            ]
                                        },
                                        {
                                            "id": "722040708",
                                            "text": "É uma longa história..."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "722040704",
                            "text": "#Olá, pode me chamar de {NICKNAME}."
                        }
                    ]
                }
            ]
        },
        {
            "id": "7220411",
            "objective": "",
            "dialogues": [
                {
                    "id": "722041101",
                    "speaker": "Una",
                    "text": "Desculpe, mas ainda não posso entrar no barco..."
                },
                {
                    "id": "722041102",
                    "speaker": "Una",
                    "text": "As pessoas de quem gosto ainda não se foram..."
                }
            ]
        },
        {
            "id": "7220406",
            "objective": "",
            "dialogues": [
                {
                    "id": "722040601",
                    "speaker": "Una",
                    "text": "Entendo... Você diz que ele está carregando... isso com ele?"
                },
                {
                    "id": "722040602",
                    "speaker": "Una",
                    "text": "O que você tem em mente...? O que pretende fazer com isso?"
                }
            ]
        },
        {
            "id": "7220412",
            "objective": "",
            "dialogues": [
                {
                    "id": "722041201",
                    "speaker": "Una",
                    "text": "Este cheiro... Essa caixa é de Kito, não é?"
                },
                {
                    "id": "722041202",
                    "speaker": "Una",
                    "text": "Então, isso significa que eles estão cansados de ficar brincando por aí e querem partir, certo?"
                },
                {
                    "id": "722041203",
                    "speaker": "Player",
                    "text": "Eu não entendo muito bem, mas parece que sim..."
                },
                {
                    "id": "722041204",
                    "speaker": "Una",
                    "text": "#Muito obrigada, forasteir{F#a}{M#o}... Adeus."
                },
                {
                    "id": "722041205",
                    "speaker": "Una",
                    "text": "Querido barqueiro, por favor... Leve-me lá, nos ciprestes de prata, ao rio dos sonhos..."
                }
            ]
        },
        {
            "id": "7220402",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "722040201",
                    "speaker": "Una",
                    "text": "Bom, já chega. Deixem... a vovó... dormir um pouco... *Zzz*..."
                },
                {
                    "id": "722040202",
                    "speaker": "Una",
                    "text": "Mas tenham cuidado... Não vão... para demasiado longe... *Zzz*..."
                }
            ]
        },
        {
            "id": "7220404",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "722040401",
                    "speaker": "Una",
                    "text": "Enfim, vão brincar... Eu fico aqui."
                },
                {
                    "id": "722040402",
                    "speaker": "Una",
                    "text": "As pétalas... As pétalas... Como é a sua terra natal?"
                }
            ]
        }
    ]
}