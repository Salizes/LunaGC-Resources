    "talks": [
        {
            "id": "7715301",
            "objective": "",
            "dialogues": [
                {
                    "id": "771530101",
                    "speaker": "Paimon",
                    "text": "Pfft, Paimon achou que ele seria pelo menos metade tão durão quanto parecia. Mas que nada, nem chegou perto."
                },
                {
                    "id": "771530102",
                    "speaker": "Paimon",
                    "text": "Está tudo bem agora. Nós afugentamos aqueles bandidos!"
                },
                {
                    "id": "771530103",
                    "speaker": "NPC#22597",
                    "text": "Haha! Louvado seja! Vou cair fora, até mais!"
                },
                {
                    "id": "771530104",
                    "speaker": "Black Screen",
                    "text": "Após se certificar de que não há nenhum Volkodlak atrás dele, o trabalhador foge do local."
                },
                {
                    "id": "771530105",
                    "speaker": "Paimon",
                    "text": "Ei! Espera...!"
                },
                {
                    "id": "771530106",
                    "speaker": "Player",
                    "text": "Ei, e o nosso agradecimento? Ou, sei lá, uma recompensa?"
                },
                {
                    "id": "771530107",
                    "speaker": "Paimon",
                    "text": "Aff, que sujeito ingrato. Podia pelo menos ter agradecido uma vez..."
                },
                {
                    "id": "771530108",
                    "speaker": "Paimon",
                    "text": "...Espera aí. Não estamos fazendo isso pela gratidão ou pelas recompensas de ninguém! Bem, não só por isso, pelo menos."
                },
                {
                    "id": "771530109",
                    "speaker": "Paimon",
                    "text": "Esquece. A gente ajuda um monte de gente sem esperar nada em troca mesmo. Acho que hoje vamos bancar os \"aventureiros supernobres\" de novo!"
                },
                {
                    "id": "771530110",
                    "speaker": "Paimon",
                    "text": "Falando nisso, você não vai embora?"
                },
                {
                    "id": "771530111",
                    "speaker": "NPC#7705",
                    "text": "Qual seria o sentido? Vou embora hoje, e amanhã eles me arrastam de volta pra cá."
                },
                {
                    "id": "771530112",
                    "speaker": "NPC#7705",
                    "text": "Vocês deviam ir embora. Vocês não são páreo para os Izmaylov."
                },
                {
                    "id": "771530113",
                    "speaker": "Paimon",
                    "text": "Hehe. Talvez isso não seja verdade, sabia? Não subestime a gente!"
                },
                {
                    "id": "771530114",
                    "speaker": "NPC#7705",
                    "text": "*Suspiro* ... Vocês não entendem."
                }
            ]
        },
        {
            "id": "7715304",
            "objective": "",
            "dialogues": [
                {
                    "id": "771530401",
                    "speaker": "Izmaylov Ameaçador",
                    "text": "Toma essa! Tentando dar no pé sem quitar sua dívida, é!?"
                },
                {
                    "id": "771530402",
                    "speaker": "NPC#22597",
                    "text": "Agh! Mais devagar, senhor, por favor! Como vou trabalhar para pagar minha dívida se quebrar meus ossos..."
                },
                {
                    "id": "771530403",
                    "speaker": "Izmaylov Ameaçador",
                    "text": "Seu malandrinho... Anda. Se mexe!"
                },
                {
                    "id": "771530404",
                    "speaker": "NPC#22597",
                    "text": "Tá, tá!"
                },
                {
                    "id": "771530405",
                    "speaker": "Black Screen",
                    "text": "O Volkodlak escolta o trabalhador para longe..."
                },
                {
                    "id": "771530406",
                    "speaker": "Paimon",
                    "text": "Espera, esse é o mesmo que fugiu antes! Então eles pegaram ele mesmo..."
                }
            ]
        },
        {
            "id": "7715302",
            "objective": "",
            "dialogues": [
                {
                    "id": "771530201",
                    "speaker": "NPC#7705",
                    "text": "Não adianta... No fim, é tudo inútil mesmo...",
