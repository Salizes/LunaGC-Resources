    "talks": [
        {
            "id": "7106001",
            "objective": "",
            "dialogues": [
                {
                    "id": "710600101",
                    "speaker": "Carta do Cabo Nikolay",
                    "text": "(Uma carta que Katarina tem muito apego. A carta ainda tem um cheiro leve remanescente de Água de Fogo)."
                }
            ]
        },
        {
            "id": "7105911",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "710591101",
                    "speaker": "Katarina",
                    "text": "O quê foi? Vieram aqui incomodar o meu descanso?"
                },
                {
                    "id": "710591102",
                    "speaker": "Paimon",
                    "text": "Não, nós só vimos que você estava aqui sozinha e queríamos conversar com você!",
                    "choices": [
                        {
                            "id": "710591103",
                            "text": "Deve ser muito chato beber sozinha, não é?",
                            "response": [
                                {
                                    "id": "710591105",
                                    "speaker": "Katarina",
                                    "text": "... Mesmo? Obrigada. Vocês me lembram de Lyudochka."
                                },
                                {
                                    "id": "710591106",
                                    "speaker": "Katarina",
                                    "text": "Ela era uma garota gentil. Antigamente ela sempre conversava de tudo comigo. Mas somente comigo."
                                },
                                {
                                    "id": "710591107",
                                    "speaker": "Katarina",
                                    "text": "*Suspiro* Como gostaria que Lyudochka estivesse aqui... Ela era uma pessoa muito divertida, você com certeza gostaria dela.",
                                    "choices": [
                                        {
                                            "id": "710591108",
                                            "text": "Lyudochka? Quem é essa?",
                                            "response": [
                                                {
                                                    "id": "710591109",
                                                    "speaker": "Katarina",
                                                    "text": "Ela é uma amiga minha. Ela tem uma aparência muito séria, mas na verdade é uma tonta bem divertida."
                                                },
                                                {
                                                    "id": "710591110",
                                                    "speaker": "Katarina",
                                                    "text": "Nós éramos como irmãs quando morávamos na Casa da Lareira... Na verdade, é possível que ela fosse ainda mais do que uma irmã para mim... Ela gostava de me provocar, mas também cuidava de mim."
                                                },
                                                {
                                                    "id": "710591111",
                                                    "speaker": "Katarina",
                                                    "text": "Haha, de qualquer forma, eu tenho a sensação que ela está bem lá fora. Quando penso nisso, todas as feridas que sofri neste lugar infernal não são nada."
                                                },
                                                {
                                                    "id": "710591112",
                                                    "speaker": "Katarina",
                                                    "text": "Espero que ela consiga realizar sua missão... E que não pense em mim."
                                                }
                                            ]
                                        },
                                        {
                                            "id": "710591113",
                                            "text": "Lyudochka? Você está falando daquela que está em Inazuma...?",
                                            "response": [
                                                {
                                                    "id": "710591114",
                                                    "speaker": "Katarina",
                                                    "text": "..."
                                                },
                                                {
                                                    "id": "710591115",
                                                    "speaker": "Katarina",
                                                    "text": "Então ela foi exposta..."
                                                },
                                                {
                                                    "id": "710591116",
                                                    "speaker": "Paimon",
                                                    "text": "Hã? Como você sabe?",
                                                    "choices": [
                                                        {
                                                            "id": "710591117",
                                                            "text": "Ela conseguiu fugir.",
                                                            "response": [
                                                                {
                                                                    "id": "710591119",
                                                                    "speaker": "Katarina",
                                                                    "text": "Mesmo?"
                                                                },
                                                                {
                                                                    "id": "710591120",
                                                                    "speaker": "Katarina",
                                                                    "text": "Haha... Ótimo, espero que ela ainda esteja fazendo sua missão bem."
                                                                },
                                                                {
                                                                    "id": "710591121",
                                                                    "speaker": "Katarina",
                                                                    "text": "Mas se ela traiu a vontade da Tsaritsa para poder viver..."
                                                                },
                                                                {
                                                                    "id": "710591122",
                                                                    "speaker": "Katarina",
                                                                    "text": "... Espero que ela não lembre de mim."
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "710591118",
                                                            "text": "Ela ainda está viva, e está muito bem."
                                                        }
                                                    ]
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "710591104",
                            "text": "Por isso nós viemos aqui conversar."
                        }
                    ]
                }
            ]
        },
