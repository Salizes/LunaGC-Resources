    "talks": [
        {
            "id": "7905101",
            "objective": "",
            "dialogues": [
                {
                    "id": "790510101",
                    "speaker": "Paimon",
                    "text": "Tem um diário aqui! Vamos ver como ele está!"
                },
                {
                    "id": "790510102",
                    "speaker": "Paimon",
                    "text": "Uau, que tom descontraído!"
                },
                {
                    "id": "790510103",
                    "speaker": "Paimon",
                    "text": "Esse pintor estava totalmente descontraído, suas habilidades haviam melhorado bastante. Com certeza foi por isso que ele fez uma obra como essa."
                },
                {
                    "id": "790510104",
                    "speaker": "Paimon",
                    "text": "Mas, no final ele foi embora, não teve como ficar com suas amigas Gotinhas. Paimon acha isso um pouco triste.",
                    "choices": [
                        {
                            "id": "790510105",
                            "text": "Talvez o artista não quisesse ficar se copiando.",
                            "response": [
                                {
                                    "id": "790510107",
                                    "speaker": "Paimon",
                                    "text": "Sim, não é como se não desse para entender."
                                },
                                {
                                    "id": "790510108",
                                    "speaker": "Paimon",
                                    "text": "Mas tem algo que Paimon ainda não entendeu... Ele mencionou que o mural que deixou para trás pode ter sido distorcido."
                                },
                                {
                                    "id": "790510109",
                                    "speaker": "Paimon",
                                    "text": "Aquele acidente de antes foi tão terrível... Será que esse problema do mural não é grave demais?",
                                    "choices": [
                                        {
                                            "id": "790510110",
                                            "text": "A resposta vai estar com as Gotinhas.",
                                            "response": [
                                                {
                                                    "id": "790510112",
                                                    "speaker": "Paimon",
                                                    "text": "Oh, é isso! Será que as Gotinhas sabem lidar com o Projetor de Transmissão e restaurar o mural?"
                                                },
                                                {
                                                    "id": "790510113",
                                                    "speaker": "Paimon",
                                                    "text": "Oh, Paimon está comovida. As Gotinhas podem não parecer muito inteligentes, mas elas são bem consideradas, são leais, são amigas importantes..."
                                                }
                                            ]
                                        },
                                        {
                                            "id": "790510111",
                                            "text": "Elas protegeram o mural do seu amigo."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "790510106",
                            "text": "Ser fiel a sua criatividade também faz sentido."
                        }
                    ]
                }
            ]
        },
