    "talks": [
        {
            "id": "7224701",
            "objective": "",
            "dialogues": [
                {
                    "id": "722470101",
                    "speaker": "Aberaku",
                    "text": "#Viajante, você está pront{M#o}{F#a}?"
                }
            ]
        },
        {
            "id": "7224705",
            "objective": "",
            "dialogues": [
                {
                    "id": "722470301",
                    "speaker": "Paimon",
                    "text": "Veja... tem algo saindo..."
                },
                {
                    "id": "722470302",
                    "speaker": "Paimon",
                    "text": "Parece ser uma sombra também..."
                },
                {
                    "id": "722470303",
                    "speaker": "Aberaku",
                    "text": "Meu nome é..."
                },
                {
                    "id": "722470304",
                    "speaker": "Aberaku",
                    "text": "Aberaku, criador de Helios!"
                },
                {
                    "id": "722470305",
                    "speaker": "Paimon",
                    "text": "Eu entendi a frase..."
                },
                {
                    "id": "722470306",
                    "speaker": "Paimon",
                    "text": "Significa que..."
                },
                {
                    "id": "722470307",
                    "speaker": "Paimon",
                    "text": "O seu nome é Helios, né?",
                    "choices": [
                        {
                            "id": "722470308",
                            "text": "Por acaso você estava o ouvindo?",
                            "response": [
                                {
                                    "id": "722470310",
                                    "speaker": "Paimon",
                                    "text": "Ah, é?"
                                },
                                {
                                    "id": "722470311",
                                    "speaker": "Paimon",
                                    "text": "O nome dele é Aberaku. Que nome estranho."
                                },
                                {
                                    "id": "722470312",
                                    "speaker": "Paimon",
                                    "text": "Mas, já que o nome dele é Aberaku, então o que é Helios?"
                                },
                                {
                                    "id": "722470313",
                                    "speaker": "Aberaku",
                                    "text": "Ah, Helios! Helios!"
                                },
                                {
                                    "id": "722470314",
                                    "speaker": "Aberaku",
                                    "text": "A minha própria criação... Helios! Quando terminou, sua luz se espalhou de horizonte em horizonte, e assim o povo foi poupado do flagelo do dragão!"
                                },
                                {
                                    "id": "722470315",
                                    "speaker": "Aberaku",
                                    "text": "Como as pessoas o contemplavam então! Como choravam lágrimas quentes, levantavam os braços com gritos de alegria, incapazes de conter suas emoções intensas!"
                                },
                                {
                                    "id": "722470316",
                                    "speaker": "Aberaku",
                                    "text": "Não... espera! Por... por que estou aqui? Por que minha alma se perdeu no reino dos sonhos, incapaz de descansar em paz?"
                                },
                                {
                                    "id": "722470317",
                                    "speaker": "Player",
                                    "text": "Paimon, você entendeu?"
                                },
                                {
                                    "id": "722470318",
                                    "speaker": "Paimon",
                                    "text": "Sim, a Paimon entendeu."
                                },
                                {
                                    "id": "722470319",
                                    "speaker": "Paimon",
                                    "text": "Este é um espírito perturbado..."
                                },
                                {
                                    "id": "722470320",
                                    "speaker": "Aberaku",
                                    "text": "Eu me lembrei agora! Minha alma está incompleta! Só quando todos os pedaços de minha alma estiverem juntos, poderei descansar em paz de novo."
                                },
                                {
                                    "id": "722470321",
                                    "speaker": "Aberaku",
                                    "text": "Em um momento desses, você que desempenha um papel muito importante..."
                                },
                                {
                                    "id": "722470322",
                                    "speaker": "Paimon",
                                    "text": "A Paimon está sentindo que os problemas estão chegando..."
                                },
                                {
                                    "id": "722470323",
                                    "speaker": "Aberaku",
                                    "text": "Uma parte de meus ossos deveria ser guardada neste lugar, mas eles apodreceram há muito tempo... Por favor, eu lhe imploro..."
                                },
                                {
                                    "id": "722470324",
                                    "speaker": "Aberaku",
                                    "text": "Pegue essas oferendas que contêm meus sentimentos... No entanto, você encontrará monstros que mantêm minha alma trancada. Quando sentirem que o objeto que contém minha alma está sendo levado... Vão sair para atacar."
                                },
                                {
                                    "id": "722470325",
                                    "speaker": "Aberaku",
                                    "text": "#Este é um assunto perigoso. Viajante, diga-me quando estiver pront{M#o}{F#a}."
                                }
                            ]
                        },
                        {
                            "id": "722470309",
                            "text": "O nome dele é Aberaku."
                        }
                    ]
                }
            ]
        },
        {
            "id": "7224702",
            "objective": "Começar o julgamento do espírito",
            "dialogues": [
                {
                    "id": "722470501",
                    "speaker": "Player",
                    "text": "#Estou pront{M#o}{F#a}."
                },
                {
                    "id": "722470502",
                    "speaker": "Aberaku",
                    "text": "Então, boa sorte para você."
                }
            ]
        },
        {
            "id": "7224704",
            "objective": "Obtenha as oferendas do espírito",
            "dialogues": [
                {
                    "id": "722470201",
                    "speaker": "Aberaku",
                    "text": "Parece que você tem força o suficiente para escoltar as ofertas."
                },
                {
                    "id": "722470202",
                    "speaker": "Aberaku",
                    "text": "Assim eu poderei ficar mais descansado... Por favor, estas ofertas terão que chegar em segurança... para eu poder..."
                },
                {
                    "id": "722470203",
                    "speaker": "Paimon",
                    "text": "Para você poder fazer o quê..."
                },
                {
                    "id": "722470204",
                    "speaker": "Aberaku",
                    "text": "Para eu poder..."
                },
                {
                    "id": "722470205",
                    "speaker": "Paimon",
                    "text": "Ah não. Voltou a quebrar."
                },
                {
                    "id": "722470206",
                    "speaker": "Paimon",
                    "text": "Mas as ofertas que ele estava falando são provavelmente estas... Parece que elas também estão um pouco gastas."
                }
            ]
        },
        {
            "id": "7224706",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "722470601",
                    "speaker": "Player",
                    "text": "Não, preciso de mais um pouco de tempo."
                },
                {
                    "id": "722470602",
                    "speaker": "Aberaku",
                    "text": "Então ficarei esperando por você."
                }
            ]
        }
    ]
