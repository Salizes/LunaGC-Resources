    "talks": [
        {
            "id": "60501",
            "objective": "",
            "dialogues": [
                {
                    "id": "6051101",
                    "speaker": "Sucrose",
                    "text": "#Sr. Albedo! {NICKNAME}!"
                },
                {
                    "id": "6051102",
                    "speaker": "Albedo",
                    "text": "Tudo bem aqui?"
                },
                {
                    "id": "6051103",
                    "speaker": "Sucrose",
                    "text": "Tudo bem! Alguns monstros entraram na cidade, mas o Mestre Diluc e o Sr. Kaeya me ajudaram a cuidar deles."
                },
                {
                    "id": "6051104",
                    "speaker": "Sucrose",
                    "text": "Tenho algum tempo sobrando agora, então estava planejando fazer algumas poções para ajudar as pessoas lutando!"
                },
                {
                    "id": "6051105",
                    "speaker": "Albedo",
                    "text": "Um bom plano."
                },
                {
                    "id": "6051106",
                    "speaker": "Albedo",
                    "text": "Lembre-se de ter cuidado. Eu sei que é improvável, mas se você encontrar uma situação que não conseguir lidar, retire-se imediatamente para um lugar seguro. Não se preocupe com a linha de frente."
                },
                {
                    "id": "6051107",
                    "speaker": "Sucrose",
                    "text": "Entendido!"
                }
            ]
        },
        {
            "id": "60502",
            "objective": "",
            "dialogues": [
                {
                    "id": "6050201",
                    "speaker": "Kaeya",
                    "text": "Trabalho fantástico na defesa, pessoal."
                },
                {
                    "id": "6050202",
                    "speaker": "Diluc",
                    "text": "Pode deixar o resto conosco."
                },
                {
                    "id": "6050203",
                    "speaker": "Lawrence",
                    "text": "Capitão Kaeya, Swan está—"
                },
                {
                    "id": "6050204",
                    "speaker": "Swan",
                    "text": "Ei! Eu estou bem. É com sua perna que devíamos estar nos preocupando..."
                },
                {
                    "id": "6050205",
                    "speaker": "Kaeya",
                    "text": "Swan, Lawrence, vocês têm que ir receber tratamento na Igreja. Não se forcem. Vamos cuidar das coisas aqui."
                },
                {
                    "id": "6050206",
                    "speaker": "Swan",
                    "text": "Mas, Mestre Diluc... Você não deixou os Cavaleiros de Favonius?"
                },
                {
                    "id": "6050207",
                    "speaker": "Diluc",
                    "text": "O que foi, só Cavaleiros conseguem proteger esse portão?"
                },
                {
                    "id": "6050208",
                    "speaker": "Kaeya",
                    "text": "Está tudo bem. O Mestre Diluc só está... altruísta como sempre. Se um civil está disposto a ajudar, quem somos nós para recusar?"
                },
                {
                    "id": "6050209",
                    "speaker": "Swan",
                    "text": "...Entendido. Somos gratos pelo apoio."
                },
                {
                    "id": "6050210",
                    "speaker": "Lawrence",
                    "text": "É, obrigado mesmo! Voltaremos logo."
                },
                {
                    "id": "6050211",
                    "speaker": "Black Screen",
                    "text": ""
                }
            ]
        },
        {
