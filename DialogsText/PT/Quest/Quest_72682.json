    "talks": [
        {
            "id": "7268201",
            "objective": "Fale com Kayabuki",
            "dialogues": [
                {
                    "id": "726820101",
                    "speaker": "Kayabuki Ikkei",
                    "text": "#Olá, Viajante {M#loiro}{F#loira}...",
                    "choices": [
                        {
                            "id": "726820102",
                            "text": "Nos encontramos de novo.",
                            "response": [
                                {
                                    "id": "726820104",
                                    "speaker": "Kayabuki Ikkei",
                                    "text": "Hmm, seu cabelo loiro me parece familiar... você é..."
                                },
                                {
                                    "id": "726820105",
                                    "speaker": "Kayabuki Ikkei",
                                    "text": "Ah sim! Você é Tornado Dourado do Hyakunin Ikki da última vez..."
                                },
                                {
                                    "id": "726820106",
                                    "speaker": "Player",
                                    "text": "T-Tornado Dourado...?"
                                },
                                {
                                    "id": "726820107",
                                    "speaker": "Kayabuki Ikkei",
                                    "text": "Anteriormente, eu estava assistindo a excelente performance dos participantes de algum canto do torneio, procurando inspiração pelas cenas de lutas mais animadoras. E lá estava você, acabando com seus oponentes feito um turbilhão dourado, destruindo tudo em seu caminho...",
                                    "choices": [
                                        {
                                            "id": "726820108",
                                            "text": "Urgh, por favor, me poupe da bajulação.",
                                            "response": [
                                                {
                                                    "id": "726820113",
                                                    "speaker": "Kayabuki Ikkei",
                                                    "text": "Enfim, algumas pessoas organizaram recentemente outro Hyakunin Ikki.",
                                                    "choices": [
                                                        {
                                                            "id": "726820114",
                                                            "text": "O que é Hyakunin Ikki?",
                                                            "response": [
                                                                {
                                                                    "id": "726820115",
                                                                    "speaker": "Kayabuki Ikkei",
                                                                    "text": "É uma luta de todos-contra-todos, onde as pessoas lutam entre si para comemorar, ou para simplesmente acabar com a má sorte. É um festival em que tanto artistas marciais quanto monstros colocam suas desavenças de lado e esquecem suas identidades, apenas para aproveitar o calor da batalha."
                                                                },
                                                                {
                                                                    "id": "726820116",
                                                                    "speaker": "Kayabuki Ikkei",
                                                                    "text": "Dizem que aqueles que se sobressaem dentre a multidão, receberão grandes tesouros como recompensa."
                                                                },
                                                                {
                                                                    "id": "726820117",
                                                                    "speaker": "Kayabuki Ikkei",
                                                                    "text": "Porém, a identidade dos organizadores e patrocinadores é um mistério."
                                                                },
                                                                {
                                                                    "id": "726820119",
                                                                    "speaker": "Kayabuki Ikkei",
                                                                    "text": "Seja qual for o caso, não é um assunto para ser discutido abertamente. Siga-me..."
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "726820118",
                                                            "text": "Entendo..."
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "726820109",
                                            "text": "...Continue, não pare.",
                                            "response": [
                                                {
                                                    "id": "726820110",
                                                    "speaker": "Kayabuki Ikkei",
                                                    "text": "#Cof... \"Espectadores com o olho aguçado de um espadachim devem ter percebido — {M#o estrangeiro loiro}{F#a estrangeira loira} estava usando a técnica Kouranka Daitatsumaki, uma técnica considerada proibida até mesmo dentre os artistas marciais anciões...\""
                                                },
                                                {
                                                    "id": "726820111",
                                                    "speaker": "Player",
                                                    "text": "?"
                                                },
                                                {
                                                    "id": "726820112",
                                                    "speaker": "Kayabuki Ikkei",
                                                    "text": "Tendo sido inspirado pela sua maravilhosa luta, escrevi essa história."
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "726820103",
                            "text": "Você tem uma missão para mim?"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7268202",
            "objective": "Fale com Kayabuki",
            "dialogues": [
                {
                    "id": "726820201",
                    "speaker": "Kayabuki Ikkei",
                    "text": "Aqui estamos."
                },
                {
                    "id": "726820202",
                    "speaker": "Kayabuki Ikkei",
                    "text": "Assim que entrarmos nesse portão suspeito, estaremos dentro da área do Hyakunin Ikki da vez.",
                    "choices": [
                        {
                            "id": "726820203",
                            "text": "Ooh, isso é animador!",
                            "response": [
                                {
                                    "id": "726820205",
                                    "speaker": "Kayabuki Ikkei",
                                    "text": "As regras provavelmente não mudaram tanto. Monstros, aventureiros e guerreiros de vários cantos do mundo compartilham um desejo em comum pela batalha e poderão acabar com sua sede neste desafio através de uma batalha acalorada."
                                },
                                {
                                    "id": "726820206",
                                    "speaker": "Kayabuki Ikkei",
                                    "text": "Assim como da última vez, sinta-se livre para trazer amigos e companheiros! Afinal de contas, \"Hyakunin\" de \"Hyakunin Ikki\" significa quanto mais, melhor!"
                                },
                                {
                                    "id": "726820207",
                                    "speaker": "Kayabuki Ikkei",
                                    "text": "Mal posso esperar pela sua performance."
                                },
                                {
                                    "id": "726820208",
                                    "speaker": "Player",
                                    "text": "Você também não irá participar dessa vez?"
                                },
                                {
                                    "id": "726820209",
                                    "speaker": "Kayabuki Ikkei",
                                    "text": "Oh, mas é claro que eu vou - como um espectador, torcendo por você!"
                                },
                                {
                                    "id": "726820210",
                                    "speaker": "Kayabuki Ikkei",
                                    "text": "#Afinal de contas, o que almejo fazer é escrever romances de ação emocionantes, e não me tornar {M#um guerreiro}{F#uma guerreira} galante feito você."
                                },
                                {
                                    "id": "726820211",
                                    "speaker": "Kayabuki Ikkei",
                                    "text": "...E o meu instinto me diz que a sua estrela brilhará mais forte nesta arena.",
                                    "choices": [
                                        {
                                            "id": "726820212",
                                            "text": "Farei o meu melhor!",
                                            "response": [
                                                {
                                                    "id": "726820214",
                                                    "speaker": "Kayabuki Ikkei",
                                                    "text": "Sim, tenho certeza que você me mostrará a melhor dança da lâmina novamente."
                                                }
                                            ]
                                        },
                                        {
                                            "id": "726820213",
                                            "text": "Aguarde e você vai ver!"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "726820204",
                            "text": "Isso soa muito complicado..."
                        }
                    ]
                }
            ]
        }
    ]
}