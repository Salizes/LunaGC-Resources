            "objective": "Fale com Lizzie",
            "dialogues": [
                {
                    "id": "706580101",
                    "speaker": "Lizzie",
                    "text": "Olá! Você está aproveitando o Festival da Brisa Florescente?",
                    "choices": [
                        {
                            "id": "706580102",
                            "text": "#Obrigad{M#o}{F#a} pela sua recomendação.",
                            "response": [
                                {
                                    "id": "706580104",
                                    "speaker": "Lizzie",
                                    "text": "Haha. Tenho mais um evento. Esse é relaxado. O nome é \"Melodia da Paisagem\"."
                                },
                                {
                                    "id": "706580105",
                                    "speaker": "Lizzie",
                                    "text": "Você deve ter visto os Bardos em Mondstadt, não é? Ao participar neste evento, você poderá tocar boa música como eles!"
                                },
                                {
                                    "id": "706580106",
                                    "speaker": "Lizzie",
                                    "text": "Nas montanhas altas, à beira do lago, sentir o sopro do vento, tocar uma música com certeza fará com que você esqueça seus problemas.",
                                    "choices": [
                                        {
                                            "id": "706580107",
                                            "text": "Não tenho experiência com isso...",
                                            "response": [
                                                {
                                                    "id": "706580109",
                                                    "speaker": "Lizzie",
                                                    "text": "Não precisa se preocupar. Essa atividade foi feita para que pessoas sem experiência com Performances também possam aproveitar e se divertir com a música."
                                                },
                                                {
                                                    "id": "706580110",
                                                    "speaker": "Lizzie",
                                                    "text": "Só precisa seguir as dicas e o ritmo das notas que todo o resto deve ficar bem.",
                                                    "choices": [
                                                        {
                                                            "id": "706580111",
                                                            "text": "#Está bem, ficarei relaxad{F#a}{M#o} então.",
                                                            "response": [
                                                                {
                                                                    "id": "706580113",
                                                                    "speaker": "Lizzie",
                                                                    "text": "Espero que você tenha um Festival da Brisa Florescente muito feliz!"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "706580112",
                                                            "text": "Vou tentar."
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "706580108",
                                            "text": "Minha música soará bem?"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "706580103",
                            "text": "Ainda não tenho tempo..."
