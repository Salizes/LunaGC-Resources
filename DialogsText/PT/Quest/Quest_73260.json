        {
            "id": "7326001",
            "objective": "",
            "dialogues": [
                {
                    "id": "732600201",
                    "speaker": "Player",
                    "text": "Certo. Do que vamos brincar?"
                },
                {
                    "id": "732600202",
                    "speaker": "Aragita",
                    "text": "Sob os baús de madeira não há apenas lagartos, também há outras coisas. Nara deve se lembrar da posição das <color=#00E1FFFF>grandes pilhas de folhas</color>."
                },
                {
                    "id": "732600203",
                    "speaker": "Player",
                    "text": "Isso é moleza. Vamos começar."
                }
            ]
        },
        {
            "id": "7326003",
            "objective": "",
            "dialogues": [
                {
                    "id": "732600301",
                    "speaker": "Player",
                    "text": "Não é o momento certo."
                },
                {
                    "id": "732600302",
                    "speaker": "Aragita",
                    "text": "Aragita não vai se apressar. Vai esperar pelo \"momento certo\"."
                }
            ]
        },
        {
            "id": "7326004",
            "objective": "",
            "dialogues": [
                {
                    "id": "732600401",
                    "speaker": "Aragita",
                    "text": "#Grama e árvores se lembram, assim como Nara. Nara é amig{F#a}{M#o} de Aranara e amig{F#a}{M#o} da grama e das árvores também."
                }
            ]
        },
        {
            "id": "7326005",
            "objective": "",
            "dialogues": [
                {
                    "id": "732600501",
                    "speaker": "Aragita",
                    "text": "Nara errou, mas não importa. Há um monte de \"próxima vez\". Qualquer momento jogando com Nara é \"o momento certo\" para Aragita."
                }
            ]
        },
        {
            "id": "7326001",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "732600101",
                    "speaker": "Aragita",
                    "text": "#É amig{F#a}{M#o} de Aranara! {M#Bom}{F#Boa} Nara, quer brincar com Aragita?"
                }
            ]
        }
    ]
