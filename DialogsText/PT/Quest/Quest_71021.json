            "dialogues": [
                {
                    "id": "710210101",
                    "speaker": "Henry Morton",
                    "text": "",
                    "choices": [
                        {
                            "id": "710210102",
                            "text": "Você pode usar o Planador.",
                            "response": [
                                {
                                    "id": "710210103",
                                    "speaker": "Henry Morton",
                                    "text": "Esqueça. Estou trancado em casa desde que entrei para a Academia Sumero. Desde então, não tenho feito nenhuma atividade ao ar livre."
                                },
                                {
                                    "id": "710210104",
                                    "speaker": "Henry Morton",
                                    "text": "Você também realmente não pode usar seu Planador na Academia, então provavelmente eu já devo ter esquecido todos os ensinamentos do meu instrutor..."
                                },
                                {
                                    "id": "710210105",
                                    "speaker": "Henry Morton",
                                    "text": "Se você me pedisse para planar até lá, eu provavelmente cairia na água na metade do caminho."
                                }
                            ]
                        },
                        {
                            "id": "710210106",
                            "text": "Você podia alugar um barco.",
                            "response": [
                                {
                                    "id": "710210107",
                                    "speaker": "Henry Morton",
                                    "text": "Eu também pensei isso. E me lembro que no Porto de Dornman você podia alugar um barco, mas ele está muito longe..."
                                },
                                {
                                    "id": "710210108",
                                    "speaker": "Henry Morton",
                                    "text": "Quem sabe quanto tempo levará uma viagem de ida e volta..."
                                },
                                {
                                    "id": "710210109",
                                    "speaker": "Henry Morton",
                                    "text": "Mas eu não poderia simplesmente construir meu próprio barco. Quero dizer, não aprendi nada sobre isso na Academia Sumeru..."
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
