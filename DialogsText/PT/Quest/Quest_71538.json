    "talks": [
        {
            "id": "7153801",
            "objective": "Espere até 08:00 — 18:00 do dia seguinte",
            "dialogues": [
                {
                    "id": "715380101",
                    "speaker": "Chevreuse",
                    "text": "#Olá, {NICKNAME}. Feliz Ritual de Lanternas.",
                    "choices": [
                        {
                            "id": "715380102",
                            "text": "Você está aqui... por um caso?",
                            "response": [
                                {
                                    "id": "715380104",
                                    "speaker": "Chevreuse",
                                    "text": "Estou sendo forçada a tirar férias."
                                },
                                {
                                    "id": "715380105",
                                    "speaker": "Player",
                                    "text": "Forçada... a tirar férias?"
                                },
                                {
                                    "id": "715380106",
                                    "speaker": "Chevreuse",
                                    "text": "O Maison Gardiennage estipula que todos os empregados devem usar o período de férias até o final do ano."
                                },
                                {
                                    "id": "715380107",
                                    "speaker": "Chevreuse",
                                    "text": "Os cálculos de fim de ano chegaram e a Patrulha descobriu que eu não tinha tirado nenhum dia de folga, então...",
                                    "choices": [
                                        {
                                            "id": "715380108",
                                            "text": "Pra que isso...",
                                            "response": [
                                                {
                                                    "id": "715380110",
                                                    "speaker": "Chevreuse",
                                                    "text": "Não. Nossos membros operam numa escala rotativa, mas como capitã do esquadrão, estou sempre de serviço."
                                                },
                                                {
                                                    "id": "715380111",
                                                    "speaker": "Chevreuse",
                                                    "text": "Eu também lido com muitos casos de emergência, então com o tempo eu só... esqueci de tirar folga."
                                                },
                                                {
                                                    "id": "715380112",
                                                    "speaker": "Chevreuse",
                                                    "text": "Eu estava bem sem tirar nenhuma folga esse ano, mas o pessoal da minha equipe não quis saber..."
                                                },
                                                {
                                                    "id": "715380113",
                                                    "speaker": "Chevreuse",
                                                    "text": "Eles começaram a gritar sobre como as \"regras devem ser seguidas\" e \"uma capitã precisa dar um exemplo na liderança\". Basicamente, eles não aceitaram um não como resposta."
                                                },
                                                {
                                                    "id": "715380114",
                                                    "speaker": "Chevreuse",
                                                    "text": "Um dos Gestionnaires que trabalha conosco mencionou como Liyue está no topo dos destinos de férias durante o festival do Ritual de Lanternas. Ele tirou uma passagem de navio lá na hora, ao vivo, e aí... aqui estou."
                                                },
                                                {
                                                    "id": "715380115",
                                                    "speaker": "Chevreuse",
                                                    "text": "Tenho que admitir — Liyue é uma maravilha de se admirar nessa época do ano. Eu acabei de voltar da Vila Qiaoying, na verdade. Eu adorei o dim sum com chá."
                                                },
                                                {
                                                    "id": "715380116",
                                                    "speaker": "Chevreuse",
                                                    "text": "Comprei alguns para compartilhar com a Patrulha Especial. Eu estava planejando seguir costumes locais e fazer uns envelopes de presente também."
                                                },
                                                {
                                                    "id": "715380117",
                                                    "speaker": "Chevreuse",
                                                    "text": "Eu só... Não sou muito boa com esse tipo de coisa. Não importa o que eu faça, sempre acaba esquisito."
                                                },
                                                {
                                                    "id": "715380118",
                                                    "speaker": "Chevreuse",
                                                    "text": "#Você sabe como fazê-los, {NICKNAME}?"
                                                },
                                                {
                                                    "id": "715380119",
                                                    "speaker": "Player",
                                                    "text": "Tenho algumas sugestões..."
                                                }
                                            ]
                                        },
                                        {
                                            "id": "715380109",
                                            "text": "É assim pra todo mundo?"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "715380103",
                            "text": "Você... não parece tá aqui a trabalho..."
                        }
                    ]
                }
            ]
        },
        {
            "id": "7153802",
            "objective": "Fale com Chevreuse",
            "dialogues": []
        },
        {
            "id": "7153803",
            "objective": "Conclua o envelope de presente com Chevreuse",
            "dialogues": [
                {
                    "id": "715380301",
                    "speaker": "Chevreuse",
                    "text": "Uau, ficou ótimo! Hmm... Você merece alguma coisa por isso."
                },
                {
                    "id": "715380302",
                    "speaker": "Chevreuse",
                    "text": "Aqui, fica com esse dim sum como agradecimento pela sua ajuda. Receber esse envelope de você faz a viagem valer realmente a pena."
                },
                {
                    "id": "715380303",
                    "speaker": "Chevreuse",
                    "text": "...Mesmo assim, estou fora há algum tempo. Queria saber se o pessoal da minha equipe continuou com os treinos."
                },
                {
                    "id": "715380304",
                    "speaker": "Chevreuse",
                    "text": "Bem, acho que chegou a hora de elaborar um teste físico."
                }
            ]
        },
