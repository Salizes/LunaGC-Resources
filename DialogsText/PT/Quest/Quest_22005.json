        {
            "id": "2200501",
            "objective": "Fale com Bao'er",
            "dialogues": [
                {
                    "id": "220050101",
                    "speaker": "Bao'er",
                    "text": "Oh! Onde está..."
                },
                {
                    "id": "220050102",
                    "speaker": "Player",
                    "text": "O que você está fazendo?"
                },
                {
                    "id": "220050103",
                    "speaker": "Bao'er",
                    "text": "#Uau! De onde você veio? Por que assim tão silencios{M#o}{F#a}?"
                },
                {
                    "id": "220050104",
                    "speaker": "Bao'er",
                    "text": "Eu? Eu sou uma pesquisadora, estou pesquisando a arquitetura antiga e as ruínas das Planícies de Guili. Pode me chamar de Bao'er."
                },
                {
                    "id": "220050105",
                    "speaker": "Bao'er",
                    "text": "Mas estava tão concentrada na minha pesquisa que perdi um pacote."
                },
                {
                    "id": "220050106",
                    "speaker": "Bao'er",
                    "text": "Aí dentro estão os tesouro... as relíquias históricas. Você pode me ajudar a procurar?",
                    "choices": [
                        {
                            "id": "220050107",
                            "text": "Entendi.",
                            "response": [
                                {
                                    "id": "220050110",
                                    "speaker": "Bao'er",
                                    "text": "Que bom! Deve ser aqui perto... ou talvez um pouco mais longe. Enfim, por favor procure com mais atenção."
                                }
                            ]
                        },
                        {
                            "id": "220050108",
                            "text": "Que tipo de pacote?",
                            "response": [
                                {
                                    "id": "220050111",
                                    "speaker": "Bao'er",
                                    "text": "É um pacote comum e quadrado, todo mundo usa."
                                },
                                {
                                    "id": "220050112",
                                    "speaker": "Bao'er",
                                    "text": "Mas por que você colocou as relíquias aí dentro? Porque assim é mais conveniente?"
                                },
                                {
                                    "id": "220050113",
                                    "speaker": "Bao'er",
                                    "text": "Aliás, eu coloquei algumas roupas dentro do pacote também, para protegê-lo do nenhum dano. Por favor, ajude-me a procurá-lo."
                                }
                            ]
                        },
                        {
                            "id": "220050109",
                            "text": "Que tipo de relíquias históricas?",
                            "response": [
                                {
                                    "id": "220050114",
                                    "speaker": "Bao'er",
                                    "text": "De fato, são relíquias bem preciosas. *Suspiro* Você não consegue entender."
                                },
                                {
                                    "id": "220050115",
                                    "speaker": "Bao'er",
                                    "text": "Só os peritos como eu conseguem entender o seu valor! Por favor, encontre o mais rápido possível!"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
