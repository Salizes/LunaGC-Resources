{
    "quest": {
        "id": "76123",
        "title": "Um Presente Dela",
        "description": "Parece que Columbina tem algo que deseja fazer no Saguão da Lua Prateada...",
        "rewards": [
            {
                "itemId": 108950,
                "count": 1
            }
