        "total_dialogue_lines": 90,
        "total_speaker_counts": {
            "Black Screen": 2,
            "Columbina": 36,
            "Kuuhenki": 1,
            "Luonnotar": 1,
            "Paimon": 21,
            "Player": 28,
            "Íbis": 1
        }
    },
    "talks": [
        {
            "id": "7612301",
            "objective": "Encontre Columbina",
            "dialogues": [
                {
                    "id": "761230101",
                    "speaker": "Paimon",
                    "text": "Uu-hu-hu, isso está com um cheiro ma-ra-vi-lho-so! Chegamos bem na hora da refeição da Columbina de novo?"
                },
                {
                    "id": "761230102",
                    "speaker": "Paimon",
                    "text": "Hã? Aqueles kuuhenki... estão fazendo fila? Para a sopa que a Columbina está servindo?"
                },
                {
                    "id": "761230103",
                    "speaker": "Columbina",
                    "text": "Só um momento."
                },
                {
                    "id": "761230104",
                    "speaker": "Kuuhenki",
                    "text": "~!"
                },
                {
                    "id": "761230105",
                    "speaker": "Paimon",
                    "text": "Uau, isso está realmente bom!"
                },
                {
                    "id": "761230106",
                    "speaker": "Paimon",
                    "text": "Uma sopa de frutas refrescante e saborosa, Paimon nunca provou nada parecido!"
                },
                {
                    "id": "761230107",
                    "speaker": "Columbina",
                    "text": "Outra porção?"
                },
                {
                    "id": "761230108",
                    "speaker": "Paimon",
                    "text": "Duas!"
                },
                {
                    "id": "761230109",
                    "speaker": "Luonnotar",
                    "text": "...!"
                },
                {
                    "id": "761230110",
                    "speaker": "Player",
                    "text": "Você está aprendendo a cozinhar?"
                },
                {
                    "id": "761230111",
                    "speaker": "Columbina",
                    "text": "Sim. Eu pedi à Ineffa algumas receitas básicas e fiz várias tentativas. Os kuuhenki e os animais reagiram de forma bem positiva."
                },
                {
                    "id": "761230112",
                    "speaker": "Player",
                    "text": "Você está tendo algum problema na cozinha?"
                },
                {
                    "id": "761230113",
                    "speaker": "Columbina",
                    "text": "Bem... Minhas mangas são muito largas. Elas esbarram na panela se eu não tomar cuidado..."
                },
                {
                    "id": "761230114",
                    "speaker": "Player",
                    "text": "(Então, não é o ato de cozinhar em si que está lhe causando problemas.)"
                },
                {
                    "id": "761230115",
                    "speaker": "Columbina",
                    "text": "Eu tenho certa dificuldade em fazer sobremesas, no entanto."
                },
                {
                    "id": "761230116",
                    "speaker": "Columbina",
                    "text": "Você precisa acertar a temperatura e as proporções..."
                },
                {
                    "id": "761230117",
                    "speaker": "Player",
                    "text": "(Ela provavelmente não cozinhava muito para si mesma no passado.)"
                },
                {
                    "id": "761230118",
                    "speaker": "Player",
                    "text": "(Além disso, doces e lanches são particularmente difíceis de acertar quando se trabalha sozinha...)"
                },
                {
                    "id": "761230119",
                    "speaker": "Player",
                    "text": "Gostaria que eu ajudasse?"
                },
                {
                    "id": "761230120",
                    "speaker": "Columbina",
                    "text": "Claro. Vamos começar com Rolinho de Ovo, que tal?"
                },
                {
                    "id": "761230121",
                    "speaker": "Black Screen",
                    "text": "Algum tempo depois..."
                },
                {
                    "id": "761230122",
                    "speaker": "Columbina",
                    "text": "Gostaria de provar um?",
                    "choices": [
                        {
                            "id": "761230123",
                            "text": "(Dar uma mordida.)",
                            "response": [
                                {
                                    "id": "761230125",
                                    "speaker": "Columbina",
                                    "text": "..."
                                },
                                {
                                    "id": "761230126",
                                    "speaker": "Player",
                                    "text": "(Uau, aquela primeira mordida provavelmente deixou minha expressão mais azeda que uma ameixa-seca...)"
                                },
                                {
                                    "id": "761230127",
                                    "speaker": "Player",
                                    "text": "(Mas depois que você engole um pouco, a doçura volta... Talvez fique melhor quando você se acostumar...)"
                                },
                                {
                                    "id": "761230128",
                                    "speaker": "Columbina",
                                    "text": "O que você acha?",
                                    "choices": [
                                        {
                                            "id": "761230129",
                                            "text": "Dá para passar...",
                                            "response": [
                                                {
                                                    "id": "761230131",
                                                    "speaker": "Paimon",
                                                    "text": "Paimon perdeu alguma coisa?"
                                                },
                                                {
                                                    "id": "761230132",
                                                    "speaker": "Player",
                                                    "text": "Experimente isto rapidinho, pode ser?"
                                                },
                                                {
                                                    "id": "761230133",
                                                    "speaker": "Paimon",
                                                    "text": "..."
                                                },
                                                {
                                                    "id": "761230134",
                                                    "speaker": "Paimon",
                                                    "text": "#Gaaaah, é muito azedo! O q—que vocês d{M#oi}{F#ua}s estão tentando fazer com a Paimon!?"
                                                },
                                                {
                                                    "id": "761230135",
                                                    "speaker": "Columbina",
                                                    "text": "Haha..."
                                                },
                                                {
                                                    "id": "761230136",
                                                    "speaker": "Player",
                                                    "text": "Mas o retrogosto é bem gostoso."
                                                },
                                                {
                                                    "id": "761230137",
                                                    "speaker": "Paimon",
                                                    "text": "#O importante é o gosto inicial! Nenhum{F#a} de vocês podia ter avisado pra Paimon dar uma mordida menor!?"
                                                },
                                                {
                                                    "id": "761230138",
                                                    "speaker": "Paimon",
                                                    "text": "Se você não tivesse dito nada, a Paimon teria achado que isso era uma pegadinha! Tipo ver as pessoas fazendo careta ou algo assim..."
                                                },
                                                {
                                                    "id": "761230139",
                                                    "speaker": "Columbina",
                                                    "text": "Certo. Deixe-me tentar de novo."
                                                },
                                                {
                                                    "id": "761230140",
                                                    "speaker": "Black Screen",
                                                    "text": "Mais tempo se passa..."
                                                },
                                                {
                                                    "id": "761230141",
                                                    "speaker": "Columbina",
                                                    "text": "Aqui. Experimente esta fornada."
                                                },
                                                {
                                                    "id": "761230142",
                                                    "speaker": "Player",
                                                    "text": "(Uau...! Isto está bem melhor!)",
                                                    "choices": [
                                                        {
                                                            "id": "761230143",
                                                            "text": "Está delicioso!",
                                                            "response": [
                                                                {
                                                                    "id": "761230145",
                                                                    "speaker": "Paimon",
                                                                    "text": "Sério? Paimon também quer! ...Mmm! Aí, sim! Muito gostoso!"
                                                                },
                                                                {
                                                                    "id": "761230146",
                                                                    "speaker": "Columbina",
                                                                    "text": "Bom o bastante para ser dado de presente?"
                                                                },
                                                                {
                                                                    "id": "761230147",
                                                                    "speaker": "Paimon",
                                                                    "text": "Com certeza! Espera, você aprendeu a cozinhar e fazer Rolinho de Ovo porque queria preparar um presente para alguém?"
                                                                },
                                                                {
                                                                    "id": "761230148",
                                                                    "speaker": "Columbina",
                                                                    "text": "Sim... Para minhas amigas."
                                                                },
                                                                {
                                                                    "id": "761230149",
                                                                    "speaker": "Player",
                                                                    "text": "É uma ótima ideia."
                                                                },
                                                                {
                                                                    "id": "761230150",
                                                                    "speaker": "Columbina",
                                                                    "text": "#Ainda se lembra da primeira vez que vocês vieram aqui junt{M#o}{F#a}s? Você tinha preparado um pouco de comida para mim."
                                                                },
                                                                {
                                                                    "id": "761230151",
                                                                    "speaker": "Columbina",
                                                                    "text": "Embora a comida não pudesse fazer muito para restaurar o poder que eu havia perdido, comê-la me fez sentir mais tranquila."
                                                                },
                                                                {
                                                                    "id": "761230152",
                                                                    "speaker": "Columbina",
                                                                    "text": "Na época, eu não pensei muito nisso, mas agora eu entendo."
                                                                },
                                                                {
                                                                    "id": "761230153",
                                                                    "speaker": "Columbina",
                                                                    "text": "O tempo e o esforço colocados ao preparar comida com cuidado, à mão, são o que lhe dão alma."
                                                                },
                                                                {
                                                                    "id": "761230154",
                                                                    "speaker": "Columbina",
                                                                    "text": "O que me agradou não foi apenas a comida em si, mas a ternura e a gentileza nas mãos que a fizeram."
                                                                },
                                                                {
                                                                    "id": "761230155",
                                                                    "speaker": "Columbina",
                                                                    "text": "E quanto menos essas mãos buscam reciprocidade, maior é a ternura e a gentileza necessárias para corresponder a isso."
                                                                },
                                                                {
                                                                    "id": "761230156",
                                                                    "speaker": "Paimon",
                                                                    "text": "Awn, a Paimon vai até ficar corada se você continuar falando assim... Para ser honesta, naquela época, a gente estava pelo menos meio que esperando cair nas suas boas graças.",
                                                                    "choices": [
                                                                        {
                                                                            "id": "761230157",
                                                                            "text": "Mas agora as coisas são diferentes.",
                                                                            "response": [
                                                                                {
                                                                                    "id": "761230159",
                                                                                    "speaker": "Columbina",
                                                                                    "text": "De fato. Mas agora que eu entendo tudo isso, gostaria de fazer um pouco mais... É uma sensação maravilhosa."
                                                                                },
                                                                                {
                                                                                    "id": "761230160",
                                                                                    "speaker": "Columbina",
                                                                                    "text": "Você viria comigo visitar nossos amigos?"
                                                                                },
                                                                                {
                                                                                    "id": "761230161",
                                                                                    "speaker": "Columbina",
                                                                                    "text": "Além dos Rolinhos de Ovo, também preparei alguns outros presentes. Ah, mas eles precisam ser enviados em segredo."
                                                                                },
                                                                                {
                                                                                    "id": "761230162",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "Por que \"em segredo\", se não se importar com a pergunta da Paimon?"
                                                                                },
                                                                                {
                                                                                    "id": "761230163",
                                                                                    "speaker": "Columbina",
                                                                                    "text": "#Bom, vocês sempre foram {M#o}{F#a}s responsáveis por me \"surpreender\". Quero ver como meus amigos vão reagir quando os papéis se inverterem."
                                                                                },
                                                                                {
                                                                                    "id": "761230164",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "Ufa. Corremos para todo lado. Mas finalmente terminamos."
                                                                                },
                                                                                {
                                                                                    "id": "761230165",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "As reações deles foram meio surpreendentes. Alguns nem perceberam que eram presentes seus, Columbina..."
                                                                                },
                                                                                {
                                                                                    "id": "761230166",
                                                                                    "speaker": "Player",
                                                                                    "text": "A Aino já foi direto beliscar..."
                                                                                },
                                                                                {
                                                                                    "id": "761230167",
                                                                                    "speaker": "Columbina",
                                                                                    "text": "Tudo bem. Já esperava por isso. O importante é que ficaram felizes em receber os presentes."
                                                                                },
                                                                                {
                                                                                    "id": "761230168",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "Nesse caso, a Lauma com certeza sabia que os Rolinhos de Ovo e o Anel de Flores na mesa dela vieram de você."
                                                                                },
                                                                                {
                                                                                    "id": "761230169",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "A Paimon até entende ela ficar hesitante em usar o Anel de Flores, mas, sério, ela ficou uns bons dez minutos encarando os Rolinhos de Ovo e ainda assim não conseguiu comer nem um..."
                                                                                },
                                                                                {
                                                                                    "id": "761230170",
                                                                                    "speaker": "Player",
                                                                                    "text": "#Eu já estava ficando preocupad{M#o}{F#a} que ela fosse até venerá-los..."
                                                                                },
                                                                                {
                                                                                    "id": "761230171",
                                                                                    "speaker": "Columbina",
                                                                                    "text": "Parece que a Jahoda levou um belo susto... Talvez não devêssemos ter colocado os presentes diretamente atrás dela..."
                                                                                },
                                                                                {
                                                                                    "id": "761230172",
                                                                                    "speaker": "Player",
                                                                                    "text": "Ela quase pulou de susto."
                                                                                },
                                                                                {
                                                                                    "id": "761230173",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "Talvez ela seja naturalmente mais atenta? Ainda assim, parece que ela se acalmou quando o Ashru veio arranhar o arranhador que você enviou."
                                                                                },
                                                                                {
                                                                                    "id": "761230174",
                                                                                    "speaker": "Columbina",
                                                                                    "text": "Quanto aos nossos outros amigos que não estão em Nod-Krai, estou contando com vocês para entregarem os presentes deles."
                                                                                },
                                                                                {
                                                                                    "id": "761230175",
                                                                                    "speaker": "Íbis",
                                                                                    "text": "!!!"
                                                                                },
                                                                                {
                                                                                    "id": "761230176",
                                                                                    "speaker": "Player",
                                                                                    "text": "Tenho de dizer, você é muito boa em preparar presentes."
                                                                                },
                                                                                {
                                                                                    "id": "761230177",
                                                                                    "speaker": "Columbina",
                                                                                    "text": "Aqui."
                                                                                },
                                                                                {
                                                                                    "id": "761230178",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "Ooh! Finalmente chegou a nossa vez?"
                                                                                },
                                                                                {
                                                                                    "id": "761230179",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "Hã? Doces? Paimon achou que a gente fosse ganhar Rolinhos de Ovo como todo mundo."
                                                                                },
                                                                                {
                                                                                    "id": "761230180",
                                                                                    "speaker": "Columbina",
                                                                                    "text": "Bem, vocês já comeram alguns enquanto faziam os testes de sabor. Um pouco de variedade faz bem, não acha?",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "761230181",
                                                                                            "text": "É... Eles também são muito bons.",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "761230183",
                                                                                                    "speaker": "Columbina",
                                                                                                    "text": "Fico feliz em ouvir isso."
                                                                                                },
                                                                                                {
                                                                                                    "id": "761230184",
                                                                                                    "speaker": "Columbina",
                                                                                                    "text": "E tem mais um presente. Aqui, para você."
                                                                                                },
                                                                                                {
                                                                                                    "id": "761230185",
                                                                                                    "speaker": "Player",
                                                                                                    "text": "Isto é... um Planador?"
                                                                                                },
                                                                                                {
                                                                                                    "id": "761230186",
                                                                                                    "speaker": "Columbina",
                                                                                                    "text": "Ouvi dizer que os céus pertencem às aves e a terra, às feras..."
                                                                                                },
                                                                                                {
                                                                                                    "id": "761230187",
                                                                                                    "speaker": "Columbina",
                                                                                                    "text": "Enquanto o vasto espaço entre os dois é reservado aos aventureiros que usam Planadores."
                                                                                                },
                                                                                                {
                                                                                                    "id": "761230188",
                                                                                                    "speaker": "Columbina",
                                                                                                    "text": "Com isto ao seu lado, que o seu caminho à frente esteja sempre iluminado como à luz da lua."
                                                                                                },
                                                                                                {
                                                                                                    "id": "761230189",
                                                                                                    "speaker": "Player",
                                                                                                    "text": "#É perfeito! Obrigad{M#o}{F#a}."
                                                                                                },
                                                                                                {
                                                                                                    "id": "761230190",
                                                                                                    "speaker": "Columbina",
                                                                                                    "text": "E obrigada a você, pela sua companhia."
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "761230182",
                                                                                            "text": "São até melhores do que os Doces da Noite da Oração Lunar."
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "761230158",
                                                                            "text": "Se tiver algo que você queira comer, é só dizer."
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "761230144",
                                                            "text": "Você aprende rápido mesmo!"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "761230130",
                                            "text": "Mas dá para melhorar..."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "761230124",
                            "text": "(Devorar tudo.)"
                        }
                    ]
                }
            ]
        }
    ]
}