        },
        {
            "id": "7403101",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "740310101",
                    "speaker": "Nizami",
                    "text": "#Jovem guerreir{M#o}{F#a}, vai treinar comigo?"
                },
                {
                    "id": "740310102",
                    "speaker": "Paimon",
                    "text": "Hmm, isso é bem repentino..."
                },
                {
                    "id": "740310103",
                    "speaker": "Nizami",
                    "text": "#Você que sabe, {M#rapaz}{F#moça} do cabelo dourado. Posso ver que você é um{F#a} veteran{M#o}{F#a} só com um olhar."
                },
                {
                    "id": "740310104",
                    "speaker": "Nizami",
                    "text": "Que tédio, não tem ninguém para treinar comigo. Se você treinar, eu te dou Cupons Especiais! Eu ganhei muitos de Roussimoff e não descobri ainda como gastar."
                },
                {
                    "id": "740310105",
                    "speaker": "Nizami",
                    "text": "Que tal?"
                }
            ]
        },
        {
            "id": "7403181",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "740318101",
                    "speaker": "Player",
                    "text": "#Sou um{F#a} pacifista, não gosto de lutar."
                },
                {
                    "id": "740318102",
                    "speaker": "Nizami",
                    "text": "#Um{F#a} pacifista que usa violência para lutar contra a violência? Cada doido com sua loucura."
                },
                {
                    "id": "740318103",
                    "speaker": "Nizami",
                    "text": "Mas isso não é uma luta, estamos apenas treinando. Treinamos para proteger melhor a paz. Se você é esse tipo de pacifista, a gente tem que treinar!"
                },
                {
                    "id": "740318104",
                    "speaker": "Player",
                    "text": "Você tem razão. Vamos nessa!"
                },
                {
                    "id": "740318105",
                    "speaker": "Nizami",
                    "text": "Ha! Muito bem!"
                },
                {
                    "id": "740318106",
                    "speaker": "Nizami",
                    "text": "Vamos para um lugar espaçoso!"
                }
            ]
        },
        {
            "id": "7403182",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "740318201",
                    "speaker": "Player",
                    "text": "Eu não posso agora. Talvez mais tarde."
                },
                {
                    "id": "740318202",
                    "speaker": "Nizami",
                    "text": "Estarei esperando você aqui!"
                }
            ]
        },
        {
            "id": "7403190",
