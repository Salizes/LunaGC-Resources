        {
            "id": "7403103",
            "objective": "Fale com Nizami",
            "dialogues": [
                {
                    "id": "740310301",
                    "speaker": "Nizami",
                    "text": "Ha! Sensacional!"
                },
                {
                    "id": "740310302",
                    "speaker": "Nizami",
                    "text": "#Eu sabia, {M#rapaz}{F#moça}! Você é um{F#a} oponente dign{M#o}{F#a}!",
                    "choices": [
                        {
                            "id": "740310303",
                            "text": "Você também não é nada mal.",
                            "response": [
                                {
                                    "id": "740310304",
                                    "speaker": "Nizami",
                                    "text": "Parece que preciso praticar mais."
                                },
                                {
                                    "id": "740310307",
                                    "speaker": "Nizami",
                                    "text": "Enfim, falo tudo na lata, como você. Aqui estão seus Cupons. Vamos fazer isso de novo outra hora!"
                                }
                            ]
                        },
                        {
                            "id": "740310305",
                            "text": "Você ainda tem um longo caminho pela frente.",
                            "response": [
                                {
                                    "id": "740310306",
                                    "speaker": "Nizami",
                                    "text": "#Você não mede suas palavras, {M#rapaz}{F#moça}. Eu gosto disso!"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7403100",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "740310001",
                    "speaker": "Black Screen",
                    "text": "Você segue Nizami ao Ringue de Pancrácio..."
