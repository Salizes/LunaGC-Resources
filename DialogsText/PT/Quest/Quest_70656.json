    "talks": [
        {
            "id": "7065601",
            "objective": "Fale com Plauen",
            "dialogues": [
                {
                    "id": "706560101",
                    "speaker": "Plauen",
                    "text": "Olá! Você veio desafiar esse Domínio daqui?",
                    "choices": [
                        {
                            "id": "706560102",
                            "text": "#Estou um pouco interessad{F#a}{M#o}.",
                            "response": [
                                {
                                    "id": "706560104",
                                    "speaker": "Plauen",
                                    "text": "Então deixe-me apresentar oficialmente. Eu sou Plauen, responsável por vigiar a entrada deste Domínio."
                                },
                                {
                                    "id": "706560105",
                                    "speaker": "Plauen",
                                    "text": "De acordo com os registros da Guilda de Aventureiros, esse Domínio parece surgir apenas por um período de tempo específico."
                                },
                                {
                                    "id": "706560106",
                                    "speaker": "Plauen",
                                    "text": "Agora estamos no Festival da Brisa Florescente. Fizemos umas alterações no interior, deixando o desafio muito especial e aberto para todos."
                                },
                                {
                                    "id": "706560107",
                                    "speaker": "Player",
                                    "text": "Não é perigoso?"
                                },
                                {
                                    "id": "706560108",
                                    "speaker": "Plauen",
                                    "text": "Não tem problema. Isso é um evento especial para celebrar o Festival. Se alguém que não tem experiência com aventuras participar, terá um Aventureiro veterano o acompanhando sempre."
                                },
                                {
                                    "id": "706560109",
                                    "speaker": "Plauen",
                                    "text": "#Vocês são {F#aventureiras}{M#aventureiros} experientes, não devem precisar de ajuda nenhuma."
                                },
                                {
                                    "id": "706560110",
                                    "speaker": "Plauen",
                                    "text": "#Você pode explorar o domínio sozinh{M#o}{F#a} ou convidar seus amigos. Mas de qualquer forma, conclua o domínio para obter recompensas.",
                                    "choices": [
                                        {
                                            "id": "706560111",
                                            "text": "Entendido.",
                                            "response": [
                                                {
                                                    "id": "706560113",
                                                    "speaker": "Plauen",
                                                    "text": "Não vou mais tomar do seu tempo. Espero que se divirtam aqui."
                                                }
                                            ]
                                        },
                                        {
                                            "id": "706560112",
                                            "text": "Se tem recompensas, vou tentar."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "706560103",
                            "text": "Parece ser um domínio bem peculiar."
                        }
                    ]
                }
            ]
        }
    ]
}