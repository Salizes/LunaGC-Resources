    "talks": [
        {
            "id": "7068901",
            "objective": "Fale com Katheryne",
            "dialogues": [
                {
                    "id": "706890114",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>Alguma novidade?</color>"
                },
                {
                    "id": "706890101",
                    "speaker": "Katheryne",
                    "text": "#Ah, {NICKNAME}, você chegou na hora certa! Tenho algo para você.",
                    "choices": [
                        {
                            "id": "706890102",
                            "text": "Uma carta pedindo ajuda? Ou uma pista de algum tesouro?",
                            "response": [
                                {
                                    "id": "706890104",
                                    "speaker": "Katheryne",
                                    "text": "#...Você com certeza está bem familiarizad{M#o}{F#a} com o tipo de trabalho que fazemos, mas receio que isso não tem nada a ver com nenhuma de nossas comissões."
                                },
                                {
                                    "id": "706890105",
                                    "speaker": "Katheryne",
                                    "text": "É um caderno novinho da Guilda de Aventureiros.",
                                    "choices": [
                                        {
                                            "id": "706890106",
                                            "text": "Mas eu já tenho o Manual de Aventura...",
                                            "response": [
                                                {
                                                    "id": "706890108",
                                                    "speaker": "Katheryne",
                                                    "text": "O Manual de Aventura serve para registrar os detalhes das comissões concluídas e informações sobre todos os tipos de monstros."
                                                },
                                                {
                                                    "id": "706890109",
                                                    "speaker": "Katheryne",
                                                    "text": "Já este caderno é para anotar as pessoas maravilhosas e os acontecimentos incríveis que você encontrar durante suas viagens.",
                                                    "choices": [
                                                        {
                                                            "id": "706890110",
                                                            "text": "Ah...",
                                                            "response": [
                                                                {
                                                                    "id": "706890112",
                                                                    "speaker": "Katheryne",
                                                                    "text": "Espero que seja de ajuda para você. De qualquer forma, isso é tudo por ora, minha \"comissão\" está concluída."
                                                                },
                                                                {
                                                                    "id": "706890113",
                                                                    "speaker": "Katheryne",
                                                                    "text": "#Boa viagem, {NICKNAME}. Ad astra abyssosque!"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "706890111",
                                                            "text": "Isso parece mesmo útil."
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "706890107",
                                            "text": "Por que está me dando um novo?"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "706890103",
                            "text": "É uma comissão de escolta ou uma missão de busca e resgate?"
                        }
                    ]
                }
            ]
        },
