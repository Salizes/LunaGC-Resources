    "talks": [
        {
            "id": "7406702",
            "objective": "Examine os três amplificadores separadamente",
            "dialogues": []
        },
        {
            "id": "7406703",
            "objective": "Vá para a localização mencionada pelo amplificador",
            "dialogues": []
        },
        {
            "id": "7406704",
            "objective": "Fale com Clynes",
            "dialogues": [
                {
                    "id": "740670401",
                    "speaker": "Clynes",
                    "text": "Nos encontramos novamente. Apostei comigo mesmo se ia ser você que viria.",
                    "choices": [
                        {
                            "id": "740670402",
                            "text": "Então, ganhou ou perdeu?",
                            "response": [
                                {
                                    "id": "740670403",
                                    "speaker": "Clynes",
                                    "text": "Hehe, ganhei e perdi."
                                },
                                {
                                    "id": "740670406",
                                    "speaker": "Paimon",
                                    "text": "Por que você faria isso usando um amplificador? Você não ia ter problema se Galvaryet te pegasse? Você não morre de medo dela?"
                                },
                                {
                                    "id": "740670407",
                                    "speaker": "Clynes",
                                    "text": "Morro de medo dela? Por quê? É só um pouco chato quando ela te pega. Mas ela passa a maioria do tempo na área administrativa. Ela não se envolve com os assuntos na Área de Produção, exceto caso tenha um motivo especial."
                                },
                                {
                                    "id": "740670408",
                                    "speaker": "Clynes",
                                    "text": "Quanto ao motivo de eu usar um amplificador para coisas assim, naturalmente é porque é chato demais aqui."
                                },
                                {
                                    "id": "740670409",
                                    "speaker": "Clynes",
                                    "text": "Acho que entendo Teilhard agora. Ele deve estar muito entediado, então tá sempre tentando achar jeitos de se divertir. Nesse sentido, só estou copiando ele."
                                },
                                {
                                    "id": "740670410",
                                    "speaker": "Clynes",
                                    "text": "Você tem um amigo como ele, né? Um que sempre é cheio de ideias malucas, às vezes fazendo uma bagunça ridícula.",
                                    "choices": [
                                        {
                                            "id": "740670411",
                                            "text": "Naturalmente.",
                                            "response": [
                                                {
                                                    "id": "740670413",
                                                    "speaker": "Paimon",
                                                    "text": "Paimon não te entende nem um pouco! Se você acha que é chato aqui e tem um amigo assim, por que vocês só não saem da Fortaleza Meropide? Ou vocês são mesmo culpados por algum crime sério...?"
                                                },
                                                {
                                                    "id": "740670414",
                                                    "speaker": "Clynes",
                                                    "text": "Eu posso sair quando quiser. Eu que escolho ficar."
                                                },
                                                {
                                                    "id": "740670415",
                                                    "speaker": "Clynes",
                                                    "text": "É muito melhor aqui do que lá fora. Nada para se preocupar, a vida é estável e não precisa pensar em coisas complicadas."
                                                },
                                                {
                                                    "id": "740670416",
                                                    "speaker": "Clynes",
                                                    "text": "Eu sinto inveja mesmo daquela garota Lanoire. Se eu fosse ela, escolheria nunca sair. Preferia nem saber do mundo lá fora.",
                                                    "choices": [
                                                        {
                                                            "id": "740670417",
                                                            "text": "Isso porque você já viu o mundo lá fora.",
                                                            "response": [
                                                                {
                                                                    "id": "740670418",
                                                                    "speaker": "Clynes",
                                                                    "text": "Você tem razão aí. Não dá pra julgar sem ter visto as evidências."
                                                                },
                                                                {
                                                                    "id": "740670421",
                                                                    "speaker": "Paimon",
                                                                    "text": "Mas isso não quer dizer que você não vai ver seus amigos se ficar aqui? Exceto se eles descerem aqui também..."
                                                                },
                                                                {
                                                                    "id": "740670422",
                                                                    "speaker": "Clynes",
                                                                    "text": "Boa notícia: Isso não é problema pra mim. Má notícia: Não é um problema porque todos os meus amigos se foram."
                                                                },
                                                                {
                                                                    "id": "740670423",
                                                                    "speaker": "Clynes",
                                                                    "text": "*Suspiro* Eu não sou bom com assuntos assim."
                                                                },
                                                                {
                                                                    "id": "740670424",
                                                                    "speaker": "Clynes",
                                                                    "text": "Quando eles ainda estavam por aqui, a vida não era tão ruim. Mesmo nosso campo de pesquisa não sendo particularmente popular e conseguir financiamento ser praticamente impossível."
                                                                },
                                                                {
                                                                    "id": "740670425",
                                                                    "speaker": "Clynes",
                                                                    "text": "Então os acidentes e azar começaram a empilhar. Butor faleceu por doença, o Laboratório Central explodiu e Teilhard se foi na explosão."
                                                                },
                                                                {
                                                                    "id": "740670426",
                                                                    "speaker": "Clynes",
                                                                    "text": "E o que foi demitido... Esqueça, não vou falar dele."
                                                                },
                                                                {
                                                                    "id": "740670427",
                                                                    "speaker": "Clynes",
                                                                    "text": "Enfim, não tinha praticamente nada que eu pudesse fazer. Mas a vida na Fortaleza é simples e quaisquer problemas que aparecem são fáceis de resolver."
                                                                },
                                                                {
                                                                    "id": "740670428",
                                                                    "speaker": "Clynes",
                                                                    "text": "Mesmo se um grande problema aparecer, não é como se fosse eu que tivesse que resolver. Então, estou muito contente com minha vida agora. É só que eu gosto de ter alguém para lembrar os velhos tempos de vez em quando.",
                                                                    "choices": [
                                                                        {
                                                                            "id": "740670429",
                                                                            "text": "É compreensível.",
                                                                            "response": [
                                                                                {
                                                                                    "id": "740670431",
                                                                                    "speaker": "Clynes",
                                                                                    "text": "Foi legal conversar com vocês hoje, então obrigado. Deixa eu te dar esses Cupons Especiais. Vocês podem pensar como uma rodada paga por mim na Loja Osso Duro de Roer."
                                                                                },
                                                                                {
                                                                                    "id": "740670432",
                                                                                    "speaker": "Clynes",
                                                                                    "text": "#Saúde, senhor{F#ita} e mocinha também. Sorriam e que tenham um ótimo dia."
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "740670430",
                                                                            "text": "Respeito sua decisão."
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "740670419",
                                                            "text": "Você não devia julgar os outros tão casualmente.",
                                                            "response": [
                                                                {
                                                                    "id": "740670420",
                                                                    "speaker": "Clynes",
                                                                    "text": "É, verdade. Hehe, agora que você falou, eu não conheço ela tão bem assim, então quem sabe o que ela pensa."
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "740670412",
                                            "text": "Não."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "740670404",
                            "text": "Por que você apostaria em si?",
                            "response": [
                                {
                                    "id": "740670405",
                                    "speaker": "Clynes",
                                    "text": "Boa pergunta, mas uma fácil de responder... Porque ninguém aqui estava disposto a fazer uma aposta tão chata comigo."
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}