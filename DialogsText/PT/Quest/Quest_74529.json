        },
        {
            "id": "7452904",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "745290401",
                    "speaker": "Citlali",
                    "text": "#Oh, bom. Você está aqui, {NICKNAME}.",
                    "choices": [
                        {
                            "id": "745290402",
                            "text": "Há quanto tempo, Citlali.",
                            "response": [
                                {
                                    "id": "745290404",
                                    "speaker": "Citlali",
                                    "text": "Oh, por favor, eu saio para caminhar de vez em quando."
                                },
                                {
                                    "id": "745290405",
                                    "speaker": "Citlali",
                                    "text": "E de qualquer forma, minhas adivinhações de ontem à noite previram que coisas boas aconteceriam comigo se eu saísse de casa hoje."
                                },
                                {
                                    "id": "745290406",
                                    "speaker": "Citlali",
                                    "text": "Se isso não bate com o que adivinhei, não sei o que mais seria.",
                                    "choices": [
                                        {
                                            "id": "745290407",
                                            "text": "Vamos deixar essa sua adivinhação em dobro!",
                                            "response": [
                                                {
                                                    "id": "745290409",
                                                    "speaker": "Citlali",
                                                    "text": "Bem, não é que você não possa... é só que... eu virei a noite dois dias atrás para terminar o volume mais recente de uma Light Novel!"
                                                },
                                                {
                                                    "id": "745290410",
                                                    "speaker": "Citlali",
                                                    "text": "Então, olha aqui pra mim rapidinho. Eu tô com uma cara boa? As olheiras já devem ter desaparecido, né?",
                                                    "choices": [
                                                        {
                                                            "id": "745290411",
                                                            "text": "Estão como sempre.",
                                                            "response": [
                                                                {
                                                                    "id": "745290413",
                                                                    "speaker": "Citlali",
                                                                    "text": "Sério? Não tente me enganar!"
                                                                },
                                                                {
                                                                    "id": "745290414",
                                                                    "speaker": "Citlali",
                                                                    "text": "Só pra deixar claro, eu vou ficar com todas que não saírem boas. Você só vai ficar com o que presta!"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "745290412",
                                                            "text": "Você está radiante como sempre!"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "745290408",
                                            "text": "Posso tirar uma foto sua?"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "745290403",
                            "text": "E que surpresa, você não está dormindo."
                        }
                    ]
                }
            ]
        }
    ]
