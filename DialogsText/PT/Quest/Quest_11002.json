                                },
                                {
                                    "id": "110020705",
                                    "speaker": "Paimon",
                                    "text": "Sim, agora que você mencionou, falta realmente um pouco de \"bum shaka-laka\"!",
                                    "choices": [
                                        {
                                            "id": "110020706",
                                            "text": "\"Bum\"?",
                                            "response": [
