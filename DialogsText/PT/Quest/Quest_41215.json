            "dialogues": [
                {
                    "id": "412100301",
                    "speaker": "Paimon",
                    "text": "Albedo...!"
                },
                {
                    "id": "412100302",
                    "speaker": "Player",
                    "text": "Oi, somos nós!"
                },
                {
                    "id": "412100303",
                    "speaker": "Albedo",
                    "text": "Hmm? Vocês de novo?"
                },
                {
                    "id": "412100304",
                    "speaker": "Albedo",
                    "text": "Vocês se perderam no caminho?"
                },
                {
                    "id": "412100305",
                    "speaker": "Paimon",
                    "text": "Não, não é isso!",
                    "choices": [
                        {
                            "id": "412100306",
                            "text": "Aceitamos o pedido da Sucrose para investigar os seus segredos.",
                            "response": [
                                {
                                    "id": "412100308",
                                    "speaker": "Albedo",
                                    "text": "Segredos?"
                                },
                                {
                                    "id": "412100309",
                                    "speaker": "Paimon",
                                    "text": "Ei!! O que você está fazendo?"
                                },
                                {
                                    "id": "412100310",
                                    "speaker": "Paimon",
                                    "text": "É uma investigação secreta! Você não devia ter falado!"
                                },
                                {
                                    "id": "412100311",
                                    "speaker": "Player",
                                    "text": "Mas de qualquer forma Albedo ia saber."
                                },
                                {
                                    "id": "412100312",
                                    "speaker": "Paimon",
                                    "text": "Uh... Mas... Mas..."
                                },
                                {
                                    "id": "412100313",
                                    "speaker": "Albedo",
                                    "text": "Você chegou na hora certa, Viajante, preciso de sua ajuda com algo."
                                },
                                {
                                    "id": "412100314",
                                    "speaker": "Albedo",
                                    "text": "Pegue!"
                                },
                                {
                                    "id": "412100315",
                                    "speaker": "Paimon",
                                    "text": "Hum? O que é isto?"
                                },
                                {
                                    "id": "412100316",
                                    "speaker": "Albedo",
                                    "text": "Como você vê, é uma espada.",
                                    "choices": [
                                        {
                                            "id": "412100317",
                                            "text": "Você sabe forjar?",
                                            "response": [
                                                {
                                                    "id": "412100319",
                                                    "speaker": "Albedo",
                                                    "text": "Não fui eu que fiz essa espada, mas apliquei alquimia nela."
                                                },
                                                {
                                                    "id": "412100320",
                                                    "speaker": "Albedo",
                                                    "text": "Quer experimentar?"
                                                },
                                                {
                                                    "id": "412100321",
                                                    "speaker": "Player",
                                                    "text": "Ah? Eu?"
                                                },
                                                {
                                                    "id": "412100322",
                                                    "speaker": "Albedo",
                                                    "text": "Minha pesquisa indica que esta espada tem algumas... Propriedades únicas. Só você pode usá-la."
                                                },
                                                {
                                                    "id": "412100323",
                                                    "speaker": "Albedo",
                                                    "text": "Mas preciso coletar dados com bastante urgência - então, poderia usá-la em uma batalha?"
                                                },
                                                {
                                                    "id": "412100324",
                                                    "speaker": "Paimon",
                                                    "text": "Espere um segundo. Por que apenas uma única pessoa pode usar essa espada?"
                                                },
                                                {
                                                    "id": "412100325",
                                                    "speaker": "Player",
                                                    "text": "Será que tem alguns efeitos colaterais?"
                                                },
                                                {
                                                    "id": "412100326",
                                                    "speaker": "Albedo",
                                                    "text": "Boa observação! Essa espada é muito especial, pois é uma espada amaldiçoada."
                                                },
                                                {
                                                    "id": "412100327",
                                                    "speaker": "Albedo",
                                                    "text": "Nenhum humano comum consegue usá-la, mas você é um caso excepcional."
                                                },
                                                {
                                                    "id": "412100328",
                                                    "speaker": "Paimon",
                                                    "text": "Hmm...?"
                                                },
                                                {
                                                    "id": "412100329",
                                                    "speaker": "Albedo",
                                                    "text": "Digamos assim, apenas você é imune à maldição dessa espada. Portanto, só você pode me ajudar."
                                                },
                                                {
                                                    "id": "412100330",
                                                    "speaker": "Albedo",
                                                    "text": "Sem mais delongas, procure uns monstros aqui perto. Algumas coisas se aprendem apenas com prática."
                                                }
                                            ]
                                        },
                                        {
                                            "id": "412100318",
                                            "text": "Um alquimista também faz trabalho de ferreiro?"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "412100307",
                            "text": "Sucrose diz que você tem grandes segredos."
                        }
                    ]
                }
            ]
        }
    ]
}