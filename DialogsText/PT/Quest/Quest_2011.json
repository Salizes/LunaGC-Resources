    "talks": [
        {
            "id": "201101",
            "objective": "Pergunte a Katheryne sobre a situação de Inazuma",
            "dialogues": [
                {
                    "id": "20110101",
                    "speaker": "Katheryne",
                    "text": "Ad astra abyssosque! O que posso fazer por você, Viajante?",
                    "choices": [
                        {
                            "id": "20110102",
                            "text": "Sobre a viagem para Inazuma...",
                            "response": [
                                {
                                    "id": "20110104",
                                    "speaker": "Katheryne",
                                    "text": "#Sim, eu já ouvi dizer que a Capitã da Frota Crux já prometeu a vocês para levá-l{M#os}{F#as} para Inazuma, certo?"
                                },
                                {
                                    "id": "20110105",
                                    "speaker": "Katheryne",
                                    "text": "Na verdade, já faz muito tempo que não vou até lá, e não tenho informações aqui que seriam úteis para você..."
                                },
                                {
                                    "id": "20110106",
                                    "speaker": "Dragão do Oceano",
                                    "text": "#Finalmente te encontrei! Você é {M#o}{F#a} Viajante de que a Capitã se orgulha?",
                                    "choices": [
                                        {
                                            "id": "20110107",
                                            "text": "Já ficamos esperando por muito tempo!",
                                            "response": [
                                                {
                                                    "id": "20110108",
                                                    "speaker": "Dragão do Oceano",
                                                    "text": "Hehe, me sinto muito honrado."
                                                },
                                                {
                                                    "id": "20110110",
                                                    "speaker": "Dragão do Oceano",
                                                    "text": "Estamos terminando os preparativos de suprimentos. Assim que as equipes fizerem a contagem, podemos prosseguir."
                                                },
                                                {
                                                    "id": "20110111",
                                                    "speaker": "Dragão do Oceano",
                                                    "text": "A Capitã me mandou para te procurar. Assim que você chegar, vamos partir."
                                                },
                                                {
                                                    "id": "20110112",
                                                    "speaker": "Paimon",
                                                    "text": "Beidou realmente sempre mantém a sua palavra."
                                                },
                                                {
                                                    "id": "20110113",
                                                    "speaker": "Dragão do Oceano",
                                                    "text": "Claro! Há muitas coisas que a Capitã é insistente, tenho certeza que verá pessoalmente quando estiver a bordo."
                                                },
                                                {
                                                    "id": "20110114",
                                                    "speaker": "Katheryne",
                                                    "text": "Então agora vocês estão prestes a ir para Inazuma? Espero que vocês tenham uma boa viagem!"
                                                },
                                                {
                                                    "id": "20110115",
                                                    "speaker": "Katheryne",
                                                    "text": "Não importa se a jornada à frente leva para os altos céus ou ao abismo profundo. Cada novo passo é uma nova conquista."
                                                },
                                                {
                                                    "id": "20110116",
                                                    "speaker": "Katheryne",
                                                    "text": "Então, nos veremos no futuro! Boa viagem, Viajante. Ad astra abyssosque!",
                                                    "choices": [
                                                        {
                                                            "id": "20110117",
                                                            "text": "Katheryne...",
                                                            "response": [
                                                                {
                                                                    "id": "20110119",
                                                                    "speaker": "Paimon",
                                                                    "text": "Oh... É meio difícil dizer adeus agora... Nós praticamente nos vemos todos os dias."
                                                                },
                                                                {
                                                                    "id": "20110120",
                                                                    "speaker": "Katheryne",
                                                                    "text": "Sendo assim, vocês me procuram assim que chegarem em Inazuma? Esperarei por vocês na Ilha Narukami.",
                                                                    "choices": [
                                                                        {
                                                                            "id": "20110121",
                                                                            "text": "...",
                                                                            "response": [
                                                                                {
                                                                                    "id": "20110123",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "Então realmente há outra Katheryne em Inazuma! Veja, não há necessidade de ficar tão sentimental aqui..."
                                                                                },
                                                                                {
                                                                                    "id": "20110124",
                                                                                    "speaker": "Dragão do Oceano",
                                                                                    "text": "Haha, bem, acho que é hora de vocês se despedirem do Porto de Liyue. Agora que entreguei minha mensagem, vou indo, já que o navio ainda está ancorado na Floresta de Pedra Guyun."
                                                                                },
                                                                                {
                                                                                    "id": "20110125",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "Ok, obrigada por ter vindo até aqui para nos avisar!"
                                                                                },
                                                                                {
                                                                                    "id": "20110126",
                                                                                    "speaker": "Dragão do Oceano",
                                                                                    "text": "Apenas cumprindo ordens. Até logo no Alcor."
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "20110122",
                                                                            "text": "... Eu já sabia!"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "20110118",
                                                            "text": "Vamos sentir a sua falta!"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "20110109",
                                            "text": "Quer dizer que as informações estão batendo a porta?"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "20110103",
                            "text": "Sobre a Frota Crux"
                        }
                    ]
                }
            ]
        },
        {
            "id": "201102",
            "objective": "Embarque no Alcor e procure por Beidou",
            "dialogues": []
        },
        {
            "id": "201103",
            "objective": "Fale com Beidou",
            "dialogues": [
                {
                    "id": "20110301",
                    "speaker": "Beidou",
                    "text": "Aha! Vocês finalmente chegaram!"
                },
                {
                    "id": "20110302",
                    "speaker": "Beidou",
                    "text": "Todos esses anos, faça chuva ou tempestade, a Frota Crux nunca sofreu um atraso. Se fosse qualquer outra pessoa, eu já poderia ter zarpado.",
                    "choices": [
                        {
                            "id": "20110303",
                            "text": "Minha culpa, Capitã!",
                            "response": [
                                {
                                    "id": "20110305",
                                    "speaker": "Beidou",
                                    "text": "#Hahaha, não fique tão séri{F#a}{M#o}, só estou brincando. Você chegou bem na hora, a tripulação acabou de fazer os preparativos finais."
                                },
                                {
                                    "id": "20110306",
                                    "speaker": "Beidou",
                                    "text": "Agora que todos estão aqui..."
                                },
                                {
                                    "id": "20110307",
                                    "speaker": "Beidou",
                                    "text": "Partimos para a terra engolida por tempestades e tormentas... A nação da \"eternidade\"!"
                                },
                                {
                                    "id": "20110308",
                                    "speaker": "Paimon",
                                    "text": "Vamos!"
                                }
                            ]
                        },
                        {
                            "id": "20110304",
                            "text": "É uma honra estar a bordo!"
                        }
                    ]
                }
            ]
        },
        {
            "id": "201104",
            "objective": "Vá para Inazuma",
            "dialogues": []
        },
        {
            "id": "201105",
            "objective": "Vá para Inazuma",
            "dialogues": []
        },
        {
            "id": "201106",
            "objective": "Vá para Inazuma",
            "dialogues": []
        },
        {
            "id": "201107",
            "objective": "Fale com Thoma",
            "dialogues": [
                {
                    "id": "20110701",
                    "speaker": "Thoma",
                    "text": "Então, você finalmente chegou. Você me deixou esperando por muito tempo, Capitã."
                },
                {
                    "id": "20110702",
                    "speaker": "Thoma",
                    "text": "#E parece que temos {F#algumas passageiras clandestinas}{M#alguns passageiros clandestinos}... Ou talvez deva dizer - convidad{F#as}{M#os} de honra."
                },
                {
                    "id": "20110703",
                    "speaker": "Paimon",
                    "text": "Shhhhh!"
                },
                {
                    "id": "20110704",
                    "speaker": "Beidou",
                    "text": "Você pode culpar sua Shogun toda-poderosa. As tempestades ao redor de Inazuma têm se tornado ainda mais violentas ultimamente."
                },
                {
                    "id": "20110705",
                    "speaker": "Beidou",
                    "text": "Embora a frota estivesse totalmente pronta para enfrentar desafios, o mau tempo nos atrapalhou."
                },
                {
                    "id": "20110706",
                    "speaker": "Beidou",
                    "text": "Agora então, deixe-me apresentar a todos. Este é Thoma, um parceiro comercial que conheci recentemente."
                },
                {
                    "id": "20110707",
                    "speaker": "Thoma",
                    "text": "#Heh, você não sabe há quanto tempo estou esperando para vê-l{F#as}{M#os}."
                },
                {
                    "id": "20110708",
                    "speaker": "Beidou",
                    "text": "#Thoma, {M#estes dois}{F#estas duas} são...?"
                },
                {
                    "id": "20110709",
                    "speaker": "Thoma",
                    "text": "Não há necessidade de apresentações, sua reputação já diz tudo. Parece que até os mares tempestuosos não conseguem manter os rumores sobre os seus feitos.",
                    "choices": [
                        {
                            "id": "20110710",
                            "text": "Olá, Thoma!",
                            "response": [
                                {
                                    "id": "20110712",
                                    "speaker": "Paimon",
                                    "text": "Hehe, com certeza é bom ouvir você dizer isso~"
                                },
                                {
                                    "id": "20110713",
                                    "speaker": "Beidou",
                                    "text": "Ha, isso seria mais conveniente."
                                },
                                {
                                    "id": "20110714",
                                    "speaker": "Beidou",
                                    "text": "#{NICKNAME}, Thoma está morando em Ritou há algum tempo. Não seria exagero dizer que ele é o Mediador deste lugar."
                                },
                                {
                                    "id": "20110715",
                                    "speaker": "Beidou",
                                    "text": "Se você tiver algum problema aqui, fale com Thoma. Mas se ele tentar mexer com você, eu vou dar uma lição a ele pessoalmente na próxima vez que vier para cá."
                                },
                                {
                                    "id": "20110716",
                                    "speaker": "Thoma",
                                    "text": "Hehehe, não precisa se preocupar. Tenho certeza que nos daremos muito bem."
                                },
                                {
                                    "id": "20110717",
                                    "speaker": "Beidou",
                                    "text": "Bom. Então, se tudo estiver resolvido, vou embora. Eu não gostaria de ser pega com minhas velas aqui embaixo, afinal, tenho um fugitivo procurado a bordo."
                                },
                                {
                                    "id": "20110718",
                                    "speaker": "Paimon",
                                    "text": "Oh, você se refere a Kazuha?"
                                },
                                {
                                    "id": "20110719",
                                    "speaker": "Beidou",
                                    "text": "Até a próxima, Viajante. Lembre-se de dar o melhor de si, independentemente das perigosas \"tempestades\" que possa encontrar.",
                                    "choices": [
                                        {
                                            "id": "20110720",
                                            "text": "Tenho essa confiança.",
                                            "response": [
                                                {
                                                    "id": "20110722",
                                                    "speaker": "Paimon",
                                                    "text": "Boa viagem, Capitã Beidou! Tchau tchau!"
                                                },
                                                {
                                                    "id": "20110723",
                                                    "speaker": "Thoma",
                                                    "text": "Então, primeiramente, precisamos nos registrar no posto de controle de fronteira."
                                                },
                                                {
                                                    "id": "20110724",
                                                    "speaker": "Paimon",
                                                    "text": "Hum, Paimon achou que deveríamos manter as coisas em segredo... Vamos cair nas mãos do governo?"
                                                },
                                                {
                                                    "id": "20110725",
                                                    "speaker": "Thoma",
                                                    "text": "Haha, não subestime os alcances do Decreto Sakoku. Você não seria capaz de evitar a inspeção, mesmo se tentasse."
                                                },
                                                {
                                                    "id": "20110726",
                                                    "speaker": "Thoma",
                                                    "text": "Portanto, temos que seguir as regras... Mesmo que elas não sejam razoáveis.",
                                                    "choices": [
                                                        {
                                                            "id": "20110727",
                                                            "text": "Sim, está bem."
                                                        },
                                                        {
                                                            "id": "20110728",
                                                            "text": "#Agora estou um pouco nervos{F#a}{M#o}."
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "20110721",
                                            "text": "Espero ver você de novo!"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "20110711",
                            "text": "Com certeza os rumores são exagerados."
                        }
                    ]
                }
            ]
        }
    ]
