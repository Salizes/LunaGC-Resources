        {
            "id": "1100003",
            "objective": "Fale com a Xiangling",
            "dialogues": [
                {
                    "id": "110000301",
                    "speaker": "???",
                    "text": "Shhh! Fale mais baixo, eu estou caçando..."
                },
                {
                    "id": "110000302",
                    "speaker": "???",
                    "text": "Eu sempre ouvi falar da quantidade de ingredientes que você consegue encontrar em Mondstadt. Vamos ver se é verdade!",
                    "choices": [
                        {
                            "id": "110000303",
                            "text": "Você é uma caçadora?",
                            "response": [
                                {
                                    "id": "110000305",
                                    "speaker": "???",
                                    "text": "Não - Eu sou uma chef! Uma chef em uma missão para encontrar ingredientes raros e exóticos em todos os cantos do mundo!"
                                },
                                {
                                    "id": "110000306",
                                    "speaker": "Xiangling",
                                    "text": "Meu nome é Xiangling. Eu sou do Porto de Liyue, e você?"
                                },
                                {
                                    "id": "110000307",
                                    "speaker": "Player",
                                    "text": "#Eu me chamo {NICKNAME}."
                                },
                                {
                                    "id": "110000308",
                                    "speaker": "Paimon",
                                    "text": "Olá, meu nome é Paimon!"
                                },
                                {
                                    "id": "110000309",
                                    "speaker": "Xiangling",
                                    "text": "Paimon!"
                                },
                                {
                                    "id": "110000310",
                                    "speaker": "Paimon",
                                    "text": "Por que você está me olhando assim?"
                                },
                                {
                                    "id": "110000311",
                                    "speaker": "Xiangling",
                                    "text": "Que criatura exótica! Ela é comestível?",
                                    "choices": [
                                        {
                                            "id": "110000312",
                                            "text": "Ela é minha amiga.",
                                            "response": [
                                                {
                                                    "id": "110000313",
                                                    "speaker": "Xiangling",
                                                    "text": "Que pena, não tenho permissão para comer amigos de outras pessoas."
                                                },
                                                {
                                                    "id": "110000316",
                                                    "speaker": "Xiangling",
                                                    "text": "#Vocês parecem ser {F#boas amigas}{M#bons amigos}. Eu também tenho um bom amigo chamado Guoba."
                                                },
                                                {
                                                    "id": "110000317",
                                                    "speaker": "Paimon",
                                                    "text": "... Isso não é o nome de um salgado de Liyue?"
                                                },
                                                {
                                                    "id": "110000318",
                                                    "speaker": "Xiangling",
                                                    "text": "Hehe... Ambos o salgado e o meu amigo estão em um lugar especial no meu coração."
                                                },
                                                {
                                                    "id": "110000319",
                                                    "speaker": "Xiangling",
                                                    "text": "Enfim, você pode caçar algo para mim?"
                                                },
                                                {
                                                    "id": "110000320",
                                                    "speaker": "Xiangling",
                                                    "text": "Há muitas coisas por aqui que podem ser usados para cozinhar."
                                                },
                                                {
                                                    "id": "110000321",
                                                    "speaker": "Xiangling",
                                                    "text": "Eu não consigo capturar sozinha, mas também não queria perder a oportunidade!"
                                                },
                                                {
                                                    "id": "110000322",
                                                    "speaker": "Paimon",
                                                    "text": "Parece muito complicado..."
                                                },
                                                {
                                                    "id": "110000323",
                                                    "speaker": "Xiangling",
                                                    "text": "Não fique assim... Vamos lá, vou preparar algo gostoso para você mais tarde."
                                                },
                                                {
                                                    "id": "110000324",
                                                    "speaker": "Paimon",
                                                    "text": "#Algo delicioso? Combinado! {NICKNAME} é muito {M#bom}{F#boa} nisso!",
                                                    "choices": [
                                                        {
                                                            "id": "110000325",
                                                            "text": "De qual lado você está!?",
                                                            "response": [
                                                                {
                                                                    "id": "110000327",
                                                                    "speaker": "Xiangling",
                                                                    "text": "#Hehe, não se preocupe com isso, {F#sua amiga}{M#seu amigo} já me respondeu."
                                                                },
                                                                {
                                                                    "id": "110000328",
                                                                    "speaker": "Xiangling",
                                                                    "text": "Eu não me importo como seja feito, desde que você me traga um pouco de carne crua."
                                                                },
                                                                {
                                                                    "id": "110000329",
                                                                    "speaker": "Xiangling",
                                                                    "text": "Ótimo, então eu vou deixar com você."
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "110000326",
                                                            "text": "Você podia ter me perguntado primeiro..."
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "110000314",
                                            "text": "Claro que sim.",
                                            "response": [
                                                {
                                                    "id": "110000315",
                                                    "speaker": "Paimon",
                                                    "text": "Não, pela última vez! A Paimon não é uma comida de emergência!"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "110000304",
                            "text": "Você é uma Aventureira?"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1100004",
            "objective": "Ajude a Xiangling a coletar Carne Crua",
            "dialogues": [
                {
                    "id": "110000401",
                    "speaker": "Xiangling",
                    "text": "Esses javalis parecem saudáveis e ativos também. Eu aposto que a carne é de boa qualidade!"
                },
                {
                    "id": "110000402",
                    "speaker": "Xiangling",
                    "text": "Ugh, só de pensar já está me deixando com fome..."
                }
            ]
        },
        {
            "id": "1100005",
            "objective": "Entregue três pedaços de Carne Crua para Xiangling",
            "dialogues": [
                {
                    "id": "110000501",
                    "speaker": "Xiangling",
                    "text": "Uau! Isso é ótimo, algumas partes vou fritar, outras vou fritar com cogumelos, e eu me pergunto o quão bom isso vai ficar com Slime condensado...",
                    "choices": [
                        {
                            "id": "110000502",
                            "text": "Parece que ela está em seu próprio mundo...",
                            "response": [
                                {
                                    "id": "110000503",
                                    "speaker": "Paimon",
                                    "text": "Eu acho que ela se esqueceu de nós..."
                                },
                                {
                                    "id": "110000506",
                                    "speaker": "Xiangling",
                                    "text": "Ahhh, desculpe! Me empolguei de mais com as novas receitas."
                                },
                                {
                                    "id": "110000507",
                                    "speaker": "Xiangling",
                                    "text": "Como prometido, um aperitivo saboroso! Experimente, e me diga o que você achou!"
                                },
                                {
                                    "id": "110000508",
                                    "speaker": "Paimon",
                                    "text": "#Somos {M#seus}{F#suas} degustador{M#es}{F#as} de comida agora?"
                                },
                                {
                                    "id": "110000509",
                                    "speaker": "Paimon",
                                    "text": "Oh... Isso é delicioso!"
                                },
                                {
                                    "id": "110000510",
                                    "speaker": "Paimon",
                                    "text": "Você pode nos contar como é feito?"
                                },
                                {
                                    "id": "110000511",
                                    "speaker": "Xiangling",
                                    "text": "Haha, claro! O único problema é que eu ainda não anotei a receita..."
                                },
                                {
                                    "id": "110000512",
                                    "speaker": "Xiangling",
                                    "text": "Entendi! Então vamos fazer outro para que você possa ver. Tenho certeza de que você vai aprender rapidinho."
                                },
                                {
                                    "id": "110000513",
                                    "speaker": "Paimon",
                                    "text": "Este prato é bastante complicado, vai ser mais difícil do que o esperado. E também não temos uma frigideira ou quaisquer condimentos."
                                },
                                {
                                    "id": "110000514",
                                    "speaker": "Xiangling",
                                    "text": "Vamos lá, é simples!"
                                },
                                {
                                    "id": "110000515",
                                    "speaker": "Xiangling",
                                    "text": "Podemos fritar em uma pedra e cozinhar usando um pouco de gordura de javali. Construa um fogão com pedras, capim seco para o fogo, use galhos como lenha..."
                                },
                                {
                                    "id": "110000516",
                                    "speaker": "Xiangling",
                                    "text": "As Flores Doces servem como açúcar. Para o sal, eu encontrei uma pedra de sal em uma caverna outro dia, é o suficiente.",
                                    "choices": [
                                        {
                                            "id": "110000517",
                                            "text": "Parece que eu já vi isso um milhão de vezes...",
                                            "response": [
                                                {
                                                    "id": "110000519",
                                                    "speaker": "Xiangling",
                                                    "text": "Hehe, não consigo evitar quando há uma chance de tentar algo novo. Mas também não posso trazer toda a minha cozinha toda vez que saio de casa."
                                                },
                                                {
                                                    "id": "110000520",
                                                    "speaker": "Xiangling",
                                                    "text": "Espere um pouco, vou me preparar."
                                                },
                                                {
                                                    "id": "110000521",
                                                    "speaker": "Allan",
                                                    "text": "Ei! O que vocês estão fazendo?"
                                                },
                                                {
                                                    "id": "110000601",
                                                    "speaker": "Allan",
                                                    "text": "Este é o habitat natural dos javalis. Você não pode caçá-los aqui. Você vai acabar afugentando todos."
                                                },
                                                {
                                                    "id": "110000602",
                                                    "speaker": "Allan",
                                                    "text": "Nós caçadores sabemos melhor do que matar a galinha para conseguir chegar ao ovo."
                                                },
                                                {
                                                    "id": "110000603",
                                                    "speaker": "Xiangling",
                                                    "text": "Ah sim, entendi!"
                                                },
                                                {
                                                    "id": "110000604",
                                                    "speaker": "Xiangling",
                                                    "text": "A carne mais fresca e de melhor qualidade vem de javalis livres que crescem no ambiente que a natureza pretendeu para eles! Se todos fugissem..."
                                                },
                                                {
                                                    "id": "110000605",
                                                    "speaker": "Xiangling",
                                                    "text": "Não, vai ser uma grande perda para gastronomia... Ah não, para todos os seres humanos.",
                                                    "choices": [
                                                        {
                                                            "id": "110000606",
                                                            "text": "Isso... Bem, é uma forma de entender as coisas.",
                                                            "response": [
                                                                {
                                                                    "id": "110000608",
                                                                    "speaker": "Xiangling",
                                                                    "text": "Desculpe, eu não tinha ideia de que isso poderia causar um grande problema."
                                                                },
                                                                {
                                                                    "id": "110000609",
                                                                    "speaker": "Allan",
                                                                    "text": "*Suspiro* Você devia pedir desculpas ao Draff."
                                                                },
                                                                {
                                                                    "id": "110000610",
                                                                    "speaker": "Allan",
                                                                    "text": "Como nosso líder, ele sempre enfatizou a importância de respeitar as regras das caças. Temo que ele esteja muito triste agora.",
                                                                    "choices": [
                                                                        {
                                                                            "id": "110000611",
                                                                            "text": "O que vamos fazer agora?",
                                                                            "response": [
                                                                                {
                                                                                    "id": "110000613",
                                                                                    "speaker": "Xiangling",
                                                                                    "text": "Eu cometi um erro, e devo pedir desculpas."
                                                                                },
                                                                                {
                                                                                    "id": "110000614",
                                                                                    "speaker": "Player",
                                                                                    "text": "Deixe-nos lhe acompanhar."
                                                                                },
                                                                                {
                                                                                    "id": "110000615",
                                                                                    "speaker": "Xiangling",
                                                                                    "text": "Hehehe, obrigada pessoal. Irei cozinhar mais alguns salgadinhos saborosos para vocês quando isso acabar."
                                                                                },
                                                                                {
                                                                                    "id": "110000616",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "Está bem. Não se preocupe, eu vou me lembrar, mesmo que você se esqueça."
                                                                                },
                                                                                {
                                                                                    "id": "110000617",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "O Draff deve estar no Vale Termal, vamos!"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "110000612",
                                                                            "text": "Acho que o caçador tem razão."
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "110000607",
                                                            "text": "Isso não é bem o que ele quis dizer."
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "110000518",
                                            "text": "#Estou cansad{F#a}{M#o} de ouvir!"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "110000504",
                            "text": "Eu quero experimentar o condensado de Slime!",
                            "response": [
                                {
                                    "id": "110000505",
                                    "speaker": "Paimon",
                                    "text": "#Hehe, {NICKNAME}, você finalmente entendeu minhas preferências culinárias."
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
