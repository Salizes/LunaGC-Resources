    "talks": [
        {
            "id": "101401",
            "objective": "Fale com a Madame Ping",
            "dialogues": [
                {
                    "id": "10140101",
                    "speaker": "Madame Ping",
                    "text": "Todas as coisas vão mudando...",
                    "choices": [
                        {
                            "id": "10140102",
                            "text": "Olá.",
                            "response": [
                                {
                                    "id": "10140103",
                                    "speaker": "Madame Ping",
                                    "text": "Hum? Jovem, você veio aqui admirar as flores?"
                                },
                                {
                                    "id": "10140104",
                                    "speaker": "Madame Ping",
                                    "text": "Que pena! Você veio em um momento em que quase todas as flores de Lírios-de-Vidro murcharam..."
                                },
                                {
                                    "id": "10140107",
                                    "speaker": "Paimon",
                                    "text": "O que aconteceu com eles?"
                                },
                                {
                                    "id": "10140108",
                                    "speaker": "Madame Ping",
                                    "text": "Na minha época, diziam que as flores de Lírio de Vidro entendiam as pessoas."
                                },
                                {
                                    "id": "10140109",
                                    "speaker": "Madame Ping",
                                    "text": "Se eles ouvissem sons agradáveis, como risos e cantos, eles ficariam contentes e floresceriam alegremente."
                                },
                                {
                                    "id": "10140110",
                                    "speaker": "Madame Ping",
                                    "text": "Caso contrário, se ouvissem sons desagradáveis, como, por exemplo, fofocas ou calúnias, eles murchariam rapidamente."
                                },
                                {
                                    "id": "10140111",
                                    "speaker": "Paimon",
                                    "text": "Então, isso significa que as flores também estão sentindo o que está acontecendo no Porto de Liyue."
                                },
                                {
                                    "id": "10140112",
                                    "speaker": "Madame Ping",
                                    "text": "Sim, os rumores sobre a morte de Rex Lapis não são pouca coisa. Eles estão em toda parte."
                                },
                                {
                                    "id": "10140113",
                                    "speaker": "Madame Ping",
                                    "text": "Alguns dizem que é uma conspiração dos Fatui. Outros dizem que os Qixing inventaram tudo, e outros ainda pensam que aquilo que está no fundo do mar está se libertando."
                                },
                                {
                                    "id": "10140114",
                                    "speaker": "Madame Ping",
                                    "text": "Este porto é como uma montanha de pavio seco. Uma faísca, e o fogo consumirá todos nós."
                                },
                                {
                                    "id": "10140115",
                                    "speaker": "Madame Ping",
                                    "text": "...Bem, não direi mais nada. Esta velha mulher está ficando velha demais e irritadiça... Você tinha algo a dizer, jovem?",
                                    "choices": [
                                        {
                                            "id": "10140116",
                                            "text": "Queríamos pedir emprestado o Sino Purificador.",
                                            "response": [
                                                {
                                                    "id": "10140117",
                                                    "speaker": "Madame Ping",
                                                    "text": "Ah, essa velha bugiganga... Eu me lembro de estar aqui comigo, mas eu envelheci. Não consigo me lembrar exatamente onde ela está."
                                                },
                                                {
                                                    "id": "10140118",
                                                    "speaker": "Madame Ping",
                                                    "text": "É uma coisinha que um velho amigo costumava usar quando eu era jovem."
                                                },
                                                {
                                                    "id": "10140119",
                                                    "speaker": "Madame Ping",
                                                    "text": "Ele me viu olhando para ele com muita frequência e me deu."
                                                },
                                                {
                                                    "id": "10140120",
                                                    "speaker": "Madame Ping",
                                                    "text": "Mas ele também me disse que se alguém viesse pegar o sino emprestado, eu não deveria ficar tão apegado."
                                                },
                                                {
                                                    "id": "10140127",
                                                    "speaker": "Madame Ping",
                                                    "text": "Já se passaram muitos anos, e quem sabe quantas vezes alguém veio pedir este sino emprestado."
                                                },
                                                {
                                                    "id": "10140128",
                                                    "speaker": "Madame Ping",
                                                    "text": "Mas, não me lembro quando começou, já faz tempo que ninguém vem pedir emprestado..."
                                                },
                                                {
                                                    "id": "10140129",
                                                    "speaker": "Madame Ping",
                                                    "text": "Ah, esses ossos velhos são tão lentos para procurar as coisas. Duvido que você possa esperar por tanto tempo...",
                                                    "choices": [
                                                        {
                                                            "id": "10140130",
                                                            "text": "#Podemos procurá-lo nós mesm{F#a}{M#o}s.",
                                                            "response": [
                                                                {
                                                                    "id": "10140131",
                                                                    "speaker": "Paimon",
                                                                    "text": "Sim! Vovó, vamos acompanhá-la para casa, e depois procuramos."
                                                                },
                                                                {
                                                                    "id": "10140132",
                                                                    "speaker": "Paimon",
                                                                    "text": "E... também podemos ajudar a organizar tudo isso!"
                                                                },
                                                                {
                                                                    "id": "10140135",
                                                                    "speaker": "Madame Ping",
                                                                    "text": "Está bom. Não se preocupem, filhos. O Sino não está longe, fiquem tranquilos."
                                                                },
                                                                {
                                                                    "id": "10140136",
                                                                    "speaker": "Paimon",
                                                                    "text": "Hã? Você vive por aqui? Uau, mas aqui é o Terraço de Yujing, deve ser bastante caro!"
                                                                },
                                                                {
                                                                    "id": "10140137",
                                                                    "speaker": "Madame Ping",
                                                                    "text": "Haha, uma senhora idosa como eu não pode se dar ao luxo de comprar um lugar nesta cidade. Vê este bule de cerâmica? Todas as minhas posses estão ali."
                                                                },
                                                                {
                                                                    "id": "10140138",
                                                                    "speaker": "Paimon",
                                                                    "text": "Todos os seus...",
                                                                    "choices": [
                                                                        {
                                                                            "id": "10140139",
                                                                            "text": "Você quer dizer que deixou as chaves de casa dentro?",
                                                                            "response": [
                                                                                {
                                                                                    "id": "10140146",
                                                                                    "speaker": "Madame Ping",
                                                                                    "text": "#Hehehe, jovens. Simplesmente quero dizer que o sino está em algum lugar dentro deste bule, e você é muito bem-vind{M#o}{F#a} a pedi-lo emprestado, se puder encontrá-lo."
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "10140140",
                                                                            "text": "Você só tem um sino?",
                                                                            "response": [
                                                                                {
                                                                                    "id": "10140141",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "Ei, isso foi rude!"
                                                                                },
                                                                                {
                                                                                    "id": "10140142",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "Hum... Mesmo assim, é um sino muito precioso, né?"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "10140143",
                                                                            "text": "Paimon, você pode entrar e ver?",
                                                                            "response": [
                                                                                {
                                                                                    "id": "10140144",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "O quê!? Besta! Não tem como a Paimon caber ali!"
                                                                                },
                                                                                {
                                                                                    "id": "10140145",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "Por que a Paimon? Por que não tiramos a tampa e vemos?"
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "10140133",
                                                            "text": "Aprendi com a Grande Mestre dos Cavaleiros de Favonius.",
                                                            "response": [
                                                                {
                                                                    "id": "10140134",
                                                                    "speaker": "Paimon",
                                                                    "text": "Que coisa estranha de se ter orgulho..."
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "10140121",
                                            "text": "Gostaríamos de pedir emprestado algo de você...",
                                            "response": [
                                                {
                                                    "id": "10140122",
                                                    "speaker": "Madame Ping",
                                                    "text": "Pedir emprestado? Vocês vieram para o Sino Purificador?"
                                                },
                                                {
                                                    "id": "10140123",
                                                    "speaker": "Madame Ping",
                                                    "text": "Não tenho nada para emprestar para vocês jovens a não ser esta coisa antiga."
                                                },
                                                {
                                                    "id": "10140124",
                                                    "speaker": "Madame Ping",
                                                    "text": "Mas, originalmente, também não era meu. Antigamente pertencia a um amigo meu."
                                                },
                                                {
                                                    "id": "10140125",
                                                    "speaker": "Madame Ping",
                                                    "text": "Eu era uma garota linda e vaidosa quando era jovem e incomodava ele por aquele sino o tempo todo..."
                                                },
                                                {
                                                    "id": "10140126",
                                                    "speaker": "Madame Ping",
                                                    "text": "Ele não conseguiu me desencorajar, e assim ele acabou me dando. Mas ele disse que se alguém viesse pedi-lo emprestado, eu não deveria ser relutante em entregá-lo."
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "10140105",
                            "text": "Você está bem?",
                            "response": [
                                {
                                    "id": "10140106",
                                    "speaker": "Madame Ping",
                                    "text": "Ah, não é nada, não é nada... Eu apenas acho uma pena que muitos desses Lírios-de-Vidro murcharam."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
