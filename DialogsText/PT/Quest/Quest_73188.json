            "objective": "Additional",
            "dialogues": [
                {
                    "id": "731880701",
                    "speaker": "Aventureiro intrigado",
                    "text": "\"Esta experiência de reflexão é o maior tesouro.\""
                },
                {
                    "id": "731880702",
                    "speaker": "Aventureiro intrigado",
                    "text": "O que... O que é isso?"
                },
                {
                    "id": "731880703",
                    "speaker": "Aventureiro intrigado",
                    "text": "Hã? Tem um pouco de Mora aqui embaixo..."
