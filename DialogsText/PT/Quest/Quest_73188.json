        },
        {
            "id": "7318808",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "731880801",
                    "speaker": "Caixa com enigmas",
                    "text": "\"Explore os mares rasos com este ramo de sabedoria.\""
                }
            ]
        },
        {
            "id": "7318809",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "731880901",
                    "speaker": "Caixa com enigmas",
                    "text": "\"Uma planta inteligente que é usada para trocar gotas de água.\""
                }
            ]
        },
        {
            "id": "7318810",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "731881001",
                    "speaker": "Caixa com enigmas",
                    "text": "\"Onde o conhecimento retorna ao mar, o tesouro está nas velas.\""
                }
            ]
        },
        {
            "id": "7318811",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "731881101",
                    "speaker": "Placa com enigmas",
                    "text": "\"Acima da correnteza, abaixo da copa das árvores.\""
                }
            ]
        },
        {
            "id": "7318812",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "731881201",
                    "speaker": "Placa com enigmas",
                    "text": "\"Os pensamentos fluem livremente, e a sabedoria para na costa, ponderando.\""
                }
            ]
        },
        {
            "id": "7318813",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "731881301",
                    "speaker": "Placa com enigmas",
                    "text": "\"Um guarda-chuva verde contempla uma cortina de pérolas.\""
                }
            ]
        }
