        },
        {
            "id": "7613608",
            "objective": "",
            "dialogues": [
                {
                    "id": "761360301",
                    "speaker": "Player",
                    "text": "(Talvez <color=#FFCC33FF>Jahoda</color> queira inspecionar o baú...)"
                },
                {
                    "id": "761360302",
                    "speaker": "Jahoda",
                    "text": "Hehehe... vamos ver quanto ganhamos."
                },
                {
                    "id": "761360303",
                    "speaker": "Jahoda",
                    "text": "Eu lembro da Chefe dizer que queria me dar um bônus. Que tal eu ajudar..."
                },
                {
                    "id": "761360304",
                    "speaker": "Jahoda",
                    "text": "Hã? Cadê o dinheiro? Só tem uma folha de papel aqui!"
                },
                {
                    "id": "761360305",
                    "speaker": "Jahoda",
                    "text": "\"Minha cara Jahoda, seu bônus não vem dessa caixa. Feche ela corretamente depois.\""
                },
                {
                    "id": "761360306",
                    "speaker": "Jahoda",
                    "text": "Pff, a chefe tá tentando me dar um susto de novo. Talvez tenha um compartimento escondido dentro dele..."
                },
                {
                    "id": "761360307",
                    "speaker": "Nefer",
                    "text": "Não tem compartimento secreto nenhum aí. Seu bônus está aqui."
                },
                {
                    "id": "761360308",
                    "speaker": "Jahoda",
                    "text": "Oh, obrigada, chefe. Eu..."
                },
                {
                    "id": "761360309",
                    "speaker": "Jahoda",
                    "text": "Ai, ai, ai, ai, ai! Aaaaai! Chefe! Eu tava só contando o caixa!"
                },
                {
                    "id": "761360310",
                    "speaker": "Jahoda",
                    "text": "Eu vou voltar pro trabalho agora mesmo!"
                },
                {
                    "id": "761360311",
                    "speaker": "Nefer",
                    "text": "Alto aí!"
                },
                {
                    "id": "761360312",
                    "speaker": "Jahoda",
                    "text": "Sim, Chefe!"
                },
                {
                    "id": "761360313",
                    "speaker": "Nefer",
                    "text": "Feche a caixa."
                },
                {
                    "id": "761360314",
                    "speaker": "Jahoda",
                    "text": "Sim, Chefe!"
                },
                {
                    "id": "761360315",
                    "speaker": "Nefer",
                    "text": "Agora você pode ir."
                },
                {
                    "id": "761360316",
                    "speaker": "Jahoda",
                    "text": "Sim, Chefe!"
                }
            ]
        },
