    "talks": [
        {
            "id": "7370701",
            "objective": "",
            "dialogues": [
                {
                    "id": "737050101",
                    "speaker": "Collei",
                    "text": "#{NICKNAME}, Paimon! Por aqui!"
                },
                {
                    "id": "737050102",
                    "speaker": "Collei",
                    "text": "Bem-vindo à base principal do \"Centro do Campo\"!"
                },
                {
                    "id": "737050103",
                    "speaker": "Collei",
                    "text": "Como pode ver, os projetos principais já estão em andamento, então podemos começar a trabalhar a qualquer momento!"
                },
                {
                    "id": "737050104",
                    "speaker": "Paimon",
                    "text": "Hmm... Isso parece... um daqueles lugares que os light novels mencionam. Sabe, os pontos de encontro de aventureiros onde os novatos se reúnem para pegar missões e tal?"
                },
                {
                    "id": "737050105",
                    "speaker": "Paimon",
                    "text": "Ah! E também quase como um festival escolar ao mesmo tempo, com todo mundo se juntando para aprender e depois formando equipes para aprimorar suas habilidades... Hehe, é tão empolgante!",
                    "choices": [
                        {
                            "id": "737050106",
                            "text": "#É, tô animad{M#o}{F#a}!",
                            "response": [
                                {
                                    "id": "737050108",
                                    "speaker": "Collei",
                                    "text": "Bem, esse lugar não é tão enfeitado quanto um festival escolar, mas o Mestre Tighnari disse que a Academia planeja ser generosa com os recursos."
                                },
                                {
                                    "id": "737050109",
                                    "speaker": "Collei",
                                    "text": "De qualquer forma, antes de estudantes e pesquisadores partirem em missões de campo perigosas, eles podem vir aqui para receber conselhos e treinamento de emergência..."
                                },
                                {
                                    "id": "737050110",
                                    "speaker": "Collei",
                                    "text": "Também temos profissionais na equipe que podem se juntar a eles para servir como guias ou pessoal de segurança."
                                },
                                {
                                    "id": "737050111",
                                    "speaker": "Amber",
                                    "text": "Sim, você pode pensar nisso como uma \"Base de Operações Avançada\" — partes iguais de treinamento teórico e prática de campo!"
                                },
                                {
                                    "id": "737050112",
                                    "speaker": "Amber",
                                    "text": "Vamos familiarizar os novos recrutas com os desafios potenciais na natureza e conduzi-los em exercícios para que não haja motivo para pânico na hora de encarar a realidade!"
                                },
                                {
                                    "id": "737050113",
                                    "speaker": "Paimon",
                                    "text": "Amber? Você também está aqui?",
                                    "choices": [
                                        {
                                            "id": "737050114",
                                            "text": "A Aventureira está ganhando novas responsabilidades?",
                                            "response": [
                                                {
                                                    "id": "737050116",
                                                    "speaker": "Amber",
                                                    "text": "#Hehe, surpres{M#o}{F#a}? Eu também fiquei!"
                                                },
                                                {
                                                    "id": "737050117",
                                                    "speaker": "Amber",
                                                    "text": "Estou de folga agora, então planejava só dar uma passada para ver a Collei..."
                                                },
                                                {
                                                    "id": "737050118",
                                                    "speaker": "Amber",
                                                    "text": "Mas não percebi o quão ocupada ela estaria! Eu não sou do tipo que fica só olhando. Então, decidi ser a assistente dela!"
                                                },
                                                {
                                                    "id": "737050119",
                                                    "speaker": "Collei",
                                                    "text": "Desculpe, Amber. Eu não queria te colocar para trabalhar durante a sua folga..."
                                                },
                                                {
                                                    "id": "737050120",
                                                    "speaker": "Amber",
                                                    "text": "Não se preocupe! Um pouco de descanso equilibrado com um trabalho gratificante é o que eu chamo de férias perfeitas! Além disso, aprendi um monte de coisas também!"
                                                },
                                                {
                                                    "id": "737050121",
                                                    "speaker": "Amber",
                                                    "text": "#E ainda pude ver {M#o}{F#a} {NICKNAME} e a Paimon de novo! Quer dizer, só fica cada vez melhor!"
                                                },
                                                {
                                                    "id": "737050122",
                                                    "speaker": "Amber",
                                                    "text": "Devemos fazer um grande banquete quando terminarmos aqui. O que acha?"
                                                },
                                                {
                                                    "id": "737050123",
                                                    "speaker": "Paimon",
                                                    "text": "Hehe, um banquete com a primeira amiga que fizemos em Sumeru e a primeira amiga que fizemos em toda a nossa jornada..."
                                                },
                                                {
                                                    "id": "737050124",
                                                    "speaker": "Paimon",
                                                    "text": "Isso soa quase tão incrível quanto um prato gigante de Carne Frita com Cenoura e Mel!",
                                                    "choices": [
                                                        {
                                                            "id": "737050125",
                                                            "text": "Bem, então vamos colocar o show na estrada.",
                                                            "response": [
                                                                {
                                                                    "id": "737050127",
                                                                    "speaker": "Amber",
                                                                    "text": "Certo! Vamos aos negócios, então..."
                                                                },
                                                                {
                                                                    "id": "737050128",
                                                                    "speaker": "Amber",
                                                                    "text": "Collei e eu estamos no comando do projeto \"Batedores Velozes\". O foco é usar dispositivos e máquinas para atravessar áreas perigosas, inspecionar o terreno e coletar detalhes sobre possíveis ameaças."
                                                                },
                                                                {
                                                                    "id": "737050129",
                                                                    "speaker": "Collei",
                                                                    "text": "Além disso, pesquisas da Amurta indicam que, durante situações perigosas, ter o apoio de um companheiro adorável pode ajudar a tranquilizar a mente dos aventureiros e evitar nervosismo em excesso..."
                                                                },
                                                                {
                                                                    "id": "737050130",
                                                                    "speaker": "Amber",
                                                                    "text": "Então, nos inspiramos em Cuilein-Anbar e no Barão Coelho para criar dois dispositivos de exploração que são, ao mesmo tempo, adoráveis e úteis — o \"robô Collambeit\" e o \"robô Barão Coelho\". Até agora, o feedback tem sido bem positivo!"
                                                                },
                                                                {
                                                                    "id": "737050131",
                                                                    "speaker": "Collei",
                                                                    "text": "Assim que coletarmos dados suficientes, a Academia continuará aprimorando os Companheiros de Exploração e lançará ainda mais designs!"
                                                                },
                                                                {
                                                                    "id": "737050132",
                                                                    "speaker": "Paimon",
                                                                    "text": "Um monte de Collambeis e Barões Coelhos correndo pela natureza... Como será que isso vai parecer?",
                                                                    "choices": [
                                                                        {
                                                                            "id": "737050133",
                                                                            "text": "Sem dúvida, como um alívio para os olhos!",
                                                                            "response": [
                                                                                {
                                                                                    "id": "737050135",
                                                                                    "speaker": "Collei",
                                                                                    "text": "Além disso, com você guiando nossos dois pequenos batedores, poderemos obter ótimos dados."
                                                                                },
                                                                                {
                                                                                    "id": "737050136",
                                                                                    "speaker": "Collei",
                                                                                    "text": "Quando você tiver uma compreensão mais completa do Centro do Campo, deveria vir testá-los."
                                                                                },
                                                                                {
                                                                                    "id": "737050137",
                                                                                    "speaker": "Collei",
                                                                                    "text": "Agora, venha comigo. Vou te apresentar aos outros consultores."
                                                                                },
                                                                                {
                                                                                    "id": "737050138",
                                                                                    "speaker": "Amber",
                                                                                    "text": "Ah, é mesmo! A moça de cabelo azul-esverdeado também tem um dispositivo superfofo ali!"
                                                                                },
                                                                                {
                                                                                    "id": "737050139",
                                                                                    "speaker": "Amber",
                                                                                    "text": "Mas, faz algo completamente diferente dos nossos companheirinhos batedores."
                                                                                },
                                                                                {
                                                                                    "id": "737050140",
                                                                                    "speaker": "Amber",
                                                                                    "text": "Estou ansiosa para ver em ação!"
                                                                                },
                                                                                {
                                                                                    "id": "737050141",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "Ah, olha! Outro rosto conhecido!"
                                                                                },
                                                                                {
                                                                                    "id": "737050142",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "Vamos lá! Vamos cumprimentar!"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "737050134",
                                                                            "text": "É meio difícil de imaginar..."
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "737050126",
                                                            "text": "Vamos trabalhar duro, para podermos festejar ainda mais."
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "737050115",
                                            "text": "Você tem chamado reforços de todos os cantos, Collei!"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "737050107",
                            "text": "Que tipo de light novels você anda lendo, Paimon..."
                        }
                    ]
                }
            ]
        }
    ]
}