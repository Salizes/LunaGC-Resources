            "dialogues": [
                {
                    "id": "705470101",
                    "speaker": "Valerina",
                    "text": "Uaaau! A Salvadora dos Gatos e Paimon, a Sussurradora de Gatos! Mal posso acreditar que vocês vieram mesmo!"
                },
                {
                    "id": "705470102",
                    "speaker": "Paimon",
                    "text": "Hã? Como é que você nos chamou?",
                    "choices": [
                        {
                            "id": "705470103",
                            "text": "Isso me soa familiar...",
                            "response": [
                                {
                                    "id": "705470105",
                                    "speaker": "Paimon",
                                    "text": "Hmm... Será que já nos vimos antes?"
                                },
                                {
                                    "id": "705470106",
                                    "speaker": "Valerina",
                                    "text": "Haha! Não acredito que a Sussurradora de Gatos ainda se lembra de mim! Manda ver, Valerina!"
                                },
                                {
                                    "id": "705470107",
                                    "speaker": "Valerina",
                                    "text": "Vamos deixar o papo em dia pra depois — que tal experimentar meu novo jogo patrocinado? Aquele que me fez sorrir por uma semana inteira..."
                                },
                                {
                                    "id": "705470108",
                                    "speaker": "Valerina",
                                    "text": "Batalhas Explosivas de Dodoco!"
                                },
                                {
                                    "id": "705470109",
                                    "speaker": "Paimon",
                                    "text": "Eita! Tantas Dodocos!",
                                    "choices": [
                                        {
                                            "id": "705470110",
                                            "text": "E são todos rostos familiares.",
                                            "response": [
                                                {
                                                    "id": "705470112",
                                                    "speaker": "Valerina",
                                                    "text": "#Olhe, Salvador{F#a} de Gatos... Hehe, ou talvez eu devesse dizer, {M#nosso}{F#nossa} admirável e brilhante Cavaleir{F#a}{M#o} Honorável!"
                                                },
                                                {
                                                    "id": "705470113",
                                                    "speaker": "Valerina",
                                                    "text": "Essa boneca Dodoco foi feita com sua imagem em mente!"
                                                },
                                                {
                                                    "id": "705470114",
                                                    "speaker": "Paimon",
                                                    "text": "#Ela tem razão! Uau, até as cores e estampas... Hehe, é igualzinha a você, {NICKNAME}!"
                                                },
                                                {
                                                    "id": "705470115",
                                                    "speaker": "Valerina",
                                                    "text": "Nesse jogo, Dodoco das Faíscas, Dodoco Brilhante, Dodoco Cavaleira e Dodoco Bruxa têm que juntar formas e usar explosivos para derrotar inimigos nunca vistos antes..."
                                                },
                                                {
                                                    "id": "705470116",
                                                    "speaker": "Valerina",
                                                    "text": "Só sou responsável pela operação e patrocínio do jogo, não sei muito sobre o desenvolvimento. Esses inimigos são tão misteriosos para mim quanto são para você..."
                                                },
                                                {
                                                    "id": "705470117",
                                                    "speaker": "Valerina",
                                                    "text": "Mas tenho certeza que até se nos encontrarmos na vida real, as incríveis Dodocos com certeza vão mandar eles voando de volta de onde vieram!"
                                                },
                                                {
                                                    "id": "705470118",
                                                    "speaker": "Paimon",
                                                    "text": "Claro! Nenhum monstro consegue impedir Klee e sua melhor amiga Dodoco!",
                                                    "choices": [
                                                        {
                                                            "id": "705470119",
                                                            "text": "Bem, vamos experimentar então!",
                                                            "response": [
                                                                {
                                                                    "id": "705470121",
                                                                    "speaker": "Valerina",
                                                                    "text": "Hehe, tenho certeza de que vocês vão se divertir muito!"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "705470120",
                                                            "text": "Um novo jogo do Dodoco!"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "705470111",
                                            "text": "Bem, o protótipo é difícil de passar despercebido!"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "705470104",
                            "text": "Essa é nova pra mim..."
                        }
                    ]
                }
            ]
        }
    ]
}