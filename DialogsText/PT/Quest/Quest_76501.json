    "talks": [
        {
            "id": "7650101",
            "objective": "",
            "dialogues": [
                {
                    "id": "765010101",
                    "speaker": "Lauma",
                    "text": "#Ah. {NICKNAME}, Paimon. São vocês. Os pássaros da floresta acabaram de anunciar sua chegada. Vieram tratar de algo importante ou... por acaso precisam da minha orientação?",
                    "choices": [
                        {
                            "id": "765010102",
                            "text": "Nós só estamos dando uma olhada.",
                            "response": [
                                {
                                    "id": "765010104",
                                    "speaker": "Lauma",
                                    "text": "Este lugar é bem nutrido pelo brilho da lua. A flora e a fauna que habitam aqui são diferentes de qualquer outra parte do mundo."
                                },
                                {
                                    "id": "765010105",
                                    "speaker": "Lauma",
                                    "text": "Então sim, eu diria que é um ótimo lugar para tirar fotos incríveis."
                                },
                                {
                                    "id": "765010106",
                                    "speaker": "Lauma",
                                    "text": "Sintam-se à vontade para explorar. Caso tenham alguma dúvida, não hesitem em me procurar. Responderei da melhor forma possível.",
                                    "choices": [
                                        {
                                            "id": "765010107",
                                            "text": "Esse lugar realmente transmite uma sensação de tranquilidade.",
                                            "response": [
                                                {
                                                    "id": "765010109",
                                                    "speaker": "Lauma",
                                                    "text": "Sim. É aqui que medito, onde me comunico com todos os seres vivos em sussurros."
                                                },
                                                {
                                                    "id": "765010110",
                                                    "speaker": "Lauma",
                                                    "text": "Só de ficar aqui parada, meu coração já se acalma."
                                                },
                                                {
                                                    "id": "765010111",
                                                    "speaker": "Paimon",
                                                    "text": "Hehe, você é uma verdadeira poeta, Lauma!",
                                                    "choices": [
                                                        {
                                                            "id": "765010112",
                                                            "text": "Na verdade, eu tenho um pequeno pedido...",
                                                            "response": [
                                                                {
                                                                    "id": "765010114",
                                                                    "speaker": "Paimon",
                                                                    "text": "É! Você combina perfeitamente com o cenário, como o centro de uma pintura belíssima! Com certeza vai ficar incrível na foto!"
                                                                },
                                                                {
                                                                    "id": "765010115",
                                                                    "speaker": "Lauma",
                                                                    "text": "Vocês gostariam de... tirar uma foto minha? Seria uma experiência inédita. Se acreditam que a serenidade deste lugar e a minha presença merecem ser eternizadas através da lente, ficarei feliz em atender."
                                                                },
                                                                {
                                                                    "id": "765010116",
                                                                    "speaker": "Lauma",
                                                                    "text": "De fato, seria uma honra adicionar mais uma lembrança feliz à sua jornada."
                                                                },
                                                                {
                                                                    "id": "765010117",
                                                                    "speaker": "Lauma",
                                                                    "text": "Então, como posso ajudar? Quer que eu olhe para alguma direção específica, ou assim já está bom?",
                                                                    "choices": [
                                                                        {
                                                                            "id": "765010118",
                                                                            "text": "Seja você mesma.",
                                                                            "response": [
                                                                                {
                                                                                    "id": "765010120",
                                                                                    "speaker": "Lauma",
                                                                                    "text": "Certo, deixarei tudo em suas mãos. Que a inspiração, por mais fugaz que seja, venha te agraciar com sua presença."
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "765010119",
                                                                            "text": "Vou te capturar no seu momento mais inspirador, pode deixar."
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "765010113",
                                                            "text": "Gostaríamos de tirar uma foto sua."
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "765010108",
                                            "text": "Você costuma passar bastante tempo por aqui, Lauma?"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "765010103",
                            "text": "E procurando algum material para fotos enquanto estamos nisso."
                        }
                    ]
                }
            ]
        },
        {
            "id": "7650104",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "765010401",
                    "speaker": "Lauma",
                    "text": "Está pronta? Se acreditar que chegou o momento certo, podemos começar."
                }
            ]
        },
        {
            "id": "7650105",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "765010501",
                    "speaker": "Player",
                    "text": "Estou pronta. Vamos começar essa sessão de fotos!"
                }
            ]
        },
        {
            "id": "7650106",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "765010601",
                    "speaker": "Player",
                    "text": "Espera um pouco, preciso de um momento para pensar no ângulo que vamos usar."
                }
            ]
        },
        {
            "id": "7650107",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "765010701",
                    "speaker": "Lauma",
                    "text": "#Ah. {NICKNAME}, Paimon. São vocês. Os pássaros da floresta acabaram de anunciar sua chegada. Vieram tratar de algo importante ou... por acaso precisam da minha orientação?",
                    "choices": [
                        {
                            "id": "765010702",
                            "text": "Nós só estamos dando uma olhada.",
                            "response": [
                                {
                                    "id": "765010704",
                                    "speaker": "Lauma",
                                    "text": "Ah, entendi. Fique à vontade para admirar a paisagem e tirar fotos do que quiser."
                                },
                                {
                                    "id": "765010705",
                                    "speaker": "Lauma",
                                    "text": "Dito isso, não vejo sua Kamera com você. Sem ela, nem mesmo os cenários mais deslumbrantes podem ser transformados em memórias fotográficas, não é?"
                                }
                            ]
                        },
                        {
                            "id": "765010703",
                            "text": "E procurando por alguns materiais de fotografia por enquanto isso."
                        }
                    ]
                }
            ]
        },
        {
            "id": "7650108",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "765010801",
                    "speaker": "Lauma",
                    "text": "E então? Conseguiu encontrar o material fotográfico que tinha em mente?",
                    "choices": [
                        {
                            "id": "765010803",
                            "text": "Estamos prontos. Que comece a sessão de fotos!",
                            "response": [
                                {
                                    "id": "765010804",
                                    "speaker": "Lauma",
                                    "text": "Uma proposta maravilhosa. Mas, ainda assim, não vejo sua Kamera com você. Sem ela, nem mesmo os cenários mais deslumbrantes podem ser transformados em fotos para serem lembradas, não é?"
                                }
                            ]
                        },
                        {
                            "id": "765010802",
                            "text": "Espera um pouco, preciso de um momento para pensar no ângulo que vamos usar."
                        }
                    ]
                }
            ]
        }
    ]
