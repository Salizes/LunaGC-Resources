    "talks": [
        {
            "id": "7212701",
            "objective": "",
            "dialogues": [
                {
                    "id": "721270101",
                    "speaker": "Hanayama Kaoru",
                    "text": "Olá, você chegou! Você vê muitas flores desabrochando? Não são bonitas?",
                    "choices": [
                        {
                            "id": "721270102",
                            "text": "De fato são muito bonitas.",
                            "response": [
                                {
                                    "id": "721270103",
                                    "speaker": "Hanayama Kaoru",
                                    "text": "Hehe... Com certeza! Estou cuidando muito bem delas..."
                                },
                                {
                                    "id": "721270106",
                                    "speaker": "Hanayama Kaoru",
                                    "text": "Na verdade, você pode fazer um favor para mim? Agora que as flores estão florescendo tão bem, eu ia pegar algumas e secar elas, para enviar junto com cartas para aqueles que ainda irão retornar a Tatarasuna."
                                },
                                {
                                    "id": "721270107",
                                    "speaker": "Hanayama Kaoru",
                                    "text": "Mas... não sei se é porque dormi muito pouco, só saí para colher umas flores e já estou tão cansada..."
                                },
                                {
                                    "id": "721270108",
                                    "speaker": "Hanayama Kaoru",
                                    "text": "Você poderia me ajudar a escolher flores doces por aqui? Apenas três são suficientes.",
                                    "choices": [
                                        {
                                            "id": "721270109",
                                            "text": "Deixe comigo.",
                                            "response": [
                                                {
                                                    "id": "721270110",
                                                    "speaker": "Hanayama Kaoru",
                                                    "text": "Obrigada, eu vou descansar um pouco..."
                                                },
                                                {
                                                    "id": "721270112",
                                                    "speaker": "Hanayama Kaoru",
                                                    "text": "Eu só quero a fragrância adorável das Flores Doces, outras flores secas serão incluídas na carta."
                                                },
                                                {
                                                    "id": "721270113",
                                                    "speaker": "Hanayama Kaoru",
                                                    "text": "Acredito que aqueles que leram essa carta, cercados por essa fragrância agradável, possam ao menos ficarem com um humor melhor."
                                                },
                                                {
                                                    "id": "721270114",
                                                    "speaker": "Hanayama Kaoru",
                                                    "text": "Conto com você, então. Vou fazer uma pequena pausa aqui... Depois de colher as flores, por favor, traga-as para mim."
                                                }
                                            ]
                                        },
                                        {
                                            "id": "721270111",
                                            "text": "As Flores Doces parecem estar por todos os lados..."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "721270104",
                            "text": "Por quanto tempo você tem plantado?",
                            "response": [
                                {
                                    "id": "721270105",
                                    "speaker": "Hanayama Kaoru",
                                    "text": "Não é assim tão longo, é só... Eu só durmo um pouco menos."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7212702",
            "objective": "",
            "dialogues": [
                {
                    "id": "721270201",
                    "speaker": "Hanayama Kaoru",
                    "text": "Você coletou as Flores Secas?"
                }
            ]
        },
        {
            "id": "7212703",
            "objective": "",
            "dialogues": [
                {
                    "id": "721270301",
                    "speaker": "Hanayama Kaoru",
                    "text": "Obrigada. Estas flores doces devem ser suficientes. Vou fazer as flores secas."
                },
                {
                    "id": "721270302",
                    "speaker": "Hanayama Kaoru",
                    "text": "Ah sim, eu tenho um presente para você."
                },
                {
                    "id": "721270303",
                    "speaker": "Hanayama Kaoru",
                    "text": "Aqui, por favor, pegue esta flor seca. Embora esteja um pouco murcha, é uma flor muito valiosa.",
                    "choices": [
                        {
                            "id": "721270304",
                            "text": "#Obrigad{F#a}{M#o}.",
                            "response": [
                                {
                                    "id": "721270307",
                                    "speaker": "Hanayama Kaoru",
                                    "text": "Esta é a primeira flor que desabrocha neste mar de flores. Você me ajudou a encontrar as sementes da flor, então eu gostaria de lhe dar esta flor."
                                },
                                {
                                    "id": "721270308",
                                    "speaker": "Hanayama Kaoru",
                                    "text": "Embora não seja nada muito valioso, mas mesmo assim... muito obrigada!"
                                },
                                {
                                    "id": "721270309",
                                    "speaker": "Player",
                                    "text": "Tenho certeza que todos voltarão."
                                },
                                {
                                    "id": "721270310",
                                    "speaker": "Hanayama Kaoru",
                                    "text": "Sim! Portanto, preciso plantar mais flores para que, quando todos voltarem, possam ver mais flores."
                                }
                            ]
                        },
                        {
                            "id": "721270305",
                            "text": "Tem algo de especial?",
                            "response": [
                                {
                                    "id": "721270306",
                                    "speaker": "Hanayama Kaoru",
                                    "text": "É claro que há algo de especial nisso, se não eu não daria especialmente a você."
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}