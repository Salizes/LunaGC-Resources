                {
                    "id": "745250401",
                    "speaker": "Cyno",
                    "text": "...",
                    "choices": [
                        {
                            "id": "745250402",
                            "text": "Que cara séria essa sua.",
                            "response": [
                                {
                                    "id": "745250404",
                                    "speaker": "Cyno",
                                    "text": "Ah, é você. Não, as investigações de hoje estão completas. Nada de incomum foi encontrado."
                                },
                                {
                                    "id": "745250405",
                                    "speaker": "Cyno",
                                    "text": "Eu só estava pensando porque aqueles Eremitas pareciam tão desanimados.",
                                    "choices": [
                                        {
                                            "id": "745250406",
                                            "text": "Talvez uma jornada cansativa?",
                                            "response": [
                                                {
                                                    "id": "745250408",
                                                    "speaker": "Cyno",
                                                    "text": "Eu aposto que eles estão com problemas financeiros. Eremita riqueza, agora é só Eremita pobreza.",
                                                    "choices": [
                                                        {
                                                            "id": "745250409",
                                                            "text": "Que tal algo mais animado?",
                                                            "response": [
                                                                {
                                                                    "id": "745250411",
                                                                    "speaker": "Cyno",
                                                                    "text": "Ah, entendi. Ainda assim, se eu só ficar ali parado, a imagem pode não ter impacto."
                                                                },
                                                                {
                                                                    "id": "745250412",
                                                                    "speaker": "Cyno",
                                                                    "text": "Não se preocupe, eu vou usar Electro. Isso deve Electro-minar, né?"
                                                                },
                                                                {
                                                                    "id": "745250413",
                                                                    "speaker": "Player",
                                                                    "text": "... Ótimo. Vou fotografar você em ação."
                                                                },
                                                                {
                                                                    "id": "745250414",
                                                                    "speaker": "Cyno",
                                                                    "text": "Certo. Conto com você. Não perca o momento crítico."
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "745250410",
                                                            "text": "Posso tirar uma foto sua?"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "745250407",
                                            "text": "Será que falharam em sua missão?"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
