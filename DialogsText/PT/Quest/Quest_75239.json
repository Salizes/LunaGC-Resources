            "dialogues": [
                {
                    "id": "752390301",
                    "speaker": "Kanei",
                    "text": "#Minha nossa, car{M#o}{F#a} cliente, Zhaka devia seguir o seu exemplo! Você não só encontrou os bonecos, como também pintou bem rápido!"
                },
                {
                    "id": "752390302",
                    "speaker": "Kanei",
                    "text": "Quando ele voltar, vou garantir que ele aprenda uma coisa ou outra com você. Por favor, aceite esse pagamento!"
                }
            ]
        },
        {
            "id": "7523901",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "752390101",
                    "speaker": "Kanei",
                    "text": "Ugh, aquele Zhaka... saiu sem terminar o trabalho! E quem sabe onde ele guardou os bonecos! Farei uma denúncia!"
                },
                {
                    "id": "752390102",
                    "speaker": "Player",
                    "text": "Que bonecos?"
                },
                {
                    "id": "752390103",
                    "speaker": "Kanei",
                    "text": "Bonecos baseados em Koholassauros. Eu tô pintando eles."
                },
                {
                    "id": "752390104",
                    "speaker": "Kanei",
                    "text": "Mas Zhaka, meu aprendiz, não apareceu nos últimos dias. Ele ainda tem três bonecos sem pintar e não faço ideia de onde colocou."
                },
                {
                    "id": "752390105",
                    "speaker": "Kanei",
                    "text": "#Car{M#o}{F#a} cliente, se importaria em me ajudar a procurar? Acho que devem estar por perto."
                }
            ]
        },
        {
            "id": "7523904",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "752390401",
                    "speaker": "Player",
                    "text": "Tenho outras coisas para fazer."
                },
                {
                    "id": "752390402",
                    "speaker": "Kanei",
                    "text": "Oh, não tem problema, eu vou fazer isso sozinho."
