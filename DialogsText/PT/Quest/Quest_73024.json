    "talks": [
        {
            "id": "7302401",
            "objective": "",
            "dialogues": [
                {
                    "id": "730240101",
                    "speaker": "???",
                    "text": "Oh, você ajudou bastante! Obrigada!"
                },
                {
                    "id": "730240102",
                    "speaker": "Rana",
                    "text": "Como você pode ver, eu sou a Patrulheira Florestal daqui. E quanto ao meu nome, é Rana.",
                    "choices": [
                        {
                            "id": "730240103",
                            "text": "#Eu sou {NICKNAME}.",
                            "response": [
                                {
                                    "id": "730240104",
                                    "speaker": "Paimon",
                                    "text": "E o nome da Paimon é Paimon! Somos de outra nação."
                                },
                                {
                                    "id": "730240107",
                                    "speaker": "Rana",
                                    "text": "Oh, entendo. Hmm... Vocês não se vestem como o povo da floresta, e nem parecem que são do deserto, mas suas roupas permitem transpiração, e são boas para viajar em Sumeru."
                                },
                                {
                                    "id": "730240108",
                                    "speaker": "Paimon",
                                    "text": "Hã? Falando nisso, já que Rana é uma Patrulheira Florestal...",
                                    "choices": [
                                        {
                                            "id": "730240109",
                                            "text": "Você deve conhecer Tighnari, não é?",
                                            "response": [
                                                {
                                                    "id": "730240110",
                                                    "speaker": "Rana",
                                                    "text": "#Oooh! {NICKNAME}, você também conhece Tighnari?"
                                                },
                                                {
                                                    "id": "730240111",
                                                    "speaker": "Rana",
                                                    "text": "Tighnari pode parecer inacessível, mas, na verdade ele é uma pessoa muito legal. Ele cuidou muito bem de mim quando eu estava treinando, e suas orelhas são lindas."
                                                },
                                                {
                                                    "id": "730240112",
                                                    "speaker": "Paimon",
                                                    "text": "Sim! Paimon realmente queria tocá-las...",
                                                    "choices": [
                                                        {
                                                            "id": "730240113",
                                                            "text": "Na verdade, eu também...",
                                                            "response": [
                                                                {
                                                                    "id": "730240114",
                                                                    "speaker": "Paimon",
                                                                    "text": "Hmm... Paimon se pergunta se voar sorrateiramente ao lado dele funcionará..."
                                                                },
                                                                {
                                                                    "id": "730240115",
                                                                    "speaker": "Rana",
                                                                    "text": "Hahaha! Tighnari ficará com raiva se você fizer isso sem perguntar antes."
                                                                },
                                                                {
                                                                    "id": "730240118",
                                                                    "speaker": "Rana",
                                                                    "text": "Não é? Elas parecem tão brilhantes. Me pergunto qual é a sensação de tocá-las. A criança que está com ele provavelmente está bem interessada também..."
                                                                },
                                                                {
                                                                    "id": "730240119",
                                                                    "speaker": "Paimon",
                                                                    "text": "Hã? Rana, você está falando de..."
                                                                },
                                                                {
                                                                    "id": "730240120",
                                                                    "speaker": "Player",
                                                                    "text": "De Collei?"
                                                                },
                                                                {
                                                                    "id": "730240121",
                                                                    "speaker": "Rana",
                                                                    "text": "#Hã? {NICKNAME}, você também conhece Collei?"
                                                                },
                                                                {
                                                                    "id": "730240122",
                                                                    "speaker": "Rana",
                                                                    "text": "Collei não tem estado muito bem. Mesmo assim, ela trabalha duro para proteger a floresta e eliminar o Definhamento. Todos estão preocupados com ela."
                                                                },
                                                                {
                                                                    "id": "730240141",
                                                                    "speaker": "Rana",
                                                                    "text": "Ahem! Enfim, o dever de uma Patrulheira Florestal é proteger a floresta, ajudar viajantes, e ser um guia."
                                                                },
                                                                {
                                                                    "id": "730240142",
                                                                    "speaker": "Rana",
                                                                    "text": "#Como {NICKNAME} e Paimon viram, ultimamente a floresta tem estado... Menos que o ideal? Os cogumelos e bestas estão mais agressivos, e há o Definhamento..."
                                                                },
                                                                {
                                                                    "id": "730240143",
                                                                    "speaker": "Rana",
                                                                    "text": "#Que tal eu escoltar vocês {F#duas}{M#dois}? A próxima parada da minha rota de patrulha é a Vila Vimara. De lá, ir até o Porto Ormos ou Cidade de Sumeru é muito fácil.",
                                                                    "choices": [
                                                                        {
                                                                            "id": "730240144",
                                                                            "text": "Claro, vamos.",
                                                                            "response": [
                                                                                {
                                                                                    "id": "730240145",
                                                                                    "speaker": "Rana",
                                                                                    "text": "Certo, manterei vocês em segurança!"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "730240146",
                                                                            "text": "Certo, mas eu tenho algumas coisas para fazer antes...",
                                                                            "response": [
                                                                                {
                                                                                    "id": "730240147",
                                                                                    "speaker": "Rana",
                                                                                    "text": "Oh, entendo. Esperarei aqui por vocês. Tenham cuidado!"
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "730240116",
                                                            "text": "Paimon pode fazer super furtivamente!",
                                                            "response": [
                                                                {
                                                                    "id": "730240117",
                                                                    "speaker": "Paimon",
                                                                    "text": "Ei! Isso não irritará Tighnari, não é?"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "730240123",
                                            "text": "Talvez conheça a Collei?",
                                            "response": [
                                                {
                                                    "id": "730240124",
                                                    "speaker": "Rana",
                                                    "text": "#Hã? {NICKNAME}, você conhece essa garota?"
                                                },
                                                {
                                                    "id": "730240125",
                                                    "speaker": "Rana",
                                                    "text": "Collei não tem estado muito bem. Mesmo assim, ela trabalha duro para proteger a floresta e eliminar o Definhamento. Todos estão preocupados com ela."
                                                },
                                                {
                                                    "id": "730240126",
                                                    "speaker": "Rana",
                                                    "text": "Mas ela está com aquele cara com orelhas bonitas, então ela deve estar bem!"
                                                },
                                                {
