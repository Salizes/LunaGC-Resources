                                                            ]
                                                        },
                                                        {
                                                            "id": "730240138",
                                                            "text": "É Amber?",
                                                            "response": [
                                                                {
                                                                    "id": "730240139",
                                                                    "speaker": "Paimon",
                                                                    "text": "\"Vai, vai, Barão Coelho!\""
                                                                },
                                                                {
                                                                    "id": "730240140",
