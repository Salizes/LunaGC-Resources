        {
            "id": "7452604",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "745260401",
                    "speaker": "Nilou",
                    "text": "#Ah, {NICKNAME}. É você.",
                    "choices": [
                        {
                            "id": "745260402",
                            "text": "Você está praticando, Nilou?",
                            "response": [
                                {
                                    "id": "745260404",
                                    "speaker": "Nilou",
                                    "text": "Não, não. Eu só estou preparando uma dança nova inspirada pelas Padisarahs que tomam banho no sol, e com o orvalho caindo das pétalas."
                                },
                                {
                                    "id": "745260405",
                                    "speaker": "Nilou",
                                    "text": "Ainda estamos nos estágios de planejamento inicial, e muitos dos movimentos ainda estão bem primitivos. Sinto que estou faltando algo...",
                                    "choices": [
                                        {
                                            "id": "745260406",
                                            "text": "Até a descrição é bela.",
                                            "response": [
                                                {
                                                    "id": "745260408",
                                                    "speaker": "Nilou",
                                                    "text": "Você quer tirar uma foto minha? Hmm, como eu disse, esses passos de dança ainda não estão prontos...",
                                                    "choices": [
                                                        {
                                                            "id": "745260409",
                                                            "text": "Ensaiar antes da dança é que dá sua forma final...",
                                                            "response": [
                                                                {
                                                                    "id": "745260411",
                                                                    "speaker": "Nilou",
                                                                    "text": "Sim, eu entendi! Nesse caso, vou dar tudo de mim para esses movimentos... capture bem a hora que as flores desabrocham."
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "745260410",
                                                            "text": "Isso também é parte da arte."
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "745260407",
                                            "text": "Você se importaria se eu tirasse uma foto sua?"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "745260403",
                            "text": "Eu não estou incomodando, estou?"
                        }
                    ]
                }
            ]
        }
    ]
