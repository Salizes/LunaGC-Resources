    "dialogues": [
        {
            "id": "698130101",
            "speaker": "Qiqi",
            "text": "Por favor, ajude... Prove isso..."
        },
        {
            "id": "698130102",
            "speaker": "Guoba",
            "text": "?"
        },
        {
            "id": "698130103",
            "speaker": "Guoba",
            "text": "...!"
        },
        {
            "id": "698130104",
            "speaker": "Qiqi",
            "text": "I—Isso falhou de novo..."
        },
        {
            "id": "698130105",
            "speaker": "Guoba",
            "text": "♪"
        },
        {
            "id": "698130106",
            "speaker": "Qiqi",
            "text": "Obrigada por... ser gentil."
        },
        {
            "id": "698130107",
            "speaker": "Qiqi",
            "text": "E—Eu preciso de ajuda de novo... Prove isso..."
        },
        {
            "id": "698130108",
            "speaker": "Guoba",
            "text": "?"
        },
        {
            "id": "698130109",
            "speaker": "Guoba",
            "text": "♬"
        },
        {
            "id": "698130110",
            "speaker": "Qiqi",
            "text": "...É—É tão bom assim?"
        },
        {
            "id": "698130111",
            "speaker": "Guoba",
            "text": "♬~"
        },
        {
            "id": "698130112",
            "speaker": "Qiqi",
            "text": "Ebaa!",
            "choices": [
                {
                    "id": "698130113",
                    "text": "Espera, algo tem um cheiro bom.",
                    "response": [
                        {
                            "id": "698130115",
                            "speaker": "Qiqi",
                            "text": "#{NICKNAME}! Eu... peguei isso emprestado da cozinha de Chef Mao... Queria cozinhar alguma coisa."
                        },
                        {
                            "id": "698130116",
                            "speaker": "Qiqi",
                            "text": "Mas eu não tenho como saber o sabor, então Chef Mao pediu ao Guoba para me ajudar."
                        },
                        {
                            "id": "698130117",
                            "speaker": "Guoba",
                            "text": "♪~"
                        },
                        {
                            "id": "698130118",
                            "speaker": "Qiqi",
                            "text": "Eh? Espera... O que estou cozinhando? Deixe-me olhar minhas anotações..."
                        },
                        {
                            "id": "698130119",
                            "speaker": "Qiqi",
                            "text": "Oh! O caderno diz: Faça um prato e deixe-o congelar para se preparar para a excursão com Yaoyao."
                        },
                        {
                            "id": "698130120",
                            "speaker": "Qiqi",
                            "text": "Mmm. Eu não preciso comer, mas Yaoyao... precisa comer para crescer... e ficar mais alta."
                        },
                        {
                            "id": "698130121",
                            "speaker": "Qiqi",
                            "text": "Será que a Yaoyao... vai crescer e ficar mais alta do que o Dr. Baizhu um dia?"
                        },
                        {
                            "id": "698130122",
                            "speaker": "Guoba",
                            "text": "?"
                        },
                        {
                            "id": "698130123",
                            "speaker": "Player",
                            "text": "Isso pode ser um pouco difícil."
                        },
                        {
                            "id": "698130124",
                            "speaker": "Qiqi",
                            "text": "Não se preocupe. Yaoyao será fofa, não importa o quão alta ela for."
                        },
                        {
                            "id": "698130125",
                            "speaker": "Qiqi",
                            "text": "Ah! Falamos por muito tempo. O fogão..."
                        },
                        {
                            "id": "698130126",
                            "speaker": "Guoba",
                            "text": "♬"
                        },
                        {
                            "id": "698130127",
                            "speaker": "Qiqi",
                            "text": "Obrigada por ficar de olho no fogão, Guoba. Por favor, prove esse daqui também..."
                        },
                        {
                            "id": "698130128",
                            "speaker": "Guoba",
                            "text": "...!"
                        },
                        {
                            "id": "698130129",
                            "speaker": "Player",
                            "text": "Definitivamente se parece com um cheiro muito \"impactante\"..."
                        }
                    ]
                },
                {
                    "id": "698130114",
                    "text": "Você está preparando algo delicioso?"
                }
            ]
        }
    ]
}