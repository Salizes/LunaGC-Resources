{
    "talkId": "6986601",
    "total_dialogue_lines": 81,
    "speaker_counts": {
        "Black Screen": 1,
        "Neuvillette": 11,
        "Pahsiv": 7,
        "Paimon": 16,
        "Player": 14,
        "Wriothesley": 32
    },
    "dialogues": [
        {
            "id": "698660101",
            "speaker": "Paimon",
            "text": "Hã? Será que os olhos da Paimon estão enganando ela? A pessoa sentada atrás da mesa é..."
        },
        {
            "id": "698660102",
            "speaker": "Player",
            "text": "Essa não, o Duque virou uma Melusine!"
        },
        {
            "id": "698660103",
            "speaker": "Paimon",
            "text": "Não-não! Isso não está certo! Isso claramente é..."
        },
        {
            "id": "698660104",
            "speaker": "Player",
            "text": "Opa, foi mal. O Duque virou um Sauriano."
        },
        {
            "id": "698660105",
            "speaker": "Paimon",
            "text": "Do que é que você está falando?"
        },
        {
            "id": "698660106",
            "speaker": "Paimon",
            "text": "#Desculpa, Pahsiv, {M#ele não está}{F#ela não está} muito bem agora...",
            "choices": [
                {
                    "id": "698660107",
                    "text": "Hehe, eu só estava pegando no seu pé.",
                    "response": [
                        {
                            "id": "698660109",
                            "speaker": "Pahsiv",
                            "text": "Bom dia, boa tarde, boa noite, Pahsiv!"
                        },
                        {
                            "id": "698660110",
                            "speaker": "Paimon",
                            "text": "Olá para você também, Pahsiv. Mas... o que você está fazendo aqui na Fortaleza Meropide?",
                            "choices": [
                                {
                                    "id": "698660111",
                                    "text": "Você fez alguma coisa errada?",
                                    "response": [
                                        {
                                            "id": "698660112",
                                            "speaker": "Paimon",
                                            "text": "Que coisas ruins a Pahsiv poderia fazer? Causar uma extinção em massa de Maralgas em Fontaine?"
                                        },
                                        {
                                            "id": "698660115",
                                            "speaker": "Pahsiv",
                                            "text": "Luz grande e brilhante, Melusine... Pahsiv, com fome..."
                                        },
                                        {
                                            "id": "698660116",
                                            "speaker": "Paimon",
                                            "text": "Hmm... Paimon não sabe o que é aquela luz grande e brilhante, mas pelo menos podemos resolver o problema da fome."
                                        },
                                        {
                                            "id": "698660117",
                                            "speaker": "Paimon",
                                            "text": "#{NICKNAME}, você deve ter alguma coisa gostosa na sua bolsa. Que tal a gente..."
                                        },
                                        {
                                            "id": "698660118",
                                            "speaker": "Pahsiv",
                                            "text": "Ah... Wrio! Wrio!"
                                        },
                                        {
                                            "id": "698660119",
                                            "speaker": "Wriothesley",
                                            "text": "Indo, indo."
                                        },
                                        {
                                            "id": "698660120",
                                            "speaker": "Wriothesley",
                                            "text": "#Hã? Vejo que temos mais convidad{M#o}{F#a}s ilustres. Por favor, me dê um momento enquanto eu deixo essas coisas aqui."
                                        },
                                        {
                                            "id": "698660121",
                                            "speaker": "Wriothesley",
                                            "text": "Ah, quem diria que eu, que passo a maior parte do dia aqui sentado sendo servido, teria que mergulhar na água para buscar comida?"
                                        },
                                        {
                                            "id": "698660122",
                                            "speaker": "Paimon",
                                            "text": "A Paimon com certeza não esperava que Vossa Graça fosse fazer isso pessoalmente!"
                                        },
                                        {
                                            "id": "698660123",
                                            "speaker": "Wriothesley",
                                            "text": "Ah, está tudo bem. Nadar de vez em quando é um bom exercício. E, se eu tiver sorte, ainda ganho um show de lontras de graça."
                                        },
                                        {
                                            "id": "698660124",
                                            "speaker": "Paimon",
                                            "text": "É, quase esqueci o quanto você pode ser ocioso às vezes..."
                                        },
                                        {
                                            "id": "698660125",
                                            "speaker": "Player",
                                            "text": "Então, como Pahsiv veio parar aqui?"
                                        },
                                        {
                                            "id": "698660126",
                                            "speaker": "Wriothesley",
                                            "text": "Hein. Então \"Pahsiv\" é mesmo o nome dela?"
                                        },
                                        {
                                            "id": "698660127",
                                            "speaker": "Wriothesley",
                                            "text": "Que interessante. É como se o nome de alguém fosse \"É Isso Aí\" ou \"Que Legal\". Só de ouvir já dá uma animada."
                                        },
                                        {
                                            "id": "698660128",
                                            "speaker": "Wriothesley",
                                            "text": "Ah, e quanto à sua pergunta... Resumindo, a Srta. Pahsiv ficou tempo demais sob o holofote de busca e acabou capturada por alguns guardas que levam as regras a sério demais."
                                        },
                                        {
                                            "id": "698660129",
                                            "speaker": "Wriothesley",
                                            "text": "Suspeito que ela estava tão absorta com a Maralga ali perto que não percebeu a \"armadilha\" se fechando ao redor dela."
                                        },
                                        {
                                            "id": "698660130",
                                            "speaker": "Wriothesley",
                                            "text": "Isso não pode, Pahsiv. Lembre-se de que certos peixes usam as luzes acima da cabeça como isca para prender suas presas."
                                        },
                                        {
                                            "id": "698660131",
                                            "speaker": "Wriothesley",
                                            "text": "Você não pode simplesmente caçar Maralga sem saber que está sendo caçada por um peixe-pescador."
                                        },
                                        {
                                            "id": "698660132",
                                            "speaker": "Pahsiv",
                                            "text": "P... Pahsiv?"
                                        },
                                        {
                                            "id": "698660133",
                                            "speaker": "Wriothesley",
                                            "text": "Está tudo bem se você não estiver acompanhando. Alguém que pode explicar isso para você vai chegar daqui a pouco."
                                        },
                                        {
                                            "id": "698660134",
                                            "speaker": "Paimon",
                                            "text": "Quem?"
                                        },
                                        {
                                            "id": "698660135",
                                            "speaker": "Wriothesley",
                                            "text": "Imagino que você também conhecem um tal de \"Nuvem Chiclete\"?"
                                        },
                                        {
                                            "id": "698660136",
                                            "speaker": "Paimon",
                                            "text": "...Pfft!"
                                        },
                                        {
                                            "id": "698660137",
                                            "speaker": "Player",
                                            "text": "Eu conheço ele. Conheço ele muito bem."
                                        },
                                        {
                                            "id": "698660138",
                                            "speaker": "Wriothesley",
                                            "text": "Bem, quem diria? Eu levo jeito para isso. Entendi de quem ela estava falando na hora..."
                                        },
                                        {
                                            "id": "698660139",
                                            "speaker": "Wriothesley",
                                            "text": "Para ser justo, é natural que uma Melusine conheça Neuvillette."
                                        },
                                        {
                                            "id": "698660140",
                                            "speaker": "Wriothesley",
                                            "text": "Mesmo assim, é a primeira vez que vejo uma que gosta de comer Maralga, fala em enigmas e ainda usa \"Melusine\" para expressar negação."
                                        },
                                        {
                                            "id": "698660141",
                                            "speaker": "Paimon",
                                            "text": "Ah, bem, sobre isso...",
                                            "choices": [
                                                {
                                                    "id": "698660142",
                                                    "text": "É uma longa história...",
                                                    "response": [
                                                        {
                                                            "id": "698660144",
                                                            "speaker": "Wriothesley",
                                                            "text": "...Onde?"
                                                        },
                                                        {
                                                            "id": "698660145",
                                                            "speaker": "Neuvillette",
                                                            "text": "Cof..."
                                                        },
                                                        {
                                                            "id": "698660146",
                                                            "speaker": "Neuvillette",
                                                            "text": "Desculpem deixar todo mundo esperando. Espero não estar atrasado."
                                                        },
                                                        {
                                                            "id": "698660147",
                                                            "speaker": "Wriothesley",
                                                            "text": "Ah, Neuvillette! Claro que não. Sempre que você aparece, é a hora certa. A srta. Pahsiv está esperando por você."
                                                        },
                                                        {
                                                            "id": "698660148",
                                                            "speaker": "Pahsiv",
                                                            "text": "Nuvem... Chi... clete!"
                                                        },
                                                        {
                                                            "id": "698660149",
                                                            "speaker": "Neuvillette",
                                                            "text": "Sem pressa, termine sua comida. A gente conversa depois."
                                                        },
                                                        {
                                                            "id": "698660150",
                                                            "speaker": "Paimon",
                                                            "text": "Isso parece até um pai encontrando o filho perdido no parque..."
                                                        },
                                                        {
                                                            "id": "698660151",
                                                            "speaker": "Wriothesley",
                                                            "text": "Ah, sim, isso mesmo. Eu encontrei nosso \"Nuvem Chiclete\" transmitindo um aviso de pessoa desaparecida por toda Fontaine.",
                                                            "choices": [
                                                                {
                                                                    "id": "698660152",
                                                                    "text": "Entendo.",
                                                                    "response": [
                                                                        {
                                                                            "id": "698660154",
                                                                            "speaker": "Neuvillette",
                                                                            "text": "Hehe... Parece que estamos de ótimo humor hoje. Essas piadas são bem criativas."
                                                                        },
                                                                        {
                                                                            "id": "698660155",
                                                                            "speaker": "Wriothesley",
                                                                            "text": "Você também parece bem feliz em ver a Pahsiv. Ela deve ser muito importante para você."
                                                                        },
                                                                        {
                                                                            "id": "698660156",
                                                                            "speaker": "Neuvillette",
                                                                            "text": "Hmm..."
                                                                        },
                                                                        {
                                                                            "id": "698660157",
                                                                            "speaker": "Neuvillette",
                                                                            "text": "Já que não tem nenhum forasteiro aqui, vou direto ao ponto."
                                                                        },
                                                                        {
                                                                            "id": "698660158",
                                                                            "speaker": "Neuvillette",
                                                                            "text": "Apesar das aparências, ela é bem diferente das outras Melusines..."
                                                                        },
                                                                        {
                                                                            "id": "698660181",
                                                                            "speaker": "Black Screen",
                                                                            "text": "Você ouve a explicação de Neuvillette sobre o que torna Pahsiv especial (embora você já soubesse)..."
                                                                        },
                                                                        {
                                                                            "id": "698660159",
                                                                            "speaker": "Wriothesley",
                                                                            "text": "Isso explica tudo. Então é por isso que a Pahsiv se expressa de um jeito tão único."
                                                                        },
                                                                        {
                                                                            "id": "698660160",
                                                                            "speaker": "Wriothesley",
                                                                            "text": "Viu? É preciso se esforçar para viver um pouco mais."
                                                                        },
                                                                        {
                                                                            "id": "698660161",
                                                                            "speaker": "Player",
                                                                            "text": "Para adquirir mais conhecimento?"
                                                                        },
                                                                        {
                                                                            "id": "698660162",
                                                                            "speaker": "Wriothesley",
                                                                            "text": "Para ouvir histórias de quem viveu mais do que você, sobre coisas que você nunca soube."
                                                                        },
                                                                        {
                                                                            "id": "698660163",
                                                                            "speaker": "Pahsiv",
                                                                            "text": "Pahsiv!"
                                                                        },
                                                                        {
                                                                            "id": "698660164",
                                                                            "speaker": "Wriothesley",
                                                                            "text": "Parece que a Srta. Pahsiv concorda também."
                                                                        },
                                                                        {
                                                                            "id": "698660165",
                                                                            "speaker": "Neuvillette",
                                                                            "text": "De fato. Muito obrigado por cuidar dela."
                                                                        },
                                                                        {
                                                                            "id": "698660166",
                                                                            "speaker": "Wriothesley",
                                                                            "text": "Foi um prazer."
                                                                        },
                                                                        {
                                                                            "id": "698660167",
                                                                            "speaker": "Wriothesley",
                                                                            "text": "E graças a vocês, agora tenho um ótimo motivo para dar uma pequena tarefa aos meus amigos do Instituto de Pesquisas de Fontaine: adicionar alguns mecanismos de identificação às nossas \"Grandes Luzes Brilhantes\"."
                                                                        },
                                                                        {
                                                                            "id": "698660168",
                                                                            "speaker": "Wriothesley",
                                                                            "text": "Ficar \"convidando\" amigos para a nossa porta assim... Não é um plano sustentável a longo prazo, concorda?"
                                                                        },
                                                                        {
                                                                            "id": "698660169",
                                                                            "speaker": "Paimon",
                                                                            "text": "#Você tem razão. Até a gente acabou sendo levad{M#o}{F#a}s de tempos em tempos enquanto passamos por aqui..."
                                                                        },
                                                                        {
                                                                            "id": "698660170",
                                                                            "speaker": "Player",
                                                                            "text": "Mal posso esperar para ver o que os inventores vão criar."
                                                                        },
                                                                        {
                                                                            "id": "698660171",
                                                                            "speaker": "Wriothesley",
                                                                            "text": "Não vamos nos precipitar. Só espero conseguir ver isso antes de morrer."
                                                                        },
                                                                        {
                                                                            "id": "698660172",
                                                                            "speaker": "Neuvillette",
                                                                            "text": "Até o processo ser concluído, vou informar as Melusines para evitarem essas... \"Grandes Luzes Brilhantes\" ao passarem por lá. Eu farei o mesmo."
                                                                        },
                                                                        {
                                                                            "id": "698660173",
                                                                            "speaker": "Wriothesley",
                                                                            "text": "Ah... sim. Não tenho a menor dúvida de que você é mais do que capaz."
                                                                        },
                                                                        {
                                                                            "id": "698660174",
                                                                            "speaker": "Neuvillette",
                                                                            "text": "Desculpe pelo inconveniente. De qualquer forma, não posso ficar por muito tempo, então me retirarei junto com a Srta. Pahsiv."
                                                                        },
                                                                        {
                                                                            "id": "698660175",
                                                                            "speaker": "Neuvillette",
                                                                            "text": "Se houver outros assuntos para discutir, vamos nos encontrar na superfície."
                                                                        },
                                                                        {
                                                                            "id": "698660176",
                                                                            "speaker": "Wriothesley",
                                                                            "text": "Entendido."
                                                                        },
                                                                        {
                                                                            "id": "698660177",
                                                                            "speaker": "Pahsiv",
                                                                            "text": "Pahsiv, vem! Tchau, Wrio!"
                                                                        },
                                                                        {
                                                                            "id": "698660178",
                                                                            "speaker": "Wriothesley",
                                                                            "text": "Certo, certo, \"da próxima vez eu passo aqui\", prometeu o bom e velho Wrio."
                                                                        },
                                                                        {
                                                                            "id": "698660179",
                                                                            "speaker": "Wriothesley",
                                                                            "text": "(Ai, não acredito que eu esqueci de pedir para Neuvillette explicar a metáfora do Peixe-Pescador para Pahsiv, e também não consegui perguntar sobre Enkanomiya.)"
                                                                        },
                                                                        {
                                                                            "id": "698660180",
                                                                            "speaker": "Wriothesley",
                                                                            "text": "(...Tudo bem, não tem pressa. Vou escrever uma carta para ele quando eu enviar os documentos.)"
                                                                        }
                                                                    ]
                                                                },
                                                                {
                                                                    "id": "698660153",
                                                                    "text": "Que reencontro comovente."
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "698660143",
                                                    "text": "Era uma vez, em Enkanomiya..."
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "698660113",
                                    "text": "Você arrumou um emprego aqui?",
                                    "response": [
                                        {
                                            "id": "698660114",
                                            "speaker": "Paimon",
                                            "text": "Paimon não consegue imaginar que tipo de trabalho a Pahsiv poderia fazer aqui... Patrulhar o mar com Dragartos a tiracolo?"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "698660108",
                    "text": "E aí, Pahsiv."
                }
            ]
        }
    ]
}