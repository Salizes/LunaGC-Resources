{
    "talkId": "6985802",
    "total_dialogue_lines": 41,
    "speaker_counts": {
        "Lauma": 23,
        "Player": 18
    },
    "dialogues": [
        {
            "id": "698580201",
            "speaker": "Lauma",
            "text": "*Zzz*"
        },
        {
            "id": "698580202",
            "speaker": "Player",
            "text": "(Ah? De novo não, né...)"
        },
        {
            "id": "698580203",
            "speaker": "Player",
            "text": "(Mas dessa vez só a Lauma está aqui... E parece que ela está mesmo dormindo.)"
        },
        {
            "id": "698580204",
            "speaker": "Player",
            "text": "(O-O que eu faço? Que tal...)"
        },
        {
            "id": "698580205",
            "speaker": "Lauma",
            "text": "Ah!"
        },
        {
            "id": "698580206",
            "speaker": "Player",
            "text": "O... Olá!"
        },
        {
            "id": "698580207",
            "speaker": "Lauma",
            "text": "#Ah, é você, {NICKNAME}. Espero que esteja bem."
        },
        {
            "id": "698580208",
            "speaker": "Player",
            "text": "Você estava tendo um pesadelo?"
        },
        {
            "id": "698580209",
            "speaker": "Lauma",
            "text": "..."
        },
        {
            "id": "698580210",
            "speaker": "Player",
            "text": "Você não precisa falar sobre isso, se não quiser..."
        },
        {
            "id": "698580211",
            "speaker": "Lauma",
            "text": "Não, não, não é isso."
        },
        {
            "id": "698580212",
            "speaker": "Lauma",
            "text": "É só que... esses chifres são bem pesados — quase caí pra frente. Levei um baita susto.",
            "choices": [
                {
                    "id": "698580213",
                    "text": "Entendi...",
                    "response": [
                        {
                            "id": "698580215",
                            "speaker": "Lauma",
                            "text": "Haha, de fato exige!"
                        },
                        {
                            "id": "698580216",
                            "speaker": "Lauma",
                            "text": "Como você pode ver, meus chifres são maiores que os de todo mundo. Fica bem cansativo sempre que preciso andar longas distâncias"
                        },
                        {
                            "id": "698580217",
                            "speaker": "Lauma",
                            "text": "Por isso tento encontrar um tempinho pra vir aqui descansar sempre que posso. Desta vez, acabei cochilando.",
                            "choices": [
                                {
                                    "id": "698580218",
                                    "text": "Deve ser difícil.",
                                    "response": [
                                        {
                                            "id": "698580220",
                                            "speaker": "Lauma",
                                            "text": "..."
                                        },
                                        {
                                            "id": "698580221",
                                            "speaker": "Lauma",
                                            "text": "Receio que nada ajude muito além de encontrar um lugar pra sentar de vez em quando e descansar um pouco."
                                        },
                                        {
                                            "id": "698580222",
                                            "speaker": "Lauma",
                                            "text": "A Srta. Aino chegou a se oferecer pra criar um dispositivo mecânico que ajudasse a sustentar meu pescoço e meus chifres..."
                                        },
                                        {
                                            "id": "698580223",
                                            "speaker": "Lauma",
                                            "text": "Fiquei agradecido, claro, mas não parecia algo exatamente... Como posso dizer..."
                                        },
                                        {
                                            "id": "698580224",
                                            "speaker": "Player",
                                            "text": "Adequado?"
                                        },
                                        {
                                            "id": "698580225",
                                            "speaker": "Lauma",
                                            "text": "Hehe, sim, essa palavra serve muito bem."
                                        },
                                        {
                                            "id": "698580226",
                                            "speaker": "Lauma",
                                            "text": "Para alguém no meu papel, há uma certa imagem que precisa ser mantida."
                                        },
                                        {
                                            "id": "698580227",
                                            "speaker": "Lauma",
                                            "text": "Como Emissária da Canção Lunar dos Filhos da Lua Gelada, seria impróprio aparecer em público com uma máquina em volta do pescoço.",
                                            "choices": [
                                                {
                                                    "id": "698580228",
                                                    "text": "\"Senhora Mecânica...\"",
                                                    "response": [
                                                        {
                                                            "id": "698580230",
                                                            "speaker": "Lauma",
                                                            "text": "De fato...",
                                                            "choices": [
                                                                {
                                                                    "id": "698580231",
                                                                    "text": "Se ao menos você tivesse sua própria Paimon, isso resolveria o problema.",
                                                                    "response": [
                                                                        {
                                                                            "id": "698580233",
                                                                            "speaker": "Lauma",
                                                                            "text": "Hmm? Isso até que é..."
                                                                        },
                                                                        {
                                                                            "id": "698580234",
                                                                            "speaker": "Player",
                                                                            "text": "Desculpa! Eu só estava brincando."
                                                                        },
                                                                        {
                                                                            "id": "698580235",
                                                                            "speaker": "Lauma",
                                                                            "text": "Hehehe..."
                                                                        },
                                                                        {
                                                                            "id": "698580236",
                                                                            "speaker": "Lauma",
                                                                            "text": "Devo dizer que achei bem divertido pensar nisso."
                                                                        },
                                                                        {
                                                                            "id": "698580237",
                                                                            "speaker": "Lauma",
                                                                            "text": "Obrigada, uma boa risada era exatamente o que eu precisava para espantar o cansaço.",
                                                                            "choices": [
                                                                                {
                                                                                    "id": "698580238",
                                                                                    "text": "Não foi nada.",
                                                                                    "response": [
                                                                                        {
                                                                                            "id": "698580240",
                                                                                            "speaker": "Lauma",
                                                                                            "text": "Não se acanhe. Sinta-se à vontade para passar por aqui sempre que estiver de passagem."
                                                                                        },
                                                                                        {
                                                                                            "id": "698580241",
                                                                                            "speaker": "Lauma",
                                                                                            "text": "Vou garantir que tenhamos todas as frutas frescas que você puder comer."
                                                                                        }
                                                                                    ]
                                                                                },
                                                                                {
                                                                                    "id": "698580239",
                                                                                    "text": "Estarei por aqui a semana toda!"
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                },
                                                                {
                                                                    "id": "698580232",
                                                                    "text": "Ela poderia ajudar a segurar seus chifres por trás..."
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "698580229",
                                                    "text": "\"...da Floresta\""
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "698580219",
                                    "text": "Não tem nada que você possa fazer pra aliviar o peso?"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "698580214",
                    "text": "Acho que dormir sentado exige prática."
                }
            ]
        }
    ]
}