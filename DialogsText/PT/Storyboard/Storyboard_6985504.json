{
    "talkId": "6985504",
    "total_dialogue_lines": 45,
    "speaker_counts": {
        "Aino": 18,
        "Ineffa": 13,
        "Player": 14
    },
    "dialogues": [
        {
            "id": "698550401",
            "speaker": "Aino",
            "text": "Quase... Pronto. Isso deve bastar. Quando a Ineffa acordar, vou me dar de presente três fatias inteiras de bolo!"
        },
        {
            "id": "698550402",
            "speaker": "Player",
            "text": "Aino? O que houve com a Ineffa?"
        },
        {
            "id": "698550403",
            "speaker": "Aino",
            "text": "Ah, oi! Você veio brincar comigo? Desculpa, tô ocupada agora! Me dá só um tempinho, já termino!"
        },
        {
            "id": "698550404",
            "speaker": "Aino",
            "text": "Ah, e a Ineffa tá bem, viu? Só fazendo uma manutenção de rotina."
        },
        {
            "id": "698550405",
            "speaker": "Aino",
            "text": "Mas alguns dias atrás, a Jahoda chamou a Ineffa de \"cara-de-metal bobona e sem graça\". Bem antes de começar a manutenção, a Ineffa me pediu pra aprimorar o senso de humor dela.",
            "choices": [
                {
                    "id": "698550406",
                    "text": "Mesmo sem senso de humor, a Ineffa já é ótima do jeitinho que é.",
                    "response": [
                        {
                            "id": "698550407",
                            "speaker": "Aino",
                            "text": "É! Que bom que a gente concorda. A Ineffa é a melhor!"
                        },
                        {
                            "id": "698550410",
                            "speaker": "Aino",
                            "text": "Certo, vou ativá-la. Ineffa, acorda! Hora de sair da cama."
                        },
                        {
                            "id": "698550411",
                            "speaker": "Ineffa",
                            "text": "#Bom dia, Aino. Bom dia, {NICKNAME}. Aino, conseguiu aprimorar meu senso de humor?"
                        },
                        {
                            "id": "698550412",
                            "speaker": "Aino",
                            "text": "Dã! Uma tarefa tão trivial não é nada pra mim! Agora é hora de fazer alguns testes pra ver se esse aprimoramento tá funcionando direitinho..."
                        },
                        {
                            "id": "698550413",
                            "speaker": "Aino",
                            "text": "Ineffa! Pode colocar mais açúcar nos meus rolinhos de ovo? Responde de um jeito engraçado, por favor."
                        },
                        {
                            "id": "698550414",
                            "speaker": "Ineffa",
                            "text": "Não posso. Quanto mais açúcar eu coloco em um rolinho de ovo, menos açúcar ele vai ter."
                        },
                        {
                            "id": "698550415",
                            "speaker": "Player",
                            "text": "Hã?"
                        },
                        {
                            "id": "698550416",
                            "speaker": "Aino",
                            "text": "Como é que é?"
                        },
                        {
                            "id": "698550417",
                            "speaker": "Ineffa",
                            "text": "Quanto mais açúcar eu coloco em um rolinho de ovo, mais os dentes da Aino vão doer. Quanto mais os dentes da Aino doem, menos açúcar ela pode consumir."
                        },
                        {
                            "id": "698550445",
                            "speaker": "Ineffa",
                            "text": "Quanto menos açúcar ela puder consumir, menos açúcar eu posso colocar nos rolinhos de ovo."
                        },
                        {
                            "id": "698550418",
                            "speaker": "Ineffa",
                            "text": "Logo: quanto mais açúcar eu coloco em um rolinho de ovo, menos açúcar o rolinho de ovo vai ter.",
                            "choices": [
                                {
                                    "id": "698550419",
                                    "text": "Eu... Eu acho que não é assim que funciona...",
                                    "response": [
                                        {
                                            "id": "698550421",
                                            "speaker": "Aino",
                                            "text": "#Tá, isso tá estranho... Tem algo esquisito. Que tal ajudar nos testes, {NICKNAME}?",
                                            "choices": [
                                                {
                                                    "id": "698550422",
                                                    "text": "Se você colocar muito açúcar nos rolinhos de ovo e fizer a Aino comer coisas doces...",
                                                    "response": [
                                                        {
                                                            "id": "698550424",
                                                            "speaker": "Ineffa",
                                                            "text": "#Se ficar tudo ruim, {NICKNAME} vai dar um sorrisinho assim."
                                                        },
                                                        {
                                                            "id": "698550425",
                                                            "speaker": "Player",
                                                            "text": "Hã?"
                                                        },
                                                        {
                                                            "id": "698550426",
                                                            "speaker": "Aino",
                                                            "text": "Como é que é?",
                                                            "choices": [
                                                                {
                                                                    "id": "698550427",
                                                                    "text": "Se é que dá pra chamar isso de senso de humor...",
                                                                    "response": [
                                                                        {
                                                                            "id": "698550429",
                                                                            "speaker": "Ineffa",
                                                                            "text": "Você não está rindo, então suspeito que não fui compreendida. Na verdade, a primeira piada que contei usou deliberadamente uma cadeia de lógica falha."
                                                                        },
                                                                        {
                                                                            "id": "698550430",
                                                                            "speaker": "Ineffa",
                                                                            "text": "Depois de confundir as relações entre rolinhos de ovo, açúcar, Aino e a saúde dental da Aino, cheguei à conclusão absurda que expressei: que quanto mais açúcar eu coloco em um rolinho de ovo, menos açúcar ele vai ter."
                                                                        },
                                                                        {
                                                                            "id": "698550431",
                                                                            "speaker": "Ineffa",
                                                                            "text": "Na segunda piada, usei uma rima entre as expressões \"ficar tudo ruim\" e \"dar um sorrisinho assim\", para criar um efeito humorístico."
                                                                        },
                                                                        {
                                                                            "id": "698550432",
                                                                            "speaker": "Aino",
                                                                            "text": "... Entendi... As piadas são engraçadas, mas não são tão óbvias sem a explicação."
                                                                        },
                                                                        {
                                                                            "id": "698550433",
                                                                            "speaker": "Ineffa",
                                                                            "text": "Sim. No entanto, segundo minhas consultas no banco de dados, esse tipo de piada, uma frase caótica sem relações causais diretas, é considerado humorístico."
                                                                        },
                                                                        {
                                                                            "id": "698550434",
                                                                            "speaker": "Ineffa",
                                                                            "text": "Frases caóticas funcionam como uma forma de orientação. A graça está na explicação que as justifica."
                                                                        },
                                                                        {
                                                                            "id": "698550435",
                                                                            "speaker": "Aino",
                                                                            "text": "Ah..."
                                                                        },
                                                                        {
                                                                            "id": "698550436",
                                                                            "speaker": "Aino",
                                                                            "text": "Hmm, isso é realmente interessante. Ineffa, por que você não anota algumas dessas piadas caóticas? Vamos testá-las na Jahoda."
                                                                        },
                                                                        {
                                                                            "id": "698550437",
                                                                            "speaker": "Aino",
                                                                            "text": "#{NICKNAME}, por que está cobrindo o rosto? Está com dor de dente? Hehe, também exagerou no açúcar?",
                                                                            "choices": [
                                                                                {
                                                                                    "id": "698550438",
                                                                                    "text": "#Não... Só estou cansad{M#o}{F#a}.",
                                                                                    "response": [
                                                                                        {
                                                                                            "id": "698550440",
                                                                                            "speaker": "Aino",
                                                                                            "text": "#Hã? O que houve? Não me diga que está ficando doente... Ineffa, prepare algo quentinho pra {M#ele}{F#ela}!"
                                                                                        },
                                                                                        {
                                                                                            "id": "698550441",
                                                                                            "speaker": "Ineffa",
                                                                                            "text": "#Entendido. Talvez {NICKNAME} tenha comido Frutas Harra demais, um tipo de planta de Sumeru."
                                                                                        },
                                                                                        {
                                                                                            "id": "698550442",
                                                                                            "speaker": "Aino",
                                                                                            "text": "Hã? O que as Frutas Harra têm a ver com isso?"
                                                                                        },
                                                                                        {
                                                                                            "id": "698550443",
                                                                                            "speaker": "Player",
                                                                                            "text": "Por favor, não pergunte..."
                                                                                        },
                                                                                        {
                                                                                            "id": "698550444",
                                                                                            "speaker": "Ineffa",
                                                                                            "text": "Porque são feitos com Pimentas Jueyun. Naturalmente, fazem a pessoa se sentir \"aquecida\"."
                                                                                        }
                                                                                    ]
                                                                                },
                                                                                {
                                                                                    "id": "698550439",
                                                                                    "text": "Não... Só estou com frio."
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                },
                                                                {
                                                                    "id": "698550428",
                                                                    "text": "... Acho que dá pra dizer que agora ela tem um?"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "698550423",
                                                    "text": "O que acontece se ficar tudo ruim?"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "698550420",
                                    "text": "Isso... não parece certo..."
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "698550408",
                    "text": "A Aino é uma mãe tão atenciosa.",
                    "response": [
                        {
                            "id": "698550409",
                            "speaker": "Aino",
                            "text": "Hehe, é claro! A Aino é a melhor mãe que existe!"
                        }
                    ]
                }
            ]
        }
    ]
}