{
    "talkId": "6981401",
    "total_dialogue_lines": 19,
    "speaker_counts": {
        "Diona": 10,
        "Player": 8,
        "Uivo de Origem Desconhecida": 1
    },
    "dialogues": [
        {
            "id": "698140101",
            "speaker": "Diona",
            "text": "Pew-Pew~!",
            "choices": [
                {
                    "id": "698140102",
                    "text": "Caçando sozinha, Diona?",
                    "response": [
                        {
                            "id": "698140104",
                            "speaker": "Diona",
                            "text": "Hunf. Caçadores da linha de sangue Kätzlein retornam bem-sucedidos mesmo quando estão sozinhos."
                        },
                        {
                            "id": "698140105",
                            "speaker": "Player",
                            "text": "Gritar \"Pew-pew\" não assustaria os animais para longe?"
                        },
                        {
                            "id": "698140106",
                            "speaker": "Diona",
                            "text": "D-De jeito nenhum! Você não consegue ver que minhas flechas são mais rápidas que o som da minha voz?"
                        },
                        {
                            "id": "698140107",
                            "speaker": "Player",
                            "text": "Ah, então o \"pew-pew\" é só para fazer um efeito dramático e bonitinho..."
                        },
                        {
                            "id": "698140108",
                            "speaker": "Diona",
                            "text": "Ei, pare com isso! Eu consigo ouvir você, sabia! Não subestime os ouvidos Kätzlein!"
                        },
                        {
                            "id": "698140109",
                            "speaker": "Diona",
                            "text": "Hunf. Tanto faz, eu não vou argumentar com você. Aqui, fique com algumas carnes. Peguei mais do que preciso, e eu ia dividir com todo mundo de qualquer forma se eu trouxesse isso de volta.",
                            "choices": [
                                {
                                    "id": "698140110",
                                    "text": "#Obrigad{M#o}{F#a}, Diona.",
                                    "response": [
                                        {
                                            "id": "698140112",
                                            "speaker": "Diona",
                                            "text": "Hehehe, e é bom você lembrar disso — e votar em mim se a cidade for escolher um campeão um dia. A última coisa que preciso é que você deixe aquele meu pai velho e bobo se sentindo o maioral."
                                        },
                                        {
                                            "id": "698140113",
                                            "speaker": "Uivo de Origem Desconhecida",
                                            "text": "Raaaarrr!"
                                        },
                                        {
                                            "id": "698140114",
                                            "speaker": "Diona",
                                            "text": "Ahhh!",
                                            "choices": [
                                                {
                                                    "id": "698140115",
                                                    "text": "Hã. Parece que a linhagem Kätzlein...",
                                                    "response": [
                                                        {
                                                            "id": "698140117",
                                                            "speaker": "Diona",
                                                            "text": "E—Eu não tenho medo desses lobos, ouviu? D-De jeito nenhum!"
                                                        },
                                                        {
                                                            "id": "698140118",
                                                            "speaker": "Diona",
                                                            "text": "Seria apenas... muito problemático se fossemos lutar, é só isso! E eu não vou dividir a minha caça com eles depois que eu lutei tanto por isso..."
                                                        },
                                                        {
                                                            "id": "698140119",
                                                            "speaker": "Diona",
                                                            "text": "Ei, o que você está esperando? Eles estão praticamente em cima de nós! ...Urg, vamos lá, vamos só embora logo!"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "698140116",
                                                    "text": "...Enfrenta seus próprios problemas também."
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "698140111",
                                    "text": "Você é a melhor caçadora do Vale Termal."
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "698140103",
                    "text": "Precisa de ajuda?"
                }
            ]
        }
    ]
}