                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "698180234",
                                    "text": "Acho que uma pose relaxada é melhor.",
                                    "response": [
                                        {
                                            "id": "698180235",
                                            "speaker": "Xianyun",
                                            "text": "Se eu soubesse, eu teria trazido aquele cinto de seda que Ganyu me deu... Que tal assim então, contra o vento...",
                                            "choices": [
                                                {
                                                    "id": "698180230",
