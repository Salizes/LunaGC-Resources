{
    "talkId": "6985801",
    "total_dialogue_lines": 36,
    "speaker_counts": {
        "Gato": 3,
        "Lauma": 19,
        "Player": 14
    },
    "dialogues": [
        {
            "id": "698580101",
            "speaker": "Lauma",
            "text": "*Zzz*"
        },
        {
            "id": "698580102",
            "speaker": "Player",
            "text": "(Ela tá dormindo? É melhor eu esperar até ela acordar...)"
        },
        {
            "id": "698580103",
            "speaker": "Player",
            "text": "(Ou talvez... será que é melhor voltar mais tarde?)"
        },
        {
            "id": "698580104",
            "speaker": "Lauma",
            "text": "Hehe...",
            "choices": [
                {
                    "id": "698580105",
                    "text": "Aah!",
                    "response": [
                        {
                            "id": "698580107",
                            "speaker": "Lauma",
                            "text": "Não precisa se desculpar."
                        },
                        {
                            "id": "698580108",
                            "speaker": "Lauma",
                            "text": "Eu não estava dormindo, só estava descansando os olhos."
                        },
                        {
                            "id": "698580109",
                            "speaker": "Lauma",
                            "text": "Além disso, esta criança ouviu seus passos e me avisou da sua presença."
                        },
                        {
                            "id": "698580110",
                            "speaker": "Lauma",
                            "text": "Os animais percebem mais do que nós, humanos. Sem dúvida, isso é uma bênção do Criador."
                        },
                        {
                            "id": "698580111",
                            "speaker": "Player",
                            "text": "#Obrigad{M#o}{F#a}, gatinho."
                        },
                        {
                            "id": "698580112",
                            "speaker": "Gato",
                            "text": "Miau."
                        },
                        {
                            "id": "698580113",
                            "speaker": "Player",
                            "text": "Ele reconheceu você como uma alma bondosa."
                        },
                        {
                            "id": "698580114",
                            "speaker": "Lauma",
                            "text": "Agora reconhece você como uma alma gentil."
                        },
                        {
                            "id": "698580115",
                            "speaker": "Lauma",
                            "text": "Esta criança me convenceu a pregar uma peça em você fingindo estar dormindo."
                        },
                        {
                            "id": "698580116",
                            "speaker": "Lauma",
                            "text": "#\"Vamos ver se {M#ele}{F#ela} espia você ou tenta roubar sua comida!\"",
                            "choices": [
                                {
                                    "id": "698580117",
                                    "text": "Ainda bem que eu não estendi a mão!",
                                    "response": [
                                        {
                                            "id": "698580119",
                                            "speaker": "Lauma",
                                            "text": "Embora eu confie no seu caráter nobre, até eu fiquei um pouco curiosa pra ver o que você faria, além disso, parecia bastante inofensivo."
                                        },
                                        {
                                            "id": "698580120",
                                            "speaker": "Lauma",
                                            "text": "Você pode nos perdoar?",
                                            "choices": [
                                                {
                                                    "id": "698580121",
                                                    "text": "Sem problema, tudo certo.",
                                                    "response": [
                                                        {
                                                            "id": "698580129",
                                                            "speaker": "Lauma",
                                                            "text": "Ah, acabei me esquecendo de perguntar. O que te traz aqui?"
                                                        },
                                                        {
                                                            "id": "698580130",
                                                            "speaker": "Player",
                                                            "text": "Só passei para ver como você estava."
                                                        },
                                                        {
                                                            "id": "698580131",
                                                            "speaker": "Lauma",
                                                            "text": "Hehe... Então é isso."
                                                        },
                                                        {
                                                            "id": "698580132",
                                                            "speaker": "Lauma",
                                                            "text": "Agradeço a sua preocupação. Está tudo bem comigo."
                                                        },
                                                        {
                                                            "id": "698580133",
                                                            "speaker": "Lauma",
                                                            "text": "Por acaso, recebemos uma grande quantidade de frutas frescas hoje. Gostaria de comer algumas comigo?"
                                                        },
                                                        {
                                                            "id": "698580134",
                                                            "speaker": "Gato",
                                                            "text": "Miau."
                                                        },
                                                        {
                                                            "id": "698580135",
                                                            "speaker": "Player",
                                                            "text": "O gato também come fruta?"
                                                        },
                                                        {
                                                            "id": "698580136",
                                                            "speaker": "Lauma",
                                                            "text": "Haha, ele não quer nos deixar. Está tentando encontrar algum consolo em um pouco de agitação neste breve momento de lazer."
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "698580122",
                                                    "text": "Que ousadia!",
                                                    "response": [
                                                        {
                                                            "id": "698580123",
                                                            "speaker": "Lauma",
                                                            "text": "#Acho que deixamos {M#ele}{F#ela} chatead{M#o}{F#a}. O que fazemos agora? Que tal você amassar a mão {M#dele}{F#dela} como pedido de desculpas?"
                                                        },
                                                        {
                                                            "id": "698580124",
                                                            "speaker": "Gato",
                                                            "text": "Miau."
                                                        },
                                                        {
                                                            "id": "698580125",
                                                            "speaker": "Player",
                                                            "text": "Você acha que eu deveria pedir desculpas?"
                                                        },
                                                        {
                                                            "id": "698580126",
                                                            "speaker": "Lauma",
                                                            "text": "Minhas palmas são iguais às de qualquer outro humano, receio que minha massagem talvez não seja tão agradável..."
                                                        },
                                                        {
                                                            "id": "698580127",
                                                            "speaker": "Lauma",
                                                            "text": "Mas posso lhe conceder as bênçãos da Canção Lunar e orar para que o caminho à sua frente seja tranquilo..."
                                                        },
                                                        {
                                                            "id": "698580128",
                                                            "speaker": "Player",
                                                            "text": "#Muito obrigad{M#o}{F#a}."
                                                        }
                                                    ]
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "698580118",
                                    "text": "Não acredito que você entrou na brincadeira..."
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "698580106",
                    "text": "Desculpa, eu te acordei..."
                }
            ]
        }
    ]
}