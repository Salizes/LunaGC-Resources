{
    "talkId": "6983003",
    "total_dialogue_lines": 23,
    "speaker_counts": {
        "Player": 8,
        "Shikanoin Heizou": 15
    },
    "dialogues": [
        {
            "id": "698300301",
            "speaker": "Shikanoin Heizou",
            "text": "Hmm, o Hanamizaka parece bem seguro hoje."
        },
        {
            "id": "698300302",
            "speaker": "Shikanoin Heizou",
            "text": "Uaaaah..."
        },
        {
            "id": "698300303",
            "speaker": "Shikanoin Heizou",
            "text": "Bem, já que estou aqui, tenho que comer algo antes de voltar e reportar para a Madame Kujou...",
            "choices": [
                {
                    "id": "698300304",
                    "text": "Te peguei!",
                    "response": [
                        {
                            "id": "698300306",
                            "speaker": "Shikanoin Heizou",
                            "text": "Não! Meu trabalho como Doushin acabou agora há pouco, e meu trabalho como detetive ainda não começou."
                        },
                        {
                            "id": "698300307",
                            "speaker": "Shikanoin Heizou",
                            "text": "#{NICKNAME}, sua acusação não é muito rigorosa.",
                            "choices": [
                                {
                                    "id": "698300308",
                                    "text": "Semântica, Heizou.",
                                    "response": [
                                        {
                                            "id": "698300310",
                                            "speaker": "Shikanoin Heizou",
                                            "text": "Eu não estava brincando. Estou me preparando para começar meu trabalho de detetive."
                                        },
                                        {
                                            "id": "698300311",
                                            "speaker": "Shikanoin Heizou",
                                            "text": "Recentemente, um grupo de pessoas estão vendendo poções proibidas perto da Hanamizaka."
                                        },
                                        {
                                            "id": "698300312",
                                            "speaker": "Shikanoin Heizou",
                                            "text": "Eles costumavam ser vendedores legítimos, mas, por algum motivo, se tornaram desonestos."
                                        },
                                        {
                                            "id": "698300313",
                                            "speaker": "Shikanoin Heizou",
                                            "text": "Eles estão usando seus negócios legítimos como disfarce para nos enganar. Os Doushins estão investigando isso há séculos, sem encontrar nada conclusivo."
                                        },
                                        {
                                            "id": "698300314",
                                            "speaker": "Shikanoin Heizou",
                                            "text": "Então, planejo resolver esse caso de uma vez por todas do meu jeito.",
                                            "choices": [
                                                {
                                                    "id": "698300315",
                                                    "text": "Precisa de ajuda?",
                                                    "response": [
                                                        {
                                                            "id": "698300317",
                                                            "speaker": "Shikanoin Heizou",
                                                            "text": "#Hahaha, obrigado, {NICKNAME}. Mas esse caso não é tão grave que precise de sua ajuda."
                                                        },
                                                        {
                                                            "id": "698300318",
                                                            "speaker": "Shikanoin Heizou",
                                                            "text": "Sango e os outros já estão investigando isso por um tempo. Já coletamos muitas pistas."
                                                        },
                                                        {
                                                            "id": "698300319",
                                                            "speaker": "Shikanoin Heizou",
                                                            "text": "Agora é a minha vez.",
                                                            "choices": [
                                                                {
                                                                    "id": "698300320",
                                                                    "text": "Isso vai ser moleza para o Grande Detetive Heizou.",
                                                                    "response": [
                                                                        {
                                                                            "id": "698300322",
                                                                            "speaker": "Shikanoin Heizou",
                                                                            "text": "#Obrigado, {NICKNAME}."
                                                                        },
                                                                        {
                                                                            "id": "698300323",
                                                                            "speaker": "Shikanoin Heizou",
                                                                            "text": "Se eu puder resolver esse caso, prometo que vou pagar um bom jantar para você."
                                                                        }
                                                                    ]
                                                                },
                                                                {
                                                                    "id": "698300321",
                                                                    "text": "O caso será resolvido."
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "698300316",
                                                    "text": "Vamos investigar juntos?"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "698300309",
                                    "text": "Quando você vai começar a trabalhar como um detetive?"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "698300305",
                    "text": "Detetive preguiçoso!"
                }
            ]
        }
    ]
}