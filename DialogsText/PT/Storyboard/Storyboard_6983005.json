{
    "talkId": "6983005",
    "total_dialogue_lines": 35,
    "speaker_counts": {
        "Player": 13,
        "Shikanoin Heizou": 22
    },
    "dialogues": [
        {
            "id": "698300501",
            "speaker": "Shikanoin Heizou",
            "text": "Não esperava que tivesse um ajudante inesperado..."
        },
        {
            "id": "698300502",
            "speaker": "Shikanoin Heizou",
            "text": "Ainda assim, pelo menos o caso está encerrado. Agora, quanto à Madame Kujou... *Suspiro* Preciso pensar em uma desculpa...",
            "choices": [
                {
                    "id": "698300503",
                    "text": "Você resolveu o caso?",
                    "response": [
                        {
                            "id": "698300505",
                            "speaker": "Shikanoin Heizou",
                            "text": "Hmm... Devo admitir que sem a ajuda da Dori, este caso não teria sido resolvido tão facilmente...",
                            "choices": [
                                {
                                    "id": "698300506",
                                    "text": "Dori? O que ela fez para ajudar?",
                                    "response": [
                                        {
                                            "id": "698300508",
                                            "speaker": "Shikanoin Heizou",
                                            "text": "A poção da Dori? Oh, deve ser o \"Tônico Milagroso Ultra-Incrível Garantido para Te Fazer Crescer Sem Nenhum Esforço!\" ou algo assim, né? Já ouvi falar dela."
                                        },
                                        {
                                            "id": "698300509",
                                            "speaker": "Shikanoin Heizou",
                                            "text": "Ela estava registrada na lista da Comissão Tenryou. Nós também testamos a poção."
                                        },
                                        {
                                            "id": "698300510",
                                            "speaker": "Shikanoin Heizou",
                                            "text": "É uma mistura de ervas inofensiva, e as próprias ervas são saudáveis, então, tecnicamente, isso realmente promove o crescimento."
                                        },
                                        {
                                            "id": "698300511",
                                            "speaker": "Player",
                                            "text": "Será que Dori estava falando a verdade?"
                                        },
                                        {
                                            "id": "698300512",
                                            "speaker": "Shikanoin Heizou",
                                            "text": "Hahaha, mas dê uma olhada no slogan dela: \"Tônico Milagroso Ultra-Incrível Garantido para Te Fazer Crescer Sem Nenhum Esforço!\"."
                                        },
                                        {
                                            "id": "698300513",
                                            "speaker": "Shikanoin Heizou",
                                            "text": "Ela mencionou em algum lugar quanto tempo levaria para crescer mais alto?",
                                            "choices": [
                                                {
                                                    "id": "698300514",
                                                    "text": "Ah!",
                                                    "response": [
                                                        {
                                                            "id": "698300516",
                                                            "speaker": "Shikanoin Heizou",
                                                            "text": "Na mosca. Beber isso pode promover o crescimento ao longo do tempo, mas quanto tempo você teria que beber antes de ver os resultados... Quem pode dizer?"
                                                        },
                                                        {
                                                            "id": "698300517",
                                                            "speaker": "Shikanoin Heizou",
                                                            "text": "Se você quer realmente ficar mais alto, por que você não bebe mais leite ao invés de beber aquela poção?",
                                                            "choices": [
                                                                {
                                                                    "id": "698300518",
                                                                    "text": "Por isso que ela está tão ansiosa...",
                                                                    "response": [
                                                                        {
                                                                            "id": "698300520",
                                                                            "speaker": "Shikanoin Heizou",
                                                                            "text": "Sim. Na minha opinião, a Srta. Dori também sabe que o \"efeito\" dessa suposta poção não é significante."
                                                                        },
                                                                        {
                                                                            "id": "698300521",
                                                                            "speaker": "Shikanoin Heizou",
                                                                            "text": "É exatamente por isso que ela colocou tanta energia em promovê-la com marketing, direcionando a atenção de todos exatamente para onde ela queria."
                                                                        },
                                                                        {
                                                                            "id": "698300522",
                                                                            "speaker": "Shikanoin Heizou",
                                                                            "text": "Não é à toa que Dori estava tão disposta a nos ajudar... Ela nem se importou em falar sobre o pagamento.",
                                                                            "choices": [
                                                                                {
                                                                                    "id": "698300523",
                                                                                    "text": "Que tipo de ajuda?",
                                                                                    "response": [
                                                                                        {
                                                                                            "id": "698300525",
                                                                                            "speaker": "Shikanoin Heizou",
                                                                                            "text": "É, graças a Dori que finalmente encontrei a chave para resolver o caso."
                                                                                        },
                                                                                        {
                                                                                            "id": "698300526",
                                                                                            "speaker": "Shikanoin Heizou",
                                                                                            "text": "Quando eu pedi ajuda a ela, eu pensei que ela fosse cobrar uma quantia exorbitante, mas ela não cobrou nada..."
                                                                                        },
                                                                                        {
                                                                                            "id": "698300527",
                                                                                            "speaker": "Shikanoin Heizou",
                                                                                            "text": "Dori provavelmente já pegou todos os parceiros comerciais legítimos e canais de distribuição que restavam para a gangue criminosa.",
                                                                                            "choices": [
                                                                                                {
                                                                                                    "id": "698300528",
                                                                                                    "text": "Não é à toa que ela está tão confiante...",
                                                                                                    "response": [
                                                                                                        {
                                                                                                            "id": "698300530",
                                                                                                            "speaker": "Shikanoin Heizou",
                                                                                                            "text": "Esqueça, não entendo como os comerciantes pensam."
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "698300531",
                                                                                                            "speaker": "Shikanoin Heizou",
                                                                                                            "text": "Mas com uma \"informante\" bem conectada como a Srta. Dori por perto, os casos futuros devem ser muito mais fáceis de resolver..."
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "698300532",
                                                                                                            "speaker": "Shikanoin Heizou",
                                                                                                            "text": "...Ahem. A Madame Kujou não está aqui, não é? Ótimo, isso é bom..."
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "698300533",
                                                                                                            "speaker": "Shikanoin Heizou",
                                                                                                            "text": "Uh, desculpe, mas preciso voltar para a Comissão Yashiro agora. Senão, a Madame Kujou ficará irritada comigo."
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "698300534",
                                                                                                            "speaker": "Shikanoin Heizou",
                                                                                                            "text": "#Até mais, {NICKNAME}."
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "698300535",
                                                                                                            "speaker": "Shikanoin Heizou",
                                                                                                            "text": "Não cometa nenhum crime."
                                                                                                        }
                                                                                                    ]
                                                                                                },
                                                                                                {
                                                                                                    "id": "698300529",
                                                                                                    "text": "Não é à toa que ela de repente começou a vender poções..."
                                                                                                }
                                                                                            ]
                                                                                        }
                                                                                    ]
                                                                                },
                                                                                {
                                                                                    "id": "698300524",
                                                                                    "text": "Aquele caso sobre as poções proibidas?"
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                },
                                                                {
                                                                    "id": "698300519",
                                                                    "text": "Pedindo para Sayu aparecer, pedindo para um mágico aparecer..."
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "698300515",
                                                    "text": "Não mencionou nada disso..."
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "698300507",
                                    "text": "Eu acabei de pegar uma poção com ela..."
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "698300504",
                    "text": "Muito bem, Heizou!"
                }
            ]
        }
    ]
}