{
    "talkId": "6984601",
    "total_dialogue_lines": 44,
    "speaker_counts": {
        "Foquinha Rotunda": 8,
        "Freminet": 24,
        "Player": 12
    },
    "dialogues": [
        {
            "id": "698460101",
            "speaker": "Freminet",
            "text": "...Eu também gosto de mergulhar."
        },
        {
            "id": "698460102",
            "speaker": "Foquinha Rotunda",
            "text": "...",
            "choices": [
                {
                    "id": "698460103",
                    "text": "Olá, Freminet!",
                    "response": [
                        {
                            "id": "698460105",
                            "speaker": "Freminet",
                            "text": "...Olá, há quanto tempo não nos vemos. Eu estava... conversando com ela."
                        },
                        {
                            "id": "698460106",
                            "speaker": "Player",
                            "text": "Com uma Foquinha Rotunda?"
                        },
                        {
                            "id": "698460107",
                            "speaker": "Freminet",
                            "text": "Uhum... Pode ser estranho para você...",
                            "choices": [
                                {
                                    "id": "698460108",
                                    "text": "De jeito nenhum! Posso me juntar a você?",
                                    "response": [
                                        {
                                            "id": "698460110",
                                            "speaker": "Freminet",
                                            "text": "Sério? Eu pensei que... isso era só algo que acontecia em livros ilustrados.",
                                            "choices": [
                                                {
                                                    "id": "698460111",
                                                    "text": "E o que essas histórias dizem?",
                                                    "response": [
                                                        {
                                                            "id": "698460113",
                                                            "speaker": "Freminet",
                                                            "text": "Tudo bem, então compartilharei elas com você."
                                                        },
                                                        {
                                                            "id": "698460114",
                                                            "speaker": "Foquinha Rotunda",
                                                            "text": "Awuu?"
                                                        },
                                                        {
                                                            "id": "698460115",
                                                            "speaker": "Freminet",
                                                            "text": "Você também quer ouvir? Certo, escute bem."
                                                        },
                                                        {
                                                            "id": "698460116",
                                                            "speaker": "Foquinha Rotunda",
                                                            "text": "Awuu~ Awuuwuu~~"
                                                        },
                                                        {
                                                            "id": "698460117",
                                                            "speaker": "Freminet",
                                                            "text": "As lendas falam de há muito, muito tempo, quando havia uma Foquinha Rotunda que se distanciou de sua família e amigo, e viveu sozinho na escuridão das profundezas do oceano."
                                                        },
                                                        {
                                                            "id": "698460118",
                                                            "speaker": "Freminet",
                                                            "text": "Mesmo que tenha vivido corajosamente em solitude, ele continuava procurando por sua família. Até que um dia, um mergulhador que adorava explorar o encontrou."
                                                        },
                                                        {
                                                            "id": "698460119",
                                                            "speaker": "Freminet",
                                                            "text": "Essa Foquinha Rotunda nunca havia visto um humano antes, e no início estava assustada. Mas o mergulhador deu-lhe um monte de comida e prometeu voltar no dia seguinte."
                                                        },
                                                        {
                                                            "id": "698460120",
                                                            "speaker": "Freminet",
                                                            "text": "E assim, logo se tornaram amigos. Todas às vezes que o mergulhador aparecia, a Foquinha Rotunda dançava alegremente e batia em sua barriga, cantando as canções das Foquinhas Rotundas."
                                                        },
                                                        {
                                                            "id": "698460121",
                                                            "speaker": "Freminet",
                                                            "text": "O mergulhador também adorava sua barriguinha rotunda, e não conseguia resistir em dar vários carinhos nela..."
                                                        },
                                                        {
                                                            "id": "698460122",
                                                            "speaker": "Freminet",
                                                            "text": "A Foquinha Rotunda também adorava a sensação dos carinhos, mas já que tinha uma péssima visão, apenas conseguia ver a silhueta borrada do mergulhador."
                                                        },
                                                        {
                                                            "id": "698460123",
                                                            "speaker": "Freminet",
                                                            "text": "Então, sempre que via um humano se aproximar, dançava alegremente, batendo em sua barriga e cantando."
                                                        },
                                                        {
                                                            "id": "698460124",
                                                            "speaker": "Foquinha Rotunda",
                                                            "text": "Awuu! Awuu! Awuu!",
                                                            "choices": [
                                                                {
                                                                    "id": "698460125",
                                                                    "text": "Tão fofo! Preciso fazer uma coceirinha!",
                                                                    "response": [
                                                                        {
                                                                            "id": "698460127",
                                                                            "speaker": "Foquinha Rotunda",
                                                                            "text": "Awuuuuu! Awuu!"
                                                                        },
                                                                        {
                                                                            "id": "698460128",
                                                                            "speaker": "Freminet",
                                                                            "text": "Bom garoto, aqui, um peixe. Acabei de pegar, então, bon appetit."
                                                                        },
                                                                        {
                                                                            "id": "698460129",
                                                                            "speaker": "Player",
                                                                            "text": "Então... é assim que a história acaba?"
                                                                        },
                                                                        {
                                                                            "id": "698460130",
                                                                            "speaker": "Freminet",
                                                                            "text": "Hmm... Eu queria que tivesse sido aí que a história acabasse, mas... Um dia, aquele mergulhador simplesmente parou de vir."
                                                                        },
                                                                        {
                                                                            "id": "698460131",
                                                                            "speaker": "Freminet",
                                                                            "text": "A Foquinha Rotunda esperou por muito, muito tempo. Finalmente, ele teve coragem de sair para procurar o mergulhador, nadando na direção que o mergulhador nadava, até que finalmente chegou à praia."
                                                                        },
                                                                        {
                                                                            "id": "698460132",
                                                                            "speaker": "Freminet",
                                                                            "text": "É aí que o livro ilustrado que tenho acaba. Não sei o resto da história. Nossos dois amigos podem ter..."
                                                                        },
                                                                        {
                                                                            "id": "698460133",
                                                                            "speaker": "Foquinha Rotunda",
                                                                            "text": "Awuuu..."
                                                                        },
                                                                        {
                                                                            "id": "698460134",
                                                                            "speaker": "Freminet",
                                                                            "text": "*Suspira* Não fique triste. É só uma história, não é real... eu acho...",
                                                                            "choices": [
                                                                                {
                                                                                    "id": "698460135",
                                                                                    "text": "Acho que eles se reunirão em breve.",
                                                                                    "response": [
                                                                                        {
                                                                                            "id": "698460137",
                                                                                            "speaker": "Freminet",
                                                                                            "text": "...É. Tenho certeza que irá."
                                                                                        },
                                                                                        {
                                                                                            "id": "698460138",
                                                                                            "speaker": "Foquinha Rotunda",
                                                                                            "text": "Awuu! Awuu! Awuu!"
                                                                                        },
                                                                                        {
                                                                                            "id": "698460139",
                                                                                            "speaker": "Freminet",
                                                                                            "text": "Quer mais peixe? Me dê um segundo... Eu ainda devo ter alguns..."
                                                                                        },
                                                                                        {
                                                                                            "id": "698460140",
                                                                                            "speaker": "Freminet",
                                                                                            "text": "...Me pergunto, qual a sensação da barriguinha de uma Foquinha Rotunda?"
                                                                                        },
                                                                                        {
                                                                                            "id": "698460141",
                                                                                            "speaker": "Freminet",
                                                                                            "text": "...Hmmmm!"
                                                                                        },
                                                                                        {
                                                                                            "id": "698460142",
                                                                                            "speaker": "Foquinha Rotunda",
                                                                                            "text": "Awuu? Awuuu... Awuu."
                                                                                        },
                                                                                        {
                                                                                            "id": "698460143",
                                                                                            "speaker": "Freminet",
                                                                                            "text": "Então... acho que vou tentar?"
                                                                                        },
                                                                                        {
                                                                                            "id": "698460144",
                                                                                            "speaker": "Freminet",
                                                                                            "text": "Uau... Isso realmente é algo. Bem diferente da sensação de tocar no gatinho de Lynette..."
                                                                                        }
                                                                                    ]
                                                                                },
                                                                                {
                                                                                    "id": "698460136",
                                                                                    "text": "Esta história terá um final feliz."
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                },
                                                                {
                                                                    "id": "698460126",
                                                                    "text": "Barriguinha! Tenho que coçar!"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "698460112",
                                                    "text": "Eu gostaria de ouvir mais sobre esses contos."
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "698460109",
                                    "text": "Eu também tenho amiguinhas Foquinhas Rotundas, sabe!?"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "698460104",
                    "text": "O que você está fazendo aqui?"
                }
            ]
        }
    ]
}