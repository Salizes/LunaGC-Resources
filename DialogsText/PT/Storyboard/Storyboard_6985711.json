    "dialogues": [
        {
            "id": "698571103",
            "speaker": "Clorinde",
            "text": "#Se {M#ele estiver}{F#ela estiver} dispost{M#o}{F#a} a se juntar a nós. Aliás, estamos jogando no \"Modo Fácil\" para acomodar os novatos."
        },
        {
            "id": "698571104",
            "speaker": "Navia",
            "text": "#{NICKNAME}, gostaria de continuar a aventura com a gente? Você com certeza gostaria, né?",
            "choices": [
                {
                    "id": "698571105",
                    "text": "Desculpa, o quê? O que aconteceu?",
                    "response": [
                        {
                            "id": "698571107",
                            "speaker": "Jahoda",
                            "text": "Ah, qual é! Se ficar fazendo mais perguntas, esses explosivos vão mandar a gente pelos ares!",
                            "choices": [
                                {
                                    "id": "698571108",
                                    "text": "E-eu vou!",
                                    "response": [
                                        {
                                            "id": "698571110",
                                            "speaker": "Clorinde",
                                            "text": "Ótimo. Já faz um tempo desde a última vez que você jogou uma campanha, então talvez tenha uma chance de escolher suas habilidades de novo."
                                        },
                                        {
                                            "id": "698571111",
                                            "speaker": "Clorinde",
                                            "text": "As habilidades que você pode modificar são \"cozinhar\" e \"medicina\". O que acha? Quer fazer alguma mudança?",
                                            "choices": [
                                                {
                                                    "id": "698571112",
                                                    "text": "Aprender \"cozinhar\"...",
                                                    "response": [
                                                        {
                                                            "id": "698571113",
                                                            "speaker": "Clorinde",
                                                            "text": "Muito bem. Nesse caso, você quer aprender a habilidade \"cozinhar\", certo?",
                                                            "choices": [
                                                                {
                                                                    "id": "698571116",
                                                                    "text": "Sim, certeza."
                                                                },
                                                                {
                                                                    "id": "698571117",
                                                                    "text": "Deixe-me reconsiderar..."
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "698571114",
                                                    "text": "Aprender \"medicina\"...",
                                                    "response": [
                                                        {
                                                            "id": "698571115",
                                                            "speaker": "Clorinde",
                                                            "text": "Muito bem. Nesse caso, você deseja aprender a habilidade de \"medicina\", certo?",
                                                            "choices": [
                                                                {
                                                                    "id": "698571116",
                                                                    "text": "Sim, certeza."
                                                                },
                                                                {
                                                                    "id": "698571117",
                                                                    "text": "Deixe-me reconsiderar..."
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "698571109",
                                    "text": "Eu vou entrar, eu vou entrar..."
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "698571106",
                    "text": "Continuar a aventura? Vamos continuar dali do..."
                }
            ]
        }
    ]
