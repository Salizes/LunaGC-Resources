{
    "talkId": "6867204",
    "total_dialogue_lines": 7,
    "speaker_counts": {
        "Registros de Observante da Lua": 7
    },
    "dialogues": [
        {
            "id": "686720401",
            "speaker": "Registros de Observante da Lua",
            "text": "\"...Foi a queda de uma estrela...\""
        },
        {
            "id": "686720402",
            "speaker": "Registros de Observante da Lua",
            "text": "\"...Foi a alma de uma estrela...\""
        },
        {
            "id": "686720403",
            "speaker": "Registros de Observante da Lua",
            "text": "\"...Ela está me chamando... como uma sopa chama a mesa...\""
        },
        {
            "id": "686720404",
            "speaker": "Registros de Observante da Lua",
            "text": "\"...Ah, estou te ouvindo, Ó Ysna'qurel, Rei de Throgg... Você foi engolido pelo abismo sombrio...\""
        },
        {
            "id": "686720405",
            "speaker": "Registros de Observante da Lua",
            "text": "\"...Então carregue essa mensagem com você...\""
        },
        {
            "id": "686720406",
            "speaker": "Registros de Observante da Lua",
            "text": "\"...Ba-Uru-Nammu-Ungien-Corpo Sombrio...\""
        },
        {
            "id": "686720407",
            "speaker": "Registros de Observante da Lua",
            "text": "\"...Você sou eu, e eu sou você...\""
        }
    ]
}