    "dialogues": [
        {
            "id": "80090801",
            "speaker": "Paimon",
            "text": "#Tem uma caixa ali. Por que nós não abrimos? Uh, por \"nós\", Paimon quer dizer só você, {NICKNAME}... Paimon tem medo... que o que estiver dentro dela arranque os dedos de Paimon...",
            "choices": [
                {
                    "id": "80090802",
                    "text": "O que raios está passando pela sua cabeça...",
                    "response": [
                        {
                            "id": "80090804",
                            "speaker": "Paimon",
                            "text": "Hã? Isso é... um espelho."
                        },
                        {
                            "id": "80090805",
                            "speaker": "Paimon",
                            "text": "E também está quebrado. Isso era uma caixa de maquiagem?",
                            "choices": [
                                {
                                    "id": "80090806",
                                    "text": "É só um espelho comum.",
                                    "response": [
                                        {
                                            "id": "80090808",
                                            "speaker": "Paimon",
                                            "text": "Hmm. Isso é meio... frustrante. Paimon esperava que a gente fosse descobrir algum super segredo, especialmente depois de Dain ficar falando tudo aquilo sobre esse lugar."
                                        }
                                    ]
                                },
                                {
                                    "id": "80090807",
                                    "text": "Está todo quebrado."
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "80090803",
                    "text": "A sua paranoia vai te enlouquecer..."
                }
            ]
        }
    ]
}