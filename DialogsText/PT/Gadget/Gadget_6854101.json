    "dialogues": [
        {
            "id": "685410101",
            "speaker": "Arataki Itto",
            "text": "Aqui, sua mesada."
        },
        {
            "id": "685410102",
            "speaker": "Mamoru",
            "text": "Eita! Posso comprar minha Light Novel favorita!"
        },
        {
            "id": "685410103",
            "speaker": "Genta",
            "text": "Hmm... Talvez eu devesse economizar?"
        },
        {
            "id": "685410104",
            "speaker": "Akira",
            "text": "Alguém a fim de Espeto de Três Sabores?"
        },
        {
            "id": "685410105",
            "speaker": "Arataki Itto",
            "text": "...!"
        },
        {
            "id": "685410106",
            "speaker": "Mamoru",
            "text": "Vou fazer isso! Valeu, Chefe!"
        },
        {
            "id": "685410107",
            "speaker": "Arataki Itto",
            "text": "...!!!"
        },
        {
            "id": "685410108",
            "speaker": "Genta",
            "text": "C-Chefe?"
        },
        {
            "id": "685410109",
            "speaker": "Arataki Itto",
            "text": "Vocês esqueceram para que sua mesada serve?"
        },
        {
            "id": "685410110",
            "speaker": "Arataki Itto",
            "text": "É para gastar... Num deck de Chamado Sagrado dos Sete novinho!"
        },
        {
            "id": "685410111",
            "speaker": "Multidão",
            "text": "Chamado Sagrado dos Sete: Um campeão trilha o caminho para a vitória!"
        },
        {
            "id": "685410112",
            "speaker": "Kuki Shinobu",
            "text": "Me lembra qual de nós é o campeão mesmo?"
        }
    ]
}