            "dialogues": [
                {
                    "id": "641690201",
                    "speaker": "Player",
                    "text": "Você é..."
                },
                {
                    "id": "641690202",
                    "speaker": "Shyam",
                    "text": "Fui eleito pelos moradores locais... Hmm... Posso ser considerado um xerife."
                },
                {
                    "id": "641690203",
                    "speaker": "Shyam",
                    "text": "Eles devem saber que no passado já fui um mercenário dos Eremitas e já fiz muitos... trabalhos, e por isso me deram essa função."
                },
                {
                    "id": "641690204",
                    "speaker": "Shyam",
                    "text": "Este é um trabalho à minha altura. Se precisar de algo, fale comigo."
                },
                {
                    "id": "641690205",
                    "speaker": "Shyam",
                    "text": "Mas se estiver pensando em arranjar encrenca sob a minha guarda, pense duas vezes."
                }
            ]
        },
        {
            "talkId": "6416903",
            "initDialog": "641690301",
            "dialogues": [
                {
                    "id": "641690301",
                    "speaker": "Player",
                    "text": "No momento, não."
                },
                {
                    "id": "641690302",
                    "speaker": "Shyam",
                    "text": "Isso seria o melhor a se fazer."
                }
            ]
        }
