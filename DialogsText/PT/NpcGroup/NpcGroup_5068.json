    "talks": [
        {
            "talkId": "6506801",
            "initDialog": "650680101",
            "dialogues": [
                {
                    "id": "650680101",
                    "speaker": "Lisette",
                    "text": "Aonde devo me aventurar a seguir?"
                }
            ]
        },
        {
            "talkId": "6506802",
            "initDialog": "650680201",
            "dialogues": [
                {
                    "id": "650680201",
                    "speaker": "Player",
                    "text": "Aventurar, você diz?"
                },
                {
                    "id": "650680202",
                    "speaker": "Lisette",
                    "text": "Isso mesmo. Minha aventura tem sido incrível! Todos me tratam bem, especialmente as pessoas na Spina di Rosula."
                }
            ]
        },
        {
            "talkId": "6506803",
            "initDialog": "650680301",
            "dialogues": [
                {
                    "id": "650680301",
                    "speaker": "Player",
                    "text": "Até depois."
                },
                {
                    "id": "650680302",
                    "speaker": "Lisette",
                    "text": "Sim, até mais!"
                }
            ]
        },
        {
            "talkId": "6506804",
            "initDialog": "650680401",
            "dialogues": [
                {
                    "id": "650680401",
                    "speaker": "Player",
                    "text": "Você não é daqui originalmente?"
                },
                {
                    "id": "650680402",
                    "speaker": "Lisette",
                    "text": "Hmm, eu... não me lembro."
                },
                {
                    "id": "650680403",
                    "speaker": "Lisette",
                    "text": "Um dia, quando eu acordei, eu só... estava aqui. Talvez meu pai e minha mãe me abandonaram ou algo assim..."
                }
            ]
        },
        {
            "talkId": "6506805",
            "initDialog": "650680501",
            "dialogues": [
                {
                    "id": "650680501",
                    "speaker": "Player",
                    "text": "Isso não é sua culpa."
                },
                {
                    "id": "650680502",
                    "speaker": "Lisette",
                    "text": "Eu sei. Todos aqui também me dizem isso."
                },
                {
                    "id": "650680503",
                    "speaker": "Lisette",
                    "text": "Todos aqui são super amigáveis, e estou vivendo muito bem. Mesmo se eu não voltar... Digo, ficaria tudo bem ficar aqui para sempre!"
                }
            ]
        }
    ]
}