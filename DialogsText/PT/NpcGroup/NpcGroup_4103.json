            "dialogues": [
                {
                    "id": "641030401",
                    "speaker": "Player",
                    "text": "Quem é Raranana?"
                },
                {
                    "id": "641030402",
                    "speaker": "Nima",
                    "text": "Amiguinhos rechonchudos."
                },
                {
                    "id": "641030403",
                    "speaker": "Nima",
                    "text": "Raranana se esgueira por aí enquanto os adultos estão fora, igual a mim, fugindo dos trabalhos na roça."
                },
                {
                    "id": "641030404",
                    "speaker": "Nima",
                    "text": "Mas Minoo sempre riu de mim por acreditar em Raranana, e ficou zangado comigo porque eu falo o nome errado."
                },
                {
                    "id": "641030405",
                    "speaker": "Nima",
                    "text": "Eu já vi Raranana com meus próprios olhos... Eles são o povo planta, Raranana existe, tenho certeza!"
                }
            ]
