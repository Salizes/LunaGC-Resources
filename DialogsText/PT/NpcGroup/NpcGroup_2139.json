        {
            "talkId": "6213901",
            "initDialog": "621390101",
            "dialogues": [
                {
                    "id": "621390101",
                    "speaker": "Zhi",
                    "text": "Olá. Como posso ajudar?"
                }
            ]
        },
        {
            "talkId": "6213902",
            "initDialog": "621390201",
            "dialogues": [
                {
                    "id": "621390201",
                    "speaker": "Player",
                    "text": "O que você está fazendo?"
                },
                {
                    "id": "621390202",
                    "speaker": "Zhi",
                    "text": "Ah, estou memorizando os nomes das ervas medicinais."
                },
                {
                    "id": "621390203",
                    "speaker": "Zhi",
                    "text": "Quer dizer, quando você vai coletar ervas nas montanhas, se você nem sabe o que está coletando, isso não seria uma brincadeira?"
                }
            ]
        },
        {
            "talkId": "6213903",
            "initDialog": "621390301",
            "dialogues": [
                {
                    "id": "621390301",
                    "speaker": "Player",
                    "text": "Você vive por aqui?"
                },
                {
                    "id": "621390302",
                    "speaker": "Zhi",
                    "text": "Sim. Muitos amigos da minha idade escolheram trabalhar ou viver no porto de Liyue, mas no final eu decidi ficar."
                },
                {
                    "id": "621390303",
                    "speaker": "Zhi",
                    "text": "Talvez porque eu tenho o nariz oriundo das montanhas, que não aguenta o cheiro de mar."
                },
                {
                    "id": "621390304",
                    "speaker": "Zhi",
                    "text": "Os idosos na vila têm dificuldades em andar, então eu tenho que colher as ervas medicinais por eles."
                }
            ]
        },
        {
            "talkId": "6213904",
            "initDialog": "621390401",
            "dialogues": [
                {
                    "id": "621390401",
                    "speaker": "Player",
                    "text": "Adeus."
                },
                {
                    "id": "621390402",
                    "speaker": "Zhi",
                    "text": "Até mais, e olhe por ande anda!"
                }
            ]
        }
    ]
}