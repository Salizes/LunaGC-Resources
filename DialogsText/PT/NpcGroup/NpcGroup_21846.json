    "talks": [
        {
            "talkId": "1504452",
            "initDialog": "150445201",
            "dialogues": [
                {
                    "id": "150445201",
                    "speaker": "Chasca",
                    "text": "No passado, minha ideia de diversão sempre foi procurar desafios emocionantes..."
                },
                {
                    "id": "150445202",
                    "speaker": "Chasca",
                    "text": "Mas, essa viagem me fez perceber que passar tempo relaxando desse jeito não é tão ruim assim..."
                }
            ]
        },
        {
            "talkId": "1504552",
            "initDialog": "150455201",
            "dialogues": [
                {
                    "id": "150455201",
                    "speaker": "Chasca",
                    "text": "Tá a fim de outro desafio?"
                }
            ]
        },
        {
            "talkId": "1504583",
            "initDialog": "150458301",
            "dialogues": [
                {
                    "id": "150458301",
                    "speaker": "Player",
                    "text": "Que tal eu tirar uma foto para você?"
                },
                {
                    "id": "150458302",
                    "speaker": "Chasca",
                    "text": "Claro, vamos nessa."
                },
                {
                    "id": "150458303",
                    "speaker": "Chasca",
                    "text": "Eu estava pensando em dar algo assim para minha \"mãe\", mas a conhecendo, ela provavelmente só ia levantar as asas e estalar a língua para mim por não a visitar com frequência..."
                },
                {
                    "id": "150458304",
                    "speaker": "Chasca",
                    "text": "Acho que vou ficar com isso como lembrança."
                }
            ]
        },
        {
            "talkId": "1504584",
            "initDialog": "150458401",
            "dialogues": [
                {
                    "id": "150458401",
                    "speaker": "Player",
                    "text": "Maravilha."
                },
                {
                    "id": "150458402",
                    "speaker": "Chasca",
                    "text": "Tudo bem, então, vamos lá."
                }
            ]
        },
        {
            "talkId": "1504585",
            "initDialog": "150458501",
            "dialogues": [
                {
                    "id": "150458501",
                    "speaker": "Player",
                    "text": "Talvez depois?"
                },
                {
                    "id": "150458502",
                    "speaker": "Chasca",
                    "text": "Claro, quando for de boa para você."
                }
            ]
        }
    ]
}