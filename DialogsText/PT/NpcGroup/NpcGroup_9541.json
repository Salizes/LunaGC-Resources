        },
        {
            "talkId": "6954105",
            "initDialog": "695410501",
            "dialogues": [
                {
                    "id": "695410501",
                    "speaker": "Yanfei",
                    "text": "Certo, vou precisar anotar jogada por jogada dessa partida e fazer uma análise... Na próxima vez, vou estar pronta!"
                }
            ]
        },
        {
            "talkId": "6954106",
            "initDialog": "695410601",
            "dialogues": [
                {
                    "id": "695410601",
                    "speaker": "Yanfei",
                    "text": "Claro. Eu acho que já memorizei todas as regras, então estou pronta para um desafio."
                }
