        },
        {
            "talkId": "6954102",
            "initDialog": "695410201",
            "dialogues": [
                {
                    "id": "695410201",
                    "speaker": "Player",
                    "text": "Que tal uma partida de Chamado Sagrado dos Sete?"
                }
            ]
        },
        {
            "talkId": "6954103",
            "initDialog": "695410301",
            "dialogues": [
                {
                    "id": "695410301",
                    "speaker": "Player",
                    "text": "No momento, preciso resolver outras coisas..."
                },
                {
                    "id": "695410302",
                    "speaker": "Yanfei",
                    "text": "Você já tá indo embora? Eu vou ficar e estudar o livro de regras mais um pouco. Não entendi muito bem essa cláusula..."
