        },
        {
            "talkId": "6954104",
            "initDialog": "695410401",
            "dialogues": [
                {
                    "id": "695410401",
                    "speaker": "Yanfei",
                    "text": "Essa partida foi emblemática. Deveriam colocar ela nos manuais do futuro."
