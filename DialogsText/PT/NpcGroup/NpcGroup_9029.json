{
    "groupId": "9029",
    "total_dialogue_lines": 70,
    "speaker_counts": {
        "Klee": 49,
        "Player": 21
    },
    "talks": [
        {
            "talkId": "6902901",
            "initDialog": "690290101",
            "dialogues": [
                {
                    "id": "690290101",
                    "speaker": "Klee",
                    "text": "#Ah, é {F#a Cavaleira}{M#o Cavaleiro} Honorável!"
                },
                {
                    "id": "690290102",
                    "speaker": "Klee",
                    "text": "Estou muito feliz de ver você novamente!"
                }
            ]
        },
        {
            "talkId": "6902902",
            "initDialog": "690290201",
            "dialogues": [
                {
                    "id": "690290201",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>Você se acostumou com esse lugar?</color>"
                },
                {
                    "id": "690290202",
                    "speaker": "Klee",
                    "text": "É realmente divertido aqui."
                },
                {
                    "id": "690290203",
                    "speaker": "Klee",
                    "text": "A casa é enorme e tem vários quartos."
                },
                {
                    "id": "690290204",
                    "speaker": "Klee",
                    "text": "Há muitas coisas novas por aqui. Vai demorar um bom tempo para correr de uma ponta à outra do caminho.",
                    "choices": [
                        {
                            "id": "690290205",
                            "text": "Parece que você está se divertindo.",
                            "response": [
                                {
                                    "id": "690290206",
                                    "speaker": "Klee",
                                    "text": "Se divertindo muuuuuuito!"
                                },
                                {
                                    "id": "690290207",
                                    "speaker": "Klee",
                                    "text": "Se você tiver tempo, Klee pode levar você para brincar!"
                                },
                                {
                                    "id": "690290212",
                                    "speaker": "Klee",
                                    "text": "Pegar lagartos, caçar sapos, desenhar, fazer artesanato, esconde-esconde... Há tantas coisas divertidas para fazer!"
                                }
                            ]
                        },
                        {
                            "id": "690290208",
                            "text": "Você não tem feito travessuras, não é mesmo?",
                            "response": [
                                {
                                    "id": "690290209",
                                    "speaker": "Klee",
                                    "text": "Não! Definitivamente não!"
                                },
                                {
                                    "id": "690290210",
                                    "speaker": "Klee",
                                    "text": "#A Mestre Jean avisou Klee várias vezes que eu não posso destruir a casa {F#da Cavaleira}{M#do Cavaleiro} Honorável."
                                },
                                {
                                    "id": "690290211",
                                    "speaker": "Klee",
                                    "text": "Então eu não trouxe nenhum de meus tesouros."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6902903",
            "initDialog": "690290301",
            "dialogues": [
                {
                    "id": "690290301",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>Você quer conversar comigo?</color>"
                },
                {
                    "id": "690290302",
                    "speaker": "Klee",
                    "text": "Certo, eu quero! Eu gosto de conversar."
                },
                {
                    "id": "690290303",
                    "speaker": "Klee",
                    "text": "Ah, posso te mostrar a coisa legal mais recente que eu encontrei.",
                    "choices": [
                        {
                            "id": "690290304",
                            "text": "Outra coisa legal?",
                            "response": [
                                {
                                    "id": "690290306",
                                    "speaker": "Klee",
                                    "text": "Olha só isso! Uma rede de pesca incrível!"
                                },
                                {
                                    "id": "690290307",
                                    "speaker": "Klee",
                                    "text": "Deixa eu te ensinar! Você espalha a rede no lago assim... Espera o momento certo e..."
                                },
                                {
                                    "id": "690290308",
                                    "speaker": "Klee",
                                    "text": "Fuuuah! Você puxa ela."
                                },
                                {
                                    "id": "690290309",
                                    "speaker": "Klee",
                                    "text": "Você tem que ter certeza de que está se escondendo silenciosamente, depois pegar ele de surpresa!",
                                    "choices": [
                                        {
                                            "id": "690290310",
                                            "text": "Isso foi incrível.",
                                            "response": [
                                                {
                                                    "id": "690290311",
                                                    "speaker": "Klee",
                                                    "text": "Hehe, Klee te contou todos os seus segredos. Agora você pode ser tão incrível quanto a Klee!"
                                                },
                                                {
                                                    "id": "690290314",
                                                    "speaker": "Klee",
                                                    "text": "Mas esse método é bem mais chato do que usar bombas..."
                                                },
                                                {
                                                    "id": "690290315",
                                                    "speaker": "Klee",
                                                    "text": "Os peixes são escorregadios e se sacodem muito, então eles saltarão de volta à água se você não os segurar com força."
                                                },
                                                {
                                                    "id": "690290316",
                                                    "speaker": "Klee",
                                                    "text": "Mas... Também é divertido brincar com os peixes deste jeito!",
                                                    "choices": [
                                                        {
                                                            "id": "690290317",
                                                            "text": "Se você estiver comigo, não se preocupe, pode usar suas bombas.",
                                                            "response": [
                                                                {
                                                                    "id": "690290318",
                                                                    "speaker": "Klee",
                                                                    "text": "Oh! Sério?"
                                                                },
                                                                {
                                                                    "id": "690290319",
                                                                    "speaker": "Klee",
                                                                    "text": "Então espere por mim! Eu posso fazer muitas bombas muito rápido porque já preparei os materiais!"
                                                                },
                                                                {
                                                                    "id": "690290323",
                                                                    "speaker": "Klee",
                                                                    "text": "Hee hee, estou super feliz!"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "690290320",
                                                            "text": "Vamos ter uma competição de pesca na próxima vez.",
                                                            "response": [
                                                                {
                                                                    "id": "690290321",
                                                                    "speaker": "Klee",
                                                                    "text": "Oba!"
                                                                },
                                                                {
                                                                    "id": "690290322",
                                                                    "speaker": "Klee",
                                                                    "text": "Se você perder, quem fará o jantar é você!"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "690290312",
                                            "text": "Por que você não está explodindo os peixes?",
                                            "response": [
                                                {
                                                    "id": "690290313",
                                                    "speaker": "Klee",
                                                    "text": "Porque essa é a sua casa, eu não posso sair explodindo tudo..."
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "690290305",
                            "text": "Então, quais são essas informações?"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6902904",
            "initDialog": "690290401",
            "dialogues": [
                {
                    "id": "690290401",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>O que você gostaria de fazer?</color>"
                },
                {
                    "id": "690290402",
                    "speaker": "Klee",
                    "text": "Sim! Eu tenho algo que preciso de sua ajuda!"
                },
                {
                    "id": "690290403",
                    "speaker": "Klee",
                    "text": "Eu quero fazer um exército de Bombinhas Dançantes!",
                    "choices": [
                        {
                            "id": "690290404",
                            "text": "...Bombinhas Dançantes?",
                            "response": [
                                {
                                    "id": "690290405",
                                    "speaker": "Klee",
                                    "text": "Sim, um exército de Bombinhas Dançantes! São várias... Várias e várias Bombinhas Dançantes."
                                },
                                {
                                    "id": "690290406",
                                    "speaker": "Klee",
                                    "text": "#Por favoooorrr, {NICKNAME}!"
                                },
                                {
                                    "id": "690290407",
                                    "speaker": "Player",
                                    "text": "Está bem..."
                                },
                                {
                                    "id": "690290410",
                                    "speaker": "Klee",
                                    "text": "Bem, vamos começar a trabalhar então!"
                                },
                                {
                                    "id": "690290411",
                                    "speaker": "Klee",
                                    "text": "#Klee fica responsável por fazer bombinhas dançantes e {NICKNAME} fica responsável por criar personagens para elas."
                                },
                                {
                                    "id": "690290412",
                                    "speaker": "Klee",
                                    "text": "Precisamos de um vendedor, de um Chef, um pintor e membros do circo...",
                                    "choices": [
                                        {
                                            "id": "690290413",
                                            "text": "Parece que não existem pessoas assim nos Cavaleiros de Favonius...",
                                            "response": [
                                                {
                                                    "id": "690290414",
                                                    "speaker": "Klee",
                                                    "text": "Não tem problema! Todos podem vir para o Ludi Harpastum!"
                                                },
                                                {
                                                    "id": "690290417",
                                                    "speaker": "Klee",
                                                    "text": "#Com um Exército de Bombinhas Dançantes, Klee poderá se divertir no Ludi Harpastum todos os dias com {NICKNAME}!"
                                                },
                                                {
                                                    "id": "690290418",
                                                    "speaker": "Klee",
                                                    "text": "Um Ludi Harpastum com você é o melhor Ludi Harpastum!"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "690290415",
                                            "text": "Parece um pouco complicado.",
                                            "response": [
                                                {
                                                    "id": "690290416",
                                                    "speaker": "Klee",
                                                    "text": "Não é nada demais. Só basta que todos usem pequenos acessórios para que possam diferenciar suas identidades!"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "690290408",
                            "text": "Eu posso ajudar.",
                            "response": [
                                {
                                    "id": "690290409",
                                    "speaker": "Klee",
                                    "text": "#{NICKNAME}, você é {F#a}{M#o} melhor!"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6902905",
            "initDialog": "690290501",
            "dialogues": [
                {
                    "id": "690290501",
                    "speaker": "Player",
                    "text": "Bom dia, Klee."
                },
                {
                    "id": "690290502",
                    "speaker": "Klee",
                    "text": "#Bom dia, {F#Cavaleira}{M#Cavaleiro} Honorável!"
                },
                {
                    "id": "690290503",
                    "speaker": "Klee",
                    "text": "Você quer levar Klee para uma aventura? Klee mal consegue esperar!"
                }
            ]
        },
        {
            "talkId": "6902906",
            "initDialog": "690290601",
            "dialogues": [
                {
                    "id": "690290601",
                    "speaker": "Player",
                    "text": "Boa noite, Klee."
                },
                {
                    "id": "690290602",
                    "speaker": "Klee",
                    "text": "Klee ainda não quer dormir..."
                },
                {
                    "id": "690290603",
                    "speaker": "Klee",
                    "text": "#Mas... Klee prometeu a você que iria se comportar bem, então... Boa noite, {NICKNAME}."
                }
            ]
        },
        {
            "talkId": "6902907",
            "initDialog": "690290701",
            "dialogues": [
                {
                    "id": "690290701",
                    "speaker": "Player",
                    "text": "Quer conversar comigo?"
                }
            ]
        },
        {
            "talkId": "6902908",
            "initDialog": "690290801",
            "dialogues": [
                {
                    "id": "690290801",
                    "speaker": "Player",
                    "text": "Gostaria de fazer alguma coisa?"
                }
            ]
        },
        {
            "talkId": "6902909",
            "initDialog": "690290901",
            "dialogues": [
                {
                    "id": "690290901",
                    "speaker": "Player",
                    "text": "Você já se acostumou com esse lugar?"
                }
            ]
        },
        {
            "talkId": "6902950",
            "initDialog": "690295001",
            "dialogues": [
                {
                    "id": "690295001",
                    "speaker": "Klee",
                    "text": "Klee deve saber como usar essa oficina!"
                },
                {
                    "id": "690295002",
                    "speaker": "Klee",
                    "text": "Apesar de ter coisas que não parecem muito comuns, só preciso usar algumas vezes para me familiarizar!"
                },
                {
                    "id": "690295003",
                    "speaker": "Klee",
                    "text": "#Obrigada, {F#Cavaleira}{M#Cavaleiro} Honorável!"
                }
            ]
        },
        {
            "talkId": "6902951",
            "initDialog": "690295101",
            "dialogues": [
                {
                    "id": "690295101",
                    "speaker": "Klee",
                    "text": "Que lugar familiar... Parece que eu já o explodi antes... Não... Eu já vi um quarto como esse!"
                },
                {
                    "id": "690295102",
                    "speaker": "Klee",
                    "text": "Enfim, aqui é bem espaçoso. Vou poder brincar bem feliz!"
                },
                {
                    "id": "690295103",
                    "speaker": "Klee",
                    "text": "#Cavaleir{F#a}{M#o} Honorável, vamos nos divertir junt{F#as}{M#os}!"
                }
            ]
        }
    ]
}