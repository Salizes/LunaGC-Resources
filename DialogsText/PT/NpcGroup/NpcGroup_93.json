            "dialogues": [
                {
                    "id": "3125601",
                    "speaker": "Teste de Missão NPC",
                    "text": "Ei, Viajante!"
                },
                {
                    "id": "3125602",
                    "speaker": "Teste de Missão NPC",
                    "text": "Ali na frente está muito perigoso, não vá por ali.",
                    "choices": [
                        {
                            "id": "3125603",
                            "text": "... O que foi?",
                            "response": [
                                {
                                    "id": "3125604",
                                    "speaker": "Teste de Missão NPC",
                                    "text": "O caminho à frente é perigoso. Uma caravana foi atacada por monstros poderosos na trilha da montanha."
                                },
                                {
                                    "id": "3125605",
                                    "speaker": "Teste de Missão NPC",
                                    "text": "É melhor sairmos daqui se não quisermos encrenca."
                                }
                            ]
                        },
                        {
                            "id": "3125606",
                            "text": "Adeus.",
                            "response": [
                                {
                                    "id": "3125607",
                                    "speaker": "Teste de Missão NPC",
                                    "text": "Vá com cuidado."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "31257",
            "initDialog": "3125701",
            "dialogues": [
                {
                    "id": "3125701",
                    "speaker": "Teste de Missão NPC",
                    "text": "A Zona de Perigo está a sua frente... Hã? Por acaso você...",
                    "choices": [
                        {
                            "id": "3125702",
                            "text": "... O que foi?",
                            "response": [
                                {
                                    "id": "3125703",
                                    "speaker": "Teste de Missão NPC",
                                    "text": "Seu traje... Seria você, o viajante de quem eles falaram?"
                                },
                                {
                                    "id": "3125704",
                                    "speaker": "Teste de Missão NPC",
                                    "text": "Hã? Você não? Suas ações heroicas já se espalharam por Mondstadt. Ouvi dizer que foi você quem pôs fim às tempestades que aterrorizaram Mondstadt!"
                                },
                                {
                                    "id": "3125705",
                                    "speaker": "Teste de Missão NPC",
                                    "text": "Embora eu acredite que você consiga lidar com os monstros à frente, ainda assim você precisa tomar cuidado."
                                }
                            ]
                        },
                        {
                            "id": "3125706",
                            "text": "Adeus.",
                            "response": [
                                {
                                    "id": "3125707",
                                    "speaker": "Teste de Missão NPC",
                                    "text": "Vá com cuidado."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6009301",
            "initDialog": "4015140501",
            "dialogues": [
                {
                    "id": "4015140501",
                    "speaker": "Anna",
                    "text": "Olá. Tem algo que *cof* eu possa fazer por você? *cof*"
                }
            ]
        },
        {
            "talkId": "6009302",
            "initDialog": "4015140502",
            "dialogues": [
                {
                    "id": "4015140502",
                    "speaker": "Anna",
                    "text": "O que você está fazendo?"
                },
                {
                    "id": "4015140506",
                    "speaker": "Anna",
                    "text": "Eu estou... *Cof cof* fazendo um desejo."
                },
                {
                    "id": "4015140507",
                    "speaker": "Anna",
                    "text": "Eu só atiro a moeda *cof* na piscina assim, e *cof* faço um pedido..."
                },
                {
                    "id": "4015140508",
                    "speaker": "Anna",
                    "text": "Você deve ser *cof cof* sincero e fazê-lo todos os dias para a Fada da Fonte ouvir você... *Cof cof*"
                },
                {
                    "id": "4015140509",
                    "speaker": "Anna",
                    "text": "Desculpe... eu não consigo parar de tossir."
                },
                {
                    "id": "4015140503",
                    "speaker": "Anna",
                    "text": "O que você deseja?"
                },
                {
                    "id": "4015140510",
                    "speaker": "Anna",
                    "text": "Oh... * cof cof* Eu tenho estado doente por muito tempo."
                },
                {
                    "id": "4015140511",
                    "speaker": "Anna",
                    "text": "Eu queria que *cof cof* a Fada da Fonte pudesse curar minha tosse."
                },
                {
                    "id": "4015140512",
                    "speaker": "Anna",
                    "text": "Desse modo, não vou mais dar trabalho para a mamãe, papai, e meu irmão Anthony..."
                }
            ]
        },
        {
            "talkId": "6009303",
            "initDialog": "4015140505",
            "dialogues": [
                {
                    "id": "4015140505",
                    "speaker": "Anna",
                    "text": "Desculpe pelo incômodo."
                },
                {
                    "id": "4015140517",
                    "speaker": "Anna",
                    "text": "Fique bem."
                },
                {
                    "id": "4015140518",
                    "speaker": "Anna",
                    "text": "Eu espero que *cof* todos os seus desejos sejam realizados logo... *cof*"
                }
            ]
        }
    ]
