        },
        {
            "talkId": "4001309",
            "initDialog": "400130901",
            "dialogues": [
                {
                    "id": "400130901",
                    "speaker": "Jean",
                    "text": "Eu não tinha ideia de que tudo isso poderia ser uma criação de Alice."
                },
                {
                    "id": "400130902",
                    "speaker": "Jean",
                    "text": "Agora que sei a verdade... Há uma certa ternura na paisagem ao nosso redor."
                },
                {
                    "id": "400130903",
                    "speaker": "Jean",
                    "text": "Um verão tão lindo... O que poderia ser um presente melhor?"
                },
                {
                    "id": "400130904",
                    "speaker": "Jean",
                    "text": "Oh! Por falar nisso... Eu ainda tenho uma promessa a cumprir com a Klee. Esses peixes não vão se explodir sozinhos."
                },
                {
                    "id": "400130905",
                    "speaker": "Jean",
                    "text": "Viajante, gostaria de participar de uma recreação inocente?"
                }
            ]
