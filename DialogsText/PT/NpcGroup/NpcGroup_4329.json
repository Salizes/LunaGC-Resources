            "dialogues": [
                {
                    "id": "643290101",
                    "speaker": "Bahram",
                    "text": "Vender coisas aqui é uma forma de passar o tempo."
                }
            ]
        },
        {
            "talkId": "6432902",
            "initDialog": "643290201",
            "dialogues": [
                {
                    "id": "643290201",
                    "speaker": "Player",
                    "text": "Como vão os negócios?"
                },
                {
                    "id": "643290202",
                    "speaker": "Bahram",
                    "text": "É o suficiente para me manter vivo."
                },
                {
                    "id": "643290203",
                    "speaker": "Bahram",
                    "text": "Esta é uma área chave no caminho do rio para Sumeru, por isso, muitas caravanas passam por aqui o ano inteiro."
                },
                {
                    "id": "643290204",
                    "speaker": "Bahram",
                    "text": "Mas se você seguir o caminho do rio, chegará ao Porto Ormos, por isso poucos comerciantes ficam por aqui."
                },
                {
                    "id": "643290205",
                    "speaker": "Bahram",
                    "text": "Mas isso também é uma coisa boa. Menos comerciantes significa menos concorrência."
                }
            ]
        },
        {
            "talkId": "6432903",
            "initDialog": "643290301",
            "dialogues": [
                {
                    "id": "643290301",
                    "speaker": "Player",
                    "text": "Adeus."
                },
                {
                    "id": "643290302",
                    "speaker": "Bahram",
                    "text": "Vá com cuidado."
                }
            ]
        }
    ]
}