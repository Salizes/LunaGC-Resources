{
    "groupId": "2154",
    "total_dialogue_lines": 54,
    "speaker_counts": {
        "Paimon": 7,
        "Player": 21,
        "Taliesin": 26
    },
    "talks": [
        {
            "talkId": "6215401",
            "initDialog": "621540101",
            "dialogues": [
                {
                    "id": "621540101",
                    "speaker": "Taliesin",
                    "text": "Desculpe... Estou um pouco tonto, mas eu consigo aguentar! Ah..."
                }
            ]
        },
        {
            "talkId": "6215402",
            "initDialog": "621540201",
            "dialogues": [
                {
                    "id": "621540201",
                    "speaker": "Player",
                    "text": "O que você está fazendo aqui?"
                },
                {
                    "id": "621540202",
                    "speaker": "Taliesin",
                    "text": "Eu me considero um bardo à moda antiga, por isso vim até aqui procurar inspiração."
                },
                {
                    "id": "621540203",
                    "speaker": "Taliesin",
                    "text": "Mas eu nunca entrei em uma mina... Além disso, quando eu vim eu estava com pressa..."
                },
                {
                    "id": "621540204",
                    "speaker": "Taliesin",
                    "text": "Ah, que dor..."
                }
            ]
        },
        {
            "talkId": "6215403",
            "initDialog": "621540301",
            "dialogues": [
                {
                    "id": "621540301",
                    "speaker": "Player",
                    "text": "Não lhe incomodarei mais..."
                },
                {
                    "id": "621540302",
                    "speaker": "Taliesin",
                    "text": "Ah, sim, se você tiver novas histórias, conte elas para mim!"
                }
            ]
        },
        {
            "talkId": "7104115",
            "initDialog": "710411501",
            "dialogues": [
                {
                    "id": "710411501",
                    "speaker": "Taliesin",
                    "text": "#Nós encontramos de novo, {NICKNAME} de cabelos loiros!",
                    "choices": [
                        {
                            "id": "710411502",
                            "text": "Taliesin, você veio para duelar?",
                            "response": [
                                {
                                    "id": "710411503",
                                    "speaker": "Paimon",
                                    "text": "Hã? Sobre o que você está falando?"
                                },
                                {
                                    "id": "710411505",
                                    "speaker": "Taliesin",
                                    "text": "#Haha, estou aqui para buscar inspiração, é claro! Escute só: {M#um herói}{F#uma heroína} sem passado, sem nenhum clã, e sua leal companheira fadinha!"
                                },
                                {
                                    "id": "710411506",
                                    "speaker": "Paimon",
                                    "text": "Quem...?"
                                },
                                {
                                    "id": "710411507",
                                    "speaker": "Player",
                                    "text": "Quem...?"
                                },
                                {
                                    "id": "710411508",
                                    "speaker": "Taliesin",
                                    "text": "#Veja, veja! Ó {M#modesto herói}{F#modesta heroína}, não dirija seu olhar perplexo para as montanhas distantes, pois, nestas terras obscuras, você é a própria luz!"
                                },
                                {
                                    "id": "710411509",
                                    "speaker": "Paimon",
                                    "text": "Ah...?"
                                },
                                {
                                    "id": "710411510",
                                    "speaker": "Player",
                                    "text": "Quê...?"
                                },
                                {
                                    "id": "710411511",
                                    "speaker": "Taliesin",
                                    "text": "Estou falando sobre você! Digo, uma versão mais literária de você, é claro."
                                },
                                {
                                    "id": "710411512",
                                    "speaker": "Player",
                                    "text": "Oh..."
                                },
                                {
                                    "id": "710411513",
                                    "speaker": "Paimon",
                                    "text": "Hã, então esse sujeito realmente consegue dizer coisas que podemos entender..."
                                },
                                {
                                    "id": "710411514",
                                    "speaker": "Player",
                                    "text": "Adeus."
                                },
                                {
                                    "id": "710411515",
                                    "speaker": "Taliesin",
                                    "text": "#Até mais, {NICKNAME} de cabelos loiros!"
                                }
                            ]
                        },
                        {
                            "id": "710411504",
                            "text": "O que você está fazendo aqui?"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7108019",
            "initDialog": "710801901",
            "dialogues": [
                {
                    "id": "710801901",
                    "speaker": "Player",
                    "text": "Me desculpe, mas eu não tenho nenhuma história nova para você no momento."
                },
                {
                    "id": "710801902",
                    "speaker": "Taliesin",
                    "text": "Oh, mesmo? Não importa. Se você encontrar novas histórias em suas aventuras, conte elas para mim!"
                }
            ]
        },
        {
            "talkId": "7108020",
            "initDialog": "710802001",
            "dialogues": [
                {
                    "id": "710802001",
                    "speaker": "Player",
                    "text": "Me desculpe, mas eu não tenho nenhuma história nova para você no momento."
                },
                {
                    "id": "710802002",
                    "speaker": "Taliesin",
                    "text": "Oh, mesmo? Não importa. Jornadas de aventura são infinitas, e os contos de aventuras também serão!"
                }
            ]
        },
        {
            "talkId": "7108801",
            "initDialog": "710880101",
            "dialogues": [
                {
                    "id": "710880101",
                    "speaker": "Taliesin",
                    "text": "Hmm... Não, não, não é assim que funciona, de acordo com a genealogia..."
                },
                {
                    "id": "710880102",
                    "speaker": "Taliesin",
                    "text": "Hã? Oh! Me desculpe, eu não vi que vocês estavam aqui!",
                    "choices": [
                        {
                            "id": "710880103",
                            "text": "Você...",
                            "response": [
                                {
                                    "id": "710880105",
                                    "speaker": "Taliesin",
                                    "text": "#{F#Shh! Shh! *COF* Ela veio! Ela veio! Seus olhos brilhantes como a lua prateada, sua armadura formidável e invencível! Ela é——}{M#Shh! Shh! *COF* Ele veio! Ele veio! Sua espada brilhando como a lua pratada, e até exércitos tremem com sua chegada! Ele é——}"
                                },
                                {
                                    "id": "710880106",
                                    "speaker": "Paimon",
                                    "text": "#{F#A loira}{M#O loiro}!",
                                    "choices": [
                                        {
                                            "id": "710880107",
                                            "text": "Ei!",
                                            "response": [
                                                {
                                                    "id": "710880109",
                                                    "speaker": "Paimon",
                                                    "text": "Hehe... Me desculpe, é o costume. Acabou saindo...",
                                                    "choices": [
                                                        {
                                                            "id": "710880110",
                                                            "text": "Que tipo de costume é esse?!",
                                                            "response": [
                                                                {
                                                                    "id": "710880112",
                                                                    "speaker": "Paimon",
                                                                    "text": "Hmm, Paimon acha que o apelido podia ser ainda mais feio..."
                                                                },
                                                                {
                                                                    "id": "710880113",
                                                                    "speaker": "Player",
                                                                    "text": "Ei!"
                                                                },
                                                                {
                                                                    "id": "710880114",
                                                                    "speaker": "Taliesin",
                                                                    "text": "Hahahaha! Paimon está certa!"
                                                                },
                                                                {
                                                                    "id": "710880115",
                                                                    "speaker": "Taliesin",
                                                                    "text": "#... {F#Ela}{M#Ele} é {NICKNAME} com cabelos loiros!"
                                                                },
                                                                {
                                                                    "id": "710880116",
                                                                    "speaker": "Player",
                                                                    "text": "Eu sou totalmente contra esses apelidos horríveis!"
                                                                },
                                                                {
                                                                    "id": "710880117",
                                                                    "speaker": "Taliesin",
                                                                    "text": "Me desculpe, me desculpe... Eu não queria lhe ofender, mas poetas \"clássicos\" de Mondstadt costumam começar desse jeito."
                                                                },
                                                                {
                                                                    "id": "710880118",
                                                                    "speaker": "Player",
                                                                    "text": "\"Clássicos\"?"
                                                                },
                                                                {
                                                                    "id": "710880119",
                                                                    "speaker": "Taliesin",
                                                                    "text": "Bem, deixe-me explicar. Eu não estou falando de músicas antigas como \"Pastoral do Dandelion\" ou poemas de amor como \"Traição no casamento, eu te odeio\"..."
                                                                },
                                                                {
                                                                    "id": "710880120",
                                                                    "speaker": "Taliesin",
                                                                    "text": "Eu estou falando de poesias épicas clássicas."
                                                                },
                                                                {
                                                                    "id": "710880121",
                                                                    "speaker": "Player",
                                                                    "text": "O que é isso?"
                                                                },
                                                                {
                                                                    "id": "710880122",
                                                                    "speaker": "Taliesin",
                                                                    "text": "Em termos simples, é a adaptação de genealogias heroicas, é o adicionar de carne e pele sobre o esqueleto da história."
                                                                },
                                                                {
                                                                    "id": "710880123",
                                                                    "speaker": "Taliesin",
                                                                    "text": "Esses épicos cantam sobre a história numa forma de uma poesia longa, despertando o povo para o conhecimento do passado. Bem, aí está, esse é o valor do épico para a sociedade."
                                                                },
                                                                {
                                                                    "id": "710880124",
                                                                    "speaker": "Taliesin",
                                                                    "text": "A habilidade da poesia para despertar a consciência histórica foi precisamente porque foi banida pelos aristocratas do passado."
                                                                },
                                                                {
                                                                    "id": "710880125",
                                                                    "speaker": "Taliesin",
                                                                    "text": "Eles temiam que nós lembraríamos de nossa liberdade e história de resistência."
                                                                },
                                                                {
                                                                    "id": "710880126",
                                                                    "speaker": "Taliesin",
                                                                    "text": "E é por isso que eu desprezo a poesia popular de hoje e busco reviver a Poesia Clássica Épica."
                                                                },
                                                                {
                                                                    "id": "710880127",
                                                                    "speaker": "Player",
                                                                    "text": "Oh, adeus."
                                                                },
                                                                {
                                                                    "id": "710880128",
                                                                    "speaker": "Taliesin",
                                                                    "text": "#Hmm, bem, até mais, {NICKNAME}, {F#A Loira}{M#O Loiro}!"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "710880111",
                                                            "text": "Não teve nem um pouco de criatividade."
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "710880108",
                                            "text": "Paimon!"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "710880104",
                            "text": "Eu sou..."
                        }
                    ]
                }
            ]
        }
    ]
}