        {
            "talkId": "6410602",
            "initDialog": "641060201",
            "dialogues": [
                {
                    "id": "641060201",
                    "speaker": "Player",
                    "text": "Quais reservas?"
                },
                {
                    "id": "641060202",
                    "speaker": "Mozhgan",
                    "text": "Rosa de Sumeru, Menta, Lótus Nilotpala, etc."
                },
                {
                    "id": "641060203",
                    "speaker": "Mozhgan",
                    "text": "Não subestime estas pequenas plantas, você se beneficiará muito se souber como utilizá-las."
                },
                {
                    "id": "641060204",
                    "speaker": "Mozhgan",
                    "text": "Por exemplo, se você moer a Rosa de Sumeru e misturar com água, poderá aplicá-la em seu rosto trazendo o brilho e frescor para sua pele!"
                },
                {
                    "id": "641060205",
                    "speaker": "Mozhgan",
                    "text": "Então me escute, sempre tenha algumas Rosas de Sumeru em casa."
                }
            ]
        },
        {
            "talkId": "6410603",
            "initDialog": "641060301",
            "dialogues": [
                {
                    "id": "641060301",
                    "speaker": "Player",
                    "text": "Adeus."
                },
                {
                    "id": "641060302",
                    "speaker": "Mozhgan",
                    "text": "Tchau."
                }
            ]
        },
        {
            "talkId": "7394501",
            "initDialog": "739450101",
            "dialogues": [
                {
                    "id": "739450101",
                    "speaker": "Player",
                    "text": "Funciona mesmo?"
                },
                {
                    "id": "739450102",
                    "speaker": "Mozhgan",
                    "text": "Bem... Pelo menos na minha experiência, vai funcionar de uma forma ou de outra."
                },
                {
                    "id": "739450103",
                    "speaker": "Mozhgan",
                    "text": "De qualquer forma, não vai doer tentar. Apenas tente a sua sorte."
                }
            ]
        }
    ]
