    "talks": [
        {
            "talkId": "6424201",
            "initDialog": "642420101",
            "dialogues": [
                {
                    "id": "642420101",
                    "speaker": "Aranaga",
                    "text": "Nova Árvore Ashvattha trouxe a tenra, invisível e intangível \"esperança\"."
                }
            ]
        },
        {
            "talkId": "6424202",
            "initDialog": "642420201",
            "dialogues": [
                {
                    "id": "642420201",
                    "speaker": "Player",
                    "text": "Olá..."
                },
                {
                    "id": "642420202",
                    "speaker": "Aranaga",
                    "text": "#Olá, Nara {NICKNAME}."
                },
                {
                    "id": "642420203",
                    "speaker": "Aranaga",
                    "text": "Vocês pararam Marana. Fizeram com que a floresta que começava a definhar voltasse a vida. Gratidão a você, e a fofinha Branca Voadora."
                }
            ]
        },
        {
            "talkId": "6424203",
            "initDialog": "642420301",
            "dialogues": [
                {
                    "id": "642420301",
                    "speaker": "Player",
                    "text": "Adeus..."
                },
                {
                    "id": "642420302",
                    "speaker": "Aranaga",
                    "text": "#Adeus... Nara {NICKNAME}."
                }
            ]
        },
        {
            "talkId": "6424204",
            "initDialog": "642420401",
            "dialogues": [
                {
                    "id": "642420401",
                    "speaker": "Aranaga",
                    "text": "Memórias caídas, novos amigos em crescimento, parece com a Erva Yajna. Ao menos é o que Aranaga pensa."
                }
            ]
        },
        {
            "talkId": "6424205",
            "initDialog": "642420501",
            "dialogues": [
                {
                    "id": "642420501",
                    "speaker": "Player",
                    "text": "Sobre a Erva Yajna..."
                },
                {
                    "id": "642420502",
                    "speaker": "Aranaga",
                    "text": "Erva Yajna tornou-se poeira ao vento, Nara provavelmente vê dessa maneira."
                },
                {
                    "id": "642420503",
                    "speaker": "Aranaga",
                    "text": "Entretanto... toda vez que uma nova Erva Yajna gera novos brotos, tudo volta à vida a partir das gramíneas da floresta como as lembranças das folhas verdes que se esvoaçaram, enterradas profundamente e sem vestígios."
                },
                {
                    "id": "642420504",
                    "speaker": "Aranaga",
                    "text": "#Nara {NICKNAME} e a Branca Voadora são iguais, novos e velhos amigos, pois, se separaram e se reunirão novamente."
                }
            ]
        },
        {
            "talkId": "6424206",
            "initDialog": "642420601",
            "dialogues": [
                {
                    "id": "642420601",
                    "speaker": "Player",
                    "text": "Sobre \"Mawtiyima\"..."
                },
                {
                    "id": "642420602",
                    "speaker": "Aranaga",
                    "text": "Sem a intrusão de Marana, Mawtiyima irá novamente cobrir as árvores e flores... após a lua emergir e desaparecer."
                },
                {
                    "id": "642420603",
                    "speaker": "Aranaga",
                    "text": "#Aranaga deve agradecer a Nara {NICKNAME} e a Branca Voadora."
                }
            ]
        },
        {
            "talkId": "6424207",
            "initDialog": "642420701",
            "dialogues": [
                {
                    "id": "642420701",
                    "speaker": "Player",
                    "text": "Adeus."
                },
                {
                    "id": "642420702",
                    "speaker": "Aranaga",
                    "text": "#Adeus, amig{F#as}{M#os} nov{F#as}{M#os}."
                }
            ]
        }
    ]
}