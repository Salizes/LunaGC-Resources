            "dialogues": [
                {
                    "id": "640710101",
                    "speaker": "Zakariya",
                    "text": "Olá, precisa de ajuda?"
                }
            ]
        },
        {
            "talkId": "6407102",
            "initDialog": "640710201",
            "dialogues": [
                {
                    "id": "640710201",
                    "speaker": "Player",
                    "text": "Que lugar é esse?"
                },
                {
                    "id": "640710202",
                    "speaker": "Zakariya",
                    "text": "O Bimarstan é onde a Academia presta assistência médica gratuita para a população. Os médicos aqui são todos pesquisadores e estudantes."
                },
                {
                    "id": "640710203",
                    "speaker": "Zakariya",
                    "text": "Independentemente de seu status social, todos podem se banhar à luz da \"Cura\" aqui."
                },
                {
                    "id": "640710204",
                    "speaker": "Zakariya",
                    "text": "A \"Cura\" é o resultado da percepção dos sábios na orientação dos deuses."
                },
                {
                    "id": "640710205",
                    "speaker": "Zakariya",
                    "text": "Pelo menos é o que diz no Manual do Médico."
                }
            ]
        },
        {
            "talkId": "6407103",
            "initDialog": "640710301",
            "dialogues": [
                {
                    "id": "640710301",
                    "speaker": "Player",
                    "text": "Agora não."
                },
                {
                    "id": "640710302",
                    "speaker": "Zakariya",
                    "text": "Lhe desejo boa saúde."
                }
            ]
        }
    ]
}