            "dialogues": [
                {
                    "id": "643800401",
                    "speaker": "Player",
                    "text": "Você me recomendaria algum livro?"
                },
                {
                    "id": "643800402",
                    "speaker": "Hunayn",
                    "text": "#Isso depende de qual Darshan e assuntos você está interessad{M#o}{F#a}."
                },
                {
                    "id": "643800403",
                    "speaker": "Hunayn",
                    "text": "Posso te dar uma lista baseada nisso."
                },
                {
                    "id": "643800404",
                    "speaker": "Hunayn",
                    "text": "Porém apenas pesquisadores e estudantes da Academia podem pegar livros emprestados da Casa de Daena, então você precisará de uma licença."
