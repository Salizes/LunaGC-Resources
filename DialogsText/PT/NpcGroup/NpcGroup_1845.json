    "talks": [
        {
            "talkId": "6180105",
            "initDialog": "618010501",
            "dialogues": [
                {
                    "id": "618010501",
                    "speaker": "Lohen",
                    "text": "#Ah, olá, Cavaleir{F#a}{M#o} Honorável!"
                },
                {
                    "id": "618010502",
                    "speaker": "Player",
                    "text": "...O que exatamente você está fazendo?"
                },
                {
                    "id": "618010503",
                    "speaker": "Lohen",
                    "text": "Exatamente o que parece: prática de tiro! Afinal, eu sou o Vice-Capitão da Companhia de Ataque à Distância."
                },
                {
                    "id": "618010504",
                    "speaker": "Lohen",
                    "text": "Pessoalmente, eu prefiro muito mais a adrenalina de cair dentro da luta, bem de perto... Mas não dá para negligenciar nosso sustento aqui na Companhia de Ataque à Distância."
                },
                {
                    "id": "618010505",
                    "speaker": "Player",
                    "text": "Nesse caso... e essa maçã?"
                },
                {
                    "id": "618010506",
                    "speaker": "Lohen",
                    "text": "Ah, não sou eu que estou praticando, são aqueles dois. Ei! A mira já ficou firme?"
                },
                {
                    "id": "618010507",
                    "speaker": "Ursula",
                    "text": "M—Minhas... minhas mãos não param de tremer!"
                },
                {
                    "id": "618010508",
                    "speaker": "Gunther",
                    "text": "E—E m—meus olhos! Não consigo mantê-los firmes!",
                    "choices": [
                        {
                            "id": "618010509",
                            "text": "...Você é o alvo!?",
                            "response": [
                                {
                                    "id": "618010511",
                                    "speaker": "Lohen",
                                    "text": "Ha! Um pouco de pressão é a melhor motivação, não é? Além disso, a munição deles não vai me machucar."
                                },
                                {
                                    "id": "618010512",
                                    "speaker": "Player",
                                    "text": "Se é assim... por que eles estão tremendo?"
                                },
                                {
                                    "id": "618010513",
                                    "speaker": "Lohen",
                                    "text": "Porque, se eles errarem... vão ter que passar pelo meu \"treino especial\" depois. Heh."
                                }
                            ]
                        },
                        {
                            "id": "618010510",
                            "text": "E se eles errarem!?"
                        }
                    ]
                }
            ]
        }
    ]
}