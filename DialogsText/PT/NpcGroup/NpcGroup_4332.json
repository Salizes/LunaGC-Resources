    },
    "talks": [
        {
            "talkId": "6433201",
            "initDialog": "643320101",
            "dialogues": [
                {
                    "id": "643320101",
                    "speaker": "Yuewen",
                    "text": "Esse é um ótimo lugar para passar as férias, não acha?"
                }
            ]
        },
        {
            "talkId": "6433202",
            "initDialog": "643320201",
            "dialogues": [
                {
                    "id": "643320201",
                    "speaker": "Player",
                    "text": "Você veio de Liyue?"
                },
                {
                    "id": "643320202",
                    "speaker": "Yuewen",
                    "text": "Sim, vim de lá. Você pode chegar ao Porto Ormos seguindo o curso do rio."
                },
                {
                    "id": "643320203",
                    "speaker": "Yuewen",
                    "text": "Acabei de descarregar um monte de carga lá e ganhei um dinheiro, então pensei em descansar na Vila Vimara antes de voltar para Liyue."
                },
                {
                    "id": "643320204",
                    "speaker": "Yuewen",
                    "text": "Mas percebi que esse lugar é um paraíso para se relaxar... Não consigo partir."
                }
            ]
        },
        {
            "talkId": "6433203",
            "initDialog": "643320301",
            "dialogues": [
                {
                    "id": "643320301",
                    "speaker": "Player",
                    "text": "É verdade."
                },
                {
                    "id": "643320302",
                    "speaker": "Yuewen",
                    "text": "Parece que concordamos. Excelente."
                }
            ]
        },
        {
            "talkId": "7395201",
            "initDialog": "739520101",
            "dialogues": [
                {
                    "id": "739520101",
                    "speaker": "Player",
                    "text": "Você quer se estabelecer?"
                },
                {
                    "id": "739520102",
                    "speaker": "Yuewen",
                    "text": "Também estou pensando nisso."
                },
                {
                    "id": "739520103",
                    "speaker": "Yuewen",
                    "text": "Talvez os velhos tempos ocupados tenham me acostumado a fazer uma tarefa atrás da outra..."
                },
                {
                    "id": "739520104",
                    "speaker": "Yuewen",
                    "text": "Mas ouvi dos aldeões que há um velho ditado Sumeru: \"A engenhosidade pode trazer o verdadeiro conhecimento\"."
                },
                {
                    "id": "739520105",
                    "speaker": "Yuewen",
                    "text": "Talvez uma mudança de mentalidade ou estilo de vida seria melhor para mim?"
                }
            ]
        }
    ]
}