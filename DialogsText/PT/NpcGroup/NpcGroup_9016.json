{
    "groupId": "9016",
    "total_dialogue_lines": 65,
    "speaker_counts": {
        "Diluc": 45,
        "Player": 20
    },
    "talks": [
        {
            "talkId": "6901601",
            "initDialog": "690160101",
            "dialogues": [
                {
                    "id": "690160101",
                    "speaker": "Diluc",
                    "text": "#Você veio, {NICKNAME}."
                },
                {
                    "id": "690160102",
                    "speaker": "Diluc",
                    "text": "Você parece estar de muito bom humor."
                }
            ]
        },
        {
            "talkId": "6901602",
            "initDialog": "690160201",
            "dialogues": [
                {
                    "id": "690160201",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>Você se acostumou com esse lugar?</color>"
                },
                {
                    "id": "690160701",
                    "speaker": "Diluc",
                    "text": "Nada mal.",
                    "choices": [
                        {
                            "id": "690160702",
                            "text": "...\"Nada mal\"?",
                            "response": [
                                {
                                    "id": "690160704",
                                    "speaker": "Diluc",
                                    "text": "..."
                                },
                                {
                                    "id": "690160705",
                                    "speaker": "Diluc",
                                    "text": "Perdão, não era minha intenção de ir levemente contra a vontade da casa."
                                },
                                {
                                    "id": "690160706",
                                    "speaker": "Diluc",
                                    "text": "#Tampouco quis aborrecê-l{F#a}{M#o}."
                                },
                                {
                                    "id": "690160707",
                                    "speaker": "Diluc",
                                    "text": "Tudo o que eu quis dizer foi... Poderia levar algum tempo para me acostumar a me alojar aqui."
                                },
                                {
                                    "id": "690160708",
                                    "speaker": "Diluc",
                                    "text": "...Mas não me leve a mal."
                                }
                            ]
                        },
                        {
                            "id": "690160703",
                            "text": "Então é verdade o que as pessoas dizem sobre seus gostos sofisticados..."
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6901603",
            "initDialog": "690160301",
            "dialogues": [
                {
                    "id": "690160301",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>Você quer conversar comigo?</color>"
                },
                {
                    "id": "690160801",
                    "speaker": "Diluc",
                    "text": "...Uma conversa do tipo ociosa?",
                    "choices": [
                        {
                            "id": "690160802",
                            "text": "Esqueci que você não é do tipo de papo furado.",
                            "response": [
                                {
                                    "id": "690160803",
                                    "speaker": "Diluc",
                                    "text": "Não, está tudo bem. Eu não me importo."
                                },
                                {
                                    "id": "690160804",
                                    "speaker": "Diluc",
                                    "text": "Nada mais justo do que separar um tempo para você."
                                },
                                {
                                    "id": "690160810",
                                    "speaker": "Diluc",
                                    "text": "...Quão perspicaz da sua parte. Sim, eu estou."
                                },
                                {
                                    "id": "690160811",
                                    "speaker": "Diluc",
                                    "text": "Seja a avareza humana escondida nas sombras ou uma conspiração de fora do mundo humano..."
                                },
                                {
                                    "id": "690160812",
                                    "speaker": "Diluc",
                                    "text": "Os malfeitores estão apenas esperando que baixemos nossa guarda."
                                },
                                {
                                    "id": "690160813",
                                    "speaker": "Diluc",
                                    "text": "..."
                                },
                                {
                                    "id": "690160814",
                                    "speaker": "Diluc",
                                    "text": "Isso não deve ser o tipo de conversa que você gostaria de ter.",
                                    "choices": [
                                        {
                                            "id": "690160815",
                                            "text": "Não me incomoda.",
                                            "response": [
                                                {
                                                    "id": "690160816",
                                                    "speaker": "Diluc",
                                                    "text": "Hmm..."
                                                },
                                                {
                                                    "id": "690160817",
                                                    "speaker": "Diluc",
                                                    "text": "Acho que preciso de uma pequena introspecção..."
                                                },
                                                {
                                                    "id": "690160821",
                                                    "speaker": "Diluc",
                                                    "text": "Mas também vou tentar encontrar alguns tópicos de conversa que se alinhem com seus interesses."
                                                }
                                            ]
                                        },
                                        {
                                            "id": "690160818",
                                            "text": "#Saber que Mondstadt tem um protetor como você me deixa despreocupad{M#o}{F#a}.",
                                            "response": [
                                                {
                                                    "id": "690160819",
                                                    "speaker": "Diluc",
                                                    "text": "Hmm..."
                                                },
                                                {
                                                    "id": "690160820",
                                                    "speaker": "Diluc",
                                                    "text": "Isso é óbvio."
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "690160805",
                            "text": "Você parece tão infeliz o tempo todo, pensei em checar em você.",
                            "response": [
                                {
                                    "id": "690160806",
                                    "speaker": "Diluc",
                                    "text": "Infeliz...? Nada do gênero."
                                },
                                {
                                    "id": "690160807",
                                    "speaker": "Diluc",
                                    "text": "Estou apenas pensando. Observando. Ou planejando."
                                },
                                {
                                    "id": "690160808",
                                    "speaker": "Diluc",
                                    "text": "No entanto... Agradeço sua preocupação. Eu não queria preocupar você."
                                }
                            ]
                        },
                        {
                            "id": "690160809",
                            "text": "Você ainda está preocupado com a segurança de Mondstadt?"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6901604",
            "initDialog": "690160401",
            "dialogues": [
                {
                    "id": "690160401",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>O que você gostaria de fazer?</color>"
                },
                {
                    "id": "690160901",
                    "speaker": "Diluc",
                    "text": "Sim... Tome um gole disso."
                },
                {
                    "id": "690160902",
                    "speaker": "Diluc",
                    "text": "É uma bebida sem álcool, baseada em uma receita familiar de longa data. Mas eu mesmo dei minha própria incrementada nela.",
                    "choices": [
                        {
                            "id": "690160903",
                            "text": "Tem um gosto fresco.",
                            "response": [
                                {
                                    "id": "690160905",
                                    "speaker": "Diluc",
                                    "text": "Pela sua expressão, você gostou."
                                },
                                {
                                    "id": "690160906",
                                    "speaker": "Diluc",
                                    "text": "Bem, fico feliz. Tentei ajustar a receita ao seu gosto e, pelo aspecto, consegui fazer exatamente isso."
                                },
                                {
                                    "id": "690160907",
                                    "speaker": "Diluc",
                                    "text": "Ainda preciso pedir sua ajuda com algo."
                                },
                                {
                                    "id": "690160908",
                                    "speaker": "Diluc",
                                    "text": "Essa bebida precisa de um nome. Como mudamos a sua receita, seu nome original já não é apropriado."
                                },
                                {
                                    "id": "690160909",
                                    "speaker": "Player",
                                    "text": "Você quer que eu pense em um?"
                                },
                                {
                                    "id": "690160910",
                                    "speaker": "Diluc",
                                    "text": "Essa bebida foi feita com seu gosto, creio que seria mais apropriado você pensar em um nome para ela."
                                },
                                {
                                    "id": "690160911",
                                    "speaker": "Diluc",
                                    "text": "Agora que você falou... Você gostaria que eu usasse seu nome?",
                                    "choices": [
                                        {
                                            "id": "690160912",
                                            "text": "É estranho.",
                                            "response": [
                                                {
                                                    "id": "690160914",
                                                    "speaker": "Diluc",
                                                    "text": "É verdade."
                                                },
                                                {
                                                    "id": "690160915",
                                                    "speaker": "Diluc",
                                                    "text": "Não tem problema, pode pensar calmamente. Se você se esquecer do sabor, apenas me fale e eu vou fazer a bebida novamente para você."
                                                },
                                                {
                                                    "id": "690160916",
                                                    "speaker": "Diluc",
                                                    "text": "Em qualquer lugar. A qualquer momento."
                                                }
                                            ]
                                        },
                                        {
                                            "id": "690160913",
                                            "text": "Deixe-me pensar melhor..."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "690160904",
                            "text": "Tem um gosto residual forte!"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6901605",
            "initDialog": "690160501",
            "dialogues": [
                {
                    "id": "690160501",
                    "speaker": "Player",
                    "text": "Bom dia, Diluc."
                },
                {
                    "id": "690161001",
                    "speaker": "Diluc",
                    "text": "Sim, correu tudo bem."
                },
                {
                    "id": "690161002",
                    "speaker": "Diluc",
                    "text": "Se precisar de mim, não se preocupe, basta me chamar."
                }
            ]
        },
        {
            "talkId": "6901606",
            "initDialog": "690160601",
            "dialogues": [
                {
                    "id": "690160601",
                    "speaker": "Player",
                    "text": "Boa noite, Diluc."
                },
                {
                    "id": "690161101",
                    "speaker": "Diluc",
                    "text": "Boa noite..."
                },
                {
                    "id": "690161102",
                    "speaker": "Diluc",
                    "text": "Nada. Pode ir."
                }
            ]
        },
        {
            "talkId": "6901612",
            "initDialog": "690161201",
            "dialogues": [
                {
                    "id": "690161201",
                    "speaker": "Player",
                    "text": "Quer conversar comigo?"
                }
            ]
        },
        {
            "talkId": "6901613",
            "initDialog": "690161301",
            "dialogues": [
                {
                    "id": "690161301",
                    "speaker": "Player",
                    "text": "Gostaria de fazer alguma coisa?"
                }
            ]
        },
        {
            "talkId": "6901614",
            "initDialog": "690161401",
            "dialogues": [
                {
                    "id": "690161401",
                    "speaker": "Player",
                    "text": "Você já se acostumou com esse lugar?"
                }
            ]
        },
        {
            "talkId": "6901650",
            "initDialog": "690165001",
            "dialogues": [
                {
                    "id": "690165001",
                    "speaker": "Diluc",
                    "text": "Para cuidar de uma horta é preciso prestar atenção a muitos fatores e não é mais simples que uma batalha ou uma partida de xadrez."
                },
                {
                    "id": "690165002",
                    "speaker": "Diluc",
                    "text": "Se atrasar a eliminação das ervas daninhas apenas por um tempinho, isso pode influenciar a qualidade do fruto e, por consequência, a textura do vinho."
                },
                {
                    "id": "690165003",
                    "speaker": "Diluc",
                    "text": "#Se precisar, eu te ajudo. Tente ser {M#um bom}{F#uma boa}gerente."
                }
            ]
        },
        {
            "talkId": "6901651",
            "initDialog": "690165101",
            "dialogues": [
                {
                    "id": "690165101",
                    "speaker": "Diluc",
                    "text": "Uma espada é a unidade de força mais fundamental, e cada soldado é indispensável."
                },
                {
                    "id": "690165102",
                    "speaker": "Diluc",
                    "text": "Cuidar de sua espada, é a base para manter uma lâmina em boas condições."
                },
                {
                    "id": "690165103",
                    "speaker": "Diluc",
                    "text": "Portanto, não seja mesquinho ao investir em sua forja."
                }
            ]
        }
    ]
}