    "talks": [
        {
            "talkId": "4001228",
            "initDialog": "400122801",
            "dialogues": [
                {
                    "id": "400122801",
                    "speaker": "Albedo",
                    "text": "Hm? Ah é você. Dando uma volta por esta área?",
                    "choices": [
                        {
                            "id": "400122802",
                            "text": "Você quer conversar?",
                            "response": [
                                {
                                    "id": "400122803",
                                    "speaker": "Albedo",
                                    "text": "Ok. Sobre o que você gostaria de falar?",
                                    "choices": [
                                        {
                                            "id": "400122804",
                                            "text": "Sobre como você se sentiu montando um dragão...",
                                            "response": [
                                                {
                                                    "id": "400122805",
                                                    "speaker": "Albedo",
                                                    "text": "Eu conduzi todo tipo de pesquisa, mas voar de Mondstadt até esta ilha em um dragão... Foi a primeira vez."
                                                },
                                                {
                                                    "id": "400122806",
                                                    "speaker": "Albedo",
                                                    "text": "Foi uma boa experiência. No céu, até mesmo falar exige todas as nossas forças, já que os ventos são muito fortes."
                                                },
                                                {
                                                    "id": "400122807",
                                                    "speaker": "Albedo",
                                                    "text": "As oportunidades de se comunicar em voz alta com outras pessoas são escassas. Embora eu tenha pouco interesse nisso, o processo foi interessante."
                                                },
                                                {
                                                    "id": "400122808",
                                                    "speaker": "Albedo",
                                                    "text": "Acho que isso pode ser considerado uma memória inesquecível.",
                                                    "choices": [
                                                        {
                                                            "id": "400122804",
                                                            "text": "Sobre como você se sentiu montando um dragão..."
                                                        },
                                                        {
                                                            "id": "400122809",
                                                            "text": "Conte-me sobre essas ilhas...",
                                                            "response": [
                                                                {
                                                                    "id": "400122810",
                                                                    "speaker": "Albedo",
                                                                    "text": "A natureza desta ilha é extraordinária. Como um segredo bem guardado, ela se revela apenas em momentos específicos."
                                                                },
                                                                {
                                                                    "id": "400122811",
                                                                    "speaker": "Albedo",
                                                                    "text": "E, no entanto, a ilha ainda contém vestígios de atividade humana."
                                                                },
                                                                {
                                                                    "id": "400122812",
                                                                    "speaker": "Albedo",
                                                                    "text": "Além disso, uma infinidade de organismos está presente aqui."
                                                                },
                                                                {
                                                                    "id": "400122813",
                                                                    "speaker": "Albedo",
                                                                    "text": "Desde que chegamos, fico pensando: qual é o limite da vida? Mesmo nos lugares mais desolados, existirá alguma forma de vida?",
                                                                    "choices": [
                                                                        {
                                                                            "id": "400122804",
                                                                            "text": "Sobre como você se sentiu montando um dragão..."
                                                                        },
                                                                        {
                                                                            "id": "400122809",
                                                                            "text": "Conte-me sobre essas ilhas..."
                                                                        },
                                                                        {
                                                                            "id": "400122814",
                                                                            "text": "Sobre você...",
                                                                            "response": [
                                                                                {
                                                                                    "id": "400122815",
                                                                                    "speaker": "Albedo",
                                                                                    "text": "Eu? Estou bem. Agradeço a preocupação."
                                                                                },
                                                                                {
                                                                                    "id": "400122816",
                                                                                    "speaker": "Albedo",
                                                                                    "text": "Como você se sente aqui, se não se importa em responder?"
                                                                                },
                                                                                {
                                                                                    "id": "400122817",
                                                                                    "speaker": "Player",
                                                                                    "text": "Nada mal."
                                                                                },
                                                                                {
                                                                                    "id": "400122818",
                                                                                    "speaker": "Albedo",
                                                                                    "text": "Ok, é bom ouvir isso."
                                                                                },
                                                                                {
                                                                                    "id": "400122819",
                                                                                    "speaker": "Albedo",
                                                                                    "text": "Existem muitas paisagens que vale a pena desenhar aqui. Você pode me acompanhar se quiser ver.",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "400122804",
                                                                                            "text": "Sobre como você se sentiu montando um dragão..."
                                                                                        },
                                                                                        {
                                                                                            "id": "400122809",
                                                                                            "text": "Conte-me sobre essas ilhas..."
                                                                                        },
                                                                                        {
                                                                                            "id": "400122814",
                                                                                            "text": "Sobre você..."
                                                                                        },
                                                                                        {
                                                                                            "id": "400122820",
                                                                                            "text": "Sobre o que aconteceu hoje...",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "400122821",
                                                                                                    "speaker": "Albedo",
                                                                                                    "text": "Os eventos de hoje não pareceram tão fora do comum."
                                                                                                },
                                                                                                {
                                                                                                    "id": "400122822",
                                                                                                    "speaker": "Albedo",
                                                                                                    "text": "Hmm? Desculpe, você quer dizer quando eu saí sozinho?"
                                                                                                },
                                                                                                {
                                                                                                    "id": "400122823",
                                                                                                    "speaker": "Albedo",
                                                                                                    "text": "Essa foi uma escolha pessoal. Não se estresse com isso. Às vezes, gosto de ficar sozinho."
                                                                                                },
                                                                                                {
                                                                                                    "id": "400122824",
                                                                                                    "speaker": "Albedo",
                                                                                                    "text": "Comunicar-se com outras pessoas pode ser desgastante. Mas se fosse escolher alguém com quem conversar, eu escolheria você."
                                                                                                },
                                                                                                {
                                                                                                    "id": "400122825",
                                                                                                    "speaker": "Albedo",
                                                                                                    "text": "Você é inteligente e gosto de conversar com pessoas inteligentes."
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "400122826",
                                                                                            "text": "Não vou lhe incomodar mais.",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "400122827",
                                                                                                    "speaker": "Albedo",
                                                                                                    "text": "Certo, boa noite."
                                                                                                }
                                                                                            ]
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "400122820",
                                                                            "text": "Sobre o que aconteceu hoje..."
                                                                        },
                                                                        {
                                                                            "id": "400122826",
                                                                            "text": "Não vou lhe incomodar mais."
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "400122814",
                                                            "text": "Sobre você..."
                                                        },
                                                        {
                                                            "id": "400122820",
                                                            "text": "Sobre o que aconteceu hoje..."
                                                        },
                                                        {
                                                            "id": "400122826",
                                                            "text": "Não vou lhe incomodar mais."
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "400122809",
                                            "text": "Conte-me sobre essas ilhas..."
                                        },
                                        {
                                            "id": "400122814",
                                            "text": "Sobre você..."
                                        },
                                        {
                                            "id": "400122820",
                                            "text": "Sobre o que aconteceu hoje..."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "400122826",
                            "text": "Não vou lhe incomodar mais."
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "4001312",
            "initDialog": "400131201",
            "dialogues": [
                {
                    "id": "400131201",
                    "speaker": "Albedo",
                    "text": "Não me olhe desse jeito."
                },
                {
                    "id": "400131202",
                    "speaker": "Albedo",
                    "text": "Se tivéssemos resolvido o enigma no início, então o jogo não teria sido muito divertido agora, não é mesmo?"
                },
                {
                    "id": "400131203",
                    "speaker": "Albedo",
                    "text": "Essa ilha é perfeita para Klee, e também é perfeita para você."
                },
                {
                    "id": "400131204",
                    "speaker": "Albedo",
                    "text": "Não acha? Verão, ilhas, mar... Apesar de ser apenas um parque de diversões numa ilha pequena, é totalmente direcionada para os Viajantes que descansam aqui."
                },
                {
                    "id": "400131205",
                    "speaker": "Albedo",
                    "text": "Você pode passar um bom verão aqui."
                }
            ]
        }
