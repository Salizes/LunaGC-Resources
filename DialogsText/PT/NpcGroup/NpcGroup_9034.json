{
    "groupId": "9034",
    "total_dialogue_lines": 59,
    "speaker_counts": {
        "Noelle": 41,
        "Player": 18
    },
    "talks": [
        {
            "talkId": "6903401",
            "initDialog": "690340101",
            "dialogues": [
                {
                    "id": "690340101",
                    "speaker": "Noelle",
                    "text": "#Olá, {NICKNAME}, que bom te ver novamente."
                },
                {
                    "id": "690340102",
                    "speaker": "Noelle",
                    "text": "Posso lhe ajudar com alguma coisa? Sempre estou disponível."
                }
            ]
        },
        {
            "talkId": "6903402",
            "initDialog": "690340201",
            "dialogues": [
                {
                    "id": "690340201",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>Você se acostumou com esse lugar?</color>"
                },
                {
                    "id": "690340202",
                    "speaker": "Noelle",
                    "text": "Claro, gostei muito do ambiente daqui."
                },
                {
                    "id": "690340203",
                    "speaker": "Noelle",
                    "text": "O exterior é vasto e agradável e o interior tem uma decoração requintada."
                },
                {
                    "id": "690340204",
                    "speaker": "Noelle",
                    "text": "Acho que aqui é melhor do que todas as mansões que já vi."
                },
                {
                    "id": "690340205",
                    "speaker": "Noelle",
                    "text": "Único defeito..."
                },
                {
                    "id": "690340206",
                    "speaker": "Player",
                    "text": "Único defeito?"
                },
                {
                    "id": "690340207",
                    "speaker": "Noelle",
                    "text": "Que comparado com Mondstadt, aqui há pouco trabalho para uma Empregada."
                },
                {
                    "id": "690340208",
                    "speaker": "Noelle",
                    "text": "Sinto como se fosse ficar desleixada..."
                }
            ]
        },
        {
            "talkId": "6903403",
            "initDialog": "690340301",
            "dialogues": [
                {
                    "id": "690340301",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>Você quer conversar comigo?</color>"
                },
                {
                    "id": "690340209",
                    "speaker": "Noelle",
                    "text": "Bem, essa é a minha honra."
                },
                {
                    "id": "690340302",
                    "speaker": "Noelle",
                    "text": "A propósito... Desde que vim para aqui, nunca mais peguei nenhum objeto perdido de origem desconhecida."
                },
                {
                    "id": "690340303",
                    "speaker": "Noelle",
                    "text": "Acho que ainda não estou acostumada.",
                    "choices": [
                        {
                            "id": "690340304",
                            "text": "Hã?",
                            "response": [
                                {
                                    "id": "690340305",
                                    "speaker": "Noelle",
                                    "text": "Objetos encontrados enquanto faço os trabalhos de limpeza."
                                },
                                {
                                    "id": "690340308",
                                    "speaker": "Noelle",
                                    "text": "Por exemplo... Quando encontrei uma bandana com uma cor apagada no fundo de um armário."
                                },
                                {
                                    "id": "690340309",
                                    "speaker": "Noelle",
                                    "text": "Ou uma bola mordida pelos gatos nos arbustos."
                                },
                                {
                                    "id": "690340310",
                                    "speaker": "Noelle",
                                    "text": "Ou até marcadores de páginas nos cantos da Biblioteca, chaves perdidas no caminho ou uma carta de confissão sem assinatura na fenda da porta da Catedral...",
                                    "choices": [
                                        {
                                            "id": "690340311",
                                            "text": "Parece que o trabalho de limpeza é muito cansativo...",
                                            "response": [
                                                {
                                                    "id": "690340312",
                                                    "speaker": "Noelle",
                                                    "text": "Não, não! Eu me sinto muito honrada eu fazê-lo."
                                                },
                                                {
                                                    "id": "690340315",
                                                    "speaker": "Noelle",
                                                    "text": "Mas, falando nisso..."
                                                },
                                                {
                                                    "id": "690340316",
                                                    "speaker": "Noelle",
                                                    "text": "Essa casa sempre esteve muito limpa."
                                                },
                                                {
                                                    "id": "690340317",
                                                    "speaker": "Player",
                                                    "text": "Também graças ao seu trabalho, Noelle."
                                                },
                                                {
                                                    "id": "690340318",
                                                    "speaker": "Noelle",
                                                    "text": "Obrigada..."
                                                },
                                                {
                                                    "id": "690340319",
                                                    "speaker": "Noelle",
                                                    "text": "Eu sou muito dedicada ao meu trabalho! E fico ainda mais feliz que limpar os Cavaleiros de Favonius ou qualquer outro lugar."
                                                },
                                                {
                                                    "id": "690340320",
                                                    "speaker": "Noelle",
                                                    "text": "Porque... Essa é sua casa."
                                                }
                                            ]
                                        },
                                        {
                                            "id": "690340313",
                                            "text": "E onde você coloca essas coisas depois de encontrá-las?",
                                            "response": [
                                                {
                                                    "id": "690340314",
                                                    "speaker": "Noelle",
                                                    "text": "Eu sempre faço um esforço para encontrar os donos! Mas os donos de algumas coisas nunca aparecem e as coisas ficam com os Cavaleiros de Favonius."
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "690340306",
                            "text": "Noelle, você tem o hábito de pegar coisas do chão?",
                            "response": [
                                {
                                    "id": "690340307",
                                    "speaker": "Noelle",
                                    "text": "Não, não é isso. É que encontrei enquanto limpava..."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6903404",
            "initDialog": "690340401",
            "dialogues": [
                {
                    "id": "690340401",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>O que você gostaria de fazer?</color>"
                },
                {
                    "id": "690340402",
                    "speaker": "Noelle",
                    "text": "Ah? Está me perguntando...?"
                },
                {
                    "id": "690340403",
                    "speaker": "Noelle",
                    "text": "Eu quero medir seu tamanho para fazer uma roupa para você.",
                    "choices": [
                        {
                            "id": "690340404",
                            "text": "Como pensou nisso de repente?",
                            "response": [
                                {
                                    "id": "690340407",
                                    "speaker": "Noelle",
                                    "text": "Se você puder usar as roupas que eu faço para você..."
                                },
                                {
                                    "id": "690340408",
                                    "speaker": "Noelle",
                                    "text": "Bem, com certeza é algo muito, muito feliz.",
                                    "choices": [
                                        {
                                            "id": "690340409",
                                            "text": "#Obrigad{F#a}{M#o} pela ajuda.",
                                            "response": [
                                                {
                                                    "id": "690340411",
                                                    "speaker": "Noelle",
                                                    "text": "Sim... Sim..."
                                                },
                                                {
                                                    "id": "690340412",
                                                    "speaker": "Noelle",
                                                    "text": "Que bom! Finalmente há algo com que me ocupar!"
                                                },
                                                {
                                                    "id": "690340413",
                                                    "speaker": "Noelle",
                                                    "text": "Entretanto, esta é a bagunça mais feliz de Teyvat."
                                                }
                                            ]
                                        },
                                        {
                                            "id": "690340410",
                                            "text": "Irei também preparar um presente para você, Noelle."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "690340405",
                            "text": "Noelle, você até sabe costurar?",
                            "response": [
                                {
                                    "id": "690340406",
                                    "speaker": "Noelle",
                                    "text": "É claro! Eu sou a \"Super Empregada\"."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6903405",
            "initDialog": "690340501",
            "dialogues": [
                {
                    "id": "690340501",
                    "speaker": "Player",
                    "text": "Bom dia, Noelle."
                },
                {
                    "id": "690340502",
                    "speaker": "Noelle",
                    "text": "#Oh, {NICKNAME}, bom dia!"
                },
                {
                    "id": "690340503",
                    "speaker": "Noelle",
                    "text": "O clima está mudando ultimamente, tome cuidado para não apanhar um resfriado."
                }
            ]
        },
        {
            "talkId": "6903406",
            "initDialog": "690340601",
            "dialogues": [
                {
                    "id": "690340601",
                    "speaker": "Player",
                    "text": "Boa noite, Noelle."
                },
                {
                    "id": "690340602",
                    "speaker": "Noelle",
                    "text": "#Boa noite, {NICKNAME}."
                },
                {
                    "id": "690340603",
                    "speaker": "Noelle",
                    "text": "Se precisar de um copo de leite quente ou uma canção para dormir, eu estarei aqui às suas ordens."
                }
            ]
        },
        {
            "talkId": "6903407",
            "initDialog": "690340701",
            "dialogues": [
                {
                    "id": "690340701",
                    "speaker": "Player",
                    "text": "Quer conversar comigo?"
                }
            ]
        },
        {
            "talkId": "6903408",
            "initDialog": "690340801",
            "dialogues": [
                {
                    "id": "690340801",
                    "speaker": "Player",
                    "text": "Gostaria de fazer alguma coisa?"
                }
            ]
        },
        {
            "talkId": "6903409",
            "initDialog": "690340901",
            "dialogues": [
                {
                    "id": "690340901",
                    "speaker": "Player",
                    "text": "Você já se acostumou com esse lugar?"
                }
            ]
        },
        {
            "talkId": "6903450",
            "initDialog": "690345001",
            "dialogues": [
                {
                    "id": "690345001",
                    "speaker": "Noelle",
                    "text": "Com essas instalações, poderei cuidar das armas convenientemente."
                },
                {
                    "id": "690345002",
                    "speaker": "Noelle",
                    "text": "Preciso ficar pronta a batalha sempre para poder proteger a todos!"
                },
                {
                    "id": "690345003",
                    "speaker": "Noelle",
                    "text": "Obrigada por fazer isso... Você também é uma pessoa que quero proteger."
                }
            ]
        },
        {
            "talkId": "6903451",
            "initDialog": "690345101",
            "dialogues": [
                {
                    "id": "690345101",
                    "speaker": "Noelle",
                    "text": "Foi você que arrumou isso tudo pessoalmente?"
                },
                {
                    "id": "690345102",
                    "speaker": "Noelle",
                    "text": "Acabei não vindo mais cedo ajudar e você teve que fazer todo esse trabalho. Negligenciei meu trabalho como empregada."
                },
                {
                    "id": "690345103",
                    "speaker": "Noelle",
                    "text": "#Você já deve estar muito cansad{F#a}{M#o} de ter trabalho o dia inteiro. Deixe-me lhe preparar um chá com algum lanche que você gosta... Por favor, descanse bastante."
                }
            ]
        }
    ]
}