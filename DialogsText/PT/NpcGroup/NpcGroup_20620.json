    },
    "talks": [
        {
            "talkId": "7902224",
            "initDialog": "790222401",
            "dialogues": [
                {
                    "id": "790222401",
                    "speaker": "Agafya",
                    "text": "Por que, há mais alguma coisa? Já lhe disse o que sei...",
                    "choices": [
                        {
                            "id": "790222402",
                            "text": "Sobre o teste de sinais...",
                            "response": [
                                {
                                    "id": "790222403",
                                    "speaker": "Agafya",
                                    "text": "Como eu disse, não tenho certeza... É provavelmente apenas um simples trabalho teste, exceto que envolve correr ao redor das ilhas e é bastante cansativo."
                                }
                            ]
                        },
                        {
                            "id": "790222404",
                            "text": "Sobre Zakhar...",
                            "response": [
                                {
                                    "id": "790222405",
                                    "speaker": "Agafya",
                                    "text": "Zahar é órfão, seus pais morreram de doença há muito tempo e diz-se que ele viveu uma vida longa e dura. Diz-se que entrou para os Fatui quando soube que davam comida..."
                                }
                            ]
                        },
                        {
                            "id": "790222406",
                            "text": "Acerca de foto...",
                            "response": [
                                {
                                    "id": "790222407",
                                    "speaker": "Agafya",
                                    "text": "Bem, na foto de grupo estão meus dois irmãos mais velhos, ambos serviram Snezhnaya... e eu sempre, sempre me orgulhei deles."
                                }
                            ]
                        },
                        {
                            "id": "790222408",
                            "text": "Adeus..."
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7902230",
            "initDialog": "790223001",
            "dialogues": [
                {
                    "id": "790223001",
                    "speaker": "Dama do Espelho",
                    "text": "...Eu preciso voltar... tenho que voltar... ele ainda está lá. Mas meus irmãos se foram, e sua foto...",
                    "choices": [
                        {
                            "id": "790223002",
                            "text": "(Não está prestando atenção...)"
                        },
                        {
                            "id": "790223003",
                            "text": "(Vamos ignorá-la...)"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7902427",
            "initDialog": "790242701",
            "dialogues": [
                {
                    "id": "790242701",
                    "speaker": "Agafya",
                    "text": "A maior parte dos membros da equipe já se foram, e já estamos prontos para sair também..."
                }
            ]
        }
    ]
}