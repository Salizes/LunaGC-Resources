    "talks": [
        {
            "talkId": "6410401",
            "initDialog": "641040101",
            "dialogues": [
                {
                    "id": "641040101",
                    "speaker": "Minoo",
                    "text": "Só as crianças que não são crescidas acreditam em histórias de Aranara."
                }
            ]
        },
        {
            "talkId": "6410402",
            "initDialog": "641040201",
            "dialogues": [
                {
                    "id": "641040201",
                    "speaker": "Player",
                    "text": "Sobre os Aranaras..."
                },
                {
                    "id": "641040202",
                    "speaker": "Minoo",
                    "text": "É uma criatura fantástica em um conto de fadas, e você deve se lembrar disso."
                },
                {
                    "id": "641040203",
                    "speaker": "Minoo",
                    "text": "Se você ainda acredita na história de Aranara, isso quer dizer que você não cresceu."
                }
            ]
        },
        {
            "talkId": "6410403",
            "initDialog": "641040301",
            "dialogues": [
                {
                    "id": "641040301",
                    "speaker": "Player",
                    "text": "Adeus."
                },
                {
                    "id": "641040302",
                    "speaker": "Minoo",
                    "text": "Daqui para frente, Minoo é um adulto corajoso."
                }
            ]
        },
        {
            "talkId": "6410404",
            "initDialog": "641040401",
            "dialogues": [
                {
                    "id": "641040401",
                    "speaker": "Player",
                    "text": "Quais são as histórias?"
                },
                {
                    "id": "641040402",
                    "speaker": "Minoo",
                    "text": "Existem muitas! Você nunca ouviu falar?"
                },
                {
                    "id": "641040403",
                    "speaker": "Minoo",
                    "text": "Por exemplo, o \"Corajoso Aranara\". Embora ele seja pequeno em tamanho, ele é grande em coragem."
                },
                {
                    "id": "641040404",
                    "speaker": "Minoo",
                    "text": "Mesmo com medo do fogo, o Aranara protege a floresta... *snif* Apagando incêndios com o próprio corpo..."
                },
                {
                    "id": "641040405",
                    "speaker": "Minoo",
                    "text": "*Choro*... Aranara..."
                },
                {
                    "id": "641040406",
                    "speaker": "Minoo",
                    "text": "Ah! Espera, isso é apenas uma história para criança! Minoo cresceu e não acredita mais nisso..."
                },
                {
                    "id": "641040407",
                    "speaker": "Minoo",
                    "text": "*Choro*..."
                }
            ]
        }
    ]
}