{
    "groupId": "7455",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Greygory": 8,
        "Player": 4
    },
    "talks": [
        {
            "talkId": "6745501",
            "initDialog": "674550101",
            "dialogues": [
                {
                    "id": "674550101",
                    "speaker": "Greygory",
                    "text": "Jornal, jornal! Notícias que todo cidadão de Snezhnaya deveria acompanhar. Você não vai querer perder, não é?"
                }
            ]
        },
        {
            "talkId": "6745502",
            "initDialog": "674550201",
            "dialogues": [
                {
                    "id": "674550201",
                    "speaker": "Player",
                    "text": "Que tipo de notícia?"
                },
                {
                    "id": "674550202",
                    "speaker": "Greygory",
                    "text": "Diplomacia, finanças, guerra, figuras importantes e o Veche discutindo furiosamente por três horas antes de enfim decidir continuar a discussão na semana que vem."
                },
                {
                    "id": "674550203",
                    "speaker": "Greygory",
                    "text": "Esse tipo de coisa. Por apenas alguns Mora, você pode descobrir para que lado o destino de Snezhnaya está virando."
                },
                {
                    "id": "674550204",
                    "speaker": "Greygory",
                    "text": "Vamos, pegue um. Dá para ver que você se importa pelo menos um pouquinho com o rumo das coisas."
                }
            ]
        },
        {
            "talkId": "6745503",
            "initDialog": "674550301",
            "dialogues": [
                {
                    "id": "674550301",
                    "speaker": "Player",
                    "text": "Adeus."
                },
                {
                    "id": "674550302",
                    "speaker": "Greygory",
                    "text": "Até a próxima."
                }
            ]
        },
        {
            "talkId": "6745504",
            "initDialog": "674550401",
            "dialogues": [
                {
                    "id": "674550401",
                    "speaker": "Player",
                    "text": "Não posso dizer que me importo."
                },
                {
                    "id": "674550402",
                    "speaker": "Greygory",
                    "text": "...C-Como você é modesto."
                },
                {
                    "id": "674550403",
                    "speaker": "Greygory",
                    "text": "Pois bem, se um dia quiser saber para que rumo o nosso destino está indo, e se amanhã todos nós passaremos fome, estarei esperando por você bem aqui."
                }
            ]
        },
        {
            "talkId": "6745505",
            "initDialog": "674550501",
            "dialogues": [
                {
                    "id": "674550501",
                    "speaker": "Player",
                    "text": "Por enquanto, estou bem."
                },
                {
                    "id": "674550502",
                    "speaker": "Greygory",
                    "text": "Que pena. Até mais."
                }
            ]
        }
    ]
}