    "talks": [
        {
            "talkId": "6242801",
            "initDialog": "624280101",
            "dialogues": [
                {
                    "id": "624280101",
                    "speaker": "Xinghuo",
                    "text": "*Suspiro* ...Hã? Oh, olá, Viajante! Você precisa de alguma ajuda?"
                }
            ]
        },
        {
            "talkId": "6242802",
            "initDialog": "624280201",
            "dialogues": [
                {
                    "id": "624280201",
                    "speaker": "Player",
                    "text": "Qual é a sua dificuldade?"
                },
                {
                    "id": "624280202",
                    "speaker": "Xinghuo",
                    "text": "*Suspiro* ... Não é óbvio?"
                },
                {
                    "id": "624280203",
                    "speaker": "Xinghuo",
                    "text": "Esse cara continua imitando tudo o que eu digo. Isso está me deixando maluco.",
                    "choices": [
                        {
                            "id": "624280204",
                            "text": "Vocês são amigos?",
                            "response": [
                                {
                                    "id": "624280205",
                                    "speaker": "Xinghuo",
                                    "text": "Hum... Acho que sim. Nós nos conhecemos há algum tempo."
                                }
                            ]
                        },
                        {
                            "id": "624280206",
                            "text": "Por que ele está te imitando?",
                            "response": [
                                {
                                    "id": "624280207",
                                    "speaker": "Xinghuo",
                                    "text": "Ele falava gaguejando até alguns anos atrás, quando uma garota que se chamava Alice, a Viajante, apareceu e lhe deu um frasco de remédio..."
                                },
                                {
                                    "id": "624280208",
                                    "speaker": "Xinghuo",
                                    "text": "Isso curou sua gagueira completamente. Mas então ele não conseguia parar de imitar a maneira como todos ao seu redor falam..."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6242803",
            "initDialog": "624280301",
            "dialogues": [
                {
                    "id": "624280301",
                    "speaker": "Player",
                    "text": "Adeus."
                },
                {
                    "id": "624280302",
                    "speaker": "Xinghuo",
                    "text": "Até mais, Viajante."
                }
            ]
        }
    ]
}