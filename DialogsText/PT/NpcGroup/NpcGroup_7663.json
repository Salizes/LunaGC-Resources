    "talks": [
        {
            "talkId": "6766301",
            "initDialog": "676630101",
            "dialogues": [
                {
                    "id": "676630101",
                    "speaker": "Rollon",
                    "text": "Mantenham o foco. A Caçada Feroz pode voltar a qualquer momento."
                }
            ]
        },
        {
            "talkId": "6766302",
            "initDialog": "676630201",
            "dialogues": [
                {
                    "id": "676630201",
                    "speaker": "Player",
                    "text": "Sobre a Caçada Feroz..."
                },
                {
                    "id": "676630202",
                    "speaker": "Rollon",
                    "text": "A Caçada Feroz é extremamente perigosa, diferente de outros lugares. Se você baixar sua guarda, será punido imediatamente."
                },
                {
                    "id": "676630203",
                    "speaker": "Rollon",
                    "text": "Apesar de só agora sabermos do que ela é capaz, ela ainda pode nos pegar a qualquer momento."
                },
                {
                    "id": "676630204",
                    "speaker": "Rollon",
                    "text": "Três anos atrás, meu irmão mais velho foi pego desavisado numa investigação. Felizmente, ele sobreviveu, graças aos seus companheiros..."
                },
                {
                    "id": "676630205",
                    "speaker": "Rollon",
                    "text": "Resumindo, quando se trata dela, é sempre importante manter o foco."
                }
            ]
        },
        {
            "talkId": "6766303",
            "initDialog": "676630301",
            "dialogues": [
                {
                    "id": "676630301",
                    "speaker": "Player",
                    "text": "(<color=#FFCC33FF>Illuga</color> parece ter algo que quer dizer...?)"
                },
                {
                    "id": "676630302",
                    "speaker": "Illuga",
                    "text": "Certo, há algo em particular que eu deveria saber?"
                },
                {
                    "id": "676630303",
                    "speaker": "Rollon",
                    "text": "Não, senhor. Não há nada de anormal. Pode deixar conosco."
                },
                {
                    "id": "676630304",
                    "speaker": "Illuga",
                    "text": "Obrigado."
                },
                {
                    "id": "676630305",
                    "speaker": "Rollon",
                    "text": "Só estamos cumprindo nosso dever."
                }
            ]
        },
        {
            "talkId": "6766304",
            "initDialog": "676630401",
            "dialogues": [
                {
                    "id": "676630401",
                    "speaker": "Player",
                    "text": "Adeus."
                },
                {
                    "id": "676630402",
                    "speaker": "Rollon",
                    "text": "Se cuidem."
                }
            ]
        }
    ]
}