        {
            "talkId": "6955712",
            "initDialog": "695571201",
            "dialogues": [
                {
                    "id": "695571201",
                    "speaker": "Gorou",
                    "text": "Afirmativo! Estou equipado e pronto."
                }
            ]
        },
        {
            "talkId": "6955714",
            "initDialog": "695571401",
            "dialogues": [
                {
                    "id": "695571401",
                    "speaker": "Player",
                    "text": "Que tal uma partida de Chamado Sagrado dos Sete?"
