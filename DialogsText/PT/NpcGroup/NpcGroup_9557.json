            "talkId": "6955717",
            "initDialog": "695571701",
            "dialogues": [
                {
                    "id": "695571701",
                    "speaker": "Gorou",
                    "text": "#Acho que jogos de carta não são meu forte... Você venceu de forma justa! Perdi para {M#o}{F#a} melhor."
