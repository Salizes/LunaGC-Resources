        },
        {
            "talkId": "6955705",
            "initDialog": "695570501",
            "dialogues": [
                {
                    "id": "695570501",
                    "speaker": "Gorou",
                    "text": "Tenho praticado, mas obviamente não o bastante... Só espere até eu afiar mais minhas habilidades, vou voltar e colocar elas a teste!"
                }
            ]
        },
        {
            "talkId": "6955706",
            "initDialog": "695570601",
            "dialogues": [
                {
                    "id": "695570601",
                    "speaker": "Gorou",
                    "text": "Vamos começar! Vou te mostrar o que sei fazer."
