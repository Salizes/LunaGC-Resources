            ]
        },
        {
            "talkId": "6955708",
            "initDialog": "695570801",
            "dialogues": [
                {
                    "id": "695570801",
                    "speaker": "Player",
                    "text": "Que tal uma partida de Chamado Sagrado dos Sete?"
                }
