        {
            "talkId": "6955711",
            "initDialog": "695571101",
            "dialogues": [
                {
                    "id": "695571101",
                    "speaker": "Gorou",
                    "text": "Nenhum general espera vencer cada batalha, mas... eu ainda não gosto da sensação de perder."
                }
