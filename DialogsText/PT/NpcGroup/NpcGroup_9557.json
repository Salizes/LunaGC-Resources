        {
            "talkId": "6955710",
            "initDialog": "695571001",
            "dialogues": [
                {
                    "id": "695571001",
                    "speaker": "Gorou",
                    "text": "Ufa... Essa foi perto, mas a sorte estava do meu lado. Quer jogar outra partida?"
