    "talks": [
        {
            "talkId": "6520001",
            "initDialog": "652000101",
            "dialogues": [
                {
                    "id": "652000101",
                    "speaker": "Choudy",
                    "text": "Eu posso beber mais! Chefe... digo, Capitão! Segunda Capitã! Terceira Capitã! Onde está a bebida?"
                }
            ]
        },
        {
            "talkId": "6520002",
            "initDialog": "652000201",
            "dialogues": [
                {
                    "id": "652000201",
                    "speaker": "Player",
                    "text": "Você está bem?"
                },
                {
                    "id": "652000202",
                    "speaker": "Choudy",
                    "text": "Quem é você? \"Burnville\" não dá... Quero \"Vedran\". Onde..."
                },
                {
                    "id": "652000203",
                    "speaker": "Choudy",
                    "text": "Ah! Já sei! Vocé é \"Ogier\"! Hahaha! Vem, vamos beber!"
                }
            ]
        },
        {
            "talkId": "6520003",
            "initDialog": "652000301",
            "dialogues": [
                {
                    "id": "652000301",
                    "speaker": "Player",
                    "text": "O que você tá fazendo?"
                },
                {
                    "id": "652000302",
                    "speaker": "Choudy",
                    "text": "Você não tá vendo que tô bebendo? Prefiro que você não beba comigo, ao menos por enquanto."
                }
            ]
        },
        {
            "talkId": "6520004",
            "initDialog": "652000401",
            "dialogues": [
                {
                    "id": "652000401",
                    "speaker": "Player",
                    "text": "Até mais."
                },
                {
                    "id": "652000402",
                    "speaker": "Choudy",
                    "text": "*Soluço*... O vinho... Cadê..."
                }
            ]
        },
        {
            "talkId": "6520005",
            "initDialog": "652000501",
            "dialogues": [
                {
                    "id": "652000501",
                    "speaker": "Player",
                    "text": "Fi-Fique longe de mim! E se comporte!"
                },
                {
                    "id": "652000502",
                    "speaker": "Choudy",
                    "text": "...Hã? Quem é você? Não vai beber comigo? Tudo bem, então vou beber sozinho... *Soluço*..."
                },
                {
                    "id": "652000503",
                    "speaker": "Choudy",
                    "text": "Por que meu vinho ainda não está aqui...?"
                }
            ]
        }
    ]
}