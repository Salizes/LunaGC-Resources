    "talks": [
        {
            "talkId": "6413501",
            "initDialog": "641350101",
            "dialogues": [
                {
                    "id": "641350101",
                    "speaker": "Shapur",
                    "text": "Sisi... Sisi! Está aí?"
                }
            ]
        },
        {
            "talkId": "6413502",
            "initDialog": "641350201",
            "dialogues": [
                {
                    "id": "641350201",
                    "speaker": "Player",
                    "text": "\"Sisi\"?"
                },
                {
                    "id": "641350202",
                    "speaker": "Shapur",
                    "text": "#Oh! {F#Uma}{M#Um} cliente?"
                },
                {
                    "id": "641350203",
                    "speaker": "Shapur",
                    "text": "Sisi é o nome do meu gato. Eu estava chamando por ele."
                },
                {
                    "id": "641350204",
                    "speaker": "Shapur",
                    "text": "Mas não sei o que deu nele ultimamente. Não importa o quanto eu chame, ele nunca me responde."
                },
                {
                    "id": "641350205",
                    "speaker": "Shapur",
                    "text": "Deixa para lá. Ele deve estar brincando com Ouo de novo."
                },
                {
                    "id": "641350206",
                    "speaker": "Shapur",
                    "text": "É melhor eu chamar minha filha para te ajudar com o check-in primeiro. Sareh, Sareh! Você está por aí?"
                }
            ]
        },
        {
            "talkId": "6413503",
            "initDialog": "641350301",
            "dialogues": [
                {
                    "id": "641350301",
                    "speaker": "Player",
                    "text": "Você é..."
                },
                {
                    "id": "641350302",
                    "speaker": "Shapur",
                    "text": "Ai... Mesmo estando na porta, ainda não vê quem eu sou?"
                },
                {
                    "id": "641350303",
                    "speaker": "Shapur",
                    "text": "Eu sou o dono desta hospedaria, o único."
                },
                {
                    "id": "641350304",
                    "speaker": "Shapur",
                    "text": "Viu, Sisi? Os jovens de hoje em dia não prestam atenção em nada."
                },
                {
                    "id": "641350305",
                    "speaker": "Shapur",
                    "text": "..."
                },
                {
                    "id": "641350306",
                    "speaker": "Shapur",
                    "text": "Sisi? Sisi! Aonde foi esse gato gordo?"
                }
            ]
        },
        {
            "talkId": "6413504",
            "initDialog": "641350401",
            "dialogues": [
                {
                    "id": "641350401",
                    "speaker": "Player",
                    "text": "Adeus."
                },
                {
                    "id": "641350402",
                    "speaker": "Shapur",
                    "text": "Deixa para lá. É melhor ir perguntar à Ouo."
                }
            ]
        }
    ]
}