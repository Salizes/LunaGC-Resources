{
    "groupId": "4190",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Arakunti": 10,
        "Player": 4
    },
    "talks": [
        {
            "talkId": "6419001",
            "initDialog": "641900101",
            "dialogues": [
                {
                    "id": "641900101",
                    "speaker": "Arakunti",
                    "text": "O som de cozinhar~ o som de preparar quebra-cabeças~ sons de perseguição~ parece confuso, mas são os sons do Festival Utsava~"
                }
            ]
        },
        {
            "talkId": "6419002",
            "initDialog": "641900201",
            "dialogues": [
                {
                    "id": "641900201",
                    "speaker": "Player",
                    "text": "Sobre o Festival Utsava..."
                },
                {
                    "id": "641900202",
                    "speaker": "Arakunti",
                    "text": "#Nos encontramos novamente, Nara {NICKNAME}."
                },
                {
                    "id": "641900203",
                    "speaker": "Arakunti",
                    "text": "#Nara {NICKNAME} vai cantar durante o Festival Utsava, e certamente será uma melodia entrelaçada com a luz do sol e da lua, o céu se sobrepondo sob os lagos, a chuva e o orvalho em apertos de mãos."
                },
                {
                    "id": "641900204",
                    "speaker": "Arakunti",
                    "text": "#Paimon não será uma preguiçosa e também cantará com Nara {NICKNAME}."
                }
            ]
        },
        {
            "talkId": "6419003",
            "initDialog": "641900301",
            "dialogues": [
                {
                    "id": "641900301",
                    "speaker": "Player",
                    "text": "Adeus."
                },
                {
                    "id": "641900302",
                    "speaker": "Arakunti",
                    "text": "#Adeus, Nara {NICKNAME}."
                }
            ]
        },
        {
            "talkId": "6419004",
            "initDialog": "641900401",
            "dialogues": [
                {
                    "id": "641900401",
                    "speaker": "Arakunti",
                    "text": "#A canção de Nara {NICKNAME} era dourada e acolhedora, como o sol, Arakunti a lembrava em seu coração."
                }
            ]
        },
        {
            "talkId": "6419005",
            "initDialog": "641900501",
            "dialogues": [
                {
                    "id": "641900501",
                    "speaker": "Player",
                    "text": "Sobre a canção..."
                },
                {
                    "id": "641900502",
                    "speaker": "Arakunti",
                    "text": "#Arakunti ouviu a melodia de Nara {NICKNAME}, era cheia de coragem e transbordava esperança."
                },
                {
                    "id": "641900503",
                    "speaker": "Arakunti",
                    "text": "Igual à Nara Varuna nas histórias."
                },
                {
                    "id": "641900504",
                    "speaker": "Arakunti",
                    "text": "#No entanto, Nara Varuna na história não retornou a Vanarana. Nara {NICKNAME}, venha visitar por favor."
                }
            ]
        },
        {
            "talkId": "6419006",
            "initDialog": "641900601",
            "dialogues": [
                {
                    "id": "641900601",
                    "speaker": "Player",
                    "text": "Adeus."
                },
                {
                    "id": "641900602",
                    "speaker": "Arakunti",
                    "text": "#Sim... Não deixe de retornar, Nara {NICKNAME}."
                }
            ]
        }
    ]
}