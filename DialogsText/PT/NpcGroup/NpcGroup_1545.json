            "dialogues": [
                {
                    "id": "709230101",
                    "speaker": "Player",
                    "text": "Por que você está tão exausto?"
                },
                {
                    "id": "709230102",
                    "speaker": "Marla",
                    "text": "Hmm... Bem, é porque eu só consigo me encontrar com o meu amor à noite."
                },
                {
                    "id": "709230103",
                    "speaker": "Marla",
                    "text": "O outro motivo é que recentemente eu tenho lido a série da \"Princesa Javali\". Acabei de terminar o grande final."
                },
                {
                    "id": "709230104",
                    "speaker": "Marla",
                    "text": "O final é um pouco estranho, mas é tão incrível que a Princesa Javali e o filhote de lobo puderam ficar juntos!"
                },
                {
                    "id": "709230105",
                    "speaker": "Marla",
                    "text": "Você chegou a ler? Se você não tiver, por favor leia... E por favor me ajude a devolvê-lo a biblioteca quando você tiver terminado, obrigada."
                }
            ]
        },
        {
            "talkId": "41734",
            "initDialog": "615450203",
            "dialogues": [
                {
                    "id": "615450203",
                    "speaker": "Player",
                    "text": "Nada em particular..."
                },
                {
                    "id": "615450204",
                    "speaker": "Marla",
                    "text": "Ok, então... Ainda bem que este banco está aqui, acho que vou tirar uma soneca agora."
                }
            ]
        },
        {
            "talkId": "6154501",
            "initDialog": "615450101",
            "dialogues": [
                {
                    "id": "615450101",
                    "speaker": "Marla",
                    "text": "Olá... O que você quer?"
                }
            ]
        },
        {
            "talkId": "6154502",
            "initDialog": "615450201",
            "dialogues": [
                {
                    "id": "615450201",
                    "speaker": "Player",
                    "text": "Você parece sonolenta."
                },
                {
                    "id": "615450202",
                    "speaker": "Marla",
                    "text": "*Bocejo* Sim... Sinto que vou adormecer a qualquer minuto. Então, se tiver algo a dizer, diga logo."
                }
