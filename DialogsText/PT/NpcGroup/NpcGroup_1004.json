    "talks": [
        {
            "talkId": "30703",
            "initDialog": "3070301",
            "dialogues": [
                {
                    "id": "3070301",
                    "speaker": "Kaeya",
                    "text": "Você é boa em planar, onde você aprendeu?",
                    "choices": [
                        {
                            "id": "3070302",
                            "text": "E esse tapa-olho?",
                            "response": [
                                {
                                    "id": "3070303",
                                    "speaker": "Kaeya",
                                    "text": "Tapa-olho? Você quer ouvir a minha história?"
                                },
                                {
                                    "id": "3070304",
                                    "speaker": "Kaeya",
                                    "text": "Pensando nisso, eu acho que não me apresentei direito."
                                },
                                {
                                    "id": "3070305",
                                    "speaker": "Kaeya",
                                    "text": "Haha, desculpe, eu sou o Intendente Kaeya."
                                },
                                {
                                    "id": "3070306",
                                    "speaker": "Kaeya",
                                    "text": "Podemos conversar melhor depois de resolver as coisas."
                                },
                                {
                                    "id": "3070307",
                                    "speaker": "Kaeya",
                                    "text": "Eu conheço um ótimo lugar para conversarmos."
                                }
                            ]
                        },
                        {
                            "id": "3070308",
                            "text": "Por que a Jean é a Grande Mestre Intendente?",
                            "response": [
                                {
                                    "id": "3070309",
                                    "speaker": "Kaeya",
                                    "text": "A Grande Mestre está de licença, então a responsabilidade dos Cavaleiros está com a Mestre Jean."
                                },
                                {
                                    "id": "3070310",
                                    "speaker": "Kaeya",
                                    "text": "Por isso, você ouvirá muitos se referirem a ela como a Grande Mestre Intendente."
                                },
                                {
                                    "id": "3070311",
                                    "speaker": "Kaeya",
                                    "text": "Quando o Grande Mestre foi embora, ele levou uma grande quantidade de cavaleiros com ele, deixando a Grande Mestre Intendente com mais responsabilidade e estresse."
                                },
                                {
                                    "id": "3070312",
                                    "speaker": "Kaeya",
                                    "text": "Não parece ter sido fácil para ela."
                                }
                            ]
                        },
                        {
                            "id": "3070313",
                            "text": "Adeus.",
                            "response": [
                                {
                                    "id": "3070314",
                                    "speaker": "Kaeya",
                                    "text": "Até mais tarde."
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}