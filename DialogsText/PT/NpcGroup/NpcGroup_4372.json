            "initDialog": "643720201",
            "dialogues": [
                {
                    "id": "643720201",
                    "speaker": "Player",
                    "text": "Sobre o \"Mestre\"..."
                },
                {
                    "id": "643720202",
                    "speaker": "Ehsan",
                    "text": "Ah, veio visitar o Mestre? É melhor que consulte o Mordomo."
                },
                {
