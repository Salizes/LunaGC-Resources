    "talks": [
        {
            "talkId": "6750601",
            "initDialog": "675060101",
            "dialogues": [
                {
                    "id": "675060101",
                    "speaker": "Timothy",
                    "text": "Têm interesse em alguns ingressos de bastidores? Ingressos da Trupe Korolevskiy. Pura arte elevada."
                }
            ]
        },
        {
            "talkId": "6750602",
            "initDialog": "675060201",
            "dialogues": [
                {
                    "id": "675060201",
                    "speaker": "Player",
                    "text": "Ingressos de bastidores...?"
                },
                {
                    "id": "675060202",
                    "speaker": "Timothy",
                    "text": "Isso mesmo. Quer um? Garantido que sai mais barato do que comprar no teatro."
                },
                {
                    "id": "675060203",
                    "speaker": "Timothy",
                    "text": "Dizem que não há nada mais belo em toda Snezhnograd do que o canto de Odette. E se você nunca viu Vodyanitsa dançar, é como se nem tivesse visitado Snezhnograd."
                },
                {
                    "id": "675060204",
                    "speaker": "Timothy",
                    "text": "Operetas, ballettos, sabe, toda essa coisa chique, tenho de tudo! Direto da trupe. Negócio honesto!"
                }
            ]
        },
        {
            "talkId": "6750603",
            "initDialog": "675060301",
            "dialogues": [
                {
                    "id": "675060301",
                    "speaker": "Player",
                    "text": "Talvez na próxima."
                },
                {
                    "id": "675060302",
                    "speaker": "Timothy",
                    "text": "Cuide-se."
                }
            ]
        },
        {
            "talkId": "6750604",
            "initDialog": "675060401",
            "dialogues": [
                {
                    "id": "675060401",
                    "speaker": "Player",
                    "text": "Acho que você quer dizer \"ópera\" e \"balé\"."
                },
                {
                    "id": "675060402",
                    "speaker": "Timothy",
                    "text": "Ah! Isso mesmo, isso mesmo... Parece que temos uma especialista aqui!"
                },
                {
                    "id": "675060403",
                    "speaker": "Timothy",
                    "text": "Para falar a verdade, eu posso até ter ingressos, mas nunca vi nenhuma dessas apresentações. Tenho que ganhar a vida de algum jeito."
                },
                {
                    "id": "675060404",
                    "speaker": "Timothy",
                    "text": "Ah, minhas desculpas. Enfim, se você estiver procurando ingressos de bastidores, não se esqueça de onde me encontrar."
                }
            ]
        },
        {
            "talkId": "6750605",
            "initDialog": "675060501",
            "dialogues": [
                {
                    "id": "675060501",
                    "speaker": "Paimon",
                    "text": ""
                },
                {
                    "id": "675060502",
                    "speaker": "Paimon",
                    "text": ""
                },
                {
                    "id": "675060503",
                    "speaker": "Paimon",
                    "text": ""
                },
                {
                    "id": "675060504",
                    "speaker": "Paimon",
                    "text": ""
                }
            ]
        },
        {
            "talkId": "6750606",
            "initDialog": "675060601",
            "dialogues": [
                {
                    "id": "675060601",
                    "speaker": "Player",
                    "text": "Esses ingressos são legítimos mesmo?"
                },
                {
                    "id": "675060602",
                    "speaker": "Timothy",
                    "text": "Ora, vamos lá! Negócios se fazem com confiança."
                },
                {
                    "id": "675060603",
                    "speaker": "Timothy",
                    "text": "Se não se sentir confortável, sem problema. Volte quando tiver se decidido, e conversaremos."
                }
            ]
        }
    ]
}