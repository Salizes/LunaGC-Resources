                {
                    "id": "641450201",
                    "speaker": "Player",
                    "text": "Regulamentos legais?"
                },
                {
                    "id": "641450202",
                    "speaker": "Gauhar",
                    "text": "Isso. Tanto os conteúdos quanto os processos ligados a elas estão sujeitos à lei."
                },
