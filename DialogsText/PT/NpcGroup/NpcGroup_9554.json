    "talks": [
        {
            "talkId": "6955401",
            "initDialog": "695540101",
            "dialogues": [
                {
                    "id": "695540101",
                    "speaker": "Yelan",
                    "text": "...Estou me sentindo com sorte. Vamos mais umas partidas."
                }
            ]
        },
        {
            "talkId": "6955402",
            "initDialog": "695540201",
            "dialogues": [
                {
                    "id": "695540201",
                    "speaker": "Player",
                    "text": "Que tal uma partida de Chamado Sagrado dos Sete?"
                }
            ]
        },
        {
            "talkId": "6955403",
            "initDialog": "695540301",
            "dialogues": [
                {
                    "id": "695540301",
                    "speaker": "Player",
                    "text": "Desculpe, mas tenho outras coisas para fazer no momento..."
                },
                {
                    "id": "695540302",
                    "speaker": "Yelan",
                    "text": "Até mais. Também vou voltar em breve. Tem um limite para quanto você pode fugir do trabalho..."
                }
            ]
        },
        {
            "talkId": "6955404",
            "initDialog": "695540401",
            "dialogues": [
                {
                    "id": "695540401",
                    "speaker": "Yelan",
                    "text": "Quer outra partida? Até os mais inteligentes de nós cometem erros — talvez na próxima, seja minha vez."
                }
            ]
        },
        {
            "talkId": "6955405",
            "initDialog": "695540501",
            "dialogues": [
                {
                    "id": "695540501",
                    "speaker": "Yelan",
                    "text": "Você sabotou os planos da maquinadora... Essa foi boa. Você vai ter que me ensinar alguns de seus truques."
                }
            ]
        },
        {
            "talkId": "6955406",
            "initDialog": "695540601",
            "dialogues": [
                {
                    "id": "695540601",
                    "speaker": "Yelan",
                    "text": "#Vamos duelar. Que os dados de nós {M#dois}{F#duas} sejam de sorte."
                }
            ]
        },
        {
            "talkId": "6955408",
            "initDialog": "695540801",
            "dialogues": [
                {
                    "id": "695540801",
                    "speaker": "Player",
                    "text": "Que tal uma partida de Chamado Sagrado dos Sete?"
                }
            ]
        },
        {
            "talkId": "6955409",
            "initDialog": "695540901",
            "dialogues": [
                {
                    "id": "695540901",
                    "speaker": "Player",
                    "text": "Preciso ajustar meu deck primeiro..."
                }
            ]
        },
        {
            "talkId": "6955410",
            "initDialog": "695541001",
            "dialogues": [
                {
                    "id": "695541001",
                    "speaker": "Yelan",
                    "text": "Tudo bem, acabamos aqui. Promete que na próxima vez você vai me fazer suar um pouco?"
                }
            ]
        },
        {
            "talkId": "6955411",
            "initDialog": "695541101",
            "dialogues": [
                {
                    "id": "695541101",
                    "speaker": "Yelan",
                    "text": "Acho que os dados não me favoreceram hoje."
                }
            ]
        },
        {
            "talkId": "6955412",
            "initDialog": "695541201",
            "dialogues": [
                {
                    "id": "695541201",
                    "speaker": "Yelan",
                    "text": "Claro. Vamos ver em que lado está a sorte dessa vez."
                }
            ]
        },
        {
            "talkId": "6955414",
            "initDialog": "695541401",
            "dialogues": [
                {
                    "id": "695541401",
                    "speaker": "Player",
                    "text": "Que tal uma partida de Chamado Sagrado dos Sete?"
                }
            ]
        },
        {
            "talkId": "6955415",
            "initDialog": "695541501",
            "dialogues": [
                {
                    "id": "695541501",
                    "speaker": "Player",
                    "text": "Preciso ajustar meu deck primeiro..."
                }
            ]
        },
        {
            "talkId": "6955416",
            "initDialog": "695541601",
            "dialogues": [
                {
                    "id": "695541601",
                    "speaker": "Yelan",
                    "text": "Venci. Você não facilitou, mas os dados foram gentis e obedientes nessa partida."
                }
            ]
        },
        {
            "talkId": "6955417",
            "initDialog": "695541701",
            "dialogues": [
                {
                    "id": "695541701",
                    "speaker": "Yelan",
                    "text": "Umas rolagens ruins e tudo está acabado."
                }
            ]
        },
        {
            "talkId": "6955418",
            "initDialog": "695541801",
            "dialogues": [
                {
                    "id": "695541801",
                    "speaker": "Player",
                    "text": "Desculpe, mas tenho outras coisas para fazer no momento..."
                }
            ]
        }
    ]
