{
    "groupId": "7038",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Koloman": 9,
        "Player": 3
    },
    "talks": [
        {
            "talkId": "6703801",
            "initDialog": "670380101",
            "dialogues": [
                {
                    "id": "670380101",
                    "speaker": "Koloman",
                    "text": "Voltar pra casa daqui toma um tempão. É sempre tão complicado... Toma metade do meu dia de trabalho, todo dia!"
                }
            ]
        },
        {
            "talkId": "6703802",
            "initDialog": "670380201",
            "dialogues": [
                {
                    "id": "670380201",
                    "speaker": "Player",
                    "text": "Parece péssimo."
                },
                {
                    "id": "670380202",
                    "speaker": "Koloman",
                    "text": "Com certeza. Isso aqui nem me paga tão bem. Tenho que sair de casa antes do sol nascer, e chego depois dele se pôr. Seja na hora que saio ou chego de casa, meu filho tá dormindo."
                },
                {
                    "id": "670380203",
                    "speaker": "Koloman",
                    "text": "Talvez em alguns anos ele nem se lembre do meu rosto, depois de ter crescido."
                }
            ]
        },
        {
            "talkId": "6703803",
            "initDialog": "670380301",
            "dialogues": [
                {
                    "id": "670380301",
                    "speaker": "Player",
                    "text": "Adeus."
                },
                {
                    "id": "670380302",
                    "speaker": "Koloman",
                    "text": "Adeus... Urgh, espero poder voltar para casa mais cedo amanhã."
                }
            ]
        },
        {
            "talkId": "6703804",
            "initDialog": "670380401",
            "dialogues": [
                {
                    "id": "670380401",
                    "speaker": "Player",
                    "text": "Então, você naquela época..."
                },
                {
                    "id": "670380402",
                    "speaker": "Koloman",
                    "text": "... Sim. Não era um bom ganha-pão. Estou acostumado a pensar que a vida é sobre adrenalina. É fácil você pensar nisso até ver com seus próprios olhos um camarada seu morrer... Deixa pra lá. Melhor deixar o passado no passado."
                },
                {
                    "id": "670380403",
                    "speaker": "Koloman",
                    "text": "Agora, tudo que eu quero fazer é viver uma vida tranquila com a minha família."
                }
            ]
        },
        {
            "talkId": "6703805",
            "initDialog": "670380501",
            "dialogues": [
                {
                    "id": "670380501",
                    "speaker": "Koloman",
                    "text": "Duelo"
                }
            ]
        },
        {
            "talkId": "6703806",
            "initDialog": "670380601",
            "dialogues": [
                {
                    "id": "670380601",
                    "speaker": "Koloman",
                    "text": "Espera, eu ganhei mesmo?"
                }
            ]
        },
        {
            "talkId": "6703807",
            "initDialog": "670380701",
            "dialogues": [
                {
                    "id": "670380701",
                    "speaker": "Koloman",
                    "text": "Hmm, impressionante. Eu nunca soube que essa carta podia ser usada desse jeito..."
                }
            ]
        }
    ]
}