{
    "groupId": "1601",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Nora": 13,
        "Player": 4
    },
    "talks": [
        {
            "talkId": "6160101",
            "initDialog": "616010101",
            "dialogues": [
                {
                    "id": "616010101",
                    "speaker": "Nora",
                    "text": "O quê? Você quer brincar comigo?"
                }
            ]
        },
        {
            "talkId": "6160102",
            "initDialog": "616010201",
            "dialogues": [
                {
                    "id": "616010201",
                    "speaker": "Player",
                    "text": "E os seus pais?"
                },
                {
                    "id": "616010202",
                    "speaker": "Nora",
                    "text": "Meu pai é o Patton!"
                },
                {
                    "id": "616010203",
                    "speaker": "Nora",
                    "text": "Ele está naquele lugar onde todos os tios bêbados vão."
                },
                {
                    "id": "616010204",
                    "speaker": "Nora",
                    "text": "Meu pai é bem ocupado no trabalho, então eu brinco sozinha bastante."
                }
            ]
        },
        {
            "talkId": "6160103",
            "initDialog": "616010301",
            "dialogues": [
                {
                    "id": "616010301",
                    "speaker": "Player",
                    "text": "Ei, pequena, o que você está fazendo?"
                },
                {
                    "id": "616010302",
                    "speaker": "Nora",
                    "text": "Eu gosto de brincar junto à estátua de deus!"
                },
                {
                    "id": "616010303",
                    "speaker": "Nora",
                    "text": "É muito alta, e muito bonita."
                },
                {
                    "id": "616010304",
                    "speaker": "Nora",
                    "text": "Você já subiu ao topo? Tentei escalá-la uma vez, mas fui advertida pela Grace."
                },
                {
                    "id": "616010305",
                    "speaker": "Nora",
                    "text": "Grace é uma moça simpática, eu não quero deixá-la furiosa novamente."
                },
                {
                    "id": "616010306",
                    "speaker": "Nora",
                    "text": "Mas se você for lá em cima, eu quero saber como é a vista!"
                }
            ]
        },
        {
            "talkId": "6160104",
            "initDialog": "616010401",
            "dialogues": [
                {
                    "id": "616010401",
                    "speaker": "Player",
                    "text": "Adeus."
                },
                {
                    "id": "616010402",
                    "speaker": "Nora",
                    "text": "Ei, você já está indo?"
                }
            ]
        },
        {
            "talkId": "6160105",
            "initDialog": "616010501",
            "dialogues": [
                {
                    "id": "616010501",
                    "speaker": "Player",
                    "text": "Sobre Stormterror..."
                },
                {
                    "id": "616010502",
                    "speaker": "Nora",
                    "text": "Papai disse que o Stormterror deve ter aparecido, pois eu quis subir na estátua dos deuses..."
                },
                {
                    "id": "616010503",
                    "speaker": "Nora",
                    "text": "Me desculpa! Eu nunca mais vou subir na estátua dos deuses novamente... *Buááá*"
                },
                {
                    "id": "616010504",
                    "speaker": "Nora",
                    "text": "Senhor Barbatos, por favor não fique bravo... *Buááá*"
                }
            ]
        }
    ]
}