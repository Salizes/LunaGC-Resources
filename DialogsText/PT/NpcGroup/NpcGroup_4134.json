                {
                    "id": "641340101",
                    "speaker": "Servan",
                    "text": "Com licença, gostaria de ver as novidades?"
                }
            ]
        },
        {
            "talkId": "6413402",
            "initDialog": "641340201",
            "dialogues": [
                {
                    "id": "641340201",
                    "speaker": "Player",
                    "text": "De novo?"
                },
                {
                    "id": "641340202",
                    "speaker": "Servan",
                    "text": "Ahn? Como assim \"de novo\"?"
                },
                {
                    "id": "641340203",
                    "speaker": "Servan",
                    "text": "Eu tenho coisas inéditas aqui que você nunca viu antes!"
                },
                {
                    "id": "641340204",
                    "speaker": "Servan",
                    "text": "Veja essa \"Gosma de Slime\". Pode ser moldada em qualquer forma e ainda gruda na parede."
                },
                {
                    "id": "641340205",
                    "speaker": "Servan",
                    "text": "E tem esse \"Voador\". É só esfregar entre as duas mãos para ele subir pelo ar!"
                },
                {
                    "id": "641340206",
                    "speaker": "Servan",
                    "text": "#Que tal? Legal, né? Pode brincar você mesm{F#a}{M#o} ou então dar para as crianças. Todos gostam!"
                },
                {
                    "id": "641340207",
                    "speaker": "Servan",
                    "text": "Ei! Espere! Não vá embora..."
                }
            ]
        },
        {
            "talkId": "6413403",
            "initDialog": "641340301",
            "dialogues": [
                {
                    "id": "641340301",
                    "speaker": "Player",
                    "text": "Tchau!"
                },
                {
                    "id": "641340302",
                    "speaker": "Servan",
                    "text": "Não vá! Tenho outras coisas para mostrar!"
                }
            ]
        }
    ]
