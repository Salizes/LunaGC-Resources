    "talks": [
        {
            "talkId": "6225501",
            "initDialog": "622550101",
            "dialogues": [
                {
                    "id": "622550101",
                    "speaker": "Muli",
                    "text": "#Olá, {M#convidado alto}{F#convidada alta}. Sabe como pescar?"
                }
            ]
        },
        {
            "talkId": "6225502",
            "initDialog": "622550201",
            "dialogues": [
                {
                    "id": "622550201",
                    "speaker": "Player",
                    "text": "Nunca pesquei muito..."
                },
                {
                    "id": "622550202",
                    "speaker": "Muli",
                    "text": "#Então vamos pescar junt{M#os}{F#as}! Pescaria é uma das coisas mais interessantes no mundo!"
                }
            ]
        },
        {
            "talkId": "6225503",
            "initDialog": "622550301",
            "dialogues": [
                {
                    "id": "622550301",
                    "speaker": "Player",
                    "text": "#Eu sou um{F#a} mestre na pesca!"
                },
                {
                    "id": "622550302",
                    "speaker": "Muli",
                    "text": "Sério? Nesse caso, você... acha que é possível pescar utensílios de jade?"
                }
            ]
        },
        {
            "talkId": "6225504",
            "initDialog": "622550401",
            "dialogues": [
                {
                    "id": "622550401",
                    "speaker": "Player",
                    "text": "Adeus."
                },
                {
                    "id": "622550402",
                    "speaker": "Muli",
                    "text": "Tchau! Vou continuar pensando em pescaria!"
                }
            ]
        },
        {
            "talkId": "6225505",
            "initDialog": "622550501",
            "dialogues": [
                {
                    "id": "622550501",
                    "speaker": "Player",
                    "text": "Por que você tem pensaria isso?"
                },
                {
                    "id": "622550502",
                    "speaker": "Muli",
                    "text": "Eu amo pescar, especialmente quando é com Qiongjiu!"
                },
                {
                    "id": "622550503",
                    "speaker": "Muli",
                    "text": "Mas meu pai diz que alguém deve herdar os negócios de jade da nossa família..."
                },
                {
                    "id": "622550504",
                    "speaker": "Muli",
                    "text": "Então seria perfeito se eu pudesse pescar alguns itens de jade! Você também não acha?!"
                },
                {
                    "id": "622550505",
                    "speaker": "Muli",
                    "text": "Ou talvez eu peça a Pequeno Mao para aprender como fazer itens de jade enquanto eu vou pescar com Qiongjiu! Isso também seria ótimo!"
                }
            ]
        }
    ]
}