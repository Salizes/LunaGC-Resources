    "talks": [
        {
            "talkId": "6405701",
            "initDialog": "640570101",
            "dialogues": [
                {
                    "id": "640570101",
                    "speaker": "Hushang",
                    "text": "Se eu pudesse entrar no mercado de Liyue..."
                }
            ]
        },
        {
            "talkId": "6405702",
            "initDialog": "640570201",
            "dialogues": [
                {
                    "id": "640570201",
                    "speaker": "Player",
                    "text": "Qual o plano?"
                },
                {
                    "id": "640570202",
                    "speaker": "Hushang",
                    "text": "É sobre o mercado de brinquedos. Ouvi pessoas dizerem que os brinquedos de Snezhnaya vendem bem em Liyue, o que me deixa um pouco arrependido."
                },
                {
                    "id": "640570203",
                    "speaker": "Hushang",
                    "text": "Se eu puder aproveitar a oportunidade de levar meus brinquedos infantis feitos à mão para Liyue, definitivamente seriam mais popular do que os produtos de Snezhnaya!"
                },
                {
                    "id": "640570204",
                    "speaker": "Hushang",
                    "text": "Como poderiam entender o coração de uma criança em um lugar tão frio como aquele?"
                }
            ]
        },
        {
            "talkId": "6405703",
            "initDialog": "640570301",
            "dialogues": [
                {
                    "id": "640570301",
                    "speaker": "Player",
                    "text": "Adeus."
                },
                {
                    "id": "640570302",
                    "speaker": "Hushang",
                    "text": "Quanto arrependimento!"
                }
            ]
        },
        {
            "talkId": "6405704",
            "initDialog": "640570401",
            "dialogues": [
                {
                    "id": "640570401",
                    "speaker": "Player",
                    "text": "Duelo"
                }
            ]
        },
        {
            "talkId": "6405705",
            "initDialog": "640570501",
            "dialogues": [
                {
                    "id": "640570501",
                    "speaker": "Hushang",
                    "text": "*Suspiro* Qual é a diversão em jogar cartas?... Vem, é melhor você dar uma olhada nos brinquedos que eu fiz..."
                }
            ]
        },
        {
            "talkId": "6405706",
            "initDialog": "640570601",
            "dialogues": [
                {
                    "id": "640570601",
                    "speaker": "Hushang",
                    "text": "Ganhei! Sendo fabricante de brinquedos, sou praticamente colega desses fabricantes de cartas. Consigo entender melhor as ideias deles!"
                }
            ]
        }
    ]
}