    "talks": [
        {
            "talkId": "6759801",
            "initDialog": "675980101",
            "dialogues": [
                {
                    "id": "675980101",
                    "speaker": "Tolstaya",
                    "text": "#Bem-vind{F#a}{M#o}! O que gostaria de pedir? Peça o que quiser!"
                }
            ]
        },
        {
            "talkId": "6759802",
            "initDialog": "675980201",
            "dialogues": [
                {
                    "id": "675980201",
                    "speaker": "Player",
                    "text": "Gostaria de ver o cardápio..."
                },
                {
                    "id": "675980202",
                    "speaker": "Tolstaya",
                    "text": "Certamente. Por favor, olhe aqui..."
                }
            ]
        },
        {
            "talkId": "6759803",
            "initDialog": "675980301",
            "dialogues": [
                {
                    "id": "675980301",
                    "speaker": "Player",
                    "text": "Este restaurante é muito bonito..."
                },
                {
                    "id": "675980302",
                    "speaker": "Tolstaya",
                    "text": "Claro que é! Este é o restaurante da Srta. Vodyanitsa, da Srta. Odette e do Sr. Alyosha..."
                },
                {
                    "id": "675980303",
                    "speaker": "Tolstaya",
                    "text": "#...Ah! V-Você é {NICKNAME}, não é? A Srta. Vodyanitsa me falou sobre você."
                },
                {
                    "id": "675980304",
                    "speaker": "Tolstaya",
                    "text": "Ela disse que você tem muito bom gosto e que é uma pessoa muito gentil. Este restaurante só ficou tão bonito graças à sua ajuda."
                }
            ]
        },
        {
            "talkId": "6759804",
            "initDialog": "675980401",
            "dialogues": [
                {
                    "id": "675980401",
                    "speaker": "Player",
                    "text": "Adeus."
                },
                {
                    "id": "675980402",
                    "speaker": "Tolstaya",
                    "text": "Cuide-se. Aguardamos sua próxima visita!"
                }
            ]
        },
        {
            "talkId": "6759805",
            "initDialog": "675980501",
            "dialogues": [
                {
                    "id": "675980501",
                    "speaker": "Player",
                    "text": "Eu não fiz nada tão impressionante assim..."
                },
                {
                    "id": "675980502",
                    "speaker": "Tolstaya",
                    "text": "Quanta modéstia! A Srta. Vodyanitsa também mencionou isso. Você é exatamente como ela disse."
                },
                {
                    "id": "675980503",
                    "speaker": "Tolstaya",
                    "text": "Veio fazer um pedido? Nesse caso, dê uma olhada no menu. Prometo que vou usar só os melhores ingredientes!"
                }
            ]
        }
    ]
}