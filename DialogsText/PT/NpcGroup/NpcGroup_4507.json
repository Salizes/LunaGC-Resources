            "dialogues": [
                {
                    "id": "645070101",
                    "speaker": "Venipi",
                    "text": "#Olá, {NICKNAME}."
                }
            ]
        },
        {
            "talkId": "6450702",
            "initDialog": "645070201",
            "dialogues": [
                {
                    "id": "645070201",
                    "speaker": "Player",
                    "text": "Fale sobre a sua era."
                },
                {
                    "id": "645070202",
                    "speaker": "Venipi",
                    "text": "Minha era?"
                },
                {
                    "id": "645070203",
                    "speaker": "Venipi",
                    "text": "Bom, oficialmente eu era aprendiz. Na realidade, só carregava tijolo."
                },
                {
                    "id": "645070204",
                    "speaker": "Venipi",
                    "text": "Se tem uma coisa que vale a pena mencionar sobre aqueles dias..."
                },
                {
                    "id": "645070205",
                    "speaker": "Venipi",
                    "text": "Todo mundo que trabalhou no Mausoléu do Rei Deshret ganhava ração dupla de cerveja todo dia."
                },
                {
                    "id": "645070206",
                    "speaker": "Venipi",
                    "text": "Ah, sinto falta daqueles tempos... embora não lembre mais do gosto."
                }
            ]
        },
        {
            "talkId": "6450703",
            "initDialog": "645070301",
            "dialogues": [
                {
                    "id": "645070301",
                    "speaker": "Player",
                    "text": "Onde está Kshama?"
                },
                {
                    "id": "645070302",
                    "speaker": "Venipi",
                    "text": "Kshama foi inspecionar o prédio e ver o que foi danificado."
                },
                {
                    "id": "645070303",
                    "speaker": "Venipi",
                    "text": "Mas não precisa se preocupar com ela. Aqui está seguro agora."
                }
            ]
        },
        {
            "talkId": "6450704",
            "initDialog": "645070401",
            "dialogues": [
                {
                    "id": "645070401",
                    "speaker": "Player",
                    "text": "Sobre o Ranqueamento de Poder de Combate..."
                },
                {
                    "id": "645070402",
                    "speaker": "Venipi",
                    "text": "Olha, isso é alto nível, sem dúvida."
                }
            ]
        },
        {
            "talkId": "6450705",
            "initDialog": "645070501",
            "dialogues": [
                {
                    "id": "645070501",
                    "speaker": "Player",
                    "text": "Tchau."
                },
                {
                    "id": "645070502",
                    "speaker": "Venipi",
                    "text": "Adeus!"
                }
            ]
        }
    ]
