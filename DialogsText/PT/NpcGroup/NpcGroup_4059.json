            "dialogues": [
                {
                    "id": "640590101",
                    "speaker": "Farhad",
                    "text": "Quando chegar a hora da estreia, serei o primeiro a comprar os ingressos."
                }
            ]
        },
        {
            "talkId": "6405902",
            "initDialog": "640590201",
            "dialogues": [
                {
                    "id": "640590201",
                    "speaker": "Player",
                    "text": "Qual estreia?"
                },
                {
                    "id": "640590202",
                    "speaker": "Farhad",
                    "text": "É a nova peça que está sendo criada pelo Sr. Sheikh Zubayr."
                },
                {
                    "id": "640590203",
                    "speaker": "Farhad",
                    "text": "Não é de se estranhar que a Srta. Nilou esteja nela."
                },
                {
                    "id": "640590204",
                    "speaker": "Farhad",
                    "text": "As peças do Teatro Zubayr nunca decepcionam. Toda vez que há algo novo, todos os acadêmicos largam suas pesquisas e brigam pelos ingressos."
                },
                {
                    "id": "640590205",
                    "speaker": "Farhad",
                    "text": "Você tem que conferir também."
                }
            ]
        },
        {
            "talkId": "6405903",
            "initDialog": "640590301",
            "dialogues": [
                {
                    "id": "640590301",
                    "speaker": "Player",
                    "text": "Adeus."
                },
                {
                    "id": "640590302",
                    "speaker": "Farhad",
                    "text": "Tchau!"
                }
            ]
        }
    ]
