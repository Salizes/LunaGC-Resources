            "dialogues": [
                {
                    "id": "411154201",
                    "speaker": "Yuhua",
                    "text": "Venha logo para dentro, agora não é uma hora boa para ficar do lado de fora."
                }
            ]
        },
        {
            "talkId": "6220601",
            "initDialog": "622060101",
            "dialogues": [
                {
                    "id": "622060101",
                    "speaker": "Yuhua",
                    "text": "Saudações! Você está à procura de uma refeição ou um quarto para passar a noite?"
                }
            ]
        },
        {
            "talkId": "6220602",
            "initDialog": "622060201",
            "dialogues": [
                {
                    "id": "622060201",
                    "speaker": "Player",
                    "text": "Desculpe, mas quem é você?"
                },
                {
                    "id": "622060202",
                    "speaker": "Yuhua",
                    "text": "Sou a Yuhua, a garçonete do Albergue Wangshu."
                },
                {
                    "id": "622060203",
                    "speaker": "Yuhua",
                    "text": "Nada suspeito sobre mim, nem um pouco.",
                    "choices": [
                        {
                            "id": "622060204",
                            "text": "Queria saber mais de você.",
                            "response": [
                                {
                                    "id": "622060205",
                                    "speaker": "Yuhua",
                                    "text": "Sou garçonete neste estabelecimento. Receio que não haja muito mais a dizer além disso."
                                }
                            ]
                        },
                        {
                            "id": "622060206",
                            "text": "Me conte sobre o Albergue Wangshu.",
                            "response": [
                                {
                                    "id": "622060207",
                                    "speaker": "Yuhua",
                                    "text": "O Albergue Wangshu está situado em uma localização conveniente em uma das principais vias que circula entre Mondstadt e Liyue. Com acomodações agradáveis a um preço acessível, simplesmente não há melhor opção para viajantes que precisam de um lugar para passar a noite."
                                },
                                {
                                    "id": "622060208",
                                    "speaker": "Yuhua",
                                    "text": "Nada suspeito sobre isso, nem um pouco. Hahahahahahaha."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6220603",
            "initDialog": "622060301",
            "dialogues": [
                {
                    "id": "622060301",
                    "speaker": "Player",
                    "text": "Adeus."
                },
                {
                    "id": "622060302",
                    "speaker": "Yuhua",
                    "text": "#Você é sempre bem-vind{M#o}{F#a} ao Albergue Wangshu. Venha sempre que quiser!"
                }
            ]
        },
        {
            "talkId": "6220604",
            "initDialog": "622060401",
            "dialogues": [
                {
                    "id": "622060401",
                    "speaker": "Yuhua",
                    "text": "Saudações! Você está à procura de uma refeição ou um quarto para passar a noite?"
                }
            ]
        },
        {
            "talkId": "6220605",
            "initDialog": "622060501",
            "dialogues": [
                {
                    "id": "622060501",
                    "speaker": "Player",
                    "text": "Posso perguntar quem é você?"
                },
                {
                    "id": "622060502",
                    "speaker": "Yuhua",
                    "text": "Eu sou Xiuhua, membro da equipe aqui no Albergue Wangshu."
                },
                {
                    "id": "622060503",
                    "speaker": "Yuhua",
                    "text": "Não há... nada suspeitoso.",
                    "choices": [
                        {
                            "id": "622060504",
                            "text": "Qual é a sua história?",
                            "response": [
                                {
                                    "id": "622060505",
                                    "speaker": "Yuhua",
                                    "text": "Você, quer saber sobre o que eu faço? ... Como você descobriu... Nada, esquece..."
                                }
                            ]
                        },
                        {
                            "id": "622060506",
                            "text": "Me conte sobre o Albergue Wangshu.",
                            "response": [
                                {
                                    "id": "622060507",
                                    "speaker": "Yuhua",
                                    "text": "O... o albergue... Ela poderia ter deixado escapar sobre a nossa missão da Qixing? O quê? Não, eu não disse nada..."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6220606",
            "initDialog": "622060601",
            "dialogues": [
                {
                    "id": "622060601",
                    "speaker": "Player",
                    "text": "Adeus."
                },
                {
                    "id": "622060602",
                    "speaker": "Yuhua",
                    "text": "O Albergue Wangshu sempre te dará as boas-vindas. Volte sempre!"
                }
            ]
        }
    ]
