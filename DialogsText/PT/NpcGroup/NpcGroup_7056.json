        {
            "talkId": "6705602",
            "initDialog": "670560201",
            "dialogues": [
                {
                    "id": "670560201",
                    "speaker": "Player",
                    "text": "Sobre a Cidade de Nasha..."
                },
                {
                    "id": "670560202",
                    "speaker": "Hurley",
                    "text": "#Tem uma Associação Comercial e um porto dentro, também tem bancos. Se você precisar de comida ou hospedagem, pode procurar sozinh{M#o}{F#a}."
                }
            ]
        },
        {
            "talkId": "6705603",
            "initDialog": "670560301",
            "dialogues": [
                {
                    "id": "670560301",
                    "speaker": "Player",
                    "text": "Aquela pessoa também é um guarda?"
                },
                {
                    "id": "670560302",
                    "speaker": "Hurley",
                    "text": "Não faço ideia. Eu sei que eu sou."
                }
            ]
        },
        {
            "talkId": "6705604",
            "initDialog": "670560401",
            "dialogues": [
                {
                    "id": "670560401",
                    "speaker": "Player",
                    "text": "Tudo bem. Não vou mais te incomodar..."
                },
                {
                    "id": "670560402",
                    "speaker": "Hurley",
                    "text": "Adeus."
                }
            ]
        },
        {
            "talkId": "6705605",
            "initDialog": "670560501",
            "dialogues": [
                {
                    "id": "670560501",
                    "speaker": "Player",
                    "text": "Ser um guarda parece ser fácil."
                },
                {
                    "id": "670560502",
                    "speaker": "Hurley",
                    "text": "...Se isso é tudo, por favor, vá embora. Preciso voltar a dormir— digo, ficar de vigia."
                }
            ]
        },
        {
            "talkId": "6705606",
            "initDialog": "670560601",
            "dialogues": [
                {
                    "id": "670560601",
                    "speaker": "Player",
                    "text": "Ele parece meio suspeito..."
                },
                {
                    "id": "670560602",
                    "speaker": "Hurley",
                    "text": "Sério? De onde estou, você que parece suspeito."
                }
            ]
        }
    ]
