        "Jeht": 80,
        "Player": 22
    },
    "talks": [
        {
            "talkId": "7322054",
            "initDialog": "732205401",
            "dialogues": [
                {
                    "id": "732205401",
                    "speaker": "Jeht",
                    "text": "#Ah, {NICKNAME}, é você... O que foi? Precisa de algo?",
                    "choices": [
                        {
                            "id": "732205402",
                            "text": "Sobre o Oásis Eterno...",
                            "response": [
                                {
                                    "id": "732205403",
                                    "speaker": "Jeht",
                                    "text": "Foi graças a você que conseguimos chegar ao Oásis Eterno. Se não fosse pela sua ajuda, não teríamos como ter aberto o caminho."
                                },
                                {
                                    "id": "732205404",
                                    "speaker": "Jeht",
                                    "text": "Eu não sei como te agradecer... Na próxima vez que acendermos uma fogueira, vamos conversar perto dela, será como..."
                                },
                                {
                                    "id": "732205405",
                                    "speaker": "Jeht",
                                    "text": "Será igual a última vez com Azariq... *Suspiro*..."
                                },
                                {
                                    "id": "732205406",
                                    "speaker": "Jeht",
                                    "text": "... Aquele traidor..."
                                },
                                {
                                    "id": "732205407",
                                    "speaker": "Player",
                                    "text": "Desculpe..."
                                },
                                {
                                    "id": "732205408",
                                    "speaker": "Jeht",
                                    "text": "Não precisa se desculpar... Eu não estava com raiva sua."
                                },
                                {
                                    "id": "732205409",
                                    "speaker": "Jeht",
                                    "text": "A Matriarca me deixou preocupada. Eu posso ser um pouco descuidada, mas não sou estúpida."
                                },
                                {
                                    "id": "732205410",
                                    "speaker": "Jeht",
                                    "text": "Os esquemas daquela máquina antiga... Não compartilhar aquilo com a tribo era um crime. No momento em que percebi isso, comecei a suspeitar dele."
                                },
                                {
                                    "id": "732205411",
                                    "speaker": "Jeht",
                                    "text": "O que eu não esperava, no entanto, era a sua vontade de continuar com os esquemas mesmo depois de passarmos tempo juntos... Como se ele pensasse que soubesse como lidar comigo..."
                                },
                                {
                                    "id": "732205412",
                                    "speaker": "Jeht",
                                    "text": "Fico enojada só de pensar nisso..."
                                },
                                {
                                    "id": "732205413",
                                    "speaker": "Jeht",
                                    "text": "Ainda bem, a Matriarca Babel sempre esteve do meu lado. Eu acredito que ela pode ajudar a tribo a prosperar novamente..."
                                },
                                {
                                    "id": "732205414",
                                    "speaker": "Jeht",
                                    "text": "Com certeza."
                                },
                                {
                                    "id": "732205415",
                                    "speaker": "Jeht",
                                    "text": "E você, você também está do meu lado!",
                                    "choices": [
                                        {
                                            "id": "732205416",
                                            "text": "Sim. Eu sou uma \"Jehtista\" também!",
                                            "response": [
                                                {
                                                    "id": "732205417",
                                                    "speaker": "Jeht",
                                                    "text": "Jehtista? Soa tão... estranho. Como um apelido que a Paimon teria."
                                                },
                                                {
                                                    "id": "732205418",
                                                    "speaker": "Jeht",
                                                    "text": "#Mas, sério. Obrigada, {NICKNAME}! De verdade!"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "732205419",
                                            "text": "E se eu entrar em conflito com a Matriarca?",
                                            "response": [
                                                {
                                                    "id": "732205420",
                                                    "speaker": "Jeht",
                                                    "text": "..."
                                                },
                                                {
                                                    "id": "732205421",
                                                    "speaker": "Jeht",
                                                    "text": "#Haha! Você deve estar brincando. Você é a convidad{M#o}{F#a} de honra dos Tanit, a pessoa que trouxe a Mãe das Jinni de volta e encontrou o caminho para o Oásis Eterno..."
                                                },
                                                {
                                                    "id": "732205422",
                                                    "speaker": "Jeht",
                                                    "text": "Eu não consigo pensar em um motivo para você entrar em conflito com a Matriarca."
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "732205423",
                            "text": "Deixa pra lá...",
                            "response": [
                                {
                                    "id": "732205424",
                                    "speaker": "Jeht",
                                    "text": "É, então... Se precisar da minha ajuda, me avise."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7322058",
            "initDialog": "732205801",
            "dialogues": [
                {
                    "id": "732205801",
                    "speaker": "Jeht",
                    "text": "#... {NICKNAME}, é você. Já voltou de Gurabad?"
                },
                {
                    "id": "732205802",
                    "speaker": "Jeht",
                    "text": "Ah, sim. Você estava procurando por mim? O que houve? Os Tanit estão bem ocupados no momento...",
                    "choices": [
                        {
                            "id": "732205803",
                            "text": "Sobre Liloupar...",
                            "response": [
                                {
                                    "id": "732205804",
                                    "speaker": "Jeht",
                                    "text": "Sim, eu soube. Ela foi embora. Voltou para aquele lugar amaldiçoado."
                                },
                                {
                                    "id": "732205805",
                                    "speaker": "Jeht",
                                    "text": "Pff, ela e sua arrogância diária me irritam muito, agora tudo finalmente está calmo. Que alívio."
                                },
                                {
                                    "id": "732205806",
                                    "speaker": "Jeht",
                                    "text": "Mas, ela nos ajudou bastante... Pensando bem, o que você acha que ela vai encontrar lá? E se não há nada para ser encontrado, será que ela se sentirá sozinha, como nós?"
                                },
                                {
                                    "id": "732205807",
                                    "speaker": "Jeht",
                                    "text": "É uma pena que não pude ir com você..."
                                }
                            ]
                        },
                        {
                            "id": "732205808",
                            "text": "Algum problema dos Tanit?",
                            "response": [
                                {
                                    "id": "732205809",
                                    "speaker": "Jeht",
                                    "text": "Sim, não é nada de mais. Mas eu não posso falar com você..."
                                },
                                {
                                    "id": "732205810",
                                    "speaker": "Jeht",
                                    "text": "É uma questão interna da tribo, e talvez envolva aquele povo do norte. Eu não sei bem os detalhes..."
                                },
                                {
                                    "id": "732205811",
                                    "speaker": "Jeht",
                                    "text": "Entretanto, hã..."
                                },
                                {
                                    "id": "732205812",
                                    "speaker": "Jeht",
                                    "text": "Entretanto...!"
                                },
                                {
                                    "id": "732205813",
                                    "speaker": "Jeht",
                                    "text": "Argh, eu sinto muito. Eu estou desse jeito porque... porque eu quero dizer é..."
                                },
                                {
                                    "id": "732205814",
                                    "speaker": "Jeht",
                                    "text": "Não! Se você encontrar com algum perigo, confie em mim! Eu sempre te ajudarei!"
                                },
                                {
                                    "id": "732205815",
                                    "speaker": "Jeht",
                                    "text": "E se eu encontrar com algo perigoso... Eu também confio que você virar me ajudar, não é?",
                                    "choices": [
                                        {
                                            "id": "732205816",
                                            "text": "Claro que sim.",
                                            "response": [
                                                {
                                                    "id": "732205817",
                                                    "speaker": "Jeht",
                                                    "text": "Obrigada... Você deveria tomar cuidado, está bem?"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "732205818",
                                            "text": "Claro, também não se esqueça de pagar.",
                                            "response": [
                                                {
                                                    "id": "732205819",
                                                    "speaker": "Jeht",
                                                    "text": "Hunf... Não mude de assunto com essa conversa de mercenário!"
                                                },
                                                {
                                                    "id": "732205820",
                                                    "speaker": "Jeht",
                                                    "text": "Só... tenha cuidado."
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "732205821",
                            "text": "Sobre Benben...",
                            "response": [
                                {
                                    "id": "732205822",
                                    "speaker": "Jeht",
                                    "text": "Foi graças a você que pegamos as coisas daquele povo do norte. Benben está se recuperando, parece cada vez melhor."
                                },
                                {
                                    "id": "732205823",
                                    "speaker": "Jeht",
                                    "text": "Ele está quase tão bom quando nos conhecemos..."
                                }
                            ]
                        },
                        {
                            "id": "732205824",
                            "text": "Por isso, quando você estiver livre...",
                            "response": [
                                {
                                    "id": "732205825",
                                    "speaker": "Jeht",
                                    "text": "Sim, conversaremos mais quando eu tiver tempo..."
                                },
                                {
                                    "id": "732205826",
                                    "speaker": "Jeht",
                                    "text": "Oh, sim, sim!"
                                },
                                {
                                    "id": "732205827",
                                    "speaker": "Jeht",
                                    "text": "Não é nada, mas, se você se deparar com algum problema, ou qualquer coisa perigosa, eu estarei ao seu lado. Por isso, tenha cuidado."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
