{
    "groupId": "9035",
    "total_dialogue_lines": 64,
    "speaker_counts": {
        "Player": 20,
        "Qiqi": 44
    },
    "talks": [
        {
            "talkId": "6903501",
            "initDialog": "690350101",
            "dialogues": [
                {
                    "id": "690350101",
                    "speaker": "Qiqi",
                    "text": "#Olá... Oh, {NICKNAME}, é você."
                },
                {
                    "id": "690350102",
                    "speaker": "Qiqi",
                    "text": "Eu me lembro de você."
                }
            ]
        },
        {
            "talkId": "6903502",
            "initDialog": "690350201",
            "dialogues": [
                {
                    "id": "690350201",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>Você se acostumou com esse lugar?</color>"
                },
                {
                    "id": "690350202",
                    "speaker": "Qiqi",
                    "text": "Aqui está bom. Muito calmo."
                },
                {
                    "id": "690350203",
                    "speaker": "Qiqi",
                    "text": "De dia também posso fazer meus exercícios de alongamentos, mas não posso ser vista por outras pessoas."
                },
                {
                    "id": "690350204",
                    "speaker": "Qiqi",
                    "text": "As coisas que preciso me lembrar, não são muitas.",
                    "choices": [
                        {
                            "id": "690350205",
                            "text": "Você trouxe suas notas?",
                            "response": [
                                {
                                    "id": "690350206",
                                    "speaker": "Qiqi",
                                    "text": "Notas? Notas..."
                                },
                                {
                                    "id": "690350207",
                                    "speaker": "Qiqi",
                                    "text": "Notas... O que é isso?"
                                },
                                {
                                    "id": "690350211",
                                    "speaker": "Player",
                                    "text": "(Oh não...)"
                                },
                                {
                                    "id": "690350213",
                                    "speaker": "Qiqi",
                                    "text": "Não precisa. Não tem problema."
                                },
                                {
                                    "id": "690350214",
                                    "speaker": "Qiqi",
                                    "text": "Porque Qiqi é muito incrível."
                                }
                            ]
                        },
                        {
                            "id": "690350208",
                            "text": "Qiqi, você não esquecerá como coletar ervas medicinais?",
                            "response": [
                                {
                                    "id": "690350209",
                                    "speaker": "Qiqi",
                                    "text": "Ervas medicinais? Ervas medicinais..."
                                },
                                {
                                    "id": "690350210",
                                    "speaker": "Qiqi",
                                    "text": "Ervas medicinais... O que é isso?"
                                },
                                {
                                    "id": "690350212",
                                    "speaker": "Player",
                                    "text": "Eu vou lhe ajudar a lembrar."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6903503",
            "initDialog": "690350301",
            "dialogues": [
                {
                    "id": "690350301",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>Você quer conversar comigo?</color>"
                },
                {
                    "id": "690350302",
                    "speaker": "Qiqi",
                    "text": "Conversar... Conversar..."
                },
                {
                    "id": "690350303",
                    "speaker": "Qiqi",
                    "text": "Conversar com você... É algo muito bom."
                },
                {
                    "id": "690350304",
                    "speaker": "Qiqi",
                    "text": "Mas..."
                },
                {
                    "id": "690350305",
                    "speaker": "Player",
                    "text": "O que houve?"
                },
                {
                    "id": "690350306",
                    "speaker": "Qiqi",
                    "text": "... Eu esqueço."
                },
                {
                    "id": "690350307",
                    "speaker": "Qiqi",
                    "text": "Sobre o que falamos, Qiqi pode esquecer."
                },
                {
                    "id": "690350308",
                    "speaker": "Qiqi",
                    "text": "O tom da voz, Qiqi pode esquecer."
                },
                {
                    "id": "690350309",
                    "speaker": "Qiqi",
                    "text": "A sensação de felicidade... Qiqi pode esquecer...",
                    "choices": [
                        {
                            "id": "690350310",
                            "text": "Mas desde que você esteja feliz agora, tudo está bem.",
                            "response": [
                                {
                                    "id": "690350311",
                                    "speaker": "Qiqi",
                                    "text": "Ah... Mesmo?"
                                },
                                {
                                    "id": "690350312",
                                    "speaker": "Qiqi",
                                    "text": "Se Qiqi ficar triste agora, você também ficará triste."
                                },
                                {
                                    "id": "690350316",
                                    "speaker": "Qiqi",
                                    "text": "Qiqi, sorria um pouco."
                                },
                                {
                                    "id": "690350317",
                                    "speaker": "Player",
                                    "text": "Seu sorriso é muito fofo, Qiqi."
                                },
                                {
                                    "id": "690350318",
                                    "speaker": "Qiqi",
                                    "text": "Ah..."
                                },
                                {
                                    "id": "690350319",
                                    "speaker": "Qiqi",
                                    "text": "É porque você está junto comigo."
                                }
                            ]
                        },
                        {
                            "id": "690350313",
                            "text": "Eu virei conversar com você todos os dias, Qiqi.",
                            "response": [
                                {
                                    "id": "690350314",
                                    "speaker": "Qiqi",
                                    "text": "Todos os dias... Vir..."
                                },
                                {
                                    "id": "690350315",
                                    "speaker": "Qiqi",
                                    "text": "Então eu... Vou ficar feliz todos os dias?"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6903504",
            "initDialog": "690350401",
            "dialogues": [
                {
                    "id": "690350401",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>O que você gostaria de fazer?</color>"
                },
                {
                    "id": "690350402",
                    "speaker": "Qiqi",
                    "text": "Quero criar um pássaro..."
                },
                {
                    "id": "690350403",
                    "speaker": "Qiqi",
                    "text": "Com você, nessa casa, criar um pássaro."
                },
                {
                    "id": "690350404",
                    "speaker": "Qiqi",
                    "text": "Procure milhete, eu vou procurar um pássaro."
                },
                {
                    "id": "690350405",
                    "speaker": "Qiqi",
                    "text": "Vamos dar a ele um ninho. O vento não vai desfazer, a chuva não vai quebrar."
                },
                {
                    "id": "690350406",
                    "speaker": "Qiqi",
                    "text": "De dia, Qiqi vai levar ele para caminhar. Antes de dormir, Qiqi fará os exercícios de alongamento com ele.",
                    "choices": [
                        {
                            "id": "690350407",
                            "text": "Qiqi, você parece com sua irmã.",
                            "response": [
                                {
                                    "id": "690350409",
                                    "speaker": "Qiqi",
                                    "text": "Sim! Qiqi será um bom exemplo!"
                                },
                                {
                                    "id": "690350410",
                                    "speaker": "Qiqi",
                                    "text": "Qiqi protegerá ele, e também protegerá você.",
                                    "choices": [
                                        {
                                            "id": "690350411",
                                            "text": "Proteger vocês também é minha responsabilidade.",
                                            "response": [
                                                {
                                                    "id": "690350413",
                                                    "speaker": "Qiqi",
                                                    "text": "Ok!"
                                                },
                                                {
                                                    "id": "690350414",
                                                    "speaker": "Qiqi",
                                                    "text": "Você, Qiqi, e o passarinho..."
                                                },
                                                {
                                                    "id": "690350415",
                                                    "speaker": "Qiqi",
                                                    "text": "Ótimo..."
                                                }
                                            ]
                                        },
                                        {
                                            "id": "690350412",
                                            "text": "#Obrigad{F#a}{M#o}, Qiqi."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "690350408",
                            "text": "Com certeza crescerá bem saudável."
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6903505",
            "initDialog": "690350501",
            "dialogues": [
                {
                    "id": "690350501",
                    "speaker": "Player",
                    "text": "Bom dia, Qiqi."
                },
                {
                    "id": "690350502",
                    "speaker": "Qiqi",
                    "text": "#Bom dia, {NICKNAME}."
                },
                {
                    "id": "690350503",
                    "speaker": "Qiqi",
                    "text": "Não se esqueça, traga coisas."
                }
            ]
        },
        {
            "talkId": "6903506",
            "initDialog": "690350601",
            "dialogues": [
                {
                    "id": "690350601",
                    "speaker": "Player",
                    "text": "Boa noite, Qiqi."
                },
                {
                    "id": "690350602",
                    "speaker": "Qiqi",
                    "text": "Boa noite, eu também lhe protegerei em seus sonhos."
                }
            ]
        },
        {
            "talkId": "6903507",
            "initDialog": "690350701",
            "dialogues": [
                {
                    "id": "690350701",
                    "speaker": "Player",
                    "text": "Quer conversar comigo?"
                }
            ]
        },
        {
            "talkId": "6903508",
            "initDialog": "690350801",
            "dialogues": [
                {
                    "id": "690350801",
                    "speaker": "Player",
                    "text": "Gostaria de fazer alguma coisa?"
                }
            ]
        },
        {
            "talkId": "6903509",
            "initDialog": "690350901",
            "dialogues": [
                {
                    "id": "690350901",
                    "speaker": "Player",
                    "text": "Você já se acostumou com esse lugar?"
                }
            ]
        },
        {
            "talkId": "6903550",
            "initDialog": "690355001",
            "dialogues": [
                {
                    "id": "690355001",
                    "speaker": "Qiqi",
                    "text": "Essa sensação... Muito familiar... Deixe Qiqi ver as anotações dela."
                },
                {
                    "id": "690355002",
                    "speaker": "Qiqi",
                    "text": "Sim, é hora de colher ervas medicinas. E também hora de descansar, num lugar como esse."
                },
                {
                    "id": "690355003",
                    "speaker": "Qiqi",
                    "text": "Confirmar segurança, obrigada."
                }
            ]
        },
        {
            "talkId": "6903551",
            "initDialog": "690355101",
            "dialogues": [
                {
                    "id": "690355101",
                    "speaker": "Qiqi",
                    "text": "Nas notas, não registrei aqui."
                },
                {
                    "id": "690355102",
                    "speaker": "Qiqi",
                    "text": "Mas aqui é muito calmo, Qiqi gosta, depois posso ficar vindo sempre aqui?"
                },
                {
                    "id": "690355103",
                    "speaker": "Qiqi",
                    "text": "Anotei, obrigada."
                }
            ]
        }
    ]
}