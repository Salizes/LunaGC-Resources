        {
            "talkId": "6242001",
            "initDialog": "624200101",
            "dialogues": [
                {
                    "id": "624200101",
                    "speaker": "Huachu",
                    "text": "*Suspiro* Posso ajudar em alguma coisa?"
                }
            ]
        },
        {
            "talkId": "6242002",
            "initDialog": "624200201",
            "dialogues": [
                {
                    "id": "624200201",
                    "speaker": "Player",
                    "text": "Qual é a sua preocupação?"
                },
                {
                    "id": "624200202",
                    "speaker": "Huachu",
                    "text": "Oh eu estou bem. É apenas minha primeira vez fora de casa e ainda estou me acostumando."
                },
                {
                    "id": "624200203",
                    "speaker": "Huachu",
                    "text": "Até o chá aqui tem um gosto diferente do que estou acostumada..."
                }
            ]
        },
        {
            "talkId": "6242003",
            "initDialog": "624200301",
            "dialogues": [
                {
                    "id": "624200301",
                    "speaker": "Player",
                    "text": "Quem é você?"
                },
                {
                    "id": "624200302",
                    "speaker": "Huachu",
                    "text": "Ah sim, desculpe... Eu sou a segunda filha do gerente da Companhia Minghua. Hoje, excepcionalmente, eu decidi ir em uma excursão."
                },
                {
                    "id": "624200303",
                    "speaker": "Huachu",
                    "text": "Mas como esta é minha primeira excursão, estou lutando para me adaptar.",
                    "choices": [
                        {
                            "id": "624200304",
                            "text": "Só vocês?",
                            "response": [
                                {
                                    "id": "624200305",
                                    "speaker": "Huachu",
                                    "text": "Sim... Por consideração ao negócio, levei só um único parceiro de viagens."
                                }
                            ]
                        },
                        {
                            "id": "624200306",
                            "text": "Aonde você está indo?",
                            "response": [
                                {
                                    "id": "624200307",
                                    "speaker": "Huachu",
                                    "text": "Desculpe, isso é uma informação confidencial."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6242004",
            "initDialog": "624200401",
            "dialogues": [
                {
                    "id": "624200401",
                    "speaker": "Player",
                    "text": "Boa viagem."
                },
                {
                    "id": "624200402",
                    "speaker": "Huachu",
                    "text": "Igualmente para você."
                }
            ]
        }
    ]
}