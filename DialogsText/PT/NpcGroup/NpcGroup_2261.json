    "talks": [
        {
            "talkId": "6226101",
            "initDialog": "622610101",
            "dialogues": [
                {
                    "id": "622610101",
                    "speaker": "Djarkutan",
                    "text": "Podemos esquecer a temperatura e umidade, então deve ser um problema com o solo..."
                }
            ]
        },
        {
            "talkId": "6226102",
            "initDialog": "622610201",
            "dialogues": [
                {
                    "id": "622610201",
                    "speaker": "Player",
                    "text": "Você é...?"
                },
                {
                    "id": "622610202",
                    "speaker": "Djarkutan",
                    "text": "Sou Djarkutan, um pesquisador do Amurta. Estou aqui para conduzir pesquisa em árvores de chá."
                }
            ]
        },
        {
            "talkId": "6226103",
            "initDialog": "622610301",
            "dialogues": [
                {
                    "id": "622610301",
                    "speaker": "Player",
                    "text": "Até mais."
                },
                {
                    "id": "622610302",
                    "speaker": "Djarkutan",
                    "text": "Até mais."
                }
            ]
        },
        {
            "talkId": "6226104",
            "initDialog": "622610401",
            "dialogues": [
                {
                    "id": "622610401",
                    "speaker": "Player",
                    "text": "Esse tópico é muito vasto."
                },
                {
                    "id": "622610402",
                    "speaker": "Djarkutan",
                    "text": "*Suspiro* Não é como se eu tivesse outra escolha! Quanto mais incomum é um tema, mais fácil é escrever um artigo sobre ele."
                },
                {
                    "id": "622610403",
                    "speaker": "Djarkutan",
                    "text": "Transplante de árvores de chá, por exemplo. Praticamente ninguém na Academia presta atenção a isso, então eu não tenho rivais no tópico."
                },
                {
                    "id": "622610404",
                    "speaker": "Djarkutan",
                    "text": "Mas..."
                }
            ]
        },
        {
            "talkId": "6226105",
            "initDialog": "622610501",
            "dialogues": [
                {
                    "id": "622610501",
                    "speaker": "Player",
                    "text": "O que houve?"
                },
                {
                    "id": "622610502",
                    "speaker": "Djarkutan",
                    "text": "Não sei porque, as árvores de chá que plantamos em Sumeru nunca crescem."
                },
                {
                    "id": "622610503",
                    "speaker": "Djarkutan",
                    "text": "Após muita consideração, sinto que a razão deve ser o solo. Infelizmente, nunca entendi minhas aulas de hidrologia e geologia, e começar do zero agora é... difícil..."
                }
            ]
        }
    ]
}