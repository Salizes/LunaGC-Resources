            "dialogues": [
                {
                    "id": "632260101",
                    "speaker": "Wakamurasaki",
                    "text": "Olá! Você precisa de mais algumas Redes Oniubíquas?"
                }
            ]
        },
        {
            "talkId": "6322602",
            "initDialog": "632260201",
            "dialogues": [
                {
                    "id": "632260201",
                    "speaker": "Player",
                    "text": "Quero comprar uma Rede Oniubíqua."
                }
            ]
        },
        {
            "talkId": "6322603",
            "initDialog": "632260301",
            "dialogues": [
                {
                    "id": "632260301",
                    "speaker": "Player",
                    "text": "Então, sobre a Rede Oniubíqua..."
                },
                {
                    "id": "632260302",
                    "speaker": "Wakamurasaki",
                    "text": "Apesar de eu ainda estar pesquisando uma rede como essa, ainda não fiz nenhum progresso."
                },
                {
                    "id": "632260303",
                    "speaker": "Wakamurasaki",
                    "text": "Não importa se é a sua firmeza ou utilidade, ou até mesmo outra funcionalidade, nada chega no nível que Sango me disse..."
                },
                {
                    "id": "632260304",
                    "speaker": "Wakamurasaki",
                    "text": "*Suspiro* Onde será que errei..."
                },
                {
                    "id": "632260305",
                    "speaker": "Wakamurasaki",
                    "text": "Sango com certeza não lembraria da técnica errada."
                },
                {
                    "id": "632260306",
                    "speaker": "Wakamurasaki",
                    "text": "Se eu tiver a chance, com certeza perguntarei a ela."
                }
            ]
        },
        {
            "talkId": "6322604",
            "initDialog": "632260401",
            "dialogues": [
                {
                    "id": "632260401",
                    "speaker": "Player",
                    "text": "Adeus."
                },
                {
                    "id": "632260402",
                    "speaker": "Wakamurasaki",
                    "text": "Adeus, e tenha cuidado!"
                }
            ]
        }
    ]
}