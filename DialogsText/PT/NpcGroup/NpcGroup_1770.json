            "dialogues": [
                {
                    "id": "617700201",
                    "speaker": "Player",
                    "text": "Água de Fogo?"
                },
                {
                    "id": "617700202",
                    "speaker": "Matthaus",
                    "text": "Heh, sim! Acabei de voltar de uma viagem de negócios para Snezhnaya e trouxe um lote inteiro do bom!"
                },
                {
                    "id": "617700203",
                    "speaker": "Matthaus",
                    "text": "Tem um impacto forte, marcante e ardente, mas por baixo tem um toque agradável de cítrico e mel..."
                },
                {
                    "id": "617700204",
                    "speaker": "Matthaus",
                    "text": "Mesmo que você não beba muito, é um ótimo presente para os amigos! Feita pelos feéricos de Novokichevgrad, tudo de altíssima qualidade. O que você acha? Quer experimentar?"
                }
            ]
        },
        {
            "talkId": "6177003",
            "initDialog": "617700301",
            "dialogues": [
                {
                    "id": "617700301",
                    "speaker": "Player",
                    "text": "Talvez outra hora."
                },
                {
                    "id": "617700302",
                    "speaker": "Matthaus",
                    "text": "Haha, volte quando quiser!"
                }
            ]
        }
    ]
