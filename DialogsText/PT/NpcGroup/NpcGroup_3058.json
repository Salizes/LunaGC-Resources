            "dialogues": [
                {
                    "id": "630580101",
                    "speaker": "Yata Kouki",
                    "text": "Olá! Glória à Shogun e ao seu eterno..."
                },
                {
                    "id": "630580102",
                    "speaker": "Yata Kouki",
                    "text": "Espera aí, quem é você? E o que você está fazendo aqui?"
                }
            ]
        },
        {
            "talkId": "6305802",
            "initDialog": "630580201",
            "dialogues": [
                {
                    "id": "630580201",
                    "speaker": "Player",
                    "text": "Eu estou apenas de passagem."
                },
                {
                    "id": "630580202",
                    "speaker": "Yata Kouki",
                    "text": "É sério?"
                },
                {
                    "id": "630580203",
                    "speaker": "Yata Kouki",
                    "text": "Hmm... Você não estava fazendo nada suspeito antes, isso é certeza. Você pode passar."
                },
                {
                    "id": "630580204",
                    "speaker": "Yata Kouki",
                    "text": "A saída é por ali, portanto, não perambulem por aí. A sede da Comissão Tenryou pode ser um lugar confuso, e você não quer se \"perder\"."
                }
            ]
        },
        {
            "talkId": "6305803",
            "initDialog": "630580301",
            "dialogues": [
                {
                    "id": "630580301",
                    "speaker": "Player",
                    "text": "Tchau."
                },
                {
                    "id": "630580302",
                    "speaker": "Yata Kouki",
                    "text": "Estou te avisando. Não tenha nenhuma ideia errada!"
                }
            ]
        }
    ]
