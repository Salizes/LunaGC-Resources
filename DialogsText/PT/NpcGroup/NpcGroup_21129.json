            "dialogues": [
                {
                    "id": "741083701",
                    "speaker": "Player",
                    "text": "Então, onde estamos..."
                },
                {
                    "id": "741083702",
                    "speaker": "Elphane",
                    "text": "O destino da excursão atual é Erinnyes. Pontos interessantes que valem a pena serem visitados incluem a Fonte Lucine e a Ópera Epiclese."
                }
            ]
        },
        {
            "talkId": "7410838",
            "initDialog": "741083801",
            "dialogues": [
                {
                    "id": "741083801",
                    "speaker": "Player",
                    "text": "Então, esse navio aqui..."
                },
                {
                    "id": "741083802",
                    "speaker": "Elphane",
                    "text": "#Sejam bem-vind{F#as}{M#os} a Via Navia. O destino da excursão atual é Erinnyes. Pontos interessantes que valem a pena serem visitados incluem a Fonte Lucine e a Ópera Epiclese."
                }
            ]
        },
        {
            "talkId": "7410839",
            "initDialog": "741083901",
            "dialogues": [
                {
                    "id": "741083901",
                    "speaker": "Player",
                    "text": "Você..."
                },
                {
                    "id": "741083902",
                    "speaker": "Elphane",
                    "text": "Sou Elphane, a guia dessa viagem."
                },
                {
                    "id": "741083903",
                    "speaker": "Player",
                    "text": "Gostaria de perguntar sobre..."
                },
                {
                    "id": "741083904",
                    "speaker": "Elphane",
                    "text": "Melusines são um povo novo que nasceu em Fontaine. Tem muitas diferenças entre a gente e a humanidade."
                },
                {
                    "id": "741083905",
                    "speaker": "Player",
                    "text": "Ainda tem mais alguma coisa sobre as Melusines?"
                },
                {
                    "id": "741083906",
                    "speaker": "Elphane",
                    "text": "#Bem, a gente tem um segredo que pode dizer pra você, car{F#a}{M#o} passageir{F#a}{M#o}."
                },
                {
                    "id": "741083907",
                    "speaker": "Elphane",
                    "text": "Somos similares aos humanos em uma coisa. Cada uma tem uma personalidade diferente. Algumas de nós gostam de conversar, outras não."
                }
            ]
        },
        {
            "talkId": "7410840",
            "initDialog": "741084001",
            "dialogues": [
                {
                    "id": "741084001",
                    "speaker": "Player",
                    "text": "Quando o..."
                },
                {
                    "id": "741084002",
                    "speaker": "Elphane",
                    "text": "Imediatamente."
                }
            ]
        },
        {
            "talkId": "7410841",
            "initDialog": "741084101",
            "dialogues": [
                {
                    "id": "741084101",
                    "speaker": "Player",
                    "text": "Até depois."
                },
                {
                    "id": "741084102",
                    "speaker": "Elphane",
                    "text": "Até depois."
                }
            ]
        },
        {
            "talkId": "7410842",
            "initDialog": "741084201",
            "dialogues": [
                {
                    "id": "741084201",
                    "speaker": "Elphane",
                    "text": "Oi.",
                    "choices": [
                        {
                            "id": "741084202",
                            "text": "Esse Hidrônibus é muito...",
                            "response": [
                                {
                                    "id": "741084203",
                                    "speaker": "Elphane",
                                    "text": "\"O Centro Hidroviário do Distrito da Corte e o Instituto de Pesquisas de Engenharia de Energia Cinética de Fontaine estão trabalhando para melhorar a velocidade do Hidrônibus.\"",
                                    "choices": [
                                        {
                                            "id": "741084204",
                                            "text": "Eu ia dizer que é muito bonito.",
                                            "response": [
                                                {
                                                    "id": "741084205",
                                                    "speaker": "Elphane",
                                                    "text": "Estou feliz que você gostou."
                                                }
                                            ]
                                        },
                                        {
                                            "id": "741084206",
                                            "text": "Mas você nem ouviu o que eu disse sobre a velocidade...",
                                            "response": [
                                                {
                                                    "id": "741084207",
                                                    "speaker": "Elphane",
                                                    "text": "#Car{F#a}{M#o} passageir{F#a}{M#o}, comentários anteriores indicam que você achará o Hidrônibus ou muito rápido ou muito lento. A resposta oficial é a mesma para os dois casos."
                                                },
                                                {
                                                    "id": "741084208",
                                                    "speaker": "Elphane",
                                                    "text": "Claro, se você achar que a velocidade está perfeita, ótimo. Obrigada, em nome do Centro Hidroviário do Distrito da Corte e do Hidrônibus."
                                                },
                                                {
                                                    "id": "741084209",
                                                    "speaker": "Player",
                                                    "text": "Você tá de mal humor, Srta. Elphane?"
                                                },
                                                {
                                                    "id": "741084210",
                                                    "speaker": "Elphane",
                                                    "text": "Não, é só que..."
                                                },
                                                {
                                                    "id": "741084211",
                                                    "speaker": "Elphane",
                                                    "text": "... Desculpe."
                                                },
                                                {
                                                    "id": "741084212",
                                                    "speaker": "Elphane",
                                                    "text": "Hmm, vou ser franca, se você quiser experimentar o prazer do Hidrônibus, recomendo que você use a Via Clementine. Aeval é a guia."
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "741084213",
                            "text": "Você podia falar mais sobre Erinnyes?",
                            "response": [
                                {
                                    "id": "741084214",
                                    "speaker": "Elphane",
                                    "text": "Áreas recomendadas para visitas são a Fonte de Lucine e a Ópera Epiclese. Fora isso, não tenho nada pra recomendar. As ruínas do instituto estão no norte de Erinnyes...",
                                    "choices": [
                                        {
                                            "id": "741084215",
                                            "text": "#Bem, eu sou mesmo {F#uma aventureira}{M#um aventureiro}...",
                                            "response": [
                                                {
                                                    "id": "741084216",
                                                    "speaker": "Elphane",
                                                    "text": "Oh, não. Essa área é bem perigosa, e também há muitos Mecautômatos fora de controle nela."
                                                },
                                                {
                                                    "id": "741084217",
                                                    "speaker": "Elphane",
                                                    "text": "No entanto, a maior ameaça no momento são os tecnocratas do instituto. Eles podem passar um dia todo falando sem dizerem nenhuma palavra ou informação sobre o que pensam, é amedrontador."
                                                },
                                                {
                                                    "id": "741084219",
                                                    "speaker": "Elphane",
                                                    "text": "Não vá para as profundezas de Erinnyes."
                                                },
                                                {
                                                    "id": "741084220",
                                                    "speaker": "Player",
                                                    "text": "Por quê?"
                                                },
                                                {
                                                    "id": "741084221",
                                                    "speaker": "Elphane",
                                                    "text": "Sinto muito, mas não sei. Foi uma sugestão do Monsieur Neuvillette, e confio na sabedoria dele."
                                                }
                                            ]
                                        },
                                        {
                                            "id": "741084218",
                                            "text": "Mais alguma coisa?"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "741084222",
                            "text": "Até depois.",
                            "response": [
                                {
                                    "id": "741084223",
                                    "speaker": "Elphane",
                                    "text": "Até depois."
                                }
                            ]
                        }
                    ]
                }
            ]
