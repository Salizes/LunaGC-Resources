    "talks": [
        {
            "talkId": "4111501",
            "initDialog": "411150101",
            "dialogues": [
                {
                    "id": "411150101",
                    "speaker": "Mona",
                    "text": "Ah, é você, quer conversar sobre o que aconteceu um pouco?"
                }
            ]
        },
        {
            "talkId": "4111502",
            "initDialog": "411150201",
            "dialogues": [
                {
                    "id": "411150201",
                    "speaker": "Player",
                    "text": "Posição de adivinhação"
                },
                {
                    "id": "411150202",
                    "speaker": "Mona",
                    "text": "Hehe. A sabedoria que conecta a terra com as estrelas já mostrou o futuro. Estrelas cairão neste local, precisamente como as profecias de Beatrix disseram."
                }
            ]
        },
        {
            "talkId": "4111503",
            "initDialog": "411150301",
            "dialogues": [
                {
                    "id": "411150301",
                    "speaker": "Player",
                    "text": "Ver resultados"
                },
                {
                    "id": "411150302",
                    "speaker": "Mona",
                    "text": "Apesar de ser apenas o resultado da adivinhação, não deve ser inconsistente com os fatos."
                }
            ]
        },
        {
            "talkId": "4111504",
            "initDialog": "411150401",
            "dialogues": [
                {
                    "id": "411150401",
                    "speaker": "Player",
                    "text": "O que nós precisamos fazer?"
                },
                {
                    "id": "411150402",
                    "speaker": "Mona",
                    "text": "Ainda estou observando a direção do incidente, e algo grande acontecerá depois disso."
                },
                {
                    "id": "411150403",
                    "speaker": "Mona",
                    "text": "Você é responsável por inspecionar o resultado atual da previsão. Quanto mais se esforçar, mais rapidamente tudo se resolverá."
                },
                {
                    "id": "411150404",
                    "speaker": "Player",
                    "text": "Eu tenho outras perguntas..."
                },
                {
                    "id": "411150405",
                    "speaker": "Mona",
                    "text": "O que mais você quer saber?"
                }
            ]
        },
        {
            "talkId": "4111505",
            "initDialog": "411150501",
            "dialogues": [
                {
                    "id": "411150501",
                    "speaker": "Player",
                    "text": "Adeus"
                },
                {
                    "id": "411150502",
                    "speaker": "Mona",
                    "text": "Apesar de já ter dito que o futuro é pré-determinado... Lhe desejo boa sorte."
                }
            ]
        }
    ]
