    "talks": [
        {
            "talkId": "6226201",
            "initDialog": "622620101",
            "dialogues": [
                {
                    "id": "622620101",
                    "speaker": "Qiongjiu",
                    "text": "Eu não acho que já te vi antes... Você veio do Porto Yilong? Sabe como fazer itens de jade?"
                }
            ]
        },
        {
            "talkId": "6226202",
            "initDialog": "622620201",
            "dialogues": [
                {
                    "id": "622620201",
                    "speaker": "Player",
                    "text": "Bem, eu não..."
                },
                {
                    "id": "622620202",
                    "speaker": "Qiongjiu",
                    "text": "Ah, que pena. É a coisa mais interessante do mundo."
                },
                {
                    "id": "622620203",
                    "speaker": "Qiongjiu",
                    "text": "*Suspiro* Se eu pudesse pescar alguns itens de jade..."
                }
            ]
        },
        {
            "talkId": "6226203",
            "initDialog": "622620301",
            "dialogues": [
                {
                    "id": "622620301",
                    "speaker": "Player",
                    "text": "Adeus."
                },
                {
                    "id": "622620302",
                    "speaker": "Qiongjiu",
                    "text": "Certo, até mais!"
                }
            ]
        },
        {
            "talkId": "6226204",
            "initDialog": "622620401",
            "dialogues": [
                {
                    "id": "622620401",
                    "speaker": "Player",
                    "text": "Por que você pensaria isso?"
                },
                {
                    "id": "622620402",
                    "speaker": "Qiongjiu",
                    "text": "Se eu pescasse algo de jade, ia passar o dia todo brincando com Mu Li..."
                },
                {
                    "id": "622620403",
                    "speaker": "Qiongjiu",
                    "text": "Pescar é divertido, mas fazer itens de jade é mais interessante."
                },
                {
                    "id": "622620404",
                    "speaker": "Qiongjiu",
                    "text": "Mas se eu não treinar minha pesca segundo o que minha família disser, as habilidades de papai e mamãe serão perdidas."
                },
                {
                    "id": "622620405",
                    "speaker": "Qiongjiu",
                    "text": "Se Pequeno Mao quisesse aprender a pescar..."
                }
            ]
        }
    ]
}