        {
            "talkId": "6505001",
            "initDialog": "650500101",
            "dialogues": [
                {
                    "id": "650500101",
                    "speaker": "Justeau",
                    "text": "Desse jeito, as coisas realmente podem sair mal. Ninguém se importa?"
                }
            ]
        },
        {
            "talkId": "6505002",
            "initDialog": "650500201",
            "dialogues": [
                {
                    "id": "650500201",
                    "speaker": "Player",
                    "text": "Se importar com o quê?"
                },
                {
                    "id": "650500202",
                    "speaker": "Justeau",
                    "text": "O problema de poluição das nossas águas!"
                },
                {
                    "id": "650500203",
                    "speaker": "Justeau",
                    "text": "A crise é tão óbvia, como derramar tinta na água limpa, mas todo mundo só ignora."
                },
                {
                    "id": "650500204",
                    "speaker": "Justeau",
                    "text": "Será que apenas nós do Salão Caritat nos importamos com isso em toda nação?"
                }
            ]
        },
        {
            "talkId": "6505003",
            "initDialog": "650500301",
            "dialogues": [
                {
                    "id": "650500301",
                    "speaker": "Player",
                    "text": "Até depois."
                },
                {
                    "id": "650500302",
                    "speaker": "Justeau",
                    "text": "#Acredite em mim, amig{M#o}{F#a}, todos nós deveríamos estar fazendo algo quanto a isso!"
                }
            ]
        }
    ]
}