            "dialogues": [
                {
                    "id": "640110101",
                    "speaker": "Layth",
                    "text": "O clima da floresta tropical não é muito bom para mim..."
                }
            ]
        },
        {
            "talkId": "6401102",
            "initDialog": "640110201",
            "dialogues": [
                {
                    "id": "640110201",
                    "speaker": "Player",
                    "text": "O que houve?"
                },
                {
                    "id": "640110202",
                    "speaker": "Layth",
                    "text": "Minha velha ferida costumava doer no tempo úmido. Mas desde que fui enviado para a Cidade de Sumeru, ela dói bastante o tempo todo."
                },
                {
                    "id": "640110203",
                    "speaker": "Layth",
                    "text": "Então, por conta da dor, só posso fazer tarefas simples na cidade."
                },
                {
                    "id": "640110204",
                    "speaker": "Layth",
                    "text": "É realmente um dilema..."
                }
            ]
        },
        {
            "talkId": "6401103",
            "initDialog": "640110301",
            "dialogues": [
                {
                    "id": "640110301",
                    "speaker": "Player",
                    "text": "Adeus."
                },
                {
                    "id": "640110302",
                    "speaker": "Layth",
                    "text": "Quanto tempo até que possa me aposentar..."
                }
            ]
        }
    ]
