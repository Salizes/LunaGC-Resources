            "dialogues": [
                {
                    "id": "616600101",
                    "speaker": "Sage",
                    "text": "Olá!"
                }
            ]
        },
        {
            "talkId": "6166002",
            "initDialog": "616600201",
            "dialogues": [
                {
                    "id": "616600201",
                    "speaker": "Player",
                    "text": "E aí, garotinho."
                },
                {
                    "id": "616600202",
                    "speaker": "Sage",
                    "text": "Hmm! Me diga, você já ouviu falar do Mar de Dandelion?"
                }
            ]
        },
        {
            "talkId": "6166003",
            "initDialog": "616600301",
            "dialogues": [
                {
                    "id": "616600301",
                    "speaker": "Player",
                    "text": "Você disse, Mar de Dandelion?"
                },
                {
                    "id": "616600302",
                    "speaker": "Sage",
                    "text": "Uhum! Há um livro que eu li, onde diz que em algum lugar de Mondstadt existe um enoooorme mar de dandelions!"
                },
                {
                    "id": "616600303",
                    "speaker": "Sage",
                    "text": "Inclusive tem até raposinhas que falam!"
                }
            ]
        },
        {
            "talkId": "6166004",
            "initDialog": "616600401",
            "dialogues": [
                {
                    "id": "616600401",
                    "speaker": "Player",
                    "text": "Até mais, garotinho."
                },
                {
                    "id": "616600402",
                    "speaker": "Sage",
                    "text": "Adeusinho!"
                },
                {
                    "id": "616600403",
                    "speaker": "Sage",
                    "text": "Conte-me se você algum dia ver o Mar de Dandelion!"
                }
            ]
        },
        {
            "talkId": "6166005",
            "initDialog": "616600501",
            "dialogues": [
                {
                    "id": "616600501",
                    "speaker": "Player",
                    "text": "Raposinhas que falam?"
                },
                {
                    "id": "616600502",
                    "speaker": "Sage",
                    "text": "Sim! Eu gostaria de saber como seria falar com animais!"
                },
                {
                    "id": "616600503",
                    "speaker": "Sage",
                    "text": "Hmm... Mas eu só vi um cara com roupas verdes e meias brancas falar com animais antes. Acabei me esbarrando com ele por aí."
                },
                {
                    "id": "616600504",
                    "speaker": "Sage",
                    "text": "Eu contei à minha mãe como ele era incrível, mas ele disse que eu estava enganado..."
                }
            ]
        }
    ]
}