    "talks": [
        {
            "talkId": "7902321",
            "initDialog": "790232101",
            "dialogues": [
                {
                    "id": "790232101",
                    "speaker": "Chevka",
                    "text": "#*Suspira* O que vou fazer sobre o Yakov... O que houve, {NICKNAME}? Mais alguma coisa?",
                    "choices": [
                        {
                            "id": "790232102",
                            "text": "Por que você se juntou aos Fatui?",
                            "response": [
                                {
                                    "id": "790232103",
                                    "speaker": "Chevka",
                                    "text": "Por que... eu me juntei aos Fatui...?"
                                },
                                {
                                    "id": "790232104",
                                    "speaker": "Chevka",
                                    "text": "Bem, fiz isso para ajudar a realizar o desejo da Vossa Majestade a Mestre Tsaritsa... e trazer mais honra a minha família. Fui criado para lutar pela Tsaritsa."
                                }
                            ]
                        },
                        {
                            "id": "790232105",
                            "text": "Sobre Yakov...",
                            "response": [
                                {
                                    "id": "790232106",
                                    "speaker": "Chevka",
                                    "text": "*Suspira* Parece que Yakov ainda está delirando..."
                                }
                            ]
                        },
                        {
                            "id": "790232107",
                            "text": "Não é nada."
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7902332",
            "initDialog": "790233201",
            "dialogues": [
                {
                    "id": "790233201",
                    "speaker": "Vanguarda de Martelo Electro",
                    "text": "Não, eu tenho que... eu tenho que devolver-lhe a insígnia... eu tenho que achá-la...",
                    "choices": [
                        {
                            "id": "790233202",
                            "text": "(Não está prestando atenção...)"
                        },
                        {
                            "id": "790233203",
                            "text": "(Vamos ignorá-lo...)"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7902429",
            "initDialog": "790242901",
            "dialogues": [
                {
                    "id": "790242901",
                    "speaker": "Chevka",
                    "text": "Hehe, aquele pesquisador, Persikov, é muito mandão, nos força a fazer todo o trabalho duro..."
                },
                {
                    "id": "790242902",
                    "speaker": "Chevka",
                    "text": "Esse experimento falhou, quem sabe o que vai acontecer quando voltarmos."
                }
            ]
        }
    ]
