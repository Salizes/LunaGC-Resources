            "dialogues": [
                {
                    "id": "670710101",
                    "speaker": "Kotenkova",
                    "text": "Robôs são uma invenção maravilhosa! Eles são os melhores companheiros de lazer que alguém poderia desejar!"
                }
            ]
        },
        {
            "talkId": "6707102",
            "initDialog": "670710201",
            "dialogues": [
                {
                    "id": "670710201",
                    "speaker": "Player",
                    "text": "Como assim?"
                },
                {
                    "id": "670710202",
                    "speaker": "Kotenkova",
                    "text": "Bem, eles são de muita ajuda quando estou trabalhando, mas onde eles brilham mesmo é em fornecer valor emocional."
                },
                {
                    "id": "670710203",
                    "speaker": "Kotenkova",
                    "text": "Trabalhar com robôs ajuda a reduzir o estresse de trabalhar... Mas brincar com eles é ainda melhor!"
                }
            ]
        },
        {
            "talkId": "6707103",
            "initDialog": "670710301",
            "dialogues": [
                {
                    "id": "670710301",
                    "speaker": "Player",
                    "text": "Adeus."
                },
                {
                    "id": "670710302",
                    "speaker": "Kotenkova",
                    "text": "Tá certo, então tchau."
                }
            ]
        }
    ]
}