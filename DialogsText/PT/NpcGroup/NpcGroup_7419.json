            "dialogues": [
                {
                    "id": "674190101",
                    "speaker": "Eliseev",
                    "text": "Preciso de algo? É só seguir em frente... *Bocejo*..."
                }
            ]
        },
        {
            "talkId": "6741902",
            "initDialog": "674190201",
            "dialogues": [
                {
                    "id": "674190201",
                    "speaker": "Player",
                    "text": "Você parece bem cansado."
                },
                {
                    "id": "674190202",
                    "speaker": "Eliseev",
                    "text": "Só um pouco, mas... Aah! Os Volkodlaks às vezes são assim..."
                },
                {
                    "id": "674190203",
                    "speaker": "Eliseev",
                    "text": "Eu prometo pra você que... *Bocejo* Isso não vai afetar meu trabalho."
                }
            ]
        },
        {
            "talkId": "6741903",
            "initDialog": "674190301",
            "dialogues": [
                {
                    "id": "674190301",
                    "speaker": "Player",
                    "text": "Por que você não vai descansar um pouco?"
                },
                {
                    "id": "674190302",
                    "speaker": "Eliseev",
                    "text": "Oh, descansar. Não tem como se resolver esse problema."
                },
                {
                    "id": "674190303",
                    "speaker": "Eliseev",
                    "text": "Quando o tempo muda, o corpo de cada Volkodlak possui reações diferentes. Não somos como os humanos."
                },
                {
                    "id": "674190304",
                    "speaker": "Eliseev",
                    "text": "Por isso estou mais cansado que o normal..."
                }
            ]
        },
        {
            "talkId": "6741904",
            "initDialog": "674190401",
            "dialogues": [
                {
                    "id": "674190401",
                    "speaker": "Player",
                    "text": "Não quero comer nada."
                },
                {
                    "id": "674190402",
                    "speaker": "Eliseev",
                    "text": "Ah, certo..."
                }
            ]
        }
    ]
