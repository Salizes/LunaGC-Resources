            "dialogues": [
                {
                    "id": "630930101",
                    "speaker": "Yokoyama",
                    "text": "#Precisa de algo, forasteir{F#a}{M#o}?"
                }
            ]
        },
        {
            "talkId": "6309302",
            "initDialog": "630930201",
            "dialogues": [
                {
                    "id": "630930201",
                    "speaker": "Player",
                    "text": "Que lugar é este?"
                },
                {
                    "id": "630930202",
                    "speaker": "Yokoyama",
                    "text": "#Este é um local importante da Comissão Kanjou que {F#uma forasteira}{M#um forasteiro} como você não deve visitar."
                },
                {
                    "id": "630930203",
                    "speaker": "Yokoyama",
                    "text": "Se você deseja se encontrar com o Comissário de Kanjou, deve dirigir-se à Agência de Assuntos Externos e entregar sua carta e seu cartão de visita."
                },
                {
                    "id": "630930204",
                    "speaker": "Yokoyama",
                    "text": "Quanto a se você pode se encontrar com o comissário... Eu diria que dependerá da sua sorte."
                }
            ]
        },
        {
            "talkId": "6309304",
            "initDialog": "630930401",
            "dialogues": [
                {
                    "id": "630930401",
                    "speaker": "Player",
                    "text": "Tchau..."
                },
                {
                    "id": "630930402",
                    "speaker": "Yokoyama",
                    "text": "Hunf, adeus."
                }
            ]
        },
        {
            "talkId": "6309305",
            "initDialog": "630930501",
            "dialogues": [
                {
                    "id": "630930501",
                    "speaker": "Yokoyama",
                    "text": "#Olá, posso ajudá-l{F#a}{M#o}?"
                }
            ]
        },
        {
            "talkId": "6309306",
            "initDialog": "630930601",
            "dialogues": [
                {
                    "id": "630930601",
                    "speaker": "Player",
                    "text": "Que lugar é este?"
                },
                {
                    "id": "630930602",
                    "speaker": "Yokoyama",
                    "text": "Esse daqui é um local chave para a Comissão Kanjou, o centro de administração de todo Ritou."
                },
                {
                    "id": "630930603",
                    "speaker": "Yokoyama",
                    "text": "Se você gostaria de se encontrar com o líder do Clã, temo que não seja uma boa hora."
                },
                {
                    "id": "630930604",
                    "speaker": "Yokoyama",
                    "text": "Ninguém pode ver o líder do Clã até que a Toda-Poderosa Shogun, a Ogosho, faça seu julgamento."
                }
            ]
        },
        {
            "talkId": "6309307",
