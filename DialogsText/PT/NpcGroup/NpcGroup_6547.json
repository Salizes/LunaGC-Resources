        {
            "talkId": "6654702",
            "initDialog": "665470201",
            "dialogues": [
                {
                    "id": "665470201",
                    "speaker": "Player",
                    "text": "Olá, \"Srta. Patrulha Aérea Asha\"."
                },
                {
                    "id": "665470202",
                    "speaker": "Tikraq",
                    "text": "Haha, não me provoque. Você precisa de alguma coisa? Ou você ficou pensando na Patrulha Aérea Asha esse tempo todo?"
                },
                {
                    "id": "665470203",
                    "speaker": "Tikraq",
                    "text": "Seja para admirar a paisagem ou criar uma nova obra-prima, se quiser viver essa experiência de novo, posso te levar de balão de ar quente."
                }
            ]
        },
        {
            "talkId": "6654703",
            "initDialog": "665470301",
            "dialogues": [
                {
                    "id": "665470301",
                    "speaker": "Player",
                    "text": "Vou deixar com você, então."
                },
                {
                    "id": "665470302",
                    "speaker": "Tikraq",
                    "text": "Sem problema, vamos nessa."
                }
            ]
        },
        {
            "talkId": "6654704",
            "initDialog": "665470401",
            "dialogues": [
                {
                    "id": "665470401",
                    "speaker": "Player",
                    "text": "Agradeço, mas quem sabe outra hora."
                },
                {
                    "id": "665470402",
                    "speaker": "Tikraq",
                    "text": "Claro. Fique à vontade para voltar quando quiser."
                }
            ]
        }
    ]
