    },
    "talks": [
        {
            "talkId": "6436901",
            "initDialog": "643690101",
            "dialogues": [
                {
                    "id": "643690101",
                    "speaker": "Goshtasb",
                    "text": "Olá! É um prazer! Por favor, sente-se."
                },
                {
                    "id": "643690102",
                    "speaker": "Goshtasb",
                    "text": "Informarei o Mestre de sua chegada assim que ele retornar."
                }
            ]
        },
        {
            "talkId": "6436902",
            "initDialog": "643690201",
            "dialogues": [
                {
                    "id": "643690201",
                    "speaker": "Player",
                    "text": "Não vejo lugares vagos."
                },
                {
                    "id": "643690202",
                    "speaker": "Goshtasb",
                    "text": "Sim, sim, perdão pela inconveniência."
                },
                {
                    "id": "643690203",
                    "speaker": "Goshtasb",
                    "text": "Não sei por que o Mestre construiu um palácio tão grande, mas ele não pensou em projetar uma sala de espera para os convidados. Também fiquei confuso."
                },
                {
                    "id": "643690204",
                    "speaker": "Goshtasb",
                    "text": "Aguarde por favor. Eu garanto que relatarei isso a ela."
                }
            ]
        },
        {
            "talkId": "6436903",
            "initDialog": "643690301",
            "dialogues": [
                {
                    "id": "643690301",
                    "speaker": "Player",
                    "text": "O Mestre?"
                },
                {
                    "id": "643690302",
                    "speaker": "Goshtasb",
                    "text": "Uau, então você não tem ideia de quem mora aqui?"
                },
                {
                    "id": "643690303",
                    "speaker": "Goshtasb",
                    "text": "Que engraçado. Se você não sabe quem mora aqui, então quem você está procurando?"
                },
                {
                    "id": "643690304",
                    "speaker": "Goshtasb",
                    "text": "Não posso te ajudar se você nem sabe quem está procurando. Agora, se você me der licença."
                }
            ]
        },
        {
            "talkId": "6436904",
            "initDialog": "643690401",
            "dialogues": [
                {
                    "id": "643690401",
                    "speaker": "Player",
                    "text": "Tenha um bom dia."
                },
                {
                    "id": "643690402",
                    "speaker": "Goshtasb",
                    "text": "Bem, tenha cuidado."
                }
            ]
        }
    ]
}