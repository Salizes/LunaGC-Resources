    "talks": [
        {
            "talkId": "6242101",
            "initDialog": "624210101",
            "dialogues": [
                {
                    "id": "624210101",
                    "speaker": "Bao'er",
                    "text": "Olá, viajante. Você está aqui para homenagear a história?"
                }
            ]
        },
        {
            "talkId": "6242102",
            "initDialog": "624210201",
            "dialogues": [
                {
                    "id": "624210201",
                    "speaker": "Player",
                    "text": "O que você está fazendo?"
                },
                {
                    "id": "624210202",
                    "speaker": "Bao'er",
                    "text": "Estou tentando o máximo que posso... Oh, digamos que sou uma arqueóloga.",
                    "choices": [
                        {
                            "id": "624210203",
                            "text": "O que você está fazendo exatamente aí?",
                            "response": [
                                {
                                    "id": "624210204",
                                    "speaker": "Bao'er",
                                    "text": "..Desculpe se eu não fui clara. Sou uma arqueóloga. Estou pesquisando a arquitetura histórica e as relíquias das Planícies de Guili."
                                }
                            ]
                        },
                        {
                            "id": "624210205",
                            "text": "Você é uma arqueóloga?",
                            "response": [
                                {
                                    "id": "624210206",
                                    "speaker": "Bao'er",
                                    "text": "Sim. Agora estamos no campo de batalha onde a Guerra dos Arcontes ocorreu todos esses milhares de anos atrás."
                                },
                                {
                                    "id": "624210207",
                                    "speaker": "Bao'er",
                                    "text": "Em outras palavras, onde o Arconte Geo travou uma batalha sangrenta e garantiu uma vitória decisiva e inequívoca contra os seus inimigos."
                                },
                                {
                                    "id": "624210208",
                                    "speaker": "Bao'er",
                                    "text": "Deve conter inúmeros artefatos a espera de serem desenterrados."
                                },
                                {
                                    "id": "624210209",
                                    "speaker": "Bao'er",
                                    "text": "Desejo muito saber que tipo de tesouros estão enterrados aqui..."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6242103",
            "initDialog": "624210301",
            "dialogues": [
                {
                    "id": "624210301",
                    "speaker": "Player",
                    "text": "Adeus."
                },
                {
                    "id": "624210302",
                    "speaker": "Bao'er",
                    "text": "Se cuide!"
                }
            ]
        }
    ]
}