            "dialogues": [
                {
                    "id": "661080101",
                    "speaker": "Sinchi",
                    "text": "Olá. Existe algo que eu possa trazer para você?"
                }
            ]
        },
        {
            "talkId": "6610802",
            "initDialog": "661080201",
            "dialogues": [
                {
                    "id": "661080201",
                    "speaker": "Player",
                    "text": "E parentes?"
                },
                {
                    "id": "661080202",
                    "speaker": "Sinchi",
                    "text": "...Você me entendeu errado. Sou apenas um caçador comum."
                },
                {
                    "id": "661080203",
                    "speaker": "Sinchi",
                    "text": "Se você está procurando por alguém, você provavelmente deveria contratar um detetive particular, ou emitir uma comissão com a Guilda de Aventureiros... honestamente também não tenho tanta certeza."
                },
                {
                    "id": "661080204",
                    "speaker": "Sinchi",
                    "text": "A única coisa que eu sei como fazer é ir caçar com o meu parceiro Yumkassauro. Desde que você me dê um alvo, serei capaz de trazer para você."
                }
            ]
        },
        {
            "talkId": "6610803",
            "initDialog": "661080301",
            "dialogues": [
                {
                    "id": "661080301",
                    "speaker": "Player",
                    "text": "Estou bem por ora."
                },
                {
                    "id": "661080302",
                    "speaker": "Sinchi",
                    "text": "Oh."
                }
            ]
        }
    ]
}