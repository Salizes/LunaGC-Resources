    },
    "talks": [
        {
            "talkId": "30903",
            "initDialog": "3090301",
            "dialogues": [
                {
                    "id": "3090301",
                    "speaker": "Jean",
                    "text": "Obrigada por aceitar o nosso convite, Viajante.",
                    "choices": [
                        {
                            "id": "3090302",
                            "text": "Como lutamos contra o Stormterror?",
                            "response": [
                                {
                                    "id": "3090303",
                                    "speaker": "Jean",
                                    "text": "Sua mudança em tamanho e o poder é realmente estranha..."
                                },
                                {
                                    "id": "3090304",
                                    "speaker": "Jean",
                                    "text": "Mas para os Cavaleiros de Favonius, nossa prioridade é lidar com as consequências deste ataque."
                                },
                                {
                                    "id": "3090305",
                                    "speaker": "Jean",
                                    "text": "O Grande Mestre me encarregou dos Cavaleiros de Favonius. Eu não posso desapontá-lo e nem as pessoas de Mondstadt."
                                },
                                {
                                    "id": "3090306",
                                    "speaker": "Jean",
                                    "text": "Eu tenho que ir até o fim disso..."
                                }
                            ]
                        },
                        {
                            "id": "3090307",
                            "text": "Todos os cavaleiros são tão estritos como a Amber?",
                            "response": [
                                {
                                    "id": "3090308",
                                    "speaker": "Jean",
                                    "text": "Ouvi dizer que você e a Aventureira Amber tiveram um mal entendimento."
                                },
                                {
                                    "id": "3090309",
                                    "speaker": "Jean",
                                    "text": "Por favor, perdoe-a. Ela estava fazendo o trabalho dela."
                                },
                                {
                                    "id": "3090310",
                                    "speaker": "Jean",
                                    "text": "Fale com a Amber de vez em quando. Tenho certeza de que você vai gostar da energia dela."
                                }
                            ]
                        },
                        {
                            "id": "3090311",
                            "text": "Adeus.",
                            "response": [
                                {
                                    "id": "3090312",
                                    "speaker": "Jean",
                                    "text": "#Obrigada pela ajuda, {NICKNAME}."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "37312",
            "initDialog": "3730902",
            "dialogues": [
                {
                    "id": "3730902",
                    "speaker": "Jean",
                    "text": "Sobre o Stormterror, ainda há alguma coisa que ainda não sabemos...",
                    "choices": [
                        {
                            "id": "3730903",
                            "text": "Como lutamos contra o Stormterror?",
                            "response": [
                                {
                                    "id": "3730904",
                                    "speaker": "Jean",
                                    "text": "Sua mudança em tamanho e o poder é realmente estranha..."
                                },
                                {
                                    "id": "3730905",
                                    "speaker": "Jean",
                                    "text": "Mas para os Cavaleiros de Favonius, nossa prioridade é lidar com as consequências deste ataque."
                                },
                                {
                                    "id": "3730906",
                                    "speaker": "Jean",
                                    "text": "O Grande Mestre me encarregou dos Cavaleiros de Favonius. Eu não posso desapontá-lo e nem as pessoas de Mondstadt."
                                },
                                {
                                    "id": "3730907",
                                    "speaker": "Jean",
                                    "text": "Eu tenho que ir até o fim disso..."
                                }
                            ]
                        },
                        {
                            "id": "3730908",
                            "text": "Sobre os Fatui.",
                            "response": [
                                {
                                    "id": "3730909",
                                    "speaker": "Jean",
                                    "text": "Aquelas pessoas em uniformes estranhos, eles são os Fatui."
                                },
                                {
                                    "id": "3730910",
                                    "speaker": "Jean",
                                    "text": "Eles estão aqui como delegados de Snezhnaya."
                                },
                                {
                                    "id": "3730911",
                                    "speaker": "Jean",
                                    "text": "Fique longe deles. Pode ser perigoso entrar em contato com eles, mesmo para viajantes inocentes."
                                }
                            ]
                        },
                        {
                            "id": "3730912",
                            "text": "Adeus.",
                            "response": [
                                {
                                    "id": "3730913",
                                    "speaker": "Jean",
                                    "text": "Que o vento te guie."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "38306",
            "initDialog": "3830514",
            "dialogues": [
                {
                    "id": "3830514",
                    "speaker": "Jean",
                    "text": "Embora eu esteja falando de mim, eu não consigo evitar de falar em um tom dramático às vezes... Talvez seja um hábito do trabalho?",
                    "choices": [
                        {
                            "id": "3830515",
                            "text": "Conte-me sobre os Cavaleiros.",
                            "response": [
                                {
                                    "id": "3830516",
                                    "speaker": "Jean",
                                    "text": "Os Cavaleiros de Favonius estavam todos ocupados cuidando do incidente. Estou envergonhada de mim mesma..."
                                },
                                {
                                    "id": "3830517",
                                    "speaker": "Jean",
                                    "text": "Se eu fosse uma líder mais forte..."
                                },
                                {
                                    "id": "3830518",
                                    "speaker": "Jean",
                                    "text": "Ou pelo menos é muito bom aumentar a moral e a força de nossas tropas, como nosso Grande Mestre faz..."
                                },
                                {
                                    "id": "3830519",
                                    "speaker": "Jean",
                                    "text": "Não, não tenho tempo para tristezas. Precisamos resolver o nosso problema primeiro, certo?"
                                }
                            ]
                        },
                        {
                            "id": "3830520",
                            "text": "Conte-me sobre a Lira Sagrada.",
                            "response": [
                                {
                                    "id": "3830521",
                                    "speaker": "Jean",
                                    "text": "Relíquia sagrada do Barbatos, tesouro de Mondstadt... A Lira Sagrada."
                                },
                                {
                                    "id": "3830522",
                                    "speaker": "Jean",
                                    "text": "Não é de se surpreender que possui o poder para purificar o mal..."
                                },
                                {
                                    "id": "3830523",
                                    "speaker": "Jean",
                                    "text": "Eu espero que ajude a salvar o Dvalin, como diz o Venti."
                                },
                                {
                                    "id": "3830524",
                                    "speaker": "Jean",
                                    "text": "Deveríamos considerar esta Lira como uma bênção de Barbatos?"
                                }
                            ]
                        },
                        {
                            "id": "3830525",
                            "text": "Adeus.",
                            "response": [
                                {
                                    "id": "3830526",
                                    "speaker": "Jean",
                                    "text": "Que o Vento nos guie para salvar Dvalin."
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}