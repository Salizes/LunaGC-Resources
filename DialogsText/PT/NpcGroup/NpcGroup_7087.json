            "dialogues": [
                {
                    "id": "670870101",
                    "speaker": "Mikko",
                    "text": "Katya não tá mais com raiva de mim, tá?"
                }
            ]
        },
        {
            "talkId": "6708702",
            "initDialog": "670870201",
            "dialogues": [
                {
                    "id": "670870201",
                    "speaker": "Player",
                    "text": "Algo aconteceu?"
                },
                {
                    "id": "670870202",
                    "speaker": "Mikko",
                    "text": "A-Ah, não é nada, sério, eu só... derrubei algumas coisas... que quebraram."
                },
                {
                    "id": "670870203",
                    "speaker": "Mikko",
                    "text": "Mas não é tudo culpa minha. Se ela tivesse me ouvido e substituído tudo com madeira ou ferro, nada disso teria acontecido!"
                },
                {
                    "id": "670870204",
                    "speaker": "Mikko",
                    "text": "*Suspiro* Se ela ainda tiver com raiva, não sei o que vou fazer..."
                }
            ]
        },
        {
            "talkId": "6708703",
            "initDialog": "670870301",
            "dialogues": [
                {
                    "id": "670870301",
                    "speaker": "Player",
                    "text": "Adeus."
                },
                {
                    "id": "670870302",
                    "speaker": "Mikko",
                    "text": "Hã? Ah. A-Adeus!"
                }
            ]
        },
        {
            "talkId": "6708704",
            "initDialog": "670870401",
            "dialogues": [
                {
                    "id": "670870401",
                    "speaker": "Player",
                    "text": "Você pediu desculpas?"
                },
                {
                    "id": "670870402",
                    "speaker": "Mikko",
                    "text": "M-Mas não é tudo culpa minha! Por que eu deveria me desculpar?"
                },
                {
                    "id": "670870403",
                    "speaker": "Mikko",
                    "text": "...Então você acha que também é minha culpa? Se eu me desculpar, eu também não devia ganhar um presente? Eu poderia provavelmente ganhar alguma coisa da Guilda Voynich..."
                }
            ]
        }
    ]
