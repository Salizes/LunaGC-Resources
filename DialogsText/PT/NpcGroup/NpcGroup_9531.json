    "talks": [
        {
            "talkId": "6953101",
            "initDialog": "695310101",
            "dialogues": [
                {
                    "id": "695310101",
                    "speaker": "Kamisato Ayato",
                    "text": "#Hehe, surpres{M#o}{F#a} em me ver aqui? Sim, isso mesmo, sou eu — você não está vendo coisas."
                }
            ]
        },
        {
            "talkId": "6953102",
            "initDialog": "695310201",
            "dialogues": [
                {
                    "id": "695310201",
                    "speaker": "Player",
                    "text": "Que tal uma partida de Chamado Sagrado dos Sete?"
                }
            ]
        },
        {
            "talkId": "6953103",
            "initDialog": "695310301",
            "dialogues": [
                {
                    "id": "695310301",
                    "speaker": "Player",
                    "text": "Tenho outras coisas para fazer..."
                },
                {
                    "id": "695310302",
                    "speaker": "Kamisato Ayato",
                    "text": "Te vejo por aí. Já passou da hora de retornar ao trabalho. Heh, mal posso esperar para ver a cara de desespero dos meus empregados — devem estar se perguntando onde estou."
                }
            ]
        },
        {
            "talkId": "6953104",
            "initDialog": "695310401",
            "dialogues": [
                {
                    "id": "695310401",
                    "speaker": "Kamisato Ayato",
                    "text": "#Eu posso ter ganho de você, mas não desista. Você é bem-vind{M#o}{F#a} para ter uma revanche sempre que quiser."
                }
            ]
        },
        {
            "talkId": "6953105",
            "initDialog": "695310501",
            "dialogues": [
                {
                    "id": "695310501",
                    "speaker": "Kamisato Ayato",
                    "text": "Parece que sua estratégia foi a melhor dessa vez."
                }
            ]
        },
        {
            "talkId": "6953106",
            "initDialog": "695310601",
            "dialogues": [
                {
                    "id": "695310601",
                    "speaker": "Kamisato Ayato",
                    "text": "Muito bem, vamos ver do que você é capaz."
                }
            ]
        },
        {
            "talkId": "6953108",
            "initDialog": "695310801",
            "dialogues": [
                {
                    "id": "695310801",
                    "speaker": "Player",
                    "text": "Que tal uma partida de Chamado Sagrado dos Sete?"
                }
            ]
        },
        {
            "talkId": "6953109",
            "initDialog": "695310901",
            "dialogues": [
                {
                    "id": "695310901",
                    "speaker": "Player",
                    "text": "Preciso ajustar meu deck primeiro..."
                }
            ]
        },
        {
            "talkId": "6953110",
            "initDialog": "695311001",
            "dialogues": [
                {
                    "id": "695311001",
                    "speaker": "Kamisato Ayato",
                    "text": "Duelar com você é muito mais divertido do que lidar com assuntos oficiais."
                }
            ]
        },
        {
            "talkId": "6953111",
            "initDialog": "695311101",
            "dialogues": [
                {
                    "id": "695311101",
                    "speaker": "Kamisato Ayato",
                    "text": "Minha nossa, parece que você tem uma melhor compreensão dos detalhes do que eu."
                }
            ]
        },
        {
            "talkId": "6953112",
            "initDialog": "695311201",
            "dialogues": [
                {
                    "id": "695311201",
                    "speaker": "Kamisato Ayato",
                    "text": "Não costumo jogar o Chamado Sagrado dos Sete, mas isso não significa que você deveria pegar leve comigo."
                }
            ]
        },
        {
            "talkId": "6953114",
            "initDialog": "695311401",
            "dialogues": [
                {
                    "id": "695311401",
                    "speaker": "Player",
                    "text": "Que tal uma partida de Chamado Sagrado dos Sete?"
                }
            ]
        },
        {
            "talkId": "6953115",
            "initDialog": "695311501",
            "dialogues": [
                {
                    "id": "695311501",
                    "speaker": "Player",
                    "text": "Preciso ajustar meu deck primeiro..."
                }
            ]
        },
        {
            "talkId": "6953116",
            "initDialog": "695311601",
            "dialogues": [
                {
                    "id": "695311601",
                    "speaker": "Kamisato Ayato",
                    "text": "Isso pode ser apenas um jogo de carta, mas existem muitas semelhanças com as manobras políticas da vida real."
                }
            ]
        },
        {
            "talkId": "6953117",
            "initDialog": "695311701",
            "dialogues": [
                {
                    "id": "695311701",
                    "speaker": "Kamisato Ayato",
                    "text": "Oh? Tenho que admitir, não previ esse resultado... o que mostra que sempre escolho os amigos certos."
                }
            ]
        },
        {
            "talkId": "6953118",
            "initDialog": "695311801",
            "dialogues": [
                {
                    "id": "695311801",
                    "speaker": "Player",
                    "text": "Tenho outras coisas para fazer..."
                }
            ]
        }
    ]
