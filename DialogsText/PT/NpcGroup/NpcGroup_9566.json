        {
            "talkId": "6956604",
            "initDialog": "695660401",
            "dialogues": [
                {
                    "id": "695660401",
                    "speaker": "Furina",
                    "text": "Hehe, exatamente como eu previ. Nenhuma surpresa aqui."
                }
            ]
        },
        {
            "talkId": "6956605",
            "initDialog": "695660501",
            "dialogues": [
                {
                    "id": "695660501",
                    "speaker": "Furina",
                    "text": "Eu... Bem, estou sempre tão ocupada que mal tenho tempo para praticar, então... Apenas espere até eu ter tempo para aprimorar minhas habilidades. Com certeza vou vencer você da próxima vez..."
                }
            ]
        },
        {
            "talkId": "6956606",
            "initDialog": "695660601",
            "dialogues": [
                {
                    "id": "695660601",
                    "speaker": "Furina",
                    "text": "Cartas? Claro! De vez em quando, eu até me arrisco."
                }
            ]
        },
        {
            "talkId": "6956608",
            "initDialog": "695660801",
            "dialogues": [
                {
                    "id": "695660801",
                    "speaker": "Player",
                    "text": "Que tal uma partida de Chamado Sagrado dos Sete?"
                }
            ]
        },
        {
            "talkId": "6956609",
            "initDialog": "695660901",
            "dialogues": [
                {
                    "id": "695660901",
                    "speaker": "Player",
                    "text": "Preciso ajustar meu deck primeiro..."
