        },
        {
            "talkId": "6956610",
            "initDialog": "695661001",
            "dialogues": [
                {
                    "id": "695661001",
                    "speaker": "Furina",
                    "text": "Bem, isso foi mais fácil fazer do que falar! Agora você vê do que sou capaz?"
                }
            ]
        },
        {
            "talkId": "6956611",
            "initDialog": "695661101",
            "dialogues": [
                {
                    "id": "695661101",
                    "speaker": "Furina",
                    "text": "O que... Eu... Eu não sabia que você jogava tão bem... Não vou pegar leve com você da próxima vez."
                }
            ]
        },
        {
            "talkId": "6956612",
            "initDialog": "695661201",
            "dialogues": [
                {
                    "id": "695661201",
                    "speaker": "Furina",
                    "text": "#Que este seja um duelo memorável para amb{F#a}{M#o}s de nós."
                }
            ]
        },
        {
            "talkId": "6956614",
            "initDialog": "695661401",
            "dialogues": [
                {
                    "id": "695661401",
                    "speaker": "Player",
                    "text": "Que tal uma partida de Chamado Sagrado dos Sete?"
                }
            ]
        },
        {
