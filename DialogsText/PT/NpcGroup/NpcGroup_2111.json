    "talks": [
        {
            "talkId": "6211101",
            "initDialog": "621110101",
            "dialogues": [
                {
                    "id": "621110101",
                    "speaker": "Sra. Qiao",
                    "text": "#Você parece cansad{M#o}{F#a}, jovem. Por que não descansa?"
                }
            ]
        },
        {
            "talkId": "6211102",
            "initDialog": "621110201",
            "dialogues": [
                {
                    "id": "621110201",
                    "speaker": "Player",
                    "text": "O que você está fazendo?"
                },
                {
                    "id": "621110202",
                    "speaker": "Sra. Qiao",
                    "text": "Oh, apenas ajudando com as barracas o máximo que uma velhinha consegue."
                },
                {
                    "id": "621110203",
                    "speaker": "Sra. Qiao",
                    "text": "Eu conheço muito bem todos os vendedores aqui. Os que vendem xícaras de chá, folhas de chá e ovos do chá."
                },
                {
                    "id": "621110204",
                    "speaker": "Sra. Qiao",
                    "text": "Quando algo surge, todos eles se sentem mais seguros me pedindo que vigiem suas barracas para eles."
                }
            ]
        },
        {
            "talkId": "6211103",
            "initDialog": "621110301",
            "dialogues": [
                {
                    "id": "621110301",
                    "speaker": "Player",
                    "text": "Adeus."
                },
                {
                    "id": "621110302",
                    "speaker": "Sra. Qiao",
                    "text": "Adeus, minha criança."
                }
            ]
        }
    ]
}