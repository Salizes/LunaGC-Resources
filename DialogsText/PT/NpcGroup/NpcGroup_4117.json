    "talks": [
        {
            "talkId": "6411701",
            "initDialog": "641170101",
            "dialogues": [
                {
                    "id": "641170101",
                    "speaker": "Fariba",
                    "text": "#Seja bem-vind{F#a}{M#o}."
                }
            ]
        },
        {
            "talkId": "6411702",
            "initDialog": "641170201",
            "dialogues": [
                {
                    "id": "641170201",
                    "speaker": "Player",
                    "text": "O que vocês vendem?"
                },
                {
                    "id": "641170202",
                    "speaker": "Fariba",
                    "text": "Bem... eu não sei tudo sobre todos os artigos. Está tudo no mostruário, então você pode ver por si mesmo."
                },
                {
                    "id": "641170203",
                    "speaker": "Fariba",
                    "text": "E depois há... coisas que as pessoas costumam usar no cotidiano."
                },
                {
                    "id": "641170204",
                    "speaker": "Fariba",
                    "text": "Cobertores, espátulas, guarda-chuvas, copos... Coisas assim."
                }
            ]
        },
        {
            "talkId": "6411703",
            "initDialog": "641170301",
            "dialogues": [
                {
                    "id": "641170301",
                    "speaker": "Player",
                    "text": "Adeus."
                },
                {
                    "id": "641170302",
                    "speaker": "Fariba",
                    "text": "Se cuida."
                }
            ]
        },
        {
            "talkId": "6411704",
            "initDialog": "641170401",
            "dialogues": [
                {
                    "id": "641170401",
                    "speaker": "Player",
                    "text": "Quanto custa os guarda-chuvas?"
                },
                {
                    "id": "641170402",
                    "speaker": "Fariba",
                    "text": "Hã... não tem o preço?"
                },
                {
                    "id": "641170403",
                    "speaker": "Fariba",
                    "text": "Bem... Guarda-chuva, guarda-chuva..."
                },
                {
                    "id": "641170404",
                    "speaker": "Fariba",
                    "text": "*Suspira* Sinceramente não lembro o preço."
                },
                {
                    "id": "641170405",
                    "speaker": "Fariba",
                    "text": "Você não quer ver outra coisa?"
                }
            ]
        },
        {
            "talkId": "6411705",
            "initDialog": "641170501",
            "dialogues": [
                {
                    "id": "641170501",
                    "speaker": "Player",
                    "text": "Conseguem vendê-los assim?"
                },
                {
                    "id": "641170502",
                    "speaker": "Fariba",
                    "text": "Parece que... nada mal? Eu não sou responsável pela contabilidade, então não tenho certeza."
                },
                {
                    "id": "641170503",
                    "speaker": "Fariba",
                    "text": "Todos os dias alguns clientes visitam a loja, mas não há rostos familiares."
                },
                {
                    "id": "641170504",
                    "speaker": "Fariba",
                    "text": "Só me lembro de uma garotinha que vem muitas vezes discutir negócios com o chefe."
                },
                {
                    "id": "641170505",
                    "speaker": "Fariba",
                    "text": "... Mas não sei que mercadorias ela traz para vender."
                },
                {
                    "id": "641170506",
                    "speaker": "Fariba",
                    "text": "Parece que o patrão a trata com muito respeito, mas nunca expõe as mercadorias que a moça traz para a loja."
                }
            ]
        }
    ]
}