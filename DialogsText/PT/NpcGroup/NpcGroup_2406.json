            "dialogues": [
                {
                    "id": "624060101",
                    "speaker": "Hui",
                    "text": "#{M#Meu herói}{F#Minha heroína} finalmente chegou! Me salve! Expulse este cachorro!"
                }
            ]
        },
        {
            "talkId": "6240602",
            "initDialog": "624060201",
            "dialogues": [
                {
                    "id": "624060201",
                    "speaker": "Player",
                    "text": "Quem é você?"
                },
                {
                    "id": "624060202",
                    "speaker": "Hui",
                    "text": "Eu sou um via... Viajante de longe... Por... Por favor, livre-se do cachorro!"
                }
            ]
        },
        {
            "talkId": "6240603",
            "initDialog": "624060301",
            "dialogues": [
                {
                    "id": "624060301",
                    "speaker": "Player",
                    "text": "Parece que esse cachorro gostou de você..."
                },
                {
                    "id": "624060302",
                    "speaker": "Hui",
                    "text": "Gostou de mim? Ele está me perseguindo e tentando me matar! Veja, ele mordeu minha panturrilha!"
                }
            ]
        },
        {
            "talkId": "6240604",
            "initDialog": "624060401",
            "dialogues": [
                {
                    "id": "624060401",
                    "speaker": "Player",
                    "text": "Adeus."
                },
                {
                    "id": "624060402",
                    "speaker": "Hui",
                    "text": "Não vai! Oh, não! Salve-me!"
                }
            ]
        }
