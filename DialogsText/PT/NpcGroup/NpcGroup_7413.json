{
    "groupId": "7413",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Player": 7,
        "Zyryanov": 9
    },
    "talks": [
        {
            "talkId": "6741301",
            "initDialog": "674130101",
            "dialogues": [
                {
                    "id": "674130101",
                    "speaker": "Zyryanov",
                    "text": "Bebidas! Bebidas gostosas e baratas! Beba com sede e sem sede! Se está com frio, tome um gole pra se esquentar!"
                }
            ]
        },
        {
            "talkId": "6741302",
            "initDialog": "674130201",
            "dialogues": [
                {
                    "id": "674130201",
                    "speaker": "Player",
                    "text": "Que bebidas vocês têm?"
                },
                {
                    "id": "674130202",
                    "speaker": "Zyryanov",
                    "text": "... Hehe, tem de tudo aqui, venha dar uma olhada?"
                }
            ]
        },
        {
            "talkId": "6741303",
            "initDialog": "674130301",
            "dialogues": [
                {
                    "id": "674130301",
                    "speaker": "Player",
                    "text": "São baratas?"
                },
                {
                    "id": "674130302",
                    "speaker": "Zyryanov",
                    "text": "Baratas, muito baratas! Mas essas aqui são de preço fixo. Se quiser, também tenho algumas mais baratas..."
                }
            ]
        },
        {
            "talkId": "6741304",
            "initDialog": "674130401",
            "dialogues": [
                {
                    "id": "674130401",
                    "speaker": "Player",
                    "text": "Não quero beber nada..."
                },
                {
                    "id": "674130402",
                    "speaker": "Zyryanov",
                    "text": "Ah, tudo bem. Se quiser beber algo, pode vir me procurar!"
                }
            ]
        },
        {
            "talkId": "6741305",
            "initDialog": "674130501",
            "dialogues": [
                {
                    "id": "674130501",
                    "speaker": "Player",
                    "text": "Tem ainda mais barato?"
                },
                {
                    "id": "674130502",
                    "speaker": "Zyryanov",
                    "text": "Hehe, é assim que minha loja funciona. Alguns amigos meus que fizeram..."
                },
                {
                    "id": "674130503",
                    "speaker": "Zyryanov",
                    "text": "Ela é forte, apesar do sabor ser leve. Às vezes pode ter algum problema ao beber... Mas o lado bom é que é barata."
                }
            ]
        },
        {
            "talkId": "6741306",
            "initDialog": "674130601",
            "dialogues": [
                {
                    "id": "674130601",
                    "speaker": "Player",
                    "text": "Esqueça, isso é um barato que sai caro."
                },
                {
                    "id": "674130602",
                    "speaker": "Zyryanov",
                    "text": "Bem, elas não se comparam as que saem de uma fábrica, mas são bem mais baratas."
                }
            ]
        },
        {
            "talkId": "6741307",
            "initDialog": "674130701",
            "dialogues": [
                {
                    "id": "674130701",
                    "speaker": "Player",
                    "text": "É, eu passo..."
                },
                {
                    "id": "674130702",
                    "speaker": "Zyryanov",
                    "text": "Tudo bem. Se quiser provar, vou te dar um bom desconto!"
                }
            ]
        },
        {
            "talkId": "6741308",
            "initDialog": "674130801",
            "dialogues": [
