    "talks": [
        {
            "talkId": "6430901",
            "initDialog": "643090101",
            "dialogues": [
                {
                    "id": "643090101",
                    "speaker": "Yohanan",
                    "text": "Será que esses Guardas-Florestais não podiam ser um pouco mais claros? Esporos? Pólen? Como raios eles esperam que entendam o que você está dizendo?!"
                }
            ]
        },
        {
            "talkId": "6430902",
            "initDialog": "643090201",
            "dialogues": [
                {
                    "id": "643090201",
                    "speaker": "Player",
                    "text": "Você é..."
                },
                {
                    "id": "643090202",
                    "speaker": "Yohanan",
                    "text": "Eu sou dos Eremitas."
                },
                {
                    "id": "643090203",
                    "speaker": "Yohanan",
                    "text": "Uh... O que mais..."
                },
                {
                    "id": "643090204",
                    "speaker": "Yohanan",
                    "text": "A propósito, você precisa de um guarda-costas?"
                }
            ]
        },
        {
            "talkId": "6430903",
            "initDialog": "643090301",
            "dialogues": [
                {
                    "id": "643090301",
                    "speaker": "Player",
                    "text": "Adeus."
                },
                {
                    "id": "643090302",
                    "speaker": "Yohanan",
                    "text": "Hã? Oh."
                }
            ]
        },
        {
            "talkId": "6430904",
            "initDialog": "643090401",
            "dialogues": [
                {
                    "id": "643090401",
                    "speaker": "Player",
                    "text": "Não preciso, sou muito forte."
                },
                {
                    "id": "643090402",
                    "speaker": "Yohanan",
                    "text": "O quê? Que arrogância."
                },
                {
                    "id": "643090403",
                    "speaker": "Yohanan",
                    "text": "Espero que você seja forte o suficiente para sobreviver na floresta tropical."
                },
                {
                    "id": "643090404",
                    "speaker": "Yohanan",
                    "text": "Ou então você vai acabar como aquela pesquisadora ali, sem dinheiro para contratar ninguém e que fica apenas vagando por lugares cheios de gente."
                },
                {
                    "id": "643090405",
                    "speaker": "Yohanan",
                    "text": "*Suspiro* Ouvi dizer que muitos pesquisadores frequentam a floresta tropical para estudá-la. Por causa disso, há muitas chances de ganhar Mora aqui. Então por que não encontro ninguém que me contrata?"
                },
                {
                    "id": "643090406",
                    "speaker": "Yohanan",
                    "text": "Invejo muito a \"Leoa Flamejante\". Ela disse que tem um trabalho enorme na cidade. Eu farei ela me pagar algumas bebidas quando voltar a cidade!"
                }
            ]
        },
        {
            "talkId": "6430905",
            "initDialog": "643090501",
            "dialogues": [
                {
                    "id": "643090501",
                    "speaker": "Player",
                    "text": "Desafio de Aventura"
                }
            ]
        },
        {
            "talkId": "6430906",
            "initDialog": "643090601",
            "dialogues": [
                {
                    "id": "643090601",
                    "speaker": "Yohanan",
                    "text": "O quê? Dessa forma, você não está contando apenas com a força do seu deck?"
                }
            ]
        },
        {
            "talkId": "6430907",
            "initDialog": "643090701",
            "dialogues": [
                {
                    "id": "643090701",
                    "speaker": "Yohanan",
                    "text": "Haha, ganhei! Cá entre nós, nem mesmo alguns estudiosos conseguem ganhar de mim!"
                }
            ]
        }
    ]
}