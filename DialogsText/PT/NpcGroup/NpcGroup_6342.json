    },
    "talks": [
        {
            "talkId": "7510706",
            "initDialog": "751070601",
            "dialogues": [
                {
                    "id": "751070601",
                    "speaker": "Ler",
                    "text": "\"Para aqueles que só estavam passando por perto, ou estiveram em atividade nessa área por muito tempo: Olhos abertos e cuidado.\""
                },
                {
                    "id": "751070602",
                    "speaker": "Ler",
                    "text": "\"Havia uma gangue criminosa astuta operando nessa área que usava armas que não deixava rastros para ferir os companheiros Saurianos das pessoas, então capturá-los para vender!\"",
                    "choices": [
                        {
                            "id": "751070603",
                            "text": "Ler",
                            "response": [
                                {
                                    "id": "751070605",
                                    "speaker": "Ler",
                                    "text": "#\"Felizmente, {M#o corajoso e astuto}{F#a corajosa e astuta} {NICKNAME}, sua companheira Paimon e {REALNAME[ID(2)|SHOWHOST(true)]} agiram decisivamente...\""
                                },
                                {
                                    "id": "751070606",
                                    "speaker": "Ler",
                                    "text": "\"Eles deram um golpe pesado nessa gangue e resgataram muitos dos animais capturados!\"",
                                    "choices": [
                                        {
                                            "id": "751070607",
                                            "text": "Ler",
                                            "response": [
                                                {
                                                    "id": "751070609",
                                                    "speaker": "Ler",
                                                    "text": "\"Contudo, ainda é incerto se esses vilões ainda têm cúmplices à solta, ou quando eles voltarão...\""
                                                },
                                                {
                                                    "id": "751070610",
                                                    "speaker": "Ler",
                                                    "text": "\"Logo após, cada um se revezou enviando patrulhas para manter a paz nessa área, continuar procurando pistas sobre essa gangue e fazer o melhor para eliminá-la completamente.\"",
                                                    "choices": [
                                                        {
                                                            "id": "751070611",
                                                            "text": "Ler",
                                                            "response": [
                                                                {
                                                                    "id": "751070613",
                                                                    "speaker": "Ler",
                                                                    "text": "\"Assim, amigos, por favor, não descansem em qualquer lugar. É mais seguro se vocês entrarem num acampamento — é mais confortável também!\""
                                                                },
                                                                {
                                                                    "id": "751070614",
                                                                    "speaker": "Ler",
                                                                    "text": "#\"Que a sorte e coragem de {NICKNAME}, Paimon e {REALNAME[ID(2)|SHOWHOST(true)]} também proteja todos vocês!\""
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "751070612",
                                                            "text": "Sair"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "751070608",
                                            "text": "Sair"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "751070604",
                            "text": "Sair"
                        }
                    ]
                }
            ]
        }
    ]
}