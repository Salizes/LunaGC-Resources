{
    "groupId": "5268",
    "total_dialogue_lines": 88,
    "speaker_counts": {
        "Black Screen": 2,
        "Gatinho Confuso": 1,
        "Guijarro": 42,
        "Paimon": 17,
        "Player": 26
    },
    "talks": [
        {
            "talkId": "7005001",
            "initDialog": "700500101",
            "dialogues": [
                {
                    "id": "700500101",
                    "speaker": "Guijarro",
                    "text": "...Esse gato, é claro, é isso! Eu sabia!",
                    "choices": [
                        {
                            "id": "700500102",
                            "text": "Guijarro?",
                            "response": [
                                {
                                    "id": "700500103",
                                    "speaker": "Guijarro",
                                    "text": "#Hã? {NICKNAME}, Paimon, o que vocês estão fazendo aqui na Vila Qiaoying?"
                                },
                                {
                                    "id": "700500106",
                                    "speaker": "Paimon",
                                    "text": "Você terminou... de escrever seu livro? Você não tá imaginando coisas estranhas, né?",
                                    "choices": [
                                        {
                                            "id": "700500107",
                                            "text": "Ou sintomas de paranoia?",
                                            "response": [
                                                {
                                                    "id": "700500109",
                                                    "speaker": "Guijarro",
                                                    "text": "Oh, não, não! Eu já terminei de escrever aquele livro. Agora é só uma questão de esperar \"Artimanhas da Corte de Fontaine\" ser impresso e partir para as vendas."
                                                },
                                                {
                                                    "id": "700500110",
                                                    "speaker": "Paimon",
                                                    "text": "Uau, parece um livro super legal! Sobre o que é?"
                                                },
                                                {
                                                    "id": "700500111",
                                                    "speaker": "Guijarro",
                                                    "text": "Um detetive covarde e sua irmãzinha corajosa, que é sua assistente. Juntos, eles coletaram evidências de incontáveis delitos, criando um \"Museu do Crime\"..."
                                                },
                                                {
                                                    "id": "700500112",
                                                    "speaker": "Guijarro",
                                                    "text": "Gêmeos desaparecidos, um Mecautômato chorão, um curador de museu que se afogou numa fonte... e o principal suspeito é uma criança de três anos.",
                                                    "choices": [
                                                        {
                                                            "id": "700500113",
                                                            "text": "Basta! Minha pele tá arrepiada!",
                                                            "response": [
                                                                {
                                                                    "id": "700500115",
                                                                    "speaker": "Guijarro",
                                                                    "text": "Hahaha! Quando estiver oficialmente na fase de vendas, vou mandar cópias autografadas para vocês."
                                                                },
                                                                {
                                                                    "id": "700500116",
                                                                    "speaker": "Paimon",
                                                                    "text": "Isso aí! Mas, Paimon vai ter medo demais para ler..."
                                                                },
                                                                {
                                                                    "id": "700500117",
                                                                    "speaker": "Paimon",
                                                                    "text": "#Tá decidido então! {NICKNAME}, você vai ler pra Paimon!",
                                                                    "choices": [
                                                                        {
                                                                            "id": "700500118",
                                                                            "text": "Eu também tô com medo...",
                                                                            "response": [
                                                                                {
                                                                                    "id": "700500119",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "#Sério...? Então a única escolha da gente vai ser ler junt{F#as}{M#os}."
                                                                                },
                                                                                {
                                                                                    "id": "700500122",
                                                                                    "speaker": "Guijarro",
                                                                                    "text": "Oh, qualé pessoal, não precisa disso. É só uma história de crime, não de terror."
                                                                                },
                                                                                {
                                                                                    "id": "700500123",
                                                                                    "speaker": "Guijarro",
                                                                                    "text": "Se querem saber de algo realmente assustador... estou pensando em escrever uma nova história. Eu já tenho uma noção geral, e estive procurando por novas fontes de inspiração para meus detalhes."
                                                                                },
                                                                                {
                                                                                    "id": "700500124",
                                                                                    "speaker": "Guijarro",
                                                                                    "text": "...Ei, não fique me encarando assim! Tudo que eu quero dessa vez é combinar a história de crime com folclore. Mesmo se só estivermos em busca de fontes, não vou ficar toda animada como antes.",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "700500125",
                                                                                            "text": "Por que não fazer isso em Fontaine?",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "700500126",
                                                                                                    "speaker": "Guijarro",
                                                                                                    "text": "Bem... você sabe, as pessoas já escreveram muito sobre o folclore de Fontaine, e eu quero algo mais novo!"
                                                                                                },
                                                                                                {
                                                                                                    "id": "700500129",
                                                                                                    "speaker": "Guijarro",
                                                                                                    "text": "E por coincidência, um amigo meu estava pensando em vir aqui ver o comércio de chá, por isso vim acompanhando."
                                                                                                },
                                                                                                {
                                                                                                    "id": "700500130",
                                                                                                    "speaker": "Guijarro",
                                                                                                    "text": "Assim que pisei fora do barco descobri algo fantástico! E enquanto eu estava pensando em como seguir em frente, vocês chegaram."
                                                                                                },
                                                                                                {
                                                                                                    "id": "700500131",
                                                                                                    "speaker": "Guijarro",
                                                                                                    "text": "É como as pessoas de Liyue dizem, isso se chama... hã... \"destinados a se encontrar mesmo separados por mil quilômetros\"?"
                                                                                                },
                                                                                                {
                                                                                                    "id": "700500132",
                                                                                                    "speaker": "Player",
                                                                                                    "text": "Quando em Liyue, faça como o povo de Liyue..."
                                                                                                },
                                                                                                {
                                                                                                    "id": "700500133",
                                                                                                    "speaker": "Paimon",
                                                                                                    "text": "Como é que Paimon pode dizer... bem, não é à toa que você é uma grande escritora. Você entende rapidinho sobre os costumes locais..."
                                                                                                },
                                                                                                {
                                                                                                    "id": "700500134",
                                                                                                    "speaker": "Paimon",
                                                                                                    "text": "Mas você disse que encontrou algo? Não tem nada aqui!"
                                                                                                },
                                                                                                {
                                                                                                    "id": "700500135",
                                                                                                    "speaker": "Guijarro",
                                                                                                    "text": "Quem disse? Olha! Não tão vendo esse gato?",
                                                                                                    "choices": [
                                                                                                        {
                                                                                                            "id": "700500136",
                                                                                                            "text": "Eu vi desde o começo! Como é que ia ser outra coisa que não fosse um gato?!",
                                                                                                            "response": [
                                                                                                                {
                                                                                                                    "id": "700500140",
                                                                                                                    "speaker": "Gatinho Confuso",
                                                                                                                    "text": "Miau...? Miaaauu..."
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "700500141",
                                                                                                                    "speaker": "Guijarro",
                                                                                                                    "text": "Ah, vocês não devem tá por dentro. Nas lendas da Vila Qiaoying, há monstros estranhos conhecidos como \"Bestas Xuanwen\"."
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "700500142",
                                                                                                                    "speaker": "Guijarro",
                                                                                                                    "text": "De acordo com as lendas, essas bestas estranhas se parecem com gatinhos, se escondendo durante a noite e com o nascer do sol, comendo e... comendo o vento e bebendo o orvalho, cruzando mil quilômetros num dia, capazes de sentir o bem e o mal, mastigando árvores de chá durante a noite para se nutrirem..."
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "700500143",
                                                                                                                    "speaker": "Guijarro",
                                                                                                                    "text": "Enfim! Foi isso que o artigo na \"Tô Chokda!\" disse!",
                                                                                                                    "choices": [
                                                                                                                        {
                                                                                                                            "id": "700500144",
                                                                                                                            "text": "Só pelo nome eu já sei que não vale nada!",
                                                                                                                            "response": [
                                                                                                                                {
                                                                                                                                    "id": "700500146",
                                                                                                                                    "speaker": "Paimon",
                                                                                                                                    "text": "Parece que quem escreveu isso... só precisou ouvir o nome \"Besta Xuanwen\" e misturou todos os rumores estranhos que ouviu dentro de uma panela!"
                                                                                                                                },
                                                                                                                                {
                                                                                                                                    "id": "700500147",
                                                                                                                                    "speaker": "Guijarro",
                                                                                                                                    "text": "Ainda assim, segundo minhas investigações, realmente há Bestas Xuanwen perto da Vila Qiaoying, mesmo eu não sabendo bem os detalhes... mas, desde que elas existam, eu posso estudá-las!"
                                                                                                                                },
                                                                                                                                {
                                                                                                                                    "id": "700500148",
                                                                                                                                    "speaker": "Paimon",
                                                                                                                                    "text": "Uau! Guijarro está totalmente diferente de antes! Ela era tão assustada e tímida antes..."
                                                                                                                                },
                                                                                                                                {
                                                                                                                                    "id": "700500149",
                                                                                                                                    "speaker": "Player",
                                                                                                                                    "text": "E agora ela veio aqui com nada, só um nome..."
                                                                                                                                },
                                                                                                                                {
                                                                                                                                    "id": "700500150",
                                                                                                                                    "speaker": "Guijarro",
                                                                                                                                    "text": "Hahaha! Eu sinto muito! É uma das minhas falhas. Assim que eu começo a escrever, acabo entrando nos personagens do livro."
                                                                                                                                },
                                                                                                                                {
                                                                                                                                    "id": "700500151",
                                                                                                                                    "speaker": "Guijarro",
                                                                                                                                    "text": "O protagonista desse livro é um detetive super-confiante! Tão confiante que ele considera todo mundo abaixo dele..."
                                                                                                                                },
                                                                                                                                {
                                                                                                                                    "id": "700500152",
                                                                                                                                    "speaker": "Guijarro",
                                                                                                                                    "text": "Certo, já tá bom de conversa, preciso pesquisar com cuidado..."
                                                                                                                                },
                                                                                                                                {
                                                                                                                                    "id": "700500153",
                                                                                                                                    "speaker": "Black Screen",
                                                                                                                                    "text": "O gato se vira e foge como um raio..."
                                                                                                                                },
                                                                                                                                {
                                                                                                                                    "id": "700500154",
                                                                                                                                    "speaker": "Guijarro",
                                                                                                                                    "text": "Uau! Ele fugiu! Atrás dele!"
                                                                                                                                },
                                                                                                                                {
                                                                                                                                    "id": "700500155",
                                                                                                                                    "speaker": "Black Screen",
                                                                                                                                    "text": "Sem falar mais nada, Guijarro corre atrás do gato..."
                                                                                                                                },
                                                                                                                                {
                                                                                                                                    "id": "700500156",
                                                                                                                                    "speaker": "Paimon",
                                                                                                                                    "text": "De novo não! Temos que alcançar logo, ou Guijarro vai acabar fazendo alguma tosquice de novo!"
                                                                                                                                },
                                                                                                                                {
                                                                                                                                    "id": "700500157",
                                                                                                                                    "speaker": "Paimon",
                                                                                                                                    "text": "Guijarro! Mais devagar!"
                                                                                                                                }
                                                                                                                            ]
                                                                                                                        },
                                                                                                                        {
                                                                                                                            "id": "700500145",
                                                                                                                            "text": "De onde foi que você tirou essa revista de fofoca lixo?"
                                                                                                                        }
                                                                                                                    ]
                                                                                                                }
                                                                                                            ]
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "700500137",
                                                                                                            "text": "A não ser que... não é um gato, e na verdade seja...",
                                                                                                            "response": [
                                                                                                                {
                                                                                                                    "id": "700500138",
                                                                                                                    "speaker": "Guijarro",
                                                                                                                    "text": "Você também acha?! Eu sabia, a nossa mente tá em sintonia!"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "700500139",
                                                                                                                    "speaker": "Paimon",
                                                                                                                    "text": "Nananinanão! Nada disso! Pode olhar de qualquer jeito, é só um gato!"
                                                                                                                }
                                                                                                            ]
                                                                                                        }
                                                                                                    ]
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "700500127",
                                                                                            "text": "Você veio esse caminho todo até a Vila Qiaoying só em busca do material de referência...",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "700500128",
                                                                                                    "speaker": "Guijarro",
                                                                                                    "text": "Bem... as pessoas já escreveram muito sobre o folclore de Fontaine, e eu quero algo mais novo!"
                                                                                                }
                                                                                            ]
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "700500120",
                                                                            "text": "Deixa comigo.",
                                                                            "response": [
                                                                                {
                                                                                    "id": "700500121",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "#Isso aí! Você é {F#a}{M#o} melhor!"
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "700500114",
                                                            "text": "Parece um caso enorme..."
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "700500108",
                                            "text": "Não estamos mais em Fontaine. Você tá bem longe de casa."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "700500104",
                            "text": "Tem algo de errado com o gato?",
                            "response": [
                                {
                                    "id": "700500105",
                                    "speaker": "Guijarro",
                                    "text": "#Eu acho que é... hmmm? {NICKNAME}, Paimon? Que coincidência ver vocês aqui. O que vocês estão fazendo na Vila Qiaoying?"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7480001",
            "initDialog": "748000101",
            "dialogues": [
                {
                    "id": "748000101",
                    "speaker": "Guijarro",
                    "text": "Não pode ser... Não pode ser..."
                },
                {
                    "id": "748000102",
                    "speaker": "Player",
                    "text": "O que você está fazendo?"
                },
                {
                    "id": "748000103",
                    "speaker": "Guijarro",
                    "text": "Ah! Não! Eu juro que não fiz nada, por favor, não me machuque!"
                },
                {
                    "id": "748000104",
                    "speaker": "Paimon",
                    "text": "Do que você está falando? Por que a gente ia te machucar?"
                },
                {
                    "id": "748000105",
                    "speaker": "Guijarro",
                    "text": "Eu não sei! Mas eu também não sei que você não vai me machucar!",
                    "choices": [
                        {
                            "id": "748000106",
                            "text": "Você não está fazendo sentido nenhum...",
                            "response": [
                                {
                                    "id": "748000108",
                                    "speaker": "Guijarro",
                                    "text": "Oh! ...Entendi! Deve ser por que eu descobri seu segredo, certo?"
                                },
                                {
                                    "id": "748000109",
                                    "speaker": "Guijarro",
                                    "text": "Eu... eu peguei o jornal com sua carta secreta escrita dentro no café?"
                                },
                                {
                                    "id": "748000110",
                                    "speaker": "Guijarro",
                                    "text": "Ou por que eu acidentalmente descobri sua senha? Espera um momento, poderia ser o peixe que eu comi ontem à noite..."
                                },
                                {
                                    "id": "748000111",
                                    "speaker": "Guijarro",
                                    "text": "Digo, a razão daquele peixe ter tão poucas espinhas é porque você já tinha retirado elas do peixe!"
                                },
                                {
                                    "id": "748000112",
                                    "speaker": "Guijarro",
                                    "text": "Sim, sim, você quer usar a diferença no número de ossos de cada peixe para mandar uma mensagem... mas eu acidentalmente comprei esse e trouxe para casa comigo..."
                                },
                                {
                                    "id": "748000113",
                                    "speaker": "Paimon",
                                    "text": "O que é que essa garota tá falando, hein? Paimon não entende nadinha...",
                                    "choices": [
                                        {
                                            "id": "748000114",
                                            "text": "Eu não vou te machucar.",
                                            "response": [
                                                {
                                                    "id": "748000116",
                                                    "speaker": "Guijarro",
                                                    "text": "Vocês realmente não vieram me machucar?"
                                                },
                                                {
                                                    "id": "748000117",
                                                    "speaker": "Paimon",
                                                    "text": "O que há com você?! Acabamos de te conhecer, por que a gente ia querer te machucar?"
                                                },
                                                {
                                                    "id": "748000118",
                                                    "speaker": "Guijarro",
                                                    "text": "S-Sério? Fico... Fico feliz. Mil desculpas, que vergonha..."
                                                },
                                                {
                                                    "id": "748000119",
                                                    "speaker": "Guijarro",
                                                    "text": "Eu estive trabalhando duro numa história de detetive, mas ainda não sei que método o criminoso deveria usar para cometer o crime."
                                                },
                                                {
                                                    "id": "748000120",
                                                    "speaker": "Guijarro",
                                                    "text": "E porque eu sempre estou pensando demais nas coisas, então... quando olho para algo, minha primeira reação é considerar como isso poderia ser usado para... sabe, cometer um crime."
                                                },
                                                {
                                                    "id": "748000121",
                                                    "speaker": "Guijarro",
                                                    "text": "*Suspiro* É por isso que eu estava... tão nervosa ainda agora. Me desculpa mesmo. Talvez eu tenha me tornado o que chamam de \"paranoica\"."
                                                },
                                                {
                                                    "id": "748000122",
                                                    "speaker": "Guijarro",
                                                    "text": "Eu estava prestes a pegar o Hidrônibus para a cidade para tomar uma xícara de café, mas quando eu vi o Hidrônibus funcionando..."
                                                },
                                                {
                                                    "id": "748000123",
                                                    "speaker": "Guijarro",
                                                    "text": "Eu... Eu vi imediatamente incontáveis possibilidades, todas as maneiras que eu poderia morrer em um Hidrônibus! Eu simplesmente não ousei subir a bordo.",
                                                    "choices": [
                                                        {
                                                            "id": "748000124",
                                                            "text": "Você mesmo disse que era só paranoia.",
                                                            "response": [
                                                                {
                                                                    "id": "748000126",
                                                                    "speaker": "Guijarro",
                                                                    "text": "Pode ser verdade. Mas eu simplesmente não consigo parar de pensar nisso, e quanto mais eu penso, mais medo tenho...",
                                                                    "choices": [
                                                                        {
                                                                            "id": "748000127",
                                                                            "text": "Eu te acompanho...",
                                                                            "response": [
                                                                                {
                                                                                    "id": "748000129",
                                                                                    "speaker": "Guijarro",
                                                                                    "text": "Sério?! Incrível, mas... E se as pessoas que quiserem me machucar também quiserem te machucar?"
                                                                                },
                                                                                {
                                                                                    "id": "748000130",
                                                                                    "speaker": "Player",
                                                                                    "text": "Só tente relaxar..."
                                                                                },
                                                                                {
                                                                                    "id": "748000131",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "#Qual é?! Pare de ficar viajando. Não importa o problema, {NICKNAME} pode resolver, mamão com açúcar!"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "748000128",
                                                                            "text": "Eu te escolto até lá."
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "748000125",
                                                            "text": "Não tem como isso acontecer, pare de ficar viajando."
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "748000115",
                                            "text": "Não seja tão paranoica."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "748000107",
                            "text": "De que você está falando?"
                        }
                    ]
                }
            ]
        }
    ]
}