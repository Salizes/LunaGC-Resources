            "dialogues": [
                {
                    "id": "614550201",
                    "speaker": "Player",
                    "text": "O que você está fazendo?"
                },
                {
                    "id": "614550202",
                    "speaker": "Norma",
                    "text": "Oh, eu só estava a caminho de comprar um pouco de comida."
                },
                {
                    "id": "614550203",
                    "speaker": "Norma",
                    "text": "Mas não para compras... Eu ia pegar uma comida no restaurante e levar para casa. Meu marido já se cansou da minha comida..."
                },
                {
                    "id": "614550204",
                    "speaker": "Norma",
                    "text": "#Você é {F#uma}{M#um} viajante? Que coisa boa..."
                },
                {
                    "id": "614550205",
                    "speaker": "Norma",
                    "text": "Ouvi dizer que só em Liyue há uma variedade tão grande de pratos diferentes que eles precisam dividi-lo em várias culinárias diferentes..."
                },
                {
                    "id": "614550206",
                    "speaker": "Norma",
                    "text": "Eu adoraria visitar se eu tiver a chance."
                }
            ]
        },
        {
            "talkId": "6145503",
            "initDialog": "614550301",
            "dialogues": [
                {
                    "id": "614550301",
                    "speaker": "Player",
                    "text": "Tchau..."
                },
                {
                    "id": "614550302",
                    "speaker": "Norma",
                    "text": "Certo, tchauzinho!"
                }
            ]
        }
    ]
