            "dialogues": [
                {
                    "id": "695750401",
                    "speaker": "Chiori",
                    "text": "Quer apostar no resultado da próxima vez? Isso poderia deixar as coisas mais emocionantes. Não se preocupe — não sou uma má perdedora."
                }
