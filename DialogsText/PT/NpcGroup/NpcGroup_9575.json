        },
        {
            "talkId": "6957505",
            "initDialog": "695750501",
            "dialogues": [
                {
                    "id": "695750501",
                    "speaker": "Chiori",
                    "text": "Estou encarando essas cartas há tanto tempo que estou começando a ficar tonta. Um banho relaxante agora parece perfeito..."
                }
            ]
        },
        {
            "talkId": "6957506",
