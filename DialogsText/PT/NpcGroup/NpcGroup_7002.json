            "dialogues": [
                {
                    "id": "670020101",
                    "speaker": "Arkhyp",
                    "text": "Melhor deixar os jovens fazerem o que quiserem, né?"
                }
            ]
        },
        {
            "talkId": "6700202",
            "initDialog": "670020201",
            "dialogues": [
                {
                    "id": "670020201",
                    "speaker": "Player",
                    "text": "Os jovens?"
                },
                {
                    "id": "670020202",
                    "speaker": "Arkhyp",
                    "text": "Haha, só falando comigo mesmo aqui. É sobre minha filha, a Lyulka. Ela fica mexendo nesses aparelhinhos de kuuvahki dela o dia inteiro. Até pegou minha oficina emprestada pra isso."
                },
                {
                    "id": "670020203",
                    "speaker": "Arkhyp",
                    "text": "Eu não entendo nada de como essas coisas funcionam, mas, já que ela tá tão dedicada... Como pai, tudo que posso fazer é deixar ela em paz."
                }
            ]
        },
        {
            "talkId": "6700203",
            "initDialog": "670020301",
            "dialogues": [
                {
                    "id": "670020301",
                    "speaker": "Player",
                    "text": "Adeus."
                },
                {
                    "id": "670020302",
                    "speaker": "Arkhyp",
                    "text": "Vá com cuidado."
                }
            ]
        }
    ]
}