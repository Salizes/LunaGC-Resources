    "talks": [
        {
            "talkId": "6311001",
            "initDialog": "631100101",
            "dialogues": [
                {
                    "id": "631100101",
                    "speaker": "Riku",
                    "text": "#Uau, {F#uma}{M#um} forasteir{F#a}{M#o}! Olá!"
                }
            ]
        },
        {
            "talkId": "6311002",
            "initDialog": "631100201",
            "dialogues": [
                {
                    "id": "631100201",
                    "speaker": "Player",
                    "text": "Quer brincar comigo?"
                },
                {
                    "id": "631100202",
                    "speaker": "Riku",
                    "text": "Sim! Quero brincar de esconde-esconde!"
                },
                {
                    "id": "631100203",
                    "speaker": "Riku",
                    "text": "... Ah, mas minha irmã ainda está trabalhando no santuário, e eu prometi a ela que não sairia daqui. Preciso esperar por ela para que possamos ir para casa juntos..."
                },
                {
                    "id": "631100204",
                    "speaker": "Riku",
                    "text": "Minha irmã ficará preocupada se ela não conseguir me encontrar..."
                },
                {
                    "id": "631100205",
                    "speaker": "Riku",
                    "text": "Muito obrigado, mas acho que posso brincar sozinho."
                }
            ]
        },
        {
            "talkId": "6311003",
            "initDialog": "631100301",
            "dialogues": [
                {
                    "id": "631100301",
                    "speaker": "Player",
                    "text": "O que você está fazendo?"
                },
                {
                    "id": "631100302",
                    "speaker": "Riku",
                    "text": "Estou contando as pessoas que vêm ao santuário para pegar Rolinhos da Sorte!"
                },
                {
                    "id": "631100303",
                    "speaker": "Riku",
                    "text": "Tinha uma garota baixinha com uma roupa de tanuki pegando alguns Rolinhos, desejando crescer ou algo do tipo..."
                },
                {
                    "id": "631100304",
                    "speaker": "Riku",
                    "text": "Tinha também uma bela garota mais velha que desejava que Inazuma permanecesse em paz e coisas do tipo..."
                },
                {
                    "id": "631100305",
                    "speaker": "Riku",
                    "text": "Oh, e tinha um carinha grandão desejando que o Clã Kujou fosse próspero..."
                },
                {
                    "id": "631100306",
                    "speaker": "Riku",
                    "text": "Os desejos deles eram tão especiais. Meu desejo é apenas poder brincar de esconde-esconde com minha irmã..."
                }
            ]
        },
        {
            "talkId": "6311004",
            "initDialog": "631100401",
            "dialogues": [
                {
                    "id": "631100401",
                    "speaker": "Player",
                    "text": "Tchau."
                },
                {
                    "id": "631100402",
                    "speaker": "Riku",
                    "text": "Certo. tchau-tchau!"
                }
            ]
        }
    ]
}