{
    "groupId": "9026",
    "total_dialogue_lines": 66,
    "speaker_counts": {
        "Player": 18,
        "Xiao": 48
    },
    "talks": [
        {
            "talkId": "6902601",
            "initDialog": "690260101",
            "dialogues": [
                {
                    "id": "690260101",
                    "speaker": "Xiao",
                    "text": "#... {NICKNAME}, é você."
                },
                {
                    "id": "690260102",
                    "speaker": "Xiao",
                    "text": "Posso lhe ajudar?"
                }
            ]
        },
        {
            "talkId": "6902602",
            "initDialog": "690260201",
            "dialogues": [
                {
                    "id": "690260201",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>Você se acostumou com esse lugar?</color>"
                },
                {
                    "id": "690260202",
                    "speaker": "Xiao",
                    "text": "..."
                },
                {
                    "id": "690260203",
                    "speaker": "Xiao",
                    "text": "Aqui não tem nada auspicioso, é um local calmo."
                },
                {
                    "id": "690260204",
                    "speaker": "Xiao",
                    "text": "Mas...",
                    "choices": [
                        {
                            "id": "690260205",
                            "text": "Mas?",
                            "response": [
                                {
                                    "id": "690260206",
                                    "speaker": "Xiao",
                                    "text": "É muito confortável."
                                },
                                {
                                    "id": "690260209",
                                    "speaker": "Xiao",
                                    "text": "Posso lhe proteger nesse paraíso."
                                },
                                {
                                    "id": "690260210",
                                    "speaker": "Xiao",
                                    "text": "Eu sei que nunca poderei ter uma vida pacífica e despreocupada."
                                },
                                {
                                    "id": "690260211",
                                    "speaker": "Xiao",
                                    "text": "... Aceito suas boas intenções."
                                }
                            ]
                        },
                        {
                            "id": "690260207",
                            "text": "Você não está acostumado?",
                            "response": [
                                {
                                    "id": "690260208",
                                    "speaker": "Xiao",
                                    "text": "...Hmph."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6902603",
            "initDialog": "690260301",
            "dialogues": [
                {
                    "id": "690260301",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>Você quer conversar comigo?</color>"
                },
                {
                    "id": "690260302",
                    "speaker": "Xiao",
                    "text": "... Conversar?"
                },
                {
                    "id": "690260303",
                    "speaker": "Xiao",
                    "text": "...Se você desejar, posso te acompanhar.",
                    "choices": [
                        {
                            "id": "690260304",
                            "text": "Ainda acho que você pode recusar.",
                            "response": [
                                {
                                    "id": "690260305",
                                    "speaker": "Xiao",
                                    "text": "Uh?"
                                },
                                {
                                    "id": "690260306",
                                    "speaker": "Xiao",
                                    "text": "Para fazer um pedido, mas prepare-se para ser rejeitado..."
                                },
                                {
                                    "id": "690260307",
                                    "speaker": "Xiao",
                                    "text": "As relações humanas realmente são problemáticas."
                                },
                                {
                                    "id": "690260311",
                                    "speaker": "Xiao",
                                    "text": "Normalmente, eu não participo de \"conversas\"."
                                },
                                {
                                    "id": "690260312",
                                    "speaker": "Xiao",
                                    "text": "Mas se for uma conversa com você, eu estou disposto a aceitar."
                                },
                                {
                                    "id": "690260313",
                                    "speaker": "Player",
                                    "text": "Xiao, você tem estado bem?"
                                },
                                {
                                    "id": "690260314",
                                    "speaker": "Xiao",
                                    "text": "Você está me perguntando sobre o carma?"
                                },
                                {
                                    "id": "690260315",
                                    "speaker": "Xiao",
                                    "text": "Está tudo bem."
                                },
                                {
                                    "id": "690260316",
                                    "speaker": "Xiao",
                                    "text": "É de minha própria responsabilidade, portanto, só eu arcarei com as consequências."
                                },
                                {
                                    "id": "690260317",
                                    "speaker": "Xiao",
                                    "text": "...Não sei se está relacionado a você, mas recentemente, a dor da minha dívida cármica tem sido menos excruciante."
                                },
                                {
                                    "id": "690260318",
                                    "speaker": "Xiao",
                                    "text": "Está muito mais fácil de suportar do que antes."
                                },
                                {
                                    "id": "690260319",
                                    "speaker": "Xiao",
                                    "text": "Quanto a qualquer preocupação em excesso... É melhor deixar isso para si mesmo."
                                }
                            ]
                        },
                        {
                            "id": "690260308",
                            "text": "Xiao, você está incomodado com algo?",
                            "response": [
                                {
                                    "id": "690260309",
                                    "speaker": "Xiao",
                                    "text": "Não é nada demais."
                                },
                                {
                                    "id": "690260310",
                                    "speaker": "Xiao",
                                    "text": "Eu não esperava que você fizesse tal pedido."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6902604",
            "initDialog": "690260401",
            "dialogues": [
                {
                    "id": "690260401",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>O que você gostaria de fazer?</color>"
                },
                {
                    "id": "690260402",
                    "speaker": "Xiao",
                    "text": "Se você tiver tempo livre, podemos ir juntos ao Porto de Liyue."
                },
                {
                    "id": "690260403",
                    "speaker": "Xiao",
                    "text": "Se não, esqueça.",
                    "choices": [
                        {
                            "id": "690260404",
                            "text": "Claro que sim.",
                            "response": [
                                {
                                    "id": "690260405",
                                    "speaker": "Xiao",
                                    "text": "Tudo bem."
                                },
                                {
                                    "id": "690260408",
                                    "speaker": "Xiao",
                                    "text": "Eu acidentalmente me aproximei da vida dos mortais."
                                },
                                {
                                    "id": "690260409",
                                    "speaker": "Xiao",
                                    "text": "Mas eu sei que você costuma ir na cidade e caminhar entre as pessoas."
                                },
                                {
                                    "id": "690260410",
                                    "speaker": "Xiao",
                                    "text": "As histórias desse período... Ou suas diversões. Se eu não experienciar pessoalmente, temo que terei dificuldade em entender seus sentimentos."
                                },
                                {
                                    "id": "690260411",
                                    "speaker": "Player",
                                    "text": "Então, Xiao... Você está fazendo isso por mim?"
                                },
                                {
                                    "id": "690260412",
                                    "speaker": "Xiao",
                                    "text": "Sim, quero lhe entender."
                                },
                                {
                                    "id": "690260413",
                                    "speaker": "Xiao",
                                    "text": "Eu tinha a sensação de que seria difícil, mas depois de ter tais pensamentos, eu não posso simplesmente sentar e não fazer nada."
                                },
                                {
                                    "id": "690260414",
                                    "speaker": "Xiao",
                                    "text": "Eu me controlarei enquanto estiver na cidade."
                                },
                                {
                                    "id": "690260415",
                                    "speaker": "Xiao",
                                    "text": "Tentarei falar... O menos possível.",
                                    "choices": [
                                        {
                                            "id": "690260416",
                                            "text": "Estarei com você.",
                                            "response": [
                                                {
                                                    "id": "690260418",
                                                    "speaker": "Xiao",
                                                    "text": "Hmm..."
                                                },
                                                {
                                                    "id": "690260419",
                                                    "speaker": "Xiao",
                                                    "text": "#Avise-me quando estiver pront{F#a}{M#o} para ir."
                                                }
                                            ]
                                        },
                                        {
                                            "id": "690260417",
                                            "text": "Você pode dizer o que quiser. Eu pagarei a fiança."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "690260406",
                            "text": "Xiao, você finalmente quer se integrar a cidade?",
                            "response": [
                                {
                                    "id": "690260407",
                                    "speaker": "Xiao",
                                    "text": "*Cof cof*"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6902605",
            "initDialog": "690260501",
            "dialogues": [
                {
                    "id": "690260501",
                    "speaker": "Player",
                    "text": "Bom dia, Xiao."
                },
                {
                    "id": "690260502",
                    "speaker": "Xiao",
                    "text": "Bom dia."
                },
                {
                    "id": "690260503",
                    "speaker": "Xiao",
                    "text": "Se encontrar alguma situação bem grave, não hesite em me chamar para ajudar."
                }
            ]
        },
        {
            "talkId": "6902606",
            "initDialog": "690260601",
            "dialogues": [
                {
                    "id": "690260601",
                    "speaker": "Player",
                    "text": "Boa noite, Xiao."
                },
                {
                    "id": "690260602",
                    "speaker": "Xiao",
                    "text": "Hoje..."
                },
                {
                    "id": "690260603",
                    "speaker": "Xiao",
                    "text": "Deixe para lá, não é nada. Boa noite."
                }
            ]
        },
        {
            "talkId": "6902607",
            "initDialog": "690260701",
            "dialogues": [
                {
                    "id": "690260701",
                    "speaker": "Player",
                    "text": "Quer conversar comigo?"
                }
            ]
        },
        {
            "talkId": "6902608",
            "initDialog": "690260801",
            "dialogues": [
                {
                    "id": "690260801",
                    "speaker": "Player",
                    "text": "Gostaria de fazer alguma coisa?"
                }
            ]
        },
        {
            "talkId": "6902609",
            "initDialog": "690260901",
            "dialogues": [
                {
                    "id": "690260901",
                    "speaker": "Player",
                    "text": "Você já se acostumou com esse lugar?"
                }
            ]
        },
        {
            "talkId": "6902650",
            "initDialog": "690265001",
            "dialogues": [
                {
                    "id": "690265001",
                    "speaker": "Xiao",
                    "text": "Casas de madeira curtas e achatadas, escassamente dispersas... Às vezes, uma aldeia como esta pode ser mais fácil de proteger do que uma cidade."
                },
                {
                    "id": "690265002",
                    "speaker": "Xiao",
                    "text": "Ao caçar demônios, eu só quero os espectadores fora da área, para que eu possa me concentrar na luta."
                },
                {
                    "id": "690265003",
                    "speaker": "Xiao",
                    "text": "...Então é assim que as construções humanas parecem de perto."
                }
            ]
        },
        {
            "talkId": "6902651",
            "initDialog": "690265101",
            "dialogues": [
                {
                    "id": "690265101",
                    "speaker": "Xiao",
                    "text": "A cozinha aqui é mobiliada exatamente como a do Albergue Wangshu."
                },
                {
                    "id": "690265102",
                    "speaker": "Xiao",
                    "text": "Olhando para os ingredientes aqui... Você conseguiria recriar aquele prato com o qual estou familiarizado? Presumo que você conheça qual..."
                },
                {
                    "id": "690265103",
                    "speaker": "Xiao",
                    "text": "...Estou apenas divagando. Não estou esperando por nada."
                }
            ]
        }
    ]
}