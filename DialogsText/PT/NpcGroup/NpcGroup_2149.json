    "talks": [
        {
            "talkId": "4111545",
            "initDialog": "411154501",
            "dialogues": [
                {
                    "id": "411154501",
                    "speaker": "Pequeno Yi",
                    "text": "Ei, estranho. Você também não dormiu, vamos ouvir uma história juntos."
                }
            ]
        },
        {
            "talkId": "6214901",
            "initDialog": "621490101",
            "dialogues": [
                {
                    "id": "621490101",
                    "speaker": "Pequeno Yi",
                    "text": "Olá, pessoa cuja qual não sei o nome! Você está aqui para ouvir a história?"
                }
            ]
        },
        {
            "talkId": "6214902",
            "initDialog": "621490201",
            "dialogues": [
                {
                    "id": "621490201",
                    "speaker": "Player",
                    "text": "Uma história?"
                },
                {
                    "id": "621490202",
                    "speaker": "Pequeno Yi",
                    "text": "Sim! As histórias do tio Ghast são tão legais! Elas são meio assustadoras... Mas são verdadeiras!",
                    "choices": [
                        {
                            "id": "621490203",
                            "text": "...Verdadeiras?",
                            "response": [
                                {
                                    "id": "621490204",
                                    "speaker": "Pequeno Yi",
                                    "text": "Simmm! Algumas das histórias realmente aconteceram na vida real..."
                                },
                                {
                                    "id": "621490205",
                                    "speaker": "Pequeno Yi",
                                    "text": "Como aquela Pequena Ming. Realmente já a vi, e ela disse que ia vir brincar comigo..."
                                },
                                {
                                    "id": "621490206",
                                    "speaker": "Pequeno Yi",
                                    "text": "Mas acho que fantasmas não têm boa memória, ela ainda não veio brincar comigo de novo."
                                }
                            ]
                        },
                        {
                            "id": "621490207",
                            "text": "Que medo...",
                            "response": [
                                {
                                    "id": "621490208",
                                    "speaker": "Pequeno Yi",
                                    "text": "Pois é, né!? As histórias costumavam me dar arrepios todas as vezes..."
                                },
                                {
                                    "id": "621490209",
                                    "speaker": "Pequeno Yi",
                                    "text": "Deixei de ter medo desde que encontrei a Pequena Ming pessoalmente. Os fantasmas não são tão assustadores como eu tinha imaginado."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6214903",
            "initDialog": "621490301",
            "dialogues": [
                {
                    "id": "621490301",
                    "speaker": "Player",
                    "text": "Adeus."
                },
                {
                    "id": "621490302",
                    "speaker": "Pequeno Yi",
                    "text": "Adeus!"
                }
            ]
        }
    ]
