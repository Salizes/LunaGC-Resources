            "dialogues": [
                {
                    "id": "674540201",
                    "speaker": "Player",
                    "text": "Olá?"
                },
                {
                    "id": "674540202",
                    "speaker": "Yermolay",
                    "text": "...Minhas desculpas. Estou em serviço, forasteiro, e não posso responder às suas perguntas. Se precisar de ajuda, procure Avreliya."
                },
                {
                    "id": "674540203",
                    "speaker": "Yermolay",
                    "text": "A Srta. Shakhovskaya me transferiu para cá justamente para que eu pudesse preservar os antigos ritos de cortesia. Mesmo diante de um lorde feérico, eu não cometeria a menor falta de etiqueta."
                }
            ]
        },
        {
            "talkId": "6745403",
            "initDialog": "674540301",
            "dialogues": [
                {
                    "id": "674540301",
                    "speaker": "Player",
                    "text": "Vou deixá-lo de guarda, então."
                },
                {
                    "id": "674540302",
                    "speaker": "Yermolay",
                    "text": "..."
                }
            ]
        }
