{
    "groupId": "10409",
    "total_dialogue_lines": 38,
    "speaker_counts": {
        "Paimon": 6,
        "Player": 7,
        "Tio Yun": 25
    },
    "talks": [
        {
            "talkId": "200005",
            "initDialog": "20000501",
            "dialogues": [
                {
                    "id": "20000501",
                    "speaker": "Paimon",
                    "text": "Olá, você veio para participar do Torneio da Frota Crux?"
                },
                {
                    "id": "20000502",
                    "speaker": "Tio Yun",
                    "text": "#Sim! Vocês já foram registrad{M#os}{F#as}?",
                    "choices": [
                        {
                            "id": "20000503",
                            "text": "Ainda não.",
                            "response": [
                                {
                                    "id": "20000505",
                                    "speaker": "Tio Yun",
                                    "text": "Sugiro que vocês se inscrevam primeiro. Não é qualquer pessoa que está qualificada para participar desse torneio."
                                },
                                {
                                    "id": "20000506",
                                    "speaker": "Tio Yun",
                                    "text": "O Torneio é um teste de habilidades de combate. Se o participante não tiver habilidades o suficiente, acabará se machucando."
                                },
                                {
                                    "id": "20000507",
                                    "speaker": "Tio Yun",
                                    "text": "Ninguém quer que isso aconteça, não é?"
                                },
                                {
                                    "id": "20000508",
                                    "speaker": "Paimon",
                                    "text": "Sim. Eu já ouvi falar dessa regra. É que eu gostaria de saber qual título você tem?"
                                },
                                {
                                    "id": "20000509",
                                    "speaker": "Tio Yun",
                                    "text": "Hahaha. Eu? Eu ganhei o segundo lugar na Competição de Lutadores do Penhasco Chihu.",
                                    "choices": [
                                        {
                                            "id": "20000510",
                                            "text": "Penhasco Chihu...",
                                            "response": [
                                                {
                                                    "id": "20000512",
                                                    "speaker": "Paimon",
                                                    "text": "Não me parece uma competição oficializada..."
                                                },
                                                {
                                                    "id": "20000513",
                                                    "speaker": "Tio Yun",
                                                    "text": "Nada disso! Vocês não sabem que ela é uma competição realizada regularmente! Quando eu participei, teve centenas de participantes!"
                                                },
                                                {
                                                    "id": "20000514",
                                                    "speaker": "Tio Yun",
                                                    "text": "Além da honra que ganhei na competição, eu também ajudei os Milleliths a pegar dois Ladrões de Tesouro."
                                                },
                                                {
                                                    "id": "20000515",
                                                    "speaker": "Tio Yun",
                                                    "text": "Hmph... Eles até ousaram me roubar aproveitando a escuridão? Que audácia!"
                                                },
                                                {
                                                    "id": "20000516",
                                                    "speaker": "Tio Yun",
                                                    "text": "Naquela noite, eu dei umas boas bofetadas no rosto do magro, ele deu uns passos para trás cambaleando, enfim o gordo ao seu lado até sacou uma faca."
                                                },
                                                {
                                                    "id": "20000517",
                                                    "speaker": "Tio Yun",
                                                    "text": "Mas eu não me assustei. Muito pelo contrário, dei um grande chute, lançando a faca ao ar, e ela acabou penetrando a viga.",
                                                    "choices": [
                                                        {
                                                            "id": "20000518",
                                                            "text": "Isso foi... realmente incrível.",
                                                            "response": [
                                                                {
                                                                    "id": "20000520",
                                                                    "speaker": "Tio Yun",
                                                                    "text": "Hahaha. Certo! Mesmo que lute sozinho contra dois ladrões, também não fico em desvantagem."
                                                                },
                                                                {
                                                                    "id": "20000521",
                                                                    "speaker": "Tio Yun",
                                                                    "text": "Apesar de ter sofrido alguns ferimentos leves, consegui detê-los e levá-los aos Milleliths, e eu recebi uma recompensa por causa disso."
                                                                },
                                                                {
                                                                    "id": "20000522",
                                                                    "speaker": "Paimon",
                                                                    "text": "Mas para nós, lidar com quatro ou cinco Ladrões de Tesouro é muito comum."
                                                                },
                                                                {
                                                                    "id": "20000523",
                                                                    "speaker": "Player",
                                                                    "text": "#Muito obrigad{M#o}{F#a} por nos contar isso."
                                                                },
                                                                {
                                                                    "id": "20000524",
                                                                    "speaker": "Paimon",
                                                                    "text": "Certo! Vamos dar mais uma volta em outros lugares."
                                                                },
                                                                {
                                                                    "id": "20000525",
                                                                    "speaker": "Tio Yun",
                                                                    "text": "Então nos veremos na arena do torneio! Não perderei para jovens!"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "20000519",
                                                            "text": "Isso foi... realmente perigoso."
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "20000511",
                                            "text": "Competição de Lutadores..."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "20000504",
                            "text": "Gostaria de dar uma voltinha por aqui."
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "200023",
            "initDialog": "20002301",
            "dialogues": [
                {
                    "id": "20002301",
                    "speaker": "Tio Yun",
                    "text": "#Nos vemos na arena, {NICKNAME}!"
                },
                {
                    "id": "20002302",
                    "speaker": "Tio Yun",
                    "text": "Observe o meu chute circular!"
                }
            ]
        },
        {
            "talkId": "200107",
            "initDialog": "20010701",
            "dialogues": [
                {
                    "id": "20010701",
                    "speaker": "Tio Yun",
                    "text": "Ah, é você, haha! Eu assisti a sua partida. Que performance impressionante!"
                },
                {
                    "id": "20010702",
                    "speaker": "Tio Yun",
                    "text": "Eu mesmo fui eliminado na terceira rodada. *Suspiro* Que pena... Se ao menos eu pudesse ter avançado mais uma rodada..."
                },
                {
                    "id": "20010703",
                    "speaker": "Paimon",
                    "text": "Ah, talvez da próxima vez, hein? A propósito, você sabe quem mais avançou para a rodada final?"
                },
                {
                    "id": "20010704",
                    "speaker": "Tio Yun",
                    "text": "Oh, sim. Ele é o mesmo que me derrotou. É um oponente formidável, rápido e hábil em tirar vantagem dos erros de seu oponente."
                },
                {
                    "id": "20010705",
                    "speaker": "Tio Yun",
                    "text": "Vacilei por um breve momento e, antes que eu percebesse, ele me levou ao chão."
                },
                {
                    "id": "20010706",
                    "speaker": "Tio Yun",
                    "text": "Com a minha estatura, não tenho medo de enfrentar oponentes fisicamente fortes. Mas diante de um oponente ágil como ele, fiquei completamente perdido..."
                },
                {
                    "id": "20010707",
                    "speaker": "Tio Yun",
                    "text": "Ainda assim, tenho certeza que ele não será páreo para você haha!"
                }
            ]
        },
        {
            "talkId": "200120",
            "initDialog": "20012001",
            "dialogues": [
                {
                    "id": "20012001",
                    "speaker": "Tio Yun",
                    "text": "Não precisa se preocupar. Ninguém aqui pode lutar contra alguém como você!"
                }
            ]
        },
        {
            "talkId": "200220",
            "initDialog": "20022001",
            "dialogues": [
                {
                    "id": "20022001",
                    "speaker": "Tio Yun",
                    "text": "Ver este torneio me ensinou que, por melhor que eu pense, sempre haverá alguém melhor lá fora..."
                },
                {
                    "id": "20022002",
                    "speaker": "Tio Yun",
                    "text": "Mas de qualquer forma, boa sorte para você lá fora. Estarei torcendo por você!"
                }
            ]
        },
        {
            "talkId": "200226",
            "initDialog": "20022601",
            "dialogues": [
                {
                    "id": "20022601",
                    "speaker": "Tio Yun",
                    "text": "A Visão foi roubada? E em plena luz do dia, também? Como isso poderia acontecer?"
                }
            ]
        }
    ]
}