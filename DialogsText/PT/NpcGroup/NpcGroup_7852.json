            "dialogues": [
                {
                    "id": "678520201",
                    "speaker": "Player",
                    "text": "Algum problema?"
                },
                {
                    "id": "678520202",
                    "speaker": "Burtsev",
                    "text": "Os carregamentos de minério de Sretomorozsk começaram a ficar cada vez menores, mas o preço continuou subindo. Tem algo de errado."
                },
                {
                    "id": "678520203",
                    "speaker": "Burtsev",
                    "text": "Antes todos faziam vista grossa e fingiam que não havia nada de errado. Ninguém quer se meter em problemas por nada..."
                },
                {
                    "id": "678520204",
                    "speaker": "Burtsev",
                    "text": "Não ninguém vai conseguir continuar assim desse jeito. Precisamos fazer algo a respeito! É hora de protestarmos!"
                }
            ]
        },
