            "dialogues": [
                {
                    "id": "630460101",
                    "speaker": "Amano",
                    "text": "Olá, como posso ajudar?"
                }
            ]
        },
        {
            "talkId": "6304602",
            "initDialog": "630460201",
            "dialogues": [
                {
                    "id": "630460201",
                    "speaker": "Player",
                    "text": "Sobre a Toda-Poderosa Shogun..."
                },
                {
                    "id": "630460202",
                    "speaker": "Amano",
                    "text": "A fama da Toda-Poderosa Shogun se espalha pelo mundo inteiro. Ela mantém a paz eterna em Inazuma."
                },
                {
                    "id": "630460203",
                    "speaker": "Amano",
                    "text": "Mas quanto ao Decreto Sakoku... Não, não importa. Eu não tenho nenhum problema com isso."
                },
                {
                    "id": "630460204",
                    "speaker": "Amano",
                    "text": "É claro que é melhor que tenhamos menos forasteiros com quem lidar. Para os poucos sortudos como você que vieram a Inazuma, você deve seguir as regras daqui."
                }
            ]
        },
        {
            "talkId": "6304603",
            "initDialog": "630460301",
            "dialogues": [
                {
                    "id": "630460301",
                    "speaker": "Player",
                    "text": "Tchau..."
                },
                {
                    "id": "630460302",
                    "speaker": "Amano",
                    "text": "#Adeus, forasteir{F#a}{M#o}."
                }
            ]
        },
        {
            "talkId": "6304604",
            "initDialog": "630460401",
            "dialogues": [
                {
                    "id": "630460401",
                    "speaker": "Player",
                    "text": "Sobre a Toda-Poderosa Shogun..."
                },
                {
                    "id": "630460402",
                    "speaker": "Amano",
                    "text": "A fama da Toda-Poderosa Shogun se espalha pelo mundo inteiro. Ela mantém a paz eterna em Inazuma."
                },
                {
                    "id": "630460403",
                    "speaker": "Amano",
                    "text": "Eu jamais questionei qualquer decisão da Toda-Poderosa Shogun."
                },
                {
                    "id": "630460404",
                    "speaker": "Amano",
                    "text": "Mesmo com o Decreto Sakoku revogado, forasteiros que vêm para Inazuma ainda assim devem seguir suas leis."
                }
            ]
        }
    ]
