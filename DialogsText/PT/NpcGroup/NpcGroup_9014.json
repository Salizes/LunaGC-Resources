{
    "groupId": "9014",
    "total_dialogue_lines": 60,
    "speaker_counts": {
        "Barbara": 43,
        "Player": 17
    },
    "talks": [
        {
            "talkId": "6901401",
            "initDialog": "690140101",
            "dialogues": [
                {
                    "id": "690140101",
                    "speaker": "Barbara",
                    "text": "#Olá, {NICKNAME}."
                },
                {
                    "id": "690140102",
                    "speaker": "Barbara",
                    "text": "Ver você tão bem assim me deixa feliz."
                }
            ]
        },
        {
            "talkId": "6901402",
            "initDialog": "690140201",
            "dialogues": [
                {
                    "id": "690140201",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>Você se acostumou com esse lugar?</color>"
                },
                {
                    "id": "690140701",
                    "speaker": "Barbara",
                    "text": "Oh, eu adoro este lugar!"
                },
                {
                    "id": "690140702",
                    "speaker": "Barbara",
                    "text": "A paisagem daqui é muito diferente da de Mondstadt. É bastante revigorante."
                },
                {
                    "id": "690140703",
                    "speaker": "Barbara",
                    "text": "E aqui, posso cantar bem alto sem me preocupar se incomodarei alguém! É a melhor forma de praticar.",
                    "choices": [
                        {
                            "id": "690140704",
                            "text": "Com certeza ninguém consideraria sua doce voz um incômodo.",
                            "response": [
                                {
                                    "id": "690140705",
                                    "speaker": "Barbara",
                                    "text": "Uhh..."
                                },
                                {
                                    "id": "690140706",
                                    "speaker": "Barbara",
                                    "text": "É muito gentil da sua parte dizer isso! Mas, uh... Ainda assim prefiro ser atenciosa com as outras pessoas."
                                },
                                {
                                    "id": "690140707",
                                    "speaker": "Barbara",
                                    "text": "De qualquer forma, fico muito feliz por você ter me convidado para vir até aqui!"
                                },
                                {
                                    "id": "690140710",
                                    "speaker": "Barbara",
                                    "text": "Gostaria de ficar aqui mais um pouco."
                                }
                            ]
                        },
                        {
                            "id": "690140708",
                            "text": "Isso é ótimo!",
                            "response": [
                                {
                                    "id": "690140709",
                                    "speaker": "Barbara",
                                    "text": "Sim... Estou feliz por você ter me convidado para vir até aqui."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6901403",
            "initDialog": "690140301",
            "dialogues": [
                {
                    "id": "690140301",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>Você quer conversar comigo?</color>"
                },
                {
                    "id": "690140801",
                    "speaker": "Barbara",
                    "text": "Oh, claro!"
                },
                {
                    "id": "690140802",
                    "speaker": "Barbara",
                    "text": "Hehe...",
                    "choices": [
                        {
                            "id": "690140803",
                            "text": "Qual o motivo desse sorriso?",
                            "response": [
                                {
                                    "id": "690140805",
                                    "speaker": "Barbara",
                                    "text": "Oh, acabei de perceber que não converso com um amigo há muito tempo."
                                },
                                {
                                    "id": "690140806",
                                    "speaker": "Barbara",
                                    "text": "De repente, me sinto abençoada.",
                                    "choices": [
                                        {
                                            "id": "690140807",
                                            "text": "Parece que é fácil agradar você.",
                                            "response": [
                                                {
                                                    "id": "690140808",
                                                    "speaker": "Barbara",
                                                    "text": "Uhh... É mesmo?"
                                                },
                                                {
                                                    "id": "690140809",
                                                    "speaker": "Barbara",
                                                    "text": "Bem, talvez... Mas isso não é algo ruim."
                                                },
                                                {
                                                    "id": "690140810",
                                                    "speaker": "Barbara",
                                                    "text": "Quanto mais feliz você for, mais energia terá para compartilhar essa felicidade com outras pessoas."
                                                },
                                                {
                                                    "id": "690140815",
                                                    "speaker": "Barbara",
                                                    "text": "Ahh... Por favor, não precisa me elogiar tanto..."
                                                },
                                                {
                                                    "id": "690140816",
                                                    "speaker": "Barbara",
                                                    "text": "Somente as críticas construtivas nos fazem crescer, certo...?"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "690140811",
                                            "text": "É porque você sempre coloca as outras pessoas em primeiro lugar.",
                                            "response": [
                                                {
                                                    "id": "690140812",
                                                    "speaker": "Barbara",
                                                    "text": "Claro que sim, é isso que devo fazer!"
                                                },
                                                {
                                                    "id": "690140813",
                                                    "speaker": "Barbara",
                                                    "text": "Você tem sido o alvo das atenções de todos, eu quero me esforçar para retribuir sua bondade."
                                                }
                                            ]
                                        },
                                        {
                                            "id": "690140814",
                                            "text": "Você é mesmo incrível como as pessoas dizem."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "690140804",
                            "text": "Lembrou de alguma coisa engraçada?"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6901404",
            "initDialog": "690140401",
            "dialogues": [
                {
                    "id": "690140401",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>O que você gostaria de fazer?</color>"
                },
                {
                    "id": "690140901",
                    "speaker": "Barbara",
                    "text": "Oh, tenho praticado uma nova música."
                },
                {
                    "id": "690140902",
                    "speaker": "Barbara",
                    "text": "Mas ainda estou ajustando alguns detalhes..."
                },
                {
                    "id": "690140903",
                    "speaker": "Barbara",
                    "text": "Quando repito o refrão, devo subir meio tom? Não consigo decidir... E acho que posso melhorar a coreografia, mas não tenho certeza..."
                },
                {
                    "id": "690140904",
                    "speaker": "Barbara",
                    "text": "Se não for um incômodo, gostaria que você visse minha apresentação e fizesse sugestões.",
                    "choices": [
                        {
                            "id": "690140905",
                            "text": "Você tem todo o meu apoio.",
                            "response": [
                                {
                                    "id": "690140907",
                                    "speaker": "Barbara",
                                    "text": "Obrigada..."
                                },
                                {
                                    "id": "690140908",
                                    "speaker": "Barbara",
                                    "text": "Hum... Por favor, não ria de mim nas partes que ainda precisam de prática."
                                },
                                {
                                    "id": "690140909",
                                    "speaker": "Barbara",
                                    "text": "Eu pensei sobre isso muitas vezes, mas levei tempo para finalmente criar coragem e me apresentar para você."
                                },
                                {
                                    "id": "690140910",
                                    "speaker": "Barbara",
                                    "text": "Se você risse de mim, não saberia onde me esconder de tanta vergonha...",
                                    "choices": [
                                        {
                                            "id": "690140911",
                                            "text": "Não se preocupe. Não rirei.",
                                            "response": [
                                                {
                                                    "id": "690140913",
                                                    "speaker": "Barbara",
                                                    "text": "Hum... Ok."
                                                },
                                                {
                                                    "id": "690140914",
                                                    "speaker": "Barbara",
                                                    "text": "Então..."
                                                },
                                                {
                                                    "id": "690140915",
                                                    "speaker": "Barbara",
                                                    "text": "Que comece o show!"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "690140912",
                                            "text": "Eu acredito em você, e você deveria acreditar também."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "690140906",
                            "text": "Seria uma honra."
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6901405",
            "initDialog": "690140501",
            "dialogues": [
                {
                    "id": "690140501",
                    "speaker": "Player",
                    "text": "Bom dia, Barbara."
                },
                {
                    "id": "690141001",
                    "speaker": "Barbara",
                    "text": "Bom dia! Espero que você tenha um ótimo dia."
                },
                {
                    "id": "690141002",
                    "speaker": "Barbara",
                    "text": "Orarei por você."
                }
            ]
        },
        {
            "talkId": "6901406",
            "initDialog": "690140601",
            "dialogues": [
                {
                    "id": "690140601",
                    "speaker": "Player",
                    "text": "Boa noite, Barbara."
                },
                {
                    "id": "690141101",
                    "speaker": "Barbara",
                    "text": "Boa noite, bons sonhos."
                }
            ]
        },
        {
            "talkId": "6901412",
            "initDialog": "690141201",
            "dialogues": [
                {
                    "id": "690141201",
                    "speaker": "Barbara",
                    "text": "Quer conversar comigo?"
                }
            ]
        },
        {
            "talkId": "6901413",
            "initDialog": "690141301",
            "dialogues": [
                {
                    "id": "690141301",
                    "speaker": "Barbara",
                    "text": "Gostaria de fazer alguma coisa?"
                }
            ]
        },
        {
            "talkId": "6901414",
            "initDialog": "690141401",
            "dialogues": [
                {
                    "id": "690141401",
                    "speaker": "Player",
                    "text": "Você já se acostumou com esse lugar?"
                }
            ]
        },
        {
            "talkId": "6901450",
            "initDialog": "690145001",
            "dialogues": [
                {
                    "id": "690145001",
                    "speaker": "Barbara",
                    "text": "Que quarto tão arrumadinho, me faz lembrar dos quartos de hóspedes dos Cavaleiros de Favonius."
                },
                {
                    "id": "690145002",
                    "speaker": "Barbara",
                    "text": "Se adicionar algumas decorações fofas, ficará ainda mais confortável..."
                },
                {
                    "id": "690145003",
                    "speaker": "Barbara",
                    "text": "#Se você tiver tempo, vamos comprar junt{F#a}{M#o}s!"
                }
            ]
        },
        {
            "talkId": "6901451",
            "initDialog": "690145101",
            "dialogues": [
                {
                    "id": "690145101",
                    "speaker": "Barbara",
                    "text": "O vento que atravessa esse parque traz um aroma familiar."
                },
                {
                    "id": "690145102",
                    "speaker": "Barbara",
                    "text": "Se ficar descansando um pouco aqui depois do almoço, ouvindo a água correndo, ficarei muito mais relaxada."
                },
                {
                    "id": "690145103",
                    "speaker": "Barbara",
                    "text": "Obrigada! Adoro esse lugar!"
                }
            ]
        }
    ]
}