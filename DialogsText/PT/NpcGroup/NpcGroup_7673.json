    "talks": [
        {
            "talkId": "6767301",
            "initDialog": "676730101",
            "dialogues": [
                {
                    "id": "676730101",
                    "speaker": "Vacarao",
                    "text": "Tem havido muita atividade de kuuvahki na área ultimamente, por favor, tome cuidado.",
                    "choices": [
                        {
                            "id": "676730102",
                            "text": "Sobre aquela Ovelha-Preguiça de antes...",
                            "response": [
                                {
                                    "id": "676730103",
                                    "speaker": "Vacarao",
                                    "text": "Sim, eu já a entreguei ao cavalheiro."
                                },
                                {
                                    "id": "676730104",
                                    "speaker": "Vacarao",
                                    "text": "Mas ouvi dizer que, não muito tempo depois, no momento em que aquele cavalheiro tentou levar a Ovelha-Preguiça para fora de Nod-Krai, ela se transformou em uma semente sem vida."
                                },
                                {
                                    "id": "676730105",
                                    "speaker": "Vacarao",
                                    "text": "Então, o plano dele de levá-la de volta para seu país também fracassou."
                                },
                                {
                                    "id": "676730106",
                                    "speaker": "Vacarao",
                                    "text": "Se ele tivesse me ouvido, talvez as coisas não precisassem terminar assim."
                                }
                            ]
                        },
                        {
                            "id": "676730107",
                            "text": "Sem problemas.",
                            "response": [
                                {
                                    "id": "676730108",
                                    "speaker": "Vacarao",
                                    "text": "Tudo bem. Por favor, cuide-se."
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}