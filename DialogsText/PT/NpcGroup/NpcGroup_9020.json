{
    "groupId": "9020",
    "total_dialogue_lines": 62,
    "speaker_counts": {
        "Player": 18,
        "Razor": 44
    },
    "talks": [
        {
            "talkId": "6902001",
            "initDialog": "690200101",
            "dialogues": [
                {
                    "id": "690200101",
                    "speaker": "Razor",
                    "text": "#{NICKNAME}, olá."
                },
                {
                    "id": "690200102",
                    "speaker": "Razor",
                    "text": "Você está me procurando?"
                }
            ]
        },
        {
            "talkId": "6902002",
            "initDialog": "690200201",
            "dialogues": [
                {
                    "id": "690200201",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>Você se acostumou com esse lugar?</color>"
                },
                {
                    "id": "690200701",
                    "speaker": "Razor",
                    "text": "Sim."
                },
                {
                    "id": "690200702",
                    "speaker": "Razor",
                    "text": "O cheiro daqui. Seu cheiro."
                },
                {
                    "id": "690200703",
                    "speaker": "Razor",
                    "text": "Muito seguro. Muito bom.",
                    "choices": [
                        {
                            "id": "690200704",
                            "text": "Como é o meu cheiro?",
                            "response": [
                                {
                                    "id": "690200705",
                                    "speaker": "Razor",
                                    "text": "Estrelas... Mar... Margaridas Voadoras..."
                                },
                                {
                                    "id": "690200708",
                                    "speaker": "Razor",
                                    "text": "Junto com você, nesse lugar, feliz."
                                }
                            ]
                        },
                        {
                            "id": "690200706",
                            "text": "Se é bom para você, ótimo.",
                            "response": [
                                {
                                    "id": "690200707",
                                    "speaker": "Razor",
                                    "text": "Bom para... Mim? Bom..."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6902003",
            "initDialog": "690200301",
            "dialogues": [
                {
                    "id": "690200301",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>Você quer conversar comigo?</color>"
                },
                {
                    "id": "690200801",
                    "speaker": "Razor",
                    "text": "Desculpe, não posso... Conversar muito."
                },
                {
                    "id": "690200802",
                    "speaker": "Razor",
                    "text": "Falar, difícil. Encontrar significado, difícil.",
                    "choices": [
                        {
                            "id": "690200803",
                            "text": "Não tem problema, eu entendo o que você quer dizer, Razor.",
                            "response": [
                                {
                                    "id": "690200804",
                                    "speaker": "Razor",
                                    "text": "Uh... Você muito forte."
                                },
                                {
                                    "id": "690200807",
                                    "speaker": "Razor",
                                    "text": "Certo, vou me esforçar para falar."
                                },
                                {
                                    "id": "690200808",
                                    "speaker": "Razor",
                                    "text": "..."
                                },
                                {
                                    "id": "690200809",
                                    "speaker": "Razor",
                                    "text": "Gosto mais da grama que do piso."
                                },
                                {
                                    "id": "690200810",
                                    "speaker": "Razor",
                                    "text": "Piso, muito grande. Mas muito duro. Grama ainda maior, mas cheira melhor.",
                                    "choices": [
                                        {
                                            "id": "690200811",
                                            "text": "Aqui você deveria usar \"e\"...",
                                            "response": [
                                                {
                                                    "id": "690200813",
                                                    "speaker": "Razor",
                                                    "text": "Sim! E cheira melhor..."
                                                },
                                                {
                                                    "id": "690200814",
                                                    "speaker": "Razor",
                                                    "text": "Gosto mais da carne que você faz do que crua."
                                                },
                                                {
                                                    "id": "690200815",
                                                    "speaker": "Razor",
                                                    "text": "Carne crua, às vezes... Dor de barriga... Sua carne, cheira bem, gostosa..."
                                                },
                                                {
                                                    "id": "690200816",
                                                    "speaker": "Razor",
                                                    "text": "Quero sempre... Comer a carne que você faz."
                                                },
                                                {
                                                    "id": "690200817",
                                                    "speaker": "Razor",
                                                    "text": "Assim está certo?"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "690200812",
                                            "text": "\"E cheira melhor\"..."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "690200805",
                            "text": "Vou treinar com você.",
                            "response": [
                                {
                                    "id": "690200806",
                                    "speaker": "Razor",
                                    "text": "Treinar? Obrigado."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6902004",
            "initDialog": "690200401",
            "dialogues": [
                {
                    "id": "690200401",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>O que você gostaria de fazer?</color>"
                },
                {
                    "id": "690200901",
                    "speaker": "Razor",
                    "text": "Quero lhe ajudar a proteger.",
                    "choices": [
                        {
                            "id": "690200902",
                            "text": "Você quer me proteger?",
                            "response": [
                                {
                                    "id": "690200903",
                                    "speaker": "Razor",
                                    "text": "Não... Você muito forte. Não precisa de proteção."
                                },
                                {
                                    "id": "690200904",
                                    "speaker": "Razor",
                                    "text": "Quero proteger casa."
                                },
                                {
                                    "id": "690200907",
                                    "speaker": "Razor",
                                    "text": "Aqui, era a sua casa no começo."
                                },
                                {
                                    "id": "690200908",
                                    "speaker": "Razor",
                                    "text": "Eu apenas vim visitar."
                                },
                                {
                                    "id": "690200909",
                                    "speaker": "Razor",
                                    "text": "#Mas, você é {F#minha}{M#meu} Lupical."
                                },
                                {
                                    "id": "690200910",
                                    "speaker": "Razor",
                                    "text": "Aqui também é minha casa."
                                },
                                {
                                    "id": "690200911",
                                    "speaker": "Razor",
                                    "text": "Quero proteger sua casa para você.",
                                    "choices": [
                                        {
                                            "id": "690200912",
                                            "text": "Não precisa proteger este lugar.",
                                            "response": [
                                                {
                                                    "id": "690200914",
                                                    "speaker": "Razor",
                                                    "text": "O que você falou... Posso fazer."
                                                },
                                                {
                                                    "id": "690200915",
                                                    "speaker": "Razor",
                                                    "text": "Então eu... Protejo você."
                                                },
                                                {
                                                    "id": "690200916",
                                                    "speaker": "Razor",
                                                    "text": "Não importa onde esteja. Se houve perigo."
                                                },
                                                {
                                                    "id": "690200917",
                                                    "speaker": "Razor",
                                                    "text": "Eu vou lhe proteger."
                                                }
                                            ]
                                        },
                                        {
                                            "id": "690200913",
                                            "text": "Eu gostaria mais que você me protegesse, Razor."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "690200905",
                            "text": "Proteger sua casa?",
                            "response": [
                                {
                                    "id": "690200906",
                                    "speaker": "Razor",
                                    "text": "Sim. Proteger casa."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6902005",
            "initDialog": "690200501",
            "dialogues": [
                {
                    "id": "690200501",
                    "speaker": "Player",
                    "text": "Bom dia, Razor."
                },
                {
                    "id": "690201001",
                    "speaker": "Razor",
                    "text": "Uh... Bom dia..."
                },
                {
                    "id": "690201002",
                    "speaker": "Razor",
                    "text": "Caçar... Correr. Se quiser, me chame."
                }
            ]
        },
        {
            "talkId": "6902006",
            "initDialog": "690200601",
            "dialogues": [
                {
                    "id": "690200601",
                    "speaker": "Player",
                    "text": "Boa noite, Razor."
                },
                {
                    "id": "690201101",
                    "speaker": "Razor",
                    "text": "#Uh... {NICKNAME}, boa noite."
                },
                {
                    "id": "690201102",
                    "speaker": "Razor",
                    "text": "Se não puder... Dormir... Me chame..."
                }
            ]
        },
        {
            "talkId": "6902012",
            "initDialog": "690201201",
            "dialogues": [
                {
                    "id": "690201201",
                    "speaker": "Player",
                    "text": "Quer conversar comigo?"
                }
            ]
        },
        {
            "talkId": "6902013",
            "initDialog": "690201301",
            "dialogues": [
                {
                    "id": "690201301",
                    "speaker": "Player",
                    "text": "Gostaria de fazer alguma coisa?"
                }
            ]
        },
        {
            "talkId": "6902014",
            "initDialog": "690201401",
            "dialogues": [
                {
                    "id": "690201401",
                    "speaker": "Player",
                    "text": "Você já se acostumou com esse lugar?"
                }
            ]
        },
        {
            "talkId": "6902050",
            "initDialog": "690205001",
            "dialogues": [
                {
                    "id": "690205001",
                    "speaker": "Razor",
                    "text": "Vila... Pertence as pessoas."
                },
                {
                    "id": "690205002",
                    "speaker": "Razor",
                    "text": "Às vezes quero ver, quando você está comigo, não tenho medo."
                },
                {
                    "id": "690205003",
                    "speaker": "Razor",
                    "text": "Obrigado, por me trazer..."
                }
            ]
        },
        {
            "talkId": "6902051",
            "initDialog": "690205101",
            "dialogues": [
                {
                    "id": "690205101",
                    "speaker": "Razor",
                    "text": "Cozinha, comida... Complicado. Na floresta, não precisamos disso."
                },
                {
                    "id": "690205102",
                    "speaker": "Razor",
                    "text": "Mas eu quero aprender. Além do Bolinho de Batata... O que você pode me ensinar?"
                },
                {
                    "id": "690205103",
                    "speaker": "Razor",
                    "text": "Farei, e darei para você e Lupical comer."
                }
            ]
        }
    ]
}