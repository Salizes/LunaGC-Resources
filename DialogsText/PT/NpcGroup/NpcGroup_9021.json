{
    "groupId": "9021",
    "total_dialogue_lines": 58,
    "speaker_counts": {
        "Amber": 41,
        "Player": 17
    },
    "talks": [
        {
            "talkId": "6902101",
            "initDialog": "690210101",
            "dialogues": [
                {
                    "id": "690210101",
                    "speaker": "Amber",
                    "text": "#Oh, é você, {NICKNAME}."
                },
                {
                    "id": "690210102",
                    "speaker": "Amber",
                    "text": "Você parece bem feliz!"
                }
            ]
        },
        {
            "talkId": "6902102",
            "initDialog": "690210201",
            "dialogues": [
                {
                    "id": "690210201",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>Você se acostumou com esse lugar?</color>"
                },
                {
                    "id": "690210202",
                    "speaker": "Amber",
                    "text": "Gosto muito!"
                },
                {
                    "id": "690210203",
                    "speaker": "Amber",
                    "text": "Não sou muito criteriosa onde vou morar, afinal de contas, sou uma Aventureira. Tenho que me adaptar a todos os tipos de ambientes."
                },
                {
                    "id": "690210204",
                    "speaker": "Amber",
                    "text": "Quando é necessário, posso até dormir nos galhos de uma árvore.",
                    "choices": [
                        {
                            "id": "690210205",
                            "text": "Você é realmente incrível.",
                            "response": [
                                {
                                    "id": "690210206",
                                    "speaker": "Amber",
                                    "text": "Mesmo...?"
                                },
                                {
                                    "id": "690210209",
                                    "speaker": "Amber",
                                    "text": "Relaxe! Gosto muito desse lugar."
                                }
                            ]
                        },
                        {
                            "id": "690210207",
                            "text": "Espero que aqui seja um pouco mais confortável que o galho de uma árvore.",
                            "response": [
                                {
                                    "id": "690210208",
                                    "speaker": "Amber",
                                    "text": "Haha, claro que sim."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6902103",
            "initDialog": "690210301",
            "dialogues": [
                {
                    "id": "690210301",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>Você quer conversar comigo?</color>"
                },
                {
                    "id": "690210302",
                    "speaker": "Amber",
                    "text": "Ótimo."
                },
                {
                    "id": "690210303",
                    "speaker": "Amber",
                    "text": "..."
                },
                {
                    "id": "690210304",
                    "speaker": "Amber",
                    "text": "Me desculpe. Eu não sou boa em contar histórias. Não sou boa como meu avô ou Lisa que sabem contar histórias interessantes de cabeça.",
                    "choices": [
                        {
                            "id": "690210305",
                            "text": "Eu me lembro de suas notas, Amber...",
                            "response": [
                                {
                                    "id": "690210306",
                                    "speaker": "Amber",
                                    "text": "Ei! Quando você descobriu elas?"
                                },
                                {
                                    "id": "690210307",
                                    "speaker": "Amber",
                                    "text": "Apesar de não serem secretas, nelas estão escritas alguns elogios sobre você..."
                                },
                                {
                                    "id": "690210308",
                                    "speaker": "Amber",
                                    "text": "...Mas ainda assim, é um pouco vergonhoso deixar outra pessoa ler meu diário!"
                                },
                                {
                                    "id": "690210309",
                                    "speaker": "Amber",
                                    "text": "Mas, eu posso separar e compartilhar algumas histórias sobre aventuras com você."
                                },
                                {
                                    "id": "690210315",
                                    "speaker": "Amber",
                                    "text": "Certo! Hehe, vamos começar..."
                                }
                            ]
                        },
                        {
                            "id": "690210310",
                            "text": "Gostaria de ouvir suas aventuras passadas, Amber.",
                            "response": [
                                {
                                    "id": "690210311",
                                    "speaker": "Amber",
                                    "text": "Sobre minhas aventuras passadas..."
                                },
                                {
                                    "id": "690210312",
                                    "speaker": "Amber",
                                    "text": "Não deve ter nada tão interessante assim. Além disso, aos meus olhos atuais, quando eu era pequena um pouco... Trelosa."
                                },
                                {
                                    "id": "690210313",
                                    "speaker": "Amber",
                                    "text": "Mas desde que você não fique rindo, posso lhe contar!"
                                },
                                {
                                    "id": "690210314",
                                    "speaker": "Player",
                                    "text": "#Então... Obrigad{F#a}{M#o}?"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6902104",
            "initDialog": "690210401",
            "dialogues": [
                {
                    "id": "690210401",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>O que você gostaria de fazer?</color>"
                },
                {
                    "id": "690210402",
                    "speaker": "Amber",
                    "text": "Eu gostaria de jantar com você."
                },
                {
                    "id": "690210403",
                    "speaker": "Amber",
                    "text": "Mesmo para um jantar simples, a sensação de comer em casa e comer em algum restaurante é completamente diferente."
                },
                {
                    "id": "690210404",
                    "speaker": "Amber",
                    "text": "Mesmo que comer em restaurante possa ser conveniente, o sabor da comida é garantido."
                },
                {
                    "id": "690210405",
                    "speaker": "Amber",
                    "text": "Só em casa que podemos ter aquela sensação única de aconchegamento.",
                    "choices": [
                        {
                            "id": "690210406",
                            "text": "Sim, eu entendo.",
                            "response": [
                                {
                                    "id": "690210407",
                                    "speaker": "Amber",
                                    "text": "Sim! Então, venha!"
                                },
                                {
                                    "id": "690210410",
                                    "speaker": "Amber",
                                    "text": "Eu vou fazer churrasco, tá? Bom! Você deve estar muito familiar com o sabor do churrasco da Aventureira."
                                },
                                {
                                    "id": "690210411",
                                    "speaker": "Amber",
                                    "text": "Eu tenho que me exigir ainda mais."
                                },
                                {
                                    "id": "690210412",
                                    "speaker": "Amber",
                                    "text": "Bom! Então, que tal tentar fazer Carne Frita com Cenoura e Mel desta vez?"
                                },
                                {
                                    "id": "690210413",
                                    "speaker": "Amber",
                                    "text": "Ah? Espero que não queime a sua cozinha."
                                },
                                {
                                    "id": "690210414",
                                    "speaker": "Player",
                                    "text": "Não faz mal."
                                },
                                {
                                    "id": "690210415",
                                    "speaker": "Player",
                                    "text": "Ajudarei também!"
                                },
                                {
                                    "id": "690210416",
                                    "speaker": "Amber",
                                    "text": "#Você sempre é {M#o}{F#a} melhor."
                                },
                                {
                                    "id": "690210417",
                                    "speaker": "Amber",
                                    "text": "Eu farei uma comida melhor para compartilhar com você. Não desistirei, não importa quantas vezes eu falhe."
                                },
                                {
                                    "id": "690210418",
                                    "speaker": "Amber",
                                    "text": "Estou muito ansiosa."
                                }
                            ]
                        },
                        {
                            "id": "690210408",
                            "text": "#Vamos jantar junt{M#os}{F#as}.",
                            "response": [
                                {
                                    "id": "690210409",
                                    "speaker": "Amber",
                                    "text": "Está falando sério?"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6902105",
            "initDialog": "690210501",
            "dialogues": [
                {
                    "id": "690210501",
                    "speaker": "Player",
                    "text": "Bom dia, Amber!"
                },
                {
                    "id": "690210502",
                    "speaker": "Amber",
                    "text": "#{NICKNAME}, bom dia!"
                },
                {
                    "id": "690210503",
                    "speaker": "Amber",
                    "text": "Quando houver necessidade de eu aparecer, é só dizer!"
                }
            ]
        },
        {
            "talkId": "6902106",
            "initDialog": "690210601",
            "dialogues": [
                {
                    "id": "690210601",
                    "speaker": "Player",
                    "text": "Boa noite, Amber!"
                },
                {
                    "id": "690210602",
                    "speaker": "Amber",
                    "text": "Boa noite e bom descanso!"
                }
            ]
        },
        {
            "talkId": "6902107",
            "initDialog": "690210701",
            "dialogues": [
                {
                    "id": "690210701",
                    "speaker": "Player",
                    "text": "Quer conversar comigo?"
                }
            ]
        },
        {
            "talkId": "6902108",
            "initDialog": "690210801",
            "dialogues": [
                {
                    "id": "690210801",
                    "speaker": "Player",
                    "text": "Gostaria de fazer alguma coisa?"
                }
            ]
        },
        {
            "talkId": "6902109",
            "initDialog": "690210901",
            "dialogues": [
                {
                    "id": "690210901",
                    "speaker": "Player",
                    "text": "Você já se acostumou com esse lugar?"
                }
            ]
        },
        {
            "talkId": "6902150",
            "initDialog": "690215001",
            "dialogues": [
                {
                    "id": "690215001",
                    "speaker": "Amber",
                    "text": "Que incrível! Você realmente construiu um acampamento tão espaçoso..."
                },
                {
                    "id": "690215002",
                    "speaker": "Amber",
                    "text": "Posso praticar minhas habilidades com arco e flecha nele?"
                },
                {
                    "id": "690215003",
                    "speaker": "Amber",
                    "text": "#Ou seja, nós praticamos junt{M#os}{F#as}, e decidimos um ganhador!"
                }
            ]
        },
        {
            "talkId": "6902151",
            "initDialog": "690215101",
            "dialogues": [
                {
                    "id": "690215101",
                    "speaker": "Amber",
                    "text": "Havia uma época em que os novatos de Planadores faziam pequenas práticas no Vale Termal."
                },
                {
                    "id": "690215102",
                    "speaker": "Amber",
                    "text": "Porque a maioria das casas no Vale Termal só têm dois andares, que é de uma altura ótima para a prática."
                },
                {
                    "id": "690215103",
                    "speaker": "Amber",
                    "text": "Mas, lembre-se de não usar o Planador ilegalmente! Aqui é a mesma coisa!"
                }
            ]
        }
    ]
}