{
    "groupId": "20433",
    "total_dialogue_lines": 22,
    "speaker_counts": {
        "Garoto Kujirai": 15,
        "Paimon": 1,
        "Player": 6
    },
    "talks": [
        {
            "talkId": "7222010",
            "initDialog": "722201001",
            "dialogues": [
                {
                    "id": "722201001",
                    "speaker": "Garoto Kujirai",
                    "text": "#Uau, {F#tia}{M#tio}, você é incrível! Você é até capaz até de decifrar a \"Técnica Kujirai, Temari Justsu\" dos irmãos Kujirai.",
                    "choices": [
                        {
                            "id": "722201002",
                            "text": "Sobre como jogar Temari...",
                            "response": [
                                {
                                    "id": "722201003",
                                    "speaker": "Garoto Kujirai",
                                    "text": "Você só precisa encontrar o Temari que as outras pessoas esconderam dentro do limite de tempo."
                                },
                                {
                                    "id": "722201004",
                                    "speaker": "Garoto Kujirai",
                                    "text": "Ao se esconder o Temari, isso também deve ser feito dentro de um limite de tempo. Dessa forma, existe igualdade entre os participantes. A senhora Aventureira disse que igualdade é muito importante!"
                                }
                            ]
                        },
                        {
                            "id": "722201005",
                            "text": "Conte-me um pouco sobre você...",
                            "response": [
                                {
                                    "id": "722201006",
                                    "speaker": "Garoto Kujirai",
                                    "text": "E então?",
                                    "choices": [
                                        {
                                            "id": "722201007",
                                            "text": "\"Técnica Kujirai, Temari Justsu\"?",
                                            "response": [
                                                {
                                                    "id": "722201008",
                                                    "speaker": "Garoto Kujirai",
                                                    "text": "Ah, ela é parte da escola de técnicas que nosso vovô Shousen criou. O objetivo dela é usar Temaris para desenvolver uma arte marcial invencível!"
                                                },
                                                {
                                                    "id": "722201009",
                                                    "speaker": "Garoto Kujirai",
                                                    "text": "Se puder utilizar alguma maneira para explodir um Temari do lado de um inimigo, poderemos vencer ele sem precisar lutar!"
                                                },
                                                {
                                                    "id": "722201010",
                                                    "speaker": "Paimon",
                                                    "text": "Hã... Paimon está bem certa que não é assim que se joga Temari..."
                                                }
                                            ]
                                        },
                                        {
                                            "id": "722201011",
                                            "text": "Quantas pessoas tem a família Kujirai?",
                                            "response": [
                                                {
                                                    "id": "722201012",
                                                    "speaker": "Garoto Kujirai",
                                                    "text": "Hã... Deixe-me pensar..."
                                                },
                                                {
                                                    "id": "722201013",
                                                    "speaker": "Garoto Kujirai",
                                                    "text": "Além do meu pai e da minha mãe, tem também minha irmã mais velha, ela se chama Momiji. Antes nós costumávamos brincar juntos."
                                                },
                                                {
                                                    "id": "722201014",
                                                    "speaker": "Garoto Kujirai",
                                                    "text": "Mas depois que ela ficou fascinada por pegar um peixe, não quer mais brincar conosco. Ainda disse que nós iríamos assustar eles!"
                                                },
                                                {
                                                    "id": "722201015",
                                                    "speaker": "Garoto Kujirai",
                                                    "text": "E depois... Quantos de nós, irmãos, ficaram sobrando? Para falar a verdade, eu não sei..."
                                                }
                                            ]
                                        },
                                        {
                                            "id": "722201016",
                                            "text": "A aventura de antes...",
                                            "response": [
                                                {
                                                    "id": "722201017",
                                                    "speaker": "Garoto Kujirai",
                                                    "text": "Ela é uma senhora Aventureira incrível!"
                                                },
                                                {
                                                    "id": "722201018",
                                                    "speaker": "Garoto Kujirai",
                                                    "text": "Ela nos ensinou como jogar Temari! Como cantar a canção dos Temari, e ainda também como atirar ele em pessoas ruins para fazer uma explosão!"
                                                },
                                                {
                                                    "id": "722201019",
                                                    "speaker": "Garoto Kujirai",
                                                    "text": "Quando ela foi embora, disse que tinha de ir para um lugar muito, muito distante, fazer algo muito importante."
                                                },
                                                {
                                                    "id": "722201020",
                                                    "speaker": "Garoto Kujirai",
                                                    "text": "Por isso nós estamos aprendendo a Técnica Temari! Para que possamos ajudar ela no futuro!"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "722201021",
                            "text": "Adeus.",
                            "response": [
                                {
                                    "id": "722201022",
                                    "speaker": "Garoto Kujirai",
                                    "text": "#Adeus, {F#tia}{M#tio}! Se você encontrar nossos irmãos e irmãs, mande um oi para eles!"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}