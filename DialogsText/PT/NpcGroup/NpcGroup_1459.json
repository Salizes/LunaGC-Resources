            "dialogues": [
                {
                    "id": "614590101",
                    "speaker": "Porto",
                    "text": "#Bem-vind{F#a}{M#o}."
                }
            ]
        },
        {
            "talkId": "6145902",
            "initDialog": "614590201",
            "dialogues": [
                {
                    "id": "614590201",
                    "speaker": "Player",
                    "text": "Que lugar é este?"
                },
                {
                    "id": "614590202",
                    "speaker": "Porto",
                    "text": "#O Quartel-General dos Cavaleiros de Favonius... Você não me parece {M#um}{F#uma} desordeir{M#o}{F#a}, então você pode entrar."
                }
            ]
        },
        {
            "talkId": "6145903",
            "initDialog": "614590301",
            "dialogues": [
                {
                    "id": "614590301",
                    "speaker": "Player",
                    "text": "Adeus."
                },
                {
                    "id": "614590302",
                    "speaker": "Porto",
                    "text": "Meus melhores desejos para você."
                }
            ]
        },
        {
            "talkId": "6145904",
            "initDialog": "614590401",
            "dialogues": [
                {
                    "id": "614590401",
                    "speaker": "Porto",
                    "text": "Estamos enfrentando mudanças climáticas anormais. Está perigoso lá fora. É recomendado que os habitantes procurem por abrigos subterrâneos."
                }
            ]
        },
        {
            "talkId": "6145905",
            "initDialog": "614590501",
            "dialogues": [
                {
                    "id": "614590501",
                    "speaker": "Porto",
                    "text": "O dragão pode voltar a qualquer momento. Os Cavaleiros de Favonius ficarão de olho, portanto, os habitantes não devem perder tempo."
                }
            ]
        },
        {
            "talkId": "6145906",
            "initDialog": "614590601",
            "dialogues": [
                {
                    "id": "614590601",
                    "speaker": "Porto",
                    "text": "Isso é uma emergência. Por favor, tenham em mente que a prioridade dos Cavaleiros de Favonius é garantir a segurança de todos na cidade."
                }
            ]
        }
    ]
}