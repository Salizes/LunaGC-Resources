        },
        {
            "talkId": "6757702",
            "initDialog": "675770201",
            "dialogues": [
                {
                    "id": "675770201",
                    "speaker": "Player",
                    "text": "O que estou contando?"
                },
                {
                    "id": "675770202",
                    "speaker": "Ignat",
                    "text": "..Mora... O turno diurno paga mais de dez mil... O turno noturno paga mais... Dá pra juntar uma boa quantia em um ano..."
                },
                {
                    "id": "675770203",
                    "speaker": "Ignat",
                    "text": "Se eu continuar economizando por mais um tempo, vai ser suficiente..."
                }
            ]
        },
        {
            "talkId": "6757703",
            "initDialog": "675770301",
            "dialogues": [
                {
                    "id": "675770301",
                    "speaker": "Player",
                    "text": "Adeus."
                },
                {
                    "id": "675770302",
                    "speaker": "Ignat",
                    "text": "Sim."
                }
            ]
        },
        {
            "talkId": "6757704",
            "initDialog": "675770401",
            "dialogues": [
                {
                    "id": "675770401",
                    "speaker": "Player",
                    "text": "O suficiente para quê?"
                },
                {
                    "id": "675770402",
                    "speaker": "Ignat",
                    "text": "Uma casinha em Snezhnograd... Daquelas com um fogão bem grande... A minha Lyubavushka, ela... não lida bem com o frio..."
                },
                {
                    "id": "675770403",
                    "speaker": "Ignat",
                    "text": "Eu quero que ela tenha uma vida um pouco melhor... Svetloledovka é fria demais. Ela não vai se acostumar a viver aqui..."
                }
            ]
        }
    ]
}