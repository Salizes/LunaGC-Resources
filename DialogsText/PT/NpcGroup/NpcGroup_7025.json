    "talks": [
        {
            "talkId": "6702501",
            "initDialog": "670250101",
            "dialogues": [
                {
                    "id": "670250101",
                    "speaker": "Havu",
                    "text": "A Gangue da Concha? Hunf! Quem tá aí pra aqueles idiotas?! Eu não! Hunf!"
                }
            ]
        },
        {
            "talkId": "6702502",
            "initDialog": "670250201",
            "dialogues": [
                {
                    "id": "670250201",
                    "speaker": "Player",
                    "text": "Eu sou da Gangue da Concha. Você não tá nem aí pra isso, né?"
                },
                {
                    "id": "670250202",
                    "speaker": "Havu",
                    "text": "Hã? Tu é mesmo hein, fera! Não é tão fácil entrar assim! E se você fosse, por que ia me contar?"
                },
                {
                    "id": "670250203",
                    "speaker": "Havu",
                    "text": "Eu tenho nada a ver com a Gangue da Concha. Nem um pouco..."
                }
            ]
        },
        {
            "talkId": "6702503",
            "initDialog": "670250301",
            "dialogues": [
                {
                    "id": "670250301",
                    "speaker": "Player",
                    "text": "Você se desentendeu com eles?"
                },
                {
                    "id": "670250302",
                    "speaker": "Havu",
                    "text": "Me desentendi? Como assim?"
                },
                {
                    "id": "670250303",
                    "speaker": "Havu",
                    "text": "... Bem, se você tá perguntando se briguei com eles, então sim. Mas isso não é nada. A culpa não é minha se eu sou tão forte, é eles que são muito fracos!"
                },
                {
                    "id": "670250304",
                    "speaker": "Havu",
                    "text": "Hunf! É porque eles não sabem como eu sou forte! Quando descobrirem... não vou deixar passar batido! Eles que começaram isso! Hunf!"
                }
            ]
        },
        {
            "talkId": "6702504",
            "initDialog": "670250401",
            "dialogues": [
                {
                    "id": "670250401",
                    "speaker": "Player",
                    "text": "Desculpe pelo incômodo."
                },
                {
                    "id": "670250402",
                    "speaker": "Havu",
                    "text": "Beleza."
                }
            ]
        },
        {
            "talkId": "6702505",
            "initDialog": "670250501",
            "dialogues": [
                {
                    "id": "670250501",
                    "speaker": "Havu",
                    "text": "Desafio de Aventura"
                }
            ]
        },
        {
            "talkId": "6702506",
            "initDialog": "670250601",
            "dialogues": [
                {
                    "id": "670250601",
                    "speaker": "Havu",
                    "text": "Haha, eu ganhei! Eu sou o melhor!"
                }
            ]
        },
        {
            "talkId": "6702507",
            "initDialog": "670250701",
            "dialogues": [
                {
                    "id": "670250701",
                    "speaker": "Havu",
                    "text": "N-Nem pensar! Ugh, você deve ter trapaceado de algum jeito! Mais uma rodada!"
                }
            ]
        }
    ]
}