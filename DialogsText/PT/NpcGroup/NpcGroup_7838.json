            "dialogues": [
                {
                    "id": "678380501",
                    "speaker": "Player",
                    "text": "Que lugar é esse?"
                },
                {
                    "id": "678380502",
                    "speaker": "Efremova",
                    "text": "Não sei. Não venho aqui há muito tempo. A Casa de Hespérides sem Larisa..."
                },
                {
                    "id": "678380503",
                    "speaker": "Efremova",
                    "text": "Naquela época, eu não gostava da mestre nova, a Snegovik que se dizia dona do lugar."
                },
                {
                    "id": "678380504",
                    "speaker": "Efremova",
                    "text": "Mas fora aquele lugar... Já me cansei do resto do mundo. Agora só quero retornar."
                }
