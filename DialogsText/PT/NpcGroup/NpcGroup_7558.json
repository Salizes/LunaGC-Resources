    "talks": [
        {
            "talkId": "6755801",
            "initDialog": "675580101",
            "dialogues": [
                {
                    "id": "675580101",
                    "speaker": "???",
                    "text": "Ajax não causou problemas para vocês, causou...?"
                }
            ]
        },
        {
            "talkId": "6755802",
            "initDialog": "675580201",
            "dialogues": [
                {
                    "id": "675580201",
                    "speaker": "Player",
                    "text": "Você está se preocupando com o Childe?"
                },
                {
                    "id": "675580202",
                    "speaker": "???",
                    "text": "Me preocupar com ele? Eu só tenho medo de que ele esteja arrumando alguma encrenca por aí..."
                },
                {
                    "id": "675580203",
                    "speaker": "???",
                    "text": "Ele vivia arranjando briga quando morava aqui. Foi exatamente por isso que o papai não deixou ele continuar na vila."
                }
            ]
        },
        {
            "talkId": "6755803",
            "initDialog": "675580301",
            "dialogues": [
                {
                    "id": "675580301",
                    "speaker": "Player",
                    "text": "Me conte sobre sua família."
                },
                {
                    "id": "675580302",
                    "speaker": "???",
                    "text": "Como o Ajax vive trazendo remédios das viagens dele, as dores de cabeça do papai melhoraram muito!"
                },
                {
                    "id": "675580303",
                    "speaker": "???",
                    "text": "Mas, dos meus três irmãos mais velhos, Ajax é o único que quase nunca volta para casa. Toda vez que ele promete brincar comigo e com o Teucer, ele dá bolo na gente nove de cada dez vezes!"
                },
                {
                    "id": "675580304",
                    "speaker": "???",
                    "text": "Mas, desde que ele ainda queira brincar com a gente, eu não me importo."
                },
                {
                    "id": "675580305",
                    "speaker": "???",
                    "text": "Eu sempre sinto que... se a gente não estiver ali segurando a mão dele, ele vai acabar escapando de repente para um lugar onde ninguém jamais conseguirá alcançá-lo."
                }
            ]
        },
        {
            "talkId": "6755804",
            "initDialog": "675580401",
            "dialogues": [
                {
                    "id": "675580401",
                    "speaker": "Player",
                    "text": "Até a próxima."
                },
                {
                    "id": "675580402",
                    "speaker": "???",
                    "text": "Até mais!"
                }
            ]
        },
