    "talks": [
        {
            "talkId": "1402204",
            "initDialog": "140220401",
            "dialogues": [
                {
                    "id": "140220401",
                    "speaker": "Ler",
                    "text": "Algumas cartas estão espalhadas na mesa...",
                    "choices": [
                        {
                            "id": "140220402",
                            "text": "Carta de Emilie",
                            "response": [
                                {
                                    "id": "140220403",
                                    "speaker": "Carta de Emilie",
                                    "text": "\"...Obrigada, Srta. Chiori, pelos seus comentários sobre as fragrâncias. Coloquei uma amostra do meu mais novo produto nessa carta. É um experimento recente com uma fragrância Rociomarinha...\""
                                },
                                {
                                    "id": "140220404",
                                    "speaker": "Carta de Emilie",
                                    "text": "\"E também, sobre o cronograma para o próximo teste...\""
                                }
                            ]
                        },
                        {
                            "id": "140220405",
                            "text": "Carta de Navia",
                            "response": [
                                {
                                    "id": "140220406",
                                    "speaker": "Carta de Navia",
                                    "text": "\"Tem uma festa Spina essa noite e você tá convidada!\""
                                },
                                {
                                    "id": "140220407",
                                    "speaker": "Carta de Navia",
                                    "text": "\"Obs.: Traga Eloffe também, tá certo?\""
                                }
                            ]
                        },
                        {
                            "id": "140220408",
                            "text": "Carta de Kirara",
                            "response": [
                                {
                                    "id": "140220409",
                                    "speaker": "Carta de Kirara",
                                    "text": "\"Alguém me perguntou sobre minhas roupas e onde as consegui enquanto estava fazendo uma entrega, Chiori. Disseram que queriam fazer um conjunto para a filha.\""
                                },
                                {
                                    "id": "140220410",
                                    "speaker": "Carta de Kirara",
                                    "text": "\"Vou anexar os tamanhos e foto da criança aqui. Vou passar na sua loja para pegar na próxima vez que estiver na cidade!\""
                                }
                            ]
                        },
                        {
                            "id": "140220411",
                            "text": "Carta de Chevreuse",
                            "response": [
                                {
                                    "id": "140220412",
                                    "speaker": "Carta de Chevreuse",
                                    "text": "\"...Os Gardes suspeitam do juiz... acordo clandestino ilícito.\""
                                },
                                {
                                    "id": "140220413",
                                    "speaker": "Carta de Chevreuse",
                                    "text": "\"...Esposa dele... cliente regular na sua loja. Por favor, fique de olho.\""
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}