            "dialogues": [
                {
                    "id": "736840201",
                    "speaker": "Vinkel",
                    "text": "#Olá, {M#veterano}{F#veterana}! Posso ajudar em algo?"
                }
            ]
        },
        {
            "talkId": "7368403",
            "initDialog": "736840301",
            "dialogues": [
                {
                    "id": "736840301",
                    "speaker": "Player",
                    "text": "Sobre a Através da Selva..."
                },
                {
                    "id": "736840302",
                    "speaker": "Vinkel",
                    "text": "Através da Selva é um evento muito legal organizado pela Guilda de Aventureiros para testar as habilidades de seus aventureiros."
                },
                {
                    "id": "736840303",
                    "speaker": "Vinkel",
                    "text": "Neste evento, os aventureiros precisam seguir as dicas para encontrar os Balões da Selva e seguir a rota definida por eles."
                },
                {
                    "id": "736840304",
                    "speaker": "Vinkel",
                    "text": "Quanto mais Balões da Selva coletados no limite de tempo, maior será sua pontuação, e maior será a recompensa obtida."
                }
            ]
        },
        {
            "talkId": "7368405",
            "initDialog": "736840501",
            "dialogues": [
                {
                    "id": "736840501",
                    "speaker": "Player",
                    "text": "Até mais."
                },
                {
                    "id": "736840502",
                    "speaker": "Vinkel",
                    "text": "Certo! Não se esqueça de participar deste evento!"
                }
            ]
        }
    ]
}