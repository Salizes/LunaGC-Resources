            "dialogues": [
                {
                    "id": "641420101",
                    "speaker": "Babak",
                    "text": "Bem-vindo à minha loja."
                }
            ]
        },
        {
            "talkId": "6414202",
            "initDialog": "641420201",
            "dialogues": [
                {
                    "id": "641420201",
                    "speaker": "Player",
                    "text": "Comprar algo."
                },
                {
                    "id": "641420202",
                    "speaker": "Babak",
                    "text": "Todos estes produtos são importações estrangeiras genuínas. Por favor, leve o tempo que precisar para escolher."
                }
            ]
        },
        {
            "talkId": "6414203",
            "initDialog": "641420301",
            "dialogues": [
                {
                    "id": "641420301",
                    "speaker": "Player",
                    "text": "Que lugar é esse?"
                },
                {
                    "id": "641420302",
                    "speaker": "Babak",
                    "text": "Esta loja é gerida pela Academia e é a maior loja de produtos importados do Porto Ormos."
                },
                {
                    "id": "641420303",
                    "speaker": "Babak",
                    "text": "Eu sou um pesquisador, e eu também sou o gerente."
                },
                {
                    "id": "641420304",
                    "speaker": "Babak",
                    "text": "A maioria dos produtos são isentos de impostos devido à garantia oficial, por isso aqui você pode comprar produtos estrangeiros a preços razoáveis."
                },
                {
                    "id": "641420305",
                    "speaker": "Babak",
                    "text": "De certa forma, isso também desencoraja contrabando."
                }
            ]
        },
        {
            "talkId": "6414204",
            "initDialog": "641420401",
            "dialogues": [
                {
                    "id": "641420401",
                    "speaker": "Player",
                    "text": "Adeus."
                },
                {
                    "id": "641420402",
                    "speaker": "Babak",
                    "text": "Se cuide."
                }
            ]
        }
    ]
