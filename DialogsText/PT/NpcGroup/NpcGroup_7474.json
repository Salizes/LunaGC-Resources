        {
            "talkId": "6747401",
            "initDialog": "674740101",
            "dialogues": [
                {
                    "id": "674740101",
                    "speaker": "Katia",
                    "text": "Notícias quentinhas! O melhor companheiro de viagem! Olá, você gostaria de um jornal?"
                }
            ]
        },
        {
            "talkId": "6747402",
            "initDialog": "674740201",
            "dialogues": [
                {
                    "id": "674740201",
                    "speaker": "Player",
                    "text": "Jornal?"
                },
                {
                    "id": "674740202",
                    "speaker": "Katia",
                    "text": "Isso mesmo. Só tem mais alguns sobrando! A manchete de hoje é realmente de tirar o fôlego, garantida de te levar em segurança!"
                },
                {
                    "id": "674740203",
                    "speaker": "Katia",
                    "text": "O trem não vai a lugar nenhum sem você, então pegue um jornal primeiro e espante o tédio!"
                }
            ]
        },
        {
            "talkId": "6747403",
            "initDialog": "674740301",
            "dialogues": [
                {
                    "id": "674740301",
                    "speaker": "Player",
                    "text": "#Estou bem por enquanto, obrigad{M#o}{F#a}."
                },
                {
                    "id": "674740302",
                    "speaker": "Katia",
                    "text": "Sem problemas. Boa sorte hoje! E se você precisar de um jornal, venha procurar Katia, sua humilde fornecedora!"
                }
            ]
        },
        {
            "talkId": "6747404",
            "initDialog": "674740401",
            "dialogues": [
                {
                    "id": "674740401",
                    "speaker": "Player",
                    "text": "Devo dizer, sua propaganda é bem interessante."
                },
                {
                    "id": "674740402",
                    "speaker": "Katia",
                    "text": "Caramba, muito obrigada! Isso significa que você tem o dom de ver o bom nas pessoas e um olhar bem aguçado!"
                },
                {
                    "id": "674740403",
                    "speaker": "Katia",
                    "text": "Pessoas boas merecem notícias boas! E olha só, o jornal de hoje está recheado de notícias excelentes. Então, gostaria de um jornal?"
                }
            ]
        },
        {
            "talkId": "6747405",
            "initDialog": "674740501",
            "dialogues": [
                {
                    "id": "674740501",
                    "speaker": "Player",
                    "text": "Não precisa."
                },
                {
                    "id": "674740502",
                    "speaker": "Katia",
                    "text": "Tudo bem, sem problemas. E se você precisar de um jornal, venha procurar Katia, sua humilde fornecedora!"
                }
            ]
        },
