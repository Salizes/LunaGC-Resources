{
    "groupId": "2514",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Bosu": 12,
        "Player": 4
    },
    "talks": [
        {
            "talkId": "6251401",
            "initDialog": "625140101",
            "dialogues": [
                {
                    "id": "625140101",
                    "speaker": "Bosu",
                    "text": "Olá, viajante. Você veio para pegar o barco?"
                }
            ]
        },
        {
            "talkId": "6251402",
            "initDialog": "625140201",
            "dialogues": [
                {
                    "id": "625140201",
                    "speaker": "Player",
                    "text": "O que você está recitando?"
                },
                {
                    "id": "625140202",
                    "speaker": "Bosu",
                    "text": "É um poema popular no Vale Chenyu, que todo barqueiro conhece."
                },
                {
                    "id": "625140203",
                    "speaker": "Bosu",
                    "text": "Essa é fácil de entender. Tem outra, mais elegante..."
                },
                {
                    "id": "625140204",
                    "speaker": "Bosu",
                    "text": "\"...A primavera cria ondas pelo vale, os santuários partem das costas do nordeste. Os montes e águas rasas do sudoeste escondem...\""
                },
                {
                    "id": "625140205",
                    "speaker": "Bosu",
                    "text": "Eu vou cantar essa daqui quando você pegar uma jangada para o Porto Yilong."
                }
            ]
        },
        {
            "talkId": "6251403",
            "initDialog": "625140301",
            "dialogues": [
                {
                    "id": "625140301",
                    "speaker": "Player",
                    "text": "Esse barco é bem único."
                },
                {
                    "id": "625140302",
                    "speaker": "Bosu",
                    "text": "Bom gosto!"
                },
                {
                    "id": "625140303",
                    "speaker": "Bosu",
                    "text": "O Vale Chenyu é raso e tem várias curvas, por isso embarcações grandes ficariam presas aqui o tempo todo."
                },
                {
                    "id": "625140304",
                    "speaker": "Bosu",
                    "text": "Mas não é uma jangada! É leve, e flutua na água, por isso nenhuma curva ou recife oculto pode nos parar."
                },
                {
                    "id": "625140305",
                    "speaker": "Bosu",
                    "text": "E mais importante, a paisagem do Vale Chenyu só pode ser apreciada bem de uma jangada."
                }
            ]
        },
        {
            "talkId": "6251404",
            "initDialog": "625140401",
            "dialogues": [
                {
                    "id": "625140401",
                    "speaker": "Player",
                    "text": "Desculpe pelo incômodo."
                },
                {
                    "id": "625140402",
                    "speaker": "Bosu",
                    "text": "Adeus, boa viagem!"
                }
            ]
        },
        {
            "talkId": "6251405",
            "initDialog": "625140501",
            "dialogues": [
                {
                    "id": "625140501",
                    "speaker": "Bosu",
                    "text": "Beleza, chegamos! Boa viagem, jovem!"
                }
            ]
        },
        {
            "talkId": "7112302",
            "initDialog": "711230201",
            "dialogues": [
                {
                    "id": "711230201",
                    "speaker": "Player",
                    "text": "Viaje na jangada de bambu até o Porto Yilong."
                },
                {
                    "id": "711230202",
                    "speaker": "Bosu",
                    "text": "Tudo certo! Por favor, vão para seus assentos que vamos partir."
                }
            ]
        }
    ]
}