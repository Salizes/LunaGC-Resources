            "dialogues": [
                {
                    "id": "641810101",
                    "speaker": "Arashakun",
                    "text": "Havendo \"coragem\", não importa quantos \"Monstros Mascarados\" apareçam, Arashakun não terá medo! Não os deixarei roubar a \"coragem\"!"
                }
            ]
        },
        {
            "talkId": "6418102",
            "initDialog": "641810201",
            "dialogues": [
                {
                    "id": "641810201",
                    "speaker": "Player",
                    "text": "Na verdade, coragem não pode ser roubada..."
                },
                {
                    "id": "641810202",
                    "speaker": "Arashakun",
                    "text": "?"
                },
                {
                    "id": "641810203",
                    "speaker": "Arashakun",
                    "text": "Contudo, depois que a \"coragem\" foi roubada, Arashakun sentiu mãos e pés fracos..."
                }
            ]
        },
        {
            "talkId": "6418103",
            "initDialog": "641810301",
            "dialogues": [
                {
                    "id": "641810301",
                    "speaker": "Player",
                    "text": "Bem, guarde-a com cuidado..."
                },
                {
                    "id": "641810302",
                    "speaker": "Arashakun",
                    "text": "Arashakun vai!"
                }
            ]
        },
        {
            "talkId": "6418104",
            "initDialog": "641810401",
            "dialogues": [
                {
                    "id": "641810401",
                    "speaker": "Player",
                    "text": "A coragem está dentro de Arashakun..."
                },
                {
                    "id": "641810402",
                    "speaker": "Arashakun",
                    "text": "#Bem, o que Nara {NICKNAME} disse é difícil de entender..."
                }
            ]
        }
