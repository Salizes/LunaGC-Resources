                {
                    "id": "695010501",
                    "speaker": "Fischl",
                    "text": "O inimigo predestinado desta Princesa... foi capaz de camuflar o ciclo de causas e efeitos das cartas?"
                }
            ]
        },
        {
            "talkId": "6950106",
            "initDialog": "695010601",
            "dialogues": [
                {
                    "id": "695010601",
                    "speaker": "Fischl",
