{
    "groupId": "15888",
    "total_dialogue_lines": 40,
    "speaker_counts": {
        "???": 1,
        "Fada Esquilo-Voador": 4,
        "Gato de Rua": 8,
        "Gato na Caixa": 2,
        "Narradora": 2,
        "Paimon": 13,
        "Player": 7,
        "Rei Girafa": 3
    },
    "talks": [
        {
            "talkId": "1600225",
            "initDialog": "160022501",
            "dialogues": [
                {
                    "id": "160022501",
                    "speaker": "Narradora",
                    "text": "As testemunhas da história chegaram a um lugar escondido nas muralhas altas, um lugar atrelado a uma das memórias mais queridas do pequeno dragão."
                },
                {
                    "id": "160022502",
                    "speaker": "Narradora",
                    "text": "Nessas memórias viviam os amigos que ele fez no castelo."
                },
                {
                    "id": "160022503",
                    "speaker": "Paimon",
                    "text": "Ei, vocês ainda tão todos aqui! Paimon acha que isso é prova que os amigos de Durin de Simulanka ainda têm um lugar especial no coração dele..."
                },
                {
                    "id": "160022504",
                    "speaker": "Fada Esquilo-Voador",
                    "text": "Olá, novamente, Viajante de cabelos dourados e fadinha prateada. Como está o pequeno dragão em sua jornada?",
                    "choices": [
                        {
                            "id": "160022505",
                            "text": "Houve algumas... complicações.",
                            "response": [
                                {
                                    "id": "160022507",
                                    "speaker": "Fada Esquilo-Voador",
                                    "text": "O quê? Mas, eu ainda me lembro dele."
                                },
                                {
                                    "id": "160022508",
                                    "speaker": "Rei Girafa",
                                    "text": "Eu também não me esqueci dele!"
                                },
                                {
                                    "id": "160022509",
                                    "speaker": "Gato na Caixa",
                                    "text": "E nem esse gato na caixa."
                                },
                                {
                                    "id": "160022510",
                                    "speaker": "Paimon",
                                    "text": "Isso são boas notícias! Pelo menos os amigos de Durin ainda se lembram dele. Certo, apenas teremos que ajudar todos a se lembrarem dele."
                                },
                                {
                                    "id": "160022511",
                                    "speaker": "Paimon",
                                    "text": "Oh, espera aí, estamos esquecendo de alguém?"
                                },
                                {
                                    "id": "160022512",
                                    "speaker": "Rei Girafa",
                                    "text": "Ah, você quer dizer, aquele gato de rua? Ele não quer ver o dragãozinho... e ele está se escondendo da gente também.",
                                    "choices": [
                                        {
                                            "id": "160022513",
                                            "text": "Um gato de rua?",
                                            "response": [
                                                {
                                                    "id": "160022515",
                                                    "speaker": "Paimon",
                                                    "text": "Sinceramente, qual é o problema dele? Ele não fala a Durin o que tá incomodando ele no mundo real, e agora, ele tá se escondendo dele no mundo da história também..."
                                                },
                                                {
                                                    "id": "160022516",
                                                    "speaker": "Fada Esquilo-Voador",
                                                    "text": "Seu esconderijo é logo ali, mas ele não vai falar com a gente. Talvez você poderia tentar?"
                                                },
                                                {
                                                    "id": "160022517",
                                                    "speaker": "Player",
                                                    "text": "Deixa com a gente."
                                                },
                                                {
                                                    "id": "160022518",
                                                    "speaker": "Paimon",
                                                    "text": "Ei, Sr. Gatinho Andarilho! Por que você está se escondendo do dragãozinho?"
                                                },
                                                {
                                                    "id": "160022519",
                                                    "speaker": "???",
                                                    "text": "Você veio até aqui só para me perguntar isso?"
                                                },
                                                {
                                                    "id": "160022520",
                                                    "speaker": "Paimon",
                                                    "text": "Hah, então você consegue falar!"
                                                },
                                                {
                                                    "id": "160022521",
                                                    "speaker": "Gato de Rua",
                                                    "text": "Você mesmo disso. Várias pessoas nem se lembram dele."
                                                },
                                                {
                                                    "id": "160022522",
                                                    "speaker": "Paimon",
                                                    "text": "Sim, e daí?"
                                                },
                                                {
                                                    "id": "160022523",
                                                    "speaker": "Gato de Rua",
                                                    "text": "Então, não deixe ele nem se aproximar de mim."
                                                },
                                                {
                                                    "id": "160022524",
                                                    "speaker": "Paimon",
                                                    "text": "O que isso deveria significar? Ei! Urg, ele ficou de bico fechado de novo..."
                                                },
                                                {
                                                    "id": "160022525",
                                                    "speaker": "Gato de Rua",
                                                    "text": "Não fale das outras pessoas pelas suas costas. É claro que me lembro dele."
                                                },
                                                {
                                                    "id": "160022526",
                                                    "speaker": "Paimon",
                                                    "text": "Eita! Você não pode só aparecer assim do nada!"
                                                },
                                                {
                                                    "id": "160022527",
                                                    "speaker": "Gato de Rua",
                                                    "text": "Hunf..."
                                                },
                                                {
                                                    "id": "160022528",
                                                    "speaker": "Paimon",
                                                    "text": "Pfff, mas devo dizer... Você está bem diferente."
                                                },
                                                {
                                                    "id": "160022529",
                                                    "speaker": "Gato de Rua",
                                                    "text": "Você pode pensar o que quiser, mas eu sempre tive essa aparência."
                                                },
                                                {
                                                    "id": "160022530",
                                                    "speaker": "Paimon",
                                                    "text": "Uh, sem resposta grosseira? Isso é novidade...",
                                                    "choices": [
                                                        {
                                                            "id": "160022531",
                                                            "text": "Ele provavelmente é só um personagem da história.",
                                                            "response": [
                                                                {
                                                                    "id": "160022533",
                                                                    "speaker": "Paimon",
                                                                    "text": "Verdade... e falando nisso, quando todos fizeram aquele desejo para Durin, você foi o único que não estava lá."
                                                                },
                                                                {
                                                                    "id": "160022534",
                                                                    "speaker": "Gato de Rua",
                                                                    "text": "Pfff, e por qual motivo ele precisaria da minha ajuda com algo tão infantil assim? Se ele realmente se deparar com um problema de verdade, ele sabe onde me achar."
                                                                },
                                                                {
                                                                    "id": "160022535",
                                                                    "speaker": "Paimon",
                                                                    "text": "Hnf... Ele pode não ser o \"Cara do Chapéu\" de verdade, mas ele definitivamente sabe fazer o papel dele..."
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "160022532",
                                                            "text": "Não é o verdadeiro Cara do Chapéu."
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "160022514",
                                            "text": "Ah... Deve ser \"aquele\" gato de rua."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "160022506",
                            "text": "Parece que quase todo mundo esqueceu quem é ele."
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "1600228",
            "initDialog": "160022801",
            "dialogues": [
                {
                    "id": "160022801",
                    "speaker": "Fada Esquilo-Voador",
                    "text": "Mas... Como todos simplesmente esqueceram dele assim? Ele precisa de outra bênção?"
                },
                {
                    "id": "160022802",
                    "speaker": "Rei Girafa",
                    "text": "Ele estava fadado a encontrar desafios no mundo fora do castelo. Caso contrário, teria sido uma jornada bem entediante."
                },
                {
                    "id": "160022803",
                    "speaker": "Gato na Caixa",
                    "text": "Se você quiser saber minha opinião, quanto menos acontecimentos em uma jornada, melhor..."
                },
                {
                    "id": "160022804",
                    "speaker": "Gato de Rua",
                    "text": "..."
                },
                {
                    "id": "160022805",
                    "speaker": "Gato de Rua",
                    "text": "Se ele realmente se deparar com um problema de verdade, ele sabe onde me achar."
                }
            ]
        }
    ]
}