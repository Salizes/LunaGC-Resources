{
    "groupId": "9045",
    "total_dialogue_lines": 65,
    "speaker_counts": {
        "Player": 17,
        "Rosaria": 48
    },
    "talks": [
        {
            "talkId": "6904501",
            "initDialog": "690450101",
            "dialogues": [
                {
                    "id": "690450101",
                    "speaker": "Rosaria",
                    "text": "... Que horas são agora?"
                }
            ]
        },
        {
            "talkId": "6904502",
            "initDialog": "690450201",
            "dialogues": [
                {
                    "id": "690450201",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>Você se acostumou com esse lugar?</color>"
                },
                {
                    "id": "690450202",
                    "speaker": "Rosaria",
                    "text": "Não é uma questão de acostumar... Não ligo muito sobre onde morar."
                },
                {
                    "id": "690450203",
                    "speaker": "Rosaria",
                    "text": "Mas, me sinto mais livre aqui do que na Igreja..."
                },
                {
                    "id": "690450204",
                    "speaker": "Rosaria",
                    "text": "Pelo menos, ninguém me incomodaria, fazendo orações de manhã.",
                    "choices": [
                        {
                            "id": "690450205",
                            "text": "Você ainda dorme muito tarde?",
                            "response": [
                                {
                                    "id": "690450206",
                                    "speaker": "Rosaria",
                                    "text": "Obrigada pela sua preocupação. Haha, só estou lidando com algumas coisas pequenas, nada demais."
                                },
                                {
                                    "id": "690450207",
                                    "speaker": "Rosaria",
                                    "text": "Estou acostumada a trabalhar e descansar assim, mudar seria inconveniente."
                                },
                                {
                                    "id": "690450211",
                                    "speaker": "Rosaria",
                                    "text": "Talvez eu me adapte mais aqui do que havia imaginado..."
                                },
                                {
                                    "id": "690450212",
                                    "speaker": "Rosaria",
                                    "text": "Shhhh... Dependência excessiva não é uma coisa boa."
                                }
                            ]
                        },
                        {
                            "id": "690450208",
                            "text": "Você se dedicou muito.",
                            "response": [
                                {
                                    "id": "690450209",
                                    "speaker": "Rosaria",
                                    "text": "Não foi nada demais."
                                },
                                {
                                    "id": "690450210",
                                    "speaker": "Rosaria",
                                    "text": "Deixe para lá. Eu sei que você se importa. Agradeço a sua preocupação."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6904503",
            "initDialog": "690450301",
            "dialogues": [
                {
                    "id": "690450301",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>Você quer conversar comigo?</color>"
                },
                {
                    "id": "690450302",
                    "speaker": "Rosaria",
                    "text": "Sim. Mas deixe-me só dizer uma coisa, se você quiser confessar, é melhor procurar alguma outra alma.",
                    "choices": [
                        {
                            "id": "690450303",
                            "text": "O que aconteceu?",
                            "response": [
                                {
                                    "id": "690450304",
                                    "speaker": "Rosaria",
                                    "text": "Hã? Eu recebi uma vez uma confissões de discípulos."
                                },
                                {
                                    "id": "690450305",
                                    "speaker": "Rosaria",
                                    "text": "Entender o que eles queriam dizer já era difícil, mas ainda precisava confortá-lo com palavras como \"Que o Arconte Anemo te proteja\"."
                                },
                                {
                                    "id": "690450306",
                                    "speaker": "Rosaria",
                                    "text": "Poupe-me!"
                                },
                                {
                                    "id": "690450310",
                                    "speaker": "Rosaria",
                                    "text": "Entretanto, há muitas pessoas que confiam que Barbatos as protegerá, por isso o sofrimento e o azar não cairá sobre suas cabeças."
                                },
                                {
                                    "id": "690450311",
                                    "speaker": "Rosaria",
                                    "text": "Tá bem! Se acreditar nisso pode confortá-lo, então deixa estar."
                                },
                                {
                                    "id": "690450312",
                                    "speaker": "Rosaria",
                                    "text": "Espere um pouco... Deveria ser Basbato? Ou será que é Bartobas? Acho que estou falando errado."
                                },
                                {
                                    "id": "690450313",
                                    "speaker": "Player",
                                    "text": "Na verdade, é Barbatos."
                                },
                                {
                                    "id": "690450314",
                                    "speaker": "Rosaria",
                                    "text": "Certo, você tem razão. Barbatos então."
                                },
                                {
                                    "id": "690450315",
                                    "speaker": "Rosaria",
                                    "text": "E... Além disso, obrigada."
                                },
                                {
                                    "id": "690450316",
                                    "speaker": "Rosaria",
                                    "text": "Fico muito feliz por poder conversar com você, sem preocupações."
                                }
                            ]
                        },
                        {
                            "id": "690450307",
                            "text": "Não tenho interesse em confissões.",
                            "response": [
                                {
                                    "id": "690450308",
                                    "speaker": "Rosaria",
                                    "text": "Ótimo, parece que nós nos entendemos em algo."
                                },
                                {
                                    "id": "690450309",
                                    "speaker": "Rosaria",
                                    "text": "Ao invés de ficar na igreja chorando e confessando um dia inteiro, não seria melhor tomar ações e corrigir o problema?"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6904504",
            "initDialog": "690450401",
            "dialogues": [
                {
                    "id": "690450401",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>O que você gostaria de fazer?</color>"
                },
                {
                    "id": "690450402",
                    "speaker": "Rosaria",
                    "text": "#Vou direto ao ponto, vamos beber junt{M#os}{F#as}."
                },
                {
                    "id": "690450403",
                    "speaker": "Rosaria",
                    "text": "#Vamos beber livremente, sem nos preocuparmos... Se ficaremos bêbad{M#os}{F#as}, não tem problema.",
                    "choices": [
                        {
                            "id": "690450404",
                            "text": "Rosaria, você realmente fica bêbada?",
                            "response": [
                                {
                                    "id": "690450406",
                                    "speaker": "Rosaria",
                                    "text": "Sim, eu nunca me deixo ficar bêbada."
                                },
                                {
                                    "id": "690450407",
                                    "speaker": "Rosaria",
                                    "text": "Inicialmente, eu pensava que era uma coisa muito idiota mostrar minha própria vulnerabilidade para as outras pessoas."
                                },
                                {
                                    "id": "690450408",
                                    "speaker": "Rosaria",
                                    "text": "Mas minhas ideias mudaram."
                                },
                                {
                                    "id": "690450409",
                                    "speaker": "Rosaria",
                                    "text": "Talvez é porque confio em você... Mas isso não é importante."
                                },
                                {
                                    "id": "690450410",
                                    "speaker": "Rosaria",
                                    "text": "Presentes dos Anjos ou Cauda do Gato... Para qual eu devo ir?",
                                    "choices": [
                                        {
                                            "id": "690450411",
                                            "text": "Presentes dos Anjos.",
                                            "response": [
                                                {
                                                    "id": "690450412",
                                                    "speaker": "Rosaria",
                                                    "text": "Os produtos da Adega do Alvorecer têm qualidade garantida."
                                                },
                                                {
                                                    "id": "690450413",
                                                    "speaker": "Rosaria",
                                                    "text": "Se você for nela, tem que provar o Vinho de Dandelion."
                                                },
                                                {
                                                    "id": "690450417",
                                                    "speaker": "Rosaria",
                                                    "text": "Pela sua aparência, parece que você bebeu mais do que devia dessa vez, não foi?"
                                                },
                                                {
                                                    "id": "690450418",
                                                    "speaker": "Player",
                                                    "text": "..."
                                                },
                                                {
                                                    "id": "690450419",
                                                    "speaker": "Rosaria",
                                                    "text": "..."
                                                },
                                                {
                                                    "id": "690450420",
                                                    "speaker": "Rosaria",
                                                    "text": "Deixe para lá, vou beber no seu lugar."
                                                },
                                                {
                                                    "id": "690450421",
                                                    "speaker": "Rosaria",
                                                    "text": "Outro dia você me paga de volta."
                                                }
                                            ]
                                        },
                                        {
                                            "id": "690450414",
                                            "text": "Cauda do Gato.",
                                            "response": [
                                                {
                                                    "id": "690450415",
                                                    "speaker": "Rosaria",
                                                    "text": "#Oh? Você está interessad{F#a}{M#o} nessa bebida especial deles?"
                                                },
                                                {
                                                    "id": "690450416",
                                                    "speaker": "Rosaria",
                                                    "text": "O bartender lá não trabalha todos os dias, mas podemos tentar nossa sorte."
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "690450405",
                            "text": "Não consigo imaginar você bêbada."
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6904505",
            "initDialog": "690450500",
            "dialogues": [
                {
                    "id": "690450500",
                    "speaker": "Rosaria",
                    "text": "Bom dia, Rosaria."
                },
                {
                    "id": "690450501",
                    "speaker": "Rosaria",
                    "text": "#Oh, bom dia, {NICKNAME}."
                },
                {
                    "id": "690450502",
                    "speaker": "Rosaria",
                    "text": "#Haha, você parece bem animad{F#a}{M#o}. Se não precisa de mim para nada, descansarei um pouco."
                }
            ]
        },
        {
            "talkId": "6904506",
            "initDialog": "690450601",
            "dialogues": [
                {
                    "id": "690450601",
                    "speaker": "Player",
                    "text": "Boa noite, Rosaria."
                },
                {
                    "id": "690450602",
                    "speaker": "Rosaria",
                    "text": "#Boa noite, {NICKNAME}, vá dormir."
                },
                {
                    "id": "690450603",
                    "speaker": "Rosaria",
                    "text": "Em breve meu trabalho deve começar."
                }
            ]
        },
        {
            "talkId": "6904507",
            "initDialog": "690450701",
            "dialogues": [
                {
                    "id": "690450701",
                    "speaker": "Player",
                    "text": "Quer conversar comigo?"
                }
            ]
        },
        {
            "talkId": "6904508",
            "initDialog": "690450801",
            "dialogues": [
                {
                    "id": "690450801",
                    "speaker": "Player",
                    "text": "Gostaria de fazer alguma coisa?"
                }
            ]
        },
        {
            "talkId": "6904509",
            "initDialog": "690450901",
            "dialogues": [
                {
                    "id": "690450901",
                    "speaker": "Player",
                    "text": "Você já se acostumou com esse lugar?"
                }
            ]
        },
        {
            "talkId": "6904550",
            "initDialog": "690455001",
            "dialogues": [
                {
                    "id": "690455001",
                    "speaker": "Rosaria",
                    "text": "Um ambiente para deixar as pessoas confortáveis."
                },
                {
                    "id": "690455002",
                    "speaker": "Rosaria",
                    "text": "As Freiras da Igreja não devem vir me procurar aqui, posso ficar sem ser importunada e descansar um pouco."
                },
                {
                    "id": "690455003",
                    "speaker": "Rosaria",
                    "text": "Obrigada por ter me falado a respeito desse lugar."
                }
            ]
        },
        {
            "talkId": "6904551",
            "initDialog": "690455101",
            "dialogues": [
                {
                    "id": "690455101",
                    "speaker": "Rosaria",
                    "text": "Não imaginei que você tinha tal gosto."
                },
                {
                    "id": "690455102",
                    "speaker": "Rosaria",
                    "text": "Será que as uvas daqui serviriam para imitar o processo de fermentação de vinho da Adega do Alvorecer?"
                },
                {
                    "id": "690455103",
                    "speaker": "Rosaria",
                    "text": "Boa opinião. Se você tiver sucesso, lembre-se de me chamar para provar."
                }
            ]
        }
    ]
}