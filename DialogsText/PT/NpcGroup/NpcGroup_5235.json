    "talks": [
        {
            "talkId": "6523501",
            "initDialog": "652350101",
            "dialogues": [
                {
                    "id": "652350101",
                    "speaker": "Irus",
                    "text": "Eu não esperava ver você aqui. O que você fez?"
                }
            ]
        },
        {
            "talkId": "6523502",
            "initDialog": "652350201",
            "dialogues": [
                {
                    "id": "652350201",
                    "speaker": "Player",
                    "text": "Eu não quebrei nenhuma lei..."
                },
                {
                    "id": "652350202",
                    "speaker": "Irus",
                    "text": "Ah, que pena..."
                }
            ]
        },
        {
            "talkId": "6523503",
            "initDialog": "652350301",
            "dialogues": [
                {
                    "id": "652350301",
                    "speaker": "Player",
                    "text": "Falou."
                },
                {
                    "id": "652350302",
                    "speaker": "Irus",
                    "text": "Se cuide! Dizer \"tchau\" em um lugar como esse é muito estranho."
                }
            ]
        },
        {
            "talkId": "6523504",
            "initDialog": "652350401",
            "dialogues": [
                {
                    "id": "652350401",
                    "speaker": "Player",
                    "text": "Que pena?"
                },
                {
                    "id": "652350402",
                    "speaker": "Irus",
                    "text": "Ah, não me interprete mal! Eu só quis dizer que esse lugar não é tão ruim assim, sabe?"
                },
                {
                    "id": "652350403",
                    "speaker": "Irus",
                    "text": "Os guardas são gente fina. E se você reparar, basta trabalhar para conseguir seus Cupons, todo dia vai ter comida. Pra falar verdade, é uma vida muito mais tranquila que a de um mercenário!"
                }
            ]
        },
        {
            "talkId": "6523505",
            "initDialog": "652350501",
            "dialogues": [
                {
                    "id": "652350501",
                    "speaker": "Player",
                    "text": "E seus companheiros?"
                },
                {
                    "id": "652350502",
                    "speaker": "Irus",
                    "text": "Você tá falando de Kayky e Kayqubad? Bem, como são criminosos, acabaram levando uma multa, mas só isso, nada de mais."
                },
                {
                    "id": "652350503",
                    "speaker": "Irus",
                    "text": "Espero que eles possam encontrar um empregador mais confiável, ou que consigam trabalhar num ramo mais honesto..."
                }
            ]
        }
    ]
}