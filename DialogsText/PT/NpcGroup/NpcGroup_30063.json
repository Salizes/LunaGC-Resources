                                                                                    "text": "Na verdade, estou um pouco assustada..."
                                                                                },
                                                                                {
                                                                                    "id": "400122716",
                                                                                    "speaker": "Klee",
                                                                                    "text": "Se eu falhar, então a Dodoco vai me deixar..."
                                                                                },
