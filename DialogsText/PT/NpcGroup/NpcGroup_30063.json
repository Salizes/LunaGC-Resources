            "dialogues": [
                {
                    "id": "400122701",
                    "speaker": "Klee",
                    "text": "#Ah! {F#Cavaleira}{M#Cavaleiro} Honorável!",
                    "choices": [
                        {
                            "id": "400122702",
                            "text": "Você quer conversar?",
                            "response": [
                                {
                                    "id": "400122703",
                                    "speaker": "Klee",
                                    "text": "Ooh, certo!",
                                    "choices": [
                                        {
                                            "id": "400122704",
                                            "text": "Sobre o Rei-Dodo...",
                                            "response": [
                                                {
                                                    "id": "400122705",
                                                    "speaker": "Klee",
                                                    "text": "#Aquele cara é muito ruim! {F#Cavaleira}{M#Cavaleiro} Honorável, você também deve tomar cuidado com ele."
                                                },
                                                {
                                                    "id": "400122706",
                                                    "speaker": "Klee",
                                                    "text": "Mesmo que eu ainda não o tenha visto, eu definitivamente protegerei a Dodoco. Não vou deixar que a Dodoco seja levada!"
                                                },
                                                {
                                                    "id": "400122707",
                                                    "speaker": "Klee",
                                                    "text": "Mesmo que ele seja o... Uh, avô? Irmão? Da Dodoco... Ou o que quer que seja..."
                                                },
                                                {
                                                    "id": "400122708",
                                                    "speaker": "Klee",
                                                    "text": "Não importa quem o Rei-Dodo seja, eu não perderei!",
                                                    "choices": [
                                                        {
                                                            "id": "400122704",
                                                            "text": "Sobre o Rei-Dodo..."
                                                        },
                                                        {
                                                            "id": "400122709",
                                                            "text": "Conte-me sobre essas ilhas...",
                                                            "response": [
                                                                {
                                                                    "id": "400122710",
                                                                    "speaker": "Klee",
                                                                    "text": "Eu amo este lugar!"
                                                                },
                                                                {
                                                                    "id": "400122711",
                                                                    "speaker": "Klee",
                                                                    "text": "Existem praias, o oceano..."
                                                                },
                                                                {
                                                                    "id": "400122712",
                                                                    "speaker": "Klee",
                                                                    "text": "E o Harpastum que a Barbara me deu, e todas as outras coisas maravilhosas! Todos aqui tornam tudo realmente emocionante!"
                                                                },
                                                                {
                                                                    "id": "400122713",
                                                                    "speaker": "Klee",
                                                                    "text": "Estou super feliz!",
