    "talks": [
        {
            "talkId": "6424501",
            "initDialog": "642450101",
            "dialogues": [
                {
                    "id": "642450101",
                    "speaker": "Soheil",
                    "text": "Por que os jovens estudiosos são tão impulsivos?"
                }
            ]
        },
        {
            "talkId": "6424502",
            "initDialog": "642450201",
            "dialogues": [
                {
                    "id": "642450201",
                    "speaker": "Player",
                    "text": "Você ainda está preocupado?"
                },
                {
                    "id": "642450202",
                    "speaker": "Soheil",
                    "text": "Sim! Ainda existem muitos jovens estudiosos se esforçando muito para entrar no deserto."
                },
                {
                    "id": "642450203",
                    "speaker": "Soheil",
                    "text": "Como resultado, tenho que dar algumas voltas com o Hulwani pelas proximidades diariamente, fico tonto e com dor nos pés. Ainda não tive tempo para estudar a Tabuleta de Pedra que vocês encontraram com tanta dificuldade."
                },
                {
                    "id": "642450204",
                    "speaker": "Soheil",
                    "text": "*Suspiro*, Gostaria de saber quando poderei voltar a Academia."
                }
            ]
        },
        {
            "talkId": "6424503",
            "initDialog": "642450301",
            "dialogues": [
                {
                    "id": "642450301",
                    "speaker": "Player",
                    "text": "Te vejo por aí."
                },
                {
                    "id": "642450302",
                    "speaker": "Soheil",
                    "text": "Adeus, tenham uma boa viagem."
                }
            ]
        }
    ]
}