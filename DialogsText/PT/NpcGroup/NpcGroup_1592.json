    "talks": [
        {
            "talkId": "6159201",
            "initDialog": "615920101",
            "dialogues": [
                {
                    "id": "615920101",
                    "speaker": "Greg",
                    "text": "Você não quer beber mais uns dois copos?"
                }
            ]
        },
        {
            "talkId": "6159202",
            "initDialog": "615920201",
            "dialogues": [
                {
                    "id": "615920201",
                    "speaker": "Player",
                    "text": "Quem é você?"
                },
                {
                    "id": "615920202",
                    "speaker": "Greg",
                    "text": "Meu nome é Greg! Eu trabalho na Adega do Alvorecer - O Mestre Diluc estava de bom humor hoje e me deu uma garrafa do seu próprio estoque!"
                },
                {
                    "id": "615920203",
                    "speaker": "Greg",
                    "text": "Bom vinho deve ser apreciado na companhia de boas pessoas! Que tal você vir comigo para o Vinhedo e abrirmos isso juntos?"
                },
                {
                    "id": "615920204",
                    "speaker": "Greg",
                    "text": "Hmm... Devo dizer que pareço ter esquecido meu caminho, a Adega do Alvorecer fica... A noroeste daqui, certo?",
                    "choices": [
                        {
                            "id": "615920205",
                            "text": "Errado.",
                            "response": [
                                {
                                    "id": "615920206",
                                    "speaker": "Greg",
                                    "text": "Ele não está bêbado como ainda tem senso de direção."
                                },
                                {
                                    "id": "615920207",
                                    "speaker": "Greg",
                                    "text": "Quem não estiver embriagado, suma da minha frente!"
                                }
                            ]
                        },
                        {
                            "id": "615920208",
                            "text": "Sim.",
                            "response": [
                                {
                                    "id": "615920209",
                                    "speaker": "Greg",
                                    "text": "Hehehe, bem... Então vamos lá!"
                                },
                                {
                                    "id": "615920210",
                                    "speaker": "Greg",
                                    "text": "Parece que alguém bebeu demais aqui! Deixe-me lhe ajudar..."
                                },
                                {
                                    "id": "615920211",
                                    "speaker": "Greg",
                                    "text": "Não se preocupe. Temos ainda um longo caminho a percorrer."
                                },
                                {
                                    "id": "615920212",
                                    "speaker": "Player",
                                    "text": "Você tem olhado para minha bolsa de moedas esse tempo todo."
                                },
                                {
                                    "id": "615920213",
                                    "speaker": "Greg",
                                    "text": "Ai, meu amigo! Ouça as palavras ofensivas que você está dizendo! Eu não me atreveria a roubar de você..."
                                },
                                {
                                    "id": "615920214",
                                    "speaker": "Greg",
                                    "text": "...Espere, como você percebeu?"
                                },
                                {
                                    "id": "615920215",
                                    "speaker": "Greg",
                                    "text": "Não finja que está bêbado, é um desperdício de tempo."
                                },
                                {
                                    "id": "615920216",
                                    "speaker": "Greg",
                                    "text": "Vai embora, não tenho mais interesse em você."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6159203",
            "initDialog": "615920301",
            "dialogues": [
                {
                    "id": "615920301",
                    "speaker": "Player",
                    "text": "Não tenho interesse."
                },
                {
                    "id": "615920302",
                    "speaker": "Greg",
                    "text": "Como queira."
                }
            ]
        }
    ]
}