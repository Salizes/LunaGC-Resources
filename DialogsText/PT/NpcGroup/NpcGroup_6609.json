    "talks": [
        {
            "talkId": "6660901",
            "initDialog": "666090101",
            "dialogues": [
                {
                    "id": "666090101",
                    "speaker": "Jayubal",
                    "text": "Ah... A última vez que embarquei num barco assim, Yohuana estava lá, carregando o pequeno Quemitl... Bons tempos."
                },
                {
                    "id": "666090102",
                    "speaker": "Jayubal",
                    "text": "Se ela ainda estivesse entre nós, tenho certeza que Yohuana adoraria se sentar ao meu lado."
                },
                {
                    "id": "666090103",
                    "speaker": "Jayubal",
                    "text": "Infelizmente, parece que a atração ainda não está pronta."
                }
            ]
        },
        {
            "talkId": "6660902",
            "initDialog": "666090201",
            "dialogues": [
                {
                    "id": "666090201",
                    "speaker": "Jayubal",
                    "text": "Ah, o barco está pronto."
                },
                {
                    "id": "666090202",
                    "speaker": "Player",
                    "text": "Quer conferir?"
                },
                {
                    "id": "666090203",
                    "speaker": "Jayubal",
                    "text": "Hehe, valeu, mas não."
                },
                {
                    "id": "666090204",
                    "speaker": "Jayubal",
                    "text": "Tenho um barquinho roxo flutuando por aí em minhas memórias. Eu passeio nele todo dia."
                }
            ]
        }
    ]
}