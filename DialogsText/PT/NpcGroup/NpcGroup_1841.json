    "talks": [
        {
            "talkId": "6184101",
            "initDialog": "618410101",
            "dialogues": [
                {
                    "id": "618410101",
                    "speaker": "Okikuni",
                    "text": "\"Três mil fileiras de lâminas e lanças, dez mil montarias e armaduras...\""
                }
            ]
        },
        {
            "talkId": "6184102",
            "initDialog": "618410201",
            "dialogues": [
                {
                    "id": "618410201",
                    "speaker": "Player",
                    "text": "Conte-me sobre a sua era."
                },
                {
                    "id": "618410202",
                    "speaker": "Okikuni",
                    "text": "Na verdade, isso se parece mais com uma coleção das minhas memórias pessoais..."
                },
                {
                    "id": "618410203",
                    "speaker": "Okikuni",
                    "text": "...Da raposa ao luar, do esqueleto gigante na natureza selvagem que tentou arrancar a lua para usar como olho..."
                },
                {
                    "id": "618410204",
                    "speaker": "Okikuni",
                    "text": "...Dos ventos de inverno, da longa jornada dos deuses..."
                }
            ]
        },
        {
            "talkId": "6184103",
            "initDialog": "618410301",
            "dialogues": [
                {
                    "id": "618410301",
                    "speaker": "Player",
                    "text": "O que você acha que é o elemento mais importante de uma história?"
                },
                {
                    "id": "618410302",
                    "speaker": "Okikuni",
                    "text": "O número de protagonistas nela."
                },
                {
                    "id": "618410303",
                    "speaker": "Okikuni",
                    "text": "O número de protagonistas nela."
                },
                {
                    "id": "618410304",
                    "speaker": "Player",
                    "text": "É tão importante que você disse duas vezes."
                },
                {
                    "id": "618410305",
                    "speaker": "Okikuni",
                    "text": "Se estamos falando de uma epopeia, ter quatro protagonistas seria pouco demais, mas 108 seria um pouco demais."
                },
                {
                    "id": "618410306",
                    "speaker": "Okikuni",
                    "text": "Na minha opinião, oito é o número perfeito."
                }
            ]
        },
        {
            "talkId": "6184104",
            "initDialog": "618410401",
            "dialogues": [
                {
                    "id": "618410401",
                    "speaker": "Player",
                    "text": "Adeus!"
                },
                {
                    "id": "618410402",
                    "speaker": "Okikuni",
                    "text": "Tchau!"
                }
            ]
        }
    ]
