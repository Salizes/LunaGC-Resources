    "talks": [
        {
            "talkId": "6956901",
            "initDialog": "695690101",
            "dialogues": [
                {
                    "id": "695690101",
                    "speaker": "Yunjin",
                    "text": "Nossa, esta taverna está tão animada que parece que fiz vários shows seguidos. Ah... se ao menos eu tivesse um pouco de chá para acalmar minha garganta."
                }
            ]
        },
        {
            "talkId": "6956902",
            "initDialog": "695690201",
            "dialogues": [
                {
                    "id": "695690201",
                    "speaker": "Player",
                    "text": "Que tal uma partida de Chamado Sagrado dos Sete?"
                }
            ]
        },
        {
            "talkId": "6956903",
            "initDialog": "695690301",
            "dialogues": [
                {
                    "id": "695690301",
                    "speaker": "Player",
                    "text": "No momento, preciso resolver outras coisas..."
                },
                {
                    "id": "695690302",
                    "speaker": "Yunjin",
                    "text": "Vou ficar e descansar um pouco mais. Vou voltar em breve."
                }
            ]
        },
        {
            "talkId": "6956904",
            "initDialog": "695690401",
            "dialogues": [
                {
                    "id": "695690401",
                    "speaker": "Yunjin",
                    "text": "Posso ter vencido desta vez, mas o destino pode mudar como a maré. Não há garantias de que vou vencer novamente na próxima vez."
                }
            ]
        },
        {
            "talkId": "6956905",
            "initDialog": "695690501",
            "dialogues": [
                {
                    "id": "695690501",
                    "speaker": "Yunjin",
                    "text": "Perdi esta vez, justamente... Sua maestria neste jogo é realmente impressionante!"
                }
            ]
        },
        {
            "talkId": "6956906",
            "initDialog": "695690601",
            "dialogues": [
                {
                    "id": "695690601",
                    "speaker": "Yunjin",
                    "text": "Por coincidência, estou livre para uma partida de treino."
                }
            ]
        },
        {
            "talkId": "6956908",
            "initDialog": "695690801",
            "dialogues": [
                {
                    "id": "695690801",
                    "speaker": "Player",
                    "text": "Que tal uma partida de Chamado Sagrado dos Sete?"
                }
            ]
        },
        {
            "talkId": "6956909",
            "initDialog": "695690901",
            "dialogues": [
                {
                    "id": "695690901",
                    "speaker": "Player",
                    "text": "Preciso ajustar meu deck primeiro..."
                }
            ]
        },
        {
            "talkId": "6956910",
            "initDialog": "695691001",
            "dialogues": [
                {
                    "id": "695691001",
                    "speaker": "Yunjin",
                    "text": "Mesmo sendo apenas um jogo de cartas, para mim parecia um impasse entre exércitos opostos. Foi uma partida excelente!"
                }
            ]
        },
        {
            "talkId": "6956911",
            "initDialog": "695691101",
            "dialogues": [
                {
                    "id": "695691101",
                    "speaker": "Yunjin",
                    "text": "Um passo em falso e o espetáculo acabou... Que descuido meu!"
                }
            ]
        },
        {
            "talkId": "6956912",
            "initDialog": "695691201",
            "dialogues": [
                {
                    "id": "695691201",
                    "speaker": "Yunjin",
                    "text": "Já que você estendeu o convite, como poderia recusar?"
                }
            ]
        },
        {
            "talkId": "6956914",
            "initDialog": "695691401",
            "dialogues": [
                {
                    "id": "695691401",
                    "speaker": "Player",
                    "text": "Que tal uma partida de Chamado Sagrado dos Sete?"
                }
            ]
        },
        {
            "talkId": "6956915",
            "initDialog": "695691501",
            "dialogues": [
                {
                    "id": "695691501",
                    "speaker": "Player",
                    "text": "Deixe-me ajustar o deck primeiro..."
                }
            ]
        },
        {
            "talkId": "6956916",
            "initDialog": "695691601",
            "dialogues": [
                {
                    "id": "695691601",
                    "speaker": "Yunjin",
                    "text": "Ufa... Essa foi por pouco."
                }
            ]
        },
        {
            "talkId": "6956917",
            "initDialog": "695691701",
            "dialogues": [
                {
                    "id": "695691701",
                    "speaker": "Yunjin",
                    "text": "Minha estratégia foi insuficiente, exatamente como eu temia... Estava destinada à derrota desta vez."
                }
            ]
        },
        {
            "talkId": "6956918",
            "initDialog": "695691801",
            "dialogues": [
                {
                    "id": "695691801",
