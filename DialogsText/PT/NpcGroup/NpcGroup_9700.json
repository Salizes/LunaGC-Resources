            "dialogues": [
                {
                    "id": "697000101",
                    "speaker": "Patton",
                    "text": "Ué? Você acha estranho eu estar aqui?"
                },
                {
                    "id": "697000102",
                    "speaker": "Patton",
                    "text": "Todo mundo precisa descansar de vez em quando... Mas e aí? Já que estamos aqui, que tal jogarmos uma partida de cartas?"
