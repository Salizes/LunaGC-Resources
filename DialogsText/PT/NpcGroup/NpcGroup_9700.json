        {
            "talkId": "6970002",
            "initDialog": "697000201",
            "dialogues": [
                {
                    "id": "697000201",
                    "speaker": "Player",
                    "text": "Vamos jogar \"Chamado Sagrado dos Sete\"!"
                }
            ]
        },
        {
            "talkId": "6970003",
            "initDialog": "697000301",
            "dialogues": [
                {
                    "id": "697000301",
                    "speaker": "Player",
                    "text": "No momento preciso resolver outras coisas..."
                },
                {
                    "id": "697000302",
                    "speaker": "Patton",
                    "text": "Certo, mas meu tempo é muito precioso... Se eu deixar o portão da taverna por muito tempo, serei descoberto."
