    "talks": [
        {
            "talkId": "6785401",
            "initDialog": "678540101",
            "dialogues": [
                {
                    "id": "678540101",
                    "speaker": "Obolensky",
                    "text": "Só estou suportando isso... Não há nada que não possamos superar!"
                }
            ]
        },
        {
            "talkId": "6785402",
            "initDialog": "678540201",
            "dialogues": [
                {
                    "id": "678540201",
                    "speaker": "Player",
                    "text": "Suportando?"
                },
                {
                    "id": "678540202",
                    "speaker": "Obolensky",
                    "text": "Isso mesmo! É assim que você vive até ver outro dia, e então outro, não é?"
                },
                {
                    "id": "678540203",
                    "speaker": "Obolensky",
                    "text": "Sou de uma pequena vila no meio do nada. Lá, o rio passa a maior parte do ano congelado, e raramente há comida suficiente."
                },
                {
                    "id": "678540204",
                    "speaker": "Obolensky",
                    "text": "Em um lugar como esse, tudo que uma pessoa pode fazer é continuar a esperar. No final, encontrei um jeito de vir para Sretomorozsk e ganhar minha vida aqui."
                },
                {
                    "id": "678540206",
                    "speaker": "Obolensky",
                    "text": "As coisas podem ser difíceis agora, mas ainda são melhores do que quando estávamos na vila. Então o que eu tenho para reclamar?"
                },
                {
                    "id": "678540207",
                    "speaker": "Obolensky",
                    "text": "Por isso eu vou só continuar suportando! A vida é assim. Só temos que persistir e aprender a trabalhar mais duro. Um dia, vamos ver a luz no final do túnel."
                }
            ]
        },
