        {
            "talkId": "6506901",
            "initDialog": "650690101",
            "dialogues": [
                {
                    "id": "650690101",
                    "speaker": "Crossa",
                    "text": "Isso foi um terremoto? Ou eu só estou enjoada...?"
                }
            ]
        },
        {
            "talkId": "6506902",
            "initDialog": "650690201",
            "dialogues": [
                {
                    "id": "650690201",
                    "speaker": "Player",
                    "text": "O que você vende aqui?"
                },
                {
                    "id": "650690202",
                    "speaker": "Crossa",
                    "text": "Pode escolher."
                }
            ]
        },
        {
            "talkId": "6506903",
            "initDialog": "650690301",
            "dialogues": [
                {
                    "id": "650690301",
                    "speaker": "Player",
                    "text": "Eu não sinto nada."
                },
                {
                    "id": "650690302",
                    "speaker": "Crossa",
                    "text": "*Suspiro* Deve ser minha velha doença se agitando então."
                },
                {
                    "id": "650690303",
                    "speaker": "Crossa",
                    "text": "Eu costumava ser uma marinheira, mas me machuquei em um acidente e desde então sinto como se meus arredores estivessem tremendo."
                },
                {
                    "id": "650690304",
                    "speaker": "Crossa",
                    "text": "Eu não posso voltar a ser uma marinheira, então eu só posso ajudar velhos amigos a vender coisas que recuperam debaixo d'água para ganhar a vida."
                }
            ]
        },
        {
            "talkId": "6506904",
            "initDialog": "650690401",
            "dialogues": [
                {
                    "id": "650690401",
                    "speaker": "Player",
                    "text": "Cuide-se."
                },
                {
                    "id": "650690402",
                    "speaker": "Crossa",
                    "text": "É... Acho que vou dar uma pausa agora."
                }
            ]
        }
    ]
}