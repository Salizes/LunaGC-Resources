{
    "groupId": "2136",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Pequena Luo": 10,
        "Player": 4
    },
    "talks": [
        {
            "talkId": "6213601",
            "initDialog": "621360101",
            "dialogues": [
                {
                    "id": "621360101",
                    "speaker": "Pequena Luo",
                    "text": "Ah, como eu gostaria de ver esse Adeptus novamente hoje, também. Mas ele não parece gostar de mim..."
                }
            ]
        },
        {
            "talkId": "6213602",
            "initDialog": "621360201",
            "dialogues": [
                {
                    "id": "621360201",
                    "speaker": "Player",
                    "text": "Um Adeptus?"
                },
                {
                    "id": "621360202",
                    "speaker": "Pequena Luo",
                    "text": "Um dia, quando eu estava na floresta, encontrei um belo e elegante Adeptus - foi como se ele tivesse saído de um livro de histórias!"
                },
                {
                    "id": "621360203",
                    "speaker": "Pequena Luo",
                    "text": "Eu sorri para ele, mas ele não sorriu de volta..."
                },
                {
                    "id": "621360204",
                    "speaker": "Pequena Luo",
                    "text": "Ele devolveu a boneca que foi roubada pelos Hilichurls... Você acha que ele gosta de mim?",
                    "choices": [
                        {
                            "id": "621360205",
                            "text": "Talvez?",
                            "response": [
                                {
                                    "id": "621360206",
                                    "speaker": "Pequena Luo",
                                    "text": "Isso... isso é triste..."
                                },
                                {
                                    "id": "621360207",
                                    "speaker": "Pequena Luo",
                                    "text": "Como é que ele pode gostar de mim, eu nunca tinha tanta tristeza..."
                                }
                            ]
                        },
                        {
                            "id": "621360208",
                            "text": "Eu diria que, na verdade, ele gosta de você.",
                            "response": [
                                {
                                    "id": "621360209",
                                    "speaker": "Pequena Luo",
                                    "text": "Sério?"
                                },
                                {
                                    "id": "621360210",
                                    "speaker": "Pequena Luo",
                                    "text": "...Pensei nisso também, será que ele só não gosta de sorrir?"
                                },
                                {
                                    "id": "621360211",
                                    "speaker": "Pequena Luo",
                                    "text": "Se eu o vir novamente, definitivamente encontrarei uma forma de fazê-lo sorrir."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6213603",
            "initDialog": "621360301",
            "dialogues": [
                {
                    "id": "621360301",
                    "speaker": "Player",
                    "text": "Vai com cuidado."
                },
                {
                    "id": "621360302",
                    "speaker": "Pequena Luo",
                    "text": "Ficarei bem! Se houver qualquer perigo, tenho certeza de que o Adeptus vira ao meu socorro."
                }
            ]
        }
    ]
}