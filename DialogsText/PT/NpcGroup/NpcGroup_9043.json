{
    "groupId": "9043",
    "total_dialogue_lines": 63,
    "speaker_counts": {
        "Player": 22,
        "Sucrose": 41
    },
    "talks": [
        {
            "talkId": "6904301",
            "initDialog": "690430101",
            "dialogues": [
                {
                    "id": "690430101",
                    "speaker": "Sucrose",
                    "text": "#Olá, {NICKNAME}."
                },
                {
                    "id": "690430102",
                    "speaker": "Sucrose",
                    "text": "Graças a sua ajuda, minha pesquisa está indo muito bem."
                }
            ]
        },
        {
            "talkId": "6904302",
            "initDialog": "690430201",
            "dialogues": [
                {
                    "id": "690430201",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>Você se acostumou com esse lugar?</color>"
                },
                {
                    "id": "690430202",
                    "speaker": "Sucrose",
                    "text": "Ah... Por favor, não se preocupe comigo."
                },
                {
                    "id": "690430203",
                    "speaker": "Sucrose",
                    "text": "Para mim, desde que eu possua um laboratório independente, estou satisfeita."
                },
                {
                    "id": "690430204",
                    "speaker": "Sucrose",
                    "text": "Aqui tem muito mais do que o que preciso.",
                    "choices": [
                        {
                            "id": "690430205",
                            "text": "Não precisa ficar desconfortada.",
                            "response": [
                                {
                                    "id": "690430207",
                                    "speaker": "Sucrose",
                                    "text": "Hã... Bem..."
                                },
                                {
                                    "id": "690430208",
                                    "speaker": "Sucrose",
                                    "text": "Se eu ficar incomodando desse jeito, ficarei envergonhada."
                                },
                                {
                                    "id": "690430209",
                                    "speaker": "Sucrose",
                                    "text": "Mas, eu levarei em consideração suas boas intenções."
                                }
                            ]
                        },
                        {
                            "id": "690430206",
                            "text": "Se precisar de algum equipamento, é só me dizer."
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6904303",
            "initDialog": "690430301",
            "dialogues": [
                {
                    "id": "690430301",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>Você quer conversar comigo?</color>"
                },
                {
                    "id": "690430302",
                    "speaker": "Sucrose",
                    "text": "Uh, eu só... Só não sou muito boa em conversar."
                },
                {
                    "id": "690430303",
                    "speaker": "Sucrose",
                    "text": "Na maior parte do tempo, estou sozinha no laboratório conduzindo alguma pesquisa, e elas tomam sempre algumas horas para serem feitas."
                },
                {
                    "id": "690430304",
                    "speaker": "Sucrose",
                    "text": "Se eu encontrar algum problema que pare minha pesquisa, posso ficar dias trabalhando nela."
                },
                {
                    "id": "690430305",
                    "speaker": "Sucrose",
                    "text": "Não entendo bem sobre o que está acontecendo lá fora, ou sobre o que todos estão falando de interessante..."
                },
                {
                    "id": "690430306",
                    "speaker": "Sucrose",
                    "text": "Além disso... Mesmo que eu tenha um dia de descanso, eu não gosto muito de sair para socializar.",
                    "choices": [
                        {
                            "id": "690430307",
                            "text": "#E se nós sairmos junt{F#as}{M#os}?",
                            "response": [
                                {
                                    "id": "690430309",
                                    "speaker": "Sucrose",
                                    "text": "Uh... Eu e você..."
                                },
                                {
                                    "id": "690430310",
                                    "speaker": "Sucrose",
                                    "text": "Não... Eu não saberia sobre o que é apropriado falar...",
                                    "choices": [
                                        {
                                            "id": "690430311",
                                            "text": "Fale o que você pensou.",
                                            "response": [
                                                {
                                                    "id": "690430313",
                                                    "speaker": "Sucrose",
                                                    "text": "Hmm..."
                                                },
                                                {
                                                    "id": "690430314",
                                                    "speaker": "Sucrose",
                                                    "text": "Ouvir isso me deixa muito aliviada."
                                                },
                                                {
                                                    "id": "690430315",
                                                    "speaker": "Sucrose",
                                                    "text": "Eu posso... Tentar."
                                                }
                                            ]
                                        },
                                        {
                                            "id": "690430312",
                                            "text": "Mesmo que você não saiba sobre o que falar, não precisa ter vergonha."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "690430308",
                            "text": "#E se nós conversarmos junt{F#as}{M#os}?"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6904304",
            "initDialog": "690430401",
            "dialogues": [
                {
                    "id": "690430401",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>O que você gostaria de fazer?</color>"
                },
                {
                    "id": "690430402",
                    "speaker": "Sucrose",
                    "text": "Ah, é assim então...? Eu tenho algumas perguntas simples para lhe fazer."
                },
                {
                    "id": "690430403",
                    "speaker": "Sucrose",
                    "text": "Você só precisa me dizer sua primeira opção, não há resposta errada."
                },
                {
                    "id": "690430404",
                    "speaker": "Sucrose",
                    "text": "Lâmpada de Grama ou Margaridas Voadoras?",
                    "choices": [
                        {
                            "id": "690430405",
                            "text": "Lâmpada de Grama.",
                            "response": [
                                {
                                    "id": "690430407",
                                    "speaker": "Sucrose",
                                    "text": "Anemogrãos ou Borboletas de Cristal?",
                                    "choices": [
                                        {
                                            "id": "690430408",
                                            "text": "Anemogrão.",
                                            "response": [
                                                {
                                                    "id": "690430410",
                                                    "speaker": "Sucrose",
                                                    "text": "Mar de Nuvens ou Campos de Flores?",
                                                    "choices": [
                                                        {
                                                            "id": "690430411",
                                                            "text": "Mar de Nuvens.",
                                                            "response": [
                                                                {
                                                                    "id": "690430413",
                                                                    "speaker": "Sucrose",
                                                                    "text": "Está bem, anotei."
                                                                },
                                                                {
                                                                    "id": "690430414",
                                                                    "speaker": "Sucrose",
                                                                    "text": "Antes, eu não sabia como expressar meus sentimentos."
                                                                },
                                                                {
                                                                    "id": "690430415",
                                                                    "speaker": "Sucrose",
                                                                    "text": "Eu queria lhe convidar para irmos ao meu paraíso... Mas eu ainda não tenho a capacidade de criá-lo."
                                                                },
                                                                {
                                                                    "id": "690430416",
                                                                    "speaker": "Sucrose",
                                                                    "text": "Por isso, por enquanto eu só posso pegar suas escolhas e colocar nessa bola de cristal."
                                                                },
                                                                {
                                                                    "id": "690430417",
                                                                    "speaker": "Sucrose",
                                                                    "text": "Até que um dia irei tirá-las para colocar no meu paraíso.",
                                                                    "choices": [
                                                                        {
                                                                            "id": "690430418",
                                                                            "text": "Fechado!",
                                                                            "response": [
                                                                                {
                                                                                    "id": "690430419",
                                                                                    "speaker": "Sucrose",
                                                                                    "text": "Hmm... Fechado."
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "690430420",
                                                                            "text": "Você também deve colocar as coisas que você gosta, Sucrose.",
                                                                            "response": [
                                                                                {
                                                                                    "id": "690430421",
                                                                                    "speaker": "Sucrose",
                                                                                    "text": "Sim... Eu me esforçarei!"
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "690430412",
                                                            "text": "Campos de Flores."
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "690430409",
                                            "text": "Borboletas de Cristal."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "690430406",
                            "text": "Margaridas Voadoras."
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6904305",
            "initDialog": "690430501",
            "dialogues": [
                {
                    "id": "690430501",
                    "speaker": "Player",
                    "text": "Bom dia, Sucrose."
                },
                {
                    "id": "690430502",
                    "speaker": "Sucrose",
                    "text": "#Oh, {NICKNAME}, bom dia!"
                },
                {
                    "id": "690430503",
                    "speaker": "Sucrose",
                    "text": "Uh... Tenha cuidado!"
                }
            ]
        },
        {
            "talkId": "6904306",
            "initDialog": "690430601",
            "dialogues": [
                {
                    "id": "690430601",
                    "speaker": "Player",
                    "text": "Boa noite, Sucrose."
                },
                {
                    "id": "690430602",
                    "speaker": "Sucrose",
                    "text": "#Uh, boa noite, {NICKNAME}."
                },
                {
                    "id": "690430603",
                    "speaker": "Sucrose",
                    "text": "Depois de meus experimentos, esse segundo tipo de Lótus de Leite deve ajudar a melhorar a qualidade do sono."
                },
                {
                    "id": "690430604",
                    "speaker": "Sucrose",
                    "text": "Eu a transformei em uma bolsa de flores secas. Se precisar, pode colocar no lado do travesseiro."
                }
            ]
        },
        {
            "talkId": "6904307",
            "initDialog": "690430701",
            "dialogues": [
                {
                    "id": "690430701",
                    "speaker": "Player",
                    "text": "Quer conversar comigo?"
                }
            ]
        },
        {
            "talkId": "6904308",
            "initDialog": "690430801",
            "dialogues": [
                {
                    "id": "690430801",
                    "speaker": "Player",
                    "text": "Gostaria de fazer alguma coisa?"
                }
            ]
        },
        {
            "talkId": "6904309",
            "initDialog": "690430901",
            "dialogues": [
                {
                    "id": "690430901",
                    "speaker": "Player",
                    "text": "Você já se acostumou com esse lugar?"
                }
            ]
        },
        {
            "talkId": "6904350",
            "initDialog": "690435001",
            "dialogues": [
                {
                    "id": "690435001",
                    "speaker": "Sucrose",
                    "text": "Uma oficina de alquimia bem equipada e bem arrumada?"
                },
                {
                    "id": "690435002",
                    "speaker": "Sucrose",
                    "text": "Mesmo se eu ficar por aqui realizando meus experimentos e fracassar, eles não afetarão as outras amostras que estão dentro do armário..."
                },
                {
                    "id": "690435003",
                    "speaker": "Sucrose",
                    "text": "Hã? Quando você chegou? Eu... Eu quero dizer que estou impaciente querendo fazer meus experimentos... Pode ser?"
                }
            ]
        },
        {
            "talkId": "6904351",
            "initDialog": "690435101",
            "dialogues": [
                {
                    "id": "690435101",
                    "speaker": "Sucrose",
                    "text": "Não importa de qual ângulo você veja, esse acampamento não tem pontos fracos. É só uma pena que não tenha ossos disponíveis..."
                },
                {
                    "id": "690435102",
                    "speaker": "Sucrose",
                    "text": "Se eu pudesse reformar esse lugar mais um pouco, talvez eu pudesse realizar pesquisas ainda mais valiosas..."
                },
                {
                    "id": "690435103",
                    "speaker": "Sucrose",
                    "text": "#Você está interessad{F#a}{M#o}? Pode... Me ajudar?"
                }
            ]
        }
    ]
}