            "dialogues": [
                {
                    "id": "622690101",
                    "speaker": "Xuanji",
                    "text": "Vocês já provaram o chá especial da casa. Se não tem mais nada para fazer, voltem para casa logo. Esta área é perigosa."
                },
                {
                    "id": "622690103",
                    "speaker": "Player",
                    "text": "Você tem novos chás?"
                },
                {
                    "id": "622690104",
                    "speaker": "Xuanji",
                    "text": "Haha, já estamos trabalhando nisso. Nos dê um pouco de tempo."
                },
                {
                    "id": "622690105",
                    "speaker": "Player",
                    "text": "O que você faz no final das contas?"
                },
                {
                    "id": "622690106",
                    "speaker": "Xuanji",
                    "text": "O que você quer dizer com isso? Tenho minha loja de chá aqui, além de vender chá, o que mais eu deveria fazer?"
                },
                {
                    "id": "622690107",
                    "speaker": "Player",
                    "text": "Até mais."
                },
                {
                    "id": "622690108",
                    "speaker": "Xuanji",
                    "text": "Vai pela sombra!"
                }
            ]
        }
    ]
}