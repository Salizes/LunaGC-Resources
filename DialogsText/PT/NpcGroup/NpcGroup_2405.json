    "talks": [
        {
            "talkId": "6240501",
            "initDialog": "624050101",
            "dialogues": [
                {
                    "id": "624050101",
                    "speaker": "Jianqiu",
                    "text": "Olá, como vão as coisas?"
                }
            ]
        },
        {
            "talkId": "6240502",
            "initDialog": "624050201",
            "dialogues": [
                {
                    "id": "624050201",
                    "speaker": "Player",
                    "text": "Você está viajando?"
                },
                {
                    "id": "624050202",
                    "speaker": "Jianqiu",
                    "text": "Vou com esta jovem em uma viagem única na vida."
                }
            ]
        },
        {
            "talkId": "6240503",
            "initDialog": "624050301",
            "dialogues": [
                {
                    "id": "624050301",
                    "speaker": "Player",
                    "text": "Quem é você?"
                },
                {
                    "id": "624050302",
                    "speaker": "Jianqiu",
                    "text": "Eu ensinei Aritmética no Penhasco de Chichu por alguns anos, onde os estudantes eram todos de famílias pobres."
                },
                {
                    "id": "624050303",
                    "speaker": "Jianqiu",
                    "text": "Agora eu trabalho no Banco Minghua como um Auxiliar de Lojista."
                },
                {
                    "id": "624050304",
                    "speaker": "Jianqiu",
                    "text": "Estou acompanhando essa jovem dama em suas viagens para cuidar da sua segurança."
                },
                {
                    "id": "624050305",
                    "speaker": "Player",
                    "text": "Aonde você está indo?"
                },
                {
                    "id": "624050306",
                    "speaker": "Jianqiu",
                    "text": "Não sei, talvez Celestia..."
                },
                {
                    "id": "624050307",
                    "speaker": "Jianqiu",
                    "text": "Hehe, brincadeira. Eu não deveria deixar as pessoas saberem para onde estamos indo. Me desculpe, por isso."
                }
            ]
        },
        {
            "talkId": "6240504",
            "initDialog": "624050401",
            "dialogues": [
                {
                    "id": "624050401",
                    "speaker": "Player",
                    "text": "Boa viagem."
                },
                {
                    "id": "624050402",
                    "speaker": "Jianqiu",
                    "text": "Com sorte, assim será! Obrigado, você também!"
                }
            ]
        }
    ]
}