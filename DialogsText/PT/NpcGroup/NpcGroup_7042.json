    "talks": [
        {
            "talkId": "6704201",
            "initDialog": "670420101",
            "dialogues": [
                {
                    "id": "670420101",
                    "speaker": "Pechna",
                    "text": "Já li esse livro antes? Não consigo me lembrar."
                }
            ]
        },
        {
            "talkId": "6704202",
            "initDialog": "670420201",
            "dialogues": [
                {
                    "id": "670420201",
                    "speaker": "Player",
                    "text": "O que você está lendo?"
                },
                {
                    "id": "670420202",
                    "speaker": "Pechna",
                    "text": "Hã, livros? Não consigo ler os difíceis, por isso estou só escolhendo livros interessantes com histórias divertidas."
                },
                {
                    "id": "670420203",
                    "speaker": "Pechna",
                    "text": "Mas acho que já li quase todos os livros novos. Estou pensando em ler uns mais antigos."
                }
            ]
        },
        {
            "talkId": "6704203",
            "initDialog": "670420301",
            "dialogues": [
                {
                    "id": "670420301",
                    "speaker": "Player",
                    "text": "Desculpe pelo incômodo."
                },
                {
                    "id": "670420302",
                    "speaker": "Pechna",
                    "text": "Hã? Ah, tudo bem."
                }
            ]
        },
        {
            "talkId": "6704204",
            "initDialog": "670420401",
            "dialogues": [
                {
                    "id": "670420401",
                    "speaker": "Player",
                    "text": "Você tem alguma recomendação?"
                },
                {
                    "id": "670420402",
                    "speaker": "Pechna",
                    "text": "Recomendação? Hmm, não. Eu não sei definir o que é bom ou ruim, ou sobre o que são as tramas. Tô aqui só matando tomando e folheando uns livros quaisquer."
                },
                {
                    "id": "670420403",
                    "speaker": "Pechna",
                    "text": "Mas, se eu tivesse que escolher um... eu iria no \"As Lendas de Reed Miller, o Ladrão Extraordinário\". O lojista diz que é o livro mais popular."
                },
                {
                    "id": "670420404",
                    "speaker": "Pechna",
                    "text": "Como é popular, provavelmente não é o pior, por isso provavelmente vale a pena uma olhada."
                }
            ]
        },
        {
            "talkId": "6704205",
            "initDialog": "670420501",
            "dialogues": [
                {
                    "id": "670420501",
                    "speaker": "Pechna",
                    "text": "Desafio de Aventura"
                }
            ]
        },
        {
            "talkId": "6704206",
            "initDialog": "670420601",
            "dialogues": [
                {
                    "id": "670420601",
                    "speaker": "Pechna",
                    "text": "Hm, eu ganhei? Ah, obrigada."
                }
            ]
        },
        {
            "talkId": "6704207",
            "initDialog": "670420701",
            "dialogues": [
                {
                    "id": "670420701",
                    "speaker": "Pechna",
                    "text": "Eu perdi. Parece que você realmente não pode levar as tramas dos livros tão a sério..."
                }
            ]
        }
    ]
}