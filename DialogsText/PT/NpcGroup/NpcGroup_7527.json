        {
            "talkId": "6752704",
            "initDialog": "675270401",
            "dialogues": [
                {
                    "id": "675270401",
                    "speaker": "Player",
                    "text": "Você garante que essa bebida que você vende vem mesmo dos feéricos?"
                },
                {
                    "id": "675270402",
                    "speaker": "Savva",
                    "text": "Mas é claro! É genuína, da boa, feita pelos feéricos de Novokitezhgrad. Nem dê muita bola para esse preço, estou dizendo. Isso aqui é praticamente de graça."
                },
                {
                    "id": "675270403",
                    "speaker": "Savva",
                    "text": "Veja bem, se estivéssemos na época do Czar Belyi, só os aristocratas teriam a chance de provar uma bebida tão boa."
                },
                {
                    "id": "675270404",
                    "speaker": "Savva",
                    "text": "Mas hoje em dia, desde que você tenha Mora suficiente no bolso, pode se divertir muito com uma garrafa dessas."
                }
            ]
        },
        {
            "talkId": "6752705",
            "initDialog": "675270501",
            "dialogues": [
                {
                    "id": "675270501",
                    "speaker": "Player",
                    "text": "Adeus."
                },
                {
                    "id": "675270502",
                    "speaker": "Savva",
                    "text": "Até mais. Volte sempre que precisar esquentar os ossos."
                }
            ]
        }
    ]
