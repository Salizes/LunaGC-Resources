    "talks": [
        {
            "talkId": "6244501",
            "initDialog": "624450101",
            "dialogues": [
                {
                    "id": "624450101",
                    "speaker": "Luo Feng",
                    "text": "#É uma honra conhecê-l{M#o}{F#a}. Posso perguntar o seu nome?"
                }
            ]
        },
        {
            "talkId": "6244502",
            "initDialog": "624450201",
            "dialogues": [
                {
                    "id": "624450201",
                    "speaker": "Player",
                    "text": "#Sou apenas {M#um}{F#uma} viajante comum."
                },
                {
                    "id": "624450202",
                    "speaker": "Luo Feng",
                    "text": "#Não seja tão modest{M#o}{F#a}!"
                },
                {
                    "id": "624450203",
                    "speaker": "Luo Feng",
                    "text": "Você pode parecer jovem, mas você tem um futuro brilhante, com certeza."
                },
                {
                    "id": "624450204",
                    "speaker": "Luo Feng",
                    "text": "Meu nome é Luo Feng, um comerciante. Se você precisar de mim no futuro, por favor, não hesite em perguntar."
                },
                {
                    "id": "624450205",
                    "speaker": "Luo Feng",
                    "text": "Claro, uma boa ação merece outra - se eu precisar de sua ajuda, por favor, venha em meu auxílio então!"
                }
            ]
        },
        {
            "talkId": "6244503",
            "initDialog": "624450301",
            "dialogues": [
                {
                    "id": "624450301",
                    "speaker": "Player",
                    "text": "O que você está fazendo?"
                },
                {
                    "id": "624450302",
                    "speaker": "Luo Feng",
                    "text": "Relações interpessoais, claro!"
                },
                {
                    "id": "624450303",
                    "speaker": "Luo Feng",
                    "text": "Mas nem todos repararam, o mais valioso no Barco da Pérola é os clientes mesmo."
                },
                {
                    "id": "624450304",
                    "speaker": "Luo Feng",
                    "text": "Todos presentes de hoje são celebridades de influência! Se conseguir estabelecer relação com um ou dois deles, essa viagem valeria totalmente a pena..."
                },
                {
                    "id": "624450305",
                    "speaker": "Luo Feng",
                    "text": "Hehe, falamos mais tarde! Eu tenho que aproveitar para conhecer mais pessoas."
                }
            ]
        },
        {
            "talkId": "6244504",
            "initDialog": "624450401",
            "dialogues": [
                {
                    "id": "624450401",
                    "speaker": "Player",
                    "text": "Adeus."
                },
                {
                    "id": "624450402",
                    "speaker": "Luo Feng",
                    "text": "Muito prazer!"
                }
            ]
        }
    ]
}