                {
                    "id": "641210101",
                    "speaker": "Berat",
                    "text": "O mar pode mudar sob nossa vigia."
                }
            ]
        },
        {
            "talkId": "6412102",
            "initDialog": "641210201",
            "dialogues": [
                {
                    "id": "641210201",
                    "speaker": "Player",
                    "text": "Olá?"
                },
                {
                    "id": "641210202",
                    "speaker": "Berat",
                    "text": "Escuta, é melhor não olhar para o oceano o tempo todo."
                },
                {
                    "id": "641210203",
                    "speaker": "Berat",
                    "text": "Caso contrário, você ficará sempre sentado o observando e não irá fazer mais nada."
                },
                {
                    "id": "641210204",
                    "speaker": "Berat",
                    "text": "Até o céu e o mar finalmente ficarem vermelhos, até que todas as coisas se pereçam e você se vá..."
                }
            ]
        },
        {
            "talkId": "6412103",
            "initDialog": "641210301",
            "dialogues": [
                {
                    "id": "641210301",
                    "speaker": "Player",
                    "text": "Adeus."
                },
                {
                    "id": "641210302",
                    "speaker": "Berat",
                    "text": "Ah! Lembre-se do meu conselho."
                }
            ]
        },
        {
            "talkId": "6412104",
            "initDialog": "641210401",
            "dialogues": [
                {
                    "id": "641210401",
                    "speaker": "Player",
                    "text": "Se for a água do mar roxa..."
                },
                {
                    "id": "641210402",
                    "speaker": "Berat",
                    "text": "Uau! Você já viu o mar roxo?"
                },
                {
                    "id": "641210403",
                    "speaker": "Berat",
                    "text": "Deve haver olhos mais astutos vigiando também!"
                },
                {
                    "id": "641210404",
                    "speaker": "Berat",
                    "text": "Em suma, escute o meu aviso..."
                },
                {
                    "id": "641210405",
                    "speaker": "Berat",
                    "text": "Não olhe para o mar o tempo todo."
                }
            ]
        }
    ]
