{
    "groupId": "9052",
    "total_dialogue_lines": 71,
    "speaker_counts": {
        "Ei": 42,
        "Player": 21,
        "Shogun Raiden": 8
    },
    "talks": [
        {
            "talkId": "6905201",
            "initDialog": "690520101",
            "dialogues": [
                {
                    "id": "690520101",
                    "speaker": "Shogun Raiden",
                    "text": "..."
                },
                {
                    "id": "690520102",
                    "speaker": "Shogun Raiden",
                    "text": "Visto que minha forma física está aqui neste reino, suponho que não há nenhum mal em ver como você utilizou este espaço infinitesimal."
                }
            ]
        },
        {
            "talkId": "6905202",
            "initDialog": "690520201",
            "dialogues": [
                {
                    "id": "690520201",
                    "speaker": "Ei",
                    "text": "#Oh, {NICKNAME}, é você."
                },
                {
                    "id": "690520202",
                    "speaker": "Ei",
                    "text": "Será que você veio apenas me ver?"
                }
            ]
        },
        {
            "talkId": "6905203",
            "initDialog": "690520301",
            "dialogues": [
                {
                    "id": "690520301",
                    "speaker": "Player",
                    "text": "Você está gostando desse lugar?"
                },
                {
                    "id": "690520302",
                    "speaker": "Ei",
                    "text": "É muito mais animado que o Plano da Eutimia que estou acostumada."
                },
                {
                    "id": "690520303",
                    "speaker": "Player",
                    "text": "Será difícil para você se acostumar com esse lugar?"
                },
                {
                    "id": "690520304",
                    "speaker": "Ei",
                    "text": "Não, não se preocupe."
                },
                {
                    "id": "690520305",
                    "speaker": "Ei",
                    "text": "Clamor e comoção são algo estritamente externo, meu eu interior continuará tranquilo como sempre.",
                    "choices": [
                        {
                            "id": "690520306",
                            "text": "Ótimo, isso é bom.",
                            "response": [
                                {
                                    "id": "690520307",
                                    "speaker": "Ei",
                                    "text": "Obrigada por sua preocupação."
                                },
                                {
                                    "id": "690520310",
                                    "speaker": "Ei",
                                    "text": "..."
                                },
                                {
                                    "id": "690520311",
                                    "speaker": "Ei",
                                    "text": "Você ficará aqui por mais um tempo?"
                                },
                                {
                                    "id": "690520312",
                                    "speaker": "Ei",
                                    "text": "Com você ao meu lado, apesar de nossas bocas permanecerem em silêncio, meu coração está em paz."
                                },
                                {
                                    "id": "690520313",
                                    "speaker": "Ei",
                                    "text": "Sua companhia... Isso é uma mudança que não contestarei."
                                }
                            ]
                        },
                        {
                            "id": "690520308",
                            "text": "Que tal tentarmos animar mais um pouco?",
                            "response": [
                                {
                                    "id": "690520309",
                                    "speaker": "Ei",
                                    "text": "Tais atividades estão em contraste direto com a noção de Eternidade. Temo que eu terei que pensar mais nela."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6905204",
            "initDialog": "690520401",
            "dialogues": [
                {
                    "id": "690520401",
                    "speaker": "Player",
                    "text": "Quer conversar comigo?"
                },
                {
                    "id": "690520402",
                    "speaker": "Ei",
                    "text": "Tudo bem, também tenho algo que gostaria de lhe perguntar."
                },
                {
                    "id": "690520403",
                    "speaker": "Player",
                    "text": "Qual o problema?"
                },
                {
                    "id": "690520404",
                    "speaker": "Ei",
                    "text": "Quero saber como você fez aquela sobremesa doce ser tão gostosa?"
                },
                {
                    "id": "690520405",
                    "speaker": "Ei",
                    "text": "*Cof* *Cof*... Bem, ela era bem ao meu gosto.",
                    "choices": [
                        {
                            "id": "690520406",
                            "text": "O mais importante é ter paciência.",
                            "response": [
                                {
                                    "id": "690520407",
                                    "speaker": "Ei",
                                    "text": "Entendo... Apesar de suas tentativas falharem, você não desistirá de outras no futuro por causa de um fracasso temporário."
                                },
                                {
                                    "id": "690520408",
                                    "speaker": "Ei",
                                    "text": "Ao fazer ajustes ao longo do caminho, você reúne o que aprendeu, bem como sua experiência acumulada."
                                },
                                {
                                    "id": "690520409",
                                    "speaker": "Ei",
                                    "text": "... É esse o significado?"
                                },
                                {
                                    "id": "690520415",
                                    "speaker": "Player",
                                    "text": "Exatamente."
                                },
                                {
                                    "id": "690520416",
                                    "speaker": "Ei",
                                    "text": "... Eu lembrarei disso."
                                },
                                {
                                    "id": "690520417",
                                    "speaker": "Ei",
                                    "text": "Agora que me beneficiei de sua experiência, tentarei seguir suas experiências na próxima vez que estar realizando otimizações na Shogun.",
                                    "choices": [
                                        {
                                            "id": "690520418",
                                            "text": "Então se trata disso...",
                                            "response": [
                                                {
                                                    "id": "690520420",
                                                    "speaker": "Ei",
                                                    "text": "Hã? Eu já não mencionei que não posso fazer comida?"
                                                },
                                                {
                                                    "id": "690520421",
                                                    "speaker": "Ei",
                                                    "text": "Mas, o conselho que você me deu também lhe beneficiará..."
                                                },
                                                {
                                                    "id": "690520422",
                                                    "speaker": "Ei",
                                                    "text": "Com uma Shogun mais poderosa, eu serei capaz de proteger você de uma miríade de perigos ainda mais eficazmente."
                                                }
                                            ]
                                        },
                                        {
                                            "id": "690520419",
                                            "text": "Eu tenho uma sensação que o que você quer aprender não é como fazer essas sobremesas..."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "690520410",
                            "text": "O mais importante é o desejo.",
                            "response": [
                                {
                                    "id": "690520411",
                                    "speaker": "Ei",
                                    "text": "Desejo?"
                                },
                                {
                                    "id": "690520412",
                                    "speaker": "Ei",
                                    "text": "Não imaginei que fosse possível deixar uma sobremesa ainda mais gostosa... Isso também pode ser um tipo de desejo."
                                },
                                {
                                    "id": "690520413",
                                    "speaker": "Ei",
                                    "text": "Hã, não.. Agora que pensei direito, não deve ser assim tão simples."
                                },
                                {
                                    "id": "690520414",
                                    "speaker": "Ei",
                                    "text": "Talvez \"esperança\" signifique o desejo de satisfazer quem come."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6905205",
            "initDialog": "690520501",
            "dialogues": [
                {
                    "id": "690520501",
                    "speaker": "Player",
                    "text": "Gostaria de fazer alguma coisa?"
                },
                {
                    "id": "690520502",
                    "speaker": "Ei",
                    "text": "Sim. Desembainhe sua espada.",
                    "choices": [
                        {
                            "id": "690520503",
                            "text": "Espere, agora?",
                            "response": [
                                {
                                    "id": "690520505",
                                    "speaker": "Ei",
                                    "text": "Hmph. Então retorne quando sua preparação estiver completa. Eu tenho tempo."
                                },
                                {
                                    "id": "690520506",
                                    "speaker": "Ei",
                                    "text": "Eu usarei minha lâmina para confirmar se você é está fora de prática ou não."
                                },
                                {
                                    "id": "690520507",
                                    "speaker": "Player",
                                    "text": "Espere, você está falando sério?"
                                },
                                {
                                    "id": "690520508",
                                    "speaker": "Ei",
                                    "text": "Claro que sim."
                                },
                                {
                                    "id": "690520509",
                                    "speaker": "Ei",
                                    "text": "O momento em que as lâminas se cruzam em batalha é também uma forma de Eternidade. Usarei isso como o momento para sentir seu ser interior."
                                },
                                {
                                    "id": "690520510",
                                    "speaker": "Ei",
                                    "text": "Um método simples e direto, mas mais claro que qualquer língua poderia expressar. Até mesmo permite que eu verifique minha própria existência.",
                                    "choices": [
                                        {
                                            "id": "690520511",
                                            "text": "Algo parece um pouco estranho...",
                                            "response": [
                                                {
                                                    "id": "690520513",
                                                    "speaker": "Ei",
                                                    "text": "Hã? Você foi capaz de ver pelo meu disfarce? Pensei que ele era preciso o suficiente."
                                                },
                                                {
                                                    "id": "690520514",
                                                    "speaker": "Ei",
                                                    "text": "Não importa. Serei honesta com você. Desejo lutar com você."
                                                },
                                                {
                                                    "id": "690520515",
                                                    "speaker": "Ei",
                                                    "text": "Afinal de contas, poucos foram capazes de suportar minha lâmina. Seria um prazer treinar com você."
                                                },
                                                {
                                                    "id": "690520516",
                                                    "speaker": "Ei",
                                                    "text": "Entretanto, temo que você ficaria relutante de lutar contra mim, por isso usei a identidade da Shogun.",
                                                    "choices": [
                                                        {
                                                            "id": "690520517",
                                                            "text": "Não precisa me enganar para isso...",
                                                            "response": [
                                                                {
                                                                    "id": "690520519",
                                                                    "speaker": "Ei",
                                                                    "text": "Ah, você não recusou. Então posso assumir que você aceitou?"
                                                                },
                                                                {
                                                                    "id": "690520520",
                                                                    "speaker": "Ei",
                                                                    "text": "Haha, prepare-se. Não serei fácil."
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "690520518",
                                                            "text": "Que pedido estranho..."
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "690520512",
                                            "text": "Ei? É você?"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "690520504",
                            "text": "#Eu não estou preparad{F#a}{M#o} mentalmente para isso..."
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6905206",
            "initDialog": "690520601",
            "dialogues": [
                {
                    "id": "690520601",
                    "speaker": "Player",
                    "text": "Bom dia, Ei."
                },
                {
                    "id": "690520602",
                    "speaker": "Ei",
                    "text": "#Bom dia, {NICKNAME}."
                },
                {
                    "id": "690520603",
                    "speaker": "Ei",
                    "text": "Até uma interação trivial como essa me enche de motivação. Incrível..."
                }
            ]
        },
        {
            "talkId": "6905207",
            "initDialog": "690520701",
            "dialogues": [
                {
                    "id": "690520701",
                    "speaker": "Player",
                    "text": "Boa noite, Ei."
                },
                {
                    "id": "690520702",
                    "speaker": "Ei",
                    "text": "Oh, a noite já chegou? Seria melhor se você fosse descansar."
                },
                {
                    "id": "690520703",
                    "speaker": "Ei",
                    "text": "#Boa noite, {NICKNAME}. Que seus sonhos sejam calmos e pacíficos."
                }
            ]
        },
        {
            "talkId": "6905211",
            "initDialog": "690521101",
            "dialogues": [
                {
                    "id": "690521101",
                    "speaker": "Shogun Raiden",
                    "text": "Esse santuário é um pouco familiar."
                },
                {
                    "id": "690521102",
                    "speaker": "Shogun Raiden",
                    "text": "É isso que significa... reminiscência?"
                },
                {
                    "id": "690521103",
                    "speaker": "Shogun Raiden",
                    "text": "Não importa. Essa sensação não é ruim."
                }
            ]
        },
        {
            "talkId": "6905212",
            "initDialog": "690521201",
            "dialogues": [
                {
                    "id": "690521201",
                    "speaker": "Shogun Raiden",
                    "text": "Um dojo?"
                },
                {
                    "id": "690521202",
                    "speaker": "Shogun Raiden",
                    "text": "Você está treinando artes marciais? Creio que a Musou no Hitotachi aumentou sua determinação."
                },
                {
                    "id": "690521203",
                    "speaker": "Shogun Raiden",
                    "text": "Aqueles que perseguem a perfeição devem ser elogiados."
                }
            ]
        }
    ]
}