{
    "groupId": "6213",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Matla": 13,
        "Player": 3
    },
    "talks": [
        {
            "talkId": "6621301",
            "initDialog": "662130101",
            "dialogues": [
                {
                    "id": "662130101",
                    "speaker": "Matla",
                    "text": "Desculpa, mas preciso limpar alguns... detritos mentais antes de ir à clínica."
                }
            ]
        },
        {
            "talkId": "6621302",
            "initDialog": "662130201",
            "dialogues": [
                {
                    "id": "662130201",
                    "speaker": "Player",
                    "text": "Detritos mentais?"
                },
                {
                    "id": "662130202",
                    "speaker": "Matla",
                    "text": "Hmm, muito direto? Que tal \"peso mental\"? Seria mais fácil de entender?"
                },
                {
                    "id": "662130203",
                    "speaker": "Matla",
                    "text": "Muitas pessoas adquirem maior autoconsciência ou conhecimento profundo através da meditação."
                },
                {
                    "id": "662130204",
                    "speaker": "Matla",
                    "text": "Eu não preciso de efeitos tão poderosos. Tudo o que necessito é paz interior."
                }
            ]
        },
        {
            "talkId": "6621303",
            "initDialog": "662130301",
            "dialogues": [
                {
                    "id": "662130301",
                    "speaker": "Player",
                    "text": "Te desejo sorte."
                },
                {
                    "id": "662130302",
                    "speaker": "Matla",
                    "text": "Meus agradecimentos."
                }
            ]
        },
        {
            "talkId": "6621304",
            "initDialog": "662130401",
            "dialogues": [
                {
                    "id": "662130401",
                    "speaker": "Player",
                    "text": "Tem algo te incomodando?"
                },
                {
                    "id": "662130402",
                    "speaker": "Matla",
                    "text": "Saiba que, às vezes, ajudar outros com seus tratamentos não é diferente de entrar em suas vidas."
                },
                {
                    "id": "662130403",
                    "speaker": "Matla",
                    "text": "Especialmente para aqueles que têm doenças crônicas, como as pessoas que sofreram corrosão do Abismo."
                },
                {
                    "id": "662130404",
                    "speaker": "Matla",
                    "text": "Compilo relatórios médicos sobre eles e registro suas condições. Assim, pensamentos sobre seus estados são inevitáveis."
                },
                {
                    "id": "662130405",
                    "speaker": "Matla",
                    "text": "Quanto a mim, essa não é a coisa mais saudável."
                },
                {
                    "id": "662130406",
                    "speaker": "Matla",
                    "text": "Mas é difícil para médicos se curarem, então tudo que posso esperar é ficar temporariamente livre enquanto medito."
                }
            ]
        },
        {
            "talkId": "6621305",
            "initDialog": "662130501",
            "dialogues": [
                {
                    "id": "662130501",
                    "speaker": "Matla",
                    "text": "Desafio de Aventura"
                }
            ]
        },
        {
            "talkId": "6621306",
            "initDialog": "662130601",
            "dialogues": [
                {
                    "id": "662130601",
                    "speaker": "Matla",
                    "text": "Eu... Eu ganhei? Uau, obrigado..."
                }
            ]
        },
        {
            "talkId": "6621307",
            "initDialog": "662130701",
            "dialogues": [
                {
                    "id": "662130701",
                    "speaker": "Matla",
                    "text": "...Huh? Por que fiz aquela jogada? Estranho..."
                }
            ]
        }
    ]
}