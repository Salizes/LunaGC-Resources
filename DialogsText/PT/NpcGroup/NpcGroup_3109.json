    "talks": [
        {
            "talkId": "6310901",
            "initDialog": "631090101",
            "dialogues": [
                {
                    "id": "631090101",
                    "speaker": "Kanra",
                    "text": "*Suspiro* Ele deve estar bem, não é?"
                }
            ]
        },
        {
            "talkId": "6310902",
            "initDialog": "631090201",
            "dialogues": [
                {
                    "id": "631090201",
                    "speaker": "Player",
                    "text": "Ele é...?"
                },
                {
                    "id": "631090202",
                    "speaker": "Kanra",
                    "text": "Ah, estou falando do meu amor. Ele agora está servindo como soldado em Tatarasuna."
                },
                {
                    "id": "631090203",
                    "speaker": "Kanra",
                    "text": "Já lhe escrevi cartas antes, perguntando se estava indo bem... Mas de uma forma ou de outra nenhuma dessas cartas obteve resposta."
                },
                {
                    "id": "631090204",
                    "speaker": "Kanra",
                    "text": "Eu não tenho outra maneira de contatá-lo, portanto, só posso rezar por ele aqui. Espero que a Arconte o abençoe e o mantenha seguro."
                }
            ]
        },
        {
            "talkId": "6310903",
            "initDialog": "631090301",
            "dialogues": [
                {
                    "id": "631090301",
                    "speaker": "Player",
                    "text": "Tchau."
                },
                {
                    "id": "631090302",
                    "speaker": "Kanra",
                    "text": "De qualquer forma, adeus..."
                }
            ]
        },
        {
            "talkId": "7292701",
            "initDialog": "729270101",
            "dialogues": [
                {
                    "id": "729270101",
                    "speaker": "Player",
                    "text": "Desejo-lhes boa sorte."
                },
                {
                    "id": "729270102",
                    "speaker": "Kanra",
                    "text": "Você é muito gentil, obrigada."
                },
                {
                    "id": "729270103",
                    "speaker": "Kanra",
                    "text": "#Humm... Você parece {F#uma}{M#um} Viajante experiente. Fique com esse amuleto, ele lhe protegerá em suas jornadas vindouras."
                },
                {
                    "id": "729270104",
                    "speaker": "Kanra",
                    "text": "Se puder ver meu amor novamente, prepararei um para ele também..."
                }
            ]
        }
    ]
}