{
    "groupId": "9037",
    "total_dialogue_lines": 65,
    "speaker_counts": {
        "Ganyu": 42,
        "Player": 23
    },
    "talks": [
        {
            "talkId": "6903701",
            "initDialog": "690370101",
            "dialogues": [
                {
                    "id": "690370101",
                    "speaker": "Ganyu",
                    "text": "#{NICKNAME}, olá."
                },
                {
                    "id": "690370102",
                    "speaker": "Ganyu",
                    "text": "Se você tiver algum trabalho que ainda não concluiu, pode deixar ele comigo."
                }
            ]
        },
        {
            "talkId": "6903702",
            "initDialog": "690370201",
            "dialogues": [
                {
                    "id": "690370201",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>Você se acostumou com esse lugar?</color>"
                },
                {
                    "id": "690370202",
                    "speaker": "Ganyu",
                    "text": "Uh, eu acho que esse lugar é muito bonito."
                },
                {
                    "id": "690370203",
                    "speaker": "Ganyu",
                    "text": "Não deve ter sido fácil arrumar um lugar grande como esse. Você deve ter trabalhado muito.",
                    "choices": [
                        {
                            "id": "690370204",
                            "text": "Não foi nada demais.",
                            "response": [
                                {
                                    "id": "690370206",
                                    "speaker": "Ganyu",
                                    "text": "Quando tenho tempo livre, gosto muito de caminhar ao ar livre calmamente."
                                },
                                {
                                    "id": "690370207",
                                    "speaker": "Ganyu",
                                    "text": "Mesmo que seja a hora da sesta, me sinto segura.",
                                    "choices": [
                                        {
                                            "id": "690370208",
                                            "text": "Segurança realmente é relaxante...",
                                            "response": [
                                                {
                                                    "id": "690370209",
                                                    "speaker": "Ganyu",
                                                    "text": "Por isso eu gosto ainda mais daqui."
                                                },
                                                {
                                                    "id": "690370212",
                                                    "speaker": "Ganyu",
                                                    "text": "Enfim... Obrigada!"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "690370210",
                                            "text": "Tenha cuidado para não pegar um resfriado.",
                                            "response": [
                                                {
                                                    "id": "690370211",
                                                    "speaker": "Ganyu",
                                                    "text": "Não se preocupe, eu durmo assim há milhares de anos."
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "690370205",
                            "text": "Se você gostou, Ganyu, então tudo está ótimo."
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6903703",
            "initDialog": "690370301",
            "dialogues": [
                {
                    "id": "690370301",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>Você quer conversar comigo?</color>"
                },
                {
                    "id": "690370302",
                    "speaker": "Ganyu",
                    "text": "Está bem... Mas se não for relacionado a trabalho, eu posso não saber lhe dar uma sugestão útil.",
                    "choices": [
                        {
                            "id": "690370303",
                            "text": "Nós só estamos conversando.",
                            "response": [
                                {
                                    "id": "690370305",
                                    "speaker": "Ganyu",
                                    "text": "Está bem..."
                                },
                                {
                                    "id": "690370306",
                                    "speaker": "Ganyu",
                                    "text": "Agora que você mencionou, antes eu sempre hesitava em me integrar a sociedade dos humanos."
                                },
                                {
                                    "id": "690370307",
                                    "speaker": "Ganyu",
                                    "text": "Quando não estou sobrecarregada com trabalho, meus colegas de trabalho às vezes organizam algumas atividades."
                                },
                                {
                                    "id": "690370308",
                                    "speaker": "Ganyu",
                                    "text": "Mas como eu sou vegetariana e nem todos são, não é muito interessante sair para fazer comprar ou ir para locais animados com os outros."
                                },
                                {
                                    "id": "690370309",
                                    "speaker": "Ganyu",
                                    "text": "Além disso, quando sou criticada, a maneira que penso sobre isso não é como a das pessoas comuns..."
                                },
                                {
                                    "id": "690370310",
                                    "speaker": "Ganyu",
                                    "text": "Esse costume não mudou, mesmo com esses milhares de anos... Eu não sei o que deveria fazer a respeito disso.",
                                    "choices": [
                                        {
                                            "id": "690370311",
                                            "text": "Deixe-me pensar em algumas atividades que possam interessar a Ganyu.",
                                            "response": [
                                                {
                                                    "id": "690370313",
                                                    "speaker": "Ganyu",
                                                    "text": "Se você fizer isso, eu lhe pagarei uma compensação adicional! Que tal... Eu lhe pagar para comermos?",
                                                    "choices": [
                                                        {
                                                            "id": "690370314",
                                                            "text": "Amigos de verdade não falam sobre isso.",
                                                            "response": [
                                                                {
                                                                    "id": "690370315",
                                                                    "speaker": "Ganyu",
                                                                    "text": "Oh... Entendo."
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "690370316",
                                                            "text": "Está bem. Usarei esta oportunidade para aprender ainda mais.",
                                                            "response": [
                                                                {
                                                                    "id": "690370317",
                                                                    "speaker": "Ganyu",
                                                                    "text": "Com você ao meu lado, eu talvez possa rapidamente me integrar à sociedade humana."
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "690370312",
                                            "text": "Eu posso lhe acompanhar enquanto você se adapta, Ganyu."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "690370304",
                            "text": "Não precisa se importar com isso."
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6903704",
            "initDialog": "690370401",
            "dialogues": [
                {
                    "id": "690370401",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>O que você gostaria de fazer?</color>"
                },
                {
                    "id": "690370402",
                    "speaker": "Ganyu",
                    "text": "Gostaria de plantar com você um tipo de flor. Ou talvez algum tipo de planta... Talvez vegetais...",
                    "choices": [
                        {
                            "id": "690370403",
                            "text": "Ganyu, você é uma especialista em jardinagem.",
                            "response": [
                                {
                                    "id": "690370404",
                                    "speaker": "Ganyu",
                                    "text": "Acho que sim... Pode-se dizer que com exceção do meu trabalho, é o meu passatempo mais importante."
                                },
                                {
                                    "id": "690370405",
                                    "speaker": "Ganyu",
                                    "text": "Antes eu me preocupava se conseguiria controlar meu apetite. Eu comia tudo que plantava..."
                                },
                                {
                                    "id": "690370408",
                                    "speaker": "Ganyu",
                                    "text": "#Mas se plantarmos junt{F#as}{M#os}, eu tenho certeza que saberei me controlar!"
                                },
                                {
                                    "id": "690370409",
                                    "speaker": "Player",
                                    "text": "Na verdade, não tem problema se comermos tudo."
                                },
                                {
                                    "id": "690370410",
                                    "speaker": "Ganyu",
                                    "text": "Não! Isso não é bom..."
                                },
                                {
                                    "id": "690370411",
                                    "speaker": "Ganyu",
                                    "text": "Eu ficarei gorda..."
                                },
                                {
                                    "id": "690370412",
                                    "speaker": "Ganyu",
                                    "text": "Se eu engordar... o meu peso... quero dizer o meu peso no seu coração.",
                                    "choices": [
                                        {
                                            "id": "690370413",
                                            "text": "Não mudará!",
                                            "response": [
                                                {
                                                    "id": "690370414",
                                                    "speaker": "Ganyu",
                                                    "text": "Oh!"
                                                },
                                                {
                                                    "id": "690370415",
                                                    "speaker": "Ganyu",
                                                    "text": "#Então... Então eu vou comer com você... Plantamos junt{F#as}{M#os} e comemos junt{F#as}{M#os}..."
                                                },
                                                {
                                                    "id": "690370418",
                                                    "speaker": "Ganyu",
                                                    "text": "Certo! Eu vou procurar algumas sementes adequadas."
                                                }
                                            ]
                                        },
                                        {
                                            "id": "690370416",
                                            "text": "Então vou comer junto com você.",
                                            "response": [
                                                {
                                                    "id": "690370417",
                                                    "speaker": "Ganyu",
                                                    "text": "#Você quer dizer... Plantar e comer junt{F#as}{M#os}?"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "690370406",
                            "text": "Não me lembro que ter visto você plantando vegetais.",
                            "response": [
                                {
                                    "id": "690370407",
                                    "speaker": "Ganyu",
                                    "text": "Porque antes eu me preocupava se conseguiria controlar meu apetite. Eu comia tudo que plantava..."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6903705",
            "initDialog": "690370501",
            "dialogues": [
                {
                    "id": "690370501",
                    "speaker": "Player",
                    "text": "Bom dia, Ganyu."
                },
                {
                    "id": "690370502",
                    "speaker": "Ganyu",
                    "text": "Você vai sair da casa? Ainda não tenho planos por enquanto."
                },
                {
                    "id": "690370503",
                    "speaker": "Ganyu",
                    "text": "Quer sejam trabalhos temporários, quer sejam outras missões..."
                },
                {
                    "id": "690370504",
                    "speaker": "Ganyu",
                    "text": "#Ah! Esqueci-me de dizer... Bom dia, {NICKNAME}."
                }
            ]
        },
        {
            "talkId": "6903706",
            "initDialog": "690370601",
            "dialogues": [
                {
                    "id": "690370601",
                    "speaker": "Player",
                    "text": "Boa noite, Ganyu."
                },
                {
                    "id": "690370602",
                    "speaker": "Ganyu",
                    "text": "#{NICKNAME}, boa noite para você também."
                },
                {
                    "id": "690370603",
                    "speaker": "Ganyu",
                    "text": "Não é preciso fazer trabalho extra na noite... Isso parece meio estranho..."
                }
            ]
        },
        {
            "talkId": "6903707",
            "initDialog": "690370701",
            "dialogues": [
                {
                    "id": "690370701",
                    "speaker": "Player",
                    "text": "Quer conversar comigo?"
                }
            ]
        },
        {
            "talkId": "6903708",
            "initDialog": "690370801",
            "dialogues": [
                {
                    "id": "690370801",
                    "speaker": "Player",
                    "text": "Gostaria de fazer alguma coisa?"
                }
            ]
        },
        {
            "talkId": "6903709",
            "initDialog": "690370901",
            "dialogues": [
                {
                    "id": "690370901",
                    "speaker": "Player",
                    "text": "Você já se acostumou com esse lugar?"
                }
            ]
        },
        {
            "talkId": "6903750",
            "initDialog": "690375001",
            "dialogues": [
                {
                    "id": "690375001",
                    "speaker": "Ganyu",
                    "text": "Cheira tão bem! É a comida de Liyue com certeza!!"
                },
                {
                    "id": "690375002",
                    "speaker": "Ganyu",
                    "text": "*Cof* *Cof*... Procurar por um Diagrama do Apaziguar de Tempestade toma muito tempo, não é?"
                },
                {
                    "id": "690375003",
                    "speaker": "Ganyu",
                    "text": "A paixão por Liyue também está reconhecendo o meu trabalho. Obrigada!"
                }
            ]
        },
        {
            "talkId": "6903751",
            "initDialog": "690375101",
            "dialogues": [
                {
                    "id": "690375101",
                    "speaker": "Ganyu",
                    "text": "Cama grande, travesseiro suave e iluminação moderada, junto com essa planta como ornamento! Que lindo!"
                },
                {
                    "id": "690375102",
                    "speaker": "Ganyu",
                    "text": "Num quarto desses, certamente posso descansar tranquilamente."
                },
                {
                    "id": "690375103",
                    "speaker": "Ganyu",
                    "text": "Tentarei terminar todo o trabalho antes do nascer do sol, e depois... Dormirei um pouco."
                }
            ]
        }
    ]
}