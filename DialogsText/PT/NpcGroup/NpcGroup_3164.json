{
    "groupId": "3164",
    "total_dialogue_lines": 31,
    "speaker_counts": {
        "Player": 7,
        "Sem nome": 24
    },
    "talks": [
        {
            "talkId": "7212401",
            "initDialog": "721240101",
            "dialogues": [
                {
                    "id": "721240101",
                    "speaker": "Sem nome",
                    "text": "Por quê? Por que não consigo encontrar?"
                },
                {
                    "id": "721240102",
                    "speaker": "Player",
                    "text": "O que você está procurando?"
                },
                {
                    "id": "721240103",
                    "speaker": "Sem nome",
                    "text": "Estou procurando por... por... Eu esqueci. Toda vez que estou prestes a me lembrar, o pensamento desaparece da minha mente."
                },
                {
                    "id": "721240104",
                    "speaker": "Sem nome",
                    "text": "Ei, você sabe o que eu deveria estar procurando?",
                    "choices": [
                        {
                            "id": "721240105",
                            "text": "Como eu iria saber?",
                            "response": [
                                {
                                    "id": "721240106",
                                    "speaker": "Sem nome",
                                    "text": "Ugh, eu simplesmente não consigo pensar..."
                                },
                                {
                                    "id": "721240111",
                                    "speaker": "Sem nome",
                                    "text": "Mas que porcaria! Por que não consigo me lembrar?",
                                    "choices": [
                                        {
                                            "id": "721240112",
                                            "text": "Uma hora isso vai surgir em sua mente.",
                                            "response": [
                                                {
                                                    "id": "721240113",
                                                    "speaker": "Sem nome",
                                                    "text": "Assim não dá. Eu não posso esperar tanto tempo."
                                                },
                                                {
                                                    "id": "721240114",
                                                    "speaker": "Sem nome",
                                                    "text": "Seja lá o que estou procurando, é definitivamente alguma coisa de extrema importância para mim. Eu preciso ter isso de volta o mais rápido possível."
                                                },
                                                {
                                                    "id": "721240115",
                                                    "speaker": "Sem nome",
                                                    "text": "Tenho a sensação inexplicável de que o motivo de eu estar neste lugar é exatamente encontrar isso. Não encontrar não é uma opção."
                                                },
                                                {
                                                    "id": "721240116",
                                                    "speaker": "Sem nome",
                                                    "text": "Vou acabar com qualquer um que tentar me deter ou ficar no meu caminho..."
                                                },
                                                {
                                                    "id": "721240117",
                                                    "speaker": "Sem nome",
                                                    "text": "Acabar... Espere, é isso mesmo! Empunhar uma espada e abater pessoas... Parece familiar, satisfatório, hahaha. As ondas de sangue, como um rio vermelho."
                                                },
                                                {
                                                    "id": "721240122",
                                                    "speaker": "Sem nome",
                                                    "text": "Quando minha espada foi manchada de vermelho pela última vez?"
                                                },
                                                {
                                                    "id": "721240123",
                                                    "speaker": "Sem nome",
                                                    "text": "Hmm, deve ter sido há alguns dias. Bem, pelo menos você está aqui hoje."
                                                },
                                                {
                                                    "id": "721240124",
                                                    "speaker": "Sem nome",
                                                    "text": "Por enquanto, vamos deixar de lado aquilo que eu estava procurando. Eu me cansei de pensar nisso por tanto tempo e agora preciso relaxar."
                                                },
                                                {
                                                    "id": "721240125",
                                                    "speaker": "Sem nome",
                                                    "text": "Ah, já faz um tempo que eu não brandia minha lâmina. Posso ouvir Takatsuki Dougire reclamando."
                                                },
                                                {
                                                    "id": "721240126",
                                                    "speaker": "Sem nome",
                                                    "text": "Ah, ouça, ela está me chamando porque quer cortar você em pedaços, hahaha. Ter um duelo com você a deixaria muito feliz.",
                                                    "choices": [
                                                        {
                                                            "id": "721240127",
                                                            "text": "Você está... Bem?",
                                                            "response": [
                                                                {
                                                                    "id": "721240129",
                                                                    "speaker": "Sem nome",
                                                                    "text": "Você não consegue ouvir a voz da Takatsuki Dougire? Que pena."
                                                                },
                                                                {
                                                                    "id": "721240130",
                                                                    "speaker": "Sem nome",
                                                                    "text": "Aqueles que vivem pela espada conseguem ouvir a voz de sua lâmina. ...Hehe, ela está insistindo para eu fazer isso de novo."
                                                                },
                                                                {
                                                                    "id": "721240131",
                                                                    "speaker": "Sem nome",
                                                                    "text": "Venha, pegue sua arma e veja se tem sorte contra mim."
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "721240128",
                                                            "text": "Sua espada não pode falar."
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "721240118",
                                            "text": "Pense em quando você chegou aqui.",
                                            "response": [
                                                {
                                                    "id": "721240119",
                                                    "speaker": "Sem nome",
                                                    "text": "Quando eu cheguei aqui? Tudo que me lembro de fazer aqui é dar golpes com minha espada. Quanto ao motivo de eu fazer isso..."
                                                },
                                                {
                                                    "id": "721240120",
                                                    "speaker": "Sem nome",
                                                    "text": "Haha, sim, agora que me lembro. Eu estava abatendo alguém!"
                                                },
                                                {
                                                    "id": "721240121",
                                                    "speaker": "Sem nome",
                                                    "text": "Se você golpear o inimigo com sua espada, o sangue jorra como um rio vermelho. Isso causa uma verdadeira adrenalina hahaha."
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "721240107",
                            "text": "Já olhou em todos os seus bolsos?",
                            "response": [
                                {
                                    "id": "721240108",
                                    "speaker": "Sem nome",
                                    "text": "Já olhei, não está comigo."
                                },
                                {
                                    "id": "721240109",
                                    "speaker": "Sem nome",
                                    "text": "Mesmo que eu não me lembre do que estou procurando, sei dizer quando algo não é aquilo que busco. Seja o que for, não está comigo."
                                },
                                {
                                    "id": "721240110",
                                    "speaker": "Sem nome",
                                    "text": "Vamos, o que é, o que estou procurando..."
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}