            "dialogues": [
                {
                    "id": "664670201",
                    "speaker": "Player",
                    "text": "Olá!"
                },
                {
                    "id": "664670202",
                    "speaker": "Menta Daifuku",
                    "text": "Squii! Squii-ii!"
                },
                {
                    "id": "664670203",
                    "speaker": "Menta Daifuku",
                    "text": "(A criaturinha peculiar parece sentir uma sensação especial de familiaridade com você. Parece estar extremamente feliz...)"
                }
            ]
        },
        {
            "talkId": "6646703",
            "initDialog": "664670301",
            "dialogues": [
                {
                    "id": "664670301",
                    "speaker": "Player",
                    "text": "Você está cuidando do local?"
                },
                {
                    "id": "664670302",
                    "speaker": "Menta Daifuku",
                    "text": "Squii! Squii-ii... Squii..."
                },
                {
                    "id": "664670303",
                    "speaker": "Menta Daifuku",
                    "text": "#(A criaturinha peculiar é muito profissional. Parece ter identificado você como {M#parceiro}{F#parceira}-chave da proprietária e está fornecendo a você um relatório detalhado...)"
                }
            ]
        },
        {
            "talkId": "6646704",
            "initDialog": "664670401",
            "dialogues": [
                {
                    "id": "664670401",
                    "speaker": "Player",
                    "text": "Fazer carinho na cabeça!"
                },
                {
                    "id": "664670402",
                    "speaker": "Menta Daifuku",
                    "text": "Squii?!"
                },
                {
                    "id": "664670403",
                    "speaker": "Menta Daifuku",
                    "text": "(A criaturinha peculiar está um pouco tímida. Sua tentativa de fazer carinho acaba em fracasso...)"
                }
            ]
        },
        {
            "talkId": "6646705",
            "initDialog": "664670501",
            "dialogues": [
                {
                    "id": "664670501",
                    "speaker": "Player",
                    "text": "Tchau!"
                },
                {
                    "id": "664670502",
                    "speaker": "Menta Daifuku",
                    "text": "Squii!"
                },
                {
                    "id": "664670503",
                    "speaker": "Menta Daifuku",
                    "text": "(A criaturinha peculiar se despede respeitosamente. Seus olhos parecem transmitir uma sensação de expectativa, como se estivesse esperando que você voltasse em breve...)"
                }
            ]
        }
    ]
