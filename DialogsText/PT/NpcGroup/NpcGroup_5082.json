    "talks": [
        {
            "talkId": "6508201",
            "initDialog": "650820101",
            "dialogues": [
                {
                    "id": "650820101",
                    "speaker": "Cornelia",
                    "text": "Olá. Aonde você está indo, se me permite a pergunta?"
                }
            ]
        },
        {
            "talkId": "6508202",
            "initDialog": "650820201",
            "dialogues": [
                {
                    "id": "650820201",
                    "speaker": "Player",
                    "text": "E-Estou só dando uma olhada..."
                },
                {
                    "id": "650820202",
                    "speaker": "Cornelia",
                    "text": "#Ah, então você é apenas {M#um}{F#uma} visitante."
                },
                {
                    "id": "650820203",
                    "speaker": "Cornelia",
                    "text": "#Minhas desculpas, eu pensei que você fosse um{F#a} cidadã{M#o} a negócios aqui."
                },
                {
                    "id": "650820204",
                    "speaker": "Cornelia",
                    "text": "Já que eu fui posta aqui mais próxima ao portão, as pessoas sempre me pedem informações."
                }
            ]
        },
        {
            "talkId": "6508203",
            "initDialog": "650820301",
            "dialogues": [
                {
                    "id": "650820301",
                    "speaker": "Player",
                    "text": "Eu não te incomodarei mais, então."
                },
                {
                    "id": "650820302",
                    "speaker": "Cornelia",
                    "text": "Nesse caso, adeus."
                }
            ]
        },
        {
            "talkId": "6508204",
            "initDialog": "650820401",
            "dialogues": [
                {
                    "id": "650820401",
                    "speaker": "Player",
                    "text": "Parece um trabalho duro."
                },
                {
                    "id": "650820402",
                    "speaker": "Cornelia",
                    "text": "Está tudo bem. Eu não acho."
                },
                {
                    "id": "650820403",
                    "speaker": "Cornelia",
                    "text": "Interação traz cor a uma vida mais opaca e ajuda a deixar a mente mais ágil."
                },
                {
                    "id": "650820404",
                    "speaker": "Cornelia",
                    "text": "Quanto mais você trabalha aqui, mais você percebe a importância da agilidade."
                }
            ]
        }
    ]
}