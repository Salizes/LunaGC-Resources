            "dialogues": [
                {
                    "id": "617570101",
                    "speaker": "Patricia",
                    "text": "Peixinho, não saia andando por aí sozinho assim! Isso me deixa preocupada..."
                }
            ]
        },
        {
            "talkId": "6175702",
            "initDialog": "617570201",
            "dialogues": [
                {
                    "id": "617570201",
                    "speaker": "Player",
                    "text": "Hããã... Por que esse cachorro se chama Peixinho?"
                },
                {
                    "id": "617570202",
                    "speaker": "Patricia",
                    "text": "Bem, meu peixinho dourado se chama Cachorrinho, então este virou Peixinho."
                },
                {
                    "id": "617570203",
                    "speaker": "Patricia",
                    "text": "Mas, na verdade, Peixinho veio antes de Cachorrinho. No mundo inteiro, somos os terceiros mais próximos. Só a mamãe e o papai são mais próximos."
                }
            ]
        },
        {
            "talkId": "6175703",
            "initDialog": "617570301",
            "dialogues": [
                {
                    "id": "617570301",
                    "speaker": "Player",
                    "text": "Tchau!"
                },
                {
                    "id": "617570302",
                    "speaker": "Patricia",
                    "text": "Tchau-tchau!"
                }
            ]
        }
    ]
