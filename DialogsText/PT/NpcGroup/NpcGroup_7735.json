    "talks": [
        {
            "talkId": "6773501",
            "initDialog": "677350101",
            "dialogues": [
                {
                    "id": "677350101",
                    "speaker": "Congshen",
                    "text": "Sonhos, ilusões, bolhas e sombras, por que se esforçar para alcançá-los? Mesmo que você estude os princípios por mil anos, se mantiver a mente completamente imóvel e \"não nascida\", você simplesmente não vai entender."
                }
            ]
        },
        {
            "talkId": "6773502",
            "initDialog": "677350201",
            "dialogues": [
                {
                    "id": "677350201",
                    "speaker": "Player",
                    "text": "Então... você está procurando um livro?"
                },
                {
                    "id": "677350202",
                    "speaker": "Congshen",
                    "text": "Você já esteve aqui antes?",
                    "choices": [
                        {
                            "id": "677350203",
                            "text": "Hã?",
                            "response": [
                                {
                                    "id": "677350206",
                                    "speaker": "Congshen",
                                    "text": "Então você entende.",
                                    "choices": [
                                        {
                                            "id": "677350207",
                                            "text": "Entende... entende o quê?",
                                            "response": [
                                                {
                                                    "id": "677350209",
                                                    "speaker": "Congshen",
                                                    "text": "Quando precisar dormir, durma. Quando precisar entender, entenda."
                                                },
                                                {
                                                    "id": "677350210",
                                                    "speaker": "Congshen",
                                                    "text": "É melhor você voltar agora. Quando o mundo acabar, apenas acompanhe."
                                                }
                                            ]
                                        },
                                        {
                                            "id": "677350208",
                                            "text": "E como eu poderia entender isso?"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "677350204",
                            "text": "Sim."
                        },
                        {
                            "id": "677350205",
                            "text": "Não."
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6773503",
            "initDialog": "677350301",
            "dialogues": [
                {
                    "id": "677350301",
                    "speaker": "Player",
                    "text": "Eu não entendo uma palavra do que você está dizendo. Adeus."
                },
                {
                    "id": "677350302",
                    "speaker": "Congshen",
                    "text": "Vá em frente."
                }
            ]
        }
    ]
}