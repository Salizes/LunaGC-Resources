        },
        {
            "talkId": "4001313",
            "initDialog": "400131301",
            "dialogues": [
                {
                    "id": "400131301",
                    "speaker": "Kaeya",
                    "text": "Ah, é a Sra. Alice! Então foi por isso que ela escreveu aquela carta para mim."
                },
                {
                    "id": "400131302",
                    "speaker": "Kaeya",
                    "text": "Ela é uma pessoa interessante, se tiver oportunidade, pode conhecê-la."
                },
                {
                    "id": "400131303",
                    "speaker": "Kaeya",
                    "text": "Apesar dela às vezes também ter problemas... Eu até que gosto de alguns problemas que são engraçados."
                },
                {
                    "id": "400131304",
                    "speaker": "Kaeya",
                    "text": "Hum? Você me pergunta se eu já tinha adivinhado?"
                },
                {
                    "id": "400131305",
                    "speaker": "Kaeya",
                    "text": "Haha, não mesmo. Eu sou uma pessoa honesta, eu estava às cegas."
                }
