        "Player": 3
    },
    "talks": [
        {
            "talkId": "6400901",
            "initDialog": "640090101",
            "dialogues": [
                {
                    "id": "640090101",
                    "speaker": "Nabiya",
                    "text": "A tentação leva ao amor, mas o excesso de amor leva à perdição..."
                },
                {
                    "id": "640090102",
                    "speaker": "Nabiya",
                    "text": "Mas por sorte eles não gostam muito de você."
                }
            ]
        },
        {
            "talkId": "6400902",
            "initDialog": "640090201",
            "dialogues": [
                {
                    "id": "640090201",
                    "speaker": "Player",
                    "text": "Quem são \"eles\"...?"
                },
                {
                    "id": "640090202",
                    "speaker": "Nabiya",
                    "text": "Harut e Marut, eles são sombras demoníacas, são seres livres e ilimitados..."
                },
                {
                    "id": "640090203",
                    "speaker": "Nabiya",
                    "text": "...E são os meus gatos."
                }
            ]
        },
        {
            "talkId": "6400903",
            "initDialog": "640090301",
            "dialogues": [
                {
                    "id": "640090301",
                    "speaker": "Player",
                    "text": "Que pena."
                },
                {
                    "id": "640090302",
                    "speaker": "Nabiya",
                    "text": "Talvez sim, talvez não."
                }
            ]
        },
        {
            "talkId": "6400904",
            "initDialog": "640090401",
            "dialogues": [
                {
                    "id": "640090401",
                    "speaker": "Player",
                    "text": "E essa coisa de \"tentação\" e \"amor\"...?"
                },
                {
                    "id": "640090402",
                    "speaker": "Nabiya",
                    "text": "Os gatos são curiosos. Apesar de terem muitas qualidades, a curiosidade é o ponto fraco dos gatos."
                },
                {
                    "id": "640090403",
                    "speaker": "Nabiya",
                    "text": "Curiosidade e afeto fazem os peixes da água serem capturados e levados para a margem e pássaros ficarem presos no chão..."
                },
                {
                    "id": "640090404",
                    "speaker": "Nabiya",
                    "text": "Isso não é a perdição para um peixe e um pássaro?"
                }
            ]
        }
    ]
}