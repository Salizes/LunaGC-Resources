                {
                    "id": "630830101",
                    "speaker": "Harrison",
                    "text": "Silêncio! Você está aqui para \"estocar\"?"
                },
                {
                    "id": "630830102",
                    "speaker": "Harrison",
                    "text": "Fale baixo e eu posso lhe mostrar algumas coisinhas muito boas..."
