        {
            "talkId": "6308302",
            "initDialog": "630830201",
            "dialogues": [
                {
                    "id": "630830201",
                    "speaker": "Player",
                    "text": "Coisinhas muito boas...?"
                },
                {
                    "id": "630830202",
                    "speaker": "Harrison",
                    "text": "Exatamente! Os produtos da Mercearia Internacional são produtos premium importados de comerciantes de todo o mundo. Nós os temos todos os tipos e categorias. Tenho certeza de que você vai gostar de um deles."
                }
            ]
        },
        {
            "talkId": "6308303",
            "initDialog": "630830301",
            "dialogues": [
                {
                    "id": "630830301",
                    "speaker": "Player",
                    "text": "Você tem certeza de que..."
                },
                {
                    "id": "630830302",
                    "speaker": "Harrison",
                    "text": "#Shh! As paredes têm ouvidos, amig{M#o}{F#a}!"
                },
                {
                    "id": "630830303",
                    "speaker": "Harrison",
                    "text": "Estas são mercadorias importadas! Eu nunca ouvi falar desta tal besteira de contrabando, haha!"
                },
                {
                    "id": "630830304",
                    "speaker": "Harrison",
                    "text": "#Vejo que você também é {M#um}{F#uma} forasteir{M#o}{F#a}. Você entende do que estamos falando, certo?"
                },
                {
                    "id": "630830305",
                    "speaker": "Harrison",
                    "text": "Se você precisar de alguma coisa, lembre-se de mim."
                }
            ]
        },
        {
            "talkId": "6308304",
            "initDialog": "630830401",
            "dialogues": [
                {
                    "id": "630830401",
                    "speaker": "Player",
                    "text": "Tchau..."
                },
                {
                    "id": "630830402",
                    "speaker": "Harrison",
                    "text": "Adeus! Cheque comigo primeiro se você precisar de alguma coisa."
                }
            ]
        },
        {
            "talkId": "7290701",
            "initDialog": "729070101",
            "dialogues": [
                {
                    "id": "729070101",
                    "speaker": "Player",
                    "text": "Er..."
                },
                {
                    "id": "729070102",
                    "speaker": "Harrison",
                    "text": "*Suspiro* Sinceridade é uma parte fundamental de fazer negócios, não é? Veja isso só como um presente de um amigo."
                },
                {
                    "id": "729070103",
                    "speaker": "Harrison",
                    "text": "Se não há risco, não ganho, não é? Espero encontrar com você depois!"
                }
