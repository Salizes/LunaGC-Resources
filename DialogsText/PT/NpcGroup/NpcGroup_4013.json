    "talks": [
        {
            "talkId": "6401301",
            "initDialog": "640130101",
            "dialogues": [
                {
                    "id": "640130101",
                    "speaker": "Farooq",
                    "text": "Cuidado com batedores de carteiras."
                }
            ]
        },
        {
            "talkId": "6401302",
            "initDialog": "640130201",
            "dialogues": [
                {
                    "id": "640130201",
                    "speaker": "Player",
                    "text": "Há muitos ladrões?"
                },
                {
                    "id": "640130202",
                    "speaker": "Farooq",
                    "text": "Sem problemas. Temos a Tropa dos Trinta aqui. Batedores de carteiras não ousariam aparecer."
                },
                {
                    "id": "640130203",
                    "speaker": "Farooq",
                    "text": "Mesmo assim, não podemos descartar que haja um deles ocasionalmente à espreita."
                },
                {
                    "id": "640130204",
                    "speaker": "Farooq",
                    "text": "Se você vir alguém que se parece exatamente comigo, cuidado com sua carteira."
                },
                {
                    "id": "640130205",
                    "speaker": "Farooq",
                    "text": "Ele é meu irmão gêmeo. Um ladrão patético. Fala besteira o tempo todo."
                },
                {
                    "id": "640130206",
                    "speaker": "Farooq",
                    "text": "Não o deixe colidir com você. Apenas preste atenção em suas ações."
                }
            ]
        },
        {
            "talkId": "6401303",
            "initDialog": "640130301",
            "dialogues": [
                {
                    "id": "640130301",
                    "speaker": "Player",
                    "text": "Agradeço pelo lembrete."
                },
                {
                    "id": "640130302",
                    "speaker": "Farooq",
                    "text": "Bom, espero que tenha entendido."
                }
            ]
        },
        {
            "talkId": "7392601",
            "initDialog": "739260101",
            "dialogues": [
                {
                    "id": "739260101",
                    "speaker": "Player",
                    "text": "Vocês são todos parecidos..."
                },
                {
                    "id": "739260102",
                    "speaker": "Farooq",
                    "text": "Então é ainda mais fácil: Não confie em ninguém."
                },
                {
                    "id": "739260103",
                    "speaker": "Farooq",
                    "text": "Se você baixar a guarda quando vir alguém de uniforme, haverá um dia que estará em desvantagem."
                }
            ]
        }
    ]
}