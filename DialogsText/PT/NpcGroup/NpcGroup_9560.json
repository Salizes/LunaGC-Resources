            ]
        },
        {
            "talkId": "6956010",
            "initDialog": "695601001",
            "dialogues": [
                {
                    "id": "695601001",
                    "speaker": "Thoma",
                    "text": "Devo dizer, fiquei bem satisfeito com meu último movimento."
                }
            ]
        },
        {
            "talkId": "6956011",
            "initDialog": "695601101",
            "dialogues": [
                {
                    "id": "695601101",
                    "speaker": "Thoma",
                    "text": "...Uau, que derrota devastadora... Acho que preciso melhorar um pouco minhas habilidades."
                }
            ]
        },
        {
            "talkId": "6956012",
            "initDialog": "695601201",
            "dialogues": [
                {
                    "id": "695601201",
                    "speaker": "Thoma",
                    "text": "Manda ver, vou com tudo dessa vez!"
