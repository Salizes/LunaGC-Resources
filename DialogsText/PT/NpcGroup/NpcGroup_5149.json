{
    "groupId": "5149",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Hermosa": 8,
        "Player": 3
    },
    "talks": [
        {
            "talkId": "6514901",
            "initDialog": "651490101",
            "dialogues": [
                {
                    "id": "651490101",
                    "speaker": "Hermosa",
                    "text": "Essas fotos são muito boas... acho que irei editá-las antes de escolher."
                }
            ]
        },
        {
            "talkId": "6514902",
            "initDialog": "651490201",
            "dialogues": [
                {
                    "id": "651490201",
                    "speaker": "Player",
                    "text": "Você é uma fotógrafa?"
                },
                {
                    "id": "651490202",
                    "speaker": "Hermosa",
                    "text": "Infelizmente não. Sou bom com fotografias, sim, mas eu prefiro o título de \"aventureira\"."
                },
                {
                    "id": "651490203",
                    "speaker": "Hermosa",
                    "text": "Eu levo meu gato em várias aventuras e tiro muitas fotos que contam uma história."
                },
                {
                    "id": "651490204",
                    "speaker": "Hermosa",
                    "text": "Digo, quem disse que fotos não podem contar histórias? Algumas delas são publicadas nos jornais e outras são usadas como ilustrações para livros."
                },
                {
                    "id": "651490205",
                    "speaker": "Hermosa",
                    "text": "Cada uma delas definitivamente irá conter o meu gato — faz com que elas sejam fáceis de identificar, sabe."
                }
            ]
        },
        {
            "talkId": "6514903",
            "initDialog": "651490301",
            "dialogues": [
                {
                    "id": "651490301",
                    "speaker": "Player",
                    "text": "Até depois."
                },
                {
                    "id": "651490302",
                    "speaker": "Hermosa",
                    "text": "Hmm? Oh, certo, tchau."
                }
            ]
        },
        {
            "talkId": "6514904",
            "initDialog": "651490401",
            "dialogues": [
                {
                    "id": "651490401",
                    "speaker": "Player",
                    "text": "Desafio de Aventura"
                }
            ]
        },
        {
            "talkId": "6514905",
            "initDialog": "651490501",
            "dialogues": [
                {
                    "id": "651490501",
                    "speaker": "Hermosa",
                    "text": "Uma partida maravilhosamente acirrada! Certamente digna de ser salva como uma foto comemorativa para encher meu Álbum de Aventuras!"
                }
            ]
        },
        {
            "talkId": "6514906",
            "initDialog": "651490601",
            "dialogues": [
                {
                    "id": "651490601",
                    "speaker": "Hermosa",
                    "text": "Ahh... Será que eu tiro foto dessa derrota?"
                }
            ]
        }
    ]
}