    "talks": [
        {
            "talkId": "6634401",
            "initDialog": "663440101",
            "dialogues": [
                {
                    "id": "663440101",
                    "speaker": "???",
                    "text": "#Oh, olá, {NICKNAME}, é você...",
                    "choices": [
                        {
                            "id": "663440102",
                            "text": "Por que você parece tão para baixo?",
                            "response": [
                                {
                                    "id": "663440103",
                                    "speaker": "???",
                                    "text": "Na verdade... a Fonte Termal ainda parece mais fria do que antes. Eu realmente fiz besteira dessa vez. O que vou fazer quando voltar...?"
                                },
                                {
                                    "id": "663440104",
                                    "speaker": "Player",
                                    "text": "Não se preocupe, apenas dê um pouco mais de tempo."
                                },
                                {
                                    "id": "663440105",
                                    "speaker": "???",
                                    "text": "Certo, entendi..."
                                }
                            ]
                        },
                        {
                            "id": "663440106",
                            "text": "Adeus.",
                            "response": [
                                {
                                    "id": "663440107",
                                    "speaker": "???",
                                    "text": "#Uhm... tome cuidado no caminho, {NICKNAME}."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6634402",
            "initDialog": "663440201",
            "dialogues": [
                {
                    "id": "663440201",
                    "speaker": "???",
                    "text": "#É você, {NICKNAME}! Hehe, há quanto tempo! Como vocês estão?",
                    "choices": [
                        {
                            "id": "663440202",
                            "text": "Algo bom aconteceu?",
                            "response": [
                                {
                                    "id": "663440203",
                                    "speaker": "???",
                                    "text": "Hehe, cá entre nós — descobri que a temperatura da água da fonte termal voltou ao normal, o que é uma ótima notícia para mim — agora meus pequenos Koholassauros podem brincar livremente, e não preciso mais me preocupar!"
                                },
                                {
                                    "id": "663440204",
                                    "speaker": "???",
                                    "text": "A próxima etapa é se divertir! Vou aproveitar ao máximo as fontes termais e o vulcão!"
                                },
                                {
                                    "id": "663440205",
                                    "speaker": "Player",
                                    "text": "Divirta-se!"
                                },
                                {
                                    "id": "663440206",
                                    "speaker": "???",
                                    "text": "#Valeu, {NICKNAME}! Não se esqueça de se divertir também, está bem?"
                                }
                            ]
                        },
                        {
                            "id": "663440207",
                            "text": "Adeus.",
                            "response": [
                                {
                                    "id": "663440208",
                                    "speaker": "???",
                                    "text": "Se cuide, e tenha uma boa viagem!"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}