    "talks": [
        {
            "talkId": "6781501",
            "initDialog": "678150101",
            "dialogues": [
                {
                    "id": "678150101",
                    "speaker": "Rusanov",
                    "text": "Quem diria que o Patriarca partiria tão de repente... *Suspiro*"
                }
            ]
        },
        {
            "talkId": "6781502",
            "initDialog": "678150201",
            "dialogues": [
                {
                    "id": "678150201",
                    "speaker": "Player",
                    "text": "Você disse \"Patriarca\"?"
                },
                {
                    "id": "678150202",
                    "speaker": "Rusanov",
                    "text": "Sim. Dizem que a enfermidade veio e levou ele rapidinho. Mas tudo aconteceu rápido demais. E os rapazes andam resmungando sobre alguma possível conspiração ou tramoia."
                },
                {
                    "id": "678150203",
                    "speaker": "Rusanov",
                    "text": "E agora as gangues menores estão mais ativas. Alguns até dizem que a Mesa Alta pode passar por mudanças em breve..."
                },
                {
                    "id": "678150204",
                    "speaker": "Rusanov",
                    "text": "Não que isso importe para um peão como eu. Eles ainda vão cobrir minha passagem de volta, não vão?"
                }
            ]
        },
        {
            "talkId": "6781503",
            "initDialog": "678150301",
            "dialogues": [
                {
                    "id": "678150301",
                    "speaker": "Player",
                    "text": "Perdão pela interrupção."
                },
                {
                    "id": "678150302",
                    "speaker": "Rusanov",
                    "text": "Certo."
                }
            ]
        }
    ]
}