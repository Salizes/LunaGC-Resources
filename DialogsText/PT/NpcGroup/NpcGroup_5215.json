    "talks": [
        {
            "talkId": "6521501",
            "initDialog": "652150101",
            "dialogues": [
                {
                    "id": "652150101",
                    "speaker": "Rosolino",
                    "text": "Na esquerda fica a Sala do Correio, e à direita fica a Enfermaria. Não se confunda."
                }
            ]
        },
        {
            "talkId": "6521502",
            "initDialog": "652150201",
            "dialogues": [
                {
                    "id": "652150201",
                    "speaker": "Player",
                    "text": "Sobre a Sala do Correio..."
                },
                {
                    "id": "652150202",
                    "speaker": "Rosolino",
                    "text": "Você paga com Cupons Especiais. Diga-nos quem será o destinatário e o endereço que vamos entregar a carta, se for em Fontaine. A carta não pode ser muito grande e o conteúdo... bem, você cuida disso."
                },
                {
                    "id": "652150203",
                    "speaker": "Rosolino",
                    "text": "Aconselho você a não perguntar sobre mais nada."
                }
            ]
        },
        {
            "talkId": "6521503",
            "initDialog": "652150301",
            "dialogues": [
                {
                    "id": "652150301",
                    "speaker": "Player",
                    "text": "Sobre a Enfermaria..."
                },
                {
                    "id": "652150302",
                    "speaker": "Rosolino",
                    "text": "Se o Dr. Arderne não estiver lá, ele provavelmente está na área de produção. Não sei mais nada além disso."
                }
            ]
        },
        {
            "talkId": "6521504",
            "initDialog": "652150401",
            "dialogues": [
                {
                    "id": "652150401",
                    "speaker": "Player",
                    "text": "#Certo, obrigad{F#a}{M#o}."
                },
                {
                    "id": "652150402",
                    "speaker": "Rosolino",
                    "text": "De nada."
                }
            ]
        },
        {
            "talkId": "6521505",
            "initDialog": "652150501",
            "dialogues": [
                {
                    "id": "652150501",
                    "speaker": "Rosolino",
                    "text": "Duelo"
                }
            ]
        },
        {
            "talkId": "6521506",
            "initDialog": "652150601",
            "dialogues": [
                {
                    "id": "652150601",
                    "speaker": "Rosolino",
                    "text": "Não se preocupe, você ainda tem muito tempo para praticar suas cartas. Apesar de estar aqui na Fortaleza Meropide... Eu não tenho tempo a perder."
                }
            ]
        },
        {
            "talkId": "6521507",
            "initDialog": "652150701",
            "dialogues": [
                {
                    "id": "652150701",
                    "speaker": "Rosolino",
                    "text": "Nada mal! Você parece tão jovem, mas é muito experiente com cartas!"
                }
            ]
        }
    ]
}