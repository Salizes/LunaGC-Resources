        {
            "talkId": "6950611",
            "initDialog": "695061101",
            "dialogues": [
                {
                    "id": "695061101",
                    "speaker": "Amber",
                    "text": "#Ei, você é muito {M#bom}{F#boa} nisso! Não se esqueça de me ensinar uma coisa ou outra da próxima vez, ok?"
                }
            ]
        },
        {
            "talkId": "6950612",
            "initDialog": "695061201",
            "dialogues": [
                {
                    "id": "695061201",
                    "speaker": "Amber",
                    "text": "Claro! Mas não vou pegar leve com você."
