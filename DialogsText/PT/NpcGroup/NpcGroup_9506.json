            "initDialog": "695060401",
            "dialogues": [
                {
                    "id": "695060401",
                    "speaker": "Amber",
                    "text": "Eu ganhei! Awwn, não fique triste. Eu... eu te pago um lanche! Que tal uma Carne Frita com Cenoura e Mel?"
