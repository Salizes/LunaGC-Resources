{
    "groupId": "5238",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Lechlade": 10,
        "Player": 6
    },
    "talks": [
        {
            "talkId": "6523801",
            "initDialog": "652380101",
            "dialogues": [
                {
                    "id": "652380101",
                    "speaker": "Lechlade",
                    "text": "Aceite meu conselho, jovem. Fique longe dessas pedras amarelas-esverdeadas! Quanto mais longe, melhor!"
                }
            ]
        },
        {
            "talkId": "6523802",
            "initDialog": "652380201",
            "dialogues": [
                {
                    "id": "652380201",
                    "speaker": "Player",
                    "text": "Quem é você?"
                },
                {
                    "id": "652380202",
                    "speaker": "Lechlade",
                    "text": "Eu sou só um ninguém..."
                }
            ]
        },
        {
            "talkId": "6523803",
            "initDialog": "652380301",
            "dialogues": [
                {
                    "id": "652380301",
                    "speaker": "Player",
                    "text": "Sobre as pedras amarelas-esverdeadas..."
                },
                {
                    "id": "652380302",
                    "speaker": "Lechlade",
                    "text": "Essas pedras são malignas! Trazem desastre aos ganancioso e azar aos ignorantes..."
                }
            ]
        },
        {
            "talkId": "6523804",
            "initDialog": "652380401",
            "dialogues": [
                {
                    "id": "652380401",
                    "speaker": "Player",
                    "text": "Até mais."
                },
                {
                    "id": "652380402",
                    "speaker": "Lechlade",
                    "text": "Então confie em mim e fique bem longe delas!"
                }
            ]
        },
        {
            "talkId": "6523805",
            "initDialog": "652380501",
            "dialogues": [
                {
                    "id": "652380501",
                    "speaker": "Lechlade",
                    "text": "A saúde realmente é algo que só valorizamos depois que perdemos..."
                }
            ]
        },
        {
            "talkId": "6523806",
            "initDialog": "652380601",
            "dialogues": [
                {
                    "id": "652380601",
                    "speaker": "Player",
                    "text": "Como você tem estado?"
                },
                {
                    "id": "652380602",
                    "speaker": "Lechlade",
                    "text": "O remédio do Dr. Arderne realmente funcionou. Minha dor de cabeça se foi e eu me sinto bem acordado. Me faz lembrar dos dias que eu podia ajudar pessoas assim..."
                },
                {
                    "id": "652380603",
                    "speaker": "Lechlade",
                    "text": "*Suspira* É tudo minha culpa. Você precisa cuidar de si, e levar quaisquer sintomas a sério, até mesmo os mais leves..."
                }
            ]
        },
        {
            "talkId": "6523807",
            "initDialog": "652380701",
            "dialogues": [
                {
                    "id": "652380701",
                    "speaker": "Player",
                    "text": "Sobre as pedras amarelas-esverdeadas..."
                },
                {
                    "id": "652380702",
                    "speaker": "Lechlade",
                    "text": "Essas coisas são péssimas!"
                },
                {
                    "id": "652380703",
                    "speaker": "Lechlade",
                    "text": "Para elas, só bloquear o caminho não é suficiente! Precisamos destruir todas elas... elas não podem ser permitidas existir."
                }
            ]
        },
        {
            "talkId": "6523808",
            "initDialog": "652380801",
            "dialogues": [
                {
                    "id": "652380801",
                    "speaker": "Player",
                    "text": "Até mais."
                },
                {
                    "id": "652380802",
                    "speaker": "Lechlade",
                    "text": "Adeus. E lembre-se de ficar longe dessas pedras amarelas-esverdeadas! Quanto mais longe, melhor!"
                }
            ]
        }
    ]
}