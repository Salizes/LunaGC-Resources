    "talks": [
        {
            "talkId": "6704401",
            "initDialog": "670440101",
            "dialogues": [
                {
                    "id": "670440101",
                    "speaker": "Alida",
                    "text": "Extra, extra! A última edição do Expresso Nasha! Quem quer uma edição?"
                }
            ]
        },
        {
            "talkId": "6704402",
            "initDialog": "670440201",
            "dialogues": [
                {
                    "id": "670440201",
                    "speaker": "Player",
                    "text": "Eu quero uma."
                },
                {
                    "id": "670440202",
                    "speaker": "Alida",
                    "text": "Certo! Com umas Mora a mais, eu te ensino o segredo para saber se o que apareceu nas notícias é verdadeiro, ou falso."
                }
            ]
        },
        {
            "talkId": "6704403",
            "initDialog": "670440301",
            "dialogues": [
                {
                    "id": "670440301",
                    "speaker": "Player",
                    "text": "#Valeu, mas não, obrigad{M#o}{F#a}."
                },
                {
                    "id": "670440302",
                    "speaker": "Alida",
                    "text": "Mesmo? Oh, tudo bem."
                }
            ]
        },
        {
            "talkId": "6704404",
            "initDialog": "670440401",
            "dialogues": [
                {
                    "id": "670440401",
                    "speaker": "Player",
                    "text": "Notícia falsa?"
                },
                {
                    "id": "670440402",
                    "speaker": "Alida",
                    "text": "Estamos falando do Expresso Nasha, parça! Você vai ter sorte se tiver uma notícia verdadeira nesse negócio!"
                },
                {
                    "id": "670440403",
                    "speaker": "Alida",
                    "text": "Toda história começa do mesmo jeito. \"Fontes dizem que\"... é só balela. E esses \"Testemunhos oculares\" são só espaço para patrocinadores!"
                },
                {
                    "id": "670440404",
                    "speaker": "Alida",
                    "text": "Oh, droga. E você nem pagou. Por que eu ainda tô falando isso tudo..."
                },
                {
                    "id": "670440405",
                    "speaker": "Alida",
                    "text": "#Argh! Esqueça! Como você é {F#fofa}{M#fofo}, pode ficar com esse conselho de graça!"
                }
            ]
        }
    ]
}