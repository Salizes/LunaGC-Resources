        {
            "talkId": "6415901",
            "initDialog": "641590101",
            "dialogues": [
                {
                    "id": "641590101",
                    "speaker": "Jahangir",
                    "text": "#Bem-vind{F#a}{M#o}! O que deseja comer?"
                },
                {
                    "id": "641590102",
                    "speaker": "Jahangir",
                    "text": "Se quiser cozinhar por conta própria, tudo bem também. A panela está à disposição."
                }
            ]
        },
        {
            "talkId": "6415902",
            "initDialog": "641590201",
            "dialogues": [
                {
                    "id": "641590201",
                    "speaker": "Player",
                    "text": "#Estou famint{M#o}{F#a}."
                },
                {
                    "id": "641590202",
                    "speaker": "Jahangir",
                    "text": "Hahaha, então pode comer!"
                }
            ]
        },
        {
            "talkId": "6415903",
            "initDialog": "641590301",
            "dialogues": [
                {
                    "id": "641590301",
                    "speaker": "Player",
                    "text": "Você é..."
                },
                {
                    "id": "641590302",
                    "speaker": "Jahangir",
                    "text": "Eu sou o dono da loja de alimentos, e como o nome sugere, ajudo as pessoas a encherem a barriga."
                },
                {
                    "id": "641590303",
                    "speaker": "Jahangir",
                    "text": "Se quiser comprar comida pronta, ou fazer por conta própria, é sua escolha! É importante que todos fiquem contentes na hora de comer, não é verdade?"
                },
                {
                    "id": "641590304",
                    "speaker": "Jahangir",
                    "text": "Principalmente mercadores viajantes e marinheiros, sempre em busca de um lugar para matar a fome. Pelo menos aqui eles podem se saciar com algo quentinho."
                },
                {
                    "id": "641590305",
                    "speaker": "Jahangir",
                    "text": "Graças a eles, eu também posso provar as iguarias de vários lugares do mundo! Hahaha!"
                }
            ]
        },
        {
            "talkId": "6415904",
            "initDialog": "641590401",
            "dialogues": [
                {
                    "id": "641590401",
                    "speaker": "Player",
                    "text": "Adeus."
                },
                {
                    "id": "641590402",
                    "speaker": "Jahangir",
                    "text": "Se cuida e volte sempre!"
                }
            ]
        }
    ]
