    "talks": [
        {
            "talkId": "7328519",
            "initDialog": "732851901",
            "dialogues": [
                {
                    "id": "732851901",
                    "speaker": "Sosi",
                    "text": "#Forasteir{M#o}{F#a} de longe... Fale com o Vijnanapati se você tiver assuntos para discutir.",
                    "choices": [
                        {
                            "id": "732851902",
                            "text": "O que você está fazendo aqui?",
                            "response": [
                                {
                                    "id": "732851903",
                                    "speaker": "Sosi",
                                    "text": "Eu... Ahem. Você não precisa saber disso."
                                },
                                {
                                    "id": "732851904",
                                    "speaker": "Sosi",
                                    "text": "Se você não tiver nada para fazer aqui, vá embora, logo."
                                }
                            ]
                        },
                        {
                            "id": "732851905",
                            "text": "Não lhe incomodarei mais.",
                            "response": [
                                {
                                    "id": "732851906",
                                    "speaker": "Sosi",
                                    "text": "Está bem, certo. Vou continuar com meu trabalho."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7328520",
            "initDialog": "732852001",
            "dialogues": [
                {
                    "id": "732852001",
                    "speaker": "Sosi",
                    "text": "#Oh! É {F#a}{M#o} Yasnapati da Senhorita Sorush. Posso responder qualquer pergunta que você fizer.",
                    "choices": [
                        {
                            "id": "732852002",
                            "text": "Sobre o Monumento de Khvarena...",
                            "response": [
                                {
                                    "id": "732852003",
                                    "speaker": "Sosi",
                                    "text": "Como todos podem ver, eu não desisti de organizar os textos da Ordem dos Céticos."
                                },
                                {
                                    "id": "732852004",
                                    "speaker": "Sosi",
                                    "text": "Apesar de eu ter descoberto que existem algumas inconsistências entre o que está escrito nesses documentos e a verdade..."
                                },
                                {
                                    "id": "732852005",
                                    "speaker": "Sosi",
                                    "text": "Acredito que com uma análise minuciosa, certamente poderei chegar a verdade."
                                }
                            ]
                        },
                        {
                            "id": "732852006",
                            "text": "Sobre os Fatui...",
                            "response": [
                                {
                                    "id": "732852007",
                                    "speaker": "Sosi",
                                    "text": "Graças ao esforço de todos, Markozov e aquele grupo dele foram embora."
                                },
                                {
                                    "id": "732852008",
                                    "speaker": "Sosi",
                                    "text": "Mas isso não quer dizer que os Fatui vão desistir assim tão fácil..."
                                },
                                {
                                    "id": "732852009",
                                    "speaker": "Sosi",
                                    "text": "Talvez a Ordem dos Cético deva considerar recrutar alguns soldados. Quero dizer, pelo menos alguém mais confiável que Pyrrho."
                                }
                            ]
                        },
                        {
                            "id": "732852010",
                            "text": "Não lhe incomodarei mais.",
                            "response": [
                                {
                                    "id": "732852011",
                                    "speaker": "Sosi",
                                    "text": "Oh, não precisa ser tão formal. Bem, vou continuar com meu trabalho."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
