            ]
        },
        {
            "talkId": "7328522",
            "initDialog": "732852201",
            "dialogues": [
                {
                    "id": "732852201",
                    "speaker": "Sosi",
                    "text": "Yasnapati da Senhorita Sorush... não desista tão facilmente. Você deve... tentar com mais veemência.",
                    "choices": [
                        {
                            "id": "732852202",
                            "text": "Algo aconteceu?",
                            "response": [
                                {
                                    "id": "732852203",
                                    "speaker": "Sosi",
                                    "text": "Ah, não é nada. Eu não estou fazendo muito progresso em minha pesquisa, só isso. Isso tudo faz parte da vida de uma pesquisadora."
                                }
                            ]
                        },
                        {
                            "id": "732852204",
                            "text": "Não te incomodaremos mais.",
                            "response": [
                                {
                                    "id": "732852205",
                                    "speaker": "Sosi",
                                    "text": "Obrigada por entender. Eu continuarei meu trabalho."
                                }
                            ]
                        }
                    ]
