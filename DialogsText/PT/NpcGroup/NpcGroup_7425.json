    "talks": [
        {
            "talkId": "6742501",
            "initDialog": "674250101",
            "dialogues": [
                {
                    "id": "674250101",
                    "speaker": "Vanya",
                    "text": "Urgh... Espere, pra onde você tá indo?"
                }
            ]
        },
        {
            "talkId": "6742502",
            "initDialog": "674250201",
            "dialogues": [
                {
                    "id": "674250201",
                    "speaker": "Player",
                    "text": "O que houve?"
                },
                {
                    "id": "674250202",
                    "speaker": "Vanya",
                    "text": "Eu encontrei algo assustador... Peguei no chão um bolinho dourado com uma runa desenhada em cima..."
                },
                {
                    "id": "674250203",
                    "speaker": "Vanya",
                    "text": "Logo em seguida, alguém pegou no meu ombro, e me arrastou... me levou até outra pessoa que pegou o meu bolinho, e me deu uma bebida estranha..."
                },
                {
                    "id": "674250204",
                    "speaker": "Vanya",
                    "text": "Eu bebi, um copo atrás do outro... e agora, eu esqueci muitas coisas. Esqueci até como voltar pra casa..."
                }
            ]
        },
        {
            "talkId": "6742503",
            "initDialog": "674250301",
            "dialogues": [
                {
                    "id": "674250301",
                    "speaker": "Player",
                    "text": "Você precisa da nossa ajuda?"
                },
                {
                    "id": "674250302",
                    "speaker": "Vanya",
                    "text": "Não, por que eu precisaria? Eu estou bem... Só quero mais um copo..."
                }
            ]
        },
        {
            "talkId": "6742504",
            "initDialog": "674250401",
            "dialogues": [
                {
                    "id": "674250401",
                    "speaker": "Player",
                    "text": "... Você só foi na taverna comprar bebida!"
                },
                {
                    "id": "674250402",
                    "speaker": "Vanya",
                    "text": "Haha... mesmo?"
                }
            ]
        },
        {
            "talkId": "6742505",
            "initDialog": "674250501",
            "dialogues": [
                {
                    "id": "674250501",
                    "speaker": "Player",
                    "text": "Você só tomou demais!"
                },
                {
                    "id": "674250502",
                    "speaker": "Vanya",
                    "text": "Mas... olhe só pra mim, eu não estou bêbado de cair no chão, eu ainda consigo andar!"
                }
            ]
        }
    ]
}