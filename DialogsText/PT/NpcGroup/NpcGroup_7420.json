    "talks": [
        {
            "talkId": "6742001",
            "initDialog": "674200101",
            "dialogues": [
                {
                    "id": "674200101",
                    "speaker": "Nefedov",
                    "text": "O pedido está pronto. Esse prato daqui também está pronto! Mesa 1! Hã? Precisa de algo?"
                }
            ]
        },
        {
            "talkId": "6742002",
            "initDialog": "674200201",
            "dialogues": [
                {
                    "id": "674200201",
                    "speaker": "Player",
                    "text": "Você é o chefe desse restaurante?"
                },
                {
                    "id": "674200202",
                    "speaker": "Nefedov",
                    "text": "Sim. É um restaurante construído pelos Volkodlaks, operado por Volkodlaks, e servindo todos de Snezhnaya. Sou eu mesmo."
                },
                {
                    "id": "674200203",
                    "speaker": "Nefedov",
                    "text": "Certo. Se você veio aqui só pra saber disso, sinto muito, mas não posso lhe acompanhar. Tenho muito o que fazer."
                }
            ]
        },
        {
            "talkId": "6742003",
            "initDialog": "674200301",
            "dialogues": [
                {
                    "id": "674200301",
                    "speaker": "Player",
                    "text": "Tem como cair pelo na comida?"
                },
                {
                    "id": "674200302",
                    "speaker": "Nefedov",
                    "text": "Claro que não? Nosso chef vai terminar de limpar o pelo antes de começar cozinhar, só pra garantir que nada vai cair dentro enquanto cozinha..."
                },
                {
                    "id": "674200303",
                    "speaker": "Nefedov",
                    "text": "Se você realmente encontrar algo assim, pode pedir para o garçom levar o prato, vamos preparar outro para você."
                }
            ]
        },
        {
            "talkId": "6742004",
            "initDialog": "674200401",
            "dialogues": [
                {
                    "id": "674200401",
                    "speaker": "Player",
                    "text": "Não é nada."
                },
                {
                    "id": "674200402",
                    "speaker": "Nefedov",
                    "text": "Então, bom apetite."
                }
            ]
        },
