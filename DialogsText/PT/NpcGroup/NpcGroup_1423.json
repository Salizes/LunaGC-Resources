            "initDialog": "614230901",
            "dialogues": [
                {
                    "id": "614230901",
                    "speaker": "Blanche",
                    "text": "#Completamente {M#meticuloso}{F#meticulosa}... Posso dizer que já conheço sua técnica."
                }
            ]
        },
        {
            "talkId": "6142310",
            "initDialog": "614231001",
            "dialogues": [
                {
                    "id": "614231001",
                    "speaker": "Blanche",
                    "text": "Se você não tomar cuidado, vai acabar perdendo."
                }
            ]
        },
        {
            "talkId": "40165",
            "initDialog": "4015142351",
            "dialogues": [
                {
                    "id": "4015142351",
                    "speaker": "Blanche",
                    "text": "Olá! Temos produtos de qualidade a preços justos!"
                }
            ]
        },
        {
            "talkId": "41704",
            "initDialog": "4015142302",
            "dialogues": [
                {
                    "id": "4015142302",
                    "speaker": "Player",
                    "text": "O que você tem para vender?"
                },
                {
                    "id": "4015142306",
                    "speaker": "Blanche",
                    "text": "Por favor, dê uma olhada ao redor."
                }
            ]
        },
        {
            "talkId": "41705",
            "initDialog": "4015142313",
            "dialogues": [
                {
                    "id": "4015142313",
                    "speaker": "Player",
                    "text": "Eu gostaria de perguntar uma coisa."
                },
                {
                    "id": "4015142314",
                    "speaker": "Blanche",
                    "text": "Estou ouvindo.",
                    "choices": [
                        {
                            "id": "4015142303",
                            "text": "O que faz os produtos de Mondstadt especial?",
                            "response": [
                                {
                                    "id": "4015142307",
                                    "speaker": "Blanche",
                                    "text": "Nossa loja pode ser pequena, mas temos um armazém no Porto de Liyue."
                                },
                                {
                                    "id": "4015142308",
                                    "speaker": "Blanche",
                                    "text": "Temos o orgulho de ter o maior catálogo de itens e a entrega mais rápida de Mondstadt."
                                }
                            ]
                        },
                        {
                            "id": "4015142304",
                            "text": "Qual é a especialidade de Mondstadt?",
                            "response": [
                                {
                                    "id": "4015142309",
                                    "speaker": "Blanche",
                                    "text": "Mondstadt é uma cidade conhecida pelos seus vinhos. Você precisa visitar as Tavernas."
                                },
                                {
                                    "id": "4015142310",
                                    "speaker": "Blanche",
                                    "text": "A maioria dos habitantes vão a uma dessas tavernas para beber depois de um dia de trabalho duro."
                                },
                                {
                                    "id": "4015142311",
                                    "speaker": "Blanche",
                                    "text": "Você pode encontrar todos os tipos de pessoas nas Tavernas à noite."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "41706",
            "initDialog": "4015142305",
            "dialogues": [
                {
                    "id": "4015142305",
                    "speaker": "Player",
                    "text": "Adeus."
                },
                {
                    "id": "4015142312",
                    "speaker": "Blanche",
                    "text": "Obrigada por vir à Loja de Mondstadt. Volte sempre!"
                }
            ]
        },
