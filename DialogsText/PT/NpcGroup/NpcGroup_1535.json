    "talks": [
        {
            "talkId": "6153501",
            "initDialog": "615350101",
            "dialogues": [
                {
                    "id": "615350101",
                    "speaker": "Ernest",
                    "text": "Hum? Quem é você? Em que posso ajudar?"
                }
            ]
        },
        {
            "talkId": "6153502",
            "initDialog": "615350201",
            "dialogues": [
                {
                    "id": "615350201",
                    "speaker": "Player",
                    "text": "O que você está fazendo?"
                },
                {
                    "id": "615350202",
                    "speaker": "Ernest",
                    "text": "Eu sou gerente da adega aqui. Ocasionalmente, supervisiono o transporte do estoque."
                },
                {
                    "id": "615350203",
                    "speaker": "Ernest",
                    "text": "O trabalho não é estressante e o chefe é extravagante. Ele me paga muito bem."
                },
                {
                    "id": "615350204",
                    "speaker": "Ernest",
                    "text": "Mesmo sem tudo isso, apenas estar na companhia desse estoque inestimável é incrível."
                },
                {
                    "id": "615350205",
                    "speaker": "Ernest",
                    "text": "Basta pensar em poucas pessoas que têm a chance de ver tanta magnificência, quanto mais trabalhar com ela."
                }
            ]
        },
        {
            "talkId": "6153503",
            "initDialog": "615350301",
            "dialogues": [
                {
                    "id": "615350301",
                    "speaker": "Player",
                    "text": "O que tem ali?"
                },
                {
                    "id": "615350302",
                    "speaker": "Ernest",
                    "text": "A cave da Adega do Alvorecer. O que eu estaria fazendo aqui de outra forma?"
                },
                {
                    "id": "615350303",
                    "speaker": "Ernest",
                    "text": "Deixe-me lhe dizer, nem pense que vai conseguir roubar o nosso vinho..."
                },
                {
                    "id": "615350304",
                    "speaker": "Ernest",
                    "text": "O seu plano nunca funcionaria..."
                },
                {
                    "id": "615350305",
                    "speaker": "Ernest",
                    "text": "Não é nada não..."
                }
            ]
        },
        {
            "talkId": "6153504",
            "initDialog": "615350401",
            "dialogues": [
                {
                    "id": "615350401",
                    "speaker": "Player",
                    "text": "Adeus."
                },
                {
                    "id": "615350402",
                    "speaker": "Ernest",
                    "text": "Nos vemos, cuide-se."
                }
            ]
        }
    ]
}