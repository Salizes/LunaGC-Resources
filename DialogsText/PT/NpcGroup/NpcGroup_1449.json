    "talks": [
        {
            "talkId": "6144901",
            "initDialog": "614490101",
            "dialogues": [
                {
                    "id": "614490101",
                    "speaker": "Miles",
                    "text": "Você está passando por dificuldades?"
                }
            ]
        },
        {
            "talkId": "6144902",
            "initDialog": "614490201",
            "dialogues": [
                {
                    "id": "614490201",
                    "speaker": "Player",
                    "text": "O que o traz aqui?"
                },
                {
                    "id": "614490202",
                    "speaker": "Miles",
                    "text": "Como você pode ver, eu sou um guarda de Mondstadt."
                },
                {
                    "id": "614490203",
                    "speaker": "Miles",
                    "text": "Proteger as pessoas, os viajantes e os comerciantes são os meus deveres."
                }
            ]
        },
        {
            "talkId": "6144903",
            "initDialog": "614490301",
            "dialogues": [
                {
                    "id": "614490301",
                    "speaker": "Player",
                    "text": "Adeus."
                },
                {
                    "id": "614490302",
                    "speaker": "Miles",
                    "text": "Até mais, Viajante."
                },
                {
                    "id": "614490303",
                    "speaker": "Miles",
                    "text": "Vai com cuidado."
                }
            ]
        },
        {
            "talkId": "6144904",
            "initDialog": "614490401",
            "dialogues": [
                {
                    "id": "614490401",
                    "speaker": "Miles",
                    "text": "Estamos enfrentando mudanças climáticas anormais. Está perigoso lá fora. É recomendado que os habitantes procurem por abrigos subterrâneos."
                }
            ]
        },
        {
            "talkId": "6144905",
            "initDialog": "614490501",
            "dialogues": [
                {
                    "id": "614490501",
                    "speaker": "Miles",
                    "text": "O dragão pode voltar a qualquer momento. Os Cavaleiros de Favonius ficarão de olho, portanto, os habitantes não devem perder tempo."
                }
            ]
        },
        {
            "talkId": "6144906",
            "initDialog": "614490601",
            "dialogues": [
                {
                    "id": "614490601",
                    "speaker": "Miles",
                    "text": "Isso é uma emergência. Por favor, tenham em mente que a prioridade dos Cavaleiros de Favonius é garantir a segurança de todos na cidade."
                }
            ]
        }
    ]
}