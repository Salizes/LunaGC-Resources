{
    "groupId": "6030",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Erinle": 11,
        "Player": 3
    },
    "talks": [
        {
            "talkId": "6603001",
            "initDialog": "660300101",
            "dialogues": [
                {
                    "id": "660300101",
                    "speaker": "Erinle",
                    "text": "Oi, um momento, por favor."
                },
                {
                    "id": "660300102",
                    "speaker": "Erinle",
                    "text": "Por favor, responda sem pensar. Quando foi sua última inspeção médica?"
                }
            ]
        },
        {
            "talkId": "6603002",
            "initDialog": "660300201",
            "dialogues": [
                {
                    "id": "660300201",
                    "speaker": "Player",
                    "text": "Erm, provavelmente..."
                },
                {
                    "id": "660300202",
                    "speaker": "Erinle",
                    "text": "Heh, você hesitou."
                },
                {
                    "id": "660300203",
                    "speaker": "Erinle",
                    "text": "Não diga mais nada. Arrume um tempo, encontre um médico e vá fazer uns exames."
                },
                {
                    "id": "660300204",
                    "speaker": "Erinle",
                    "text": "Você pode pensar que estou dizendo isso só para te assustar, mas você provavelmente não sabe quantos competidores só acabam sabendo de grandes problemas de saúde momentos antes de competirem."
                },
                {
                    "id": "660300205",
                    "speaker": "Erinle",
                    "text": "É uma lástima quando males pequenos e negligenciados se transformam em algo mais sério, arruinando todo aquele trabalho duro que dedicaram ao treinamento."
                },
                {
                    "id": "660300206",
                    "speaker": "Erinle",
                    "text": "E mesmo que você não seja um guerreiro, ainda precisa ir ao médico regularmente!"
                },
                {
                    "id": "660300207",
                    "speaker": "Erinle",
                    "text": "Você deveria saber que uma pessoa sem saúde não é diferente de uma tribo sem pessoas."
                }
            ]
        },
        {
            "talkId": "6603003",
            "initDialog": "660300301",
            "dialogues": [
                {
                    "id": "660300301",
                    "speaker": "Player",
                    "text": "Irei imediatamente!"
                },
                {
                    "id": "660300302",
                    "speaker": "Erinle",
                    "text": "Tudo certo, então!"
                }
            ]
        },
        {
            "talkId": "7591601",
            "initDialog": "759160101",
            "dialogues": [
                {
                    "id": "759160101",
                    "speaker": "Player",
                    "text": "E-Eu entendo."
                },
                {
                    "id": "759160102",
                    "speaker": "Erinle",
                    "text": "Ótimo. Outra pessoa convencida."
                },
                {
                    "id": "759160103",
                    "speaker": "Erinle",
                    "text": "Nada pior do que esperar até você estar colhendo o que plantou sem ter como fugir."
                }
            ]
        }
    ]
}