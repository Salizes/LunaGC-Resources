        },
        {
            "talkId": "6442902",
            "initDialog": "644290201",
            "dialogues": [
                {
                    "id": "644290201",
                    "speaker": "Player",
                    "text": "Você me reconhece?"
                },
                {
                    "id": "644290202",
                    "speaker": "Fouad",
                    "text": "Ah, vejo que adivinhei corretamente."
                },
                {
                    "id": "644290203",
                    "speaker": "Fouad",
                    "text": "O chefe comentou que você apareceria. Disse que é nosso novo companheiro."
                },
                {
                    "id": "644290204",
                    "speaker": "Fouad",
                    "text": "Você tem uma cara única, então te reconheci imediatamente."
                },
                {
                    "id": "644290205",
                    "speaker": "Fouad",
                    "text": "Bem, já que o chefe disse, acho que isso te faz nosso amigo. Os Eremitas te saúdam."
                }
            ]
        },
        {
            "talkId": "6442903",
            "initDialog": "644290301",
            "dialogues": [
                {
                    "id": "644290301",
                    "speaker": "Player",
                    "text": "Te vejo por aí."
                },
                {
                    "id": "644290302",
                    "speaker": "Fouad",
                    "text": "Cuide-se!"
                }
            ]
        }
    ]
