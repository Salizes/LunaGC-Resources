{
    "groupId": "9053",
    "total_dialogue_lines": 62,
    "speaker_counts": {
        "Player": 17,
        "Sayu": 45
    },
    "talks": [
        {
            "talkId": "6905301",
            "initDialog": "690530101",
            "dialogues": [
                {
                    "id": "690530101",
                    "speaker": "Sayu",
                    "text": "#Hoo-ah, {NICKNAME}."
                },
                {
                    "id": "690530102",
                    "speaker": "Sayu",
                    "text": "... Olá..."
                }
            ]
        },
        {
            "talkId": "6905302",
            "initDialog": "690530201",
            "dialogues": [
                {
                    "id": "690530201",
                    "speaker": "Player",
                    "text": "Você gosta daqui?"
                },
                {
                    "id": "690530202",
                    "speaker": "Sayu",
                    "text": "Sim, durmo muito bem."
                },
                {
                    "id": "690530203",
                    "speaker": "Sayu",
                    "text": "Não preciso me preocupar em ser chamada para o trabalho de repente."
                },
                {
                    "id": "690530204",
                    "speaker": "Sayu",
                    "text": "Mesmo se eu dormir o tempo todo, não haverá problema.",
                    "choices": [
                        {
                            "id": "690530205",
                            "text": "É ótimo que você goste daqui.",
                            "response": [
                                {
                                    "id": "690530206",
                                    "speaker": "Sayu",
                                    "text": "É claro. E aqui não há Tanuki."
                                },
                                {
                                    "id": "690530207",
                                    "speaker": "Sayu",
                                    "text": "Eu adorei."
                                }
                            ]
                        },
                        {
                            "id": "690530208",
                            "text": "Você pode vir mais vezes.",
                            "response": [
                                {
                                    "id": "690530209",
                                    "speaker": "Sayu",
                                    "text": "Ok, obrigada."
                                },
                                {
                                    "id": "690530210",
                                    "speaker": "Sayu",
                                    "text": "Então esta será minha primeira escolha quando eu faltar... quero dizer, quando eu tiver um dia de folga do trabalho."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6905303",
            "initDialog": "690530301",
            "dialogues": [
                {
                    "id": "690530301",
                    "speaker": "Player",
                    "text": "Quer conversar comigo?"
                },
                {
                    "id": "690530302",
                    "speaker": "Sayu",
                    "text": "Ótimo."
                },
                {
                    "id": "690530303",
                    "speaker": "Sayu",
                    "text": "Vou tentar ficar acordada...",
                    "choices": [
                        {
                            "id": "690530304",
                            "text": "Você dormiu o suficiente?",
                            "response": [
                                {
                                    "id": "690530305",
                                    "speaker": "Sayu",
                                    "text": "Agora que você perguntou, estou ficando com um pouco de sono de novo..."
                                },
                                {
                                    "id": "690530306",
                                    "speaker": "Sayu",
                                    "text": "...*bocejo*"
                                },
                                {
                                    "id": "690530307",
                                    "speaker": "Sayu",
                                    "text": "Não, eu tenho que aguentar firme..."
                                },
                                {
                                    "id": "690530311",
                                    "speaker": "Sayu",
                                    "text": "Se eu adormecer enquanto estou com você... estaria perdendo um tempo precioso."
                                },
                                {
                                    "id": "690530312",
                                    "speaker": "Player",
                                    "text": "E o seu trabalho?"
                                },
                                {
                                    "id": "690530313",
                                    "speaker": "Sayu",
                                    "text": "Está tudo bem..."
                                },
                                {
                                    "id": "690530314",
                                    "speaker": "Sayu",
                                    "text": "Meu trabalho é apenas um monte de tarefas sem muita relevância."
                                },
                                {
                                    "id": "690530315",
                                    "speaker": "Sayu",
                                    "text": "Não é tão importante quanto ficar aqui."
                                },
                                {
                                    "id": "690530316",
                                    "speaker": "Sayu",
                                    "text": "Eu posso dormir, e posso conversar com você..."
                                }
                            ]
                        },
                        {
                            "id": "690530308",
                            "text": "Se você está com sono, vá deitar.",
                            "response": [
                                {
                                    "id": "690530309",
                                    "speaker": "Sayu",
                                    "text": "Hmm, estou bem..."
                                },
                                {
                                    "id": "690530310",
                                    "speaker": "Sayu",
                                    "text": "*bocejo* ...não quero dormir agora..."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6905304",
            "initDialog": "690530401",
            "dialogues": [
                {
                    "id": "690530401",
                    "speaker": "Player",
                    "text": "Gostaria de fazer alguma coisa?"
                },
                {
                    "id": "690530402",
                    "speaker": "Sayu",
                    "text": "Se você tiver tempo..."
                },
                {
                    "id": "690530403",
                    "speaker": "Sayu",
                    "text": "Gostaria de plantar uma árvore comigo?"
                },
                {
                    "id": "690530404",
                    "speaker": "Player",
                    "text": "Plantar uma árvore?"
                },
                {
                    "id": "690530405",
                    "speaker": "Sayu",
                    "text": "Sim, vamos plantar uma enorme!"
                },
                {
                    "id": "690530406",
                    "speaker": "Sayu",
                    "text": "Maior do que todas aquelas árvores lá fora."
                },
                {
                    "id": "690530407",
                    "speaker": "Sayu",
                    "text": "Posso lhe ensinar um pouco de ninjutsu usando folhas."
                },
                {
                    "id": "690530408",
                    "speaker": "Sayu",
                    "text": "Ah, e todos seriam técnicas de fuga..."
                },
                {
                    "id": "690530409",
                    "speaker": "Sayu",
                    "text": "Hmm, porque fugir é muito importante! Especialmente ao enfrentar inimigos bem fortes!"
                },
                {
                    "id": "690530410",
                    "speaker": "Sayu",
                    "text": "Eu não quero que você se machuque..."
                },
                {
                    "id": "690530411",
                    "speaker": "Player",
                    "text": "Então conto com você para me ensinar."
                },
                {
                    "id": "690530412",
                    "speaker": "Sayu",
                    "text": "Deixe comigo."
                },
                {
                    "id": "690530413",
                    "speaker": "Sayu",
                    "text": "Depois disso, podemos subir na árvore para descansar."
                },
                {
                    "id": "690530414",
                    "speaker": "Sayu",
                    "text": "Sentar em um galho, sentir o vento..."
                },
                {
                    "id": "690530415",
                    "speaker": "Sayu",
                    "text": "*Bocejo* ... Só de pensar nisso... Fico com sono.",
                    "choices": [
                        {
                            "id": "690530416",
                            "text": "Boa noite, Sayu.",
                            "response": [
                                {
                                    "id": "690530418",
                                    "speaker": "Sayu",
                                    "text": "#Você também, {NICKNAME}."
                                },
                                {
                                    "id": "690530419",
                                    "speaker": "Sayu",
                                    "text": "*bocejo* ... Espero sonhar com você toda vez que dormir..."
                                }
                            ]
                        },
                        {
                            "id": "690530417",
                            "text": "Tenha bons sonhos, Sayu."
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6905305",
            "initDialog": "690530501",
            "dialogues": [
                {
                    "id": "690530501",
                    "speaker": "Player",
                    "text": "Bom dia."
                },
                {
                    "id": "690530502",
                    "speaker": "Sayu",
                    "text": "...Dia? Já é de manhã?"
                },
                {
                    "id": "690530503",
                    "speaker": "Sayu",
                    "text": "Hmm, ainda estou com sono."
                }
            ]
        },
        {
            "talkId": "6905306",
            "initDialog": "690530601",
            "dialogues": [
                {
                    "id": "690530601",
                    "speaker": "Player",
                    "text": "Boa noite, Sayu."
                },
                {
                    "id": "690530602",
                    "speaker": "Sayu",
                    "text": "#Boa noite, {NICKNAME}."
                },
                {
                    "id": "690530603",
                    "speaker": "Sayu",
                    "text": "Espero que você durma tão profundamente quanto eu."
                }
            ]
        },
        {
            "talkId": "6905307",
            "initDialog": "690530701",
            "dialogues": [
                {
                    "id": "690530701",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>Você se acostumou com esse lugar?</color>"
                }
            ]
        },
        {
            "talkId": "6905308",
            "initDialog": "690530801",
            "dialogues": [
                {
                    "id": "690530801",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>Você quer conversar comigo?</color>"
                }
            ]
        },
        {
            "talkId": "6905309",
            "initDialog": "690530901",
            "dialogues": [
                {
                    "id": "690530901",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>O que você gostaria de fazer?</color>"
                }
            ]
        },
        {
            "talkId": "6905310",
            "initDialog": "690531001",
            "dialogues": [
                {
                    "id": "690531001",
                    "speaker": "Sayu",
                    "text": "Esse lugar parece um bom esconderijo."
                },
                {
                    "id": "690531002",
                    "speaker": "Sayu",
                    "text": "Não serei descoberta por ninguém, e posso dormir o suficiente."
                },
                {
                    "id": "690531003",
                    "speaker": "Sayu",
                    "text": "Eu adorei esse lugar, obrigada!"
                }
            ]
        },
        {
            "talkId": "6905311",
            "initDialog": "690531101",
            "dialogues": [
                {
                    "id": "690531101",
                    "speaker": "Sayu",
                    "text": "O terreno na vila é muito complexo. Se eu dormir aqui, acho que não serei descoberta, não é?"
                },
                {
                    "id": "690531102",
                    "speaker": "Sayu",
                    "text": "As casas não são altas, e nem baixas. Posso até mesmo usá-las para praticar minhas habilidades de fuga."
                },
                {
                    "id": "690531103",
                    "speaker": "Sayu",
                    "text": "Que lugar ótimo..."
                }
            ]
        }
    ]
}