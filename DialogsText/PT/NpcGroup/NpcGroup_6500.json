{
    "groupId": "6500",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Motolinia": 10,
        "Player": 5
    },
    "talks": [
        {
            "talkId": "6650001",
            "initDialog": "665000101",
            "dialogues": [
                {
                    "id": "665000101",
                    "speaker": "Motolinia",
                    "text": "A linguagem das flores comunica a imprevisibilidade do destino. Segundo minha adivinhação, você deve estar aqui em busca da orientação das minhas \"flores\"..."
                }
            ]
        },
        {
            "talkId": "6650002",
            "initDialog": "665000201",
            "dialogues": [
                {
                    "id": "665000201",
                    "speaker": "Player",
                    "text": "Deixe-me ver suas flores."
                },
                {
                    "id": "665000202",
                    "speaker": "Motolinia",
                    "text": "Que você encontre seu destino."
                }
            ]
        },
        {
            "talkId": "6650003",
            "initDialog": "665000301",
            "dialogues": [
                {
                    "id": "665000301",
                    "speaker": "Player",
                    "text": "Você é...?"
                },
                {
                    "id": "665000302",
                    "speaker": "Motolinia",
                    "text": "Eu? Sou Motolinia, a que fala a linguagem das \"flores\". Em termos comuns, sou a proprietária dessa floricultura."
                }
            ]
        },
        {
            "talkId": "6650004",
            "initDialog": "665000401",
            "dialogues": [
                {
                    "id": "665000401",
                    "speaker": "Player",
                    "text": "Essas flores podem falar?"
                },
                {
                    "id": "665000402",
                    "speaker": "Motolinia",
                    "text": "Elas podem, mas não podem. Flores não podem falar, mas tudo sobre elas fala. Suas aparências podem revelar destino. Seu pólen pode expressar emoções. E seus botões podem adivinhar nossos finais."
                },
                {
                    "id": "665000403",
                    "speaker": "Motolinia",
                    "text": "E o que você precisa fazer para entendê-las é meramente ouvir com atenção..."
                }
            ]
        },
        {
            "talkId": "6650005",
            "initDialog": "665000501",
            "dialogues": [
                {
                    "id": "665000501",
                    "speaker": "Player",
                    "text": "Você tem alguma recomendação de flor?"
                },
                {
                    "id": "665000502",
                    "speaker": "Motolinia",
                    "text": "Flores fortes são atraídas a almas ardentes. Talvez uma que fique de pé com orgulho ao vento, como o Crisântemo Brilhante, seja uma companheira adequada para você."
                }
            ]
        },
        {
            "talkId": "6650007",
            "initDialog": "665000701",
            "dialogues": [
                {
                    "id": "665000701",
                    "speaker": "Player",
                    "text": "Desculpe, mas eu tenho que ir."
                },
                {
                    "id": "665000702",
                    "speaker": "Motolinia",
                    "text": "Fique bem. Como as \"flores\" preveem, nossos caminhos com certeza se cruzarão mais uma vez..."
                }
            ]
        },
        {
            "talkId": "6650008",
            "initDialog": "665000801",
            "dialogues": [
                {
                    "id": "665000801",
                    "speaker": "Motolinia",
                    "text": "Desafio de Aventura"
                }
            ]
        },
        {
            "talkId": "6650009",
            "initDialog": "665000901",
            "dialogues": [
                {
                    "id": "665000901",
                    "speaker": "Motolinia",
                    "text": "Tudo bem da orientação das \"flores\"..."
                }
            ]
        },
        {
            "talkId": "6650010",
            "initDialog": "665001001",
            "dialogues": [
                {
                    "id": "665001001",
                    "speaker": "Motolinia",
                    "text": "O que foi? Minha adivinhação errou?"
                }
            ]
        }
    ]
}