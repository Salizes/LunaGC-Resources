    "talks": [
        {
            "talkId": "6957201",
            "initDialog": "695720101",
            "dialogues": [
                {
                    "id": "695720101",
                    "speaker": "Chevreuse",
                    "text": "Esses jogos de carta são bem populares na Patrulha de Segurança e Monitoramento Especial. Vários de meus colegas gostam de comprar e trocá-las... Não vou impedir minha equipe de se envolver em um nível sensato de atividade recreativa, mas eu aviso a eles para jogarem com moderação."
                }
            ]
        },
        {
            "talkId": "6957202",
            "initDialog": "695720201",
            "dialogues": [
                {
                    "id": "695720201",
                    "speaker": "Player",
                    "text": "Que tal uma partida de Chamado Sagrado dos Sete?"
                }
            ]
        },
        {
            "talkId": "6957203",
            "initDialog": "695720301",
            "dialogues": [
                {
                    "id": "695720301",
                    "speaker": "Player",
                    "text": "No momento, preciso resolver outras coisas..."
                },
                {
                    "id": "695720302",
                    "speaker": "Chevreuse",
                    "text": "Adeus. Voltarei para o trabalho em breve. Tenho certeza que muito trabalho já se acumulou enquanto estive fora..."
                }
            ]
        },
        {
            "talkId": "6957204",
            "initDialog": "695720401",
            "dialogues": [
                {
                    "id": "695720401",
                    "speaker": "Chevreuse",
                    "text": "Não posso levar crédito por aquela vitória — apenas tive sorte. Poderia ter saído para qualquer lado."
                }
            ]
        },
        {
            "talkId": "6957205",
            "initDialog": "695720501",
            "dialogues": [
                {
                    "id": "695720501",
                    "speaker": "Chevreuse",
                    "text": "...É, não sou boa em jogos como esse. Ufa... E parece que meu tempo de descanso acabou."
                }
            ]
        },
        {
            "talkId": "6957206",
            "initDialog": "695720601",
            "dialogues": [
                {
                    "id": "695720601",
                    "speaker": "Chevreuse",
                    "text": "Vamos começar. Estou sempre preparada para uma batalha."
                }
            ]
        },
        {
            "talkId": "6957208",
            "initDialog": "695720801",
            "dialogues": [
                {
                    "id": "695720801",
                    "speaker": "Player",
                    "text": "Que tal uma partida de Chamado Sagrado dos Sete?"
                }
            ]
        },
        {
            "talkId": "6957209",
            "initDialog": "695720901",
            "dialogues": [
                {
                    "id": "695720901",
                    "speaker": "Player",
                    "text": "Ajuste o deck primeiro..."
                }
            ]
        },
        {
            "talkId": "6957210",
            "initDialog": "695721001",
            "dialogues": [
                {
                    "id": "695721001",
                    "speaker": "Chevreuse",
                    "text": "Ainda bem que eu estava bem preparada, senão teria perdido."
                }
            ]
        },
        {
            "talkId": "6957211",
            "initDialog": "695721101",
            "dialogues": [
                {
                    "id": "695721101",
                    "speaker": "Chevreuse",
                    "text": "...Perdi. Não consegui descobrir suas táticas."
                }
            ]
        },
        {
            "talkId": "6957212",
            "initDialog": "695721201",
            "dialogues": [
                {
                    "id": "695721201",
                    "speaker": "Chevreuse",
                    "text": "Treinamento extra? Sem problemas, estou dentro."
                }
            ]
        },
        {
            "talkId": "6957214",
            "initDialog": "695721401",
            "dialogues": [
                {
                    "id": "695721401",
                    "speaker": "Player",
                    "text": "Que tal uma partida de Chamado Sagrado dos Sete?"
                }
            ]
        },
        {
            "talkId": "6957215",
            "initDialog": "695721501",
            "dialogues": [
                {
                    "id": "695721501",
                    "speaker": "Player",
                    "text": "Ajuste o deck primeiro..."
                }
            ]
        },
        {
            "talkId": "6957216",
            "initDialog": "695721601",
            "dialogues": [
                {
                    "id": "695721601",
                    "speaker": "Chevreuse",
                    "text": "Se você quiser uma chance de corrigir seus erros táticos, estou disposta a jogar outra partida."
                }
            ]
        },
        {
            "talkId": "6957217",
            "initDialog": "695721701",
            "dialogues": [
                {
                    "id": "695721701",
                    "speaker": "Chevreuse",
                    "text": "Você ganhou. Cometi erros demais e estraguei minhas chances."
                }
            ]
        },
        {
            "talkId": "6957218",
            "initDialog": "695721801",
            "dialogues": [
                {
                    "id": "695721801",
                    "speaker": "Player",
                    "text": "No momento, preciso resolver outras coisas..."
                }
            ]
        }
    ]
