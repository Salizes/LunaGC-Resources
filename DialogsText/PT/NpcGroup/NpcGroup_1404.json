            "dialogues": [
                {
                    "id": "4015140401",
                    "speaker": "Quinn",
                    "text": "Três maçãs por 1 Mora...?"
                },
                {
                    "id": "4015140402",
                    "speaker": "Quinn",
                    "text": "O que ela está pensando... *hic*",
                    "choices": [
                        {
                            "id": "4015140403",
                            "text": "Quem é você?",
                            "response": [
                                {
                                    "id": "4015140407",
                                    "speaker": "Quinn",
                                    "text": "*hic* Ah, é você..."
                                },
                                {
                                    "id": "4015140408",
                                    "speaker": "Quinn",
                                    "text": "Isso mesmo. Eu sou Quinn, da Fruteira de Quinn. Minha tenda fica em..."
                                },
                                {
                                    "id": "4015140409",
                                    "speaker": "Quinn",
                                    "text": "Frutas frescas apenas nas... Frutas de Quinn..."
                                },
                                {
                                    "id": "4015140410",
                                    "speaker": "Quinn",
                                    "text": "Espera aí... Já nos conhecemos antes?"
                                },
                                {
                                    "id": "4015140411",
                                    "speaker": "Quinn",
                                    "text": "#(Estou me sentindo meio tont{M#o}{F#a}...)"
                                },
                                {
                                    "id": "4015140405",
                                    "speaker": "Player",
                                    "text": "Maçãs..."
                                },
                                {
                                    "id": "4015140417",
                                    "speaker": "Quinn",
                                    "text": "*Hic* Sem frutas na noite... Sem descontos também..."
                                },
                                {
                                    "id": "4015140418",
                                    "speaker": "Quinn",
                                    "text": "*Hic* Volte sempre..."
                                }
                            ]
                        },
                        {
                            "id": "4015140404",
                            "text": "Quem é ela?",
                            "response": [
                                {
                                    "id": "4015140412",
                                    "speaker": "Quinn",
                                    "text": "Oh, vá perguntar a Bea."
                                },
                                {
                                    "id": "4015140413",
                                    "speaker": "Quinn",
                                    "text": "Não sei o que ela está pensando."
                                },
                                {
                                    "id": "4015140414",
                                    "speaker": "Quinn",
                                    "text": "Barganhando comigo todos os dias... Mesmo que ela seja minha amiga próxima..."
                                },
                                {
                                    "id": "4015140415",
                                    "speaker": "Quinn",
                                    "text": "Eu não conseguiria vender três maçãs a ela nem que fosse por 1 Mora, mesmo se eu quisesse..."
                                },
                                {
                                    "id": "4015140416",
                                    "speaker": "Quinn",
                                    "text": "Você concorda, certo? *hic*"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
