    "talks": [
        {
            "talkId": "4001230",
            "initDialog": "400123001",
            "dialogues": [
                {
                    "id": "400123001",
                    "speaker": "Diluc",
                    "text": "Andar sozinho pela costa a esta hora da noite parece solitário.",
                    "choices": [
                        {
                            "id": "400123002",
                            "text": "Você quer conversar?",
                            "response": [
                                {
                                    "id": "400123003",
                                    "speaker": "Diluc",
                                    "text": "Combinado.",
                                    "choices": [
                                        {
                                            "id": "400123004",
                                            "text": "Sobre as cartas estranhas...",
                                            "response": [
                                                {
                                                    "id": "400123005",
                                                    "speaker": "Diluc",
                                                    "text": "Eu estava cético em relação à carta desde o início."
                                                },
                                                {
                                                    "id": "400123006",
                                                    "speaker": "Diluc",
                                                    "text": "Mas, por cautela, perguntei aos outros sobre isso. Com certeza, eu não era o único destinatário."
                                                },
                                                {
                                                    "id": "400123007",
                                                    "speaker": "Diluc",
                                                    "text": "Este é claramente um ato premeditado. O objetivo da parte responsável ainda não foi revelado, por isso vim aqui para investigar."
                                                },
                                                {
                                                    "id": "400123008",
                                                    "speaker": "Diluc",
                                                    "text": "Agora que eu estou aqui, você pode relaxar.",
                                                    "choices": [
                                                        {
                                                            "id": "400123004",
                                                            "text": "Sobre as cartas estranhas..."
                                                        },
                                                        {
                                                            "id": "400123013",
                                                            "text": "Conte-me sobre você...",
                                                            "response": [
                                                                {
                                                                    "id": "400123014",
                                                                    "speaker": "Diluc",
                                                                    "text": "Eu? Meus assuntos dificilmente merecem ser discutidos."
                                                                },
                                                                {
                                                                    "id": "400123015",
                                                                    "speaker": "Diluc",
                                                                    "text": "Ao contrário, estou mais preocupado com a sua situação."
                                                                },
                                                                {
                                                                    "id": "400123016",
                                                                    "speaker": "Diluc",
                                                                    "text": "Como você tem estado? Acostumando-se à vida na ilha?"
                                                                },
                                                                {
                                                                    "id": "400123017",
                                                                    "speaker": "Player",
                                                                    "text": "Não é nada mal."
                                                                },
                                                                {
                                                                    "id": "400123018",
                                                                    "speaker": "Diluc",
                                                                    "text": "Se você precisar de ajuda, venha me procurar a qualquer momento."
                                                                },
                                                                {
                                                                    "id": "400123019",
                                                                    "speaker": "Diluc",
                                                                    "text": "E se você encontrar alguma pista, entre em contato comigo imediatamente."
                                                                },
                                                                {
                                                                    "id": "400123020",
                                                                    "speaker": "Diluc",
                                                                    "text": "Por falar nisso, a Klee acabou de me pedir para ajudá-la a pescar. Venha comigo, se você quiser.",
                                                                    "choices": [
                                                                        {
                                                                            "id": "400123004",
                                                                            "text": "Sobre as cartas estranhas..."
                                                                        },
                                                                        {
                                                                            "id": "400123013",
                                                                            "text": "Conte-me sobre você..."
                                                                        },
                                                                        {
                                                                            "id": "400123021",
                                                                            "text": "Sobre o que aconteceu hoje...",
                                                                            "response": [
                                                                                {
                                                                                    "id": "400123022",
                                                                                    "speaker": "Diluc",
                                                                                    "text": "Hoje? ...Oh, você quis dizer aquilo."
                                                                                },
                                                                                {
                                                                                    "id": "400123023",
                                                                                    "speaker": "Diluc",
                                                                                    "text": "Acontecimentos frívolos não merecem sua atenção."
                                                                                },
                                                                                {
                                                                                    "id": "400123024",
                                                                                    "speaker": "Diluc",
                                                                                    "text": "E quanto ao Kaeya... Hnf, ele parece estar de bom humor."
                                                                                },
                                                                                {
                                                                                    "id": "400123025",
                                                                                    "speaker": "Diluc",
                                                                                    "text": "Mesmo depois de todos estes anos, ele ainda gosta do verão tanto quanto gostava quando era criança.",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "400123004",
                                                                                            "text": "Sobre as cartas estranhas..."
                                                                                        },
                                                                                        {
                                                                                            "id": "400123013",
                                                                                            "text": "Conte-me sobre você..."
                                                                                        },
                                                                                        {
                                                                                            "id": "400123021",
                                                                                            "text": "Sobre o que aconteceu hoje..."
                                                                                        },
                                                                                        {
                                                                                            "id": "400123026",
                                                                                            "text": "Não vou lhe incomodar mais.",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "400123027",
                                                                                                    "speaker": "Diluc",
                                                                                                    "text": "Boa noite, descanse um pouco."
                                                                                                }
                                                                                            ]
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "400123026",
                                                                            "text": "Não vou lhe incomodar mais."
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "400123021",
                                                            "text": "Sobre o que aconteceu hoje..."
                                                        },
                                                        {
                                                            "id": "400123026",
                                                            "text": "Não vou lhe incomodar mais."
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "400123013",
                                            "text": "Conte-me sobre você..."
                                        },
                                        {
                                            "id": "400123021",
                                            "text": "Sobre o que aconteceu hoje..."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "400123026",
                            "text": "Não vou lhe incomodar mais."
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "4001314",
            "initDialog": "400131401",
            "dialogues": [
                {
                    "id": "400131401",
                    "speaker": "Diluc",
                    "text": "Então foi essa mulher o tempo todo. Eu poderia ter percebido."
                },
                {
                    "id": "400131402",
                    "speaker": "Diluc",
                    "text": "A Sra. Alice é a única pessoa em Mondstadt capaz de fazer isso... Ela e aquele bardo."
                },
                {
                    "id": "400131403",
                    "speaker": "Diluc",
                    "text": "As cartas eram na verdade convites. E nós fomos todos convidados a vir até aqui."
                },
                {
                    "id": "400131404",
                    "speaker": "Diluc",
                    "text": "Ah... Isso significa que para ela, todos nós ainda somos umas crianças."
                },
                {
                    "id": "400131405",
                    "speaker": "Diluc",
                    "text": "Há muito tempo que ninguém me tratava como uma criança."
                }
            ]
        }
    ]
