            "dialogues": [
                {
                    "id": "621050101",
                    "speaker": "Jingda",
                    "text": "...*Suspiro*"
                },
                {
                    "id": "621050102",
                    "speaker": "Jingda",
                    "text": "Por que tenho tanto azar, que de todas as pessoas com quem você poderia ter falado, você me escolheu?"
                }
            ]
        },
        {
            "talkId": "6210502",
            "initDialog": "621050201",
            "dialogues": [
                {
                    "id": "621050201",
                    "speaker": "Player",
                    "text": "O que foi...?"
                },
                {
                    "id": "621050202",
                    "speaker": "Jingda",
                    "text": "Nada. A vida é exaustiva o suficiente por si mesma. Depois, há a conversa com as pessoas, o que requer força cerebral, que cansa ainda mais!"
                },
                {
                    "id": "621050203",
                    "speaker": "Jingda",
                    "text": "Ah, minha existência é tão trágica..."
                }
            ]
        },
        {
            "talkId": "6210503",
            "initDialog": "621050301",
            "dialogues": [
                {
                    "id": "621050301",
                    "speaker": "Player",
                    "text": "Ah, desculpe..."
                },
                {
                    "id": "621050302",
                    "speaker": "Jingda",
                    "text": "Então está tudo bem? Isso é ótimo..."
                }
            ]
        }
    ]
