    },
    "talks": [
        {
            "talkId": "6601201",
            "initDialog": "660120101",
            "dialogues": [
                {
                    "id": "660120101",
                    "speaker": "Vitusov",
                    "text": "Meia hora para terminar uma porção tripla de \"Montanha, Mar e Céu\"... Acha que é possível?"
                }
            ]
        },
        {
            "talkId": "6601202",
            "initDialog": "660120201",
            "dialogues": [
                {
                    "id": "660120201",
                    "speaker": "Player",
                    "text": "Deixa eu tentar."
                },
                {
                    "id": "660120202",
                    "speaker": "Vitusov",
                    "text": "Também acho!"
                },
                {
                    "id": "660120203",
                    "speaker": "Vitusov",
                    "text": "Antes de vir para Natlan, eu me preocupava um pouco de não conseguir comer a comida local."
                },
                {
                    "id": "660120204",
                    "speaker": "Vitusov",
                    "text": "Mas parece que eu estava exagerando! Uma boa refeição grande e de alta-caloria é exatamente o que eu precisava."
                },
                {
                    "id": "660120205",
                    "speaker": "Vitusov",
                    "text": "Espera, me deixa pensar nisso... Já é hora de experimentar esse desafio de tempo limitado de deixar pratos limpos."
                }
            ]
        },
        {
            "talkId": "6601203",
            "initDialog": "660120301",
            "dialogues": [
                {
                    "id": "660120301",
                    "speaker": "Player",
                    "text": "Não dê um passo maior que a perna."
                },
                {
                    "id": "660120302",
                    "speaker": "Vitusov",
                    "text": "Ok, entendido."
                }
            ]
        }
    ]
}