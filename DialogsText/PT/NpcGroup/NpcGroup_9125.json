{
    "groupId": "9125",
    "total_dialogue_lines": 98,
    "speaker_counts": {
        "Columbina": 61,
        "Player": 37
    },
    "talks": [
        {
            "talkId": "6912501",
            "initDialog": "691250101",
            "dialogues": [
                {
                    "id": "691250101",
                    "speaker": "Columbina",
                    "text": "Olá."
                },
                {
                    "id": "691250102",
                    "speaker": "Columbina",
                    "text": "Este é o seu jardim, então é a minha vez de cumprimentar você primeiro."
                }
            ]
        },
        {
            "talkId": "6912502",
            "initDialog": "691250201",
            "dialogues": [
                {
                    "id": "691250201",
                    "speaker": "Player",
                    "text": "Está se acomodando bem?"
                },
                {
                    "id": "691250202",
                    "speaker": "Columbina",
                    "text": "Hmm... Na verdade, não."
                },
                {
                    "id": "691250203",
                    "speaker": "Player",
                    "text": "Ah... Está barulhento demais aqui?"
                },
                {
                    "id": "691250204",
                    "speaker": "Columbina",
                    "text": "Não, não é isso."
                },
                {
                    "id": "691250205",
                    "speaker": "Columbina",
                    "text": "#É só que... você já foi m{M#eu}{F#inha} convidad{M#o}{F#a} tantas vezes até agora. Agora que, de repente, eu é que sou a convidada, não estou muito acostumada a isso."
                },
                {
                    "id": "691250206",
                    "speaker": "Columbina",
                    "text": "#O que eu devo fazer? Conversar com você? Ou talvez jogar algo junt{M#o}{F#a}s?",
                    "choices": [
                        {
                            "id": "691250207",
                            "text": "Pense neste lugar como sua \"casa\"...",
                            "response": [
                                {
                                    "id": "691250209",
                                    "speaker": "Columbina",
                                    "text": "Sério? Hmm... Nesse caso, posso sair por aí, cantando enquanto caminho?"
                                },
                                {
                                    "id": "691250210",
                                    "speaker": "Player",
                                    "text": "Claro que pode."
                                },
                                {
                                    "id": "691250211",
                                    "speaker": "Columbina",
                                    "text": "Posso tirar uma soneca em qualquer lugar que eu escolher, se eu quiser descansar?"
                                },
                                {
                                    "id": "691250212",
                                    "speaker": "Player",
                                    "text": "É só gritar se precisar de um travesseiro."
                                },
                                {
                                    "id": "691250213",
                                    "speaker": "Columbina",
                                    "text": "E também estaria tudo bem colher algumas das plantas que você plantou? Sabe, como você às vezes faz com a Prata Lunar no Saguão da Lua Prateada?",
                                    "choices": [
                                        {
                                            "id": "691250214",
                                            "text": "Então você sabia o tempo todo...",
                                            "response": [
                                                {
                                                    "id": "691250216",
                                                    "speaker": "Columbina",
                                                    "text": "Haha, é só uma brincadeira. Contanto que elas ajudem você na sua jornada, eu jamais me oporia."
                                                },
                                                {
                                                    "id": "691250217",
                                                    "speaker": "Columbina",
                                                    "text": "Você criou um ambiente muito agradável aqui. Já me basta poder aproveitá-lo em paz."
                                                },
                                                {
                                                    "id": "691250218",
                                                    "speaker": "Columbina",
                                                    "text": "Fico pensando... devo tentar decorar o Saguão da Lua Prateada também?"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "691250215",
                                            "text": "Então, você vem guardando rancor..."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "691250208",
                            "text": "Faça o que tiver vontade."
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6912503",
            "initDialog": "691250301",
            "dialogues": [
                {
                    "id": "691250301",
                    "speaker": "Player",
                    "text": "Gostaria de conversar?"
                },
                {
                    "id": "691250302",
                    "speaker": "Columbina",
                    "text": "Certo. Mas talvez eu precise que você comece a conversa. Eu normalmente não converso muito com as pessoas."
                },
                {
                    "id": "691250303",
                    "speaker": "Columbina",
                    "text": "Mesmo quando eu estava com os Fatui, eu geralmente ficava sentada em um canto durante as reuniões e evitava participar dos debates."
                },
                {
                    "id": "691250304",
                    "speaker": "Columbina",
                    "text": "A maioria dos assuntos era entediante mesmo. Um quer isso, outro quer lutar por aquilo... E ninguém cedia nem um pouco."
                },
                {
                    "id": "691250305",
                    "speaker": "Player",
                    "text": "(Acho que ela começou a conversa muito bem...)"
                },
                {
                    "id": "691250306",
                    "speaker": "Columbina",
                    "text": "Mais irritante era como às vezes vinham pedir a minha opinião."
                },
                {
                    "id": "691250307",
                    "speaker": "Columbina",
                    "text": "Meus olhos estão sempre fechados, então eles presumiam que eu estava ouvindo em silêncio. Na verdade, na maior parte do tempo eu estava ou dormindo, ou simplesmente sem pensar em nada."
                },
                {
                    "id": "691250308",
                    "speaker": "Columbina",
                    "text": "Mas responder nunca foi um problema. Em momentos assim, eu escolhia um dos que tinham feito a pergunta e dizia que ele estava certo. Isso sempre funcionava."
                },
                {
                    "id": "691250309",
                    "speaker": "Columbina",
                    "text": "Se o Magnata e o Galo estivessem discutindo, eu tomaria o partido do Galo. E se o Dottore e a Arlecchino estivessem presos em um debate, eu ficaria do lado da Arlecchino."
                },
                {
                    "id": "691250310",
                    "speaker": "Columbina",
                    "text": "O Capitano estava sempre com a razão e, embora Sandrone pudesse ser bem teimosa, em geral, ela também estava certa."
                },
                {
                    "id": "691250311",
                    "speaker": "Columbina",
                    "text": "E se o Capitano e Sandrone me perguntassem ao mesmo tempo? Hmm... Isso era bem raro. E se isso realmente acontecesse... eu diria que os dois lados tinham razão."
                },
                {
                    "id": "691250312",
                    "speaker": "Columbina",
                    "text": "Ambos são muito decididos. A minha opinião não alteraria o julgamento deles."
                },
                {
                    "id": "691250313",
                    "speaker": "Columbina",
                    "text": "...Hmmmm? Sobre o que você queria falar comigo, mesmo...?",
                    "choices": [
                        {
                            "id": "691250314",
                            "text": "Ah, não se preocupe. Nós estamos indo muito bem.",
                            "response": [
                                {
                                    "id": "691250316",
                                    "speaker": "Columbina",
                                    "text": "É mesmo? Bom, fico feliz que você esteja se divertindo."
                                },
                                {
                                    "id": "691250317",
                                    "speaker": "Columbina",
                                    "text": "Na verdade, eu prefiro conversar com kuuhenki do que com humanos."
                                },
                                {
                                    "id": "691250318",
                                    "speaker": "Columbina",
                                    "text": "O modo como pensam é puro e simples, e eles não escondem seus pensamentos."
                                },
                                {
                                    "id": "691250319",
                                    "speaker": "Columbina",
                                    "text": "\"Vamos brincar\", \"Me conta uma história\", \"Quero dormir\", \"Tem algo legal ali\"..."
                                },
                                {
                                    "id": "691250320",
                                    "speaker": "Columbina",
                                    "text": "Através dos olhos deles, o mundo é simples e belo."
                                }
                            ]
                        },
                        {
                            "id": "691250315",
                            "text": "Você também é uma excelente contadora de histórias..."
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6912504",
            "initDialog": "691250401",
            "dialogues": [
                {
                    "id": "691250401",
                    "speaker": "Player",
                    "text": "Tem algo que você gostaria de fazer?"
                },
                {
                    "id": "691250402",
                    "speaker": "Columbina",
                    "text": "Hum... Já estou aqui como sua convidada. Será mesmo adequado fazer você atender aos meus pedidos também?",
                    "choices": [
                        {
                            "id": "691250403",
                            "text": "Tudo bem.",
                            "response": [
                                {
                                    "id": "691250405",
                                    "speaker": "Columbina",
                                    "text": "Muito bem, então. Na verdade, eu tenho sim algo com o qual preciso de ajuda."
                                },
                                {
                                    "id": "691250406",
                                    "speaker": "Player",
                                    "text": "#Sou tod{M#o}{F#a} ouvidos."
                                },
                                {
                                    "id": "691250407",
                                    "speaker": "Columbina",
                                    "text": "A Lauma disse que vai me apresentar aos Filhos da Lua Gelada de hoje em dia, na esperança de que eu consiga me integrar a essa família."
                                },
                                {
                                    "id": "691250408",
                                    "speaker": "Columbina",
                                    "text": "Fico feliz por ela ter dito isso, mas... também estou um pouco preocupada."
                                },
                                {
                                    "id": "691250409",
                                    "speaker": "Player",
                                    "text": "Com o que você está preocupada?"
                                },
                                {
                                    "id": "691250410",
                                    "speaker": "Columbina",
                                    "text": "Eu raramente interajo com desconhecidos, então temo não ser capaz de manter uma conversa. Não quero deixá-los desconfortáveis."
                                },
                                {
                                    "id": "691250411",
                                    "speaker": "Columbina",
                                    "text": "Você poderia me ajudar a... ensaiar? Ou melhor, a simular situações que eu possa vir a encontrar."
                                },
                                {
                                    "id": "691250412",
                                    "speaker": "Player",
                                    "text": "O que eu preciso fazer, exatamente?"
                                },
                                {
                                    "id": "691250413",
                                    "speaker": "Columbina",
                                    "text": "É simples. Faça as perguntas que os Filhos da Lua Gelada poderiam fazer e eu vou responder. Se a minha resposta não for adequada, avise-me.",
                                    "choices": [
                                        {
                                            "id": "691250414",
                                            "text": "Sinceramente, tudo o que você precisa fazer é ser você mesma...",
                                            "response": [
                                                {
                                                    "id": "691250415",
                                                    "speaker": "Columbina",
                                                    "text": "Eu sei. Mas esta é uma oportunidade rara, e eu quero me dar melhor com eles, então..."
                                                },
                                                {
                                                    "id": "691250417",
                                                    "speaker": "Columbina",
                                                    "text": "Então vamos começar."
                                                },
                                                {
                                                    "id": "691250418",
                                                    "speaker": "Player",
                                                    "text": "Você vai nos deixar de novo, Senhora Deusa da Lua?"
                                                },
                                                {
                                                    "id": "691250419",
                                                    "speaker": "Columbina",
                                                    "text": "Vou.",
                                                    "choices": [
                                                        {
                                                            "id": "691250420",
                                                            "text": "...Hã?",
                                                            "response": [
                                                                {
                                                                    "id": "691250422",
                                                                    "speaker": "Columbina",
                                                                    "text": "Hmm? Eu vou viajar, não vou? Isso quer dizer que vou embora.",
                                                                    "choices": [
                                                                        {
                                                                            "id": "691250423",
                                                                            "text": "Você precisa ser clara quando se trata dessas coisas...",
                                                                            "response": [
                                                                                {
                                                                                    "id": "691250425",
                                                                                    "speaker": "Columbina",
                                                                                    "text": "Ah. Entendi. Serei clara.",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "691250426",
                                                                                            "text": "E só por via das dúvidas...",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "691250428",
                                                                                                    "speaker": "Columbina",
                                                                                                    "text": "Claro."
                                                                                                },
                                                                                                {
                                                                                                    "id": "691250429",
                                                                                                    "speaker": "Player",
                                                                                                    "text": "Poderia abençoar meu pedido de casamento, para que seja aceito?"
                                                                                                },
                                                                                                {
                                                                                                    "id": "691250430",
                                                                                                    "speaker": "Columbina",
                                                                                                    "text": "Não."
                                                                                                },
                                                                                                {
                                                                                                    "id": "691250431",
                                                                                                    "speaker": "Player",
                                                                                                    "text": "Poderia abençoar minha criança para que ela cresça mais?"
                                                                                                },
                                                                                                {
                                                                                                    "id": "691250432",
                                                                                                    "speaker": "Columbina",
                                                                                                    "text": "Se por acaso seu filho for um Cervo de Chifre de Gelo..."
                                                                                                },
                                                                                                {
                                                                                                    "id": "691250433",
                                                                                                    "speaker": "Player",
                                                                                                    "text": "Em casos assim, você também pode simplesmente dizer que não."
                                                                                                },
                                                                                                {
                                                                                                    "id": "691250434",
                                                                                                    "speaker": "Columbina",
                                                                                                    "text": "Muito bem. Não."
                                                                                                },
                                                                                                {
                                                                                                    "id": "691250435",
                                                                                                    "speaker": "Player",
                                                                                                    "text": "Há algum convidado que você gostaria de chamar para nos visitar?"
                                                                                                },
                                                                                                {
                                                                                                    "id": "691250436",
                                                                                                    "speaker": "Columbina",
                                                                                                    "text": "Sandrone dos Fatui, e Arlecchino também. Elas estão bem curiosas sobre a minha vida aqui."
                                                                                                },
                                                                                                {
                                                                                                    "id": "691250437",
                                                                                                    "speaker": "Player",
                                                                                                    "text": "É... isso talvez não caia muito bem..."
                                                                                                },
                                                                                                {
                                                                                                    "id": "691250438",
                                                                                                    "speaker": "Columbina",
                                                                                                    "text": "Hã...? Elas não podem? Eles não iriam aprovar?"
                                                                                                },
                                                                                                {
                                                                                                    "id": "691250439",
                                                                                                    "speaker": "Player",
                                                                                                    "text": "O que eu estou dizendo é que isso não cairia muito bem com os Filhos da Lua Gelada..."
                                                                                                },
                                                                                                {
                                                                                                    "id": "691250440",
                                                                                                    "speaker": "Columbina",
                                                                                                    "text": "Entendo. Nesse caso, eu gostaria de convidar Maalaus, o Sr. Albedo e a Srta. Nicole."
                                                                                                },
                                                                                                {
                                                                                                    "id": "691250441",
                                                                                                    "speaker": "Columbina",
                                                                                                    "text": "Maalaus e o Sr. Albedo são artistas talentosos, enquanto a Srta. Nicole é uma escritora brilhante. Eu gostaria que eles registrassem as vidas felizes que os Filhos da Lua Gelada levam hoje."
                                                                                                },
                                                                                                {
                                                                                                    "id": "691250442",
                                                                                                    "speaker": "Player",
                                                                                                    "text": "Uma excelente ideia."
                                                                                                },
                                                                                                {
                                                                                                    "id": "691250443",
                                                                                                    "speaker": "Columbina",
                                                                                                    "text": "Sim, e quanto à Sandrone e à Arlecchino, vou dar um jeito de trazê-las às escondidas quando surgir a oportunidade."
                                                                                                },
                                                                                                {
                                                                                                    "id": "691250444",
                                                                                                    "speaker": "Player",
                                                                                                    "text": "Agora, isso... é algo que você não pode dizer."
                                                                                                },
                                                                                                {
                                                                                                    "id": "691250445",
                                                                                                    "speaker": "Columbina",
                                                                                                    "text": "Sim. E não direi."
                                                                                                },
                                                                                                {
                                                                                                    "id": "691250446",
                                                                                                    "speaker": "Columbina",
                                                                                                    "text": "Hmm... Minhas respostas ainda não são boas o bastante, né?"
                                                                                                },
                                                                                                {
                                                                                                    "id": "691250447",
                                                                                                    "speaker": "Columbina",
                                                                                                    "text": "Se tivermos a oportunidade, pratique mais comigo."
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "691250427",
                                                                                            "text": "Deixe-me fazer algumas perguntas sobre as tradições..."
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "691250424",
                                                                            "text": "Não é desse tipo de \"ir embora\" que eles estavam falando..."
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "691250421",
                                                            "text": "V-você vai...?"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "691250416",
                                            "text": "Entendido."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "691250404",
                            "text": "É assim que recebo os meus convidados."
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6912505",
            "initDialog": "691250501",
            "dialogues": [
                {
                    "id": "691250501",
                    "speaker": "Player",
                    "text": "Bom dia, Columbina!"
                },
                {
                    "id": "691250502",
                    "speaker": "Columbina",
                    "text": "Bom dia. Que você tenha sucesso em sua jornada hoje."
                },
                {
                    "id": "691250503",
                    "speaker": "Columbina",
                    "text": "Embora a lua agora tenha se ocultado, esta bênção permanecerá com você por mim."
                }
            ]
        },
        {
            "talkId": "6912506",
            "initDialog": "691250601",
            "dialogues": [
                {
                    "id": "691250601",
                    "speaker": "Player",
                    "text": "Boa noite, Columbina."
                },
                {
                    "id": "691250602",
                    "speaker": "Columbina",
                    "text": "Boa noite. Vou fazer o possível para não cantar enquanto você estiver dormindo."
                }
            ]
        },
        {
            "talkId": "6912510",
            "initDialog": "691251001",
            "dialogues": [
                {
                    "id": "691251001",
                    "speaker": "Columbina",
                    "text": "Você transportou o Saguão da Lua Prateada até aqui para mim?"
                },
                {
                    "id": "691251002",
                    "speaker": "Columbina",
                    "text": "Hmm, não. É como um reflexo na água? Que lindo. Isso traz de volta tantas memórias bonitas."
                },
                {
                    "id": "691251003",
                    "speaker": "Columbina",
                    "text": "Acho que agora só está faltando a minha canção."
                }
            ]
        },
        {
            "talkId": "6912511",
            "initDialog": "691251101",
            "dialogues": [
                {
                    "id": "691251101",
                    "speaker": "Columbina",
                    "text": "Ah, você também tem estes aqui. Esses tambores são os instrumentos favoritos dos kuuhenki."
                },
                {
                    "id": "691251102",
                    "speaker": "Columbina",
                    "text": "Eu costumava me preocupar que eles se empolgassem e se machucassem, mas, como se estivessem rufando alto para afastar minhas preocupações, eles tocaram ainda mais forte."
                },
                {
                    "id": "691251103",
                    "speaker": "Columbina",
                    "text": "Pode me ensinar como fazer um? Tenho certeza de que aquelas crianças ficariam felizes em receber um de presente."
                }
            ]
        }
    ]
}