    "talks": [
        {
            "talkId": "4001226",
            "initDialog": "400122601",
            "dialogues": [
                {
                    "id": "400122601",
                    "speaker": "Barbara",
                    "text": "#{F#Cavaleira}{M#Cavaleiro} Honorável, você chegou na hora certa, quer contemplar o mar junto comigo?",
                    "choices": [
                        {
                            "id": "400122602",
                            "text": "Você quer conversar?",
                            "response": [
                                {
                                    "id": "400122603",
                                    "speaker": "Barbara",
                                    "text": "Certo! Há alguma coisa sobre a qual você queria falar?",
                                    "choices": [
                                        {
                                            "id": "400122604",
                                            "text": "Conte-me sobre o Ludi Harpastum...",
                                            "response": [
                                                {
                                                    "id": "400122605",
                                                    "speaker": "Barbara",
                                                    "text": "#Você provavelmente já está familiarizad{M#o}{F#a}, mas Ludi Harpastum é um festival tradicional de Mondstadt."
                                                },
                                                {
                                                    "id": "400122606",
                                                    "speaker": "Barbara",
                                                    "text": "Durante as festividades, jogamos belos e coloridos Harpastums no ar. É como nós celebramos o Arconte Anemo e mandamos alegria para ele. É um festival para todas as idades!"
                                                },
                                                {
                                                    "id": "400122607",
                                                    "speaker": "Barbara",
                                                    "text": "Klee adora o Ludi Harpastum. Mesmo assim, ele ainda não chegou... Então eu a fiz um Harpastum especial."
                                                },
                                                {
                                                    "id": "400122608",
                                                    "speaker": "Barbara",
                                                    "text": "Espero que isso a anime. Ela tem um sorriso tão contagioso, não posso deixar de sorrir quando a vejo... É uma ótima sensação.",
                                                    "choices": [
                                                        {
                                                            "id": "400122604",
                                                            "text": "Conte-me sobre o Ludi Harpastum..."
                                                        },
                                                        {
                                                            "id": "400122609",
                                                            "text": "Conte-me sobre essas ilhas...",
                                                            "response": [
                                                                {
                                                                    "id": "400122610",
                                                                    "speaker": "Barbara",
                                                                    "text": "Sei que minha irmã está sempre nos dizendo para mantermos nossa guarda, mas para mim, estas ilhas são muito divertidas."
                                                                },
                                                                {
                                                                    "id": "400122611",
                                                                    "speaker": "Barbara",
                                                                    "text": "Sentada na praia, olhando para o céu estrelado de verão, cantarolando ao longo das ondas que balançam..."
                                                                },
                                                                {
                                                                    "id": "400122612",
                                                                    "speaker": "Barbara",
                                                                    "text": "É tão romântico..."
                                                                },
                                                                {
                                                                    "id": "400122613",
                                                                    "speaker": "Barbara",
                                                                    "text": "E com você aqui, o verão parece muito mais especial.",
                                                                    "choices": [
                                                                        {
                                                                            "id": "400122604",
                                                                            "text": "Conte-me sobre o Ludi Harpastum..."
                                                                        },
                                                                        {
                                                                            "id": "400122609",
                                                                            "text": "Conte-me sobre essas ilhas..."
                                                                        },
                                                                        {
                                                                            "id": "400122614",
                                                                            "text": "Conte-me sobre você...",
                                                                            "response": [
                                                                                {
                                                                                    "id": "400122615",
                                                                                    "speaker": "Barbara",
                                                                                    "text": "Oh... Eu?"
                                                                                },
                                                                                {
                                                                                    "id": "400122616",
                                                                                    "speaker": "Barbara",
                                                                                    "text": "Bem, eu-eu... Na verdade, eu..."
                                                                                },
                                                                                {
                                                                                    "id": "400122617",
                                                                                    "speaker": "Barbara",
                                                                                    "text": "*Suspiro* Você quer saber a verdade?"
                                                                                },
                                                                                {
                                                                                    "id": "400122618",
                                                                                    "speaker": "Barbara",
                                                                                    "text": "Só vim para as ilhas por preocupação com a segurança de todos... Embora deva admitir que também não queria perder a viagem junto com todos vocês."
                                                                                },
                                                                                {
                                                                                    "id": "400122619",
                                                                                    "speaker": "Barbara",
                                                                                    "text": "E-eu espero que você não ria de mim. Afinal, uma Diaconisa não deve se envolver com assuntos de diversão e jogos..."
                                                                                },
                                                                                {
                                                                                    "id": "400122620",
                                                                                    "speaker": "Player",
                                                                                    "text": "Eu não ousaria."
                                                                                },
                                                                                {
                                                                                    "id": "400122621",
                                                                                    "speaker": "Barbara",
                                                                                    "text": "Ufa... Agradeço.",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "400122604",
                                                                                            "text": "Conte-me sobre o Ludi Harpastum..."
                                                                                        },
                                                                                        {
                                                                                            "id": "400122609",
                                                                                            "text": "Conte-me sobre essas ilhas..."
                                                                                        },
                                                                                        {
                                                                                            "id": "400122614",
                                                                                            "text": "Conte-me sobre você..."
                                                                                        },
                                                                                        {
                                                                                            "id": "400122622",
                                                                                            "text": "Sobre o que aconteceu hoje...",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "400122623",
                                                                                                    "speaker": "Barbara",
                                                                                                    "text": "Eu não sabia que os outros estariam aqui também. Foi bom ver todos juntos assim."
                                                                                                },
                                                                                                {
                                                                                                    "id": "400122624",
                                                                                                    "speaker": "Barbara",
                                                                                                    "text": "Quero aproveitar esta oportunidade para me aproximar de todos... especialmente da minha irmã."
                                                                                                },
                                                                                                {
                                                                                                    "id": "400122625",
                                                                                                    "speaker": "Barbara",
                                                                                                    "text": "Pode ser apenas sua personalidade, mas ela sempre está muito ocupada. Ela tem muitas responsabilidades."
                                                                                                },
                                                                                                {
                                                                                                    "id": "400122626",
                                                                                                    "speaker": "Barbara",
                                                                                                    "text": "Espero que ela tenha mais tempo para si mesma e possa relaxar um pouco mais... No mínimo, espero poder fazê-la feliz quando eu estiver por perto."
                                                                                                },
                                                                                                {
                                                                                                    "id": "400122627",
                                                                                                    "speaker": "Barbara",
                                                                                                    "text": "Será que devo cantar uma música para ela? Hmm...",
                                                                                                    "choices": [
                                                                                                        {
                                                                                                            "id": "400122604",
                                                                                                            "text": "Conte-me sobre o Ludi Harpastum..."
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "400122609",
                                                                                                            "text": "Conte-me sobre essas ilhas..."
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "400122614",
                                                                                                            "text": "Conte-me sobre você..."
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "400122622",
                                                                                                            "text": "Sobre o que aconteceu hoje..."
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "400122628",
                                                                                                            "text": "Não vou lhe incomodar mais.",
                                                                                                            "response": [
                                                                                                                {
                                                                                                                    "id": "400122629",
                                                                                                                    "speaker": "Barbara",
                                                                                                                    "text": "Sim, em breve nos veremos de novo!"
                                                                                                                }
                                                                                                            ]
                                                                                                        }
                                                                                                    ]
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "400122628",
                                                                                            "text": "Não vou lhe incomodar mais."
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "400122622",
                                                                            "text": "Sobre o que aconteceu hoje..."
                                                                        },
                                                                        {
                                                                            "id": "400122628",
                                                                            "text": "Não vou lhe incomodar mais."
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "400122614",
                                                            "text": "Conte-me sobre você..."
                                                        },
                                                        {
                                                            "id": "400122622",
                                                            "text": "Sobre o que aconteceu hoje..."
                                                        },
                                                        {
                                                            "id": "400122628",
                                                            "text": "Não vou lhe incomodar mais."
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "400122609",
                                            "text": "Conte-me sobre essas ilhas..."
                                        },
                                        {
                                            "id": "400122614",
                                            "text": "Conte-me sobre você..."
                                        },
                                        {
                                            "id": "400122622",
                                            "text": "Sobre o que aconteceu hoje..."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "400122628",
                            "text": "Não vou lhe incomodar mais."
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "4001310",
            "initDialog": "400131001",
            "dialogues": [
                {
                    "id": "400131001",
                    "speaker": "Barbara",
                    "text": "Incrível! Toda essa ilha é, na verdade, um presente?"
                },
                {
                    "id": "400131002",
                    "speaker": "Barbara",
                    "text": "#Cavaleir{F#a}{M#o} Honorável, eu me sinto tão comovida... Mesmo que não tenha relação direta comigo, eu me sinto muito comovida."
                },
                {
                    "id": "400131003",
                    "speaker": "Barbara",
                    "text": "Quando duas pessoas passam muito tempo juntas, elas se tornam uma pessoa querida uma da outra..."
                },
                {
                    "id": "400131004",
                    "speaker": "Barbara",
                    "text": "Eu percebi muitas coisas."
                }
            ]
        }
    ]
}