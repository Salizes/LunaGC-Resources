    "talks": [
        {
            "talkId": "6424001",
            "initDialog": "642400101",
            "dialogues": [
                {
                    "id": "642400101",
                    "speaker": "Aranakin",
                    "text": "#Ah! É {F#a}{M#o} amig{F#a}{M#o} Nara, ol...olá..."
                }
            ]
        },
        {
            "talkId": "6424002",
            "initDialog": "642400201",
            "dialogues": [
                {
                    "id": "642400201",
                    "speaker": "Player",
                    "text": "Olá..."
                },
                {
                    "id": "642400202",
                    "speaker": "Aranakin",
                    "text": "#Pouc{F#as}{M#os} Nara visitam Vanarana, mas {F#as}{M#os} que assim fazem, são amig{F#as}{M#os} de Aranara."
                },
                {
                    "id": "642400203",
                    "speaker": "Aranakin",
                    "text": "#Aranakin lhe dá as boas-vindas... Nunca antes vist{M#o}{F#a} amig{F#a}{M#o} Nara."
                }
            ]
        },
        {
            "talkId": "6424003",
            "initDialog": "642400301",
            "dialogues": [
                {
                    "id": "642400301",
                    "speaker": "Player",
                    "text": "Adeus..."
                },
                {
                    "id": "642400302",
                    "speaker": "Aranakin",
                    "text": "#Adeus, amig{F#a}{M#o} Nara."
                }
            ]
        },
        {
            "talkId": "6424004",
            "initDialog": "642400401",
            "dialogues": [
                {
                    "id": "642400401",
                    "speaker": "Aranakin",
                    "text": "#Ah, \"Kusava\"! \"Branca Voadora\"~ Nara {NICKNAME} e Branca Voadora, junt{F#as}{M#os} a cantar~"
                }
            ]
        },
        {
            "talkId": "6424005",
            "initDialog": "642400501",
            "dialogues": [
                {
                    "id": "642400501",
                    "speaker": "Player",
                    "text": "Sobre cantar..."
                },
                {
                    "id": "642400502",
                    "speaker": "Aranakin",
                    "text": "Esta é a canção que Aranakin cantou após a chegada do \"Cogumelo Zohrah\" na história que você contou."
                },
                {
                    "id": "642400503",
                    "speaker": "Aranakin",
                    "text": "#Mesmo que Aranakin não se lembre, contudo, as árvores e gramas da floresta devem se lembrar desta canção após ouvi-la. Aranakin os disse uma vez: Nara {NICKNAME} é uma semente incrível, e é amig{F#a}{M#o} de Aranakin."
                }
            ]
        },
        {
            "talkId": "6424006",
            "initDialog": "642400601",
            "dialogues": [
                {
                    "id": "642400601",
                    "speaker": "Player",
                    "text": "Sobre Khayyam..."
                },
                {
                    "id": "642400602",
                    "speaker": "Aranakin",
                    "text": "Nara Khayyam... Eu tinha esquecido seu nome. Ele também não nos vê mais, não é?"
                },
                {
                    "id": "642400603",
                    "speaker": "Aranakin",
                    "text": "Embora não consiga mais me encontrar com ele, contarei a floresta e ao vento sobre ele através de canções, sua marca será deixada."
                },
                {
                    "id": "642400604",
                    "speaker": "Aranakin",
                    "text": "Assim, não esquecerei seu nome novamente."
                }
            ]
        },
        {
            "talkId": "6424007",
            "initDialog": "642400701",
            "dialogues": [
                {
                    "id": "642400701",
                    "speaker": "Player",
                    "text": "Adeus."
                },
                {
                    "id": "642400702",
                    "speaker": "Aranakin",
                    "text": "#Adeus, amig{F#a}{M#o} de Aranakin."
                }
            ]
        }
    ]
}