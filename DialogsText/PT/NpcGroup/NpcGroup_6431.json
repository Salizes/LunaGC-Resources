    "talks": [
        {
            "talkId": "5900241",
            "initDialog": "590024101",
            "dialogues": [
                {
                    "id": "590024101",
                    "speaker": "Player",
                    "text": "Há alguma coisa notável por perto?"
                }
            ]
        },
        {
            "talkId": "5900242",
            "initDialog": "590024201",
            "dialogues": [
                {
                    "id": "590024201",
                    "speaker": "Pahua",
                    "text": "Deixa eu pensar... Hmm, acho que não existe nada que você vá achar particularmente interessante, mas, sabe o que dizem, \"é descansando que se ganha\" — às vezes é bom relaxar."
                }
            ]
        },
        {
            "talkId": "6643101",
            "initDialog": "664310101",
            "dialogues": [
                {
                    "id": "664310101",
                    "speaker": "Pahua",
                    "text": "Escolha o equipamento certo para trabalhar mais facilmente."
                }
            ]
        },
        {
            "talkId": "6643102",
            "initDialog": "664310201",
            "dialogues": [
                {
                    "id": "664310201",
                    "speaker": "Player",
                    "text": "O que você está vendendo?"
                },
                {
                    "id": "664310202",
                    "speaker": "Pahua",
                    "text": "Equipamento de treino."
                },
                {
                    "id": "664310203",
                    "speaker": "Pahua",
                    "text": "Mas... Bem, olhando para você, acho que você está longe de precisar desse tipo de equipamento de iniciante."
                }
            ]
        },
        {
            "talkId": "6643103",
            "initDialog": "664310301",
            "dialogues": [
                {
                    "id": "664310301",
                    "speaker": "Player",
                    "text": "Até mais."
                },
                {
                    "id": "664310302",
                    "speaker": "Pahua",
                    "text": "Sim, até mais."
                }
            ]
        },
        {
            "talkId": "6643104",
            "initDialog": "664310401",
            "dialogues": [
                {
                    "id": "664310401",
                    "speaker": "Player",
                    "text": "O que você quer dizer?"
                },
                {
                    "id": "664310402",
                    "speaker": "Pahua",
                    "text": "Exatamente o que eu disse. Sou uma treinadora de educação física com um bom olho para os níveis de habilidade e necessidades dos meus clientes."
                },
                {
                    "id": "664310403",
                    "speaker": "Pahua",
                    "text": "Eu só recomendo equipamento que eu ache que vá ajudar, e você me parece estar acima da média dos fanáticos por condicionamento físico, estou certa? Nada que eu tenho aqui te desafiará o bastante."
                },
                {
                    "id": "664310404",
                    "speaker": "Pahua",
                    "text": "Contudo, se você estiver procurando comprar algo para um amigo, então talvez eu possa ajudar. Só me diga em que tipo de condição física ele está e eu farei o resto."
                }
            ]
        },
        {
            "talkId": "6643105",
            "initDialog": "664310501",
            "dialogues": [
                {
                    "id": "664310501",
                    "speaker": "Pahua",
                    "text": "Duelo"
                }
            ]
        },
        {
            "talkId": "6643106",
            "initDialog": "664310601",
            "dialogues": [
                {
                    "id": "664310601",
                    "speaker": "Pahua",
                    "text": "Hmm, parece que você deveria considerar ajustar o seu deck."
                }
            ]
        },
        {
            "talkId": "6643107",
            "initDialog": "664310701",
            "dialogues": [
                {
                    "id": "664310701",
                    "speaker": "Pahua",
                    "text": "Que deck forte... É perfeito para alguém com suas habilidades."
                }
            ]
        }
    ]
}