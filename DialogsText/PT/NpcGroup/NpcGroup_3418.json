    "talks": [
        {
            "talkId": "6341801",
            "initDialog": "634180101",
            "dialogues": [
                {
                    "id": "634180101",
                    "speaker": "Taisiya",
                    "text": "Há muito tempo, eu participei de um banquete aqui. Até mesmo pude ver o Czar Belyi em pessoa..."
                },
                {
                    "id": "634180102",
                    "speaker": "Pletnyov",
                    "text": "Céus, Taisiya, veja essas decorações..."
                },
                {
                    "id": "634180103",
                    "speaker": "Taisiya",
                    "text": "*Suspiro* Pletnyov..."
                },
                {
                    "id": "634180104",
                    "speaker": "Pletnyov",
                    "text": "Acho que aquele candelabro ali é maior do que eu... Céus..."
                },
                {
                    "id": "634180105",
                    "speaker": "Taisiya",
                    "text": "Certo, certo, já chega. Pelo menos não fale tão alto, ou então vou ter que fingir que não te conheço!"
                },
                {
                    "id": "634180106",
                    "speaker": "Pletnyov",
                    "text": "O que houve?"
                },
                {
                    "id": "634180107",
                    "speaker": "Taisiya",
                    "text": "Isso me deixa envergonhada..."
                }
            ]
        }
    ]
}