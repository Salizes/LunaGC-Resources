    },
    "talks": [
        {
            "talkId": "6444201",
            "initDialog": "644420101",
            "dialogues": [
                {
                    "id": "644420101",
                    "speaker": "Rashnu",
                    "text": "O Oásis Vourukasha é ótimo, mas Barsom também é muito bom..."
                }
            ]
        },
        {
            "talkId": "6444202",
            "initDialog": "644420201",
            "dialogues": [
                {
                    "id": "644420201",
                    "speaker": "Player",
                    "text": "Sobre Barsom..."
                },
                {
                    "id": "644420202",
                    "speaker": "Rashnu",
                    "text": "É um lugar tranquilo, adequado para um bom sono."
                },
                {
                    "id": "644420203",
                    "speaker": "Rashnu",
                    "text": "... As Pari dormem de um jeito diferente de humanos."
                },
                {
                    "id": "644420204",
                    "speaker": "Rashnu",
                    "text": "O sono ajuda a melhorar o foco. *Ronco* Ajuda você a sentir suas raízes e galhos com mais clareza."
                }
            ]
        },
        {
            "talkId": "6444203",
            "initDialog": "644420301",
            "dialogues": [
                {
                    "id": "644420301",
                    "speaker": "Player",
                    "text": "Sobre o Tambor Kory..."
                },
                {
                    "id": "644420302",
                    "speaker": "Rashnu",
                    "text": "Um instrumento humano. Um que é extremamente barulhento."
                }
            ]
        },
        {
            "talkId": "6444204",
            "initDialog": "644420401",
            "dialogues": [
                {
                    "id": "644420401",
                    "speaker": "Player",
                    "text": "Não lhe incomodarei mais."
                },
                {
                    "id": "644420402",
                    "speaker": "Rashnu",
                    "text": "*Ronco*..."
                }
            ]
        },
        {
            "talkId": "6444205",
            "initDialog": "644420501",
            "dialogues": [
                {
                    "id": "644420501",
                    "speaker": "Rashnu",
                    "text": "*Ronco* *Ronco* Hã? Você está com Sorush?"
                }
            ]
        },
        {
            "talkId": "6444206",
            "initDialog": "644420601",
            "dialogues": [
                {
                    "id": "644420601",
                    "speaker": "Player",
                    "text": "Você estava dormindo?"
                },
                {
                    "id": "644420602",
                    "speaker": "Rashnu",
                    "text": "Descansar também é um dever..."
                },
                {
                    "id": "644420603",
                    "speaker": "Rashnu",
                    "text": "O Oásis Vourukasha é um lugar maravilhoso. Já faz algum tempo desde que estive aqui, mas tudo ainda parece familiar."
                }
            ]
        },
        {
            "talkId": "6444207",
            "initDialog": "644420701",
            "dialogues": [
                {
                    "id": "644420701",
                    "speaker": "Player",
                    "text": "Sobre Sorush..."
                },
                {
                    "id": "644420702",
                    "speaker": "Rashnu",
                    "text": "Só por me acordar apenas para algo tão importante... Eu já a perdoei."
                },
                {
                    "id": "644420703",
                    "speaker": "Rashnu",
                    "text": "O crédito por extinguir o Sinal de Apaosha pertence a Sorush... e de todos os que a ajudaram."
                },
                {
                    "id": "644420704",
                    "speaker": "Rashnu",
                    "text": "Embora a situação possa não ser como ela esperava, acho que as circunstâncias atuais são melhores."
                }
            ]
        },
        {
            "talkId": "6444208",
            "initDialog": "644420801",
            "dialogues": [
                {
                    "id": "644420801",
                    "speaker": "Player",
                    "text": "Não lhe incomodarei mais."
                },
                {
                    "id": "644420802",
                    "speaker": "Rashnu",
                    "text": "*Ronco*..."
                }
            ]
        }
    ]
}