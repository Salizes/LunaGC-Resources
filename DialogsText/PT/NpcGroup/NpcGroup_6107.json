        "Player": 3
    },
    "talks": [
        {
            "talkId": "6610701",
            "initDialog": "661070101",
            "dialogues": [
                {
                    "id": "661070101",
                    "speaker": "Hakau",
                    "text": "Quem imaginava que seria tão difícil viver tão nas alturas todos os dias..."
                },
                {
                    "id": "661070102",
                    "speaker": "Hakau",
                    "text": "Me pergunto qual é a sensação de ser balançado de um lado a outro por um Yumkassauro."
                }
            ]
        },
        {
            "talkId": "6610702",
            "initDialog": "661070201",
            "dialogues": [
                {
                    "id": "661070201",
                    "speaker": "Player",
                    "text": "Bem legal, hein?"
                },
                {
                    "id": "661070202",
                    "speaker": "Hakau",
                    "text": "Oh, você quer dizer o prazer de ir e vir livremente?"
                },
                {
                    "id": "661070203",
                    "speaker": "Hakau",
                    "text": "Hmm... Você acha que flutuar no ar é meio como nadar na água?"
                },
                {
                    "id": "661070204",
                    "speaker": "Hakau",
                    "text": "Então eu meio que consigo entender."
                }
            ]
        },
        {
            "talkId": "6610703",
            "initDialog": "661070301",
            "dialogues": [
                {
                    "id": "661070301",
                    "speaker": "Player",
                    "text": "Bem doloroso, hein?"
                },
                {
                    "id": "661070302",
                    "speaker": "Hakau",
                    "text": "Sério? Então, os Descendentes das Copas não estão sempre... se envolvendo em práticas espirituais todos os dias?"
                },
                {
                    "id": "661070303",
                    "speaker": "Hakau",
                    "text": "Oh... Não é à toa que seus guerreiros são tão fortes... Muito melhor do que pessoas como nós, que só sabem alguns truques baratos de lava..."
                }
            ]
        },
        {
            "talkId": "6610704",
            "initDialog": "661070401",
            "dialogues": [
                {
                    "id": "661070401",
                    "speaker": "Player",
                    "text": "Por que não tenta você?"
                },
                {
                    "id": "661070402",
                    "speaker": "Hakau",
                    "text": "Você tem um bom ponto."
                }
            ]
        }
    ]
}