    "talks": [
        {
            "talkId": "6651301",
            "initDialog": "665130101",
            "dialogues": [
                {
                    "id": "665130101",
                    "speaker": "Kanei",
                    "text": "Hmm... Com isso, o pedido deve estar quase pronto."
                }
            ]
        },
        {
            "talkId": "6651302",
            "initDialog": "665130201",
            "dialogues": [
                {
                    "id": "665130201",
                    "speaker": "Player",
                    "text": "Que pedido?"
                },
                {
                    "id": "665130202",
                    "speaker": "Kanei",
                    "text": "Só alguns pedidos de lembrancinhas. Agora que o resort abriu para os negócios, estamos ficando sem estoque de muitas de nossas mercadorias, incluindo as nossas bonecas."
                },
                {
                    "id": "665130203",
                    "speaker": "Kanei",
                    "text": "Mas, graças a você, com certeza conseguiremos concluir esse pedido sem nenhum problema."
                }
            ]
        },
        {
            "talkId": "6651303",
            "initDialog": "665130301",
            "dialogues": [
                {
                    "id": "665130301",
                    "speaker": "Player",
                    "text": "Que lugar é esse?"
                },
                {
                    "id": "665130302",
                    "speaker": "Kanei",
                    "text": "Esta é a oficina de pintura do resort. Somos responsáveis por fornecer tintas para grafite, além de colorir algumas bonecas e lembrancinhas."
                }
            ]
        },
        {
            "talkId": "6651304",
            "initDialog": "665130401",
            "dialogues": [
                {
                    "id": "665130401",
                    "speaker": "Player",
                    "text": "Você está cuidando disso sozinho?"
                },
                {
                    "id": "665130402",
                    "speaker": "Kanei",
                    "text": "Eu tenho um aprendiz e alguns Asha por perto para ajudar. Asha amam cores, e amam brincar com as cores também."
                },
                {
                    "id": "665130403",
                    "speaker": "Kanei",
                    "text": "O fato de essa oficina poder atender as necessidades de pintura do resort é graças a esses carinhas."
                }
            ]
        },
        {
            "talkId": "6651308",
            "initDialog": "665130801",
            "dialogues": [
                {
                    "id": "665130801",
                    "speaker": "Player",
                    "text": "Até mais."
                },
                {
                    "id": "665130802",
                    "speaker": "Kanei",
                    "text": "Você parece estar se divertindo!"
                }
            ]
        }
    ]
}