        {
            "talkId": "6208402",
            "initDialog": "620840201",
            "dialogues": [
                {
                    "id": "620840201",
                    "speaker": "Player",
                    "text": "Senhorita?"
                },
                {
                    "id": "620840202",
                    "speaker": "Barqueira",
                    "text": "..."
                },
                {
                    "id": "620840203",
                    "speaker": "Player",
                    "text": "...Ela está bem?"
                },
                {
                    "id": "620840204",
                    "speaker": "Barqueira",
                    "text": "... Você... Está falando comigo?"
                },
                {
                    "id": "620840205",
                    "speaker": "Barqueira",
                    "text": "Em Liyue, geralmente não é habitual que as pessoas falem conosco sobre a Funerária Wangsheng."
                },
                {
                    "id": "620840206",
                    "speaker": "Barqueira",
                    "text": "#Então... Você é um forasteir{F#a}{M#o}? Ou \"outra coisa\"?",
                    "choices": [
                        {
                            "id": "620840207",
                            "text": "Você está certo, não sou daqui.",
                            "response": [
                                {
                                    "id": "620840208",
                                    "speaker": "Barqueira",
                                    "text": "Entendi, olá."
                                },
                                {
                                    "id": "620840209",
                                    "speaker": "Barqueira",
                                    "text": "Eu trabalho na Funerária de Wangsheng. Pensando bem, não falo com ninguém que não seja de lá há muito tempo."
                                },
                                {
                                    "id": "620840210",
                                    "speaker": "Barqueira",
                                    "text": "Mesmo quando eu estou trabalhando, eu não falo com os membros de outros familiares em respeito às tradições antigas."
                                },
                                {
                                    "id": "620840211",
                                    "speaker": "Barqueira",
                                    "text": "Quando a noite cai, a família deixa de lado o que é necessário e algumas coisas para comer e depois se retira para seus quartos, onde fecha bem as portas. Eu, então, faço meus negócios em silêncio, preparando as cinzas antes de me despedir."
                                },
                                {
                                    "id": "620840212",
                                    "speaker": "Barqueira",
                                    "text": "Então é muito raro que alguém venha falar comigo à noite. Perdoe-me, eu não estava ignorando você intencionalmente."
                                }
                            ]
                        },
                        {
                            "id": "620840213",
                            "text": "Isso mesmo, é \"outra coisa\"...",
                            "response": [
                                {
                                    "id": "620840214",
                                    "speaker": "Barqueira",
                                    "text": "...Será que é possível?"
                                },
                                {
                                    "id": "620840215",
                                    "speaker": "Barqueira",
                                    "text": "Eu olho a morte diretamente nos olhos enquanto os outros não ousam."
                                },
                                {
                                    "id": "620840216",
                                    "speaker": "Barqueira",
                                    "text": "Eu não tenho nada a ver com o que o trouxe até aqui."
                                },
                                {
                                    "id": "620840217",
                                    "speaker": "Barqueira",
                                    "text": "Eu não tenho nada a ver com o lugar para onde você irá."
                                },
                                {
                                    "id": "620840218",
                                    "speaker": "Barqueira",
                                    "text": "Vá, alma perdida. Para a luz."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
