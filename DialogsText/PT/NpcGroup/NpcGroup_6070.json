    "talks": [
        {
            "talkId": "6607001",
            "initDialog": "660700101",
            "dialogues": [
                {
                    "id": "660700101",
                    "speaker": "Yelafath",
                    "text": "#Bem-vind{M#o}{F#a} à Rede de Atlahua!"
                }
            ]
        },
        {
            "talkId": "6607002",
            "initDialog": "660700201",
            "dialogues": [
                {
                    "id": "660700201",
                    "speaker": "Player",
                    "text": "O que você vende por aqui?"
                },
                {
                    "id": "660700202",
                    "speaker": "Yelafath",
                    "text": "Em sua maioria, equipamentos para pesca. É como dizem, se há água, há peixe, e muitos vem até a nossa tribo justamente para isso."
                },
                {
                    "id": "660700203",
                    "speaker": "Yelafath",
                    "text": "Graças a eles, os negócios são ótimos! Se a sua vara está quebrada, eu também posso consertá-la!"
                },
                {
                    "id": "660700204",
                    "speaker": "Yelafath",
                    "text": "Sou ótima com trabalhos manuais, então também vendo algumas pequenas insígnias e ornamentos."
                },
                {
                    "id": "660700205",
                    "speaker": "Yelafath",
                    "text": "Muitos turistas querem levar algumas lembrancinhas, então também faço trabalhos personalizados — se você quiser colocar seu nome ou coisa parecida, eu posso fazer isso, facílimo!"
                }
            ]
        },
        {
            "talkId": "6607003",
            "initDialog": "660700301",
            "dialogues": [
                {
                    "id": "660700301",
                    "speaker": "Player",
                    "text": "Adeus."
                },
                {
                    "id": "660700302",
                    "speaker": "Yelafath",
                    "text": "Até mais, volte em breve!"
                }
            ]
        },
        {
            "talkId": "6607004",
            "initDialog": "660700401",
            "dialogues": [
                {
                    "id": "660700401",
                    "speaker": "Yelafath",
                    "text": "Duelo"
                }
            ]
        },
        {
            "talkId": "6607005",
            "initDialog": "660700501",
            "dialogues": [
                {
                    "id": "660700501",
                    "speaker": "Yelafath",
                    "text": "Desculpe, mas esta vitória é minha!"
                }
            ]
        },
        {
            "talkId": "6607006",
            "initDialog": "660700601",
            "dialogues": [
                {
                    "id": "660700601",
                    "speaker": "Yelafath",
                    "text": "Hehe, eu perdi. Vamos jogar novamente da próxima vez!"
                }
            ]
        }
    ]
}