    "talks": [
        {
            "talkId": "6765901",
            "initDialog": "676590101",
            "dialogues": [
                {
                    "id": "676590101",
                    "speaker": "Anleifr",
                    "text": "O que quer que aconteça, temos que proteger esse entreposto!"
                }
            ]
        },
        {
            "talkId": "6765902",
            "initDialog": "676590201",
            "dialogues": [
                {
                    "id": "676590201",
                    "speaker": "Player",
                    "text": "#Obrigad{F#a}{M#o} pelo trabalho duro."
                },
                {
                    "id": "676590202",
                    "speaker": "Anleifr",
                    "text": "Oh, não foi nada! Não sou comparável ao Capitão."
                },
                {
                    "id": "676590203",
                    "speaker": "Anleifr",
                    "text": "Oh, pensando bem, ele ainda está naquela idade em que está crescendo. No nosso próximo jantar, devo insistir que ele sente e coma, ao invés de ficar zanzando como de costume."
                }
            ]
        },
        {
            "talkId": "6765903",
            "initDialog": "676590301",
            "dialogues": [
                {
                    "id": "676590301",
                    "speaker": "Player",
                    "text": "(<color=#FFCC33FF>Illuga</color> parece ter algo que quer dizer...?)"
                },
                {
                    "id": "676590302",
                    "speaker": "Illuga",
                    "text": "Certo. Você viu algo de incomum por aqui?"
                },
                {
                    "id": "676590303",
                    "speaker": "Anleifr",
                    "text": "Não, senhor. Nada de anormal. Mas estou de olhos abertos, não precisa se preocupar."
                },
                {
                    "id": "676590304",
                    "speaker": "Illuga",
                    "text": "Certo, se algo aparecer, reporte assim que pduer."
                },
                {
                    "id": "676590305",
                    "speaker": "Anleifr",
                    "text": "Sim, senhor!"
                }
            ]
        },
        {
            "talkId": "6765904",
            "initDialog": "676590401",
            "dialogues": [
                {
                    "id": "676590401",
                    "speaker": "Player",
                    "text": "#Obrigad{M#o}{F#a} pelo seu tempo."
                },
                {
                    "id": "676590402",
                    "speaker": "Anleifr",
                    "text": "Nenhum problema. Até a próxima."
                }
            ]
        }
    ]
