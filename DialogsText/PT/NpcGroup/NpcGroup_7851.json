                {
                    "id": "678510101",
                    "speaker": "Guseva",
                    "text": "Não há nada a fazer a não ser esperar..."
                }
            ]
        },
        {
            "talkId": "6785102",
            "initDialog": "678510201",
            "dialogues": [
                {
                    "id": "678510201",
                    "speaker": "Player",
                    "text": "Pelo que você tá esperando?"
                },
                {
                    "id": "678510202",
                    "speaker": "Guseva",
                    "text": "Estou esperando pelo próximo carregamento de minério de cristal chegar. Estou esperando a situação de Sretomorozsk retornar ao normal, assim o próximo trem vai chegar e me levar daqui."
                }
            ]
        },
        {
            "talkId": "6785103",
