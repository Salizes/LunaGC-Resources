    "dialogues": [
        {
            "id": "615350301",
            "speaker": "Player",
            "text": "O que tem ali?"
        },
        {
            "id": "615350302",
            "speaker": "Ernest",
            "text": "A cave da Adega do Alvorecer. O que eu estaria fazendo aqui de outra forma?"
        },
        {
            "id": "615350303",
            "speaker": "Ernest",
            "text": "Deixe-me lhe dizer, nem pense que vai conseguir roubar o nosso vinho..."
        },
        {
            "id": "615350304",
            "speaker": "Ernest",
            "text": "O seu plano nunca funcionaria..."
        },
        {
            "id": "615350305",
            "speaker": "Ernest",
            "text": "Não é nada não..."
        }
