    "dialogues": [
        {
            "id": "663290101",
            "speaker": "Loshts",
            "text": "Tal \"intensidade\"... É empolgante! Absolutamente empolgante!",
            "choices": [
                {
                    "id": "663290102",
                    "text": "Você está falando de mim?",
                    "response": [
                        {
                            "id": "663290103",
                            "speaker": "Loshts",
                            "text": "Exatamente, exatamente! Então, o que diz? Quer dar uma chance ao \"Desafio de Guerreiro\"? Basta se registrar com o mestre. Tenho grandes expectativas para você!",
                            "choices": [
                                {
                                    "id": "663290106",
                                    "text": "Em breve estarei lá!",
                                    "response": [
                                        {
                                            "id": "663290107",
                                            "speaker": "Loshts",
                                            "text": "Ótimo, ótimo! Ah, mal posso esperar para ver suas habilidades lendárias em ação!"
                                        }
                                    ]
                                },
                                {
                                    "id": "663290108",
                                    "text": "Deixe-me pensar sobre isso...",
                                    "response": [
                                        {
                                            "id": "663290109",
                                            "speaker": "Loshts",
                                            "text": "#Ah, uma pena, uma pena mesmo... Acho que não vou poder vê-l{M#o}{F#a} em ação, no final das contas."
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "663290104",
                    "text": "Perdão te incomodar.",
                    "response": [
                        {
                            "id": "663290105",
                            "speaker": "Loshts",
                            "text": "Cuide-se."
                        }
                    ]
                }
            ]
        }
    ]
}