{
    "talkId": "6904104",
    "total_dialogue_lines": 19,
    "speaker_counts": {
        "Mona": 12,
        "Player": 7
    },
    "dialogues": [
        {
            "id": "690410401",
            "speaker": "Player",
            "text": "<color=#FFCC33FF>O que você gostaria de fazer?</color>"
        },
        {
            "id": "690410402",
            "speaker": "Mona",
            "text": "Sim, que combinar com você uma data para passar umas férias."
        },
        {
            "id": "690410403",
            "speaker": "Player",
            "text": "Férias?"
        },
        {
            "id": "690410404",
            "speaker": "Mona",
            "text": "Pode ser em uma ilha deserta ou em uma floresta úmida... É melhor deixar seu trabalho e descansar e aproveitar um pouco.",
            "choices": [
                {
                    "id": "690410405",
                    "text": "Não parece Mona falando...",
                    "response": [
                        {
                            "id": "690410406",
                            "speaker": "Mona",
                            "text": "Mesmo? *Suspiro* Não, você não pensa em mim como uma pesquisadora louca, não é?"
                        },
                        {
                            "id": "690410407",
                            "speaker": "Mona",
                            "text": "Tudo que eu faço é para observar os fatos do mundo... Férias também podem ser consideradas um método para isso."
                        },
                        {
                            "id": "690410410",
                            "speaker": "Mona",
                            "text": "Eu comecei os preparativos para esse plano muito tempo atrás."
                        },
                        {
                            "id": "690410411",
                            "speaker": "Mona",
                            "text": "Não é fácil juntar dinheiro, por isso eu especialmente preparei uma jarra para juntar ele. Cada vez que me foi pago algo pelo que escrevi, coloquei dentro."
                        },
                        {
                            "id": "690410412",
                            "speaker": "Mona",
                            "text": "E no mesmo período, também suportei não comprar edições de manuscritos de pesquisa com casca dura... Aos poucos, finalmente juntei o suficiente.",
                            "choices": [
                                {
                                    "id": "690410413",
                                    "text": "Realmente não é fácil...",
                                    "response": [
                                        {
                                            "id": "690410414",
                                            "speaker": "Mona",
                                            "text": "Não se preocupe, é merecido!"
                                        },
                                        {
                                            "id": "690410419",
                                            "speaker": "Mona",
                                            "text": "Sim. Fico esperando notícias suas."
                                        }
                                    ]
                                },
                                {
                                    "id": "690410415",
                                    "text": "Não posso usar o dinheiro de Mona.",
                                    "response": [
                                        {
                                            "id": "690410416",
                                            "speaker": "Mona",
                                            "text": "*Suspiro* ... O que você quer dizer?"
                                        },
                                        {
                                            "id": "690410417",
                                            "speaker": "Mona",
                                            "text": "Obrigada por sua compreensão! Mas, isso é algo que eu quero fazer, então não tem problema."
                                        }
                                    ]
                                },
                                {
                                    "id": "690410418",
                                    "text": "Então vou organizar um tempo."
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690410408",
                    "text": "Mona, como estão seus fundos?",
                    "response": [
                        {
                            "id": "690410409",
                            "speaker": "Mona",
                            "text": "Hmph, claro que eles estão prontos."
                        }
                    ]
                }
            ]
        }
    ]
}