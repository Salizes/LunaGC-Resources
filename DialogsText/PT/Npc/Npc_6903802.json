{
    "talkId": "6903802",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Albedo": 8,
        "Player": 3
    },
    "dialogues": [
        {
            "id": "690380201",
            "speaker": "Player",
            "text": "<color=#FFCC33FF>Você se acostumou com esse lugar?</color>"
        },
        {
            "id": "690380202",
            "speaker": "Albedo",
            "text": "Sim. Eu penso que a \"utopia\" que falam nos livros deve ser aqui."
        },
        {
            "id": "690380203",
            "speaker": "Albedo",
            "text": "Aqui é tranquilo e confortável. Depois de me dedicar de alma e coração à investigação, parece que me esqueci até do tempo.",
            "choices": [
                {
                    "id": "690380204",
                    "text": "Não se esqueça de comer na hora certa.",
                    "response": [
                        {
                            "id": "690380205",
                            "speaker": "Albedo",
                            "text": "..."
                        },
                        {
                            "id": "690380206",
                            "speaker": "Albedo",
                            "text": "Sim, isso é certo."
                        },
                        {
                            "id": "690380207",
                            "speaker": "Albedo",
                            "text": "Ah, sim..."
                        },
                        {
                            "id": "690380210",
                            "speaker": "Albedo",
                            "text": "Por vezes, eu rabisco por todo o lado... Sua decoração dentro do Paraíso Mágico também é uma inspiração para mim."
                        },
                        {
                            "id": "690380211",
                            "speaker": "Albedo",
                            "text": "...Obrigado."
                        }
                    ]
                },
                {
                    "id": "690380208",
                    "text": "Se precisar de algo, me fale.",
                    "response": [
                        {
                            "id": "690380209",
                            "speaker": "Albedo",
                            "text": "Só preciso que libere sua criatividade."
                        }
                    ]
                }
            ]
        }
    ]
}