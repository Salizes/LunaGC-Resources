{
    "talkId": "6900202",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Kamisato Ayaka": 10,
        "Player": 4
    },
    "dialogues": [
        {
            "id": "690020201",
            "speaker": "Player",
            "text": "Você gosta daqui?"
        },
        {
            "id": "690020202",
            "speaker": "Kamisato Ayaka",
            "text": "Haha, não precisa se preocupar."
        },
        {
            "id": "690020203",
            "speaker": "Kamisato Ayaka",
            "text": "As paisagens daqui não são como as que vejo em casa. Existem novas maravilhas a serem descobertas a cada etapa."
        },
        {
            "id": "690020204",
            "speaker": "Kamisato Ayaka",
            "text": "Mas também há um significado adicional, porque este lugar pertence a você.",
            "choices": [
                {
                    "id": "690020205",
                    "text": "Sinta-se em casa. Literalmente haha.",
                    "response": [
                        {
                            "id": "690020206",
                            "speaker": "Kamisato Ayaka",
                            "text": "Ah..."
                        },
                        {
                            "id": "690020207",
                            "speaker": "Kamisato Ayaka",
                            "text": "Isso seria muito impróprio..."
                        },
                        {
                            "id": "690020208",
                            "speaker": "Kamisato Ayaka",
                            "text": "Mas agradeço a gentileza."
                        },
                        {
                            "id": "690020212",
                            "speaker": "Player",
                            "text": "O prazer é todo meu."
                        },
                        {
                            "id": "690020213",
                            "speaker": "Kamisato Ayaka",
                            "text": "Ahaha... Isso é muito atencioso da sua parte. Mas não precisa se esforçar tanto por mim."
                        },
                        {
                            "id": "690020214",
                            "speaker": "Kamisato Ayaka",
                            "text": "Avise se precisar de minha ajuda. Espero poder ajudar você também."
                        }
                    ]
                },
                {
                    "id": "690020209",
                    "text": "Espero que seja um lugar onde você possa deixar de lado suas preocupações e apenas relaxar.",
                    "response": [
                        {
                            "id": "690020210",
                            "speaker": "Kamisato Ayaka",
                            "text": "Hmm... Agradeço sua gentileza."
                        },
                        {
                            "id": "690020211",
                            "speaker": "Kamisato Ayaka",
                            "text": "Eu não ousaria \"deixar de lado as preocupações\" e \"relaxar\". Mas agradeço por poder descansar aqui um pouco."
                        }
                    ]
                }
            ]
        }
    ]
}