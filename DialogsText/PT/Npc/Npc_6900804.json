{
    "talkId": "6900804",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 5,
        "Yelan": 12
    },
    "dialogues": [
        {
            "id": "690080401",
            "speaker": "Player",
            "text": "Gostaria de fazer alguma coisa?"
        },
        {
            "id": "690080402",
            "speaker": "Yelan",
            "text": "Esse é seu momento de descanso? Então vamos fazer algo que não exija muito esforço mental."
        },
        {
            "id": "690080403",
            "speaker": "Yelan",
            "text": "Ah! Por acaso, tenho um dado no meu bolso. Que tal jogarmos um jogo?"
        },
        {
            "id": "690080404",
            "speaker": "Yelan",
            "text": "Eu rolo o dado, e o número que sair vai definir quem confessa.",
            "choices": [
                {
                    "id": "690080405",
                    "text": "Número?",
                    "response": [
                        {
                            "id": "690080407",
                            "speaker": "Yelan",
                            "text": "Se sair 1, 3 ou 5, será você quem vai me contar um... segredo que ninguém mais saiba."
                        },
                        {
                            "id": "690080408",
                            "speaker": "Yelan",
                            "text": "Se sair 2, 4 ou 6, eu faço o mesmo. Que tal?",
                            "choices": [
                                {
                                    "id": "690080409",
                                    "text": "Me parece arriscado...",
                                    "response": [
                                        {
                                            "id": "690080410",
                                            "speaker": "Yelan",
                                            "text": "Me parece que você ainda não confia totalmente em mim."
                                        },
                                        {
                                            "id": "690080411",
                                            "speaker": "Yelan",
                                            "text": "De qualquer forma, ainda que eu dê trela para parceiros importantes, me sinto ainda mais à vontade com você."
                                        },
                                        {
                                            "id": "690080412",
                                            "speaker": "Yelan",
                                            "text": "Talvez um dia você se torne especialista em coleta de inteligência, e eu mal poderei esperar para jogar com você."
                                        }
                                    ]
                                },
                                {
                                    "id": "690080413",
                                    "text": "Então, vamos experimentar.",
                                    "response": [
                                        {
                                            "id": "690080414",
                                            "speaker": "Yelan",
                                            "text": "Ahn? Você tem 50% de chance de perder esse jogo. Ainda quer jogar mesmo assim?"
                                        },
                                        {
                                            "id": "690080415",
                                            "speaker": "Yelan",
                                            "text": "Ou você quer tanto saber do meu segredo, que até prosseguiria com a aposta?"
                                        },
                                        {
                                            "id": "690080416",
                                            "speaker": "Yelan",
                                            "text": "Interessante. Antes, eu tinha pensado em mexer uns pauzinhos, mas agora mal posso esperar para ver."
                                        },
                                        {
                                            "id": "690080417",
                                            "speaker": "Yelan",
                                            "text": "Hehe... Certo, vamos começar a primeira rodada."
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690080406",
                    "text": "Quem vai \"confessar\"?"
                }
            ]
        }
    ]
}