{
    "talkId": "6905205",
    "total_dialogue_lines": 20,
    "speaker_counts": {
        "Ei": 12,
        "Player": 8
    },
    "dialogues": [
        {
            "id": "690520501",
            "speaker": "Player",
            "text": "Gostaria de fazer alguma coisa?"
        },
        {
            "id": "690520502",
            "speaker": "Ei",
            "text": "Sim. Desembainhe sua espada.",
            "choices": [
                {
                    "id": "690520503",
                    "text": "Espere, agora?",
                    "response": [
                        {
                            "id": "690520505",
                            "speaker": "Ei",
                            "text": "Hmph. Então retorne quando sua preparação estiver completa. Eu tenho tempo."
                        },
                        {
                            "id": "690520506",
                            "speaker": "Ei",
                            "text": "Eu usarei minha lâmina para confirmar se você é está fora de prática ou não."
                        },
                        {
                            "id": "690520507",
                            "speaker": "Player",
                            "text": "Espere, você está falando sério?"
                        },
                        {
                            "id": "690520508",
                            "speaker": "Ei",
                            "text": "Claro que sim."
                        },
                        {
                            "id": "690520509",
                            "speaker": "Ei",
                            "text": "O momento em que as lâminas se cruzam em batalha é também uma forma de Eternidade. Usarei isso como o momento para sentir seu ser interior."
                        },
                        {
                            "id": "690520510",
                            "speaker": "Ei",
                            "text": "Um método simples e direto, mas mais claro que qualquer língua poderia expressar. Até mesmo permite que eu verifique minha própria existência.",
                            "choices": [
                                {
                                    "id": "690520511",
                                    "text": "Algo parece um pouco estranho...",
                                    "response": [
                                        {
                                            "id": "690520513",
                                            "speaker": "Ei",
                                            "text": "Hã? Você foi capaz de ver pelo meu disfarce? Pensei que ele era preciso o suficiente."
                                        },
                                        {
                                            "id": "690520514",
                                            "speaker": "Ei",
                                            "text": "Não importa. Serei honesta com você. Desejo lutar com você."
                                        },
                                        {
                                            "id": "690520515",
                                            "speaker": "Ei",
                                            "text": "Afinal de contas, poucos foram capazes de suportar minha lâmina. Seria um prazer treinar com você."
                                        },
                                        {
                                            "id": "690520516",
                                            "speaker": "Ei",
                                            "text": "Entretanto, temo que você ficaria relutante de lutar contra mim, por isso usei a identidade da Shogun.",
                                            "choices": [
                                                {
                                                    "id": "690520517",
                                                    "text": "Não precisa me enganar para isso...",
                                                    "response": [
                                                        {
                                                            "id": "690520519",
                                                            "speaker": "Ei",
                                                            "text": "Ah, você não recusou. Então posso assumir que você aceitou?"
                                                        },
                                                        {
                                                            "id": "690520520",
                                                            "speaker": "Ei",
                                                            "text": "Haha, prepare-se. Não serei fácil."
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "690520518",
                                                    "text": "Que pedido estranho..."
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "690520512",
                                    "text": "Ei? É você?"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690520504",
                    "text": "#Eu não estou preparad{F#a}{M#o} mentalmente para isso..."
                }
            ]
        }
    ]
}