{
    "talkId": "6902603",
    "total_dialogue_lines": 19,
    "speaker_counts": {
        "Player": 4,
        "Xiao": 15
    },
    "dialogues": [
        {
            "id": "690260301",
            "speaker": "Player",
            "text": "<color=#FFCC33FF>Você quer conversar comigo?</color>"
        },
        {
            "id": "690260302",
            "speaker": "Xiao",
            "text": "... Conversar?"
        },
        {
            "id": "690260303",
            "speaker": "Xiao",
            "text": "...Se você desejar, posso te acompanhar.",
            "choices": [
                {
                    "id": "690260304",
                    "text": "Ainda acho que você pode recusar.",
                    "response": [
                        {
                            "id": "690260305",
                            "speaker": "Xiao",
                            "text": "Uh?"
                        },
                        {
                            "id": "690260306",
                            "speaker": "Xiao",
                            "text": "Para fazer um pedido, mas prepare-se para ser rejeitado..."
                        },
                        {
                            "id": "690260307",
                            "speaker": "Xiao",
                            "text": "As relações humanas realmente são problemáticas."
                        },
                        {
                            "id": "690260311",
                            "speaker": "Xiao",
                            "text": "Normalmente, eu não participo de \"conversas\"."
                        },
                        {
                            "id": "690260312",
                            "speaker": "Xiao",
                            "text": "Mas se for uma conversa com você, eu estou disposto a aceitar."
                        },
                        {
                            "id": "690260313",
                            "speaker": "Player",
                            "text": "Xiao, você tem estado bem?"
                        },
                        {
                            "id": "690260314",
                            "speaker": "Xiao",
                            "text": "Você está me perguntando sobre o carma?"
                        },
                        {
                            "id": "690260315",
                            "speaker": "Xiao",
                            "text": "Está tudo bem."
                        },
                        {
                            "id": "690260316",
                            "speaker": "Xiao",
                            "text": "É de minha própria responsabilidade, portanto, só eu arcarei com as consequências."
                        },
                        {
                            "id": "690260317",
                            "speaker": "Xiao",
                            "text": "...Não sei se está relacionado a você, mas recentemente, a dor da minha dívida cármica tem sido menos excruciante."
                        },
                        {
                            "id": "690260318",
                            "speaker": "Xiao",
                            "text": "Está muito mais fácil de suportar do que antes."
                        },
                        {
                            "id": "690260319",
                            "speaker": "Xiao",
                            "text": "Quanto a qualquer preocupação em excesso... É melhor deixar isso para si mesmo."
                        }
                    ]
                },
                {
                    "id": "690260308",
                    "text": "Xiao, você está incomodado com algo?",
                    "response": [
                        {
                            "id": "690260309",
                            "speaker": "Xiao",
                            "text": "Não é nada demais."
                        },
                        {
                            "id": "690260310",
                            "speaker": "Xiao",
                            "text": "Eu não esperava que você fizesse tal pedido."
                        }
                    ]
                }
            ]
        }
    ]
}