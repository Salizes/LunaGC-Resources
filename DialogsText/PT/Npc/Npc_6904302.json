    "speaker_counts": {
        "Player": 3,
        "Sucrose": 6
    },
    "dialogues": [
        {
            "id": "690430201",
            "speaker": "Player",
            "text": "<color=#FFCC33FF>Você se acostumou com esse lugar?</color>"
        },
        {
            "id": "690430202",
            "speaker": "Sucrose",
            "text": "Ah... Por favor, não se preocupe comigo."
        },
        {
            "id": "690430203",
            "speaker": "Sucrose",
            "text": "Para mim, desde que eu possua um laboratório independente, estou satisfeita."
        },
        {
            "id": "690430204",
            "speaker": "Sucrose",
            "text": "Aqui tem muito mais do que o que preciso.",
            "choices": [
                {
                    "id": "690430205",
                    "text": "Não precisa ficar desconfortada.",
                    "response": [
                        {
                            "id": "690430207",
                            "speaker": "Sucrose",
                            "text": "Hã... Bem..."
                        },
                        {
                            "id": "690430208",
                            "speaker": "Sucrose",
                            "text": "Se eu ficar incomodando desse jeito, ficarei envergonhada."
                        },
                        {
                            "id": "690430209",
                            "speaker": "Sucrose",
                            "text": "Mas, eu levarei em consideração suas boas intenções."
                        }
                    ]
                },
                {
                    "id": "690430206",
                    "text": "Se precisar de algum equipamento, é só me dizer."
                }
            ]
        }
    ]
}