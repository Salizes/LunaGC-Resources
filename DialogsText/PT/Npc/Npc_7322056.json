    "dialogues": [
        {
            "id": "732205601",
            "speaker": "Masseira",
            "text": "#Ah? São {M#os convidados}{F#as convidadas} de honra..."
        },
        {
            "id": "732205602",
            "speaker": "Masseira",
            "text": "Estou impressionado! O que você fez foi incrível."
        },
        {
            "id": "732205603",
            "speaker": "Masseira",
            "text": "#Talvez um dia eu possa pedir pela sua ajuda. Espero que você ainda esteja dispost{M#o}{F#a} a oferecê-la.",
            "choices": [
                {
                    "id": "732205604",
                    "text": "Claro, o que você acha de jogar cartas primeiro?",
                    "response": [
                        {
                            "id": "732205605",
                            "speaker": "Masseira",
                            "text": "Cartas? Com você? Seria um prazer."
                        }
                    ]
                },
                {
                    "id": "732205606",
                    "text": "Quando chegar a hora, vou ajudar.",
                    "response": [
                        {
                            "id": "732205607",
                            "speaker": "Masseira",
                            "text": "Então eu agradeço desde já."
                        }
                    ]
                }
            ]
        }
    ]
