    "dialogues": [
        {
            "id": "690340801",
            "speaker": "Player",
            "text": "Gostaria de fazer alguma coisa?"
        },
        {
            "id": "690340401",
            "speaker": "Player",
            "text": "<color=#FFCC33FF>O que você gostaria de fazer?</color>"
        },
        {
            "id": "690340402",
            "speaker": "Noelle",
            "text": "Ah? Está me perguntando...?"
        },
        {
            "id": "690340403",
            "speaker": "Noelle",
            "text": "Eu quero medir seu tamanho para fazer uma roupa para você.",
            "choices": [
                {
                    "id": "690340404",
                    "text": "Como pensou nisso de repente?",
                    "response": [
                        {
                            "id": "690340407",
                            "speaker": "Noelle",
                            "text": "Se você puder usar as roupas que eu faço para você..."
                        },
                        {
                            "id": "690340408",
                            "speaker": "Noelle",
                            "text": "Bem, com certeza é algo muito, muito feliz.",
                            "choices": [
                                {
                                    "id": "690340409",
                                    "text": "#Obrigad{F#a}{M#o} pela ajuda.",
                                    "response": [
                                        {
                                            "id": "690340411",
                                            "speaker": "Noelle",
                                            "text": "Sim... Sim..."
                                        },
                                        {
                                            "id": "690340412",
                                            "speaker": "Noelle",
                                            "text": "Que bom! Finalmente há algo com que me ocupar!"
                                        },
                                        {
                                            "id": "690340413",
                                            "speaker": "Noelle",
                                            "text": "Entretanto, esta é a bagunça mais feliz de Teyvat."
                                        }
                                    ]
                                },
                                {
                                    "id": "690340410",
                                    "text": "Irei também preparar um presente para você, Noelle."
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690340405",
                    "text": "Noelle, você até sabe costurar?",
                    "response": [
                        {
                            "id": "690340406",
                            "speaker": "Noelle",
                            "text": "É claro! Eu sou a \"Super Empregada\"."
                        }
                    ]
                }
            ]
        }
    ]
}