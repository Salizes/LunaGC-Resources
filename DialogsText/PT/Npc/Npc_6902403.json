{
    "talkId": "6902403",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Beidou": 11,
        "Player": 4
    },
    "dialogues": [
        {
            "id": "690240301",
            "speaker": "Player",
            "text": "<color=#FFCC33FF>Você quer conversar comigo?</color>"
        },
        {
            "id": "690240302",
            "speaker": "Beidou",
            "text": "Certo! Sobre o que você quer conversar?"
        },
        {
            "id": "690240303",
            "speaker": "Beidou",
            "text": "Mas, você já não ouviu outras pessoas falarem sobre minhas histórias no mar?"
        },
        {
            "id": "690240304",
            "speaker": "Beidou",
            "text": "Devemos trocar, fale as histórias de suas aventuras!",
            "choices": [
                {
                    "id": "690240305",
                    "text": "Uh... Eu derrotei um dragão.",
                    "response": [
                        {
                            "id": "690240306",
                            "speaker": "Beidou",
                            "text": "Oh, interessante! Quão grande era esse dragão?"
                        },
                        {
                            "id": "690240308",
                            "speaker": "Beidou",
                            "text": "Hahaha, incrível!"
                        },
                        {
                            "id": "690240309",
                            "speaker": "Beidou",
                            "text": "Eu quebrei o mar, você derrotou o céu."
                        },
                        {
                            "id": "690240310",
                            "speaker": "Beidou",
                            "text": "#Vamos fazer aventurar junt{F#as}{M#os}, seremos invencíveis!"
                        },
                        {
                            "id": "690240311",
                            "speaker": "Player",
                            "text": "Basicamente, eu derroto Hilichurls..."
                        },
                        {
                            "id": "690240312",
                            "speaker": "Beidou",
                            "text": "Como Hilichurls são? Já ouvi falar deles no mar, mas nunca vi um!"
                        },
                        {
                            "id": "690240313",
                            "speaker": "Beidou",
                            "text": "Uma aventura não se trata de quantas ondas você encontra, mas sim em quantas ondas desconhecidas ainda lhe aguardam!"
                        },
                        {
                            "id": "690240314",
                            "speaker": "Beidou",
                            "text": "Ei, isso soou muito profundo agora que pensei nisso..."
                        },
                        {
                            "id": "690240315",
                            "speaker": "Beidou",
                            "text": "Haha, esta foi uma ótima conversa! E agora, um brinde! Um brinde!"
                        }
                    ]
                },
                {
                    "id": "690240307",
                    "text": "Ainda maior que o seu navio, Beidou."
                }
            ]
        }
    ]
}