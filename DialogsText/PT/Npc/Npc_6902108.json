{
    "talkId": "6902108",
    "total_dialogue_lines": 19,
    "speaker_counts": {
        "Amber": 13,
        "Player": 6
    },
    "dialogues": [
        {
            "id": "690210801",
            "speaker": "Player",
            "text": "Gostaria de fazer alguma coisa?"
        },
        {
            "id": "690210401",
            "speaker": "Player",
            "text": "<color=#FFCC33FF>O que você gostaria de fazer?</color>"
        },
        {
            "id": "690210402",
            "speaker": "Amber",
            "text": "Eu gostaria de jantar com você."
        },
        {
            "id": "690210403",
            "speaker": "Amber",
            "text": "Mesmo para um jantar simples, a sensação de comer em casa e comer em algum restaurante é completamente diferente."
        },
        {
            "id": "690210404",
            "speaker": "Amber",
            "text": "Mesmo que comer em restaurante possa ser conveniente, o sabor da comida é garantido."
        },
        {
            "id": "690210405",
            "speaker": "Amber",
            "text": "Só em casa que podemos ter aquela sensação única de aconchegamento.",
            "choices": [
                {
                    "id": "690210406",
                    "text": "Sim, eu entendo.",
                    "response": [
                        {
                            "id": "690210407",
                            "speaker": "Amber",
                            "text": "Sim! Então, venha!"
                        },
                        {
                            "id": "690210410",
                            "speaker": "Amber",
                            "text": "Eu vou fazer churrasco, tá? Bom! Você deve estar muito familiar com o sabor do churrasco da Aventureira."
                        },
                        {
                            "id": "690210411",
                            "speaker": "Amber",
                            "text": "Eu tenho que me exigir ainda mais."
                        },
                        {
                            "id": "690210412",
                            "speaker": "Amber",
                            "text": "Bom! Então, que tal tentar fazer Carne Frita com Cenoura e Mel desta vez?"
                        },
                        {
                            "id": "690210413",
                            "speaker": "Amber",
                            "text": "Ah? Espero que não queime a sua cozinha."
                        },
                        {
                            "id": "690210414",
                            "speaker": "Player",
                            "text": "Não faz mal."
                        },
                        {
                            "id": "690210415",
                            "speaker": "Player",
                            "text": "Ajudarei também!"
                        },
                        {
                            "id": "690210416",
                            "speaker": "Amber",
                            "text": "#Você sempre é {M#o}{F#a} melhor."
                        },
                        {
                            "id": "690210417",
                            "speaker": "Amber",
                            "text": "Eu farei uma comida melhor para compartilhar com você. Não desistirei, não importa quantas vezes eu falhe."
                        },
                        {
                            "id": "690210418",
                            "speaker": "Amber",
                            "text": "Estou muito ansiosa."
                        }
                    ]
                },
                {
                    "id": "690210408",
                    "text": "#Vamos jantar junt{M#os}{F#as}.",
                    "response": [
                        {
                            "id": "690210409",
                            "speaker": "Amber",
                            "text": "Está falando sério?"
                        }
                    ]
                }
            ]
        }
    ]
}