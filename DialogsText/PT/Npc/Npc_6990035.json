    "dialogues": [
        {
            "id": "699003501",
            "speaker": "Player",
            "text": "Sobre os nomes dos Aranaras..."
        },
        {
            "id": "699003502",
            "speaker": "Paimon",
            "text": "Arama, Arana, Araja, Arakavi... Argh, esses nomes Aranaras são horríveis de lembrar!"
        },
        {
            "id": "699003503",
            "speaker": "Paimon",
            "text": "A única parte que Paimon tem certeza é que todos começam com \"Ara\"!",
            "choices": [
                {
                    "id": "699003504",
                    "text": "Então se você fosse uma Aranara...",
                    "response": [
                        {
                            "id": "699003506",
                            "speaker": "Paimon",
                            "text": "Sim! E o seu seria..."
                        },
                        {
                            "id": "699003507",
                            "speaker": "Paimon",
                            "text": "Hmm... Pensando melhor, apenas te chamaram de \"Nara Viajante\"..."
                        },
                        {
                            "id": "699003508",
                            "speaker": "Player",
                            "text": "Sim, para eles somos todos Nara..."
                        },
                        {
                            "id": "699003509",
                            "speaker": "Paimon",
                            "text": "Mas se alguém é chamado \"Nara\", como os Aranaras o chamariam?"
                        },
                        {
                            "id": "699003510",
                            "speaker": "Player",
                            "text": "Acho que \"Nara Nara\"...? Soa adorável."
                        },
                        {
                            "id": "699003511",
                            "speaker": "Paimon",
                            "text": "Hehe, sim."
                        }
                    ]
                },
                {
                    "id": "699003505",
                    "text": "Seu nome seria Arapaimon."
                }
            ]
        }
    ]
}