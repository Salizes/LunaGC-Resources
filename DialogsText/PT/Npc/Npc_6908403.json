{
    "talkId": "6908403",
    "total_dialogue_lines": 22,
    "speaker_counts": {
        "Lyney": 14,
        "Player": 8
    },
    "dialogues": [
        {
            "id": "690840301",
            "speaker": "Player",
            "text": "Quer conversar comigo?"
        },
        {
            "id": "690840302",
            "speaker": "Lyney",
            "text": "Claro, vamos nessa. Diga lá, por que você não olha o meu chapéu? Você reparou em algo de diferente nele?"
        },
        {
            "id": "690840303",
            "speaker": "Player",
            "text": "Não, nada."
        },
        {
            "id": "690840304",
            "speaker": "Lyney",
            "text": "Ah, então você não olhou com atenção suficiente. Se aproxime um pouco mais."
        },
        {
            "id": "690840305",
            "speaker": "Player",
            "text": "Tanto faz."
        },
        {
            "id": "690840306",
            "speaker": "Lyney",
            "text": "E aí? Achou a resposta? É o padrão ou a cor? Você já deve ter visto esse chapéu várias vezes antes.",
            "choices": [
                {
                    "id": "690840307",
                    "text": "...Ainda não tô vendo nada.",
                    "response": [
                        {
                            "id": "690840308",
                            "speaker": "Lyney",
                            "text": "*Suspiro* Que pena... mas a sua conclusão está correta."
                        },
                        {
                            "id": "690840311",
                            "speaker": "Lyney",
                            "text": "Fiz um pequeno truque e roubei algo seu. Depois disso, coloquei uma carta na sua bolsa."
                        },
                        {
                            "id": "690840312",
                            "speaker": "Lyney",
                            "text": "Você consegue adivinhar o que roubei?",
                            "choices": [
                                {
                                    "id": "690840313",
                                    "text": "Minha carteira?",
                                    "response": [
                                        {
                                            "id": "690840314",
                                            "speaker": "Lyney",
                                            "text": "Haha, eu sou um ladrãozinho que adora Mora! Não é à toa que meus bolsos sempre estão cheios dela."
                                        },
                                        {
                                            "id": "690840315",
                                            "speaker": "Lyney",
                                            "text": "O que eu roubei, na verdade, foi a sua atenção. Isso vale mais do que Mora?"
                                        },
                                        {
                                            "id": "690840321",
                                            "speaker": "Lyney",
                                            "text": "#Contanto que você entenda e aperfeiçoe este truque, e pratique um pouco seus movimentos, você também pode virar um{F#a} mágic{M#o}{F#a} excepcional!"
                                        },
                                        {
                                            "id": "690840322",
                                            "speaker": "Lyney",
                                            "text": "...Ok, você pode devolver minha carta agora."
                                        }
                                    ]
                                },
                                {
                                    "id": "690840316",
                                    "text": "Meu coração?",
                                    "response": [
                                        {
                                            "id": "690840317",
                                            "speaker": "Lyney",
                                            "text": "Que resposta inesperada! Meu coração até ficou mais rápido com ela."
                                        },
                                        {
                                            "id": "690840318",
                                            "speaker": "Lyney",
                                            "text": "Mas o que eu roubei foi a sua atenção. Apesar de não ser tão valiosa como o seu coração, ela ainda é muito importante para nós, mágicos!"
                                        }
                                    ]
                                },
                                {
                                    "id": "690840319",
                                    "text": "Atenção?",
                                    "response": [
                                        {
                                            "id": "690840320",
                                            "speaker": "Lyney",
                                            "text": "Pensou muito bem! Parabéns, essa era a resposta certa."
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690840309",
                    "text": "...É o tamanho?",
                    "response": [
                        {
                            "id": "690840310",
                            "speaker": "Lyney",
                            "text": "Não, eu te enganei."
                        }
                    ]
                }
            ]
        }
    ]
}