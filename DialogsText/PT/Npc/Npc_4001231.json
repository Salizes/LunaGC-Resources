                                        {
                                            "id": "400123108",
                                            "speaker": "Razor",
                                            "text": "Então, eu vim..."
                                        },
                                        {
                                            "id": "400123109",
                                            "speaker": "Razor",
                                            "text": "Esse lugar... É salgado. Também tem folhas, grama, fruta."
                                        },
                                        {
                                            "id": "400123110",
                                            "speaker": "Razor",
                                            "text": "Seu cheiro... Cheira bom.",
