    "dialogues": [
        {
            "id": "690530801",
            "speaker": "Player",
            "text": "<color=#FFCC33FF>Você quer conversar comigo?</color>"
        },
        {
            "id": "690530302",
            "speaker": "Sayu",
            "text": "Ótimo."
        },
        {
            "id": "690530303",
            "speaker": "Sayu",
            "text": "Vou tentar ficar acordada...",
            "choices": [
                {
                    "id": "690530304",
                    "text": "Você dormiu o suficiente?",
                    "response": [
                        {
                            "id": "690530305",
                            "speaker": "Sayu",
                            "text": "Agora que você perguntou, estou ficando com um pouco de sono de novo..."
                        },
                        {
                            "id": "690530306",
                            "speaker": "Sayu",
                            "text": "...*bocejo*"
                        },
                        {
                            "id": "690530307",
                            "speaker": "Sayu",
                            "text": "Não, eu tenho que aguentar firme..."
                        },
                        {
                            "id": "690530311",
                            "speaker": "Sayu",
                            "text": "Se eu adormecer enquanto estou com você... estaria perdendo um tempo precioso."
                        },
                        {
                            "id": "690530312",
                            "speaker": "Player",
                            "text": "E o seu trabalho?"
                        },
                        {
                            "id": "690530313",
                            "speaker": "Sayu",
                            "text": "Está tudo bem..."
                        },
                        {
                            "id": "690530314",
                            "speaker": "Sayu",
                            "text": "Meu trabalho é apenas um monte de tarefas sem muita relevância."
                        },
                        {
                            "id": "690530315",
                            "speaker": "Sayu",
                            "text": "Não é tão importante quanto ficar aqui."
                        },
                        {
                            "id": "690530316",
                            "speaker": "Sayu",
                            "text": "Eu posso dormir, e posso conversar com você..."
                        }
                    ]
                },
                {
                    "id": "690530308",
                    "text": "Se você está com sono, vá deitar.",
                    "response": [
                        {
                            "id": "690530309",
                            "speaker": "Sayu",
                            "text": "Hmm, estou bem..."
                        },
                        {
                            "id": "690530310",
                            "speaker": "Sayu",
                            "text": "*bocejo* ...não quero dormir agora..."
                        }
                    ]
                }
            ]
        }
    ]
}