    "dialogues": [
        {
            "id": "662760101",
            "speaker": "Yerimen",
            "text": "Urgh... De-desculpa, só, só me deixa descansar um pouco...",
            "choices": [
                {
                    "id": "662760102",
                    "text": "Você está bem?",
                    "response": [
                        {
                            "id": "662760104",
                            "speaker": "Yerimen",
                            "text": "T-tô bem, cof, é que antes voei rápido demais, agora tô meio enjoado..."
                        },
                        {
                            "id": "662760105",
                            "speaker": "Yerimen",
                            "text": "Embora Temach tenha dito para não me preocupar, que todos passam por essa fase, até o Taruka parece estar tranquilo... Será que ele não está apenas tentando me confortar?"
                        }
                    ]
                },
                {
                    "id": "662760103",
                    "text": "Descanse primeiro.",
                    "response": [
                        {
                            "id": "662760106",
                            "speaker": "Yerimen",
                            "text": "Agradeço..."
                        }
                    ]
                }
            ]
