{
    "talkId": "6911104",
    "total_dialogue_lines": 21,
    "speaker_counts": {
        "Player": 9,
        "Varesa": 12
    },
    "dialogues": [
        {
            "id": "691110401",
            "speaker": "Player",
            "text": "Gostaria de fazer alguma coisa?"
        },
        {
            "id": "691110402",
            "speaker": "Varesa",
            "text": "#Na verdade, tem algo que penso há muito tempo... E, agora que estamos só nós {M#dois}{F#duas} aqui, eu..."
        },
        {
            "id": "691110403",
            "speaker": "Varesa",
            "text": "Eu... acho que vou dizer logo de uma vez...",
            "choices": [
                {
                    "id": "691110404",
                    "text": "...S-Sim?",
                    "response": [
                        {
                            "id": "691110406",
                            "speaker": "Varesa",
                            "text": "Podemos... lutar? Tipo, quero que você vá com tudo, não se segure!"
                        },
                        {
                            "id": "691110407",
                            "speaker": "Varesa",
                            "text": "#Você é {M#um herói}{F#uma heroína}, uma lenda e a pessoa mais forte que conheço... Eu te admiro de verdade! Você é um modelo para mim!"
                        },
                        {
                            "id": "691110408",
                            "speaker": "Varesa",
                            "text": "Então quero ver... quanto nos separa em nossa força total!",
                            "choices": [
                                {
                                    "id": "691110409",
                                    "text": "Espera...",
                                    "response": [
                                        {
                                            "id": "691110411",
                                            "speaker": "Varesa",
                                            "text": "Acho que é um pouco confuso... Digo, você provavelmente poderia enfrentar um Arconte de igual para igual, mas ainda tenho medo de te machucar. Meu estilo de luta é um pouco, hmm, bagunçado..."
                                        },
                                        {
                                            "id": "691110412",
                                            "speaker": "Varesa",
                                            "text": "Eu só quero dizer, hmm... *Suspiro* O que eu tô tentando dizer...",
                                            "choices": [
                                                {
                                                    "id": "691110413",
                                                    "text": "Mesmo se for só uma luta de treino, eu não acho que posso ir com tudo contra você.",
                                                    "response": [
                                                        {
                                                            "id": "691110415",
                                                            "speaker": "Varesa",
                                                            "text": "Ah, não... entendo. Eu deveria ter pensado nisso..."
                                                        },
                                                        {
                                                            "id": "691110416",
                                                            "speaker": "Varesa",
                                                            "text": "Eu entendo isso. De alguma forma, me faz sentir toda engraçada por dentro..."
                                                        },
                                                        {
                                                            "id": "691110417",
                                                            "speaker": "Varesa",
                                                            "text": "Espera... Por que não testamos nossa força deu um jeito diferente? Tipo... com exercícios?",
                                                            "choices": [
                                                                {
                                                                    "id": "691110418",
                                                                    "text": "Essa ideia é bem melhor.",
                                                                    "response": [
                                                                        {
                                                                            "id": "691110420",
                                                                            "speaker": "Varesa",
                                                                            "text": "Tudo bem, então vamos nos aquecer com uma corrida de noventa mil passos, então a gente nada metade dessa distância. Quando isso acabar, vou trazer os pesos. Cinquenta deve servir... Cada um mais ou menos do peso de um Tantakassauro adulto."
                                                                        },
                                                                        {
                                                                            "id": "691110421",
                                                                            "speaker": "Varesa",
                                                                            "text": "#Aah, estou ficando animada! Mal posso esperar para te ver na cama do supino! Aposto que você vai ficar muito irad{M#o}{F#a}!"
                                                                        }
                                                                    ]
                                                                },
                                                                {
                                                                    "id": "691110419",
                                                                    "text": "Que sorte das aventuras me manterem em forma."
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "691110414",
                                                    "text": "Porque, como você, eu não gosto de lutar contra meus amigos."
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "691110410",
                                    "text": "Você quer que eu vá com tudo?"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "691110405",
                    "text": "Você ficou séria demais de repente..."
                }
            ]
        }
    ]
}