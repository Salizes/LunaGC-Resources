        {
            "id": "721972604",
            "speaker": "Chouji",
            "text": "#{NICKNAME}, você precisa de algo?"
        },
        {
            "id": "721972605",
            "speaker": "Player",
            "text": "Sobre o santuário..."
        },
        {
            "id": "721972606",
            "speaker": "Chouji",
            "text": "É uma pena que não há muitas pessoas sobrando na ilha. Espero que alguém possa tomar conta daqueles santuários..."
        },
        {
            "id": "721972607",
            "speaker": "Chouji",
            "text": "Mas não é tão ruim assim. Não importa o quão ruim as coisas fiquem, no final, tudo melhorará, não é?"
        },
        {
            "id": "721972608",
            "speaker": "Player",
            "text": "Espero que você esteja certo."
        },
        {
            "id": "721972609",
            "speaker": "Chouji",
            "text": "Sim, vamos torcer que sim!"
        }
    ]
}