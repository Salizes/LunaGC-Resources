{
    "talkId": "6903702",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Ganyu": 7,
        "Player": 5
    },
    "dialogues": [
        {
            "id": "690370201",
            "speaker": "Player",
            "text": "<color=#FFCC33FF>Você se acostumou com esse lugar?</color>"
        },
        {
            "id": "690370202",
            "speaker": "Ganyu",
            "text": "Uh, eu acho que esse lugar é muito bonito."
        },
        {
            "id": "690370203",
            "speaker": "Ganyu",
            "text": "Não deve ter sido fácil arrumar um lugar grande como esse. Você deve ter trabalhado muito.",
            "choices": [
                {
                    "id": "690370204",
                    "text": "Não foi nada demais.",
                    "response": [
                        {
                            "id": "690370206",
                            "speaker": "Ganyu",
                            "text": "Quando tenho tempo livre, gosto muito de caminhar ao ar livre calmamente."
                        },
                        {
                            "id": "690370207",
                            "speaker": "Ganyu",
                            "text": "Mesmo que seja a hora da sesta, me sinto segura.",
                            "choices": [
                                {
                                    "id": "690370208",
                                    "text": "Segurança realmente é relaxante...",
                                    "response": [
                                        {
                                            "id": "690370209",
                                            "speaker": "Ganyu",
                                            "text": "Por isso eu gosto ainda mais daqui."
                                        },
                                        {
                                            "id": "690370212",
                                            "speaker": "Ganyu",
                                            "text": "Enfim... Obrigada!"
                                        }
                                    ]
                                },
                                {
                                    "id": "690370210",
                                    "text": "Tenha cuidado para não pegar um resfriado.",
                                    "response": [
                                        {
                                            "id": "690370211",
                                            "speaker": "Ganyu",
                                            "text": "Não se preocupe, eu durmo assim há milhares de anos."
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690370205",
                    "text": "Se você gostou, Ganyu, então tudo está ótimo."
                }
            ]
        }
    ]
}