{
    "talkId": "6901502",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Kaeya": 8,
        "Player": 3
    },
    "dialogues": [
        {
            "id": "690150201",
            "speaker": "Player",
            "text": "<color=#FFCC33FF>Você se acostumou com esse lugar?</color>"
        },
        {
            "id": "690150701",
            "speaker": "Kaeya",
            "text": "Ah, estou muito acostumado."
        },
        {
            "id": "690150702",
            "speaker": "Kaeya",
            "text": "Hmm, embora eu sinta que \"acostumado\" não expressa meus sentimentos completamente."
        },
        {
            "id": "690150703",
            "speaker": "Kaeya",
            "text": "No início realmente fiquei assustado.",
            "choices": [
                {
                    "id": "690150704",
                    "text": "Assustado, no bom sentido?",
                    "response": [
                        {
                            "id": "690150705",
                            "speaker": "Kaeya",
                            "text": "Sim, claro!"
                        },
                        {
                            "id": "690150708",
                            "speaker": "Kaeya",
                            "text": "Aqui é ainda mais bonito do que eu imaginei."
                        },
                        {
                            "id": "690150709",
                            "speaker": "Kaeya",
                            "text": "Mas, como fiquei aqui já por algum tempo, já não me sinto tão assustado. Até me sinto um pouco livre, e tenho um sentimento de pertença aqui."
                        },
                        {
                            "id": "690150710",
                            "speaker": "Kaeya",
                            "text": "Isso é raro..."
                        }
                    ]
                },
                {
                    "id": "690150706",
                    "text": "Assustado, no mau sentido?",
                    "response": [
                        {
                            "id": "690150707",
                            "speaker": "Kaeya",
                            "text": "*Suspiro* É claro que é no bom sentido."
                        }
                    ]
                }
            ]
        }
    ]
}