{
    "talkId": "6902908",
    "total_dialogue_lines": 19,
    "speaker_counts": {
        "Klee": 12,
        "Player": 7
    },
    "dialogues": [
        {
            "id": "690290801",
            "speaker": "Player",
            "text": "Gostaria de fazer alguma coisa?"
        },
        {
            "id": "690290401",
            "speaker": "Player",
            "text": "<color=#FFCC33FF>O que você gostaria de fazer?</color>"
        },
        {
            "id": "690290402",
            "speaker": "Klee",
            "text": "Sim! Eu tenho algo que preciso de sua ajuda!"
        },
        {
            "id": "690290403",
            "speaker": "Klee",
            "text": "Eu quero fazer um exército de Bombinhas Dançantes!",
            "choices": [
                {
                    "id": "690290404",
                    "text": "...Bombinhas Dançantes?",
                    "response": [
                        {
                            "id": "690290405",
                            "speaker": "Klee",
                            "text": "Sim, um exército de Bombinhas Dançantes! São várias... Várias e várias Bombinhas Dançantes."
                        },
                        {
                            "id": "690290406",
                            "speaker": "Klee",
                            "text": "#Por favoooorrr, {NICKNAME}!"
                        },
                        {
                            "id": "690290407",
                            "speaker": "Player",
                            "text": "Está bem..."
                        },
                        {
                            "id": "690290410",
                            "speaker": "Klee",
                            "text": "Bem, vamos começar a trabalhar então!"
                        },
                        {
                            "id": "690290411",
                            "speaker": "Klee",
                            "text": "#Klee fica responsável por fazer bombinhas dançantes e {NICKNAME} fica responsável por criar personagens para elas."
                        },
                        {
                            "id": "690290412",
                            "speaker": "Klee",
                            "text": "Precisamos de um vendedor, de um Chef, um pintor e membros do circo...",
                            "choices": [
                                {
                                    "id": "690290413",
                                    "text": "Parece que não existem pessoas assim nos Cavaleiros de Favonius...",
                                    "response": [
                                        {
                                            "id": "690290414",
                                            "speaker": "Klee",
                                            "text": "Não tem problema! Todos podem vir para o Ludi Harpastum!"
                                        },
                                        {
                                            "id": "690290417",
                                            "speaker": "Klee",
                                            "text": "#Com um Exército de Bombinhas Dançantes, Klee poderá se divertir no Ludi Harpastum todos os dias com {NICKNAME}!"
                                        },
                                        {
                                            "id": "690290418",
                                            "speaker": "Klee",
                                            "text": "Um Ludi Harpastum com você é o melhor Ludi Harpastum!"
                                        }
                                    ]
                                },
                                {
                                    "id": "690290415",
                                    "text": "Parece um pouco complicado.",
                                    "response": [
                                        {
                                            "id": "690290416",
                                            "speaker": "Klee",
                                            "text": "Não é nada demais. Só basta que todos usem pequenos acessórios para que possam diferenciar suas identidades!"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690290408",
                    "text": "Eu posso ajudar.",
                    "response": [
                        {
                            "id": "690290409",
                            "speaker": "Klee",
                            "text": "#{NICKNAME}, você é {F#a}{M#o} melhor!"
                        }
                    ]
                }
            ]
        }
    ]
}