{
    "talkId": "6902507",
    "total_dialogue_lines": 18,
    "speaker_counts": {
        "Player": 7,
        "Xingqiu": 11
    },
    "dialogues": [
        {
            "id": "690250701",
            "speaker": "Player",
            "text": "Quer conversar comigo?"
        },
        {
            "id": "690250301",
            "speaker": "Player",
            "text": "<color=#FFCC33FF>Você quer conversar comigo?</color>"
        },
        {
            "id": "690250302",
            "speaker": "Xingqiu",
            "text": "Mas é claro! É sempre um prazer conversar com você."
        },
        {
            "id": "690250303",
            "speaker": "Xingqiu",
            "text": "Diga-me, o que você tem feito recentemente?",
            "choices": [
                {
                    "id": "690250304",
                    "text": "Oh, você sabe... Escoltando cargas, castigando discípulos do mal...",
                    "response": [
                        {
                            "id": "690250306",
                            "speaker": "Xingqiu",
                            "text": "Magnífico! Atos de puro cavalheirismo, pelo que parece."
                        },
                        {
                            "id": "690250307",
                            "speaker": "Xingqiu",
                            "text": "*Suspiro* Oh, como eu adoraria sair usando a espada com você... Perseguindo pela justiça por toda a terra!",
                            "choices": [
                                {
                                    "id": "690250308",
                                    "text": "Mas suas mãos estão atadas, correto?",
                                    "response": [
                                        {
                                            "id": "690250309",
                                            "speaker": "Xingqiu",
                                            "text": "Esqueça, haha. Acabei de ter uma ótima ideia..."
                                        },
                                        {
                                            "id": "690250312",
                                            "speaker": "Xingqiu",
                                            "text": "Por que não temos uma pequena competição? O primeiro a fazer cem atos de cavalheirismo ganha!"
                                        },
                                        {
                                            "id": "690250313",
                                            "speaker": "Xingqiu",
                                            "text": "Não há restrições quanto à natureza do ato ou do beneficiário. Mas é preciso manter uma contagem. Uma vez concluído o ato, ele deve ser verificado pela outra parte."
                                        },
                                        {
                                            "id": "690250314",
                                            "speaker": "Player",
                                            "text": "Estou me sentindo bem confiante."
                                        },
                                        {
                                            "id": "690250315",
                                            "speaker": "Xingqiu",
                                            "text": "Hehehehehe..."
                                        },
                                        {
                                            "id": "690250316",
                                            "speaker": "Xingqiu",
                                            "text": "Oh, hehe... Não ligue para mim."
                                        },
                                        {
                                            "id": "690250317",
                                            "speaker": "Xingqiu",
                                            "text": "Apenas... Não espere ganhar tão facilmente."
                                        }
                                    ]
                                },
                                {
                                    "id": "690250310",
                                    "text": "#Eu ficaria muito honrad{M#o}{F#a} em ter você comigo.",
                                    "response": [
                                        {
                                            "id": "690250311",
                                            "speaker": "Xingqiu",
                                            "text": "Hehe... É uma pena que tenha que esperar até algum momento no futuro. Mas se estamos falando do aqui e agora... Ooh! Eu entendi..."
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690250305",
                    "text": "Afugentando monstros, resgatando pessoas da morte certa... O costumeiro."
                }
            ]
        }
    ]
}