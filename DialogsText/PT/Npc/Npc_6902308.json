{
    "talkId": "6902308",
    "total_dialogue_lines": 24,
    "speaker_counts": {
        "Player": 7,
        "Xiangling": 17
    },
    "dialogues": [
        {
            "id": "690230801",
            "speaker": "Player",
            "text": "Gostaria de fazer alguma coisa?"
        },
        {
            "id": "690230401",
            "speaker": "Player",
            "text": "<color=#FFCC33FF>O que você gostaria de fazer?</color>"
        },
        {
            "id": "690230402",
            "speaker": "Xiangling",
            "text": "#Vamos junt{F#as}{M#os} em uma aventura!",
            "choices": [
                {
                    "id": "690230403",
                    "text": "Isso não era o que já estávamos fazendo?",
                    "response": [
                        {
                            "id": "690230404",
                            "speaker": "Xiangling",
                            "text": "Sim, isso mesmo!"
                        },
                        {
                            "id": "690230405",
                            "speaker": "Xiangling",
                            "text": "Mas, isso ainda é a primeira coisa que eu queria fazer!"
                        },
                        {
                            "id": "690230408",
                            "speaker": "Xiangling",
                            "text": "Quero fazer aventuras junto com você, explorar o desconhecido. Coletar todos os tipos de ingredientes misteriosos de Teyvat para cozinhar uma comida gostosa e que você prove ela!"
                        },
                        {
                            "id": "690230409",
                            "speaker": "Xiangling",
                            "text": "Depois de pensar sobre isso, creio que isso é a coisa mais feliz."
                        },
                        {
                            "id": "690230410",
                            "speaker": "Player",
                            "text": "(A felicidade de Xiangling é muito simples...)"
                        },
                        {
                            "id": "690230411",
                            "speaker": "Xiangling",
                            "text": "O que aconteceu?"
                        },
                        {
                            "id": "690230412",
                            "speaker": "Xiangling",
                            "text": "Por que você está me olhando e não fala nada? Será que não está entendendo o que estou falando..."
                        },
                        {
                            "id": "690230413",
                            "speaker": "Xiangling",
                            "text": "Eu não vou adicionar um condimento estranho na sua comida!"
                        },
                        {
                            "id": "690230414",
                            "speaker": "Xiangling",
                            "text": "Uh - o que quero dizer é... Eu definitivamente pedirei sua opinião quando estiver inspirada para fazer algo!"
                        },
                        {
                            "id": "690230415",
                            "speaker": "Xiangling",
                            "text": "Além disso... Quando estivermos na natureza, eu não ficarei no seu caminho!"
                        },
                        {
                            "id": "690230416",
                            "speaker": "Xiangling",
                            "text": "E se encontrarmos inimigos que não possamos lidar, posso correr ainda mais rápido...",
                            "choices": [
                                {
                                    "id": "690230417",
                                    "text": "Eu nunca disse que não gostava da ideia...",
                                    "response": [
                                        {
                                            "id": "690230418",
                                            "speaker": "Xiangling",
                                            "text": "... Quase que você me mata de susto."
                                        },
                                        {
                                            "id": "690230421",
                                            "speaker": "Xiangling",
                                            "text": "Está bem, está bem."
                                        },
                                        {
                                            "id": "690230422",
                                            "speaker": "Xiangling",
                                            "text": "Mas, eu também estou ainda mais forte. Não importa se é como Chef ou noutros aspectos."
                                        },
                                        {
                                            "id": "690230423",
                                            "speaker": "Xiangling",
                                            "text": "Qualquer coisa para colocar um sorriso em seu rosto!"
                                        }
                                    ]
                                },
                                {
                                    "id": "690230419",
                                    "text": "Estava pensando sobre as suas coisas, Xiangling.",
                                    "response": [
                                        {
                                            "id": "690230420",
                                            "speaker": "Xiangling",
                                            "text": "Oh..."
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690230406",
                    "text": "Eu pensei que você queria que eu provasse as comidas.",
                    "response": [
                        {
                            "id": "690230407",
                            "speaker": "Xiangling",
                            "text": "Provar comidas faz parte da aventura!"
                        }
                    ]
                }
            ]
        }
    ]
}