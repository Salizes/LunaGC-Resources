    "dialogues": [
        {
            "id": "661010301",
            "speaker": "Player",
            "text": "Você consegue vender para mim?"
        },
        {
            "id": "661010302",
            "speaker": "Michica",
            "text": "O quê? O contrabando?"
        },
        {
            "id": "661010303",
            "speaker": "Michica",
            "text": "Ei, criatura, para com isso!"
        },
        {
            "id": "661010304",
            "speaker": "Michica",
            "text": "Ahem, aquilo foi só uma piadinha! De jeito nenhum eu sairia por aí e venderia essas coisas."
        },
        {
            "id": "661010305",
            "speaker": "Michica",
            "text": "Apenas faça de conta que você nunca ouviu nada, tudo bem? Muito obrigado."
