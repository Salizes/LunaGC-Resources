    "dialogues": [
        {
            "id": "690220901",
            "speaker": "Player",
            "text": "Você já se acostumou com esse lugar?"
        },
        {
            "id": "690220202",
            "speaker": "Venti",
            "text": "É ótimo, é claro."
        },
        {
            "id": "690220203",
            "speaker": "Venti",
            "text": "Eu sei que cada detalhe aqui é o resultado de seu trabalho árduo. Eu tenho imensa gratidão por tudo o que você fez.",
            "choices": [
                {
                    "id": "690220204",
                    "text": "Que bom você ter gostado!",
                    "response": [
                        {
                            "id": "690220205",
                            "speaker": "Venti",
                            "text": "Sim, gosto!"
                        },
                        {
                            "id": "690220208",
                            "speaker": "Venti",
                            "text": "*Suspiro*... Apesar de perguntar minha opinião, eu estou muito feliz."
                        },
                        {
                            "id": "690220209",
                            "speaker": "Venti",
                            "text": "Mas você também deveria ter confiança no seu próprio gosto!"
                        },
                        {
                            "id": "690220210",
                            "speaker": "Venti",
                            "text": "#Você é {F#a verdadeiro}{M#o verdadeiro} protagonista daqui!"
                        },
                        {
                            "id": "690220211",
                            "speaker": "Venti",
                            "text": "Não custa nada tentar! Torne seus sonhos em realidade!"
                        }
                    ]
                },
                {
                    "id": "690220206",
                    "text": "Venti, você gostaria de algo?",
                    "response": [
                        {
                            "id": "690220207",
                            "speaker": "Venti",
                            "text": "O que eu gostaria... Tudo já está aqui!"
                        }
                    ]
                }
            ]
        }
    ]
}