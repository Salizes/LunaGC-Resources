{
    "talkId": "6903403",
    "total_dialogue_lines": 21,
    "speaker_counts": {
        "Noelle": 15,
        "Player": 6
    },
    "dialogues": [
        {
            "id": "690340301",
            "speaker": "Player",
            "text": "<color=#FFCC33FF>Você quer conversar comigo?</color>"
        },
        {
            "id": "690340209",
            "speaker": "Noelle",
            "text": "Bem, essa é a minha honra."
        },
        {
            "id": "690340302",
            "speaker": "Noelle",
            "text": "A propósito... Desde que vim para aqui, nunca mais peguei nenhum objeto perdido de origem desconhecida."
        },
        {
            "id": "690340303",
            "speaker": "Noelle",
            "text": "Acho que ainda não estou acostumada.",
            "choices": [
                {
                    "id": "690340304",
                    "text": "Hã?",
                    "response": [
                        {
                            "id": "690340305",
                            "speaker": "Noelle",
                            "text": "Objetos encontrados enquanto faço os trabalhos de limpeza."
                        },
                        {
                            "id": "690340308",
                            "speaker": "Noelle",
                            "text": "Por exemplo... Quando encontrei uma bandana com uma cor apagada no fundo de um armário."
                        },
                        {
                            "id": "690340309",
                            "speaker": "Noelle",
                            "text": "Ou uma bola mordida pelos gatos nos arbustos."
                        },
                        {
                            "id": "690340310",
                            "speaker": "Noelle",
                            "text": "Ou até marcadores de páginas nos cantos da Biblioteca, chaves perdidas no caminho ou uma carta de confissão sem assinatura na fenda da porta da Catedral...",
                            "choices": [
                                {
                                    "id": "690340311",
                                    "text": "Parece que o trabalho de limpeza é muito cansativo...",
                                    "response": [
                                        {
                                            "id": "690340312",
                                            "speaker": "Noelle",
                                            "text": "Não, não! Eu me sinto muito honrada eu fazê-lo."
                                        },
                                        {
                                            "id": "690340315",
                                            "speaker": "Noelle",
                                            "text": "Mas, falando nisso..."
                                        },
                                        {
                                            "id": "690340316",
                                            "speaker": "Noelle",
                                            "text": "Essa casa sempre esteve muito limpa."
                                        },
                                        {
                                            "id": "690340317",
                                            "speaker": "Player",
                                            "text": "Também graças ao seu trabalho, Noelle."
                                        },
                                        {
                                            "id": "690340318",
                                            "speaker": "Noelle",
                                            "text": "Obrigada..."
                                        },
                                        {
                                            "id": "690340319",
                                            "speaker": "Noelle",
                                            "text": "Eu sou muito dedicada ao meu trabalho! E fico ainda mais feliz que limpar os Cavaleiros de Favonius ou qualquer outro lugar."
                                        },
                                        {
                                            "id": "690340320",
                                            "speaker": "Noelle",
                                            "text": "Porque... Essa é sua casa."
                                        }
                                    ]
                                },
                                {
                                    "id": "690340313",
                                    "text": "E onde você coloca essas coisas depois de encontrá-las?",
                                    "response": [
                                        {
                                            "id": "690340314",
                                            "speaker": "Noelle",
                                            "text": "Eu sempre faço um esforço para encontrar os donos! Mas os donos de algumas coisas nunca aparecem e as coisas ficam com os Cavaleiros de Favonius."
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690340306",
                    "text": "Noelle, você tem o hábito de pegar coisas do chão?",
                    "response": [
                        {
                            "id": "690340307",
                            "speaker": "Noelle",
                            "text": "Não, não é isso. É que encontrei enquanto limpava..."
                        }
                    ]
                }
            ]
        }
    ]
}