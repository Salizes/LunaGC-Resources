{
    "talkId": "6902208",
    "total_dialogue_lines": 22,
    "speaker_counts": {
        "Player": 7,
        "Venti": 15
    },
    "dialogues": [
        {
            "id": "690220801",
            "speaker": "Player",
            "text": "Gostaria de fazer alguma coisa?"
        },
        {
            "id": "690220401",
            "speaker": "Player",
            "text": "<color=#FFCC33FF>O que você gostaria de fazer?</color>"
        },
        {
            "id": "690220402",
            "speaker": "Venti",
            "text": "Bem... Vamos realizar um banquete!"
        },
        {
            "id": "690220403",
            "speaker": "Venti",
            "text": "Chame seus melhores amigos, eu levarei o meu vinho."
        },
        {
            "id": "690220404",
            "speaker": "Venti",
            "text": "Quanto ao local..."
        },
        {
            "id": "690220405",
            "speaker": "Venti",
            "text": "Que tal ficarmos aqui? Procuramos um lugar, e o adornamos com bancos, cercas e belas flores.",
            "choices": [
                {
                    "id": "690220406",
                    "text": "Mas... Qual o tema da comemoração?",
                    "response": [
                        {
                            "id": "690220407",
                            "speaker": "Venti",
                            "text": "Uh? Ainda é necessário um tema? Espere eu vou pensar em um."
                        },
                        {
                            "id": "690220408",
                            "speaker": "Venti",
                            "text": "\"Saúde\" \"Tin tin\"... Isso! \"Bênçãos de felicidade\"! O que você acha?"
                        },
                        {
                            "id": "690220412",
                            "speaker": "Venti",
                            "text": "Oh, sim! Posso lhe pedir que prepare algumas comidas?"
                        },
                        {
                            "id": "690220413",
                            "speaker": "Venti",
                            "text": "Qualquer coisa está bom, gosto de comer o que você faz!",
                            "choices": [
                                {
                                    "id": "690220414",
                                    "text": "Isso me deixa feliz.",
                                    "response": [
                                        {
                                            "id": "690220415",
                                            "speaker": "Venti",
                                            "text": "Sim, sim. Com certeza será muito animado."
                                        },
                                        {
                                            "id": "690220420",
                                            "speaker": "Venti",
                                            "text": "Certo, então vamos começar os preparativos!"
                                        },
                                        {
                                            "id": "690220421",
                                            "speaker": "Venti",
                                            "text": "Que dia alegre... Hoje também é um dia digno de beber um copo para celebrar."
                                        }
                                    ]
                                },
                                {
                                    "id": "690220416",
                                    "text": "Hmm... Sinto que isso vai ser caótico.",
                                    "response": [
                                        {
                                            "id": "690220417",
                                            "speaker": "Venti",
                                            "text": "Hehehe, fazer pouco caso do caos é a marca registrada dos banquetes!"
                                        },
                                        {
                                            "id": "690220418",
                                            "speaker": "Venti",
                                            "text": "Relaxe, eu cuidarei de tudo."
                                        }
                                    ]
                                },
                                {
                                    "id": "690220419",
                                    "text": "Também me esforçarei."
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690220409",
                    "text": "Você vai se apresentar nele, Venti?",
                    "response": [
                        {
                            "id": "690220410",
                            "speaker": "Venti",
                            "text": "Certo! Vou cantar uma suíte que não toco há muito tempo."
                        },
                        {
                            "id": "690220411",
                            "speaker": "Venti",
                            "text": "O que você gostaria de ouvir eu cantar? Posso praticar de antemão, claro, não preciso de tanto tempo assim."
                        }
                    ]
                }
            ]
        }
    ]
}