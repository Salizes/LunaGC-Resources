{
    "talkId": "6142702",
    "total_dialogue_lines": 18,
    "speaker_counts": {
        "Donna": 15,
        "Player": 3
    },
    "dialogues": [
        {
            "id": "4015142702",
            "speaker": "Player",
            "text": "Quem é você?"
        },
        {
            "id": "4015142706",
            "speaker": "Donna",
            "text": "Ei?!"
        },
        {
            "id": "4015142707",
            "speaker": "Donna",
            "text": "Eu sou apenas uma garota comum... Ajudando por aqui..."
        },
        {
            "id": "4015142708",
            "speaker": "Donna",
            "text": "(Deuses, estou ficando vermelha?)"
        },
        {
            "id": "4015142709",
            "speaker": "Donna",
            "text": "(Eu sonhei que o Diluc estava me dando flores... Isso parece muito óbvio?)"
        },
        {
            "id": "4015142710",
            "speaker": "Donna",
            "text": "Não... Não me olhe assim... Não tem nada de especial em mim.",
            "choices": [
                {
                    "id": "4015142703",
                    "text": "Diluc?",
                    "response": [
                        {
                            "id": "4015142711",
                            "speaker": "Donna",
                            "text": "Oh... Eu disse isso... Em voz alta...?"
                        },
                        {
                            "id": "4015142712",
                            "speaker": "Donna",
                            "text": "Me desculpe..."
                        },
                        {
                            "id": "4015142713",
                            "speaker": "Donna",
                            "text": "Eu estive sonhando acordada em me encontrar com o Diluc aqui... Então eu..."
                        },
                        {
                            "id": "4015142714",
                            "speaker": "Donna",
                            "text": "Não, eu não..."
                        },
                        {
                            "id": "4015142715",
                            "speaker": "Donna",
                            "text": "(O que eu faço? Eu amo tanto o Diluc!)"
                        }
                    ]
                },
                {
                    "id": "4015142704",
                    "text": "Torta da Lua?",
                    "response": [
                        {
                            "id": "4015142716",
                            "speaker": "Donna",
                            "text": "Você está aqui pelas Tortas da Lua?"
                        },
                        {
                            "id": "4015142717",
                            "speaker": "Donna",
                            "text": "Elas são uma especialidade de Mondstadt, um tipo de torta de carne que é doce e gratificante."
                        },
                        {
                            "id": "4015142718",
                            "speaker": "Donna",
                            "text": "(Eu poderia fazer uma Torta da Lua deliciosa e dar ao Diluc...)"
                        },
                        {
                            "id": "4015142719",
                            "speaker": "Donna",
                            "text": "(Pare... Pare com isso, Donna!)"
                        },
                        {
                            "id": "4015142720",
                            "speaker": "Donna",
                            "text": "Se você tiver a oportunidade, não deixe de experimentar!"
                        }
                    ]
                }
            ]
        }
    ]
}