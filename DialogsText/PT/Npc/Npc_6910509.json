{
    "talkId": "6910509",
    "total_dialogue_lines": 35,
    "speaker_counts": {
        "Ororon": 21,
        "Player": 14
    },
    "dialogues": [
        {
            "id": "691050401",
            "speaker": "Player",
            "text": "Gostaria de fazer alguma coisa?"
        },
        {
            "id": "691050402",
            "speaker": "Ororon",
            "text": "Não consigo pensar em nada. Você tem algo para recomendar?"
        },
        {
            "id": "691050403",
            "speaker": "Player",
            "text": "Que tal... algo pacífico?"
        },
        {
            "id": "691050404",
            "speaker": "Ororon",
            "text": "Nesse caso... talvez você gostaria de experimentar Gravura de Flogisto?"
        },
        {
            "id": "691050405",
            "speaker": "Ororon",
            "text": "Parece mais sério do que realmente é. Basicamente, envolve pintar padrões que podem ser ativados para gerar diferentes efeitos, usando Flogisto ou Energia Elemental."
        },
        {
            "id": "691050406",
            "speaker": "Ororon",
            "text": "Se não estamos procurando por efeitos específicos, podemos tornar ainda mais simples ao desenhar grafites aleatórios e deixar o resto acontecer naturalmente."
        },
        {
            "id": "691050407",
            "speaker": "Ororon",
            "text": "Por exemplo, desenhar Paimon nas costas da sua mão, pode acabar causando uma fome extrema por um tempo."
        },
        {
            "id": "691050408",
            "speaker": "Player",
            "text": "Faz sentido."
        },
        {
            "id": "691050409",
            "speaker": "Ororon",
            "text": "Tudo depende do padrão em si e a fórmula da tinta."
        },
        {
            "id": "691050410",
            "speaker": "Player",
            "text": "Que tal... algo que não é nem um pouco pacífico?"
        },
        {
            "id": "691050411",
            "speaker": "Ororon",
            "text": "Você quer dizer, algum tipo de esporte ou atividade física?"
        },
        {
            "id": "691050412",
            "speaker": "Ororon",
            "text": "Poderíamos apostar uma corrida."
        },
        {
            "id": "691050413",
            "speaker": "Player",
            "text": "?",
            "choices": [
                {
                    "id": "691050414",
                    "text": "E com isso, você quer dizer... ver quem consegue correr mais rápido?",
                    "response": [
                        {
                            "id": "691050416",
                            "speaker": "Ororon",
                            "text": "Nunca se subestime."
                        },
                        {
                            "id": "691050417",
                            "speaker": "Ororon",
                            "text": "Se você não está se sentindo confiante suficiente, posso te mostrar como fazer bombas de fumaça de grafite. Dessa forma, é uma competição justa.",
                            "choices": [
                                {
                                    "id": "691050418",
                                    "text": "Eu adoraria.",
                                    "response": [
                                        {
                                            "id": "691050420",
                                            "speaker": "Ororon",
                                            "text": "Oh... Você tem razão."
                                        },
                                        {
                                            "id": "691050421",
                                            "speaker": "Ororon",
                                            "text": "Esse lugar se parece tanto com minha casa, quase esqueci que ainda sou um convidado. Desculpe por isso."
                                        },
                                        {
                                            "id": "691050422",
                                            "speaker": "Ororon",
                                            "text": "Nesse caso, teremos que aceitar ser apenas uma simples corrida. Por mim tudo bem — é exercício da mesma forma."
                                        },
                                        {
                                            "id": "691050423",
                                            "speaker": "Player",
                                            "text": "Alguma outra opção?"
                                        },
                                        {
                                            "id": "691050424",
                                            "speaker": "Ororon",
                                            "text": "Claro. Que tal uma combinação dos dois?"
                                        },
                                        {
                                            "id": "691050425",
                                            "speaker": "Ororon",
                                            "text": "Em outras palavras, fazer grafite durante a corrida.",
                                            "choices": [
                                                {
                                                    "id": "691050426",
                                                    "text": "Haha!",
                                                    "response": [
                                                        {
                                                            "id": "691050429",
                                                            "speaker": "Ororon",
                                                            "text": "Baseado na sua reação, você espera que seja uma piada, né?"
                                                        },
                                                        {
                                                            "id": "691050430",
                                                            "speaker": "Ororon",
                                                            "text": "Então, uh... É. Era uma piada."
                                                        },
                                                        {
                                                            "id": "691050431",
                                                            "speaker": "Player",
                                                            "text": "Valeu por conversar comigo. Foi bem divertido."
                                                        },
                                                        {
                                                            "id": "691050432",
                                                            "speaker": "Ororon",
                                                            "text": "É claro! E, bem, eu quem deveria estar te agradecendo."
                                                        },
                                                        {
                                                            "id": "691050433",
                                                            "speaker": "Ororon",
                                                            "text": "Não costumo visitar a casa dos meus amigos, então realmente aprecio você ter me convidado para cá."
                                                        },
                                                        {
                                                            "id": "691050434",
                                                            "speaker": "Player",
                                                            "text": "Por nada! Sinta-se livre para vir a qualquer momento."
                                                        },
                                                        {
                                                            "id": "691050435",
                                                            "speaker": "Ororon",
                                                            "text": "Obrigado! Da próxima vez, até trarei meu rabanete premiado — é bem grandão."
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "691050427",
                                                    "text": "...Você está brincando, não é?",
                                                    "response": [
                                                        {
                                                            "id": "691050428",
                                                            "speaker": "Ororon",
                                                            "text": "...Sim?"
                                                        }
                                                    ]
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "691050419",
                                    "text": "Mas, parece algo difícil de limpar depois..."
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "691050415",
                    "text": "Eu certamente perderia."
                }
            ]
        }
    ]
}