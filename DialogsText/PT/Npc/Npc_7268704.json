    "dialogues": [
        {
            "id": "726870401",
            "speaker": "Fushizome",
            "text": "#Olá, bem-vind{F#as}{M#os}."
        },
        {
            "id": "726870402",
            "speaker": "Fushizome",
            "text": "#Você está interessad{F#a}{M#o} na Ikebana?",
            "choices": [
                {
                    "id": "726870403",
                    "text": "Ikebana?",
                    "response": [
                        {
                            "id": "726870404",
                            "speaker": "Paimon",
                            "text": "Paimon acha que já vimos algo parecido antes..."
                        },
                        {
                            "id": "726870405",
                            "speaker": "Fushizome",
                            "text": "Isso é ótimo!"
                        },
                        {
                            "id": "726870406",
                            "speaker": "Fushizome",
                            "text": "Neste momento, estou preparando um evento para divulgar a beleza da Ikebana."
                        },
                        {
