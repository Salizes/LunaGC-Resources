    "dialogues": [
        {
            "id": "690430401",
            "speaker": "Player",
            "text": "<color=#FFCC33FF>O que você gostaria de fazer?</color>"
        },
        {
            "id": "690430402",
            "speaker": "Sucrose",
            "text": "Ah, é assim então...? Eu tenho algumas perguntas simples para lhe fazer."
        },
        {
            "id": "690430403",
            "speaker": "Sucrose",
            "text": "Você só precisa me dizer sua primeira opção, não há resposta errada."
        },
        {
            "id": "690430404",
            "speaker": "Sucrose",
            "text": "Lâmpada de Grama ou Margaridas Voadoras?",
            "choices": [
                {
                    "id": "690430405",
                    "text": "Lâmpada de Grama.",
                    "response": [
                        {
                            "id": "690430407",
                            "speaker": "Sucrose",
                            "text": "Anemogrãos ou Borboletas de Cristal?",
                            "choices": [
                                {
                                    "id": "690430408",
                                    "text": "Anemogrão.",
                                    "response": [
                                        {
                                            "id": "690430410",
                                            "speaker": "Sucrose",
                                            "text": "Mar de Nuvens ou Campos de Flores?",
                                            "choices": [
                                                {
                                                    "id": "690430411",
                                                    "text": "Mar de Nuvens.",
                                                    "response": [
                                                        {
                                                            "id": "690430413",
                                                            "speaker": "Sucrose",
                                                            "text": "Está bem, anotei."
                                                        },
                                                        {
                                                            "id": "690430414",
                                                            "speaker": "Sucrose",
                                                            "text": "Antes, eu não sabia como expressar meus sentimentos."
                                                        },
                                                        {
                                                            "id": "690430415",
                                                            "speaker": "Sucrose",
                                                            "text": "Eu queria lhe convidar para irmos ao meu paraíso... Mas eu ainda não tenho a capacidade de criá-lo."
                                                        },
                                                        {
                                                            "id": "690430416",
                                                            "speaker": "Sucrose",
                                                            "text": "Por isso, por enquanto eu só posso pegar suas escolhas e colocar nessa bola de cristal."
                                                        },
                                                        {
                                                            "id": "690430417",
                                                            "speaker": "Sucrose",
                                                            "text": "Até que um dia irei tirá-las para colocar no meu paraíso.",
                                                            "choices": [
                                                                {
                                                                    "id": "690430418",
                                                                    "text": "Fechado!",
                                                                    "response": [
                                                                        {
                                                                            "id": "690430419",
                                                                            "speaker": "Sucrose",
                                                                            "text": "Hmm... Fechado."
                                                                        }
                                                                    ]
                                                                },
                                                                {
                                                                    "id": "690430420",
                                                                    "text": "Você também deve colocar as coisas que você gosta, Sucrose.",
                                                                    "response": [
                                                                        {
                                                                            "id": "690430421",
                                                                            "speaker": "Sucrose",
                                                                            "text": "Sim... Eu me esforçarei!"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "690430412",
                                                    "text": "Campos de Flores."
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "690430409",
                                    "text": "Borboletas de Cristal."
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690430406",
                    "text": "Margaridas Voadoras."
                }
            ]
        }
    ]
