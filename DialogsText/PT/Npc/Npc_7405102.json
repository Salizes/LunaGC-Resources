{
    "talkId": "7405102",
    "total_dialogue_lines": 22,
    "speaker_counts": {
        "Player": 6,
        "Srta. Qiu": 9,
        "Xingye": 3,
        "Yifeng": 4
    },
    "dialogues": [
        {
            "id": "740510201",
            "speaker": "Xingye",
            "text": "O que vamos fazer agora, Chefe? A filmagem não está pronta e o Projektor está perdido..."
        },
        {
            "id": "740510202",
            "speaker": "Srta. Qiu",
            "text": "Tudo bem, pare de suspirar. A gente não postou uma comissão na Guilda de Aventureiros?"
        },
        {
            "id": "740510203",
            "speaker": "Srta. Qiu",
            "text": "Só tem uma coisa que precisamos fazer hoje, esperar..."
        },
        {
            "id": "740510204",
            "speaker": "Yifeng",
            "text": "É, mas nosso filme inacabado ainda está na máquina."
        },
        {
            "id": "740510205",
            "speaker": "Yifeng",
            "text": "Mesmo que a máquina seja bem resistente, se o filme for danificado..."
        },
        {
            "id": "740510206",
            "speaker": "Srta. Qiu",
            "text": "Então...",
            "choices": [
                {
                    "id": "740510207",
                    "text": "Que Projektor?",
                    "response": [
                        {
                            "id": "740510208",
                            "speaker": "Srta. Qiu",
                            "text": "Ora, ora! Eu não disse que a ajuda estava a caminho? Como eu disse, tudo que tínhamos que fazer era esperar!"
                        },
                        {
                            "id": "740510221",
                            "speaker": "Yifeng",
                            "text": "Quando é que a eficiência da Guilda foi tão alta assim?"
                        },
                        {
                            "id": "740510209",
                            "speaker": "Xingye",
                            "text": "Hmm, parece que algumas pessoas de Fontaine não são preguiçosas no fim das contas."
                        },
                        {
                            "id": "740510210",
                            "speaker": "Srta. Qiu",
                            "text": "#Olá, aventureir{M#o}{F#a}. Você deve estar aqui pela comissão para nos ajudar a recuperar nosso Projektor, certo?"
                        },
                        {
                            "id": "740510211",
                            "speaker": "Srta. Qiu",
                            "text": "Fomos atacados por monstros ali, por favor, rápido...",
                            "choices": [
                                {
                                    "id": "740510212",
                                    "text": "Eu não aceitei nenhuma comissão.",
                                    "response": [
                                        {
                                            "id": "740510214",
                                            "speaker": "Xingye",
                                            "text": "Hmm..."
                                        },
                                        {
                                            "id": "740510215",
                                            "speaker": "Yifeng",
                                            "text": "Então..."
                                        },
                                        {
                                            "id": "740510216",
                                            "speaker": "Srta. Qiu",
                                            "text": "Está tudo bem! Sem estresse. Eu sabia que a Guilda de Aventureiros não era confiável..."
                                        },
                                        {
                                            "id": "740510217",
                                            "speaker": "Srta. Qiu",
                                            "text": "#Aventureir{M#o}{F#a}, gostaria de aceitar uma comissão de emergência? O pagamento é muito bom.",
                                            "choices": [
                                                {
                                                    "id": "740510218",
                                                    "text": "Eu posso ajudar com isso...",
                                                    "response": [
                                                        {
                                                            "id": "740510220",
                                                            "speaker": "Srta. Qiu",
                                                            "text": "Ótimo! Fantástico! Eu preciso que você vá e nos ajude a recuperar nosso Projektor! Teremos uma dívida com você!"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "740510219",
                                                    "text": "Contanto que o pagamento seja bom."
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "740510213",
                                    "text": "Eu só estava passando por perto."
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "740510222",
                    "text": "O que aconteceu?"
                }
            ]
        }
    ]
}