    },
    "dialogues": [
        {
            "id": "690390201",
            "speaker": "Player",
            "text": "<color=#FFCC33FF>Você se acostumou com esse lugar?</color>"
        },
        {
            "id": "690390202",
            "speaker": "Diona",
            "text": "Hmph, adequado.",
            "choices": [
                {
                    "id": "690390203",
                    "text": "Só adequado?",
                    "response": [
                        {
                            "id": "690390205",
                            "speaker": "Diona",
                            "text": "A grama aqui não é tão macia quanto a grama onde eu faço minhas sestas."
                        },
                        {
                            "id": "690390206",
                            "speaker": "Diona",
                            "text": "Aqui não tem tantas borboletas como no campo de flores onde eu vou frequentemente."
                        },
                        {
                            "id": "690390207",
                            "speaker": "Diona",
                            "text": "Aqui não é possível caçar de forma livre como na natureza..."
                        },
                        {
                            "id": "690390208",
                            "speaker": "Player",
                            "text": "Eu irei... Mudar."
                        },
                        {
                            "id": "690390209",
                            "speaker": "Diona",
                            "text": "Mas... Mas aqui não tem aquele cheiro desprezível de álcool que eu detesto..."
                        },
                        {
                            "id": "690390210",
                            "speaker": "Diona",
                            "text": "E também não tem aqueles montes de bêbados fazendo barulho."
                        },
                        {
                            "id": "690390211",
                            "speaker": "Diona",
                            "text": "Por isso, se puder continuar assim, é melhor..."
                        }
                    ]
                },
                {
                    "id": "690390204",
                    "text": "Diona, você tem alguma boa sugestão?"
                }
            ]
        }
    ]
}