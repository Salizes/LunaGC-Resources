    "dialogues": [
        {
            "id": "690210201",
            "speaker": "Player",
            "text": "<color=#FFCC33FF>Você se acostumou com esse lugar?</color>"
        },
        {
            "id": "690210202",
            "speaker": "Amber",
            "text": "Gosto muito!"
        },
        {
            "id": "690210203",
            "speaker": "Amber",
            "text": "Não sou muito criteriosa onde vou morar, afinal de contas, sou uma Aventureira. Tenho que me adaptar a todos os tipos de ambientes."
        },
        {
            "id": "690210204",
            "speaker": "Amber",
            "text": "Quando é necessário, posso até dormir nos galhos de uma árvore.",
            "choices": [
                {
                    "id": "690210205",
                    "text": "Você é realmente incrível.",
                    "response": [
                        {
                            "id": "690210206",
                            "speaker": "Amber",
                            "text": "Mesmo...?"
                        },
                        {
                            "id": "690210209",
                            "speaker": "Amber",
                            "text": "Relaxe! Gosto muito desse lugar."
                        }
                    ]
                },
                {
                    "id": "690210207",
                    "text": "Espero que aqui seja um pouco mais confortável que o galho de uma árvore.",
                    "response": [
                        {
                            "id": "690210208",
                            "speaker": "Amber",
                            "text": "Haha, claro que sim."
                        }
                    ]
                }
            ]
        }
    ]
}