{
    "talkId": "7665010",
    "total_dialogue_lines": 25,
    "speaker_counts": {
        "Furão Ladrão": 3,
        "Lauma": 10,
        "Paimon": 4,
        "Player": 8
    },
    "dialogues": [
        {
            "id": "766501001",
            "speaker": "Paimon",
            "text": "Oi, Lauma, viemos te visitar!",
            "choices": [
                {
                    "id": "766501002",
                    "text": "Isso é...",
                    "response": [
                        {
                            "id": "766501004",
                            "speaker": "Paimon",
                            "text": "É, tem razão. Olha para todas essas caixas e outras coisas no chão. Algumas foram abertas e outras não... Isso não era a biblioteca?",
                            "choices": [
                                {
                                    "id": "766501005",
                                    "text": "Parece que isso aqui era um armazém, na verdade.",
                                    "response": [
                                        {
                                            "id": "766501007",
                                            "speaker": "Paimon",
                                            "text": "Olha, Lauma tá ali falando com um Furão Ladrão. Será que deu problema de novo? Vamos dar uma olhada."
                                        },
                                        {
                                            "id": "766501008",
                                            "speaker": "Furão Ladrão",
                                            "text": "..."
                                        },
                                        {
                                            "id": "766501009",
                                            "speaker": "Lauma",
                                            "text": "*Suspiro* Seja como for, não temos nenhum trabalho de escavação urgente no momento... Então, por favor, pare de cavar buracos em todo lugar, certo?"
                                        },
                                        {
                                            "id": "766501010",
                                            "speaker": "Furão Ladrão",
                                            "text": "♪"
                                        },
                                        {
                                            "id": "766501011",
                                            "speaker": "Lauma",
                                            "text": "Que bom menino. Aqui, essa Mora é para você."
                                        },
                                        {
                                            "id": "766501012",
                                            "speaker": "Furão Ladrão",
                                            "text": "♪♪♪"
                                        },
                                        {
                                            "id": "766501013",
                                            "speaker": "Paimon",
                                            "text": "Esse é o Furão Ladrão da última vez, né? O que Lauma tava dizendo? Encontrou outra relíquia?"
                                        },
                                        {
                                            "id": "766501014",
                                            "speaker": "Lauma",
                                            "text": "#Olá, {NICKNAME}, Paimon. Boas-vindas à biblioteca. Posso ajudar vocês com alguma coisa?",
                                            "choices": [
                                                {
                                                    "id": "766501015",
                                                    "text": "Vi você conversando com o Furão Ladrão.",
                                                    "response": [
                                                        {
                                                            "id": "766501017",
                                                            "speaker": "Lauma",
                                                            "text": "Não. Eu só tava dando um aviso sério ao pequenino. Ele ficou um pouco animado demais ultimamente e está começando a incomodar a comunidade."
                                                        },
                                                        {
                                                            "id": "766501018",
                                                            "speaker": "Lauma",
                                                            "text": "A paixão dele por caça a tesouros só cresceu desde que recuperamos a Imagem Lunar... Ele vem até mim o tempo todo perguntando quando vai ser a próxima caça ao tesouro."
                                                        },
                                                        {
                                                            "id": "766501019",
                                                            "speaker": "Lauma",
                                                            "text": "Eu continuo repetindo que temos documentos e relíquias mais que suficientes em nossa biblioteca para ocupar nossa pesquisa, mas...",
                                                            "choices": [
                                                                {
                                                                    "id": "766501020",
                                                                    "text": "Ele não consegue mudar sua natureza.",
                                                                    "response": [
                                                                        {
                                                                            "id": "766501022",
                                                                            "speaker": "Lauma",
                                                                            "text": "Sim. Mas ele não entende direito o que constitui uma \"relíquia\", então simplesmente cava tudo que pareça valioso e traz para cá."
                                                                        },
                                                                        {
                                                                            "id": "766501023",
                                                                            "speaker": "Lauma",
                                                                            "text": "Ele pelo menos me prometeu que não ia sair cavando por aí de novo, mas já tem uma fila grande de itens de escavações anteriores... Não tem jeito. Eu vou ter que passar por eles individualmente para organizar todos."
                                                                        },
                                                                        {
                                                                            "id": "766501024",
                                                                            "speaker": "Lauma",
                                                                            "text": "Desculpem, pessoal. Receio que não vou poder acompanhar vocês no passeio de hoje."
                                                                        },
                                                                        {
                                                                            "id": "766501025",
                                                                            "speaker": "Lauma",
                                                                            "text": "Ufa... Agora, o que tá nessa caixa mesmo...?"
                                                                        }
                                                                    ]
                                                                },
                                                                {
                                                                    "id": "766501021",
                                                                    "text": "Ainda saiu procurando por coisas?"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "766501016",
                                                    "text": "Vocês descobriram mais relíquias enterradas?"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "766501006",
                                    "text": "Eles estão reformando den ovo?"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "766501003",
                    "text": "...Coisa demais."
                }
            ]
        }
    ]
}