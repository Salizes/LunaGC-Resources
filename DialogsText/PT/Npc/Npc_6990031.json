    },
    "dialogues": [
        {
            "id": "699003101",
            "speaker": "Player",
            "text": "Sobre o Grande Bazar..."
        },
        {
            "id": "699003102",
            "speaker": "Paimon",
            "text": "O povo do Grande Bazar é muito talentoso!"
        },
        {
            "id": "699003103",
            "speaker": "Paimon",
            "text": "Eles vendem itens tecidos, jarros e vasos lindos, e especiarias que só o cheiro da água na boca e faz a barriga de Paimon roncar..."
        },
        {
            "id": "699003104",
            "speaker": "Paimon",
            "text": "E todos eles cantam e dançam muito bom! Paimon gostaria de poder fazer isso!"
        },
        {
            "id": "699003105",
            "speaker": "Player",
            "text": "Bem, se você está falando sério, pode aprender."
        },
        {
            "id": "699003106",
            "speaker": "Paimon",
            "text": "O quê? Sério?",
            "choices": [
                {
                    "id": "699003107",
                    "text": "Dançar, por exemplo...",
                    "response": [
                        {
                            "id": "699003109",
                            "speaker": "Player",
                            "text": "Você não tem como tropeçar..."
                        },
                        {
                            "id": "699003111",
                            "speaker": "Paimon",
                            "text": "Oh, sim! Paimon sempre se esquece como voar é tão útil!"
                        },
                        {
                            "id": "699003112",
                            "speaker": "Paimon",
                            "text": "Vamos para o Grande Bazar para que o mundo admire e cubra Paimon de elogios!"
                        },
                        {
                            "id": "699003113",
                            "speaker": "Player",
                            "text": "Ahá! Então é sobre isso?"
                        }
                    ]
                },
                {
                    "id": "699003108",
                    "text": "Você tem uma vantagem natural."
                }
            ]
        }
    ]
}