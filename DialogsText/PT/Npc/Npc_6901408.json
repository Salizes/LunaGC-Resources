    "dialogues": [
        {
            "id": "690140801",
            "speaker": "Barbara",
            "text": "Oh, claro!"
        },
        {
            "id": "690140802",
            "speaker": "Barbara",
            "text": "Hehe...",
            "choices": [
                {
                    "id": "690140803",
                    "text": "Qual o motivo desse sorriso?",
                    "response": [
                        {
                            "id": "690140805",
                            "speaker": "Barbara",
                            "text": "Oh, acabei de perceber que não converso com um amigo há muito tempo."
                        },
                        {
                            "id": "690140806",
                            "speaker": "Barbara",
                            "text": "De repente, me sinto abençoada.",
                            "choices": [
                                {
                                    "id": "690140807",
                                    "text": "Parece que é fácil agradar você.",
                                    "response": [
                                        {
                                            "id": "690140808",
                                            "speaker": "Barbara",
                                            "text": "Uhh... É mesmo?"
                                        },
                                        {
                                            "id": "690140809",
                                            "speaker": "Barbara",
                                            "text": "Bem, talvez... Mas isso não é algo ruim."
                                        },
                                        {
                                            "id": "690140810",
                                            "speaker": "Barbara",
                                            "text": "Quanto mais feliz você for, mais energia terá para compartilhar essa felicidade com outras pessoas."
                                        },
                                        {
                                            "id": "690140815",
                                            "speaker": "Barbara",
                                            "text": "Ahh... Por favor, não precisa me elogiar tanto..."
                                        },
                                        {
                                            "id": "690140816",
                                            "speaker": "Barbara",
                                            "text": "Somente as críticas construtivas nos fazem crescer, certo...?"
                                        }
                                    ]
                                },
                                {
                                    "id": "690140811",
                                    "text": "É porque você sempre coloca as outras pessoas em primeiro lugar.",
                                    "response": [
                                        {
                                            "id": "690140812",
                                            "speaker": "Barbara",
                                            "text": "Claro que sim, é isso que devo fazer!"
                                        },
                                        {
                                            "id": "690140813",
                                            "speaker": "Barbara",
                                            "text": "Você tem sido o alvo das atenções de todos, eu quero me esforçar para retribuir sua bondade."
                                        }
                                    ]
                                },
                                {
                                    "id": "690140814",
                                    "text": "Você é mesmo incrível como as pessoas dizem."
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690140804",
                    "text": "Lembrou de alguma coisa engraçada?"
                }
            ]
        }
    ]
}