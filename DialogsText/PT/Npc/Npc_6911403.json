{
    "talkId": "6911403",
    "total_dialogue_lines": 29,
    "speaker_counts": {
        "Player": 9,
        "Skirk": 20
    },
    "dialogues": [
        {
            "id": "691140301",
            "speaker": "Player",
            "text": "Quer conversar comigo?"
        },
        {
            "id": "691140302",
            "speaker": "Skirk",
            "text": "Se você estiver com tempo para conversar, melhor aproveitar ele para refinar sua proeza marcial.",
            "choices": [
                {
                    "id": "691140303",
                    "text": "Ei, só uma conversinha nunca fez mal a ninguém!",
                    "response": [
                        {
                            "id": "691140304",
                            "speaker": "Skirk",
                            "text": "...",
                            "choices": [
                                {
                                    "id": "691140305",
                                    "text": "Vamos, só uma conversinha.",
                                    "response": [
                                        {
                                            "id": "691140306",
                                            "speaker": "Skirk",
                                            "text": "...",
                                            "choices": [
                                                {
                                                    "id": "691140307",
                                                    "text": "...Por favor?",
                                                    "response": [
                                                        {
                                                            "id": "691140308",
                                                            "speaker": "Skirk",
                                                            "text": "*Suspiro*..."
                                                        },
                                                        {
                                                            "id": "691140309",
                                                            "speaker": "Skirk",
                                                            "text": "O que você quer perguntar?",
                                                            "choices": [
                                                                {
                                                                    "id": "691140310",
                                                                    "text": "Você não se sente sozinha aqui?",
                                                                    "response": [
                                                                        {
                                                                            "id": "691140311",
                                                                            "speaker": "Skirk",
                                                                            "text": "Sozinha... Hmm, boa pergunta."
                                                                        },
                                                                        {
                                                                            "id": "691140312",
                                                                            "speaker": "Skirk",
                                                                            "text": "Os humanos costumam sofrer com a solidão. Alguns dizem que ela é a emoção mais agonizante de todas. Eu já estive no mesmo barco, mas agora, já selei isso através da racionalidade."
                                                                        },
                                                                        {
                                                                            "id": "691140313",
                                                                            "speaker": "Skirk",
                                                                            "text": "Depois de conquistar minha solidão, pensei mais nisso. Por que nos sentimos solitários? Por que essa emoção negativa é mantida, apesar de nossa evolução?"
                                                                        },
                                                                        {
                                                                            "id": "691140314",
                                                                            "speaker": "Skirk",
                                                                            "text": "Cheguei a conclusão que deve ser porque os humanos sempre viveram em comunidade. A solidão não serve nenhuma função positiva em um nível individual, mas foi benéfica para a sobrevivência da espécie como um todo."
                                                                        },
                                                                        {
                                                                            "id": "691140315",
                                                                            "speaker": "Skirk",
                                                                            "text": "Mas eu e o mestre evoluímos individualmente. Nosso caminho sempre foi diferente, distante da humanidade."
                                                                        },
                                                                        {
                                                                            "id": "691140316",
                                                                            "speaker": "Skirk",
                                                                            "text": "É por isso que eu às vezes observo os humanos e penso em quais emoções inúteis seriam benéficas eu manter. Afinal, é útil reter uma habilidade básica para ter empatia com os outros."
                                                                        }
                                                                    ]
                                                                },
                                                                {
                                                                    "id": "691140317",
                                                                    "text": "Você já se divertiu alguma vez...?",
                                                                    "response": [
                                                                        {
                                                                            "id": "691140318",
                                                                            "speaker": "Skirk",
                                                                            "text": "Então você ainda está tentando me entender... Eu não diria que me diverti muito na vida. Faz muito, muito tempo desde que isso aconteceu."
                                                                        },
                                                                        {
                                                                            "id": "691140319",
                                                                            "speaker": "Skirk",
                                                                            "text": "Quando eu era pequena, havia um lagarto gigante que vivia na floresta perto da minha casa. Ele não tinha medo de humanos, na verdade, era bem amigável com eles."
                                                                        },
                                                                        {
                                                                            "id": "691140320",
                                                                            "speaker": "Skirk",
                                                                            "text": "Minha mãe disse que ele tinha centenas de anos de idade. Eu não sei se isso é verdade. Tudo que eu sei é que ele parecia ser bem velho e passava o dia inteiro tomando banho de sol nos dosséis."
                                                                        },
                                                                        {
                                                                            "id": "691140321",
                                                                            "speaker": "Skirk",
                                                                            "text": "Eu adorava explorar a floresta quando era pequena. Um dia, fui perseguida por um enxame de abelhas, cada uma delas tinha o tamanho da palma da minha mão. No meu desespero, fugi até o lagarto e implorei por ajuda."
                                                                        },
                                                                        {
                                                                            "id": "691140322",
                                                                            "speaker": "Skirk",
                                                                            "text": "Para minha surpresa, o lagarto também não tinha como enfrentar as abelhas, por isso fugimos do enxame juntos. Eu era mais rápida e consegui mergulhar em um rio, escapando. Quando voltei para ver como o lagarto estava, ele estava caído no chão."
                                                                        },
                                                                        {
                                                                            "id": "691140323",
                                                                            "speaker": "Skirk",
                                                                            "text": "Eu pensei que ele havia morrido, chorei muito enquanto o segurava nos meus braços. Eu fiquei tão devastada que fiz um velório, até coloquei uma pedra como uma lápide."
                                                                        },
                                                                        {
                                                                            "id": "691140324",
                                                                            "speaker": "Skirk",
                                                                            "text": "Mas antes que eu conseguisse terminar, minha mãe me viu. Ela exumou imediatamente o lagarto, tratou seus ferimentos e o ajudou a se recuperar."
                                                                        },
                                                                        {
                                                                            "id": "691140325",
                                                                            "speaker": "Skirk",
                                                                            "text": "Desde então, ele continuou a ser amigável com todos os humanos... exceto eu. Todas as vezes que ele me via, fugia como se fosse o vento."
                                                                        },
                                                                        {
                                                                            "id": "691140326",
                                                                            "speaker": "Skirk",
                                                                            "text": "Eu... sequer sei se ele sobreviveu àquele incêndio."
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "691140327",
                                                    "text": "Bem..."
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "691140327",
                                    "text": "Bem..."
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "691140327",
                    "text": "Bem..."
                }
            ]
        }
    ]
}