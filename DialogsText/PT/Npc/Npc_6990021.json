    },
    "dialogues": [
        {
            "id": "699002101",
            "speaker": "Player",
            "text": "Sobre o Decreto de Caça à Visão..."
        },
        {
            "id": "699002102",
            "speaker": "Paimon",
            "text": "É difícil falar sobre os eventos recentes em Inazuma e não mencionar o Decreto de Caça à Visão."
        },
        {
            "id": "699002103",
            "speaker": "Paimon",
            "text": "Mas você não tem uma Visão, por isso não precisa se preocupar em perder a sua."
        },
        {
            "id": "699002104",
            "speaker": "Paimon",
            "text": "#Por outro lado, se você for peg{F#a}{M#o} pela Comissão Tenryou, você também não pode entregar sua Visão em troca de sua vida...",
            "choices": [
                {
                    "id": "699002105",
                    "text": "Eu posso falar para eles...",
                    "response": [
                        {
                            "id": "699002107",
                            "speaker": "Paimon",
                            "text": "Outra razão para ter Paimon junta... Espere, O QUÊ?!"
                        },
                        {
                            "id": "699002108",
                            "speaker": "Player",
                            "text": "Relaxe, eu não deixaria eles lhe levarem."
                        },
                        {
                            "id": "699002109",
                            "speaker": "Paimon",
                            "text": "Assim Paimon gostou mais.",
                            "choices": [
                                {
                                    "id": "699002110",
                                    "text": "#Nós só iríamos pres{F#as}{M#os}...",
                                    "response": [
                                        {
                                            "id": "699002112",
                                            "speaker": "Paimon",
                                            "text": "Uh... Bem, se realmente fosse isso que acontecesse, acho que você deveria entregar Paimon então..."
                                        },
                                        {
                                            "id": "699002113",
                                            "speaker": "Paimon",
                                            "text": "#... Espere! Que tal não sermos peg{F#as}{M#os} em primeiro lugar?!"
                                        }
                                    ]
                                },
                                {
                                    "id": "699002111",
                                    "text": "#E sofreríamos a pena junt{F#as}{M#os}..."
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "699002106",
                    "text": "... Que você é minha Visão."
                }
            ]
        }
    ]
}