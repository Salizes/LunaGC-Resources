    "dialogues": [
        {
            "id": "620570201",
            "speaker": "Player",
            "text": "O que foi esse barulho?"
        },
        {
            "id": "620570202",
            "speaker": "Yicheng",
            "text": "Isso... *grrr*"
        },
        {
            "id": "620570203",
            "speaker": "Yicheng",
            "text": "Minha barriga está roncando... *Grrrr*"
        },
        {
            "id": "620570204",
            "speaker": "Yicheng",
            "text": "Pois... *grrr*"
        },
        {
            "id": "620570205",
            "speaker": "Yicheng",
            "text": "Estou sempre com fome, meu estômago está sempre roncando de fome... *GRRR*",
            "choices": [
                {
                    "id": "620570206",
                    "text": "Você tem certeza de que está bem?",
                    "response": [
                        {
                            "id": "620570207",
                            "speaker": "Yicheng",
                            "text": "Estou bem... *grrr*"
                        },
                        {
                            "id": "620570208",
                            "speaker": "Yicheng",
                            "text": "Além do fato de que o ... *GRRRR* o barulho é muito alto..."
                        },
                        {
                            "id": "620570209",
                            "speaker": "Yicheng",
                            "text": "Que abafam a minha... *GRRRR* voz..."
                        },
                        {
                            "id": "620570210",
                            "speaker": "Yicheng",
                            "text": "Todo resto está... *GRRRRR* Bem..."
                        }
                    ]
                },
                {
                    "id": "620570211",
                    "text": "Precisa que eu traga algo para você comer?",
                    "response": [
                        {
                            "id": "620570212",
                            "speaker": "Yicheng",
                            "text": "Isso seria incrível!"
                        },
                        {
                            "id": "620570213",
                            "speaker": "Yicheng",
                            "text": "Neste momento, eu adoraria comer um *GRRRR*..."
                        },
                        {
                            "id": "620570214",
                            "speaker": "Yicheng",
                            "text": "Eu seria capaz de matar um *GRRR*..."
                        },
                        {
                            "id": "620570215",
                            "speaker": "Yicheng",
                            "text": "Além disso, estou com um desejo enorme por *GRRR* com um pouco de *GRRRR*..."
                        },
                        {
                            "id": "620570216",
                            "speaker": "Yicheng",
                            "text": "É isso por agora, obrigado!"
                        }
                    ]
                }
            ]
        }
    ]
}