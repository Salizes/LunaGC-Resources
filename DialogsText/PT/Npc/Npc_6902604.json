{
    "talkId": "6902604",
    "total_dialogue_lines": 19,
    "speaker_counts": {
        "Player": 6,
        "Xiao": 13
    },
    "dialogues": [
        {
            "id": "690260401",
            "speaker": "Player",
            "text": "<color=#FFCC33FF>O que você gostaria de fazer?</color>"
        },
        {
            "id": "690260402",
            "speaker": "Xiao",
            "text": "Se você tiver tempo livre, podemos ir juntos ao Porto de Liyue."
        },
        {
            "id": "690260403",
            "speaker": "Xiao",
            "text": "Se não, esqueça.",
            "choices": [
                {
                    "id": "690260404",
                    "text": "Claro que sim.",
                    "response": [
                        {
                            "id": "690260405",
                            "speaker": "Xiao",
                            "text": "Tudo bem."
                        },
                        {
                            "id": "690260408",
                            "speaker": "Xiao",
                            "text": "Eu acidentalmente me aproximei da vida dos mortais."
                        },
                        {
                            "id": "690260409",
                            "speaker": "Xiao",
                            "text": "Mas eu sei que você costuma ir na cidade e caminhar entre as pessoas."
                        },
                        {
                            "id": "690260410",
                            "speaker": "Xiao",
                            "text": "As histórias desse período... Ou suas diversões. Se eu não experienciar pessoalmente, temo que terei dificuldade em entender seus sentimentos."
                        },
                        {
                            "id": "690260411",
                            "speaker": "Player",
                            "text": "Então, Xiao... Você está fazendo isso por mim?"
                        },
                        {
                            "id": "690260412",
                            "speaker": "Xiao",
                            "text": "Sim, quero lhe entender."
                        },
                        {
                            "id": "690260413",
                            "speaker": "Xiao",
                            "text": "Eu tinha a sensação de que seria difícil, mas depois de ter tais pensamentos, eu não posso simplesmente sentar e não fazer nada."
                        },
                        {
                            "id": "690260414",
                            "speaker": "Xiao",
                            "text": "Eu me controlarei enquanto estiver na cidade."
                        },
                        {
                            "id": "690260415",
                            "speaker": "Xiao",
                            "text": "Tentarei falar... O menos possível.",
                            "choices": [
                                {
                                    "id": "690260416",
                                    "text": "Estarei com você.",
                                    "response": [
                                        {
                                            "id": "690260418",
                                            "speaker": "Xiao",
                                            "text": "Hmm..."
                                        },
                                        {
                                            "id": "690260419",
                                            "speaker": "Xiao",
                                            "text": "#Avise-me quando estiver pront{F#a}{M#o} para ir."
                                        }
                                    ]
                                },
                                {
                                    "id": "690260417",
                                    "text": "Você pode dizer o que quiser. Eu pagarei a fiança."
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690260406",
                    "text": "Xiao, você finalmente quer se integrar a cidade?",
                    "response": [
                        {
                            "id": "690260407",
                            "speaker": "Xiao",
                            "text": "*Cof cof*"
                        }
                    ]
                }
            ]
        }
    ]
}