{
    "talkId": "6904303",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Player": 5,
        "Sucrose": 10
    },
    "dialogues": [
        {
            "id": "690430301",
            "speaker": "Player",
            "text": "<color=#FFCC33FF>Você quer conversar comigo?</color>"
        },
        {
            "id": "690430302",
            "speaker": "Sucrose",
            "text": "Uh, eu só... Só não sou muito boa em conversar."
        },
        {
            "id": "690430303",
            "speaker": "Sucrose",
            "text": "Na maior parte do tempo, estou sozinha no laboratório conduzindo alguma pesquisa, e elas tomam sempre algumas horas para serem feitas."
        },
        {
            "id": "690430304",
            "speaker": "Sucrose",
            "text": "Se eu encontrar algum problema que pare minha pesquisa, posso ficar dias trabalhando nela."
        },
        {
            "id": "690430305",
            "speaker": "Sucrose",
            "text": "Não entendo bem sobre o que está acontecendo lá fora, ou sobre o que todos estão falando de interessante..."
        },
        {
            "id": "690430306",
            "speaker": "Sucrose",
            "text": "Além disso... Mesmo que eu tenha um dia de descanso, eu não gosto muito de sair para socializar.",
            "choices": [
                {
                    "id": "690430307",
                    "text": "#E se nós sairmos junt{F#as}{M#os}?",
                    "response": [
                        {
                            "id": "690430309",
                            "speaker": "Sucrose",
                            "text": "Uh... Eu e você..."
                        },
                        {
                            "id": "690430310",
                            "speaker": "Sucrose",
                            "text": "Não... Eu não saberia sobre o que é apropriado falar...",
                            "choices": [
                                {
                                    "id": "690430311",
                                    "text": "Fale o que você pensou.",
                                    "response": [
                                        {
                                            "id": "690430313",
                                            "speaker": "Sucrose",
                                            "text": "Hmm..."
                                        },
                                        {
                                            "id": "690430314",
                                            "speaker": "Sucrose",
                                            "text": "Ouvir isso me deixa muito aliviada."
                                        },
                                        {
                                            "id": "690430315",
                                            "speaker": "Sucrose",
                                            "text": "Eu posso... Tentar."
                                        }
                                    ]
                                },
                                {
                                    "id": "690430312",
                                    "text": "Mesmo que você não saiba sobre o que falar, não precisa ter vergonha."
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690430308",
                    "text": "#E se nós conversarmos junt{F#as}{M#os}?"
                }
            ]
        }
    ]
}