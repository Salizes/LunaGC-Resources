    "dialogues": [
        {
            "id": "690510201",
            "speaker": "Player",
            "text": "<color=#FFCC33FF>Você se acostumou com esse lugar?</color>"
        },
        {
            "id": "690510202",
            "speaker": "Eula",
            "text": "Hmph... Que tipo de problema é esse?"
        },
        {
            "id": "690510203",
            "speaker": "Eula",
            "text": "Eu não sou boa em fazer elogios."
        },
        {
            "id": "690510204",
            "speaker": "Player",
            "text": "Eu só estou preocupada com seus sentimentos, Eula."
        },
        {
            "id": "690510205",
            "speaker": "Eula",
            "text": "Não tem sentido. Você pensa que eu sou tão sensível assim?"
        },
        {
            "id": "690510206",
            "speaker": "Eula",
            "text": "Não é bom, nem mau. É isso que você quer ouvir.",
            "choices": [
                {
                    "id": "690510207",
                    "text": "Realmente é assim?",
                    "response": [
                        {
                            "id": "690510209",
                            "speaker": "Eula",
                            "text": "#Ei, você estava me observando escondid{F#a}{M#o}?"
                        },
                        {
                            "id": "690510210",
                            "speaker": "Eula",
                            "text": "(Droga... Como será que eu não descobri?)"
                        },
                        {
                            "id": "690510211",
                            "speaker": "Eula",
                            "text": "Enfim... A vingança será minha."
                        }
                    ]
                },
                {
                    "id": "690510208",
                    "text": "Você costumava ter uma expressão bem gentil..."
                }
            ]
        }
    ]
}