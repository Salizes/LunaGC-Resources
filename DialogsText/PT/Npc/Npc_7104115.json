    "dialogues": [
        {
            "id": "710411501",
            "speaker": "Taliesin",
            "text": "#Nós encontramos de novo, {NICKNAME} de cabelos loiros!",
            "choices": [
                {
                    "id": "710411502",
                    "text": "Taliesin, você veio para duelar?",
                    "response": [
                        {
                            "id": "710411503",
                            "speaker": "Paimon",
                            "text": "Hã? Sobre o que você está falando?"
                        },
                        {
                            "id": "710411505",
                            "speaker": "Taliesin",
                            "text": "#Haha, estou aqui para buscar inspiração, é claro! Escute só: {M#um herói}{F#uma heroína} sem passado, sem nenhum clã, e sua leal companheira fadinha!"
                        },
                        {
                            "id": "710411506",
                            "speaker": "Paimon",
                            "text": "Quem...?"
                        },
                        {
                            "id": "710411507",
                            "speaker": "Player",
                            "text": "Quem...?"
                        },
                        {
                            "id": "710411508",
                            "speaker": "Taliesin",
                            "text": "#Veja, veja! Ó {M#modesto herói}{F#modesta heroína}, não dirija seu olhar perplexo para as montanhas distantes, pois, nestas terras obscuras, você é a própria luz!"
                        },
                        {
                            "id": "710411509",
                            "speaker": "Paimon",
                            "text": "Ah...?"
                        },
                        {
                            "id": "710411510",
                            "speaker": "Player",
                            "text": "Quê...?"
                        },
                        {
                            "id": "710411511",
                            "speaker": "Taliesin",
                            "text": "Estou falando sobre você! Digo, uma versão mais literária de você, é claro."
                        },
                        {
                            "id": "710411512",
                            "speaker": "Player",
                            "text": "Oh..."
                        },
                        {
                            "id": "710411513",
                            "speaker": "Paimon",
                            "text": "Hã, então esse sujeito realmente consegue dizer coisas que podemos entender..."
                        },
                        {
                            "id": "710411514",
                            "speaker": "Player",
                            "text": "Adeus."
                        },
                        {
                            "id": "710411515",
                            "speaker": "Taliesin",
                            "text": "#Até mais, {NICKNAME} de cabelos loiros!"
                        }
                    ]
                },
                {
                    "id": "710411504",
                    "text": "O que você está fazendo aqui?"
                }
            ]
        }
    ]
}