{
    "talkId": "6902907",
    "total_dialogue_lines": 24,
    "speaker_counts": {
        "Klee": 16,
        "Player": 8
    },
    "dialogues": [
        {
            "id": "690290701",
            "speaker": "Player",
            "text": "Quer conversar comigo?"
        },
        {
            "id": "690290301",
            "speaker": "Player",
            "text": "<color=#FFCC33FF>Você quer conversar comigo?</color>"
        },
        {
            "id": "690290302",
            "speaker": "Klee",
            "text": "Certo, eu quero! Eu gosto de conversar."
        },
        {
            "id": "690290303",
            "speaker": "Klee",
            "text": "Ah, posso te mostrar a coisa legal mais recente que eu encontrei.",
            "choices": [
                {
                    "id": "690290304",
                    "text": "Outra coisa legal?",
                    "response": [
                        {
                            "id": "690290306",
                            "speaker": "Klee",
                            "text": "Olha só isso! Uma rede de pesca incrível!"
                        },
                        {
                            "id": "690290307",
                            "speaker": "Klee",
                            "text": "Deixa eu te ensinar! Você espalha a rede no lago assim... Espera o momento certo e..."
                        },
                        {
                            "id": "690290308",
                            "speaker": "Klee",
                            "text": "Fuuuah! Você puxa ela."
                        },
                        {
                            "id": "690290309",
                            "speaker": "Klee",
                            "text": "Você tem que ter certeza de que está se escondendo silenciosamente, depois pegar ele de surpresa!",
                            "choices": [
                                {
                                    "id": "690290310",
                                    "text": "Isso foi incrível.",
                                    "response": [
                                        {
                                            "id": "690290311",
                                            "speaker": "Klee",
                                            "text": "Hehe, Klee te contou todos os seus segredos. Agora você pode ser tão incrível quanto a Klee!"
                                        },
                                        {
                                            "id": "690290314",
                                            "speaker": "Klee",
                                            "text": "Mas esse método é bem mais chato do que usar bombas..."
                                        },
                                        {
                                            "id": "690290315",
                                            "speaker": "Klee",
                                            "text": "Os peixes são escorregadios e se sacodem muito, então eles saltarão de volta à água se você não os segurar com força."
                                        },
                                        {
                                            "id": "690290316",
                                            "speaker": "Klee",
                                            "text": "Mas... Também é divertido brincar com os peixes deste jeito!",
                                            "choices": [
                                                {
                                                    "id": "690290317",
                                                    "text": "Se você estiver comigo, não se preocupe, pode usar suas bombas.",
                                                    "response": [
                                                        {
                                                            "id": "690290318",
                                                            "speaker": "Klee",
                                                            "text": "Oh! Sério?"
                                                        },
                                                        {
                                                            "id": "690290319",
                                                            "speaker": "Klee",
                                                            "text": "Então espere por mim! Eu posso fazer muitas bombas muito rápido porque já preparei os materiais!"
                                                        },
                                                        {
                                                            "id": "690290323",
                                                            "speaker": "Klee",
                                                            "text": "Hee hee, estou super feliz!"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "690290320",
                                                    "text": "Vamos ter uma competição de pesca na próxima vez.",
                                                    "response": [
                                                        {
                                                            "id": "690290321",
                                                            "speaker": "Klee",
                                                            "text": "Oba!"
                                                        },
                                                        {
                                                            "id": "690290322",
                                                            "speaker": "Klee",
                                                            "text": "Se você perder, quem fará o jantar é você!"
                                                        }
                                                    ]
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "690290312",
                                    "text": "Por que você não está explodindo os peixes?",
                                    "response": [
                                        {
                                            "id": "690290313",
                                            "speaker": "Klee",
                                            "text": "Porque essa é a sua casa, eu não posso sair explodindo tudo..."
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690290305",
                    "text": "Então, quais são essas informações?"
                }
            ]
        }
    ]
}