{
    "talkId": "7268472",
    "total_dialogue_lines": 18,
    "speaker_counts": {
        "Mamoru": 13,
        "Player": 5
    },
    "dialogues": [
        {
            "id": "726847201",
            "speaker": "Mamoru",
            "text": "Eu sou o Mamoru, Embaixador de Ambiência do Festival de Tambores Arataki. Você precisa de algo?"
        },
        {
            "id": "726847202",
            "speaker": "Mamoru",
            "text": "Você está perguntando do meu trabalho?"
        },
        {
            "id": "726847203",
            "speaker": "Mamoru",
            "text": "Eu sou Embaixador de Ambiência, meu trabalho consiste em criar uma atmosfera animada, e fazer com que os participantes digam \"Estou a ponto de pirar\"."
        },
        {
            "id": "726847204",
            "speaker": "Mamoru",
            "text": "Você está se sentindo assim?",
            "choices": [
                {
                    "id": "726847205",
                    "text": "Nem um pouco.",
                    "response": [
                        {
                            "id": "726847207",
                            "speaker": "Mamoru",
                            "text": "Por... Por favor não fale assim!"
                        },
                        {
                            "id": "726847208",
                            "speaker": "Mamoru",
                            "text": "Não destrua meu otimismo com essa frieza! Desse jeito, meu trabalho perde o sentido, né?"
                        },
                        {
                            "id": "726847209",
                            "speaker": "Mamoru",
                            "text": "#Você é amig{F#a}{M#o} do chefe, me dê algum suporte no lugar dele. Diga aquela frase para mim!"
                        },
                        {
                            "id": "726847210",
                            "speaker": "Player",
                            "text": "Qual frase?"
                        },
                        {
                            "id": "726847211",
                            "speaker": "Mamoru",
                            "text": "\"Eu estou a ponto de pirar\"",
                            "choices": [
                                {
                                    "id": "726847212",
                                    "text": "Eu estou a ponto de pirar.",
                                    "response": [
                                        {
                                            "id": "726847213",
                                            "speaker": "Mamoru",
                                            "text": "Ótimo! Ótimo!"
                                        },
                                        {
                                            "id": "726847214",
                                            "speaker": "Mamoru",
                                            "text": "Esse é o melhor elogio que posso receber!"
                                        },
                                        {
                                            "id": "726847218",
                                            "speaker": "Mamoru",
                                            "text": "Vamos, amigos! É hora da música! É hora da dança!"
                                        }
                                    ]
                                },
                                {
                                    "id": "726847215",
                                    "text": "Eu vou... Eu vou... Desculpa, não posso falar.",
                                    "response": [
                                        {
                                            "id": "726847216",
                                            "speaker": "Mamoru",
                                            "text": "Mesmo que seja como você diz, o pessoal da Gangue Arataki está trabalhando duro, por isso, de qualquer forma, eu não posso relaxar..."
                                        },
                                        {
                                            "id": "726847217",
                                            "speaker": "Mamoru",
                                            "text": "Não importa qual seja o ataque sofrido, não desista, essa é a lição que o chefe ensinou!"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "726847206",
                    "text": "Nem de longe."
                }
            ]
        }
    ]
}