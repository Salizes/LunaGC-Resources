        "Player": 3,
        "Sayu": 7
    },
    "dialogues": [
        {
            "id": "690530201",
            "speaker": "Player",
            "text": "Você gosta daqui?"
        },
        {
            "id": "690530202",
            "speaker": "Sayu",
            "text": "Sim, durmo muito bem."
        },
        {
            "id": "690530203",
            "speaker": "Sayu",
            "text": "Não preciso me preocupar em ser chamada para o trabalho de repente."
        },
        {
            "id": "690530204",
            "speaker": "Sayu",
            "text": "Mesmo se eu dormir o tempo todo, não haverá problema.",
            "choices": [
                {
                    "id": "690530205",
                    "text": "É ótimo que você goste daqui.",
                    "response": [
                        {
                            "id": "690530206",
                            "speaker": "Sayu",
                            "text": "É claro. E aqui não há Tanuki."
                        },
                        {
                            "id": "690530207",
                            "speaker": "Sayu",
                            "text": "Eu adorei."
                        }
                    ]
                },
                {
                    "id": "690530208",
                    "text": "Você pode vir mais vezes.",
                    "response": [
                        {
                            "id": "690530209",
                            "speaker": "Sayu",
                            "text": "Ok, obrigada."
                        },
                        {
                            "id": "690530210",
                            "speaker": "Sayu",
                            "text": "Então esta será minha primeira escolha quando eu faltar... quero dizer, quando eu tiver um dia de folga do trabalho."
                        }
                    ]
                }
            ]
        }
    ]
}