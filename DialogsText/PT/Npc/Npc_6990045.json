        {
            "id": "699004501",
            "speaker": "Player",
            "text": "Sobre resolução de conflitos..."
        },
        {
            "id": "699004502",
            "speaker": "Paimon",
            "text": "Paimon ouviu que até mesmo em Natlan, existem várias formas de resolver conflitos que não envolvem competições de força.",
            "choices": [
                {
                    "id": "699004503",
                    "text": "Sério?",
                    "response": [
                        {
                            "id": "699004505",
                            "speaker": "Paimon",
                            "text": "É! Tipo, aparentemente, algumas pessoas dos Filhos dos Ecos resolvem suas disputas ao fazer competições de dança!",
                            "choices": [
                                {
                                    "id": "699004506",
                                    "text": "Competição de dança?",
                                    "response": [
                                        {
                                            "id": "699004508",
                                            "speaker": "Paimon",
                                            "text": "Ahã!"
                                        },
                                        {
                                            "id": "699004509",
                                            "speaker": "Player",
                                            "text": "E simplesmente botam pra quebrar?"
                                        },
                                        {
                                            "id": "699004510",
                                            "speaker": "Paimon",
                                            "text": "Uhummm!"
                                        },
                                        {
                                            "id": "699004511",
                                            "speaker": "Player",
                                            "text": "Até uma pessoa ficar tão exausta que não consegue mais levantar?"
                                        },
                                        {
                                            "id": "699004512",
                                            "speaker": "Paimon",
                                            "text": "Isso!"
                                        },
                                        {
                                            "id": "699004513",
                                            "speaker": "Paimon",
                                            "text": "...Espera, mas o quê... Espera aí, isso é uma competição de força!"
                                        }
                                    ]
                                },
                                {
                                    "id": "699004507",
                                    "text": "Então, eles decidem mutualmente um local e hora..."
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "699004504",
                    "text": "Na Nação da Guerra?"
                }
            ]
        }
    ]
