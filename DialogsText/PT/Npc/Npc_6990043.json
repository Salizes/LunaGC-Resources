{
    "talkId": "6990043",
    "total_dialogue_lines": 18,
    "speaker_counts": {
        "Paimon": 9,
        "Player": 9
    },
    "dialogues": [
        {
            "id": "699004301",
            "speaker": "Player",
            "text": "Sobre Melusines..."
        },
        {
            "id": "699004302",
            "speaker": "Paimon",
            "text": "Aparentemente, toda Melusine recebe sua própria lembrança especial quando nascem. Elas consideram isso como um símbolo do seu próprio ser.",
            "choices": [
                {
                    "id": "699004303",
                    "text": "Se você fosse uma Melusine...",
                    "response": [
                        {
                            "id": "699004305",
                            "speaker": "Paimon",
                            "text": "Definitivamente um garfo! Para representar a missão da vida de Paimon de experimentar todas as comidas deliciosas do mundo inteiro!"
                        },
                        {
                            "id": "699004306",
                            "speaker": "Player",
                            "text": "Então, não seria Mora?"
                        },
                        {
                            "id": "699004307",
                            "speaker": "Paimon",
                            "text": "Ooh, bom ponto... é, se fosse Mora, significaria que Paimon está destinada a ser uma pessoa super rica. Então Paimon poderia comprar tudo que ela quisesse!"
                        },
                        {
                            "id": "699004308",
                            "speaker": "Paimon",
                            "text": "Hmmm... Arg, Paimon está tão dividida! Os dois são tão tentadores...",
                            "choices": [
                                {
                                    "id": "699004309",
                                    "text": "E se fosse um garfo feito de Mora?",
                                    "response": [
                                        {
                                            "id": "699004311",
                                            "speaker": "Paimon",
                                            "text": "Uau, é uma ótima ideia!"
                                        },
                                        {
                                            "id": "699004312",
                                            "speaker": "Paimon",
                                            "text": "#Enfim, chega de falar da Paimon. Sua lembrança provavelmente seria... uma panela, para representar ser {M#o}{F#a} chef gourmet pessoal da Paimon!"
                                        },
                                        {
                                            "id": "699004313",
                                            "speaker": "Player",
                                            "text": "Não, não, não, minha lembrança seria a Paimon."
                                        },
                                        {
                                            "id": "699004314",
                                            "speaker": "Paimon",
                                            "text": "Hehe, aww, sério?"
                                        },
                                        {
                                            "id": "699004315",
                                            "speaker": "Player",
                                            "text": "Com Paimon como minha lembrança, tudo que você tem, no fim, seria meu."
                                        },
                                        {
                                            "id": "699004316",
                                            "speaker": "Paimon",
                                            "text": "Hmm... tá bom, certo. Amigos compartilham tudo, não é?"
                                        },
                                        {
                                            "id": "699004317",
                                            "speaker": "Player",
                                            "text": "Haha, é... minhas coisas ainda seriam minhas..."
                                        },
                                        {
                                            "id": "699004318",
                                            "speaker": "Paimon",
                                            "text": "Ei, não é justo!"
                                        }
                                    ]
                                },
                                {
                                    "id": "699004310",
                                    "text": "Então você poderia dizer que, de certa forma, tem os dois pássaros na mão."
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "699004304",
                    "text": "Qual seria a sua lembrança?"
                }
            ]
        }
    ]
}