{
    "talkId": "6903707",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Ganyu": 10,
        "Player": 7
    },
    "dialogues": [
        {
            "id": "690370701",
            "speaker": "Player",
            "text": "Quer conversar comigo?"
        },
        {
            "id": "690370302",
            "speaker": "Ganyu",
            "text": "Está bem... Mas se não for relacionado a trabalho, eu posso não saber lhe dar uma sugestão útil.",
            "choices": [
                {
                    "id": "690370303",
                    "text": "Nós só estamos conversando.",
                    "response": [
                        {
                            "id": "690370305",
                            "speaker": "Ganyu",
                            "text": "Está bem..."
                        },
                        {
                            "id": "690370306",
                            "speaker": "Ganyu",
                            "text": "Agora que você mencionou, antes eu sempre hesitava em me integrar a sociedade dos humanos."
                        },
                        {
                            "id": "690370307",
                            "speaker": "Ganyu",
                            "text": "Quando não estou sobrecarregada com trabalho, meus colegas de trabalho às vezes organizam algumas atividades."
                        },
                        {
                            "id": "690370308",
                            "speaker": "Ganyu",
                            "text": "Mas como eu sou vegetariana e nem todos são, não é muito interessante sair para fazer comprar ou ir para locais animados com os outros."
                        },
                        {
                            "id": "690370309",
                            "speaker": "Ganyu",
                            "text": "Além disso, quando sou criticada, a maneira que penso sobre isso não é como a das pessoas comuns..."
                        },
                        {
                            "id": "690370310",
                            "speaker": "Ganyu",
                            "text": "Esse costume não mudou, mesmo com esses milhares de anos... Eu não sei o que deveria fazer a respeito disso.",
                            "choices": [
                                {
                                    "id": "690370311",
                                    "text": "Deixe-me pensar em algumas atividades que possam interessar a Ganyu.",
                                    "response": [
                                        {
                                            "id": "690370313",
                                            "speaker": "Ganyu",
                                            "text": "Se você fizer isso, eu lhe pagarei uma compensação adicional! Que tal... Eu lhe pagar para comermos?",
                                            "choices": [
                                                {
                                                    "id": "690370314",
                                                    "text": "Amigos de verdade não falam sobre isso.",
                                                    "response": [
                                                        {
                                                            "id": "690370315",
                                                            "speaker": "Ganyu",
                                                            "text": "Oh... Entendo."
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "690370316",
                                                    "text": "Está bem. Usarei esta oportunidade para aprender ainda mais.",
                                                    "response": [
                                                        {
                                                            "id": "690370317",
                                                            "speaker": "Ganyu",
                                                            "text": "Com você ao meu lado, eu talvez possa rapidamente me integrar à sociedade humana."
                                                        }
                                                    ]
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "690370312",
                                    "text": "Eu posso lhe acompanhar enquanto você se adapta, Ganyu."
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690370304",
                    "text": "Não precisa se importar com isso."
                }
            ]
        }
    ]
}