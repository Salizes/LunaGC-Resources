{
    "talkId": "6905204",
    "total_dialogue_lines": 22,
    "speaker_counts": {
        "Ei": 15,
        "Player": 7
    },
    "dialogues": [
        {
            "id": "690520401",
            "speaker": "Player",
            "text": "Quer conversar comigo?"
        },
        {
            "id": "690520402",
            "speaker": "Ei",
            "text": "Tudo bem, também tenho algo que gostaria de lhe perguntar."
        },
        {
            "id": "690520403",
            "speaker": "Player",
            "text": "Qual o problema?"
        },
        {
            "id": "690520404",
            "speaker": "Ei",
            "text": "Quero saber como você fez aquela sobremesa doce ser tão gostosa?"
        },
        {
            "id": "690520405",
            "speaker": "Ei",
            "text": "*Cof* *Cof*... Bem, ela era bem ao meu gosto.",
            "choices": [
                {
                    "id": "690520406",
                    "text": "O mais importante é ter paciência.",
                    "response": [
                        {
                            "id": "690520407",
                            "speaker": "Ei",
                            "text": "Entendo... Apesar de suas tentativas falharem, você não desistirá de outras no futuro por causa de um fracasso temporário."
                        },
                        {
                            "id": "690520408",
                            "speaker": "Ei",
                            "text": "Ao fazer ajustes ao longo do caminho, você reúne o que aprendeu, bem como sua experiência acumulada."
                        },
                        {
                            "id": "690520409",
                            "speaker": "Ei",
                            "text": "... É esse o significado?"
                        },
                        {
                            "id": "690520415",
                            "speaker": "Player",
                            "text": "Exatamente."
                        },
                        {
                            "id": "690520416",
                            "speaker": "Ei",
                            "text": "... Eu lembrarei disso."
                        },
                        {
                            "id": "690520417",
                            "speaker": "Ei",
                            "text": "Agora que me beneficiei de sua experiência, tentarei seguir suas experiências na próxima vez que estar realizando otimizações na Shogun.",
                            "choices": [
                                {
                                    "id": "690520418",
                                    "text": "Então se trata disso...",
                                    "response": [
                                        {
                                            "id": "690520420",
                                            "speaker": "Ei",
                                            "text": "Hã? Eu já não mencionei que não posso fazer comida?"
                                        },
                                        {
                                            "id": "690520421",
                                            "speaker": "Ei",
                                            "text": "Mas, o conselho que você me deu também lhe beneficiará..."
                                        },
                                        {
                                            "id": "690520422",
                                            "speaker": "Ei",
                                            "text": "Com uma Shogun mais poderosa, eu serei capaz de proteger você de uma miríade de perigos ainda mais eficazmente."
                                        }
                                    ]
                                },
                                {
                                    "id": "690520419",
                                    "text": "Eu tenho uma sensação que o que você quer aprender não é como fazer essas sobremesas..."
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690520410",
                    "text": "O mais importante é o desejo.",
                    "response": [
                        {
                            "id": "690520411",
                            "speaker": "Ei",
                            "text": "Desejo?"
                        },
                        {
                            "id": "690520412",
                            "speaker": "Ei",
                            "text": "Não imaginei que fosse possível deixar uma sobremesa ainda mais gostosa... Isso também pode ser um tipo de desejo."
                        },
                        {
                            "id": "690520413",
                            "speaker": "Ei",
                            "text": "Hã, não.. Agora que pensei direito, não deve ser assim tão simples."
                        },
                        {
                            "id": "690520414",
                            "speaker": "Ei",
                            "text": "Talvez \"esperança\" signifique o desejo de satisfazer quem come."
                        }
                    ]
                }
            ]
        }
    ]
}