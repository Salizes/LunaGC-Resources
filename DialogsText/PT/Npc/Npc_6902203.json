{
    "talkId": "6902203",
    "total_dialogue_lines": 18,
    "speaker_counts": {
        "Player": 4,
        "Venti": 14
    },
    "dialogues": [
        {
            "id": "690220301",
            "speaker": "Player",
            "text": "<color=#FFCC33FF>Você quer conversar comigo?</color>"
        },
        {
            "id": "690220302",
            "speaker": "Venti",
            "text": "#{M#Meu amigo querido}{F#Minha amiga querida}, você tem algo a dizer?",
            "choices": [
                {
                    "id": "690220303",
                    "text": "#Na verdade, estou bem cansad{F#a}{M#o} ultimamente...",
                    "response": [
                        {
                            "id": "690220304",
                            "speaker": "Venti",
                            "text": "#Hehe, que corajos{F#a}{M#o}, você se esforça muito."
                        },
                        {
                            "id": "690220305",
                            "speaker": "Venti",
                            "text": "Entendi o que você quis dizer!"
                        },
                        {
                            "id": "690220306",
                            "speaker": "Venti",
                            "text": "...Eu estou sem energia, até mesmo as maçãs perdem o seu sabor doce na minha boca."
                        },
                        {
                            "id": "690220307",
                            "speaker": "Venti",
                            "text": "Que vontade de tirar uma soneca! Acredito que acordarei energético."
                        },
                        {
                            "id": "690220308",
                            "speaker": "Venti",
                            "text": "Venha cá dormir em meu ombro."
                        },
                        {
                            "id": "690220316",
                            "speaker": "Venti",
                            "text": "Hehe..."
                        },
                        {
                            "id": "690220317",
                            "speaker": "Venti",
                            "text": "Resumindo, relaxe!"
                        },
                        {
                            "id": "690220318",
                            "speaker": "Venti",
                            "text": "Quando você precisar de mim, sempre estarei ao seu lado."
                        }
                    ]
                },
                {
                    "id": "690220309",
                    "text": "#Estou meio perdid{M#o}{F#a}...",
                    "response": [
                        {
                            "id": "690220310",
                            "speaker": "Venti",
                            "text": "Sim, sim..."
                        },
                        {
                            "id": "690220311",
                            "speaker": "Venti",
                            "text": "Isso é bastante comum. Nem todas as coisas ocorrem como desejado."
                        },
                        {
                            "id": "690220312",
                            "speaker": "Venti",
                            "text": "#Neste momento, pergunte a si mesm{M#o}{F#a} qual é a sua prioridade."
                        },
                        {
                            "id": "690220313",
                            "speaker": "Venti",
                            "text": "Mesmo que eu esteja completamente em um caos, basta ter uma brisa que conseguirei endireitar todos meus pensamentos."
                        },
                        {
                            "id": "690220314",
                            "speaker": "Venti",
                            "text": "Não tema, eu estou aqui."
                        },
                        {
                            "id": "690220315",
                            "speaker": "Player",
                            "text": "Venti com uma aparência séria... Isso não é comum."
                        }
                    ]
                }
            ]
        }
    ]
}