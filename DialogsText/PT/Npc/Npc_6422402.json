    "dialogues": [
        {
            "id": "642240201",
            "speaker": "Player",
            "text": "Tem algo lhe preocupando?"
        },
        {
            "id": "642240202",
            "speaker": "Arakara",
            "text": "#Ah! É Nara {NICKNAME}. Olá."
        },
        {
            "id": "642240203",
            "speaker": "Arakara",
            "text": "Arakara queria saber como Nara cultivava à terra. Não elogiam flores nem cantam para árvores frutíferas."
        },
        {
            "id": "642240204",
            "speaker": "Arakara",
            "text": "Mas o seu jeito também deixa as árvores felizes."
        },
        {
            "id": "642240205",
            "speaker": "Arakara",
            "text": "#Nara {NICKNAME} sabe como eles fazem isso?"
        }
    ]
}