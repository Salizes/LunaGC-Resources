{
    "talkId": "6904404",
    "total_dialogue_lines": 24,
    "speaker_counts": {
        "Player": 6,
        "Xinyan": 18
    },
    "dialogues": [
        {
            "id": "690440401",
            "speaker": "Player",
            "text": "<color=#FFCC33FF>O que você gostaria de fazer?</color>"
        },
        {
            "id": "690440402",
            "speaker": "Xinyan",
            "text": "Você quer tentar tocar?"
        },
        {
            "id": "690440403",
            "speaker": "Xinyan",
            "text": "Dê uma olhada, você também já ouviu muitas performances minhas."
        },
        {
            "id": "690440404",
            "speaker": "Xinyan",
            "text": "#Se estiver interessad{F#a}{M#o}, pode tentar, e eu também posso lhe ensinar!",
            "choices": [
                {
                    "id": "690440405",
                    "text": "Eu aprendi como tocar o instrumento antes.",
                    "response": [
                        {
                            "id": "690440406",
                            "speaker": "Xinyan",
                            "text": "De verdade? Que legal!"
                        },
                        {
                            "id": "690440411",
                            "speaker": "Xinyan",
                            "text": "Ah, na minha opinião, Rock n' Roll é algo tão importante como a vida."
                        },
                        {
                            "id": "690440412",
                            "speaker": "Xinyan",
                            "text": "Se eu puder fazer uma música de Rock n' Roll com você isso com certeza seria duas vezes... Não. Isso com certeza seria a coisa mais legal desse mundo!"
                        },
                        {
                            "id": "690440413",
                            "speaker": "Xinyan",
                            "text": "Claro... Eu sei que meu gosto musical é diferente. O Rock n' Roll para mim é muito mais do que somente música."
                        },
                        {
                            "id": "690440414",
                            "speaker": "Xinyan",
                            "text": "Se você estiver hesitante, eu com certeza não lhe forçarei!",
                            "choices": [
                                {
                                    "id": "690440415",
                                    "text": "Já que é para você, Xinyan, eu posso tentar...",
                                    "response": [
                                        {
                                            "id": "690440416",
                                            "speaker": "Xinyan",
                                            "text": "Sim... Sim..."
                                        },
                                        {
                                            "id": "690440417",
                                            "speaker": "Xinyan",
                                            "text": "Então eu não posso falhar com suas expectativas de ser uma boa professora."
                                        },
                                        {
                                            "id": "690440418",
                                            "speaker": "Xinyan",
                                            "text": "Aqui, esta é a minha lira."
                                        },
                                        {
                                            "id": "690440419",
                                            "speaker": "Xinyan",
                                            "text": "O treinamento... Começa agora!"
                                        }
                                    ]
                                },
                                {
                                    "id": "690440420",
                                    "text": "Será que podemos encontrar outra maneira de tocar Rock n' Roll?",
                                    "response": [
                                        {
                                            "id": "690440421",
                                            "speaker": "Xinyan",
                                            "text": "Não-tem-problema!"
                                        },
                                        {
                                            "id": "690440422",
                                            "speaker": "Xinyan",
                                            "text": "Na verdade... Você me responder já me deixou muito emocionada."
                                        },
                                        {
                                            "id": "690440423",
                                            "speaker": "Xinyan",
                                            "text": "Afinal de contas, isso é realmente significante tanto para você quanto para mim..."
                                        },
                                        {
                                            "id": "690440424",
                                            "speaker": "Xinyan",
                                            "text": "#*Cof* *Cof* Eu aguardarei para tocarmos Rock n' Roll junt{F#as}{M#os}!"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690440407",
                    "text": "Eu temo que não saiba tocar bem...",
                    "response": [
                        {
                            "id": "690440408",
                            "speaker": "Xinyan",
                            "text": "Não tem problema, eu te ajudo!"
                        },
                        {
                            "id": "690440409",
                            "speaker": "Xinyan",
                            "text": "Eu posso prestar atenção na forma, para ir fazendo ela passo a passo... Apesar dessa ser a primeira vez que sou uma professora."
                        }
                    ]
                },
                {
                    "id": "690440410",
                    "text": "Por que você pensaria nisso?"
                }
            ]
        }
    ]
}