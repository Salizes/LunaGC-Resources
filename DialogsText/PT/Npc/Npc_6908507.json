{
    "talkId": "6908507",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Freminet": 12,
        "Player": 3
    },
    "dialogues": [
        {
            "id": "690850201",
            "speaker": "Player",
            "text": "Você está gostando daqui?"
        },
        {
            "id": "690850202",
            "speaker": "Freminet",
            "text": "Uhum."
        },
        {
            "id": "690850203",
            "speaker": "Freminet",
            "text": "..."
        },
        {
            "id": "690850204",
            "speaker": "Freminet",
            "text": "Digo, uh... Tudo aqui é ótimo. E estou acostumado agora, então não precisa se preocupar comigo.",
            "choices": [
                {
                    "id": "690850205",
                    "text": "Está tudo bem. Não precisa ser tão educado.",
                    "response": [
                        {
                            "id": "690850206",
                            "speaker": "Freminet",
                            "text": "Desculpe..."
                        },
                        {
                            "id": "690850207",
                            "speaker": "Freminet",
                            "text": "Só estou preocupado que se eu disser tudo que se passa em minha mente, eu posso acabar causando desentendimentos desnecessários."
                        },
                        {
                            "id": "690850210",
                            "speaker": "Freminet",
                            "text": "..."
                        },
                        {
                            "id": "690850211",
                            "speaker": "Freminet",
                            "text": "...Tudo bem, então nesse caso, farei o que me pede..."
                        },
                        {
                            "id": "690850212",
                            "speaker": "Freminet",
                            "text": "Para dizer a verdade, eu— estou com um pouco de saudades de casa."
                        },
                        {
                            "id": "690850213",
                            "speaker": "Freminet",
                            "text": "Mesmo que este lugar seja muito confortável e o ambiente aqui seja impecável, eu só... não pareço me acostumar com a vida aqui."
                        },
                        {
                            "id": "690850214",
                            "speaker": "Freminet",
                            "text": "Esse problema não é de ninguém além de meu, então... Por favor, não ache que estou chateado com você ou insatisfeito com alguma coisa aqui."
                        },
                        {
                            "id": "690850215",
                            "speaker": "Freminet",
                            "text": "...Espero que possa me perdoar."
                        }
                    ]
                },
                {
                    "id": "690850208",
                    "text": "Você pode me falar como se sente de verdade.",
                    "response": [
                        {
                            "id": "690850209",
                            "speaker": "Freminet",
                            "text": "Heh... Tem certeza disso mesmo?"
                        }
                    ]
                }
            ]
        }
    ]
}