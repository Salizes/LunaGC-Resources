{
    "talkId": "6903503",
    "total_dialogue_lines": 19,
    "speaker_counts": {
        "Player": 5,
        "Qiqi": 14
    },
    "dialogues": [
        {
            "id": "690350301",
            "speaker": "Player",
            "text": "<color=#FFCC33FF>Você quer conversar comigo?</color>"
        },
        {
            "id": "690350302",
            "speaker": "Qiqi",
            "text": "Conversar... Conversar..."
        },
        {
            "id": "690350303",
            "speaker": "Qiqi",
            "text": "Conversar com você... É algo muito bom."
        },
        {
            "id": "690350304",
            "speaker": "Qiqi",
            "text": "Mas..."
        },
        {
            "id": "690350305",
            "speaker": "Player",
            "text": "O que houve?"
        },
        {
            "id": "690350306",
            "speaker": "Qiqi",
            "text": "... Eu esqueço."
        },
        {
            "id": "690350307",
            "speaker": "Qiqi",
            "text": "Sobre o que falamos, Qiqi pode esquecer."
        },
        {
            "id": "690350308",
            "speaker": "Qiqi",
            "text": "O tom da voz, Qiqi pode esquecer."
        },
        {
            "id": "690350309",
            "speaker": "Qiqi",
            "text": "A sensação de felicidade... Qiqi pode esquecer...",
            "choices": [
                {
                    "id": "690350310",
                    "text": "Mas desde que você esteja feliz agora, tudo está bem.",
                    "response": [
                        {
                            "id": "690350311",
                            "speaker": "Qiqi",
                            "text": "Ah... Mesmo?"
                        },
                        {
                            "id": "690350312",
                            "speaker": "Qiqi",
                            "text": "Se Qiqi ficar triste agora, você também ficará triste."
                        },
                        {
                            "id": "690350316",
                            "speaker": "Qiqi",
                            "text": "Qiqi, sorria um pouco."
                        },
                        {
                            "id": "690350317",
                            "speaker": "Player",
                            "text": "Seu sorriso é muito fofo, Qiqi."
                        },
                        {
                            "id": "690350318",
                            "speaker": "Qiqi",
                            "text": "Ah..."
                        },
                        {
                            "id": "690350319",
                            "speaker": "Qiqi",
                            "text": "É porque você está junto comigo."
                        }
                    ]
                },
                {
                    "id": "690350313",
                    "text": "Eu virei conversar com você todos os dias, Qiqi.",
                    "response": [
                        {
                            "id": "690350314",
                            "speaker": "Qiqi",
                            "text": "Todos os dias... Vir..."
                        },
                        {
                            "id": "690350315",
                            "speaker": "Qiqi",
                            "text": "Então eu... Vou ficar feliz todos os dias?"
                        }
                    ]
                }
            ]
        }
    ]
}