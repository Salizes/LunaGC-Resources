{
    "talkId": "6906703",
    "total_dialogue_lines": 24,
    "speaker_counts": {
        "Collei": 14,
        "Player": 10
    },
    "dialogues": [
        {
            "id": "690670301",
            "speaker": "Player",
            "text": "Quer conversar comigo?"
        },
        {
            "id": "690670302",
            "speaker": "Collei",
            "text": "Claro!"
        },
        {
            "id": "690670303",
            "speaker": "Collei",
            "text": "..."
        },
        {
            "id": "690670304",
            "speaker": "Collei",
            "text": "... Me desculpe, eu pensei que você começaria."
        },
        {
            "id": "690670305",
            "speaker": "Collei",
            "text": "Eu não tenho muita experiência em iniciar conversas... Por isso não sei por onde começar."
        },
        {
            "id": "690670306",
            "speaker": "Player",
            "text": "Não se preocupe. Por acaso eu tenho algo que queria te contar."
        },
        {
            "id": "690670307",
            "speaker": "Collei",
            "text": "Oh, claro, pode falar! Sou toda ouvidos!",
            "choices": [
                {
                    "id": "690670308",
                    "text": "Amber me contou algumas coisas sobre você...",
                    "response": [
                        {
                            "id": "690670309",
                            "speaker": "Collei",
                            "text": "Amber?! Ela falou de mim? O que ela disse? Espere, preciso pegar meu caderno para escrever isso!",
                            "choices": [
                                {
                                    "id": "690670310",
                                    "text": "Uau, você do nada ficou tão radiante...",
                                    "response": [
                                        {
                                            "id": "690670312",
                                            "speaker": "Collei",
                                            "text": "Oh, eu não nada sobre radiante. Ainda tenho um longo caminho pela frente... Você tem algo mais para dizer?",
                                            "choices": [
                                                {
                                                    "id": "690670313",
                                                    "text": "Ela mencionou você em sua carta mais recente...",
                                                    "response": [
                                                        {
                                                            "id": "690670315",
                                                            "speaker": "Collei",
                                                            "text": "Oh, eu... Uh, eu fiz o melhor que pude..."
                                                        },
                                                        {
                                                            "id": "690670320",
                                                            "speaker": "Collei",
                                                            "text": "Eu aprendi algumas palavras novas recentemente. Eu queria me familiarizar com elas, por isso tentei usá-las na minha carta."
                                                        },
                                                        {
                                                            "id": "690670321",
                                                            "speaker": "Collei",
                                                            "text": "Mas se isso a deixou difícil de ser lida, acho que eu estava dando um passo maior que minha perna."
                                                        },
                                                        {
                                                            "id": "690670322",
                                                            "speaker": "Collei",
                                                            "text": "Eu preciso ir com calma e usar palavras novas com mais cuidado. Melhor misturar algumas palavras novas com algumas que já conheço..."
                                                        },
                                                        {
                                                            "id": "690670323",
                                                            "speaker": "Player",
                                                            "text": "Se quiser eu posso te ajudar a revisar elas."
                                                        },
                                                        {
                                                            "id": "690670324",
                                                            "speaker": "Collei",
                                                            "text": "Sério? Uau, obrigada! Oh, nesse caso, eu precisarei te chamar de \"mestre\" também!"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "690670314",
                                                    "text": "Disse que precisava melhorar sua ortografia..."
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "690670311",
                                    "text": "Ela ficaria bem feliz."
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690670316",
                    "text": "Kaeya me disse algumas coisas sobre você...",
                    "response": [
                        {
                            "id": "690670317",
                            "speaker": "Collei",
                            "text": "Ka—Kaeya?!... Eu sinto muito, mas estou sentindo uma dor de barriga..."
                        },
                        {
                            "id": "690670318",
                            "speaker": "Player",
                            "text": "Ele disse que você cometeu muitos erros de ortografia na sua carta mais recente."
                        },
                        {
                            "id": "690670319",
                            "speaker": "Collei",
                            "text": "Oh, sim? Eu tinha certeza que ele... Ahem! Não importa."
                        }
                    ]
                }
            ]
        }
    ]
}