    "dialogues": [
        {
            "id": "699002601",
            "speaker": "Player",
            "text": "Sobre as preocupações de Sayu..."
        },
        {
            "id": "699002602",
            "speaker": "Paimon",
            "text": "A pequena Sayu parece muito preocupada."
        },
        {
            "id": "699002603",
            "speaker": "Paimon",
            "text": "Paimon não entende porque ela tem tantas preocupações."
        },
        {
            "id": "699002604",
            "speaker": "Player",
            "text": "Devem ser as preocupações do crescimento."
        },
        {
            "id": "699002605",
            "speaker": "Paimon",
            "text": "Uh, Paimon não entendeu o que você falou."
        },
        {
            "id": "699002606",
            "speaker": "Paimon",
            "text": "Afinal de contas, Paimon não tem preocupação alguma!"
        },
        {
            "id": "699002607",
            "speaker": "Player",
            "text": "Hum...",
            "choices": [
                {
                    "id": "699002608",
                    "text": "Droga, não tenho nenhuma Mora comigo.",
                    "response": [
                        {
                            "id": "699002610",
                            "speaker": "Paimon",
                            "text": "Hã? Não!"
                        },
                        {
                            "id": "699002611",
                            "speaker": "Player",
                            "text": "Agora você tem uma preocupação."
                        },
                        {
                            "id": "699002612",
                            "speaker": "Paimon",
                            "text": "Como você pôde fazer uma pegadinha dessa com Paimon?"
                        }
                    ]
                },
                {
                    "id": "699002609",
                    "text": "Nossos próximos dias serão um pouco apertados."
                }
            ]
        }
    ]
