    "dialogues": [
        {
            "id": "622060501",
            "speaker": "Player",
            "text": "Posso perguntar quem é você?"
        },
        {
            "id": "622060502",
            "speaker": "Yuhua",
            "text": "Eu sou Xiuhua, membro da equipe aqui no Albergue Wangshu."
        },
        {
            "id": "622060503",
            "speaker": "Yuhua",
            "text": "Não há... nada suspeitoso.",
            "choices": [
                {
                    "id": "622060504",
                    "text": "Qual é a sua história?",
                    "response": [
                        {
                            "id": "622060505",
                            "speaker": "Yuhua",
                            "text": "Você, quer saber sobre o que eu faço? ... Como você descobriu... Nada, esquece..."
                        }
                    ]
                },
                {
                    "id": "622060506",
                    "text": "Me conte sobre o Albergue Wangshu.",
                    "response": [
                        {
                            "id": "622060507",
                            "speaker": "Yuhua",
                            "text": "O... o albergue... Ela poderia ter deixado escapar sobre a nossa missão da Qixing? O quê? Não, eu não disse nada..."
                        }
                    ]
                }
            ]
        }
    ]
