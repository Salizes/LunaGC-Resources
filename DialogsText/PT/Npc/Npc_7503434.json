    "dialogues": [
        {
            "id": "750343401",
            "speaker": "Pampa",
            "text": "Ei, você tem um tempo para vir aqui?",
            "choices": [
                {
                    "id": "750343402",
                    "text": "A gente te conhece?",
                    "response": [
                        {
                            "id": "750343403",
                            "speaker": "Pampa",
                            "text": "Nos conhecemos, conversamos, então somos amigos! Além disso, não estávamos do mesmo lado durante aquela coisa? Não me diga que você já esqueceu!"
                        },
                        {
                            "id": "750343404",
                            "speaker": "Player",
                            "text": "Estou do meu próprio lado."
                        },
                        {
                            "id": "750343405",
                            "speaker": "Pampa",
                            "text": "*Suspira* Tá, você tem razão, tem razão. Ouvi que até mesmo o Sr. Tenehua te admira muito. Ser seu amigo é uma grande honra!"
                        }
                    ]
                },
                {
                    "id": "750343406",
                    "text": "Bem, tenho que ir.",
                    "response": [
                        {
                            "id": "750343407",
                            "speaker": "Pampa",
                            "text": "Vá à vontade!"
                        }
                    ]
                }
            ]
        }
    ]
}