    "dialogues": [
        {
            "id": "710440101",
            "speaker": "Muning",
            "text": "Quem é você...?",
            "choices": [
                {
                    "id": "710440102",
                    "text": "Olá...",
                    "response": [
                        {
                            "id": "710440104",
                            "speaker": "Muning",
                            "text": "Minhas desculpas, mas o Despenhadeiro foi fechado por tempo indefinido. Não estamos abertos a visitas."
                        },
                        {
                            "id": "710440105",
                            "speaker": "Muning",
                            "text": "A menos que..."
                        },
                        {
                            "id": "710440106",
                            "speaker": "Player",
                            "text": "A menos que...?"
                        },
                        {
                            "id": "710440107",
                            "speaker": "Muning",
                            "text": "A menos que você consiga permissão do Terraço de Yujing... Ou se você estiver em uma <color=#00E1FFFF>missão especial</color>."
                        },
                        {
                            "id": "710440108",
                            "speaker": "Muning",
                            "text": "No entanto, as coisas têm sido bastante incomuns ultimamente, e os superiores têm estado muito ocupados... Eu aconselho que você cuide dos seus assuntos e não nos perturbe."
                        },
                        {
                            "id": "710440109",
                            "speaker": "Muning",
                            "text": "Por favor, saia imediatamente pela sua própria segurança."
                        }
                    ]
                },
                {
                    "id": "710440103",
                    "text": "Eu sou..."
                }
            ]
        }
    ]
}