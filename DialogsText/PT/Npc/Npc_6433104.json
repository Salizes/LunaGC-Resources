    "dialogues": [
        {
            "id": "643310401",
            "speaker": "Player",
            "text": "Vá para um adivinho."
        },
        {
            "id": "643310402",
            "speaker": "Zadith",
            "text": "#Hahaha, você é tão {M#engraçado}{F#engraçada}!"
        },
        {
            "id": "643310403",
            "speaker": "Zadith",
            "text": "... Você estava brincando, né?"
        },
        {
            "id": "643310404",
            "speaker": "Zadith",
            "text": "Não importa quão difícil seja para escolher, é uma decisão importante sobre a minha carreira futura."
        },
        {
            "id": "643310405",
            "speaker": "Zadith",
            "text": "Se eu fizer a escolha errada, posso acabar desistindo como Arezo ou nunca me graduar como Hosseini."
        },
        {
            "id": "643310406",
            "speaker": "Zadith",
            "text": "Não posso acabar assim!"
        }
    ]
}