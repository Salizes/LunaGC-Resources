{
    "talkId": "6901409",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Barbara": 11,
        "Player": 4
    },
    "dialogues": [
        {
            "id": "690140901",
            "speaker": "Barbara",
            "text": "Oh, tenho praticado uma nova música."
        },
        {
            "id": "690140902",
            "speaker": "Barbara",
            "text": "Mas ainda estou ajustando alguns detalhes..."
        },
        {
            "id": "690140903",
            "speaker": "Barbara",
            "text": "Quando repito o refrão, devo subir meio tom? Não consigo decidir... E acho que posso melhorar a coreografia, mas não tenho certeza..."
        },
        {
            "id": "690140904",
            "speaker": "Barbara",
            "text": "Se não for um incômodo, gostaria que você visse minha apresentação e fizesse sugestões.",
            "choices": [
                {
                    "id": "690140905",
                    "text": "Você tem todo o meu apoio.",
                    "response": [
                        {
                            "id": "690140907",
                            "speaker": "Barbara",
                            "text": "Obrigada..."
                        },
                        {
                            "id": "690140908",
                            "speaker": "Barbara",
                            "text": "Hum... Por favor, não ria de mim nas partes que ainda precisam de prática."
                        },
                        {
                            "id": "690140909",
                            "speaker": "Barbara",
                            "text": "Eu pensei sobre isso muitas vezes, mas levei tempo para finalmente criar coragem e me apresentar para você."
                        },
                        {
                            "id": "690140910",
                            "speaker": "Barbara",
                            "text": "Se você risse de mim, não saberia onde me esconder de tanta vergonha...",
                            "choices": [
                                {
                                    "id": "690140911",
                                    "text": "Não se preocupe. Não rirei.",
                                    "response": [
                                        {
                                            "id": "690140913",
                                            "speaker": "Barbara",
                                            "text": "Hum... Ok."
                                        },
                                        {
                                            "id": "690140914",
                                            "speaker": "Barbara",
                                            "text": "Então..."
                                        },
                                        {
                                            "id": "690140915",
                                            "speaker": "Barbara",
                                            "text": "Que comece o show!"
                                        }
                                    ]
                                },
                                {
                                    "id": "690140912",
                                    "text": "Eu acredito em você, e você deveria acreditar também."
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690140906",
                    "text": "Seria uma honra."
                }
            ]
        }
    ]
}