{
    "talkId": "6901609",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Diluc": 11,
        "Player": 5
    },
    "dialogues": [
        {
            "id": "690160901",
            "speaker": "Diluc",
            "text": "Sim... Tome um gole disso."
        },
        {
            "id": "690160902",
            "speaker": "Diluc",
            "text": "É uma bebida sem álcool, baseada em uma receita familiar de longa data. Mas eu mesmo dei minha própria incrementada nela.",
            "choices": [
                {
                    "id": "690160903",
                    "text": "Tem um gosto fresco.",
                    "response": [
                        {
                            "id": "690160905",
                            "speaker": "Diluc",
                            "text": "Pela sua expressão, você gostou."
                        },
                        {
                            "id": "690160906",
                            "speaker": "Diluc",
                            "text": "Bem, fico feliz. Tentei ajustar a receita ao seu gosto e, pelo aspecto, consegui fazer exatamente isso."
                        },
                        {
                            "id": "690160907",
                            "speaker": "Diluc",
                            "text": "Ainda preciso pedir sua ajuda com algo."
                        },
                        {
                            "id": "690160908",
                            "speaker": "Diluc",
                            "text": "Essa bebida precisa de um nome. Como mudamos a sua receita, seu nome original já não é apropriado."
                        },
                        {
                            "id": "690160909",
                            "speaker": "Player",
                            "text": "Você quer que eu pense em um?"
                        },
                        {
                            "id": "690160910",
                            "speaker": "Diluc",
                            "text": "Essa bebida foi feita com seu gosto, creio que seria mais apropriado você pensar em um nome para ela."
                        },
                        {
                            "id": "690160911",
                            "speaker": "Diluc",
                            "text": "Agora que você falou... Você gostaria que eu usasse seu nome?",
                            "choices": [
                                {
                                    "id": "690160912",
                                    "text": "É estranho.",
                                    "response": [
                                        {
                                            "id": "690160914",
                                            "speaker": "Diluc",
                                            "text": "É verdade."
                                        },
                                        {
                                            "id": "690160915",
                                            "speaker": "Diluc",
                                            "text": "Não tem problema, pode pensar calmamente. Se você se esquecer do sabor, apenas me fale e eu vou fazer a bebida novamente para você."
                                        },
                                        {
                                            "id": "690160916",
                                            "speaker": "Diluc",
                                            "text": "Em qualquer lugar. A qualquer momento."
                                        }
                                    ]
                                },
                                {
                                    "id": "690160913",
                                    "text": "Deixe-me pensar melhor..."
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690160904",
                    "text": "Tem um gosto residual forte!"
                }
            ]
        }
    ]
}