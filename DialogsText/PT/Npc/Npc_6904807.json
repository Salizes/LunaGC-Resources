{
    "talkId": "6904807",
    "total_dialogue_lines": 18,
    "speaker_counts": {
        "Player": 6,
        "Yanfei": 12
    },
    "dialogues": [
        {
            "id": "690480701",
            "speaker": "Player",
            "text": "Quer conversar comigo?"
        },
        {
            "id": "690480302",
            "speaker": "Yanfei",
            "text": "Que legal, vamos conversar! Mas quando eu começo a falar, não paro mais."
        },
        {
            "id": "690480303",
            "speaker": "Yanfei",
            "text": "#Você está estranhamente quiet{F#a}{M#o}. Estou fazendo muito barulho?",
            "choices": [
                {
                    "id": "690480304",
                    "text": "Não...",
                    "response": [
                        {
                            "id": "690480305",
                            "speaker": "Yanfei",
                            "text": "Se não puder, é melhor."
                        },
                        {
                            "id": "690480306",
                            "speaker": "Yanfei",
                            "text": "Não sei porque, mas ouvir você dizer isso dessa forma me deixou feliz."
                        },
                        {
                            "id": "690480307",
                            "speaker": "Yanfei",
                            "text": "Já que é assim, escolha um tópico."
                        },
                        {
                            "id": "690480312",
                            "speaker": "Player",
                            "text": "Então... Vamos conversar sobre clientes difíceis de lidar."
                        },
                        {
                            "id": "690480313",
                            "speaker": "Yanfei",
                            "text": "#Oh, mas eu tenho tantas coisas interessantes para falar, você ficará desapontad{F#a}{M#o} depois de perguntar sobre isso.",
                            "choices": [
                                {
                                    "id": "690480314",
                                    "text": "Porque você, Yanfei, deve saber lidar com a maioria das situações.",
                                    "response": [
                                        {
                                            "id": "690480316",
                                            "speaker": "Yanfei",
                                            "text": "Então você pensou nisso."
                                        },
                                        {
                                            "id": "690480317",
                                            "speaker": "Yanfei",
                                            "text": "Obrigada..."
                                        },
                                        {
                                            "id": "690480318",
                                            "speaker": "Yanfei",
                                            "text": "*Cof Cof* Bem, vou lhe dizer que o cliente que veio até mim na última vez para uma consulta sobre disputa civil..."
                                        }
                                    ]
                                },
                                {
                                    "id": "690480315",
                                    "text": "Perguntei para poder lhe ajudar a resolver esse problema."
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690480308",
                    "text": "Ouvir você falar já é bom o suficiente.",
                    "response": [
                        {
                            "id": "690480309",
                            "speaker": "Yanfei",
                            "text": "*Suspiro* Só me ouvir?"
                        },
                        {
                            "id": "690480310",
                            "speaker": "Yanfei",
                            "text": "Vamos conversar! Quando duas pessoas falam, se chama conversa."
                        },
                        {
                            "id": "690480311",
                            "speaker": "Yanfei",
                            "text": "Eu não sou uma contadora de contos. Eu já escolhi o meu trabalho favorito, nunca me tornarei uma contadora de contos na minha vida."
                        }
                    ]
                }
            ]
        }
    ]
}