    "speaker_counts": {
        "Jean": 13,
        "Player": 5
    },
    "dialogues": [
        {
            "id": "690031401",
            "speaker": "Jean",
            "text": "Quer conversar comigo?"
        },
        {
            "id": "690030801",
            "speaker": "Jean",
            "text": "Está bem, desejo muito lhe acompanhar."
        },
        {
            "id": "690030802",
            "speaker": "Jean",
            "text": "Sobre o que você gostaria de conversar?",
            "choices": [
                {
                    "id": "690030803",
                    "text": "Qualquer coisa, desde que não seja sobre trabalho.",
                    "response": [
                        {
                            "id": "690030804",
                            "speaker": "Jean",
                            "text": "Me desculpe... Sempre estou falando de coisas do trabalho, acabarei lhe deixando incomodado."
                        },
                        {
                            "id": "690030805",
                            "speaker": "Jean",
                            "text": "Pensarei um pouco sobre mim mesma."
                        },
                        {
                            "id": "690030806",
                            "speaker": "Player",
                            "text": "Jean está séria de novo..."
                        },
                        {
                            "id": "690030807",
                            "speaker": "Jean",
                            "text": "Me desculpe, eu..."
                        },
                        {
                            "id": "690030808",
                            "speaker": "Jean",
                            "text": "#Eu entendo. Você quer dizer que nós deveríamos ficar mais relaxad{M#o}{F#a}s."
                        },
                        {
                            "id": "690030816",
                            "speaker": "Jean",
                            "text": "Uh... Eu..."
                        },
                        {
                            "id": "690030817",
                            "speaker": "Jean",
                            "text": "Eu vou me esforçar..."
                        }
                    ]
                },
                {
                    "id": "690030809",
                    "text": "Jean, ouvi dizer que você canta muito bem. Que tal cantar agora?",
                    "response": [
                        {
                            "id": "690030810",
                            "speaker": "Jean",
                            "text": "...Apenas algumas canções simples."
                        },
                        {
                            "id": "690030811",
                            "speaker": "Jean",
                            "text": "Não é nada que eu deva me gabar sobre..."
                        },
                        {
                            "id": "690030812",
                            "speaker": "Player",
                            "text": "Gostaria de ouvir você cantar."
                        },
                        {
                            "id": "690030813",
                            "speaker": "Jean",
                            "text": "Mas... Mas eu não me preparei para isso."
                        },
                        {
                            "id": "690030814",
                            "speaker": "Jean",
                            "text": "Pelo menos espere eu praticar um pouco."
                        }
                    ]
                },
                {
                    "id": "690030815",
                    "text": "Se serve para você, serve para mim."
                }
            ]
        }
    ]
}