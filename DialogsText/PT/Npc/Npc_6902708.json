{
    "talkId": "6902708",
    "total_dialogue_lines": 19,
    "speaker_counts": {
        "Ningguang": 12,
        "Player": 7
    },
    "dialogues": [
        {
            "id": "690270801",
            "speaker": "Player",
            "text": "Gostaria de fazer alguma coisa?"
        },
        {
            "id": "690270401",
            "speaker": "Player",
            "text": "<color=#FFCC33FF>O que você gostaria de fazer?</color>"
        },
        {
            "id": "690270402",
            "speaker": "Ningguang",
            "text": "Na verdade, inclusive... Existe algo que eu tenho planejado há algum tempo."
        },
        {
            "id": "690270403",
            "speaker": "Ningguang",
            "text": "Na próxima vez que tivermos uma decisão política importante em nossas mãos, gostaria que você se envolvesse.",
            "choices": [
                {
                    "id": "690270404",
                    "text": "Para ajudar a reunir a papelada?",
                    "response": [
                        {
                            "id": "690270406",
                            "speaker": "Ningguang",
                            "text": "#Não exatamente... Eu estava pensando que você estaria envolvid{M#o}{F#a} na própria decisão em si.",
                            "choices": [
                                {
                                    "id": "690270407",
                                    "text": "#Eu estou apt{M#o}{F#a} para isso...?",
                                    "response": [
                                        {
                                            "id": "690270408",
                                            "speaker": "Ningguang",
                                            "text": "#Fique tranquil{M#o}{F#a}, eu não sou propensa a julgamentos errôneos."
                                        },
                                        {
                                            "id": "690270409",
                                            "speaker": "Ningguang",
                                            "text": "A fonte de conhecimento e a ousadia de espírito que suas viagens lhe proporcionaram certamente imbuirá suas diretrizes com raras e valiosas previsões."
                                        },
                                        {
                                            "id": "690270415",
                                            "speaker": "Ningguang",
                                            "text": "Não tenho dúvidas quanto a isso."
                                        },
                                        {
                                            "id": "690270416",
                                            "speaker": "Ningguang",
                                            "text": "Oh, isso me lembrou."
                                        },
                                        {
                                            "id": "690270417",
                                            "speaker": "Ningguang",
                                            "text": "Após a decisão ser tomada, se você puder, por favor, rasgue qualquer documentação que se acumule na parede durante o processo."
                                        },
                                        {
                                            "id": "690270418",
                                            "speaker": "Ningguang",
                                            "text": "#Liyue está prestes a sofrer outra tempestade de neve de papel. Desta vez, você será {M#o}{F#a} únic{M#o}{F#a} a mudar o clima prevalecente."
                                        }
                                    ]
                                },
                                {
                                    "id": "690270410",
                                    "text": "Estarei à altura do desafio.",
                                    "response": [
                                        {
                                            "id": "690270411",
                                            "speaker": "Ningguang",
                                            "text": "Gosto de sua ousadia de espírito."
                                        },
                                        {
                                            "id": "690270412",
                                            "speaker": "Ningguang",
                                            "text": "O mundo do comércio é um campo de batalha, e a elaboração de leis requer convicção e determinação."
                                        },
                                        {
                                            "id": "690270413",
                                            "speaker": "Ningguang",
                                            "text": "Tudo o que você experimentou durante suas viagens certamente irá impregnar suas diretrizes com raras e valiosas previsões."
                                        },
                                        {
                                            "id": "690270414",
                                            "speaker": "Player",
                                            "text": "Vou dar o meu melhor."
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690270405",
                    "text": "Para estudar o pensamento por trás da elaboração de leis?"
                }
            ]
        }
    ]
}