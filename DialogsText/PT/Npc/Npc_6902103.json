{
    "talkId": "6902103",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Amber": 11,
        "Player": 4
    },
    "dialogues": [
        {
            "id": "690210301",
            "speaker": "Player",
            "text": "<color=#FFCC33FF>Você quer conversar comigo?</color>"
        },
        {
            "id": "690210302",
            "speaker": "Amber",
            "text": "Ótimo."
        },
        {
            "id": "690210303",
            "speaker": "Amber",
            "text": "..."
        },
        {
            "id": "690210304",
            "speaker": "Amber",
            "text": "Me desculpe. Eu não sou boa em contar histórias. Não sou boa como meu avô ou Lisa que sabem contar histórias interessantes de cabeça.",
            "choices": [
                {
                    "id": "690210305",
                    "text": "Eu me lembro de suas notas, Amber...",
                    "response": [
                        {
                            "id": "690210306",
                            "speaker": "Amber",
                            "text": "Ei! Quando você descobriu elas?"
                        },
                        {
                            "id": "690210307",
                            "speaker": "Amber",
                            "text": "Apesar de não serem secretas, nelas estão escritas alguns elogios sobre você..."
                        },
                        {
                            "id": "690210308",
                            "speaker": "Amber",
                            "text": "...Mas ainda assim, é um pouco vergonhoso deixar outra pessoa ler meu diário!"
                        },
                        {
                            "id": "690210309",
                            "speaker": "Amber",
                            "text": "Mas, eu posso separar e compartilhar algumas histórias sobre aventuras com você."
                        },
                        {
                            "id": "690210315",
                            "speaker": "Amber",
                            "text": "Certo! Hehe, vamos começar..."
                        }
                    ]
                },
                {
                    "id": "690210310",
                    "text": "Gostaria de ouvir suas aventuras passadas, Amber.",
                    "response": [
                        {
                            "id": "690210311",
                            "speaker": "Amber",
                            "text": "Sobre minhas aventuras passadas..."
                        },
                        {
                            "id": "690210312",
                            "speaker": "Amber",
                            "text": "Não deve ter nada tão interessante assim. Além disso, aos meus olhos atuais, quando eu era pequena um pouco... Trelosa."
                        },
                        {
                            "id": "690210313",
                            "speaker": "Amber",
                            "text": "Mas desde que você não fique rindo, posso lhe contar!"
                        },
                        {
                            "id": "690210314",
                            "speaker": "Player",
                            "text": "#Então... Obrigad{F#a}{M#o}?"
                        }
                    ]
                }
            ]
        }
    ]
}