{
    "talkId": "6902902",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Klee": 9,
        "Player": 3
    },
    "dialogues": [
        {
            "id": "690290201",
            "speaker": "Player",
            "text": "<color=#FFCC33FF>Você se acostumou com esse lugar?</color>"
        },
        {
            "id": "690290202",
            "speaker": "Klee",
            "text": "É realmente divertido aqui."
        },
        {
            "id": "690290203",
            "speaker": "Klee",
            "text": "A casa é enorme e tem vários quartos."
        },
        {
            "id": "690290204",
            "speaker": "Klee",
            "text": "Há muitas coisas novas por aqui. Vai demorar um bom tempo para correr de uma ponta à outra do caminho.",
            "choices": [
                {
                    "id": "690290205",
                    "text": "Parece que você está se divertindo.",
                    "response": [
                        {
                            "id": "690290206",
                            "speaker": "Klee",
                            "text": "Se divertindo muuuuuuito!"
                        },
                        {
                            "id": "690290207",
                            "speaker": "Klee",
                            "text": "Se você tiver tempo, Klee pode levar você para brincar!"
                        },
                        {
                            "id": "690290212",
                            "speaker": "Klee",
                            "text": "Pegar lagartos, caçar sapos, desenhar, fazer artesanato, esconde-esconde... Há tantas coisas divertidas para fazer!"
                        }
                    ]
                },
                {
                    "id": "690290208",
                    "text": "Você não tem feito travessuras, não é mesmo?",
                    "response": [
                        {
                            "id": "690290209",
                            "speaker": "Klee",
                            "text": "Não! Definitivamente não!"
                        },
                        {
                            "id": "690290210",
                            "speaker": "Klee",
                            "text": "#A Mestre Jean avisou Klee várias vezes que eu não posso destruir a casa {F#da Cavaleira}{M#do Cavaleiro} Honorável."
                        },
                        {
                            "id": "690290211",
                            "speaker": "Klee",
                            "text": "Então eu não trouxe nenhum de meus tesouros."
                        }
                    ]
                }
            ]
        }
    ]
}