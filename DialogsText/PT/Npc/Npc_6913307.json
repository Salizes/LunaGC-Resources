{
    "talkId": "6913307",
    "total_dialogue_lines": 19,
    "speaker_counts": {
        "Player": 7,
        "Sandrone": 12
    },
    "dialogues": [
        {
            "id": "691330201",
            "speaker": "Player",
            "text": "O que acha daqui?"
        },
        {
            "id": "691330202",
            "speaker": "Sandrone",
            "text": "É legal. Obrigada por perguntar.",
            "choices": [
                {
                    "id": "691330203",
                    "text": "Só isso?",
                    "response": [
                        {
                            "id": "691330205",
                            "speaker": "Sandrone",
                            "text": "Hah... Ser \"difícil de agradar\" é simplesmente o sinal das expectativas e do gosto refinado de uma dama. Isso não significa que ela seja incapaz de se adaptar."
                        },
                        {
                            "id": "691330206",
                            "speaker": "Sandrone",
                            "text": "Veja este lugar, por exemplo. Não tem uma cadeira sequer, chove o tempo todo e o teto vaza, mas você não me vê reclamando."
                        },
                        {
                            "id": "691330207",
                            "speaker": "Sandrone",
                            "text": "Claro, se eu começar a reclamar, por mais desagradáveis que sejam minhas palavras, será tudo inteiramente culpa sua.",
                            "choices": [
                                {
                                    "id": "691330208",
                                    "text": "Então... Tem alguma recomendação?",
                                    "response": [
                                        {
                                            "id": "691330210",
                                            "speaker": "Sandrone",
                                            "text": "#Eu não usaria a palavra \"recomendações\", exatamente... mas, se você realmente está interessad{F#a}{M#o}, posso compartilhar alguns pontos de referência da minha antiga casa."
                                        },
                                        {
                                            "id": "691330211",
                                            "speaker": "Sandrone",
                                            "text": "Quanto ao interior, não há muito a dizer. Mas uma lareira acesa deixaria este lugar aconchegante o ano todo."
                                        },
                                        {
                                            "id": "691330212",
                                            "speaker": "Sandrone",
                                            "text": "Se estivermos falando da área externa... Eu costumava organizar meu jardim de acordo com as características de cada planta."
                                        },
                                        {
                                            "id": "691330213",
                                            "speaker": "Sandrone",
                                            "text": "Quais flores desabrocham na primavera, quais árvores dão frutos no outono... Garantir que a fragrância de uma flor não sobrepuje a de outra... Existe uma arte nisso.",
                                            "choices": [
                                                {
                                                    "id": "691330214",
                                                    "text": "Isso parece muito complexo...",
                                                    "response": [
                                                        {
                                                            "id": "691330215",
                                                            "speaker": "Sandrone",
                                                            "text": "É simples depois que você aprende as regras. Posso te ensinar, se quiser."
                                                        },
                                                        {
                                                            "id": "691330218",
                                                            "speaker": "Sandrone",
                                                            "text": "De qualquer forma, sob meus cuidados, o jardim mudava com o passar das estações. Eu tinha muito orgulho do que havia conseguido, e isso também costumava deixar Alain feliz."
                                                        },
                                                        {
                                                            "id": "691330219",
                                                            "speaker": "Sandrone",
                                                            "text": "Agora que penso nisso... Eu deveria mesmo encontrar tempo para voltar e arrumar tudo por lá."
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "691330216",
                                                    "text": "Parece lindo...",
                                                    "response": [
                                                        {
                                                            "id": "691330217",
                                                            "speaker": "Sandrone",
                                                            "text": "Hmph, isso é óbvio."
                                                        }
                                                    ]
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "691330209",
                                    "text": "Como você acha que posso melhorar este lugar?"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "691330204",
                    "text": "Achei que seria mais difícil de agradar..."
                }
            ]
        }
    ]
}