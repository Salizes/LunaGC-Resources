{
    "talkId": "6911308",
    "total_dialogue_lines": 21,
    "speaker_counts": {
        "Ifa": 14,
        "Player": 7
    },
    "dialogues": [
        {
            "id": "691130301",
            "speaker": "Player",
            "text": "Quer conversar comigo?"
        },
        {
            "id": "691130302",
            "speaker": "Ifa",
            "text": "Claro."
        },
        {
            "id": "691130303",
            "speaker": "Ifa",
            "text": "Boa hora, tenho uns salgadinhos aqui. Quer alguns?",
            "choices": [
                {
                    "id": "691130304",
                    "text": "São para Saurianos?",
                    "response": [
                        {
                            "id": "691130306",
                            "speaker": "Ifa",
                            "text": "São para quem quiser. Eu, você, ou os Saurianos. Nunca faz mal levar um pouco de comida."
                        },
                        {
                            "id": "691130307",
                            "speaker": "Ifa",
                            "text": "Prove isso, é uma carne seca que fiz. Eu particularmente diria que está ótima.",
                            "choices": [
                                {
                                    "id": "691130308",
                                    "text": "Bem crocante... que delícia!",
                                    "response": [
                                        {
                                            "id": "691130309",
                                            "speaker": "Ifa",
                                            "text": "Mesmo? Que bom que você gostou. Eu também faço outros tipos com outros temperos. Vou trazer mais sabores na próxima vez."
                                        },
                                        {
                                            "id": "691130315",
                                            "speaker": "Ifa",
                                            "text": "Ei, pode ficar com a sacola de carne seca. Da próxima vez que precisar se dar bem com um Sauriano, dê um pouco disso. Vai ajudar."
                                        },
                                        {
                                            "id": "691130316",
                                            "speaker": "Ifa",
                                            "text": "Não sei se você precisa disso agora, mas... enfim, pode ficar."
                                        },
                                        {
                                            "id": "691130317",
                                            "speaker": "Player",
                                            "text": "#Obrigad{F#a}{M#o}, Ifa! Você é muito atencioso..."
                                        },
                                        {
                                            "id": "691130318",
                                            "speaker": "Ifa",
                                            "text": "Aw, fico feliz que você pensa assim."
                                        },
                                        {
                                            "id": "691130319",
                                            "speaker": "Ifa",
                                            "text": "Para ser sincero, quando criança, eu era muito desorganizado. Só consegui me controlar depois de me tornar um veterinário."
                                        },
                                        {
                                            "id": "691130327",
                                            "speaker": "Ifa",
                                            "text": "A tragédia é inevitável na vida. Mas tudo passa com o tempo."
                                        },
                                        {
                                            "id": "691130328",
                                            "speaker": "Ifa",
                                            "text": "Quaisquer que sejam as dificuldades que esteja enfrentando em sua vida, desejo-lhe o melhor para superá-las."
                                        }
                                    ]
                                },
                                {
                                    "id": "691130310",
                                    "text": "#Obrigad{M#o}{F#a}, mas... é muito borrachuda.",
                                    "response": [
                                        {
                                            "id": "691130311",
                                            "speaker": "Ifa",
                                            "text": "Ah, ops... esqueci que seus dentes não são afiados como o de um Sauriano..."
                                        },
                                        {
                                            "id": "691130312",
                                            "speaker": "Ifa",
                                            "text": "Sinto muito por isso. Vamos tentar outra coisa. Também tenho uns biscoitos."
                                        },
                                        {
                                            "id": "691130313",
                                            "speaker": "Player",
                                            "text": "Hmm, que crocantes!"
                                        },
                                        {
                                            "id": "691130314",
                                            "speaker": "Ifa",
                                            "text": "Hehe, e espero que sejam mais gentis nos seus dentes."
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "691130305",
                    "text": "São comida de emergência?"
                }
            ]
        }
    ]
}