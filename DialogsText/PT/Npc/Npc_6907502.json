{
    "talkId": "6907502",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Player": 5,
        "Wanderer": 11
    },
    "dialogues": [
        {
            "id": "690750201",
            "speaker": "Player",
            "text": "Você se acostumou bem aqui?"
        },
        {
            "id": "690750202",
            "speaker": "Wanderer",
            "text": "...",
            "choices": [
                {
                    "id": "690750203",
                    "text": "O-O que houve?",
                    "response": [
                        {
                            "id": "690750204",
                            "speaker": "Wanderer",
                            "text": "#Você é {M#o}{F#a} don{M#o}{F#a} deste lugar. Por que você está nervos{M#o}{F#a}? Que decepcionante."
                        },
                        {
                            "id": "690750207",
                            "speaker": "Wanderer",
                            "text": "... Não é nada. Só estava refletindo sobre algo desinteressante."
                        },
                        {
                            "id": "690750208",
                            "speaker": "Wanderer",
                            "text": "No seu... Hmm... reino, algumas áreas estão bem vazias. Por quê?",
                            "choices": [
                                {
                                    "id": "690750209",
                                    "text": "Não é necessário preencher tudo. O espaço vazio tem a sua própria beleza.",
                                    "response": [
                                        {
                                            "id": "690750210",
                                            "speaker": "Wanderer",
                                            "text": "Foi rude de minha parte comentar sobre as suas escolhas de forma tão descuidada."
                                        },
                                        {
                                            "id": "690750211",
                                            "speaker": "Wanderer",
                                            "text": "#Você foi generos{M#o}{F#a} o bastante para me receber aqui. Eu deveria mostrar gratidão e apreço."
                                        },
                                        {
                                            "id": "690750215",
                                            "speaker": "Wanderer",
                                            "text": "Esse é o seu lugar. Arrume-o como desejar."
                                        },
                                        {
                                            "id": "690750216",
                                            "speaker": "Wanderer",
                                            "text": "Eu sou apenas um convidado passageiro."
                                        }
                                    ]
                                },
                                {
                                    "id": "690750212",
                                    "text": "Eu colocaria mais coisas se pudesse, mas não posso.",
                                    "response": [
                                        {
                                            "id": "690750213",
                                            "speaker": "Wanderer",
                                            "text": "Eu entendo. Sempre existem coisas que estão fora do nosso alcance."
                                        },
                                        {
                                            "id": "690750214",
                                            "speaker": "Wanderer",
                                            "text": "Às vezes, a situação melhora com o tempo. Outras vezes, tudo o que você pode fazer é manter o status quo."
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690750205",
                    "text": "O que você quer?",
                    "response": [
                        {
                            "id": "690750206",
                            "speaker": "Wanderer",
                            "text": "Pff."
                        }
                    ]
                }
            ]
        }
    ]
}