{
    "talkId": "6909609",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Arlecchino": 9,
        "Player": 8
    },
    "dialogues": [
        {
            "id": "690960201",
            "speaker": "Player",
            "text": "Você gosta daqui?"
        },
        {
            "id": "690960202",
            "speaker": "Arlecchino",
            "text": "Obrigada por me convidar a este paraíso. Esse provou ser um ótimo local de férias."
        },
        {
            "id": "690960203",
            "speaker": "Arlecchino",
            "text": "A transferência de titularidade é uma opção, por acaso?",
            "choices": [
                {
                    "id": "690960204",
                    "text": "...Hein?!",
                    "response": [
                        {
                            "id": "690960206",
                            "speaker": "Arlecchino",
                            "text": "Não precisa se espantar. Esse é um local calmo e seguro, protegido dos incômodos externos. Seria uma ótima base reserva."
                        },
                        {
                            "id": "690960207",
                            "speaker": "Arlecchino",
                            "text": "Qualquer objeto que possa resolver muitos problemas vale um bom preço.",
                            "choices": [
                                {
                                    "id": "690960208",
                                    "text": "Sinto desapontar...",
                                    "response": [
                                        {
                                            "id": "690960210",
                                            "speaker": "Arlecchino",
                                            "text": "Uma resposta insatisfatória, mas não inesperada."
                                        },
                                        {
                                            "id": "690960211",
                                            "speaker": "Arlecchino",
                                            "text": "Isso lembra um \"lar\" mais do que uma base. Vamos manter assim, então."
                                        },
                                        {
                                            "id": "690960212",
                                            "speaker": "Player",
                                            "text": "Falando em \"lar\"..."
                                        },
                                        {
                                            "id": "690960213",
                                            "speaker": "Arlecchino",
                                            "text": "Algo errado?",
                                            "choices": [
                                                {
                                                    "id": "690960214",
                                                    "text": "Quer fazer um \"churrasco de família\"?",
                                                    "response": [
                                                        {
                                                            "id": "690960216",
                                                            "speaker": "Arlecchino",
                                                            "text": "Uma ótima sugestão. Esse espaço é grande suficiente para uma reunião de família."
                                                        },
                                                        {
                                                            "id": "690960217",
                                                            "speaker": "Arlecchino",
                                                            "text": "#As crianças ficarão contentes em ter a chance de visitar e se divertir na casa de um{F#a} amig{M#o}{F#a}. Combinado, então... quanto aos custos da reunião, simplesmente deixe comigo."
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "690960215",
                                                    "text": "Todas as crianças da Casa da Lareira serão bem-vindas."
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "690960209",
                                    "text": "Mas não está a venda."
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690960205",
                    "text": "Você quer comprar o Bule de Relachá?"
                }
            ]
        }
    ]
}