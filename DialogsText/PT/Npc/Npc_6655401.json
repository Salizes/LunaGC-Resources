    "dialogues": [
        {
            "id": "665540101",
            "speaker": "Uhane",
            "text": "#Bem-vind{M#o}{F#a} a Paititi — o lugar dos seus sonhos! *Hip*...",
            "choices": [
                {
                    "id": "665540102",
                    "text": "O que é Paititi?",
                    "response": [
                        {
                            "id": "665540103",
                            "speaker": "Uhane",
                            "text": "Paititi é a Ilha Tete, e a Ilha Tete é Paititi! *Soluço*..."
                        },
                        {
                            "id": "665540104",
                            "speaker": "Uhane",
                            "text": "Então, o tesouro enterrado na Ilha Tete é o misterioso tesouro do dourado país de Paititi..."
                        },
                        {
                            "id": "665540105",
                            "speaker": "Uhane",
                            "text": "Segredo maneiro, né?! *Hip*..."
                        },
                        {
                            "id": "665540106",
                            "speaker": "Player",
                            "text": "Tem mesmo um tesouro aqui?"
                        },
                        {
                            "id": "665540107",
                            "speaker": "Uhane",
                            "text": "Hehe, por que eu mentiria pra você? É real, porque foi enterrado pelas autoridades do resort."
                        },
                        {
                            "id": "665540108",
                            "speaker": "Uhane",
                            "text": "É pra atrair clientes, mas é um tesouro de verdade. Então vamos ver quem tem sorte o bastante pra encontrar..."
                        },
                        {
                            "id": "665540109",
                            "speaker": "Player",
                            "text": "Você pode me dizer onde está?"
                        },
                        {
                            "id": "665540110",
                            "speaker": "Uhane",
                            "text": "Ah, qual é! Esses jovens de hoje... Pfff..."
                        },
                        {
                            "id": "665540111",
                            "speaker": "Uhane",
                            "text": "...Aff, não faz essa carinha de gatinho triste! Tá bom, tá bom, vou te dar uma dica!"
                        },
                        {
                            "id": "665540112",
                            "speaker": "Uhane",
                            "text": "Parte norte da Ilha Tete. É tudo o que vou dizer, e é tudo o que você precisa. *Hic*..."
                        }
                    ]
                },
                {
                    "id": "665540213",
                    "text": "Até depois.",
                    "response": [
                        {
                            "id": "665540214",
                            "speaker": "Uhane",
                            "text": "Tchaaau... *Hic*..."
                        }
                    ]
                }
            ]
        }
    ]
}