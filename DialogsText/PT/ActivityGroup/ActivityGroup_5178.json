            "dialogues": [
                {
                    "id": "401432001",
                    "speaker": "Quadro de Avisos",
                    "text": "O Albergue Wangshu está contratando urgentemente um chef temporário altamente remunerado, o salário é negociável. Os interessados devem subir para falar com o chefe Huai'an."
                }
            ]
        },
        {
            "talkId": "4014321",
            "initDialog": "401432101",
            "dialogues": [
                {
                    "id": "401432101",
                    "speaker": "Yanxiao Sorridente",
                    "text": "Sal, molho de soja, vinagre... Bem, há o suficiente para esta temporada."
                }
            ]
        },
        {
            "talkId": "4014322",
            "initDialog": "401432201",
            "dialogues": [
                {
                    "id": "401432201",
                    "speaker": "Huai'an",
                    "text": "#Ei, {NICKNAME}, parece que este ano começou bem."
                }
            ]
        },
        {
            "talkId": "4014323",
            "initDialog": "401432301",
            "dialogues": [
                {
                    "id": "401432301",
                    "speaker": "Verr Goldet",
                    "text": "#Bem-vind{M#o}{F#a}s! Como posso ajudar?"
                }
            ]
        },
        {
            "talkId": "4014324",
            "initDialog": "401432401",
            "dialogues": [
                {
                    "id": "401432401",
                    "speaker": "Player",
                    "text": "Posso comprar algo como de costume?"
                },
                {
                    "id": "401432402",
                    "speaker": "Verr Goldet",
                    "text": "Claro, fique à vontade para dar uma olhada."
                }
            ]
        },
        {
            "talkId": "4014325",
            "initDialog": "401432501",
            "dialogues": [
                {
                    "id": "401432501",
                    "speaker": "Player",
                    "text": "Adeus, chefe."
                },
                {
                    "id": "401432502",
                    "speaker": "Verr Goldet",
                    "text": "Adeus. Continue trabalhando duro."
                }
            ]
        },
        {
            "talkId": "4014326",
            "initDialog": "401432601",
            "dialogues": [
                {
                    "id": "401432601",
                    "speaker": "Player",
                    "text": "Não vou mais te incomodar."
                },
                {
                    "id": "401432602",
                    "speaker": "Huai'an",
                    "text": "Adeus, tenha uma boa viagem."
