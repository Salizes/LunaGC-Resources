    "talks": [
        {
            "talkId": "7467302",
            "initDialog": "746730201",
            "dialogues": [
                {
                    "id": "746730201",
                    "speaker": "Ulman",
                    "text": "E aí! Já voltaram?! Encontraram o tesouro?",
                    "choices": [
                        {
                            "id": "746730202",
                            "text": "Me mostre o que você tem.",
                            "response": [
                                {
                                    "id": "746730210",
                                    "speaker": "Ulman",
                                    "text": "Claro, deem uma olhada!"
                                }
                            ]
                        },
                        {
                            "id": "746730203",
                            "text": "Por que você veio a Fontaine?",
                            "response": [
                                {
                                    "id": "746730204",
                                    "speaker": "Ulman",
                                    "text": "Claro que estou aqui para... hmm... fazer negócios! Alguns dos meus parceiros de negócios vieram para cá, então claro que vim também."
                                },
                                {
                                    "id": "746730205",
                                    "speaker": "Paimon",
                                    "text": "Ei, esses parceiros de negócios seus não são... Ladrões de Tesouro ou coisa do tipo?"
                                },
                                {
                                    "id": "746730206",
                                    "speaker": "Ulman",
                                    "text": "Sem chance! Eu nunca trabalharia com gente dessa laia! O risco é alto demais..."
                                },
                                {
                                    "id": "746730207",
                                    "speaker": "Ulman",
                                    "text": "Hmm... Ou pelo menos eu não trabalharia diretamente com eles. Se por alguma razão eu tivesse que trabalhar com eles, ia precisar achar um intermediário."
                                }
                            ]
                        },
                        {
                            "id": "746730208",
                            "text": "Até mais.",
                            "response": [
                                {
                                    "id": "746730209",
                                    "speaker": "Ulman",
                                    "text": "Adeus! Deixo a recuperação das Moedas de Ferro Antigas com vocês, lembrem-se de me trazer as que encontrarem! Definitivamente vou comprar elas por um bom preço."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7467402",
            "initDialog": "746740201",
            "dialogues": [
                {
                    "id": "746740201",
                    "speaker": "Ulman",
                    "text": "O que fazer, o que fazer... *Suspiro* Talvez eu só devesse voltar direto para Mondstadt..."
                },
                {
                    "id": "746740202",
                    "speaker": "Ulman",
                    "text": "Já faz tanto tempo que eu até esqueci o sabor de Vinho de Dandelion...",
                    "choices": [
                        {
                            "id": "746740203",
                            "text": "Me mostre o que você tem.",
                            "response": [
                                {
                                    "id": "746740205",
                                    "speaker": "Ulman",
                                    "text": "Claro, deem uma olhada!"
                                }
                            ]
                        },
                        {
                            "id": "746740204",
                            "text": "Até mais.",
                            "response": [
                                {
                                    "id": "746740206",
                                    "speaker": "Ulman",
                                    "text": "Te vejo na próxima! Tenho a sensação que trabalharemos juntos de novo no futuro. Conto contigo quando chegar a hora!"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}