    "talks": [
        {
            "talkId": "7451502",
            "initDialog": "745150201",
            "dialogues": [
                {
                    "id": "745150201",
                    "speaker": "Hosseini",
                    "text": "Então, como vão os experimentos?",
                    "choices": [
                        {
                            "id": "745150202",
                            "text": "De boa, mais ou menos.",
                            "response": [
                                {
                                    "id": "745150203",
                                    "speaker": "Hosseini",
                                    "text": "As operações do Disco estão estáveis e os dados registrados estão claros. Normalmente, eu estaria emocionado."
                                },
                                {
                                    "id": "745150204",
                                    "speaker": "Hosseini",
                                    "text": "Mas ao observar seu desempenho de combate ao vivo, sinto que ainda há muito espaço para melhoria do dispositivo.",
                                    "choices": [
                                        {
                                            "id": "745150205",
                                            "text": "Bem, eu me garanto nas lutas.",
                                            "response": [
                                                {
                                                    "id": "745150206",
                                                    "speaker": "Hosseini",
                                                    "text": "Heh. Sim, é verdade. Precisarei trabalhar mais duro também."
                                                }
                                            ]
                                        },
                                        {
                                            "id": "745150207",
                                            "text": "Encontrar problemas é sempre bom.",
                                            "response": [
                                                {
                                                    "id": "745150208",
                                                    "speaker": "Hosseini",
                                                    "text": "#Precisamente. E por acaso tenho algumas ideias, então essa rodada de experimentos foi realmente uma colheita rica. Obrigado, {NICKNAME}."
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "745150209",
                            "text": "Acabei de notar. Você não tosse mais.",
                            "response": [
                                {
                                    "id": "745150210",
                                    "speaker": "Hosseini",
                                    "text": "Hmm. Agora que você mencionou... Estive melhor desde que fizemos progresso no Disco Hosseini."
                                },
                                {
                                    "id": "745150211",
                                    "speaker": "Hosseini",
                                    "text": "Talvez seja como os médicos dizem, \"rir é o melhor remédio\", afinal?",
                                    "choices": [
                                        {
                                            "id": "745150212",
                                            "text": "Espero que dê tudo certo.",
                                            "response": [
                                                {
                                                    "id": "745150213",
                                                    "speaker": "Hosseini",
                                                    "text": "#Obrigado, {NICKNAME}."
                                                }
                                            ]
                                        },
                                        {
                                            "id": "745150214",
                                            "text": "Vai te impedir de ser jubilado?",
                                            "response": [
                                                {
                                                    "id": "745150215",
                                                    "speaker": "Hosseini",
                                                    "text": "Vamos precisar que meu orientador queira cooperar para isso."
                                                },
                                                {
                                                    "id": "745150216",
                                                    "speaker": "Hosseini",
                                                    "text": "Mas, teoreticamente, ele terá que se conformar se o Disco Hosseini realmente atender às expectativas."
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}