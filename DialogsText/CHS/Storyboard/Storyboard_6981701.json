{
    "talkId": "6981701",
    "total_dialogue_lines": 35,
    "speaker_counts": {
        "Player": 3,
        "德财": 2,
        "望发": 2,
        "派蒙": 13,
        "申鹤": 11,
        "阿标": 2,
        "阿梅": 2
    },
    "dialogues": [
        {
            "id": "698170101",
            "speaker": "阿标",
            "text": "这次走镖，跋山涉水，历经千险。时隔这么久，终于能回来与你再次相见…你会生我的气吗？"
        },
        {
            "id": "698170102",
            "speaker": "阿梅",
            "text": "怎么会？只是…"
        },
        {
            "id": "698170103",
            "speaker": "阿梅",
            "text": "「旦为朝云，暮为行雨。朝朝暮暮，阳台之下。」虽然不能相见，但分别的日子里，我每天都在思念着你。"
        },
        {
            "id": "698170104",
            "speaker": "阿标",
            "text": "阿梅——"
        },
        {
            "id": "698170105",
            "speaker": "申鹤",
            "text": "……"
        },
        {
            "id": "698170106",
            "speaker": "派蒙",
            "text": "你好呀，申鹤！"
        },
        {
            "id": "698170107",
            "speaker": "申鹤",
            "text": "啊…是你们，你们怎么来了？"
        },
        {
            "id": "698170108",
            "speaker": "派蒙",
            "text": "#嘿嘿，{NICKNAME}说好久没来万民堂啦，正好今天有空，我们就一起来吃午饭。咦，卯师傅不在吗？"
        },
        {
            "id": "698170109",
            "speaker": "申鹤",
            "text": "卯师傅出门采购食材，今天是我看店。",
            "choices": [
                {
                    "id": "698170110",
                    "text": "刚刚看你在沉思…",
                    "response": [
                        {
                            "id": "698170112",
                            "speaker": "申鹤",
                            "text": "不，已经没关系了。"
                        },
                        {
                            "id": "698170113",
                            "speaker": "申鹤",
                            "text": "有什么想吃的东西吗？我来帮你们做。在这里帮工期间，我也向卯师傅学了几样手艺。"
                        },
                        {
                            "id": "698170114",
                            "speaker": "派蒙",
                            "text": "咦，真的吗？申鹤都会做什么呀？"
                        },
                        {
                            "id": "698170115",
                            "speaker": "申鹤",
                            "text": "比如烤吃虎鱼，还有香嫩椒椒鸡…"
                        },
                        {
                            "id": "698170116",
                            "speaker": "派蒙",
                            "text": "好耶！正好都是我们爱吃的！"
                        },
                        {
                            "id": "698170117",
                            "speaker": "申鹤",
                            "text": "嗯。以前你们来的时候，我看你们点过。"
                        },
                        {
                            "id": "698170118",
                            "speaker": "申鹤",
                            "text": "稍坐片刻，我来下厨。"
                        },
                        {
                            "id": "698170119",
                            "speaker": "Player",
                            "text": "我们也来帮忙吧。"
                        },
                        {
                            "id": "698170120",
                            "speaker": "派蒙",
                            "text": "没错，大美食家派蒙品尝过无数料理，今天就让我来指点你一下吧。"
                        },
                        {
                            "id": "698170121",
                            "speaker": "派蒙",
                            "text": "我们上！"
                        },
                        {
                            "id": "698170122",
                            "speaker": "派蒙",
                            "text": "#不愧是{NICKNAME}，一眨眼就把蔬菜切好了！"
                        },
                        {
                            "id": "698170123",
                            "speaker": "派蒙",
                            "text": "等下，火是不是有点大——喂！申鹤，灶台下面冒烟了！"
                        },
                        {
                            "id": "698170124",
                            "speaker": "申鹤",
                            "text": "不必担心。「寒冰变神」！"
                        },
                        {
                            "id": "698170125",
                            "speaker": "派蒙",
                            "text": "等下，怎么连灶台一起冻住啦！"
                        },
                        {
                            "id": "698170126",
                            "speaker": "派蒙",
                            "text": "嗯…嗯？味道意外的还不错…"
                        },
                        {
                            "id": "698170127",
                            "speaker": "派蒙",
                            "text": "椒椒鸡被冰过之后有一种特殊的口感，难道我们意外发现了新的菜肴？"
                        },
                        {
                            "id": "698170128",
                            "speaker": "派蒙",
                            "text": "真好吃。嘿嘿，你们也快来尝尝看！"
                        },
                        {
                            "id": "698170129",
                            "speaker": "申鹤",
                            "text": "好吃就好。下次有机会，我们再一起下厨吧。"
                        },
                        {
                            "id": "698170130",
                            "speaker": "望发",
                            "text": "你好，店里有人在吗？"
                        },
                        {
                            "id": "698170131",
                            "speaker": "派蒙",
                            "text": "客人渐渐多起来了呢。申鹤是不是也要开始忙了？"
                        },
                        {
                            "id": "698170132",
                            "speaker": "申鹤",
                            "text": "嗯，我去看看。"
                        },
                        {
                            "id": "698170133",
                            "speaker": "望发",
                            "text": "「夕阳红旅团」？你确定这个名字能吸引人来报名？"
                        },
                        {
                            "id": "698170134",
                            "speaker": "德财",
                            "text": "名字可以再议嘛。不过「送长辈出门旅游」，据说也是当代年轻人表达孝心的一种方式，我觉得是个商机。"
                        },
                        {
                            "id": "698170135",
                            "speaker": "德财",
                            "text": "…不好意思，点单。"
                        }
                    ]
                },
                {
                    "id": "698170111",
                    "text": "有什么心事吗？"
                }
            ]
        }
    ]
}