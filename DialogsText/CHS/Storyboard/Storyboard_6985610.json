{
    "talkId": "6985610",
    "total_dialogue_lines": 36,
    "speaker_counts": {
        "Player": 16,
        "伊涅芙": 20
    },
    "dialogues": [
        {
            "id": "698561001",
            "speaker": "伊涅芙",
            "text": "还差3个。检测到有熟人接近…"
        },
        {
            "id": "698561002",
            "speaker": "Player",
            "text": "伊涅芙？"
        },
        {
            "id": "698561003",
            "speaker": "伊涅芙",
            "text": "#你好，{NICKNAME}。"
        },
        {
            "id": "698561004",
            "speaker": "Player",
            "text": "你在采摘白灵果吗？"
        },
        {
            "id": "698561005",
            "speaker": "伊涅芙",
            "text": "是的。爱诺喜欢吃新鲜度高一点的白灵果制作的蛋卷。"
        },
        {
            "id": "698561006",
            "speaker": "伊涅芙",
            "text": "市集今天贩卖的白灵果均不能满足爱诺的要求，所以我在执行采摘新鲜白灵果的指令。",
            "choices": [
                {
                    "id": "698561007",
                    "text": "你还好吗？",
                    "response": [
                        {
                            "id": "698561008",
                            "speaker": "伊涅芙",
                            "text": "我很好，谢谢，你呢？"
                        },
                        {
                            "id": "698561009",
                            "speaker": "Player",
                            "text": "我很好，但是等一会…"
                        },
                        {
                            "id": "698561011",
                            "speaker": "伊涅芙",
                            "text": "谢谢你的关心，前几天，爱诺已经将我的幽默感调整至原来的数值。",
                            "choices": [
                                {
                                    "id": "698561012",
                                    "text": "（呼…总算调回去了…）",
                                    "response": [
                                        {
                                            "id": "698561014",
                                            "speaker": "伊涅芙",
                                            "text": "因为在输出了最初的几则笑话后，我创作笑话的效率明显下降，勉强创作的笑话，也没有趣味。"
                                        },
                                        {
                                            "id": "698561015",
                                            "speaker": "伊涅芙",
                                            "text": "据爱诺推测，是因为此类笑话的创作逻辑太过混乱，我的逻辑模块无法理解其创作原则，也无法输出具体内容。"
                                        },
                                        {
                                            "id": "698561016",
                                            "speaker": "伊涅芙",
                                            "text": "为了不影响模块本身的运作，爱诺还是复原了各个模块的数值。"
                                        },
                                        {
                                            "id": "698561017",
                                            "speaker": "伊涅芙",
                                            "text": "#但如果{NICKNAME}很喜欢我之前的幽默感，我可以告诉爱诺。",
                                            "choices": [
                                                {
                                                    "id": "698561018",
                                                    "text": "这样就挺好的！",
                                                    "response": [
                                                        {
                                                            "id": "698561020",
                                                            "speaker": "伊涅芙",
                                                            "text": "#{NICKNAME}不喜欢这样的幽默感么？",
                                                            "choices": [
                                                                {
                                                                    "id": "698561021",
                                                                    "text": "我认识一个有这种幽默感的人。",
                                                                    "response": [
                                                                        {
                                                                            "id": "698561023",
                                                                            "speaker": "伊涅芙",
                                                                            "text": "是么？那他一定是一个很厉害的人。居然能够在如此混乱、诡异、毫无逻辑的创作原则下，一直创作出能让人笑出来的好笑话。"
                                                                        },
                                                                        {
                                                                            "id": "698561024",
                                                                            "speaker": "Player",
                                                                            "text": "我们还是来谈谈蛋卷的事吧…"
                                                                        },
                                                                        {
                                                                            "id": "698561025",
                                                                            "speaker": "伊涅芙",
                                                                            "text": "好的，如果你要问我蛋卷里能不能多加点糖的话…"
                                                                        },
                                                                        {
                                                                            "id": "698561026",
                                                                            "speaker": "伊涅芙",
                                                                            "text": "我的回答是：白灵蛋卷有固定的糖分配方，多加或者少加都会影响口味。",
                                                                            "choices": [
                                                                                {
                                                                                    "id": "698561027",
                                                                                    "text": "谢天谢地…",
                                                                                    "response": [
                                                                                        {
                                                                                            "id": "698561029",
                                                                                            "speaker": "伊涅芙",
                                                                                            "text": "当然。正在检测环境是否具备烹饪演示条件…该环境不适合进行烹饪。"
                                                                                        },
                                                                                        {
                                                                                            "id": "698561030",
                                                                                            "speaker": "伊涅芙",
                                                                                            "text": "…但我携带了，可以立即食用的「轰雷电光斩！」。请你收下。",
                                                                                            "choices": [
                                                                                                {
                                                                                                    "id": "698561032",
                                                                                                    "text": "（看来伊涅芙真的恢复了。）",
                                                                                                    "response": [
                                                                                                        {
                                                                                                            "id": "698561034",
                                                                                                            "speaker": "伊涅芙",
                                                                                                            "text": "不必客气。"
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "698561035",
                                                                                                            "speaker": "伊涅芙",
                                                                                                            "text": "如果有时间的话，请来我们家做客吧。"
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "698561036",
                                                                                                            "speaker": "伊涅芙",
                                                                                                            "text": "虽然我的幽默感数值已复原。但爱诺最近一直在研究此类笑话的创作逻辑链。"
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "698561037",
                                                                                                            "speaker": "伊涅芙",
                                                                                                            "text": "#如果她能做出笑话专用创作模块的话，我就可以继续输出好笑话了。请期待吧，{NICKNAME}。"
                                                                                                        }
                                                                                                    ]
                                                                                                },
                                                                                                {
                                                                                                    "id": "698561033",
                                                                                                    "text": "那就谢谢了？"
                                                                                                }
                                                                                            ]
                                                                                        }
                                                                                    ]
                                                                                },
                                                                                {
                                                                                    "id": "698561028",
                                                                                    "text": "那…白灵蛋卷的制作方法…"
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                },
                                                                {
                                                                    "id": "698561022",
                                                                    "text": "他的幽默感永无止境…"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "698561019",
                                                    "text": "不用再调了！"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "698561013",
                                    "text": "咦？怎么调回去了？"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "698561010",
                    "text": "你的幽默感调整如何？"
                }
            ]
        }
    ]
}