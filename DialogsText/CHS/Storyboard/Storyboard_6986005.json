{
    "talkId": "6986005",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 4,
        "奈芙尔": 7,
        "萨维特": 3
    },
    "dialogues": [
        {
            "id": "698600501",
            "speaker": "奈芙尔",
            "text": "嗯…这本书不错，我买下了。还有之前的那两本，都给我包起来吧。"
        },
        {
            "id": "698600502",
            "speaker": "萨维特",
            "text": "好的，奈芙尔小姐。不过之前那两本书…恕我直言，写这两本书的作者，实在不可信。"
        },
        {
            "id": "698600503",
            "speaker": "萨维特",
            "text": "即使是在《那夏快报》上，这家伙也算是最会信口开河的人。"
        },
        {
            "id": "698600504",
            "speaker": "萨维特",
            "text": "您瞧，这本《识人的艺术》和另外一本《交际的艺术》上，他连名字都不敢署！"
        },
        {
            "id": "698600505",
            "speaker": "奈芙尔",
            "text": "没关系，我只是买回去，给我店里那位小姑娘长长见识。",
            "choices": [
                {
                    "id": "698600506",
                    "text": "长…长长见识…？",
                    "response": [
                        {
                            "id": "698600508",
                            "speaker": "奈芙尔",
                            "text": "嗯。多看点书，对她来说没坏处。"
                        },
                        {
                            "id": "698600509",
                            "speaker": "奈芙尔",
                            "text": "她老是这么咋咋呼呼，莽莽撞撞的，我以后还怎么安心把重要的工作交给她？",
                            "choices": [
                                {
                                    "id": "698600510",
                                    "text": "（你就没有不安心过…）",
                                    "response": [
                                        {
                                            "id": "698600512",
                                            "speaker": "奈芙尔",
                                            "text": "是啊，我正好也来看看，雅珂达和这位作者，到底谁更不靠谱。"
                                        },
                                        {
                                            "id": "698600513",
                                            "speaker": "奈芙尔",
                                            "text": "要是那个「更不靠谱」的人是雅珂达的话…"
                                        },
                                        {
                                            "id": "698600514",
                                            "speaker": "奈芙尔",
                                            "text": "那我就头痛了。或许，只能想点其他的「激励政策」，来鼓舞一下这位小姑娘了。"
                                        }
                                    ]
                                },
                                {
                                    "id": "698600511",
                                    "text": "但这个作者不是不靠谱吗？"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "698600507",
                    "text": "你要让雅珂达看这个？"
                }
            ]
        }
    ]
}