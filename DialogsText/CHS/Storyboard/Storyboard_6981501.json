{
    "talkId": "6981501",
    "total_dialogue_lines": 22,
    "speaker_counts": {
        "Player": 8,
        "砂糖": 14
    },
    "dialogues": [
        {
            "id": "698150101",
            "speaker": "砂糖",
            "text": "…嗯，真有趣，我要记录下来。",
            "choices": [
                {
                    "id": "698150102",
                    "text": "今天是你的假期吗？",
                    "response": [
                        {
                            "id": "698150104",
                            "speaker": "砂糖",
                            "text": "#{NICKNAME}？我、我还以为这个地方不会有人来才对。"
                        },
                        {
                            "id": "698150105",
                            "speaker": "砂糖",
                            "text": "我正趁着假期，在这里观察自然呢。"
                        },
                        {
                            "id": "698150106",
                            "speaker": "Player",
                            "text": "遗迹守卫吗？"
                        },
                        {
                            "id": "698150107",
                            "speaker": "砂糖",
                            "text": "往那边看，你看到那群白鸽了吗？"
                        },
                        {
                            "id": "698150108",
                            "speaker": "Player",
                            "text": "可鸽子不是到处都有吗？"
                        },
                        {
                            "id": "698150109",
                            "speaker": "砂糖",
                            "text": "但只有在足够高、足够安全、足够人迹罕至的地方，它们才会呈现出最自然真实的模样。"
                        },
                        {
                            "id": "698150110",
                            "speaker": "砂糖",
                            "text": "啊，说到这个。你看，遗迹守卫的巡逻并不会干涉白鸽的生态。",
                            "choices": [
                                {
                                    "id": "698150111",
                                    "text": "是因为它不会主动攻击动物吗？",
                                    "response": [
                                        {
                                            "id": "698150113",
                                            "speaker": "砂糖",
                                            "text": "这正是我好奇的地方。"
                                        },
                                        {
                                            "id": "698150114",
                                            "speaker": "砂糖",
                                            "text": "曾经，我观察到过团雀在遗迹守卫的头顶上筑巢。而当其他人靠近时，那遗迹守卫还能重新运作。"
                                        },
                                        {
                                            "id": "698150115",
                                            "speaker": "砂糖",
                                            "text": "这种关系能够算共生吗？它们之间是否存在可供交流的语言或信号？"
                                        },
                                        {
                                            "id": "698150116",
                                            "speaker": "砂糖",
                                            "text": "这种对自律机关的信赖是不是和印随现象一样是可以遗传的本能？还是说它们有着比我们想象中更高的知能？"
                                        },
                                        {
                                            "id": "698150117",
                                            "speaker": "砂糖",
                                            "text": "生物的秘密还有很多，我想要更多了解它们！",
                                            "choices": [
                                                {
                                                    "id": "698150118",
                                                    "text": "是值得思考的问题。",
                                                    "response": [
                                                        {
                                                            "id": "698150120",
                                                            "speaker": "砂糖",
                                                            "text": "谢谢！我很高兴能有机会和你分享这些看法。"
                                                        },
                                                        {
                                                            "id": "698150121",
                                                            "speaker": "砂糖",
                                                            "text": "之前我总觉得…一个人在实验室里做实验度过的时光是最充实和快乐的。"
                                                        },
                                                        {
                                                            "id": "698150122",
                                                            "speaker": "砂糖",
                                                            "text": "但现在想想，以这样的方式度过假期也不错。"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "698150119",
                                                    "text": "能理解你的心情。"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "698150112",
                                    "text": "是因为动物能理解它没有敌意吗？"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "698150103",
                    "text": "你怎么爬到那么高的地方来了？"
                }
            ]
        }
    ]
}