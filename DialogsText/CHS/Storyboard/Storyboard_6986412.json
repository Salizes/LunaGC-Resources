{
    "talkId": "6986412",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 4,
        "菲林斯": 7
    },
    "dialogues": [
        {
            "id": "698641201",
            "speaker": "菲林斯",
            "text": "#{NICKNAME}，真是巧遇，向您致意。"
        },
        {
            "id": "698641202",
            "speaker": "菲林斯",
            "text": "我刚在周围巡视，刚扫清了一处狂猎，就遇见了您。"
        },
        {
            "id": "698641203",
            "speaker": "菲林斯",
            "text": "这里距城里实在遥远，周围魔物丛生，亦有狂猎作乱，如果您需要我护送您入城的话，我乐意效劳。",
            "choices": [
                {
                    "id": "698641204",
                    "text": "不用了不用了…",
                    "response": [
                        {
                            "id": "698641206",
                            "speaker": "菲林斯",
                            "text": "啊，原来如此，那我的确不应多有叨扰了。",
                            "choices": [
                                {
                                    "id": "698641207",
                                    "text": "放心啦，我很强的。",
                                    "response": [
                                        {
                                            "id": "698641209",
                                            "speaker": "菲林斯",
                                            "text": "呵呵，的确如此。我已经亲眼见识过了。"
                                        },
                                        {
                                            "id": "698641210",
                                            "speaker": "菲林斯",
                                            "text": "但路见您独经荒野，无论是出于友谊，还是出于礼节，我还是应当来问候一番。"
                                        },
                                        {
                                            "id": "698641211",
                                            "speaker": "菲林斯",
                                            "text": "那么，我就先行告辞了。如需帮助，您知道应当去何处找我。我保证，当您叩门时，我必有应答。"
                                        }
                                    ]
                                },
                                {
                                    "id": "698641208",
                                    "text": "以我的身手，遇不见危险。"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "698641205",
                    "text": "我在这里还有点事。"
                }
            ]
        }
    ]
}