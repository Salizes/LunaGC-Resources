{
    "talkId": "6984202",
    "total_dialogue_lines": 34,
    "speaker_counts": {
        "Black Screen": 1,
        "Player": 5,
        "千织": 20,
        "迪希雅": 8
    },
    "dialogues": [
        {
            "id": "698420201",
            "speaker": "千织",
            "text": "我会尽快安排的，但定制的衣服通常制作时间更长一些。"
        },
        {
            "id": "698420202",
            "speaker": "千织",
            "text": "要是赶不上迪希雅小姐离开的日子，我会委托「狛荷屋」给你送过去。"
        },
        {
            "id": "698420203",
            "speaker": "迪希雅",
            "text": "好，那就拜托老板了。"
        },
        {
            "id": "698420204",
            "speaker": "千织",
            "text": "没事。你给的尺码都很详细，做起来应该不会太慢。"
        },
        {
            "id": "698420205",
            "speaker": "千织",
            "text": "另外，你需要的话，我可以为你再单独定制一件舞服。"
        },
        {
            "id": "698420206",
            "speaker": "迪希雅",
            "text": "欸？我不需要的，买这些衣服，也是为了陪大小姐练习，平日里我也不怎么有自己跳舞的机会。"
        },
        {
            "id": "698420207",
            "speaker": "千织",
            "text": "是么？但你的目光，刚才一直在我店里挂着的各式舞服上来回打转。"
        },
        {
            "id": "698420208",
            "speaker": "千织",
            "text": "依我看，你应该比较喜欢绸缎做的款式，衣服上要有波浪纹，短款裙边，手腕和腰部要有束带…",
            "choices": [
                {
                    "id": "698420209",
                    "text": "欸？是什么时候…",
                    "response": [
                        {
                            "id": "698420211",
                            "speaker": "千织",
                            "text": "只是跟着你的目光，做了一点简单观察而已。怎么样，如果你想要一件属于自己的舞蹈服的话，现在正是好时机。"
                        },
                        {
                            "id": "698420212",
                            "speaker": "迪希雅",
                            "text": "我…"
                        },
                        {
                            "id": "698420213",
                            "speaker": "千织",
                            "text": "钱不够？"
                        },
                        {
                            "id": "698420214",
                            "speaker": "迪希雅",
                            "text": "倒也不是，我是带足了钱，但…"
                        },
                        {
                            "id": "698420215",
                            "speaker": "千织",
                            "text": "那就是有其他顾虑。你有硬币么？"
                        },
                        {
                            "id": "698420216",
                            "speaker": "迪希雅",
                            "text": "咦？硬币，我倒是有，可是…"
                        },
                        {
                            "id": "698420217",
                            "speaker": "千织",
                            "text": "正面是买，反面是不买，丢起来看看结果吧。",
                            "choices": [
                                {
                                    "id": "698420218",
                                    "text": "原来是用丢硬币来解决吗…",
                                    "response": [
                                        {
                                            "id": "698420220",
                                            "speaker": "迪希雅",
                                            "text": "这样也有点太随便了，其实我…"
                                        },
                                        {
                                            "id": "698420221",
                                            "speaker": "千织",
                                            "text": "现在就丢吧。"
                                        },
                                        {
                                            "id": "698420222",
                                            "speaker": "千织",
                                            "text": "丢出去的一瞬间，你就知道自己心里的答案了。"
                                        },
                                        {
                                            "id": "698420223",
                                            "speaker": "Black Screen",
                                            "text": "迪希雅抛出了硬币。硬币在空中打了几个转，被她用左手的手背接住，右手飞快地盖了上去。"
                                        },
                                        {
                                            "id": "698420224",
                                            "speaker": "千织",
                                            "text": "结果呢？"
                                        },
                                        {
                                            "id": "698420225",
                                            "speaker": "迪希雅",
                                            "text": "……"
                                        },
                                        {
                                            "id": "698420226",
                                            "speaker": "千织",
                                            "text": "不用打开看。如果此刻你心里想的是「最好是正面」的话。"
                                        },
                                        {
                                            "id": "698420227",
                                            "speaker": "千织",
                                            "text": "那现在，就是你为自己买一件新衣服的时候了。"
                                        },
                                        {
                                            "id": "698420228",
                                            "speaker": "千织",
                                            "text": "不要因为一些没有意义的顾虑，而错过一件自己心仪的东西。"
                                        },
                                        {
                                            "id": "698420229",
                                            "speaker": "迪希雅",
                                            "text": "哈哈哈！好，老板，请为我做一件衣服吧。"
                                        },
                                        {
                                            "id": "698420230",
                                            "speaker": "千织",
                                            "text": "好，去店里谈谈你的要求吧，里面有茶。"
                                        },
                                        {
                                            "id": "698420231",
                                            "speaker": "千织",
                                            "text": "#{NICKNAME}，一起进去喝一杯茶？顺便也给你量量尺码。"
                                        },
                                        {
                                            "id": "698420232",
                                            "speaker": "Player",
                                            "text": "我就不用了…"
                                        },
                                        {
                                            "id": "698420233",
                                            "speaker": "千织",
                                            "text": "是么？好吧，那需要订衣服的时候来找我吧，你应该知道店里的营业时间。"
                                        },
                                        {
                                            "id": "698420234",
                                            "speaker": "千织",
                                            "text": "迪希雅小姐，里面请吧。"
                                        }
                                    ]
                                },
                                {
                                    "id": "698420219",
                                    "text": "这也太随意了…"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "698420210",
                    "text": "这也太详细了！"
                }
            ]
        }
    ]
}