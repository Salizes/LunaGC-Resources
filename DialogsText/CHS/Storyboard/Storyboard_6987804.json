{
    "talkId": "6987804",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 2,
        "法尔伽": 10
    },
    "dialogues": [
        {
            "id": "698780401",
            "speaker": "法尔伽",
            "text": "喝！"
        },
        {
            "id": "698780402",
            "speaker": "法尔伽",
            "text": "嗯…总觉得这剑还是不够重，用起来轻飘飘的。"
        },
        {
            "id": "698780403",
            "speaker": "法尔伽",
            "text": "算了，挪德卡莱的锻造工艺不合我胃口，等回了蒙德城，让瓦格纳帮我再把剑加重一点。",
            "choices": [
                {
                    "id": "698780404",
                    "text": "总感觉这句话在哪听过…",
                    "response": [
                        {
                            "id": "698780406",
                            "speaker": "法尔伽",
                            "text": "诺艾尔？哈哈哈哈，那也正常，那孩子也用不惯普通的武器。"
                        },
                        {
                            "id": "698780407",
                            "speaker": "法尔伽",
                            "text": "我本来还说，想在挪德卡莱找点特别的矿石，给她造一把特别的剑带回去，作为礼物呢。"
                        },
                        {
                            "id": "698780408",
                            "speaker": "法尔伽",
                            "text": "结果我找了半天，也没找到合适的矿石。看来这次只能空着手回去了。"
                        },
                        {
                            "id": "698780409",
                            "speaker": "法尔伽",
                            "text": "不过，我听说诺艾尔正在学习琴的风压剑？那我正好也回去教她两招！"
                        },
                        {
                            "id": "698780410",
                            "speaker": "法尔伽",
                            "text": "要是诺艾尔也能和我一样，双手持双剑的话，那就最好。这样的话，我可以教她怎么用剑打出风压了。"
                        },
                        {
                            "id": "698780411",
                            "speaker": "法尔伽",
                            "text": "虽然她离成为正式骑士还缺了一些契机，但先想个骑士称号吧！"
                        },
                        {
                            "id": "698780412",
                            "speaker": "法尔伽",
                            "text": "侦察骑士…狮牙骑士…还差个什么骑士呢…"
                        }
                    ]
                },
                {
                    "id": "698780405",
                    "text": "好像诺艾尔也拜托过瓦格纳…"
                }
            ]
        }
    ]
}