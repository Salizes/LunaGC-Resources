    "dialogues": [
        {
            "id": "698571301",
            "speaker": "克洛琳德",
            "text": "好。那么游戏继续。"
        },
        {
            "id": "698571302",
            "speaker": "「主持人」",
            "text": "「…就在所有人束手无策之时，一个熟悉的声音却从众人的背后响起。」",
            "choices": [
                {
                    "id": "698571401",
                    "text": "好久不见，各位。看来你们需要我的帮助？",
                    "response": [
                        {
                            "id": "698571402",
                            "speaker": "娜维娅",
                            "text": "#{NICKNAME}，你怎么会在这里？难、难道是听到了我们的呼唤？"
                        },
                        {
                            "id": "698571403",
                            "speaker": "派蒙",
                            "text": "#（怎么把{NICKNAME}说得和召唤灵一样…啊，这么一想，确实很像呢，嘿嘿嘿…）"
                        },
                        {
                            "id": "698571404",
                            "speaker": "Player",
                            "text": "是、是啊…我听见了呼唤，我必须回应！"
                        },
                        {
                            "id": "698571405",
                            "speaker": "雅珂达",
                            "text": "（这意思就是：「我是被突然莫名其妙拉进来玩游戏的啊！」吧…）"
                        },
                        {
                            "id": "698571701",
                            "speaker": "叶洛亚",
                            "text": "#（不愧是{NICKNAME}，好强的代入感啊…）"
                        },
                        {
                            "id": "698571801",
                            "speaker": "「主持人」",
                            "text": "「虽然逐影猎人们彼此之间还有许多话想要倾诉，但此时此刻，久别重逢的喜悦必须要让位于迫在眉睫的危机。」"
                        },
                        {
                            "id": "698571802",
                            "speaker": "「主持人」",
                            "text": "那么，战斗轮继续。第一轮由你们行动。"
                        },
                        {
                            "id": "698571803",
                            "speaker": "「主持人」",
                            "text": "另外。因为临时加入了新成员，所以我要为敌人的各项能力加上数张「暗卡」。"
                        },
                        {
                            "id": "698571804",
                            "speaker": "娜维娅",
                            "text": "#{NICKNAME}才不是突然加入的，{M#他}{F#她}一直和我们旅行啊。"
                        },
                        {
                            "id": "698571805",
                            "speaker": "娜维娅",
                            "text": "只不过…呃…突然离开了一小段时间而已…"
                        },
                        {
                            "id": "698571806",
                            "speaker": "「主持人」",
                            "text": "我已经算好「暗卡」数量了。你们该商量战术了。"
                        },
                        {
                            "id": "698571807",
                            "speaker": "娜维娅",
                            "text": "欸——克洛琳德好严格哦…"
                        },
                        {
                            "id": "698571808",
                            "speaker": "娜维娅",
                            "text": "#那么就按照原本的战术来吧，既然有了{NICKNAME}的加入，我们的人手就足够了。"
                        },
                        {
                            "id": "698571809",
                            "speaker": "娜维娅",
                            "text": "我和叶洛亚待在正面，抵挡住怪物的攻势。"
                        },
                        {
                            "id": "698571810",
                            "speaker": "娜维娅",
                            "text": "#雅珂达和{NICKNAME}就绕到背后，把怪物从背后一口气全部打倒。"
                        },
                        {
                            "id": "698571811",
                            "speaker": "雅珂达",
                            "text": "好嘞，交给我吧。嘿嘿，从背后攻击的时候，「炼气士」可是有着很高的伤害增强呢。"
                        },
                        {
                            "id": "698571901",
                            "speaker": "雅珂达",
                            "text": "#不过…{NICKNAME}，你为什么是厨师啊。厨师要怎么…偷袭呢？",
                            "choices": [
                                {
                                    "id": "698571902",
                                    "text": "我可以用平底锅重击。",
                                    "response": [
                                        {
                                            "id": "698571903",
                                            "speaker": "「主持人」",
                                            "text": "#没错。{NICKNAME}的平底锅是一种钝器，如果抽到好卡的话，可以让敌人陷入长时间眩晕。"
                                        }
                                    ]
                                },
                                {
                                    "id": "698571904",
                                    "text": "我可以用食物劝降对手。",
                                    "response": [
                                        {
                                            "id": "698571905",
                                            "speaker": "「主持人」",
                                            "text": "可以。如果你真的能抽到好卡的话。"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "698571501",
                    "text": "好久不见，各位。看来你们需要我的帮助？",
                    "response": [
                        {
                            "id": "698571502",
                            "speaker": "娜维娅",
                            "text": "#{NICKNAME}，你怎么会在这里？难、难道是听到了我们的呼唤？"
                        },
                        {
                            "id": "698571503",
                            "speaker": "派蒙",
                            "text": "#（怎么把{NICKNAME}说得和召唤灵一样…啊，这么一想，确实很像呢，嘿嘿嘿…）"
                        },
                        {
                            "id": "698571504",
                            "speaker": "Player",
                            "text": "是、是啊…我听见了呼唤，我必须回应！"
                        },
                        {
                            "id": "698571505",
                            "speaker": "雅珂达",
                            "text": "（这意思就是：「我是被突然莫名其妙拉进来玩游戏的啊！」吧…）"
                        },
                        {
                            "id": "698571601",
                            "speaker": "叶洛亚",
                            "text": "（不愧是娜维娅小姐之前提过的老玩家，一下子就代入了啊…）"
                        }
                    ]
                }
            ]
        }
    ]
}