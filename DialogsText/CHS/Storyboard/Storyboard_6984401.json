{
    "talkId": "6984401",
    "total_dialogue_lines": 21,
    "speaker_counts": {
        "Player": 4,
        "绮良良": 9,
        "香菱": 8
    },
    "dialogues": [
        {
            "id": "698440101",
            "speaker": "绮良良",
            "text": "呼…呼…好烫…"
        },
        {
            "id": "698440102",
            "speaker": "香菱",
            "text": "唔…这个温度还是不行吗？但放凉了的话，这道菜就不好吃了…",
            "choices": [
                {
                    "id": "698440103",
                    "text": "有什么试吃活动吗？",
                    "response": [
                        {
                            "id": "698440105",
                            "speaker": "香菱",
                            "text": "#{NICKNAME}，你也来了！绮良良刚从稻妻送了一批新鲜的鱼过来。"
                        },
                        {
                            "id": "698440106",
                            "speaker": "香菱",
                            "text": "我想着她跑了这么远，就打算做点热腾腾的璃月菜招待她，所谓「一烫抵三鲜」嘛。"
                        },
                        {
                            "id": "698440107",
                            "speaker": "绮良良",
                            "text": "豪…豪醋！真的豪…唔喵！烫烫烫烫烫！"
                        },
                        {
                            "id": "698440108",
                            "speaker": "香菱",
                            "text": "真的不用勉强啦！我们璃月也有凉菜的，我马上就能做出来！"
                        },
                        {
                            "id": "698440109",
                            "speaker": "绮良良",
                            "text": "但这道水煮鱼真的很好吃啊！我、我再试试…"
                        },
                        {
                            "id": "698440110",
                            "speaker": "绮良良",
                            "text": "呼，呼呼呼呼…再拿凉水泡一泡…先泡凉…"
                        },
                        {
                            "id": "698440111",
                            "speaker": "绮良良",
                            "text": "唔喵！"
                        },
                        {
                            "id": "698440112",
                            "speaker": "Player",
                            "text": "还是烫？"
                        },
                        {
                            "id": "698440113",
                            "speaker": "绮良良",
                            "text": "好辣！"
                        },
                        {
                            "id": "698440114",
                            "speaker": "Player",
                            "text": "果然是「猫舌头」啊…"
                        },
                        {
                            "id": "698440115",
                            "speaker": "香菱",
                            "text": "哎呀，你别勉强了，快快快，含着这团饭，我爹说这样解辣。"
                        },
                        {
                            "id": "698440116",
                            "speaker": "绮良良",
                            "text": "呜…呜喵…确实豪一点了…"
                        },
                        {
                            "id": "698440117",
                            "speaker": "香菱",
                            "text": "我想想喔，有什么好吃的凉菜呢…"
                        },
                        {
                            "id": "698440118",
                            "speaker": "绮良良",
                            "text": "咦，这饭团的味道也好好喔，和奶奶做的饭团一样好吃，酸酸甜甜的…"
                        },
                        {
                            "id": "698440119",
                            "speaker": "香菱",
                            "text": "那当然啦，我在里面加了煮熟的土豆和甜甜花，还有梅子干啦，树莓干啦…欸？你怎么吃掉啦！"
                        },
                        {
                            "id": "698440120",
                            "speaker": "绮良良",
                            "text": "舌头！舌头又烧起来了！辣辣辣辣辣辣辣！"
                        },
                        {
                            "id": "698440121",
                            "speaker": "香菱",
                            "text": "只有含着才有解辣的效果啦！快快快再含一团，这次别再吃啦！"
                        }
                    ]
                },
                {
                    "id": "698440104",
                    "text": "遇到什么麻烦了吗？"
                }
            ]
        }
    ]
}