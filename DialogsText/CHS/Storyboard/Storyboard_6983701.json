{
    "talkId": "6983701",
    "total_dialogue_lines": 19,
    "speaker_counts": {
        "Player": 4,
        "提纳里": 10,
        "赛诺": 5
    },
    "dialogues": [
        {
            "id": "698370101",
            "speaker": "提纳里",
            "text": "嗯…答应了柯莱今天晚上煮蘑菇浓汤喝，除了蘑菇之外，还要买点其他调味品…"
        },
        {
            "id": "698370102",
            "speaker": "提纳里",
            "text": "赛诺，你在看什么？是想尝尝这种蘑菇吗？"
        },
        {
            "id": "698370103",
            "speaker": "赛诺",
            "text": "不，我是在思考一个和蘑菇有关的问题。"
        },
        {
            "id": "698370104",
            "speaker": "Player",
            "text": "赛诺在估量什么吗？"
        },
        {
            "id": "698370105",
            "speaker": "赛诺",
            "text": "#是你啊，{NICKNAME}。你刚才说的这个笑话不错，请让我借鉴一下。"
        },
        {
            "id": "698370106",
            "speaker": "提纳里",
            "text": "#欸？{NICKNAME}刚才说什么了？估量…估…"
        },
        {
            "id": "698370107",
            "speaker": "赛诺",
            "text": "很不错，我喜欢。",
            "choices": [
                {
                    "id": "698370108",
                    "text": "之前受教了。",
                    "response": [
                        {
                            "id": "698370110",
                            "speaker": "提纳里",
                            "text": "……"
                        },
                        {
                            "id": "698370111",
                            "speaker": "提纳里",
                            "text": "马上就到吃饭的时间了，你们俩就别折腾了。"
                        },
                        {
                            "id": "698370112",
                            "speaker": "提纳里",
                            "text": "#{NICKNAME}，要过来一起吃么？你来做客的话，柯莱也会很高兴的。"
                        },
                        {
                            "id": "698370113",
                            "speaker": "赛诺",
                            "text": "嗯，这样不错。但是可惜，我还是没找到「萤蕈」。"
                        },
                        {
                            "id": "698370114",
                            "speaker": "提纳里",
                            "text": "「萤蕈」？我怎么都没听说过这种蘑菇，是院里刚发现的新物种？"
                        },
                        {
                            "id": "698370115",
                            "speaker": "提纳里",
                            "text": "不对啊，培育新物种的项目我应该都看过，没有用这个词组命名的蘑菇啊…"
                        },
                        {
                            "id": "698370116",
                            "speaker": "赛诺",
                            "text": "是啊，毕竟这种蘑菇尚无「音讯」。"
                        },
                        {
                            "id": "698370117",
                            "speaker": "提纳里",
                            "text": "……"
                        },
                        {
                            "id": "698370118",
                            "speaker": "Player",
                            "text": "……"
                        },
                        {
                            "id": "698370119",
                            "speaker": "提纳里",
                            "text": "赛诺，今天晚上，你必须把所有蘑菇汤都喝完。"
                        }
                    ]
                },
                {
                    "id": "698370109",
                    "text": "耳濡目染。"
                }
            ]
        }
    ]
}