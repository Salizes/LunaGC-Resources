{
    "talkId": "6981402",
    "total_dialogue_lines": 31,
    "speaker_counts": {
        "Player": 7,
        "砂糖": 12,
        "迪奥娜": 12
    },
    "dialogues": [
        {
            "id": "698140201",
            "speaker": "砂糖",
            "text": "…迪奥娜！太好了，你今天没去酒馆呀。"
        },
        {
            "id": "698140202",
            "speaker": "砂糖",
            "text": "你的父亲是外出打猎还没有回来吗？我好像没见到他。"
        },
        {
            "id": "698140203",
            "speaker": "迪奥娜",
            "text": "老爹感冒了，正在家里休养身体。别担心，他就是不小心吹到风了，我会照顾他的。"
        },
        {
            "id": "698140204",
            "speaker": "迪奥娜",
            "text": "你是为了这个来的吧？我都给你准备好了。"
        },
        {
            "id": "698140205",
            "speaker": "迪奥娜",
            "text": "嗯？等等！我听见有谁过来了。"
        },
        {
            "id": "698140206",
            "speaker": "迪奥娜",
            "text": "#什么嘛，吓我一跳，是{NICKNAME}啊。"
        },
        {
            "id": "698140207",
            "speaker": "Player",
            "text": "大调酒师胆子真小。"
        },
        {
            "id": "698140208",
            "speaker": "迪奥娜",
            "text": "你，你说谁胆子小呢！明明你上次见过我捕猎时的身手…不、不对。"
        },
        {
            "id": "698140209",
            "speaker": "迪奥娜",
            "text": "我是说，你不知道我抓到过比我个子还大的野兽！横着比我宽，竖着比我高。"
        },
        {
            "id": "698140210",
            "speaker": "迪奥娜",
            "text": "今天…今天是因为这些货品特殊，多留几个心眼！",
            "choices": [
                {
                    "id": "698140211",
                    "text": "奇怪的炼金材料吗？",
                    "response": [
                        {
                            "id": "698140213",
                            "speaker": "砂糖",
                            "text": "咳…真不好意思。实在好奇的话，你就自己看吧…"
                        },
                        {
                            "id": "698140214",
                            "speaker": "Player",
                            "text": "（不知道是狼还是狗的乳牙，禽类的碎骨，风丘丘萨满的手杖…）"
                        },
                        {
                            "id": "698140215",
                            "speaker": "Player",
                            "text": "（三根林猪的肋骨，还带着一股香料的味道。是之前捕到的猎物吗？不会是晚餐剩下的吧？）"
                        },
                        {
                            "id": "698140216",
                            "speaker": "Player",
                            "text": "可…难道手杖也算骨头吗？"
                        },
                        {
                            "id": "698140217",
                            "speaker": "砂糖",
                            "text": "这次竟然有这么多收获！谢谢你。"
                        },
                        {
                            "id": "698140218",
                            "speaker": "砂糖",
                            "text": "但我今天出门时没把四倍酸钩钩果和伍式嘟嘟莲苦味加强版装进包里…你明天会来蒙德城吗？"
                        },
                        {
                            "id": "698140219",
                            "speaker": "迪奥娜",
                            "text": "不会啦，我最近没空去调酒了，还得抽时间打猎呢。"
                        },
                        {
                            "id": "698140220",
                            "speaker": "砂糖",
                            "text": "这样啊…"
                        },
                        {
                            "id": "698140221",
                            "speaker": "砂糖",
                            "text": "那，你要不要收下这个？"
                        },
                        {
                            "id": "698140222",
                            "speaker": "砂糖",
                            "text": "是我新培育出来的富含胡萝卜素的落落莓。它的颜色、香气和营养价值都更加接近传统的胡萝卜。"
                        },
                        {
                            "id": "698140223",
                            "speaker": "砂糖",
                            "text": "我很好奇…它是会更吸引喜欢胡萝卜的小动物，还是能同时吸引两种口味偏好的动物？"
                        },
                        {
                            "id": "698140224",
                            "speaker": "迪奥娜",
                            "text": "噢…好像是个挺有意思的问题。那我可以用它做诱饵喽？"
                        },
                        {
                            "id": "698140225",
                            "speaker": "砂糖",
                            "text": "嗯，请务必告诉我实验后的结论。"
                        },
                        {
                            "id": "698140226",
                            "speaker": "迪奥娜",
                            "text": "没问题。"
                        },
                        {
                            "id": "698140227",
                            "speaker": "砂糖",
                            "text": "替我向杜拉夫先生问好，祝他早日康复。"
                        },
                        {
                            "id": "698140228",
                            "speaker": "砂糖",
                            "text": "我差不多也该回去了，拼装我的究极狂暴西风龙战士改二十三号…"
                        },
                        {
                            "id": "698140229",
                            "speaker": "迪奥娜",
                            "text": "什、什么龙？"
                        },
                        {
                            "id": "698140230",
                            "speaker": "Player",
                            "text": "迪奥娜，你学会了吗？"
                        },
                        {
                            "id": "698140231",
                            "speaker": "迪奥娜",
                            "text": "学会什么啦？根本学不会吧这种东西！"
                        }
                    ]
                },
                {
                    "id": "698140212",
                    "text": "新鲜的骨头吗？"
                }
            ]
        }
    ]
}