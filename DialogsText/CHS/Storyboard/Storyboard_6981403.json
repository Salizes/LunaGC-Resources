{
    "talkId": "6981403",
    "total_dialogue_lines": 31,
    "speaker_counts": {
        "Player": 11,
        "迪奥娜": 20
    },
    "dialogues": [
        {
            "id": "698140301",
            "speaker": "迪奥娜",
            "text": "空的…就连这个也是空的…"
        },
        {
            "id": "698140302",
            "speaker": "迪奥娜",
            "text": "怎么会这样…",
            "choices": [
                {
                    "id": "698140303",
                    "text": "你又在打猎了吗？",
                    "response": [
                        {
                            "id": "698140304",
                            "speaker": "迪奥娜",
                            "text": "是的…呜。"
                        },
                        {
                            "id": "698140306",
                            "speaker": "迪奥娜",
                            "text": "我之前在这附近布下了好多最新型机关陷阱，装着各种动物会感兴趣的食物。"
                        },
                        {
                            "id": "698140307",
                            "speaker": "迪奥娜",
                            "text": "没想到检查一圈，一只猎物都没抓到，食物也不见了…"
                        },
                        {
                            "id": "698140308",
                            "speaker": "迪奥娜",
                            "text": "买的时候说什么完美隐藏，就连放陷阱的人都有可能找不到它…我看现在倒是隐藏得比布下的时候更完美…什么都没了！"
                        },
                        {
                            "id": "698140309",
                            "speaker": "Player",
                            "text": "陷阱有被外力破坏吗？"
                        },
                        {
                            "id": "698140310",
                            "speaker": "迪奥娜",
                            "text": "没有啊。就多了点枯叶子的气味。"
                        },
                        {
                            "id": "698140311",
                            "speaker": "Player",
                            "text": "那你都放了些什么吃的？"
                        },
                        {
                            "id": "698140312",
                            "speaker": "迪奥娜",
                            "text": "我想想…禽类的胸肉、林猪的腿肉、松果、日落果…"
                        },
                        {
                            "id": "698140313",
                            "speaker": "迪奥娜",
                            "text": "砂糖之前给的胡萝卜色落落莓，调酒用剩下的蜥蜴尾巴，我自家腌制的冷肉拼盘，邻居送的进口泡泡桔…"
                        },
                        {
                            "id": "698140314",
                            "speaker": "Player",
                            "text": "（常规和不常规的诱饵都在往陷阱里放啊…）"
                        },
                        {
                            "id": "698140315",
                            "speaker": "迪奥娜",
                            "text": "…还有我用泡泡桔和薄荷试调的饮料，出门前顺手捞上的清泉镇鲈鱼，噢还有之前砂糖特地送上门的嘟嘟莲…差不多这些。",
                            "choices": [
                                {
                                    "id": "698140316",
                                    "text": "全都不见了吗？",
                                    "response": [
                                        {
                                            "id": "698140318",
                                            "speaker": "迪奥娜",
                                            "text": "是啊！全都不见了，最可气的就是这点！没想到这坏家伙的食谱那么杂，胃口还那么大，竟然把所有东西都吃干净了。"
                                        },
                                        {
                                            "id": "698140319",
                                            "speaker": "迪奥娜",
                                            "text": "噢，装饮料的碗倒是没拿走…"
                                        },
                                        {
                                            "id": "698140320",
                                            "speaker": "迪奥娜",
                                            "text": "真是个狡猾的小偷…我猜应该会是一只红狐吧？林地里面就属它们什么都吃。"
                                        },
                                        {
                                            "id": "698140321",
                                            "speaker": "迪奥娜",
                                            "text": "等等，草丛里有动静！"
                                        },
                                        {
                                            "id": "698140322",
                                            "speaker": "Player",
                                            "text": "并不是我们要找的「犯人」。"
                                        },
                                        {
                                            "id": "698140323",
                                            "speaker": "迪奥娜",
                                            "text": "哼，早知道之前就不该相信那些酒鬼大叔的鬼话。什么最省力、最方便、提瓦特各地的厉害猎手都在使用的超便捷新式陷阱…"
                                        },
                                        {
                                            "id": "698140324",
                                            "speaker": "迪奥娜",
                                            "text": "明明就是我自己用弓箭捕猎来得更快一点！",
                                            "choices": [
                                                {
                                                    "id": "698140325",
                                                    "text": "那现在怎么办？",
                                                    "response": [
                                                        {
                                                            "id": "698140327",
                                                            "speaker": "迪奥娜",
                                                            "text": "不，我才不要在这个关头放弃呢！"
                                                        },
                                                        {
                                                            "id": "698140328",
                                                            "speaker": "迪奥娜",
                                                            "text": "吃掉我那么多东西，要…要是让其他猎人们知道了，会折损我身为「凯茨莱茵家族」猎手的尊严…"
                                                        },
                                                        {
                                                            "id": "698140329",
                                                            "speaker": "Player",
                                                            "text": "原来是尊严啊…"
                                                        },
                                                        {
                                                            "id": "698140330",
                                                            "speaker": "迪奥娜",
                                                            "text": "这次，我要在诱饵里混入会让小动物身体变得酥麻的药草。"
                                                        },
                                                        {
                                                            "id": "698140331",
                                                            "speaker": "迪奥娜",
                                                            "text": "喜欢吃就吃个够好了！我就不信逮不到这只讨人厌的坏家伙！"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "698140326",
                                                    "text": "要把这些陷阱逐个回收了吗？"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "698140317",
                                    "text": "就连饮料也…"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "698140305",
                    "text": "发生什么事了？"
                }
            ]
        }
    ]
}