{
    "talkId": "6980102",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 4,
        "琴": 9,
        "诺艾尔": 4
    },
    "dialogues": [
        {
            "id": "698010201",
            "speaker": "诺艾尔",
            "text": "谢谢琴团长！我记住了！"
        },
        {
            "id": "698010202",
            "speaker": "琴",
            "text": "嗯，再来一次，我帮你纠正一下动作。",
            "choices": [
                {
                    "id": "698010203",
                    "text": "喝！",
                    "response": [
                        {
                            "id": "698010205",
                            "speaker": "诺艾尔",
                            "text": "你好呀，荣誉骑士前辈。"
                        },
                        {
                            "id": "698010206",
                            "speaker": "琴",
                            "text": "你好，荣誉骑士，有什么需要我帮忙的么？",
                            "choices": [
                                {
                                    "id": "698010207",
                                    "text": "没有没有。",
                                    "response": [
                                        {
                                            "id": "698010209",
                                            "speaker": "琴",
                                            "text": "诺艾尔很有天赋，剑术学得也很快。"
                                        },
                                        {
                                            "id": "698010210",
                                            "speaker": "琴",
                                            "text": "虽然她使用的武器和我用的…差别略大，但剑术总有相通之处，我只是稍微提醒了几点，她就已经大致明白了。"
                                        },
                                        {
                                            "id": "698010211",
                                            "speaker": "琴",
                                            "text": "剩下的就是耐下心来勤加练习了，以诺艾尔的悟性，相信用不了多久，就可以完全理解这种剑术了。"
                                        },
                                        {
                                            "id": "698010212",
                                            "speaker": "琴",
                                            "text": "就是…练习的时候，务必再小心点。如果要进行负重练习，可以在手腕上绑些重物。"
                                        },
                                        {
                                            "id": "698010213",
                                            "speaker": "琴",
                                            "text": "这样既便于拆卸，也…可以防止一些意外事故…"
                                        },
                                        {
                                            "id": "698010214",
                                            "speaker": "诺艾尔",
                                            "text": "对，对不起琴团长，我再也不会把剑甩进您办公室里了！"
                                        },
                                        {
                                            "id": "698010215",
                                            "speaker": "琴",
                                            "text": "没事，不用在意，你昨天已经打扫了那么久，房里的一切都恢复原状了。"
                                        },
                                        {
                                            "id": "698010216",
                                            "speaker": "诺艾尔",
                                            "text": "可是…那柄剑还插在您办公室的天花板上…因为天花板太高了，也不好拔下来…"
                                        },
                                        {
                                            "id": "698010217",
                                            "speaker": "琴",
                                            "text": "那个啊…就先让它待在那吧，就当做是…一种装饰也好…"
                                        }
                                    ]
                                },
                                {
                                    "id": "698010208",
                                    "text": "就是来看看诺艾尔练剑。"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "698010204",
                    "text": "风压剑！"
                }
            ]
        }
    ]
}