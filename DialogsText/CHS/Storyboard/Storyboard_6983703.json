{
    "talkId": "6983703",
    "total_dialogue_lines": 24,
    "speaker_counts": {
        "Black Screen": 1,
        "Player": 6,
        "乃亚卜": 5,
        "赛诺": 12
    },
    "dialogues": [
        {
            "id": "698370301",
            "speaker": "乃亚卜",
            "text": "…我没开玩笑，请让我和您同行吧！"
        },
        {
            "id": "698370302",
            "speaker": "乃亚卜",
            "text": "至少，也要去找几个雇佣兵一起同行。"
        },
        {
            "id": "698370303",
            "speaker": "赛诺",
            "text": "人太多了难免行动迟缓，那家伙到处流窜，想要抓住他必须快进快打，雷厉风行。"
        },
        {
            "id": "698370304",
            "speaker": "乃亚卜",
            "text": "但…"
        },
        {
            "id": "698370305",
            "speaker": "赛诺",
            "text": "到此为止。就按照原计划行动，到时候务必一击成功。"
        },
        {
            "id": "698370306",
            "speaker": "乃亚卜",
            "text": "……"
        },
        {
            "id": "698370307",
            "speaker": "乃亚卜",
            "text": "是，大风纪官。"
        },
        {
            "id": "698370324",
            "speaker": "Black Screen",
            "text": "乃亚卜快步离开了。"
        },
        {
            "id": "698370308",
            "speaker": "Player",
            "text": "遇见麻烦了？"
        },
        {
            "id": "698370309",
            "speaker": "赛诺",
            "text": "小事。一个学者带着他造出的违禁器械逃离了教令院，我们风纪官正在追捕他。"
        },
        {
            "id": "698370310",
            "speaker": "赛诺",
            "text": "为了不引起城里居民们的恐慌，我们决定暗中行事。"
        },
        {
            "id": "698370311",
            "speaker": "Player",
            "text": "听刚才的话，你要一个人出击？"
        },
        {
            "id": "698370312",
            "speaker": "赛诺",
            "text": "是，计划已经制订完毕。其他风纪官会在预定地点设置陷阱，我则会单独出动，把他驱赶到预定位置。"
        },
        {
            "id": "698370313",
            "speaker": "赛诺",
            "text": "犯人很狡猾，已经骗过了好几位出去追捕的风纪官，并且…还有风纪官受了不轻的伤。"
        },
        {
            "id": "698370314",
            "speaker": "赛诺",
            "text": "但这一次，他再也逃不过了。",
            "choices": [
                {
                    "id": "698370315",
                    "text": "我相信赛诺。",
                    "response": [
                        {
                            "id": "698370317",
                            "speaker": "赛诺",
                            "text": "嗯。放心吧，只是去恐吓一只胆小的鬣狗，再让它自己跌进陷阱里去。"
                        },
                        {
                            "id": "698370318",
                            "speaker": "赛诺",
                            "text": "如果胆敢亮出爪牙，那…黄沙将会是它的归宿。"
                        },
                        {
                            "id": "698370319",
                            "speaker": "赛诺",
                            "text": "…放心。我处理过很多起这样的事件了，不会有意外的。",
                            "choices": [
                                {
                                    "id": "698370320",
                                    "text": "赛诺居然没讲冷笑话…",
                                    "response": [
                                        {
                                            "id": "698370322",
                                            "speaker": "赛诺",
                                            "text": "抱歉，暂时没找到灵感。"
                                        },
                                        {
                                            "id": "698370323",
                                            "speaker": "赛诺",
                                            "text": "等我回来之后，再给你讲一个最好玩的笑话。"
                                        }
                                    ]
                                },
                                {
                                    "id": "698370321",
                                    "text": "怎么还有点不习惯…"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "698370316",
                    "text": "我相信大风纪官。"
                }
            ]
        }
    ]
}