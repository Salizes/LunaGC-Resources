{
    "talkId": "6987601",
    "total_dialogue_lines": 43,
    "speaker_counts": {
        "Player": 10,
        "卡齐娜": 11,
        "基尼奇": 10,
        "玛拉妮": 4,
        "阿乔": 8
    },
    "dialogues": [
        {
            "id": "698760101",
            "speaker": "卡齐娜",
            "text": "首先要保持微笑，等客人来的时候，要打招呼…"
        },
        {
            "id": "698760102",
            "speaker": "卡齐娜",
            "text": "根据客人不同的需求，介绍款式和颜色…"
        },
        {
            "id": "698760103",
            "speaker": "卡齐娜",
            "text": "呼…全都记住了。这样就可以了吧…应、应该可以的吧？"
        },
        {
            "id": "698760104",
            "speaker": "卡齐娜",
            "text": "唔唔…玛拉妮那么相信我，绝对不可以搞砸呀。加油！卡齐娜！一定可以的！"
        },
        {
            "id": "698760105",
            "speaker": "Player",
            "text": "你好呀，卡齐娜。"
        },
        {
            "id": "698760106",
            "speaker": "卡齐娜",
            "text": "啊！欢、欢迎光临「悠游豚豚」水上用品商店…欸！师父！"
        },
        {
            "id": "698760107",
            "speaker": "Player",
            "text": "怎么是卡齐娜在看店？"
        },
        {
            "id": "698760108",
            "speaker": "卡齐娜",
            "text": "嘿嘿，玛拉妮这几天当向导去带队啦。她今天已经出发去做准备工作了。"
        },
        {
            "id": "698760109",
            "speaker": "卡齐娜",
            "text": "所以店铺就没人看管了，她本来是说暂时关门一段时间也没问题。"
        },
        {
            "id": "698760110",
            "speaker": "卡齐娜",
            "text": "不过我刚刚好有空，就想着为朋友做点什么，加上说不定以后我能开一家蛋糕店呢，提前积累点经验也好。",
            "choices": [
                {
                    "id": "698760111",
                    "text": "刚刚卡齐娜反应很快，说得也很好。",
                    "response": [
                        {
                            "id": "698760113",
                            "speaker": "卡齐娜",
                            "text": "…呜…谢谢师父鼓励我。玛拉妮之前也说过差不多的话，我、我一定能行的！",
                            "choices": [
                                {
                                    "id": "698760114",
                                    "text": "那我就不影响卡齐娜看店啦。",
                                    "response": [
                                        {
                                            "id": "698760116",
                                            "speaker": "卡齐娜",
                                            "text": "好呀好呀，待会见哦！"
                                        },
                                        {
                                            "id": "698760117",
                                            "speaker": "基尼奇",
                                            "text": "……"
                                        },
                                        {
                                            "id": "698760118",
                                            "speaker": "阿乔",
                                            "text": "…呼哈，好喝。喂，基尼奇，你闲着也是闲着，还不快给伟大圣龙库胡勒阿乔再倒些青蜜莓汁？"
                                        },
                                        {
                                            "id": "698760119",
                                            "speaker": "基尼奇",
                                            "text": "没空。"
                                        },
                                        {
                                            "id": "698760120",
                                            "speaker": "阿乔",
                                            "text": "你胡说！你明明什么都没做啊！卡齐娜？她那边又没什么问题…服侍我喝青蜜莓汁要紧。"
                                        },
                                        {
                                            "id": "698760121",
                                            "speaker": "基尼奇",
                                            "text": "没了。"
                                        },
                                        {
                                            "id": "698760122",
                                            "speaker": "阿乔",
                                            "text": "胡说！怎么会那么快！我还没喝几口，不是有一大瓶吗？说，是不是你偷喝了？"
                                        },
                                        {
                                            "id": "698760123",
                                            "speaker": "基尼奇",
                                            "text": "没必要。"
                                        },
                                        {
                                            "id": "698760124",
                                            "speaker": "阿乔",
                                            "text": "胡…嘁，算你硬气。那你就快点去找玛拉妮那个小丫头，让她再给伟大圣龙进贡三大瓶青蜜莓汁！"
                                        },
                                        {
                                            "id": "698760125",
                                            "speaker": "阿乔",
                                            "text": "就凭这些，还不够我润嘴唇的…"
                                        },
                                        {
                                            "id": "698760126",
                                            "speaker": "基尼奇",
                                            "text": "跟我去打招呼。"
                                        },
                                        {
                                            "id": "698760127",
                                            "speaker": "基尼奇",
                                            "text": "#又见面了，{NICKNAME}。",
                                            "choices": [
                                                {
                                                    "id": "698760128",
                                                    "text": "基尼奇和阿乔？",
                                                    "response": [
                                                        {
                                                            "id": "698760130",
                                                            "speaker": "基尼奇",
                                                            "text": "嗯，是玛拉妮的委托，在她不在的时间里，托我照看一下独自看店的卡齐娜。"
                                                        },
                                                        {
                                                            "id": "698760131",
                                                            "speaker": "阿乔",
                                                            "text": "还有我！自私鬼基尼奇，你不要当我不存在，更不要漏掉我的功绩！"
                                                        },
                                                        {
                                                            "id": "698760132",
                                                            "speaker": "基尼奇",
                                                            "text": "那我分享一下。阿乔的功绩是在委托完成前消耗了全部预缴报酬。"
                                                        },
                                                        {
                                                            "id": "698760133",
                                                            "speaker": "Player",
                                                            "text": "哇噢。"
                                                        },
                                                        {
                                                            "id": "698760134",
                                                            "speaker": "阿乔",
                                                            "text": "基尼奇，你！你活腻了！"
                                                        },
                                                        {
                                                            "id": "698760135",
                                                            "speaker": "基尼奇",
                                                            "text": "…看样子已经结束了。那么我差不多也应该…"
                                                        },
                                                        {
                                                            "id": "698760136",
                                                            "speaker": "玛拉妮",
                                                            "text": "欸——！来都来了嘛，怎么急着走？还好我有点担心这边，所以加速了准备工作，提前回来了。"
                                                        },
                                                        {
                                                            "id": "698760137",
                                                            "speaker": "玛拉妮",
                                                            "text": "#既然刚好碰上了，不如一起去聚餐吧！就当庆祝我们的好朋友卡齐娜第一次独立看店圆满结束！{NICKNAME}也一起吧！"
                                                        },
                                                        {
                                                            "id": "698760138",
                                                            "speaker": "玛拉妮",
                                                            "text": "你看，卡齐娜看到我们了！而且，聚餐还有更多的加冰青蜜莓汁，我请客哦！"
                                                        },
                                                        {
                                                            "id": "698760139",
                                                            "speaker": "阿乔",
                                                            "text": "咳咳，那我库胡勒阿乔也屈尊答应这番邀请了。"
                                                        },
                                                        {
                                                            "id": "698760140",
                                                            "speaker": "Player",
                                                            "text": "看来又会很热闹了。"
                                                        },
                                                        {
                                                            "id": "698760141",
                                                            "speaker": "基尼奇",
                                                            "text": "…走吧。"
                                                        },
                                                        {
                                                            "id": "698760142",
                                                            "speaker": "玛拉妮",
                                                            "text": "好耶！卡齐娜，这边这边~"
                                                        },
                                                        {
                                                            "id": "698760143",
                                                            "speaker": "卡齐娜",
                                                            "text": "来啦，玛拉妮！"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "698760129",
                                                    "text": "你们是在这里看卡齐娜吗？"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "698760115",
                                    "text": "等卡齐娜下班了我们再见吧。"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "698760112",
                    "text": "我也相信卡齐娜！"
                }
            ]
        }
    ]
}