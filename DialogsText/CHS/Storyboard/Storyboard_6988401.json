{
    "talkId": "6988401",
    "total_dialogue_lines": 27,
    "speaker_counts": {
        "Player": 7,
        "塔利雅": 6,
        "派蒙": 3,
        "芭芭拉": 11
    },
    "dialogues": [
        {
            "id": "698840101",
            "speaker": "塔利雅",
            "text": "…所以，你那首新颂歌的灵感，就来自于那位纳塔客人？"
        },
        {
            "id": "698840102",
            "speaker": "芭芭拉",
            "text": "当时我正在城外练习呢，刚唱完一段高音，就看见一条毛茸茸的尾巴从树上耷拉了下来…"
        },
        {
            "id": "698840103",
            "speaker": "芭芭拉",
            "text": "我吓了一跳，还以为遇见野兽了，仔细一看，原来是那位纳塔来的希诺宁小姐。",
            "choices": [
                {
                    "id": "698840104",
                    "text": "芭芭拉也遇见希诺宁了？",
                    "response": [
                        {
                            "id": "698840106",
                            "speaker": "派蒙",
                            "text": "希诺宁之前不是在图书馆睡午觉吗？怎么又跑树上了…咦，我为什么要说又…"
                        },
                        {
                            "id": "698840107",
                            "speaker": "芭芭拉",
                            "text": "这个啊，希诺宁小姐说在图书馆睡觉会打扰到其他人，所以她还是想挑一个僻静的地方休息…结果，没想到还是被我打扰了。"
                        },
                        {
                            "id": "698840108",
                            "speaker": "塔利雅",
                            "text": "放心吧，芭芭拉小姐，无论在任何情况下，你的歌声都不能被称作「打扰」。不然，她怎么会愿意帮你调整那首风神颂歌的节奏呢？"
                        },
                        {
                            "id": "698840109",
                            "speaker": "芭芭拉",
                            "text": "嗯！她真的很好心，明明还在打哈欠呢，但还是很认真地给了我好多建议。"
                        },
                        {
                            "id": "698840110",
                            "speaker": "芭芭拉",
                            "text": "可惜…蒙德城没有希诺宁小姐所说的「热舞乐台」，我没办法亲手试试那种乐器。",
                            "choices": [
                                {
                                    "id": "698840111",
                                    "text": "下次我们一起去纳塔。",
                                    "response": [
                                        {
                                            "id": "698840113",
                                            "speaker": "芭芭拉",
                                            "text": "真的？那就太好啦，我还没怎么去过其他国家旅行呢…"
                                        },
                                        {
                                            "id": "698840114",
                                            "speaker": "芭芭拉",
                                            "text": "但在那之前，我一定要把这首新的风神颂歌写好，不仅是希诺宁小姐，还有那位叫做温迪的诗人也给了我好多建议。"
                                        },
                                        {
                                            "id": "698840115",
                                            "speaker": "芭芭拉",
                                            "text": "#{NICKNAME}，派蒙，还有塔利雅，到时候你们一定要来听我唱歌啊。"
                                        },
                                        {
                                            "id": "698840116",
                                            "speaker": "芭芭拉",
                                            "text": "…还有温迪，如果他能少喝点的话，也可以来的。"
                                        },
                                        {
                                            "id": "698840117",
                                            "speaker": "塔利雅",
                                            "text": "没问题，芭芭拉小姐。比起那些普通的美酒，温迪肯定更喜欢你的颂歌。"
                                        },
                                        {
                                            "id": "698840118",
                                            "speaker": "芭芭拉",
                                            "text": "可我平时见到他的时候，他几乎酒不离手。唉，风神保佑他，明明他那么擅长唱歌和写诗，如果能把精力用在正道上…"
                                        },
                                        {
                                            "id": "698840119",
                                            "speaker": "塔利雅",
                                            "text": "依我看，风神已经保佑他了，毕竟他可是我的朋友里最自由的人啊。"
                                        },
                                        {
                                            "id": "698840120",
                                            "speaker": "塔利雅",
                                            "text": "噢。我该进去告解了，容我先告辞。",
                                            "choices": [
                                                {
                                                    "id": "698840121",
                                                    "text": "告解？",
                                                    "response": [
                                                        {
                                                            "id": "698840123",
                                                            "speaker": "塔利雅",
                                                            "text": "毕竟西蒙枢机卿终于回到教堂了啊，能找他告解的机会可不多，我可不能错过。"
                                                        },
                                                        {
                                                            "id": "698840124",
                                                            "speaker": "派蒙",
                                                            "text": "西蒙枢机卿…啊！我听法尔伽说过，是那位跟着法尔伽去挪德卡莱远征的「拂晓的枢机卿」吧？"
                                                        },
                                                        {
                                                            "id": "698840125",
                                                            "speaker": "派蒙",
                                                            "text": "虽然之前就听说，远征的骑士团准备回蒙德城了，但没想到居然回来得这么快。"
                                                        },
                                                        {
                                                            "id": "698840126",
                                                            "speaker": "Player",
                                                            "text": "但我记得这位枢机卿同时也是…"
                                                        },
                                                        {
                                                            "id": "698840127",
                                                            "speaker": "芭芭拉",
                                                            "text": "…没错，是我和姐姐的父亲。"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "698840122",
                                                    "text": "怎么突然…"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "698840112",
                                    "text": "让你亲手试试「热舞乐台」。"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "698840105",
                    "text": "应该是城外午睡吧…"
                }
            ]
        }
    ]
}