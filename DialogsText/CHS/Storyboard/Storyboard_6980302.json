{
    "talkId": "6980302",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Player": 7,
        "钟离": 8
    },
    "dialogues": [
        {
            "id": "698030201",
            "speaker": "钟离",
            "text": "这应该是堂主要的那本…"
        },
        {
            "id": "698030202",
            "speaker": "Player",
            "text": "钟离，你在看什么呢？"
        },
        {
            "id": "698030203",
            "speaker": "钟离",
            "text": "#{NICKNAME}，幸会。我是受堂主的托付，出来帮她买几本书。",
            "choices": [
                {
                    "id": "698030204",
                    "text": "《拜托了我的狐仙宫司》…",
                    "response": [
                        {
                            "id": "698030207",
                            "speaker": "钟离",
                            "text": "这只是一部分，还有一些尚未摆在这里贩卖的，我已经托店主去购置了。"
                        },
                        {
                            "id": "698030208",
                            "speaker": "Player",
                            "text": "钟离，你看了这些书么？"
                        },
                        {
                            "id": "698030209",
                            "speaker": "钟离",
                            "text": "之前没读过，在堂主的催促下，最近才拜读了好几本。读完之后，倒也觉得有几分趣味。"
                        },
                        {
                            "id": "698030210",
                            "speaker": "钟离",
                            "text": "稻妻的话本，果然与璃月的文风大相径庭。唔…但人各有所爱，倒也分不得高下贵贱。",
                            "choices": [
                                {
                                    "id": "698030211",
                                    "text": "不是不是，我的意思是…",
                                    "response": [
                                        {
                                            "id": "698030213",
                                            "speaker": "钟离",
                                            "text": "怎么了？这书里对雷电将军的武艺描绘十分生动。"
                                        },
                                        {
                                            "id": "698030214",
                                            "speaker": "钟离",
                                            "text": "特别是书中人物对「无想的一刀」的探讨追寻，也很有趣…"
                                        },
                                        {
                                            "id": "698030215",
                                            "speaker": "钟离",
                                            "text": "#唔，天色不早了。{NICKNAME}，我还要把书送去给堂主，我们就此别过，回头再见吧。"
                                        }
                                    ]
                                },
                                {
                                    "id": "698030212",
                                    "text": "那个，转生为雷电将军…"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "698030205",
                    "text": "《转生成为雷电将军…》…"
                },
                {
                    "id": "698030206",
                    "text": "《异邦人喧哗旅…》…"
                }
            ]
        }
    ]
}