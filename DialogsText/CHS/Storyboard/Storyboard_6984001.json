{
    "talkId": "6984001",
    "total_dialogue_lines": 20,
    "speaker_counts": {
        "Black Screen": 1,
        "Player": 6,
        "琳妮特": 13
    },
    "dialogues": [
        {
            "id": "698400101",
            "speaker": "琳妮特",
            "text": "…接下来是，往左拧两圈。"
        },
        {
            "id": "698400102",
            "speaker": "Black Screen",
            "text": "（机器发出了一阵不满的轰鸣，上面的指示灯恼火地明灭不定，但最后，还是认输一般地全部熄灭了。这台机器彻底停机了…）"
        },
        {
            "id": "698400103",
            "speaker": "琳妮特",
            "text": "好，坏掉了。"
        },
        {
            "id": "698400104",
            "speaker": "Player",
            "text": "哪里好了啊！"
        },
        {
            "id": "698400105",
            "speaker": "琳妮特",
            "text": "你好。",
            "choices": [
                {
                    "id": "698400106",
                    "text": "啊…欸？你、你好…",
                    "response": [
                        {
                            "id": "698400108",
                            "speaker": "琳妮特",
                            "text": "我正在帮灰河的大家解决麻烦。"
                        },
                        {
                            "id": "698400109",
                            "speaker": "琳妮特",
                            "text": "最近灰河里收到了几台废弃的机械，本来大家打算和之前一样，把它拆成零件之后卖掉换钱。"
                        },
                        {
                            "id": "698400110",
                            "speaker": "琳妮特",
                            "text": "但这台机器不知道为什么，总是无法正常停机。而且总是会在半夜莫名其妙地突然启动。"
                        },
                        {
                            "id": "698400111",
                            "speaker": "琳妮特",
                            "text": "机器们嘎吱嘎吱地乱跑，把好几个半夜出门或回家的人吓得半死，还有人被吓得摔进水里，淹了个半死。"
                        },
                        {
                            "id": "698400112",
                            "speaker": "琳妮特",
                            "text": "哥哥刚好来这边做魔术表演，就答应帮忙想想办法。"
                        },
                        {
                            "id": "698400113",
                            "speaker": "Player",
                            "text": "总觉得应该是菲米尼出现在这里…"
                        },
                        {
                            "id": "698400114",
                            "speaker": "琳妮特",
                            "text": "但他只会把机器修好，不知道怎么修坏。"
                        },
                        {
                            "id": "698400115",
                            "speaker": "琳妮特",
                            "text": "我可以。",
                            "choices": [
                                {
                                    "id": "698400116",
                                    "text": "别这么自豪地说出这种话啊！",
                                    "response": [
                                        {
                                            "id": "698400118",
                                            "speaker": "琳妮特",
                                            "text": "总之，哥哥拜托我过来帮忙了，等会他会买蛋糕回来。一台机器，一份蛋糕。"
                                        },
                                        {
                                            "id": "698400119",
                                            "speaker": "琳妮特",
                                            "text": "嗯，接下来还要再修理三台，我要先去忙了。"
                                        },
                                        {
                                            "id": "698400120",
                                            "speaker": "琳妮特",
                                            "text": "下一台的奖励蛋糕是树莓…嗯，树莓果酱夹心，浇酸糖酱，手指饼干衬底…还有薄荷巧克力装饰。"
                                        }
                                    ]
                                },
                                {
                                    "id": "698400117",
                                    "text": "「修坏」这个词不对吧我说…"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "698400107",
                    "text": "你这是在…"
                }
            ]
        }
    ]
}