{
    "talkId": "6985712",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 8,
        "克洛琳德": 7,
        "娜维娅": 1,
        "雅珂达": 1
    },
    "dialogues": [
        {
            "id": "698571201",
            "speaker": "克洛琳德",
            "text": "#如果{NICKNAME}同意的话…但是，看来{NICKNAME}还没弄清状况。"
        },
        {
            "id": "698571202",
            "speaker": "克洛琳德",
            "text": "简而言之，我们正在玩「桌上剧团」的剧本，在这个剧本里，每个人都会扮演一个角色。"
        },
        {
            "id": "698571203",
            "speaker": "克洛琳德",
            "text": "比如…娜维娅是「逐影猎人」，雅珂达是「炼气士」，而叶洛亚则是「纯水骑士」…"
        },
        {
            "id": "698571204",
            "speaker": "娜维娅",
            "text": "哎呀，游戏规则很简单的，总之先一起玩吧，玩着玩着就熟悉了！"
        },
        {
            "id": "698571205",
            "speaker": "雅珂达",
            "text": "再拖一会，我们就要被炸药全部炸飞了啊——"
        },
        {
            "id": "698571206",
            "speaker": "Player",
            "text": "愿、愿意！"
        },
        {
            "id": "698571207",
            "speaker": "Player",
            "text": "我加入，我加入——"
        },
        {
            "id": "698571208",
            "speaker": "克洛琳德",
            "text": "嗯。那么…出于多方考虑，这次游戏的难度就设为「轻松体验」好了。"
        },
        {
            "id": "698571209",
            "speaker": "克洛琳德",
            "text": "#{NICKNAME}，你先为你所扮演的角色选择一下「技能」吧。",
            "choices": [
                {
                    "id": "698571210",
                    "text": "做个厨师吧…",
                    "response": [
                        {
                            "id": "698571211",
                            "speaker": "克洛琳德",
                            "text": "可以，你确定想要学习的技能是「厨艺」，对吧？",
                            "choices": [
                                {
                                    "id": "698571214",
                                    "text": "确定。"
                                },
                                {
                                    "id": "698571215",
                                    "text": "我再想想…"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "698571212",
                    "text": "做个医生吧…",
                    "response": [
                        {
                            "id": "698571213",
                            "speaker": "克洛琳德",
                            "text": "可以，你确定想要学习的技能是「医术」，对吧？",
                            "choices": [
                                {
                                    "id": "698571214",
                                    "text": "确定。"
                                },
                                {
                                    "id": "698571215",
                                    "text": "我再想想…"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}