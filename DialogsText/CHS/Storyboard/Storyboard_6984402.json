{
    "talkId": "6984402",
    "total_dialogue_lines": 27,
    "speaker_counts": {
        "Player": 8,
        "绮良良": 9,
        "重云": 8,
        "香菱": 2
    },
    "dialogues": [
        {
            "id": "698440201",
            "speaker": "绮良良",
            "text": "吃饱了吃饱了，这次我的舌头既没有被烫到也没有被辣到，谢谢啦重云小哥。"
        },
        {
            "id": "698440202",
            "speaker": "重云",
            "text": "小姐客气了，香菱这厨房里什么都有，我做这一碗面不费事的。"
        },
        {
            "id": "698440203",
            "speaker": "香菱",
            "text": "怎么样？我没骗你吧，我就说我认识一个朋友，会做出好吃的凉菜。",
            "choices": [
                {
                    "id": "698440204",
                    "text": "咦？重云也在？",
                    "response": [
                        {
                            "id": "698440206",
                            "speaker": "香菱",
                            "text": "对啦，重云的拿手菜不就是又凉又好吃的「山珍凉卤面」吗？用它来款待绮良良最合适不过啦。"
                        },
                        {
                            "id": "698440207",
                            "speaker": "重云",
                            "text": "我也是正巧路过，香菱拉着我说有急事拜托，我就跟她进来…做了一碗面和几盘小菜给绮良良小姐。",
                            "choices": [
                                {
                                    "id": "698440208",
                                    "text": "这么一说，重云的体质…",
                                    "response": [
                                        {
                                            "id": "698440210",
                                            "speaker": "重云",
                                            "text": "是啊，正巧了。所以我就按照我的食谱，给绮良良小姐做了一顿简餐。还好，看起来还算合绮良良小姐的口味。"
                                        },
                                        {
                                            "id": "698440211",
                                            "speaker": "绮良良",
                                            "text": "重云小哥，我都说了不用这么客气啦，你再这么客气，我就不带你找五百藏大哥和一斗大哥了。",
                                            "choices": [
                                                {
                                                    "id": "698440212",
                                                    "text": "找五百藏和一斗？",
                                                    "response": [
                                                        {
                                                            "id": "698440214",
                                                            "speaker": "绮良良",
                                                            "text": "重云小哥不是说，他一直想要见到鬼怪，但却一直见不到么？"
                                                        },
                                                        {
                                                            "id": "698440215",
                                                            "speaker": "绮良良",
                                                            "text": "一斗大哥是正经的鬼族，五百藏大哥是正经的大妖怪…我正好可以带他去见一见啊。"
                                                        },
                                                        {
                                                            "id": "698440216",
                                                            "speaker": "重云",
                                                            "text": "大、大妖？！这…绮良良小姐，这稻妻的妖鬼具体是怎样的？平日里可曾用法术危及人命？"
                                                        },
                                                        {
                                                            "id": "698440217",
                                                            "speaker": "重云",
                                                            "text": "若是那妖鬼凶狠异常，我还可以向沉玉谷蓝氏的蓝砚姑娘请援，她有家传的奇门方术，定能降住妖邪！"
                                                        },
                                                        {
                                                            "id": "698440218",
                                                            "speaker": "重云",
                                                            "text": "对了，还有我的好友行秋，他剑术高超，有一副侠义心肠，一定愿意助我！",
                                                            "choices": [
                                                                {
                                                                    "id": "698440219",
                                                                    "text": "重云啊，那个，你先冷静…",
                                                                    "response": [
                                                                        {
                                                                            "id": "698440221",
                                                                            "speaker": "绮良良",
                                                                            "text": "哎呀，重云小哥，你误会啦。五百藏大哥和一斗大哥都是好人…不对，好妖怪。"
                                                                        },
                                                                        {
                                                                            "id": "698440222",
                                                                            "speaker": "绮良良",
                                                                            "text": "一斗大哥做过最坏最坏最坏的事，也就是打牌输了不认，到现在还欠我一串三彩团子呢。"
                                                                        },
                                                                        {
                                                                            "id": "698440223",
                                                                            "speaker": "绮良良",
                                                                            "text": "五百藏大哥也很好的，就是…每次我路过镇守之森的时候，都要被他拉着玩捉迷藏…"
                                                                        },
                                                                        {
                                                                            "id": "698440224",
                                                                            "speaker": "重云",
                                                                            "text": "欸？这…这和我在书上看见的不一样…"
                                                                        },
                                                                        {
                                                                            "id": "698440225",
                                                                            "speaker": "绮良良",
                                                                            "text": "嘻嘻，书上的怎么能当真？书上还说，你们璃月每个人都会踩着剑呼呼地在天上飞呢。"
                                                                        },
                                                                        {
                                                                            "id": "698440226",
                                                                            "speaker": "绮良良",
                                                                            "text": "好啦，过几天你就和我搭一班船走吧，我带你见见他们，还有我奶奶。"
                                                                        },
                                                                        {
                                                                            "id": "698440227",
                                                                            "speaker": "重云",
                                                                            "text": "好，我这就回去做准备。对了，要把我记录妖鬼的小册子带上…"
                                                                        }
                                                                    ]
                                                                },
                                                                {
                                                                    "id": "698440220",
                                                                    "text": "这两位不是你想象的「鬼」…"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "698440213",
                                                    "text": "找他们做什么？"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "698440209",
                                    "text": "也不能吃热辣的食物呢。"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "698440205",
                    "text": "做凉菜…喔！难道是…"
                }
            ]
        }
    ]
}