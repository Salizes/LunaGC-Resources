{
    "talkId": "6984502",
    "total_dialogue_lines": 38,
    "speaker_counts": {
        "Player": 8,
        "塞德娜": 10,
        "那维莱特": 20
    },
    "dialogues": [
        {
            "id": "698450201",
            "speaker": "那维莱特",
            "text": "所以你的推荐是，千织屋的当季童装？"
        },
        {
            "id": "698450202",
            "speaker": "塞德娜",
            "text": "是的那维莱特大人。"
        },
        {
            "id": "698450203",
            "speaker": "塞德娜",
            "text": "千织屋的爱洛芙姐姐经常请基娅拉去试穿童装样衣，还拍了很多画片，每一套都很可爱呢。"
        },
        {
            "id": "698450204",
            "speaker": "那维莱特",
            "text": "既然这样，我去订购一批。"
        },
        {
            "id": "698450205",
            "speaker": "Player",
            "text": "打扰咯。"
        },
        {
            "id": "698450206",
            "speaker": "那维莱特",
            "text": "#{NICKNAME}，你好。"
        },
        {
            "id": "698450207",
            "speaker": "塞德娜",
            "text": "你好呀！"
        },
        {
            "id": "698450208",
            "speaker": "塞德娜",
            "text": "来得正好。那维莱特大人的日程有了新的安排，我们正在商量带什么礼物呢。",
            "choices": [
                {
                    "id": "698450209",
                    "text": "新的安排？",
                    "response": [
                        {
                            "id": "698450211",
                            "speaker": "那维莱特",
                            "text": "我正打算利用难得的休假去海沫村探望美露莘们。"
                        },
                        {
                            "id": "698450212",
                            "speaker": "那维莱特",
                            "text": "有段时日没去拜访，为了难得的会面，我想准备些礼物。"
                        },
                        {
                            "id": "698450213",
                            "speaker": "那维莱特",
                            "text": "#{NICKNAME}，正好你在，能否请你也给些建议？"
                        },
                        {
                            "id": "698450214",
                            "speaker": "那维莱特",
                            "text": "听说你与很多美露莘熟识，你的想法会成为珍贵的参考。"
                        },
                        {
                            "id": "698450215",
                            "speaker": "Player",
                            "text": "有喜欢画画的美露莘朋友。"
                        },
                        {
                            "id": "698450216",
                            "speaker": "塞德娜",
                            "text": "对对！我记得，瑟琳寄来的信也有提过，玛梅赫一直很喜欢画画。"
                        },
                        {
                            "id": "698450217",
                            "speaker": "那维莱特",
                            "text": "的确。考虑到她们日常出入的环境，应当准备些防水的油彩。"
                        },
                        {
                            "id": "698450218",
                            "speaker": "Player",
                            "text": "好像没有不喜欢零件的美露莘。"
                        },
                        {
                            "id": "698450219",
                            "speaker": "塞德娜",
                            "text": "对的对的。这个我可以帮忙挑选，发条工坊经常会有打折出售的机关零件，还有发条玩具。"
                        },
                        {
                            "id": "698450220",
                            "speaker": "那维莱特",
                            "text": "嗯，那这部分的采购就辛苦你了。"
                        },
                        {
                            "id": "698450221",
                            "speaker": "那维莱特",
                            "text": "挑喜欢的就好，不必在意价格，我会多备些摩拉。"
                        },
                        {
                            "id": "698450222",
                            "speaker": "Player",
                            "text": "做些美食总归不会出错。"
                        },
                        {
                            "id": "698450223",
                            "speaker": "那维莱特",
                            "text": "这个…论厨艺的话，我可能只擅长做汤…"
                        },
                        {
                            "id": "698450224",
                            "speaker": "那维莱特",
                            "text": "塞德娜，最近美露莘们有什么特别想吃的东西吗？"
                        },
                        {
                            "id": "698450225",
                            "speaker": "塞德娜",
                            "text": "我想想…嗯…蛋糕，马卡龙，膨膨泡芙，果果软糖…"
                        },
                        {
                            "id": "698450226",
                            "speaker": "塞德娜",
                            "text": "还有小零食圈圈圆圆，和枫达饮料！"
                        },
                        {
                            "id": "698450227",
                            "speaker": "那维莱特",
                            "text": "……",
                            "choices": [
                                {
                                    "id": "698450228",
                                    "text": "偶尔吃吃这些也没关系啦。",
                                    "response": [
                                        {
                                            "id": "698450230",
                                            "speaker": "那维莱特",
                                            "text": "我明白的。"
                                        },
                                        {
                                            "id": "698450231",
                                            "speaker": "那维莱特",
                                            "text": "大家的口味各不相同，为了公平公正，本应准备更多的种类才是。"
                                        },
                                        {
                                            "id": "698450232",
                                            "speaker": "那维莱特",
                                            "text": "那便这样吧。前面提到的这些礼品，都会一一备齐。"
                                        },
                                        {
                                            "id": "698450233",
                                            "speaker": "那维莱特",
                                            "text": "感谢两位的建议，等采购完成后我会请人分装打包好，分别送出。"
                                        },
                                        {
                                            "id": "698450234",
                                            "speaker": "那维莱特",
                                            "text": "塞德娜的签收地址，依旧填在沫芒宫吧。"
                                        },
                                        {
                                            "id": "698450235",
                                            "speaker": "塞德娜",
                                            "text": "欸？我也有吗？不是给海沫村朋友们的礼物吗？"
                                        },
                                        {
                                            "id": "698450236",
                                            "speaker": "那维莱特",
                                            "text": "当然。机会难得，所有美露莘都有份。"
                                        },
                                        {
                                            "id": "698450237",
                                            "speaker": "那维莱特",
                                            "text": "你也是美露莘，不是吗？"
                                        },
                                        {
                                            "id": "698450238",
                                            "speaker": "塞德娜",
                                            "text": "嗯！谢谢那维莱特大人！"
                                        }
                                    ]
                                },
                                {
                                    "id": "698450229",
                                    "text": "她们开心就好，开心就好…"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "698450210",
                    "text": "什么礼物？"
                }
            ]
        }
    ]
}