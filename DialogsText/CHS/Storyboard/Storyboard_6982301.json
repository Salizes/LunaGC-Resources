{
    "talkId": "6982301",
    "total_dialogue_lines": 36,
    "speaker_counts": {
        "Player": 10,
        "派蒙": 7,
        "胡桃": 8,
        "艾梅莉埃": 3,
        "香菱": 8
    },
    "dialogues": [
        {
            "id": "698230101",
            "speaker": "派蒙",
            "text": "怪了，万民堂好像没开锅啊，怎么这么大一股水煮鱼的味…",
            "choices": [
                {
                    "id": "698230102",
                    "text": "派蒙肚子又饿了？",
                    "response": [
                        {
                            "id": "698230104",
                            "speaker": "派蒙",
                            "text": "才没有啦！你仔细闻闻，真的有一股很奇怪的水煮鱼味，但我又说不上哪里怪…",
                            "choices": [
                                {
                                    "id": "698230105",
                                    "text": "咦？那边的人是…",
                                    "response": [
                                        {
                                            "id": "698230107",
                                            "speaker": "胡桃",
                                            "text": "…真的是水煮鱼味的香水！香菱，你也来闻闻，是不是这个味道？"
                                        },
                                        {
                                            "id": "698230108",
                                            "speaker": "香菱",
                                            "text": "嗯…哇！真的，连辣椒的香味都还原了，这到底是怎么做到的…"
                                        },
                                        {
                                            "id": "698230109",
                                            "speaker": "艾梅莉埃",
                                            "text": "一些不同于常理的香料组合，特殊的香料研磨技术…最重要的是，一位专业厨师的协助。"
                                        },
                                        {
                                            "id": "698230110",
                                            "speaker": "香菱",
                                            "text": "嘿嘿，毕竟我们店里每天都有好多人吃水煮鱼，我对这种味道可熟悉了。"
                                        },
                                        {
                                            "id": "698230111",
                                            "speaker": "香菱",
                                            "text": "就算那股水煮鱼的香味不是来自于锅里，而是来自于香水瓶里，我也绝对不会闻错！"
                                        },
                                        {
                                            "id": "698230112",
                                            "speaker": "Player",
                                            "text": "果然是艾梅莉埃…"
                                        },
                                        {
                                            "id": "698230113",
                                            "speaker": "香菱",
                                            "text": "#{NICKNAME}？你来得正好，来来来，你也来闻闻我的手腕。"
                                        },
                                        {
                                            "id": "698230114",
                                            "speaker": "香菱",
                                            "text": "艾梅莉埃姐姐刚帮我们做了一份水煮鱼味的香水，可好玩了！"
                                        },
                                        {
                                            "id": "698230115",
                                            "speaker": "Player",
                                            "text": "这、这味道是…"
                                        },
                                        {
                                            "id": "698230116",
                                            "speaker": "派蒙",
                                            "text": "唔…闻着闻着，我真的要闻饿了…"
                                        },
                                        {
                                            "id": "698230117",
                                            "speaker": "胡桃",
                                            "text": "哼哼。你瞧，本堂主说得没错吧。这种香水确实能勾起人的食欲来。"
                                        },
                                        {
                                            "id": "698230118",
                                            "speaker": "胡桃",
                                            "text": "香菱啊，你就听我的，就把这种香水喷在你们万民堂的菜谱上。每一道菜，都对应一种香水。"
                                        },
                                        {
                                            "id": "698230119",
                                            "speaker": "胡桃",
                                            "text": "就算是客人没吃过这种菜，只要闻闻菜谱，就知道大概是什么味道了。"
                                        },
                                        {
                                            "id": "698230120",
                                            "speaker": "香菱",
                                            "text": "对喔，这样就可以避免客人点错了菜又不想吃，既浪费食物，又浪费钱了…！"
                                        },
                                        {
                                            "id": "698230121",
                                            "speaker": "胡桃",
                                            "text": "对啦对啦，以后我们还可以专门做一本厚厚的「璃月菜味道图谱」，只要翻开，就能闻到对应菜的味道，这肯定好玩！"
                                        },
                                        {
                                            "id": "698230122",
                                            "speaker": "香菱",
                                            "text": "怎么听起来，像是把一大堆菜塞进一个柜子里一样。这样肯定会串味的啦…"
                                        },
                                        {
                                            "id": "698230123",
                                            "speaker": "Player",
                                            "text": "香水…是这么用的吗…"
                                        },
                                        {
                                            "id": "698230124",
                                            "speaker": "派蒙",
                                            "text": "听起来还挺好玩的呀，嘿嘿，翻开来就可以闻见好吃的…不过，这样是不是更容易饿了…？"
                                        },
                                        {
                                            "id": "698230125",
                                            "speaker": "艾梅莉埃",
                                            "text": "食品调香也是一个值得深究的门道。况且随性调配的即兴之作，本就是悦己之物，不必对谁负责，兴致来了，用在哪里都合适。"
                                        },
                                        {
                                            "id": "698230126",
                                            "speaker": "艾梅莉埃",
                                            "text": "况且…呵呵，看来这瓶香水，已经起作用了。"
                                        },
                                        {
                                            "id": "698230127",
                                            "speaker": "派蒙",
                                            "text": "#呜哇！刚才不是我肚子叫，是{NICKNAME}！",
                                            "choices": [
                                                {
                                                    "id": "698230128",
                                                    "text": "香菱，把香水借我用用。",
                                                    "response": [
                                                        {
                                                            "id": "698230130",
                                                            "speaker": "派蒙",
                                                            "text": "你…你好恐怖喔！要喷也喷杏仁豆腐味的啦，吃太辣的话会睡不着的…"
                                                        },
                                                        {
                                                            "id": "698230131",
                                                            "speaker": "派蒙",
                                                            "text": "咦？怎么又有一股水煮鱼的味道，闻起来烫烫的，不像是刚才的香水…"
                                                        },
                                                        {
                                                            "id": "698230132",
                                                            "speaker": "香菱",
                                                            "text": "#派蒙，{NICKNAME}，艾梅莉埃小姐，开饭啦！"
                                                        },
                                                        {
                                                            "id": "698230133",
                                                            "speaker": "Player",
                                                            "text": "什、什么时候？！"
                                                        },
                                                        {
                                                            "id": "698230134",
                                                            "speaker": "胡桃",
                                                            "text": "哎呀，别管那些了，刚才动脑筋太多，本堂主肚子也要饿扁了。"
                                                        },
                                                        {
                                                            "id": "698230135",
                                                            "speaker": "胡桃",
                                                            "text": "哦对了，香菱啊，你帮我再做一份杏仁豆腐呗，客卿他帮我排队买点心去了，我也给他带一份吃的回去。"
                                                        },
                                                        {
                                                            "id": "698230136",
                                                            "speaker": "胡桃",
                                                            "text": "香水也借我用用，嘿嘿…喷了水煮鱼味香水的杏仁豆腐，看看客卿吃了之后，会有什么感想。"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "698230129",
                                                    "text": "等派蒙睡觉了我喷她头上。"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "698230106",
                                    "text": "我好像知道水煮鱼味从哪里来了…"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "698230103",
                    "text": "我们这就去点一份吧。"
                }
            ]
        }
    ]
}