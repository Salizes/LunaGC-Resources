{
    "talkId": "6980704",
    "total_dialogue_lines": 45,
    "speaker_counts": {
        "Player": 13,
        "行秋": 32
    },
    "dialogues": [
        {
            "id": "698070401",
            "speaker": "行秋",
            "text": "唉，大哥说的果然没错，我只懂写书，不懂卖书啊…",
            "choices": [
                {
                    "id": "698070402",
                    "text": "行秋，你在做什么呢？",
                    "response": [
                        {
                            "id": "698070404",
                            "speaker": "行秋",
                            "text": "#还差最后几章就整理好了。但…{NICKNAME}，我且问你一句。"
                        },
                        {
                            "id": "698070405",
                            "speaker": "行秋",
                            "text": "你觉得，我的书法能卖多少钱？"
                        },
                        {
                            "id": "698070406",
                            "speaker": "Player",
                            "text": "无价！"
                        },
                        {
                            "id": "698070407",
                            "speaker": "行秋",
                            "text": "你怎么说话的口气这么老气，别开玩笑了，我认真问的。",
                            "choices": [
                                {
                                    "id": "698070408",
                                    "text": "我不懂书法市场。",
                                    "response": [
                                        {
                                            "id": "698070410",
                                            "speaker": "行秋",
                                            "text": "#呼…谢啦，{NICKNAME}，还好你没和家里的那些人一样，和我说那些笔墨如金，有价无市的生意话。"
                                        },
                                        {
                                            "id": "698070411",
                                            "speaker": "行秋",
                                            "text": "之前，我去问大哥打字机的事了。问到一半，刚准备拐着弯问他怎么不帮我带一台回来，你猜他怎么说？"
                                        },
                                        {
                                            "id": "698070412",
                                            "speaker": "Player",
                                            "text": "他是故意不带的？"
                                        },
                                        {
                                            "id": "698070413",
                                            "speaker": "行秋",
                                            "text": "没有，大哥其实早就带了一台回来，还说自己已经听说了事情的来龙去脉，让我先去试试打字机的尺寸。"
                                        },
                                        {
                                            "id": "698070414",
                                            "speaker": "行秋",
                                            "text": "我一试，发现整台打字机都是按照我的手掌尺寸改造过，用着十分合适。"
                                        },
                                        {
                                            "id": "698070415",
                                            "speaker": "行秋",
                                            "text": "大哥还说，事出紧急，我可以用这台打字机写小说杂文，太爷爷那边他也说过了。"
                                        },
                                        {
                                            "id": "698070416",
                                            "speaker": "行秋",
                                            "text": "他之所以没有直接把这台打字机给我，其实是因为…希望我能写出好字。"
                                        },
                                        {
                                            "id": "698070417",
                                            "speaker": "行秋",
                                            "text": "人们常说「见字如面」，亲笔写的字，总是会比打字机打出来的字更让人觉得亲近。"
                                        },
                                        {
                                            "id": "698070418",
                                            "speaker": "行秋",
                                            "text": "大哥说，他之所以愿意把那本《洗墨录》交给我，而不是直接把打字机送过来…"
                                        },
                                        {
                                            "id": "698070419",
                                            "speaker": "行秋",
                                            "text": "也是因为，他觉得我的字迹虽然不太像话，但仍然有风骨，笔脉可圈可点。"
                                        },
                                        {
                                            "id": "698070420",
                                            "speaker": "行秋",
                                            "text": "如果我以后都用打字机写文章，他只怕我用得忘形，以后根本不提笔写字，断绝了书法脉络。",
                                            "choices": [
                                                {
                                                    "id": "698070421",
                                                    "text": "我还以为你大哥会说…",
                                                    "response": [
                                                        {
                                                            "id": "698070423",
                                                            "speaker": "行秋",
                                                            "text": "老实说，我当时也是捏着一把汗啊，差点把茶杯给捏碎了。"
                                                        },
                                                        {
                                                            "id": "698070424",
                                                            "speaker": "行秋",
                                                            "text": "我就怕大哥开口说什么：「在生意场上，亲近就是交际，交际就是人脉，人脉就是摩拉，练字就是为了赚钱。」"
                                                        },
                                                        {
                                                            "id": "698070425",
                                                            "speaker": "行秋",
                                                            "text": "要是他这么说，我非得夺门而出，跑去重云他们家住上十天半个月不可。"
                                                        },
                                                        {
                                                            "id": "698070426",
                                                            "speaker": "Player",
                                                            "text": "你大哥还挺通情达理的。"
                                                        },
                                                        {
                                                            "id": "698070427",
                                                            "speaker": "行秋",
                                                            "text": "是啊，大哥从来不和我念叨那些生意话，只是让我随心生活就好。"
                                                        },
                                                        {
                                                            "id": "698070428",
                                                            "speaker": "行秋",
                                                            "text": "但…唉，虽然他不说，但商会里那么多生意往来，我又何尝不知道「见字如面，落笔成金」的道理？"
                                                        },
                                                        {
                                                            "id": "698070429",
                                                            "speaker": "行秋",
                                                            "text": "太爷爷的一幅字能值得几十万摩拉，大哥的一封书信能让人专程过来道谢…"
                                                        },
                                                        {
                                                            "id": "698070430",
                                                            "speaker": "行秋",
                                                            "text": "和大哥出去拜贺的时候，我还看见，有人把太爷爷写的贺柬裱挂在墙上。"
                                                        },
                                                        {
                                                            "id": "698070431",
                                                            "speaker": "行秋",
                                                            "text": "#{NICKNAME}，你再看看这几本书。这是我新写的小说，内容没有一丝一毫的差别。"
                                                        },
                                                        {
                                                            "id": "698070432",
                                                            "speaker": "行秋",
                                                            "text": "只是因为我签字的时候，最后一个字的笔锋多往外甩了几寸，就硬生生多卖了两百摩拉。"
                                                        },
                                                        {
                                                            "id": "698070433",
                                                            "speaker": "行秋",
                                                            "text": "字还是那几个字，文章还是那篇文章。只是因为笔锋长短，就分出了高低贵贱。"
                                                        },
                                                        {
                                                            "id": "698070434",
                                                            "speaker": "行秋",
                                                            "text": "同一封贺柬，虽然内容无差。但大家会把太爷爷写的信挂在墙上，把大哥写的信细心放在盒子里…"
                                                        },
                                                        {
                                                            "id": "698070435",
                                                            "speaker": "行秋",
                                                            "text": "我知道，这些都是生意场上的人情琐事，他们并不在意信里写了什么，只是在意谁给他们写的信。只是…",
                                                            "choices": [
                                                                {
                                                                    "id": "698070436",
                                                                    "text": "行秋给我写的信，我都记得。",
                                                                    "response": [
                                                                        {
                                                                            "id": "698070438",
                                                                            "speaker": "行秋",
                                                                            "text": "我知道，谢啦。也是苦了你，天天看着满纸蚯蚓文，我争取早日学会打字机，给你打出一封漂漂亮亮的信来。",
                                                                            "choices": [
                                                                                {
                                                                                    "id": "698070439",
                                                                                    "text": "还是行秋亲笔写的好。",
                                                                                    "response": [
                                                                                        {
                                                                                            "id": "698070441",
                                                                                            "speaker": "行秋",
                                                                                            "text": "噗…哈哈哈，好，好，那我以后给你写信，还是用我那鬼画符的「书法」。"
                                                                                        },
                                                                                        {
                                                                                            "id": "698070442",
                                                                                            "speaker": "行秋",
                                                                                            "text": "要是哪天你突然看见我的信里满纸都是端正书法，可要记得快快来找我。"
                                                                                        },
                                                                                        {
                                                                                            "id": "698070443",
                                                                                            "speaker": "行秋",
                                                                                            "text": "我要么是被贼人绑架，要么就是想见你了。"
                                                                                        },
                                                                                        {
                                                                                            "id": "698070444",
                                                                                            "speaker": "行秋",
                                                                                            "text": "#哎呀，天色不早，我也该回去了。回头再见了，{NICKNAME}。"
                                                                                        },
                                                                                        {
                                                                                            "id": "698070445",
                                                                                            "speaker": "行秋",
                                                                                            "text": "也不知道那位羲帆先生，是不是也是因为不想看见自己的字被贩来卖去，才弃笔提剑的呢…"
                                                                                        }
                                                                                    ]
                                                                                },
                                                                                {
                                                                                    "id": "698070440",
                                                                                    "text": "还是蚯蚓文亲切。"
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                },
                                                                {
                                                                    "id": "698070437",
                                                                    "text": "喏，都好好放着呢。"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "698070422",
                                                    "text": "你亲笔写的字更值钱呢。"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "698070409",
                                    "text": "但行秋写的字我都喜欢。"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "698070403",
                    "text": "文稿都整理好了？"
                }
            ]
        }
    ]
}