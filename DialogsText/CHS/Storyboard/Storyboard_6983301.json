{
    "talkId": "6983301",
    "total_dialogue_lines": 28,
    "speaker_counts": {
        "Player": 9,
        "夏洛蒂": 19
    },
    "dialogues": [
        {
            "id": "698330101",
            "speaker": "夏洛蒂",
            "text": "…应该就是这个时间啊。她难道今天不来喝咖啡？"
        },
        {
            "id": "698330102",
            "speaker": "Player",
            "text": "夏洛蒂…"
        },
        {
            "id": "698330103",
            "speaker": "夏洛蒂",
            "text": "不对不对，今天的咖啡是她最喜欢的口味，她绝对会来…"
        },
        {
            "id": "698330104",
            "speaker": "Player",
            "text": "蒸汽鸟报记者夏洛蒂小姐！"
        },
        {
            "id": "698330105",
            "speaker": "夏洛蒂",
            "text": "#呜哇！{NICKNAME}？你、你吓死我了！你过来的时候也不出个声么？"
        },
        {
            "id": "698330106",
            "speaker": "Player",
            "text": "我都叫你好多次啦。"
        },
        {
            "id": "698330107",
            "speaker": "夏洛蒂",
            "text": "欸？对、对不起嘛…我光想着报道和留影了，没听见…"
        },
        {
            "id": "698330108",
            "speaker": "夏洛蒂",
            "text": "唉，克洛琳德小姐到现在也没出现，难道她今天真的不来了…",
            "choices": [
                {
                    "id": "698330109",
                    "text": "你要采访克洛琳德？",
                    "response": [
                        {
                            "id": "698330111",
                            "speaker": "夏洛蒂",
                            "text": "话是这么说啦…但如果我能采访到「从未被人采访过的决斗代理人」，那我肯定能再写出一篇头版报道。"
                        },
                        {
                            "id": "698330112",
                            "speaker": "夏洛蒂",
                            "text": "当然啦，要是直接去找克洛琳德小姐，我肯定会像其他的记者一样，被她直接拒之门外。所以…"
                        },
                        {
                            "id": "698330113",
                            "speaker": "夏洛蒂",
                            "text": "所以…我决定走点「弯路」来解决这个问题。"
                        },
                        {
                            "id": "698330114",
                            "speaker": "夏洛蒂",
                            "text": "首先，我制订了一张完善的表单，里面包含了她最常去的几个地点。"
                        },
                        {
                            "id": "698330115",
                            "speaker": "夏洛蒂",
                            "text": "然后，我会在特定的时间段里去那几个地点「蹲守」，等待着和克洛琳德小姐「偶遇」。"
                        },
                        {
                            "id": "698330116",
                            "speaker": "夏洛蒂",
                            "text": "我甚至还在学习桌游呢，准备过几天就去「桌上剧团」，和大家一起玩玩新剧本。甚至…直接做剧本主持人。"
                        },
                        {
                            "id": "698330117",
                            "speaker": "夏洛蒂",
                            "text": "如果能主持一场有克洛琳德小姐参与的游戏，我就可以用主持的身份，和她再拉近点关系…"
                        },
                        {
                            "id": "698330118",
                            "speaker": "夏洛蒂",
                            "text": "当然，我不会在玩游戏的时候问出失礼的问题。我的新闻稿件从不采信非正式场合的不可信发言。"
                        },
                        {
                            "id": "698330119",
                            "speaker": "Player",
                            "text": "你当心遇见娜维娅…"
                        },
                        {
                            "id": "698330120",
                            "speaker": "夏洛蒂",
                            "text": "娜维娅小姐？她怎么了，我听说她非常擅长玩桌游呀？",
                            "choices": [
                                {
                                    "id": "698330121",
                                    "text": "你要想好怎么表演会说话的门。",
                                    "response": [
                                        {
                                            "id": "698330123",
                                            "speaker": "夏洛蒂",
                                            "text": "咦…咦？做剧本主持还要考虑这种问题么…哎呀，没事，相信我这个记者的口才吧。"
                                        },
                                        {
                                            "id": "698330124",
                                            "speaker": "夏洛蒂",
                                            "text": "要是遇见了我无法理解的问题，我会用专业话术让大家忽略它的，绝对天衣无缝，不会有任何人察觉。"
                                        },
                                        {
                                            "id": "698330125",
                                            "speaker": "Player",
                                            "text": "是…是这样解决的么？难道平时…"
                                        },
                                        {
                                            "id": "698330126",
                                            "speaker": "夏洛蒂",
                                            "text": "不会不会，和你聊天的时候，我可都是敞开心扉，无话不谈的呢。"
                                        },
                                        {
                                            "id": "698330127",
                                            "speaker": "夏洛蒂",
                                            "text": "呜哇！先不说了，我要快点赶去德波大饭店。克洛琳德小姐说不定正准备去那边买蛋糕呢。"
                                        },
                                        {
                                            "id": "698330128",
                                            "speaker": "夏洛蒂",
                                            "text": "#我先走啦，{NICKNAME}，下次有机会，你可一定要接受我的专访啊！"
                                        }
                                    ]
                                },
                                {
                                    "id": "698330122",
                                    "text": "还有怎么阻止她质问路过的青蛙。"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "698330110",
                    "text": "她不是不接受采访吗？"
                }
            ]
        }
    ]
}