    "dialogues": [
        {
            "id": "698130101",
            "speaker": "七七",
            "text": "请帮忙…尝尝这个…"
        },
        {
            "id": "698130102",
            "speaker": "锅巴",
            "text": "？"
        },
        {
            "id": "698130103",
            "speaker": "锅巴",
            "text": "——！"
        },
        {
            "id": "698130104",
            "speaker": "七七",
            "text": "又、又失败了吗…"
        },
        {
            "id": "698130105",
            "speaker": "锅巴",
            "text": "♪"
        },
        {
            "id": "698130106",
            "speaker": "七七",
            "text": "谢谢…你的安慰。"
        },
        {
            "id": "698130107",
            "speaker": "七七",
            "text": "请、请再帮忙…尝尝这个…"
        },
        {
            "id": "698130108",
            "speaker": "锅巴",
            "text": "？"
        },
        {
            "id": "698130109",
            "speaker": "锅巴",
            "text": "♬"
        },
        {
            "id": "698130110",
            "speaker": "七七",
            "text": "…真、真的好吃吗？"
        },
        {
            "id": "698130111",
            "speaker": "锅巴",
            "text": "♬~"
        },
        {
            "id": "698130112",
            "speaker": "七七",
            "text": "太好了！",
            "choices": [
                {
                    "id": "698130113",
                    "text": "好香啊。",
                    "response": [
                        {
                            "id": "698130115",
                            "speaker": "七七",
                            "text": "#{NICKNAME}！我…找卯师傅借用了这边的厨房…想要做点菜。"
                        },
                        {
                            "id": "698130116",
                            "speaker": "七七",
                            "text": "但我尝不出味道，卯师傅就让锅巴来帮我的忙。"
                        },
                        {
                            "id": "698130117",
                            "speaker": "锅巴",
                            "text": "♪~"
                        },
                        {
                            "id": "698130118",
                            "speaker": "七七",
                            "text": "欸？等等…为什么要做菜来着？我看看笔记…"
                        },
                        {
                            "id": "698130119",
                            "speaker": "七七",
                            "text": "噢！笔记上写着：做好菜，冻起来，给和瑶瑶的郊游做准备。"
                        },
                        {
                            "id": "698130120",
                            "speaker": "七七",
                            "text": "嗯，我不吃东西没关系，瑶瑶不一样…瑶瑶要吃多点才能长大…长高。"
                        },
                        {
                            "id": "698130121",
                            "speaker": "七七",
                            "text": "瑶瑶…会不会长得比白先生更高？"
                        },
                        {
                            "id": "698130122",
                            "speaker": "锅巴",
                            "text": "？"
                        },
                        {
                            "id": "698130123",
                            "speaker": "Player",
                            "text": "那恐怕有点困难。"
                        },
                        {
                            "id": "698130124",
                            "speaker": "七七",
                            "text": "没关系。瑶瑶，长多大都会，很可爱。"
                        },
                        {
                            "id": "698130125",
                            "speaker": "七七",
                            "text": "啊，聊太久了。炉子那边…"
                        },
                        {
                            "id": "698130126",
                            "speaker": "锅巴",
                            "text": "♬"
                        },
                        {
                            "id": "698130127",
                            "speaker": "七七",
                            "text": "谢谢你看着炉子，锅巴。那最后这个，也拜托了…"
                        },
                        {
                            "id": "698130128",
                            "speaker": "锅巴",
                            "text": "——！"
                        },
                        {
                            "id": "698130129",
                            "speaker": "Player",
                            "text": "看来是很有冲击力的味道呢…"
                        }
                    ]
                },
                {
                    "id": "698130114",
                    "text": "在做什么好吃的吗？"
                }
            ]
        }
    ]
}