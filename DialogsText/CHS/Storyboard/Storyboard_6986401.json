{
    "talkId": "6986401",
    "total_dialogue_lines": 31,
    "speaker_counts": {
        "Player": 9,
        "菲林斯": 22
    },
    "dialogues": [
        {
            "id": "698640102",
            "speaker": "菲林斯",
            "text": "…不在吗？",
            "choices": [
                {
                    "id": "698640132",
                    "text": "菲林斯在找什么？",
                    "response": [
                        {
                            "id": "698640103",
                            "speaker": "菲林斯",
                            "text": "#你好，{NICKNAME}，真是让人心情愉快的相遇。"
                        },
                        {
                            "id": "698640104",
                            "speaker": "菲林斯",
                            "text": "见到您，我这刚吃了闭门羹的糟糕心情，也算是好了一些。",
                            "choices": [
                                {
                                    "id": "698640105",
                                    "text": "遇见麻烦了？",
                                    "response": [
                                        {
                                            "id": "698640107",
                                            "speaker": "菲林斯",
                                            "text": "算不上什么麻烦，只是遇见一些…意外情况。"
                                        },
                                        {
                                            "id": "698640108",
                                            "speaker": "菲林斯",
                                            "text": "原本我打听到，那夏镇有位收藏家，出于经济原因不得不出手两枚古币。"
                                        },
                                        {
                                            "id": "698640109",
                                            "speaker": "菲林斯",
                                            "text": "但那位收藏家性情古怪，从来不接信件，想要购买她收藏的话，就只能前去和她面谈。"
                                        },
                                        {
                                            "id": "698640110",
                                            "speaker": "菲林斯",
                                            "text": "这次我也是趁着来镇上采购物资的机会，想要顺便拜访。但…看来她并不在家，非常遗憾。"
                                        },
                                        {
                                            "id": "698640111",
                                            "speaker": "Player",
                                            "text": "原来菲林斯喜欢收藏古币。"
                                        },
                                        {
                                            "id": "698640112",
                                            "speaker": "菲林斯",
                                            "text": "一点小小的爱好，人总有一些自己偏爱的东西。对我来说，古币、宝石中的老货就是这样的东西。"
                                        },
                                        {
                                            "id": "698640113",
                                            "speaker": "菲林斯",
                                            "text": "时间是最好的筛选者，能从时间的筛子里漏出来的东西，质量都不错。"
                                        },
                                        {
                                            "id": "698640114",
                                            "speaker": "菲林斯",
                                            "text": "钱币的制式、花纹和磨损程度能够告诉我各种信息，让我知道它穿越了多少岁月才来到此刻我的手中。"
                                        },
                                        {
                                            "id": "698640115",
                                            "speaker": "菲林斯",
                                            "text": "想一想，一枚钱币或许曾流经一万个人的手，给他们带来过欢乐和痛苦，见证了他们人生的许多片段。"
                                        },
                                        {
                                            "id": "698640116",
                                            "speaker": "菲林斯",
                                            "text": "它身上时间的重量远比看上去的要沉重许多，它是过去的见证，至今也依然拥有价值，很值得收藏。"
                                        },
                                        {
                                            "id": "698640118",
                                            "speaker": "菲林斯",
                                            "text": "这几天，我被那两枚古币吊足了胃口。"
                                        },
                                        {
                                            "id": "698640119",
                                            "speaker": "菲林斯",
                                            "text": "它们到底是什么样子，身上有什么特别的故事…见不到这位收藏家我甚至都不想回去了。"
                                        },
                                        {
                                            "id": "698640120",
                                            "speaker": "菲林斯",
                                            "text": "…看我，讲起这些事情来就忘了身边还有人，净顾着说自己的事了。"
                                        },
                                        {
                                            "id": "698640121",
                                            "speaker": "菲林斯",
                                            "text": "让我想想还有什么有趣的话题，能弥补我刚才自说自话的失礼呢？"
                                        },
                                        {
                                            "id": "698640122",
                                            "speaker": "菲林斯",
                                            "text": "嗯，前些天我在一位枫丹商人那里买到了一枚漂亮的海蓝色宝石，它沉睡在枫丹的海底许久，前些日子才被捞上来。"
                                        },
                                        {
                                            "id": "698640123",
                                            "speaker": "菲林斯",
                                            "text": "有人说，它曾经被嵌在某位枫丹廷决斗代理人的佩剑上；也有人说，它曾经是某一批海盗的心上珍宝…",
                                            "choices": [
                                                {
                                                    "id": "698640124",
                                                    "text": "越听越假…",
                                                    "response": [
                                                        {
                                                            "id": "698640126",
                                                            "speaker": "菲林斯",
                                                            "text": "呵呵，您和我的想法一样。当商人们开始鼓唇弄舌时，就代表着他们并不相信自己手里的货物。"
                                                        },
                                                        {
                                                            "id": "698640127",
                                                            "speaker": "菲林斯",
                                                            "text": "但好在，我总是能认清一件宝物的价值——即使连他的主人都没有意识到，自己手持何物。"
                                                        },
                                                        {
                                                            "id": "698640128",
                                                            "speaker": "菲林斯",
                                                            "text": "请允许我再一次邀请您来我的驻所，相信您一定会愿意欣赏那颗宝石，也愿意顺便聆听一下，它究竟价值几何。",
                                                            "choices": [
                                                                {
                                                                    "id": "698640129",
                                                                    "text": "好，我会来的。",
                                                                    "response": [
                                                                        {
                                                                            "id": "698640131",
                                                                            "speaker": "菲林斯",
                                                                            "text": "我静候您的光临。"
                                                                        }
                                                                    ]
                                                                },
                                                                {
                                                                    "id": "698640130",
                                                                    "text": "我很期待！"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "698640125",
                                                    "text": "你该不会被骗钱了吧？"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "698640106",
                                    "text": "需要帮忙吗？"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "698640101",
                    "text": "菲林斯在等人吗？"
                }
            ]
        }
    ]
}