{
    "talkId": "6986201",
    "total_dialogue_lines": 31,
    "speaker_counts": {
        "Player": 13,
        "烟绯": 18
    },
    "dialogues": [
        {
            "id": "698620101",
            "speaker": "烟绯",
            "text": "…唔——"
        },
        {
            "id": "698620102",
            "speaker": "Player",
            "text": "烟绯？好久不见。"
        },
        {
            "id": "698620103",
            "speaker": "烟绯",
            "text": "#{NICKNAME}？你好呀。好久不见，没想到我们居然会在挪德卡莱遇见。",
            "choices": [
                {
                    "id": "698620104",
                    "text": "你来这里是因为…",
                    "response": [
                        {
                            "id": "698620106",
                            "speaker": "烟绯",
                            "text": "哈哈哈，我倒是想啊。可惜挪德卡莱比我想象中的更加「无法无天」。"
                        },
                        {
                            "id": "698620107",
                            "speaker": "烟绯",
                            "text": "怎么说呢。这里已经成为了字面意义上的「无法之地」了。"
                        },
                        {
                            "id": "698620108",
                            "speaker": "烟绯",
                            "text": "就算有人请我去做律法援助，我觉得到最后也会演变成…大家开始用「最终辩护手段」陈述己见吧。"
                        },
                        {
                            "id": "698620109",
                            "speaker": "Player",
                            "text": "最终手段是…"
                        },
                        {
                            "id": "698620110",
                            "speaker": "烟绯",
                            "text": "喏。就是这个。最直接的「最终辩护手段」。"
                        },
                        {
                            "id": "698620111",
                            "speaker": "Player",
                            "text": "确实是「手」段呢…"
                        },
                        {
                            "id": "698620112",
                            "speaker": "烟绯",
                            "text": "好啦，不开玩笑了。我之所以来挪德卡莱，是为了给我和阿忍合著的普法新书取材。"
                        },
                        {
                            "id": "698620113",
                            "speaker": "烟绯",
                            "text": "这本书的主题是「律法的边界」，里面有一章要详述律法彻底消失的后果。"
                        },
                        {
                            "id": "698620114",
                            "speaker": "烟绯",
                            "text": "在璃月我是绝无可能取到这种材的啦。所以…我就来了挪德卡莱，这个著名的「无法之地」。"
                        },
                        {
                            "id": "698620115",
                            "speaker": "烟绯",
                            "text": "一踏进挪德卡莱，我就知道来对地方了。这地方已经不能说是律法消失了，简直可以说是律法从未存在了。"
                        },
                        {
                            "id": "698620116",
                            "speaker": "烟绯",
                            "text": "也怪不得我待到现在，连一个同行都没见过…在这种地方做律法咨询，非得饿死不可。",
                            "choices": [
                                {
                                    "id": "698620117",
                                    "text": "你一个人来的？",
                                    "response": [
                                        {
                                            "id": "698620119",
                                            "speaker": "烟绯",
                                            "text": "放心啦。我好歹也有仙人血脉。一般的强盗匪徒伤不了我。"
                                        },
                                        {
                                            "id": "698620120",
                                            "speaker": "烟绯",
                                            "text": "我还巴不得来几个本地的盗匪抢劫我呢。我正好问问他们，是怎么在这片无法之地上生存的。",
                                            "choices": [
                                                {
                                                    "id": "698620121",
                                                    "text": "不过，萍姥姥居然会同意你出来…",
                                                    "response": [
                                                        {
                                                            "id": "698620123",
                                                            "speaker": "烟绯",
                                                            "text": "啊？啊…哈哈…是、是啊！我可是磨了几天嘴皮子，才让姥姥放我出来呢…",
                                                            "choices": [
                                                                {
                                                                    "id": "698620124",
                                                                    "text": "等等。",
                                                                    "response": [
                                                                        {
                                                                            "id": "698620126",
                                                                            "speaker": "烟绯",
                                                                            "text": "说、说过啊！我怎么可能瞒着姥姥呢，我…我真说过了…"
                                                                        },
                                                                        {
                                                                            "id": "698620127",
                                                                            "speaker": "Player",
                                                                            "text": "那萍姥姥答应了么？"
                                                                        },
                                                                        {
                                                                            "id": "698620128",
                                                                            "speaker": "烟绯",
                                                                            "text": "答…答应了…吗？哈哈…那个…姥姥最疼我了，我可是说了好多话…"
                                                                        },
                                                                        {
                                                                            "id": "698620129",
                                                                            "speaker": "烟绯",
                                                                            "text": "那个…我在那个「秘闻馆」里约了面谈，时间差不多到了，我走了啊！"
                                                                        },
                                                                        {
                                                                            "id": "698620130",
                                                                            "speaker": "Player",
                                                                            "text": "烟绯！"
                                                                        },
                                                                        {
                                                                            "id": "698620131",
                                                                            "speaker": "烟绯",
                                                                            "text": "#下次有机会再见啦，{NICKNAME}！"
                                                                        }
                                                                    ]
                                                                },
                                                                {
                                                                    "id": "698620125",
                                                                    "text": "烟绯小姐，你和萍姥姥说过吗？"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "698620122",
                                                    "text": "我还以为她会给你点宝贝防身…"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "698620118",
                                    "text": "有点太危险了…"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "698620105",
                    "text": "呃，总不可能是律法援助…"
                }
            ]
        }
    ]
}