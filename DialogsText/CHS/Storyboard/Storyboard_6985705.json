{
    "talkId": "6985705",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 3,
        "雅珂达": 11
    },
    "dialogues": [
        {
            "id": "698570501",
            "speaker": "雅珂达",
            "text": "…真的在这附近？没看见啊。不行不行，不能再往前面走了…"
        },
        {
            "id": "698570502",
            "speaker": "雅珂达",
            "text": "可是那只猫还没找到，要是这么回去，怎么和奈姐交代…啊！可恶可恶可恶，这只笨猫！"
        },
        {
            "id": "698570503",
            "speaker": "Player",
            "text": "雅珂达？"
        },
        {
            "id": "698570504",
            "speaker": "雅珂达",
            "text": "呜哇！你，你吓我一跳…"
        },
        {
            "id": "698570505",
            "speaker": "雅珂达",
            "text": "正好遇见你了，哎，你有没有在附近看见一只黑白条纹的小猫？"
        },
        {
            "id": "698570506",
            "speaker": "雅珂达",
            "text": "呃…脖子上还戴着一个蓝色的领结，尾巴很大。",
            "choices": [
                {
                    "id": "698570507",
                    "text": "没注意啊…",
                    "response": [
                        {
                            "id": "698570509",
                            "speaker": "雅珂达",
                            "text": "是啊——可恶！奈姐今天也不知道又突发了什么灵感，非要让我来这里找猫，还要我仔细留意周围…"
                        },
                        {
                            "id": "698570510",
                            "speaker": "雅珂达",
                            "text": "我说你要找猫的话，直接去协会发委托不就好了吗？这帮人天天干这个，最会帮人找猫了…"
                        },
                        {
                            "id": "698570511",
                            "speaker": "雅珂达",
                            "text": "可她就是坚持要我过来！我都在这里转悠半天了，连一根猫毛都没看见…"
                        },
                        {
                            "id": "698570512",
                            "speaker": "雅珂达",
                            "text": "要是我空着手回去的话，说不定奈姐又要训我…"
                        },
                        {
                            "id": "698570513",
                            "speaker": "雅珂达",
                            "text": "不行不行，不和你说了，我要接着去找猫了。"
                        },
                        {
                            "id": "698570514",
                            "speaker": "雅珂达",
                            "text": "喂——猫——你在哪里啊——"
                        }
                    ]
                },
                {
                    "id": "698570508",
                    "text": "你是来这里找猫的？"
                }
            ]
        }
    ]
}