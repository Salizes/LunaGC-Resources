{
    "talkId": "6985802",
    "total_dialogue_lines": 41,
    "speaker_counts": {
        "Player": 18,
        "菈乌玛": 23
    },
    "dialogues": [
        {
            "id": "698580201",
            "speaker": "菈乌玛",
            "text": "呼…"
        },
        {
            "id": "698580202",
            "speaker": "Player",
            "text": "（嗯？又来？）"
        },
        {
            "id": "698580203",
            "speaker": "Player",
            "text": "（不过这次只有菈乌玛在…而且看起来像是真的睡着了…）"
        },
        {
            "id": "698580204",
            "speaker": "Player",
            "text": "（怎、怎么办？要不还是…）"
        },
        {
            "id": "698580205",
            "speaker": "菈乌玛",
            "text": "啊！"
        },
        {
            "id": "698580206",
            "speaker": "Player",
            "text": "你、你好…"
        },
        {
            "id": "698580207",
            "speaker": "菈乌玛",
            "text": "#啊，是{NICKNAME}，你也好。"
        },
        {
            "id": "698580208",
            "speaker": "Player",
            "text": "是做噩梦了吗？"
        },
        {
            "id": "698580209",
            "speaker": "菈乌玛",
            "text": "唔…"
        },
        {
            "id": "698580210",
            "speaker": "Player",
            "text": "没关系，不想说也可以的…"
        },
        {
            "id": "698580211",
            "speaker": "菈乌玛",
            "text": "不，你误会了。"
        },
        {
            "id": "698580212",
            "speaker": "菈乌玛",
            "text": "其实是因为…头上的角冠太重，刚刚差点歪倒，所以惊醒了自己。",
            "choices": [
                {
                    "id": "698580213",
                    "text": "原来如此。",
                    "response": [
                        {
                            "id": "698580215",
                            "speaker": "菈乌玛",
                            "text": "呵呵，的确。"
                        },
                        {
                            "id": "698580216",
                            "speaker": "菈乌玛",
                            "text": "如你所见，我的角冠比其他人的都要大上一些，走动时间久了，确实会略感疲惫。"
                        },
                        {
                            "id": "698580217",
                            "speaker": "菈乌玛",
                            "text": "所以偶尔我会抽空来这里坐下休息一会，只是这次真的不小心睡着了。",
                            "choices": [
                                {
                                    "id": "698580218",
                                    "text": "真不容易呢。",
                                    "response": [
                                        {
                                            "id": "698580220",
                                            "speaker": "菈乌玛",
                                            "text": "唔…"
                                        },
                                        {
                                            "id": "698580221",
                                            "speaker": "菈乌玛",
                                            "text": "抱歉，除了偶尔找个地方靠上去休息一下，目前还没有什么有效的解决方式。"
                                        },
                                        {
                                            "id": "698580222",
                                            "speaker": "菈乌玛",
                                            "text": "爱诺小姐曾经提议过，要不要为我做一个用来支撑颈部或者角冠的机械装置…"
                                        },
                                        {
                                            "id": "698580223",
                                            "speaker": "菈乌玛",
                                            "text": "很感谢她愿意帮忙，但我个人觉得不是特别…嗯…"
                                        },
                                        {
                                            "id": "698580224",
                                            "speaker": "Player",
                                            "text": "「得体」？"
                                        },
                                        {
                                            "id": "698580225",
                                            "speaker": "菈乌玛",
                                            "text": "呵呵，是这个意思。"
                                        },
                                        {
                                            "id": "698580226",
                                            "speaker": "菈乌玛",
                                            "text": "身在其位就要为之保持合适的形象。"
                                        },
                                        {
                                            "id": "698580227",
                                            "speaker": "菈乌玛",
                                            "text": "作为「霜月之子」的「咏月使」，的确不太适合以那样的形象出现。",
                                            "choices": [
                                                {
                                                    "id": "698580228",
                                                    "text": "「苍林的…」…",
                                                    "response": [
                                                        {
                                                            "id": "698580230",
                                                            "speaker": "菈乌玛",
                                                            "text": "嗯…",
                                                            "choices": [
                                                                {
                                                                    "id": "698580231",
                                                                    "text": "如果菈乌玛有自己的派蒙就好了。",
                                                                    "response": [
                                                                        {
                                                                            "id": "698580233",
                                                                            "speaker": "菈乌玛",
                                                                            "text": "嗯？这个也…"
                                                                        },
                                                                        {
                                                                            "id": "698580234",
                                                                            "speaker": "Player",
                                                                            "text": "抱歉！忍不住开了个玩笑。"
                                                                        },
                                                                        {
                                                                            "id": "698580235",
                                                                            "speaker": "菈乌玛",
                                                                            "text": "呵呵呵…"
                                                                        },
                                                                        {
                                                                            "id": "698580236",
                                                                            "speaker": "菈乌玛",
                                                                            "text": "实不相瞒，想象了一下，的确还挺好笑的。"
                                                                        },
                                                                        {
                                                                            "id": "698580237",
                                                                            "speaker": "菈乌玛",
                                                                            "text": "谢谢你，笑过之后，已经感觉不到疲惫了。",
                                                                            "choices": [
                                                                                {
                                                                                    "id": "698580238",
                                                                                    "text": "不客气。",
                                                                                    "response": [
                                                                                        {
                                                                                            "id": "698580240",
                                                                                            "speaker": "菈乌玛",
                                                                                            "text": "嗯。有机会的话，欢迎多来这里做客。"
                                                                                        },
                                                                                        {
                                                                                            "id": "698580241",
                                                                                            "speaker": "菈乌玛",
                                                                                            "text": "我会准备好新鲜水果招待你的。"
                                                                                        }
                                                                                    ]
                                                                                },
                                                                                {
                                                                                    "id": "698580239",
                                                                                    "text": "还得是我。"
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                },
                                                                {
                                                                    "id": "698580232",
                                                                    "text": "可以帮你在后面托住…"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "698580229",
                                                    "text": "「机械圣女」…"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "698580219",
                                    "text": "没有什么缓解的办法吗？"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "698580214",
                    "text": "看来坐着睡觉需要技术力。"
                }
            ]
        }
    ]
}