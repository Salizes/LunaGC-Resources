{
    "talkId": "6980905",
    "total_dialogue_lines": 19,
    "speaker_counts": {
        "Player": 5,
        "安柏": 14
    },
    "dialogues": [
        {
            "id": "698090501",
            "speaker": "安柏",
            "text": "好舒服的风…就在这里休息一会吧…"
        },
        {
            "id": "698090502",
            "speaker": "安柏",
            "text": "#{NICKNAME}，你来的正好，快过来一起坐坐。"
        },
        {
            "id": "698090503",
            "speaker": "安柏",
            "text": "这里差不多能算是蒙德城最高的地方了，你看底下，漂亮吧。"
        },
        {
            "id": "698090504",
            "speaker": "安柏",
            "text": "广场上有好多人呢，嗯…我都看见玛格丽特小姐正在广场上散步了…"
        },
        {
            "id": "698090505",
            "speaker": "安柏",
            "text": "呼啊…也只有在今天这样的休息日里，我能在这边看着远方发呆。"
        },
        {
            "id": "698090506",
            "speaker": "安柏",
            "text": "放在平时，我要么从这里匆匆忙忙起飞，要么就是急急忙忙地在这里降落…",
            "choices": [
                {
                    "id": "698090507",
                    "text": "安柏要好好休息。",
                    "response": [
                        {
                            "id": "698090509",
                            "speaker": "安柏",
                            "text": "毕竟我是西风骑士团的骑士呀，帮助蒙德城的大家是我的职责。"
                        },
                        {
                            "id": "698090510",
                            "speaker": "安柏",
                            "text": "只要能为大家解决烦恼，无论是什么麻烦事，我都有义务去帮忙。"
                        },
                        {
                            "id": "698090511",
                            "speaker": "Player",
                            "text": "不愧是最好的「侦察骑士」。"
                        },
                        {
                            "id": "698090512",
                            "speaker": "安柏",
                            "text": "欸？你别夸啦，我都要脸红了。骑士团…还有冒险家协会的各位都和我一样努力，甚至比我还辛苦呢。"
                        },
                        {
                            "id": "698090513",
                            "speaker": "安柏",
                            "text": "但只要是为了蒙德城，无论多么辛苦，我们都会继续努力下去。"
                        },
                        {
                            "id": "698090514",
                            "speaker": "安柏",
                            "text": "…欸？等等，玛格丽特小姐是不是突然跑出去了，还在喊着什么？",
                            "choices": [
                                {
                                    "id": "698090515",
                                    "text": "啊？！",
                                    "response": [
                                        {
                                            "id": "698090517",
                                            "speaker": "安柏",
                                            "text": "呜哇！玛格丽特小姐正在追一个人，难道是小偷不成？"
                                        },
                                        {
                                            "id": "698090518",
                                            "speaker": "安柏",
                                            "text": "#{NICKNAME}你在这里等着，我过去帮忙！不能让那家伙跑掉！"
                                        },
                                        {
                                            "id": "698090519",
                                            "speaker": "安柏",
                                            "text": "前面那个人！给我站住——"
                                        }
                                    ]
                                },
                                {
                                    "id": "698090516",
                                    "text": "我，我啥也没看见啊？"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "698090508",
                    "text": "平时太辛苦了。"
                }
            ]
        }
    ]
}