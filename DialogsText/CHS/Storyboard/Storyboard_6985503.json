{
    "talkId": "6985503",
    "total_dialogue_lines": 53,
    "speaker_counts": {
        "Player": 7,
        "伊涅芙": 14,
        "派蒙": 8,
        "爱诺": 24
    },
    "dialogues": [
        {
            "id": "698550301",
            "speaker": "爱诺",
            "text": "伊涅芙。"
        },
        {
            "id": "698550302",
            "speaker": "伊涅芙",
            "text": "嗯？"
        },
        {
            "id": "698550303",
            "speaker": "爱诺",
            "text": "你喜欢小猫吗？"
        },
        {
            "id": "698550304",
            "speaker": "伊涅芙",
            "text": "按照之前的规律，当爱诺问出「你喜欢吃零食吗」之类的句式时，实际是爱诺想吃零食。"
        },
        {
            "id": "698550305",
            "speaker": "伊涅芙",
            "text": "爱诺想要养小猫？"
        },
        {
            "id": "698550306",
            "speaker": "爱诺",
            "text": "嘻嘻。不觉得阿舍鲁很可爱吗？"
        },
        {
            "id": "698550307",
            "speaker": "伊涅芙",
            "text": "爱诺。我们讨论过了，我们的屋子里不太适合养宠物。"
        },
        {
            "id": "698550308",
            "speaker": "爱诺",
            "text": "我知道啦。我不会养猫的。之前都和伊涅芙约好了。"
        },
        {
            "id": "698550309",
            "speaker": "爱诺",
            "text": "但是伊涅芙…嘻嘻，你觉得猫猫可爱吗？"
        },
        {
            "id": "698550310",
            "speaker": "伊涅芙",
            "text": "很可爱。如果爱诺能帮我做出能够不被猫毛堵住的吸尘器的话，猫就更可爱了。"
        },
        {
            "id": "698550311",
            "speaker": "爱诺",
            "text": "嘿嘿，那个之后再帮你做。但在那之前，我问问你喔。"
        },
        {
            "id": "698550312",
            "speaker": "爱诺",
            "text": "伊涅芙，你想变成小猫咪的模样吗？"
        },
        {
            "id": "698550313",
            "speaker": "伊涅芙",
            "text": "…爱诺，我不理解。"
        },
        {
            "id": "698550314",
            "speaker": "派蒙",
            "text": "什么？！伊涅芙要变成猫？"
        },
        {
            "id": "698550315",
            "speaker": "爱诺",
            "text": "#{NICKNAME}，派蒙！你们过来找我玩吗？"
        },
        {
            "id": "698550316",
            "speaker": "爱诺",
            "text": "来得正好！你们喜欢吃零食吗？我请你们吃吧！我也陪着客人们一起吃点，嘻嘻。"
        },
        {
            "id": "698550317",
            "speaker": "派蒙",
            "text": "我挺喜欢吃的…但这样不太好吧？",
            "choices": [
                {
                    "id": "698550318",
                    "text": "没猜错的话…",
                    "response": [
                        {
                            "id": "698550320",
                            "speaker": "爱诺",
                            "text": "你、你们难道也搭载了零食摄入量的计算模块…"
                        },
                        {
                            "id": "698550321",
                            "speaker": "派蒙",
                            "text": "还好我吃饱了才过来的，不然肯定禁不住诱惑！",
                            "choices": [
                                {
                                    "id": "698550322",
                                    "text": "比起零食…",
                                    "response": [
                                        {
                                            "id": "698550324",
                                            "speaker": "爱诺",
                                            "text": "这是因为，我听见一些坏小孩背地里说伊涅芙总是穿一套衣服，看起来很没趣。"
                                        },
                                        {
                                            "id": "698550325",
                                            "speaker": "爱诺",
                                            "text": "伊涅芙可好看了，也很有趣，那帮小孩真是没审美！"
                                        },
                                        {
                                            "id": "698550326",
                                            "speaker": "爱诺",
                                            "text": "不过，后来我转念一想…在打造伊涅芙的时候，我确实没有问过她喜不喜欢这样的造型。"
                                        },
                                        {
                                            "id": "698550327",
                                            "speaker": "派蒙",
                                            "text": "所以你想让…伊涅芙换一个造型？"
                                        },
                                        {
                                            "id": "698550328",
                                            "speaker": "爱诺",
                                            "text": "嘿嘿，偶尔换一身装扮，也挺不错的呀。"
                                        },
                                        {
                                            "id": "698550329",
                                            "speaker": "爱诺",
                                            "text": "不过我会以伊涅芙的意愿为主的，毕竟我可是很开明的家长嘛。"
                                        },
                                        {
                                            "id": "698550330",
                                            "speaker": "伊涅芙",
                                            "text": "爱诺打造的机体相当完美与便利，我并不在意这样的问题。"
                                        },
                                        {
                                            "id": "698550331",
                                            "speaker": "伊涅芙",
                                            "text": "如果听见了糟糕的话，我也会直接删除，或者直接关闭听觉系统。所以爱诺刚刚提到的事，对我来说并不成问题。"
                                        },
                                        {
                                            "id": "698550332",
                                            "speaker": "派蒙",
                                            "text": "欸…那要是爱诺吵着要吃蛋卷，你也会关掉那个…听觉系统吗？"
                                        },
                                        {
                                            "id": "698550333",
                                            "speaker": "伊涅芙",
                                            "text": "不会的，爱诺所说的所有话，我都会听到和记住。因为爱诺是重要的家人。"
                                        },
                                        {
                                            "id": "698550334",
                                            "speaker": "伊涅芙",
                                            "text": "你们所说的话也是，你们是我重要的朋友。"
                                        },
                                        {
                                            "id": "698550335",
                                            "speaker": "伊涅芙",
                                            "text": "迄今为止，在我的记录中，派蒙和爱诺所说的话，大部分都是要吃各类甜食，或者是偷偷商量着出去吃东西。"
                                        },
                                        {
                                            "id": "698550336",
                                            "speaker": "伊涅芙",
                                            "text": "最晚的一次记录发生在半夜，我想，二位还是少吃一点比较好。"
                                        },
                                        {
                                            "id": "698550337",
                                            "speaker": "爱诺",
                                            "text": "呜——"
                                        },
                                        {
                                            "id": "698550338",
                                            "speaker": "派蒙",
                                            "text": "这些…也不用记得这么牢啦…"
                                        },
                                        {
                                            "id": "698550339",
                                            "speaker": "伊涅芙",
                                            "text": "#而{NICKNAME}所说的话，一部分是在讨论委托，一部分是在关心和帮助朋友，还有一部分是在处理各类危机。"
                                        },
                                        {
                                            "id": "698550340",
                                            "speaker": "伊涅芙",
                                            "text": "#{NICKNAME}，还是休息一下比较好。",
                                            "choices": [
                                                {
                                                    "id": "698550341",
                                                    "text": "放心啦，我心里有数。",
                                                    "response": [
                                                        {
                                                            "id": "698550343",
                                                            "speaker": "爱诺",
                                                            "text": "#好啦好啦，现在就是{NICKNAME}休息的好时候。"
                                                        },
                                                        {
                                                            "id": "698550344",
                                                            "speaker": "爱诺",
                                                            "text": "决定了！我要给伊涅芙做一套漂亮的猫猫套装，派蒙，来帮我的忙！"
                                                        },
                                                        {
                                                            "id": "698550345",
                                                            "speaker": "爱诺",
                                                            "text": "嗯…顺便也给派蒙做一套好了…"
                                                        },
                                                        {
                                                            "id": "698550346",
                                                            "speaker": "Player",
                                                            "text": "好！"
                                                        },
                                                        {
                                                            "id": "698550347",
                                                            "speaker": "派蒙",
                                                            "text": "别替我答应啊！"
                                                        },
                                                        {
                                                            "id": "698550348",
                                                            "speaker": "派蒙",
                                                            "text": "呃…不过…要是好看的话，也不是不行啦，嘿嘿…"
                                                        },
                                                        {
                                                            "id": "698550349",
                                                            "speaker": "爱诺",
                                                            "text": "好嘞，就这么决定了。伊涅芙，做一些蛋卷来吧，等你做好蛋卷，我肯定也做好你的装饰了。"
                                                        },
                                                        {
                                                            "id": "698550350",
                                                            "speaker": "爱诺",
                                                            "text": "我看看喔…扳手，在这里。钳子，在这里…咦？怎么这里还有一颗「蛋卷螺栓」。"
                                                        },
                                                        {
                                                            "id": "698550351",
                                                            "speaker": "爱诺",
                                                            "text": "#{NICKNAME}，喏，这个送给你。这是我之前无聊的时候做的小工艺品，你拿着留作纪念吧。"
                                                        },
                                                        {
                                                            "id": "698550352",
                                                            "speaker": "爱诺",
                                                            "text": "它应该有什么具体用途的…唔，但我现在记不清了，等我记起来了再告诉你。"
                                                        },
                                                        {
                                                            "id": "698550353",
                                                            "speaker": "爱诺",
                                                            "text": "现在的重点，是给伊涅芙和派蒙做一套漂漂亮亮的猫猫衣服！"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "698550342",
                                                    "text": "办完正事就会休息。"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "698550323",
                                    "text": "我更在意伊涅芙变猫的事！"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "698550319",
                    "text": "爱诺今天已经吃过了吧？"
                }
            ]
        }
    ]
}