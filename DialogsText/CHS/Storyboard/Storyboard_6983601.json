{
    "talkId": "6983601",
    "total_dialogue_lines": 19,
    "speaker_counts": {
        "Player": 5,
        "夏沃蕾": 12,
        "法代纳": 2
    },
    "dialogues": [
        {
            "id": "698360101",
            "speaker": "夏沃蕾",
            "text": "前面的！不许停下！还落在后面的人，回来继续加练！"
        },
        {
            "id": "698360102",
            "speaker": "夏沃蕾",
            "text": "速度提起来！你们是在跑步还是在散步！"
        },
        {
            "id": "698360103",
            "speaker": "Player",
            "text": "夏沃蕾！后面有好多人倒下了！"
        },
        {
            "id": "698360104",
            "speaker": "夏沃蕾",
            "text": "是么？看来明天要给他们再加点训练量了。"
        },
        {
            "id": "698360105",
            "speaker": "夏沃蕾",
            "text": "一个紧急战斗冲刺训练就能累成这样…平时体能训练偷的那些懒，现在全都要还回来。"
        },
        {
            "id": "698360106",
            "speaker": "夏沃蕾",
            "text": "俯卧撑只做半程，引体向上横杆不过胸，跑操时靠着内侧跑…你们以为我不知道么？"
        },
        {
            "id": "698360107",
            "speaker": "夏沃蕾",
            "text": "这样还怎么扛着铳枪作战？要是罪犯逃跑的话，他们难道还要卸下负重再追么？",
            "choices": [
                {
                    "id": "698360108",
                    "text": "具体训练内容是什么？",
                    "response": [
                        {
                            "id": "698360110",
                            "speaker": "夏沃蕾",
                            "text": "没什么，就是背着负重，在限定时间内跑到指定的地点，找到指定的器具，然后再跑回来罢了。"
                        },
                        {
                            "id": "698360111",
                            "speaker": "夏沃蕾",
                            "text": "他们的负重剔除了行军时的物品，只包括铳枪、弹药、观通装备、防护器具与药品。"
                        },
                        {
                            "id": "698360112",
                            "speaker": "Player",
                            "text": "那…位置是怎么指定的？"
                        },
                        {
                            "id": "698360113",
                            "speaker": "夏沃蕾",
                            "text": "就是朝着远方发射一发信号烟雾箭，箭落下的位置，就是他们要抵达并展开战斗的阵位。"
                        },
                        {
                            "id": "698360114",
                            "speaker": "Player",
                            "text": "射箭啊…那应该也没多远…"
                        },
                        {
                            "id": "698360115",
                            "speaker": "法代纳",
                            "text": "队长…那您…也别用警备机关射啊…"
                        },
                        {
                            "id": "698360116",
                            "speaker": "夏沃蕾",
                            "text": "要是你们下次训练还不达标，我就要用铳枪射击信号弹了。"
                        },
                        {
                            "id": "698360117",
                            "speaker": "夏沃蕾",
                            "text": "休息得差不多了，该重新开始了，后面还有几个人掉队了，我也会去督促他们。"
                        },
                        {
                            "id": "698360118",
                            "speaker": "夏沃蕾",
                            "text": "现在，站起来，继续跑。爬也给我爬去终点！"
                        },
                        {
                            "id": "698360119",
                            "speaker": "法代纳",
                            "text": "队长！您饶了我吧——"
                        }
                    ]
                },
                {
                    "id": "698360109",
                    "text": "感觉好复杂…"
                }
            ]
        }
    ]
}