{
    "talkId": "6986101",
    "total_dialogue_lines": 33,
    "speaker_counts": {
        "Player": 12,
        "米卡": 21
    },
    "dialogues": [
        {
            "id": "698610101",
            "speaker": "米卡",
            "text": "差不多这样就可以了…",
            "choices": [
                {
                    "id": "698610102",
                    "text": "米卡？你怎么来了？",
                    "response": [
                        {
                            "id": "698610104",
                            "speaker": "米卡",
                            "text": "#{NICKNAME}？你好啊，没想到会在这里遇见你…"
                        },
                        {
                            "id": "698610105",
                            "speaker": "米卡",
                            "text": "呃，其实我应该想到的…琴团长和我提到过，你会前往挪德卡莱，就是不知道具体什么时候抵达。"
                        },
                        {
                            "id": "698610106",
                            "speaker": "米卡",
                            "text": "没想到，我刚刚进入挪德卡莱，就遇见你了。",
                            "choices": [
                                {
                                    "id": "698610107",
                                    "text": "骑士团的大家知道我来了？",
                                    "response": [
                                        {
                                            "id": "698610109",
                                            "speaker": "米卡",
                                            "text": "对，法尔伽大团长不是给你寄了一封信吗？他也寄信回蒙德了，把你的情况都告诉了我们。"
                                        },
                                        {
                                            "id": "698610110",
                                            "speaker": "米卡",
                                            "text": "骑士团的大家还想着怎么支援你呢，但大团长的信里却让我们不要冒动，事情他都已经安排好了…",
                                            "choices": [
                                                {
                                                    "id": "698610111",
                                                    "text": "确实都安排好了，放心啦。",
                                                    "response": [
                                                        {
                                                            "id": "698610113",
                                                            "speaker": "米卡",
                                                            "text": "法尔伽大团长安排正经事情的时候，总是很可靠的。这一点我们都放心。"
                                                        },
                                                        {
                                                            "id": "698610114",
                                                            "speaker": "米卡",
                                                            "text": "不过，如果你遇见了什么麻烦，需要西风骑士团的直接帮助，请随时开口。我们随时都可以为你提供支援。"
                                                        },
                                                        {
                                                            "id": "698610115",
                                                            "speaker": "米卡",
                                                            "text": "你可是我们西风骑士团的「荣誉骑士」，是我们骑士团里重要的一员。"
                                                        },
                                                        {
                                                            "id": "698610116",
                                                            "speaker": "米卡",
                                                            "text": "这是我离开蒙德的时候，琴团长让我转告你的。",
                                                            "choices": [
                                                                {
                                                                    "id": "698610117",
                                                                    "text": "我现在就想喝苹果酿。",
                                                                    "response": [
                                                                        {
                                                                            "id": "698610119",
                                                                            "speaker": "米卡",
                                                                            "text": "欸？啊…！你等一下，虽然我没带甜甜花酿鸡，但我真的带了一瓶最好的苹果酿。"
                                                                        },
                                                                        {
                                                                            "id": "698610120",
                                                                            "speaker": "米卡",
                                                                            "text": "这是凯亚队长让我带着的，他说，你肯定很想念苹果酿的味道，带上一瓶准没错。",
                                                                            "choices": [
                                                                                {
                                                                                    "id": "698610121",
                                                                                    "text": "凯亚连这都想到了…",
                                                                                    "response": [
                                                                                        {
                                                                                            "id": "698610123",
                                                                                            "speaker": "米卡",
                                                                                            "text": "稍等，我拿给你喔…我放在包里，用衣服包好了…"
                                                                                        },
                                                                                        {
                                                                                            "id": "698610124",
                                                                                            "speaker": "米卡",
                                                                                            "text": "找到了！喏，快点尝尝吧。",
                                                                                            "choices": [
                                                                                                {
                                                                                                    "id": "698610125",
                                                                                                    "text": "没给大团长带点酒？",
                                                                                                    "response": [
                                                                                                        {
                                                                                                            "id": "698610127",
                                                                                                            "speaker": "米卡",
                                                                                                            "text": "带了啊，我走的时候，大团长特意叮嘱我，要我带几瓶品质最好的「蒲公英酒」给他。"
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "698610128",
                                                                                                            "speaker": "米卡",
                                                                                                            "text": "本来琴团长说，这次去挪德卡莱路途遥远，主要任务还是送信，没必要给我增加额外负重，就别带酒了，她之后再找人运送过去…"
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "698610129",
                                                                                                            "speaker": "米卡",
                                                                                                            "text": "但我想来想去，还是塞了两瓶酒，准备带回去给大团长。"
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "698610130",
                                                                                                            "speaker": "米卡",
                                                                                                            "text": "不然，在蒲公英酒运过来之前，他肯定又要每天在我耳朵旁边念叨「蒲公英酒」到底有多好喝了…"
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "698610131",
                                                                                                            "speaker": "米卡",
                                                                                                            "text": "对了，有时间的话回骑士团坐坐吧，这样才能吃到刚出炉的甜甜花酿鸡和烤肉排。"
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "698610132",
                                                                                                            "speaker": "米卡",
                                                                                                            "text": "嘿嘿，这句话是安柏小姐让我转告你的。"
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "698610133",
                                                                                                            "speaker": "米卡",
                                                                                                            "text": "好啦，该转告的话都转告完了，我也该出发了。再见啦，「荣誉骑士」。"
                                                                                                        }
                                                                                                    ]
                                                                                                },
                                                                                                {
                                                                                                    "id": "698610126",
                                                                                                    "text": "我听说他可喜欢酒了。"
                                                                                                }
                                                                                            ]
                                                                                        }
                                                                                    ]
                                                                                },
                                                                                {
                                                                                    "id": "698610122",
                                                                                    "text": "该说不愧是凯亚吗…"
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                },
                                                                {
                                                                    "id": "698610118",
                                                                    "text": "我现在就想吃甜甜花酿鸡。"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "698610112",
                                                    "text": "连住的地方都是最好的。"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "698610108",
                                    "text": "难道是法尔伽大团长…"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "698610103",
                    "text": "又是来送信的么？"
                }
            ]
        }
    ]
}