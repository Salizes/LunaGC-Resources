{
    "talkId": "6980701",
    "total_dialogue_lines": 29,
    "speaker_counts": {
        "Player": 7,
        "行秋": 22
    },
    "dialogues": [
        {
            "id": "698070101",
            "speaker": "行秋",
            "text": "「落玉一夜裁，春雨几度开…」"
        },
        {
            "id": "698070102",
            "speaker": "行秋",
            "text": "不对不对，怎么又读到现在了，该练剑了…"
        },
        {
            "id": "698070103",
            "speaker": "Player",
            "text": "行秋？你在做什么呢？"
        },
        {
            "id": "698070104",
            "speaker": "行秋",
            "text": "#{NICKNAME}，真是巧了，能在这里遇见你，我正在这里练剑呢。"
        },
        {
            "id": "698070105",
            "speaker": "行秋",
            "text": "唔，这么说也不对，应该说我正在练字呢。",
            "choices": [
                {
                    "id": "698070106",
                    "text": "你用剑来练字？",
                    "response": [
                        {
                            "id": "698070107",
                            "speaker": "行秋",
                            "text": "是啊。怎么样，还算新奇吧？"
                        },
                        {
                            "id": "698070110",
                            "speaker": "行秋",
                            "text": "你瞧这周围的落叶，都是我练字的字帖。被从中间斩开的是正书，顺着叶脉斩开的是素书，斩碎了的则是行书。"
                        },
                        {
                            "id": "698070111",
                            "speaker": "Player",
                            "text": "什…什么书？"
                        },
                        {
                            "id": "698070112",
                            "speaker": "行秋",
                            "text": "哈哈哈，这都是些书法风格的名字，每种风格都各有特色，有的端正规整，有的则肆意挥洒…"
                        },
                        {
                            "id": "698070113",
                            "speaker": "行秋",
                            "text": "哎呀，我练得倒是开心，就是对不起这周围的竹子…"
                        },
                        {
                            "id": "698070114",
                            "speaker": "行秋",
                            "text": "行秋行秋，这下子我可真是让这片林子遭了一阵秋风啦。"
                        },
                        {
                            "id": "698070115",
                            "speaker": "Player",
                            "text": "你刚才念的，难道是什么秘诀？"
                        },
                        {
                            "id": "698070116",
                            "speaker": "行秋",
                            "text": "秘诀？哈哈哈，不是不是，我刚才只是在读这本《洗墨录》里的注释。"
                        },
                        {
                            "id": "698070117",
                            "speaker": "行秋",
                            "text": "这本《洗墨录》可是一本奇书啊，是一位书法大家羲帆所著，据说他由书法入剑法，从此练就了一身书剑双绝的本领。"
                        },
                        {
                            "id": "698070118",
                            "speaker": "行秋",
                            "text": "之后他也不藏私，将自己的剑法刻在了一座石碑上，取名叫做《洗墨录》，任凭天下英才前来观看。"
                        },
                        {
                            "id": "698070119",
                            "speaker": "行秋",
                            "text": "这本《洗墨录》可是难得的「原迹注释本」，内容文字都是拓写自那座石碑的原迹，是我大哥的宝贝收藏。"
                        },
                        {
                            "id": "698070120",
                            "speaker": "行秋",
                            "text": "我大哥这人啊，平日里大方慷慨，但就是视书如命，爱书成痴，每逢有人上门借书时，都要和他磨大半天嘴皮子。"
                        },
                        {
                            "id": "698070121",
                            "speaker": "行秋",
                            "text": "前几天他居然亲手把这本《洗墨录》交给我，叮嘱我认真练字，还把我吓了一跳呢。"
                        },
                        {
                            "id": "698070122",
                            "speaker": "行秋",
                            "text": "我还以为自己因为写字太差，要被我爹逐出家门，大哥提前收到消息，送我这本书当临别礼物。"
                        },
                        {
                            "id": "698070123",
                            "speaker": "行秋",
                            "text": "哎呀，当时我和大哥都双目泪垂，两人握着书的手也是久久不愿松开…",
                            "choices": [
                                {
                                    "id": "698070124",
                                    "text": "他应该是舍不得书…",
                                    "response": [
                                        {
                                            "id": "698070126",
                                            "speaker": "行秋",
                                            "text": "哈哈哈哈哈，你这人，你这人！张口就把事情说得这样明白，我还觉着这场景挺有趣的，想要写进小说里呢。"
                                        },
                                        {
                                            "id": "698070127",
                                            "speaker": "行秋",
                                            "text": "如果把你接的话也写进书里，肯定也别有一番趣味…"
                                        },
                                        {
                                            "id": "698070128",
                                            "speaker": "行秋",
                                            "text": "啊呀！一和你聊天就忘了时间，都这么晚了，我得快些回家了。"
                                        },
                                        {
                                            "id": "698070129",
                                            "speaker": "行秋",
                                            "text": "#{NICKNAME}，回头再见啦。"
                                        }
                                    ]
                                },
                                {
                                    "id": "698070125",
                                    "text": "你应该是不想练字…"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "698070108",
                    "text": "那你的笔还有点危险…",
                    "response": [
                        {
                            "id": "698070109",
                            "speaker": "行秋",
                            "text": "哈哈哈，放心吧，我已经练完了，早就收笔入匣，不危险不危险。"
                        }
                    ]
                }
            ]
        }
    ]
}