{
    "talkId": "6983003",
    "total_dialogue_lines": 23,
    "speaker_counts": {
        "Player": 8,
        "鹿野院平藏": 15
    },
    "dialogues": [
        {
            "id": "698300301",
            "speaker": "鹿野院平藏",
            "text": "嗯，今天花见坂的治安还算不错嘛。"
        },
        {
            "id": "698300302",
            "speaker": "鹿野院平藏",
            "text": "呼啊——"
        },
        {
            "id": "698300303",
            "speaker": "鹿野院平藏",
            "text": "哎呀，出都出来了，先吃点东西，再回去向九条大人交差…",
            "choices": [
                {
                    "id": "698300304",
                    "text": "抓到你了！",
                    "response": [
                        {
                            "id": "698300306",
                            "speaker": "鹿野院平藏",
                            "text": "错误！我作为同心的工作刚刚结束了，作为侦探的工作还没有开始。"
                        },
                        {
                            "id": "698300307",
                            "speaker": "鹿野院平藏",
                            "text": "#{NICKNAME}，你这句指控有点太不严谨了。",
                            "choices": [
                                {
                                    "id": "698300308",
                                    "text": "平藏又在玩文字游戏了。",
                                    "response": [
                                        {
                                            "id": "698300310",
                                            "speaker": "鹿野院平藏",
                                            "text": "我刚才可没开玩笑。我正准备开始侦探工作呢。"
                                        },
                                        {
                                            "id": "698300311",
                                            "speaker": "鹿野院平藏",
                                            "text": "最近，花见坂附近出现了一群到处兜售违禁药水的人。"
                                        },
                                        {
                                            "id": "698300312",
                                            "speaker": "鹿野院平藏",
                                            "text": "那群人原本是正经的生意人，也不知道怎么的，突然走了偏路。"
                                        },
                                        {
                                            "id": "698300313",
                                            "speaker": "鹿野院平藏",
                                            "text": "他们拿原来的正经生意做掩护，一直和我们绕圈子，同心们追查了好久，也找不到决定性的证据。"
                                        },
                                        {
                                            "id": "698300314",
                                            "speaker": "鹿野院平藏",
                                            "text": "所以，我就打算以我自己的方法，来为这桩案子找到突破口。",
                                            "choices": [
                                                {
                                                    "id": "698300315",
                                                    "text": "要帮忙吗？",
                                                    "response": [
                                                        {
                                                            "id": "698300317",
                                                            "speaker": "鹿野院平藏",
                                                            "text": "#哈哈哈，谢谢你啦，{NICKNAME}。但这件案子的严重程度还没到需要你出手的份上。"
                                                        },
                                                        {
                                                            "id": "698300318",
                                                            "speaker": "鹿野院平藏",
                                                            "text": "我已经拜托了珊瑚她们暗中调查了一段时间，线索搜集得差不多了。"
                                                        },
                                                        {
                                                            "id": "698300319",
                                                            "speaker": "鹿野院平藏",
                                                            "text": "接下来…就要看我的了。",
                                                            "choices": [
                                                                {
                                                                    "id": "698300320",
                                                                    "text": "名侦探平藏一定没问题。",
                                                                    "response": [
                                                                        {
                                                                            "id": "698300322",
                                                                            "speaker": "鹿野院平藏",
                                                                            "text": "#那就借你吉言了，{NICKNAME}。"
                                                                        },
                                                                        {
                                                                            "id": "698300323",
                                                                            "speaker": "鹿野院平藏",
                                                                            "text": "要是这桩案子真能顺利结案，我一定请你吃好吃的。"
                                                                        }
                                                                    ]
                                                                },
                                                                {
                                                                    "id": "698300321",
                                                                    "text": "肯定能顺利破案。"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "698300316",
                                                    "text": "我们一起？"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "698300309",
                                    "text": "那你什么时候开始侦探工作？"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "698300305",
                    "text": "没有专心工作的侦探！"
                }
            ]
        }
    ]
}