{
    "talkId": "6985602",
    "total_dialogue_lines": 53,
    "speaker_counts": {
        "Player": 12,
        "伊涅芙": 31,
        "派蒙": 7,
        "雅珂达": 3
    },
    "dialogues": [
        {
            "id": "698560201",
            "speaker": "伊涅芙",
            "text": "……"
        },
        {
            "id": "698560202",
            "speaker": "Player",
            "text": "伊涅芙？"
        },
        {
            "id": "698560203",
            "speaker": "伊涅芙",
            "text": "……",
            "choices": [
                {
                    "id": "698560204",
                    "text": "难道是睡着了？",
                    "response": [
                        {
                            "id": "698560206",
                            "speaker": "雅珂达",
                            "text": "呼…呼…"
                        },
                        {
                            "id": "698560207",
                            "speaker": "派蒙",
                            "text": "雅珂达怎么也在旁边？而且还…睡着了？"
                        },
                        {
                            "id": "698560208",
                            "speaker": "派蒙",
                            "text": "这到底是什么情况，总觉得放着不管会出问题…要不去找爱诺想想办法？"
                        },
                        {
                            "id": "698560209",
                            "speaker": "伊涅芙",
                            "text": "检测到关键词，冥想状态暂时结束。"
                        },
                        {
                            "id": "698560210",
                            "speaker": "派蒙",
                            "text": "呜哇，吓我一跳！"
                        },
                        {
                            "id": "698560211",
                            "speaker": "Player",
                            "text": "机器人也需要冥想吗？"
                        },
                        {
                            "id": "698560212",
                            "speaker": "伊涅芙",
                            "text": "不，是雅珂达的请求。她拜托我帮忙解析冥想的详细步骤，并指导她进行冥想修习，以疏解自己的精神压力。"
                        },
                        {
                            "id": "698560213",
                            "speaker": "派蒙",
                            "text": "雅珂达的精神压力，已经大到需要借助冥想来疏解了吗？",
                            "choices": [
                                {
                                    "id": "698560214",
                                    "text": "难道她有什么烦心事？",
                                    "response": [
                                        {
                                            "id": "698560216",
                                            "speaker": "伊涅芙",
                                            "text": "不知道。但雅珂达说，她已经失眠了很久，无论什么解决方法都想要试一试。"
                                        },
                                        {
                                            "id": "698560217",
                                            "speaker": "伊涅芙",
                                            "text": "首先，我尝试让她坐在厨房里，闭上眼睛，将注意力集中在蛋卷的香味上。"
                                        },
                                        {
                                            "id": "698560218",
                                            "speaker": "伊涅芙",
                                            "text": "通过激活嗅觉模块，思维模块的活跃度应该会相应减弱…"
                                        },
                                        {
                                            "id": "698560219",
                                            "speaker": "Player",
                                            "text": "那么成功了吗？"
                                        },
                                        {
                                            "id": "698560220",
                                            "speaker": "伊涅芙",
                                            "text": "成功地激活了她的食欲。她将做好的蛋卷一口气吃完了。"
                                        },
                                        {
                                            "id": "698560221",
                                            "speaker": "伊涅芙",
                                            "text": "因为吃得太撑，她又一次失眠了。"
                                        },
                                        {
                                            "id": "698560222",
                                            "speaker": "派蒙",
                                            "text": "这也正常啦…毕竟我们不是伊涅芙，普通人闻到香味的时候，只会越闻越想吃啦…"
                                        },
                                        {
                                            "id": "698560223",
                                            "speaker": "伊涅芙",
                                            "text": "是的。随后我们又尝试，让她在睡前进行剧烈的体力或脑力运动。例如伐木，长跑，俯卧撑，拳击等。"
                                        },
                                        {
                                            "id": "698560224",
                                            "speaker": "伊涅芙",
                                            "text": "大量消耗能量后，机体应该会更容易进入到休眠模式。"
                                        },
                                        {
                                            "id": "698560225",
                                            "speaker": "Player",
                                            "text": "那…好像也没成功？"
                                        },
                                        {
                                            "id": "698560226",
                                            "speaker": "伊涅芙",
                                            "text": "没有。她运动到一半的时候，想起自己还有一项委托待办，半路赶去完成了那一项委托。"
                                        },
                                        {
                                            "id": "698560227",
                                            "speaker": "伊涅芙",
                                            "text": "回来后，抱着膝盖蹲在墙角，说："
                                        },
                                        {
                                            "id": "698560228",
                                            "speaker": "伊涅芙",
                                            "text": "「啊…因为刚才练得太累，带人穿越遗迹的时候，腿脚都使不上力，一路连滚带爬…奈姐要是知道的话，我就完蛋了…」"
                                        },
                                        {
                                            "id": "698560229",
                                            "speaker": "伊涅芙",
                                            "text": "然后，她又失眠了。"
                                        },
                                        {
                                            "id": "698560230",
                                            "speaker": "伊涅芙",
                                            "text": "最后，我们决定再试试冥想。"
                                        },
                                        {
                                            "id": "698560231",
                                            "speaker": "雅珂达",
                                            "text": "奈姐…奈姐，别…别…我不偷你茶喝了…呼…"
                                        },
                                        {
                                            "id": "698560232",
                                            "speaker": "派蒙",
                                            "text": "看来，冥想确实起作用了呢。雅珂达睡得很沉啊。",
                                            "choices": [
                                                {
                                                    "id": "698560233",
                                                    "text": "都开始说梦话了。",
                                                    "response": [
                                                        {
                                                            "id": "698560235",
                                                            "speaker": "伊涅芙",
                                                            "text": "我认为雅珂达的睡眠，和冥想并无直接关系。"
                                                        },
                                                        {
                                                            "id": "698560236",
                                                            "speaker": "伊涅芙",
                                                            "text": "首先，我解析的冥想步骤，实际上并不适合雅珂达使用。"
                                                        },
                                                        {
                                                            "id": "698560237",
                                                            "speaker": "伊涅芙",
                                                            "text": "冥想的目的，是获得深度宁静状态，在此基础上增强自我认知。"
                                                        },
                                                        {
                                                            "id": "698560238",
                                                            "speaker": "伊涅芙",
                                                            "text": "对于普通人来说，深度宁静状态接近于「假寐」。"
                                                        },
                                                        {
                                                            "id": "698560239",
                                                            "speaker": "伊涅芙",
                                                            "text": "对我来说，深度宁静状态则是关闭部分结构后的「半停机休眠」。"
                                                        },
                                                        {
                                                            "id": "698560240",
                                                            "speaker": "伊涅芙",
                                                            "text": "如果想要关闭雅珂达的部分结构，我想，会对她的人身安全有所危害。"
                                                        },
                                                        {
                                                            "id": "698560241",
                                                            "speaker": "派蒙",
                                                            "text": "所以，其实冥想也不管用啊…那雅珂达是怎么睡着的？不会真的是…累到睡着的吧…"
                                                        },
                                                        {
                                                            "id": "698560242",
                                                            "speaker": "伊涅芙",
                                                            "text": "事实上，我也不理解。我只能将当时的情况，复述给你们。"
                                                        },
                                                        {
                                                            "id": "698560243",
                                                            "speaker": "伊涅芙",
                                                            "text": "当雅珂达躺下，试着以冥想的方式睡着时，突然对我说："
                                                        },
                                                        {
                                                            "id": "698560244",
                                                            "speaker": "伊涅芙",
                                                            "text": "「不要离我太远，不然我要是在睡觉的时候被偷袭，就完蛋了。」"
                                                        },
                                                        {
                                                            "id": "698560245",
                                                            "speaker": "伊涅芙",
                                                            "text": "我回答：「好的。我会一直守在你身边。」"
                                                        },
                                                        {
                                                            "id": "698560246",
                                                            "speaker": "伊涅芙",
                                                            "text": "然后，和每天晚上哄爱诺睡觉时一样，我握住了雅珂达的手。"
                                                        },
                                                        {
                                                            "id": "698560247",
                                                            "speaker": "伊涅芙",
                                                            "text": "过了一会之后，雅珂达就睡着了。"
                                                        },
                                                        {
                                                            "id": "698560248",
                                                            "speaker": "雅珂达",
                                                            "text": "笨…笨蛋…机器人…这可是我…自己做的…呼…呼…",
                                                            "choices": [
                                                                {
                                                                    "id": "698560249",
                                                                    "text": "总之，能够好好休息就行。",
                                                                    "response": [
                                                                        {
                                                                            "id": "698560251",
                                                                            "speaker": "伊涅芙",
                                                                            "text": "嗯。如果你们也需要助眠，请尽管来找我。不过，我只能同时握住两只手，请谅解。"
                                                                        },
                                                                        {
                                                                            "id": "698560252",
                                                                            "speaker": "伊涅芙",
                                                                            "text": "对了，在之前做手工时，我做了几枚「蛋卷螺栓」，送了一枚给雅珂达，也送你一枚。"
                                                                        },
                                                                        {
                                                                            "id": "698560253",
                                                                            "speaker": "伊涅芙",
                                                                            "text": "再见，祝你睡个好觉。"
                                                                        }
                                                                    ]
                                                                },
                                                                {
                                                                    "id": "698560250",
                                                                    "text": "让她睡吧，我们就不打扰了。"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "698560234",
                                                    "text": "果然是因为奈芙尔啊…"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "698560215",
                                    "text": "难道是又被奈芙尔派了工作？"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "698560205",
                    "text": "难道是没电了？"
                }
            ]
        }
    ]
}