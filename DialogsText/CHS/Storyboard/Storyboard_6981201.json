{
    "talkId": "6981201",
    "total_dialogue_lines": 41,
    "speaker_counts": {
        "Player": 5,
        "瑶瑶": 21,
        "萍姥姥": 15
    },
    "dialogues": [
        {
            "id": "698120101",
            "speaker": "瑶瑶",
            "text": "师父，请看这一式。"
        },
        {
            "id": "698120102",
            "speaker": "萍姥姥",
            "text": "嗯，不错不错。"
        },
        {
            "id": "698120103",
            "speaker": "瑶瑶",
            "text": "紧接着要接这一招…保持重心，握紧长枪…身前不能露出破绽。"
        },
        {
            "id": "698120104",
            "speaker": "瑶瑶",
            "text": "#哎呀，{NICKNAME}{M#哥哥}{F#姐姐}，别来无恙呀。"
        },
        {
            "id": "698120105",
            "speaker": "萍姥姥",
            "text": "好久不见。",
            "choices": [
                {
                    "id": "698120106",
                    "text": "姥姥好，我就在一边偷偷师。",
                    "response": [
                        {
                            "id": "698120108",
                            "speaker": "瑶瑶",
                            "text": "不耽误不耽误。正好也想请你看看我的进步。嘿！"
                        },
                        {
                            "id": "698120109",
                            "speaker": "萍姥姥",
                            "text": "这孩子…继续吧。衣巾落枣花，古柳送长沙，落枣三式，接送古柳。"
                        },
                        {
                            "id": "698120110",
                            "speaker": "瑶瑶",
                            "text": "落枣…落枣是前戳…再上撩…喝！"
                        },
                        {
                            "id": "698120111",
                            "speaker": "萍姥姥",
                            "text": "继续，樱桃五式演完，再续上小圆花枪第六式。"
                        },
                        {
                            "id": "698120112",
                            "speaker": "瑶瑶",
                            "text": "小、小圆花枪是…师父，这枪法怎么接得上呀？"
                        },
                        {
                            "id": "698120113",
                            "speaker": "萍姥姥",
                            "text": "枪在你手上，你的手能接，枪法就能接。动。"
                        },
                        {
                            "id": "698120114",
                            "speaker": "瑶瑶",
                            "text": "要先画圆，再转回来…挑…挑高…哈！"
                        },
                        {
                            "id": "698120115",
                            "speaker": "萍姥姥",
                            "text": "不错，不错。枪法已有形状，只是在换枪法时手腕僵硬，有些生涩，要多练。"
                        },
                        {
                            "id": "698120116",
                            "speaker": "瑶瑶",
                            "text": "是！师父！我这就再重复一次！"
                        },
                        {
                            "id": "698120117",
                            "speaker": "萍姥姥",
                            "text": "呵呵…这孩子…好啦，今日暂且就练到这里吧。"
                        },
                        {
                            "id": "698120118",
                            "speaker": "瑶瑶",
                            "text": "欸？我还想比平时再多练一些呢…",
                            "choices": [
                                {
                                    "id": "698120119",
                                    "text": "真刻苦。",
                                    "response": [
                                        {
                                            "id": "698120121",
                                            "speaker": "瑶瑶",
                                            "text": "嗯…师父说过：「业精于勤而荒于嬉。」"
                                        },
                                        {
                                            "id": "698120122",
                                            "speaker": "瑶瑶",
                                            "text": "我后两天想和师父告假，但也不想为此落下每天的日课…正打算加倍努力，补在今天。"
                                        },
                                        {
                                            "id": "698120123",
                                            "speaker": "萍姥姥",
                                            "text": "你这孩子，就算是补衣服，也没有提前打补丁的说法。"
                                        },
                                        {
                                            "id": "698120124",
                                            "speaker": "萍姥姥",
                                            "text": "过来吧，辫子有些散了，姥姥帮你重新扎扎。"
                                        },
                                        {
                                            "id": "698120125",
                                            "speaker": "瑶瑶",
                                            "text": "噢！谢谢师父。"
                                        },
                                        {
                                            "id": "698120126",
                                            "speaker": "萍姥姥",
                                            "text": "爱学自是好事，「业精于勤而荒于嬉」这句话也没错。但就像扎头发的发绳，需是松紧有度方才合适。"
                                        },
                                        {
                                            "id": "698120127",
                                            "speaker": "萍姥姥",
                                            "text": "玩的时候便好好玩个痛快，之后再收了心，回来好好学习。"
                                        },
                                        {
                                            "id": "698120128",
                                            "speaker": "萍姥姥",
                                            "text": "若是心里想着玩，手里练着枪。不仅没玩好，也没学好，两般都是亏。"
                                        },
                                        {
                                            "id": "698120129",
                                            "speaker": "瑶瑶",
                                            "text": "是，瑶瑶明白了，这就去玩个痛快！"
                                        },
                                        {
                                            "id": "698120130",
                                            "speaker": "Player",
                                            "text": "我也去玩个痛快！"
                                        },
                                        {
                                            "id": "698120131",
                                            "speaker": "萍姥姥",
                                            "text": "呵呵…好啊。想好要去哪里玩吗？"
                                        },
                                        {
                                            "id": "698120132",
                                            "speaker": "瑶瑶",
                                            "text": "嗯，我想和七七一起去轻策庄郊游！"
                                        },
                                        {
                                            "id": "698120133",
                                            "speaker": "瑶瑶",
                                            "text": "这个季节雨露滋润，作物丰收，运气好的话，我们顺路就能采到草药。"
                                        },
                                        {
                                            "id": "698120134",
                                            "speaker": "瑶瑶",
                                            "text": "最重要的是，漫山遍野的树叶色彩缤纷，我想让七七亲眼看看那么漂亮的风景。"
                                        },
                                        {
                                            "id": "698120135",
                                            "speaker": "萍姥姥",
                                            "text": "行，那就去吧，路上注意安全。"
                                        },
                                        {
                                            "id": "698120136",
                                            "speaker": "瑶瑶",
                                            "text": "放心吧，师父。我现在的枪法可好啦！既能防身，还能保朋友周全。"
                                        },
                                        {
                                            "id": "698120137",
                                            "speaker": "瑶瑶",
                                            "text": "噢，师父，那这几天你也要按时吃饭，好好照顾自己哦！"
                                        },
                                        {
                                            "id": "698120138",
                                            "speaker": "萍姥姥",
                                            "text": "好好好，师父答应你。"
                                        },
                                        {
                                            "id": "698120139",
                                            "speaker": "瑶瑶",
                                            "text": "那我继续练习喽？"
                                        },
                                        {
                                            "id": "698120140",
                                            "speaker": "瑶瑶",
                                            "text": "衣巾落枣花，古柳送…送什么来着？"
                                        },
                                        {
                                            "id": "698120141",
                                            "speaker": "瑶瑶",
                                            "text": "啊！对了，我想起来了，是送长沙！"
                                        }
                                    ]
                                },
                                {
                                    "id": "698120120",
                                    "text": "我看着手都有些酸喽。"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "698120107",
                    "text": "没耽误瑶瑶练习吧？"
                }
            ]
        }
    ]
}