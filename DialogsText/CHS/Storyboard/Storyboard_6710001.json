{
    "talkId": "6710001",
    "total_dialogue_lines": 53,
    "speaker_counts": {
        "Player": 10,
        "卡尼": 6,
        "明娜": 6,
        "烟绯": 14,
        "菈乌玛": 17
    },
    "dialogues": [
        {
            "id": "671000101",
            "speaker": "明娜",
            "text": "哇，姐姐你头上的是角吗？"
        },
        {
            "id": "671000102",
            "speaker": "卡尼",
            "text": "哇，和鹿头上的角差不多！"
        },
        {
            "id": "671000103",
            "speaker": "明娜",
            "text": "那就是角啦！我们「霜月之子」也有人头顶上长角！"
        },
        {
            "id": "671000104",
            "speaker": "卡尼",
            "text": "对对对，我们的咏月使，菈乌玛姐姐就有一对很漂亮的角！"
        },
        {
            "id": "671000105",
            "speaker": "烟绯",
            "text": "…呃，虽然我还没完全搞清楚状况，但我想我的角和菈乌玛小姐的角应该不太一样。"
        },
        {
            "id": "671000106",
            "speaker": "卡尼",
            "text": "我知道，我知道！菈乌玛姐姐的角是立着的，姐姐你的角是下垂的！所以…姐姐也是咏月使吗？"
        },
        {
            "id": "671000107",
            "speaker": "烟绯",
            "text": "咏、咏月使？我应该不是…"
        },
        {
            "id": "671000108",
            "speaker": "烟绯",
            "text": "（咏月使？听着怪怪的…姥姥说，之前确实有一位仙人和月亮有关，但那位仙人应该不是咏月使…吧…）"
        },
        {
            "id": "671000109",
            "speaker": "烟绯",
            "text": "（不对不对，姥姥之前嘱咐过，不能随便对外人说仙人的事。可是，我现在该怎么说…）"
        },
        {
            "id": "671000110",
            "speaker": "明娜",
            "text": "欸…可是姐姐的角，明明和菈乌玛姐姐的角一样好看…"
        },
        {
            "id": "671000111",
            "speaker": "卡尼",
            "text": "姐姐姐姐，那你能和小动物说话吗？就像菈乌玛姐姐一样！"
        },
        {
            "id": "671000112",
            "speaker": "烟绯",
            "text": "#（咦？{NICKNAME}！好，这下救星来啦！）"
        },
        {
            "id": "671000113",
            "speaker": "烟绯",
            "text": "#哎！{NICKNAME}，这边！"
        },
        {
            "id": "671000114",
            "speaker": "Player",
            "text": "烟绯？你怎么在这里？"
        },
        {
            "id": "671000115",
            "speaker": "烟绯",
            "text": "…先不说这些。快帮我解解围啊。再被这么问下去，我仙人的身份就要瞒不住啦。",
            "choices": [
                {
                    "id": "671000116",
                    "text": "解、解围？",
                    "response": [
                        {
                            "id": "671000118",
                            "speaker": "菈乌玛",
                            "text": "明娜，卡尼。对客人热情以待是没错，但问话太急，还是有些失了礼貌…"
                        },
                        {
                            "id": "671000119",
                            "speaker": "明娜",
                            "text": "啊！菈乌玛姐姐！"
                        },
                        {
                            "id": "671000120",
                            "speaker": "明娜",
                            "text": "喔…对、对不起，长角的姐姐，我们问太多了…"
                        },
                        {
                            "id": "671000121",
                            "speaker": "卡尼",
                            "text": "对不起，姐姐…因为我们还是第一次见到长角的外人，所以…"
                        },
                        {
                            "id": "671000122",
                            "speaker": "菈乌玛",
                            "text": "好啦。明娜，卡尼，快些回家去吧。我来的路上，看见你们的父母正在四处寻你们，想必是有些着急了。"
                        },
                        {
                            "id": "671000123",
                            "speaker": "卡尼",
                            "text": "哇！完蛋了，都已经过了晚饭时间了！"
                        },
                        {
                            "id": "671000124",
                            "speaker": "明娜",
                            "text": "完了完了，老爸非训我不可…再见菈乌玛姐姐，再见…那个…长角的姐姐！"
                        },
                        {
                            "id": "671000125",
                            "speaker": "烟绯",
                            "text": "呼啊…谢谢您帮忙解围，菈乌玛小姐。要是您不来，我都不知道怎么收场了。"
                        },
                        {
                            "id": "671000126",
                            "speaker": "烟绯",
                            "text": "唉，我确实应该听您的劝告，就留在书库里查阅资料的。没想到只是出来这么一会，就…"
                        },
                        {
                            "id": "671000127",
                            "speaker": "菈乌玛",
                            "text": "烟绯小姐无需怪罪自己。孩子们好奇心太重，又是第一次见到长角的外人，所以才如此失礼，我替他们向你致歉。"
                        },
                        {
                            "id": "671000128",
                            "speaker": "菈乌玛",
                            "text": "所幸，团雀把你被明娜和卡尼围住的事很快告诉我了。看来，我赶到得也算是及时。"
                        },
                        {
                            "id": "671000129",
                            "speaker": "烟绯",
                            "text": "没事没事，是我应该听您的话，尽量不外出的…",
                            "choices": [
                                {
                                    "id": "671000130",
                                    "text": "等一会。",
                                    "response": [
                                        {
                                            "id": "671000132",
                                            "speaker": "菈乌玛",
                                            "text": "是的。烟绯小姐前些天来「霜月之子」拜访，说是想要取材和查阅些资料。既是为钻研学问而来，我就请她住下了。"
                                        },
                                        {
                                            "id": "671000133",
                                            "speaker": "烟绯",
                                            "text": "嘿嘿，多谢菈乌玛小姐的帮助。我搜集到了许多宝贵资料，带回去之后，绝对能吓阿忍一跳。"
                                        },
                                        {
                                            "id": "671000134",
                                            "speaker": "菈乌玛",
                                            "text": "烟绯小姐无需客气。你也只是查阅些资料，抄些教规而已。"
                                        },
                                        {
                                            "id": "671000135",
                                            "speaker": "菈乌玛",
                                            "text": "虽然…我并不了解您所说的「律法的边界」…但既然对您有所帮助，那便好了。"
                                        },
                                        {
                                            "id": "671000136",
                                            "speaker": "烟绯",
                                            "text": "「律法的边界」就是…哎呀，一时半会我也说不清。等我写好了书，寄过来几本给您看看就是。"
                                        },
                                        {
                                            "id": "671000137",
                                            "speaker": "烟绯",
                                            "text": "这本普法书简洁易懂，生动翔实，保证您一看就懂。里面不仅讲了律法的概念，还收录了不少国家的现行律法条款呢！"
                                        },
                                        {
                                            "id": "671000138",
                                            "speaker": "菈乌玛",
                                            "text": "是么？那我就期待恭读烟绯小姐的书了，我想，孩子们也会很感兴趣的。"
                                        },
                                        {
                                            "id": "671000139",
                                            "speaker": "烟绯",
                                            "text": "#保证有趣！那我先去书库里接着抄书去了，回头见了，菈乌玛小姐，{NICKNAME}。"
                                        },
                                        {
                                            "id": "671000140",
                                            "speaker": "菈乌玛",
                                            "text": "呵呵，希望这位仙人小姐，能够得偿所愿…"
                                        },
                                        {
                                            "id": "671000141",
                                            "speaker": "Player",
                                            "text": "菈乌玛，烟绯把她的身份告诉你了？"
                                        },
                                        {
                                            "id": "671000142",
                                            "speaker": "菈乌玛",
                                            "text": "烟绯小姐在初次拜访时，就已对我坦诚相告。呵呵，见这位仙人小姐也生有角冠，我倒是有几分亲切感。"
                                        },
                                        {
                                            "id": "671000143",
                                            "speaker": "菈乌玛",
                                            "text": "我听她讲了许多璃月的仙人传说，作为交换，我也允许她进入书库查阅资料。"
                                        },
                                        {
                                            "id": "671000144",
                                            "speaker": "菈乌玛",
                                            "text": "这位仙人小姐倒是懂得守规矩，迄今为止，没有丝毫逾越之举，品德很是值得赞赏。",
                                            "choices": [
                                                {
                                                    "id": "671000145",
                                                    "text": "毕竟是律法咨询师嘛。",
                                                    "response": [
                                                        {
                                                            "id": "671000147",
                                                            "speaker": "菈乌玛",
                                                            "text": "是么？那是最好。但…这位仙人小姐在谈及璃月传说时，曾提到了一位与月有关的「白马仙人」。"
                                                        },
                                                        {
                                                            "id": "671000148",
                                                            "speaker": "菈乌玛",
                                                            "text": "若是我没记错。「霜月之子」的典籍中，亦有记载一位曾经身居月上的神使。",
                                                            "choices": [
                                                                {
                                                                    "id": "671000149",
                                                                    "text": "白马仙人…",
                                                                    "response": [
                                                                        {
                                                                            "id": "671000151",
                                                                            "speaker": "菈乌玛",
                                                                            "text": "#{NICKNAME}，这只是些我的胡乱猜想，不用放在心上。"
                                                                        },
                                                                        {
                                                                            "id": "671000152",
                                                                            "speaker": "菈乌玛",
                                                                            "text": "但转念想想。虽然璃月与挪德卡莱相距甚远，但却始终同沐一片月光之下…"
                                                                        },
                                                                        {
                                                                            "id": "671000153",
                                                                            "speaker": "菈乌玛",
                                                                            "text": "希望璃月诸民，也能受月庇佑，平安顺遂。"
                                                                        }
                                                                    ]
                                                                },
                                                                {
                                                                    "id": "671000150",
                                                                    "text": "（在璃月众仙里，有这么一位吗…？）"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "671000146",
                                                    "text": "最擅长守规矩。"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "671000131",
                                    "text": "你们俩已经认识了？"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "671000117",
                    "text": "那…那个…"
                }
            ]
        }
    ]
}