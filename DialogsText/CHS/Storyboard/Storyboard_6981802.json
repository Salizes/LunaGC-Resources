{
    "talkId": "6981802",
    "total_dialogue_lines": 92,
    "speaker_counts": {
        "Player": 35,
        "派蒙": 17,
        "闲云": 40
    },
    "dialogues": [
        {
            "id": "698180201",
            "speaker": "闲云",
            "text": "天下承平，万象更新，此处亦是人间好时节啊…"
        },
        {
            "id": "698180202",
            "speaker": "派蒙",
            "text": "闲云——！你果然在这里呢。"
        },
        {
            "id": "698180203",
            "speaker": "闲云",
            "text": "哦，是你们。"
        },
        {
            "id": "698180204",
            "speaker": "派蒙",
            "text": "你心情看起来还不错…吧？不、不气了吧？"
        },
        {
            "id": "698180205",
            "speaker": "闲云",
            "text": "可笑。本仙岂是那种鼠肚鸡肠之辈？申鹤都跟本仙说了，你们心思倒也巧妙，选了个好地方。"
        },
        {
            "id": "698180206",
            "speaker": "闲云",
            "text": "是叫摘星崖对吧？好名字。此地的罡风与奥藏山的很不一样，更添灵俏与悠然，但同样颇合我心意。"
        },
        {
            "id": "698180207",
            "speaker": "派蒙",
            "text": "嘻嘻，你喜欢就好。一直担心要是让你费劲爬上来才发现不喜欢，那可就不好了…"
        },
        {
            "id": "698180208",
            "speaker": "闲云",
            "text": "费劲？本仙乘风高飞，举目千里，不一会便寻到此处，可谓易如拾芥。"
        },
        {
            "id": "698180209",
            "speaker": "闲云",
            "text": "即便从崖底开始攀登，踏风而跃，前后不过脚程几步，何来费劲之说？"
        },
        {
            "id": "698180210",
            "speaker": "派蒙",
            "text": "对哦，差点忘记她是一只大仙鸟了…"
        },
        {
            "id": "698180211",
            "speaker": "闲云",
            "text": "放肆！本仙耳朵也好着呢！"
        },
        {
            "id": "698180212",
            "speaker": "派蒙",
            "text": "呃、呃…我的意思是真君神通广大，我们肯定是比不上啦…"
        },
        {
            "id": "698180213",
            "speaker": "派蒙",
            "text": "#{NICKNAME}可以证明！我们第一次来这里时可是费了好大劲才爬到崖顶呢…"
        },
        {
            "id": "698180214",
            "speaker": "Player",
            "text": "想当年，真的很不容易。"
        },
        {
            "id": "698180215",
            "speaker": "闲云",
            "text": "哼，倒也不必这般自谦，从前是从前，如今是如今。"
        },
        {
            "id": "698180216",
            "speaker": "闲云",
            "text": "本仙从来不会看走眼，你的天资绝伦超群，如今攀爬跳跃不也一样毫不费力？"
        },
        {
            "id": "698180217",
            "speaker": "Player",
            "text": "想想好像确实…"
        },
        {
            "id": "698180218",
            "speaker": "派蒙",
            "text": "话说…怎么只有闲云一个？我还以为甘雨申鹤她们会陪你一起出来玩呢。"
        },
        {
            "id": "698180219",
            "speaker": "闲云",
            "text": "有何稀奇？弟子们各有各的事要忙，就连漱玉，小小年纪便懂得光阴不可虚度，要抓紧练功…"
        },
        {
            "id": "698180220",
            "speaker": "闲云",
            "text": "罢了，如此一来反倒乐得清闲。本仙向来漫无羁束，独来独往更显快意自在。"
        },
        {
            "id": "698180221",
            "speaker": "派蒙",
            "text": "好有女侠风范…"
        },
        {
            "id": "698180222",
            "speaker": "闲云",
            "text": "当真？正好，这枫丹的留影机你应该熟悉吧？"
        },
        {
            "id": "698180223",
            "speaker": "闲云",
            "text": "难得出一趟远门，帮我留影几张如何？"
        },
        {
            "id": "698180224",
            "speaker": "闲云",
            "text": "画面远近我均调设妥当了，你站在远处，按下机关即可。"
        },
        {
            "id": "698180225",
            "speaker": "闲云",
            "text": "唯一问题是，该摆出何种姿势？你有何建议？",
            "choices": [
                {
                    "id": "698180226",
                    "text": "当然要帅气女侠的姿势。",
                    "response": [
                        {
                            "id": "698180229",
                            "speaker": "闲云",
                            "text": "那就这样吧。如何？本仙发型没乱吧？",
                            "choices": [
                                {
                                    "id": "698180230",
                                    "text": "保持住，我要按下快门咯！",
                                    "response": [
                                        {
                                            "id": "698180231",
                                            "speaker": "闲云",
                                            "text": "嗯。本仙准备妥当了。"
                                        },
                                        {
                                            "id": "698180238",
                                            "speaker": "闲云",
                                            "text": "拍好了？本仙瞧瞧…哈，不错。"
                                        },
                                        {
                                            "id": "698180239",
                                            "speaker": "闲云",
                                            "text": "辛苦你了，来，本仙也帮你俩留影几张。"
                                        },
                                        {
                                            "id": "698180240",
                                            "speaker": "派蒙",
                                            "text": "真的吗？我们也有份吗？"
                                        },
                                        {
                                            "id": "698180241",
                                            "speaker": "闲云",
                                            "text": "方才听你们所言，此地蕴藏无限回忆。今日故地重游，应有不少新的感慨吧？"
                                        },
                                        {
                                            "id": "698180242",
                                            "speaker": "闲云",
                                            "text": "何不趁现在将此刻的心境记录下来呢？将来看着画片也能回味今日所感。"
                                        },
                                        {
                                            "id": "698180243",
                                            "speaker": "派蒙",
                                            "text": "噢，好有道理！我们也去拍一下吧！那就劳烦闲云啦！"
                                        },
                                        {
                                            "id": "698180244",
                                            "speaker": "闲云",
                                            "text": "嚯，这留影机还算机巧，眼前所见可真明晰了然…"
                                        },
                                        {
                                            "id": "698180245",
                                            "speaker": "闲云",
                                            "text": "小东西，嘴角擦擦干净，我们开始了。"
                                        },
                                        {
                                            "id": "698180246",
                                            "speaker": "派蒙",
                                            "text": "哦，哦！难道我早上吃的饼干没擦干净？"
                                        },
                                        {
                                            "id": "698180247",
                                            "speaker": "闲云",
                                            "text": "来，站在崖边，想到什么了？此刻心情如何？",
                                            "choices": [
                                                {
                                                    "id": "698180248",
                                                    "text": "非常高兴！",
                                                    "response": [
                                                        {
                                                            "id": "698180250",
                                                            "speaker": "闲云",
                                                            "text": "你可想好表情了？本仙可要按下机关了。",
                                                            "choices": [
                                                                {
                                                                    "id": "698180251",
                                                                    "text": "好了，就这样吧。",
                                                                    "response": [
                                                                        {
                                                                            "id": "698180252",
                                                                            "speaker": "派蒙",
                                                                            "text": "没错没错，第一感觉最重要！"
                                                                        },
                                                                        {
                                                                            "id": "698180257",
                                                                            "speaker": "闲云",
                                                                            "text": "好了。唔…跟本仙想象的并无二致，甚好甚好。"
                                                                        },
                                                                        {
                                                                            "id": "698180258",
                                                                            "speaker": "派蒙",
                                                                            "text": "我看看我看看！"
                                                                        },
                                                                        {
                                                                            "id": "698180259",
                                                                            "speaker": "派蒙",
                                                                            "text": "欸…这…你看看…",
                                                                            "choices": [
                                                                                {
                                                                                    "id": "698180260",
                                                                                    "text": "好像跟我想象的不一样…",
                                                                                    "response": [
                                                                                        {
                                                                                            "id": "698180262",
                                                                                            "speaker": "闲云",
                                                                                            "text": "有何不妥？"
                                                                                        },
                                                                                        {
                                                                                            "id": "698180263",
                                                                                            "speaker": "闲云",
                                                                                            "text": "你常年奔行提瓦特各处，奇山异水目不暇接，最终或沦为寻常。唯有旅途的心绪，最是珍贵。"
                                                                                        },
                                                                                        {
                                                                                            "id": "698180264",
                                                                                            "speaker": "派蒙",
                                                                                            "text": "可是你自己的照片明明拍到了大片漂亮的风景呀，跟我们的不一样…"
                                                                                        },
                                                                                        {
                                                                                            "id": "698180265",
                                                                                            "speaker": "闲云",
                                                                                            "text": "欸，怎能同论？本仙此行目的本就是观山玩水，既是初次来访，存些秀色掠影理之固然。"
                                                                                        },
                                                                                        {
                                                                                            "id": "698180266",
                                                                                            "speaker": "闲云",
                                                                                            "text": "再者，不把这景色拍全怎能让那两个老家伙一眼察觉？哼，本仙也能背着他们在别处独乐。"
                                                                                        },
                                                                                        {
                                                                                            "id": "698180267",
                                                                                            "speaker": "闲云",
                                                                                            "text": "好了，今日很尽兴，日后本仙会继续按照旅行手册游玩，不必操心。"
                                                                                        },
                                                                                        {
                                                                                            "id": "698180268",
                                                                                            "speaker": "闲云",
                                                                                            "text": "也辛苦你们了，你们若有正事便去忙吧，不必专程陪同。"
                                                                                        }
                                                                                    ]
                                                                                },
                                                                                {
                                                                                    "id": "698180261",
                                                                                    "text": "这都看不见风景了呀！"
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                },
                                                                {
                                                                    "id": "698180255",
                                                                    "text": "但还是忘不掉摔过的跤。",
                                                                    "response": [
                                                                        {
                                                                            "id": "698180256",
                                                                            "speaker": "派蒙",
                                                                            "text": "我懂我懂！"
                                                                        },
                                                                        {
                                                                            "id": "698180273",
                                                                            "speaker": "闲云",
                                                                            "text": "你可想好表情了？本仙可要按下机关了。",
                                                                            "choices": [
                                                                                {
                                                                                    "id": "698180272",
                                                                                    "text": "好了，就这样吧。"
                                                                                },
                                                                                {
                                                                                    "id": "698180253",
                                                                                    "text": "其实还是很高兴的。",
                                                                                    "response": [
                                                                                        {
                                                                                            "id": "698180254",
                                                                                            "speaker": "派蒙",
                                                                                            "text": "嘻嘻，我也是！"
                                                                                        },
                                                                                        {
                                                                                            "id": "698180274",
                                                                                            "speaker": "闲云",
                                                                                            "text": "你可想好表情了？本仙可要按下机关了。",
                                                                                            "choices": [
                                                                                                {
                                                                                                    "id": "698180272",
                                                                                                    "text": "好了，就这样吧。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "698180255",
                                                                                                    "text": "但还是忘不掉摔过的跤。"
                                                                                                }
                                                                                            ]
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "698180249",
                                                    "text": "想起爬着爬着体力不支摔下崖底…",
                                                    "response": [
                                                        {
                                                            "id": "698180271",
                                                            "speaker": "闲云",
                                                            "text": "你可想好表情了？本仙可要按下机关了。",
                                                            "choices": [
                                                                {
                                                                    "id": "698180272",
                                                                    "text": "好了，就这样吧。"
                                                                },
                                                                {
                                                                    "id": "698180253",
                                                                    "text": "其实还是很高兴的。"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "698180234",
                                    "text": "还是放松的姿势比较好。",
                                    "response": [
                                        {
                                            "id": "698180235",
                                            "speaker": "闲云",
                                            "text": "早知道应该把甘雨送的丝绢带来才是…那就先这样吧，迎着风…",
                                            "choices": [
                                                {
                                                    "id": "698180230",
                                                    "text": "保持住，我要按下快门咯！"
                                                },
                                                {
                                                    "id": "698180232",
                                                    "text": "还是帅气的姿势合适。",
                                                    "response": [
                                                        {
                                                            "id": "698180233",
                                                            "speaker": "闲云",
                                                            "text": "这样如何？",
                                                            "choices": [
                                                                {
                                                                    "id": "698180230",
                                                                    "text": "保持住，我要按下快门咯！"
                                                                },
                                                                {
                                                                    "id": "698180234",
                                                                    "text": "还是放松的姿势比较好。"
                                                                },
                                                                {
                                                                    "id": "698180236",
                                                                    "text": "还是意想不到的姿势有惊喜。",
                                                                    "response": [
                                                                        {
                                                                            "id": "698180237",
                                                                            "speaker": "闲云",
                                                                            "text": "哼。那是自然。",
                                                                            "choices": [
                                                                                {
                                                                                    "id": "698180230",
                                                                                    "text": "保持住，我要按下快门咯！"
                                                                                },
                                                                                {
                                                                                    "id": "698180232",
                                                                                    "text": "还是帅气的姿势合适。"
                                                                                },
                                                                                {
                                                                                    "id": "698180234",
                                                                                    "text": "还是放松的姿势比较好。"
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "698180236",
                                                    "text": "还是意想不到的姿势有惊喜。"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "698180236",
                                    "text": "还是意想不到的姿势有惊喜。"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "698180227",
                    "text": "平常放松最真实。",
                    "response": [
                        {
