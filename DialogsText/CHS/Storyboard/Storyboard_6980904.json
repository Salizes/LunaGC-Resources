{
    "talkId": "6980904",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 2,
        "安柏": 11
    },
    "dialogues": [
        {
            "id": "698090401",
            "speaker": "安柏",
            "text": "雷泽…雷泽，这里也没看见…"
        },
        {
            "id": "698090402",
            "speaker": "安柏",
            "text": "#{NICKNAME}，你来的时候看见雷泽了吗？",
            "choices": [
                {
                    "id": "698090403",
                    "text": "没有，怎么了？",
                    "response": [
                        {
                            "id": "698090405",
                            "speaker": "安柏",
                            "text": "没有没有，虽然…确实有点急…"
                        },
                        {
                            "id": "698090406",
                            "speaker": "安柏",
                            "text": "前几天他来城里玩的时候，本来要和可莉一起吃蛋糕，可是那天刚好蛋糕卖光了，他没吃到。"
                        },
                        {
                            "id": "698090407",
                            "speaker": "安柏",
                            "text": "今天可莉起了个大早，买到蛋糕之后，想要进奔狼领把蛋糕送给雷泽。"
                        },
                        {
                            "id": "698090408",
                            "speaker": "安柏",
                            "text": "她差点一个人跑出城去，还好凯亚队长及时发现，把她拦了下来。"
                        },
                        {
                            "id": "698090409",
                            "speaker": "安柏",
                            "text": "要是可莉一个人跑进奔狼领，那就太危险了。"
                        },
                        {
                            "id": "698090410",
                            "speaker": "安柏",
                            "text": "为了让可莉乖乖待在骑士团里，我答应她，把她画的蜡笔画和蛋糕一起送给雷泽。"
                        },
                        {
                            "id": "698090411",
                            "speaker": "安柏",
                            "text": "但…我都快把奔狼领跑遍了，也没发现雷泽…"
                        },
                        {
                            "id": "698090412",
                            "speaker": "安柏",
                            "text": "呼…不行不行，不能气馁，再找不到雷泽的话，蛋糕就不好吃了！"
                        },
                        {
                            "id": "698090413",
                            "speaker": "安柏",
                            "text": "#我飞起来再找一次，{NICKNAME}，先走啦！"
                        }
                    ]
                },
                {
                    "id": "698090404",
                    "text": "找他有急事么？"
                }
            ]
        }
    ]
}