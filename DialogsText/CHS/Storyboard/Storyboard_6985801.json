{
    "talkId": "6985801",
    "total_dialogue_lines": 36,
    "speaker_counts": {
        "Player": 14,
        "猫": 3,
        "菈乌玛": 19
    },
    "dialogues": [
        {
            "id": "698580101",
            "speaker": "菈乌玛",
            "text": "呼…"
        },
        {
            "id": "698580102",
            "speaker": "Player",
            "text": "（睡着了吗？等她醒了再打招呼吧…）"
        },
        {
            "id": "698580103",
            "speaker": "Player",
            "text": "（或者…要不过会再来？）"
        },
        {
            "id": "698580104",
            "speaker": "菈乌玛",
            "text": "呵呵…",
            "choices": [
                {
                    "id": "698580105",
                    "text": "呀！",
                    "response": [
                        {
                            "id": "698580107",
                            "speaker": "菈乌玛",
                            "text": "不，请务必不要道歉。"
                        },
                        {
                            "id": "698580108",
                            "speaker": "菈乌玛",
                            "text": "我没有睡着，只是在闭目休息。"
                        },
                        {
                            "id": "698580109",
                            "speaker": "菈乌玛",
                            "text": "而且，这孩子已经提前告诉我，它听到了你的脚步声。"
                        },
                        {
                            "id": "698580110",
                            "speaker": "菈乌玛",
                            "text": "小动物们总是能比人类感知到更多东西，这或许是造物主赐予它们的祝福。"
                        },
                        {
                            "id": "698580111",
                            "speaker": "Player",
                            "text": "谢谢你，猫猫。"
                        },
                        {
                            "id": "698580112",
                            "speaker": "猫",
                            "text": "喵。"
                        },
                        {
                            "id": "698580113",
                            "speaker": "Player",
                            "text": "它说了什么？"
                        },
                        {
                            "id": "698580114",
                            "speaker": "菈乌玛",
                            "text": "现在它承认了你是一位非常友善的人。"
                        },
                        {
                            "id": "698580115",
                            "speaker": "菈乌玛",
                            "text": "这孩子啊，刚刚还在怂恿我要假装睡觉捉弄你一下。"
                        },
                        {
                            "id": "698580116",
                            "speaker": "菈乌玛",
                            "text": "#「看看{M#他}{F#她}是会偷看你，还是会偷吃你的东西！」",
                            "choices": [
                                {
                                    "id": "698580117",
                                    "text": "还好我没有伸手！",
                                    "response": [
                                        {
                                            "id": "698580119",
                                            "speaker": "菈乌玛",
                                            "text": "尽管我相信你品行高洁，但在此等无伤大雅的时刻，即使是我，也会对未曾探得的结果产生好奇。"
                                        },
                                        {
                                            "id": "698580120",
                                            "speaker": "菈乌玛",
                                            "text": "你会原谅我们的吧？",
                                            "choices": [
                                                {
                                                    "id": "698580121",
                                                    "text": "当然。",
                                                    "response": [
                                                        {
                                                            "id": "698580129",
                                                            "speaker": "菈乌玛",
                                                            "text": "#嗯，还没来得及问，{NICKNAME}是找我有事吗？"
                                                        },
                                                        {
                                                            "id": "698580130",
                                                            "speaker": "Player",
                                                            "text": "就来看看你最近好不好。"
                                                        },
                                                        {
                                                            "id": "698580131",
                                                            "speaker": "菈乌玛",
                                                            "text": "呵呵…原来是这样。"
                                                        },
                                                        {
                                                            "id": "698580132",
                                                            "speaker": "菈乌玛",
                                                            "text": "多谢你的关心，我这边一切顺利。"
                                                        },
                                                        {
                                                            "id": "698580133",
                                                            "speaker": "菈乌玛",
                                                            "text": "正好，「霜月之子」今天又取得了不少新鲜水果，请和我一起享用吧。"
                                                        },
                                                        {
                                                            "id": "698580134",
                                                            "speaker": "猫",
                                                            "text": "喵。"
                                                        },
                                                        {
                                                            "id": "698580135",
                                                            "speaker": "Player",
                                                            "text": "难道它也想吃水果吗？"
                                                        },
                                                        {
                                                            "id": "698580136",
                                                            "speaker": "菈乌玛",
                                                            "text": "呵呵，它只是舍不得离开我们的聚会。想在这片刻的闲暇中，为自己寻到一份能够安心的忙碌而已。"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "698580122",
                                                    "text": "好哇你俩！",
                                                    "response": [
                                                        {
                                                            "id": "698580123",
                                                            "speaker": "菈乌玛",
                                                            "text": "#{M#他}{F#她}似乎生气了，怎么办？要用你的肉垫揉揉{M#他}{F#她}的手臂，以示歉意吗？"
                                                        },
                                                        {
                                                            "id": "698580124",
                                                            "speaker": "猫",
                                                            "text": "喵。"
                                                        },
                                                        {
                                                            "id": "698580125",
                                                            "speaker": "Player",
                                                            "text": "那菈乌玛的歉意呢？"
                                                        },
                                                        {
                                                            "id": "698580126",
                                                            "speaker": "菈乌玛",
                                                            "text": "我的手掌与常人一般无二，恐怕无法为你带来独特的慰藉。"
                                                        },
                                                        {
                                                            "id": "698580127",
                                                            "speaker": "菈乌玛",
                                                            "text": "但我可以赐予你「咏月使」的祝福，为你祈愿前路顺遂…"
                                                        },
                                                        {
                                                            "id": "698580128",
                                                            "speaker": "Player",
                                                            "text": "谢谢，那我就收下了。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "698580118",
                                    "text": "你居然采纳了…"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "698580106",
                    "text": "抱歉，吵醒你了…"
                }
            ]
        }
    ]
}