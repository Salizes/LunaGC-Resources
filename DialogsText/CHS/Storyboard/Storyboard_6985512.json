{
    "talkId": "6985512",
    "total_dialogue_lines": 23,
    "speaker_counts": {
        "Black Screen": 1,
        "Player": 4,
        "伊涅芙": 4,
        "爱诺": 14
    },
    "dialogues": [
        {
            "id": "698551201",
            "speaker": "爱诺",
            "text": "嗯？这样操作不对么？伊涅芙，再把上次记下来的操作手册念一遍。"
        },
        {
            "id": "698551202",
            "speaker": "伊涅芙",
            "text": "爱诺，我认为普通的润滑剂已经足够使用，不需要额外再制作新品。"
        },
        {
            "id": "698551203",
            "speaker": "爱诺",
            "text": "哎呀，来都来了，我还要再玩一会。",
            "choices": [
                {
                    "id": "698551204",
                    "text": "你们在做什么呢？",
                    "response": [
                        {
                            "id": "698551206",
                            "speaker": "爱诺",
                            "text": "#{NICKNAME}，你来得正好，你肯定知道怎么操作这种炼金台吧。"
                        },
                        {
                            "id": "698551207",
                            "speaker": "爱诺",
                            "text": "快快快，帮我做一瓶那种…叫什么来着？冰冰凉凉的，霜什么…什么精油来着？"
                        },
                        {
                            "id": "698551208",
                            "speaker": "伊涅芙",
                            "text": "「霜劫精油」。"
                        },
                        {
                            "id": "698551209",
                            "speaker": "爱诺",
                            "text": "对对，就是这种冰冰凉凉的东西，我想要把它和润滑油结合在一起，给伊涅芙制作一种全新的关节润滑剂。"
                        },
                        {
                            "id": "698551210",
                            "speaker": "爱诺",
                            "text": "#我本来想要自己操作，但考虑到效率问题…嗯，就由{NICKNAME}来帮忙吧！"
                        },
                        {
                            "id": "698551211",
                            "speaker": "伊涅芙",
                            "text": "其实，只是因为爱诺制作精油时失败了许多次，目前只剩下了制作两瓶精油的材料了。"
                        },
                        {
                            "id": "698551212",
                            "speaker": "爱诺",
                            "text": "我才没有失败！那是合理的试错过程！"
                        },
                        {
                            "id": "698551213",
                            "speaker": "爱诺",
                            "text": "#做一瓶精油对我来说，当然不在话下。但既然{NICKNAME}来了，那当然要把专业的事交给专业的人来做呀。"
                        },
                        {
                            "id": "698551214",
                            "speaker": "爱诺",
                            "text": "#嘿嘿，{NICKNAME}，拜托你啦。",
                            "choices": [
                                {
                                    "id": "698551215",
                                    "text": "行，交给我吧。",
                                    "response": [
                                        {
                                            "id": "698551217",
                                            "speaker": "Black Screen",
                                            "text": "帮爱诺飞快地制作了两瓶完美的「霜劫精油」…"
                                        },
                                        {
                                            "id": "698551218",
                                            "speaker": "爱诺",
                                            "text": "#哇，{NICKNAME}果然厉害，走吧伊涅芙，我们回去调配一下润滑剂。"
                                        },
                                        {
                                            "id": "698551219",
                                            "speaker": "爱诺",
                                            "text": "相信我，这种润滑剂肯定能解决那些部件的过热问题。"
                                        },
                                        {
                                            "id": "698551220",
                                            "speaker": "伊涅芙",
                                            "text": "好的，爱诺。但我在工作时，内部构件的温度并没有长时间超出过平均值。"
                                        },
                                        {
                                            "id": "698551221",
                                            "speaker": "爱诺",
                                            "text": "呃…那个，有备无患嘛，有备无患。"
                                        },
                                        {
                                            "id": "698551222",
                                            "speaker": "爱诺",
                                            "text": "#谢谢你啦{NICKNAME}，这种精油我只要一瓶就行，剩下的那一瓶你留着吧。"
                                        },
                                        {
                                            "id": "698551223",
                                            "speaker": "爱诺",
                                            "text": "我们走啦，等有空了之后，记得来找我们玩啊。"
                                        }
                                    ]
                                },
                                {
                                    "id": "698551216",
                                    "text": "包在我身上。"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "698551205",
                    "text": "是要制作药剂么？"
                }
            ]
        }
    ]
}