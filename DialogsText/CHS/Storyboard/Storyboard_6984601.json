{
    "talkId": "6984601",
    "total_dialogue_lines": 44,
    "speaker_counts": {
        "Player": 12,
        "膨膨兽": 8,
        "菲米尼": 24
    },
    "dialogues": [
        {
            "id": "698460101",
            "speaker": "菲米尼",
            "text": "…我也喜欢潜水。"
        },
        {
            "id": "698460102",
            "speaker": "膨膨兽",
            "text": "……",
            "choices": [
                {
                    "id": "698460103",
                    "text": "菲米尼！你好呀。",
                    "response": [
                        {
                            "id": "698460105",
                            "speaker": "菲米尼",
                            "text": "…你好，好久不见。我在…陪它聊天。"
                        },
                        {
                            "id": "698460106",
                            "speaker": "Player",
                            "text": "陪膨膨兽聊天？"
                        },
                        {
                            "id": "698460107",
                            "speaker": "菲米尼",
                            "text": "嗯…也许你会觉得很奇怪…",
                            "choices": [
                                {
                                    "id": "698460108",
                                    "text": "一点都不奇怪！我也想加入！",
                                    "response": [
                                        {
                                            "id": "698460110",
                                            "speaker": "菲米尼",
                                            "text": "真的？我还以为…这只是绘本里的故事呢。",
                                            "choices": [
                                                {
                                                    "id": "698460111",
                                                    "text": "绘本里写了什么？",
                                                    "response": [
                                                        {
                                                            "id": "698460113",
                                                            "speaker": "菲米尼",
                                                            "text": "好，我现在就讲给你听。"
                                                        },
                                                        {
                                                            "id": "698460114",
                                                            "speaker": "膨膨兽",
                                                            "text": "呜呜？"
                                                        },
                                                        {
                                                            "id": "698460115",
                                                            "speaker": "菲米尼",
                                                            "text": "你也想听么？好呀，那我也讲给你听。"
                                                        },
                                                        {
                                                            "id": "698460116",
                                                            "speaker": "膨膨兽",
                                                            "text": "呜~呜呜~"
                                                        },
                                                        {
                                                            "id": "698460117",
                                                            "speaker": "菲米尼",
                                                            "text": "传说在很久很久以前，有一只膨膨兽和族群失散了，一直独自生活在黑漆漆的海底。"
                                                        },
                                                        {
                                                            "id": "698460118",
                                                            "speaker": "菲米尼",
                                                            "text": "它勇敢地一边独自生活，一边寻找着家人。有一天，一个热爱冒险的深水潜水员发现了它。"
                                                        },
                                                        {
                                                            "id": "698460119",
                                                            "speaker": "菲米尼",
                                                            "text": "这只膨膨兽从未见过人类，一开始很害怕，但那位潜水员却给了它许多好吃的，并且许诺，自己第二天还会回来。"
                                                        },
                                                        {
                                                            "id": "698460120",
                                                            "speaker": "菲米尼",
                                                            "text": "就这样，膨膨兽和这位潜水员成了朋友。每当潜水员来的时候，它都会高兴地跳舞和拍肚皮，还会唱着膨膨兽的歌。"
                                                        },
                                                        {
                                                            "id": "698460121",
                                                            "speaker": "菲米尼",
                                                            "text": "潜水员也很喜欢它圆鼓鼓的肚皮，每次都忍不住摸了好久好久…"
                                                        },
                                                        {
                                                            "id": "698460122",
                                                            "speaker": "菲米尼",
                                                            "text": "膨膨兽也很享受手掌在肚皮上摩挲的感觉，可是它们视力很差，看不清潜水员的样子，只能勉强看见一个人形。"
                                                        },
                                                        {
                                                            "id": "698460123",
                                                            "speaker": "菲米尼",
                                                            "text": "所以，每当有人形在靠近时，它都会高兴地跳舞、拍肚皮和唱歌。"
                                                        },
                                                        {
                                                            "id": "698460124",
                                                            "speaker": "膨膨兽",
                                                            "text": "呜！呜！呜！",
                                                            "choices": [
                                                                {
                                                                    "id": "698460125",
                                                                    "text": "可爱！摸摸！",
                                                                    "response": [
                                                                        {
                                                                            "id": "698460127",
                                                                            "speaker": "膨膨兽",
                                                                            "text": "呜呜！呜！"
                                                                        },
                                                                        {
                                                                            "id": "698460128",
                                                                            "speaker": "菲米尼",
                                                                            "text": "好孩子，这些小鱼给你，我刚捕到的，慢慢吃吧。"
                                                                        },
                                                                        {
                                                                            "id": "698460129",
                                                                            "speaker": "Player",
                                                                            "text": "那个故事，到此结束了么？"
                                                                        },
                                                                        {
                                                                            "id": "698460130",
                                                                            "speaker": "菲米尼",
                                                                            "text": "嗯…我也希望故事到这里就能结束。但…从某天开始，潜水员就再也没来过…"
                                                                        },
                                                                        {
                                                                            "id": "698460131",
                                                                            "speaker": "菲米尼",
                                                                            "text": "那只膨膨兽等了好久好久，最后只能鼓起勇气，顺着潜水员离开的方向，一直游到海滩上，找寻潜水员的身影。"
                                                                        },
                                                                        {
                                                                            "id": "698460132",
                                                                            "speaker": "菲米尼",
                                                                            "text": "我手上的这本绘本，就画到这里了。我也不知道结局是怎么样的。我想，这对朋友应该…"
                                                                        },
                                                                        {
                                                                            "id": "698460133",
                                                                            "speaker": "膨膨兽",
                                                                            "text": "呜…"
                                                                        },
                                                                        {
                                                                            "id": "698460134",
                                                                            "speaker": "菲米尼",
                                                                            "text": "哎，你别难过。这只是绘本的故事，不是真的…应该…",
                                                                            "choices": [
                                                                                {
                                                                                    "id": "698460135",
                                                                                    "text": "应该会很快重逢的。",
                                                                                    "response": [
                                                                                        {
                                                                                            "id": "698460137",
                                                                                            "speaker": "菲米尼",
                                                                                            "text": "…嗯。我想，一定会的。"
                                                                                        },
                                                                                        {
                                                                                            "id": "698460138",
                                                                                            "speaker": "膨膨兽",
                                                                                            "text": "呜！呜！呜！"
                                                                                        },
                                                                                        {
                                                                                            "id": "698460139",
                                                                                            "speaker": "菲米尼",
                                                                                            "text": "你又想吃小鱼了么？我还有一些，稍等一下。"
                                                                                        },
                                                                                        {
                                                                                            "id": "698460140",
                                                                                            "speaker": "菲米尼",
                                                                                            "text": "…膨膨兽的肚皮，摸起来到底是什么感觉呢？"
                                                                                        },
                                                                                        {
                                                                                            "id": "698460141",
                                                                                            "speaker": "菲米尼",
                                                                                            "text": "…嗯！"
                                                                                        },
                                                                                        {
                                                                                            "id": "698460142",
                                                                                            "speaker": "膨膨兽",
                                                                                            "text": "呜？呜呜，呜。"
                                                                                        },
                                                                                        {
                                                                                            "id": "698460143",
                                                                                            "speaker": "菲米尼",
                                                                                            "text": "那、那我试试？"
                                                                                        },
                                                                                        {
                                                                                            "id": "698460144",
                                                                                            "speaker": "菲米尼",
                                                                                            "text": "好特别，跟琳妮特养的猫手感不一样…"
                                                                                        }
                                                                                    ]
                                                                                },
                                                                                {
                                                                                    "id": "698460136",
                                                                                    "text": "这个故事会有一个好结局的。"
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                },
                                                                {
                                                                    "id": "698460126",
                                                                    "text": "肚皮！摸摸！"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "698460112",
                                                    "text": "想听听绘本的故事。"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "698460109",
                                    "text": "我也有膨膨兽朋友哦！"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "698460104",
                    "text": "你在这里做什么？"
                }
            ]
        }
    ]
}