    "dialogues": [
        {
            "id": "698190101",
            "speaker": "枫原万叶",
            "text": "「春草复萌发，天地行将绿」…"
        },
        {
            "id": "698190102",
            "speaker": "枫原万叶",
            "text": "新雨过后，风轻云淡。登高望远，胸中无限开阔。"
        },
        {
            "id": "698190103",
            "speaker": "枫原万叶",
            "text": "若又恰好与故人相逢，那更是人间好时节…对吧？"
        }
    ]
}