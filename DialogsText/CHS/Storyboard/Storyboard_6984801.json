{
    "talkId": "6984801",
    "total_dialogue_lines": 40,
    "speaker_counts": {
        "Player": 12,
        "梦见月瑞希": 13,
        "莱依拉": 15
    },
    "dialogues": [
        {
            "id": "698480101",
            "speaker": "莱依拉",
            "text": "不行，不行，开头综述不能这么写，要再详细一点…"
        },
        {
            "id": "698480102",
            "speaker": "梦见月瑞希",
            "text": "这位客人…"
        },
        {
            "id": "698480103",
            "speaker": "莱依拉",
            "text": "但太详细的话，会不会有轻重不分的感觉？呜…到底怎么写…"
        },
        {
            "id": "698480104",
            "speaker": "梦见月瑞希",
            "text": "莱依拉小姐，不如…我们去里面，坐下慢慢聊？"
        },
        {
            "id": "698480105",
            "speaker": "莱依拉",
            "text": "欸？！对不起，对不起！我一下子没控制住，不由自主地又开始想论文的事情了…"
        },
        {
            "id": "698480106",
            "speaker": "梦见月瑞希",
            "text": "没关系，我之前也给几位教令院的学生做过诊疗，他们的精神状态…和您的倒也差不多。"
        },
        {
            "id": "698480107",
            "speaker": "莱依拉",
            "text": "您去过须弥？"
        },
        {
            "id": "698480108",
            "speaker": "梦见月瑞希",
            "text": "是的，我曾经受一位学者的邀请，去给他的学生们做了一段时间的诊疗。"
        },
        {
            "id": "698480109",
            "speaker": "莱依拉",
            "text": "这样吗…那、那几位学长学姐有什么严重的问题么…"
        },
        {
            "id": "698480110",
            "speaker": "梦见月瑞希",
            "text": "倒也谈不上多严重，就是持续性的失眠、惊惧、妄想，还有严重的耳鸣和眩晕症状…",
            "choices": [
                {
                    "id": "698480111",
                    "text": "这到底是在写论文…",
                    "response": [
                        {
                            "id": "698480113",
                            "speaker": "莱依拉",
                            "text": "我宁愿去讨伐魔物…"
                        },
                        {
                            "id": "698480114",
                            "speaker": "莱依拉",
                            "text": "如果讨伐成功了，那就万事大吉，如果讨伐失败了，我也就什么都不用担心了。"
                        },
                        {
                            "id": "698480115",
                            "speaker": "莱依拉",
                            "text": "但、但是论文…我连什么算成功，什么算失败都不知道。"
                        },
                        {
                            "id": "698480116",
                            "speaker": "莱依拉",
                            "text": "我已经拼命写出来第三稿了，但交上去的时候，我的导师却直接把论文倒扣在桌上，还说："
                        },
                        {
                            "id": "698480117",
                            "speaker": "莱依拉",
                            "text": "「暂时别操心论文的事，先去稻妻的『秋沙钱汤』放松放松，恢复一下状态吧，我已经替你联系好了。」",
                            "choices": [
                                {
                                    "id": "698480118",
                                    "text": "这导师人还挺好的…",
                                    "response": [
                                        {
                                            "id": "698480120",
                                            "speaker": "梦见月瑞希",
                                            "text": "没错，我这边也是提前接到了莱依拉小姐导师的信件，里面详述了莱依拉小姐的情况，拜托我为她做一段时间的诊疗。"
                                        },
                                        {
                                            "id": "698480121",
                                            "speaker": "梦见月瑞希",
                                            "text": "我想，应该是哪位和我相熟的学者，把我的联系方式给了莱依拉小姐的导师吧。"
                                        },
                                        {
                                            "id": "698480122",
                                            "speaker": "莱依拉",
                                            "text": "绝对不可能这么简单…我的论文还没写完，课题也才刚开始，小组作业还拖着一堆没交…"
                                        },
                                        {
                                            "id": "698480123",
                                            "speaker": "莱依拉",
                                            "text": "导师不会是觉得我太没用，要把我…把我赶走吧…",
                                            "choices": [
                                                {
                                                    "id": "698480124",
                                                    "text": "莱依拉！振作点！",
                                                    "response": [
                                                        {
                                                            "id": "698480126",
                                                            "speaker": "莱依拉",
                                                            "text": "这就是导师送我最后的礼物…这是我人生最后一次泡澡了…"
                                                        },
                                                        {
                                                            "id": "698480127",
                                                            "speaker": "莱依拉",
                                                            "text": "回到教令院…我就会被赶走…在角落里一直算星图…一直算星图…",
                                                            "choices": [
                                                                {
                                                                    "id": "698480128",
                                                                    "text": "不至于啦！不至于啊！",
                                                                    "response": [
                                                                        {
                                                                            "id": "698480130",
                                                                            "speaker": "梦见月瑞希",
                                                                            "text": "（…果然，和信里说的一样，症状十分严重。也不知道这样的症状在莱依拉身上持续了多久。）"
                                                                        },
                                                                        {
                                                                            "id": "698480131",
                                                                            "speaker": "梦见月瑞希",
                                                                            "text": "（不过，她导师明明在信里肯定了她的能力啊，也不断强调，莱依拉绝对是自己最优秀的学生。）"
                                                                        },
                                                                        {
                                                                            "id": "698480132",
                                                                            "speaker": "梦见月瑞希",
                                                                            "text": "（难道，是莱依拉小姐单方面不信任自己的能力，从而引发了这些症状？看来，要深入诊疗一下了…）"
                                                                        },
                                                                        {
                                                                            "id": "698480133",
                                                                            "speaker": "莱依拉",
                                                                            "text": "老板…我先进去了…要是有什么信件的话，请你帮我签收…",
                                                                            "choices": [
                                                                                {
                                                                                    "id": "698480134",
                                                                                    "text": "怎么感觉…",
                                                                                    "response": [
                                                                                        {
                                                                                            "id": "698480136",
                                                                                            "speaker": "梦见月瑞希",
                                                                                            "text": "……",
                                                                                            "choices": [
                                                                                                {
                                                                                                    "id": "698480137",
                                                                                                    "text": "瑞希，救救莱依拉！",
                                                                                                    "response": [
                                                                                                        {
                                                                                                            "id": "698480139",
                                                                                                            "speaker": "梦见月瑞希",
                                                                                                            "text": "#放心吧，{NICKNAME}，我会帮助莱依拉小姐的。而且，我刚才已经想出了初步的诊疗方案。"
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "698480140",
                                                                                                            "speaker": "梦见月瑞希",
                                                                                                            "text": "…接下来，就是实施正式诊疗了。"
                                                                                                        }
                                                                                                    ]
                                                                                                },
                                                                                                {
                                                                                                    "id": "698480138",
                                                                                                    "text": "瑞希，想想办法！"
                                                                                                }
                                                                                            ]
                                                                                        }
                                                                                    ]
                                                                                },
                                                                                {
                                                                                    "id": "698480135",
                                                                                    "text": "莱依拉的状态更不好了…"
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                },
                                                                {
                                                                    "id": "698480129",
                                                                    "text": "莱依拉！冷静下来！"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "698480125",
                                                    "text": "眼、眼神灰掉了…"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "698480119",
                                    "text": "放松放松也是好事嘛。"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "698480112",
                    "text": "还是在讨伐魔物…"
                }
            ]
        }
    ]
}