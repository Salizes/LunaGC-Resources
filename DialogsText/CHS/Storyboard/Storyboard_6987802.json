{
    "talkId": "6987802",
    "total_dialogue_lines": 37,
    "speaker_counts": {
        "Player": 5,
        "法尔伽": 14,
        "派蒙": 2,
        "菲林斯": 16
    },
    "dialogues": [
        {
            "id": "698780201",
            "speaker": "法尔伽",
            "text": "我就说嘛，整个挪德卡莱，你就是我最棒的酒友！"
        },
        {
            "id": "698780202",
            "speaker": "菲林斯",
            "text": "谬赞了，法尔伽先生。我只知道如何品酒，但你的酒品在我之上的。"
        },
        {
            "id": "698780203",
            "speaker": "法尔伽",
            "text": "#{NICKNAME}，来得正巧啊，你也来喝点？"
        },
        {
            "id": "698780204",
            "speaker": "菲林斯",
            "text": "#我想，{NICKNAME}{M#先生}{F#小姐}适合来一点温和的饮料。"
        },
        {
            "id": "698780205",
            "speaker": "菲林斯",
            "text": "正巧德米安先生有事离开了，那就由我为你调制饮料吧，你喜欢什么口味，甜的？还是酸一些。",
            "choices": [
                {
                    "id": "698780206",
                    "text": "甜一些。",
                    "response": [
                        {
                            "id": "698780207",
                            "speaker": "菲林斯",
                            "text": "嗯，奔波忙碌了一天，的确需要用甜味来犒劳自己，我想，奶油应当合你的心意。"
                        },
                        {
                            "id": "698780208",
                            "speaker": "法尔伽",
                            "text": "甜的？噢，不然加点我们上次喝的果汁？味道很不错，甜味也很适中。"
                        },
                        {
                            "id": "698780209",
                            "speaker": "菲林斯",
                            "text": "法尔伽先生，我想我们喝酒时，从未喝过「果汁」。"
                        },
                        {
                            "id": "698780210",
                            "speaker": "菲林斯",
                            "text": "我猜，你说的应该是那一瓶从稻妻进口的「绯樱酒」吧，那一小瓶，可是放倒了四个酒客。"
                        },
                        {
                            "id": "698780211",
                            "speaker": "法尔伽",
                            "text": "「绯樱酒」？怪了，我喝的时候都没尝出什么味道，只记得那一碟「盐渍绯樱」味道很不错，适合下酒。"
                        },
                        {
                            "id": "698780217",
                            "speaker": "菲林斯",
                            "text": "#请吧。{M#先生}{F#小姐}，这是一杯无名的饮料，但我相信，它会为你带来好心情。"
                        },
                        {
                            "id": "698780218",
                            "speaker": "菲林斯",
                            "text": "派蒙小姐，这杯鲜榨的果汁是你的，我在里面掺了一些果肉，喝起来口感会更好。"
                        },
                        {
                            "id": "698780219",
                            "speaker": "派蒙",
                            "text": "哇！谢谢，嘿嘿嘿——"
                        },
                        {
                            "id": "698780220",
                            "speaker": "菲林斯",
                            "text": "法尔伽先生，请你尝尝这一杯。"
                        },
                        {
                            "id": "698780221",
                            "speaker": "法尔伽",
                            "text": "噢？还有我的份，这是酒会之后的解酒环节吗？"
                        },
                        {
                            "id": "698780222",
                            "speaker": "法尔伽",
                            "text": "这是…钩钩果的味道，哈哈哈哈哈，你从哪里搞来的，什么时候？"
                        },
                        {
                            "id": "698780223",
                            "speaker": "菲林斯",
                            "text": "你对蒙德城的思念溢于言表，而我又恰好善于捕捉细节。总之，我相信这种果子能让你愉快一些。"
                        },
                        {
                            "id": "698780224",
                            "speaker": "法尔伽",
                            "text": "真不错。可惜啊…整个挪德卡莱，也只有你能和我喝这么久。"
                        },
                        {
                            "id": "698780225",
                            "speaker": "法尔伽",
                            "text": "不过，你似乎从来都没有喝尽兴过。"
                        },
                        {
                            "id": "698780226",
                            "speaker": "菲林斯",
                            "text": "如果你是指，完全陶醉在美酒之中，任凭思绪缥缈，享受此类捉摸不透的快感。那么我想…",
                            "choices": [
                                {
                                    "id": "698780227",
                                    "text": "毕竟菲林斯是…",
                                    "response": [
                                        {
                                            "id": "698780229",
                                            "speaker": "菲林斯",
                                            "text": "消失无踪。虽然有些烈酒会让火苗腾起，但老实说，我对此并无太大感觉。"
                                        },
                                        {
                                            "id": "698780230",
                                            "speaker": "法尔伽",
                                            "text": "哈，那只不过是酒不够烈！比如至冬的「火水」，你肯定尝过，对吧？"
                                        },
                                        {
                                            "id": "698780231",
                                            "speaker": "菲林斯",
                                            "text": "当然。但我很久没喝过了，都快忘了。"
                                        },
                                        {
                                            "id": "698780232",
                                            "speaker": "法尔伽",
                                            "text": "过段时间我去搞一桶，咱们喝个痛快。"
                                        },
                                        {
                                            "id": "698780233",
                                            "speaker": "菲林斯",
                                            "text": "听您的，法尔伽先生。但在那之前，我想咱们应当一起碰个杯，来庆祝今晚美好的相遇。"
                                        },
                                        {
                                            "id": "698780234",
                                            "speaker": "法尔伽",
                                            "text": "好嘞，干杯！"
                                        },
                                        {
                                            "id": "698780235",
                                            "speaker": "Player",
                                            "text": "干杯！"
                                        },
                                        {
                                            "id": "698780236",
                                            "speaker": "派蒙",
                                            "text": "干杯！"
                                        },
                                        {
                                            "id": "698780237",
                                            "speaker": "菲林斯",
                                            "text": "祝各位，今夜愉快。"
                                        }
                                    ]
                                },
                                {
                                    "id": "698780228",
                                    "text": "酒遇见火就会…"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "698780212",
                    "text": "酸一些。",
                    "response": [
                        {
                            "id": "698780213",
                            "speaker": "菲林斯",
                            "text": "看你的脸色有些疲惫。来点酸味提提神，的确不错。嗯…不如来一些柠檬汁吧。"
                        },
                        {
                            "id": "698780214",
                            "speaker": "法尔伽",
                            "text": "我还没尝过酸味的酒呢，最多是在喝完酒之后，再来一点酸的饮料来解酒。"
                        },
                        {
                            "id": "698780215",
                            "speaker": "法尔伽",
                            "text": "这么一说，好久没有尝过诺艾尔做的解酒汤了，她就会在里面放钩钩果和树莓汁。"
                        },
                        {
                            "id": "698780216",
                            "speaker": "法尔伽",
                            "text": "唉，没了诺艾尔的解酒汤，我的酒量都下降了不少，真想回蒙德啊…"
                        }
                    ]
                }
            ]
        }
    ]
}