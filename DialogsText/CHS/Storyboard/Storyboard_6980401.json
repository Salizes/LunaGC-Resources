{
    "talkId": "6980401",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Player": 2,
        "凝光": 10,
        "白术": 4
    },
    "dialogues": [
        {
            "id": "698040101",
            "speaker": "白术",
            "text": "…是心力交杂，思虑过度了。最近又是季节交替，风寒有些重。"
        },
        {
            "id": "698040102",
            "speaker": "凝光",
            "text": "请再给我开些药吧，过几天，我请人过去取。"
        },
        {
            "id": "698040103",
            "speaker": "白术",
            "text": "好吧。不过，风寒之疾，虽然可以用药驱逐，但…如果天权大人继续如此心力交瘁，这病恐怕还要反复。"
        },
        {
            "id": "698040104",
            "speaker": "凝光",
            "text": "谢谢白大夫叮嘱，但璃月诸事，放不下也轻不得…还是先开些药，缓和此时的病症吧。"
        },
        {
            "id": "698040105",
            "speaker": "白术",
            "text": "唉…我再开些温养的食疗方子吧。慢慢调理，先让身子别亏虚太多。"
        },
        {
            "id": "698040106",
            "speaker": "凝光",
            "text": "#{NICKNAME}，真是贵客。是有什么急事么？",
            "choices": [
                {
                    "id": "698040107",
                    "text": "听起来你没休息好…",
                    "response": [
                        {
                            "id": "698040109",
                            "speaker": "凝光",
                            "text": "昨天睡得少了，今天起来又受了凉风，感上了风寒。"
                        },
                        {
                            "id": "698040110",
                            "speaker": "凝光",
                            "text": "本来想着吃吃药应付过去，没想到头痛得很，只能把白大夫请来。"
                        },
                        {
                            "id": "698040111",
                            "speaker": "凝光",
                            "text": "呵呵，每隔一段时间，白大夫就要来给我看病开药，也是麻烦您了。"
                        },
                        {
                            "id": "698040112",
                            "speaker": "白术",
                            "text": "哪里的话，看病救人，本就是我职责所在，算不得麻烦。只是…"
                        },
                        {
                            "id": "698040113",
                            "speaker": "凝光",
                            "text": "白大夫，这里也是我的职责所在。"
                        },
                        {
                            "id": "698040114",
                            "speaker": "凝光",
                            "text": "总务司万事交汇，不能有半分怠慢，就算我再心力交瘁，也要把事情处理妥当才是。"
                        },
                        {
                            "id": "698040115",
                            "speaker": "凝光",
                            "text": "呵呵…如今只有我一人头痛，要是突然撂下挑子，就不知道有几人要心力交瘁了。"
                        },
                        {
                            "id": "698040116",
                            "speaker": "凝光",
                            "text": "要是总务司里人人心力交瘁，无心办事…那璃月港，只怕也要染上风寒了。"
                        }
                    ]
                },
                {
                    "id": "698040108",
                    "text": "你身体不舒服么？"
                }
            ]
        }
    ]
}