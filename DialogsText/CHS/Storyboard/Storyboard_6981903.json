{
    "talkId": "6981903",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 2,
        "枫原万叶": 10
    },
    "dialogues": [
        {
            "id": "698190301",
            "speaker": "枫原万叶",
            "text": "天气清爽的夜晚，正适合磨练武艺。"
        },
        {
            "id": "698190302",
            "speaker": "枫原万叶",
            "text": "说来有趣，当我回想剑道中的一招一式，旅途的回忆也会一起涌入脑海。"
        },
        {
            "id": "698190303",
            "speaker": "枫原万叶",
            "text": "因此无论我身处何地…握紧刀时，都仿佛与你们站在一起。",
            "choices": [
                {
                    "id": "698190304",
                    "text": "一起切磋下？",
                    "response": [
                        {
                            "id": "698190305",
                            "speaker": "枫原万叶",
                            "text": "再好不过，看来我放在袋中的竹刀总算能派上用场了。"
                        },
                        {
                            "id": "698190306",
                            "speaker": "枫原万叶",
                            "text": "旅行的时候，我也听到了许多有关你的传说。比起我们在稻妻的那段时光，现在的你肯定也变得更强了，对吧？"
                        },
                        {
                            "id": "698190307",
                            "speaker": "枫原万叶",
                            "text": "正巧，我也在不断修行。让我们用手中的刀，来诉说这段经历吧。"
                        }
                    ]
                },
                {
                    "id": "698190308",
                    "text": "接下来打算去哪旅行？",
                    "response": [
                        {
                            "id": "698190309",
                            "speaker": "枫原万叶",
                            "text": "我向北斗大姐头请了假，打算去纳塔看看。"
                        },
                        {
                            "id": "698190310",
                            "speaker": "枫原万叶",
                            "text": "眼下正在收拾行李…这种满怀期待的心情，或许也是旅行的一环吧。"
                        },
                        {
                            "id": "698190311",
                            "speaker": "枫原万叶",
                            "text": "只要我们都在路上，就一定会在下个地方再见。"
                        },
                        {
                            "id": "698190312",
                            "speaker": "枫原万叶",
                            "text": "到那时，我会备上一壶好酒，聊聊彼此的故事。"
                        }
                    ]
                }
            ]
        }
    ]
}