{
    "talkId": "6981003",
    "total_dialogue_lines": 32,
    "speaker_counts": {
        "Player": 6,
        "拉姆达": 7,
        "斯坦利": 1,
        "杰克": 2,
        "罗莎莉亚": 16
    },
    "dialogues": [
        {
            "id": "698100301",
            "speaker": "罗莎莉亚",
            "text": "…都这个时间了，晨祷早就开始了。算了，不去了。",
            "choices": [
                {
                    "id": "698100302",
                    "text": "难道你喝了个通宵？",
                    "response": [
                        {
                            "id": "698100304",
                            "speaker": "罗莎莉亚",
                            "text": "我正在工作呢。"
                        },
                        {
                            "id": "698100305",
                            "speaker": "罗莎莉亚",
                            "text": "看到那张陌生面孔了吗？天刚暗那会儿，他就在和酒馆里的冒险家们喝酒吹牛了。"
                        },
                        {
                            "id": "698100306",
                            "speaker": "Player",
                            "text": "他身上有什么疑点吗？"
                        },
                        {
                            "id": "698100307",
                            "speaker": "罗莎莉亚",
                            "text": "他声称自己是个老道的商人，从璃月来。温暖的酒馆却让他很不自在，他极力用衣服掩盖皮肤上的痕迹。"
                        },
                        {
                            "id": "698100308",
                            "speaker": "罗莎莉亚",
                            "text": "而他摘下手套和人握手的时候，手指上全是刚长出来的冻疮。"
                        },
                        {
                            "id": "698100309",
                            "speaker": "Player",
                            "text": "他去过寒冷的地方吗？"
                        },
                        {
                            "id": "698100310",
                            "speaker": "罗莎莉亚",
                            "text": "比如雪山脚下，然后为了某种目的才来到这里。"
                        },
                        {
                            "id": "698100311",
                            "speaker": "罗莎莉亚",
                            "text": "而谎言则是…",
                            "choices": [
                                {
                                    "id": "698100312",
                                    "text": "哪个老道的商人…",
                                    "response": [
                                        {
                                            "id": "698100314",
                                            "speaker": "斯坦利",
                                            "text": "…请我当护卫，你可算找对人了！"
                                        },
                                        {
                                            "id": "698100315",
                                            "speaker": "拉姆达",
                                            "text": "…斯坦利先生的事迹我早有耳闻。但人数…嗯…还有些不够。"
                                        },
                                        {
                                            "id": "698100316",
                                            "speaker": "拉姆达",
                                            "text": "据线人报，我这批要送往璃月的货，可是被传说中盗宝团的「南长姊」盯上了呀。"
                                        },
                                        {
                                            "id": "698100317",
                                            "speaker": "杰克",
                                            "text": "斯坦利先生，那我要不要再去和凯瑟琳小姐说说？帮帮这位好先生。再说我本来就不想去荆夫港跑腿。"
                                        },
                                        {
                                            "id": "698100318",
                                            "speaker": "拉姆达",
                                            "text": "哎呀，那可真是感激不尽。荆夫港…那不就在蒙德周边？路线很安全啊。"
                                        },
                                        {
                                            "id": "698100319",
                                            "speaker": "拉姆达",
                                            "text": "当然还是我这边更需要人力。钱不是问题，如果能喊上你更多同伴的话…"
                                        },
                                        {
                                            "id": "698100320",
                                            "speaker": "罗莎莉亚",
                                            "text": "就给了你对荆夫港货物下手的可乘之机？"
                                        },
                                        {
                                            "id": "698100321",
                                            "speaker": "拉姆达",
                                            "text": "你…你在说什么！"
                                        },
                                        {
                                            "id": "698100322",
                                            "speaker": "罗莎莉亚",
                                            "text": "跟我走吧，「好先生」。剩下的话不适合在温暖的酒馆聊。"
                                        },
                                        {
                                            "id": "698100323",
                                            "speaker": "杰克",
                                            "text": "可是，修女小姐…他怎么了吗？"
                                        },
                                        {
                                            "id": "698100324",
                                            "speaker": "罗莎莉亚",
                                            "text": "「南长姊」动手前怎么可能露出风声？"
                                        },
                                        {
                                            "id": "698100325",
                                            "speaker": "罗莎莉亚",
                                            "text": "至于调虎离山…盗宝团的老伎俩了。这么多年也没点进步。"
                                        },
                                        {
                                            "id": "698100326",
                                            "speaker": "拉姆达",
                                            "text": "我…我不认识什么盗宝团，我可是清白的！"
                                        },
                                        {
                                            "id": "698100327",
                                            "speaker": "罗莎莉亚",
                                            "text": "听说骑士团那边，最近恰巧抓到了几个在雪山脚下扎营的盗宝团成员。"
                                        },
                                        {
                                            "id": "698100328",
                                            "speaker": "罗莎莉亚",
                                            "text": "既然你是清白的，跟我去见见他们总没问题吧？他们应该不至于把你认出来。"
                                        },
                                        {
                                            "id": "698100329",
                                            "speaker": "拉姆达",
                                            "text": "可恶！"
                                        },
                                        {
                                            "id": "698100330",
                                            "speaker": "罗莎莉亚",
                                            "text": "别想跑。"
                                        },
                                        {
                                            "id": "698100331",
                                            "speaker": "罗莎莉亚",
                                            "text": "露出后背是个错误的选择。"
                                        },
                                        {
                                            "id": "698100332",
                                            "speaker": "罗莎莉亚",
                                            "text": "走吧。说给西风骑士听或者说给我听，你总要选一个。"
                                        }
                                    ]
                                },
                                {
                                    "id": "698100313",
                                    "text": "从璃月来蒙德会走雪山？"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "698100303",
                    "text": "今天没有工作吗？"
                }
            ]
        }
    ]
}