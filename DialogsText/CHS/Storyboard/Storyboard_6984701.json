{
    "talkId": "6984701",
    "total_dialogue_lines": 43,
    "speaker_counts": {
        "Black Screen": 1,
        "Player": 11,
        "久岐忍": 15,
        "托马": 16
    },
    "dialogues": [
        {
            "id": "698470101",
            "speaker": "久岐忍",
            "text": "…也就是说，只要通过了考试，拿到这张「家政服务从业执照」，就能接到更多维修保洁类的活。"
        },
        {
            "id": "698470102",
            "speaker": "托马",
            "text": "久岐小姐抓到重点了，社奉行推广家政技能培训与考试的初衷就是为了促进就业，方便待业的居民找工作。",
            "choices": [
                {
                    "id": "698470103",
                    "text": "阿忍要参加新的考试吗？",
                    "response": [
                        {
                            "id": "698470105",
                            "speaker": "久岐忍",
                            "text": "#哦，是{NICKNAME}。没错，我正在了解社奉行的家政技能培训课。"
                        },
                        {
                            "id": "698470106",
                            "speaker": "久岐忍",
                            "text": "据托马先生说，只要能完整参与一期课程并且通过考试，社奉行就会发放执照，对找工作很有好处。"
                        },
                        {
                            "id": "698470107",
                            "speaker": "托马",
                            "text": "我想，以久岐小姐的才干，要拿到这张执照是很简单的事。"
                        },
                        {
                            "id": "698470108",
                            "speaker": "久岐忍",
                            "text": "过奖。我的确不畏惧考证，不过荒泷派的其他人…"
                        },
                        {
                            "id": "698470109",
                            "speaker": "久岐忍",
                            "text": "老大的上一份工作是在秋沙钱汤帮客人搓背，但他力气太大，直接把人搓出了外伤。"
                        },
                        {
                            "id": "698470110",
                            "speaker": "久岐忍",
                            "text": "阿晃一个月前还在志村屋帮忙烤串，结果每烤好一串他要吃掉三串，要不是旁边的人拦着，志村屋那个月只怕是要亏本。"
                        },
                        {
                            "id": "698470111",
                            "speaker": "久岐忍",
                            "text": "还有阿守和元太…省心一点的可能就只有阿丑了，毕竟它不需要工作。",
                            "choices": [
                                {
                                    "id": "698470112",
                                    "text": "不会被炒吗？",
                                    "response": [
                                        {
                                            "id": "698470114",
                                            "speaker": "久岐忍",
                                            "text": "你猜得没错，我问起来的时候，这几个家伙异口同声告诉我："
                                        },
                                        {
                                            "id": "698470115",
                                            "speaker": "久岐忍",
                                            "text": "「对不起，我们又被开除了，嘿嘿。」"
                                        },
                                        {
                                            "id": "698470116",
                                            "speaker": "久岐忍",
                                            "text": "总之，从结果上来说，除了我，荒泷派全体成员都在待业。",
                                            "choices": [
                                                {
                                                    "id": "698470117",
                                                    "text": "是社会闲散人员啊。",
                                                    "response": [
                                                        {
                                                            "id": "698470119",
                                                            "speaker": "托马",
                                                            "text": "所以，久岐小姐是想帮荒泷派的各位拿到执照，从而让他们更方便找到工作吗？"
                                                        },
                                                        {
                                                            "id": "698470120",
                                                            "speaker": "久岐忍",
                                                            "text": "没错，我就是这个想法。"
                                                        },
                                                        {
                                                            "id": "698470121",
                                                            "speaker": "久岐忍",
                                                            "text": "但要让他们直接来上课考试，八成是不会有结果的，还是我自己先把执照考出来比较好。"
                                                        },
                                                        {
                                                            "id": "698470122",
                                                            "speaker": "久岐忍",
                                                            "text": "然后再回去辅导他们，这样成功的可能性大一些。"
                                                        },
                                                        {
                                                            "id": "698470123",
                                                            "speaker": "托马",
                                                            "text": "非常周到的想法，那么久岐小姐打算现在报名吗？"
                                                        },
                                                        {
                                                            "id": "698470124",
                                                            "speaker": "久岐忍",
                                                            "text": "稍等，我得回去拿一下证件，顺便跟老大他们说一声。"
                                                        },
                                                        {
                                                            "id": "698470125",
                                                            "speaker": "托马",
                                                            "text": "也好，久岐小姐准备好了的话，可以来社奉行府找我报名，直到我休假之前，报名都不会截止。"
                                                        },
                                                        {
                                                            "id": "698470126",
                                                            "speaker": "久岐忍",
                                                            "text": "好，我尽快。多谢托马先生。"
                                                        },
                                                        {
                                                            "id": "698470127",
                                                            "speaker": "Black Screen",
                                                            "text": "阿忍大步离开了…"
                                                        },
                                                        {
                                                            "id": "698470128",
                                                            "speaker": "托马",
                                                            "text": "#是个干脆利落的人啊，你觉得呢？{NICKNAME}，有阵子没见了。",
                                                            "choices": [
                                                                {
                                                                    "id": "698470129",
                                                                    "text": "没有阿忍荒泷派得散。",
                                                                    "response": [
                                                                        {
                                                                            "id": "698470131",
                                                                            "speaker": "Player",
                                                                            "text": "托马要休假吗？"
                                                                        },
                                                                        {
                                                                            "id": "698470132",
                                                                            "speaker": "托马",
                                                                            "text": "嗯，家政技能培训是社奉行一力主导推广的，协助其他吏僚完成报名工作之后，我打算休个长假。"
                                                                        },
                                                                        {
                                                                            "id": "698470133",
                                                                            "speaker": "托马",
                                                                            "text": "家主大人已经批准了，趁这个时间我得回蒙德一趟，帮母亲处理点事情。",
                                                                            "choices": [
                                                                                {
                                                                                    "id": "698470134",
                                                                                    "text": "母亲？",
                                                                                    "response": [
                                                                                        {
                                                                                            "id": "698470136",
                                                                                            "speaker": "托马",
                                                                                            "text": "怎么一脸惊讶的表情，哦…我好像没和你细说过家里人的事情。"
                                                                                        },
                                                                                        {
                                                                                            "id": "698470137",
                                                                                            "speaker": "托马",
                                                                                            "text": "其实也都是平凡的人，我母亲土生土长在蒙德，是西风骑士团的骑士。"
                                                                                        },
                                                                                        {
                                                                                            "id": "698470138",
                                                                                            "speaker": "托马",
                                                                                            "text": "锁国令解除之后，蒙德和稻妻的往来变多了，我和她通信变得方便起来。"
                                                                                        },
                                                                                        {
                                                                                            "id": "698470139",
                                                                                            "speaker": "托马",
                                                                                            "text": "哈哈，有一次收到她的信，一定要我寄稻妻的酒回去，让她尝尝我在稻妻能喝到什么。"
                                                                                        },
                                                                                        {
                                                                                            "id": "698470140",
                                                                                            "speaker": "托马",
                                                                                            "text": "哪有酒能和蒙德的蒲公英酒比嘛，可惜，她现在要喝家乡的酒就没那么容易了。"
                                                                                        },
                                                                                        {
                                                                                            "id": "698470141",
                                                                                            "speaker": "托马",
                                                                                            "text": "法尔伽大团长带队远征，现在驻扎在挪德卡莱，我母亲也受抽调，已经动身去加入驻队了。"
                                                                                        },
                                                                                        {
                                                                                            "id": "698470142",
                                                                                            "speaker": "托马",
                                                                                            "text": "我这次回去，要帮忙处理她留在家里的东西，正好也这么久没回去，不知道蒙德城变化大不大。"
                                                                                        },
                                                                                        {
                                                                                            "id": "698470143",
                                                                                            "speaker": "托马",
                                                                                            "text": "你是到处旅行的人，有机会的话，说不定我们会在蒙德城里碰上吧。"
                                                                                        }
                                                                                    ]
                                                                                },
                                                                                {
                                                                                    "id": "698470135",
                                                                                    "text": "托马要回蒙德了？"
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                },
                                                                {
                                                                    "id": "698470130",
                                                                    "text": "阿忍又要多一张证书了。"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "698470118",
                                                    "text": "在荒泷派，倒也正常。"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "698470113",
                                    "text": "他们的工作…"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "698470104",
                    "text": "阿忍要找新工作吗？"
                }
            ]
        }
    ]
}