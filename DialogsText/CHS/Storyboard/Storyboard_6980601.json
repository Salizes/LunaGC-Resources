{
    "talkId": "6980601",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 3,
        "刻晴": 9
    },
    "dialogues": [
        {
            "id": "698060101",
            "speaker": "刻晴",
            "text": "咦？白大夫怎么不在，那只能过几天来了…"
        },
        {
            "id": "698060102",
            "speaker": "刻晴",
            "text": "#{NICKNAME}，你怎么也来不卜庐了，是哪里难受么？还是生了病来抓药？",
            "choices": [
                {
                    "id": "698060103",
                    "text": "看见刻晴在这里，就过来了。",
                    "response": [
                        {
                            "id": "698060105",
                            "speaker": "刻晴",
                            "text": "算不上大事，就是前几天下山时没留神，崴了脚腕。"
                        },
                        {
                            "id": "698060106",
                            "speaker": "刻晴",
                            "text": "最初没在意，结果过了一夜，整个脚腕都疼得要裂开一样，连路也走不了。"
                        },
                        {
                            "id": "698060107",
                            "speaker": "刻晴",
                            "text": "还好甘雨过来探望我，帮忙去不卜庐请来了白大夫，敷上了药。"
                        },
                        {
                            "id": "698060108",
                            "speaker": "刻晴",
                            "text": "多亏了白大夫医术高超，过了几天就能下床走路，现在连疼也不疼了。"
                        },
                        {
                            "id": "698060109",
                            "speaker": "Player",
                            "text": "真的没问题么？"
                        },
                        {
                            "id": "698060110",
                            "speaker": "刻晴",
                            "text": "已经好的差不多了。这次过来，也只是拿一些温养的药物。"
                        },
                        {
                            "id": "698060111",
                            "speaker": "刻晴",
                            "text": "放心吧，我自己心里有数。我几乎天天在外面测量土地，这种小伤不知道受过多少次，算不得大问题。"
                        },
                        {
                            "id": "698060112",
                            "speaker": "刻晴",
                            "text": "#喔，白大夫好像来了，那我先去拿药了，{NICKNAME}，我们回头再聊。"
                        }
                    ]
                },
                {
                    "id": "698060104",
                    "text": "刻晴是生病了么？"
                }
            ]
        }
    ]
}