    "dialogues": [
        {
            "id": "698572001",
            "speaker": "雅珂达",
            "text": "#不过…{NICKNAME}，你为什么是医生啊。医生要怎么…偷袭呢？",
            "choices": [
                {
                    "id": "698572002",
                    "text": "我可以用药物攻击。",
                    "response": [
                        {
                            "id": "698572003",
                            "speaker": "「主持人」",
                            "text": "#{NICKNAME}的药箱中，确实存有强毒性和麻醉类的药物。"
                        }
                    ]
                },
                {
                    "id": "698572004",
                    "text": "我可以用沉重的药箱击倒它们。",
                    "response": [
                        {
                            "id": "698572005",
                            "speaker": "「主持人」",
                            "text": "#我计算过{NICKNAME}所携带药箱的重量，确实可以。"
                        },
                        {
                            "id": "698572006",
                            "speaker": "「主持人」",
                            "text": "另外，在投掷药箱后，药箱内所存放的强毒性和麻醉类药物，也会被视为对目标进行了一次投掷。"
                        }
                    ]
                }
            ]
        }
    ]
}