{
    "talkId": "6985710",
    "total_dialogue_lines": 35,
    "speaker_counts": {
        "Player": 12,
        "「主持人」": 1,
        "克洛琳德": 6,
        "叶洛亚": 3,
        "娜维娅": 7,
        "派蒙": 1,
        "雅珂达": 5
    },
    "dialogues": [
        {
            "id": "698571001",
            "speaker": "雅珂达",
            "text": "叶洛亚，你真的不能和我一起偷偷摸摸到怪物背后偷袭，把它们全部打倒吗？"
        },
        {
            "id": "698571002",
            "speaker": "雅珂达",
            "text": "我一轮可以行动三次欸，总共就四个怪物，我打倒三个，你打倒一个就行。"
        },
        {
            "id": "698571003",
            "speaker": "叶洛亚",
            "text": "我可以正面吸引怪物的注意力，但偷袭…"
        },
        {
            "id": "698571004",
            "speaker": "娜维娅",
            "text": "唉，这也是没办法的事。毕竟叶洛亚是选了「公正之杯」的「纯水骑士」嘛。"
        },
        {
            "id": "698571005",
            "speaker": "「主持人」",
            "text": "是的。如果叶洛亚选择从背后偷袭，那么就会被迫转为「弃誓骑士」，在进行所有行动时，都会附加一个巨大的减值。"
        },
        {
            "id": "698571006",
            "speaker": "娜维娅",
            "text": "这下糟糕了，要是不一口气打倒所有怪物，那我们所有人都要被炸药炸飞了啊！"
        },
        {
            "id": "698571007",
            "speaker": "叶洛亚",
            "text": "还有一个办法。我可以用「狂澜波」一口气冲到最深处，然后引爆炸药…"
        },
        {
            "id": "698571008",
            "speaker": "娜维娅",
            "text": "不行不行，那样你的角色不就要被「除名」了嘛！大家好不容易聚起来玩得这么开心，你一个人被「除名」也太可惜了啦。"
        },
        {
            "id": "698571009",
            "speaker": "叶洛亚",
            "text": "但是，如果不这样做，娜维娅小姐玩了这么久的「角色」恐怕也要被「除名」，这样不更可惜了吗？"
        },
        {
            "id": "698571010",
            "speaker": "雅珂达",
            "text": "我才刚玩没多久，不要啊——"
        },
        {
            "id": "698571011",
            "speaker": "娜维娅",
            "text": "呜——没关系，我还有一招。"
        },
        {
            "id": "698571012",
            "speaker": "克洛琳德",
            "text": "娜维娅，把蛋卷收回去。"
        },
        {
            "id": "698571013",
            "speaker": "雅珂达",
            "text": "呜哇！这一招也被防住了啊！",
            "choices": [
                {
                    "id": "698571014",
                    "text": "娜维娅？",
                    "response": [
                        {
                            "id": "698571016",
                            "speaker": "派蒙",
                            "text": "这桌上的摆件，还有你们刚才说的话，你们这是在玩…"
                        },
                        {
                            "id": "698571017",
                            "speaker": "娜维娅",
                            "text": "#救星来啦！{NICKNAME}，你来得正好！快快快，快加入我们！"
                        },
                        {
                            "id": "698571018",
                            "speaker": "娜维娅",
                            "text": "克洛琳德，这样应该不算违反规则吧？"
                        },
                        {
                            "id": "698571103",
                            "speaker": "克洛琳德",
                            "text": "#如果{NICKNAME}同意的话。顺便一提，为了照顾新人，我们现在玩的难度是「轻松体验」。"
                        },
                        {
                            "id": "698571104",
                            "speaker": "娜维娅",
                            "text": "#{NICKNAME}，你愿意和我们继续冒险吗？肯定愿意的，对吧？",
                            "choices": [
                                {
                                    "id": "698571105",
                                    "text": "咦？怎么突然就——",
                                    "response": [
                                        {
                                            "id": "698571107",
                                            "speaker": "雅珂达",
                                            "text": "别问啦，再问我们就要被炸药全部炸飞了啊——",
                                            "choices": [
                                                {
                                                    "id": "698571108",
                                                    "text": "愿、愿意！",
                                                    "response": [
                                                        {
                                                            "id": "698571110",
                                                            "speaker": "克洛琳德",
                                                            "text": "#好。但{NICKNAME}毕竟这么长时间没有游玩剧本了，可以拥有一次重新选择技能的机会。"
                                                        },
                                                        {
                                                            "id": "698571111",
                                                            "speaker": "克洛琳德",
                                                            "text": "可以修改的技能是「厨艺」和「医术」，怎么样，要修改吗？",
                                                            "choices": [
                                                                {
                                                                    "id": "698571112",
                                                                    "text": "学习「厨艺」…",
                                                                    "response": [
                                                                        {
                                                                            "id": "698571113",
                                                                            "speaker": "克洛琳德",
                                                                            "text": "可以，你确定想要学习的技能是「厨艺」，对吧？",
                                                                            "choices": [
                                                                                {
                                                                                    "id": "698571116",
                                                                                    "text": "确定。"
                                                                                },
                                                                                {
                                                                                    "id": "698571117",
                                                                                    "text": "我再想想…"
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                },
                                                                {
                                                                    "id": "698571114",
                                                                    "text": "学习「医术」…",
                                                                    "response": [
                                                                        {
                                                                            "id": "698571115",
                                                                            "speaker": "克洛琳德",
                                                                            "text": "可以，你确定想要学习的技能是「医术」，对吧？",
                                                                            "choices": [
                                                                                {
                                                                                    "id": "698571116",
                                                                                    "text": "确定。"
                                                                                },
                                                                                {
                                                                                    "id": "698571117",
                                                                                    "text": "我再想想…"
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "698571109",
                                                    "text": "我加入，我加入——"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "698571106",
                                    "text": "继续冒险？难道是顺着上次的…"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "698571015",
                    "text": "还有克洛琳德？"
                }
            ]
        }
    ]
}