{
    "talkId": "6986301",
    "total_dialogue_lines": 35,
    "speaker_counts": {
        "Player": 13,
        "辛焱": 22
    },
    "dialogues": [
        {
            "id": "698630101",
            "speaker": "辛焱",
            "text": "#哟，居然是{NICKNAME}！"
        },
        {
            "id": "698630102",
            "speaker": "辛焱",
            "text": "没想到能在这里遇见你，太绝了太妙了，我应该为此即兴一曲！",
            "choices": [
                {
                    "id": "698630103",
                    "text": "你好呀辛焱！",
                    "response": [
                        {
                            "id": "698630105",
                            "speaker": "辛焱",
                            "text": "是啊，我刚玩个痛快呢。「玩」可是找灵感的好办法。"
                        },
                        {
                            "id": "698630106",
                            "speaker": "辛焱",
                            "text": "虽说我的歌啊，大多数的主题是激烈的反抗，还有打破讨厌的成见…但这并不意味着旋律也要永远严肃。"
                        },
                        {
                            "id": "698630107",
                            "speaker": "辛焱",
                            "text": "丧气过头的话，曲子里的精气神也会不足，所以，保持心情明亮，是件很重要的事。"
                        },
                        {
                            "id": "698630108",
                            "speaker": "辛焱",
                            "text": "多玩多散心，多养精蓄锐，歌喉里的芯和拨动琴弦时的音头，才能充满力劲。",
                            "choices": [
                                {
                                    "id": "698630109",
                                    "text": "说得有道理。",
                                    "response": [
                                        {
                                            "id": "698630112",
                                            "speaker": "辛焱",
                                            "text": "大概是为了…意想不到的突破？"
                                        },
                                        {
                                            "id": "698630113",
                                            "speaker": "辛焱",
                                            "text": "之前我一直在埋头写新歌，但总感觉，写出来的许多小样，都摆脱不了以前的影子，这可不行。"
                                        },
                                        {
                                            "id": "698630114",
                                            "speaker": "辛焱",
                                            "text": "于是，为了跳出自己给自己画下的「大牢」，我就出远门来旅游。",
                                            "choices": [
                                                {
                                                    "id": "698630115",
                                                    "text": "行动力好强。",
                                                    "response": [
                                                        {
                                                            "id": "698630117",
                                                            "speaker": "辛焱",
                                                            "text": "上一站，我去了枫丹。在一篇报刊上，我看到了挪德卡莱的风景照，一下子来了兴趣，就去搜罗了一些情报。"
                                                        },
                                                        {
                                                            "id": "698630118",
                                                            "speaker": "辛焱",
                                                            "text": "结果发现，本地的氛围和意境，我以前从没接触过。似乎，名叫「霜月之子」的群体，还会演奏很有特色的器乐…"
                                                        },
                                                        {
                                                            "id": "698630119",
                                                            "speaker": "辛焱",
                                                            "text": "我就在想，能不能把这种当地民谣风格的元素，融入我擅长的音乐之中？",
                                                            "choices": [
                                                                {
                                                                    "id": "698630120",
                                                                    "text": "融合…特色？",
                                                                    "response": [
                                                                        {
                                                                            "id": "698630122",
                                                                            "speaker": "辛焱",
                                                                            "text": "当然，融合的是一些笛类，键琴类乐器的空灵音色，还有少数特色的旋律段落。"
                                                                        },
                                                                        {
                                                                            "id": "698630123",
                                                                            "speaker": "辛焱",
                                                                            "text": "作曲编曲和歌词之类的重要部分，还是不能完全变成其他的风格。"
                                                                        },
                                                                        {
                                                                            "id": "698630124",
                                                                            "speaker": "辛焱",
                                                                            "text": "话又说回来了，刚到那夏镇的时候，我的琴盒不小心碰到了一堵铁皮墙，结果发出了非常奇妙的声响…"
                                                                        },
                                                                        {
                                                                            "id": "698630125",
                                                                            "speaker": "辛焱",
                                                                            "text": "灵感一下子就在我的脑袋里爆发了，我意识到，不仅能引入新乐器，丰富曲子的听感，我的主音琴也有着提升音色的空间！",
                                                                            "choices": [
                                                                                {
                                                                                    "id": "698630126",
                                                                                    "text": "是什么样的音色？",
                                                                                    "response": [
                                                                                        {
                                                                                            "id": "698630128",
                                                                                            "speaker": "辛焱",
                                                                                            "text": "铮铮扎~铮铮扎…这样？"
                                                                                        },
                                                                                        {
                                                                                            "id": "698630129",
                                                                                            "speaker": "辛焱",
                                                                                            "text": "啊呀，只用喉咙当然发不出琴的声音！"
                                                                                        },
                                                                                        {
                                                                                            "id": "698630130",
                                                                                            "speaker": "辛焱",
                                                                                            "text": "简单来说，要凝练，紧实，干净且凶猛。"
                                                                                        },
                                                                                        {
                                                                                            "id": "698630131",
                                                                                            "speaker": "辛焱",
                                                                                            "text": "改改琴身内部的腔体，加大音色压缩，把单音孔改成双音孔来增强低频的表现，从而增强锋利和金属感…",
                                                                                            "choices": [
                                                                                                {
                                                                                                    "id": "698630132",
                                                                                                    "text": "听不太懂了…但是感觉很厉害！",
                                                                                                    "response": [
                                                                                                        {
                                                                                                            "id": "698630134",
                                                                                                            "speaker": "辛焱",
                                                                                                            "text": "哈哈，有你给我打气，我的动力就像是…连续两百速度的双踩底鼓，汹涌至极！"
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "698630135",
                                                                                                            "speaker": "辛焱",
                                                                                                            "text": "等我好好琢磨琢磨，狠狠下功夫捣鼓一番，再正式邀请你来听我的突破性新作！"
                                                                                                        }
                                                                                                    ]
                                                                                                },
                                                                                                {
                                                                                                    "id": "698630133",
                                                                                                    "text": "期待成品的效果！"
                                                                                                }
                                                                                            ]
                                                                                        }
                                                                                    ]
                                                                                },
                                                                                {
                                                                                    "id": "698630127",
                                                                                    "text": "简单哼哼听听？"
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                },
                                                                {
                                                                    "id": "698630121",
                                                                    "text": "民谣…摇滚？"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "698630116",
                                                    "text": "确实是个好办法。"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "698630110",
                                    "text": "不过，玩的去处应该很多？"
                                },
                                {
                                    "id": "698630111",
                                    "text": "为什么选了挪德卡莱？"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "698630104",
                    "text": "你也来这边玩？"
                }
            ]
        }
    ]
}