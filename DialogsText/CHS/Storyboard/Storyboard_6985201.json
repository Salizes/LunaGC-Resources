{
    "talkId": "6985201",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 3,
        "希诺宁": 11
    },
    "dialogues": [
        {
            "id": "698520101",
            "speaker": "希诺宁",
            "text": "又是给我的指名委托？不接不接，拜托你帮我原路退回。"
        },
        {
            "id": "698520102",
            "speaker": "希诺宁",
            "text": "要谈事情的话，麻烦自己来我工坊。我不接受用书信的方式谈工作。"
        },
        {
            "id": "698520103",
            "speaker": "Player",
            "text": "还、还能原路退回的？"
        },
        {
            "id": "698520104",
            "speaker": "希诺宁",
            "text": "唉，你是不知道，用书信的方式谈工作真的很麻烦啊。"
        },
        {
            "id": "698520105",
            "speaker": "希诺宁",
            "text": "光是修改一个零件的尺寸，我说不定就要和客人来来回回互相寄十几封信。"
        },
        {
            "id": "698520106",
            "speaker": "希诺宁",
            "text": "光是递送信件，就不知道浪费了多少时间。"
        },
        {
            "id": "698520107",
            "speaker": "希诺宁",
            "text": "有那个闲工夫，还不如直接到部族里和我面谈，这样子效率最高。"
        },
        {
            "id": "698520108",
            "speaker": "希诺宁",
            "text": "…哈？还有一封信给我？一定要我拆开？真是…"
        },
        {
            "id": "698520109",
            "speaker": "希诺宁",
            "text": "……",
            "choices": [
                {
                    "id": "698520110",
                    "text": "怎么了？",
                    "response": [
                        {
                            "id": "698520112",
                            "speaker": "希诺宁",
                            "text": "是玛薇卡。她已经在我的工坊里，等着和我「面谈」了。"
                        },
                        {
                            "id": "698520113",
                            "speaker": "希诺宁",
                            "text": "玛…薇…卡…"
                        },
                        {
                            "id": "698520114",
                            "speaker": "希诺宁",
                            "text": "不行。我要再想个办法，离部族远一点…"
                        }
                    ]
                },
                {
                    "id": "698520111",
                    "text": "是难缠的客人吗？"
                }
            ]
        }
    ]
}