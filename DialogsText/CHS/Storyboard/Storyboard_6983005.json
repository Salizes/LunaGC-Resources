{
    "talkId": "6983005",
    "total_dialogue_lines": 35,
    "speaker_counts": {
        "Player": 13,
        "鹿野院平藏": 22
    },
    "dialogues": [
        {
            "id": "698300501",
            "speaker": "鹿野院平藏",
            "text": "没想到，居然有这么一位意外的帮手…"
        },
        {
            "id": "698300502",
            "speaker": "鹿野院平藏",
            "text": "不过，这桩案子也算是结了。九条大人那边…唉，还要想点说辞才行啊…",
            "choices": [
                {
                    "id": "698300503",
                    "text": "成功破案了？",
                    "response": [
                        {
                            "id": "698300505",
                            "speaker": "鹿野院平藏",
                            "text": "呃…惭愧惭愧，要是没有多莉小姐的帮忙，这案件只怕也没这么容易结案…",
                            "choices": [
                                {
                                    "id": "698300506",
                                    "text": "多莉？她帮了什么忙？",
                                    "response": [
                                        {
                                            "id": "698300508",
                                            "speaker": "鹿野院平藏",
                                            "text": "多莉小姐的药水？喔，应当是「保证人能轻轻松松长高的超厉害灵药」对吧？我有所耳闻。"
                                        },
                                        {
                                            "id": "698300509",
                                            "speaker": "鹿野院平藏",
                                            "text": "她早就在天领奉行的名簿上有过登记了，那瓶药水也被我们拿去查验过。"
                                        },
                                        {
                                            "id": "698300510",
                                            "speaker": "鹿野院平藏",
                                            "text": "药水里的成分确实都是无害的健康草药，在某种程度上来说，确实有增高效果。"
                                        },
                                        {
                                            "id": "698300511",
                                            "speaker": "Player",
                                            "text": "难道多莉说的是真的…"
                                        },
                                        {
                                            "id": "698300512",
                                            "speaker": "鹿野院平藏",
                                            "text": "哈哈哈，但你仔细看看她所说的宣传语：「保证人能轻轻松松长高的超厉害灵药」。"
                                        },
                                        {
                                            "id": "698300513",
                                            "speaker": "鹿野院平藏",
                                            "text": "这里有提到长高所需要的「时间」吗？",
                                            "choices": [
                                                {
                                                    "id": "698300514",
                                                    "text": "啊…！",
                                                    "response": [
                                                        {
                                                            "id": "698300516",
                                                            "speaker": "鹿野院平藏",
                                                            "text": "对吧，喝这种药水确实有助于人增高，但到底要喝多久…那就说不好了。"
                                                        },
                                                        {
                                                            "id": "698300517",
                                                            "speaker": "鹿野院平藏",
                                                            "text": "要我说，如果真的想要增高的话，与其喝这种药水，还不如多喝点牛奶呢。",
                                                            "choices": [
                                                                {
                                                                    "id": "698300518",
                                                                    "text": "所以她才那么大张旗鼓…",
                                                                    "response": [
                                                                        {
                                                                            "id": "698300520",
                                                                            "speaker": "鹿野院平藏",
                                                                            "text": "是啊。依我看，多莉小姐自己也知道，这瓶所谓灵药的「药效」并不显著。"
                                                                        },
                                                                        {
                                                                            "id": "698300521",
                                                                            "speaker": "鹿野院平藏",
                                                                            "text": "所以，才想要借用这样的宣传，将大众的注意力引导到有利于自己的方向。"
                                                                        },
                                                                        {
                                                                            "id": "698300522",
                                                                            "speaker": "鹿野院平藏",
                                                                            "text": "嗯…这么一想，怪不得多莉小姐在帮我们忙的时候那么爽快…连报酬都没详细谈。",
                                                                            "choices": [
                                                                                {
                                                                                    "id": "698300523",
                                                                                    "text": "你说的忙…",
                                                                                    "response": [
                                                                                        {
                                                                                            "id": "698300525",
                                                                                            "speaker": "鹿野院平藏",
                                                                                            "text": "没错，多亏了多莉小姐，我才能找到案件的突破口。"
                                                                                        },
                                                                                        {
                                                                                            "id": "698300526",
                                                                                            "speaker": "鹿野院平藏",
                                                                                            "text": "当时我请她帮忙时，还以为这位大商人会狮子大开口，结果她什么也没要…"
                                                                                        },
                                                                                        {
                                                                                            "id": "698300527",
                                                                                            "speaker": "鹿野院平藏",
                                                                                            "text": "现在看来…那个犯罪团伙里仅存的一些正经商业渠道和合作伙伴，只怕早就被多莉小姐收下了。",
                                                                                            "choices": [
                                                                                                {
                                                                                                    "id": "698300528",
                                                                                                    "text": "怪不得她这么有自信…",
                                                                                                    "response": [
                                                                                                        {
                                                                                                            "id": "698300530",
                                                                                                            "speaker": "鹿野院平藏",
                                                                                                            "text": "算了算了，这些生意人的心思啊，我可揣摩不透。"
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "698300531",
                                                                                                            "speaker": "鹿野院平藏",
                                                                                                            "text": "但有多莉小姐这么一位神通广大的「线人」在，今后破起案来，应该会更加轻松吧…"
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "698300532",
                                                                                                            "speaker": "鹿野院平藏",
                                                                                                            "text": "…咳。九条大人不在吧？好，还好她走了…"
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "698300533",
                                                                                                            "speaker": "鹿野院平藏",
                                                                                                            "text": "呃，不好不好，聊了这么久，我要快点回奉行所了，不然九条大人只怕要生气了。"
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "698300534",
                                                                                                            "speaker": "鹿野院平藏",
                                                                                                            "text": "#回头见啦，{NICKNAME}。"
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "698300535",
                                                                                                            "speaker": "鹿野院平藏",
                                                                                                            "text": "记住，别犯罪喔。"
                                                                                                        }
                                                                                                    ]
                                                                                                },
                                                                                                {
                                                                                                    "id": "698300529",
                                                                                                    "text": "怪不得她会突然推销药水…"
                                                                                                }
                                                                                            ]
                                                                                        }
                                                                                    ]
                                                                                },
                                                                                {
                                                                                    "id": "698300524",
                                                                                    "text": "难道是那桩违禁药水的案子？"
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                },
                                                                {
                                                                    "id": "698300519",
                                                                    "text": "又是请早柚，又是请魔术师…"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "698300515",
                                                    "text": "完、完全没提到…"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "698300507",
                                    "text": "我刚从她那边拿了一瓶药水…"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "698300504",
                    "text": "不愧是平藏！"
                }
            ]
        }
    ]
}