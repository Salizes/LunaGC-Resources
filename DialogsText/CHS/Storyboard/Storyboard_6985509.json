    "dialogues": [
        {
            "id": "698550901",
            "speaker": "爱诺",
            "text": "带上这些零食吧，还有我和伊涅芙编的帽子，对了，你的角也需要抹一些保护油才行，等一下喔…"
        },
        {
            "id": "698550902",
            "speaker": "伊涅芙",
            "text": "保护油在这里，爱诺。我也来帮忙。"
        },
        {
            "id": "698550903",
            "speaker": "凛角鹿",
            "text": "……"
        },
        {
            "id": "698550904",
            "speaker": "菈乌玛",
            "text": "呵呵，它说：「能和你们成为朋友，是一件很好很好的事。」"
        }
    ]
