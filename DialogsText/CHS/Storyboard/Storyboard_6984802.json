{
    "talkId": "6984802",
    "total_dialogue_lines": 41,
    "speaker_counts": {
        "Player": 4,
        "梦见月瑞希": 13,
        "莱依拉": 24
    },
    "dialogues": [
        {
            "id": "698480201",
            "speaker": "梦见月瑞希",
            "text": "…看来，你是莱依拉小姐的「第二个人格」，对吧。"
        },
        {
            "id": "698480202",
            "speaker": "莱依拉",
            "text": "第二个人格？妖怪小姐，你可别搞错了，我就是「莱依拉」，现在，我只是在「梦游」。",
            "choices": [
                {
                    "id": "698480203",
                    "text": "你…你是…",
                    "response": [
                        {
                            "id": "698480205",
                            "speaker": "莱依拉",
                            "text": "#不愧是我的挚友{NICKNAME}，这个称呼非常准确。"
                        },
                        {
                            "id": "698480206",
                            "speaker": "梦见月瑞希",
                            "text": "性格也和莱依拉小姐相反。哼…简直就像是在原本的人格上戴了「面具」一样。"
                        },
                        {
                            "id": "698480207",
                            "speaker": "莱依拉",
                            "text": "「戴上面具」？唔，这样的说法还挺有趣的。"
                        },
                        {
                            "id": "698480208",
                            "speaker": "梦见月瑞希",
                            "text": "像你这样的「面具」，还存在着几副？"
                        },
                        {
                            "id": "698480209",
                            "speaker": "莱依拉",
                            "text": "嗤。妖怪小姐，看你的架势。如果我说出：「不止一副」的话，你会怎么样？"
                        },
                        {
                            "id": "698480210",
                            "speaker": "梦见月瑞希",
                            "text": "我的处理方法，会视您的回答而定。请作答吧，不过需要说明的是，在这里谎言是无效的。"
                        },
                        {
                            "id": "698480211",
                            "speaker": "莱依拉",
                            "text": "可怕可怕…放心吧，我是唯一的。再说了，我可不是你说的那种家伙。"
                        },
                        {
                            "id": "698480212",
                            "speaker": "莱依拉",
                            "text": "最多，我就是在她陷入久违的良好睡眠之后，帮她做一下作业，画一画星图而已。"
                        },
                        {
                            "id": "698480213",
                            "speaker": "莱依拉",
                            "text": "最近这孩子把自己逼得更紧了，压力越来越大…虽然莱依拉憋着不说，但她心里转的那些事情，我可都知道。"
                        },
                        {
                            "id": "698480214",
                            "speaker": "莱依拉",
                            "text": "明明事情都做得还算不错，她却总是鸡蛋里挑骨头。就好像找不出错，就誓不罢休一样。"
                        },
                        {
                            "id": "698480215",
                            "speaker": "梦见月瑞希",
                            "text": "…内向攻击的行为这么强烈。在平时的学习和生活里，莱依拉小姐所受到的正向反馈很少？"
                        },
                        {
                            "id": "698480216",
                            "speaker": "莱依拉",
                            "text": "没有，无论是导师还是同学，都对莱依拉称赞有加。"
                        },
                        {
                            "id": "698480217",
                            "speaker": "莱依拉",
                            "text": "但以「她」的性格，并不会在意那些已然完结的工作，反而…会被那些尚未填补的错漏吸引。"
                        },
                        {
                            "id": "698480218",
                            "speaker": "梦见月瑞希",
                            "text": "…我明白了，在后续的诊疗里，我会注意调整治疗方案的。"
                        },
                        {
                            "id": "698480219",
                            "speaker": "梦见月瑞希",
                            "text": "但我也要提一句，如果莱依拉小姐恢复了正常，你也会消失。"
                        },
                        {
                            "id": "698480220",
                            "speaker": "莱依拉",
                            "text": "这样么？那挺好的，我期待着消失的那一天。"
                        },
                        {
                            "id": "698480221",
                            "speaker": "梦见月瑞希",
                            "text": "……"
                        },
                        {
                            "id": "698480222",
                            "speaker": "莱依拉",
                            "text": "怎么了？妖怪小姐，我本来就是「莱依拉」，从始至终，一直都是。"
                        },
                        {
                            "id": "698480223",
                            "speaker": "莱依拉",
                            "text": "你所谓的「消失」。只不过，是摘下了「面具」而已。"
                        },
                        {
                            "id": "698480224",
                            "speaker": "莱依拉",
                            "text": "#{NICKNAME}，能稍微扶着我一点吗？我觉得…睡得差不多了。"
                        },
                        {
                            "id": "698480225",
                            "speaker": "莱依拉",
                            "text": "唔…？我…我怎么…",
                            "choices": [
                                {
                                    "id": "698480226",
                                    "text": "我扶着你呢。",
                                    "response": [
                                        {
                                            "id": "698480228",
                                            "speaker": "莱依拉",
                                            "text": "#谢谢你，{NICKNAME}。我、我不是应该在接受诊疗吗？我不会…不会又梦游了吧？"
                                        },
                                        {
                                            "id": "698480229",
                                            "speaker": "莱依拉",
                                            "text": "瑞希小姐！我有没有说失礼的话，或者做什么过分的事…"
                                        },
                                        {
                                            "id": "698480230",
                                            "speaker": "梦见月瑞希",
                                            "text": "没有，放心吧。不过…莱依拉小姐突然在诊疗中醒过来，可是把我吓了一跳。"
                                        },
                                        {
                                            "id": "698480231",
                                            "speaker": "莱依拉",
                                            "text": "对不起，肯定是我之前几个星期都没睡好的原因。只要我没睡好，就容易开始梦游。"
                                        },
                                        {
                                            "id": "698480232",
                                            "speaker": "梦见月瑞希",
                                            "text": "那么，刚才这一觉您睡得怎么样呢？"
                                        },
                                        {
                                            "id": "698480233",
                                            "speaker": "莱依拉",
                                            "text": "欸？嗯…睡得很好，头不晕了，眼睛也不花了。"
                                        },
                                        {
                                            "id": "698480234",
                                            "speaker": "莱依拉",
                                            "text": "但我做了一个好奇怪的梦。梦见一个看不清脸的人坐在我旁边，还一直握着我的手。"
                                        },
                                        {
                                            "id": "698480235",
                                            "speaker": "莱依拉",
                                            "text": "她好像是在说什么，但我没听清。只觉得…她坐在旁边，很让我安心。我…"
                                        },
                                        {
                                            "id": "698480236",
                                            "speaker": "梦见月瑞希",
                                            "text": "好了，到此为止。"
                                        },
                                        {
                                            "id": "698480237",
                                            "speaker": "梦见月瑞希",
                                            "text": "梦境只是顺水奔流而下的绯樱，偶尔回味还好，若是想要伸手抓住…"
                                        },
                                        {
                                            "id": "698480238",
                                            "speaker": "莱依拉",
                                            "text": "…嗯，我知道了。"
                                        },
                                        {
                                            "id": "698480239",
                                            "speaker": "梦见月瑞希",
                                            "text": "好了，今天的诊疗到此为止。明天这个时候，还请莱依拉小姐按时登门啊。"
                                        },
                                        {
                                            "id": "698480240",
                                            "speaker": "莱依拉",
                                            "text": "#好、好的！谢谢您，也谢谢{NICKNAME}刚才扶住我。"
                                        },
                                        {
                                            "id": "698480241",
                                            "speaker": "莱依拉",
                                            "text": "那么，我就先告辞了…我觉得，现在能写出很棒的综述！"
                                        }
                                    ]
                                },
                                {
                                    "id": "698480227",
                                    "text": "慢点，莱依拉。"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "698480204",
                    "text": "梦游版莱依拉！"
                }
            ]
        }
    ]
}