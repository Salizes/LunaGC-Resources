{
    "talkId": "6981404",
    "total_dialogue_lines": 23,
    "speaker_counts": {
        "Player": 5,
        "迪奥娜": 6,
        "雷泽": 12
    },
    "dialogues": [
        {
            "id": "698140401",
            "speaker": "雷泽",
            "text": "肚子…不对劲…"
        },
        {
            "id": "698140402",
            "speaker": "雷泽",
            "text": "眼皮…重。困了…但天，亮的？"
        },
        {
            "id": "698140403",
            "speaker": "雷泽",
            "text": "…树枝，摇晃。树叶，亮闪闪的…眼睛疼。"
        },
        {
            "id": "698140404",
            "speaker": "雷泽",
            "text": "困了。"
        },
        {
            "id": "698140405",
            "speaker": "Player",
            "text": "醒醒，雷泽。没事吧？"
        },
        {
            "id": "698140406",
            "speaker": "迪奥娜",
            "text": "快！快让他把这个咕嘟咕嘟地喝下去。"
        },
        {
            "id": "698140407",
            "speaker": "雷泽",
            "text": "哈…"
        },
        {
            "id": "698140408",
            "speaker": "迪奥娜",
            "text": "好点了吗？"
        },
        {
            "id": "698140409",
            "speaker": "雷泽",
            "text": "嗯。树叶，停下来了。"
        },
        {
            "id": "698140410",
            "speaker": "迪奥娜",
            "text": "对不起！雷泽，是我不好。我没想到吃那些诱饵的小动物会是你…"
        },
        {
            "id": "698140411",
            "speaker": "雷泽",
            "text": "诱饵？"
        },
        {
            "id": "698140412",
            "speaker": "迪奥娜",
            "text": "对啊。老爹病刚好，我让他这段时间多休息，我自己在用新陷阱捕猎呢。"
        },
        {
            "id": "698140413",
            "speaker": "雷泽",
            "text": "不知道，陷阱。以为是，清泉镇的…礼物。我收下了。"
        },
        {
            "id": "698140414",
            "speaker": "雷泽",
            "text": "冷肉拼盘，好吃。饮料，好吃。胡萝卜味的落落莓，好吃。"
        },
        {
            "id": "698140415",
            "speaker": "雷泽",
            "text": "嘟嘟莲，是蔬菜。蔬菜送给朋友。"
        },
        {
            "id": "698140416",
            "speaker": "Player",
            "text": "我插句话…哪个朋友？"
        },
        {
            "id": "698140417",
            "speaker": "雷泽",
            "text": "班尼特。",
            "choices": [
                {
                    "id": "698140418",
                    "text": "苦味加强版。",
                    "response": [
                        {
                            "id": "698140420",
                            "speaker": "迪奥娜",
                            "text": "呜呜，我成了大坏人…又害了雷泽，又害了班尼特…砂糖想要的实验结论也带不回去了…"
                        },
                        {
                            "id": "698140421",
                            "speaker": "Player",
                            "text": "别难过，朋友们会谅解的。"
                        },
                        {
                            "id": "698140422",
                            "speaker": "雷泽",
                            "text": "谅解。"
                        },
                        {
                            "id": "698140423",
                            "speaker": "迪奥娜",
                            "text": "我以后，再也不要用陷阱打猎了——"
                        }
                    ]
                },
                {
                    "id": "698140419",
                    "text": "班——尼——特——"
                }
            ]
        }
    ]
}