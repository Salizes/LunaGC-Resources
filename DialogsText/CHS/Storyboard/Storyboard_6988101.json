{
    "talkId": "6988101",
    "total_dialogue_lines": 34,
    "speaker_counts": {
        "Player": 8,
        "嘉明": 26
    },
    "dialogues": [
        {
            "id": "698810101",
            "speaker": "嘉明",
            "text": "……",
            "choices": [
                {
                    "id": "698810102",
                    "text": "嘉明？怎么一个人在这荒郊僻野？",
                    "response": [
                        {
                            "id": "698810104",
                            "speaker": "嘉明",
                            "text": "#咦？是{NICKNAME}啊！"
                        },
                        {
                            "id": "698810105",
                            "speaker": "嘉明",
                            "text": "哈哈，真是白天不要讲人夜晚不要讲鬼，刚才还在想，要是你来了就有人陪我吃了。"
                        },
                        {
                            "id": "698810106",
                            "speaker": "嘉明",
                            "text": "多谢你关心先，我怎么会被劫镖咧？明明刚刚才安全送完一镖，我们认识这么久，你没理由信不过我的身手的。"
                        },
                        {
                            "id": "698810107",
                            "speaker": "Player",
                            "text": "那你这是在…"
                        },
                        {
                            "id": "698810108",
                            "speaker": "嘉明",
                            "text": "放松点，闻一闻？闻到香味了吗？"
                        },
                        {
                            "id": "698810109",
                            "speaker": "Player",
                            "text": "哇好香！在做什么好吃的吗？"
                        },
                        {
                            "id": "698810110",
                            "speaker": "嘉明",
                            "text": "嘿嘿，识货。呐，你有口福了，准备有得吃了！"
                        },
                        {
                            "id": "698810111",
                            "speaker": "嘉明",
                            "text": "刚刚那趟镖的老板在山里面开了家农庄，好巧不巧，今天计错数，多准备了一些食材，就让我带回去。"
                        },
                        {
                            "id": "698810112",
                            "speaker": "嘉明",
                            "text": "那个禽肉真的很靓，哦，我的意思是很新鲜，肉质很好。"
                        },
                        {
                            "id": "698810113",
                            "speaker": "嘉明",
                            "text": "加上回去的路上还有山泉水，天时地利都出现了…看来也是时候做点事情来凑齐「人和」了。"
                        },
                        {
                            "id": "698810114",
                            "speaker": "嘉明",
                            "text": "所以我决定亲手做一道记忆中的——「淬金冷玉」！"
                        },
                        {
                            "id": "698810115",
                            "speaker": "Player",
                            "text": "居然是…淬、淬金冷玉？！"
                        },
                        {
                            "id": "698810116",
                            "speaker": "嘉明",
                            "text": "难道你也吃过这味菜吗？"
                        },
                        {
                            "id": "698810117",
                            "speaker": "Player",
                            "text": "哈哈，没有。只是觉得名字很厉害！"
                        },
                        {
                            "id": "698810118",
                            "speaker": "嘉明",
                            "text": "哈哈，何止名字厉害啊，味道也不得了。"
                        },
                        {
                            "id": "698810119",
                            "speaker": "嘉明",
                            "text": "其实这道菜是家里的帮工小梁教我的，他跟我老妈是老乡，说老妈旧时最喜欢吃这道菜喔。"
                        },
                        {
                            "id": "698810120",
                            "speaker": "嘉明",
                            "text": "不过我也没有全部照搬，按自己喜欢的口味改良了下。"
                        },
                        {
                            "id": "698810121",
                            "speaker": "嘉明",
                            "text": "把水煲滚，加点盐，新鲜的禽肉放下去泡一泡，但一定要记得不能泡久了！"
                        },
                        {
                            "id": "698810122",
                            "speaker": "嘉明",
                            "text": "基本在心里默念完「烧卖虾饺叉烧包，白灼生菜萝卜糕」就要马上捞出来。"
                        },
                        {
                            "id": "698810123",
                            "speaker": "嘉明",
                            "text": "重复三次这样的步骤后，把禽肉放进泡着冰雾花的山泉水里。"
                        },
                        {
                            "id": "698810124",
                            "speaker": "嘉明",
                            "text": "一热一冷，是不是很像打铁的师傅淬火那样？"
                        },
                        {
                            "id": "698810125",
                            "speaker": "Player",
                            "text": "好复杂…"
                        },
                        {
                            "id": "698810126",
                            "speaker": "嘉明",
                            "text": "哈哈哈，其实我也觉得有点麻烦，所以有时也会偷懒，少做几个步骤…"
                        },
                        {
                            "id": "698810127",
                            "speaker": "嘉明",
                            "text": "但是这次不一样！不能浪费这么靓的禽肉啊！等一下你就知道了。"
                        },
                        {
                            "id": "698810128",
                            "speaker": "嘉明",
                            "text": "反正现在已经到了最后也是最关键的一步：将火力控制到最小，让禽肉在锅里慢慢浸熟，给点耐心…"
                        },
                        {
                            "id": "698810129",
                            "speaker": "Player",
                            "text": "要等多久会熟？"
                        },
                        {
                            "id": "698810130",
                            "speaker": "嘉明",
                            "text": "跟你聊完这些之后，不迟不早，时间刚刚好，不要眨眼啊——"
                        },
                        {
                            "id": "698810131",
                            "speaker": "嘉明",
                            "text": "「淬金冷玉」出锅，嗱，像这样表面发出琉璃那样的光泽，说明火候刚刚好，又好看又好吃。"
                        },
                        {
                            "id": "698810132",
                            "speaker": "嘉明",
                            "text": "你尝一下？看合不合你口味？"
                        },
                        {
                            "id": "698810133",
                            "speaker": "嘉明",
                            "text": "喜欢的话，下次继续做给你吃咯。"
                        },
                        {
                            "id": "698810134",
                            "speaker": "嘉明",
                            "text": "放心，自己吃的随便一点没所谓，招呼朋友我一定跟足烹饪步骤来炮制。"
                        }
                    ]
                },
                {
                    "id": "698810103",
                    "text": "不会被劫镖了吧？！"
                }
            ]
        }
    ]
}