{
    "talkId": "6984301",
    "total_dialogue_lines": 29,
    "speaker_counts": {
        "Black Screen": 1,
        "Player": 7,
        "柯莱": 19,
        "耶佳娜": 2
    },
    "dialogues": [
        {
            "id": "698430101",
            "speaker": "耶佳娜",
            "text": "嗯，我理解了！谢谢柯莱前辈！"
        },
        {
            "id": "698430102",
            "speaker": "柯莱",
            "text": "如果有兴趣的话，你还可以去查阅一下《雨林植物习性研究》里面关于月莲的文章。"
        },
        {
            "id": "698430103",
            "speaker": "柯莱",
            "text": "如果遇到搞不懂的问题，可以随时来找我讨论。"
        },
        {
            "id": "698430104",
            "speaker": "耶佳娜",
            "text": "好的！谢谢柯莱前辈！"
        },
        {
            "id": "698430129",
            "speaker": "Black Screen",
            "text": "耶佳娜满足地离开了。"
        },
        {
            "id": "698430105",
            "speaker": "柯莱",
            "text": "呼…都说了不用谢这么多次了…",
            "choices": [
                {
                    "id": "698430106",
                    "text": "柯莱前辈好！",
                    "response": [
                        {
                            "id": "698430108",
                            "speaker": "柯莱",
                            "text": "#{NICKNAME}，是你啊！真是的，不要开我的玩笑啦。",
                            "choices": [
                                {
                                    "id": "698430109",
                                    "text": "你看起来非常专业。",
                                    "response": [
                                        {
                                            "id": "698430111",
                                            "speaker": "柯莱",
                                            "text": "没有没有，我只是帮学弟学妹们辅导了一下辨识植物的课后作业而已…"
                                        },
                                        {
                                            "id": "698430112",
                                            "speaker": "柯莱",
                                            "text": "本来说好了只有两三个人，开一个简短的学习会，但没想到，一下子来了好多人…"
                                        },
                                        {
                                            "id": "698430113",
                                            "speaker": "柯莱",
                                            "text": "还是提纳里师父帮忙，去预约了一个空的大教室，这才让大家都坐了下来。"
                                        },
                                        {
                                            "id": "698430114",
                                            "speaker": "柯莱",
                                            "text": "就是…我本来打算就在下面，和大家坐在一起看看题目就好。但提纳里师父却让我去讲台上…"
                                        },
                                        {
                                            "id": "698430115",
                                            "speaker": "柯莱",
                                            "text": "呜…我还是第一次站在讲台上面，台下黑压压的好多人，我都快吓死了，一句话也说不出来…"
                                        },
                                        {
                                            "id": "698430116",
                                            "speaker": "柯莱",
                                            "text": "明明之前花了好多天准备资料，还把以前巡林时候做的笔记都重新整理了一遍。"
                                        },
                                        {
                                            "id": "698430117",
                                            "speaker": "柯莱",
                                            "text": "但是一站上讲台，我就大脑一片空白，什么也想不起来…"
                                        },
                                        {
                                            "id": "698430118",
                                            "speaker": "柯莱",
                                            "text": "多亏提纳里师父帮我做了开场白，还让大家踊跃发言，他来总结问题，再交给我来解答。"
                                        },
                                        {
                                            "id": "698430119",
                                            "speaker": "柯莱",
                                            "text": "在解答了几个问题之后，我就越讲越顺畅了，讲到最后，都差点忘了提纳里师父还在旁边。嘿嘿，也许是我太投入了吧。",
                                            "choices": [
                                                {
                                                    "id": "698430120",
                                                    "text": "柯莱的学习很有成果。",
                                                    "response": [
                                                        {
                                                            "id": "698430122",
                                                            "speaker": "柯莱",
                                                            "text": "嗯！也是多亏了大家一直在帮助我。我…"
                                                        },
                                                        {
                                                            "id": "698430123",
                                                            "speaker": "柯莱",
                                                            "text": "呜哇！"
                                                        },
                                                        {
                                                            "id": "698430124",
                                                            "speaker": "Player",
                                                            "text": "你不会到现在一直没吃饭吧？"
                                                        },
                                                        {
                                                            "id": "698430125",
                                                            "speaker": "柯莱",
                                                            "text": "咳…是啊，今天的行程太满了，早上开始都没怎么吃饭…"
                                                        },
                                                        {
                                                            "id": "698430126",
                                                            "speaker": "柯莱",
                                                            "text": "我、我先去吃饭了！等一下还要去给提纳里师父当助教呢！"
                                                        },
                                                        {
                                                            "id": "698430127",
                                                            "speaker": "柯莱",
                                                            "text": "#{NICKNAME}，下次再见啦。"
                                                        },
                                                        {
                                                            "id": "698430128",
                                                            "speaker": "柯莱",
                                                            "text": "嘿嘿，说不定下次我站上讲台的时候，就不是辅导作业，而是正式授课啦。"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "698430121",
                                                    "text": "都是柯莱努力的结果。"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "698430110",
                                    "text": "很有学姐的样子呢。"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "698430107",
                    "text": "柯莱老师好。"
                }
            ]
        }
    ]
}