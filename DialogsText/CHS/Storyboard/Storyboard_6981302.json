{
    "talkId": "6981302",
    "total_dialogue_lines": 59,
    "speaker_counts": {
        "Player": 21,
        "七七": 5,
        "兹白": 26,
        "派蒙": 7
    },
    "dialogues": [
        {
            "id": "698130201",
            "speaker": "七七",
            "text": "…这里就可以到大路上去了。路很宽，不会迷路了。"
        },
        {
            "id": "698130202",
            "speaker": "兹白",
            "text": "多谢了，小姑娘。我记得你应当是住在「不卜庐」内，对吧？我在城里见过你。"
        },
        {
            "id": "698130203",
            "speaker": "七七",
            "text": "是的，可是七七记性不好，忘记了你，对不起…"
        },
        {
            "id": "698130204",
            "speaker": "七七",
            "text": "嗯…七七还要去采药，白先生在等着，要先走了。"
        },
        {
            "id": "698130205",
            "speaker": "兹白",
            "text": "欸，七七姑娘，还请留步，我…"
        },
        {
            "id": "698130206",
            "speaker": "Player",
            "text": "（欸？七七，还有…）"
        },
        {
            "id": "698130207",
            "speaker": "派蒙",
            "text": "兹白也在，好奇怪的组合哦…",
            "choices": [
                {
                    "id": "698130208",
                    "text": "（总之，先看看情况啦…）",
                    "response": [
                        {
                            "id": "698130210",
                            "speaker": "派蒙",
                            "text": "我知道啦，我知道啦，呜哇…为什么突然鬼鬼祟祟的，我们怎么都不可能瞒过…"
                        },
                        {
                            "id": "698130211",
                            "speaker": "Player",
                            "text": "（嘘——）"
                        },
                        {
                            "id": "698130212",
                            "speaker": "七七",
                            "text": "要…要抓药的话，白先生在店里，请你过去吧。"
                        },
                        {
                            "id": "698130213",
                            "speaker": "七七",
                            "text": "对、对不起，但七七，真的忘记了。也真的要去采药了，再见…"
                        },
                        {
                            "id": "698130214",
                            "speaker": "兹白",
                            "text": "…唉。何至于此。"
                        },
                        {
                            "id": "698130215",
                            "speaker": "兹白",
                            "text": "#{NICKNAME}，派蒙，还请出来一见。你们应当也有问题问我吧。"
                        },
                        {
                            "id": "698130216",
                            "speaker": "Player",
                            "text": "你早就发现我们了？"
                        },
                        {
                            "id": "698130217",
                            "speaker": "派蒙",
                            "text": "我就说嘛，无论如何都瞒不过兹白的…不过，你为什么和七七在一起呀？"
                        },
                        {
                            "id": "698130218",
                            "speaker": "Player",
                            "text": "总不会是真的迷路了吧？"
                        },
                        {
                            "id": "698130219",
                            "speaker": "兹白",
                            "text": "只是想找个时机，和那位七七小姑娘单独见一面罢了。"
                        },
                        {
                            "id": "698130220",
                            "speaker": "兹白",
                            "text": "没想到，这世上居然有这样的「仙人」…独有仙躯，却无仙魂。而且还神魂失丧，这应该就是她如此健忘的原因吧…",
                            "choices": [
                                {
                                    "id": "698130221",
                                    "text": "兹白看出来七七健忘的原因了？",
                                    "response": [
                                        {
                                            "id": "698130223",
                                            "speaker": "兹白",
                                            "text": "在我之前，恐怕早已有人暗中帮七七姑娘治疗过了。她头顶那道符箓所用的术法我很熟悉，正是镇定魂魄之用。"
                                        },
                                        {
                                            "id": "698130224",
                                            "speaker": "兹白",
                                            "text": "要是没有那道符箓，只怕七七姑娘的神魂早已泄尽，变成一个无知无觉的木人了。",
                                            "choices": [
                                                {
                                                    "id": "698130225",
                                                    "text": "等一下，兹白很熟悉那道符箓？",
                                                    "response": [
                                                        {
                                                            "id": "698130227",
                                                            "speaker": "兹白",
                                                            "text": "正是「三尸法」。"
                                                        },
                                                        {
                                                            "id": "698130228",
                                                            "speaker": "派蒙",
                                                            "text": "等…等一下，你是说，七七头上的那道符箓，和你用过的那个「三尸法」有关？",
                                                            "choices": [
                                                                {
                                                                    "id": "698130229",
                                                                    "text": "那就是说…",
                                                                    "response": [
                                                                        {
                                                                            "id": "698130231",
                                                                            "speaker": "兹白",
                                                                            "text": "嗯，她也被斩出了「三尸」。我和七七姑娘同行一路，已经细细观察过了。她如今的身躯内，确实只有一尊「尸神」留存。"
                                                                        },
                                                                        {
                                                                            "id": "698130232",
                                                                            "speaker": "兹白",
                                                                            "text": "虽然不能确定究竟是哪一尊，但这尊「尸神」也并不完整，似乎曾被外力击碎，随后又被人以精妙术法聚合起来…"
                                                                        },
                                                                        {
                                                                            "id": "698130233",
                                                                            "speaker": "兹白",
                                                                            "text": "呵，也不一定是「人」…或许，是哪位仙人出力，用仙力凝聚了七七姑娘的魂魄，又用符箓镇住温养吧。",
                                                                            "choices": [
                                                                                {
                                                                                    "id": "698130234",
                                                                                    "text": "……",
                                                                                    "response": [
                                                                                        {
                                                                                            "id": "698130236",
                                                                                            "speaker": "兹白",
                                                                                            "text": "这件事，恐怕也只有七七姑娘自己知道了。有关他人身世，我本不便深究。可是…",
                                                                                            "choices": [
                                                                                                {
                                                                                                    "id": "698130237",
                                                                                                    "text": "可、可是？",
                                                                                                    "response": [
                                                                                                        {
                                                                                                            "id": "698130239",
                                                                                                            "speaker": "兹白",
                                                                                                            "text": "我在七七姑娘的体内，察觉到了一股浓重的「死气」。",
                                                                                                            "choices": [
                                                                                                                {
                                                                                                                    "id": "698130240",
                                                                                                                    "text": "难道是那次的海灯节…",
                                                                                                                    "response": [
                                                                                                                        {
                                                                                                                            "id": "698130242",
                                                                                                                            "speaker": "派蒙",
                                                                                                                            "text": "啊…！我也记起来了，当时七七确实吸入了好多死气，还差点睡过去！"
                                                                                                                        },
                                                                                                                        {
                                                                                                                            "id": "698130243",
                                                                                                                            "speaker": "兹白",
                                                                                                                            "text": "原来如此…她本就是无魂之体，「死气」进入她体内后，就宛入无人之境。"
                                                                                                                        },
                                                                                                                        {
                                                                                                                            "id": "698130244",
                                                                                                                            "speaker": "兹白",
                                                                                                                            "text": "要不是这道符箓帮她镇定神魂，只怕她当场就会完全失魂丧志了。"
                                                                                                                        },
                                                                                                                        {
                                                                                                                            "id": "698130245",
                                                                                                                            "speaker": "兹白",
                                                                                                                            "text": "…可是，虽然抵住了「死气」，但这道符箓里的仙力也损耗了不少。"
                                                                                                                        },
                                                                                                                        {
                                                                                                                            "id": "698130246",
                                                                                                                            "speaker": "兹白",
                                                                                                                            "text": "这枚符箓本就是无源之水，虽然制作者向内度入的仙力十分深厚，但时至今日，里面的仙力早已十不存一。"
                                                                                                                        },
                                                                                                                        {
                                                                                                                            "id": "698130247",
                                                                                                                            "speaker": "兹白",
                                                                                                                            "text": "再加上你所说的「死气」入体…恐怕，这枚符箓的仙力马上就要耗尽了。"
                                                                                                                        },
                                                                                                                        {
                                                                                                                            "id": "698130248",
                                                                                                                            "speaker": "兹白",
                                                                                                                            "text": "如此说来，怪不得那两位「仙人」会突然进城造访「不卜庐」…他们一定也是心有所感了。"
                                                                                                                        },
                                                                                                                        {
                                                                                                                            "id": "698130249",
                                                                                                                            "speaker": "派蒙",
                                                                                                                            "text": "两位仙人？难道是闲云和萍姥姥？"
                                                                                                                        },
                                                                                                                        {
                                                                                                                            "id": "698130250",
                                                                                                                            "speaker": "兹白",
                                                                                                                            "text": "闲云和萍姥姥这两位我认得，但那两位「仙人」原本为一鸟一鹿，进城之前，化成了男子模样…",
                                                                                                                            "choices": [
                                                                                                                                {
                                                                                                                                    "id": "698130251",
                                                                                                                                    "text": "理水叠山真君…",
                                                                                                                                    "response": [
                                                                                                                                        {
                                                                                                                                            "id": "698130253",
                                                                                                                                            "speaker": "兹白",
                                                                                                                                            "text": "#呵呵，原来他们的名号是这个，多谢了，{NICKNAME}。"
                                                                                                                                        },
                                                                                                                                        {
                                                                                                                                            "id": "698130254",
                                                                                                                                            "speaker": "兹白",
                                                                                                                                            "text": "既然我们都是为了七七姑娘而来，或许…我应当去见一见他们。"
                                                                                                                                        },
                                                                                                                                        {
                                                                                                                                            "id": "698130255",
                                                                                                                                            "speaker": "兹白",
                                                                                                                                            "text": "嗯，择日不如撞日，撞日不如今日，稍后我就启程，去那二位的仙府上叨扰一番。"
                                                                                                                                        },
                                                                                                                                        {
                                                                                                                                            "id": "698130256",
                                                                                                                                            "speaker": "Player",
                                                                                                                                            "text": "需要我帮忙的话，我随时能来！"
                                                                                                                                        },
                                                                                                                                        {
                                                                                                                                            "id": "698130257",
                                                                                                                                            "speaker": "派蒙",
                                                                                                                                            "text": "我也是！"
                                                                                                                                        },
                                                                                                                                        {
                                                                                                                                            "id": "698130258",
                                                                                                                                            "speaker": "兹白",
                                                                                                                                            "text": "呵呵，勿要忧心。七七姑娘定然会安然无恙的。"
                                                                                                                                        },
                                                                                                                                        {
                                                                                                                                            "id": "698130259",
                                                                                                                                            "speaker": "兹白",
                                                                                                                                            "text": "…只是，如此高明的「三尸法」，究竟是谁施的呢？"
                                                                                                                                        }
                                                                                                                                    ]
                                                                                                                                },
                                                                                                                                {
                                                                                                                                    "id": "698130252",
                                                                                                                                    "text": "削月筑阳真君…"
                                                                                                                                }
                                                                                                                            ]
                                                                                                                        }
                                                                                                                    ]
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "698130241",
                                                                                                                    "text": "难道是那次进入「生死边界」…！"
                                                                                                                }
                                                                                                            ]
                                                                                                        }
                                                                                                    ]
                                                                                                },
                                                                                                {
                                                                                                    "id": "698130238",
                                                                                                    "text": "七七怎么了？有什么问题吗？"
                                                                                                }
                                                                                            ]
                                                                                        }
                                                                                    ]
                                                                                },
                                                                                {
                                                                                    "id": "698130235",
                                                                                    "text": "七七，到底之前…"
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                },
                                                                {
                                                                    "id": "698130230",
                                                                    "text": "七七也和兹白一样…"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "698130226",
                                                    "text": "那这道术法是…"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "698130222",
                                    "text": "那你可以帮七七治疗吗？"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "698130209",
                    "text": "（飞低点，派蒙。）"
                }
            ]
        }
    ]
}