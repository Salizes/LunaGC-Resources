{
    "talkId": "6980703",
    "total_dialogue_lines": 68,
    "speaker_counts": {
        "Player": 24,
        "行秋": 31,
        "重云": 13
    },
    "dialogues": [
        {
            "id": "698070301",
            "speaker": "行秋",
            "text": "此事莫要再提，此事莫要再提…"
        },
        {
            "id": "698070302",
            "speaker": "重云",
            "text": "事急从权啊，实在不行，我去请小姨帮忙。"
        },
        {
            "id": "698070303",
            "speaker": "行秋",
            "text": "申鹤小姐？不行不行，这件事可别再牵扯旁人了，不然我…",
            "choices": [
                {
                    "id": "698070304",
                    "text": "遇见麻烦了？",
                    "response": [
                        {
                            "id": "698070306",
                            "speaker": "行秋",
                            "text": "#{NICKNAME}！你，你来的…这…算是正好…",
                            "choices": [
                                {
                                    "id": "698070307",
                                    "text": "咦？重云也在？",
                                    "response": [
                                        {
                                            "id": "698070309",
                                            "speaker": "行秋",
                                            "text": "这件事，只怕是比捉妖还要麻烦…"
                                        },
                                        {
                                            "id": "698070310",
                                            "speaker": "行秋",
                                            "text": "我以「枕玉」的名号著写小说这件事，你还记得吧？"
                                        },
                                        {
                                            "id": "698070311",
                                            "speaker": "行秋",
                                            "text": "说来惭愧，因为我的字实在是太…潦草，每次稿件送出去后，编辑部都要返我好几封信，询问我一些词句问题。"
                                        },
                                        {
                                            "id": "698070312",
                                            "speaker": "行秋",
                                            "text": "这样的书信来去实在太费时间，于是我和那边的编辑部约定好，尽量提前几天写好稿件。"
                                        },
                                        {
                                            "id": "698070313",
                                            "speaker": "行秋",
                                            "text": "写好之后尽快寄去编辑部，由一位编辑替我重新誊写一遍，然后再交给其他编辑，进行正式刊印出版。"
                                        },
                                        {
                                            "id": "698070314",
                                            "speaker": "Player",
                                            "text": "听起来好麻烦…"
                                        },
                                        {
                                            "id": "698070315",
                                            "speaker": "行秋",
                                            "text": "是啊。我也…我也挺不好意思的，也经常寄些特产零食过去，作为答谢。"
                                        },
                                        {
                                            "id": "698070316",
                                            "speaker": "行秋",
                                            "text": "但…但谁知道，这几天我收到信件，编辑部说，那位编辑突然病倒了，没人能帮我誊写…",
                                            "choices": [
                                                {
                                                    "id": "698070317",
                                                    "text": "编辑部里那么多人…",
                                                    "response": [
                                                        {
                                                            "id": "698070319",
                                                            "speaker": "行秋",
                                                            "text": "咳…是…",
                                                            "choices": [
                                                                {
                                                                    "id": "698070320",
                                                                    "text": "真的只有一个人啊！",
                                                                    "response": [
                                                                        {
                                                                            "id": "698070322",
                                                                            "speaker": "行秋",
                                                                            "text": "你就别取笑我了，唉…"
                                                                        },
                                                                        {
                                                                            "id": "698070323",
                                                                            "speaker": "Player",
                                                                            "text": "重云的字怎么样？"
                                                                        },
                                                                        {
                                                                            "id": "698070324",
                                                                            "speaker": "重云",
                                                                            "text": "#你瞧，{NICKNAME}的第一反应也是…"
                                                                        },
                                                                        {
                                                                            "id": "698070325",
                                                                            "speaker": "行秋",
                                                                            "text": "不不不！不行，不行！此事莫要再提！"
                                                                        },
                                                                        {
                                                                            "id": "698070326",
                                                                            "speaker": "Player",
                                                                            "text": "难道重云的字也…"
                                                                        },
                                                                        {
                                                                            "id": "698070327",
                                                                            "speaker": "行秋",
                                                                            "text": "没有没有，重云写的字很好看，他画的符都比我写的字入眼…"
                                                                        },
                                                                        {
                                                                            "id": "698070328",
                                                                            "speaker": "Player",
                                                                            "text": "那为什么不让重云帮忙？"
                                                                        },
                                                                        {
                                                                            "id": "698070329",
                                                                            "speaker": "行秋",
                                                                            "text": "我…你…他…这…"
                                                                        },
                                                                        {
                                                                            "id": "698070330",
                                                                            "speaker": "重云",
                                                                            "text": "我也和行秋说过，我可以帮忙誊写，他最开始也答应了。"
                                                                        },
                                                                        {
                                                                            "id": "698070331",
                                                                            "speaker": "重云",
                                                                            "text": "可是，我还没誊写几段，行秋突然抓着我的肩膀摇来摇去，拜托我别写了。"
                                                                        },
                                                                        {
                                                                            "id": "698070332",
                                                                            "speaker": "重云",
                                                                            "text": "我心说，难不成是我字写得太丑？可是他突然说…"
                                                                        },
                                                                        {
                                                                            "id": "698070333",
                                                                            "speaker": "行秋",
                                                                            "text": "你…你…你誊写就誊写，怎么写着写着突然念起来了！"
                                                                        },
                                                                        {
                                                                            "id": "698070334",
                                                                            "speaker": "重云",
                                                                            "text": "啊？我觉得你写的好呀。故事有趣，还人人有诗号呢。我不由自主地就念出来了。"
                                                                        },
                                                                        {
                                                                            "id": "698070335",
                                                                            "speaker": "重云",
                                                                            "text": "特别是飞狐女侠拿着解药下山那一段，你不是还写了首词么？我记得是…"
                                                                        },
                                                                        {
                                                                            "id": "698070336",
                                                                            "speaker": "重云",
                                                                            "text": "「衣上凡尘杂酒痕，远游无处入剑门…」"
                                                                        },
                                                                        {
                                                                            "id": "698070337",
                                                                            "speaker": "行秋",
                                                                            "text": "你…你你你…好重云，我求求你别念了…",
                                                                            "choices": [
                                                                                {
                                                                                    "id": "698070338",
                                                                                    "text": "「衣上凡尘杂酒痕…」",
                                                                                    "response": [
                                                                                        {
                                                                                            "id": "698070341",
                                                                                            "speaker": "重云",
                                                                                            "text": "再说了，你写的故事虽然好，但复杂得很，有好多细节我看不懂。"
                                                                                        },
                                                                                        {
                                                                                            "id": "698070342",
                                                                                            "speaker": "重云",
                                                                                            "text": "比如酒仙人为什么突然答应帮忙，他的「酒宗十三剑」怎么被人偷走的…"
                                                                                        },
                                                                                        {
                                                                                            "id": "698070343",
                                                                                            "speaker": "Player",
                                                                                            "text": "听起来好有意思。"
                                                                                        },
                                                                                        {
                                                                                            "id": "698070344",
                                                                                            "speaker": "重云",
                                                                                            "text": "对吧。行秋写的小说可好看了，他还写了好多有趣的短文呢，比如…"
                                                                                        },
                                                                                        {
                                                                                            "id": "698070345",
                                                                                            "speaker": "重云",
                                                                                            "text": "等会，行秋，你脸怎么这么红？",
                                                                                            "choices": [
                                                                                                {
                                                                                                    "id": "698070346",
                                                                                                    "text": "他的阳气也挺旺盛的。",
                                                                                                    "response": [
                                                                                                        {
                                                                                                            "id": "698070348",
                                                                                                            "speaker": "行秋",
                                                                                                            "text": "二位，二位…你们就饶了我，饶了我吧，你们再说下去，我的手指就要把剑柄给捏碎了…"
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "698070349",
                                                                                                            "speaker": "行秋",
                                                                                                            "text": "要我听认识的人在我面前念诵自己写的文章，我宁愿去吃那些应酬宴会！",
                                                                                                            "choices": [
                                                                                                                {
                                                                                                                    "id": "698070350",
                                                                                                                    "text": "好了好了，不逗你了。",
                                                                                                                    "response": [
                                                                                                                        {
                                                                                                                            "id": "698070352",
                                                                                                                            "speaker": "行秋",
                                                                                                                            "text": "打字机？这我听说过，是枫丹廷那边的机关奇术？"
                                                                                                                        },
                                                                                                                        {
                                                                                                                            "id": "698070353",
                                                                                                                            "speaker": "Player",
                                                                                                                            "text": "有了它，你就不用亲笔写字了。"
                                                                                                                        },
                                                                                                                        {
                                                                                                                            "id": "698070354",
                                                                                                                            "speaker": "行秋",
                                                                                                                            "text": "真的？！好好好，有了这等奇物，我就再也不用为书法问题发愁了。"
                                                                                                                        },
                                                                                                                        {
                                                                                                                            "id": "698070355",
                                                                                                                            "speaker": "行秋",
                                                                                                                            "text": "这枫丹的机关竟然如此巧妙，我平时都只是听大哥说，从未亲手碰过…"
                                                                                                                        },
                                                                                                                        {
                                                                                                                            "id": "698070356",
                                                                                                                            "speaker": "行秋",
                                                                                                                            "text": "…咦？等等，大哥他经常跟着商队去枫丹，理应也听说过打字机这种机关。"
                                                                                                                        },
                                                                                                                        {
                                                                                                                            "id": "698070357",
                                                                                                                            "speaker": "行秋",
                                                                                                                            "text": "他知道我不擅长书法，又经常写文章…怎么从来没和我提起过…"
                                                                                                                        },
                                                                                                                        {
                                                                                                                            "id": "698070358",
                                                                                                                            "speaker": "行秋",
                                                                                                                            "text": "算了算了，现在不是想这个的时候，无论那种叫做打字机的机关如何神奇，现在我也没法借来使用。",
                                                                                                                            "choices": [
                                                                                                                                {
                                                                                                                                    "id": "698070359",
                                                                                                                                    "text": "实在不行，你念我写。",
                                                                                                                                    "response": [
                                                                                                                                        {
                                                                                                                                            "id": "698070361",
                                                                                                                                            "speaker": "行秋",
                                                                                                                                            "text": "事…事到如今…也唯有此计了…"
                                                                                                                                        },
                                                                                                                                        {
                                                                                                                                            "id": "698070362",
                                                                                                                                            "speaker": "行秋",
                                                                                                                                            "text": "之前开玩笑说，要把你说的话写进小说里，没想到，现在是你把我说的话写成小说…"
                                                                                                                                        },
                                                                                                                                        {
                                                                                                                                            "id": "698070363",
                                                                                                                                            "speaker": "行秋",
                                                                                                                                            "text": "唉，也许这都是定数…"
                                                                                                                                        },
                                                                                                                                        {
                                                                                                                                            "id": "698070364",
                                                                                                                                            "speaker": "Player",
                                                                                                                                            "text": "这叫缘分。"
                                                                                                                                        },
                                                                                                                                        {
                                                                                                                                            "id": "698070365",
                                                                                                                                            "speaker": "行秋",
                                                                                                                                            "text": "是，是…我们之间缘分实在太深了…"
                                                                                                                                        },
                                                                                                                                        {
                                                                                                                                            "id": "698070366",
                                                                                                                                            "speaker": "行秋",
                                                                                                                                            "text": "等我回去整理一下文稿，整理好之后，就请你过来听写。"
                                                                                                                                        },
                                                                                                                                        {
                                                                                                                                            "id": "698070367",
                                                                                                                                            "speaker": "重云",
                                                                                                                                            "text": "行秋，你整理好之后，能先给我看一眼么？我真的很想知道飞狐女侠…"
                                                                                                                                        },
                                                                                                                                        {
                                                                                                                                            "id": "698070368",
                                                                                                                                            "speaker": "行秋",
                                                                                                                                            "text": "重云，你就饶了我吧…"
                                                                                                                                        }
                                                                                                                                    ]
                                                                                                                                },
                                                                                                                                {
                                                                                                                                    "id": "698070360",
                                                                                                                                    "text": "我保证不多问问题。"
                                                                                                                                }
                                                                                                                            ]
                                                                                                                        }
                                                                                                                    ]
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "698070351",
                                                                                                                    "text": "我之后帮你去借一台打字机来。"
                                                                                                                }
                                                                                                            ]
                                                                                                        }
                                                                                                    ]
                                                                                                },
                                                                                                {
                                                                                                    "id": "698070347",
                                                                                                    "text": "偷偷吃辣椒了？"
                                                                                                }
                                                                                            ]
                                                                                        }
                                                                                    ]
                                                                                },
                                                                                {
                                                                                    "id": "698070339",
                                                                                    "text": "「远游无处入剑门…」"
                                                                                },
                                                                                {
                                                                                    "id": "698070340",
                                                                                    "text": "写的好啊，还有么？我要看！"
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                },
                                                                {
                                                                    "id": "698070321",
                                                                    "text": "你的书法还挺厉害…"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "698070318",
                                                    "text": "难道就一个人能看懂？"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "698070308",
                                    "text": "你们是要捉妖去？"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "698070305",
                    "text": "有什么事要解决，我来了！"
                }
            ]
        }
    ]
}