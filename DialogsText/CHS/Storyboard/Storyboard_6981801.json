{
    "talkId": "6981801",
    "total_dialogue_lines": 63,
    "speaker_counts": {
        "Player": 11,
        "派蒙": 22,
        "申鹤": 18,
        "闲云": 11,
        "闲云&派蒙": 1
    },
    "dialogues": [
        {
            "id": "698180101",
            "speaker": "闲云",
            "text": "你这孩子，发了工钱给自己买些好吃好玩的多好，存起来也行，平白费这些摩拉作甚…"
        },
        {
            "id": "698180102",
            "speaker": "申鹤",
            "text": "师父是我最亲的人，按照人间的说法，对长辈尽孝本是应当…"
        },
        {
            "id": "698180103",
            "speaker": "闲云",
            "text": "……"
        },
        {
            "id": "698180104",
            "speaker": "派蒙",
            "text": "留…闲云，申鹤，你们在聊什么？",
            "choices": [
                {
                    "id": "698180105",
                    "text": "闲云你好呀。",
                    "response": [
                        {
                            "id": "698180107",
                            "speaker": "闲云",
                            "text": "#{NICKNAME}，好久不见，你们莫不是专程来探望本仙的？"
                        },
                        {
                            "id": "698180108",
                            "speaker": "派蒙",
                            "text": "当、当然！毕竟有段时间没见了嘛，交情再好也是需要定期维护的！你说对吧！"
                        },
                        {
                            "id": "698180109",
                            "speaker": "派蒙",
                            "text": "还有…我刚刚好像听到你们说什么好吃的…嘻嘻，所以又有什么好吃的？"
                        },
                        {
                            "id": "698180110",
                            "speaker": "申鹤",
                            "text": "派蒙，我们并没有谈论食物，方才的话是师父对我的教导。"
                        },
                        {
                            "id": "698180111",
                            "speaker": "申鹤",
                            "text": "店里有许多年轻顾客都为自己的父母报名了时下最流行的旅行团，听闻专为长辈设计，我也替师父报名了。"
                        },
                        {
                            "id": "698180112",
                            "speaker": "申鹤",
                            "text": "名为「耆英欢孝旅行团」，请看，这是宣传图册。"
                        },
                        {
                            "id": "698180113",
                            "speaker": "派蒙",
                            "text": "「奔赴璃月山川，遍览瑰奇风光」…"
                        },
                        {
                            "id": "698180114",
                            "speaker": "派蒙",
                            "text": "全程入住特色客栈套间，品尝地道风味菜肴，尊享专属座驾出行…"
                        },
                        {
                            "id": "698180115",
                            "speaker": "派蒙",
                            "text": "哇…看得我都心动了！"
                        },
                        {
                            "id": "698180116",
                            "speaker": "闲云",
                            "text": "哼，在璃月一词尚未出现的过去，群仙便已飞相往来于山野。璃月还有什么美景是本仙未曾见识过的？"
                        },
                        {
                            "id": "698180117",
                            "speaker": "派蒙",
                            "text": "这么豪华的旅程，肯定不便宜吧？"
                        },
                        {
                            "id": "698180118",
                            "speaker": "闲云",
                            "text": "咳，花费三个月工钱有余。"
                        },
                        {
                            "id": "698180119",
                            "speaker": "闲云",
                            "text": "哎呀，也不提前跟本仙商量商量，便付好定金，这架势，非要本仙动身啊。"
                        },
                        {
                            "id": "698180120",
                            "speaker": "申鹤",
                            "text": "只要师父高兴，要花费我的全部工钱也无妨。"
                        },
                        {
                            "id": "698180121",
                            "speaker": "闲云",
                            "text": "傻孩子…你有这份孝顺本仙的心，师父便满足了。"
                        },
                        {
                            "id": "698180122",
                            "speaker": "闲云",
                            "text": "既然气氛烘托至此，申鹤啊…"
                        },
                        {
                            "id": "698180123",
                            "speaker": "申鹤",
                            "text": "我明白了。我现在就去替师父取消报名。"
                        },
                        {
                            "id": "698180125",
                            "speaker": "闲云&派蒙",
                            "text": "欸？"
                        },
                        {
                            "id": "698180126",
                            "speaker": "申鹤",
                            "text": "师父所言有理，我的确冲动了。"
                        },
                        {
                            "id": "698180127",
                            "speaker": "申鹤",
                            "text": "旅团老板的说辞虽有吸引力，但我更愿意听师父的。我会尽快找他取消报名。"
                        },
                        {
                            "id": "698180128",
                            "speaker": "派蒙",
                            "text": "可、可这定金不是交了么？"
                        },
                        {
                            "id": "698180129",
                            "speaker": "闲云",
                            "text": "对、对啊。且不说摩拉能否尽数退还，这一来一往多麻烦啊…"
                        },
                        {
                            "id": "698180130",
                            "speaker": "申鹤",
                            "text": "不麻烦，老板承诺过费用可退。我会尽量用言语交涉，如要用到拳脚，就更谈不上麻烦了。"
                        },
                        {
                            "id": "698180131",
                            "speaker": "闲云",
                            "text": "这…你…哎…罢了！"
                        },
                        {
                            "id": "698180132",
                            "speaker": "闲云",
                            "text": "你且去吧！天色不早了，我先回去给漱玉做饭了！"
                        },
                        {
                            "id": "698180133",
                            "speaker": "派蒙",
                            "text": "怎么办，闲云肯定不高兴了呀…快想想办法呀！"
                        },
                        {
                            "id": "698180134",
                            "speaker": "派蒙",
                            "text": "那个…"
                        },
                        {
                            "id": "698180135",
                            "speaker": "申鹤",
                            "text": "嗯？",
                            "choices": [
                                {
                                    "id": "698180136",
                                    "text": "你也不用太担心…",
                                    "response": [
                                        {
                                            "id": "698180138",
                                            "speaker": "申鹤",
                                            "text": "你是说师父生气了？这是为何？"
                                        },
                                        {
                                            "id": "698180139",
                                            "speaker": "申鹤",
                                            "text": "言已至此，难道她还在为我乱花工钱的行为不满…"
                                        },
                                        {
                                            "id": "698180140",
                                            "speaker": "派蒙",
                                            "text": "不不，绝对不是在生你的气，申鹤不要太自责啦。"
                                        },
                                        {
                                            "id": "698180141",
                                            "speaker": "派蒙",
                                            "text": "闲云虽然嘴上说着不想去，但她可为你感到自豪啦！她刚刚聊天时，嘴角都快翘到天上去了。"
                                        },
                                        {
                                            "id": "698180142",
                                            "speaker": "派蒙",
                                            "text": "也许只是因为期待的旅行泡汤了，才有点失望吧…"
                                        },
                                        {
                                            "id": "698180143",
                                            "speaker": "申鹤",
                                            "text": "……"
                                        },
                                        {
                                            "id": "698180144",
                                            "speaker": "申鹤",
                                            "text": "一切照常，就不会失望了，是这个意思吗？"
                                        },
                                        {
                                            "id": "698180145",
                                            "speaker": "派蒙",
                                            "text": "#{NICKNAME}，你觉得呢？",
                                            "choices": [
                                                {
                                                    "id": "698180146",
                                                    "text": "我有更好的办法。",
                                                    "response": [
                                                        {
                                                            "id": "698180148",
                                                            "speaker": "派蒙",
                                                            "text": "闲云的专属旅行？…我懂了！根据她的需求来设计游玩路线，是这个意思吧！"
                                                        },
                                                        {
                                                            "id": "698180149",
                                                            "speaker": "派蒙",
                                                            "text": "是个好主意耶，不愧是你！申鹤你觉得呢？"
                                                        },
                                                        {
                                                            "id": "698180150",
                                                            "speaker": "申鹤",
                                                            "text": "你经验丰富，我相信你的判断。"
                                                        },
                                                        {
                                                            "id": "698180151",
                                                            "speaker": "派蒙",
                                                            "text": "#交给我们吧！{M#他}{F#她}可是提瓦特鼎鼎大名的旅行者，而我又是{M#他}{F#她}最好的向导！"
                                                        },
                                                        {
                                                            "id": "698180152",
                                                            "speaker": "派蒙",
                                                            "text": "我们俩一起出手，绝对能让闲云满意的！"
                                                        },
                                                        {
                                                            "id": "698180153",
                                                            "speaker": "Player",
                                                            "text": "深度出国游！"
                                                        },
                                                        {
                                                            "id": "698180154",
                                                            "speaker": "派蒙",
                                                            "text": "对对！反正璃月的风景她都看过了，不如趁这个机会让她到更远的地方走走。"
                                                        },
                                                        {
                                                            "id": "698180155",
                                                            "speaker": "派蒙",
                                                            "text": "可是璃月之外还有这么多国家，各有各的特色，该先推荐她去哪里玩好呢…",
                                                            "choices": [
                                                                {
                                                                    "id": "698180156",
                                                                    "text": "蒙德吧，风与自由的城邦。",
                                                                    "response": [
                                                                        {
                                                                            "id": "698180158",
                                                                            "speaker": "派蒙",
                                                                            "text": "那也是我们旅行的起点呢！这么说来蒙德作为第一站最合适不过！"
                                                                        },
                                                                        {
                                                                            "id": "698180159",
                                                                            "speaker": "派蒙",
                                                                            "text": "蒙德城，摘星崖，风起地，甜甜花酿鸡…记下来记下来…"
                                                                        },
                                                                        {
                                                                            "id": "698180160",
                                                                            "speaker": "申鹤",
                                                                            "text": "有什么我能帮上忙的吗？",
                                                                            "choices": [
                                                                                {
                                                                                    "id": "698180161",
                                                                                    "text": "有件事只有你才能做…",
                                                                                    "response": [
                                                                                        {
                                                                                            "id": "698180163",
                                                                                            "speaker": "申鹤",
                                                                                            "text": "明白。我会照做的。"
                                                                                        },
                                                                                        {
                                                                                            "id": "698180164",
                                                                                            "speaker": "申鹤",
                                                                                            "text": "#谢谢派蒙，还有，{NICKNAME}，谢谢你。"
                                                                                        }
                                                                                    ]
                                                                                },
                                                                                {
                                                                                    "id": "698180162",
                                                                                    "text": "将这份蒙德旅行手册交给闲云。"
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                },
                                                                {
                                                                    "id": "698180157",
                                                                    "text": "适合做旅行的起点。"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "698180147",
                                                    "text": "我来为闲云定制专属旅行计划吧！"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "698180137",
                                    "text": "她可能只是一时气在头上…"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "698180106",
                    "text": "申鹤，又见面了。"
                }
            ]
        }
    ]
}