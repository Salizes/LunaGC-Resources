{
    "talkId": "6985703",
    "total_dialogue_lines": 19,
    "speaker_counts": {
        "Player": 3,
        "凯瑟琳": 6,
        "雅珂达": 10
    },
    "dialogues": [
        {
            "id": "698570301",
            "speaker": "雅珂达",
            "text": "…哈？这次的摩拉是不是少了点，和之前说好的不一样啊。"
        },
        {
            "id": "698570302",
            "speaker": "凯瑟琳",
            "text": "雅珂达小姐。如果您下次能够把委托所需的物品完整带回来的话，那您的委托报酬也一定会「非常完整」。"
        },
        {
            "id": "698570303",
            "speaker": "Player",
            "text": "雅珂达做了什么？"
        },
        {
            "id": "698570304",
            "speaker": "雅珂达",
            "text": "呜呃…那、那只是一点小意外！谁知道会突然冲出来一堆魔物，把我撞到河里去啊…"
        },
        {
            "id": "698570305",
            "speaker": "凯瑟琳",
            "text": "那您在履行护送委托的时候，也请不要再向委托人传递太多错误信息。"
        },
        {
            "id": "698570306",
            "speaker": "雅珂达",
            "text": "我、我也没说得太夸张啊，大部分…都是实话…"
        },
        {
            "id": "698570307",
            "speaker": "凯瑟琳",
            "text": "「偷遍挪德卡莱的大盗」…"
        },
        {
            "id": "698570308",
            "speaker": "雅珂达",
            "text": "那是…那是…随便吹牛的…我也不知道她是枫丹警备队的人啊！莫名其妙把我盘问了一路…"
        },
        {
            "id": "698570309",
            "speaker": "雅珂达",
            "text": "那个女人严肃得要命，一点都不懂幽默，居然还向协会建议重审我的冒险家资格…"
        },
        {
            "id": "698570310",
            "speaker": "凯瑟琳",
            "text": "「罩着那夏镇的地头蛇」…",
            "choices": [
                {
                    "id": "698570311",
                    "text": "地头蛇喔…",
                    "response": [
                        {
                            "id": "698570313",
                            "speaker": "雅珂达",
                            "text": "那…那是在形容奈姐！我是替她说的！"
                        },
                        {
                            "id": "698570314",
                            "speaker": "凯瑟琳",
                            "text": "总而言之，雅珂达小姐，如果您之后还想顺利接到委托的话，最好…"
                        },
                        {
                            "id": "698570315",
                            "speaker": "雅珂达",
                            "text": "知道了…谨言慎行嘛。奈姐教过我，但总是绷着脸也太没趣了…"
                        },
                        {
                            "id": "698570316",
                            "speaker": "凯瑟琳",
                            "text": "#唉，那么我想，您也许可以向您身边的这位专业冒险家{NICKNAME}学习。"
                        },
                        {
                            "id": "698570317",
                            "speaker": "雅珂达",
                            "text": "#{NICKNAME}？行吧…{M#他}{F#她}确实挺厉害的。"
                        },
                        {
                            "id": "698570318",
                            "speaker": "雅珂达",
                            "text": "不过，还是等我先把这次委托的钱带回去给奈姐吧。"
                        },
                        {
                            "id": "698570319",
                            "speaker": "雅珂达",
                            "text": "唉，居然还被扣钱了。奈姐不会又要训我吧…"
                        }
                    ]
                },
                {
                    "id": "698570312",
                    "text": "罩着那夏镇喔…"
                }
            ]
        }
    ]
}