{
    "talkId": "6980301",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Player": 3,
        "钟离": 13
    },
    "dialogues": [
        {
            "id": "698030101",
            "speaker": "钟离",
            "text": "唔，不知道这茶叶味道如何。"
        },
        {
            "id": "698030102",
            "speaker": "钟离",
            "text": "#{NICKNAME}，你来得正好，坐。"
        },
        {
            "id": "698030103",
            "speaker": "钟离",
            "text": "我托人从枫丹买来了几包好茶叶，价钱可是不菲。"
        },
        {
            "id": "698030104",
            "speaker": "钟离",
            "text": "早听说枫丹的土壤水质都与璃月大不相同，不知道这枫丹种出来的茶叶，究竟是什么味道。",
            "choices": [
                {
                    "id": "698030105",
                    "text": "不如再去枫丹取点水来？",
                    "response": [
                        {
                            "id": "698030107",
                            "speaker": "钟离",
                            "text": "嗯…你说得也有道理。但古人亦云：「活水取之则淤。」"
                        },
                        {
                            "id": "698030108",
                            "speaker": "钟离",
                            "text": "如果去枫丹取水回来，只怕一路颠簸劳顿，让枫丹的好水失去了风味，泡出来的茶叶滋味反倒是落了下乘。"
                        },
                        {
                            "id": "698030109",
                            "speaker": "Player",
                            "text": "取水也有这讲究？"
                        },
                        {
                            "id": "698030110",
                            "speaker": "钟离",
                            "text": "那是自然，想要泡一杯好茶，也要讲究君臣佐使，车卒兵将。"
                        },
                        {
                            "id": "698030111",
                            "speaker": "钟离",
                            "text": "买到了好茶叶，只能算是寻到了一位贤君名将。"
                        },
                        {
                            "id": "698030112",
                            "speaker": "钟离",
                            "text": "如果水不好，茶具不好，乃至天公不作美，天气也不好…"
                        },
                        {
                            "id": "698030113",
                            "speaker": "钟离",
                            "text": "那就算这位贤君名将的能力再超凡出众，用着一群庸臣懒兵，只怕也打不赢仗了。"
                        },
                        {
                            "id": "698030114",
                            "speaker": "钟离",
                            "text": "所以，与其舍近求远，不如就用璃月的泉水款待这包茶叶吧。"
                        },
                        {
                            "id": "698030115",
                            "speaker": "钟离",
                            "text": "这一杯茶里两方交汇，说不定别有滋味。"
                        },
                        {
                            "id": "698030116",
                            "speaker": "钟离",
                            "text": "#喔。时候差不多了，请，{NICKNAME}。"
                        }
                    ]
                },
                {
                    "id": "698030106",
                    "text": "这样说不定更有风味。"
                }
            ]
        }
    ]
}