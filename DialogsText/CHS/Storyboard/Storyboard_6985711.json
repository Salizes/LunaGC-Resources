    "dialogues": [
        {
            "id": "698571103",
            "speaker": "克洛琳德",
            "text": "#如果{NICKNAME}同意的话。顺便一提，为了照顾新人，我们现在玩的难度是「轻松体验」。"
        },
        {
            "id": "698571104",
            "speaker": "娜维娅",
            "text": "#{NICKNAME}，你愿意和我们继续冒险吗？肯定愿意的，对吧？",
            "choices": [
                {
                    "id": "698571105",
                    "text": "咦？怎么突然就——",
                    "response": [
                        {
                            "id": "698571107",
                            "speaker": "雅珂达",
                            "text": "别问啦，再问我们就要被炸药全部炸飞了啊——",
                            "choices": [
                                {
                                    "id": "698571108",
                                    "text": "愿、愿意！",
                                    "response": [
                                        {
                                            "id": "698571110",
                                            "speaker": "克洛琳德",
                                            "text": "#好。但{NICKNAME}毕竟这么长时间没有游玩剧本了，可以拥有一次重新选择技能的机会。"
                                        },
                                        {
                                            "id": "698571111",
                                            "speaker": "克洛琳德",
                                            "text": "可以修改的技能是「厨艺」和「医术」，怎么样，要修改吗？",
                                            "choices": [
                                                {
                                                    "id": "698571112",
                                                    "text": "学习「厨艺」…",
                                                    "response": [
                                                        {
                                                            "id": "698571113",
                                                            "speaker": "克洛琳德",
                                                            "text": "可以，你确定想要学习的技能是「厨艺」，对吧？",
                                                            "choices": [
                                                                {
                                                                    "id": "698571116",
                                                                    "text": "确定。"
                                                                },
                                                                {
                                                                    "id": "698571117",
                                                                    "text": "我再想想…"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "698571114",
                                                    "text": "学习「医术」…",
                                                    "response": [
                                                        {
                                                            "id": "698571115",
                                                            "speaker": "克洛琳德",
                                                            "text": "可以，你确定想要学习的技能是「医术」，对吧？",
                                                            "choices": [
                                                                {
                                                                    "id": "698571116",
                                                                    "text": "确定。"
                                                                },
                                                                {
                                                                    "id": "698571117",
                                                                    "text": "我再想想…"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "698571109",
                                    "text": "我加入，我加入——"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "698571106",
                    "text": "继续冒险？难道是顺着上次的…"
                }
            ]
        }
    ]
}