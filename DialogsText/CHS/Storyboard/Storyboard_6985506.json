{
    "talkId": "6985506",
    "total_dialogue_lines": 36,
    "speaker_counts": {
        "Player": 8,
        "伊涅芙": 10,
        "宵宫": 7,
        "爱诺": 11
    },
    "dialogues": [
        {
            "id": "698550601",
            "speaker": "爱诺",
            "text": "宵宫姐姐！你来啦！",
            "choices": [
                {
                    "id": "698550602",
                    "text": "（已经是宵宫「姐姐」了？）",
                    "response": [
                        {
                            "id": "698550604",
                            "speaker": "宵宫",
                            "text": "爱诺，你好呀。我收到你的信就赶来了，怎么样？完成了吗？"
                        },
                        {
                            "id": "698550605",
                            "speaker": "爱诺",
                            "text": "那当然啦！宵宫姐姐的订单我第一时间就完成了，嘿嘿。伊涅芙，帮忙确认一下订单。"
                        },
                        {
                            "id": "698550606",
                            "speaker": "伊涅芙",
                            "text": "好的，订单数据读取中…"
                        },
                        {
                            "id": "698550607",
                            "speaker": "伊涅芙",
                            "text": "客户宵宫姐姐。定制陪伴孩子们的礼物，已完成。"
                        },
                        {
                            "id": "698550608",
                            "speaker": "伊涅芙",
                            "text": "备注：以三彩团子食谱、烟火筒、风筝、陀螺、手鞠交换。"
                        },
                        {
                            "id": "698550609",
                            "speaker": "伊涅芙",
                            "text": "订单内容确认完毕。"
                        },
                        {
                            "id": "698550610",
                            "speaker": "爱诺",
                            "text": "哼哼，就在这里啦。宵宫姐姐看看吧，我敢打包票，肯定满意！"
                        },
                        {
                            "id": "698550611",
                            "speaker": "宵宫",
                            "text": "我看看…唔哦！这是…一盆鱼？"
                        },
                        {
                            "id": "698550612",
                            "speaker": "爱诺",
                            "text": "我叫它——晃晃悠悠盆盆鱼！你看，还会摇摆哦，像不像鱼在水里游动的样子？"
                        },
                        {
                            "id": "698550613",
                            "speaker": "爱诺",
                            "text": "这样宵宫姐姐就不用担心松坂他们养不活鱼啦！而且现在甚至都不用换水。怎么样？怎么样？喜欢吗？"
                        },
                        {
                            "id": "698550614",
                            "speaker": "宵宫",
                            "text": "哇哇！种在花盆里的鱼吗？这也太好玩了吧，哈哈。爱诺是怎么想到这么有意思的设计的？"
                        },
                        {
                            "id": "698550615",
                            "speaker": "宵宫",
                            "text": "松坂、岩夫和彩香收到后肯定会很惊喜的！我先替他们谢谢爱诺啦！"
                        },
                        {
                            "id": "698550616",
                            "speaker": "爱诺",
                            "text": "那当然啦！只要有甜食，动动脑子对爱诺来说就是轻轻松松的事情。"
                        },
                        {
                            "id": "698550617",
                            "speaker": "Player",
                            "text": "真好玩，不愧是爱诺！"
                        },
                        {
                            "id": "698550618",
                            "speaker": "爱诺",
                            "text": "#{NICKNAME}！你也喜欢吗？刚刚好材料够，我做了好多呢，这一盆就送给你吧！",
                            "choices": [
                                {
                                    "id": "698550619",
                                    "text": "新朋友！谢谢爱诺…",
                                    "response": [
                                        {
                                            "id": "698550621",
                                            "speaker": "爱诺",
                                            "text": "不用不用，宵宫姐姐给我好多礼物呢，还帮我做了好多好多之前没见过的玩具！"
                                        },
                                        {
                                            "id": "698550622",
                                            "speaker": "爱诺",
                                            "text": "但我真的不会玩陀螺…宵宫姐姐，再教一教我吧。"
                                        },
                                        {
                                            "id": "698550623",
                                            "speaker": "宵宫",
                                            "text": "没问题，我这次还专门给你做了一条「爱诺专用陀螺绳」呢。"
                                        },
                                        {
                                            "id": "698550624",
                                            "speaker": "宵宫",
                                            "text": "给你，我们来比赛，看谁的陀螺转的更久，更快吧。"
                                        },
                                        {
                                            "id": "698550625",
                                            "speaker": "爱诺",
                                            "text": "好耶！谁输了，谁就要去帮伊涅芙做蛋卷。"
                                        },
                                        {
                                            "id": "698550626",
                                            "speaker": "伊涅芙",
                                            "text": "而赢的人，可以一边继续玩陀螺，一边等着蛋卷做好。"
                                        },
                                        {
                                            "id": "698550627",
                                            "speaker": "爱诺",
                                            "text": "就是这样，快点快点，宵宫姐姐，我昨天可是练习了好久呢。"
                                        },
                                        {
                                            "id": "698550628",
                                            "speaker": "宵宫",
                                            "text": "哼哼，想要赢我？你还要再练习一百年呢！",
                                            "choices": [
                                                {
                                                    "id": "698550629",
                                                    "text": "爱诺玩得很开心啊…",
                                                    "response": [
                                                        {
                                                            "id": "698550631",
                                                            "speaker": "伊涅芙",
                                                            "text": "我试过了。在精确计算抽打陀螺的力道，角度和所需时间后，只要我持续发力，我的陀螺会一直旋转下去。"
                                                        },
                                                        {
                                                            "id": "698550632",
                                                            "speaker": "Player",
                                                            "text": "一直旋转下去啊…"
                                                        },
                                                        {
                                                            "id": "698550633",
                                                            "speaker": "伊涅芙",
                                                            "text": "是的。直到爱诺和宵宫小姐一起在沙发上睡着，我去给她们盖被子之后，我的陀螺才停止了旋转。"
                                                        },
                                                        {
                                                            "id": "698550634",
                                                            "speaker": "伊涅芙",
                                                            "text": "自那之后，我认为，我还是更适合忠于自己的职责——制作蛋卷，和提醒爱诺和宵宫小姐吃饭。"
                                                        },
                                                        {
                                                            "id": "698550635",
                                                            "speaker": "伊涅芙",
                                                            "text": "但是，自从宵宫小姐到来后，爱诺很开心。"
                                                        },
                                                        {
                                                            "id": "698550636",
                                                            "speaker": "伊涅芙",
                                                            "text": "我想，她有了一个新朋友，这样再好不过了。"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "698550630",
                                                    "text": "伊涅芙，你也试试？"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "698550620",
                                    "text": "需要用甜点食谱交换吗？"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "698550603",
                    "text": "（真不愧是宵宫「姐姐」！）"
                }
            ]
        }
    ]
}