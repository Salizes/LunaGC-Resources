{
    "talkId": "6985501",
    "total_dialogue_lines": 44,
    "speaker_counts": {
        "Player": 7,
        "伊涅芙": 16,
        "凛角鹿": 3,
        "爱诺": 18
    },
    "dialogues": [
        {
            "id": "698550101",
            "speaker": "爱诺",
            "text": "伊涅芙，小鹿的情况怎么样？"
        },
        {
            "id": "698550102",
            "speaker": "伊涅芙",
            "text": "伤口已经开始缓慢愈合，伤势已经稳定了。"
        },
        {
            "id": "698550103",
            "speaker": "爱诺",
            "text": "那个医生开的药果然有用…它还会觉得痛吗？"
        },
        {
            "id": "698550104",
            "speaker": "伊涅芙",
            "text": "疼痛避免不了，但它一定会很快好起来的。"
        },
        {
            "id": "698550105",
            "speaker": "爱诺",
            "text": "好呀，伊涅芙。等下做一份蛋糕吧，还有蛋卷！等它醒了，肚子肯定会饿的。"
        },
        {
            "id": "698550106",
            "speaker": "伊涅芙",
            "text": "只是你想吃而已吧，爱诺。我已经预备好了动物食谱，稍后会去制作。"
        },
        {
            "id": "698550107",
            "speaker": "爱诺",
            "text": "喔——"
        },
        {
            "id": "698550108",
            "speaker": "伊涅芙",
            "text": "你不能吃动物食谱，爱诺。"
        },
        {
            "id": "698550109",
            "speaker": "爱诺",
            "text": "我也没有想要偷吃小鹿的病号餐啦！",
            "choices": [
                {
                    "id": "698550110",
                    "text": "这只小鹿怎么了？",
                    "response": [
                        {
                            "id": "698550112",
                            "speaker": "伊涅芙",
                            "text": "是的。我们在一处悬崖下遇见了这只小鹿，它似乎是跌到了崖底，受了很重的伤。"
                        },
                        {
                            "id": "698550113",
                            "speaker": "伊涅芙",
                            "text": "于是，我就把它送到镇里，看了医生，也开了药。"
                        },
                        {
                            "id": "698550114",
                            "speaker": "伊涅芙",
                            "text": "按照预定计划，我们会照顾这只小鹿，直到它的伤口恢复后，再将它送到附近的树林里，让它回归族群。"
                        },
                        {
                            "id": "698550115",
                            "speaker": "爱诺",
                            "text": "……"
                        },
                        {
                            "id": "698550116",
                            "speaker": "Player",
                            "text": "爱诺，你怎么了？"
                        },
                        {
                            "id": "698550117",
                            "speaker": "伊涅芙",
                            "text": "爱诺，我们之前讨论过这个问题。"
                        },
                        {
                            "id": "698550118",
                            "speaker": "爱诺",
                            "text": "我可以照顾它的，我可以早起喂它吃东西，也可以帮它梳毛。"
                        },
                        {
                            "id": "698550119",
                            "speaker": "伊涅芙",
                            "text": "但上次你早起给它喂食后，就抱着它睡着了，最后你和小鹿，都只把早餐吃了一半。"
                        },
                        {
                            "id": "698550120",
                            "speaker": "爱诺",
                            "text": "因为…因为…那个…"
                        },
                        {
                            "id": "698550121",
                            "speaker": "伊涅芙",
                            "text": "昨天梳毛时，你和它玩起了滚球游戏，毛发飘到了全屋的各个角落。"
                        },
                        {
                            "id": "698550122",
                            "speaker": "伊涅芙",
                            "text": "处理时，甚至堵塞了我的吸尘器。",
                            "choices": [
                                {
                                    "id": "698550123",
                                    "text": "伊涅芙辛苦了…",
                                    "response": [
                                        {
                                            "id": "698550125",
                                            "speaker": "爱诺",
                                            "text": "我忍不住就和它玩起来了，对不起嘛…"
                                        },
                                        {
                                            "id": "698550126",
                                            "speaker": "爱诺",
                                            "text": "但是，无论如何，那个…"
                                        },
                                        {
                                            "id": "698550127",
                                            "speaker": "爱诺",
                                            "text": "嗯…我要养它！"
                                        },
                                        {
                                            "id": "698550128",
                                            "speaker": "凛角鹿",
                                            "text": "……"
                                        },
                                        {
                                            "id": "698550130",
                                            "speaker": "爱诺",
                                            "text": "我都习惯早上起来，先给它喂水，再帮它梳毛，然后陪它玩了。"
                                        },
                                        {
                                            "id": "698550131",
                                            "speaker": "爱诺",
                                            "text": "要是它突然走掉的话…我会不习惯！小鹿也会不习惯的！"
                                        },
                                        {
                                            "id": "698550132",
                                            "speaker": "伊涅芙",
                                            "text": "……"
                                        },
                                        {
                                            "id": "698550133",
                                            "speaker": "凛角鹿",
                                            "text": "……"
                                        },
                                        {
                                            "id": "698550134",
                                            "speaker": "爱诺",
                                            "text": "你看，小鹿自己也不想走！"
                                        },
                                        {
                                            "id": "698550135",
                                            "speaker": "伊涅芙",
                                            "text": "我并没有听懂它说的话，爱诺。"
                                        },
                                        {
                                            "id": "698550136",
                                            "speaker": "爱诺",
                                            "text": "动作就决定一切啦！你看它，可喜欢我了！"
                                        },
                                        {
                                            "id": "698550137",
                                            "speaker": "爱诺",
                                            "text": "要是小鹿会说话就好了，那样，它就能自己说服你啦。"
                                        },
                                        {
                                            "id": "698550138",
                                            "speaker": "伊涅芙",
                                            "text": "那我也可以告诉它，不要再每天早上帮爱诺吃掉早餐里的蔬菜了。"
                                        },
                                        {
                                            "id": "698550139",
                                            "speaker": "爱诺",
                                            "text": "唔呃？！伊涅芙，你…你是怎么发现的…"
                                        },
                                        {
                                            "id": "698550140",
                                            "speaker": "凛角鹿",
                                            "text": "……"
                                        },
                                        {
                                            "id": "698550141",
                                            "speaker": "伊涅芙",
                                            "text": "我是猜的。但现在证实了。"
                                        },
                                        {
                                            "id": "698550142",
                                            "speaker": "爱诺",
                                            "text": "伊涅芙骗人…"
                                        },
                                        {
                                            "id": "698550143",
                                            "speaker": "伊涅芙",
                                            "text": "明天早上，我会监督你和小鹿吃早餐。"
                                        },
                                        {
                                            "id": "698550144",
                                            "speaker": "Player",
                                            "text": "擅长和动物沟通，也听得懂动物语言的人…"
                                        },
                                        {
                                            "id": "698550145",
                                            "speaker": "Player",
                                            "text": "如果菈乌玛在这里的话，说不定…"
                                        }
                                    ]
                                },
                                {
                                    "id": "698550124",
                                    "text": "爱诺也很有心了。"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "698550111",
                    "text": "你们在照顾它吗？"
                }
            ]
        }
    ]
}