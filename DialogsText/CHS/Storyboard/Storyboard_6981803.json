{
    "talkId": "6981803",
    "total_dialogue_lines": 47,
    "speaker_counts": {
        "Player": 13,
        "派蒙": 13,
        "闲云": 21
    },
    "dialogues": [
        {
            "id": "698180301",
            "speaker": "派蒙",
            "text": "闲云小姐——又见面了！"
        },
        {
            "id": "698180302",
            "speaker": "闲云",
            "text": "悄声！"
        },
        {
            "id": "698180303",
            "speaker": "派蒙",
            "text": "欸，怎么了？"
        },
        {
            "id": "698180304",
            "speaker": "闲云",
            "text": "当心别把远处的鸽子吓跑。本仙已在此等候了半日，这次只许成功，不可失败…"
        },
        {
            "id": "698180305",
            "speaker": "派蒙",
            "text": "闲云也想烤禽肉吃吗？"
        },
        {
            "id": "698180306",
            "speaker": "闲云",
            "text": "荒谬！本仙不曾做过诛戮无辜生灵之事，亦不会去做！只是在等待留影时机罢了！"
        },
        {
            "id": "698180307",
            "speaker": "派蒙",
            "text": "对不起对不起，是我多想了！"
        },
        {
            "id": "698180308",
            "speaker": "Player",
            "text": "我来帮你！"
        },
        {
            "id": "698180309",
            "speaker": "闲云",
            "text": "也好，你的水平值得信赖。"
        },
        {
            "id": "698180310",
            "speaker": "闲云",
            "text": "切记，要将后方建筑的巨型风叶机关和桥面的鸽子一同纳入画面之中，应该难不倒你。"
        },
        {
            "id": "698180311",
            "speaker": "Player",
            "text": "没问题，开始吧。"
        },
        {
            "id": "698180312",
            "speaker": "闲云",
            "text": "这回要摆出何种姿势才好？",
            "choices": [
                {
                    "id": "698180313",
                    "text": "摆一个惊艳全场的姿势！",
                    "response": [
                        {
                            "id": "698180315",
                            "speaker": "闲云",
                            "text": "那便…这样如何？风叶机关和鸽子都入画了吧？",
                            "choices": [
                                {
                                    "id": "698180316",
                                    "text": "我觉得很好，准备，要拍咯——",
                                    "response": [
                                        {
                                            "id": "698180317",
                                            "speaker": "闲云",
                                            "text": "嗯，拍吧。"
                                        },
                                        {
                                            "id": "698180322",
                                            "speaker": "闲云",
                                            "text": "好了？容本仙看看，水平依旧，如此甚好！"
                                        },
                                        {
                                            "id": "698180323",
                                            "speaker": "派蒙",
                                            "text": "闲云最近都去了哪些地方玩？"
                                        },
                                        {
                                            "id": "698180324",
                                            "speaker": "闲云",
                                            "text": "不久前，按着你的手册去了风起地，那片地域葱蔚洇润，巨木更有惠风环绕，应是积厚流光之福地。"
                                        },
                                        {
                                            "id": "698180325",
                                            "speaker": "派蒙",
                                            "text": "嘻嘻，手册上写的都是我们自己去过觉得不错的地方，那里可凉快啦，是睡午觉的绝佳地点！"
                                        },
                                        {
                                            "id": "698180326",
                                            "speaker": "闲云",
                                            "text": "更多的，便都呈现在画片中了，喏。"
                                        },
                                        {
                                            "id": "698180327",
                                            "speaker": "派蒙",
                                            "text": "我看看我看看…"
                                        },
                                        {
                                            "id": "698180328",
                                            "speaker": "派蒙",
                                            "text": "道理我都明白，可是…风车菊为什么这么大啊！"
                                        },
                                        {
                                            "id": "698180329",
                                            "speaker": "闲云",
                                            "text": "此为「特写」。"
                                        },
                                        {
                                            "id": "698180330",
                                            "speaker": "派蒙",
                                            "text": "…那这张模模糊糊拍的是什么呀？"
                                        },
                                        {
                                            "id": "698180331",
                                            "speaker": "闲云",
                                            "text": "此为意境，乃本仙设计力作。"
                                        },
                                        {
                                            "id": "698180332",
                                            "speaker": "派蒙",
                                            "text": "好吧…还有吗？"
                                        },
                                        {
                                            "id": "698180333",
                                            "speaker": "闲云",
                                            "text": "浅尝了蒙德城本地美食。"
                                        },
                                        {
                                            "id": "698180334",
                                            "speaker": "派蒙",
                                            "text": "哇！我最喜欢这张！香味都透过画片溢出来了！"
                                        },
                                        {
                                            "id": "698180335",
                                            "speaker": "闲云",
                                            "text": "此为鸟瞰图。"
                                        },
                                        {
                                            "id": "698180336",
                                            "speaker": "派蒙",
                                            "text": "震惊！这到底怎么拍的？！"
                                        },
                                        {
                                            "id": "698180337",
                                            "speaker": "闲云",
                                            "text": "哼。飞上云端即可，易如反掌。"
                                        },
                                        {
                                            "id": "698180338",
                                            "speaker": "派蒙",
                                            "text": "还真是「鸟看」图…"
                                        },
                                        {
                                            "id": "698180339",
                                            "speaker": "Player",
                                            "text": "看起来收获很多，你开心就好！"
                                        },
                                        {
                                            "id": "698180340",
                                            "speaker": "闲云",
                                            "text": "这几日虽身在殊方异域，但依照着你的手册游玩，畅行无阻，惊喜连连。"
                                        },
                                        {
                                            "id": "698180341",
                                            "speaker": "闲云",
                                            "text": "天色尚早，本仙计划随兴闲游，权当寻觅野趣，有手册在手，你无须挂心。"
                                        }
                                    ]
                                },
                                {
                                    "id": "698180320",
                                    "text": "还是融入当地风情比较有趣。",
                                    "response": [
                                        {
                                            "id": "698180321",
                                            "speaker": "闲云",
                                            "text": "城门外的军士似乎是这么摆的…",
                                            "choices": [
                                                {
                                                    "id": "698180316",
                                                    "text": "我觉得很好，准备，要拍咯——"
                                                },
                                                {
                                                    "id": "698180318",
                                                    "text": "还是想要看惊艳全场的姿势。",
                                                    "response": [
                                                        {
                                                            "id": "698180319",
                                                            "speaker": "闲云",
                                                            "text": "笑话，本仙向来威风赫赫，何时不惊艳？哼…如此这般，怎么样？",
                                                            "choices": [
                                                                {
                                                                    "id": "698180316",
                                                                    "text": "我觉得很好，准备，要拍咯——"
                                                                },
                                                                {
                                                                    "id": "698180320",
                                                                    "text": "还是融入当地风情比较有趣。"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "698180314",
                    "text": "要不要试试融入当地风情？",
                    "response": [
                        {
                            "id": "698180342",
                            "speaker": "闲云",
                            "text": "那便…这样如何？风叶机关和鸽子都入画了吧？",
                            "choices": [
                                {
                                    "id": "698180316",
                                    "text": "我觉得很好，准备，要拍咯——"
                                },
                                {
                                    "id": "698180318",
                                    "text": "还是想要看惊艳全场的姿势。"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}