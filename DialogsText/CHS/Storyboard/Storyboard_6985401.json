{
    "talkId": "6985401",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 3,
        "基尼奇": 6,
        "阿乔": 5
    },
    "dialogues": [
        {
            "id": "698540101",
            "speaker": "基尼奇",
            "text": "知道了。我不会让阿乔出来吓人的。"
        },
        {
            "id": "698540102",
            "speaker": "阿乔",
            "text": "吓人？哼哼哼哼，那是本圣龙的气势！"
        },
        {
            "id": "698540103",
            "speaker": "基尼奇",
            "text": "弱得吓人？"
        },
        {
            "id": "698540104",
            "speaker": "阿乔",
            "text": "基！尼！奇！你说什么？"
        },
        {
            "id": "698540105",
            "speaker": "Player",
            "text": "咦，基尼奇？"
        },
        {
            "id": "698540106",
            "speaker": "阿乔",
            "text": "#哦哟？哦哟哟哟，居然能遇见你。{NICKNAME}，你也是来找活干的？"
        },
        {
            "id": "698540107",
            "speaker": "阿乔",
            "text": "可惜啊可惜啊，厉害的赚钱的活已经都被本圣龙看上了，在本圣龙的…"
        },
        {
            "id": "698540108",
            "speaker": "基尼奇",
            "text": "#别理阿乔，{NICKNAME}。需要推荐委托的话，我可以帮忙。",
            "choices": [
                {
                    "id": "698540109",
                    "text": "不用不用…",
                    "response": [
                        {
                            "id": "698540111",
                            "speaker": "基尼奇",
                            "text": "嗯。如果需要帮忙的话，尽管开口。"
                        },
                        {
                            "id": "698540112",
                            "speaker": "阿乔",
                            "text": "帮忙？你可真是好心，还不如…"
                        },
                        {
                            "id": "698540113",
                            "speaker": "基尼奇",
                            "text": "阿乔，闭嘴。"
                        },
                        {
                            "id": "698540114",
                            "speaker": "基尼奇",
                            "text": "省下点力气，放在对付魔物的时候用吧。"
                        }
                    ]
                },
                {
                    "id": "698540110",
                    "text": "我已经接好了。"
                }
            ]
        }
    ]
}