{
    "talkId": "6982501",
    "total_dialogue_lines": 24,
    "speaker_counts": {
        "Player": 7,
        "云堇": 17
    },
    "dialogues": [
        {
            "id": "698250101",
            "speaker": "云堇",
            "text": "#欸，是{NICKNAME}，今天怎么有空上这儿来了？",
            "choices": [
                {
                    "id": "698250102",
                    "text": "来见你的。",
                    "response": [
                        {
                            "id": "698250103",
                            "speaker": "云堇",
                            "text": "哎呀，你这嘴啊，真贫。"
                        },
                        {
                            "id": "698250106",
                            "speaker": "云堇",
                            "text": "今天我不演，来这儿听刘苏先生说书，顺便散散心。"
                        },
                        {
                            "id": "698250107",
                            "speaker": "Player",
                            "text": "云堇有什么烦恼吗？"
                        },
                        {
                            "id": "698250108",
                            "speaker": "云堇",
                            "text": "过几天我们社要排一场老戏，叫《三塔记》。"
                        },
                        {
                            "id": "698250109",
                            "speaker": "云堇",
                            "text": "有几段词和对应的表演，我想做些调整，但一时还拿不定主意要不要改。"
                        },
                        {
                            "id": "698250110",
                            "speaker": "云堇",
                            "text": "嗯，如果你有空的话，可以听我说一说吗？"
                        },
                        {
                            "id": "698250111",
                            "speaker": "Player",
                            "text": "当然。"
                        },
                        {
                            "id": "698250112",
                            "speaker": "云堇",
                            "text": "比方说出名的「云婵娟」这一段：「云婵娟来花婵娟，风流尽在山水间。江月半轮佳人面，娥眉青酒动心田。」"
                        },
                        {
                            "id": "698250113",
                            "speaker": "云堇",
                            "text": "前一句我不打算改，但后一句要是就那么干巴巴地唱，我总觉得差点意思。"
                        },
                        {
                            "id": "698250114",
                            "speaker": "云堇",
                            "text": "要是能配合情境做些动作就好了，比如举起酒壶摆出喝酒的姿势，舞台布景也可以相应地改一改。"
                        },
                        {
                            "id": "698250115",
                            "speaker": "云堇",
                            "text": "类似的调整还有好几处，改了的话我自己心里是满意了，不过一些年纪大的戏迷可能更喜欢过去那种表现形式。"
                        },
                        {
                            "id": "698250116",
                            "speaker": "云堇",
                            "text": "况且留给我们的排练时间不算多，又要改布景又要重新设计动作，工期上可能有点问题。"
                        },
                        {
                            "id": "698250117",
                            "speaker": "Player",
                            "text": "排戏还真是复杂。"
                        },
                        {
                            "id": "698250118",
                            "speaker": "云堇",
                            "text": "是啊，除了剧本和表演本身，还要考虑很多场外因素。"
                        },
                        {
                            "id": "698250119",
                            "speaker": "云堇",
                            "text": "写戏演戏是我们整个云翰社最擅长、也最喜欢做的事，但场外因素…嗯…应对起来就比较麻烦。"
                        },
                        {
                            "id": "698250120",
                            "speaker": "云堇",
                            "text": "观众是否喜欢我们的创新，演出承办方和我们是否能互相理解，这种事情都是不可控的。"
                        },
                        {
                            "id": "698250121",
                            "speaker": "云堇",
                            "text": "不过往好处想想，作为曲艺人的乐趣我已经都享受到了，学着做好一个当家人，这个新挑战会带来新乐趣吧。",
                            "choices": [
                                {
                                    "id": "698250122",
                                    "text": "云堇肯定能做到。",
                                    "response": [
                                        {
                                            "id": "698250124",
                                            "speaker": "云堇",
                                            "text": "呵呵，多谢了，承你的吉言，想必前路无碍。"
                                        }
                                    ]
                                },
                                {
                                    "id": "698250123",
                                    "text": "云堇加油！"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "698250104",
                    "text": "正巧路过。",
                    "response": [
                        {
                            "id": "698250105",
                            "speaker": "云堇",
                            "text": "真是巧了，要来一道坐坐吗？"
                        }
                    ]
                }
            ]
        }
    ]
}