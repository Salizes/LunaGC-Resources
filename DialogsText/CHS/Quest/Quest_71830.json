    "talks": [
        {
            "id": "7183001",
            "objective": "(test)自然时间等到第二天$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7183002",
            "objective": "与王平安对话",
            "dialogues": [
                {
                    "id": "718300201",
                    "speaker": "王平安",
                    "text": "这可真是个大工程…"
                },
                {
                    "id": "718300202",
                    "speaker": "Player",
                    "text": "你还真在修庙啊…"
                },
                {
                    "id": "718300203",
                    "speaker": "王平安",
                    "text": "是您啊。可不是，我都说了我是正经人了。"
                },
                {
                    "id": "718300204",
                    "speaker": "王平安",
                    "text": "不过，我还是没想到工程量会有这么大…"
                },
                {
                    "id": "718300205",
                    "speaker": "王平安",
                    "text": "那位设计屋子的师傅一听是供奉「夜叉」的庙，整个人都来劲了。"
                },
                {
                    "id": "718300206",
                    "speaker": "王平安",
                    "text": "不仅把设计图画了厚厚一大叠，还抓着我到处去采购材料。"
                },
                {
                    "id": "718300207",
                    "speaker": "王平安",
                    "text": "我看他那架势，要是再年轻个几十岁，非要自己过来亲自修不可…",
                    "choices": [
                        {
                            "id": "718300208",
                            "text": "没有遇见什么危险吧？",
                            "response": [
                                {
                                    "id": "718300209",
                                    "speaker": "王平安",
                                    "text": "危险？噢，您是说魔物和盗宝团吧？"
                                },
                                {
                                    "id": "718300212",
                                    "speaker": "王平安",
                                    "text": "这您不用担心，听说我要给夜叉修庙之后，总务司那边也派了几位千岩军随行。"
                                },
                                {
                                    "id": "718300213",
                                    "speaker": "王平安",
                                    "text": "这附近的魔物，基本上都被那几位千岩军赶走了。"
                                },
                                {
                                    "id": "718300214",
                                    "speaker": "王平安",
                                    "text": "至于盗宝团嘛…他们看见千岩军在这，估计也不敢露头了。"
                                },
                                {
                                    "id": "718300215",
                                    "speaker": "王平安",
                                    "text": "不过，修这庙的工程量超乎我的想象，原本准备的材料也不够了，我们只能从城里再运一些材料过来。"
                                },
                                {
                                    "id": "718300216",
                                    "speaker": "王平安",
                                    "text": "我觉得…那群盗宝团虽然不敢对工地动手，但他们也许会埋伏在路上，等着抢劫那些运过来的材料。"
                                },
                                {
                                    "id": "718300217",
                                    "speaker": "王平安",
                                    "text": "虽然千岩军能守住工地，但要是那些运材料的人在路上被盗宝团袭击，那千岩军肯定也没法及时过去援助。"
                                },
                                {
                                    "id": "718300218",
                                    "speaker": "王平安",
                                    "text": "英雄，我能请您帮个忙吗？"
                                },
                                {
                                    "id": "718300219",
                                    "speaker": "王平安",
                                    "text": "我知道您身手很好，对付那些盗宝团肯定不在话下。"
                                },
                                {
                                    "id": "718300220",
                                    "speaker": "王平安",
                                    "text": "能请您去附近教训一下那群盗宝团，别让这群家伙捣乱吗？",
                                    "choices": [
                                        {
                                            "id": "718300221",
                                            "text": "没问题。",
                                            "response": [
                                                {
                                                    "id": "718300222",
                                                    "speaker": "王平安",
                                                    "text": "那就拜托英雄了，真是太感谢了。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "718300223",
                                            "text": "为什么不拜托千岩军去？",
                                            "response": [
                                                {
                                                    "id": "718300224",
                                                    "speaker": "王平安",
                                                    "text": "他们不分日夜守着工地，已经够累了。"
                                                },
                                                {
                                                    "id": "718300225",
                                                    "speaker": "王平安",
                                                    "text": "这件事就拜托您了，英雄。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "718300210",
                            "text": "我记得这周围不太安全…",
                            "response": [
                                {
                                    "id": "718300211",
                                    "speaker": "王平安",
                                    "text": "您是说，这周围有魔物和盗宝团吧？"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7183003",
            "objective": "打倒所有盗宝团",
            "dialogues": [
                {
                    "id": "718300301",
                    "speaker": "王平安",
                    "text": "慢点拆，慢点拆！别把雕像给碰坏了！"
                },
                {
                    "id": "718300302",
                    "speaker": "王平安",
                    "text": "唉，看来还得建一段时间啊…"
                }
            ]
        },
        {
            "id": "7183004",
            "objective": "与盗宝团对话",
            "dialogues": [
                {
                    "id": "718300401",
                    "speaker": "盗宝团老大",
                    "text": "英雄住手！我们认输了，认输了！",
                    "choices": [
                        {
                            "id": "718300402",
                            "text": "收拾东西，滚远点！",
                            "response": [
                                {
                                    "id": "718300404",
                                    "speaker": "盗宝团老大",
                                    "text": "是，是…"
                                },
                                {
                                    "id": "718300405",
                                    "speaker": "盗宝团老大",
                                    "text": "但不知道…我们兄弟是哪里冒犯了英雄？"
                                },
                                {
                                    "id": "718300406",
                                    "speaker": "盗宝团老大",
                                    "text": "难不成英雄正在这周围发财？"
                                },
                                {
                                    "id": "718300407",
                                    "speaker": "Player",
                                    "text": "我们正在这附近修庙。"
                                },
                                {
                                    "id": "718300408",
                                    "speaker": "盗宝团老大",
                                    "text": "修、修庙？这荒郊野岭的，英雄怎么会在这里修庙？"
                                },
                                {
                                    "id": "718300409",
                                    "speaker": "盗宝团老大",
                                    "text": "这…这周围居然有供着仙师的庙？等会，难道那个破屋子…"
                                },
                                {
                                    "id": "718300410",
                                    "speaker": "盗宝团小弟",
                                    "text": "老大，我们上次去那边休息的时候，我看见了一只鸟的雕像，那不会就…"
                                },
                                {
                                    "id": "718300411",
                                    "speaker": "Player",
                                    "text": "那就是夜叉「铜雀」。"
                                },
                                {
                                    "id": "718300412",
                                    "speaker": "盗宝团老大",
                                    "text": "啊？！"
                                },
                                {
                                    "id": "718300413",
                                    "speaker": "盗宝团小弟",
                                    "text": "老、老大！我们是不是冒犯仙师了…"
                                },
                                {
                                    "id": "718300414",
                                    "speaker": "盗宝团老大",
                                    "text": "别、别瞎说！我们之前又不知道，那算是…算是无心之过！仙师应该…应该不会怪罪的…"
                                },
                                {
                                    "id": "718300415",
                                    "speaker": "盗宝团老大",
                                    "text": "英雄！给仙师修庙这件事，我们知道了。"
                                },
                                {
                                    "id": "718300416",
                                    "speaker": "盗宝团老大",
                                    "text": "之前是我们有眼无珠，对仙师不敬…"
                                },
                                {
                                    "id": "718300417",
                                    "speaker": "盗宝团老大",
                                    "text": "我们这就回去，让周围的兄弟离那座庙远点。"
                                },
                                {
                                    "id": "718300418",
                                    "speaker": "盗宝团小弟",
                                    "text": "老大，我们要不要抽个空去那边烧几柱香，给仙师赔个罪…"
                                },
                                {
                                    "id": "718300419",
                                    "speaker": "盗宝团老大",
                                    "text": "哪来这么多废话，赶紧走！"
                                }
                            ]
                        },
                        {
                            "id": "718300403",
                            "text": "以后离这里远一点。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7183007",
            "objective": "向王平安回报",
            "dialogues": [
                {
                    "id": "718300701",
                    "speaker": "王平安",
                    "text": "您回来了，周围有盗宝团吗？"
                },
                {
                    "id": "718300702",
                    "speaker": "王平安",
                    "text": "走了就好，走了就好…"
                },
                {
                    "id": "718300703",
                    "speaker": "Player",
                    "text": "还有什么我们能帮上的吗？"
                },
                {
                    "id": "718300704",
                    "speaker": "王平安",
                    "text": "哈哈哈，谢谢您好心，但您都帮了我那么多忙，我可不能让您再跑前跑后了。"
                },
                {
                    "id": "718300705",
                    "speaker": "王平安",
                    "text": "但如果您愿意的话，倒是可以找些<color=#00E1FFFF>却砂木</color>给我，这样您也算是真正参与建筑这座庙了。"
                },
                {
                    "id": "718300706",
                    "speaker": "王平安",
                    "text": "修庙可是件积德的事，您亲自参与一下，说不定也能沾点福气呢。",
                    "choices": [
                        {
                            "id": "718300707",
                            "text": "我会找点却砂木来的。",
                            "response": [
                                {
                                    "id": "718300708",
                                    "speaker": "王平安",
                                    "text": "哈哈哈，好。您找到<color=#00E1FFFF>却砂木</color>之后，直接带来给我就是。"
                                }
                            ]
                        },
                        {
                            "id": "718300709",
                            "text": "有其他人捐物资来修庙吗？",
                            "response": [
                                {
                                    "id": "718300710",
                                    "speaker": "王平安",
                                    "text": "嗯…老实说，其实没多少人。毕竟这荒郊野岭的，大部分人都不知道这里还有一座庙。"
                                },
                                {
                                    "id": "718300711",
                                    "speaker": "王平安",
                                    "text": "而且，那位名为铜雀的仙师，现在也没多少人记得了…"
                                },
                                {
                                    "id": "718300712",
                                    "speaker": "王平安",
                                    "text": "好了，不说这些了。您找到<color=#00E1FFFF>却砂木</color>之后，直接带来给我就是。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7183005",
            "objective": "将却砂木带给王平安",
            "dialogues": [
                {
                    "id": "718300501",
                    "speaker": "王平安",
                    "text": "怎么样，您找到<color=#00E1FFFF>却砂木</color>了吗？"
                }
            ]
        },
        {
            "id": "7183006",
            "objective": "将却砂木带给王平安",
            "dialogues": [
                {
                    "id": "718300601",
                    "speaker": "王平安",
                    "text": "好，这些<color=#00E1FFFF>却砂木</color>我就收下了。"
                },
                {
                    "id": "718300602",
                    "speaker": "王平安",
                    "text": "这座庙还得一段时间才能完工，这段时间我会一直待在这里。"
                },
                {
                    "id": "718300603",
                    "speaker": "王平安",
                    "text": "您要是有空的话，也可以多来看看。"
                }
            ]
        },
        {
            "id": "7183008",
            "objective": "(test）控制人群group$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7183011",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "718301101",
                    "speaker": "王平安",
                    "text": "唉，这庙真是够破的…柱子也坏了，梁也断了，还好这雕像没坏…"
                },
                {
                    "id": "718301102",
                    "speaker": "王平安",
                    "text": "真是的，怎么一直没人修呢…"
                }
            ]
        }
    ]
}