        {
            "id": "4001109",
            "objective": "(test)询问战备情况进度记录$HIDDEN",
            "dialogues": [
                {
                    "id": "400110901",
                    "speaker": "琴",
                    "text": "准备好了吗？",
                    "choices": [
                        {
                            "id": "400110902",
                            "text": "还没有。",
                            "response": [
                                {
                                    "id": "400110903",
                                    "speaker": "琴",
                                    "text": "不用着急，慢慢收拾就好。我会在这里等着你们的。"
                                }
                            ]
                        },
                        {
                            "id": "400110904",
                            "text": "准备好了。",
                            "response": [
                                {
                                    "id": "400110905",
                                    "speaker": "琴",
                                    "text": "那么，各位就请随我一同到<color=#00E1FFFF>海上</color>去吧。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
