        {
            "id": "4001118",
            "objective": "调查神秘装置",
            "dialogues": []
        },
        {
            "id": "4001119",
            "objective": "调查神秘装置",
            "dialogues": []
        },
        {
            "id": "4001103",
            "objective": "(test)询问战备情况进度记录$HIDDEN",
            "dialogues": [
                {
                    "id": "400110301",
                    "speaker": "芭芭拉",
                    "text": "唔…有什么是我能做的呢…",
                    "choices": [
                        {
                            "id": "400110302",
                            "text": "关于群岛…",
                            "response": [
                                {
                                    "id": "400110303",
                                    "speaker": "芭芭拉",
                                    "text": "我从刚才就想说了，这里的大海真美啊。"
                                },
                                {
                                    "id": "400110304",
                                    "speaker": "芭芭拉",
                                    "text": "大海与阳光…梦寐以求的夏天呢！"
                                },
                                {
                                    "id": "400110305",
                                    "speaker": "芭芭拉",
                                    "text": "真想面朝大海办一场演出啊，效果肯定不错。"
                                }
                            ]
                        },
                        {
                            "id": "400110306",
                            "text": "关于夏装…",
                            "response": [
                                {
                                    "id": "400110307",
                                    "speaker": "芭芭拉",
                                    "text": "怎么样？这件衣服…还不错吧？"
                                },
                                {
                                    "id": "400110308",
                                    "speaker": "芭芭拉",
                                    "text": "我特地选了跟海岛气氛比较搭的装扮，想给大家一个惊喜。"
                                },
                                {
                                    "id": "400110309",
                                    "speaker": "芭芭拉",
                                    "text": "啊，请别担心！就算穿着夏装，芭芭拉也是非常可靠的伙伴哦！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "4001120",
            "objective": "(test)任务隔离，防止回滚$HIDDEN",
            "dialogues": []
        },
        {
            "id": "4001104",
            "objective": "与众人讨论岛屿的变化",
            "dialogues": [
                {
                    "id": "400110501",
                    "speaker": "派蒙",
                    "text": "怎么会有这种事，这片海域实在太神秘了！"
                },
                {
                    "id": "400110502",
                    "speaker": "芭芭拉",
                    "text": "整片陆地都升了上来！"
                },
                {
                    "id": "400110503",
                    "speaker": "可莉",
                    "text": "大魔王，大魔王，哇咿！我来抓你啦，嘎——！"
                },
                {
                    "id": "400110504",
                    "speaker": "派蒙",
                    "text": "小可莉，永远这么有精神啊。"
                },
                {
                    "id": "400110505",
                    "speaker": "琴",
                    "text": "地面震动之前，我有听到类似机关的声音。依我看，这片海面下有着非常巨大的机关。"
                },
                {
                    "id": "400110506",
                    "speaker": "琴",
                    "text": "整片海岛位于机关构架出的底盘上，机关启动，将各个岛屿一并托出水面。"
                },
                {
                    "id": "400110507",
                    "speaker": "芭芭拉",
                    "text": "这样的事情，堪称奇迹…难道这是风神巴巴托斯的力量吗？"
                },
                {
                    "id": "400110508",
                    "speaker": "派蒙",
                    "text": "应该不是吧？我总觉得这更像是某个人刻意的作为…"
                },
                {
                    "id": "400110509",
                    "speaker": "琴",
                    "text": "怎么想都不可思议…用信件把我们引来这里，再以这样的机关挑战我们，所谓的嘟嘟大魔王绝非无能之辈。"
                },
                {
                    "id": "400110510",
                    "speaker": "Player",
                    "text": "我也这么觉得。"
                },
                {
                    "id": "400110511",
                    "speaker": "芭芭拉",
                    "text": "唉，假日的气氛一下就消失了…"
                },
                {
                    "id": "400110512",
                    "speaker": "琴",
                    "text": "……"
                },
                {
                    "id": "400110513",
                    "speaker": "琴",
                    "text": "总之，我会打起精神做好最高级别的警戒。"
                },
                {
                    "id": "400110514",
                    "speaker": "派蒙",
                    "text": "琴团长，雷厉风行的时候真帅气呀！"
                },
                {
                    "id": "400110515",
                    "speaker": "Player",
                    "text": "派蒙和我也会多加留心。"
                },
                {
                    "id": "400110516",
                    "speaker": "琴",
                    "text": "感谢你们的理解。"
                },
                {
                    "id": "400110517",
                    "speaker": "可莉",
                    "text": "找到了，大魔王！"
                },
                {
                    "id": "400110518",
                    "speaker": "可莉",
                    "text": "就在那边的岛上，嘿嘿，抓到你了哦！"
                },
                {
                    "id": "400110519",
                    "speaker": "可莉",
                    "text": "既然要可莉来找你，那可莉就来啦！蹦蹦炸弹，预备——！我们一起跑！"
                },
                {
                    "id": "400110520",
                    "speaker": "芭芭拉",
                    "text": "那是…<color=#00E1FFFF>海中央的平台</color>？"
                },
                {
                    "id": "400110521",
                    "speaker": "琴",
                    "text": "确实有东西出现了。各位，可以靠近查看，但请务必保持警戒。"
                }
            ]
        },
        {
            "id": "4001105",
            "objective": "前往中央平台",
            "dialogues": []
        },
        {
            "id": "4001106",
            "objective": "探讨面前的「神秘人士」",
            "dialogues": [
                {
                    "id": "400110601",
                    "speaker": "琴",
                    "text": "各位，请小心！"
                },
                {
                    "id": "400110602",
                    "speaker": "派蒙",
                    "text": "那是…个子很高大的人吗？"
                },
                {
                    "id": "400110603",
                    "speaker": "芭芭拉",
                    "text": "很像是人，又不太对劲？"
                },
                {
                    "id": "400110604",
                    "speaker": "可莉",
                    "text": "嘟嘟大魔王，可莉来见你啦！你可以…呃…判、判…嗯？"
                },
                {
                    "id": "400110605",
                    "speaker": "派蒙",
                    "text": "「审判」！"
                },
                {
                    "id": "400110606",
                    "speaker": "可莉",
                    "text": "你可以「审判」可莉了！"
                },
                {
                    "id": "400110607",
                    "speaker": "派蒙",
                    "text": "啊——！这孩子在说什么呀！"
                },
                {
                    "id": "400110608",
                    "speaker": "琴",
                    "text": "她根本不明白那句话的意思吧…"
                },
                {
                    "id": "400110609",
                    "speaker": "可莉",
                    "text": "喂，大魔王——！你怎么不理我呀？"
                },
                {
                    "id": "400110610",
                    "speaker": "可莉",
                    "text": "是不是可莉来得太慢，惹你生气了？那…对不起嘛！"
                },
                {
                    "id": "400110611",
                    "speaker": "芭芭拉",
                    "text": "向对方道歉了？可莉这孩子，思维有点跳跃吧…"
                },
                {
                    "id": "400110612",
                    "speaker": "可莉",
                    "text": "大——魔——王——！"
                },
                {
                    "id": "400110613",
                    "speaker": "芭芭拉",
                    "text": "看起来，对方没有要理睬可莉的意思呢。"
                },
                {
                    "id": "400110614",
                    "speaker": "琴",
                    "text": "是人型的机械吧。没有反应，应该是已经损坏了。"
                },
                {
                    "id": "400110615",
                    "speaker": "芭芭拉",
                    "text": "你认识那个吗？"
                },
                {
                    "id": "400110616",
                    "speaker": "琴",
                    "text": "只是猜测。它跟海岛的整体气氛格格不入…看衣着，倒像是从稻妻漂流而来。"
                },
                {
                    "id": "400110617",
                    "speaker": "派蒙",
                    "text": "稻妻？那不是很远的地方吗？"
                },
                {
                    "id": "400110618",
                    "speaker": "Player",
                    "text": "它也是异乡人吗？"
                },
                {
                    "id": "400110619",
                    "speaker": "琴",
                    "text": "是的。这里是独立的海域，不跟任何国度接壤，对这片海洋而言，它也是异乡人。"
                },
                {
                    "id": "400110620",
                    "speaker": "琴",
                    "text": "但以稻妻眼下的情况，又怎么会发生这种事…"
                },
                {
                    "id": "400110621",
                    "speaker": "派蒙",
                    "text": "没反应的异乡人…好神奇，是有人把它带来这里吗？"
                },
                {
                    "id": "400110622",
                    "speaker": "可莉",
                    "text": "呜哇——大魔王不动了！"
                },
                {
                    "id": "400110623",
                    "speaker": "琴",
                    "text": "可莉…也许大魔王只是累了。"
                },
                {
                    "id": "400110624",
                    "speaker": "派蒙",
                    "text": "对对，大魔王应该是睡着了吧？等你等得不耐烦，就呼——地睡过去了！"
                },
                {
                    "id": "400110625",
                    "speaker": "芭芭拉",
                    "text": "嗯，我们陪可莉去别处玩，等大魔王睡醒再来找他。"
                },
                {
                    "id": "400110626",
                    "speaker": "可莉",
                    "text": "…真的…？"
                },
                {
                    "id": "400110627",
                    "speaker": "芭芭拉",
                    "text": "当然啦，你要相信我们。"
                },
                {
                    "id": "400110628",
                    "speaker": "可莉",
                    "text": "唔…不对，可莉想到了！"
                },
                {
                    "id": "400110629",
                    "speaker": "可莉",
                    "text": "这个不是大魔王，真正的大魔王还在别的地方。"
                },
                {
                    "id": "400110630",
                    "speaker": "琴",
                    "text": "欸？是、是吗？"
                },
                {
                    "id": "400110631",
                    "speaker": "可莉",
                    "text": "可莉不会放弃，大魔王，等着吧，我们来找你！"
                },
                {
                    "id": "400110632",
                    "speaker": "派蒙",
                    "text": "又跑掉了…小孩子的精神真好呢。"
                },
                {
                    "id": "400110633",
                    "speaker": "芭芭拉",
                    "text": "可莉，等等我们！"
                }
            ]
        },
        {
            "id": "4001107",
            "objective": "探查周围环境",
            "dialogues": [
                {
                    "id": "400110701",
                    "speaker": "芭芭拉",
                    "text": "荣誉骑士，请看这里！"
                },
                {
                    "id": "400110702",
                    "speaker": "派蒙",
                    "text": "唔…？这是什么…"
                },
                {
                    "id": "400110703",
                    "speaker": "芭芭拉",
                    "text": "叠放的石块和小小的花朵…"
                },
                {
                    "id": "400110704",
                    "speaker": "芭芭拉",
                    "text": "这种感觉，好像是在纪念某个人。",
                    "choices": [
                        {
                            "id": "400110705",
                            "text": "好敏锐的感知力。",
                            "response": [
                                {
                                    "id": "400110707",
                                    "speaker": "芭芭拉",
                                    "text": "说得我都不好意思了…"
                                },
                                {
                                    "id": "400110708",
                                    "speaker": "派蒙",
                                    "text": "可这附近只有那个没反应的稻妻机械而已呀。"
                                },
                                {
                                    "id": "400110709",
                                    "speaker": "芭芭拉",
                                    "text": "难道是在纪念它？"
                                },
                                {
                                    "id": "400110710",
                                    "speaker": "琴",
                                    "text": "或许，它也曾做出过值得他人纪念的事。"
                                },
                                {
                                    "id": "400110711",
                                    "speaker": "芭芭拉",
                                    "text": "……"
                                },
                                {
                                    "id": "400110712",
                                    "speaker": "琴",
                                    "text": "我们所见到的这些布设，足以证明这片海域中有人类存在过。可光凭这些，无法推导究竟是怎样的人类文明。"
                                },
                                {
                                    "id": "400110713",
                                    "speaker": "琴",
                                    "text": "迄今为止我们也没有见到任何人类或是人类的墓冢…"
                                },
                                {
                                    "id": "400110714",
                                    "speaker": "可莉",
                                    "text": "琴团长，可莉去那边看看可以吗？"
                                },
                                {
                                    "id": "400110715",
                                    "speaker": "琴",
                                    "text": "可以，务必注意安全。"
                                },
                                {
                                    "id": "400110716",
                                    "speaker": "可莉",
                                    "text": "嗯！"
                                },
                                {
                                    "id": "400110717",
                                    "speaker": "Player",
                                    "text": "这片海岛上究竟有多少秘密？"
                                },
                                {
                                    "id": "400110718",
                                    "speaker": "琴",
                                    "text": "可莉还小，比较缺乏危机感，但旅行者，我希望我们都能清醒地了解现状。"
                                },
                                {
                                    "id": "400110719",
                                    "speaker": "琴",
                                    "text": "坦白说，一开始我以为那封信只是恶作剧。"
                                },
                                {
                                    "id": "400110720",
                                    "speaker": "派蒙",
                                    "text": "我们也这么想。"
                                },
                                {
                                    "id": "400110721",
                                    "speaker": "芭芭拉",
                                    "text": "我也是，可会是谁给这样的小孩子寄恶作剧信件呢？"
                                },
                                {
                                    "id": "400110722",
                                    "speaker": "琴",
                                    "text": "知道这座岛屿的人本就是少数，引导我们解开机关更是布局巧妙…"
                                },
                                {
                                    "id": "400110723",
                                    "speaker": "琴",
                                    "text": "说不定，这些不是恶作剧而是谋划已久的陷阱。我们绝对不能掉以轻心。"
                                },
                                {
                                    "id": "400110724",
                                    "speaker": "可莉",
                                    "text": "芭芭拉姐姐！"
                                },
                                {
                                    "id": "400110725",
                                    "speaker": "芭芭拉",
                                    "text": "可莉，怎么了？"
                                },
                                {
                                    "id": "400110726",
                                    "speaker": "可莉",
                                    "text": "你说…大魔王会不会不想见可莉？"
                                },
                                {
                                    "id": "400110727",
                                    "speaker": "芭芭拉",
                                    "text": "为什么呢？"
                                },
                                {
                                    "id": "400110728",
                                    "speaker": "可莉",
                                    "text": "因为嘟嘟可喜欢可莉，可莉也喜欢嘟嘟可，大魔王没法把我们分开，就只能不见我们…"
                                },
                                {
                                    "id": "400110729",
                                    "speaker": "可莉",
                                    "text": "呜…可莉很怕他把我们分开。"
                                },
                                {
                                    "id": "400110730",
                                    "speaker": "芭芭拉",
                                    "text": "……"
                                },
                                {
                                    "id": "400110731",
                                    "speaker": "芭芭拉",
                                    "text": "可莉看，这是什么？"
                                },
                                {
                                    "id": "400110732",
                                    "speaker": "可莉",
                                    "text": "是羽球！"
                                },
                                {
                                    "id": "400110733",
                                    "speaker": "芭芭拉",
                                    "text": "我听姐…咳！听琴团长说过，可莉一直想玩羽球对不对？"
                                },
                                {
                                    "id": "400110734",
                                    "speaker": "可莉",
                                    "text": "对，可莉想过羽球节！"
                                },
                                {
                                    "id": "400110735",
                                    "speaker": "芭芭拉",
                                    "text": "这是我为可莉做的特制羽球，只要可莉想玩，天天都是羽球节，好不好？"
                                },
                                {
                                    "id": "400110736",
                                    "speaker": "可莉",
                                    "text": "好——！"
                                },
                                {
                                    "id": "400110737",
                                    "speaker": "Player",
                                    "text": "感受到祈礼牧师的温柔了…"
                                },
                                {
                                    "id": "400110738",
                                    "speaker": "芭芭拉",
                                    "text": "所以可莉，打起精神来。见到大魔王以后，我们大家都会帮你说服他，让他允许你和嘟嘟可在一起。"
                                },
                                {
                                    "id": "400110739",
                                    "speaker": "可莉",
                                    "text": "嗯！"
                                },
                                {
                                    "id": "400110740",
                                    "speaker": "Player",
                                    "text": "大家一起加油找到他。"
                                },
                                {
                                    "id": "400110741",
                                    "speaker": "可莉",
                                    "text": "好！"
                                },
                                {
                                    "id": "400110742",
                                    "speaker": "派蒙",
                                    "text": "交给我们吧，一定会帮可莉找到那个家伙的。"
                                },
                                {
                                    "id": "400110743",
                                    "speaker": "派蒙",
                                    "text": "就算不知道什么时候才能找到、不知道在哪里才能找到…也、也总会找到的吧，嗯！"
                                },
                                {
                                    "id": "400110744",
                                    "speaker": "派蒙",
                                    "text": "在那之前，就先到附近尽情搜索吧！"
                                }
                            ]
                        },
                        {
                            "id": "400110706",
                            "text": "不愧是祈礼牧师。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "4001111",
            "objective": "听听大家的看法",
            "dialogues": []
        },
        {
            "id": "4001104",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "400110401",
                    "speaker": "可莉",
                    "text": "嗯，要带蹦蹦炸弹、嘟嘟可…还有我自己！",
                    "choices": [
                        {
                            "id": "400110406",
                            "text": "关于浮标…",
                            "response": [
                                {
                                    "id": "400110407",
                                    "speaker": "可莉",
                                    "text": "海上那些东西，肯定是嘟嘟大魔王放的！他是坏人哦！"
                                },
                                {
                                    "id": "400110408",
                                    "speaker": "可莉",
                                    "text": "不过，可莉会勇敢面对他，为了嘟嘟可，可莉会努力！"
                                },
                                {
                                    "id": "400110409",
                                    "speaker": "可莉",
                                    "text": "#荣誉骑士{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}，谢谢你帮可莉的忙。"
                                }
                            ]
                        },
                        {
                            "id": "400110402",
                            "text": "关于夏天…",
                            "response": [
                                {
                                    "id": "400110403",
                                    "speaker": "可莉",
                                    "text": "可莉喜欢夏天！但也不是只喜欢夏天…"
                                },
                                {
                                    "id": "400110404",
                                    "speaker": "可莉",
                                    "text": "可莉还喜欢秋天，啊对了，春天和冬天也喜欢！"
                                },
                                {
                                    "id": "400110405",
                                    "speaker": "可莉",
                                    "text": "虽然冬天很冷，但可莉有蹦蹦炸弹，觉得冷的话，用炸弹就好啦。"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}