            "罗尔德": 70
        }
    },
    "talks": [
        {
            "id": "7217501",
            "objective": "",
            "dialogues": [
                {
                    "id": "721750101",
                    "speaker": "罗尔德",
                    "text": "没想到你们也还在这座岛上，真是太好了。"
                },
                {
                    "id": "721750102",
                    "speaker": "罗尔德",
                    "text": "你们近来如何？有没有什么惊人的发现？说来让我听听嘛。",
                    "choices": [
                        {
                            "id": "721750103",
                            "text": "没什么发现。",
                            "response": [
                                {
                                    "id": "721750104",
                                    "speaker": "罗尔德",
                                    "text": "难免的，难免的！这样一座岛屿上从来不缺少秘密，相信你一定能有所发现的。"
                                },
                                {
                                    "id": "721750107",
                                    "speaker": "派蒙",
                                    "text": "话说回来，罗尔德先生在这里做什么呀？"
                                },
                                {
                                    "id": "721750108",
                                    "speaker": "罗尔德",
                                    "text": "嗯？我刚收拾好营地行李，正准备离开呢。"
                                },
                                {
                                    "id": "721750109",
                                    "speaker": "罗尔德",
                                    "text": "这座岛上的浓雾太邪门了…每次深入没多远就会迷失方向。然后不知不觉间就会回到起点。"
                                },
                                {
                                    "id": "721750110",
                                    "speaker": "罗尔德",
                                    "text": "先前阿釜特意指引的道路让我给忘了个干净…结果想要再回去寻访那边的原住民，却再也找不到路了…"
                                },
                                {
                                    "id": "721750111",
                                    "speaker": "罗尔德",
                                    "text": "身上的罗盘也好，地上的影子也好，都没法用来指明方向…甚至我连鞋子都试过了，可到最后也没能在雾中多前进半步。"
                                },
                                {
                                    "id": "721750112",
                                    "speaker": "派蒙",
                                    "text": "鞋子…？"
                                },
                                {
                                    "id": "721750113",
                                    "speaker": "Player",
                                    "text": "他说的是丢鞋指路。"
                                },
                                {
                                    "id": "721750114",
                                    "speaker": "派蒙",
                                    "text": "欸——！"
                                },
                                {
                                    "id": "721750115",
                                    "speaker": "罗尔德",
                                    "text": "#哈！这种资深冒险家的小技巧果然难不住{NICKNAME}！小派蒙要多学学咯。"
                                },
                                {
                                    "id": "721750116",
                                    "speaker": "Player",
                                    "text": "派蒙还需要学习哦。"
                                },
                                {
                                    "id": "721750117",
                                    "speaker": "派蒙",
                                    "text": "根本是碰运气吧！这种东西有什么必要学啦！"
                                },
                                {
                                    "id": "721750118",
                                    "speaker": "罗尔德",
                                    "text": "总之就是这样，我的探索裹足不前。"
                                },
                                {
                                    "id": "721750119",
                                    "speaker": "罗尔德",
                                    "text": "唉…假如把绳索绑在附近的树上，紧握着另一端摸索前进的话，本来还可以再多试几次的。"
                                },
                                {
                                    "id": "721750120",
                                    "speaker": "派蒙",
                                    "text": "所以为什么不再试试了？"
                                },
                                {
                                    "id": "721750121",
                                    "speaker": "罗尔德",
                                    "text": "用来分辨方向的备用鞋子丢完了…",
                                    "choices": [
                                        {
                                            "id": "721750122",
                                            "text": "原来备用鞋子都是一次性的吗…",
                                            "response": [
                                                {
                                                    "id": "721750123",
                                                    "speaker": "罗尔德",
                                                    "text": "嘿嘿，原本不是的。只是丢多了，就总是忘了回头捡回来，结果慢慢就都…消耗掉了。"
                                                },
                                                {
                                                    "id": "721750126",
                                                    "speaker": "罗尔德",
                                                    "text": "啊！对了，我终于想起自己有什么事情要拜托你们了！"
                                                },
                                                {
                                                    "id": "721750127",
                                                    "speaker": "派蒙",
                                                    "text": "哇，吓我一跳！还以为你要咬人了！"
                                                },
                                                {
                                                    "id": "721750128",
                                                    "speaker": "罗尔德",
                                                    "text": "抱歉，抱歉，呵呵…"
                                                },
                                                {
                                                    "id": "721750129",
                                                    "speaker": "罗尔德",
                                                    "text": "如你所知，我本来就有个丢脸的毛病…就是无论做什么都丢三落四的。"
                                                },
                                                {
                                                    "id": "721750130",
                                                    "speaker": "罗尔德",
                                                    "text": "生来记忆力不佳，给我造成了很多不便，尤其身为冒险家，很容易为此而陷入危险…"
                                                },
                                                {
                                                    "id": "721750131",
                                                    "speaker": "罗尔德",
                                                    "text": "而我此次来到鹤观的目的之一，是采集一种名为「幽灯蕈」的菌类。听珊瑚小姐说，这种菌类能够增强记忆力，缓解大脑劳损，对视力也有好处。"
                                                },
                                                {
                                                    "id": "721750132",
                                                    "speaker": "罗尔德",
                                                    "text": "上次与阿釜一同前来，因为对「遇见原住民」这件事太过上心…反倒忘了采集菌类…唉。"
                                                },
                                                {
                                                    "id": "721750133",
                                                    "speaker": "罗尔德",
                                                    "text": "又没能想到，自己一个人登岛之后就遇到了这样的困难…真是可惜。"
                                                },
                                                {
                                                    "id": "721750134",
                                                    "speaker": "罗尔德",
                                                    "text": "如果你们在这里还有冒险安排的话，不知可否请帮我采摘一些「幽灯蕈」回来？",
                                                    "choices": [
                                                        {
                                                            "id": "721750135",
                                                            "text": "没问题。",
                                                            "response": [
                                                                {
                                                                    "id": "721750136",
                                                                    "speaker": "罗尔德",
                                                                    "text": "十分感谢！"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "721750137",
                                                            "text": "到时候别忘了找我要就好。",
                                                            "response": [
                                                                {
                                                                    "id": "721750138",
                                                                    "speaker": "罗尔德",
                                                                    "text": "哈哈，这个不会忘的！"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "721750124",
                                            "text": "真是遗憾…",
                                            "response": [
                                                {
                                                    "id": "721750125",
                                                    "speaker": "罗尔德",
                                                    "text": "唉，说的是呢…"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "721750105",
                            "text": "我们还在探索途中。",
                            "response": [
                                {
                                    "id": "721750106",
                                    "speaker": "罗尔德",
                                    "text": "这样呀，哈哈，那就别让我耽误你们的路程了！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7217517",
            "objective": "向罗尔德交付「幽灯蕈」",
            "dialogues": []
        },
        {
            "id": "7217510",
            "objective": "向罗尔德交付「幽灯蕈」",
            "dialogues": [
                {
                    "id": "721750301",
                    "speaker": "罗尔德",
                    "text": "嗯…有这些的话应该足够了，谢谢你们！"
                },
                {
                    "id": "721750302",
                    "speaker": "罗尔德",
                    "text": "顺便，如果你们在岛上的「祭场」附近有什么发现的话，还望告知我一下。"
                },
                {
                    "id": "721750303",
                    "speaker": "罗尔德",
                    "text": "啊…对了，你们随身带着「留影机」，枫丹货，对吧？那东西还挺贵的…如果经费有宽裕的话，我也得给自己采购一台。"
                },
                {
                    "id": "721750304",
                    "speaker": "罗尔德",
                    "text": "听本地的历史作家所言，传说鹤观的古代原住民会用颜料将无法追忆的古老历史涂画在山洞内的岩壁上，往往存续超过千年…"
                },
                {
                    "id": "721750305",
                    "speaker": "罗尔德",
                    "text": "此前的寻访中，我似乎也借着祭典的火光看到了些许图案…自此之后就难以忘怀，几天都没有睡好觉…"
                },
                {
                    "id": "721750306",
                    "speaker": "罗尔德",
                    "text": "这些壁画，据我所知从未有人目睹…假如能够借二位的口述得以证实的话，将会为「冒险家协会」在历史学术范畴带来又一大突破。"
                },
                {
                    "id": "721750307",
                    "speaker": "罗尔德",
                    "text": "所以我希望二位能寻到传说中的壁画，尽可能完整清晰地拍摄下来。我会买下你们的照片作为日志素材所需，并且为你们支付足够的辛苦费。"
                },
                {
                    "id": "721750308",
                    "speaker": "罗尔德",
                    "text": "不知两位意下如何？",
                    "choices": [
                        {
                            "id": "721750309",
                            "text": "没问题。",
                            "response": [
                                {
                                    "id": "721750310",
                                    "speaker": "罗尔德",
                                    "text": "非常感谢！"
                                }
                            ]
                        },
                        {
                            "id": "721750311",
                            "text": "只要你别再弄丢日志。",
                            "response": [
                                {
                                    "id": "721750312",
                                    "speaker": "罗尔德",
                                    "text": "我…我尽力而为。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7217504",
            "objective": "",
            "dialogues": [
                {
                    "id": "721750401",
                    "speaker": "罗尔德",
                    "text": "两位好！最近有什么收获吗！",
                    "choices": [
                        {
                            "id": "721750402",
                            "text": "没发现什么有趣的东西。",
                            "response": [
                                {
                                    "id": "721750403",
                                    "speaker": "罗尔德",
                                    "text": "不用急躁，我一直在这里的。"
                                },
                                {
                                    "id": "721750404",
                                    "speaker": "罗尔德",
                                    "text": "顺便，谢谢你送的「幽灯蕈」。很新鲜！"
                                },
                                {
                                    "id": "721750407",
                                    "speaker": "派蒙",
                                    "text": "说的倒是轻松，你吃的蘑菇不还是我们采的吗！"
                                },
                                {
                                    "id": "721750408",
                                    "speaker": "罗尔德",
                                    "text": "哈哈，别在意那么多嘛，我一直在吃呢。"
                                },
                                {
                                    "id": "721750409",
                                    "speaker": "派蒙",
                                    "text": "哇——这个健忘人！！"
                                }
                            ]
                        },
                        {
                            "id": "721750405",
                            "text": "还在努力奔走。",
                            "response": [
                                {
                                    "id": "721750406",
                                    "speaker": "罗尔德",
                                    "text": "累了的话也请休息一下，来点「幽灯蕈」吧！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7217505",
            "objective": "",
            "dialogues": [
                {
                    "id": "721750501",
                    "speaker": "罗尔德",
                    "text": "（test）这些记录真的是太有价值了！"
                },
                {
                    "id": "721750502",
                    "speaker": "罗尔德",
                    "text": "（test）有了这些，日记就可以完成了！日志给你"
                },
                {
                    "id": "721750503",
                    "speaker": "Player",
                    "text": "（test）好耶！"
                }
            ]
        },
        {
            "id": "7217506",
            "objective": "",
            "dialogues": [
                {
                    "id": "721750601",
                    "speaker": "罗尔德",
                    "text": "#你好啊，{NICKNAME}，还有多话的小精灵！"
                },
                {
                    "id": "721750602",
                    "speaker": "派蒙",
                    "text": "你好呀，健·忘·人！"
                },
                {
                    "id": "721750603",
                    "speaker": "派蒙",
                    "text": "我·是·派·蒙！下次可不要忘记啦！"
                },
                {
                    "id": "721750604",
                    "speaker": "罗尔德",
                    "text": "我知道呀，小·派·蒙。"
                },
                {
                    "id": "721750605",
                    "speaker": "派蒙",
                    "text": "哇！原来你在耍我！你这人的礼貌哪里去啦！"
                },
                {
                    "id": "721750606",
                    "speaker": "派蒙",
                    "text": "#哼，{NICKNAME}快把那些鬼里鬼气的蘑菇给他吧，我不要和他说话了！"
                },
                {
                    "id": "721750607",
                    "speaker": "Player",
                    "text": "这些足够吗？"
                }
            ]
        },
        {
            "id": "7217502",
            "objective": "在遗迹里拍摄壁画",
            "dialogues": [
                {
                    "id": "721750201",
                    "speaker": "罗尔德",
                    "text": "（test）太感谢了，这些壁画有很大的研究价值"
                },
                {
                    "id": "721750202",
                    "speaker": "Player",
                    "text": "（test）好耶！参与写了冒险日志！"
                },
                {
                    "id": "721750203",
                    "speaker": "罗尔德",
                    "text": "（test）另外我听说这个岛上有会发光的奇怪蘑菇？整几个？"
                },
                {
                    "id": "721750204",
                    "speaker": "Player",
                    "text": "（test）好嘞！使命必达！"
                }
            ]
        },
        {
            "id": "7217518",
            "objective": "",
            "dialogues": [
                {
                    "id": "721751801",
                    "speaker": "罗尔德",
                    "text": "#又见面了，{NICKNAME}！还有…那个…"
                },
                {
                    "id": "721751802",
                    "speaker": "派蒙",
                    "text": "…？"
                },
                {
                    "id": "721751803",
                    "speaker": "罗尔德",
                    "text": "顺便一问，这个飞来飞去的小家伙怎么卖？看上去蛮有趣的。"
                },
                {
                    "id": "721751804",
                    "speaker": "派蒙",
                    "text": "欸？！",
                    "choices": [
                        {
                            "id": "721751805",
                            "text": "你还好吗…？",
                            "response": [
                                {
                                    "id": "721751806",
                                    "speaker": "派蒙",
                                    "text": "明显不太好吧！这家伙怎么突然失忆了！"
                                },
                                {
                                    "id": "721751809",
                                    "speaker": "罗尔德",
                                    "text": "你们在说什…噗…"
                                },
                                {
                                    "id": "721751810",
                                    "speaker": "罗尔德",
                                    "text": "噗…哈哈哈哈哈！"
                                },
                                {
                                    "id": "721751811",
                                    "speaker": "派蒙",
                                    "text": "？？"
                                },
                                {
                                    "id": "721751812",
                                    "speaker": "Player",
                                    "text": "？？？"
                                },
                                {
                                    "id": "721751813",
                                    "speaker": "罗尔德",
                                    "text": "哈哈哈哈…咳咳…哈哈哈哈哈！瞧瞧…瞧瞧你们那副表情！噗哈哈哈哈哈！"
                                },
                                {
                                    "id": "721751814",
                                    "speaker": "罗尔德",
                                    "text": "完了…我笑岔气了…对不…对不起…这是…呵哈哈哈哈…这是我最喜欢的「健忘笑话」！"
                                },
                                {
                                    "id": "721751815",
                                    "speaker": "派蒙",
                                    "text": "一点也不好笑吧！！",
                                    "choices": [
                                        {
                                            "id": "721751816",
                                            "text": "不是很懂你的幽默感…",
                                            "response": [
                                                {
                                                    "id": "721751818",
                                                    "speaker": "罗尔德",
                                                    "text": "噗…好了，好了，不开玩笑了，抱歉抱歉。"
                                                },
                                                {
                                                    "id": "721751819",
                                                    "speaker": "派蒙",
                                                    "text": "真是的，我还以为你作为大冒险家，是个很严肃的人呢！"
                                                },
                                                {
                                                    "id": "721751820",
                                                    "speaker": "罗尔德",
                                                    "text": "呵呵，可不要产生这样的刻板印象哦，冒险家协会可是有名的怪人圈子。我在里面算是比较正常的呢。"
                                                },
                                                {
                                                    "id": "721751821",
                                                    "speaker": "派蒙",
                                                    "text": "…也没有多正常吧。"
                                                },
                                                {
                                                    "id": "721751822",
                                                    "speaker": "罗尔德",
                                                    "text": "还是谢谢你们的蘑菇。这东西到现在为止效果还不太明显…或许是需要长期服用，也许本身就不是什么药物…总之味道不差就是了。"
                                                },
                                                {
                                                    "id": "721751823",
                                                    "speaker": "罗尔德",
                                                    "text": "这些可不能全吃完了，我还要留一些给须弥的朋友，帮忙研究一下它的药用价值。"
                                                },
                                                {
                                                    "id": "721751824",
                                                    "speaker": "派蒙",
                                                    "text": "我猜你一转头就会把这事忘了…"
                                                },
                                                {
                                                    "id": "721751825",
                                                    "speaker": "罗尔德",
                                                    "text": "咳咳，正事正事。请问二位有没有去寻找壁画呢？"
                                                },
                                                {
                                                    "id": "721751826",
                                                    "speaker": "Player",
                                                    "text": "这里是你要的相片。"
                                                },
                                                {
                                                    "id": "721751827",
                                                    "speaker": "罗尔德",
                                                    "text": "哦哦，大恩不言谢！这个国家是这样表达感谢的，对吧？"
                                                },
                                                {
                                                    "id": "721751828",
                                                    "speaker": "罗尔德",
                                                    "text": "唔嗯…有趣，非常有趣。只是…你们没有发现更多壁画了吗？",
                                                    "choices": [
                                                        {
                                                            "id": "721751829",
                                                            "text": "这些是全部了。",
                                                            "response": [
                                                                {
                                                                    "id": "721751831",
                                                                    "speaker": "罗尔德",
                                                                    "text": "那就更有意思了…"
                                                                },
                                                                {
                                                                    "id": "721751832",
                                                                    "speaker": "派蒙",
                                                                    "text": "咦…？"
                                                                },
                                                                {
                                                                    "id": "721751833",
                                                                    "speaker": "罗尔德",
                                                                    "text": "鹤观的原住民曾以雷元素之魔鸟为信仰，以祭祀仪礼为核心组建起自己的文明。稍微了解历史的人对此应该并无异见…"
                                                                },
                                                                {
                                                                    "id": "721751834",
                                                                    "speaker": "罗尔德",
                                                                    "text": "但在你们提供的壁画上…却没有雷鸟的痕迹。人们所膜拜的是另一些东西——"
                                                                },
                                                                {
                                                                    "id": "721751835",
                                                                    "speaker": "罗尔德",
                                                                    "text": "日月星辰…和…奇怪的符号。或许…在雷鸟降临之前，鹤观原住民的先祖们就已经拥有了一定高度的文明…"
                                                                },
                                                                {
                                                                    "id": "721751836",
                                                                    "speaker": "罗尔德",
                                                                    "text": "除此之外…雾与月亮，群星与黑暗…唔，解释不通呢…"
                                                                },
                                                                {
                                                                    "id": "721751837",
                                                                    "speaker": "派蒙",
                                                                    "text": "还是不要过度用脑了吧…你的记性已经很不行了。"
                                                                },
                                                                {
                                                                    "id": "721751838",
                                                                    "speaker": "罗尔德",
                                                                    "text": "…啊，抱歉。思考太入迷，忘了你们还在场。"
                                                                },
                                                                {
                                                                    "id": "721751839",
                                                                    "speaker": "罗尔德",
                                                                    "text": "再次感谢你们的辛劳，我接下来的日志有了足够的素材…假如能有幸被历史学者重视的话，我是不会忘记署上二位的大名的！"
                                                                },
                                                                {
                                                                    "id": "721751840",
                                                                    "speaker": "罗尔德",
                                                                    "text": "好了，我也该去冒险家协会报道了。实在抱歉打扰了你很长时间，希望下次有缘再见。"
                                                                },
                                                                {
                                                                    "id": "721751841",
                                                                    "speaker": "派蒙",
                                                                    "text": "真是个大忙人呀…"
                                                                },
                                                                {
                                                                    "id": "721751842",
                                                                    "speaker": "罗尔德",
                                                                    "text": "啊，顺便…还有一件事。虽然不是什么大事，但希望你能替我关注一下。先前提到的那个小孩子…叫…什么来着…"
                                                                },
                                                                {
                                                                    "id": "721751843",
                                                                    "speaker": "罗尔德",
                                                                    "text": "「阿瑠」…对，是这个名字。我这次顺便给那孩子带了些吃的…希望还新鲜。"
                                                                },
                                                                {
                                                                    "id": "721751844",
                                                                    "speaker": "罗尔德",
                                                                    "text": "自从上次以来，我还一直惦记着这岛上有个孩子…在这样凶险的岛上过日子，一定很不容易吧。"
                                                                },
                                                                {
                                                                    "id": "721751845",
                                                                    "speaker": "罗尔德",
                                                                    "text": "#好了，不多耽误你时间了，{NICKNAME}。旅途的下一站再见，向着星辰与深渊！"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "721751830",
                                                            "text": "我们只找到了这些。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "721751817",
                                            "text": "这是「健忘人」适应这个世界的方式。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "721751807",
                            "text": "之前的「幽灯蕈」有效吗…？",
                            "response": [
                                {
                                    "id": "721751808",
                                    "speaker": "派蒙",
                                    "text": "对呀，对呀！怎么还恶化了！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7217509",
            "objective": "回去找罗尔德",
            "dialogues": []
        }
    ]
}