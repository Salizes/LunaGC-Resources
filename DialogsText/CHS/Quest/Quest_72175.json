        "rewards_formatted": "冒险阅历 x150, 原石 x20, 摩拉 x20000",
        "chapter": {
            "icon": "",
            "id": "",
            "num": "",
            "title": ""
        },
        "total_dialogue_lines": 118,
        "total_speaker_counts": {
            "Player": 24,
