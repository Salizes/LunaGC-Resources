    "talks": [
        {
            "id": "601601",
            "objective": "与同伴们会合",
            "dialogues": []
        },
        {
            "id": "601602",
            "objective": "与「木偶」对话",
            "dialogues": [
                {
                    "id": "60160201",
                    "speaker": "「木偶」",
                    "text": "喔，你们来了。"
                },
                {
                    "id": "60160202",
                    "speaker": "派蒙",
                    "text": "桑多涅！进度怎么样？"
                },
                {
                    "id": "60160203",
                    "speaker": "「木偶」",
                    "text": "你们将成为第一第二个见到我得意之作的人…或者飘浮灵？"
                },
                {
                    "id": "60160204",
                    "speaker": "派蒙",
                    "text": "喂！！"
                },
                {
                    "id": "60160205",
                    "speaker": "「木偶」",
                    "text": "不管了。来，都不许眨眼，仔细地看清楚。"
                },
                {
                    "id": "60160206",
                    "speaker": "派蒙",
                    "text": "哇，是个从来没见过的东西！"
                },
                {
                    "id": "60160207",
                    "speaker": "Player",
                    "text": "看上去很不得了！"
                },
                {
                    "id": "60160208",
                    "speaker": "「木偶」",
                    "text": "这个计程仪直观表现了「术式」的进展。目前，它还在构建最重要的联结。"
                },
                {
                    "id": "60160209",
                    "speaker": "「木偶」",
                    "text": "进程完成时，我会将它送到你身边。这样才能迎回哥伦比娅。"
                },
                {
                    "id": "60160210",
                    "speaker": "派蒙",
                    "text": "送到身边？如果只是计算结果的话，直接用通讯仪告诉我们不就行了？"
                },
                {
                    "id": "60160211",
                    "speaker": "「木偶」",
                    "text": "…啧。你这小东西还真是没见过世面。这不是简简单单的「算式」，而是能够构建某种规则的「术式」。"
                },
                {
                    "id": "60160212",
                    "speaker": "「木偶」",
                    "text": "…算了，说多了你们也不明白，总之只要知道它是哥伦比娅回来所需的必要条件就行了。"
                },
                {
                    "id": "60160213",
                    "speaker": "Player",
                    "text": "我明白了。"
                },
                {
                    "id": "60160214",
                    "speaker": "「木偶」",
                    "text": "我把这些数据分享给你。尼可同意我使用她构建的信息通道，所以可以通过嘟嘟通讯仪，像这样…"
                },
                {
                    "id": "60160215",
                    "speaker": "「木偶」",
                    "text": "好了。现在你也可以查看进程了。"
                },
                {
                    "id": "60160216",
                    "speaker": "派蒙",
                    "text": "真的有欸！你好厉害！"
                },
                {
                    "id": "60160217",
                    "speaker": "「木偶」",
                    "text": "废话，我一直很厉害，哈哈哈哈。"
                },
                {
                    "id": "60160218",
                    "speaker": "「木偶」",
                    "text": "嗯，我需要交代给你的就这些。接下来要是有空，也去看看其他人，监督一下他们，别让任何人掉链子。"
                },
                {
                    "id": "60160219",
                    "speaker": "「木偶」",
                    "text": "在愚人众，这类监督不属于苛责的范畴。我只是希望一切顺利。"
                },
                {
                    "id": "60160220",
                    "speaker": "「木偶」",
                    "text": "目前术式还在运转，我不方便移动。你就作为我的第二双眼睛，去完成使命吧。"
                }
            ]
        },
        {
            "id": "601603",
            "objective": "与同伴们对话",
            "dialogues": [
                {
                    "id": "60160301",
                    "speaker": "菲林斯",
                    "text": "#{NICKNAME}，派蒙，很高兴见到你们。"
                },
                {
                    "id": "60160302",
                    "speaker": "派蒙",
                    "text": "菲林斯！你这边准备得怎么样？"
                },
                {
                    "id": "60160303",
                    "speaker": "菲林斯",
                    "text": "还不错。我已经做好正面迎战多托雷的准备了。"
                },
                {
                    "id": "60160304",
                    "speaker": "派蒙",
                    "text": "哦哦，这一次看起来比平时还认真些呢。"
                },
                {
                    "id": "60160305",
                    "speaker": "菲林斯",
                    "text": "说真的，我平时不怎么喜欢全力以赴。那不利于隐藏身份，对吧？再说，一个人应当有选择地展露实力。"
                },
                {
                    "id": "60160306",
                    "speaker": "菲林斯",
                    "text": "养精蓄锐，更好地赢下关键之战。目前我正处于这个状态。"
                },
                {
                    "id": "60160307",
                    "speaker": "派蒙",
                    "text": "#能看到你认真，心里都踏实了几分。对吧{NICKNAME}？",
                    "choices": [
                        {
                            "id": "60160308",
                            "text": "是的。",
                            "response": [
                                {
                                    "id": "60160310",
                                    "speaker": "菲林斯",
                                    "text": "能得到两位的信任，我很荣幸。"
                                },
                                {
                                    "id": "60160311",
                                    "speaker": "菲林斯",
                                    "text": "还请好好休息。我衷心希望，能在决战中见到精神抖擞的你们。"
                                }
                            ]
                        },
                        {
                            "id": "60160309",
                            "text": "感觉很安心。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "601604",
            "objective": "与同伴们对话",
            "dialogues": [
                {
                    "id": "60160401",
                    "speaker": "奈芙尔",
                    "text": "看什么呢？咏月使小姐。"
                },
                {
                    "id": "60160402",
                    "speaker": "菈乌玛",
                    "text": "你对我的称呼还真奇怪。咏月使小姐、咏月使女士…都叫过了。"
                },
                {
                    "id": "60160403",
                    "speaker": "奈芙尔",
                    "text": "是啊，不行吗？这不都是你吗。"
                },
                {
                    "id": "60160404",
                    "speaker": "菈乌玛",
                    "text": "但我已经想好直接叫你奈芙尔了。"
                },
                {
                    "id": "60160405",
                    "speaker": "奈芙尔",
                    "text": "我本来就叫这个，有什么奇怪的。"
                },
                {
                    "id": "60160406",
                    "speaker": "菈乌玛",
                    "text": "意思是不加任何称谓，直呼其名。"
                },
                {
                    "id": "60160407",
                    "speaker": "奈芙尔",
                    "text": "什么意思？"
                },
                {
                    "id": "60160408",
                    "speaker": "菈乌玛",
                    "text": "也许可以证明我们的关系变融洽了。"
                },
                {
                    "id": "60160409",
                    "speaker": "奈芙尔",
                    "text": "多么美丽的错觉。"
                },
                {
                    "id": "60160410",
                    "speaker": "派蒙",
                    "text": "奈芙尔！菈乌玛！"
                },
                {
                    "id": "60160411",
                    "speaker": "菈乌玛",
                    "text": "#派蒙，{NICKNAME}。"
                },
                {
                    "id": "60160412",
                    "speaker": "派蒙",
                    "text": "我们来看看你们的情况！准备得还顺利吗？有好好休息吗？"
                },
                {
                    "id": "60160413",
                    "speaker": "奈芙尔",
                    "text": "放心吧，不会拖大家后腿的。"
                },
                {
                    "id": "60160414",
                    "speaker": "菈乌玛",
                    "text": "我也会全力帮助大家取得胜利。"
                },
                {
                    "id": "60160415",
                    "speaker": "菈乌玛",
                    "text": "对了，请允许我给你们稍微检查一下…"
                },
                {
                    "id": "60160416",
                    "speaker": "菈乌玛",
                    "text": "…好了。两位的状态都不错，真是再好不过了。",
                    "choices": [
                        {
                            "id": "60160417",
                            "text": "托大家的福。",
                            "response": [
                                {
                                    "id": "60160419",
                                    "speaker": "奈芙尔",
                                    "text": "不用客气。你不比我们任何人轻松，所以你也要好好休息，直到迎战多托雷的那一刻。"
                                },
                                {
                                    "id": "60160420",
                                    "speaker": "派蒙",
                                    "text": "#放心吧，我会监督{M#他}{F#她}的。"
                                },
                                {
                                    "id": "60160421",
                                    "speaker": "菈乌玛",
                                    "text": "那就好。派蒙自己也要注意休息哦。"
                                },
                                {
                                    "id": "60160422",
                                    "speaker": "派蒙",
                                    "text": "嗯，我记住啦！"
                                }
                            ]
                        },
                        {
                            "id": "60160418",
                            "text": "非常感谢。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "601605",
            "objective": "与同伴们对话",
            "dialogues": [
                {
                    "id": "60160501",
                    "speaker": "杜林",
                    "text": "尼可小姐送来了支援，那夏镇附近现在已经构筑起完整的防御工事了！"
                },
                {
                    "id": "60160502",
                    "speaker": "阿贝多",
                    "text": "泛着金色的火光…是尼可女士的力量。"
                },
                {
                    "id": "60160503",
                    "speaker": "阿贝多",
                    "text": "加上刚才法尔伽团长送来的信息…嗯，他们果然商量好了。"
                },
                {
                    "id": "60160504",
                    "speaker": "阿贝多",
                    "text": "有她帮忙，情况应该会稳定一些。至少大家可以得到最基本的保障。"
                },
                {
                    "id": "60160505",
                    "speaker": "派蒙",
                    "text": "阿贝多，杜林！"
                },
                {
                    "id": "60160506",
                    "speaker": "杜林",
                    "text": "#是{NICKNAME}和派蒙！你们好。"
                },
                {
                    "id": "60160507",
                    "speaker": "阿贝多",
                    "text": "休息得还好吗？"
                },
                {
                    "id": "60160508",
                    "speaker": "Player",
                    "text": "谢谢关心，还不错。"
                },
                {
                    "id": "60160509",
                    "speaker": "杜林",
                    "text": "那我们就放心了。"
                },
                {
                    "id": "60160510",
                    "speaker": "杜林",
                    "text": "按照计划，那夏镇交给我和阿贝多。"
                },
                {
                    "id": "60160511",
                    "speaker": "杜林",
                    "text": "虽说多托雷的能量界域一直在不断向这里拓张…我们会竭尽全力守住阵地的。"
                },
                {
                    "id": "60160512",
                    "speaker": "阿贝多",
                    "text": "我们并肩作战过很多次，每一次都取得了好的结果。"
                },
                {
                    "id": "60160513",
                    "speaker": "阿贝多",
                    "text": "这次一定也是如此，所以，尽管去战斗吧。"
                }
            ]
        },
        {
            "id": "601606",
            "objective": "与同伴们对话",
