        },
        {
            "id": "601607",
            "objective": "击败眼前的敌人",
            "dialogues": [
                {
                    "id": "60160701",
                    "speaker": "Player",
                    "text": "（……！！）"
                },
                {
                    "id": "60160702",
                    "speaker": "Player",
                    "text": "（有什么东西过来了…是「博士」的爪牙吗？）"
                },
                {
                    "id": "60160703",
                    "speaker": "奈芙尔",
                    "text": "来了，数量还不少。"
                },
                {
                    "id": "60160704",
                    "speaker": "菈乌玛",
                    "text": "和预期一样。"
                },
                {
                    "id": "60160705",
                    "speaker": "Player",
                    "text": "各位！准备好！"
                },
                {
                    "id": "60160706",
                    "speaker": "菲林斯",
                    "text": "到指定地点迎战！"
                },
                {
                    "id": "60160707",
                    "speaker": "阿贝多",
                    "text": "开始吧。"
                },
                {
                    "id": "60160708",
                    "speaker": "杜林",
                    "text": "随时可以行动！"
                }
            ]
        },
