        },
        {
            "id": "600399",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "60039904",
                    "speaker": "多托雷",
                    "text": "抱歉抱歉，掳走你的伙伴并非我本意。"
                },
                {
                    "id": "60039905",
                    "speaker": "多托雷",
                    "text": "但这并非没有选择，只要你愿意顺从，我自然也能放他们自由。"
                },
                {
                    "id": "60039906",
                    "speaker": "多托雷",
                    "text": "这可是相当理想的交易。不考虑考虑吗？"
                }
            ]
        },
        {
            "id": "601699",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "60169901",
                    "speaker": "菲林斯",
                    "text": "哦？把我转移到了未知的结界内。"
                },
                {
                    "id": "60169902",
                    "speaker": "菲林斯",
                    "text": "这种空间构造…多托雷似乎想将我们都困在这里。"
                },
                {
                    "id": "60169903",
                    "speaker": "菲林斯",
                    "text": "果然没有出口。看来，比拼耐力的时候到了。"
                },
                {
                    "id": "60169904",
                    "speaker": "菈乌玛",
                    "text": "多托雷果然想把我们分散开，再逐个击破…"
                },
                {
                    "id": "60169905",
                    "speaker": "菈乌玛",
                    "text": "不会让他得逞的。"
                },
                {
                    "id": "60169906",
                    "speaker": "菈乌玛",
                    "text": "现在，为了我们的胜利祈祷吧。"
                },
                {
                    "id": "60169907",
                    "speaker": "奈芙尔",
                    "text": "这算什么？灵感来源是哥伦比娅进入的那个未知空间吗？"
                },
                {
                    "id": "60169908",
                    "speaker": "奈芙尔",
                    "text": "哈，还真出不去了…"
                },
                {
                    "id": "60169909",
                    "speaker": "奈芙尔",
                    "text": "走着瞧吧。"
                },
                {
                    "id": "60169910",
                    "speaker": "哥伦比娅",
                    "text": "我将赐予你新月的祝福。"
                },
                {
                    "id": "60169911",
                    "speaker": "哥伦比娅",
                    "text": "新月，驻映于你身侧。"
                },
                {
                    "id": "60169912",
                    "speaker": "多托雷",
                    "text": "如此执着于妨碍我的计划…"
                }
            ]
        }
    ]
