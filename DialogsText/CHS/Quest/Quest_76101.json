        {
            "id": "7610106",
            "objective": "前往广场",
            "dialogues": [
                {
                    "id": "761010601",
                    "speaker": "叶洛亚",
                    "text": "要是比约恩也在就好了…"
                },
                {
                    "id": "761010602",
                    "speaker": "Player",
                    "text": "他一定会非常自豪的。"
                },
                {
                    "id": "761010603",
                    "speaker": "叶洛亚",
                    "text": "是啊。过几天再去看看他好了，告诉他城里的近况，让他放心。"
                }
            ]
        },
        {
            "id": "7610108",
            "objective": "激活增幅器",
            "dialogues": [
                {
                    "id": "761010801",
                    "speaker": "罗洛",
                    "text": "#{NICKNAME}，宴会的餐饮还合你的口味吗？"
                },
                {
                    "id": "761010802",
                    "speaker": "Player",
                    "text": "要是每天都有宴会就好了…"
                },
                {
                    "id": "761010803",
                    "speaker": "罗洛",
                    "text": "每天吗？那或许有些勉强…"
                },
                {
                    "id": "761010804",
                    "speaker": "Player",
                    "text": "只是开个玩笑！"
                },
                {
                    "id": "761010805",
                    "speaker": "罗洛",
                    "text": "哈哈，是吗？不过也不是不能理解。希望今后能多一些像今天这样值得庆祝的日子。"
                }
            ]
        },
