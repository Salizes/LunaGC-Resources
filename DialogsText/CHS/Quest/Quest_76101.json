    "talks": [
        {
            "id": "7610101",
            "objective": "前往皮拉米达城",
            "dialogues": [
                {
                    "id": "761010101",
                    "speaker": "叶洛亚",
                    "text": "#{NICKNAME}、派蒙！"
                },
                {
                    "id": "761010102",
                    "speaker": "派蒙",
                    "text": "嘿嘿，我们来啦！这里好热闹呀。"
                },
                {
                    "id": "761010103",
                    "speaker": "叶洛亚",
                    "text": "这段时间大家都辛苦了，总算是将善后的工作也处理得差不多了，这才有时间组织宴会。"
                },
                {
                    "id": "761010104",
                    "speaker": "Player",
                    "text": "你也辛苦了。"
                },
                {
                    "id": "761010105",
                    "speaker": "叶洛亚",
                    "text": "我做的这些实在不算什么。而且，如果没有你们的协助，即使最终能够获胜，恐怕也会付出更多的牺牲…"
                },
                {
                    "id": "761010106",
                    "speaker": "派蒙",
                    "text": "我们可是你的队员呢！就不要说这种见外的话啦。"
                },
                {
                    "id": "761010107",
                    "speaker": "叶洛亚",
                    "text": "嗯，说得也是。啊，老爷子准备发言了。"
                },
                {
                    "id": "761010108",
                    "speaker": "尼基塔",
                    "text": "各位战友，各位兄弟姐妹，今天我们汇聚一堂，不是为了单纯的欢庆，而是为了纪念这场来之不易的胜利。"
                },
                {
                    "id": "761010109",
                    "speaker": "尼基塔",
                    "text": "在我们举杯之时，不要忘记那些再也无法与我们举杯同庆的人，他们以血肉为代价，兑现了誓言。"
                },
                {
                    "id": "761010110",
                    "speaker": "尼基塔",
                    "text": "在此次的战役中，叶洛亚率领的「魇夜之莺」调查分队承担了最为艰巨的任务…"
                },
                {
                    "id": "761010111",
                    "speaker": "尼基塔",
                    "text": "#尤其是{NICKNAME}两位，在这危难之际仍义无反顾加入我们，在作战中发挥了不容忽视的作用。"
                },
                {
                    "id": "761010112",
                    "speaker": "尼基塔",
                    "text": "他们不畏牺牲，迎难而上，从危难中为我们开拓了通向胜利的道路。"
                },
                {
                    "id": "761010113",
                    "speaker": "尼基塔",
                    "text": "他们的功绩，所有为了生者和未来而奋斗的人的功绩，都将被永远铭刻于历史之中。"
                },
                {
                    "id": "761010114",
                    "speaker": "尼基塔",
                    "text": "是的，我们胜利了！尽管付出了巨大的代价。我们可以流泪，可以哀悼，但绝不能被悲痛击垮。"
                },
                {
                    "id": "761010115",
                    "speaker": "尼基塔",
                    "text": "因为我们所为之奋斗的「未来」将要到来，为了让火种传递，为了让引路的明灯继续照耀，我们还不能停下脚步。"
                },
                {
                    "id": "761010116",
                    "speaker": "尼基塔",
                    "text": "但是，只在今日，让我们为了胜利，为了英勇不朽的战友们，也为了未来，干杯吧！"
                }
            ]
        },
        {
            "id": "7610102",
            "objective": "与执灯人对话",
            "dialogues": [
                {
                    "id": "761010201",
                    "speaker": "奥拉维",
                    "text": "叶洛亚！你可算回来了，尼基塔执灯长正等你呢！"
                },
                {
                    "id": "761010202",
                    "speaker": "派蒙",
                    "text": "欸？尼基塔…执灯长？"
                },
                {
                    "id": "761010203",
                    "speaker": "派蒙",
                    "text": "#{NICKNAME}，「尼基塔」不就是委托我们去找「银灯芯」的那个老爷爷吗？"
                },
                {
                    "id": "761010204",
                    "speaker": "派蒙",
                    "text": "我记得他明明说自己只是个普通的执灯士…",
                    "choices": [
                        {
                            "id": "761010205",
                            "text": "是啊…",
                            "response": [
                                {
                                    "id": "761010207",
                                    "speaker": "叶洛亚",
                                    "text": "老爷子可真是的…唉，你们就当是他的恶作剧吧。"
                                },
                                {
                                    "id": "761010208",
                                    "speaker": "叶洛亚",
                                    "text": "先不说这些了，我们去向他报告情况吧。"
                                }
                            ]
                        },
                        {
                            "id": "761010206",
                            "text": "不，他怎么看都不像普通执灯士吧…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7610103",
            "objective": "向老爷子报告",
            "dialogues": [
                {
                    "id": "761010301",
                    "speaker": "叶洛亚",
                    "text": "老爷子，我们回来了！"
                },
                {
                    "id": "761010302",
                    "speaker": "尼基塔",
                    "text": "回来就好，苦壑崖的情况怎么样？"
                },
                {
                    "id": "761010303",
                    "speaker": "Black Screen",
                    "text": "简明扼要地说明了情况…"
                },
                {
                    "id": "761010304",
                    "speaker": "尼基塔",
                    "text": "果然如此啊…从这里也能清楚地观测到，厄布拉神柱完全被深渊力量…被那不死的妖魔「教授」给控制了。"
                },
                {
                    "id": "761010305",
                    "speaker": "尼基塔",
                    "text": "但它目前还没有太大的动作，想来是那位爱莉厄小姐在全力与之抗衡。"
                },
                {
                    "id": "761010306",
                    "speaker": "尼基塔",
                    "text": "她为我们争取来的难能可贵的时间，一点也不能浪费。"
                },
                {
                    "id": "761010307",
                    "speaker": "尼基塔",
                    "text": "所幸在菲林斯和大家的帮助下，准备工作已经完成得差不多了。"
                },
                {
                    "id": "761010308",
                    "speaker": "尼基塔",
                    "text": "有了你们带回来的「螺旋剑」，「德肋庇革劳诺之箭」也就成型了。"
                },
                {
                    "id": "761010309",
                    "speaker": "派蒙",
                    "text": "呃…「德肋庇革劳诺之箭」是什么？是跟「银灯芯」、「螺旋剑」一样厉害的圣物吗？"
                },
                {
                    "id": "761010310",
                    "speaker": "尼基塔",
                    "text": "哈哈，是比它们更厉害的东西。"
                },
                {
                    "id": "761010311",
                    "speaker": "尼基塔",
                    "text": "五百年前，铸灯者力有未逮，只将那不死的妖魔封印于苦壑崖之下。但在那之后，铸灯者和初代咏月使也并未放弃。"
                },
                {
                    "id": "761010312",
                    "speaker": "尼基塔",
                    "text": "为了在未来的某一天，彻底终结那不死的妖魔，他们用古老的技术打造了这把「弓矢」，由我们执灯人代代守护至今。"
                },
                {
                    "id": "761010313",
                    "speaker": "尼基塔",
                    "text": "现在终于到了让它完成使命的时刻。"
                },
                {
                    "id": "761010314",
                    "speaker": "派蒙",
                    "text": "哦…居然有这么厉害的箭，真想看看…它长什么样子呀？"
                },
                {
                    "id": "761010315",
                    "speaker": "尼基塔",
                    "text": "傻孩子，你们早就见过了，不如说，我们就在「德肋庇革劳诺之箭」里。",
                    "choices": [
                        {
                            "id": "761010316",
                            "text": "啊？",
                            "response": [
                                {
                                    "id": "761010317",
                                    "speaker": "派蒙",
                                    "text": "难、难道是要把我们一起发射出去…怎么想都不可能吧！"
                                },
                                {
                                    "id": "761010320",
                                    "speaker": "尼基塔",
                                    "text": "这座麦酒大厅就是围绕「德肋庇革劳诺之箭」建造的，而你们带回的「螺旋剑」，正是它所缺失的箭头。"
                                },
                                {
                                    "id": "761010321",
                                    "speaker": "尼基塔",
                                    "text": "只要将「螺旋剑」装填进这里，就能让「德肋庇革劳诺之箭」进入发射准备了。"
                                },
                                {
                                    "id": "761010322",
                                    "speaker": "派蒙",
                                    "text": "可这不是壁炉吗？"
                                },
                                {
                                    "id": "761010323",
                                    "speaker": "叶洛亚",
                                    "text": "是壁炉，也是让「螺旋剑」化为「箭镞」的特殊装置。"
                                },
                                {
                                    "id": "761010324",
                                    "speaker": "尼基塔",
                                    "text": "趁那「恶卵」尚未孵化…用这传承至今的「弓矢」，将它彻底葬送吧！"
                                },
                                {
                                    "id": "761010325",
                                    "speaker": "尼基塔",
                                    "text": "在此期间，想必那不死的妖魔还会垂死挣扎吧，不管它送来多少爪牙，我们一定会替你们拦下。"
                                },
                                {
                                    "id": "761010326",
                                    "speaker": "尼基塔",
                                    "text": "发射「德肋庇革劳诺之箭」的重任，就交给你们了。"
                                }
                            ]
                        },
                        {
                            "id": "761010318",
                            "text": "是要把我也发射出去吗？",
                            "response": [
                                {
                                    "id": "761010319",
                                    "speaker": "派蒙",
                                    "text": "#原来{NICKNAME}就是我们的最终决战兵器！…才不是吧！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
