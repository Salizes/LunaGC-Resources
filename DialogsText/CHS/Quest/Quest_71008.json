        {
            "id": "7100805",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "710080501",
                    "speaker": "小姜",
                    "text": "#嘿嘿，怎么样，{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，你果然找不到我吧。"
                },
                {
                    "id": "710080502",
                    "speaker": "小姜",
                    "text": "#唔，既然是第一次玩，我给{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}一点提示好了。"
                },
                {
                    "id": "710080503",
                    "speaker": "小姜",
                    "text": "我就藏在<color=#00E1FFFF>石头后面</color>喔，嘿嘿，仔细找找吧。要继续吗？"
                }
            ]
        },
        {
            "id": "7100806",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "710080601",
                    "speaker": "小姜",
                    "text": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}还是没找到吗？"
                },
                {
                    "id": "710080602",
                    "speaker": "小姜",
                    "text": "#我果然藏得不错啊，唔…那我给{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}降低点难度吧。"
                },
                {
                    "id": "710080603",
                    "speaker": "小姜",
                    "text": "#我就藏在<color=#00E1FFFF>北边</color>喔，具体是哪里，{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}就自己去找吧。要继续吗？"
                }
            ]
        },
        {
            "id": "7100807",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "710080701",
                    "speaker": "小姜",
                    "text": "#我藏得有这么好吗…嗯…好吧，老是找不到，{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}也玩得没意思了。"
                },
                {
                    "id": "710080702",
                    "speaker": "小姜",
                    "text": "我就藏在<color=#00E1FFFF>北边的一块大石头</color>周围。"
                },
