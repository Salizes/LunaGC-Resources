            "objective": "（test）祭拜$HIDDEN",
            "dialogues": [
                {
                    "id": "710083301",
                    "speaker": "Player",
                    "text": "我先休息一下。"
                }
            ]
        },
        {
            "id": "7100837",
            "objective": "与小姜对话",
            "dialogues": [
                {
                    "id": "710083901",
                    "speaker": "小姜",
                    "text": "（test）好像有人会带我来这里看看呢"
                },
                {
                    "id": "710083902",
                    "speaker": "小姜",
                    "text": "（test）他们会哭，也会做奇怪的动作，烧奇怪的东西"
                },
                {
                    "id": "710083903",
                    "speaker": "小姜",
                    "text": "（test）我不懂，也只能在这里看看"
                },
                {
                    "id": "710083904",
                    "speaker": "小姜",
                    "text": "（test）我累了，要去那边休息一下"
                }
            ]
        },
