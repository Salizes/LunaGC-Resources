        {
            "id": "7115208",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "711520802",
                    "speaker": "九条裟罗",
                    "text": "很不错的画片，用来作纪念再合适不过了。"
                },
                {
                    "id": "711520803",
                    "speaker": "九条裟罗",
                    "text": "#谢谢，{NICKNAME}，我会把它作为私人物品，好好保存的。",
                    "choices": [
                        {
                            "id": "711520801",
                            "text": "关于我刚放的霄灯…",
                            "response": [
                                {
                                    "id": "711520804",
                                    "speaker": "九条裟罗",
                                    "text": "嗯。我看见了，稍后我也会去买几盏霄灯带回稻妻。挂在天领奉行的门口，应该也会很好看的。"
                                },
                                {
                                    "id": "711520805",
                                    "speaker": "九条裟罗",
                                    "text": "有鹿野院同心在，想必贼匪也不敢对这几盏霄灯有贪念。"
                                }
                            ]
                        },
                        {
                            "id": "711520806",
                            "text": "再见，海灯节快乐。",
                            "response": [
                                {
                                    "id": "711520807",
                                    "speaker": "九条裟罗",
                                    "text": "多谢，也祝你节日愉快…但我多问一句，往常的海灯节里，千岩军们也是如此严格值守的么？"
                                },
                                {
                                    "id": "711520808",
                                    "speaker": "九条裟罗",
                                    "text": "在节日期间，他们的纪律也能如此严明，实在让人佩服。"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
