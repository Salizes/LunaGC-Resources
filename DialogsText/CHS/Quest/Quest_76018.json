    "talks": [
        {
            "id": "7601801",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "760180101",
                    "speaker": "派蒙",
                    "text": "完全瘫倒在地了呢…看上去像是被摔在地上的落落莓果冻。刚才路过的时候，差点没有发现。"
                },
                {
                    "id": "760180102",
                    "speaker": "派蒙",
                    "text": "好像对我们的到来完全没有反应，是睡着了吗？"
                },
                {
                    "id": "760180103",
                    "speaker": "Player",
                    "text": "水母没有大脑，好像不太需要睡眠？"
                },
                {
                    "id": "760180104",
                    "speaker": "派蒙",
                    "text": "欸？！没、没有大脑…竟然存在这样的生物。"
                },
                {
                    "id": "760180105",
                    "speaker": "派蒙",
                    "text": "不过即便没有大脑，好像也能感受到痛苦…它看起来很不舒服的样子。"
                },
                {
                    "id": "760180106",
                    "speaker": "派蒙",
                    "text": "我们快把这里的屏障打开，确认一下它是不是还好吧！不过，这个装置要怎么才能打开呢？",
                    "choices": [
                        {
                            "id": "760180107",
                            "text": "看来需要好用的大脑，那只有我了。",
                            "response": [
                                {
                                    "id": "760180108",
                                    "speaker": "派蒙",
                                    "text": "嗯？怎么说得好像我大脑空空一样…"
                                },
                                {
                                    "id": "760180110",
                                    "speaker": "派蒙",
                                    "text": "#哼，我只是不擅长解开机关这种事而已。要是找好吃的…{NICKNAME}肯定比不过我的！"
                                }
                            ]
                        },
                        {
                            "id": "760180109",
                            "text": "真是果冻的话，派蒙就有办法了吧？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7601802",
            "objective": "解救瘫倒的水母",
            "dialogues": [
                {
                    "id": "760180201",
                    "speaker": "派蒙",
                    "text": "没、没能赶上…唔，落落莓果冻是在悼念同伴吗？"
                },
                {
                    "id": "760180202",
                    "speaker": "「落落莓果冻」",
                    "text": "……"
                },
                {
                    "id": "760180203",
                    "speaker": "派蒙",
                    "text": "水母真的是没有思考能力的生物吗？它明明看上去很难过的样子…"
                },
                {
                    "id": "760180204",
                    "speaker": "Player",
                    "text": "或许，拥有这种情绪并不需要思考。"
                },
                {
                    "id": "760180205",
                    "speaker": "派蒙",
                    "text": "#{NICKNAME}说得对，难过的时候并不是靠思考就能停下来的。"
                },
                {
                    "id": "760180206",
                    "speaker": "派蒙",
                    "text": "也许，这样的感情…是从我们心里很深很深的地方，自己浮现出来的吧。"
                },
                {
                    "id": "760180207",
                    "speaker": "「落落莓果冻」",
                    "text": "……"
                },
                {
                    "id": "760180208",
                    "speaker": "派蒙",
                    "text": "很难过么…不会哭、不会说话、甚至都叫不出声…还真是令人担心呢。有什么是我们能为你做的吗？"
                },
                {
                    "id": "760180209",
                    "speaker": "Player",
                    "text": "说不定还有别的水母被困。"
                },
                {
                    "id": "760180210",
                    "speaker": "派蒙",
                    "text": "对、对哦，这么多水母都倒下了…也就是说，那些愚人众根本不在乎它们会变成什么样子！"
                },
                {
                    "id": "760180211",
                    "speaker": "派蒙",
                    "text": "这个基地那么大，肯定会有很多像刚才那样的坏机器。那么被困住的肯定不止落落莓果冻一只。"
                },
                {
                    "id": "760180212",
                    "speaker": "派蒙",
                    "text": "我们一起去把它们都找出来吧！"
                },
                {
                    "id": "760180213",
                    "speaker": "「落落莓果冻」",
                    "text": "……"
                }
            ]
        },
        {
            "id": "7601803",
            "objective": "与派蒙对话$HIDDEN",
            "dialogues": [
                {
                    "id": "760180301",
                    "speaker": "派蒙",
                    "text": "真的就把钥匙放在了门边…这里的愚人众好像挺笨的呢。",
                    "choices": [
                        {
                            "id": "760180302",
                            "text": "既然是敌人，笨笨的也不错。",
                            "response": [
                                {
                                    "id": "760180303",
                                    "speaker": "派蒙",
                                    "text": "对哦，要是遇到聪明又认真的家伙，我们找起钥匙来可就费劲了！"
                                },
                                {
                                    "id": "760180304",
                                    "speaker": "派蒙",
                                    "text": "那只水母…唔，不如就叫它「落落莓果冻」好了！说不定就来不及获救了…"
                                },
                                {
                                    "id": "760180308",
                                    "speaker": "派蒙",
                                    "text": "话说回来，现在屏障都已经打开了，它怎么还是不动呢？"
                                },
                                {
                                    "id": "760180309",
                                    "speaker": "Black Screen",
                                    "text": "被解救的水母挣扎着想要游动起来，却还是无力地瘫倒在地…"
                                },
                                {
                                    "id": "760180310",
                                    "speaker": "「落落莓果冻」",
                                    "text": "……"
                                },
                                {
                                    "id": "760180311",
                                    "speaker": "派蒙",
                                    "text": "怎、怎么还是很痛苦的样子…难道不光是因为被困住了吗？"
                                },
                                {
                                    "id": "760180312",
                                    "speaker": "Player",
                                    "text": "可能是由于这里的月矩力很稀薄。"
                                },
                                {
                                    "id": "760180313",
                                    "speaker": "派蒙",
                                    "text": "#{NICKNAME}感受不到足够的月矩力吗…"
                                },
                                {
                                    "id": "760180314",
                                    "speaker": "派蒙",
                                    "text": "#我们刚来到挪德卡莱的时候，{NICKNAME}就一直能感受到月矩力的存在。"
                                },
                                {
                                    "id": "760180315",
                                    "speaker": "派蒙",
                                    "text": "是不是因为这里的环境突然变了，它才这么不舒服的？"
                                },
                                {
                                    "id": "760180316",
                                    "speaker": "「落落莓果冻」",
                                    "text": "……"
                                },
                                {
                                    "id": "760180317",
                                    "speaker": "派蒙",
                                    "text": "再坚持一下，一定会救你出去的，我们来想办法！"
                                },
                                {
                                    "id": "760180318",
                                    "speaker": "派蒙",
                                    "text": "#{NICKNAME}，快想想办法吧！",
                                    "choices": [
                                        {
                                            "id": "760180319",
                                            "text": "遇到要动脑筋立刻就放弃了…",
                                            "response": [
                                                {
                                                    "id": "760180320",
                                                    "speaker": "派蒙",
                                                    "text": "那、那是因为情况紧急嘛，再这样下去感觉这个小家伙会坚持不住的！"
                                                },
                                                {
                                                    "id": "760180322",
                                                    "speaker": "派蒙",
                                                    "text": "一定是因为愚人众在这儿建了乱七八糟的坏机器，所以这里的环境才出了问题的。把它们通通关掉吧！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "760180321",
                                            "text": "嗯，派蒙不会的事当然只有我来了。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "760180305",
                            "text": "派蒙的头脑比愚人众还要灵光耶！",
                            "response": [
                                {
                                    "id": "760180306",
                                    "speaker": "派蒙",
                                    "text": "怎么听都不像是在好好夸我的样子…"
                                },
                                {
                                    "id": "760180307",
                                    "speaker": "派蒙",
                                    "text": "要不是我一开始发现了这滩落落莓果冻…嗯，不如就叫它这个名字好了！我们大概已经错过救援的机会了吧？"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7601819",
            "objective": "关闭愚人众的机器",
            "dialogues": []
        },
        {
            "id": "7601820",
            "objective": "跟随水母",
            "dialogues": [
                {
                    "id": "760180501",
                    "speaker": "派蒙",
                    "text": "哇，「落落莓果冻」飞起来了！这才应该是你平时的样子吧？果然是因为那些坏机器的关系！"
                },
                {
                    "id": "760180502",
                    "speaker": "派蒙",
                    "text": "小家伙是要带我们到那里去吗？我们跟过去看看吧。"
                }
            ]
        },
        {
            "id": "7601821",
            "objective": "跟随水母",
            "dialogues": []
        },
        {
            "id": "7601818",
            "objective": "跟随水母",
            "dialogues": [
                {
                    "id": "760180601",
                    "speaker": "派蒙",
                    "text": "「落落莓果冻」钻到了大壳子里…下面的沙堆好像埋着什么东西，是你要答谢我们的礼物吗？"
                },
                {
                    "id": "760180602",
                    "speaker": "「落落莓果冻」",
                    "text": "……"
                },
                {
                    "id": "760180603",
                    "speaker": "派蒙",
                    "text": "真的是礼物欸，我就知道是这样。「落落莓果冻」很懂礼貌嘛！",
                    "choices": [
                        {
                            "id": "760180604",
                            "text": "已经可以无障碍交流了呢。",
                            "response": [
                                {
                                    "id": "760180605",
                                    "speaker": "派蒙",
                                    "text": "因为「落落莓果冻」和我都是心思单纯的好孩子，所以才可以实现不需要语言的交流。"
                                },
                                {
                                    "id": "760180608",
                                    "speaker": "派蒙",
                                    "text": "「感谢你们救了我！这片沙滩埋藏着数不清的宝物，请不要客气，通通收下吧！」它一定是想这样说。"
                                },
                                {
                                    "id": "760180609",
                                    "speaker": "「落落莓果冻」",
                                    "text": "……",
                                    "choices": [
                                        {
                                            "id": "760180610",
                                            "text": "姑且只能相信派蒙的水母语了。",
                                            "response": [
                                                {
                                                    "id": "760180611",
                                                    "speaker": "派蒙",
                                                    "text": "水母语是什么啦…都说了不需要通过语言就可以表达！这种事，你当然只能相信我了。"
                                                },
                                                {
                                                    "id": "760180613",
                                                    "speaker": "派蒙",
                                                    "text": "那「落落莓果冻」就在这里稍微休息一下好了！我们来看看沙堆底下到底埋着什么好东西吧。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "760180612",
                                            "text": "既然「落落莓果冻」都这样说了。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "760180606",
                            "text": "想知道不通过语言是怎么沟通的？",
                            "response": [
                                {
                                    "id": "760180607",
                                    "speaker": "派蒙",
                                    "text": "说明你的想法太复杂啦。如果是「落落莓果冻」和我这样心思单纯的好孩子，不需要语言也可以沟通好的。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7601804",
            "objective": "(test)废弃",
            "dialogues": [
                {
                    "id": "760180401",
                    "speaker": "派蒙",
                    "text": "果然还有被困住的水母，它的状态也很糟糕，得赶紧把它救出来才行！"
                }
            ]
        },
        {
            "id": "7601805",
            "objective": "查看附近的沙堆",
            "dialogues": []
        },
        {
