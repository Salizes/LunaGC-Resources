    "talks": [
        {
            "id": "7265101",
            "objective": "",
            "dialogues": [
                {
                    "id": "726510101",
                    "speaker": "乌尔曼",
                    "text": "唉，难道我真是什么「吸引仙灵体质」…"
                },
                {
                    "id": "726510102",
                    "speaker": "乌尔曼",
                    "text": "你…旅行者？你怎么也在这？",
                    "choices": [
                        {
                            "id": "726510103",
                            "text": "你是谁？",
                            "response": [
                                {
                                    "id": "726510104",
                                    "speaker": "乌尔曼",
                                    "text": "我啊！乌尔曼，我俩不是还合作寻过宝吗？"
                                },
                                {
                                    "id": "726510105",
                                    "speaker": "乌尔曼",
                                    "text": "哎呀，「寻宝仙灵」！记起来了吗？"
                                },
                                {
                                    "id": "726510108",
                                    "speaker": "Player",
                                    "text": "你怎么来稻妻了？"
                                },
                                {
                                    "id": "726510109",
                                    "speaker": "乌尔曼",
                                    "text": "咳…上次我俩合作的时候，你不是帮我找到了那么多铁钱吗？"
                                },
                                {
                                    "id": "726510110",
                                    "speaker": "乌尔曼",
                                    "text": "我把那些铁钱倒腾了倒腾，赚了不少摩拉，嘿嘿，还是得多谢你啦。"
                                },
                                {
                                    "id": "726510111",
                                    "speaker": "乌尔曼",
                                    "text": "不过你也知道，这年头花钱的地方多，那么些摩拉也不经花…"
                                },
                                {
                                    "id": "726510112",
                                    "speaker": "乌尔曼",
                                    "text": "但我没了「寻宝仙灵」，也没你帮忙，铁钱肯定是没法找了。"
                                },
                                {
                                    "id": "726510113",
                                    "speaker": "乌尔曼",
                                    "text": "所以，我就想要找另外的方法赚钱…"
                                },
                                {
                                    "id": "726510114",
                                    "speaker": "乌尔曼",
                                    "text": "我听某位…呃…前同事说，稻妻这边遍地宝藏，就想要来碰碰运气。"
                                },
                                {
                                    "id": "726510115",
                                    "speaker": "Player",
                                    "text": "你知道稻妻锁着国的吧…"
                                },
                                {
                                    "id": "726510116",
                                    "speaker": "乌尔曼",
                                    "text": "那我当然知道，但是嘛…嘿嘿，我有自己的门路。"
                                },
                                {
                                    "id": "726510117",
                                    "speaker": "乌尔曼",
                                    "text": "我和我的某些「好朋友」友好沟通，并且付出了一点点小代价之后，弄到了一艘船，准备开船来稻妻。"
                                },
                                {
                                    "id": "726510118",
                                    "speaker": "乌尔曼",
                                    "text": "但是，唉…但是我越接近稻妻，天气就越怪，又是打雷，又是风暴…"
                                },
                                {
                                    "id": "726510119",
                                    "speaker": "乌尔曼",
                                    "text": "然后，突然一道雷正巧劈在我的船上，船毁了，我也掉进了海里。"
                                },
                                {
                                    "id": "726510120",
                                    "speaker": "乌尔曼",
                                    "text": "几个浪头拍过来，我喝了好几口水，人也晕了过去，再醒来的时候，就在海滩上趴着了。"
                                },
                                {
                                    "id": "726510121",
                                    "speaker": "Player",
                                    "text": "你运气可真好。"
                                },
                                {
                                    "id": "726510122",
                                    "speaker": "乌尔曼",
                                    "text": "哈哈哈，那可不，我运气一向不错。"
                                },
                                {
                                    "id": "726510123",
                                    "speaker": "乌尔曼",
                                    "text": "而且…呃…怎么说呢，我上岸之后四处打探了一下，结果…"
                                },
                                {
                                    "id": "726510124",
                                    "speaker": "乌尔曼",
                                    "text": "结果又遇见了这个小家伙，它还带着我找到了几处宝藏，我想，也许它也是那种「寻宝仙灵」吧…"
                                },
                                {
                                    "id": "726510125",
                                    "speaker": "乌尔曼",
                                    "text": "而且，它也和之前的那家伙一样，寻了几处宝藏之后就歇了，只是一直跟在我身边转来转去…"
                                },
                                {
                                    "id": "726510126",
                                    "speaker": "Player",
                                    "text": "又是这种仙灵…"
                                },
                                {
                                    "id": "726510127",
                                    "speaker": "乌尔曼",
                                    "text": "我也不知道为什么，难道我是什么「吸引仙灵体质」？"
                                },
                                {
                                    "id": "726510128",
                                    "speaker": "乌尔曼",
                                    "text": "或者说，是我身上有什么特别的东西吸引它？我是弄不清楚…"
                                },
                                {
                                    "id": "726510129",
                                    "speaker": "乌尔曼",
                                    "text": "但总之，既然来了稻妻，那我可不能白来。"
                                },
                                {
                                    "id": "726510130",
                                    "speaker": "乌尔曼",
                                    "text": "根据我的打探，周围还颇有些宝藏，我都记在我的这个手册上了。"
                                },
                                {
                                    "id": "726510131",
                                    "speaker": "乌尔曼",
                                    "text": "但这小家伙似乎又提不起干劲了，就凭我找这些宝藏可是有点费劲…"
                                },
                                {
                                    "id": "726510132",
                                    "speaker": "乌尔曼",
                                    "text": "旅行者，如果你有兴趣的话，那就再和我合作合作吧，你的那个「寻宝仙灵」，应该还愿意干活吧。"
                                },
                                {
                                    "id": "726510133",
                                    "speaker": "乌尔曼",
                                    "text": "还是上次的规矩，宝藏点我给你标好，你帮我去找到这些宝藏，里面的宝贝都归你，我分文不取。"
                                },
                                {
                                    "id": "726510134",
                                    "speaker": "乌尔曼",
                                    "text": "但如果你找到了「铁钱」的话，就带来给我吧，嘿嘿，我会出个好价钱的。"
                                },
                                {
                                    "id": "726510135",
                                    "speaker": "Player",
                                    "text": "希望真是个好价钱。"
                                },
                                {
                                    "id": "726510136",
                                    "speaker": "乌尔曼",
                                    "text": "那当然了，你和我都合作过了，就放心相信我吧。"
                                },
                                {
                                    "id": "726510137",
                                    "speaker": "乌尔曼",
                                    "text": "这本手册给你，祝你寻宝愉快，也祝咱们合作愉快。"
                                }
                            ]
                        },
                        {
                            "id": "726510106",
                            "text": "你是那个「寻宝仙灵」的…",
                            "response": [
                                {
                                    "id": "726510107",
                                    "speaker": "乌尔曼",
                                    "text": "对，就是我，乌尔曼。我俩不是还合作寻过宝吗？"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7265102",
            "objective": "与乌尔曼对话",
            "dialogues": []
        },
        {
            "id": "7265102",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "726510201",
                    "speaker": "乌尔曼",
                    "text": "唉，难道我真是什么「吸引仙灵体质」…"
                },
                {
                    "id": "726510202",
                    "speaker": "Player",
                    "text": "什么「吸引仙灵体质」？"
                },
                {
                    "id": "726510203",
                    "speaker": "乌尔曼",
                    "text": "你是…旅行者？哎呀，你来得正好。"
                },
                {
                    "id": "726510204",
                    "speaker": "乌尔曼",
                    "text": "我有一桩大生意，好生意！能赚到成吨的摩拉，不知道你有没有兴趣…",
                    "choices": [
                        {
                            "id": "726510205",
                            "text": "那你自己为什么不去做？",
                            "response": [
                                {
                                    "id": "726510207",
                                    "speaker": "乌尔曼",
                                    "text": "你别这么警惕嘛，你看，我就是个想来稻妻发一笔财的普通人。"
                                },
                                {
                                    "id": "726510208",
                                    "speaker": "乌尔曼",
                                    "text": "稻妻不是锁着国嘛，我就找几位好朋友想了想办法，弄了一艘小船，准备渡海来稻妻…"
                                },
                                {
                                    "id": "726510209",
                                    "speaker": "乌尔曼",
                                    "text": "但是，唉…但是我越接近稻妻，天气就越怪，又是打雷，又是风暴…"
                                },
                                {
                                    "id": "726510210",
                                    "speaker": "乌尔曼",
                                    "text": "然后，突然一道雷正巧劈在我的船上，船毁了，我也掉进了海里。"
                                },
                                {
                                    "id": "726510211",
                                    "speaker": "乌尔曼",
                                    "text": "几个浪头拍过来，我喝了好几口水，人也晕了过去，再醒来的时候，就在海滩上趴着了。"
                                },
                                {
                                    "id": "726510212",
                                    "speaker": "Player",
                                    "text": "你运气可真好。"
                                },
                                {
                                    "id": "726510213",
                                    "speaker": "乌尔曼",
                                    "text": "哈哈哈，那可不，我运气一向不错。"
                                },
                                {
                                    "id": "726510214",
                                    "speaker": "乌尔曼",
                                    "text": "而且…呃…怎么说呢，我上岸之后四处打探了一下，结果…"
                                },
                                {
                                    "id": "726510215",
                                    "speaker": "乌尔曼",
                                    "text": "就遇见了这小家伙。"
                                },
                                {
                                    "id": "726510216",
                                    "speaker": "Player",
                                    "text": "仙、仙灵？"
                                },
                                {
                                    "id": "726510217",
                                    "speaker": "乌尔曼",
                                    "text": "准确地来说，它叫做「寻宝仙灵」。顾名思义，就是那种能带着人找到宝藏的好伙伴。"
                                },
                                {
                                    "id": "726510218",
                                    "speaker": "乌尔曼",
                                    "text": "但是不知道为什么，它带着我去寻了几处宝藏之后，突然就罢工了，只是一直跟在我身边转来转去…"
                                },
                                {
                                    "id": "726510219",
                                    "speaker": "乌尔曼",
                                    "text": "我寻思，它也许是觉得我挖宝贝的速度太慢，想要换个合作伙伴了。"
                                },
                                {
                                    "id": "726510220",
                                    "speaker": "乌尔曼",
                                    "text": "旅行者，如果你有兴趣的话，你愿意来当这个合作寻宝的伙伴吗？"
                                },
                                {
                                    "id": "726510221",
                                    "speaker": "Player",
                                    "text": "我不擅长和仙灵交流…"
                                },
                                {
                                    "id": "726510222",
                                    "speaker": "乌尔曼",
                                    "text": "哈哈哈，没事没事，这小家伙好像还挺喜欢你的，你看它蹦跶得多欢…"
                                },
                                {
                                    "id": "726510223",
                                    "speaker": "乌尔曼",
                                    "text": "咳！不说这个，总之，你想试试和这小家伙合作吗？",
                                    "choices": [
                                        {
                                            "id": "726510224",
                                            "text": "我试试吧。",
                                            "response": [
                                                {
                                                    "id": "726510226",
                                                    "speaker": "乌尔曼",
                                                    "text": "那太好了，我俩…不，我们三个，从现在开始就是合作关系了。"
                                                },
                                                {
                                                    "id": "726510227",
                                                    "speaker": "乌尔曼",
                                                    "text": "这个本子你收好，这上面标记的地方都是可能埋有宝藏的地方。"
                                                },
                                                {
                                                    "id": "726510228",
                                                    "speaker": "乌尔曼",
                                                    "text": "没有「寻宝仙灵」帮忙，我是绝对找不到那些宝藏的…所以，就交给你了，旅行者。",
                                                    "choices": [
                                                        {
                                                            "id": "726510229",
                                                            "text": "找到宝藏后归谁？",
                                                            "response": [
                                                                {
                                                                    "id": "726510230",
                                                                    "speaker": "乌尔曼",
                                                                    "text": "这个嘛…找到宝藏后，里面的宝贝都归你，我分文不取。"
                                                                },
                                                                {
                                                                    "id": "726510233",
                                                                    "speaker": "乌尔曼",
                                                                    "text": "但是你在挖宝藏的时候，也许有时候会发现「铁钱」…"
                                                                },
                                                                {
                                                                    "id": "726510234",
                                                                    "speaker": "乌尔曼",
                                                                    "text": "如果你发现了「铁钱」的话，可以把这种古代钱币带来给我。"
                                                                },
                                                                {
                                                                    "id": "726510235",
                                                                    "speaker": "乌尔曼",
                                                                    "text": "虽然一般的商人不会收这种东西，但我会出一个好价钱收购它们的。"
                                                                },
                                                                {
                                                                    "id": "726510236",
                                                                    "speaker": "乌尔曼",
                                                                    "text": "那么，这个本子你拿好，带上那个小家伙。"
                                                                },
                                                                {
                                                                    "id": "726510237",
                                                                    "speaker": "乌尔曼",
                                                                    "text": "祝你寻宝愉快，同时嘛…也祝咱们合作愉快。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "726510231",
                                                            "text": "那些宝藏，你我五五开。",
                                                            "response": [
                                                                {
                                                                    "id": "726510232",
                                                                    "speaker": "乌尔曼",
                                                                    "text": "哟，没想到你还懂点规矩…咳，不过这些宝藏我就不拿了。"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "726510225",
                                            "text": "希望它能喜欢我…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "726510206",
                            "text": "听起来就很可疑。"
                        }
                    ]
                }
            ]
        }
    ]
}