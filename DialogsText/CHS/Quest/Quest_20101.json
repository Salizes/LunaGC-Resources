            ]
        },
        {
            "id": "2010127",
            "objective": "(test)对NPC3贿赂$HIDDEN",
            "dialogues": [
                {
                    "id": "201012701",
                    "speaker": "Player",
                    "text": "（欺骗对话内容）我们是蒙冬友爱协会的成员"
                },
                {
                    "id": "201012799",
                    "speaker": "Player",
                    "text": "我们代表协会会来犒劳你们，不过要先找到你们队长「沟通」下。"
                },
                {
                    "id": "201012702",
                    "speaker": "派蒙",
                    "text": "你怎么看出来我愿意帮助你们？",
                    "choices": [
                        {
                            "id": "201012703",
                            "text": "有钱能使鬼推磨呵。",
                            "response": [
                                {
                                    "id": "201012704",
                                    "speaker": "派蒙",
                                    "text": "什么？！"
                                },
                                {
                                    "id": "201012709",
                                    "speaker": "派蒙",
                                    "text": "我可以帮助你们，不过队长同意后，我需要2000摩拉的犒赏金。",
                                    "choices": [
                                        {
                                            "id": "201012710",
                                            "text": "全都给你。",
                                            "response": [
                                                {
                                                    "id": "201012711",
                                                    "speaker": "派蒙",
                                                    "text": "听上去值得考虑…"
                                                },
                                                {
                                                    "id": "201012716",
                                                    "speaker": "派蒙",
                                                    "text": "唔，唔唔…"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "201012712",
                                            "text": "1500摩拉可以么？",
                                            "response": [
                                                {
                                                    "id": "201012713",
                                                    "speaker": "派蒙",
                                                    "text": "什么？"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "201012714",
                                            "text": "分期贷款可以吗？",
                                            "response": [
                                                {
                                                    "id": "201012715",
                                                    "speaker": "派蒙",
                                                    "text": "你在耍我吗？！"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "201012705",
                            "text": "适当的礼物是沟通的基础。",
                            "response": [
                                {
                                    "id": "201012706",
                                    "speaker": "派蒙",
                                    "text": "这样的话，也不错…"
                                }
                            ]
                        },
                        {
                            "id": "201012707",
                            "text": "长的一副贪婪模样。",
                            "response": [
                                {
                                    "id": "201012708",
                                    "speaker": "派蒙",
                                    "text": "岂有此理…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
