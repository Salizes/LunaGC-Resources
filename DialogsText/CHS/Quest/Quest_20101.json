        },
        {
            "id": "2010101",
            "objective": "进入愚人众的藏身地",
            "dialogues": []
        },
        {
            "id": "2010102",
            "objective": "盘问守卫以获得线索",
            "dialogues": []
        },
        {
            "id": "2010103",
            "objective": "盘问守卫以获得线索",
            "dialogues": [
                {
                    "id": "201010301",
                    "speaker": "「愚人众」守卫",
                    "text": "哇啊…不要吃我！——呃，你们…是人类？"
                },
                {
                    "id": "201010302",
                    "speaker": "「愚人众」守卫",
                    "text": "一整层的防御…都被突破了…我还以为是「深渊教团」的怪物攻来了…",
                    "choices": [
                        {
                            "id": "201010303",
                            "text": "我们是来取天空之琴的。",
                            "response": [
                                {
                                    "id": "201010304",
                                    "speaker": "「愚人众」守卫",
                                    "text": "你，你们怎么知道「天空之琴」在这里…"
                                },
                                {
                                    "id": "201010309",
                                    "speaker": "「愚人众」守卫",
                                    "text": "存放圣物的地方是上锁的，你们要找钥匙的话…往前走吧，不要找我！"
                                },
                                {
                                    "id": "201010310",
                                    "speaker": "「愚人众」守卫",
                                    "text": "钥匙不知道是在哪位先遣队员手里…但总之你可以去房间里找他们。"
                                },
                                {
                                    "id": "201010311",
                                    "speaker": "派蒙",
                                    "text": "是个被吓破胆了的人呢。"
                                },
                                {
                                    "id": "201010312",
                                    "speaker": "「愚人众」守卫",
                                    "text": "哼…你，你们好自为之吧！"
                                },
                                {
                                    "id": "201010313",
                                    "speaker": "「愚人众」守卫",
                                    "text": "我们「愚人众」在蒙德…可是有「执行官」坐镇的！"
                                },
                                {
                                    "id": "201010314",
                                    "speaker": "「愚人众」守卫",
                                    "text": "「女士」大人会找到你们，把你们吊起来折磨——到那时可不要连累我啊！"
                                }
                            ]
                        },
                        {
                            "id": "201010305",
                            "text": "我们是来取你性命的。",
                            "response": [
                                {
                                    "id": "201010306",
                                    "speaker": "「愚人众」守卫",
                                    "text": "咿——"
                                },
                                {
                                    "id": "201010307",
                                    "speaker": "「愚人众」守卫",
                                    "text": "不要这样…！我有珍贵的情报要坦白！"
                                },
                                {
                                    "id": "201010308",
                                    "speaker": "「愚人众」守卫",
                                    "text": "其实我们把蒙德的至宝，「天空之琴」，藏在这座遗迹深处。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
