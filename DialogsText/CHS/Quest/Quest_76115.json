    "talks": [
        {
            "id": "7611501",
            "objective": "前往「旗舰」",
            "dialogues": [
                {
                    "id": "761150101",
                    "speaker": "派蒙",
                    "text": "欸？奈芙尔和雅珂达！你们怎么在这里？"
                },
                {
                    "id": "761150102",
                    "speaker": "雅珂达",
                    "text": "当然是为了工作咯。之前一直没有线索的悬赏目标，已经被我们找到啦。"
                },
                {
                    "id": "761150103",
                    "speaker": "Black Screen",
                    "text": "听雅珂达大致介绍了悬赏目标「裂颚」哈尔克，以及此前「秘闻馆」调查到的信息…"
                },
                {
                    "id": "761150104",
                    "speaker": "奈芙尔",
                    "text": "先说结论吧，真正的隐者德文特多半已经遇害，而现在占据了隐者小屋的就是悬赏目标「裂颚」哈尔克。"
                },
                {
                    "id": "761150105",
                    "speaker": "奈芙尔",
                    "text": "雅珂达找到的日志残片也可以作为旁证，德文特在知道一切的情况下依然收留了他。"
                },
                {
                    "id": "761150106",
                    "speaker": "奈芙尔",
                    "text": "毫不意外，哈尔克故态复萌，在了结了德文特之后又窃取了他的身份。"
                },
                {
                    "id": "761150107",
                    "speaker": "雅珂达",
                    "text": "虽然之前去调查的时候没见上面，但小屋里的家伙不管怎么想都不可能是德文特先生。"
                },
                {
                    "id": "761150108",
                    "speaker": "雅珂达",
                    "text": "而且只要自称隐者，就算做些奇怪的事也不会被怀疑。那面罩肯定不是为了修行，而是为了遮盖下巴上的伤疤。"
                },
                {
                    "id": "761150109",
                    "speaker": "奈芙尔",
                    "text": "至于下落不明的游商，做最坏的考虑，可能也已经遇害。"
                },
                {
                    "id": "761150110",
                    "speaker": "派蒙",
                    "text": "做了这么多坏事，还两次恩将仇报，到底是什么样的恶棍啊…"
                },
                {
                    "id": "761150111",
                    "speaker": "奈芙尔",
                    "text": "我推测，「流浪之环」货品失窃案确实与哈尔克无关，作案的动机太薄弱了。"
                },
                {
                    "id": "761150112",
                    "speaker": "奈芙尔",
                    "text": "他在这十年间从未逾矩，失窃货品的价值足以让他放弃辛苦构筑的一切吗？我看未必。"
                },
                {
                    "id": "761150113",
                    "speaker": "奈芙尔",
                    "text": "那么我们不妨做一些假设。"
                },
                {
                    "id": "761150114",
                    "speaker": "奈芙尔",
                    "text": "已知在事发后，他回到阿特拉号的残骸附近，攻击了来寻宝的宝藏猎人。当人身处困境，回归起点便是一种本能。"
                },
                {
                    "id": "761150115",
                    "speaker": "奈芙尔",
                    "text": "当他还在阿特拉号上当舵手时，声名、财富，都不在话下。但加入「流浪之环」后又如何？"
                },
                {
                    "id": "761150116",
                    "speaker": "奈芙尔",
                    "text": "哪怕十年间都循规蹈矩，当窃案发生时，人们依然将怀疑的目光和言语投向他。"
                },
                {
                    "id": "761150117",
                    "speaker": "奈芙尔",
                    "text": "而更让他难以接受的，恐怕是与他出身相同，但过去只是无名之辈的朱亚尼现在反倒如鱼得水。"
                },
                {
                    "id": "761150118",
                    "speaker": "奈芙尔",
                    "text": "即使他当面指控朱亚尼，也无人采信他的说辞。"
                },
                {
                    "id": "761150119",
                    "speaker": "奈芙尔",
                    "text": "被失望和愤怒裹挟，他犯下了第一个错。这次事件，就是他人生的转折点。"
                },
                {
                    "id": "761150120",
                    "speaker": "奈芙尔",
                    "text": "之后在隐者小屋发生的事应该也大同小异…哪怕是微小的矛盾也会引发致命的冲突。"
                },
                {
                    "id": "761150121",
                    "speaker": "派蒙",
                    "text": "#{NICKNAME}，这么危险的家伙，我们也不能放着不管吧？",
                    "choices": [
                        {
                            "id": "761150122",
                            "text": "给我一个除害的机会。",
                            "response": [
                                {
                                    "id": "761150124",
                                    "speaker": "奈芙尔",
                                    "text": "#既然{NICKNAME}主动请缨，那就让雅珂达休息一个回合吧。"
                                },
                                {
                                    "id": "761150125",
                                    "speaker": "雅珂达",
                                    "text": "之前调查我也出了不少力嘛！就当给我放个假。"
                                },
                                {
                                    "id": "761150126",
                                    "speaker": "奈芙尔",
                                    "text": "至于前面所说的假设是否无误，待我们会一会他便知分晓。"
                                }
                            ]
                        },
                        {
                            "id": "761150123",
                            "text": "就算是为了赏金，交给我吧。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7611502",
            "objective": "前往隐者小屋",
            "dialogues": [
                {
                    "id": "761150201",
                    "speaker": "德文特？",
                    "text": "…我没招惹过你们。"
                },
                {
                    "id": "761150202",
                    "speaker": "奈芙尔",
                    "text": "看来你很清楚我们为什么来。"
                },
                {
                    "id": "761150203",
                    "speaker": "德文特？",
                    "text": "…那都是过去的事，现在我只想过平静的生活。"
                },
                {
                    "id": "761150204",
                    "speaker": "奈芙尔",
                    "text": "靠夺取他人的身份吗？先是朱亚尼，但没有成功，之后又是德文特。"
                },
                {
                    "id": "761150205",
                    "speaker": "奈芙尔",
                    "text": "不过拙劣的扮演迟早被揭穿，不会再有下一个受害者了。"
                },
                {
                    "id": "761150206",
                    "speaker": "德文特？",
                    "text": "…朱亚尼？我想要夺取他的身份？"
                },
                {
                    "id": "761150207",
                    "speaker": "德文特？",
                    "text": "那不是他的…那凭什么是他的？就因为他长得更讨人喜欢，说话更会奉承吗？"
                },
                {
                    "id": "761150208",
                    "speaker": "德文特？",
                    "text": "我们明明是一样的！…被他拿走的东西，本来就是属于我的！"
                },
                {
                    "id": "761150209",
                    "speaker": "雅珂达",
                    "text": "那德文特先生和游商呢？他们又对你做了什么？"
                },
                {
                    "id": "761150210",
                    "speaker": "德文特？",
                    "text": "…他们？他们问了不该问的问题，就像你们一样。"
                },
                {
                    "id": "761150211",
                    "speaker": "德文特？",
                    "text": "受死吧！"
                }
            ]
        },
        {
            "id": "7611503",
            "objective": "击败「裂颚」哈尔克",
            "dialogues": [
                {
                    "id": "761150301",
                    "speaker": "奈芙尔",
                    "text": "只知重复昨日之我的可悲之人，和预想的一样，不得不说也有些无趣。"
                },
                {
                    "id": "761150302",
                    "speaker": "派蒙",
                    "text": "他明明都坚持不做坏事那么久了，最后却还是…还是说，他天生就是坏人，坏人是不会变好的？",
                    "choices": [
                        {
                            "id": "761150303",
                            "text": "坚持做好事显然更难。",
                            "response": [
                                {
                                    "id": "761150305",
                                    "speaker": "奈芙尔",
                                    "text": "选择的权利始终都在，哪怕是刚才，他也可以选择认错忏悔。只是他又一次选错了。"
                                },
                                {
                                    "id": "761150306",
                                    "speaker": "奈芙尔",
                                    "text": "落子皆错，方有今日这盘死局。"
                                },
                                {
                                    "id": "761150307",
                                    "speaker": "奈芙尔",
                                    "text": "#不说这些了，总归是又了结了一桩工作。悬赏的证物就依约定，由{NICKNAME}交给勒塞克吧。"
                                },
                                {
                                    "id": "761150308",
                                    "speaker": "雅珂达",
                                    "text": "#有老板和{NICKNAME}出马就是叫人放心！这次我真的放假啦。"
                                },
                                {
                                    "id": "761150309",
                                    "speaker": "奈芙尔",
                                    "text": "呵呵，既然休息的一回合已经结束，雅珂达也该开始新的工作了吧？"
                                },
                                {
                                    "id": "761150310",
                                    "speaker": "雅珂达",
                                    "text": "欸——"
                                }
                            ]
                        },
                        {
                            "id": "761150304",
                            "text": "是他做了错误的决定。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7611504",
            "objective": "与奈芙尔对话",
            "dialogues": []
        }
    ]
}