    },
    "talks": [
        {
            "id": "7715401",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "771540101",
                    "speaker": "？？？",
                    "text": "哎呦喂…哎呦…我的腰啊，我可怜的…小狗…"
                },
                {
                    "id": "771540102",
                    "speaker": "派蒙",
                    "text": "怎、怎么了，老人家？"
                },
                {
                    "id": "771540103",
                    "speaker": "？？？",
                    "text": "哦…我，我刚才摔倒了腰，有点痛，哎…两位，能帮我看看我的小狗，它还在跑吗？"
                },
                {
                    "id": "771540104",
                    "speaker": "派蒙",
                    "text": "你的小狗，不是就在你身边吗？"
                },
                {
                    "id": "771540105",
                    "speaker": "？？？",
                    "text": "哎，不是这一只，是另外一只，拉着空的雪橇…"
                },
                {
                    "id": "771540106",
                    "speaker": "派蒙",
                    "text": "如果是这么说的话…确实有这么一只。"
                },
                {
                    "id": "771540107",
                    "speaker": "？？？",
                    "text": "唉…都是我害的，好心人啊，我看你身手矫健，脚步有力，不知道能不能帮腰痛的老头一个忙…"
                },
                {
                    "id": "771540108",
                    "speaker": "派蒙",
                    "text": "呃…帮忙倒是可以，不过你得先告诉我们是什么情况。"
                },
                {
                    "id": "771540109",
                    "speaker": "费尔金",
                    "text": "咳咳…老头子我名叫费尔金，呃，是在这冰原上拉雪橇跑货的…"
                },
                {
                    "id": "771540110",
                    "speaker": "派蒙",
                    "text": "咦，都已经有了列车了还要用雪橇吗？"
                },
                {
                    "id": "771540111",
                    "speaker": "费尔金",
                    "text": "列车四通八达是不假，但是也有没法开动列车的地方，就像这片冰原，轨道也没法铺设嘛。"
                },
                {
                    "id": "771540112",
                    "speaker": "费尔金",
                    "text": "总之，今天在拉雪橇的时候，我突然奇想，想试试从前在报纸上看到的杂技演员的动作…"
                },
                {
                    "id": "771540113",
                    "speaker": "费尔金",
                    "text": "用两只手牵着两辆雪橇的缰绳，然后脚踩在两辆雪橇上…结果嘛…"
                },
                {
                    "id": "771540114",
                    "speaker": "派蒙",
                    "text": "看来是摔了下来。"
                },
                {
                    "id": "771540115",
                    "speaker": "费尔金",
                    "text": "哎呀，杂技演员果然是经过专业训练的，就算老头子我自诩在这冰原上拉雪橇三十年…"
                },
                {
                    "id": "771540116",
                    "speaker": "费尔金",
                    "text": "果然还是不行，哎呀…腰倒是还好，"
                },
                {
                    "id": "771540117",
                    "speaker": "费尔金",
                    "text": "可是我的那只小狗…它、它训练有素，只听在它身后的雪橇上的人的命令，现在还在不停地跑…"
                },
                {
                    "id": "771540118",
                    "speaker": "派蒙",
                    "text": "啊？那怎么办？"
                },
                {
                    "id": "771540119",
                    "speaker": "费尔金",
                    "text": "我、我想了个办法…我用这辆雪橇拉着你们靠近小狗的雪橇，你们翻过去，然后用口哨令他停下。"
                },
                {
                    "id": "771540120",
                    "speaker": "派蒙",
                    "text": "口哨？"
                },
                {
                    "id": "771540121",
                    "speaker": "费尔金",
                    "text": "对，就像这样，「咻——咻——」，它就不会再乱跑，而是回到营地里面去啦。"
                },
                {
                    "id": "771540122",
                    "speaker": "派蒙",
                    "text": "呃…这个口哨。"
                },
                {
                    "id": "771540123",
                    "speaker": "费尔金",
                    "text": "只要把手这样放进嘴里，抿紧，舌头后缩，然后猛地吹气…"
                },
                {
                    "id": "771540124",
                    "speaker": "派蒙",
                    "text": "噗——噗——！完全不行嘛。"
                },
                {
                    "id": "771540125",
                    "speaker": "Player",
                    "text": "「咻——咻——」"
                },
                {
                    "id": "771540126",
                    "speaker": "费尔金",
                    "text": "#哦，这位{M#小哥}{F#女士}倒是吹得相当嘹亮，很好很好。"
                },
                {
                    "id": "771540127",
                    "speaker": "费尔金",
                    "text": "怎么样，帮帮老头子我这个忙吧。"
                },
                {
                    "id": "771540128",
                    "speaker": "Player",
                    "text": "「咻——咻——」"
                },
                {
                    "id": "771540129",
                    "speaker": "派蒙",
                    "text": "呜，好讨厌，你在炫耀什么啦。"
                },
                {
                    "id": "771540130",
                    "speaker": "费尔金",
                    "text": "那我就当你这样是答应了，来，上雪橇来吧！"
                }
            ]
        },
        {
            "id": "7715405",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "771540501",
                    "speaker": "费尔金",
                    "text": "驾…驾…快点跑，小家伙，追上你的兄弟…"
                }
            ]
        },
        {
            "id": "7715402",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "771540201",
                    "speaker": "派蒙",
                    "text": "噗——噗——！呜，还是吹不出来。"
                },
                {
                    "id": "771540202",
                    "speaker": "Player",
                    "text": "「咻——咻——」"
                },
                {
                    "id": "771540203",
                    "speaker": "Black Screen",
                    "text": "终于听到停下哨令的小狗慢慢停了下来。\\n它喘着粗气朝背后的你感激地看了一眼…或许也是在疑惑你到底是什么时候出现在雪橇上的。\\n总之，它抖了抖身子，慢慢带着你朝它们的营地走去。"
                }
            ]
        },
        {
            "id": "7715403",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "771540301",
                    "speaker": "费尔金",
                    "text": "快，快翻到那架雪橇上去，记得吹口哨啊！"
                }
            ]
        },
        {
            "id": "7715404",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "771540401",
                    "speaker": "费尔金",
                    "text": "呜呜，我可怜的小狗啊，我以后再也不干那样的蠢事了。"
                },
                {
                    "id": "771540402",
                    "speaker": "费尔金",
                    "text": "了不起啊年轻人，我看到你的动作了，真是干净又利落…"
                },
                {
                    "id": "771540403",
                    "speaker": "费尔金",
                    "text": "这是给你们愿意出手相助的酬劳，以后要是有什么帮得上忙的，尽管和我说！"
                },
                {
                    "id": "771540404",
                    "speaker": "费尔金",
                    "text": "哎，哎，跑了这么久，我得看看我的小狗的情况…"
                },
                {
                    "id": "771540405",
                    "speaker": "派蒙",
                    "text": "好！"
                },
                {
                    "id": "771540406",
                    "speaker": "Player",
                    "text": "「咻——咻——」"
                },
                {
                    "id": "771540407",
                    "speaker": "派蒙",
                    "text": "不许吹了，等…等你把我教会了我们再一起吹，不许一个人吹啦！"
                },
                {
                    "id": "771540408",
                    "speaker": "费尔金",
                    "text": "哈哈，只要勤加练习，你一定也能吹出来的！"
                }
            ]
        }
    ]
}