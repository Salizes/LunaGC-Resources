{
    "quest": {
        "id": "22044",
        "title": "饰猫之法",
        "description": "在浅濑神社工作的大岛纯平似乎正在为某事而发愁…",
        "rewards": [],
        "rewards_formatted": "",
        "chapter": {
            "icon": "",
            "id": "",
            "num": "",
            "title": ""
        },
        "total_dialogue_lines": 22,
        "total_speaker_counts": {
            "Player": 3,
