        }
    },
    "talks": [
        {
            "id": "2204401",
            "objective": "与大岛纯平对话",
            "dialogues": [
                {
                    "id": "220440101",
                    "speaker": "大岛纯平",
                    "text": "旅行者，你怎么来了？你是想过来拜一拜吗？"
                },
                {
                    "id": "220440102",
                    "speaker": "Player",
                    "text": "你的木雕怎么样了？"
                },
                {
                    "id": "220440103",
                    "speaker": "大岛纯平",
                    "text": "哈哈哈，倒也还算顺利，就是木雕的尺寸还得再把握把握。"
                },
                {
                    "id": "220440104",
                    "speaker": "大岛纯平",
                    "text": "毕竟，按照我最初的想法，这些木雕的大小最好不超过人的手掌尺寸。"
                },
                {
                    "id": "220440105",
                    "speaker": "大岛纯平",
                    "text": "这样子，才方便拿在手里把玩。"
                },
                {
                    "id": "220440106",
                    "speaker": "大岛纯平",
                    "text": "而且，除了雕像本身之外…我还想要再做一点「装饰」。"
                },
                {
                    "id": "220440107",
                    "speaker": "大岛纯平",
                    "text": "我之前看人做雕像的时候，除了制作雕像的本体，还会在雕像旁边搭配一些小装饰。"
                },
                {
                    "id": "220440108",
                    "speaker": "大岛纯平",
                    "text": "比如花啦、动物啦，或者是带花纹的底座之类的…"
                },
                {
                    "id": "220440109",
                    "speaker": "大岛纯平",
                    "text": "我也想给我的这种小木雕做一个带装饰物的底座…虽然因为尺寸问题，一个木雕应该只能附带一个装饰…"
                },
                {
                    "id": "220440110",
                    "speaker": "大岛纯平",
                    "text": "但是我想，只要把那些装饰做成可拆卸的就行了。到时候客人想要什么装饰，我就给他们安上什么装饰。"
                },
                {
                    "id": "220440111",
                    "speaker": "大岛纯平",
                    "text": "我想要先从简单的装饰开始练起，比如…鸣草之类的植物。"
                },
                {
                    "id": "220440112",
                    "speaker": "大岛纯平",
                    "text": "旅行者，能请你帮我去采三株「鸣草」来给我做参考吗？",
                    "choices": [
                        {
                            "id": "220440113",
                            "text": "交给我吧。",
                            "response": [
                                {
                                    "id": "220440117",
                                    "speaker": "大岛纯平",
                                    "text": "那就拜托你了，旅行者。你采到鸣草后，就快点带来给我吧。"
                                }
                            ]
                        },
                        {
                            "id": "220440114",
                            "text": "为什么要三株？",
                            "response": [
                                {
                                    "id": "220440115",
                                    "speaker": "大岛纯平",
                                    "text": "有三株的话，我就可以同时观察三种不同状态的鸣草了。"
                                },
                                {
                                    "id": "220440116",
                                    "speaker": "大岛纯平",
                                    "text": "这样的话，我一定能雕出最好看的鸣草。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2204402",
            "objective": "将三份鸣草交给大岛纯平",
            "dialogues": [
                {
                    "id": "220440201",
                    "speaker": "大岛纯平",
                    "text": "你采到鸣草了吗？"
                }
            ]
        },
        {
            "id": "2204403",
            "objective": "与大岛纯平对话",
            "dialogues": [
                {
                    "id": "220440301",
                    "speaker": "大岛纯平",
                    "text": "喔！这些就足够了，谢谢你旅行者。"
                },
                {
                    "id": "220440302",
                    "speaker": "大岛纯平",
                    "text": "我等会就来研究一下…看看怎么样才能把木头雕成鸣草的模样…"
                },
                {
                    "id": "220440303",
                    "speaker": "大岛纯平",
                    "text": "唔，如果我能把这些装饰做得好一些，种类也再做多一些的话…"
                },
                {
                    "id": "220440304",
                    "speaker": "大岛纯平",
                    "text": "说不定，装饰也能单独拿出来卖…"
                }
            ]
        }
    ]
}