        {
            "id": "4007213",
            "objective": "与众人对话",
            "dialogues": [
                {
                    "id": "400721301",
                    "speaker": "派蒙",
                    "text": "又回来了。"
                },
                {
                    "id": "400721302",
                    "speaker": "枫原万叶",
                    "text": "刚才，我们似乎不小心窥见了邪龙的真面目。"
                },
                {
                    "id": "400721303",
                    "speaker": "辛焱",
                    "text": "唉，这种事我可太有体会了，总有人觉得我们的爱好是浪费时间。"
                },
                {
                    "id": "400721304",
                    "speaker": "莫娜",
                    "text": "嗯？你…"
                },
                {
                    "id": "400721305",
                    "speaker": "阿诺德",
                    "text": "我是「渴望被问路的阿诺德」。"
                },
                {
                    "id": "400721306",
                    "speaker": "莫娜",
                    "text": "我的意思是，你怎么又来了？"
                },
                {
                    "id": "400721307",
                    "speaker": "阿诺德",
                    "text": "噢，噢，我猜，你们应该会找《圣国的咏唱》第三卷。"
                },
                {
                    "id": "400721308",
                    "speaker": "莫娜",
                    "text": "还真是让你猜对了…"
                },
                {
                    "id": "400721309",
                    "speaker": "阿诺德",
                    "text": "亲爱的女士，您不必为我做任何事。您的美丽，就是对我最大的褒奖。我将在此献上您所追寻的答案。"
                },
                {
                    "id": "400721310",
                    "speaker": "阿诺德",
                    "text": "圣典第三卷，位于王城顶楼。"
                },
                {
                    "id": "400721311",
                    "speaker": "枫原万叶",
                    "text": "有什么安保措施吗？"
                },
                {
                    "id": "400721312",
                    "speaker": "阿诺德",
                    "text": "噢，噢当然了先生，您在说什么傻话？任何国家都不会将最重要的书暴露在荒野上。"
                },
                {
                    "id": "400721313",
                    "speaker": "枫原万叶",
                    "text": "也就是说，那边依然会有夜鸦护卫。"
                },
                {
                    "id": "400721314",
                    "speaker": "阿诺德",
                    "text": "看守圣典是臣民无上的荣耀。但没关系，相信这位女士只是想阅读圣典而已。"
                },
                {
                    "id": "400721315",
                    "speaker": "阿诺德",
                    "text": "您的面容如此迷人，且富有智慧。您的同伴也像是英雄，如果是诸位，应该能读懂我们圣典中的故事。"
                },
                {
                    "id": "400721316",
                    "speaker": "阿诺德",
                    "text": "殿下的事迹经大书记官奥兹大人转述，成为了幽夜净土的珍宝。每一次我读这本书，都盼望殿下能感到幸福。"
                }
            ]
        },
        {
            "id": "4007299",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "400729902",
                    "speaker": "旁白",
                    "text": "「皇女殿下降临，大战不免祸及王城。」"
                },
                {
                    "id": "400729904",
                    "speaker": "莱昂",
                    "text": "救命——！有人吗，救救我——！"
                },
                {
                    "id": "400729905",
                    "speaker": "派蒙",
                    "text": "啊啊啊，我才刚听到重要的地方，皇女到底说了什么啊！"
                },
                {
                    "id": "400729906",
                    "speaker": "辛焱",
                    "text": "这个声音好耳熟，不会又是那位夜鸦骑士小哥吧。"
                }
            ]
        }
    ]
}