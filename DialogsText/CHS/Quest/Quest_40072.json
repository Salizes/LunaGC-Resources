    "talks": [
        {
            "id": "4007202",
            "objective": "寻找《圣国的咏唱》第二卷",
            "dialogues": [
                {
                    "id": "400720201",
                    "speaker": "神情严肃的夜鸦",
                    "text": "站住，什么人！"
                },
                {
                    "id": "400720202",
                    "speaker": "眼神凛冽的夜鸦",
                    "text": "看你们的样子，不是幽夜净土臣民吧？说！来这里做什么！"
                },
                {
                    "id": "400720203",
                    "speaker": "派蒙",
                    "text": "竟然有守卫！"
                },
                {
                    "id": "400720204",
                    "speaker": "Player",
                    "text": "不必慌张。"
                },
                {
                    "id": "400720205",
                    "speaker": "派蒙",
                    "text": "欸？你干什么？"
                },
                {
                    "id": "400720206",
                    "speaker": "Player",
                    "text": "我们是皇女殿下的家臣。"
                },
                {
                    "id": "400720207",
                    "speaker": "Player",
                    "text": "穿越星海而来之人。"
                },
                {
                    "id": "400720208",
                    "speaker": "神情严肃的夜鸦",
                    "text": "你如何证明自己是殿下的家臣？"
                },
                {
                    "id": "400720209",
                    "speaker": "莫娜",
                    "text": "哼，问出如此狂妄的问题，正说明你们眼光浅薄。"
                },
                {
                    "id": "400720210",
                    "speaker": "莫娜",
                    "text": "「令我的子民自由，不囿于古老法则。」"
                },
                {
                    "id": "400720211",
                    "speaker": "眼神凛冽的夜鸦",
                    "text": "是、是幽夜净土的口令！他们真的是殿下的臣子！"
                },
                {
                    "id": "400720212",
                    "speaker": "神情严肃的夜鸦",
                    "text": "天哪，我、我僭越了！各位，请原谅我们…"
                },
                {
                    "id": "400720213",
                    "speaker": "派蒙",
                    "text": "知错了还不快退下？"
                },
                {
                    "id": "400720214",
                    "speaker": "神情严肃的夜鸦",
                    "text": "是是，属下这就离开…"
                },
                {
                    "id": "400720215",
                    "speaker": "派蒙",
                    "text": "他们走啦。"
                },
                {
                    "id": "400720216",
                    "speaker": "枫原万叶",
                    "text": "这就是《圣国的咏唱》第二卷。各位，准备好了吗？"
                },
                {
                    "id": "400720217",
                    "speaker": "派蒙",
                    "text": "出发！"
                }
            ]
        },
        {
            "id": "4007220",
            "objective": "(test)(hide)销毁夜鸦雕像$HIDDEN",
            "dialogues": []
        },
        {
            "id": "4007203",
            "objective": "翻开《圣国的咏唱》第二卷",
            "dialogues": []
        },
        {
            "id": "4007204",
            "objective": "与众人对话",
            "dialogues": [
                {
                    "id": "400720401",
                    "speaker": "旁白",
                    "text": "「然而，幽夜净土迎来连续如噩梦的阴霾。邪龙塔斯拉克潜入地下，越过海底，游走至王城之上。」"
                },
                {
                    "id": "400720402",
                    "speaker": "辛焱",
                    "text": "欸？有龙吗？我觉得只有天气变阴了啊。"
                },
                {
                    "id": "400720403",
                    "speaker": "枫原万叶",
                    "text": "龙…会不会是种比喻？"
                },
                {
                    "id": "400720404",
                    "speaker": "莫娜",
                    "text": "是吗…不认可她、反驳她幻想的一切，共同构筑成了她的宿敌，「邪龙塔斯拉克」。"
                }
            ]
        },
        {
