    "talks": [
        {
            "id": "7153301",
            "objective": "与米卡对话",
            "dialogues": [
                {
                    "id": "715330101",
                    "speaker": "米卡",
                    "text": "…唔，感觉也不太对，这种「祝柬」，真难做啊。"
                },
                {
                    "id": "715330102",
                    "speaker": "Player",
                    "text": "米卡，你在做「祝柬」吗？"
                },
                {
                    "id": "715330103",
                    "speaker": "米卡",
                    "text": "#欸？{NICKNAME}，居然能遇见你，真巧了。"
                },
                {
                    "id": "715330104",
                    "speaker": "Player",
                    "text": "你是来璃月过海灯节的么？"
                },
                {
                    "id": "715330105",
                    "speaker": "米卡",
                    "text": "欸？不是不是，我来璃月港本来是为了执行递送信件的任务，刚巧遇上了海灯节。"
                },
                {
                    "id": "715330106",
                    "speaker": "米卡",
                    "text": "我来之前听可莉前辈说，她很想要一封海灯节的「祝柬」，就想着顺便买一封回去。"
                },
                {
                    "id": "715330107",
                    "speaker": "米卡",
                    "text": "结果，没想到要自己做…"
                },
                {
                    "id": "715330108",
                    "speaker": "米卡",
                    "text": "我做了半天，却总觉得做出来的「祝柬」不太对…但也不知道具体哪里不对…"
                },
                {
                    "id": "715330109",
                    "speaker": "米卡",
                    "text": "#{NICKNAME}，你见多识广…能给我点制作「祝柬」的建议吗？"
                },
                {
                    "id": "715330110",
                    "speaker": "Player",
                    "text": "让我思考一下…"
                }
            ]
        },
        {
            "id": "7153302",
            "objective": "和米卡一同完成祝柬",
            "dialogues": [
                {
                    "id": "715330201",
                    "speaker": "米卡",
                    "text": "#{NICKNAME}，你见多识广…能给我点制作「祝柬」的建议吗？"
                },
                {
                    "id": "715330202",
                    "speaker": "Player",
                    "text": "让我思考一下…"
                }
            ]
        },
        {
            "id": "7153303",
            "objective": "与米卡对话",
            "dialogues": [
                {
                    "id": "715330301",
                    "speaker": "米卡",
                    "text": "这「祝柬」真好看！不愧是你，做得又快又好…"
                },
                {
                    "id": "715330302",
                    "speaker": "米卡",
                    "text": "…哎呀！不好不好，我在这里待太久了，还得快点回骑士团复命。"
                },
                {
                    "id": "715330303",
                    "speaker": "米卡",
                    "text": "#谢谢你帮忙，{NICKNAME}，可莉前辈一定会很喜欢这封「祝柬」的。"
                }
            ]
        }
    ]
}