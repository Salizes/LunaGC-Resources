    },
    "talks": [
        {
            "id": "7603601",
            "objective": "同「少女」见面",
            "dialogues": [
                {
                    "id": "760360101",
                    "speaker": "「少女」",
                    "text": "不是这个蓝色吗？"
                },
                {
                    "id": "760360102",
                    "speaker": "月灵",
                    "text": "……",
                    "choices": [
                        {
                            "id": "760360103",
                            "text": "哥伦比娅？",
                            "response": [
                                {
                                    "id": "760360105",
                                    "speaker": "「少女」",
                                    "text": "嗯？是你们。"
                                },
                                {
                                    "id": "760360106",
                                    "speaker": "「少女」",
                                    "text": "帮帮我好吗？之后会给你们好处的。"
                                },
                                {
                                    "id": "760360107",
                                    "speaker": "派蒙",
                                    "text": "呃…你什么时候才能改掉这个习惯啦…",
                                    "choices": [
                                        {
                                            "id": "760360108",
                                            "text": "你之前也帮过我们很多…",
                                            "response": [
                                                {
                                                    "id": "760360110",
                                                    "speaker": "派蒙",
                                                    "text": "对啊，就算没什么好处我们也会帮忙的啦。"
                                                },
                                                {
                                                    "id": "760360111",
                                                    "speaker": "派蒙",
                                                    "text": "所以到底怎么了？"
                                                },
                                                {
                                                    "id": "760360112",
                                                    "speaker": "「少女」",
                                                    "text": "唔…准确来说，是它需要帮助。"
                                                },
                                                {
                                                    "id": "760360113",
                                                    "speaker": "月灵",
                                                    "text": "……"
                                                },
                                                {
                                                    "id": "760360114",
                                                    "speaker": "派蒙",
                                                    "text": "这只月灵？"
                                                },
                                                {
                                                    "id": "760360115",
                                                    "speaker": "「少女」",
                                                    "text": "这孩子不知从哪里捡到了一支画笔，回来后在我周围开心地晃。"
                                                },
                                                {
                                                    "id": "760360116",
                                                    "speaker": "「少女」",
                                                    "text": "我给它找了些画布和颜料，但画了一阵子后，它好像怎么也调不出心仪的颜色。"
                                                },
                                                {
                                                    "id": "760360117",
                                                    "speaker": "努昂诺塔",
                                                    "text": "……！"
                                                },
                                                {
                                                    "id": "760360118",
                                                    "speaker": "派蒙",
                                                    "text": "咦，你怎么出来了？"
                                                },
                                                {
                                                    "id": "760360119",
                                                    "speaker": "努昂诺塔",
                                                    "text": "！！"
                                                },
                                                {
                                                    "id": "760360120",
                                                    "speaker": "月灵",
                                                    "text": "？？"
                                                },
                                                {
                                                    "id": "760360121",
                                                    "speaker": "努昂诺塔",
                                                    "text": "……！"
                                                },
                                                {
                                                    "id": "760360122",
                                                    "speaker": "派蒙",
                                                    "text": "呃…就算你这么比划，我们也不知道你要什么啦…"
                                                },
                                                {
                                                    "id": "760360123",
                                                    "speaker": "努昂诺塔",
                                                    "text": "……"
                                                },
                                                {
                                                    "id": "760360124",
                                                    "speaker": "努昂诺塔",
                                                    "text": "！！"
                                                },
                                                {
                                                    "id": "760360125",
                                                    "speaker": "月灵",
                                                    "text": "！！"
                                                },
                                                {
                                                    "id": "760360126",
                                                    "speaker": "派蒙",
                                                    "text": "呀！它好像看上了你的背包。"
                                                },
                                                {
                                                    "id": "760360127",
                                                    "speaker": "「少女」",
                                                    "text": "你们身上有带合适的颜料吗？"
                                                },
                                                {
                                                    "id": "760360128",
                                                    "speaker": "派蒙",
                                                    "text": "我们不会随身带那种东西啦…话说回来，哥伦比娅是从哪里找到颜料的？你平时也不像会画画的样子。"
                                                },
                                                {
                                                    "id": "760360129",
                                                    "speaker": "「少女」",
                                                    "text": "这孩子有些等不及，我就随手用身边带颜色的花朵给它做了些。"
                                                },
                                                {
                                                    "id": "760360130",
                                                    "speaker": "派蒙",
                                                    "text": "哦！难道说，努昂诺塔也是想找一些色彩丰富的东西来做颜料吗？"
                                                },
                                                {
                                                    "id": "760360131",
                                                    "speaker": "派蒙",
                                                    "text": "快快快，看看我们包里都有些什么。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "760360109",
                                            "text": "你之前也给过我们赐福…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "760360104",
                            "text": "发生什么了？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7603602",
            "objective": "将一些色彩丰富的东西交给月灵",
            "dialogues": [
                {
                    "id": "760360201",
                    "speaker": "月灵",
                    "text": "！！"
                },
                {
                    "id": "760360202",
                    "speaker": "派蒙",
                    "text": "别急哦，我们找找，最好是挪德卡莱颜色丰富的植物，对吧？"
                }
            ]
        },
        {
            "id": "7603603",
            "objective": "同月灵对话",
            "dialogues": [
                {
                    "id": "760360301",
                    "speaker": "派蒙",
                    "text": "这些就够了吧？"
                },
                {
                    "id": "760360302",
                    "speaker": "「少女」",
                    "text": "嗯，它看起来很满意。"
                },
                {
                    "id": "760360303",
                    "speaker": "梅拉",
                    "text": "~！"
                },
                {
                    "id": "760360304",
                    "speaker": "派蒙",
                    "text": "我以前都不知道月灵还会画画呢。"
                },
                {
                    "id": "760360305",
                    "speaker": "「少女」",
                    "text": "它们其实和我们一样，有着各自的性格和爱好。"
                },
                {
                    "id": "760360306",
                    "speaker": "派蒙",
                    "text": "欸？难道说挪德卡莱的每一只月灵你都认识？"
                },
                {
                    "id": "760360307",
                    "speaker": "「少女」",
                    "text": "嗯，只要见过的话就认识。"
                },
                {
                    "id": "760360308",
                    "speaker": "派蒙",
                    "text": "这么厉害？！在我看来除了努昂诺塔有些特殊之外，其他月灵几乎都长一个样…"
                },
                {
                    "id": "760360309",
                    "speaker": "派蒙",
                    "text": "那这只会画画的小家伙叫什么名字呀？"
                },
                {
                    "id": "760360310",
                    "speaker": "「少女」",
                    "text": "名字…？"
                },
                {
                    "id": "760360311",
                    "speaker": "派蒙",
                    "text": "你该不会没给它们取名字吧…"
                },
                {
                    "id": "760360312",
                    "speaker": "「少女」",
                    "text": "我认识它们，它们也认识我，不需要名字…我也没有名字呀。"
                },
                {
                    "id": "760360313",
                    "speaker": "派蒙",
                    "text": "不要把不好的传统延续下去呀！"
                },
                {
                    "id": "760360314",
                    "speaker": "派蒙",
                    "text": "呃…那，那我想想…「努昂诺塔」意思是月神赐福下诞生的生灵…"
                },
                {
                    "id": "760360315",
                    "speaker": "派蒙",
                    "text": "那「画」在「霜月之子」的语言里是怎么说的？"
                },
                {
                    "id": "760360316",
                    "speaker": "「少女」",
                    "text": "好像是…梅…娜？梅拉？是梅拉。"
                },
                {
                    "id": "760360317",
                    "speaker": "派蒙",
                    "text": "听着还不错，那就叫它「梅拉」好了！"
                },
                {
                    "id": "760360318",
                    "speaker": "梅拉",
                    "text": "？？"
                },
                {
                    "id": "760360319",
                    "speaker": "派蒙",
                    "text": "怎么样，梅拉，你画好了吗？"
                },
                {
                    "id": "760360320",
                    "speaker": "梅拉",
                    "text": "！！"
                },
                {
                    "id": "760360321",
                    "speaker": "派蒙",
                    "text": "哦！我看看我看看…这！这…！"
                },
                {
                    "id": "760360322",
                    "speaker": "Player",
                    "text": "怎么了？"
                },
                {
                    "id": "760360323",
                    "speaker": "派蒙",
                    "text": "这画得也太好了！"
                },
                {
                    "id": "760360324",
                    "speaker": "派蒙",
                    "text": "我还以为画得会比较孩子气…或者…像美露莘那样…"
                },
                {
                    "id": "760360325",
                    "speaker": "「少女」",
                    "text": "月灵很擅长感知周围的环境，在临摹所见之物的时候，倾向于将自己的感受原封不动地记录下来。"
                },
                {
                    "id": "760360326",
                    "speaker": "Player",
                    "text": "梅拉画的是…哥伦比娅？"
                },
                {
                    "id": "760360327",
                    "speaker": "梅拉",
                    "text": "！！"
                },
                {
                    "id": "760360328",
                    "speaker": "「少女」",
                    "text": "嗯？"
                },
                {
                    "id": "760360329",
                    "speaker": "派蒙",
                    "text": "…看起来像是哥伦比娅刚诞生时的样子。"
                },
                {
                    "id": "760360330",
                    "speaker": "「少女」",
                    "text": "欸？"
                },
                {
                    "id": "760360331",
                    "speaker": "派蒙",
                    "text": "我记得菈乌玛也说过，你诞生的时候被「霜月之子」记录了下来，不过和这幅画似乎有些区别。",
                    "choices": [
                        {
                            "id": "760360332",
                            "text": "而且月灵这种生物…",
                            "response": [
                                {
                                    "id": "760360334",
                                    "speaker": "「少女」",
                                    "text": "这孩子…梅拉，是最初诞生的月灵之一。它或许是结合自己的感知，想象了当时的画面吧。"
                                },
                                {
                                    "id": "760360335",
                                    "speaker": "派蒙",
                                    "text": "哦！这么看来，梅拉在很努力地为我们介绍自己的神明呢。"
                                },
                                {
                                    "id": "760360336",
                                    "speaker": "梅拉",
                                    "text": "~！"
                                },
                                {
                                    "id": "760360337",
                                    "speaker": "「少女」",
                                    "text": "……"
                                },
                                {
                                    "id": "760360338",
                                    "speaker": "派蒙",
                                    "text": "放心吧，我们会和哥伦比娅好好相处的。"
                                },
                                {
                                    "id": "760360339",
                                    "speaker": "梅拉",
                                    "text": "！！"
                                },
                                {
                                    "id": "760360340",
                                    "speaker": "派蒙",
                                    "text": "咦？这么快又画好一张？"
                                },
                                {
                                    "id": "760360341",
                                    "speaker": "「少女」",
                                    "text": "……？"
                                },
                                {
                                    "id": "760360342",
                                    "speaker": "派蒙",
                                    "text": "这画的是…「霜月之子」将哥伦比娅奉为神明时候的事吧。"
                                },
                                {
                                    "id": "760360343",
                                    "speaker": "派蒙",
                                    "text": "嗯？哥伦比娅在祭坛那边干什么呢？画得太小了有些看不清。"
                                },
                                {
                                    "id": "760360344",
                                    "speaker": "梅拉",
                                    "text": "~！"
                                },
                                {
                                    "id": "760360345",
                                    "speaker": "派蒙",
                                    "text": "原来是在吃贡品吗！"
                                },
                                {
                                    "id": "760360346",
                                    "speaker": "「少女」",
                                    "text": "…不能吃吗？"
                                },
                                {
                                    "id": "760360347",
                                    "speaker": "派蒙",
                                    "text": "倒也不是说不能吃吧，只是…有些意外。"
                                },
                                {
                                    "id": "760360348",
                                    "speaker": "Player",
                                    "text": "看你吃得很开心…"
                                },
                                {
                                    "id": "760360349",
                                    "speaker": "「少女」",
                                    "text": "因为…好吃嘛…"
                                },
                                {
                                    "id": "760360350",
                                    "speaker": "派蒙",
                                    "text": "也是…"
                                },
                                {
                                    "id": "760360351",
                                    "speaker": "梅拉",
                                    "text": "~！"
                                },
                                {
                                    "id": "760360352",
                                    "speaker": "「少女」",
                                    "text": "好，知道了。"
                                },
                                {
                                    "id": "760360353",
                                    "speaker": "「少女」",
                                    "text": "手给我。",
                                    "choices": [
                                        {
                                            "id": "760360354",
                                            "text": "可以不要「回报」的…",
                                            "response": [
                                                {
                                                    "id": "760360356",
                                                    "speaker": "「少女」",
                                                    "text": "不，这算是「相处」的证明。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "760360355",
                                            "text": "这个不能吃…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "760360333",
                            "text": "应该是月神诞生后出现的…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7603699",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "760369901",
                    "speaker": "派蒙",
                    "text": "上次来听到了很多「愚人众」的话题呢，不知道今天她心情怎么样，会聊些什么呢？"
                },
                {
                    "id": "760369902",
                    "speaker": "派蒙",
                    "text": "哥伦比娅？"
                },
                {
                    "id": "760369903",
                    "speaker": "派蒙",
                    "text": "欸？她看起来好不开心的样子！"
                },
                {
                    "id": "760369904",
                    "speaker": "「少女」",
                    "text": "是这个吗？"
                },
                {
                    "id": "760369905",
                    "speaker": "「少女」",
                    "text": "也不是这个？"
                },
                {
                    "id": "760369906",
                    "speaker": "「少女」",
                    "text": "这个呢？"
                }
            ]
        }
    ]
}