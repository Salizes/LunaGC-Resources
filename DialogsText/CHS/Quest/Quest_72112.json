    "talks": [
        {
            "id": "7211225",
            "objective": "（test）神官神社创生$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7211235",
            "objective": "（test）抽签引导对话$HIDDEN",
            "dialogues": [
                {
                    "id": "721123501",
                    "speaker": "玄冬林檎",
                    "text": "你要求签？"
                },
                {
                    "id": "721123502",
                    "speaker": "派蒙",
                    "text": "呜哇，好冷淡。"
                },
                {
                    "id": "721123503",
                    "speaker": "Player",
                    "text": "我想求签…"
                },
                {
                    "id": "721123504",
                    "speaker": "玄冬林檎",
                    "text": "明白了。流程是这样的。首先请你用力摇晃这个什么东西。"
                },
                {
                    "id": "721123505",
                    "speaker": "Player",
                    "text": "记得是叫「御神签箱」…"
                },
                {
                    "id": "721123506",
                    "speaker": "玄冬林檎",
                    "text": "没错。从里面会掉出一根竹签。把这根竹签给我，我会给你对应的纸片儿。"
                },
                {
                    "id": "721123507",
                    "speaker": "Player",
                    "text": "好像叫「御神签」来着…"
                },
                {
                    "id": "721123508",
                    "speaker": "玄冬林檎",
                    "text": "这种事情怎样都好吧。"
                },
                {
                    "id": "721123509",
                    "speaker": "派蒙",
                    "text": "我有问题！如果说，如果说我们抽到了凶签，要怎么办呢？"
                },
                {
                    "id": "721123510",
                    "speaker": "玄冬林檎",
                    "text": "是命运让你抽到凶签，你还想怎样？啊？"
                },
                {
                    "id": "721123511",
                    "speaker": "派蒙",
                    "text": "欸！"
                },
                {
                    "id": "721123512",
                    "speaker": "Player",
                    "text": "外头那个像架子的东西…"
                },
                {
                    "id": "721123513",
                    "speaker": "玄冬林檎",
                    "text": "啧。"
                },
                {
                    "id": "721123514",
                    "speaker": "派蒙",
                    "text": "她很露骨地「啧」了耶！"
                },
                {
                    "id": "721123515",
                    "speaker": "玄冬林檎",
                    "text": "我看看…是这样的。「把凶签捆到『御签挂』上，就可以逢凶化吉」。"
                },
                {
                    "id": "721123516",
                    "speaker": "玄冬林檎",
                    "text": "啊，对哦！如果你抽到凶签，把它捆到那个架子上就行了嘛。"
                },
                {
                    "id": "721123517",
                    "speaker": "玄冬林檎",
                    "text": "他们还真是…不对，我们「鸣神大社」很温柔的。所以就算抽到了凶签，也会给你们转运的机会。"
                },
                {
                    "id": "721123518",
                    "speaker": "派蒙",
                    "text": "虽然感觉哪里好像怪怪的…"
                },
                {
                    "id": "721123519",
                    "speaker": "派蒙",
                    "text": "#{NICKNAME}，我们求签吧！"
                }
            ]
        },
        {
            "id": "7211236",
            "objective": "（test）解签引导对话$HIDDEN",
            "dialogues": [
                {
                    "id": "721123601",
                    "speaker": "玄冬林檎",
                    "text": "把竹签交出来。"
                },
                {
                    "id": "721123602",
                    "speaker": "Player",
                    "text": "好、好的。"
                },
                {
                    "id": "721123603",
                    "speaker": "派蒙",
                    "text": "神社真是个不讲情面的地方…"
                },
                {
                    "id": "721123604",
                    "speaker": "玄冬林檎",
                    "text": "给你。"
                },
                {
                    "id": "721123605",
                    "speaker": "派蒙",
                    "text": "唔呣，看看运势吧。"
                },
                {
                    "id": "721123606",
                    "speaker": "玄冬林檎",
                    "text": "对了。每天只能求一次签，这点请你记住。"
                },
                {
                    "id": "721123607",
                    "speaker": "玄冬林檎",
                    "text": "不然我会很累…不对，不然御签挂会挂不下…也不是，应该怎么说来着？"
                },
                {
                    "id": "721123608",
                    "speaker": "玄冬林檎",
                    "text": "「御神签是神明意志的体现。所以要尊重神明的意志，并且尽人所能及之力。」"
                },
                {
                    "id": "721123609",
                    "speaker": "玄冬林檎",
                    "text": "你看，写得真好。所以每天只能求一次签，记好了。"
                }
            ]
        },
        {
            "id": "7211215",
            "objective": "（test）检测完成暗号对话$HIDDEN",
            "dialogues": [
                {
                    "id": "721121501",
                    "speaker": "玄冬林檎",
                    "text": "你好。"
                }
            ]
        },
        {
            "id": "7211219",
            "objective": "（test）特殊交付1后加载group$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7211220",
            "objective": "（test）检测焰刀对话$HIDDEN",
            "dialogues": [
                {
                    "id": "721130701",
                    "speaker": "派蒙",
                    "text": "玄冬小姐的态度还是老样子…不管怎样，先看看签文吧。"
                },
                {
                    "id": "721130702",
                    "speaker": "派蒙",
                    "text": "咦？这是…"
                },
                {
                    "id": "721130703",
                    "speaker": "派蒙",
                    "text": "我明白了，这是需要对付的坏蛋吧！"
                },
                {
                    "id": "721130704",
                    "speaker": "派蒙",
                    "text": "嗯嗯，原来如此。原来玄冬小姐是谍报人员，通过这种方式接头，扫除对稻妻不利的人。"
                },
                {
                    "id": "721130705",
                    "speaker": "玄冬林檎",
                    "text": "好吵。"
                },
                {
                    "id": "721130706",
                    "speaker": "派蒙",
                    "text": "噫！对、对不起！不要对我们降下「终末」！"
                },
                {
                    "id": "721130707",
                    "speaker": "玄冬林檎",
                    "text": "赶紧走开。"
                },
                {
                    "id": "721130708",
                    "speaker": "派蒙",
                    "text": "我们这就走！到画里的地方看看，能不能找到目标！"
                }
            ]
        },
