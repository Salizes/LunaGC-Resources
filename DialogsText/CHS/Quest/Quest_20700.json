    "talks": [
        {
            "id": "2070001",
            "objective": "与查耶维奇对话",
            "dialogues": [
                {
                    "id": "207002101",
                    "speaker": "Player",
                    "text": "去山底。"
                },
                {
                    "id": "207002102",
                    "speaker": "查耶维奇",
                    "text": "山底是吧，那里倒是没什么，就是一群丘丘人来回游荡，虽然没什么危险，但是看着就碍眼。"
                },
                {
                    "id": "207002103",
                    "speaker": "查耶维奇",
                    "text": "你赶紧去把它们全部给清理掉，这么点小事，我觉得…一分钟，差不多了吧。"
                }
            ]
        },
        {
            "id": "2070002",
            "objective": "按查耶维奇的要求打倒丘丘人",
            "dialogues": [
                {
                    "id": "207000201",
                    "speaker": "Player",
                    "text": "已经办好了。"
                },
                {
                    "id": "207000202",
                    "speaker": "查耶维奇",
                    "text": "这么快就回来了，还没到一分钟就全部解决了，身手不凡，身手不凡呐，哈哈哈。"
                },
                {
                    "id": "207000203",
                    "speaker": "查耶维奇",
                    "text": "不错不错，5000摩拉，一分不少，拿好了。"
                },
                {
                    "id": "207000204",
                    "speaker": "派蒙",
                    "text": "身手不凡也才5000摩拉…"
                },
                {
                    "id": "207000205",
                    "speaker": "查耶维奇",
                    "text": "可别嫌少，这酬劳可是我仔细算过的，和你们的工作刚好相称。"
                },
                {
                    "id": "207000206",
                    "speaker": "查耶维奇",
                    "text": "想要赚大钱，就得办点大事，下次有机会的话，你们再努努力吧。"
                }
            ]
        },
        {
            "id": "2070005",
            "objective": "查耶维奇战斗A结果判定$HIDDEN",
            "dialogues": [
                {
                    "id": "207000501",
                    "speaker": "葛瑞丝",
                    "text": "我，资本家，万恶"
                }
            ]
        },
        {
            "id": "2070004",
            "objective": "任务A普通完成奖励发放$HIDDEN",
            "dialogues": [
                {
                    "id": "207000304",
                    "speaker": "Player",
                    "text": "已经办好了。"
                },
                {
                    "id": "207000305",
                    "speaker": "查耶维奇",
                    "text": "磨磨蹭蹭，和西风骑士团一个德行，我说了给你一分钟，你是忘了还是压根没听进去？"
                },
                {
                    "id": "207000306",
                    "speaker": "查耶维奇",
                    "text": "哼，这么点简单的细节都不在意…1000摩拉拿好，该干嘛干嘛去吧。"
                },
                {
                    "id": "207000307",
                    "speaker": "派蒙",
                    "text": "1000摩拉？怎么这么少！"
                },
                {
                    "id": "207000308",
                    "speaker": "查耶维奇",
                    "text": "事情办成那样，还想要多少钱？这些就是你们应得的酬劳，拿好了！"
                }
            ]
        },
        {
            "id": "2070006",
            "objective": "任务B普通完成奖励发放$HIDDEN",
            "dialogues": [
                {
                    "id": "207003301",
                    "speaker": "Player",
                    "text": "已经办好了。"
                },
                {
                    "id": "207003302",
                    "speaker": "查耶维奇",
                    "text": "你是听不懂我说的话，还是就想随便敷衍了事，啊？！"
                },
                {
                    "id": "207003303",
                    "speaker": "查耶维奇",
                    "text": "我让你别弄坏那些箱子，你怎么给我打碎了这么多？我这货还卖不卖，这生意还做不做了？"
                },
                {
                    "id": "207003304",
                    "speaker": "Player",
                    "text": "没看见什么货物…"
                },
                {
                    "id": "207003305",
                    "speaker": "查耶维奇",
                    "text": "那些箱子！就是我的货物！不然你以为我为什么敢把它们摆在野外？"
                },
                {
                    "id": "207003306",
                    "speaker": "查耶维奇",
                    "text": "算了算了，和你这种办事心不在焉的人没什么好说的，就1000摩拉，拿好了，赶紧走人！"
                },
                {
                    "id": "207003307",
                    "speaker": "派蒙",
                    "text": "这也太少了，怎么才1000摩拉呀！"
                },
                {
                    "id": "207003308",
                    "speaker": "查耶维奇",
                    "text": "嫌少？这么点小事都办不好，还指望白拿多少钱？这些就是你们应得的酬劳，拿好了。"
                }
            ]
        },
        {
            "id": "2070007",
            "objective": "按查耶维奇的要求打倒丘丘人",
            "dialogues": []
        },
        {
            "id": "2070008",
            "objective": "按查耶维奇的要求打倒丘丘人",
            "dialogues": []
        },
        {
            "id": "2070009",
