    },
    "talks": [
        {
            "id": "7054401",
            "objective": "(test)彩蛋对话4$HIDDEN",
            "dialogues": [
                {
                    "id": "705440101",
                    "speaker": "菲谢尔",
                    "text": "哦呵呵~既是被冠以「猫茸茸城堡」这般奇巧之名的宝地，陈设如此凡俗，未免有些寒碜了…"
                },
                {
                    "id": "705440102",
                    "speaker": "菲谢尔",
                    "text": "至少得装设几座…紫玛瑙葡萄藤编织而成的秋千！纯净白银的灯盏上，应当是渊水海盐制成的蜡烛，点亮晚星纹样的猫餐盘！"
                },
                {
                    "id": "705440103",
                    "speaker": "菲谢尔",
                    "text": "嗯…还有雕像！熔炼失落王朝的古币，以峡湾深底的奇异珍珠和露滴为辅料，打造猫之眷属的雕像，想必是个不错的选择！"
                },
                {
                    "id": "705440104",
                    "speaker": "菲谢尔",
                    "text": "你也是这么想的，没错吧，这位猫之眷属…"
                },
                {
                    "id": "705440105",
                    "speaker": "菲谢尔",
                    "text": "呃，你还未报上名号来。好好斟酌措辞吧，让本皇女知晓你的名字，可是无上的荣耀！"
                },
                {
                    "id": "705440106",
                    "speaker": "「阿呆」",
                    "text": "喵？"
                },
                {
                    "id": "705440107",
                    "speaker": "派蒙",
                    "text": "它叫「阿呆」哦，尊贵的皇女！"
                },
                {
                    "id": "705440108",
                    "speaker": "派蒙",
                    "text": "「阿呆」不太懂事，听不懂皇女考究的用词，还请皇女见谅…"
                },
                {
                    "id": "705440109",
                    "speaker": "派蒙",
                    "text": "不对不对！怎么一见到菲谢尔，我就自动进入那种状态了？",
                    "choices": [
                        {
                            "id": "705440110",
                            "text": "没什么不好的，我也开演！",
                            "response": [
                                {
                                    "id": "705440112",
                                    "speaker": "菲谢尔",
                                    "text": "果然，不出所料，两位「猫之魔法师」，你们再次被命运的纽带牵引，来到了本皇女的面前…"
                                },
                                {
                                    "id": "705440113",
                                    "speaker": "菲谢尔",
                                    "text": "真是令人感慨的重逢啊！"
                                },
                                {
                                    "id": "705440114",
                                    "speaker": "派蒙",
                                    "text": "这个称呼…看来菲谢尔已经从瓦乐瑞娜那里听说了我们的事了呢！"
                                },
                                {
                                    "id": "705440115",
                                    "speaker": "菲谢尔",
                                    "text": "有你们出谋划策，近来本皇女在幽夜净土深思之时，偶然从过往阅历中寻获的巧念，便能轻松落实了——"
                                },
                                {
                                    "id": "705440116",
                                    "speaker": "菲谢尔",
                                    "text": "本皇女打算遴选感官最为敏锐、才思最为聪颖的猫之眷属，与本皇女同行！"
                                },
                                {
                                    "id": "705440117",
                                    "speaker": "「阿呆」",
                                    "text": "喵~"
                                },
                                {
                                    "id": "705440118",
                                    "speaker": "派蒙",
                                    "text": "原来菲谢尔也有养猫的打算啊，想来倒也挺正常的，大部分人见识过猫猫的可爱后，应该都会想养一只。"
                                },
                                {
                                    "id": "705440119",
                                    "speaker": "派蒙",
                                    "text": "不过，菲谢尔不是有奥兹陪着吗？"
                                },
                                {
                                    "id": "705440120",
                                    "speaker": "派蒙",
                                    "text": "你们行动的速度本来就很快，猫猫真的能跟上？还是说…要让奥兹载着猫猫飞行？"
                                },
                                {
                                    "id": "705440121",
                                    "speaker": "菲谢尔",
                                    "text": "哼哼，本皇女时常跨越三千宇宙，虽说旅途不算漫长，但适当多些伙伴，洞悉易被忽略之物…自然没有坏处！"
                                },
                                {
                                    "id": "705440122",
                                    "speaker": "菲谢尔",
                                    "text": "奥兹也很想与猫之眷属玩…咳！想与猫之眷属通力合作，确保本皇女每时每刻的心绪都如霁月光风！"
                                },
                                {
                                    "id": "705440123",
                                    "speaker": "菲谢尔",
                                    "text": "可惜，即便奥兹难得展示平易近人的姿态，也难以完全隐去身上的威压，没法接近猫之眷属。"
                                },
                                {
                                    "id": "705440124",
                                    "speaker": "菲谢尔",
                                    "text": "距离奥兹不到五步距离时，猫之眷属们的毛发就像是飘散的蓬蓬果，疏忽膨胀开来，随后它们便会陷入惊恐，四散逃开。"
                                },
                                {
                                    "id": "705440125",
                                    "speaker": "菲谢尔",
                                    "text": "虔信风神的忠实修女建议奥兹在外休息，言之有理…我默许了。"
                                },
                                {
                                    "id": "705440126",
                                    "speaker": "派蒙",
                                    "text": "威压？我好像明白了…"
                                },
                                {
                                    "id": "705440127",
                                    "speaker": "派蒙",
                                    "text": "难道说，奥兹身上的雷元素太充沛，一进到「猫茸茸城堡」就会让所有猫猫炸毛。"
                                },
                                {
                                    "id": "705440128",
                                    "speaker": "派蒙",
                                    "text": "这样一来，还怎么让猫猫跟着菲谢尔旅行啊…"
                                },
                                {
                                    "id": "705440129",
                                    "speaker": "派蒙",
                                    "text": "要是提瓦特存在某种材料…能够隔绝雷元素的影响就好了。"
                                },
                                {
                                    "id": "705440130",
                                    "speaker": "派蒙",
                                    "text": "用这种材料给猫猫做衣服，就能让猫猫跟着菲谢尔和奥兹旅行了。"
                                },
                                {
                                    "id": "705440131",
                                    "speaker": "「阿呆」",
                                    "text": "喵？",
                                    "choices": [
                                        {
                                            "id": "705440132",
                                            "text": "先给我啊！当然先给我啊！",
                                            "response": [
                                                {
                                                    "id": "705440134",
                                                    "speaker": "派蒙",
                                                    "text": "不过仔细想想，元素力超级超级厉害，随随便便就能找到抵抗元素力的材料…哪有那么好的事。"
                                                },
                                                {
                                                    "id": "705440135",
                                                    "speaker": "派蒙",
                                                    "text": "我们俩也不要做白日梦了啦。"
                                                },
                                                {
                                                    "id": "705440136",
                                                    "speaker": "菲谢尔",
                                                    "text": "天真！勿要以常理估量猫之眷属的才能！凡人的只言片语难以概括它们的特质。"
                                                },
                                                {
                                                    "id": "705440137",
                                                    "speaker": "菲谢尔",
                                                    "text": "此世的某地或许存在…能潜入水下，耐受烈火，能乘风而行的猫之眷属，必然也有无惧轰雷的特殊个体。"
                                                },
                                                {
                                                    "id": "705440138",
                                                    "speaker": "菲谢尔",
                                                    "text": "只要本皇女耐心寻找，定然不会错过，至多再等十年百年，不过幽夜净土时钟上的片刻光阴！"
                                                },
                                                {
                                                    "id": "705440139",
                                                    "speaker": "菲谢尔",
                                                    "text": "此外，后天的修行也相当重要，我看「阿呆」颇有潜质，说不定跟着本皇女一段时间后，对雷之力就会愈发熟悉。"
                                                },
                                                {
                                                    "id": "705440140",
                                                    "speaker": "菲谢尔",
                                                    "text": "正巧本皇女理清了万千繁杂事务，近来还算空闲，不妨在此多多观察猫之眷属们…尤其是「阿呆」！"
                                                },
                                                {
                                                    "id": "705440141",
                                                    "speaker": "「阿呆」",
                                                    "text": "喵！"
                                                },
                                                {
                                                    "id": "705440142",
                                                    "speaker": "派蒙",
                                                    "text": "嘿嘿，那就祝你在「猫茸茸城堡」玩得开心啦，菲谢尔！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "705440133",
                                            "text": "我穿上它去暴打雷史莱姆！"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "705440111",
                            "text": "大猫之魔法师，前来参谒！"
                        }
                    ]
                }
            ]
        }
    ]
}