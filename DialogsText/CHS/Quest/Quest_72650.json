        }
    },
    "talks": [
        {
            "id": "7265001",
            "objective": "与涉川对话",
            "dialogues": [
                {
                    "id": "726500101",
                    "speaker": "涉川",
                    "text": "你好。我叫涉川，是武道流派「心流」的宗主。"
                },
                {
                    "id": "726500102",
                    "speaker": "涉川",
                    "text": "看你的样子应该是外国的旅行者吧。如何，对「心流」，有兴趣吗？",
                    "choices": [
                        {
                            "id": "726500103",
                            "text": "「心流」…？",
                            "response": [
                                {
                                    "id": "726500106",
                                    "speaker": "涉川",
                                    "text": "总之，这是老身独创的技术。与岩藏流、喜多院流，还有外国的「西风剑术」这些用武器战斗的流派不同，我的技术的精髓在于磨练「心流」，再利用「心流」磨练战斗技巧的流派。"
                                },
                                {
                                    "id": "726500107",
                                    "speaker": "涉川",
                                    "text": "早年流浪海外，四处钻研武道时，我曾观察过纳塔人的「拳斗术」。这种武道流派在练习时，会与假想敌战斗。"
                                },
                                {
                                    "id": "726500108",
                                    "speaker": "派蒙",
                                    "text": "「假想敌」？"
                                },
                                {
                                    "id": "726500109",
                                    "speaker": "Player",
                                    "text": "会打你的「幻想朋友」。"
                                },
                                {
                                    "id": "726500110",
                                    "speaker": "涉川",
                                    "text": "没错。幻想敌人的行动，再针对幻想做出反应。这种在当地被称为「影子拳斗」的练习技巧，在老身看来是相当孤高的修行法。"
                                },
                                {
                                    "id": "726500111",
                                    "speaker": "涉川",
                                    "text": "而「心流」就是将这种修行发挥到极致的无限制格斗流派。在老身的指导下，什么样的假想敌都能得到再现。"
                                },
                                {
                                    "id": "726500112",
                                    "speaker": "涉川",
                                    "text": "从史莱姆到落武者，甚至是那些至冬国来的异人战士。只要精通心流的心得，就轻易能再现出与其战斗的情境，从而磨练自己的战斗技术。"
                                },
                                {
                                    "id": "726500113",
                                    "speaker": "涉川",
                                    "text": "顺带一提，世界上最强的生物恐怕是「雷晶蝶」了。岩藏流前代的永胤曾经借由老身的「心流」，尝试挑战有人类体型的雷晶蝶，但就连十秒也没能撑下去。"
                                },
                                {
                                    "id": "726500114",
                                    "speaker": "涉川",
                                    "text": "不仅仅是对手，就连风向、天候、机关、乃至「地脉异常」，老身都可以通过心流模拟。可以说得上是最实用的技术了。"
                                },
                                {
                                    "id": "726500115",
                                    "speaker": "派蒙",
                                    "text": "既然心流这么厉害，为什么涉川先生要亲自挖角呢？"
                                },
                                {
                                    "id": "726500116",
                                    "speaker": "涉川",
                                    "text": "老身心流实在是太过…真实了，以至于弟子与假想敌战斗时，有时真的会受伤。"
                                },
                                {
                                    "id": "726500128",
                                    "speaker": "涉川",
                                    "text": "即使是心流幻想的「剑」，也会砍伤手脚。而心流幻想的「火铳」，甚至真的能射穿身体。"
                                },
                                {
                                    "id": "726500117",
                                    "speaker": "涉川",
                                    "text": "久而久之，不完全倾心于武道的，就因为害怕离开了心流；而不顾一切的武痴，又不应该掌握心流，被我撵走了。",
                                    "choices": [
                                        {
                                            "id": "726500118",
                                            "text": "这么厉害？",
                                            "response": [
                                                {
                                                    "id": "726500120",
                                                    "speaker": "涉川",
                                                    "text": "是啊。但我看你与心流也有缘，不如试试老身的「心流」，如何？",
                                                    "choices": [
                                                        {
                                                            "id": "726500121",
                                                            "text": "有意思…",
                                                            "response": [
                                                                {
                                                                    "id": "726500124",
                                                                    "speaker": "涉川",
                                                                    "text": "总之，如果有兴趣的话，就将眼前的平台视为心流的「土俵」吧。"
                                                                },
                                                                {
                                                                    "id": "726500125",
                                                                    "speaker": "涉川",
                                                                    "text": "而老身，会为你量身定做最适合你的「心流战场」…"
                                                                },
                                                                {
                                                                    "id": "726500126",
                                                                    "speaker": "涉川",
                                                                    "text": "只不过，小心别受伤了。毕竟…"
                                                                },
                                                                {
                                                                    "id": "726500127",
                                                                    "speaker": "涉川",
                                                                    "text": "「心流」可是很无情的。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "726500122",
                                                            "text": "没有兴趣。",
                                                            "response": [
                                                                {
                                                                    "id": "726500123",
                                                                    "speaker": "涉川",
                                                                    "text": "这样啊。那还真是可惜。"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "726500119",
                                            "text": "这么可怕？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "726500104",
                            "text": "没有兴趣。",
                            "response": [
                                {
                                    "id": "726500105",
                                    "speaker": "涉川",
                                    "text": "#别这么说嘛。{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYE|INFO_FEMALE_PRONOUN_GIRLE]}，你步伐稳健，站姿挺拔，呼吸更是毫无破绽，想必常年走在「武」的道路上吧？"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}