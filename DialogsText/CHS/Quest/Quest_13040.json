            "dialogues": [
                {
                    "id": "130400201",
                    "speaker": "赛诺",
                    "text": "风景真不错。"
                },
                {
                    "id": "130400202",
                    "speaker": "赛诺",
                    "text": "这种氛围下，应该出其不意地讲个笑话。"
                }
            ]
        },
        {
            "id": "1304099",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "130409901",
                    "speaker": "居勒什",
                    "text": "（…我也不能再把学生当小孩子看了。必须承认，赛诺已经成长得超乎我想象。）"
                },
                {
                    "id": "130409902",
                    "speaker": "居勒什",
                    "text": "（以后我啊，当个退休老贤者就好啦，年轻一辈会负担起未来的。）"
                },
                {
                    "id": "130409903",
                    "speaker": "赛诺",
                    "text": "（在想了，我在想了…）"
                }
            ]
        }
