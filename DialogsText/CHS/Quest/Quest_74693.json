    "talks": [
        {
            "id": "7469301",
            "objective": "与赛诺对话",
            "dialogues": [
                {
                    "id": "746930101",
                    "speaker": "赛诺",
                    "text": "真的不能把这套卡的卡背复制一份给我吗？"
                },
                {
                    "id": "746930102",
                    "speaker": "芭比洛斯",
                    "text": "抱歉，不可以。"
                },
                {
                    "id": "746930103",
                    "speaker": "赛诺",
                    "text": "真的很帅，可以再商量一下吗？"
                },
                {
                    "id": "746930104",
                    "speaker": "芭比洛斯",
                    "text": "不可以。"
                },
                {
                    "id": "746930105",
                    "speaker": "赛诺",
                    "text": "好吧，拿到好看的牌背和使用强力的卡牌都需要付出代价，我明白的。",
                    "choices": [
                        {
                            "id": "746930106",
                            "text": "你根本没明白。",
                            "response": [
                                {
                                    "id": "746930109",
                                    "speaker": "派蒙",
                                    "text": "喂！你根本什么也没问，直接就说出原因了吗？说不定赛诺是来…"
                                },
                                {
                                    "id": "746930110",
                                    "speaker": "赛诺",
                                    "text": "没错。不愧是我的挚友，我们已经心意相通了。"
                                },
                                {
                                    "id": "746930111",
                                    "speaker": "派蒙",
                                    "text": "还真是啊？！"
                                },
                                {
                                    "id": "746930112",
                                    "speaker": "赛诺",
                                    "text": "最近枫丹这边正在举办一场小型的牌友聚会，据说，聚会上会发放免费的限定款式卡套。"
                                },
                                {
                                    "id": "746930113",
                                    "speaker": "赛诺",
                                    "text": "教令院没有什么要紧事，所以我就过来了。"
                                },
                                {
                                    "id": "746930114",
                                    "speaker": "派蒙",
                                    "text": "就算是有要紧事，赛诺肯定也会把它变得不太要紧的吧…"
                                },
                                {
                                    "id": "746930115",
                                    "speaker": "赛诺",
                                    "text": "是的，我只加了两个星期的班，就把所有事务都处理得差不多了。"
                                },
                                {
                                    "id": "746930116",
                                    "speaker": "赛诺",
                                    "text": "赛索斯也帮忙了，他很适合做文本工作，我答应给他也带一副卡套作为补偿。"
                                },
                                {
                                    "id": "746930117",
                                    "speaker": "芭比洛斯",
                                    "text": "这位大风纪官，你到底抽不抽牌了？"
                                },
                                {
                                    "id": "746930118",
                                    "speaker": "赛诺",
                                    "text": "当然要抽。你刚才说，这张牌可以用来预测我的未来，对吧？"
                                },
                                {
                                    "id": "746930119",
                                    "speaker": "芭比洛斯",
                                    "text": "准确地说其实不是这样。不过你这么理解也没有什么太大的问题。"
                                },
                                {
                                    "id": "746930120",
                                    "speaker": "赛诺",
                                    "text": "原来是这样…这就是《决斗王》里写的「赌上命运的下一轮抽牌」吗？"
                                },
                                {
                                    "id": "746930121",
                                    "speaker": "赛诺",
                                    "text": "那么，到我的回合了，抽牌…！"
                                },
                                {
                                    "id": "746930122",
                                    "speaker": "Black Screen",
                                    "text": "赛诺深吸一口气，用帅气的姿势抽出了卡牌…"
                                },
                                {
                                    "id": "746930123",
                                    "speaker": "芭比洛斯",
                                    "text": "是逆位的「节制」啊，被你这位须弥教令院的「大风纪官」抽到，倒是不出所料。"
                                },
                                {
                                    "id": "746930124",
                                    "speaker": "Player",
                                    "text": "你之前听说过赛诺？"
                                },
                                {
                                    "id": "746930125",
                                    "speaker": "芭比洛斯",
                                    "text": "艾莉丝和我提起过几次，说古板的教令院，居然有这么一位富有幽默感的「大风纪官」，真是有趣。"
                                },
                                {
                                    "id": "746930126",
                                    "speaker": "赛诺",
                                    "text": "谢谢夸奖。我已经抽了牌，接下来该做什么？"
                                },
                                {
                                    "id": "746930127",
                                    "speaker": "芭比洛斯",
                                    "text": "既然是逆位的「节制」，或者说逆位的「技艺」，那我会建议，你最好先保持「什么都不做」的状态。"
                                },
                                {
                                    "id": "746930128",
                                    "speaker": "芭比洛斯",
                                    "text": "你行事过于急躁匆忙，几乎要在命运的独木桥上失去平衡了。"
                                },
                                {
                                    "id": "746930129",
                                    "speaker": "赛诺",
                                    "text": "是我打牌太没有节制了吗？赛索斯和提纳里也这么说过我，我已经调整好时间表了。"
                                },
                                {
                                    "id": "746930130",
                                    "speaker": "芭比洛斯",
                                    "text": "…我不是说打牌。我是说工作时间。能够让你这位「大风纪官」全力应对的事，应该不止是「七圣召唤」吧？"
                                },
                                {
                                    "id": "746930131",
                                    "speaker": "赛诺",
                                    "text": "除打牌之外，我的时间安排，基本上没有一丝一毫「调整」的余地。"
                                },
                                {
                                    "id": "746930132",
                                    "speaker": "芭比洛斯",
                                    "text": "如此安排所带来的压力，你习惯了独自承担。"
                                },
                                {
                                    "id": "746930133",
                                    "speaker": "赛诺",
                                    "text": "还有诸位风纪官同僚，我们会一起承担。"
                                },
                                {
                                    "id": "746930134",
                                    "speaker": "芭比洛斯",
                                    "text": "但他们都指望着你。不止是风纪官，教令院的学者，须弥的民众…许多人，都指望着你这位「大风纪官」。"
                                },
                                {
                                    "id": "746930135",
                                    "speaker": "芭比洛斯",
                                    "text": "没人会提起这件事，或者，他们都没有意识到自己内心的这份想法…毕竟他们都被你的幽默感吸引住了。"
                                },
                                {
                                    "id": "746930136",
                                    "speaker": "芭比洛斯",
                                    "text": "但你却每时每刻都能感受到那些目光…喔，还有那位与你同行的「影子」，他也是重担之一。"
                                },
                                {
                                    "id": "746930137",
                                    "speaker": "赛诺",
                                    "text": "……"
                                },
                                {
                                    "id": "746930138",
                                    "speaker": "芭比洛斯",
                                    "text": "你习惯了走在最前方，接过一个又一个重担…我想，或许这才是你「失衡」的原因。"
                                },
                                {
                                    "id": "746930139",
                                    "speaker": "赛诺",
                                    "text": "我有许多朋友，还有「七圣召唤」。"
                                },
                                {
                                    "id": "746930140",
                                    "speaker": "芭比洛斯",
                                    "text": "看来，你并不打算休息。"
                                },
                                {
                                    "id": "746930141",
                                    "speaker": "赛诺",
                                    "text": "还没到能够休息的时候。"
                                },
                                {
                                    "id": "746930142",
                                    "speaker": "芭比洛斯",
                                    "text": "确实，对你这样的人来说，如果内心的鏖战无休无止，那么哪怕是死亡之日，亦不是职责的终结之时。"
                                },
                                {
                                    "id": "746930143",
                                    "speaker": "芭比洛斯",
                                    "text": "收下这张「月谕圣牌」吧。或许它能指引你，找到那个足以让你重拾平衡的「理由」。"
                                },
                                {
                                    "id": "746930144",
                                    "speaker": "芭比洛斯",
                                    "text": "在那个时候，你内心的鏖战，应该也会走向最终的决战。",
                                    "choices": [
                                        {
                                            "id": "746930145",
                                            "text": "赛诺不会输的。",
                                            "response": [
                                                {
                                                    "id": "746930147",
                                                    "speaker": "赛诺",
                                                    "text": "#谢谢你，{NICKNAME}，派蒙。"
                                                },
                                                {
                                                    "id": "746930148",
                                                    "speaker": "赛诺",
                                                    "text": "也谢谢您，这张牌我收下了。我保证，不会把它带进梅洛彼得堡。"
                                                },
                                                {
                                                    "id": "746930149",
                                                    "speaker": "派蒙",
                                                    "text": "…哈？怎么莫名其妙的，等一下，难道说——",
                                                    "choices": [
                                                        {
                                                            "id": "746930150",
                                                            "text": "怎么又来了！",
                                                            "response": [
                                                                {
                                                                    "id": "746930153",
                                                                    "speaker": "芭比洛斯",
                                                                    "text": "…这和梅洛彼得堡有什么关系？"
                                                                },
                                                                {
                                                                    "id": "746930154",
                                                                    "speaker": "赛诺",
                                                                    "text": "因为这是…"
                                                                },
                                                                {
                                                                    "id": "746930155",
                                                                    "speaker": "赛诺",
                                                                    "text": "「越狱」圣牌。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "746930151",
                                                            "text": "转换得好快！"
                                                        },
                                                        {
                                                            "id": "746930152",
                                                            "text": "芭比洛斯女士，您不要——"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "746930146",
                                            "text": "赛诺是最强的。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "746930107",
                            "text": "我根本不明白！"
                        },
                        {
                            "id": "746930108",
                            "text": "你怎么来这里打牌了？"
                        }
                    ]
                }
            ]
        },
