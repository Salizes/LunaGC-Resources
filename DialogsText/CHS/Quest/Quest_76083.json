    "talks": [
        {
            "id": "7608301",
            "objective": "同「少女」见面",
            "dialogues": [
                {
                    "id": "760830101",
                    "speaker": "月灵",
                    "text": "~！"
                },
                {
                    "id": "760830102",
                    "speaker": "月灵",
                    "text": "！！"
                },
                {
                    "id": "760830103",
                    "speaker": "「少女」",
                    "text": "我刚好在和月灵们玩猜图案的游戏，要加入吗？"
                }
            ]
        },
        {
            "id": "7608302",
            "objective": "同月灵玩耍",
            "dialogues": [
                {
                    "id": "760830701",
                    "speaker": "Black Screen",
                    "text": "游戏结束后，月灵们一如既往地扑到了你身上，看起来十分开心。"
                },
                {
                    "id": "760830702",
                    "speaker": "「少女」",
                    "text": "谢谢你们愿意陪月灵们玩游戏。"
                },
                {
                    "id": "760830703",
                    "speaker": "「少女」",
                    "text": "希望，下次我们也能共度这样放松的时光。"
                }
            ]
        },
        {
            "id": "7605002",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "760500201",
                    "speaker": "「少女」",
                    "text": "如果你愿意的话，下次也来陪月灵们玩游戏吧。"
                }
            ]
        },
        {
            "id": "7608302",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "760830201",
                    "speaker": "<UNKNOWN>",
                    "text": "(test)台词文本"
                }
            ]
        },
        {
            "id": "7608304",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "760830401",
                    "speaker": "「少女」",
                    "text": "去吧，月灵们。"
                },
                {
                    "id": "760830402",
                    "speaker": "「少女」",
                    "text": "猜猜看这是什么图案。",
                    "choices": [
                        {
                            "id": "760830403",
                            "text": "月亮。",
                            "response": [
                                {
                                    "id": "760830404",
                                    "speaker": "月灵",
                                    "text": "！！"
                                },
                                {
                                    "id": "760830405",
                                    "speaker": "派蒙",
                                    "text": "哼哼，这次还是挺明显的嘛。"
                                },
                                {
                                    "id": "760830406",
                                    "speaker": "「少女」",
                                    "text": "对我们来说，这个谜底有些过于简单了。"
                                }
                            ]
                        },
                        {
                            "id": "760830407",
                            "text": "陆鳗鳗。",
                            "response": [
                                {
                                    "id": "760830408",
                                    "speaker": "派蒙",
                                    "text": "这次的这位是腰部出了问题？！"
                                },
                                {
                                    "id": "760830409",
                                    "speaker": "「少女」",
                                    "text": "你们的见闻真的非常丰富呢…"
                                },
                                {
                                    "id": "760830410",
                                    "speaker": "「少女」",
                                    "text": "正确答案是月亮。"
                                },
                                {
                                    "id": "760830411",
                                    "speaker": "「少女」",
                                    "text": "回来吧，做得很好哦。"
                                }
                            ]
                        },
                        {
                            "id": "760830412",
                            "text": "圆弧。",
                            "response": [
                                {
                                    "id": "760830413",
                                    "speaker": "派蒙",
                                    "text": "谁都看得出来是圆弧吧！那么简单的结论怎么可能是正确答案啦！"
                                },
                                {
                                    "id": "760830414",
                                    "speaker": "「少女」",
                                    "text": "的确不能说有错，可惜这并不是月灵们的本意。"
                                },
                                {
                                    "id": "760830415",
                                    "speaker": "「少女」",
                                    "text": "正确答案是月亮。"
                                },
                                {
                                    "id": "760830416",
                                    "speaker": "「少女」",
                                    "text": "回来吧，做得很好哦。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7608305",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "760830501",
                    "speaker": "「少女」",
                    "text": "去吧，月灵们。"
                },
                {
                    "id": "760830502",
                    "speaker": "「少女」",
                    "text": "猜猜看这是什么图案吧。",
                    "choices": [
                        {
                            "id": "760830503",
                            "text": "重拳出击鸭。",
                            "response": [
                                {
                                    "id": "760830504",
                                    "speaker": "月灵",
                                    "text": "！！"
                                },
                                {
                                    "id": "760830505",
                                    "speaker": "派蒙",
                                    "text": "你这到底是怎么看出来的？"
                                },
                                {
                                    "id": "760830506",
                                    "speaker": "「少女」",
                                    "text": "原来它叫这个名字。它也会把那位机械师放在手上，盛着她到处走吗？"
                                },
                                {
                                    "id": "760830507",
                                    "speaker": "派蒙",
                                    "text": "你的想象中好像混入了前同事的影子…"
                                }
                            ]
                        },
                        {
                            "id": "760830508",
                            "text": "吃圆了肚子的盗宝鼬。",
                            "response": [
                                {
                                    "id": "760830509",
                                    "speaker": "派蒙",
                                    "text": "都吃成这样了，它还盗得了宝吗？"
                                },
                                {
                                    "id": "760830510",
                                    "speaker": "「少女」",
                                    "text": "或者说已经用不着去偷东西了吧？"
                                },
                                {
                                    "id": "760830511",
                                    "speaker": "「少女」",
                                    "text": "正确答案是…爱诺工坊附近的大大的机械鸭子。"
                                },
                                {
                                    "id": "760830512",
                                    "speaker": "「少女」",
                                    "text": "回来吧，辛苦你们了。"
                                }
                            ]
                        },
                        {
                            "id": "760830513",
                            "text": "烧瓶。",
                            "response": [
                                {
                                    "id": "760830514",
                                    "speaker": "派蒙",
                                    "text": "月灵们真拼命啊，为了摆游戏用的图案，还要专门观察和研究实验器材！"
                                },
                                {
                                    "id": "760830515",
                                    "speaker": "「少女」",
                                    "text": "答案很接近了。"
                                },
                                {
                                    "id": "760830516",
                                    "speaker": "「少女」",
                                    "text": "正确答案是…爱诺工坊附近的大大的机械鸭子。"
                                },
                                {
                                    "id": "760830517",
                                    "speaker": "派蒙",
                                    "text": "这哪里接近了！"
                                },
                                {
                                    "id": "760830518",
                                    "speaker": "「少女」",
                                    "text": "回来吧，辛苦你们了。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7608306",
