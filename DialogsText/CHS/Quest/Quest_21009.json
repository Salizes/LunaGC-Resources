            "dialogues": [
                {
                    "id": "210090101",
                    "speaker": "Player",
                    "text": "我明白了。"
                },
                {
                    "id": "210090102",
                    "speaker": "朱老板",
                    "text": "我只记得，那是一种香甜可口的美味料理。有着看着就让人垂涎欲滴的外型，营养也十分丰富…"
                },
                {
                    "id": "210090103",
                    "speaker": "朱老板",
                    "text": "食材有：大量的禽肉，和甜甜花。名字好像是叫…什么花什么鸡来着。如果能做出来交给我的话，就太感谢了。"
                },
                {
                    "id": "210090104",
                    "speaker": "朱老板",
                    "text": "旅行者，接下来就看你的了。"
                }
            ]
        },
        {
            "id": "2100910",
            "objective": "与朱老板对话$HIDDEN",
            "dialogues": []
        },
        {
            "id": "2100920",
            "objective": "将「什么花什么鸡」带给朱老板",
            "dialogues": []
        },
        {
            "id": "2100930",
            "objective": "与朱老板对话",
            "dialogues": [
                {
                    "id": "210093001",
                    "speaker": "朱老板",
                    "text": "太感谢你了，旅行者，这是给你的答谢，请收下吧。"
                }
            ]
        },
        {
            "id": "2100920",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "210092006",
                    "speaker": "朱老板",
                    "text": "啊哈！就是这个，就是这个味道！"
                },
                {
                    "id": "210092007",
                    "speaker": "朱老板",
                    "text": "我要去试试，能不能自己做出来这道料理…"
                },
                {
                    "id": "210092008",
                    "speaker": "朱老板",
                    "text": "不…尝起来和看起来，都不太像是那个料理…"
                },
                {
                    "id": "210092099",
                    "speaker": "朱老板",
                    "text": "这样吧，我再提示你一遍…"
                },
                {
                    "id": "210092009",
                    "speaker": "朱老板",
                    "text": "先来尝尝看…"
                },
                {
                    "id": "210092010",
                    "speaker": "朱老板",
                    "text": "嗯…这个…"
                }
            ]
        },
        {
            "id": "2100990",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "210099001",
                    "speaker": "朱老板",
                    "text": "记忆中的味道…"
                },
                {
                    "id": "210099002",
                    "speaker": "朱老板",
                    "text": "要怎样才能重现呢？"
                }
            ]
        }
