    },
    "talks": [
        {
            "id": "7220401",
            "objective": "跟奶奶讲话（test）$HIDDEN",
            "dialogues": [
                {
                    "id": "722040101",
                    "speaker": "宇奈",
                    "text": "木户，木奈，你们来啦…？"
                },
                {
                    "id": "722040102",
                    "speaker": "宇奈",
                    "text": "真是的…又到处乱跑，我的腿脚可跟不上你们啦…要是遇到危险该怎么办呀…",
                    "choices": [
                        {
                            "id": "722040103",
                            "text": "您好…？",
                            "response": [
                                {
                                    "id": "722040105",
                                    "speaker": "宇奈",
                                    "text": "欸哟！你们真是…你们还小，可不要说这种话呀，这样太伤老人家的心了…"
                                },
                                {
                                    "id": "722040106",
                                    "speaker": "宇奈",
                                    "text": "既然来了，就先别乱跑乱玩啦…也来陪陪奶奶，好不好？",
                                    "choices": [
                                        {
                                            "id": "722040107",
                                            "text": "抱歉，我…",
                                            "response": [
                                                {
                                                    "id": "722040109",
                                                    "speaker": "宇奈",
                                                    "text": "上次那个故事讲到哪里了…？啊，对了…那是你们的爷爷的爷爷年纪还小的时候咯…"
                                                },
                                                {
                                                    "id": "722040110",
                                                    "speaker": "宇奈",
                                                    "text": "在雾海之外、外人的岛屿上，有一支氏族叫做夷摩美氏…他们的主母，是一个狐狸样的女人…"
                                                },
                                                {
                                                    "id": "722040111",
                                                    "speaker": "宇奈",
                                                    "text": "他们说，那边的土地上，生满了雷色的花朵…夷摩美氏的族人们，就在那样的高山与田野间筑屋生活，相爱相乐…"
                                                },
                                                {
                                                    "id": "722040112",
                                                    "speaker": "宇奈",
                                                    "text": "然后呀…哈…他们的花呀…哈…呼…"
                                                },
                                                {
                                                    "id": "722040113",
                                                    "speaker": "宇奈",
                                                    "text": "呼…呼…雾海的外面呀…嗯…",
                                                    "choices": [
                                                        {
                                                            "id": "722040114",
                                                            "text": "老婆婆…？您还好吗？",
                                                            "response": [
                                                                {
                                                                    "id": "722040116",
                                                                    "speaker": "宇奈",
                                                                    "text": "欸…木户？木奈？哦…你们要走了？唉…真不好意思，奶奶又自顾自地睡着了…"
                                                                },
                                                                {
                                                                    "id": "722040117",
                                                                    "speaker": "宇奈",
                                                                    "text": "临走之前，别忘了这个呀…奶奶一直为你们珍藏着呢…这是雾海之外另一边来的好看的花…可不要丢了哟。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "722040115",
                                                            "text": "（还是不要打扰她了…）"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "722040108",
                                            "text": "好吧…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "722040104",
                            "text": "可能您认错人了…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7220408",
            "objective": "自然日刷新2$HIDDEN",
            "dialogues": [
                {
                    "id": "722040801",
                    "speaker": "宇奈",
                    "text": "木户和木奈哟…还在这座岛上吧？"
                },
                {
                    "id": "722040802",
                    "speaker": "宇奈",
                    "text": "小孩子呀…真是放不下心呀…"
                }
            ]
        },
        {
            "id": "7220402",
            "objective": "跟奶奶讲话（test）$HIDDEN",
            "dialogues": [
                {
                    "id": "722040301",
                    "speaker": "宇奈",
                    "text": "唉…越来越不清楚了…越来越记不清事情了呀…",
                    "choices": [
                        {
                            "id": "722040302",
                            "text": "您好？",
                            "response": [
                                {
                                    "id": "722040304",
                                    "speaker": "宇奈",
                                    "text": "唉…记性越来越差了。人老了，越来越多的事情，记不住了呀…"
                                },
                                {
                                    "id": "722040305",
                                    "speaker": "宇奈",
                                    "text": "这样怎么可好呀…也不知道木户和木奈有没有饿着，在外面玩安不安全…",
                                    "choices": [
                                        {
                                            "id": "722040306",
                                            "text": "他们不会有事的。",
                                            "response": [
                                                {
                                                    "id": "722040308",
                                                    "speaker": "宇奈",
                                                    "text": "木户，木奈！你们怎么才来呀…在路上有没有摔着碰着？没有又去爬树吧…？"
                                                },
                                                {
                                                    "id": "722040309",
                                                    "speaker": "宇奈",
                                                    "text": "真是让奶奶担心坏了…唉，最近不知发生了什么，岛上的人越来越少了…"
                                                },
                                                {
                                                    "id": "722040310",
                                                    "speaker": "宇奈",
                                                    "text": "我还记得名字的人呢，更少了…"
                                                },
                                                {
                                                    "id": "722040311",
                                                    "speaker": "宇奈",
                                                    "text": "唉，要是什么时候，奶奶把你们也忘记了…那该怎么办呀…"
                                                },
                                                {
                                                    "id": "722040312",
                                                    "speaker": "Player",
                                                    "text": "……"
                                                },
                                                {
                                                    "id": "722040313",
                                                    "speaker": "宇奈",
                                                    "text": "唉…这些花瓣给你们，什么时候呀，要是奶奶把你们忘了，就给我看这个吧…"
                                                },
                                                {
                                                    "id": "722040314",
                                                    "speaker": "宇奈",
                                                    "text": "奶奶还有好多故事要给你们讲呢…"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "722040307",
                                            "text": "我能帮得上忙吗？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "722040303",
                            "text": "发生什么事了吗？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7220409",
            "objective": "自然日刷新3$HIDDEN",
            "dialogues": [
                {
                    "id": "722040901",
                    "speaker": "宇奈",
                    "text": "你来了呀…呵呵，真是的，木户，木奈！"
                },
                {
                    "id": "722040902",
                    "speaker": "宇奈",
                    "text": "他们又跑去不知哪里玩了吧，真是的…不好意思呀。"
                },
                {
                    "id": "722040903",
                    "speaker": "宇奈",
                    "text": "对了…你叫…什么来着？",
                    "choices": [
                        {
                            "id": "722040904",
                            "text": "#{NICKNAME}，您好。",
                            "response": [
                                {
                                    "id": "722040906",
                                    "speaker": "宇奈",
                                    "text": "唉…我…快要离开了，对吧？"
                                },
                                {
                                    "id": "722040907",
                                    "speaker": "Player",
                                    "text": "离开…？"
                                },
                                {
                                    "id": "722040908",
                                    "speaker": "宇奈",
                                    "text": "那个撑船的人，最近一直来催我呢。"
                                },
                                {
                                    "id": "722040909",
                                    "speaker": "宇奈",
                                    "text": "每次都会静静地过来，穿着金的毛皮衣服，金的长裤子，头上戴着金丝的冠…"
                                },
                                {
                                    "id": "722040910",
                                    "speaker": "宇奈",
                                    "text": "就像妈妈给我讲的，就像我给木户和木奈讲的那样…带我们登上银璨璨的船哟…"
                                },
                                {
                                    "id": "722040911",
                                    "speaker": "宇奈",
                                    "text": "在闪亮亮的河上荡呀荡呀…就到了梦中。梦的土地没有迷雾，那里有一座金色的大屋子…有七十个，又七十个的摇篮…摇啊摇，摇啊摇…"
                                },
                                {
                                    "id": "722040912",
                                    "speaker": "宇奈",
                                    "text": "我们安眠在那里，就化成了点点的光…然后呀，就化成了大地上小孩子的梦…",
                                    "choices": [
                                        {
                                            "id": "722040913",
                                            "text": "哇……",
                                            "response": [
                                                {
                                                    "id": "722040915",
                                                    "speaker": "宇奈",
                                                    "text": "撑船的人说…他替木户和木奈转交了这些给我。呵呵…这两个孩子呀…"
                                                },
                                                {
                                                    "id": "722040916",
                                                    "speaker": "宇奈",
                                                    "text": "还不是时候哟…还不是时候呢…"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "722040914",
                                            "text": "您的意思是…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "722040905",
                            "text": "#我是{NICKNAME}呀。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7220403",
            "objective": "跟奶奶讲话（test）$HIDDEN",
            "dialogues": [
                {
                    "id": "722040501",
                    "speaker": "宇奈",
                    "text": "是阿部呀。家里蘑菇收成如何？呵呵…你可不要再去打扰祭司大人咯，他再劝我也是不会同意的！"
                },
                {
                    "id": "722040502",
                    "speaker": "宇奈",
                    "text": "呵呵，对不起啦！一个人养家而已，我怎么就忙不过来了？呵呵，对不起啦…"
                },
                {
                    "id": "722040503",
                    "speaker": "宇奈",
                    "text": "对不起啦…唉…对不起啦…",
                    "choices": [
                        {
                            "id": "722040504",
                            "text": "您好，老婆婆。",
                            "response": [
                                {
                                    "id": "722040506",
                                    "speaker": "宇奈",
                                    "text": "啊…！是你呀！真是的…羞不羞人！快进来！",
                                    "choices": [
                                        {
                                            "id": "722040507",
                                            "text": "呃…？",
                                            "response": [
                                                {
                                                    "id": "722040509",
                                                    "speaker": "宇奈",
                                                    "text": "在外面的渔获如何…？没有打到鱼吗…没关系，没关系，靠家里的园垄也足够了。只是给雷鸟大人的奉献没办法足额了…嗯，怎么了？"
                                                },
                                                {
                                                    "id": "722040510",
                                                    "speaker": "宇奈",
                                                    "text": "你在犯什么傻！今年的祭典明明很顺利，接下来的年景一定都不错…祭司大人也说我们会有个强壮的孩子…"
                                                },
                                                {
                                                    "id": "722040511",
                                                    "speaker": "宇奈",
                                                    "text": "可为什么突然跟我说这种事！你忘了釜氏的下场吗！",
                                                    "choices": [
                                                        {
                                                            "id": "722040512",
                                                            "text": "请您冷静一点！",
                                                            "response": [
                                                                {
                                                                    "id": "722040514",
                                                                    "speaker": "宇奈",
                                                                    "text": "如果你也想要离弃雷鸟大人，被狂怒的海浪吞噬的话，那就随便你去吧！"
                                                                },
                                                                {
                                                                    "id": "722040515",
                                                                    "speaker": "宇奈",
                                                                    "text": "我的孩子…可怜的孩子…唉…"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "722040513",
                                                            "text": "「釜」…？"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "722040508",
                                            "text": "唔……"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "722040505",
                            "text": "请问您还好吗？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7220410",
            "objective": "自然日刷新4$HIDDEN",
            "dialogues": [
                {
                    "id": "722041001",
                    "speaker": "宇奈",
                    "text": "唉…孩子们呀…"
                },
                {
                    "id": "722041002",
                    "speaker": "Player",
                    "text": "我替木户和木奈将这个转交给您。"
                }
            ]
        },
        {
            "id": "7220404",
            "objective": "跟奶奶讲话（test）$HIDDEN",
            "dialogues": [
                {
                    "id": "722040701",
                    "speaker": "宇奈",
                    "text": "你好，你好…"
                },
                {
                    "id": "722040702",
                    "speaker": "宇奈",
                    "text": "唉，对不起呀，年纪大了头脑难免不清楚…请问你是谁呀…？我曾认识你吗？",
                    "choices": [
                        {
                            "id": "722040703",
                            "text": "#我是{NICKNAME}。",
                            "response": [
                                {
                                    "id": "722040705",
                                    "speaker": "宇奈",
                                    "text": "没听说过的名字呢…是外面来的人？"
                                },
                                {
                                    "id": "722040706",
                                    "speaker": "宇奈",
                                    "text": "奇怪，奇怪…没有雷鸟大人的准许，应该没有人能随随便便来到岛上呀…",
                                    "choices": [
                                        {
                                            "id": "722040707",
                                            "text": "雷鸟早已不在了…",
                                            "response": [
                                                {
                                                    "id": "722040709",
                                                    "speaker": "宇奈",
                                                    "text": "唉…看见你，就让我想起我可怜的丈夫…可现在，我却连他的样子都记不起来了…"
                                                },
                                                {
                                                    "id": "722040710",
                                                    "speaker": "宇奈",
                                                    "text": "那时候我们都还年轻，脑子里都是些不切实际的幻想…但有些人，即使在一起过日子久了，也不会长大半点…"
                                                },
                                                {
                                                    "id": "722040711",
                                                    "speaker": "宇奈",
                                                    "text": "他离我而去，扎了一条木筏想要渡海去另一边，外人的岛上…他说他想要在那里自由地捕猎，采摘没见过的花…好看的花…"
                                                },
                                                {
                                                    "id": "722040712",
                                                    "speaker": "宇奈",
                                                    "text": "从小时候他就这样说…但他从来没有长大过。"
                                                },
                                                {
                                                    "id": "722040713",
                                                    "speaker": "宇奈",
                                                    "text": "后来，祭司大人的孩子在海滩上看见了他…卧在那里，贝壳一样安静，比海砂还要白…这些花瓣，就握在他的手里…"
                                                },
                                                {
                                                    "id": "722040714",
                                                    "speaker": "宇奈",
                                                    "text": "祭司大人哭了，和我说…先祖的船拒绝了他。他的「灵」此后只能徘徊在外人的土地上了…"
                                                },
                                                {
                                                    "id": "722040715",
                                                    "speaker": "宇奈",
                                                    "text": "那时我才刚刚生下我们的孩子…这种事情，我要怎么与他说才好呢…"
                                                },
                                                {
                                                    "id": "722040716",
                                                    "speaker": "Player",
                                                    "text": "……"
                                                },
                                                {
                                                    "id": "722040717",
                                                    "speaker": "宇奈",
                                                    "text": "后来呀…我的孩子也有了孩子，再后来，我也送孩子们登上了银璨璨的船…但我依然在这个大地上活着…"
                                                },
                                                {
                                                    "id": "722040718",
                                                    "speaker": "宇奈",
                                                    "text": "我的牵挂呀…也就只有了木户与木奈…"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "722040708",
                                            "text": "很难和您解释其中原因…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "722040704",
                            "text": "#您好，叫我{NICKNAME}就好。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7220411",
            "objective": "自然日刷新5$HIDDEN",
            "dialogues": [
                {
                    "id": "722041101",
                    "speaker": "宇奈",
                    "text": "不好意思呀…我还不能登船呢…"
                },
                {
                    "id": "722041102",
                    "speaker": "宇奈",
                    "text": "我还有牵挂的人没有上船呢…"
                }
            ]
        },
        {
            "id": "7220405",
            "objective": "跟奶奶讲话（test）$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7220406",
            "objective": "寻找这个味道的花（test）$HIDDEN",
            "dialogues": [
                {
                    "id": "722040601",
                    "speaker": "宇奈",
                    "text": "这样吗…你说他的手里握着…这些？"
                },
                {
                    "id": "722040602",
                    "speaker": "宇奈",
                    "text": "究竟在想什么呀…你究竟在想些什么呢…"
                }
            ]
        },
        {
            "id": "7220407",
            "objective": "跟奶奶讲话（test）$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7220412",
            "objective": "跟奶奶讲话（test）$HIDDEN",
            "dialogues": [
                {
                    "id": "722041201",
                    "speaker": "宇奈",
                    "text": "这个…这个气味是…木户那孩子的香包…有这两个孩子的气味呢…"
                },
                {
                    "id": "722041202",
                    "speaker": "宇奈",
                    "text": "所以…他们终于玩累了，要离开了，是吗？"
                },
                {
                    "id": "722041203",
                    "speaker": "Player",
                    "text": "我不是很懂，但应该是的…"
                },
                {
                    "id": "722041204",
                    "speaker": "宇奈",
                    "text": "谢谢你了，外来的人…再见。"
                },
                {
                    "id": "722041205",
                    "speaker": "宇奈",
                    "text": "银璨璨的柏树林，睡梦的河…请你引我去那边吧，撑船的人…"
                }
            ]
        },
        {
            "id": "7220402",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "722040201",
                    "speaker": "宇奈",
                    "text": "好啦…好啦…也让奶奶睡一会吧…嗯…呼…呼…"
                },
                {
                    "id": "722040202",
                    "speaker": "宇奈",
                    "text": "你们可小心点…别跑太远了…呼…呼…"
                }
            ]
        },
        {
            "id": "7220404",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "722040401",
                    "speaker": "宇奈",
                    "text": "去玩吧，去玩吧…奶奶不会离开的。"
                },
                {
                    "id": "722040402",
                    "speaker": "宇奈",
                    "text": "花瓣呀…花瓣哟…你的故乡，是什么样子呢…？"
                }
            ]
        }
    ]
}