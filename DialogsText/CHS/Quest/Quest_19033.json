    "talks": [
        {
            "id": "1903301",
            "objective": "独自寻找妖邪的线索",
            "dialogues": [
                {
                    "id": "1903201201",
                    "speaker": "周良",
                    "text": "唉，好累，终于可以休息了。"
                },
                {
                    "id": "1903201202",
                    "speaker": "周良",
                    "text": "是不是有点过火了呢，好像有几个人被吓破胆了。"
                },
                {
                    "id": "1903201203",
                    "speaker": "Player",
                    "text": "请问你是？"
                },
                {
                    "id": "1903201204",
                    "speaker": "周良",
                    "text": "啊啊，这里不应该靠近！"
                },
                {
                    "id": "1903201205",
                    "speaker": "周良",
                    "text": "唉，算了，被你听到了吧？"
                },
                {
                    "id": "1903201206",
                    "speaker": "周良",
                    "text": "我就是在这里扮演鬼怪的工作人员，现在轮到我休息，所以又热又不透气的衣服被我脱掉了。",
                    "choices": [
                        {
                            "id": "1903201207",
                            "text": "果然这里没有鬼吧？",
                            "response": [
                                {
                                    "id": "1903201209",
                                    "speaker": "周良",
                                    "text": "是啊，怎么可能会有真正的鬼？"
                                },
                                {
                                    "id": "1903201210",
                                    "speaker": "周良",
                                    "text": "无论是我们，还是来参加试胆大会的人，都不希望看到真正的鬼吧。"
                                },
                                {
                                    "id": "1903201211",
                                    "speaker": "周良",
                                    "text": "他们想要的，只是一种氛围，或者说，契机。最重要的是刺激的感觉。"
                                },
                                {
                                    "id": "1903201212",
                                    "speaker": "周良",
                                    "text": "在提心吊胆中，遭遇一些意外，顺势说出平时不敢说的话，这就是试胆大会的作用。",
                                    "choices": [
                                        {
                                            "id": "1903201213",
                                            "text": "我觉得也是。",
                                            "response": [
                                                {
                                                    "id": "1903201215",
                                                    "speaker": "周良",
                                                    "text": "好了，我差不多该继续工作了，你和你的朋友也要玩的开心哦。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "1903201214",
                                            "text": "（重云应该很失望。）"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "1903201208",
                            "text": "都只是吓唬人的对吧？"
                        }
                    ]
                }
            ]
        }
    ]
}