    "talks": [
        {
            "id": "7054801",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "705480101",
                    "speaker": "丽莎",
                    "text": "啊呀，看样子，赫塔回去忙了，格兰菲狄也不在…饮品小站完全由小可爱接管了？",
                    "choices": [
                        {
                            "id": "705480102",
                            "text": "没错，正是在下！",
                            "response": [
                                {
                                    "id": "705480104",
                                    "speaker": "丽莎",
                                    "text": "好呀~我可以放心点单啦，而不用担心…喝到后勤小队的神奇特调，整夜翻来覆去，完全没有睡意，只好熬夜工作。",
                                    "choices": [
                                        {
                                            "id": "705480105",
                                            "text": "熬夜工作都是过去式了吧？",
                                            "response": [
                                                {
                                                    "id": "705480107",
                                                    "speaker": "丽莎",
                                                    "text": "没错哦，现在的我只是一个清闲的图书管理员。"
                                                },
                                                {
                                                    "id": "705480108",
                                                    "speaker": "丽莎",
                                                    "text": "要是借阅逾期的人再少一点，不用我费心费力去上门追回，我就能早点来和小可爱闲聊，多试试你的杰作。",
                                                    "choices": [
                                                        {
                                                            "id": "705480109",
                                                            "text": "那，今天想喝点什么？",
                                                            "response": [
                                                                {
                                                                    "id": "705480111",
                                                                    "speaker": "丽莎",
                                                                    "text": "我想想哦…我没有特别偏爱的配方，请给我一杯恢复元气，改善心情的特调。"
                                                                },
                                                                {
                                                                    "id": "705480112",
                                                                    "speaker": "丽莎",
                                                                    "text": "能让我以松弛、闲适的状态入睡，就再好不过啦。"
                                                                },
                                                                {
                                                                    "id": "705480113",
                                                                    "speaker": "Player",
                                                                    "text": "（饮品小站已经有很多经典配方了，先从这些里边选一种吧…）"
                                                                },
                                                                {
                                                                    "id": "705480114",
                                                                    "speaker": "Player",
                                                                    "text": "（丽莎想要恢复元气，「雪韵晨晖」似乎是个不错的选择…）"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "705480110",
                                                            "text": "有什么特别的口味要求吗？"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "705480106",
                                            "text": "丽莎现在应该不会这么忙了？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "705480103",
                            "text": "荣誉调饮师为您效劳！"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7054802",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7054803",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "705480301",
                    "speaker": "Player",
                    "text": "完成了，专为丽莎调制的新品…"
                },
                {
                    "id": "705480302",
                    "speaker": "Player",
                    "text": "目标是让丽莎早早入睡，做个安稳踏实的梦，就叫它「安梦蔷薇」好了。"
                },
                {
                    "id": "705480303",
                    "speaker": "丽莎",
                    "text": "从色彩搭配到杯型都有调整，和第一杯的风格完全不同了…"
                },
                {
                    "id": "705480304",
                    "speaker": "丽莎",
                    "text": "单论外观，的确是我喜欢的类型，就让我尝尝它的风味吧。"
                },
                {
                    "id": "705480305",
                    "speaker": "丽莎",
                    "text": "嗯…满分。"
                },
                {
                    "id": "705480306",
                    "speaker": "丽莎",
                    "text": "就像是…享用了贵重的甜品后，沿着果酒湖畔散步，吹着轻柔的湖风，松弛而悠闲…"
                },
                {
                    "id": "705480307",
                    "speaker": "丽莎",
                    "text": "真真切切驱离了疲惫感，又不至于太过亢奋。"
                },
                {
                    "id": "705480308",
                    "speaker": "丽莎",
                    "text": "呵~困意已经上来了，作为睡前的饮品，效果实在太棒…"
                },
                {
                    "id": "705480309",
                    "speaker": "丽莎",
                    "text": "值得我专门写一篇短文，来称赞这杯特调，并将小可爱的名字冠上「调饮新天才」的称号。",
                    "choices": [
                        {
                            "id": "705480310",
                            "text": "不用那么正式。",
                            "response": [
                                {
                                    "id": "705480312",
                                    "speaker": "丽莎",
                                    "text": "说起来，确实可以找个天气晴朗干爽，阳光又不太燥热的日子，在湖边散散步呢。"
                                },
                                {
                                    "id": "705480313",
                                    "speaker": "丽莎",
                                    "text": "要是有小可爱陪着我，边走边聊天，一定更闲适…"
                                },
                                {
                                    "id": "705480314",
                                    "speaker": "丽莎",
                                    "text": "等到归来的时候，再为我调上这么一杯「安梦蔷薇」，就无可挑剔啦。",
                                    "choices": [
                                        {
                                            "id": "705480315",
                                            "text": "下次一定！",
                                            "response": [
                                                {
                                                    "id": "705480317",
                                                    "speaker": "丽莎",
                                                    "text": "嗯哼~这认真的语气，我记住啦。"
                                                },
                                                {
                                                    "id": "705480318",
                                                    "speaker": "丽莎",
                                                    "text": "到时候，可不许找借口推脱哦。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "705480316",
                                            "text": "我专门空出时间来！"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "705480311",
                            "text": "丽莎喜欢就好！"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7054804",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7054805",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7054806",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "705480201",
                    "speaker": "Player",
                    "text": "这杯是「雪韵晨晖」，请慢用。"
                },
                {
                    "id": "705480202",
                    "speaker": "丽莎",
                    "text": "真不错，小可爱~"
                },
                {
                    "id": "705480203",
                    "speaker": "丽莎",
                    "text": "酸度适中，甜而不腻，入口温润，回甘轻快。"
                },
                {
                    "id": "705480204",
                    "speaker": "丽莎",
                    "text": "不过，我感觉，喝完这杯特调后，好像更有精神了…"
                },
                {
                    "id": "705480205",
                    "speaker": "丽莎",
                    "text": "说不定，你在冥冥之中破解了格兰菲狄的秘密，调出了比她更厉害的提神饮品？",
                    "choices": [
                        {
                            "id": "705480206",
                            "text": "还是调整一下饮品里的成分？",
                            "response": [
                                {
                                    "id": "705480208",
                                    "speaker": "丽莎",
                                    "text": "没事，不着急~你的眼神里充满好奇，好像还有许多想问我的事？"
                                },
                                {
                                    "id": "705480209",
                                    "speaker": "丽莎",
                                    "text": "我们聊聊天，你慢慢想想，很快就有灵感啦。"
                                },
                                {
                                    "id": "705480210",
                                    "speaker": "Player",
                                    "text": "今天丽莎追回了哪些书？"
                                },
                                {
                                    "id": "705480211",
                                    "speaker": "丽莎",
                                    "text": "让我有点烦恼，又有些哭笑不得的问题呀。"
                                },
                                {
                                    "id": "705480212",
                                    "speaker": "丽莎",
                                    "text": "一位刚刚出师，从枫丹来到歌德大饭店任职的厨师，借走了最贵重的那本《千年蒙德甜品全书》。"
                                },
                                {
                                    "id": "705480213",
                                    "speaker": "丽莎",
                                    "text": "她居然想用制作甜品的思路，来改良各种肉菜，减轻油腻感…",
                                    "choices": [
                                        {
                                            "id": "705480214",
                                            "text": "纯甜口的肉类吗…",
                                            "response": [
                                                {
                                                    "id": "705480216",
                                                    "speaker": "丽莎",
                                                    "text": "是啊，从结果上看，她有些滥用焦糖酱，反而让本该香气扑鼻的肉片甜得发慌。"
                                                },
                                                {
                                                    "id": "705480217",
                                                    "speaker": "丽莎",
                                                    "text": "焦糖酱明明是个好孩子，加入各种饮品，都不可能让人反感的。有时，我也会在下午茶里加上一小勺呢。"
                                                },
                                                {
                                                    "id": "705480218",
                                                    "speaker": "丽莎",
                                                    "text": "这么看来，改进料理，不是越有创意就越好呀。"
                                                },
                                                {
                                                    "id": "705480219",
                                                    "speaker": "Player",
                                                    "text": "丽莎好像还带来了一个笔记本？"
                                                },
                                                {
                                                    "id": "705480220",
                                                    "speaker": "丽莎",
                                                    "text": "哦，这是今天另一项工作的见证者。"
                                                },
                                                {
                                                    "id": "705480221",
                                                    "speaker": "丽莎",
                                                    "text": "——再过不久，远征队的许多成员就要陆续返回蒙德了，他们长期在外活动，口味可能发生变化。"
                                                },
                                                {
                                                    "id": "705480222",
                                                    "speaker": "丽莎",
                                                    "text": "为了进口一批新食材，满足这些骑士变化后的习惯，琴拜托我走访了十来户代表性的家庭，做了几项调查。",
                                                    "choices": [
                                                        {
                                                            "id": "705480223",
                                                            "text": "好细致的计划…",
                                                            "response": [
                                                                {
                                                                    "id": "705480225",
                                                                    "speaker": "丽莎",
                                                                    "text": "嗯，他们都为蒙德付出了劳苦、时间和血汗，值得大家用尊重和关照回报。"
                                                                },
                                                                {
                                                                    "id": "705480226",
                                                                    "speaker": "丽莎",
                                                                    "text": "调查结果中，被提及次数最多的食材，就是纳塔的苦种，以及用这种奇特植物制作出来的可可了。"
                                                                },
                                                                {
                                                                    "id": "705480227",
                                                                    "speaker": "丽莎",
                                                                    "text": "许多骑士在信件中提到，他们习惯用可可让自己保持精力充沛。我也试过可可热饮，感觉，提神的效果不输咖啡呢。"
                                                                },
                                                                {
                                                                    "id": "705480228",
                                                                    "speaker": "Player",
                                                                    "text": "最近还去了什么别的地方嘛？"
                                                                },
                                                                {
                                                                    "id": "705480229",
                                                                    "speaker": "丽莎",
                                                                    "text": "是说借机在外逛逛吗？被你猜到啦~"
                                                                },
                                                                {
                                                                    "id": "705480230",
                                                                    "speaker": "丽莎",
                                                                    "text": "为了调查蒙德现有的冷门饮品，我去了一趟晨曦酒庄，和爱德琳女仆长聊了会儿天。"
                                                                },
                                                                {
                                                                    "id": "705480231",
                                                                    "speaker": "丽莎",
                                                                    "text": "返程的路上，还遇到了一位巡逻的小骑士艾玛托，她遇见了不知怎么对付的魔物，慌慌张张向我求援。"
                                                                },
                                                                {
                                                                    "id": "705480232",
                                                                    "speaker": "丽莎",
                                                                    "text": "我就陪她绕道奔狼领，好好教训了那几只暴躁的猎犬…难得这样活动筋骨，很畅快哦~"
                                                                },
                                                                {
                                                                    "id": "705480233",
                                                                    "speaker": "Player",
                                                                    "text": "丽莎最近喜欢什么植物呢？"
                                                                },
                                                                {
                                                                    "id": "705480234",
                                                                    "speaker": "丽莎",
                                                                    "text": "哦？小可爱的用词很谨慎嘛，加上了「最近」这个限定词…"
                                                                },
                                                                {
                                                                    "id": "705480235",
                                                                    "speaker": "丽莎",
                                                                    "text": "是考虑到一段时间没见，我也会有变化…还是对以前的事记不太清了呢？",
                                                                    "choices": [
                                                                        {
                                                                            "id": "705480236",
                                                                            "text": "毕竟丽莎见多识广，博学多闻…",
                                                                            "response": [
                                                                                {
                                                                                    "id": "705480238",
                                                                                    "speaker": "丽莎",
                                                                                    "text": "不错嘛，回答得滴水不漏~"
                                                                                },
                                                                                {
                                                                                    "id": "705480239",
                                                                                    "speaker": "丽莎",
                                                                                    "text": "在学生时期，我可能会被书本上的新奇植物吸引，不断开拓见闻，跳出舒适圈。但现在，我已经习惯了安稳和规律。"
                                                                                },
                                                                                {
                                                                                    "id": "705480240",
                                                                                    "speaker": "丽莎",
                                                                                    "text": "借用一位璃月律法专家的比喻，我的生活快要接近「颐养天年」的状态啦，不再是个善变的家伙。"
                                                                                },
                                                                                {
                                                                                    "id": "705480241",
                                                                                    "speaker": "丽莎",
                                                                                    "text": "所以，你肯定还记得——几年前一起冒险的时候，你就为我找来了一种清甜的炼金材料…"
                                                                                },
                                                                                {
                                                                                    "id": "705480242",
                                                                                    "speaker": "丽莎",
                                                                                    "text": "我的喜好一直没变过哦。"
                                                                                },
                                                                                {
                                                                                    "id": "705480243",
                                                                                    "speaker": "Player",
                                                                                    "text": "好，我已经拿定主意了。"
                                                                                },
                                                                                {
                                                                                    "id": "705480244",
                                                                                    "speaker": "Player",
                                                                                    "text": "让我为你准备一款改良的特调吧。"
                                                                                },
                                                                                {
                                                                                    "id": "705480245",
                                                                                    "speaker": "丽莎",
                                                                                    "text": "果然，小可爱的聪颖才智又进步了，只需要稍微提醒一下，就能抓住灵感~"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "705480237",
                                                                            "text": "偶尔有些新兴趣，很合理吧？"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "705480224",
                                                            "text": "真是体贴的安排。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "705480215",
                                            "text": "这思路还真不一般…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "705480207",
                            "text": "我改改配方，给你再调一杯？"
                        }
                    ]
                }
            ]
        },
