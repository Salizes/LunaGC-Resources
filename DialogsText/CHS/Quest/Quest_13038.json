    "talks": [
        {
            "id": "1303801",
            "objective": "等待至晚上（20-24点）",
            "dialogues": [
                {
                    "id": "130380101",
                    "speaker": "Black Screen",
                    "text": "到约定时间了，一行人再次碰面…"
                },
                {
                    "id": "130380102",
                    "speaker": "赛诺",
                    "text": "我认真考虑过了。老师那个脾气，能孤身跑到沙漠来，就肯定做好了再也不回去的准备。"
                },
                {
                    "id": "130380103",
                    "speaker": "赛诺",
                    "text": "他又是个爱憎分明，一意孤行的人，我们不可能说服他逃走。"
                },
                {
                    "id": "130380104",
                    "speaker": "提纳里",
                    "text": "我同意。我的老师纳菲斯也说过，居勒什这个人很死心眼。"
                },
                {
                    "id": "130380105",
                    "speaker": "赛诺",
                    "text": "嗯，另外我还想到一些事。"
                },
                {
                    "id": "130380106",
                    "speaker": "赛诺",
                    "text": "缄默之殿的信息你们都知道了，我这里没有要补充的内容。"
                },
                {
                    "id": "130380107",
                    "speaker": "赛诺",
                    "text": "我对这地方的记忆还是很模糊，多半是受跋灵影响。小时候我经常觉得头痛，反复发烧。"
                },
                {
                    "id": "130380108",
                    "speaker": "赛诺",
                    "text": "当时还会突然感受到某种伟大的情感，看见一些模糊的影子。可都是片段，记不住。"
                },
                {
                    "id": "130380109",
                    "speaker": "赛诺",
                    "text": "我那时还小，只知道脑子里有股顽强的意志。现在想想，哪怕无法交流，赫曼努比斯也以某种方式鼓舞着人类。"
                },
                {
                    "id": "130380110",
                    "speaker": "赛诺",
                    "text": "那种传入精神的力量，也许就是他们信仰的东西。赫曼努比斯的意志和力量确实存在，所以…"
                },
                {
                    "id": "130380111",
                    "speaker": "派蒙",
                    "text": "你要受他威胁吗？没有更好的办法了吗？",
                    "choices": [
                        {
                            "id": "130380112",
                            "text": "别冲动，赛诺。",
                            "response": [
                                {
                                    "id": "130380114",
                                    "speaker": "赛诺",
                                    "text": "不，我不打算还。他们也许有资格把握七柱力量的去向，但我需要这份力量来守护须弥。"
                                },
                                {
                                    "id": "130380115",
                                    "speaker": "赛诺",
                                    "text": "——我要正面对抗，堂堂正正地，再次赢下这股力量。"
                                },
                                {
                                    "id": "130380116",
                                    "speaker": "提纳里",
                                    "text": "对了，临走前艾尔海森提醒过我，缄默之殿从前是个古老的贵族般的组织，而贵族总是被自己的礼仪所束缚。"
                                },
                                {
                                    "id": "130380117",
                                    "speaker": "提纳里",
                                    "text": "卡维也说他在沙漠工作时听说沙漠部落大多都有自己的规矩，沙漠人总说自己无法违背血统和部落规矩。"
                                },
                                {
                                    "id": "130380118",
                                    "speaker": "提纳里",
                                    "text": "我们不妨主动一些，提出我们的方案。"
                                },
                                {
                                    "id": "130380119",
                                    "speaker": "派蒙",
                                    "text": "哇…原来还可以这样。"
                                },
                                {
                                    "id": "130380120",
                                    "speaker": "赛诺",
                                    "text": "想到一起去了。"
                                },
                                {
                                    "id": "130380121",
                                    "speaker": "赛诺",
                                    "text": "占据先机，主动提出无法拒绝的条件，我们就有可能拿下他们。"
                                },
                                {
                                    "id": "130380122",
                                    "speaker": "Player",
                                    "text": "听起来挺像那么回事的。"
                                },
                                {
                                    "id": "130380123",
                                    "speaker": "提纳里",
                                    "text": "嗯，切入口也想到了。我们可以去找赛索斯，告诉他我懂一些医学，想看看他祖父的情况。"
                                }
                            ]
                        },
                        {
                            "id": "130380113",
                            "text": "一定还有办法的！"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1303802",
            "objective": "与同伴们一起讨论",
            "dialogues": []
        },
        {
            "id": "1303803",
            "objective": "与赛索斯对话",
            "dialogues": [
                {
                    "id": "130380201",
                    "speaker": "赛诺",
                    "text": "赛索斯，我们谈谈吧。"
                },
                {
                    "id": "130380202",
                    "speaker": "赛索斯",
                    "text": "你想清楚了吗？"
                },
                {
                    "id": "130380203",
                    "speaker": "提纳里",
                    "text": "在那之前，我稍微懂一点医学，能不能让我看看巴穆恩的情况？"
                },
                {
                    "id": "130380204",
                    "speaker": "赛索斯",
                    "text": "没问题，不过我们的人里也有医生，你想看出什么新花样怕是不可能了。"
                },
                {
                    "id": "130380205",
                    "speaker": "提纳里",
                    "text": "我只是需要一个答案。"
                },
                {
                    "id": "130380206",
                    "speaker": "赛索斯",
                    "text": "跟我来。"
                },
                {
                    "id": "130380207",
                    "speaker": "赛索斯",
                    "text": "轻一点，别吵到他。"
                },
                {
                    "id": "130380208",
                    "speaker": "Black Screen",
                    "text": "提纳里掏出这次随身带着的一些检查用具，为巴穆恩做了基本检查。"
                },
                {
                    "id": "130380209",
                    "speaker": "提纳里",
                    "text": "……"
                },
                {
                    "id": "130380210",
                    "speaker": "提纳里",
                    "text": "我们到外面说吧。"
                },
                {
                    "id": "130380211",
                    "speaker": "提纳里",
                    "text": "巴穆恩深度昏迷了，情况很不乐观。你们的医生肯定也诊断出了同样的结果。"
                },
                {
                    "id": "130380212",
                    "speaker": "提纳里",
                    "text": "年轻时受过重伤，后来又积劳成疾，年迈体衰…"
                },
                {
                    "id": "130380213",
                    "speaker": "提纳里",
                    "text": "我必须遗憾地通知你……他的状况对我来说还算眼熟，一般这样的人最多只能再坚持几天。"
                },
                {
                    "id": "130380214",
                    "speaker": "赛索斯",
                    "text": "…这些我早就知道。"
                },
                {
                    "id": "130380215",
                    "speaker": "赛诺",
                    "text": "你是他的继承人吧？看得出，你尊重他，但你们想法不完全一样，你顾虑的方面更多，更现实。"
                },
                {
                    "id": "130380216",
                    "speaker": "赛诺",
                    "text": "开个条件吧，在巴穆恩还看得见的时间里给这件事一个结果，我知道你在乎。"
                },
                {
                    "id": "130380217",
                    "speaker": "派蒙",
                    "text": "对啊，很多事不能拖，你应该明白的。"
                },
                {
                    "id": "130380218",
                    "speaker": "赛索斯",
                    "text": "……"
                },
                {
                    "id": "130380219",
                    "speaker": "提纳里",
                    "text": "其实，你们俩现在的处境非常相似，都跟养育自己的人想法不同。"
                },
                {
                    "id": "130380220",
                    "speaker": "派蒙",
                    "text": "而且明明是另一代人的矛盾，做决定的却是你们…"
                },
                {
                    "id": "130380221",
                    "speaker": "赛索斯",
                    "text": "你说得没错，这件事里双方立场都已经变化转移了。"
                },
                {
                    "id": "130380222",
                    "speaker": "赛索斯",
                    "text": "我同意，赛诺。一切皆因赫曼努比斯而起，不妨也用他的仪式来做了断。"
                },
                {
                    "id": "130380223",
                    "speaker": "赛索斯",
                    "text": "传说赫曼努比斯刚到图莱杜拉城时曾与人比武，他和他的两位同伴连日战斗，收服人心，招揽了大批有志之士。"
                },
                {
                    "id": "130380224",
                    "speaker": "赛索斯",
                    "text": "那些人后来都成为了缄默之殿的一份子。这是我们的开始，也是我们的仪式——「决斗之仪」。"
                },
                {
                    "id": "130380225",
                    "speaker": "赛诺",
                    "text": "很有意义，就用这个办法吧。"
                },
                {
                    "id": "130380226",
                    "speaker": "赛索斯",
                    "text": "你也拥有赫曼努比斯之力，与缄默之殿有很大关系。我同意你带同伴参加这场比试。"
                },
                {
                    "id": "130380227",
                    "speaker": "提纳里",
                    "text": "三对三，可以。"
                },
                {
                    "id": "130380228",
                    "speaker": "赛索斯",
                    "text": "但我有要求。你们作为攻擂方，必须连胜三局，而且赛诺，你我都要赌上自己持有的跋灵。"
                },
                {
                    "id": "130380229",
                    "speaker": "赛索斯",
                    "text": "放任居勒什带走跋灵是爷爷从前因怜悯犯下的错误，也是缄默之殿必须跨过的议题，这一点上我不能退让。"
                },
                {
                    "id": "130380230",
                    "speaker": "赛诺",
                    "text": "正合我意。"
                },
                {
                    "id": "130380231",
                    "speaker": "赛诺",
                    "text": "如果我赢了，缄默之殿必须释放居勒什，并将过去的事一笔勾销。"
                },
                {
                    "id": "130380232",
                    "speaker": "赛诺",
                    "text": "如果你赢了，我会归还这份力量。"
                },
                {
                    "id": "130380233",
                    "speaker": "赛索斯",
                    "text": "一言为定。那么明天晚上八点，到仪式之厅见面吧。"
                }
            ]
        },
        {
            "id": "1303815",
            "objective": "(test)隐藏任务用来对话中开门$HIDDEN",
            "dialogues": []
        },
        {
            "id": "1303809",
            "objective": "与赛诺对话",
            "dialogues": [
                {
                    "id": "130380601",
                    "speaker": "提纳里",
                    "text": "都谈到这个份上，可没有回头路了。"
                },
                {
                    "id": "130380602",
                    "speaker": "赛诺",
                    "text": "也不是才开始的。从老师偷偷溜走那一刻起，我就已经没有回头路了。"
                },
                {
                    "id": "130380603",
                    "speaker": "提纳里",
                    "text": "你得赢。不论是作为大风纪官还是作为你自己，都需要这份力量。"
                },
                {
                    "id": "130380604",
                    "speaker": "派蒙",
                    "text": "对呀。而且这股力量跟了你这么久，它一定也认可你了。"
                },
                {
                    "id": "130380605",
                    "speaker": "赛诺",
                    "text": "…不论是作为风纪官，还是作为我自己…"
                },
                {
                    "id": "130380606",
                    "speaker": "赛诺",
                    "text": "是啊，这么想想，我也是好不容易才克服困难制服了这股力量的。又不是谁都能做到。"
                },
                {
                    "id": "130380607",
                    "speaker": "派蒙",
                    "text": "就是就是！",
                    "choices": [
                        {
                            "id": "130380608",
                            "text": "不要多想，拿下胜利吧！",
                            "response": [
                                {
                                    "id": "130380610",
                                    "speaker": "提纳里",
                                    "text": "#嗯，我和{NICKNAME}绝对不会输。"
                                },
                                {
                                    "id": "130380611",
                                    "speaker": "赛诺",
                                    "text": "我也一样。"
                                },
                                {
                                    "id": "130380612",
                                    "speaker": "赛诺",
                                    "text": "沙漠文明非常古老，又因为种种原因一度和雨林产生间隙。就像迪希雅说的，偏见阻隔着人们。"
                                },
                                {
                                    "id": "130380613",
                                    "speaker": "赛诺",
                                    "text": "心病更是一切的源头。我总觉得巴穆恩在乎的东西似乎远不止这些，赛索斯也不是恶人，他有他的打算。"
                                },
                                {
                                    "id": "130380614",
                                    "speaker": "赛诺",
                                    "text": "…一切就看明天了。"
                                }
                            ]
                        },
                        {
                            "id": "130380609",
                            "text": "我们也会帮忙的。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1303804",
            "objective": "等待至次日（20-24点）",
            "dialogues": []
        },
        {
            "id": "1303805",
            "objective": "前往仪式之厅",
            "dialogues": [
                {
                    "id": "130380301",
                    "speaker": "杜安雷",
                    "text": "今日，当着众贤之至贤，赫曼努比斯大人权柄与威能的见证，我等将再次举行决斗之仪。"
                },
                {
                    "id": "130380302",
                    "speaker": "杜安雷",
                    "text": "此为至圣的仪式，观礼者将不可打扰，百般恭敬，庄严地观看全过程。"
                },
                {
                    "id": "130380303",
                    "speaker": "杜安雷",
                    "text": "缄默之殿的代表。防守方。"
                },
                {
                    "id": "130380304",
                    "speaker": "赛索斯",
                    "text": "爷爷，你来了。"
                },
                {
                    "id": "130380305",
                    "speaker": "巴穆恩",
                    "text": "…咳…多少年了，你竟然举办这个仪式，赛索斯。"
                },
                {
                    "id": "130380306",
                    "speaker": "赛索斯",
                    "text": "我知道我在做什么，爷爷，放心看着吧。"
                },
                {
                    "id": "130380307",
                    "speaker": "杜安雷",
                    "text": "教令院的代表。进攻方。"
                },
                {
                    "id": "130380308",
                    "speaker": "赛诺",
                    "text": "准备好了。今天我们会用实力赢下话语权。"
                },
                {
                    "id": "130380309",
                    "speaker": "杜安雷",
                    "text": "那么，请双方就位，决定出战顺序。"
                },
                {
                    "id": "130380310",
                    "speaker": "杜安雷",
                    "text": "在这里，我等将不问来者何来，去者何去，赌上赫曼努比斯的力量，战斗直到决出胜负！"
                },
                {
                    "id": "130380311",
                    "speaker": "Player",
                    "text": "我打头阵吧。"
                },
                {
                    "id": "130380312",
                    "speaker": "派蒙",
                    "text": "哎？真的吗？"
                },
                {
                    "id": "130380313",
                    "speaker": "Player",
                    "text": "真的。士气很重要。"
                },
                {
                    "id": "130380314",
                    "speaker": "提纳里",
                    "text": "#我同意，{NICKNAME}很强，率先出战能震慑对手。"
                },
                {
                    "id": "130380315",
                    "speaker": "赛诺",
                    "text": "那你第二个。"
                },
                {
                    "id": "130380316",
                    "speaker": "提纳里",
                    "text": "嗯。"
                },
                {
                    "id": "130380317",
                    "speaker": "赛诺",
                    "text": "决定好了。"
                },
                {
                    "id": "130380318",
                    "speaker": "赛索斯",
                    "text": "我们也决定好了，开始吧。"
                }
            ]
        },
