    "talks": [
        {
            "id": "602401",
            "objective": "准备妥当后进入尼可开启的门",
            "dialogues": [
                {
                    "id": "60240101",
                    "speaker": "伊涅芙",
                    "text": "确认各位身体状况正常，我的工作圆满完成，可喜可贺。"
                }
            ]
        },
        {
            "id": "602402",
            "objective": "向前探索这个空间",
            "dialogues": [
                {
                    "id": "60240301",
                    "speaker": "派蒙",
                    "text": "这些人是…"
                },
                {
                    "id": "60240302",
                    "speaker": "尼可",
                    "text": "从他们的衣服可以判断，他们都是过去的亥珀波瑞亚人的虚影。"
                },
                {
                    "id": "60240303",
                    "speaker": "派蒙",
                    "text": "也就是说，他们有可能会有关于「月神」名字的线索对吧？"
                },
                {
                    "id": "60240304",
                    "speaker": "派蒙",
                    "text": "你好，请问你们知道月神的名字叫什么吗？"
                },
                {
                    "id": "60240305",
                    "speaker": "撒亚赞铎",
                    "text": "嗯？"
                },
                {
                    "id": "60240306",
                    "speaker": "派蒙",
                    "text": "哦，抱歉，这么问有点莫名其妙吧，我想想应该怎么解释…"
                },
                {
                    "id": "60240307",
                    "speaker": "撒亚赞铎",
                    "text": "月亮，早就消失了，月神也都死了。她们的名字毫无意义。"
                },
                {
                    "id": "60240308",
                    "speaker": "撒亚赞铎",
                    "text": "等新的月神降生，我们自然会得知她的名讳。"
                },
                {
                    "id": "60240309",
                    "speaker": "撒亚赞铎",
                    "text": "现在我们已经穷尽一切手段，只需静静等待，静静等待…"
                },
                {
                    "id": "60240310",
                    "speaker": "撒亚赞铎",
                    "text": "……"
                },
                {
                    "id": "60240311",
                    "speaker": "「仆人」",
                    "text": "过去的人都这么虔诚吗？看上去不打算理会我们了。"
                },
                {
                    "id": "60240312",
                    "speaker": "菈乌玛",
                    "text": "它所说的新的月神，就是指哥伦比娅吧。"
                },
                {
                    "id": "60240313",
                    "speaker": "菈乌玛",
                    "text": "可惜从他身处的年代看，库塔尔的诞生已经是很久很久以后的事了。"
                },
                {
                    "id": "60240314",
                    "speaker": "Player",
                    "text": "救赎并没有到来。"
                },
                {
                    "id": "60240315",
                    "speaker": "派蒙",
                    "text": "呃，但…怎么说呢，如果之后能遇到时代没那么遥远的虚影，是不是就有可能知道哥伦比娅的真名了？"
                },
                {
                    "id": "60240316",
                    "speaker": "菈乌玛",
                    "text": "嗯，注意一下吧，从他们的服装很容易辨认。"
                },
                {
                    "id": "60240317",
                    "speaker": "Player",
                    "text": "你怎么不说话？"
                },
                {
                    "id": "60240318",
                    "speaker": "派蒙",
                    "text": "对啊，一路上你不都超能说的吗？"
                },
                {
                    "id": "60240319",
                    "speaker": "尼可",
                    "text": "哦，没事，没什么。你们说的都很有道理。"
                },
                {
                    "id": "60240320",
                    "speaker": "尼可",
                    "text": "亥珀波瑞亚人心中的月神一定是存在于远古时期的三月女神，很难从他们那里知道现在的月神的信息。"
                },
                {
                    "id": "60240321",
                    "speaker": "尼可",
                    "text": "或许因为月神曾给予过诸多庇护与恩惠，神与龙的战争又令世界千疮百孔，他们才会祈祷月神尽快降生吧。"
                },
                {
                    "id": "60240322",
                    "speaker": "派蒙",
                    "text": "原来如此，很有道理啊。"
                },
                {
                    "id": "60240323",
                    "speaker": "「仆人」",
                    "text": "继续前进吧，看看有没有其他线索。"
                }
            ]
        },
        {
            "id": "602403",
            "objective": "向前探索这个空间",
            "dialogues": []
        },
        {
            "id": "602404",
            "objective": "查看墙上的画",
            "dialogues": [
                {
                    "id": "60240401",
                    "speaker": "派蒙",
                    "text": "欸，这里有好几幅画，看起来有些年头了。尼可你这么懂，应该也知道这里画的是什么吧？"
                },
                {
                    "id": "60240402",
                    "speaker": "尼可",
                    "text": "我来看看…嗯。"
                },
                {
                    "id": "60240403",
                    "speaker": "尼可",
                    "text": "想要看懂这些壁画，就必须了解「葬火之战」前后的历史，之前我和菈乌玛简单概述过一次。"
                },
                {
                    "id": "60240404",
                    "speaker": "菈乌玛",
                    "text": "嗯…的确能对上。三月女神的争执，尼伯龙根的改造…",
                    "choices": [
                        {
                            "id": "60240405",
                            "text": "听上去会是长篇大论…",
                            "response": [
                                {
                                    "id": "60240407",
                                    "speaker": "尼可",
                                    "text": "不，我很乐意再讲一次！"
                                },
                                {
                                    "id": "60240408",
                                    "speaker": "派蒙",
                                    "text": "好、好吧…"
                                },
                                {
                                    "id": "60240409",
                                    "speaker": "尼可",
                                    "text": "提瓦特的三轮明月，以及三位月之女神，都是在彼时提瓦特的统治者，尼伯龙根的意志下诞生的。"
                                },
                                {
                                    "id": "60240410",
                                    "speaker": "尼可",
                                    "text": "可是后来，「天理」来到了提瓦特，对这个世界进行了彻头彻尾的改造。"
                                },
                                {
                                    "id": "60240411",
                                    "speaker": "尼可",
                                    "text": "三月女神的力量自然无法与天理对抗，但天理也没有将她们视为必须铲除的异端。"
                                },
                                {
                                    "id": "60240412",
                                    "speaker": "尼可",
                                    "text": "本质上，三月女神维系着这颗星球的存续与运转，与天理的目的并无冲突，但隐患也因此种下…"
                                },
                                {
                                    "id": "60240413",
                                    "speaker": "「仆人」",
                                    "text": "尼伯龙根回来了，对吧？"
                                },
                                {
                                    "id": "60240414",
                                    "speaker": "尼可",
                                    "text": "嗯，随后就是那场「葬火之战」，尼伯龙根与天理爆发了战争。"
                                },
                                {
                                    "id": "60240415",
                                    "speaker": "尼可",
                                    "text": "三月女神内部也出现了分歧，有神明认为应该追随尼伯龙根，毕竟月亮就是由他升起的。"
                                },
                                {
                                    "id": "60240416",
                                    "speaker": "尼可",
                                    "text": "但也有神明认为被卷入争斗的话，世界会更加趋近破碎，后果难以估量…"
                                },
                                {
                                    "id": "60240417",
                                    "speaker": "尼可",
                                    "text": "更何况那位归来的造物主身上已经沾染了危险的深渊之力。"
                                },
                                {
                                    "id": "60240418",
                                    "speaker": "尼可",
                                    "text": "结果是尼伯龙根发现了三位女神的不忠，将她们囚禁，再将月亮改造成了对抗天理的武器。"
                                },
                                {
                                    "id": "60240419",
                                    "speaker": "派蒙",
                                    "text": "武、武器？"
                                },
                                {
                                    "id": "60240420",
                                    "speaker": "尼可",
                                    "text": "嗯，曾经守护星球的月亮，最终变为了令一切生灵畏惧，只会带来毁灭的存在。"
                                },
                                {
                                    "id": "60240421",
                                    "speaker": "尼可",
                                    "text": "虽然天理曾和三月女神有过和平约定，但眼下，月亮对提瓦特的威胁远远超过了可容忍的程度。"
                                },
                                {
                                    "id": "60240422",
                                    "speaker": "尼可",
                                    "text": "还有另一种说法，是天理不知道月神被囚禁的内情，认为是月神率先撕破了和平的誓言。"
                                },
                                {
                                    "id": "60240423",
                                    "speaker": "Player",
                                    "text": "然后呢？"
                                },
                                {
                                    "id": "60240424",
                                    "speaker": "尼可",
                                    "text": "无论真相如何，总之天理击碎了两个月亮，将另一个月亮扔到了天外。"
                                },
                                {
                                    "id": "60240425",
                                    "speaker": "尼可",
                                    "text": "她们在尼伯龙根陨落之后有没有从他的囚禁中逃出来，尚不可知。"
                                },
                                {
                                    "id": "60240426",
                                    "speaker": "尼可",
                                    "text": "但能确定的是，自那之后月亮就不再属于提瓦特，她们的力量因排斥而逐渐流失，最终接连逝去。"
                                },
                                {
                                    "id": "60240427",
                                    "speaker": "派蒙",
                                    "text": "原来是这样…"
                                },
                                {
                                    "id": "60240428",
                                    "speaker": "「仆人」",
                                    "text": "既然你说月亮在那时候就不属于提瓦特，那哥伦比娅又为何会在提瓦特降生呢？"
                                },
                                {
                                    "id": "60240429",
                                    "speaker": "尼可",
                                    "text": "这或许是尚未破碎的霜月，与提瓦特残留的古老联系，你可以视为那是三位月神的遗愿。"
                                },
                                {
                                    "id": "60240430",
                                    "speaker": "尼可",
                                    "text": "从始至终，她们都不渴望战争，只想守护这片土地而已。"
                                },
                                {
                                    "id": "60240431",
                                    "speaker": "菈乌玛",
                                    "text": "…我明白了。"
                                },
                                {
                                    "id": "60240432",
                                    "speaker": "「仆人」",
                                    "text": "如果三位女神最终的命运如你所说，那哥伦比娅现在也处于这个危险的状态中。"
                                },
                                {
                                    "id": "60240433",
                                    "speaker": "「仆人」",
                                    "text": "我们的调查还没有进展，需要加快速度了。"
                                },
                                {
                                    "id": "60240434",
                                    "speaker": "派蒙",
                                    "text": "嗯，你说得对，继续前进吧！"
                                }
                            ]
                        },
                        {
                            "id": "60240406",
                            "text": "要不回去再听吧？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "602409",
            "objective": "",
            "dialogues": [
                {
                    "id": "60240901",
                    "speaker": "「少女」",
                    "text": "还是…没赶上吗…"
                },
                {
                    "id": "60240902",
                    "speaker": "「少女」",
                    "text": "名字…"
                },
                {
                    "id": "60240903",
                    "speaker": "Player",
                    "text": "可以告诉我你的名字吗？"
                },
                {
                    "id": "60240904",
                    "speaker": "Player",
                    "text": "可以告诉我你的名字吗？"
                },
                {
                    "id": "60240905",
                    "speaker": "「少女」",
                    "text": "我的名字…是…"
                },
                {
                    "id": "60240906",
                    "speaker": "Player",
                    "text": "哥伦比娅！"
                },
                {
                    "id": "60240907",
                    "speaker": "Player",
                    "text": "哥伦比娅！"
                },
                {
                    "id": "60240908",
                    "speaker": "「少女」",
                    "text": "…欸？"
                }
            ]
        },
        {
            "id": "602405",
            "objective": "继续向前探索",
            "dialogues": [
                {
                    "id": "60240501",
                    "speaker": "派蒙",
                    "text": "终于到了…我猜我们需要启动它，对吗？"
                },
                {
                    "id": "60240502",
                    "speaker": "尼可",
                    "text": "是的，虽然一开始我有点担心，但靠近的时候我感知到它内部的月矩力流动畅通，应该还能正常运转。"
                },
                {
                    "id": "60240503",
                    "speaker": "尼可",
                    "text": "问题在于启动它的机关，似乎保存得不是很完整…"
                },
                {
                    "id": "60240504",
                    "speaker": "「仆人」",
                    "text": "如果有路上遇到的那种装置的核心，是不是能修好它？"
                },
                {
                    "id": "60240505",
                    "speaker": "尼可",
                    "text": "很有可能，亥珀波瑞亚人应该留下了这种备案。我们四处找找那种核心吧。"
                }
            ]
        },
        {
            "id": "602406",
            "objective": "寻找启动装置的办法",
            "dialogues": [
                {
                    "id": "60240601",
                    "speaker": "尼可",
                    "text": "这里就是当时「亥珀波瑞亚」人与月亮沟通的地方。"
                },
                {
                    "id": "60240602",
                    "speaker": "尼可",
                    "text": "在「祈月之夜」将月髓放置于台上，就能打开通往月亮的「传送门」，将月神送往属于她的家。"
                },
                {
                    "id": "60240603",
                    "speaker": "尼可",
                    "text": "当然，前提是我们先能找回那位小姐。",
                    "choices": [
                        {
                            "id": "60240604",
                            "text": "我有个问题…",
                            "response": [
                                {
                                    "id": "60240606",
                                    "speaker": "尼可",
                                    "text": "是的，你想问…其实那里不一定安全？"
                                },
                                {
                                    "id": "60240607",
                                    "speaker": "Player",
                                    "text": "没错，可能已经被深渊污染了。"
                                },
                                {
                                    "id": "60240608",
                                    "speaker": "尼可",
                                    "text": "但是她只有回去这一种选择，你是明白的。"
                                },
                                {
                                    "id": "60240609",
                                    "speaker": "Player",
                                    "text": "嗯…"
                                },
                                {
                                    "id": "60240610",
                                    "speaker": "派蒙",
                                    "text": "另外还有一件事，我们这里已经抵达了终点对吧。"
                                },
                                {
                                    "id": "60240611",
                                    "speaker": "派蒙",
                                    "text": "可是，无论路上记载历史的画，还是那些「亥珀波瑞亚」时期的人，都没有告诉我们哥伦比娅的名字。"
                                },
                                {
                                    "id": "60240612",
                                    "speaker": "众人",
                                    "text": "……"
                                },
                                {
                                    "id": "60240613",
                                    "speaker": "众人",
                                    "text": "……"
                                },
                                {
                                    "id": "60240614",
                                    "speaker": "众人",
                                    "text": "……"
                                },
                                {
                                    "id": "60240615",
                                    "speaker": "众人",
                                    "text": "……"
                                },
                                {
                                    "id": "60240616",
                                    "speaker": "尼可",
                                    "text": "唔，方便的话，能告诉我艾莉丝当时是怎么和你们说有关「找名字」的事的吗？"
                                },
                                {
                                    "id": "60240617",
                                    "speaker": "派蒙",
                                    "text": "哦，就是这样…"
                                },
                                {
                                    "id": "60240618",
                                    "speaker": "艾莉丝",
                                    "text": "那就去找出来吧，身为月神，我想应该存在属于她的名字。"
                                },
                                {
                                    "id": "60240619",
                                    "speaker": "艾莉丝",
                                    "text": "无论是「哥伦比娅」，还是「库塔尔」，都不是她的真名，也没有得到她的认可。"
                                },
                                {
                                    "id": "60240620",
                                    "speaker": "尼可",
                                    "text": "…那，有没有一种可能，在此之前的历史中，根本就不存在那位月神的「真名」呢？"
                                },
                                {
                                    "id": "60240621",
                                    "speaker": "「仆人」",
                                    "text": "尽管不想承认，但我们不得不接受这个现实了。"
                                },
                                {
                                    "id": "60240622",
                                    "speaker": "菈乌玛",
                                    "text": "无人知晓月神如何降生，她也没有所谓「父母」之人，赐名这件事或许从未发生过…"
                                },
                                {
                                    "id": "60240623",
                                    "speaker": "派蒙",
                                    "text": "那…那难道哥伦比娅真的回不来了吗？她真的就要这么消失了吗？"
                                },
                                {
                                    "id": "60240624",
                                    "speaker": "尼可",
                                    "text": "欸…？是…是我的问题听起来太消极了吗？大家怎么都往坏的方面想了呢？"
                                },
                                {
                                    "id": "60240625",
                                    "speaker": "Player",
                                    "text": "这是什么意思…"
                                },
                                {
                                    "id": "60240626",
                                    "speaker": "尼可",
                                    "text": "在「以前」的历史中不存在她的真名，不代表「未来」不会有啊！"
                                },
                                {
                                    "id": "60240627",
                                    "speaker": "派蒙",
                                    "text": "啊…？"
                                },
                                {
                                    "id": "60240628",
                                    "speaker": "尼可",
                                    "text": "你们再想想艾莉丝说过的话，她从头到尾，都没有说过要你们去找一个「新名字」呀。"
                                },
                                {
                                    "id": "60240629",
                                    "speaker": "「仆人」",
                                    "text": "你的意思难道是…"
                                },
                                {
                                    "id": "60240630",
                                    "speaker": "Player",
                                    "text": "由我们来赋予她名字？"
                                },
                                {
                                    "id": "60240631",
                                    "speaker": "尼可",
                                    "text": "嗯，名字的确是同这个世界建立联系的锚点。如果以前没有的话，那现在给予她一个不就行了？"
                                },
                                {
                                    "id": "60240632",
                                    "speaker": "尼可",
                                    "text": "#这就好比…啊，对了！{NICKNAME}，你觉得如果在你刚到提瓦特的时候，有人在背后喊「杜麦尼」，你会回头吗？"
                                },
                                {
                                    "id": "60240633",
                                    "speaker": "Player",
                                    "text": "不会…"
                                },
                                {
                                    "id": "60240634",
                                    "speaker": "尼可",
                                    "text": "那现在呢？"
                                },
                                {
                                    "id": "60240635",
                                    "speaker": "Player",
                                    "text": "……！"
                                },
                                {
                                    "id": "60240636",
                                    "speaker": "「仆人」",
                                    "text": "我理解你的意思了。"
                                },
                                {
                                    "id": "60240637",
                                    "speaker": "尼可",
                                    "text": "在漫长的人生旅途中，我们身边的家人、朋友，也在随着时间而变化。"
                                },
                                {
                                    "id": "60240638",
                                    "speaker": "尼可",
                                    "text": "当他们以不同的名字呼唤你时，重要的不是名字本身。而是这个名字所代表的意义。"
                                },
                                {
                                    "id": "60240639",
                                    "speaker": "尼可",
                                    "text": "以及…你是否认同这其中的意义。"
                                },
                                {
                                    "id": "60240640",
                                    "speaker": "Player",
                                    "text": "荧…"
                                },
                                {
                                    "id": "60240641",
                                    "speaker": "Player",
                                    "text": "空…"
                                },
                                {
                                    "id": "60240642",
                                    "speaker": "Player",
                                    "text": "……"
                                },
                                {
                                    "id": "60240643",
                                    "speaker": "尼可",
                                    "text": "所以，当闭上眼睛，眼前出现那位月神小姐背影的时候，现在的你们会怎么呼唤她呢？"
                                },
                                {
                                    "id": "60240644",
                                    "speaker": "Player",
                                    "text": "……"
                                },
                                {
                                    "id": "60240645",
                                    "speaker": "Player",
                                    "text": "哥伦比娅…"
                                },
                                {
                                    "id": "60240646",
                                    "speaker": "「仆人」",
                                    "text": "哥伦比娅。"
                                },
                                {
                                    "id": "60240647",
                                    "speaker": "派蒙",
                                    "text": "我也会叫她哥伦比娅。"
                                },
                                {
                                    "id": "60240648",
                                    "speaker": "菈乌玛",
                                    "text": "她早已舍弃了「库塔尔」所代表的一切，我想…我今后也该这么叫她。哥伦比娅。"
                                },
                                {
                                    "id": "60240649",
                                    "speaker": "尼可",
                                    "text": "看来，你们已经找到答案了呢。"
                                },
                                {
                                    "id": "60240650",
                                    "speaker": "派蒙",
                                    "text": "可是…真的有这么简单吗？我们一路上可是找了这么久都没找到！"
                                },
                                {
                                    "id": "60240651",
                                    "speaker": "尼可",
                                    "text": "我想，在这次旅途中，和「结果」同样重要的，是「过程」。"
                                },
                                {
                                    "id": "60240652",
                                    "speaker": "尼可",
                                    "text": "如果没有经历那些寻找的过程，没有一次次否认那些找到的结果，又如何得到你们认为正确的答案呢？"
                                },
                                {
                                    "id": "60240653",
                                    "speaker": "尼可",
                                    "text": "啊！这么一说，这还真像是艾莉丝会做的事呢…"
                                },
                                {
                                    "id": "60240654",
                                    "speaker": "「仆人」",
                                    "text": "你是说那位魔女，或许从一开始就知道世界上不存在哥伦比娅的「真名」？"
                                },
                                {
                                    "id": "60240655",
                                    "speaker": "尼可",
                                    "text": "唔…我也说不好，只是觉得这很像她会一边满意地笑出声，一边说「有趣」的结果。"
                                },
                                {
                                    "id": "60240656",
                                    "speaker": "菈乌玛",
                                    "text": "唔…！"
                                },
                                {
                                    "id": "60240657",
                                    "speaker": "派蒙",
                                    "text": "菈乌玛！你的角！"
                                },
                                {
                                    "id": "60240658",
                                    "speaker": "尼可",
                                    "text": "各位…你们该抓紧时间了。祈月之夜的月亮，已经升起来了。"
                                },
                                {
                                    "id": "60240659",
                                    "speaker": "尼可",
                                    "text": "请放心，刚才你们喊出「哥伦比娅」这个名字的时候，其中所蕴含的力量在我看来足以将那位月神唤回。"
                                },
                                {
                                    "id": "60240660",
                                    "speaker": "派蒙",
                                    "text": "名字里的…力量？"
                                },
                                {
                                    "id": "60240661",
                                    "speaker": "尼可",
                                    "text": "嗯…就是…唔…可…可恶！"
                                },
                                {
                                    "id": "60240662",
                                    "speaker": "派蒙",
                                    "text": "呃…这次你又怎么了？"
                                },
                                {
                                    "id": "60240663",
                                    "speaker": "尼可",
                                    "text": "可恶…！真的好想解释一下这其中的原理！好想从提瓦特本源的规则说起！说它个几个小时！"
                                },
                                {
                                    "id": "60240664",
                                    "speaker": "尼可",
                                    "text": "但是…！冷静，冷静，尼可，你是一位庄严的天使，是分得清轻重缓急的天使！"
                                },
                                {
                                    "id": "60240665",
                                    "speaker": "派蒙",
                                    "text": "我…我懂了，是我不好，不该在这时候问这些。"
                                },
                                {
                                    "id": "60240666",
                                    "speaker": "尼可",
                                    "text": "总…总之！请各位快些出发吧，记住你们刚才呼唤这个名字的心情。"
                                },
                                {
                                    "id": "60240667",
                                    "speaker": "菈乌玛",
                                    "text": "那就在此约定…"
                                },
                                {
                                    "id": "60240668",
                                    "speaker": "「仆人」",
                                    "text": "以「哥伦比娅」之名将她找回…"
                                },
                                {
                                    "id": "60240669",
                                    "speaker": "派蒙",
                                    "text": "为她举办最棒的「祈月之夜」！"
                                },
                                {
                                    "id": "60240670",
                                    "speaker": "Player",
                                    "text": "再送她回家。"
                                }
                            ]
                        },
                        {
                            "id": "60240605",
                            "text": "月亮在天空之外对吧？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "602407",
            "objective": "进入成功开启的门",
            "dialogues": []
        },
        {
            "id": "602408",
            "objective": "探索深处的空间",
            "dialogues": []
        },
        {
            "id": "602410",
            "objective": "前往「银月之庭」",
            "dialogues": [
                {
                    "id": "60241001",
                    "speaker": "「少女」",
                    "text": "已经…连动的力气也没有了…"
                },
                {
                    "id": "60241002",
                    "speaker": "「少女」",
                    "text": "意识，也快飘走了…"
                },
                {
                    "id": "60241003",
                    "speaker": "「少女」",
                    "text": "#{NICKNAME}{M#他们}{F#她们}出来了吗？最后…还想再见一面…"
                }
            ]
        },
        {
            "id": "602411",
            "objective": "与哥伦比娅交谈",
            "dialogues": [
                {
                    "id": "60241101",
                    "speaker": "Player",
                    "text": "哥伦比娅·希珀塞莱尼娅。嗯，很好听的名字。"
                },
                {
                    "id": "60241102",
                    "speaker": "哥伦比娅",
                    "text": "以前从没想过，「哥伦比娅」会成为我的真名。"
                },
                {
                    "id": "60241103",
                    "speaker": "哥伦比娅",
                    "text": "但在与你、与其他朋友们相遇后，这个名字所代表的意义，似乎慢慢发生了变化。"
                },
                {
                    "id": "60241104",
                    "speaker": "哥伦比娅",
                    "text": "它从一个愚人众的代号，变成了「朋友们口中的我」。"
                },
                {
                    "id": "60241105",
                    "speaker": "Player",
                    "text": "（比起第一次见她的时候，哥伦比娅真的变了不少…现在的她居然会这样分享自己的内心。）"
                },
                {
                    "id": "60241106",
                    "speaker": "哥伦比娅",
                    "text": "嗯？怎么了？你怎么不说话？"
                },
                {
                    "id": "60241107",
                    "speaker": "Player",
                    "text": "我在为你高兴。"
                },
                {
                    "id": "60241108",
                    "speaker": "哥伦比娅",
                    "text": "哈，谢谢你。其他人呢？"
                },
                {
                    "id": "60241109",
                    "speaker": "Player",
                    "text": "大家去其他地方呼唤你的名字了，我们也差不多去和他们会合吧。"
                },
                {
                    "id": "60241110",
                    "speaker": "哥伦比娅",
                    "text": "好的，我也想好好感谢他们。他们也为我做了很多事。不论是找我的名字，还是进入那个古老的遗迹…"
                },
                {
                    "id": "60241111",
                    "speaker": "Player",
                    "text": "咦？你难道…"
                },
                {
                    "id": "60241112",
                    "speaker": "哥伦比娅",
                    "text": "嗯，在还能支撑自己意识的时候，我一直都跟在你们后面。"
                },
                {
                    "id": "60241113",
                    "speaker": "Player",
                    "text": "从什么时候开始的…"
                },
                {
                    "id": "60241114",
                    "speaker": "哥伦比娅",
                    "text": "还记得吗？在那夏镇的时候，你回过头，叫了我一声「哥伦比娅」。"
                },
                {
                    "id": "60241115",
                    "speaker": "Player",
                    "text": "（原来是那时候…）"
                },
                {
                    "id": "60241116",
                    "speaker": "Player",
                    "text": "（但那时…好像是有人在背后拍了我一下…或者说…我「认为」是哥伦比娅在背后拍了我一下…）"
                },
                {
                    "id": "60241117",
                    "speaker": "哥伦比娅",
                    "text": "走吧，别让大家久等了。"
                },
                {
                    "id": "60241118",
                    "speaker": "Player",
                    "text": "好，跟我来吧。"
                },
                {
                    "id": "60241119",
                    "speaker": "哥伦比娅",
                    "text": "啊，不过…"
                },
                {
                    "id": "60241120",
                    "speaker": "Player",
                    "text": "嗯？"
                },
                {
                    "id": "60241121",
                    "speaker": "哥伦比娅",
                    "text": "在那之前…可以再叫一次我的名字吗？"
                },
                {
                    "id": "60241122",
                    "speaker": "Player",
                    "text": "哈哈…"
                },
                {
                    "id": "60241123",
                    "speaker": "Player",
                    "text": "走吧，哥伦比娅·希珀塞莱尼娅。"
                }
            ]
        },
        {
            "id": "602412",
            "objective": "带哥伦比娅去和同伴会合",
            "dialogues": [
                {
                    "id": "60241201",
                    "speaker": "Black Screen",
                    "text": "哥伦比娅借小动物和月灵，将这个好消息告知了同伴们…"
                },
                {
                    "id": "60241202",
                    "speaker": "Black Screen",
                    "text": "尽管有些同伴过了很久，才从它们手舞足蹈的动作中悟出了消息的内容…"
                }
            ]
        },
        {
            "id": "602402",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "60240201",
                    "speaker": "法尔伽",
                    "text": "各位没事就好，这下我也放心了。"
                }
            ]
        },
        {
            "id": "602409",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "60240912",
                    "speaker": "Player",
                    "text": "哥伦比娅！你在吗？"
                },
                {
                    "id": "60240913",
                    "speaker": "Player",
                    "text": "哥伦比娅！你在吗？"
                },
                {
                    "id": "60240916",
                    "speaker": "Player",
                    "text": "「哥伦比娅」…这是我们第一次见面时，你告诉我的名字。"
                },
                {
                    "id": "60240917",
                    "speaker": "Player",
                    "text": "「哥伦比娅」…这是我们第一次见面时，你告诉我的名字。"
                },
                {
                    "id": "60240918",
                    "speaker": "Player",
                    "text": "也是我一直以来呼唤你的名字。"
                },
                {
                    "id": "60240919",
                    "speaker": "Player",
                    "text": "也是我一直以来呼唤你的名字。"
                },
                {
                    "id": "60240920",
                    "speaker": "「少女」",
                    "text": "「哥伦比娅」…"
                },
                {
                    "id": "60240921",
                    "speaker": "Player",
                    "text": "这是个好名字。"
                },
                {
                    "id": "60240922",
                    "speaker": "Player",
                    "text": "这是个好名字。"
                },
                {
                    "id": "60240923",
                    "speaker": "Player",
                    "text": "它出现在我和你的每一段回忆中…"
                },
                {
                    "id": "60240924",
                    "speaker": "Player",
                    "text": "它出现在我和你的每一段回忆中…"
                },
                {
                    "id": "60240925",
                    "speaker": "Player",
                    "text": "出现在朋友们的每一段回忆中。"
                },
                {
                    "id": "60240926",
                    "speaker": "Player",
                    "text": "出现在朋友们的每一段回忆中。"
                },
                {
                    "id": "60240929",
                    "speaker": "Player",
                    "text": "如果你也喜欢的话…"
                },
                {
                    "id": "60240930",
                    "speaker": "Player",
                    "text": "如果你也喜欢的话…"
                },
                {
                    "id": "60240935",
                    "speaker": "「少女」",
                    "text": "在找我？"
                },
                {
                    "id": "60240943",
                    "speaker": "「少女」",
                    "text": "我喜欢。"
                },
                {
                    "id": "60240946",
                    "speaker": "「少女」",
                    "text": "今后也这么呼唤我吧。"
                },
                {
                    "id": "60240947",
                    "speaker": "「少女」",
                    "text": "我的名字是——"
                },
                {
                    "id": "60240948",
                    "speaker": "「少女」",
                    "text": "哥伦比娅·希珀塞莱尼娅。"
                }
            ]
        },
        {
            "id": "602450",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "60245001",
                    "speaker": "撒亚赞铎",
                    "text": "等到月亮重新升起，我们就能再次获得庇佑…"
                },
                {
                    "id": "60245002",
                    "speaker": "撒亚赞铎",
                    "text": "天无绝人之路，天无绝人之路…"
                }
            ]
        },
        {
            "id": "602451",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "60245101",
                    "speaker": "约法娜",
                    "text": "月亮…只是暂时离开了我们…"
                }
            ]
        },
        {
            "id": "602452",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "60245201",
                    "speaker": "调查书架",
                    "text": "（书架上陈列了很多书籍。很遗憾，并没有和新生月神，或是哥伦比娅有关的内容。）"
                }
            ]
        },
        {
            "id": "602453",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "60245301",
                    "speaker": "匝黎尼亚",
                    "text": "我们应该相信他的承诺吗？"
                },
                {
                    "id": "60245302",
                    "speaker": "阿德禄拉雅",
                    "text": "我们只能相信他了。"
                }
            ]
        },
        {
            "id": "602454",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "60245401",
                    "speaker": "勒亚革欧瑟",
                    "text": "为何这个世界的创造者，不再怜悯他们的子民了呢？"
                },
                {
                    "id": "60245402",
                    "speaker": "玛诺薛西斯",
                    "text": "记住他的话…我们需要靠自己…改变命运…"
                }
            ]
        },
        {
            "id": "602499",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "60249901",
                    "speaker": "尼可",
                    "text": "唔，有点怪怪的…「他」是谁？"
                },
                {
                    "id": "60249902",
                    "speaker": "派蒙",
                    "text": "怎么了？"
                },
                {
                    "id": "60249903",
                    "speaker": "尼可",
                    "text": "没什么，只是脑海里出现了三十多个可能性，一下没法确定是谁…果然还是时间太久，记不太清了。"
                },
                {
                    "id": "60249904",
                    "speaker": "派蒙",
                    "text": "好、好吧…你真厉害。"
                },
                {
                    "id": "60249905",
                    "speaker": "Black Screen",
                    "text": "通知朋友之后，众人分头前往哥伦比娅可能存在的各处呼唤她的名字。\\n而你选择了最初遇见她的地方…"
                }
            ]
        }
    ]
