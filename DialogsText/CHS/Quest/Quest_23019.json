    "talks": [
        {
            "id": "2301901",
            "objective": "与拉菲克对话",
            "dialogues": [
                {
                    "id": "230190101",
                    "speaker": "拉菲克",
                    "text": "果然，这样做会更花钱啊…"
                },
                {
                    "id": "230190102",
                    "speaker": "Player",
                    "text": "你在说什么呢？"
                },
                {
                    "id": "230190103",
                    "speaker": "拉菲克",
                    "text": "啊，你好，我正在研究一艘船只的设计问题呢，现在…遇到了一些瓶颈。"
                },
                {
                    "id": "230190104",
                    "speaker": "拉菲克",
                    "text": "简单来说，就是我想在不提高造价的情况下，让船能装更多的东西。"
                },
                {
                    "id": "230190105",
                    "speaker": "拉菲克",
                    "text": "一旦重量大了，结构会变得更容易破损，重量不均匀的情况下平衡也会出现问题…"
                },
                {
                    "id": "230190106",
                    "speaker": "拉菲克",
                    "text": "解决这些问题的最好方法，就是用更好的材料，但这样…问题就又回到了造价问题上…"
                },
                {
                    "id": "230190107",
                    "speaker": "拉菲克",
                    "text": "唉，其实说白了就是我没钱，但又想要造出一艘好船。"
                },
                {
                    "id": "230190108",
                    "speaker": "拉菲克",
                    "text": "所以某些用钱就能砸通的问题，我只能想办法用一些技术性的手段绕过去。"
                },
                {
                    "id": "230190109",
                    "speaker": "Player",
                    "text": "真的能这么做吗…"
                },
                {
                    "id": "230190110",
                    "speaker": "拉菲克",
                    "text": "哈哈哈，说出来你可能不信，但其实有很多人都这么做。"
                },
                {
                    "id": "230190111",
                    "speaker": "拉菲克",
                    "text": "毕竟我们造的船也都是不会遇见什么风浪的近海渔船。"
                },
                {
                    "id": "230190112",
                    "speaker": "拉菲克",
                    "text": "大家都秉承着能省则省，修修补补的原则造船…凑合凑合，能用就行。"
                },
                {
                    "id": "230190113",
                    "speaker": "拉菲克",
                    "text": "拜这原则所赐，我们修船的生意每天都好得不行。"
                },
                {
                    "id": "230190114",
                    "speaker": "拉菲克",
                    "text": "旅行者，如果你愿意的话，就帮我去那边检查一下那艘刚回港的船吧，它貌似因为经常运载重物出了点问题。"
                },
                {
                    "id": "230190115",
                    "speaker": "拉菲克",
                    "text": "我刚好就在研究这方面的问题，说不定能从它身上找到点灵感。",
                    "choices": [
                        {
                            "id": "230190116",
                            "text": "交给我吧。",
                            "response": [
                                {
                                    "id": "230190117",
                                    "speaker": "拉菲克",
                                    "text": "那就拜托你了！我得赶紧去修另外一艘船去了…"
                                }
                            ]
                        },
                        {
                            "id": "230190118",
                            "text": "你自己怎么不去？",
                            "response": [
                                {
                                    "id": "230190119",
                                    "speaker": "拉菲克",
                                    "text": "我也想自己去，但我还被人拜托去维修另外一艘急着要再出海收网的船…"
                                },
                                {
                                    "id": "230190120",
                                    "speaker": "拉菲克",
                                    "text": "所以就只能拜托你了，旅行者！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2301902",
            "objective": "前往船只上调查",
            "dialogues": [
                {
                    "id": "230190201",
                    "speaker": "拉菲克",
                    "text": "怎么每天都有这么多事要处理，唉…"
                }
            ]
        },
        {
            "id": "2301905",
            "objective": "检查1点开车$HIDDEN",
            "dialogues": []
        },
        {
            "id": "2301903",
            "objective": "检查船体",
            "dialogues": []
        },
        {
            "id": "2301904",
            "objective": "回去向拉菲克说明情况",
            "dialogues": [
                {
                    "id": "230190401",
                    "speaker": "拉菲克",
                    "text": "怎么样，你检查完那艘船了吗？"
                },
                {
                    "id": "230190402",
                    "speaker": "Player",
                    "text": "已经检查完了…"
                },
                {
                    "id": "230190403",
                    "speaker": "Black Screen",
                    "text": "在描述了船只情况之后…"
                },
                {
                    "id": "230190404",
                    "speaker": "拉菲克",
                    "text": "原来如此，那些为了省钱而用了取巧功夫的结构果然出问题了啊…"
                },
                {
                    "id": "230190405",
                    "speaker": "拉菲克",
                    "text": "但维修这种结构要花不少钱，那个船主人，我记得手头一直很拮据…"
                },
                {
                    "id": "230190406",
                    "speaker": "拉菲克",
                    "text": "唉，我还是去和他谈谈吧，和钱相比，肯定是命更重要啊…"
                }
            ]
        }
    ]
}