            "dialogues": [
                {
                    "id": "190680601",
                    "speaker": "诺艾尔的学习笔记",
                    "text": "#「创造两人的独处空间」、「为{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}献上亲手做的蛋糕」…"
