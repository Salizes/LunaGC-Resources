    "talks": [
        {
            "id": "201001",
            "objective": "前往约定地点与哲平汇合",
            "dialogues": []
        },
        {
            "id": "201002",
            "objective": "与哲平对话",
            "dialogues": [
                {
                    "id": "20100201",
                    "speaker": "哲平",
                    "text": "#哟，{NICKNAME}，你来啦。"
                },
                {
                    "id": "20100202",
                    "speaker": "哲平",
                    "text": "马上就到与珊瑚宫大人约定的日子了，我们也该出发了。"
                },
                {
                    "id": "20100203",
                    "speaker": "哲平",
                    "text": "准备好了吗？我先带你去我们<color=#00E1FFFF>海祇岛</color>的军营看看，之后我们一起去找珊瑚宫大人。"
                },
                {
                    "id": "20100204",
                    "speaker": "哲平",
                    "text": "如果中途晕船的话，要及时跟我说。不过听说你在南十字船队待过，应该没事吧…"
                },
                {
                    "id": "20100205",
                    "speaker": "哲平",
                    "text": "准备，起航！"
                }
            ]
        },
        {
            "id": "201003",
            "objective": "前往反抗军营地",
            "dialogues": []
        },
        {
            "id": "201004",
            "objective": "与哲平对话",
            "dialogues": [
                {
                    "id": "20100401",
                    "speaker": "哲平",
                    "text": "这里就是我们海祇岛军队的训练营了。"
                },
                {
                    "id": "20100402",
                    "speaker": "哲平",
                    "text": "目前的反抗军，绝大部分都是由海祇岛的本土士兵组成。"
                },
                {
                    "id": "20100403",
                    "speaker": "哲平",
                    "text": "一部分人在踏鞴砂跟幕府军正面交战，一部分人留在海祇岛，保护百姓的安全。"
                },
                {
                    "id": "20100404",
                    "speaker": "派蒙",
                    "text": "哲平以前也在这里训练吗？"
                },
                {
                    "id": "20100405",
                    "speaker": "哲平",
                    "text": "是啊，可惜我还没有完全得到教官的认可，就不得不去踏鞴砂参战了，只能先在后勤部队帮点小忙…"
                },
                {
                    "id": "20100406",
                    "speaker": "哲平",
                    "text": "我暂时会住在这里，如果你想找我的话，来这里就好。"
                },
                {
                    "id": "20100407",
                    "speaker": "哲平",
                    "text": "要是我不在，你可以写个字条，贴在附近的墙上。我看到了就会去找你…"
                },
                {
                    "id": "20100408",
                    "speaker": "哲平",
                    "text": "…糟了，快到与<color=#00E1FFFF>珊瑚宫大人</color>约定的时间了。"
                },
                {
                    "id": "20100409",
                    "speaker": "哲平",
                    "text": "下次再带你逛一逛海祇岛吧，我先带你去<color=#00E1FFFF>珊瑚宫</color>！"
                },
                {
                    "id": "20100410",
                    "speaker": "派蒙",
                    "text": "珊瑚宫，应该就是那位<color=#00E1FFFF>珊瑚宫心海</color>住的地方…我们过去看看吧。"
                }
            ]
        },
        {
            "id": "201005",
            "objective": "前往珊瑚宫",
            "dialogues": []
        },
        {
            "id": "201006",
            "objective": "与珊瑚宫心海对话",
            "dialogues": [
                {
                    "id": "20100601",
                    "speaker": "珊瑚宫心海",
                    "text": "无论如何，粮草都是重中之重，不能有任何闪失。"
                },
                {
                    "id": "20100602",
                    "speaker": "珊瑚宫心海",
                    "text": "如今我们和幕府军之间的冲突日渐激烈，必须要优先保证后方稳定。"
                },
                {
                    "id": "20100603",
                    "speaker": "大久保大介",
                    "text": "是。我再想想办法…"
                },
                {
                    "id": "20100604",
                    "speaker": "珊瑚宫心海",
                    "text": "放心，有了之前那批物资，我也在着手扩充军队。"
                },
                {
                    "id": "20100605",
                    "speaker": "珊瑚宫心海",
                    "text": "人手不足的时候辛苦你们了，之后的局面应该会有所好转。"
                },
                {
                    "id": "20100606",
                    "speaker": "大久保大介",
                    "text": "扩充军队？太好了。虽然不知道这次是谁在背后资助我们，但真是帮大忙了…"
                },
                {
                    "id": "20100607",
                    "speaker": "大久保大介",
                    "text": "欸？这不是哲平吗，你小子回海祇岛了？"
                },
                {
                    "id": "20100608",
                    "speaker": "大久保大介",
                    "text": "这位是…"
                },
                {
                    "id": "20100609",
                    "speaker": "哲平",
                    "text": "#嘿嘿，是珊瑚宫大人的客人哦，我是负责把{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}带回海祇岛的。"
                },
                {
                    "id": "20100610",
                    "speaker": "大久保大介",
                    "text": "哦？莫非就是最近军队中已有传言的那位…力大无穷、百步穿杨、金刚不坏的新人？"
                },
                {
                    "id": "20100611",
                    "speaker": "派蒙",
                    "text": "为什么会有这样的传闻啦！"
                },
                {
                    "id": "20100612",
                    "speaker": "大久保大介",
                    "text": "两位远道而来，多半是有要紧事。我就不多打扰了，之后有空，也可以来我这坐坐。"
                },
                {
                    "id": "20100613",
                    "speaker": "大久保大介",
                    "text": "那珊瑚宫大人，我就先行告退了。"
                },
                {
                    "id": "20100614",
                    "speaker": "哲平",
                    "text": "珊瑚宫大人，我刚刚好像听到大久保大哥说什么「资助」，那是什么？"
                },
                {
                    "id": "20100615",
                    "speaker": "珊瑚宫心海",
                    "text": "不久之前，有人写信给我，说愿意支持海祇岛的抗争，并且送来了大量的物资。"
                },
                {
                    "id": "20100616",
                    "speaker": "珊瑚宫心海",
                    "text": "拜此所赐，我们终于可以放开手脚招兵买马，与幕府军在正面战场展开对抗。",
                    "choices": [
                        {
                            "id": "20100617",
                            "text": "那真是太好了。",
                            "response": [
                                {
                                    "id": "20100618",
                                    "speaker": "珊瑚宫心海",
                                    "text": "其实我对此还有疑虑…不过海祇岛并不富庶，这笔物资确实是雪中送炭。"
                                },
                                {
                                    "id": "20100621",
                                    "speaker": "珊瑚宫心海",
                                    "text": "对方的要求也不过分，只说让我们竭尽全力对抗幕府军。"
                                },
                                {
                                    "id": "20100622",
                                    "speaker": "珊瑚宫心海",
                                    "text": "不管他们的目的是什么，至少在这一点上我们是一致的，那就当做是多了一个不愿露面的盟友吧。"
                                },
                                {
                                    "id": "20100623",
                                    "speaker": "珊瑚宫心海",
                                    "text": "当然，也不能完全放松警惕。如果你们发现任何异样，请及时汇报给我。"
                                },
                                {
                                    "id": "20100624",
                                    "speaker": "哲平",
                                    "text": "珊瑚宫大人，那前线的伙食是不是也会变好？前几天去伤兵营，那些家伙吵着要吃烤肉。"
                                },
                                {
                                    "id": "20100625",
                                    "speaker": "珊瑚宫心海",
                                    "text": "呵呵…放心，我已经安排好了。烤肉管饱，不过还是不许喝酒。"
                                },
                                {
                                    "id": "20100626",
                                    "speaker": "哲平",
                                    "text": "太好了！"
                                },
                                {
                                    "id": "20100627",
                                    "speaker": "珊瑚宫心海",
                                    "text": "也难为你们了。从眼狩令颁布、我们起兵反抗以来，军中的饭菜确实很少更换。"
                                },
                                {
                                    "id": "20100628",
                                    "speaker": "珊瑚宫心海",
                                    "text": "之后我会和后勤部队进行协商，在这方面做出一些改变。"
                                },
                                {
                                    "id": "20100629",
                                    "speaker": "珊瑚宫心海",
                                    "text": "不过我们的物资还是有限，胜利之前，还希望你们再忍耐一下。"
                                },
                                {
                                    "id": "20100630",
                                    "speaker": "派蒙",
                                    "text": "那眼狩令，什么时候才能结束呢？"
                                },
                                {
                                    "id": "20100631",
                                    "speaker": "珊瑚宫心海",
                                    "text": "这个问题…我也没有答案。"
                                },
                                {
                                    "id": "20100632",
                                    "speaker": "珊瑚宫心海",
                                    "text": "眼狩令的颁布本就很奇怪。不管是天领奉行，还是将军大人，他们的态度都很微妙。"
                                },
                                {
                                    "id": "20100633",
                                    "speaker": "珊瑚宫心海",
                                    "text": "天领奉行突然对眼狩令追捧至极，而将军大人似乎也对眼狩令带来的战争视而不见…"
                                },
                                {
                                    "id": "20100634",
                                    "speaker": "珊瑚宫心海",
                                    "text": "在解开这些谜题之前，眼狩令恐怕都不会结束。我只能向你保证，只要眼狩令还在，我们就不会放弃反抗。"
                                },
                                {
                                    "id": "20100635",
                                    "speaker": "珊瑚宫心海",
                                    "text": "#{NICKNAME}，现在我想再确认一下。在了解到海祇岛和反抗军的现状之后，你还愿意与我们一同抗争吗？"
                                },
                                {
                                    "id": "20100636",
                                    "speaker": "Player",
                                    "text": "我不会放弃。"
                                },
                                {
                                    "id": "20100637",
                                    "speaker": "珊瑚宫心海",
                                    "text": "好，那现在，我正式颁布对你的任命——"
                                },
                                {
                                    "id": "20100638",
                                    "speaker": "珊瑚宫心海",
                                    "text": "从现在起，你将升任海祇岛特别行动队「剑鱼二番队」的队长。"
                                },
                                {
                                    "id": "20100639",
                                    "speaker": "哲平",
                                    "text": "剑剑剑剑鱼二番队？是我理解的那个，被冠以「剑鱼」之名的特别行动队吗？"
                                },
                                {
                                    "id": "20100640",
                                    "speaker": "哲平",
                                    "text": "我记得光是进入特别行动队就很难了，居然可以一口气当上队长…这也太厉害了！"
                                },
                                {
                                    "id": "20100641",
                                    "speaker": "珊瑚宫心海",
                                    "text": "虽然是破格任命，但我相信以你的智慧、勇气与力量，可以带领这支队伍走向胜利。"
                                },
                                {
                                    "id": "20100642",
                                    "speaker": "派蒙",
                                    "text": "好耶！那我们什么时候去上任呀？"
                                },
                                {
                                    "id": "20100643",
                                    "speaker": "珊瑚宫心海",
                                    "text": "剑鱼二番队如今正在本岛<color=#00E1FFFF>西南</color>处的山谷待命，最近有一些<color=#00E1FFFF>流浪武士</color>闹事，需要特别行动队来稳定后方。"
                                },
                                {
                                    "id": "20100644",
                                    "speaker": "珊瑚宫心海",
                                    "text": "委任书我已经写好，你给他们看一下就可以了。那些流浪武士，也麻烦你一起清剿。"
                                },
                                {
                                    "id": "20100645",
                                    "speaker": "珊瑚宫心海",
                                    "text": "特别行动队的人都是海祇岛的精锐，身上或许会有些傲气，不过相信你能够赢得他们的信任。"
                                },
                                {
                                    "id": "20100646",
                                    "speaker": "哲平",
                                    "text": "那，那我呢？珊瑚宫大人，有什么作战需要我吗？"
                                },
                                {
                                    "id": "20100647",
                                    "speaker": "哲平",
                                    "text": "我也想为反抗军多做一些贡献！"
                                },
                                {
                                    "id": "20100648",
                                    "speaker": "珊瑚宫心海",
                                    "text": "当然有了，等下我也会给你安排。"
                                },
                                {
                                    "id": "20100649",
                                    "speaker": "哲平",
                                    "text": "#保证完成任务！嘿嘿，{NICKNAME}，虽然你已经当上了剑鱼二番队的小队长，但我也不会输给你。"
                                },
                                {
                                    "id": "20100650",
                                    "speaker": "派蒙",
                                    "text": "好吧，你小心一点，不要太勉强了。"
                                },
                                {
                                    "id": "20100651",
                                    "speaker": "派蒙",
                                    "text": "#{NICKNAME}，我们也出发吧。"
                                }
                            ]
                        },
                        {
                            "id": "20100619",
                            "text": "真的靠谱吗？",
                            "response": [
                                {
                                    "id": "20100620",
                                    "speaker": "珊瑚宫心海",
                                    "text": "我对此也有疑虑…不过海祇岛并不富庶，这笔物资确实是雪中送炭。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "201012",
            "objective": "前往「剑鱼二番队」驻扎地点",
            "dialogues": []
        },
        {
            "id": "201013",
            "objective": "与「剑鱼二番队」成员对话",
            "dialogues": [
                {
                    "id": "20101301",
                    "speaker": "剑鱼二番队代理队长",
                    "text": "你就是新任的剑鱼二番队队长吧，珊瑚宫大人已经跟我们说了。"
                },
                {
                    "id": "20101302",
                    "speaker": "剑鱼二番队代理队长",
                    "text": "军队中早有关于你的传闻，委任书也确认完毕。不过我尚有一个疑虑…"
                },
                {
                    "id": "20101303",
                    "speaker": "派蒙",
                    "text": "嗯？还有什么问题吗？"
                },
                {
                    "id": "20101304",
                    "speaker": "剑鱼二番队代理队长",
                    "text": "简单来说，就是你是否值得我们追随。"
                },
                {
                    "id": "20101305",
                    "speaker": "派蒙",
                    "text": "你们的意思是…"
                },
                {
                    "id": "20101306",
                    "speaker": "剑鱼二番队老兵",
                    "text": "放在平时，最直接的做法就是痛痛快快地打一场。不过现在嘛，这里有更好的靶子。"
                },
                {
                    "id": "20101307",
                    "speaker": "剑鱼二番队老兵",
                    "text": "我们驻扎在这里，是因为最近很多<color=#00E1FFFF>流浪武士</color>闹事。如果你能把这些<color=#00E1FFFF>流浪武士</color>干掉，我们就认可你的实力。"
                },
                {
                    "id": "20101308",
                    "speaker": "Player",
                    "text": "没问题。"
                },
                {
                    "id": "20101309",
                    "speaker": "派蒙",
                    "text": "嗯嗯，就让他们心服口服吧！"
                }
            ]
        },
        {
            "id": "201017",
            "objective": "(test)刷出怪物用$HIDDEN",
            "dialogues": []
        },
        {
            "id": "201007",
            "objective": "清除附近魔物威胁",
            "dialogues": []
        },
        {
            "id": "201014",
            "objective": "与「剑鱼二番队」成员对话",
            "dialogues": [
                {
                    "id": "20101401",
                    "speaker": "剑鱼二番队代理队长",
                    "text": "有两下子嘛…虽然不如传闻中那么夸张，但确实很厉害。"
                },
                {
                    "id": "20101402",
                    "speaker": "幸德",
                    "text": "介绍一下，我叫幸德，剑鱼二番队的代理队长。这位是嘉久，也是队伍中的老兵了。"
                },
                {
                    "id": "20101403",
                    "speaker": "幸德",
                    "text": "现在，我正式把「队长」一职交给你。剑鱼二番队，随时待命。"
                },
                {
                    "id": "20101404",
                    "speaker": "Player",
                    "text": "还有别的流浪武士闹事吗？"
                },
                {
                    "id": "20101405",
                    "speaker": "嘉久",
                    "text": "遭到袭击的重灾区有两处，这里的流浪武士已经被队长干掉，他们的据点就只剩下<color=#00E1FFFF>本岛东部</color>的浅滩了。"
                },
                {
                    "id": "20101406",
                    "speaker": "嘉久",
                    "text": "不过那里的流浪武士数量更多，战斗力也更强。",
                    "choices": [
                        {
                            "id": "20101407",
                            "text": "过去看看吧。",
                            "response": [
                                {
                                    "id": "20101409",
                                    "speaker": "派蒙",
                                    "text": "是呀，海祇岛还在和幕府军打仗呢，不能让这些坏家伙在后面捣乱！"
                                }
                            ]
                        },
                        {
                            "id": "20101408",
                            "text": "心海也说要保证后方安全。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "201010",
            "objective": "前往有魔物威胁的地点",
            "dialogues": []
        },
        {
            "id": "201016",
            "objective": "与「剑鱼二番队」成员对话",
            "dialogues": [
                {
                    "id": "20101601",
                    "speaker": "派蒙",
                    "text": "好多流浪武士…"
                },
                {
                    "id": "20101602",
                    "speaker": "幸德",
                    "text": "这还只是其中的一部分，他们在附近还有两个营地。"
                },
                {
                    "id": "20101603",
                    "speaker": "幸德",
                    "text": "不管我们进攻哪个营地，其他两个营地的流浪武士都会成为隐患。他们可以自由选择支援或逃走。"
                },
                {
                    "id": "20101604",
                    "speaker": "Player",
                    "text": "那就同时进攻…"
                },
                {
                    "id": "20101605",
                    "speaker": "幸德",
                    "text": "可是这样的话，队长有可能遇到危险…"
                },
                {
                    "id": "20101606",
                    "speaker": "幸德",
                    "text": "分兵之后，保护队长的人数太少，我有点不放心。"
                },
                {
                    "id": "20101607",
                    "speaker": "Player",
                    "text": "没事。"
                },
                {
                    "id": "20101608",
                    "speaker": "派蒙",
                    "text": "没错没错，这点人还伤不到我们哦！"
                },
                {
                    "id": "20101609",
                    "speaker": "幸德",
                    "text": "好吧。那我们将他们一网打尽，之后再回来与队长会合！"
                }
            ]
        },
        {
            "id": "201018",
            "objective": "(test)悄悄的把NPC换成怪物$HIDDEN",
            "dialogues": []
        },
        {
            "id": "201008",
            "objective": "清除附近魔物威胁",
            "dialogues": []
        },
        {
            "id": "201015",
            "objective": "与「剑鱼二番队」成员对话",
            "dialogues": [
                {
                    "id": "20101501",
                    "speaker": "派蒙",
                    "text": "#这样应该就可以了…{NICKNAME}，你没受伤吧？",
                    "choices": [
                        {
                            "id": "20101502",
                            "text": "没事。",
                            "response": [
                                {
                                    "id": "20101504",
                                    "speaker": "派蒙",
                                    "text": "嗯嗯…也不知道幸德和嘉久那边怎么样了。要不要过去看看呢？"
                                },
                                {
                                    "id": "20101505",
                                    "speaker": "嘉久",
                                    "text": "队长——"
                                },
                                {
                                    "id": "20101506",
                                    "speaker": "幸德",
                                    "text": "报告队长，其他两个营地清剿完毕，这样整个海祇岛的后方就暂时安全了。"
                                },
                                {
                                    "id": "20101507",
                                    "speaker": "派蒙",
                                    "text": "太好了！嘿嘿，既解决了流浪武士的麻烦，又得到了大家的认可…"
                                },
                                {
                                    "id": "20101508",
                                    "speaker": "派蒙",
                                    "text": "不过之后应该做些什么呢？还是回去问问心海吧。"
                                },
                                {
                                    "id": "20101509",
                                    "speaker": "嘉久",
                                    "text": "这次终于出了口恶气，早就看这帮流浪武士不顺眼了，不过幸德以前一直不让打。"
                                },
                                {
                                    "id": "20101510",
                                    "speaker": "幸德",
                                    "text": "啊？说得好像没有队长在，你们打得过一样。我不是为了你们好吗？"
                                },
                                {
                                    "id": "20101511",
                                    "speaker": "嘉久",
                                    "text": "明明是你比较胆小…"
                                },
                                {
                                    "id": "20101512",
                                    "speaker": "派蒙",
                                    "text": "喂喂，不可以吵架哦！"
                                },
                                {
                                    "id": "20101513",
                                    "speaker": "派蒙",
                                    "text": "#真是的…{NICKNAME}，我们还是先去跟<color=#00E1FFFF>心海</color>复命吧。"
                                }
                            ]
                        },
                        {
                            "id": "20101503",
                            "text": "就是有点累。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "201011",
            "objective": "回到本部，与珊瑚宫心海对话",
            "dialogues": [
                {
                    "id": "20101101",
                    "speaker": "珊瑚宫心海",
                    "text": "#怎么样，{NICKNAME}，上任的过程还顺利吗？",
                    "choices": [
                        {
                            "id": "20101102",
                            "text": "很顺利。",
                            "response": [
                                {
                                    "id": "20101103",
                                    "speaker": "珊瑚宫心海",
                                    "text": "呵呵…虽然这么说，但幸德他们应该还是稍微考验了你一下吧？"
                                },
                                {
                                    "id": "20101106",
                                    "speaker": "珊瑚宫心海",
                                    "text": "不过，相信以你的能力，通过这种考验还是很轻松的。"
                                },
                                {
                                    "id": "20101107",
                                    "speaker": "珊瑚宫心海",
                                    "text": "你回来复命，说明登陆海祇岛的流浪武士已经被赶跑了吧？"
                                },
                                {
                                    "id": "20101122",
                                    "speaker": "派蒙",
                                    "text": "当然啦，我们可是把他们揍得落花流水呢！"
                                },
                                {
                                    "id": "20101108",
                                    "speaker": "珊瑚宫心海",
                                    "text": "这样就可以了，接下来只要让大久保派人严加看守，就可以避免他们再次闹事。"
                                },
                                {
                                    "id": "20101109",
                                    "speaker": "珊瑚宫心海",
                                    "text": "辛苦了。有功当赏，必须要给你奖励才行。让我想想…升职不行，太快了。增加军饷…"
                                },
                                {
                                    "id": "20101110",
                                    "speaker": "Player",
                                    "text": "怎么没看见哲平？"
                                },
                                {
                                    "id": "20101111",
                                    "speaker": "珊瑚宫心海",
                                    "text": "我给哲平也安排了任务，是一个奇袭幕府海军的作战。"
                                },
                                {
                                    "id": "20101112",
                                    "speaker": "珊瑚宫心海",
                                    "text": "他不愿意呆在后方，我也尊重他的选择。"
                                },
                                {
                                    "id": "20101113",
                                    "speaker": "珊瑚宫心海",
                                    "text": "#言归正传，{NICKNAME}，有一项特殊的任务，我想要交给你。"
                                },
                                {
                                    "id": "20101114",
                                    "speaker": "派蒙",
                                    "text": "「特殊的任务」？"
                                },
                                {
                                    "id": "20101115",
                                    "speaker": "珊瑚宫心海",
                                    "text": "是的。在海祇岛和踏鞴砂之间，有一处<color=#00E1FFFF>魔神遗迹</color>。那里有几个小岛，经常被当做运送物资的中转站。"
                                },
                                {
                                    "id": "20101116",
                                    "speaker": "珊瑚宫心海",
                                    "text": "不过这段时间，存放在那里的粮草经常会莫名其妙地消失。"
                                },
                                {
                                    "id": "20101117",
                                    "speaker": "珊瑚宫心海",
                                    "text": "但是，军队路过的时候，却又说没有发现危险…我想委托你帮忙查证一下真相。"
                                },
                                {
                                    "id": "20101118",
                                    "speaker": "珊瑚宫心海",
                                    "text": "此事并不急迫，不必太过匆忙。这几天，你们不妨先熟悉一下军队，也可以在海祇岛各处转转。"
                                },
                                {
                                    "id": "20101119",
                                    "speaker": "珊瑚宫心海",
                                    "text": "等哲平回来之后，你可以跟他聊聊天，然后找个天气晴朗的日子出海。"
                                },
                                {
                                    "id": "20101120",
                                    "speaker": "派蒙",
                                    "text": "哲平他真的没事吗…"
                                },
                                {
                                    "id": "20101121",
                                    "speaker": "派蒙",
                                    "text": "#一想到他以前冒失的样子，就有点担心。对了，{NICKNAME}，我们去<color=#00E1FFFF>训练营</color>等他吧！"
                                }
                            ]
                        },
                        {
                            "id": "20101104",
                            "text": "遇到了一点「考验」。",
                            "response": [
                                {
                                    "id": "20101105",
                                    "speaker": "珊瑚宫心海",
                                    "text": "嗯，确实是他们的性格。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "201009",
            "objective": "与哲平对话",
            "dialogues": [
                {
                    "id": "20100901",
                    "speaker": "哲平",
                    "text": "#好久不见啦，{NICKNAME}。"
                },
                {
                    "id": "20100902",
                    "speaker": "哲平",
                    "text": "怎么样，和剑鱼二番队那些人还合得来吗？",
                    "choices": [
                        {
                            "id": "20100903",
                            "text": "合得来。",
                            "response": [
                                {
                                    "id": "20100905",
                                    "speaker": "哲平",
                                    "text": "嘿嘿，就让我这个前辈教你一些统兵之道吧！"
                                },
                                {
                                    "id": "20100906",
                                    "speaker": "哲平",
                                    "text": "你要给他们增加军饷，还要设置一些悬赏，要让他们遵守纪律…还有什么来着？"
                                },
                                {
                                    "id": "20100907",
                                    "speaker": "派蒙",
                                    "text": "哇哦…哲平，你是从哪听来的啊？"
                                },
                                {
                                    "id": "20100908",
                                    "speaker": "哲平",
                                    "text": "从一本八重堂出版的小说…那是好久以前的事了。当时我用好几个团子当贿赂，那个朋友才答应借我看。"
                                },
                                {
                                    "id": "20100909",
                                    "speaker": "派蒙",
                                    "text": "居然试图用小说里的东西指导军队，这就是别人说的「纸上谈兵」吗？"
                                },
                                {
                                    "id": "20100910",
                                    "speaker": "哲平",
                                    "text": "哼哼，不要小看我哦。现在我可是和你们一样，正在学习和摸索「治军之道」呢。",
                                    "choices": [
                                        {
                                            "id": "20100911",
                                            "text": "难道说…",
                                            "response": [
                                                {
                                                    "id": "20100913",
                                                    "speaker": "哲平",
                                                    "text": "没错！因为在海战中立下了汗马功劳，现在我也是特别行动队的队长了！"
                                                },
                                                {
                                                    "id": "20100914",
                                                    "speaker": "哲平",
                                                    "text": "而且还是一个全新的小队，「鲱鱼一番队」！怎么样，听起来是不是很厉害？"
                                                },
                                                {
                                                    "id": "20100915",
                                                    "speaker": "哲平",
                                                    "text": "我问过珊瑚宫大人啦，珊瑚宫大人说，我们的队服都已经在制作中了。"
                                                },
                                                {
                                                    "id": "20100916",
                                                    "speaker": "哲平",
                                                    "text": "等制作好了，我们一起去把队服取回来。之后换上全新的队服见面，想想就觉得很酷！"
                                                },
                                                {
                                                    "id": "20100917",
                                                    "speaker": "哲平",
                                                    "text": "真好啊，多亏了从资助方那里拿到的东西…"
                                                },
                                                {
                                                    "id": "20100918",
                                                    "speaker": "派蒙",
                                                    "text": "那个队服，我也会有吗？"
                                                },
                                                {
                                                    "id": "20100919",
                                                    "speaker": "哲平",
                                                    "text": "当然了！你也是我们海祇岛军队的一员呀。"
                                                },
                                                {
                                                    "id": "20100920",
                                                    "speaker": "派蒙",
                                                    "text": "好耶！"
                                                },
                                                {
                                                    "id": "20100921",
                                                    "speaker": "鲱鱼一番队队员",
                                                    "text": "队长，有新的作战任务到了…"
                                                },
                                                {
                                                    "id": "20100922",
                                                    "speaker": "哲平",
                                                    "text": "#嗯，我现在过去。那我先走啦，{NICKNAME}，下次再见。"
                                                },
                                                {
                                                    "id": "20100923",
                                                    "speaker": "哲平",
                                                    "text": "你可要小心一点，不要被我轻易地超过去了哦。"
                                                },
                                                {
                                                    "id": "20100924",
                                                    "speaker": "派蒙",
                                                    "text": "我们才不会输给你呢！"
                                                },
                                                {
                                                    "id": "20100925",
                                                    "speaker": "哲平",
                                                    "text": "咳咳…这可难说。现在我的状态超级好，正是建功立业的好时候！"
                                                },
                                                {
                                                    "id": "20100926",
                                                    "speaker": "派蒙",
                                                    "text": "没想到哲平居然也升到小队长啦，看来他真的很努力呢。"
                                                },
                                                {
                                                    "id": "20100927",
                                                    "speaker": "派蒙",
                                                    "text": "我们休息一下，然后去<color=#00E1FFFF>魔神战争遗迹</color>那边看看吧！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "20100912",
                                            "text": "哲平也…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "20100904",
                            "text": "有些苦恼…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "201051",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "20105101",
                    "speaker": "珊瑚宫心海",
                    "text": "今后，一起努力吧。"
                }
            ]
        },
        {
            "id": "201052",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "20105201",
                    "speaker": "哲平",
                    "text": "虽然直升队长确实很厉害，但我也不会掉队的！早晚有一天会赶上你的！"
                }
            ]
        },
        {
            "id": "201053",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "20105301",
                    "speaker": "剑鱼二番队代理队长",
                    "text": "让我看看，你是否值得我们追随。"
                },
                {
                    "id": "20105302",
                    "speaker": "剑鱼二番队老兵",
                    "text": "上司无能的话，我们也会跟着送命。所以在这件事上我们可是很严格的。"
                }
            ]
        }
    ]
}