    "talks": [
        {
            "id": "7369101",
            "objective": "与法尔博对话",
            "dialogues": [
                {
                    "id": "736910101",
                    "speaker": "法尔博",
                    "text": "希望大家能够喜欢这个玩具啊…"
                },
                {
                    "id": "736910102",
                    "speaker": "Player",
                    "text": "这边有什么玩的？"
                },
                {
                    "id": "736910103",
                    "speaker": "法尔博",
                    "text": "你是…旅行者对吧？我是梨多梵谛学院的学生法尔博。"
                },
                {
                    "id": "736910104",
                    "speaker": "法尔博",
                    "text": "呃…你知道我们学院是研究什么的吗？"
                },
                {
                    "id": "736910105",
                    "speaker": "Player",
                    "text": "唔…我记得应该是…"
                },
                {
                    "id": "736910106",
                    "speaker": "法尔博",
                    "text": "我们梨多梵谛学院专注于研究星象啦，当然，这么说不太准确，学院里还细分了很多研究领域…"
                },
                {
                    "id": "736910107",
                    "speaker": "法尔博",
                    "text": "但很遗憾的是，我们研究的很多东西就算拿出来说，一般人也不一定听得懂，或者是…有兴趣听。"
                },
                {
                    "id": "736910108",
                    "speaker": "法尔博",
                    "text": "如果直接摆出一个占星摊，我又怕负责摊位的各位同学会不由自主陷入学术讨论中，完全没心思管摊位。"
                },
                {
                    "id": "736910109",
                    "speaker": "法尔博",
                    "text": "所以，在多方讨论之后，我们决定出了一个折中的方案。"
                },
                {
                    "id": "736910110",
                    "speaker": "法尔博",
                    "text": "你看见这个特制星盘了吗？上面分布着很多星星，你所要做的，就是把这些星星拼成一个特定的图案。"
                },
                {
                    "id": "736910111",
                    "speaker": "法尔博",
                    "text": "这些图案也不会特别复杂，更不会涉及某些尚未有结论的学术争端。"
                },
                {
                    "id": "736910112",
                    "speaker": "法尔博",
                    "text": "咳，总之就是…一个简单而快乐，不会引起学术争执的拼图游戏。"
                },
                {
                    "id": "736910113",
                    "speaker": "Player",
                    "text": "你看起来好像挺紧张的…"
                },
                {
                    "id": "736910114",
                    "speaker": "法尔博",
                    "text": "毕竟这个游戏和星星有关嘛…咱们学院的部分学生只要听见星星两个字就会十分紧张。"
                },
                {
                    "id": "736910115",
                    "speaker": "法尔博",
                    "text": "你是不知道，在设计这个玩具的时候，我和多少同学解释过这只是一个玩具，和学术研究一点关系都没有…"
                },
                {
                    "id": "736910116",
                    "speaker": "法尔博",
                    "text": "不说了不说了，如果你有兴趣的话，就来试玩一下吧。",
                    "choices": [
                        {
                            "id": "736910117",
                            "text": "想要试玩看看。",
                            "response": [
                                {
                                    "id": "736910118",
                                    "speaker": "法尔博",
                                    "text": "没问题，星盘就在这里。"
                                }
                            ]
                        },
                        {
                            "id": "736910119",
                            "text": "还有别的事。",
                            "response": [
                                {
                                    "id": "736910120",
                                    "speaker": "法尔博",
                                    "text": "唔，反正在学院游乐会期间，我会一直在这边开着摊位，你想玩的话直接过来就好。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7369199",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "736919901",
                    "speaker": "法尔博",
                    "text": "（这真的就只是个玩具啊！唉，下次说什么我也不接这个活了…）"
                }
            ]
        }
    ]
}