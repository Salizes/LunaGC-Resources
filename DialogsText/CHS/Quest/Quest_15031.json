    "talks": [
        {
            "id": "1503101",
            "objective": "返回并告知部族众人",
            "dialogues": [
                {
                    "id": "150310101",
                    "speaker": "Black Screen",
                    "text": "首领阿卡特将「沃陆之邦」的众人召集到了一起，瓦雷莎简要地说明了蘑菇的调查进展。"
                },
                {
                    "id": "150310102",
                    "speaker": "阿卡特",
                    "text": "……"
                },
                {
                    "id": "150310103",
                    "speaker": "阿托力",
                    "text": "……"
                },
                {
                    "id": "150310104",
                    "speaker": "伊安珊",
                    "text": "……"
                },
                {
                    "id": "150310105",
                    "speaker": "派蒙",
                    "text": "我们在调查的时候感觉还好，现在从旁听者的角度听了一遍，感觉确实有点荒唐。"
                },
                {
                    "id": "150310106",
                    "speaker": "Player",
                    "text": "这种难以言述的沉默…"
                },
                {
                    "id": "150310107",
                    "speaker": "阿卡特",
                    "text": "原来如此，果园里的蘑菇居然有自己的意识，这可是个不得了的发现啊！"
                },
                {
                    "id": "150310108",
                    "speaker": "伊安珊",
                    "text": "是啊，要是没有你们调查，说不定会酝酿出很可怕的危机。"
                },
                {
                    "id": "150310109",
                    "speaker": "豪特利",
                    "text": "幸亏你们察觉到了，还收集了这么多线索！"
                },
                {
                    "id": "150310110",
                    "speaker": "瓦雷莎",
                    "text": "太好了，你们没觉得我讲的故事很奇怪…"
                },
                {
                    "id": "150310111",
                    "speaker": "阿卡特",
                    "text": "哈哈哈，奇怪是奇怪，毕竟和蘑菇说话这种事，我们谁都没经历过啊。"
                },
                {
                    "id": "150310112",
                    "speaker": "阿卡特",
                    "text": "但是瓦雷莎你从来都不是会骗人的孩子，这我们也都知道，再加上绿蘑菇对我们来说本来就是个谜题。"
                },
                {
                    "id": "150310113",
                    "speaker": "阿卡特",
                    "text": "现在既然发现了不好的苗头，我们大家当然都很愿意支持你们的调查！"
                },
                {
                    "id": "150310114",
                    "speaker": "伊安珊",
                    "text": "有什么需要帮忙的，尽管说就好了。"
                },
                {
                    "id": "150310115",
                    "speaker": "派蒙",
                    "text": "你们接受得好快！"
                },
                {
                    "id": "150310116",
                    "speaker": "Player",
                    "text": "太谢谢你们了。"
                },
                {
                    "id": "150310117",
                    "speaker": "阿托力",
                    "text": "刚刚说，需要用高温烹饪这种蘑菇对吧，稍等，我现在就去准备。"
                },
                {
                    "id": "150310118",
                    "speaker": "阿托力",
                    "text": "来了来了，我直接用铁盘煎了一下，这个温度应该够高！"
                },
                {
                    "id": "150310119",
                    "speaker": "派蒙",
                    "text": "哇，果然是很香的味道呢，我的食欲全都回来了。"
                },
                {
                    "id": "150310120",
                    "speaker": "瓦雷莎",
                    "text": "那、那我们就不客气了。"
                },
                {
                    "id": "150310121",
                    "speaker": "「蕈之贤主」",
                    "text": "嗯…"
                },
                {
                    "id": "150310122",
                    "speaker": "派蒙",
                    "text": "听到了吗，是它的声音！"
                },
                {
                    "id": "150310123",
                    "speaker": "「蕈之贤主」",
                    "text": "哈哈哈哈，看来你们是摸到了一点窍门，可是这种温度完全——展现不出丝毫的诚意。"
                },
                {
                    "id": "150310124",
                    "speaker": "「蕈之贤主」",
                    "text": "你们以为用家常的火，家常的工具，随便做一做，就能得到「蕈之贤主」的赏识？"
                },
                {
                    "id": "150310125",
                    "speaker": "「蕈之贤主」",
                    "text": "人类真是让我失望，有提示的时候，还能用智慧解决我留下的难题…"
                },
                {
                    "id": "150310126",
                    "speaker": "「蕈之贤主」",
                    "text": "结果没有提示，马上就原形毕露，采用的办法真是愚不可及。"
                },
                {
                    "id": "150310127",
                    "speaker": "「蕈之贤主」",
                    "text": "再去想想办法吧，嘻嘻嘻嘻——"
                },
                {
                    "id": "150310128",
                    "speaker": "阿托力",
                    "text": "怎、怎么样，听到它的声音了吗？"
                },
                {
                    "id": "150310129",
                    "speaker": "派蒙",
                    "text": "可恶，这家伙果然很讨厌！"
                },
                {
                    "id": "150310130",
                    "speaker": "派蒙",
                    "text": "它说温度还不够高，达不到它的要求，太难伺候了吧！",
                    "choices": [
                        {
                            "id": "150310131",
                            "text": "但是要弄清楚它想搞什么…",
                            "response": [
                                {
                                    "id": "150310133",
                                    "speaker": "阿卡特",
                                    "text": "温度不够高，那看来得用更厉害的手段才行。"
                                },
                                {
                                    "id": "150310134",
                                    "speaker": "阿卡特",
                                    "text": "听到了吗，各位，麻烦大家去收集一些高温的东西，什么都行！"
                                },
                                {
                                    "id": "150310135",
                                    "speaker": "阿托力",
                                    "text": "我去想想办法！"
                                },
                                {
                                    "id": "150310136",
                                    "speaker": "伊安珊",
                                    "text": "交给我吧！"
                                },
                                {
                                    "id": "150310137",
                                    "speaker": "瓦雷莎",
                                    "text": "那我们也去找找？"
                                },
                                {
                                    "id": "150310138",
                                    "speaker": "派蒙",
                                    "text": "好啊，但这附近我们还不是很熟，你有什么想法吗？"
                                },
                                {
                                    "id": "150310139",
                                    "speaker": "瓦雷莎",
                                    "text": "嗯…目前还没有眉目，但我们可以去火山附近看看…"
                                },
                                {
                                    "id": "150310140",
                                    "speaker": "瓦雷莎",
                                    "text": "火山总是吐各种各样的东西出来，说不定就会有很好的素材。"
                                },
                                {
                                    "id": "150310141",
                                    "speaker": "派蒙",
                                    "text": "没问题，走吧！要是有机会的话，我要把找到的烫烫素材，甩到这个坏蘑菇的脸上！"
                                }
                            ]
                        },
                        {
                            "id": "150310132",
                            "text": "也只能继续配合它了吧。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1503102",
            "objective": "寻找所需的高温材料",
            "dialogues": [
                {
                    "id": "150310201",
                    "speaker": "瓦雷莎",
                    "text": "这条路我平时经常走，我记得路边会有正在休息的熔岩游像。"
                },
                {
                    "id": "150310202",
                    "speaker": "瓦雷莎",
                    "text": "它们的核心很烫，应该能满足我们的要求。"
                },
                {
                    "id": "150310203",
                    "speaker": "派蒙",
                    "text": "没想到大家会这么配合我们，看来他们其实都对这个蘑菇有所怀疑啊。"
                },
                {
                    "id": "150310204",
                    "speaker": "瓦雷莎",
                    "text": "嗯，还是多亏了你们来到这里，之前有很多很多人都吃过这种蘑菇，但能和蘑菇说上话，真的还是第一次…"
                },
                {
                    "id": "150310205",
                    "speaker": "派蒙",
                    "text": "也是，就算想查，也不知道从哪里开始查吧…"
                },
                {
                    "id": "150310206",
                    "speaker": "瓦雷莎",
                    "text": "所以这次还算是个难得的好机会，再加上那个「蕈之贤主」总是出言不逊，也点燃了大家的胜负欲。"
                },
                {
                    "id": "150310207",
                    "speaker": "Player",
                    "text": "「沃陆之邦」的人好像都热爱竞争。"
                },
                {
                    "id": "150310208",
                    "speaker": "派蒙",
                    "text": "是哦，不过瓦雷莎看上去是个特别温和的人，可能只有运动和战斗的时候除外…"
                },
                {
                    "id": "150310209",
                    "speaker": "瓦雷莎",
                    "text": "这个…是的，我并不喜欢战斗，也不争强好胜，我觉得只要能过好每一天的日子就行了。"
                },
                {
                    "id": "150310210",
                    "speaker": "瓦雷莎",
                    "text": "可是伊安珊老师教了我很多，比如「力量」是手段而不是目的…"
                },
                {
                    "id": "150310211",
                    "speaker": "瓦雷莎",
                    "text": "在深渊攻进来的时候，要是我没有进行平时的训练，也不擅长掌控元素力量，就只能眼睁睁地看着魔物肆虐。"
                },
                {
                    "id": "150310212",
                    "speaker": "瓦雷莎",
                    "text": "就算再怎么害怕，我都必须鼓起勇气，不能让这种事发生。",
                    "choices": [
                        {
                            "id": "150310213",
                            "text": "能看出来。",
                            "response": [
                                {
                                    "id": "150310215",
                                    "speaker": "瓦雷莎",
                                    "text": "谢谢，我会慢慢变得勇敢，就像菲耶蒂娜一样勇敢。"
                                },
                                {
                                    "id": "150310216",
                                    "speaker": "瓦雷莎",
                                    "text": "走吧，我们边走边找。"
                                }
                            ]
                        },
                        {
                            "id": "150310214",
                            "text": "你的心底有坚强的一面。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1503103",
            "objective": "越过障碍，向上攀登",
            "dialogues": [
                {
                    "id": "150310301",
                    "speaker": "瓦雷莎",
                    "text": "顺利解决！这个好像很不错，你们看，里面的燃素还很活跃呢。"
                },
                {
                    "id": "150310302",
                    "speaker": "派蒙",
                    "text": "我摸摸看…哇，好烫！"
                },
                {
                    "id": "150310303",
                    "speaker": "瓦雷莎",
                    "text": "像这样的再多找上几块应该就够了，走，我们再往上看看。"
                }
            ]
        },
        {
            "id": "1503105",
            "objective": "消灭「熔岩游像」",
            "dialogues": []
        },
        {
            "id": "1503104",
            "objective": "与瓦雷莎交谈",
            "dialogues": []
        },
        {
            "id": "1503106",
            "objective": "消灭「熔岩游像」",
            "dialogues": []
        },
        {
            "id": "1503108",
            "objective": "躲避火山喷发",
            "dialogues": []
        },
        {
            "id": "1503109",
            "objective": "击败眼前的魔物",
            "dialogues": []
        },
        {
            "id": "1503107",
            "objective": "与瓦雷莎交谈，获取素材",
            "dialogues": [
                {
                    "id": "150310401",
                    "speaker": "派蒙",
                    "text": "收获很丰富啊，有好多游像眼，还有这个，好像是它用来喷火的东西。"
                },
                {
                    "id": "150310402",
                    "speaker": "瓦雷莎",
                    "text": "嗯，这是它的背甲，能够喷射燃素，所以它的动作很迅捷。"
                },
                {
                    "id": "150310403",
                    "speaker": "瓦雷莎",
                    "text": "我爸爸和我讲过，它是住在火山里的一种生物，我们能碰上，运气真的很好。"
                },
                {
                    "id": "150310404",
                    "speaker": "瓦雷莎",
                    "text": "我觉得这块背甲说不定比游像眼制造的温度更高，嘿嘿，这下子肯定够了。"
                },
                {
                    "id": "150310405",
                    "speaker": "Player",
                    "text": "刚刚你战斗的表现很不错。"
                },
                {
                    "id": "150310406",
                    "speaker": "瓦雷莎",
                    "text": "唔…就算再怎么不想战斗，也有不得不战斗的时候，为了能尽快进入状态，我也想了很多很多办法。"
                },
                {
                    "id": "150310407",
                    "speaker": "瓦雷莎",
                    "text": "比如，我总是在看各种英雄的故事，而我最喜欢的英雄，就是之前提到过的「菲耶蒂娜」。"
                },
                {
                    "id": "150310408",
                    "speaker": "瓦雷莎",
                    "text": "她最标志性的道具，就是脸上的面具了，所以我也根据故事里的描述，做了一个差不多的面具。"
                },
                {
                    "id": "150310409",
                    "speaker": "瓦雷莎",
                    "text": "当戴上面具的时候，我就觉得我变成了她——因为不能让她的名字蒙羞，我必须勇敢起来。"
                },
                {
                    "id": "150310410",
                    "speaker": "瓦雷莎",
                    "text": "但也可以说，这种做法是我躲在了她的身后…"
                },
                {
                    "id": "150310411",
                    "speaker": "派蒙",
                    "text": "原来是这样啊。",
                    "choices": [
                        {
                            "id": "150310412",
                            "text": "可是很管用啊。",
                            "response": [
                                {
                                    "id": "150310414",
                                    "speaker": "瓦雷莎",
                                    "text": "真的吗？可是…"
                                },
                                {
                                    "id": "150310415",
                                    "speaker": "瓦雷莎",
                                    "text": "总有一天，我需要摘掉面具，面对自己。"
                                },
                                {
                                    "id": "150310416",
                                    "speaker": "瓦雷莎",
                                    "text": "可是越是迈不出这一步，就越是会依赖这个面具，我…很担心。",
                                    "choices": [
                                        {
                                            "id": "150310417",
                                            "text": "但决定要调查蘑菇的是你自己。",
                                            "response": [
                                                {
                                                    "id": "150310419",
                                                    "speaker": "派蒙",
                                                    "text": "对啊，这是你自己的决定！冒险的真谛在于做出勇敢的决定，战斗只是很片面的一个环节！"
                                                },
                                                {
                                                    "id": "150310420",
                                                    "speaker": "瓦雷莎",
                                                    "text": "原来如此…"
                                                },
                                                {
                                                    "id": "150310421",
                                                    "speaker": "派蒙",
                                                    "text": "你已经进步很多了，不用着急啦。"
                                                },
                                                {
                                                    "id": "150310422",
                                                    "speaker": "瓦雷莎",
                                                    "text": "谢谢你们，你们总在鼓励我，教了我很多东西。"
                                                },
                                                {
                                                    "id": "150310423",
                                                    "speaker": "瓦雷莎",
                                                    "text": "嗯！我会继续成长，直到能够面对我自己的名字！"
                                                },
                                                {
                                                    "id": "150310424",
                                                    "speaker": "瓦雷莎",
                                                    "text": "心情舒畅之后，好像肚子突然就饿了！"
                                                },
                                                {
                                                    "id": "150310425",
                                                    "speaker": "派蒙",
                                                    "text": "欸，又饿了？我觉得我还没消化完呢！"
                                                },
                                                {
                                                    "id": "150310426",
                                                    "speaker": "瓦雷莎",
                                                    "text": "走吧，回「沃陆之邦」，这次一定能满足「蕈之贤主」的要求。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "150310418",
                                            "text": "并不是你的面具。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "150310413",
                            "text": "不用觉得这是丢人的事。"
                        }
                    ]
                }
            ]
        }
    ]
}