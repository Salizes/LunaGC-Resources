    "talks": [
        {
            "id": "7105906",
            "objective": "隐藏任务计时$HIDDEN",
            "dialogues": [
                {
                    "id": "710590601",
                    "speaker": "派蒙",
                    "text": "唔…连个人影都没有，这下我们要怎么回去交差呀…"
                },
                {
                    "id": "710590602",
                    "speaker": "派蒙",
                    "text": "嗯，也没有别的办法啦，我们回去吧？"
                }
            ]
        },
        {
            "id": "7105901",
            "objective": "与卡塔琳娜对话$HIDDEN",
            "dialogues": [
                {
                    "id": "710590101",
                    "speaker": "卡塔琳娜",
                    "text": "你们来了！请随便坐坐吧。"
                },
                {
                    "id": "710590102",
                    "speaker": "卡塔琳娜",
                    "text": "抱歉，之前急匆匆把你们赶走，也没有说清楚要请你们帮什么忙。",
                    "choices": [
                        {
                            "id": "710590103",
                            "text": "没关系，你请说吧。",
                            "response": [
                                {
                                    "id": "710590107",
                                    "speaker": "卡塔琳娜",
                                    "text": "放心吧，我不会让你们做坏事的。",
                                    "choices": [
                                        {
                                            "id": "710590108",
                                            "text": "那你请说。",
                                            "response": [
                                                {
                                                    "id": "710590113",
                                                    "speaker": "卡塔琳娜",
                                                    "text": "是这样的…我的科利亚…我的队员尼古拉和我失散了。"
                                                },
                                                {
                                                    "id": "710590114",
                                                    "speaker": "卡塔琳娜",
                                                    "text": "所以…我想拜托你寻找他留下的线索。"
                                                },
                                                {
                                                    "id": "710590115",
                                                    "speaker": "卡塔琳娜",
                                                    "text": "如果他还活着，请带他回来见我。如果他牺牲了…也请让我知道。"
                                                },
                                                {
                                                    "id": "710590116",
                                                    "speaker": "卡塔琳娜",
                                                    "text": "实在抱歉，拜托你这样的事情…但希望你们能够考虑一下。"
                                                },
                                                {
                                                    "id": "710590117",
                                                    "speaker": "派蒙",
                                                    "text": "这样呀…我还以为你要找我们做什么坏事呢！比如说，给千岩军搞破坏…什么的…"
                                                },
                                                {
                                                    "id": "710590118",
                                                    "speaker": "卡塔琳娜",
                                                    "text": "千岩军…为什么？和他们为敌对我们愚人众没有好处的。"
                                                },
                                                {
                                                    "id": "710590119",
                                                    "speaker": "Player",
                                                    "text": "你是什么意思？"
                                                },
                                                {
                                                    "id": "710590120",
                                                    "speaker": "卡塔琳娜",
                                                    "text": "我还想问你…！"
                                                },
                                                {
                                                    "id": "710590121",
                                                    "speaker": "卡塔琳娜",
                                                    "text": "等等…我明白了…我们在地面上和璃月人闹翻了…？这就解释了为什么我们的补给会中断…"
                                                },
                                                {
                                                    "id": "710590122",
                                                    "speaker": "卡塔琳娜",
                                                    "text": "可恶…地面上到底发生了些什么啊…",
                                                    "choices": [
                                                        {
                                                            "id": "710590123",
                                                            "text": "说来话长…",
                                                            "response": [
                                                                {
                                                                    "id": "710590125",
                                                                    "speaker": "卡塔琳娜",
                                                                    "text": "哼…那个之后再说。战争就是这样…敌友瞬息万变，这就是愚人众栖身其中的环境。"
                                                                },
                                                                {
                                                                    "id": "710590126",
                                                                    "speaker": "卡塔琳娜",
                                                                    "text": "但我现在…至少是现在，我只关心科利亚一个人。"
                                                                },
                                                                {
                                                                    "id": "710590127",
                                                                    "speaker": "卡塔琳娜",
                                                                    "text": "在我们撤退的途中，他和小队失散了…后来，我回来找他，结果自己也和其他人失散了。唉，真是丢人…"
                                                                },
                                                                {
                                                                    "id": "710590128",
                                                                    "speaker": "卡塔琳娜",
                                                                    "text": "至于他最后出现的地点…我可以帮你在地图上标出位置。"
                                                                },
                                                                {
                                                                    "id": "710590129",
                                                                    "speaker": "卡塔琳娜",
                                                                    "text": "他在那里和我们分开了，他想要引开追击的敌人…他是个优秀的战士，我知道他不会死在那里。"
                                                                },
                                                                {
                                                                    "id": "710590130",
                                                                    "speaker": "卡塔琳娜",
                                                                    "text": "希望他在那边留下了线索…希望如此。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "710590124",
                                                            "text": "事端是你们挑起的…"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "710590109",
                                            "text": "你当然不会让我们坏愚人众的事。",
                                            "response": [
                                                {
                                                    "id": "710590110",
                                                    "speaker": "派蒙",
                                                    "text": "对啊，如果我们做的好事对于你们这些坏家伙来说是坏事的话，你可不许阻止我们呀！"
                                                },
                                                {
                                                    "id": "710590111",
                                                    "speaker": "卡塔琳娜",
                                                    "text": "什么好事…坏事…我阻止你们…？"
                                                },
                                                {
                                                    "id": "710590112",
                                                    "speaker": "卡塔琳娜",
                                                    "text": "唉…你们好烦啊，听我把话说完好不好！"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "710590104",
                            "text": "没关系，我们还没答应你呢。",
                            "response": [
                                {
                                    "id": "710590105",
                                    "speaker": "派蒙",
                                    "text": "对呀，你们是愚人众嘛！要是指使我们做坏事的话，我们可不干！"
                                },
                                {
                                    "id": "710590106",
                                    "speaker": "卡塔琳娜",
                                    "text": "噗…你说的很有道理。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7105902",
            "objective": "寻找尼古拉留下的线索",
            "dialogues": [
                {
                    "id": "710590201",
                    "speaker": "尼古拉下士的日志残片",
                    "text": "「…倒霉，卡佳老姐的巴拉莱卡琴坏掉了。行动事出紧急，不知道是怎么弄坏的，一定要抢在挨骂前修好…」"
                },
                {
                    "id": "710590202",
                    "speaker": "尼古拉下士的日志残片",
                    "text": "「…五百年前的祖先们就是这样对抗灾变的吗？大尉说，我们经历的苦战相比祖先而言，不过只是零头而已…」"
                },
                {
                    "id": "710590203",
                    "speaker": "尼古拉下士的日志残片",
                    "text": "（中间许多页被黑色的物质浸染，清除掉黑色物质后，墨水写下的字迹也被完全毁掉了。）"
                },
                {
                    "id": "710590204",
                    "speaker": "尼古拉下士的日志残片",
                    "text": "「…这里不能待下去了，那些家伙可以透过黑色的泥状物窥视我的行踪…」"
                },
                {
                    "id": "710590205",
                    "speaker": "尼古拉下士的日志残片",
                    "text": "「…接下来要继续往反方向前进，把它们再度引向远离小队主力的地方…」"
                },
                {
                    "id": "710590206",
                    "speaker": "尼古拉下士的日志残片",
                    "text": "「…东南方的堡垒遗迹旁边有一处洞口，或许可以走那条路…」"
                },
                {
                    "id": "710590207",
                    "speaker": "尼古拉下士的日志残片",
                    "text": "「…祝我好运吧，舍我其谁！」"
                }
            ]
        },
        {
            "id": "7105903",
            "objective": "前往尼古拉日志中提及的地点",
            "dialogues": [
                {
                    "id": "710590301",
                    "speaker": "卡塔琳娜",
                    "text": "你们回来了，我还有些火水可以分。"
                },
                {
                    "id": "710590302",
                    "speaker": "卡塔琳娜",
                    "text": "哈哈…没有要你们陪我喝酒啦，如果你们受伤的话，火水也可以用来清洁伤口的。"
                },
                {
                    "id": "710590303",
                    "speaker": "卡塔琳娜",
                    "text": "怎么样？有何收获？"
                },
                {
                    "id": "710590304",
                    "speaker": "Player",
                    "text": "我们找到了这些。"
                }
            ]
        },
        {
            "id": "7105904",
            "objective": "探索日志提及的地点",
            "dialogues": [
                {
                    "id": "710590401",
                    "speaker": "卡塔琳娜",
                    "text": "你回来了。请问有什么发现吗？"
                },
                {
                    "id": "710590402",
                    "speaker": "卡塔琳娜",
                    "text": "没有的话也没关系的，请随便休息一下吧。"
                },
                {
                    "id": "710590403",
                    "speaker": "卡塔琳娜",
                    "text": "不用在乎我是否着急啦…反正我也有留在这里养老的计划，说不定还要拜托你替我申领退休金呢！"
                },
                {
                    "id": "710590404",
                    "speaker": "派蒙",
                    "text": "哇，你这家伙倒是悠闲！"
                },
                {
                    "id": "710590405",
                    "speaker": "卡塔琳娜",
                    "text": "哼，你们再没什么新发现的话，我可要在这里悠闲到老咯。"
                }
            ]
        },
        {
            "id": "7105908",
            "objective": "阅读尼古拉留下的信息",
            "dialogues": [
                {
                    "id": "710591401",
                    "speaker": "尼古拉下士的笔记",
                    "text": "「…成功进入了这处暗室，巨大的机关怪物还在外面游荡，似乎在耐心地等待我逃出去，就像掠食者，居心叵测，险恶异常…」"
                },
                {
                    "id": "710591402",
                    "speaker": "尼古拉下士的笔记",
                    "text": "「…左腿受了重伤，草草包扎了一下，很痛，肿起来了。可能有感染…」"
                },
                {
                    "id": "710591403",
                    "speaker": "尼古拉下士的笔记",
                    "text": "「…岩穴里还有另一个出口，不敢确定通往何处。出口的结构很脆弱，如果没有支撑的话，遇到强大的外力很容易垮塌…」"
                },
                {
                    "id": "710591404",
                    "speaker": "尼古拉下士的笔记",
                    "text": "「…我被发现了，有人来了。来客是一个…浑身漆黑的…剑士…？」"
                },
                {
                    "id": "710591405",
                    "speaker": "尼古拉下士的笔记",
                    "text": "「…他，不，它…？似乎坚固的金属栅栏也拦不住它，看到它的模样我就知道了…」"
                },
                {
                    "id": "710591406",
                    "speaker": "尼古拉下士的笔记",
                    "text": "「…对不起，卡佳。」"
                }
            ]
        },
        {
            "id": "7105907",
            "objective": "与派蒙对话",
            "dialogues": [
                {
                    "id": "710590603",
                    "speaker": "派蒙",
                    "text": "咦…这个徽记…就是那个愚人众家伙留下的吗？"
                }
            ]
        },
        {
            "id": "7105905",
            "objective": "将找到的线索告诉卡塔琳娜",
            "dialogues": []
        },
        {
            "id": "7105909",
            "objective": "与卡塔琳娜对话",
            "dialogues": [
                {
                    "id": "710591305",
                    "speaker": "卡塔琳娜",
                    "text": "这些是…士官徽章，行动日志和…笔记？"
                },
                {
                    "id": "710591306",
                    "speaker": "卡塔琳娜",
                    "text": "请告诉我，科利亚他人在哪里？他还活着吗…？",
                    "choices": [
                        {
                            "id": "710591307",
                            "text": "我们没有找到他，但他可能还活着。",
                            "response": [
                                {
                                    "id": "710591309",
                                    "speaker": "卡塔琳娜",
                                    "text": "科利亚不可能丢下我去做逃兵的。你们…你们可以放心，我明白的，他是不会临阵脱逃的。"
                                },
                                {
                                    "id": "710591310",
                                    "speaker": "卡塔琳娜",
                                    "text": "这些东西，你们是在哪里发现的？"
                                },
                                {
                                    "id": "710591311",
                                    "speaker": "Player",
                                    "text": "东南方一处山洞，我为你标出来。"
                                },
                                {
                                    "id": "710591312",
                                    "speaker": "派蒙",
                                    "text": "是一个很邪门的地方，有很多奇怪的怪物…"
                                },
                                {
                                    "id": "710591313",
                                    "speaker": "卡塔琳娜",
                                    "text": "谢谢…谢谢你，我…抱歉……"
                                },
                                {
                                    "id": "710591314",
                                    "speaker": "卡塔琳娜",
                                    "text": "我…我希望科利亚牺牲了，我宁愿这样相信。"
                                },
                                {
                                    "id": "710591315",
                                    "speaker": "卡塔琳娜",
                                    "text": "科利亚，请不要让女皇陛下蒙羞，不要让我蒙羞……"
                                },
                                {
                                    "id": "710591316",
                                    "speaker": "Player",
                                    "text": "……"
                                },
                                {
                                    "id": "710591317",
                                    "speaker": "卡塔琳娜",
                                    "text": "咳，咳…我没事的…抱歉，抱歉！把气氛搞得这么僵…才想起来，还没来得及好好感谢你们呢！"
                                },
                                {
                                    "id": "710591318",
                                    "speaker": "卡塔琳娜",
                                    "text": "对了，火水…啊，唉…你们不喝酒的，是吗？"
                                },
                                {
                                    "id": "710591319",
                                    "speaker": "卡塔琳娜",
                                    "text": "我还有些摩拉…还有就是…之前收集的一些物资，反正已经没有什么用了，请你收下吧。",
                                    "choices": [
                                        {
                                            "id": "710591320",
                                            "text": "接下来有何打算？",
                                            "response": [
                                                {
                                                    "id": "710591322",
                                                    "speaker": "卡塔琳娜",
                                                    "text": "接下来吗？谢谢关心，不过我不需要再拜托你帮忙「做坏事」啦。"
                                                },
                                                {
                                                    "id": "710591323",
                                                    "speaker": "卡塔琳娜",
                                                    "text": "嗯…也许我还是会去找我的科利亚吧。"
                                                },
                                                {
                                                    "id": "710591324",
                                                    "speaker": "卡塔琳娜",
                                                    "text": "部队调防之前他寄给我的信，我还留在身上…对于我来说，这是他还在这世上的最后证据了…我会永远将它留在身边。"
                                                },
                                                {
                                                    "id": "710591325",
                                                    "speaker": "卡塔琳娜",
                                                    "text": "如果他还活着…作为女皇陛下的愚人众，我会猎取那个叛徒的首级，无论他逃到哪里，藏到什么时候。"
                                                },
                                                {
                                                    "id": "710591326",
                                                    "speaker": "卡塔琳娜",
                                                    "text": "如果他已经牺牲了…作为他的姐姐，我也将迎向每一位愚人众必然面临的命运，并且为他而自豪。"
                                                },
                                                {
                                                    "id": "710591327",
                                                    "speaker": "卡塔琳娜",
                                                    "text": "所谓「舍我其谁」呢…就是这样的事。",
                                                    "choices": [
                                                        {
                                                            "id": "710591328",
                                                            "text": "如果你在作恶，而我必须阻止你呢？",
                                                            "response": [
                                                                {
                                                                    "id": "710591329",
                                                                    "speaker": "卡塔琳娜",
                                                                    "text": "…我们都有没得选择的时候，也都有不得不去做的事情，对吧？"
                                                                },
                                                                {
                                                                    "id": "710591333",
                                                                    "speaker": "卡塔琳娜",
                                                                    "text": "好啦…你真的太严肃了，没到喝酒年纪的孩子呀，总是有奇奇怪怪的烦恼。"
                                                                },
                                                                {
                                                                    "id": "710591334",
                                                                    "speaker": "卡塔琳娜",
                                                                    "text": "到时候再说吧，到不得不选择的时候再说。"
                                                                },
                                                                {
                                                                    "id": "710591335",
                                                                    "speaker": "卡塔琳娜",
                                                                    "text": "不过现在，我要休息了…你也要睡一会儿吗？"
                                                                },
                                                                {
                                                                    "id": "710591336",
                                                                    "speaker": "派蒙",
                                                                    "text": "只有一张草铺，你叫我们怎么睡呀？明明是在赶我们走吧！"
                                                                },
                                                                {
                                                                    "id": "710591337",
                                                                    "speaker": "卡塔琳娜",
                                                                    "text": "哈哈哈哈哈！那是你们自己的问题…真可怜。"
                                                                },
                                                                {
                                                                    "id": "710591338",
                                                                    "speaker": "卡塔琳娜",
                                                                    "text": "不过不管怎样，我真心感谢你们帮忙。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "710591330",
                                                            "text": "你一定要拘泥于愚人众的立场吗？",
                                                            "response": [
                                                                {
                                                                    "id": "710591331",
                                                                    "speaker": "卡塔琳娜",
                                                                    "text": "嗯？是呀，很奇怪吗？"
                                                                },
                                                                {
                                                                    "id": "710591332",
                                                                    "speaker": "卡塔琳娜",
                                                                    "text": "理念呀、立场呀，都是太无聊的问题了。噗…我的面具下面可不是只有理念，我是怕子弹的！"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
