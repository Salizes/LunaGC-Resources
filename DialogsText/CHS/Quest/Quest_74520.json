        },
        {
            "id": "7452002",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "745200201",
                    "speaker": "Player",
                    "text": "我们继续留影吧！"
                }
            ]
        },
        {
            "id": "7452003",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "745200301",
                    "speaker": "Player",
                    "text": "请稍等，我再构思一下。"
                }
            ]
        },
        {
            "id": "7452004",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "745200401",
                    "speaker": "优菈",
                    "text": "#是你啊，{NICKNAME}，没想到能在这种地方遇到你。",
                    "choices": [
                        {
                            "id": "745200402",
                            "text": "好久不见了，优菈。",
                            "response": [
                                {
                                    "id": "745200404",
                                    "speaker": "优菈",
                                    "text": "算是例行巡视。不过，对我而言，更像是保持战斗状态的必要活动。"
                                },
                                {
                                    "id": "745200405",
                                    "speaker": "优菈",
                                    "text": "最近蒙德相对太平，值得游击小队全体出动的威胁几乎没有。队里的大家…精神上确实放松了不少。"
                                },
                                {
                                    "id": "745200406",
                                    "speaker": "Player",
                                    "text": "劳逸结合也是好事嘛。"
                                },
                                {
                                    "id": "745200407",
                                    "speaker": "优菈",
                                    "text": "话虽如此，但我作为队长，必须要时刻保持自己的战斗力。"
                                },
                                {
                                    "id": "745200408",
                                    "speaker": "优菈",
                                    "text": "毕竟，敌人的剑可不会因为和平而变得迟钝。"
                                },
                                {
                                    "id": "745200409",
                                    "speaker": "优菈",
                                    "text": "所以，我习惯在巡视的间隙，找个僻静的地方练习剑术，确保姿态不会生疏。",
                                    "choices": [
                                        {
                                            "id": "745200410",
                                            "text": "时机正好…",
                                            "response": [
                                                {
                                                    "id": "745200412",
                                                    "speaker": "优菈",
                                                    "text": "哦？倒是有趣的请求。"
                                                },
                                                {
                                                    "id": "745200413",
                                                    "speaker": "优菈",
                                                    "text": "不过，我的动作很快，你的留影机跟得上吗？",
                                                    "choices": [
                                                        {
                                                            "id": "745200414",
                                                            "text": "按照你平时的速度就好了！",
                                                            "response": [
                                                                {
                                                                    "id": "745200416",
                                                                    "speaker": "优菈",
                                                                    "text": "好。既然你这么有自信，那我也要全力以赴了。"
                                                                },
                                                                {
                                                                    "id": "745200417",
                                                                    "speaker": "优菈",
                                                                    "text": "看好了，浪花卷起的时刻可是转瞬即逝的。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "745200415",
                                                            "text": "我的镜头会尽力跟上你的！"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "745200411",
                                            "text": "请让我为你留影！"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "745200403",
                            "text": "你是在这里执勤吗？"
                        }
                    ]
                }
            ]
        }
    ]
}