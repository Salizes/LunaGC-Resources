            "dialogues": [
                {
                    "id": "411490401",
                    "speaker": "Player",
                    "text": "还有别的事。"
                },
                {
                    "id": "411490402",
                    "speaker": "莎拉",
                    "text": "咦？好吧…那我去找别人帮忙。最近是怎么回事啊，怎么大家突然都开始要求外送餐品了…"
                }
            ]
        },
        {
            "id": "4114901",
            "objective": "与莎拉对话",
            "dialogues": [
                {
                    "id": "411490101",
                    "speaker": "Player",
                    "text": "我这就送过去。"
                },
                {
                    "id": "411490102",
                    "speaker": "莎拉",
                    "text": "那就太好了，谢谢你愿意帮忙。"
                },
                {
                    "id": "411490103",
                    "speaker": "莎拉",
                    "text": "送的时候记得<color=#00E1FFFF>小心点别被撞到，也别跑得太快</color>。要是烤松饼散了的话，那瓦里特先生肯定不会收下的。"
                }
            ]
        },
        {
            "id": "4114902",
            "objective": "将餐品送给急躁的瓦里特",
            "dialogues": [
                {
                    "id": "411490201",
                    "speaker": "急躁的瓦里特",
                    "text": "怎么还没送来，我还有正事要做呢！"
                }
            ]
        },
        {
            "id": "4114903",
            "objective": "与急躁的瓦里特对话",
            "dialogues": [
                {
                    "id": "411490601",
                    "speaker": "Player",
                    "text": "这是您订的餐。"
                },
                {
                    "id": "411490602",
                    "speaker": "急躁的瓦里特",
                    "text": "总算送来了，快给我，吃完了我还有正事要做。"
                },
                {
                    "id": "411490603",
                    "speaker": "急躁的瓦里特",
                    "text": "这附近，说不定能找到合适的酿酒材料…"
                }
            ]
        },
        {
            "id": "4114903",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "411490301",
                    "speaker": "Player",
                    "text": "听说有特别订单…"
                },
                {
                    "id": "411490302",
                    "speaker": "莎拉",
                    "text": "对啊，你来得正好。早些时候，瓦里特先生在我们这订了一份庄园烤松饼，钱也已经预付好了。"
                },
                {
                    "id": "411490303",
                    "speaker": "莎拉",
                    "text": "然后，他让我们晚些时候把餐送到明冠峡南面的一个地方…"
                },
                {
                    "id": "411490304",
                    "speaker": "莎拉",
                    "text": "但不知道为什么，最近要求外送的餐品越来越多，我们的人手都不够了。"
                },
                {
                    "id": "411490305",
                    "speaker": "莎拉",
                    "text": "如果你愿意的话，就请帮忙跑一趟吧。"
                }
            ]
        },
        {
            "id": "4114905",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "411490501",
                    "speaker": "急躁的瓦里特",
                    "text": "怎么还没送来，我还有正事要做呢！"
                }
            ]
        }
