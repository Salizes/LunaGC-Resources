        {
            "id": "502805",
            "objective": "继续「你」的旅途",
            "dialogues": [
                {
                    "id": "50280501",
                    "speaker": "虚空中的声音",
                    "text": "降临者的生命比你想象中更有价值。"
                },
                {
                    "id": "50280502",
                    "speaker": "虚空中的声音",
                    "text": "你亲手捏碎了世界的希望。"
                },
                {
                    "id": "50280503",
                    "speaker": "玛薇卡",
                    "text": "若我注定失败，你又为何恐惧。"
                },
                {
                    "id": "50280504",
                    "speaker": "虚空中的声音",
                    "text": "……"
                },
                {
                    "id": "50280505",
                    "speaker": "玛薇卡",
                    "text": "（为了愿望，我们步上巡礼。）"
                },
                {
                    "id": "50280506",
                    "speaker": "玛薇卡",
                    "text": "（为了最强之名，我们云聚斗争。）"
                },
                {
                    "id": "50280507",
                    "speaker": "玛薇卡",
                    "text": "（为了梦，我们在劫火中燃尽。）"
                },
                {
                    "id": "50280508",
                    "speaker": "玛薇卡",
                    "text": "（如此轮回，循环往复…）"
                }
            ]
        },
