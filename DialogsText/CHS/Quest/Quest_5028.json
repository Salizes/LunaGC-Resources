            "dialogues": [
                {
                    "id": "50280202",
                    "speaker": "欧洛伦",
                    "text": "#{M#他}{F#她}的灵魂正直而纯净，「英雄」也只是{M#他}{F#她}的起点。"
                },
                {
                    "id": "50280207",
                    "speaker": "恰斯卡",
                    "text": "#想随{M#他}{F#她}振翅高飞，去看天外世界。"
                },
                {
                    "id": "50280208",
                    "speaker": "伊安珊",
                    "text": "#想了解{M#他}{F#她}的故乡，养育{M#他}{F#她}的土地一定很自由，很温暖。"
                },
                {
                    "id": "50280211",
                    "speaker": "希诺宁",
                    "text": "#我羡慕{M#他}{F#她}见多识广，却依然能享受当下。"
                },
                {
                    "id": "50280212",
                    "speaker": "玛拉妮",
                    "text": "#能和{M#他}{F#她}做朋友真是太开心啦！"
                }
            ]
        },
        {
            "id": "502803",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "50280302",
                    "speaker": "希巴拉克",
                    "text": "天使，被贬谪之■■，早应■■■■！"
