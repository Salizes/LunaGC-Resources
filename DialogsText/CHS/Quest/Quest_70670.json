    "talks": [
        {
            "id": "7067001",
            "objective": "与吉盖克斯对话",
            "dialogues": [
                {
                    "id": "706700101",
                    "speaker": "吉盖克斯",
                    "text": "你好，想试试「风行迷踪」吗？",
                    "choices": [
                        {
                            "id": "706700102",
                            "text": "你还在招募人来试玩啊…",
                            "response": [
                                {
                                    "id": "706700103",
                                    "speaker": "吉盖克斯",
                                    "text": "是您啊！您上次玩「风行迷踪」时所展现的技术，让我印象深刻。"
                                },
                                {
                                    "id": "706700104",
                                    "speaker": "吉盖克斯",
                                    "text": "不过，虽然您玩起来游刃有余，但还是有不少人和我说这个游戏很难，要么游侠很难跑掉，要么猎手找不到人。"
                                },
                                {
                                    "id": "706700105",
                                    "speaker": "吉盖克斯",
                                    "text": "还有人向我抱怨，被猎手抓住的游侠在游戏结束前根本就无事可干，只能在一旁干看着，实在有些无聊…"
                                },
                                {
                                    "id": "706700106",
                                    "speaker": "吉盖克斯",
                                    "text": "唉，我也不知道他们说的对不对，所以就想再招募一批人来试玩，听听他们的意见…"
                                },
                                {
                                    "id": "706700120",
                                    "speaker": "吉盖克斯",
                                    "text": "咳，不说这么多了，不如你直接来试玩一下吧。",
                                    "choices": [
                                        {
                                            "id": "706700121",
                                            "text": "游玩「风行迷踪」。",
                                            "response": [
                                                {
                                                    "id": "706700123",
                                                    "speaker": "吉盖克斯",
                                                    "text": "好吧，如果有兴趣试玩「风行迷踪」的话，就过来找我吧。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "706700122",
                                            "text": "离开。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "706700107",
                            "text": "「风行迷踪」是什么？",
                            "response": [
                                {
                                    "id": "706700108",
                                    "speaker": "吉盖克斯",
                                    "text": "啊哈，问得好，「风行迷踪」是一款承载着蒙德城历史的游戏！"
                                },
                                {
                                    "id": "706700109",
                                    "speaker": "吉盖克斯",
                                    "text": "你应该知道，在之前的蒙德城里有一群「贵族」吧？"
                                },
                                {
                                    "id": "706700110",
                                    "speaker": "吉盖克斯",
                                    "text": "他们在蒙德城里暴行不断，让不少人都苦不堪言…"
                                },
                                {
                                    "id": "706700111",
                                    "speaker": "吉盖克斯",
                                    "text": "为了反抗贵族们的种种暴行，有一群勇敢的蒙德人聚集了起来，形成了一个秘密的反抗组织。"
                                },
                                {
                                    "id": "706700112",
                                    "speaker": "吉盖克斯",
                                    "text": "这群游侠们不断在蒙德各处展开行动，让贵族们颇吃了些苦头。"
                                },
                                {
                                    "id": "706700113",
                                    "speaker": "吉盖克斯",
                                    "text": "但是，那些贵族们也很快训练出了一群用来镇压游侠们的爪牙。"
                                },
                                {
                                    "id": "706700114",
                                    "speaker": "吉盖克斯",
                                    "text": "于是，游侠们和贵族们的爪牙们，就这样在蒙德各处展开了一场又一场的对决。"
                                },
                                {
                                    "id": "706700115",
                                    "speaker": "吉盖克斯",
                                    "text": "「风行迷踪」，正是取材于这样史诗一般的真实历史事件！曾经也是很受欢迎的…"
                                },
                                {
                                    "id": "706700116",
                                    "speaker": "Player",
                                    "text": "曾经？"
                                },
                                {
                                    "id": "706700117",
                                    "speaker": "吉盖克斯",
                                    "text": "是啊，现在城里的年轻人们对于「风行迷踪」可没多少兴趣了…"
                                },
                                {
                                    "id": "706700118",
                                    "speaker": "吉盖克斯",
                                    "text": "但我可不想让「风行迷踪」就此失传，所以，我对它原来的规则做了些调整，让游戏规则更容易被理解，也更有趣。"
                                },
                                {
                                    "id": "706700119",
                                    "speaker": "吉盖克斯",
                                    "text": "除此之外，我还特意添加了好几张全新的游戏地图。我觉得，这样应该会有更多的人来玩吧…"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}