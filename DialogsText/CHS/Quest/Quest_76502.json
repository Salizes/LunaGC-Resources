            "dialogues": [
                {
                    "id": "765020401",
                    "speaker": "爱诺",
                    "text": "怎么样，要开始拍摄了吗？我…我的心现在砰砰直跳！"
                }
            ]
        },
        {
            "id": "7650205",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "765020501",
                    "speaker": "Player",
                    "text": "没问题，我们开始留影吧！"
                }
            ]
        },
        {
            "id": "7650206",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "765020601",
                    "speaker": "Player",
                    "text": "请稍等，我再找找灵感。"
                }
            ]
        },
        {
            "id": "7650207",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "765020701",
                    "speaker": "爱诺",
                    "text": "#是{NICKNAME}和派蒙呀？怎么啦怎么啦？难道有什么超级厉害的委托，需要本天才机械师出马？",
                    "choices": [
                        {
                            "id": "765020702",
                            "text": "我们正在四处参观。",
                            "response": [
                                {
                                    "id": "765020704",
                                    "speaker": "爱诺",
                                    "text": "好说好说，我爱诺的工坊里，到处都是闪闪发光的好东西！不过，你的留影机好像没带在身上耶，是忘记了吗？"
                                }
                            ]
                        },
                        {
                            "id": "765020703",
                            "text": "顺便寻找拍摄素材。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7650208",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "765020801",
                    "speaker": "爱诺",
                    "text": "怎么样，找到什么让你眼前一亮的拍摄素材了吗？嘿嘿，要不要给你一点建议呀？",
                    "choices": [
                        {
                            "id": "765020803",
                            "text": "没问题，我们开始留影吧！",
                            "response": [
                                {
                                    "id": "765020804",
                                    "speaker": "爱诺",
                                    "text": "好啊。不过，你的留影机好像没带在身上耶，是忘记了吗？"
                                }
                            ]
                        },
                        {
                            "id": "765020802",
                            "text": "请稍等，我再找找灵感。"
                        }
                    ]
                }
            ]
        }
