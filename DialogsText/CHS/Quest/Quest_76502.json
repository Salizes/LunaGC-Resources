    "talks": [
        {
            "id": "7650201",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "765020101",
                    "speaker": "爱诺",
                    "text": "#是{NICKNAME}和派蒙呀？怎么啦怎么啦？难道有什么超级厉害的委托，需要本天才机械师出马？"
                },
                {
                    "id": "765020102",
                    "speaker": "爱诺",
                    "text": "嘿嘿，熟人好说，可以给你们打个八折！只要你们悄悄给我带点零食就行——嘘，千万别让伊涅芙知道！",
                    "choices": [
                        {
                            "id": "765020103",
                            "text": "我们正在四处参观。",
                            "response": [
                                {
                                    "id": "765020105",
                                    "speaker": "爱诺",
                                    "text": "那你们算是来对地方了。我爱诺的工坊里，到处都是闪闪发光的好东西，别的地方绝对见不到！"
                                },
                                {
                                    "id": "765020106",
                                    "speaker": "爱诺",
                                    "text": "不过，你们走路的时候要小心脚下哦，不要被那些零件绊倒啦。",
                                    "choices": [
                                        {
                                            "id": "765020107",
                                            "text": "这个机器人的样子很奇特呢。",
                                            "response": [
                                                {
                                                    "id": "765020109",
                                                    "speaker": "爱诺",
                                                    "text": "哼哼，那当然。它叫做「重拳出击鸭」，本来我想把它做成一个垃圾分类机器人，帮我把那些废铜烂铁都整理好。"
                                                },
                                                {
                                                    "id": "765020110",
                                                    "speaker": "爱诺",
                                                    "text": "结果一不小心，我把它造得太结实了，悬臂又特别灵活。于是我灵光一闪，就给它加入了超强的防卫机能！"
                                                },
                                                {
                                                    "id": "765020111",
                                                    "speaker": "爱诺",
                                                    "text": "这样一来，要是有哪个不长眼的坏蛋想偷偷溜进我的工坊，它就会把他们全部打扫成「不可回收垃圾」啦。"
                                                },
                                                {
                                                    "id": "765020112",
                                                    "speaker": "派蒙",
                                                    "text": "爱诺的想法还是那么天马行空呢。",
                                                    "choices": [
                                                        {
                                                            "id": "765020113",
                                                            "text": "机会难得…",
                                                            "response": [
                                                                {
                                                                    "id": "765020115",
                                                                    "speaker": "爱诺",
                                                                    "text": "我、我吗？和「重拳出击鸭」一起？大家平时只对我的发明感兴趣，很少有人想拍我耶…"
                                                                },
                                                                {
                                                                    "id": "765020116",
                                                                    "speaker": "爱诺",
                                                                    "text": "不过，如果你们想要记录本天才机械师和无敌小弟的工作日常，也不是不行啦！"
                                                                },
                                                                {
                                                                    "id": "765020117",
                                                                    "speaker": "爱诺",
                                                                    "text": "可是…我平时都不怎么给自己拍照的，也不知道要摆什么姿势才帅气啦…万一拍出来不好看怎么办…",
                                                                    "choices": [
                                                                        {
                                                                            "id": "765020118",
                                                                            "text": "像平时一样就可以了。",
                                                                            "response": [
                                                                                {
                                                                                    "id": "765020120",
                                                                                    "speaker": "爱诺",
                                                                                    "text": "好吧，那就交给你了哦。要把「重拳出击鸭」的威猛也一起拍出来！"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "765020119",
                                                                            "text": "我会努力拍下最帅气的一刻。"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "765020114",
                                                            "text": "可以为你拍摄画片吗？"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "765020108",
                                            "text": "它也是爱诺的「小弟」吗？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "765020104",
                            "text": "顺便寻找拍摄素材。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7650202",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7650204",
