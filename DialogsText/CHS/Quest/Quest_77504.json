    },
    "talks": [
        {
            "id": "7750401",
            "objective": "开车$HIDDEN",
            "dialogues": [
                {
                    "id": "775040101",
                    "speaker": "？？？",
                    "text": "咦？还有别的新人吗？"
                },
                {
                    "id": "775040102",
                    "speaker": "派蒙",
                    "text": "欸？新人？在说我们俩？"
                },
                {
                    "id": "775040103",
                    "speaker": "？？？",
                    "text": "你们穿得不像本地人，又在这附近转悠，难道是小松果和木头人的朋友？"
                },
                {
                    "id": "775040104",
                    "speaker": "？？？",
                    "text": "不管那么多了，海屑镇的「强化互助会」欢迎你们！"
                },
                {
                    "id": "775040105",
                    "speaker": "琪琪科娃",
                    "text": "就让我——得到了凯瑟琳大人的祝福，塔拉利欣大哥的肯定，还有「新锋」之眷顾的琪琪科娃，好好关照你们吧~"
                },
                {
                    "id": "775040106",
                    "speaker": "派蒙",
                    "text": "强化…互助会？没听过的名字…"
                },
                {
                    "id": "775040107",
                    "speaker": "琪琪科娃",
                    "text": "顾名思义，是帮助大家不断变强，成为高手的团队哦。"
                },
                {
                    "id": "775040108",
                    "speaker": "琪琪科娃",
                    "text": "只要你有着闯出一片天地的志气，就能与我们同行！",
                    "choices": [
                        {
                            "id": "775040109",
                            "text": "好呀好呀，我当然有志气。",
                            "response": [
                                {
                                    "id": "775040111",
                                    "speaker": "琪琪科娃",
                                    "text": "那就跟着我走吧，带你们去和大家碰面。"
                                },
                                {
                                    "id": "775040112",
                                    "speaker": "琪琪科娃",
                                    "text": "正好，我们也要开始这一期的活动了，你们赶上了好时候！"
                                },
                                {
                                    "id": "775040113",
                                    "speaker": "派蒙",
                                    "text": "喂喂，你怎么就顺着她的话说下去了？"
                                },
                                {
                                    "id": "775040114",
                                    "speaker": "派蒙",
                                    "text": "我知道你有谦虚的时候，不过，真的要装成新人吗？",
                                    "choices": [
                                        {
                                            "id": "775040115",
                                            "text": "迎合一下有干劲的孩子也不错？",
                                            "response": [
                                                {
                                                    "id": "775040117",
                                                    "speaker": "派蒙",
                                                    "text": "呜啊，你是不是被尼可影响了，开始想着…体验体验轻小说式的情节？"
                                                },
                                                {
                                                    "id": "775040118",
                                                    "speaker": "派蒙",
                                                    "text": "…搞得我也有点想试试看了。"
                                                },
                                                {
                                                    "id": "775040119",
                                                    "speaker": "琪琪科娃",
                                                    "text": "跟上了琪琪科娃，来到了车站旁不远的碰头地点。"
                                                },
                                                {
                                                    "id": "775040120",
                                                    "speaker": "琪琪科娃",
                                                    "text": "好啦，这里就是我们的据点了。"
                                                },
                                                {
                                                    "id": "775040121",
                                                    "speaker": "派蒙",
                                                    "text": "喔，除了至冬本地人，也有纳塔和璃月的孩子？"
                                                },
                                                {
                                                    "id": "775040122",
                                                    "speaker": "「小松果」",
                                                    "text": "#嗯？木头人，怎么感觉，这个{M#大哥哥}{F#大姐姐}看起来好眼熟？"
                                                },
                                                {
                                                    "id": "775040123",
                                                    "speaker": "「燃爆木头人」",
                                                    "text": "#等等，小松果，我应该没眼花啊？{M#他}{F#她}是是是是是是…"
                                                },
                                                {
                                                    "id": "775040124",
                                                    "speaker": "「燃爆木头人」",
                                                    "text": "杜杜杜杜杜杜杜…",
                                                    "choices": [
                                                        {
                                                            "id": "775040125",
                                                            "text": "嘟嘟可超级可爱？",
                                                            "response": [
                                                                {
                                                                    "id": "775040127",
                                                                    "speaker": "派蒙",
                                                                    "text": "嘘——"
                                                                },
                                                                {
                                                                    "id": "775040128",
                                                                    "speaker": "派蒙",
                                                                    "text": "#该怎么说好呢，唔…{NICKNAME}现在还不想被知道真实身份。"
                                                                },
                                                                {
                                                                    "id": "775040129",
                                                                    "speaker": "「燃爆木头人」",
                                                                    "text": "难道是在…执行特殊任务？我好像明白了。"
                                                                },
                                                                {
                                                                    "id": "775040130",
                                                                    "speaker": "「小松果」",
                                                                    "text": "我们会保密的！"
                                                                },
                                                                {
                                                                    "id": "775040173",
                                                                    "speaker": "琪琪科娃",
                                                                    "text": "咦，你们说的话好难懂啊？",
                                                                    "choices": [
                                                                        {
                                                                            "id": "775040131",
                                                                            "text": "是接头暗号喔。",
                                                                            "response": [
                                                                                {
                                                                                    "id": "775040133",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "啊对，我们跟着小松果和木头人混，当然会有专业用语。"
                                                                                },
                                                                                {
                                                                                    "id": "775040134",
                                                                                    "speaker": "「燃爆木头人」",
                                                                                    "text": "我？她？杜麦尼…跟着我们混？"
                                                                                },
                                                                                {
                                                                                    "id": "775040135",
                                                                                    "speaker": "「小松果」",
                                                                                    "text": "我我我，我们赶紧去写信，告诉维热姐姐这件事！"
                                                                                },
                                                                                {
                                                                                    "id": "775040136",
                                                                                    "speaker": "琪琪科娃",
                                                                                    "text": "没看出来，你们还挺专业的！难怪能从热热的纳塔翻越高山和大海，来到冰冰凉凉的至冬…"
                                                                                },
                                                                                {
                                                                                    "id": "775040137",
                                                                                    "speaker": "琪琪科娃",
                                                                                    "text": "要吃点黑列巴配暖汤吗？恢复恢复精神，然后我们就可以开始正题啦？"
                                                                                },
                                                                                {
                                                                                    "id": "775040138",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "这么熟练…你很有姐姐的样子嘛。"
                                                                                },
                                                                                {
                                                                                    "id": "775040139",
                                                                                    "speaker": "琪琪科娃",
                                                                                    "text": "当然，把互助会托付给我的两位大哥，可是专业的冒险者哦。我也会继承他的精神，成为帮助大家的行家。"
                                                                                },
                                                                                {
                                                                                    "id": "775040140",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "聚在一起吃零食确实能快快恢复元气，不过，要变成行家只靠这点还不够…"
                                                                                },
                                                                                {
                                                                                    "id": "775040141",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "你还有什么计划吗？"
                                                                                },
                                                                                {
                                                                                    "id": "775040142",
                                                                                    "speaker": "琪琪科娃",
                                                                                    "text": "哼哼，我们的诀窍在于「无上限分享」——"
                                                                                },
                                                                                {
                                                                                    "id": "775040143",
                                                                                    "speaker": "琪琪科娃",
                                                                                    "text": "我们都知道，冒险家协会是一个比较松散的组织。凯瑟琳大人给大家派发任务，有能力的强者赢下一切。"
                                                                                },
                                                                                {
                                                                                    "id": "775040144",
                                                                                    "speaker": "琪琪科娃",
                                                                                    "text": "但有的强者之间反而会互相提防，吝惜自己的诀窍，这就让一些经验没法在同行之中流通。"
                                                                                },
                                                                                {
                                                                                    "id": "775040145",
                                                                                    "speaker": "琪琪科娃",
                                                                                    "text": "比如，明明有简单办法打赢某只魔物，却有好几拨人绕了不同的弯子，撞得头破血流。"
                                                                                },
                                                                                {
                                                                                    "id": "775040146",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "是这个道理…在其他领域，这样的案例好像也不少…"
                                                                                },
                                                                                {
                                                                                    "id": "775040147",
                                                                                    "speaker": "琪琪科娃",
                                                                                    "text": "是啊！用一个枫丹大哥的话来说，「重复发明轮子的情节，每天都在全提瓦特各地上演。」"
                                                                                },
                                                                                {
                                                                                    "id": "775040148",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "可以理解，毕竟冒险家们不全都互相认识，也不会每干成一件委托，就聚在一起进行讨论吧？"
                                                                                },
                                                                                {
                                                                                    "id": "775040149",
                                                                                    "speaker": "琪琪科娃",
                                                                                    "text": "不太明白他们的作风。反正，我们「强化互助会」要打破这种僵局。"
                                                                                },
                                                                                {
                                                                                    "id": "775040150",
                                                                                    "speaker": "琪琪科娃",
                                                                                    "text": "互助会最重要的事，就是像分享好吃的东西一样，在内部共享各种心得和道具。"
                                                                                },
                                                                                {
                                                                                    "id": "775040151",
                                                                                    "speaker": "琪琪科娃",
                                                                                    "text": "不限于标满重要地点的地图、写着独门诀窍的笔记、剑法古籍、绝世宝剑部件等各种好东西。"
                                                                                },
                                                                                {
                                                                                    "id": "775040152",
                                                                                    "speaker": "琪琪科娃",
                                                                                    "text": "当然，成员们富余的装备和物资也会在这里共享，甚至还有互赠的礼物哦。"
                                                                                },
                                                                                {
                                                                                    "id": "775040153",
                                                                                    "speaker": "琪琪科娃",
                                                                                    "text": "等到各种力量被汇聚起来，越来越多的人，就能越来越轻松地解决越来越广的问题！",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "775040154",
                                                                                            "text": "有意思的想法。",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "775040156",
                                                                                                    "speaker": "派蒙",
                                                                                                    "text": "那，现在的进展怎么样呢？"
                                                                                                },
                                                                                                {
                                                                                                    "id": "775040157",
                                                                                                    "speaker": "琪琪科娃",
                                                                                                    "text": "咳咳，这个嘛…因为我们最近才重新开始活动，所以目前成员也没恢复到最厉害那时候的水平。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "775040158",
                                                                                                    "speaker": "琪琪科娃",
                                                                                                    "text": "我想先让大家熟悉至冬的环境，所以做了探索各种地点的计划。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "775040159",
                                                                                                    "speaker": "琪琪科娃",
                                                                                                    "text": "只要抵达了指定的地方，好好考察那里的情况，用我们的留影机记录下来，再拿野外的一些陈设练练手，就算成功！"
                                                                                                },
                                                                                                {
                                                                                                    "id": "775040160",
                                                                                                    "speaker": "派蒙",
                                                                                                    "text": "也，也对，目前看来，你和成员们的年纪都不大，一开始就尝试非常难的挑战，也有点危险。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "775040161",
                                                                                                    "speaker": "琪琪科娃",
                                                                                                    "text": "虽然我们现在还没有什么厉害的成就…但，互助会被交到我手里之前，的确帮过不少人。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "775040162",
                                                                                                    "speaker": "琪琪科娃",
                                                                                                    "text": "我相信只要我们一起努力，每天互相敦促，就每天都能变强！"
                                                                                                },
                                                                                                {
                                                                                                    "id": "775040163",
                                                                                                    "speaker": "派蒙",
                                                                                                    "text": "好喔，真是干劲满满，态度值得肯定！"
                                                                                                },
                                                                                                {
                                                                                                    "id": "775040164",
                                                                                                    "speaker": "派蒙",
                                                                                                    "text": "#我和{NICKNAME}最擅长探索不熟悉的地方了，就让我们也出一份力，给互助会提供一点支援？"
                                                                                                },
                                                                                                {
                                                                                                    "id": "775040165",
                                                                                                    "speaker": "派蒙",
                                                                                                    "text": "也是为了…感谢琪琪科娃的热情、还有黑列巴和浓汤。",
                                                                                                    "choices": [
                                                                                                        {
                                                                                                            "id": "775040166",
                                                                                                            "text": "互相扶持的感觉很不错。",
                                                                                                            "response": [
                                                                                                                {
                                                                                                                    "id": "775040168",
                                                                                                                    "speaker": "琪琪科娃",
                                                                                                                    "text": "我准备准备，也要出发了！如果你们有收获的话，可以抽空回来看看，顺带检查一下据点里的收件箱？"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "775040169",
                                                                                                                    "speaker": "琪琪科娃",
                                                                                                                    "text": "没准会有惊喜的收获呢~"
                                                                                                                }
                                                                                                            ]
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "775040167",
                                                                                                            "text": "看见新人成长很有意思。"
                                                                                                        }
                                                                                                    ]
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "775040155",
                                                                                            "text": "非常棒的目标。"
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "775040132",
                                                                            "text": "是道上的行话。"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "775040126",
                                                            "text": "嘟嘟大魔王好坏？"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "775040116",
                                            "text": "偶尔也可以扮演普通人试试嘛。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "775040110",
                            "text": "没错，我们都是需要帮助的新人。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7750402",
            "objective": "去海屑镇转转",
            "dialogues": []
        }
    ]
}