    "talks": [
        {
            "id": "7220801",
            "objective": "钓鱼2条（test）$HIDDEN",
            "dialogues": [
                {
                    "id": "722080101",
                    "speaker": "伊部",
                    "text": "呵呵，虽然钓技不错，但还有提高空间哦。",
                    "choices": [
                        {
                            "id": "722080102",
                            "text": "欸？！",
                            "response": [
                                {
                                    "id": "722080104",
                                    "speaker": "伊部",
                                    "text": "哎呀，对不起，对不起…总是忘了打招呼，忘记自己会吓到别人…呵呵。"
                                },
                                {
                                    "id": "722080105",
                                    "speaker": "Player",
                                    "text": "居然还一副乐在其中的样子…"
                                },
                                {
                                    "id": "722080106",
                                    "speaker": "伊部",
                                    "text": "没办法嘛，偶尔吓唬一下小孩子还是挺好玩的…"
                                },
                                {
                                    "id": "722080107",
                                    "speaker": "伊部",
                                    "text": "咳咳，我们说回钓鱼的事情吧？",
                                    "choices": [
                                        {
                                            "id": "722080108",
                                            "text": "是正事吗？",
                                            "response": [
                                                {
                                                    "id": "722080110",
                                                    "speaker": "伊部",
                                                    "text": "说来丢人，是这样的啦…先前在钓鱼时，我不小心遗落了牧梨交给我的护身符…里面有着她的祖灵与雷鸟大人的祝福。"
                                                },
                                                {
                                                    "id": "722080111",
                                                    "speaker": "伊部",
                                                    "text": "这么重要的东西，如果登船时让她知道我给搞丢了可就不得了了…"
                                                },
                                                {
                                                    "id": "722080112",
                                                    "speaker": "伊部",
                                                    "text": "金色的撑船人答应会寻人来帮我一起找…可是等到现在都没有人影…我就想，既然你来了，也请拜托帮帮我吧！",
                                                    "choices": [
                                                        {
                                                            "id": "722080113",
                                                            "text": "之前还以为你挺可靠的…",
                                                            "response": [
                                                                {
                                                                    "id": "722080115",
                                                                    "speaker": "伊部",
                                                                    "text": "我经常钓鱼的地点就在那边…可是记忆越来越稀薄了，可能要麻烦你多找一找…",
                                                                    "choices": [
                                                                        {
                                                                            "id": "722080116",
                                                                            "text": "既然是旧日记忆中的场所…",
                                                                            "response": [
                                                                                {
                                                                                    "id": "722080118",
                                                                                    "speaker": "伊部",
                                                                                    "text": "唔…你说什么？那是外人用来寻找地点的方法吗…？"
                                                                                },
                                                                                {
                                                                                    "id": "722080119",
                                                                                    "speaker": "伊部",
                                                                                    "text": "唉…总之，如果找对地方的话，直接就地搜寻就好了。"
                                                                                },
                                                                                {
                                                                                    "id": "722080120",
                                                                                    "speaker": "Player",
                                                                                    "text": "我该怎么搜寻？"
                                                                                },
                                                                                {
                                                                                    "id": "722080121",
                                                                                    "speaker": "伊部",
                                                                                    "text": "呃…用钓的？"
                                                                                },
                                                                                {
                                                                                    "id": "722080122",
                                                                                    "speaker": "Player",
                                                                                    "text": "…行吧。"
                                                                                },
                                                                                {
                                                                                    "id": "722080123",
                                                                                    "speaker": "伊部",
                                                                                    "text": "雷鸟大人和祖灵护佑你！拜托你了，外人朋友！"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "722080117",
                                                                            "text": "用「羽毛」应该可以看到吧…"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "722080114",
                                                            "text": "真拿你没办法…",
                                                            "response": [
                                                                {
                                                                    "id": "722080199",
                                                                    "speaker": "伊部",
                                                                    "text": "在逢岳之野西边，面对着三重瀑布的小岛…就在那小岛更西边的海里了…"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "722080109",
                                            "text": "这人怎么还在想着钓鱼…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "722080103",
                            "text": "请你先打招呼再出现！"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7220803",
            "objective": "",
            "dialogues": [
                {
                    "id": "722080301",
                    "speaker": "伊部",
                    "text": "你回来了！"
                },
                {
                    "id": "722080302",
                    "speaker": "Player",
                    "text": "你要的是这个吗？"
                }
            ]
        },
        {
            "id": "7220804",
            "objective": "",
            "dialogues": [
                {
                    "id": "722080401",
                    "speaker": "伊部",
                    "text": "你回来了！请问找到护身符了吗？"
                },
                {
                    "id": "722080402",
                    "speaker": "Player",
                    "text": "我还在努力。"
                },
                {
                    "id": "722080403",
                    "speaker": "伊部",
                    "text": "这样啊，不必着急，也请你注意安全。岛外来的朋友。"
                },
                {
                    "id": "722080404",
                    "speaker": "伊部",
                    "text": "在逢岳之野西边，面对着三重瀑布的小岛…我要的东西就在那小岛更西边的海里呢…"
                }
            ]
        },
        {
            "id": "7220806",
            "objective": "",
            "dialogues": [
                {
                    "id": "722080201",
                    "speaker": "伊部",
                    "text": "谢谢你！现在我终于可以放心登船了…"
                },
                {
                    "id": "722080202",
                    "speaker": "Player",
                    "text": "那船是去往哪里的…？"
                },
                {
                    "id": "722080203",
                    "speaker": "伊部",
                    "text": "金的土地，梦的土地。没有迷雾的国度…我们会在睡梦中再见，朋友。"
                }
            ]
        },
        {
            "id": "7220805",
            "objective": "test 废弃$HIDDEN",
            "dialogues": []
        }
    ]
}