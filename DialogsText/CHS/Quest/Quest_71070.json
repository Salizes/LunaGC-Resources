    "talks": [
        {
            "id": "7107001",
            "objective": "初到营地-阿武$HIDDEN",
            "dialogues": [
                {
                    "id": "710700101",
                    "speaker": "瑾武",
                    "text": "啊，你来了。多谢你帮我们打通了道路，志琼为了给我们开路，也帮了很多忙。我们都很感谢你们。",
                    "choices": [
                        {
                            "id": "710700102",
                            "text": "关于营地…",
                            "response": [
                                {
                                    "id": "710700103",
                                    "speaker": "瑾武",
                                    "text": "怎么样，还不错吧？老本行了。"
                                },
                                {
                                    "id": "710700104",
                                    "speaker": "瑾武",
                                    "text": "我从十几岁开始，就跟着老爹学习这些了…如何搭建营地，如何制作晶石灯，如何维护矿具…"
                                },
                                {
                                    "id": "710700105",
                                    "speaker": "瑾武",
                                    "text": "学着学着，他就老了…后来老爹眼睛不行了，矿上的安全设备就都由我来维护了。"
                                },
                                {
                                    "id": "710700106",
                                    "speaker": "瑾武",
                                    "text": "再然后，你看…我岁数也不小了。剩下的日子没什么好说啦…有了男人，男人没了，生了闺女，闺女去须弥上学了…"
                                },
                                {
                                    "id": "710700107",
                                    "speaker": "瑾武",
                                    "text": "有时候，矿上的男人去得早，留下的小孩子们也都由我揽下来照顾…身上就总是带着些小甜食什么的。"
                                },
                                {
                                    "id": "710700108",
                                    "speaker": "瑾武",
                                    "text": "所以呀…在我的印象里，小孩子总是带着甜甜的气味，眼巴巴地等在地面上，等着我们的糖瓜，或者好看的小石头。"
                                },
                                {
                                    "id": "710700109",
                                    "speaker": "派蒙",
                                    "text": "哇…所以瑾武姐现在也带着糖果吗？"
                                },
                                {
                                    "id": "710700110",
                                    "speaker": "瑾武",
                                    "text": "糖果呀？嗯…城里那种花里胡哨的糖果没有咯。不过你也不要嫌弃砂糖块呀？"
                                },
                                {
                                    "id": "710700111",
                                    "speaker": "派蒙",
                                    "text": "原来是这种糖呀…"
                                },
                                {
                                    "id": "710700112",
                                    "speaker": "瑾武",
                                    "text": "身边的人来来去去，留下的只有挂念，在这里陪着我。哈哈，还有你们这些下矿的冒险家们。"
                                }
                            ]
                        },
                        {
                            "id": "710700113",
                            "text": "关于志琼…",
                            "response": [
                                {
                                    "id": "710700114",
                                    "speaker": "瑾武",
                                    "text": "志琼是矿上的新生代，明蕴镇出生的。其实层岩巨渊里有经验的矿工都是明蕴镇来的…志琼没赶上好时候吧。"
                                },
                                {
                                    "id": "710700115",
                                    "speaker": "瑾武",
                                    "text": "啊…不要误会，我不是说现在日子过得不好。我的意思是，明蕴镇好些年前因为矿产枯竭，已经停产了。"
                                },
                                {
                                    "id": "710700116",
                                    "speaker": "瑾武",
                                    "text": "志琼后来来了层岩巨渊，层岩巨渊也出事停产了…这孩子可能天生不适合做矿工。"
                                },
                                {
                                    "id": "710700117",
                                    "speaker": "Player",
                                    "text": "这…"
                                },
                                {
                                    "id": "710700118",
                                    "speaker": "瑾武",
                                    "text": "后来嘛，大家各寻生路，我继续留在矿坑——撤离后留下的设备还要维护嘛。她就去做了冒险家。"
                                },
                                {
                                    "id": "710700119",
                                    "speaker": "瑾武",
                                    "text": "这孩子总是长不大，一点也不爱惜自己。还是在矿下做工的日子太少了。"
                                },
                                {
                                    "id": "710700120",
                                    "speaker": "瑾武",
                                    "text": "如果她能够习惯矿工的生活，如果她也以自己的双手拯救过那些身陷危险的人…恐怕会对生命有更深的认识吧。"
                                },
                                {
                                    "id": "710700121",
                                    "speaker": "瑾武",
                                    "text": "虽然不是什么像样的请求…我希望你能多盯着她一点，可别让她把自己害死了。"
                                }
                            ]
                        },
                        {
                            "id": "710700122",
                            "text": "再见。",
                            "response": [
                                {
                                    "id": "710700123",
                                    "speaker": "瑾武",
                                    "text": "嗯，保重安全！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7107002",
            "objective": "初到营地-克里托夫$HIDDEN",
            "dialogues": [
                {
                    "id": "710701701",
                    "speaker": "克里托夫",
                    "text": "你好！旅途如何？"
                },
                {
                    "id": "710701702",
                    "speaker": "Player",
                    "text": "还好，你过得如何？"
                },
                {
                    "id": "710701703",
                    "speaker": "克里托夫",
                    "text": "感谢你给的机会，自从调配炮弹引信成功以后，大家都愿意接受我留在这里了。"
                },
                {
                    "id": "710701704",
                    "speaker": "克里托夫",
                    "text": "至于上到地面之后的打算嘛…哈哈，还没想好！反正大概是不会做盗宝团啦！",
                    "choices": [
                        {
                            "id": "710701705",
                            "text": "大概…？",
                            "response": [
                                {
                                    "id": "710701707",
                                    "speaker": "克里托夫",
                                    "text": "肯定不会，肯定不会啦！"
                                },
                                {
                                    "id": "710701708",
                                    "speaker": "Player",
                                    "text": "再见。"
                                },
                                {
                                    "id": "710701709",
                                    "speaker": "克里托夫",
                                    "text": "保重！"
                                }
                            ]
                        },
                        {
                            "id": "710701706",
                            "text": "真的…？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7107003",
            "objective": "初到营地-海迪夫$HIDDEN",
            "dialogues": [
                {
                    "id": "710701801",
                    "speaker": "海迪夫",
                    "text": "这家伙…唉…啊？啊，你好。抱歉，你打扰到我了。"
                },
                {
                    "id": "710701802",
                    "speaker": "Player",
                    "text": "那我们算是扯平了？"
                },
                {
                    "id": "710701804",
                    "speaker": "海迪夫",
                    "text": "好了，不要和我逗闷子了。现在我们的情况很不妙，你知道吗？很不妙。"
                },
                {
                    "id": "710701805",
                    "speaker": "海迪夫",
                    "text": "你也看到那块发光的晶石碎片了，对吧？据我猜测，在更深处应该还有一块更大的…我猜你也早就预料到了。"
                },
                {
                    "id": "710701806",
                    "speaker": "海迪夫",
                    "text": "理论上说，当上面那块碎片「回归」之后，能量读数应该是趋于稳定的…嗯，事实也是这样。但…波形完全不对…完全不对。",
                    "choices": [
                        {
                            "id": "710701807",
                            "text": "你在说什么？",
                            "response": [
                                {
                                    "id": "710701809",
                                    "speaker": "海迪夫",
                                    "text": "没怎么上过学，嗯？好吧…简单来说。我们正在面临着两种强大力量的斗争，就像石磨上的豆子一样，明白吗？"
                                },
                                {
                                    "id": "710701810",
                                    "speaker": "海迪夫",
                                    "text": "在更大的时间尺度上，我们正在被来自上面和下面的两种力量，急速磨成豆浆！"
                                },
                                {
                                    "id": "710701811",
                                    "speaker": "海迪夫",
                                    "text": "不信的话就等着瞧吧，那个叫志琼的冒险家…我见过近距离接触过那种东西之后人的样子。"
                                },
                                {
                                    "id": "710701812",
                                    "speaker": "海迪夫",
                                    "text": "今天她咳血，明天她就有可能把自己的肺组织也一并咳出来。"
                                },
                                {
                                    "id": "710701813",
                                    "speaker": "Player",
                                    "text": "我有什么能帮忙的吗？"
                                },
                                {
                                    "id": "710701814",
                                    "speaker": "海迪夫",
                                    "text": "你？嗯…让我想想，让我想想…给我时间，一定有办法的…"
                                },
                                {
                                    "id": "710701815",
                                    "speaker": "海迪夫",
                                    "text": "不过现在，我们最要紧是需要你继续探索，看看下面究竟发生了什么事。"
                                },
                                {
                                    "id": "710701816",
                                    "speaker": "海迪夫",
                                    "text": "放心吧，我不会放着这么严重的事情不管的…我可得对勘探队员的安全负责，不能让自己的钱白花了。"
                                },
                                {
                                    "id": "710701817",
                                    "speaker": "Player",
                                    "text": "你也会对我的安全负责吗？"
                                },
                                {
                                    "id": "710701818",
                                    "speaker": "海迪夫",
                                    "text": "唔…不得不承认，你的能力已经超出了我的预估，所以…既然你完全有能力为自己负责…"
                                },
                                {
                                    "id": "710701819",
                                    "speaker": "海迪夫",
                                    "text": "唉，算了，不要提那些不知所谓的话了…一旦你出了意外，我也会付出补偿的，好了吧？"
                                }
                            ]
                        },
                        {
                            "id": "710701808",
                            "text": "请用我听得懂的语言。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7107004",
            "objective": "初到营地-塔列辛$HIDDEN",
            "dialogues": [
                {
                    "id": "710701901",
                    "speaker": "塔列辛",
                    "text": "抱歉…我有点头晕，不过我还能挺得住的！欸哟…嘶…",
                    "choices": [
                        {
                            "id": "710701902",
                            "text": "你来这里做什么？",
                            "response": [
                                {
                                    "id": "710701903",
                                    "speaker": "塔列辛",
                                    "text": "我是老派吟游诗人嘛，当然是来这里寻找灵感。"
                                },
                                {
                                    "id": "710701904",
                                    "speaker": "派蒙",
                                    "text": "哇…明明之前还很有精神的，怎么现在一副要死的样子…"
                                },
                                {
                                    "id": "710701905",
                                    "speaker": "塔列辛",
                                    "text": "我又没下过矿…再加上…就是之前来的时候急匆匆的，有点…抻着筋了。"
                                },
                                {
                                    "id": "710701906",
                                    "speaker": "塔列辛",
                                    "text": "嗨呀好痛…"
                                }
                            ]
                        },
                        {
                            "id": "710701907",
                            "text": "不打扰你了…",
                            "response": [
                                {
                                    "id": "710701908",
                                    "speaker": "塔列辛",
                                    "text": "嘶…呼…这药油怎么不好使呢…啊，慢走，有新故事的话还请告诉我！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7107005",
            "objective": "阿志离开-阿武$HIDDEN",
            "dialogues": [
                {
                    "id": "710702001",
                    "speaker": "瑾武",
                    "text": "啊，你来了。"
                },
                {
                    "id": "710702002",
                    "speaker": "瑾武",
                    "text": "志琼她最近很不对劲，我怀疑是那些…污黑的东西在影响她的心智和身体。"
                },
                {
                    "id": "710702003",
                    "speaker": "瑾武",
                    "text": "那些…东西，和传说中，五百年前的本地人对漆黑灾变的描述十分相似…"
                },
                {
                    "id": "710702004",
                    "speaker": "瑾武",
                    "text": "可是如今夜叉多已销声匿迹，岩王爷也离开了…我还是头一次这么担忧我们凡人的安危。"
                },
                {
                    "id": "710702005",
                    "speaker": "瑾武",
                    "text": "抱歉…拉住你说了这么多没用的话。但…"
                },
                {
                    "id": "710702006",
                    "speaker": "瑾武",
                    "text": "算了…你一路保重。"
                }
            ]
        },
        {
            "id": "7107006",
            "objective": "阿志离开-克里托夫$HIDDEN",
            "dialogues": [
                {
                    "id": "710702101",
                    "speaker": "克里托夫",
                    "text": "志琼刚才好像在发脾气一样，气冲冲地就走了。你知道是怎么回事吗？"
                },
                {
                    "id": "710702102",
                    "speaker": "克里托夫",
                    "text": "哼，她都说过不会再生我的气了…结果来到这个营地以后就完全没有好脾气。"
                },
                {
                    "id": "710702103",
                    "speaker": "克里托夫",
                    "text": "海迪夫那家伙逢人就说志琼脑子坏掉了，一定要离开层岩巨渊…"
                },
                {
                    "id": "710702104",
                    "speaker": "克里托夫",
                    "text": "哼哼，我看他才是读书把脑袋读坏了。"
                }
            ]
        },
        {
            "id": "7107007",
            "objective": "阿志离开-塔列辛$HIDDEN",
            "dialogues": [
                {
                    "id": "710702201",
                    "speaker": "塔列辛",
                    "text": "呼…脚踝好多了…消痛了。为璃月的药油我也得作一首史诗才行…"
                },
                {
                    "id": "710702202",
                    "speaker": "塔列辛",
                    "text": "啊，抱歉，我刚刚一直在这里休息，没有注意到你。"
                },
                {
                    "id": "710702203",
                    "speaker": "塔列辛",
                    "text": "如果你是要找志琼的话…她说她要去寻找一处大门什么的…"
                },
                {
                    "id": "710702204",
                    "speaker": "塔列辛",
                    "text": "还说要把冒险故事回来给我分享，你去那边找她就好。"
                }
            ]
        },
        {
            "id": "7107008",
            "objective": "阿志离开-海迪夫$HIDDEN",
            "dialogues": [
                {
                    "id": "710702301",
                    "speaker": "海迪夫",
                    "text": "难听的话都和你说过了，我很抱歉。"
                },
                {
                    "id": "710702302",
                    "speaker": "海迪夫",
                    "text": "好了，我就不打扰你了…我们都有自己的事情要忙。"
                }
            ]
        },
        {
            "id": "7107009",
            "objective": "再度离开-阿武$HIDDEN",
            "dialogues": [
                {
                    "id": "710702401",
                    "speaker": "瑾武",
                    "text": "怎么，又回来了？有什么需要的吗？"
                },
                {
                    "id": "710702402",
                    "speaker": "Player",
                    "text": "关于志琼…"
                },
                {
                    "id": "710702403",
                    "speaker": "瑾武",
                    "text": "她返回上面重新勘误地图去了。我不知道她急个什么劲…总之，看到她很有精神就好。"
                },
                {
                    "id": "710702404",
                    "speaker": "瑾武",
                    "text": "总之，谢谢你…虽然我不知道你用什么方式把她弄回来的。我们都很担心她，但看到她好转真是太好了。"
                }
            ]
        },
        {
            "id": "7107010",
            "objective": "再度离开-克里托夫$HIDDEN",
            "dialogues": [
                {
                    "id": "710702501",
                    "speaker": "克里托夫",
                    "text": "你好！回来聊天的话我随时奉陪！",
                    "choices": [
                        {
                            "id": "710702502",
                            "text": "你好闲呀。",
                            "response": [
                                {
                                    "id": "710702503",
                                    "speaker": "克里托夫",
                                    "text": "喂，可别把我当闲汉了。等到你们需要我的时候，我可是要忙得不可开交呢。"
                                }
                            ]
                        },
                        {
                            "id": "710702504",
                            "text": "关于志琼…",
                            "response": [
                                {
                                    "id": "710702505",
                                    "speaker": "克里托夫",
                                    "text": "她呀…她回来以后冷静了许多。唔…不知道是不是这里邪门的环境原因，大家都有些暴躁易怒，越来越没耐心。"
                                },
                                {
                                    "id": "710702506",
                                    "speaker": "克里托夫",
                                    "text": "刚刚我还被瑾武姐骂了一顿呢，从没见过她那么凶…我现在还心有余悸。"
                                }
                            ]
                        },
                        {
                            "id": "710702507",
                            "text": "再见。",
                            "response": [
                                {
                                    "id": "710702508",
                                    "speaker": "克里托夫",
                                    "text": "再见，保重！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7107011",
            "objective": "再度离开-海迪夫$HIDDEN",
            "dialogues": [
                {
                    "id": "710702601",
                    "speaker": "海迪夫",
                    "text": "多谢你了，如果不是有你一直在帮忙，勘探队肯定会中途垮掉的。"
                },
                {
                    "id": "710702602",
                    "speaker": "海迪夫",
                    "text": "虽然不知道你们做了什么，但元素地脉活动的读数稳定了许多…嗯，污染物的扩张速度正在减慢。"
                },
                {
                    "id": "710702603",
                    "speaker": "海迪夫",
                    "text": "至于为什么会这样…或许答案仍然隐藏在大地的更深处吧…谁知道呢。"
                },
                {
                    "id": "710702604",
                    "speaker": "海迪夫",
                    "text": "至于志琼那孩子…唉，离开还来得及。她视层岩巨渊胜过生命，全然不顾层岩巨渊正想要她的命。"
                }
            ]
        },
        {
            "id": "7107013",
            "objective": "主线结束后-阿志$HIDDEN",
            "dialogues": [
                {
                    "id": "710702701",
                    "speaker": "志琼",
                    "text": "实在抱歉…之前因为我的任性，给你添麻烦了，前辈。"
                },
                {
                    "id": "710702702",
                    "speaker": "志琼",
                    "text": "我之后还会继续细化已有的地图，以及帮瑾武姐布置信标，监测那些污黑物质的活动情况。"
                },
                {
                    "id": "710702703",
                    "speaker": "志琼",
                    "text": "那些东西…听他们说很可能和五百年前的漆黑灾祸有关。只不过不清楚是过去的余震，还是卷土重来的征兆…"
                },
                {
                    "id": "710702704",
                    "speaker": "志琼",
                    "text": "无论如何，感谢前辈，让我知道了普通人的极限所在，以及…在限度之内怎样寻求自身的意义…"
                },
                {
                    "id": "710702705",
                    "speaker": "派蒙",
                    "text": "哇…志琼怎么突然说话像个哲学家一样了！"
                },
                {
                    "id": "710702706",
                    "speaker": "Player",
                    "text": "我从没想过那么多。"
                },
                {
                    "id": "710702707",
                    "speaker": "志琼",
                    "text": "只是前辈真的帮了我很多，相比起来…我就连绘制地图，也总是要麻烦前辈的帮助…"
                },
                {
                    "id": "710702708",
                    "speaker": "志琼",
                    "text": "更何况面对险境时，总是会拖累前辈你们…",
                    "choices": [
                        {
                            "id": "710702709",
                            "text": "我只是在意你的安全而已。",
                            "response": [
                                {
                                    "id": "710702711",
                                    "speaker": "志琼",
                                    "text": "嗯…我也不会放弃的，等休整好了，我会再度出发的。"
                                }
                            ]
                        },
                        {
                            "id": "710702710",
                            "text": "没关系，希望你能完成地图。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7107014",
            "objective": "主线结束后-阿武$HIDDEN",
            "dialogues": [
                {
                    "id": "710702801",
                    "speaker": "瑾武",
                    "text": "哈哈，你回来了。请随便休息一下吧，把这里当自己家就好！",
                    "choices": [
                        {
                            "id": "710702802",
                            "text": "这里可不像能住人的样子。",
                            "response": [
                                {
                                    "id": "710702804",
                                    "speaker": "瑾武",
                                    "text": "哈哈哈哈哈！你这孩子，说话怎么这么损呢！"
                                },
                                {
                                    "id": "710702805",
                                    "speaker": "瑾武",
                                    "text": "唉，多亏了你的帮助，营地的氛围也轻松了许多。如果之前我让你感觉太严肃紧张的话，实在是对不起。"
                                },
                                {
                                    "id": "710702806",
                                    "speaker": "瑾武",
                                    "text": "要紧事务已经完成了，现在留给我们的是长期工作。也就是…常驻地下，监督异变情况。"
                                },
                                {
                                    "id": "710702807",
                                    "speaker": "瑾武",
                                    "text": "过一段时间或许矿坑就可以部分开放了，但这么深的地下还不行。"
                                },
                                {
                                    "id": "710702808",
                                    "speaker": "瑾武",
                                    "text": "我们要负责封锁这片区域，不能让矿工…不，不能让任何人下到这里来。"
                                }
                            ]
                        },
                        {
                            "id": "710702803",
                            "text": "我要把自己当做穴居人吗？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7107015",
            "objective": "主线结束后-克里托夫$HIDDEN",
            "dialogues": [
                {
                    "id": "710702901",
                    "speaker": "克里托夫",
                    "text": "啊，你来了！欢迎来到层岩巨渊勘探队的爆破组与饮料供应处！"
                },
                {
                    "id": "710702902",
                    "speaker": "克里托夫",
                    "text": "全体成员——也就是我，克里托夫，向你致敬！"
                },
                {
                    "id": "710702903",
                    "speaker": "克里托夫",
                    "text": "哈哈，这杯算请你了！多谢你为我们做的一切。",
                    "choices": [
                        {
                            "id": "710702904",
                            "text": "接下来有什么打算？",
                            "response": [
                                {
                                    "id": "710702906",
                                    "speaker": "克里托夫",
                                    "text": "既然我已经正式成为勘探队的一员了，当然要跟随队伍留在这里。"
                                },
                                {
                                    "id": "710702907",
                                    "speaker": "克里托夫",
                                    "text": "哼…不过如果海迪夫和瑾武姐能帮我申请到更多帮手就好了…"
                                },
                                {
                                    "id": "710702908",
                                    "speaker": "克里托夫",
                                    "text": "虽说到那时候呀，恐怕我就当不成爆破组长兼唯一队员了。"
                                }
                            ]
                        },
                        {
                            "id": "710702905",
                            "text": "你要留在这里吗？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7107016",
            "objective": "主线结束后-海迪夫$HIDDEN",
            "dialogues": [
                {
                    "id": "710703001",
                    "speaker": "海迪夫",
                    "text": "#哦？我还以为你已经离开了呢。你好，{NICKNAME}。"
                },
                {
                    "id": "710703002",
                    "speaker": "海迪夫",
                    "text": "能量读数稳定了许多…谢谢你的努力，等我回去会在论文中提起你的。"
                },
                {
                    "id": "710703003",
                    "speaker": "海迪夫",
                    "text": "不过作为名义上的勘探队雇主，我还需要长期留驻观察影响。"
                },
                {
                    "id": "710703004",
                    "speaker": "Player",
                    "text": "我该走了。"
                },
                {
                    "id": "710703005",
                    "speaker": "海迪夫",
                    "text": "我就不强留你了，不过勘探队永远欢迎你到来。"
                }
            ]
        },
