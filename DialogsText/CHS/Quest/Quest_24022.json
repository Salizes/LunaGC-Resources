        {
            "id": "2402205",
            "objective": "取回资料",
            "dialogues": [
                {
                    "id": "240220501",
                    "speaker": "安里",
                    "text": "为了枫达！这件事就拜托您了。"
                }
            ]
        },
        {
            "id": "2402206",
            "objective": "取回资料",
            "dialogues": [
                {
                    "id": "240220601",
                    "speaker": "安里",
                    "text": "居然真的找到了完好无损的资料…您真是我的福星！"
                },
                {
                    "id": "240220602",
                    "speaker": "派蒙",
                    "text": "等等，你怎么一副意外的表情？"
                },
                {
                    "id": "240220603",
                    "speaker": "派蒙",
                    "text": "你不会…其实对回收资料这件事压根没抱希望吧！"
                },
                {
                    "id": "240220604",
                    "speaker": "安里",
                    "text": "怎么可能！我用枫达发誓，绝无此种想法！",
                    "choices": [
                        {
                            "id": "240220605",
                            "text": "你最好没有。",
                            "response": [
                                {
                                    "id": "240220607",
                                    "speaker": "安里",
                                    "text": "咳！总之，顺利回收到了资料绝对是一件好事，我先研究一下里面的内容…"
                                },
                                {
                                    "id": "240220608",
                                    "speaker": "Black Screen",
                                    "text": "安里开始翻看起了资料…"
                                },
                                {
                                    "id": "240220609",
                                    "speaker": "安里",
                                    "text": "这里面记载的是调整枫达甜度的各种方法…"
                                },
                                {
                                    "id": "240220610",
                                    "speaker": "安里",
                                    "text": "居然能够想到在枫达里加盐以丰富饮品风味…不愧是过去的我！"
                                },
                                {
                                    "id": "240220611",
                                    "speaker": "Player",
                                    "text": "你先让现在的自己反思一下吧。"
                                },
                                {
                                    "id": "240220612",
                                    "speaker": "派蒙",
                                    "text": "咸…咸味的枫达，总觉得…不太想喝呢…"
                                },
                                {
                                    "id": "240220613",
                                    "speaker": "安里",
                                    "text": "咦？你们是不喜欢这种味道吗？"
                                },
                                {
                                    "id": "240220614",
                                    "speaker": "安里",
                                    "text": "哈哈哈，放心吧，盐带来的咸味不会太强烈，整体的饮品风味还是偏甜的。"
                                },
                                {
                                    "id": "240220615",
                                    "speaker": "安里",
                                    "text": "唔…既然是你们帮我收回的资料，那这次我制作的新型枫达，也会参考你们的意见。"
                                },
                                {
                                    "id": "240220616",
                                    "speaker": "安里",
                                    "text": "你们觉得，我应该采用这篇设计稿的意见，在枫达里加入盐吗？"
                                }
                            ]
                        },
                        {
                            "id": "240220606",
                            "text": "你问过枫达的感受吗？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "2402207",
            "objective": "取回资料",
            "dialogues": [
                {
                    "id": "240220701",
                    "speaker": "Player",
                    "text": "加吧，咸味挺好的。"
                },
                {
                    "id": "240220702",
                    "speaker": "安里",
                    "text": "没问题，就以你们的意见为准！"
                },
                {
                    "id": "240220703",
                    "speaker": "安里",
                    "text": "我会继续研究新型枫达的，等我造出了完成品，一定先请你们品尝。"
                },
                {
                    "id": "240220704",
                    "speaker": "安里",
                    "text": "咸味、甜味…唔…怎么把握两者的平衡呢…"
                }
            ]
        },
        {
            "id": "2402208",
            "objective": "向安里回报",
            "dialogues": []
        },
