    "talks": [
        {
            "id": "7502501",
            "objective": "等待龙伙伴玩耍归来$HIDDEN",
            "dialogues": [
                {
                    "id": "750250101",
                    "speaker": "派蒙",
                    "text": "呜啊，这是什么神奇的地方？居然有这么多小嵴锋龙…"
                },
                {
                    "id": "750250102",
                    "speaker": "派蒙",
                    "text": "难道是什么嵴锋龙的…聚集地？"
                },
                {
                    "id": "750250103",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "呀！…唔呀？"
                },
                {
                    "id": "750250104",
                    "speaker": "派蒙",
                    "text": "#难得遇到这么多同伴，{REALNAME[ID(2)|SHOWHOST(true)]}看上去也显得很兴奋呢…"
                },
                {
                    "id": "750250105",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "呀？"
                },
                {
                    "id": "750250106",
                    "speaker": "派蒙",
                    "text": "#哦，你是想去那边和它们一起玩吗？唔，{NICKNAME}，这么一想，{REALNAME[ID(2)|SHOWHOST(true)]}确实很少和小嵴锋龙们一起…",
                    "choices": [
                        {
                            "id": "750250107",
                            "text": "注意安全哦？",
                            "response": [
                                {
                                    "id": "750250109",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "呀！"
                                },
                                {
                                    "id": "750250110",
                                    "speaker": "派蒙",
                                    "text": "#虽然还是有点担心，不过现在我们就找个地方坐下来，边吃东西边聊天，等着{REALNAME[ID(2)|SHOWHOST(true)]}好了。"
                                },
                                {
                                    "id": "750250111",
                                    "speaker": "Black Screen",
                                    "text": "#你和派蒙在附近找到了一块不错的休息处，等待{REALNAME[ID(2)|SHOWHOST(true)]}结束游玩归来。"
                                },
                                {
                                    "id": "750250112",
                                    "speaker": "Black Screen",
                                    "text": "只不过，等待的时间似乎长了一些…"
                                },
                                {
                                    "id": "750250113",
                                    "speaker": "派蒙",
                                    "text": "#…咦，{REALNAME[ID(2)|SHOWHOST(true)]}怎么还没有回来？"
                                },
                                {
                                    "id": "750250114",
                                    "speaker": "派蒙",
                                    "text": "不会是出了什么事了吧…"
                                },
                                {
                                    "id": "750250115",
                                    "speaker": "Player",
                                    "text": "也许是玩得太开心了？"
                                },
                                {
                                    "id": "750250116",
                                    "speaker": "派蒙",
                                    "text": "要是这样，也得好好说说它，天都要黑了还不回来！"
                                },
                                {
                                    "id": "750250117",
                                    "speaker": "派蒙",
                                    "text": "唔…我们快点去找找它吧。"
                                }
                            ]
                        },
                        {
                            "id": "750250108",
                            "text": "要及时回来！"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7502504",
            "objective": "去寻找未归的龙伙伴",
            "dialogues": []
        },
        {
            "id": "7502506",
            "objective": "(test)和幼崽A对话$HIDDEN",
            "dialogues": [
                {
                    "id": "750250601",
                    "speaker": "派蒙",
                    "text": "#你好你好，请问你看到过{REALNAME[ID(2)|SHOWHOST(true)]}吗？就是那只新来的小嵴锋龙…"
                },
                {
                    "id": "750250602",
                    "speaker": "派蒙",
                    "text": "头上有印记，尾巴上有丝带…"
                },
                {
                    "id": "750250603",
                    "speaker": "呆呆的小嵴锋龙",
                    "text": "唔嗯？"
                },
                {
                    "id": "750250604",
                    "speaker": "派蒙",
                    "text": "唔，看上去好像没法理解我们说的话。"
                },
                {
                    "id": "750250605",
                    "speaker": "派蒙",
                    "text": "#{NICKNAME}，看来我们只能一个一个找过去了…"
                }
            ]
        },
        {
            "id": "7502507",
            "objective": "(test)和幼崽B对话$HIDDEN",
            "dialogues": [
                {
                    "id": "750250701",
                    "speaker": "派蒙",
                    "text": "看看这只小嵴锋龙…真会选地方！"
                },
                {
                    "id": "750250702",
                    "speaker": "派蒙",
                    "text": "#也不对，尾巴上没有丝巾，不是{REALNAME[ID(2)|SHOWHOST(true)]}呢。"
                },
                {
                    "id": "750250703",
                    "speaker": "树上的小嵴锋龙",
                    "text": "唔嗯？"
                }
            ]
        },
        {
            "id": "7502508",
            "objective": "(test)和幼崽C对话$HIDDEN",
            "dialogues": [
                {
                    "id": "750250801",
                    "speaker": "派蒙",
                    "text": "哎呀，你有没有见过…"
                },
                {
                    "id": "750250802",
                    "speaker": "Black Screen",
                    "text": "#派蒙向看上去机灵的小嵴锋龙描述了{REALNAME[ID(2)|SHOWHOST(true)]}的样子。"
                },
                {
                    "id": "750250803",
                    "speaker": "机灵的小嵴锋龙",
                    "text": "呀！"
                },
                {
                    "id": "750250804",
                    "speaker": "机灵的小嵴锋龙",
                    "text": "呀！！"
                },
                {
                    "id": "750250805",
                    "speaker": "派蒙",
                    "text": "#等等，这个反应，难道你知道我们要找{REALNAME[ID(2)|SHOWHOST(true)]}？真聪明！"
                },
                {
                    "id": "750250806",
                    "speaker": "派蒙",
                    "text": "我们赶快跟上它吧！"
                }
            ]
        },
        {
            "id": "7502513",
            "objective": "(test)幼崽C走到树莓地点$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7502514",
            "objective": "(test)幼崽C拿出树莓$HIDDEN",
            "dialogues": [
                {
                    "id": "750250501",
                    "speaker": "派蒙",
                    "text": "#啊，好多树莓，谢谢你…不对不对，我们要找的不是树莓，是{REALNAME[ID(2)|SHOWHOST(true)]}啦。"
                },
                {
                    "id": "750250502",
                    "speaker": "机灵的小嵴锋龙",
                    "text": "唔嗯？",
                    "choices": [
                        {
                            "id": "750250503",
                            "text": "不管怎么样，谢谢你了！",
                            "response": [
                                {
                                    "id": "750250505",
                                    "speaker": "机灵的小嵴锋龙",
                                    "text": "呀！"
                                },
                                {
                                    "id": "750250506",
                                    "speaker": "派蒙",
                                    "text": "#收到了树莓倒是很开心，但是看来{REALNAME[ID(2)|SHOWHOST(true)]}不在这里，还是再找找吧！"
                                }
                            ]
                        },
                        {
                            "id": "750250504",
                            "text": "树莓我们就收下了！"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7502515",
            "objective": "(test)找出钻地的幼崽D$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7502509",
            "objective": "(test)和幼崽D对话$HIDDEN",
            "dialogues": [
                {
                    "id": "750250901",
                    "speaker": "派蒙",
                    "text": "好啦，找到一只在地下悉悉索索的小嵴锋龙——"
                },
                {
                    "id": "750250902",
                    "speaker": "练习钻地的小嵴锋龙",
                    "text": "？"
                },
                {
                    "id": "750250903",
                    "speaker": "派蒙",
                    "text": "#也不是{REALNAME[ID(2)|SHOWHOST(true)]}？"
                },
                {
                    "id": "750250904",
                    "speaker": "派蒙",
                    "text": "#真是的，这里的小嵴锋龙也太多了点吧，唉，{REALNAME[ID(2)|SHOWHOST(true)]}究竟到哪去了？"
                }
            ]
        },
        {
            "id": "7502510",
            "objective": "(test)和幼崽E对话$HIDDEN",
            "dialogues": [
                {
                    "id": "750251001",
                    "speaker": "派蒙",
                    "text": "你好你好…"
                },
                {
                    "id": "750251002",
                    "speaker": "派蒙",
                    "text": "不对，为什么我下意识就和小嵴锋龙这么打招呼了啦？"
                },
                {
                    "id": "750251003",
                    "speaker": "活跃的小嵴锋龙",
                    "text": "呀！呀！"
                },
                {
                    "id": "750251004",
                    "speaker": "Player",
                    "text": "派蒙有礼貌！"
                },
                {
                    "id": "750251005",
                    "speaker": "派蒙",
                    "text": "嘿嘿，谢谢夸奖啦…"
                },
                {
                    "id": "750251006",
                    "speaker": "派蒙",
                    "text": "#不过言归正传，这只小嵴锋龙明显也不是{REALNAME[ID(2)|SHOWHOST(true)]}…"
                },
                {
                    "id": "750251007",
                    "speaker": "派蒙",
                    "text": "#嗯…要是{REALNAME[ID(2)|SHOWHOST(true)]}也像这只小嵴锋龙这样，一直这么开心就好了。"
                }
            ]
        },
        {
            "id": "7502511",
            "objective": "与龙伙伴对话$HIDDEN",
            "dialogues": [
                {
                    "id": "750251101",
                    "speaker": "派蒙",
                    "text": "啊！原来你在这里睡觉呢，难怪我们半天都找不到…"
                },
                {
                    "id": "750251102",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "唔嗯…"
                },
                {
                    "id": "750251103",
                    "speaker": "派蒙",
                    "text": "看来你玩得很开心嘛，都把自己累到犯困了。"
                },
                {
                    "id": "750251104",
                    "speaker": "派蒙",
                    "text": "不过在外面这样很危险哦，如果觉得困了，或者想休息了，一定要回到我们身边来啦…",
                    "choices": [
                        {
                            "id": "750251105",
                            "text": "说过要注意安全了哦…",
                            "response": [
                                {
                                    "id": "750251107",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "唔…"
                                },
                                {
                                    "id": "750251108",
                                    "speaker": "派蒙",
                                    "text": "好啦好啦，偶尔玩得尽兴也挺好的嘛。不过，以后一定要注意啦。"
                                },
                                {
                                    "id": "750251109",
                                    "speaker": "派蒙",
                                    "text": "对了，我们去和那边的大嵴锋龙打个招呼吧，说不定以后还能在别的地方遇到，到时候再一起和他们玩吧！"
                                },
                                {
                                    "id": "750251110",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "呀！"
                                }
                            ]
                        },
                        {
                            "id": "750251106",
                            "text": "说过要及时回来哦？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7502516",
            "objective": "找到龙伙伴$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7502512",
            "objective": "与大嵴锋龙告别",
            "dialogues": [
                {
                    "id": "750251201",
                    "speaker": "家长般的大嵴锋龙",
                    "text": "唔嗯？"
                },
                {
                    "id": "750251202",
                    "speaker": "派蒙",
                    "text": "#这段时间，{REALNAME[ID(2)|SHOWHOST(true)]}有劳你关照了哦，谢谢你啦！"
                },
                {
                    "id": "750251203",
                    "speaker": "家长般的大嵴锋龙",
                    "text": "唔…"
                },
                {
                    "id": "750251204",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "呀！"
                },
                {
                    "id": "750251205",
                    "speaker": "派蒙",
                    "text": "虽然也听不懂龙在说什么啦…"
                },
                {
                    "id": "750251206",
                    "speaker": "派蒙",
                    "text": "#那就要说再见了…{REALNAME[ID(2)|SHOWHOST(true)]}，要好好道别。"
                },
                {
                    "id": "750251207",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "唔…"
                },
                {
                    "id": "750251208",
                    "speaker": "Player",
                    "text": "没关系，道别是为了下一次相遇。"
                },
                {
                    "id": "750251209",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "唔嗯…呀！"
                },
                {
                    "id": "750251210",
                    "speaker": "家长般的大嵴锋龙",
                    "text": "唔嗯…"
                },
                {
                    "id": "750251211",
                    "speaker": "家长般的大嵴锋龙",
                    "text": "嗷——"
                },
                {
                    "id": "750251212",
                    "speaker": "小嵴锋龙们",
                    "text": "呀！"
                },
                {
                    "id": "750251213",
                    "speaker": "小嵴锋龙们",
                    "text": "呀，唔嗯…"
                },
                {
                    "id": "750251214",
                    "speaker": "家长般的大嵴锋龙",
                    "text": "唔嗯…"
                },
                {
                    "id": "750251215",
                    "speaker": "Black Screen",
                    "text": "似乎是到了嵴锋龙们回巢的时候，大嵴锋龙转身…\\n而小嵴锋龙们也跟着它，一同离去了。"
                },
                {
                    "id": "750251216",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "呜…"
                },
                {
                    "id": "750251217",
                    "speaker": "派蒙",
                    "text": "#哎呀，{REALNAME[ID(2)|SHOWHOST(true)]}，是觉得寂寞了吗？"
                },
                {
                    "id": "750251218",
                    "speaker": "派蒙",
                    "text": "嘿嘿，别忘了，你身边还有我们在呢！"
                },
                {
                    "id": "750251219",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "唔嗯，呀！"
                }
            ]
        },
