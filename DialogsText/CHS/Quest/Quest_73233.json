    "talks": [
        {
            "id": "7323301",
            "objective": "与里夫对话",
            "dialogues": [
                {
                    "id": "732330101",
                    "speaker": "里夫",
                    "text": "真是一点时间都抽不出来…"
                },
                {
                    "id": "732330102",
                    "speaker": "里夫",
                    "text": "现在也找不到人和我换班，这可怎么办…"
                },
                {
                    "id": "732330103",
                    "speaker": "里夫",
                    "text": "咦？旅行者…欸！请留步，旅行者！"
                },
                {
                    "id": "732330104",
                    "speaker": "Player",
                    "text": "怎么了？"
                },
                {
                    "id": "732330105",
                    "speaker": "里夫",
                    "text": "不好意思，突然叫住了你。我就是想问问你有没有空，我想请你帮个忙…",
                    "choices": [
                        {
                            "id": "732330106",
                            "text": "你说吧…",
                            "response": [
                                {
                                    "id": "732330107",
                                    "speaker": "里夫",
                                    "text": "你愿意帮忙吗？真是太谢谢你了！"
                                },
                                {
                                    "id": "732330111",
                                    "speaker": "里夫",
                                    "text": "事情是这样的…我在阿扎莱那里订了一个花盆，还有一批花种。"
                                },
                                {
                                    "id": "732330112",
                                    "speaker": "里夫",
                                    "text": "本来我拜托了一个朋友帮我去拿…"
                                },
                                {
                                    "id": "732330113",
                                    "speaker": "里夫",
                                    "text": "但他突然说有任务要去执行，暂时没法帮我这个忙了。我一时半会也找不到另外一个人帮忙…"
                                },
                                {
                                    "id": "732330114",
                                    "speaker": "里夫",
                                    "text": "旅行者，能请你帮我去阿扎莱那一趟，把花盆和花种带回来吗？我听人说…他现在好像在村口等着接货。"
                                },
                                {
                                    "id": "732330115",
                                    "speaker": "Player",
                                    "text": "你买这个做什么？"
                                },
                                {
                                    "id": "732330116",
                                    "speaker": "里夫",
                                    "text": "这些花和种子都是送给我女朋友内尔敏的。"
                                },
                                {
                                    "id": "732330117",
                                    "speaker": "里夫",
                                    "text": "她…身体不是很好，一直在家里养病。"
                                },
                                {
                                    "id": "732330118",
                                    "speaker": "里夫",
                                    "text": "你也看得到，这阿如村周围都是沙漠，也看不见什么绿植，环境实在是有些不太好。"
                                },
                                {
                                    "id": "732330119",
                                    "speaker": "里夫",
                                    "text": "我之前就买了一些绿植放在她家里，但她老是憋在屋子里养病，心情也不太好。"
                                },
                                {
                                    "id": "732330120",
                                    "speaker": "里夫",
                                    "text": "我平时工作也很忙，白天基本上没空回家陪她，只有在晚上能和她说说话…"
                                },
                                {
                                    "id": "732330121",
                                    "speaker": "里夫",
                                    "text": "我就想，不如让她自己也种点花，也算是能打发点时间，不至于让她老是想着自己生病了这件事。"
                                },
                                {
                                    "id": "732330122",
                                    "speaker": "里夫",
                                    "text": "结果，没想到出了这么一茬事…",
                                    "choices": [
                                        {
                                            "id": "732330123",
                                            "text": "我这就去跑一趟。",
                                            "response": [
                                                {
                                                    "id": "732330125",
                                                    "speaker": "里夫",
                                                    "text": "那就拜托你了，你把东西带回来之后，就直接拿给我吧。"
                                                },
                                                {
                                                    "id": "732330126",
                                                    "speaker": "里夫",
                                                    "text": "我要先把种子给种好，然后还得松土，施药…"
                                                },
                                                {
                                                    "id": "732330127",
                                                    "speaker": "里夫",
                                                    "text": "内尔敏的身体很弱，可不能让她太劳累了…"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "732330124",
                                            "text": "我去帮你把东西拿回来。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "732330108",
                            "text": "有钱就有空。",
                            "response": [
                                {
                                    "id": "732330109",
                                    "speaker": "里夫",
                                    "text": "欸？这…我倒是有点积蓄，报酬你不用担心…"
                                },
                                {
                                    "id": "732330110",
                                    "speaker": "里夫",
                                    "text": "无论如何，你愿意帮忙就最好了。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7323302",
            "objective": "与阿扎莱对话",
            "dialogues": [
                {
                    "id": "732330201",
                    "speaker": "阿扎莱",
                    "text": "唉，还有一批货物呢…"
                },
                {
                    "id": "732330202",
                    "speaker": "Player",
                    "text": "关于里夫的货物…"
                },
                {
                    "id": "732330203",
                    "speaker": "阿扎莱",
                    "text": "你是说里夫找我订的货物吗？我刚接了一批货，里面正好有他要的东西。"
                },
                {
                    "id": "732330204",
                    "speaker": "阿扎莱",
                    "text": "不过，他买的东西可不少啊…你是帮他来拿货的吗？",
                    "choices": [
                        {
                            "id": "732330205",
                            "text": "很，很重吗？",
                            "response": [
                                {
                                    "id": "732330207",
                                    "speaker": "阿扎莱",
                                    "text": "除了那个花盆之外，还有各类种子，肥料和园艺用品…"
                                },
                                {
                                    "id": "732330208",
                                    "speaker": "阿扎莱",
                                    "text": "这些东西加起来可不轻啊，你…你一个人搬得过去吗？",
                                    "choices": [
                                        {
                                            "id": "732330209",
                                            "text": "我自有办法…",
                                            "response": [
                                                {
                                                    "id": "732330211",
                                                    "speaker": "阿扎莱",
                                                    "text": "这样啊…那行，我给你把东西都包好。真是辛苦你走这一趟了…"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "732330210",
                                            "text": "我都答应人家了…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "732330206",
                            "text": "有，有多少…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7323303",
            "objective": "将东西带回给里夫",
            "dialogues": [
                {
                    "id": "732330301",
                    "speaker": "里夫",
                    "text": "旅行者！你把东西拿回来了吗？"
                }
            ]
        },
        {
            "id": "7323307",
            "objective": "将东西带回给里夫",
            "dialogues": [
                {
                    "id": "732330401",
                    "speaker": "里夫",
                    "text": "就是这些，太谢谢你了，旅行者。",
                    "choices": [
                        {
                            "id": "732330402",
                            "text": "你是要开花店吗…",
                            "response": [
                                {
                                    "id": "732330404",
                                    "speaker": "里夫",
                                    "text": "哎呀，这不是…一次性买多点，免得总是出去嘛…"
                                },
                                {
                                    "id": "732330405",
                                    "speaker": "里夫",
                                    "text": "你先在旁边休息一下吧！我得先把种子种下去，再施点肥料…"
                                },
                                {
                                    "id": "732330406",
                                    "speaker": "Black Screen",
                                    "text": "里夫开始摆弄起了花盆…"
                                },
                                {
                                    "id": "732330407",
                                    "speaker": "里夫",
                                    "text": "好了！这样就可以了，内尔敏只需要给这盆花浇浇水就行。"
                                },
                                {
                                    "id": "732330408",
                                    "speaker": "里夫",
                                    "text": "旅行者，能不能…再请你帮我把这盆花送去给内尔敏…"
                                },
                                {
                                    "id": "732330409",
                                    "speaker": "Player",
                                    "text": "你自己怎么不去？"
                                },
                                {
                                    "id": "732330410",
                                    "speaker": "里夫",
                                    "text": "我得盯着这个路口啊，要是有粮食或者物资运过来，我还得去叫村里的人过来接收物资。"
                                },
                                {
                                    "id": "732330411",
                                    "speaker": "里夫",
                                    "text": "周围这温度…你应该已经感觉到了。要是接收速度太慢，物资说不定都会被晒坏。"
                                },
                                {
                                    "id": "732330412",
                                    "speaker": "里夫",
                                    "text": "拜托你啦旅行者，内尔敏住得离这里不远，你就把这一盆花送去给她就好，其余的东西我会想办法运回去。"
                                }
                            ]
                        },
                        {
                            "id": "732330403",
                            "text": "你买这么多东西干啥！？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7323304",
            "objective": "将花盆带给内尔敏",
            "dialogues": []
        },
        {
            "id": "7323305",
            "objective": "与内尔敏对话",
            "dialogues": [
                {
                    "id": "732330501",
                    "speaker": "Black Screen",
                    "text": "屋内的某人似乎听到了动静…"
                },
                {
                    "id": "732330502",
                    "speaker": "内尔敏",
                    "text": "你好，请问有什么事吗？"
                },
                {
                    "id": "732330503",
                    "speaker": "Player",
                    "text": "关于这盆花…"
                },
                {
                    "id": "732330504",
                    "speaker": "内尔敏",
                    "text": "这是…里夫送给我的？"
                },
                {
                    "id": "732330505",
                    "speaker": "内尔敏",
                    "text": "这盆里种着花吗？真的？谢谢你帮他送来，我很喜欢…"
                },
                {
                    "id": "732330506",
                    "speaker": "内尔敏",
                    "text": "不过…我真的能养好它吗…"
                },
                {
                    "id": "732330507",
                    "speaker": "Player",
                    "text": "你之前没养过花吗？"
                },
                {
                    "id": "732330508",
                    "speaker": "内尔敏",
                    "text": "我…我不擅长照顾植物，之前好多盆绿植都被我养得枯萎了…"
                },
                {
                    "id": "732330509",
                    "speaker": "内尔敏",
                    "text": "这盆花一定更娇贵，要是我又把它给养枯的话…"
                },
                {
                    "id": "732330510",
                    "speaker": "内尔敏",
                    "text": "唔，不行，既然花已经到我手上了，我就要好好照顾它才行！"
                },
                {
                    "id": "732330511",
                    "speaker": "内尔敏",
                    "text": "库尔苏姆奶奶一定知道怎么解决这个问题…"
                }
            ]
        },
        {
            "id": "7323306",
            "objective": "向里夫回报",
            "dialogues": [
                {
                    "id": "732330601",
                    "speaker": "里夫",
                    "text": "旅行者，你回来了，真是辛苦你了…内尔敏怎么说？",
                    "choices": [
                        {
                            "id": "732330602",
                            "text": "她担心自己不会种花。",
                            "response": [
                                {
                                    "id": "732330603",
                                    "speaker": "里夫",
                                    "text": "这个…我会陪着她研究这事的啦，实在不行就去找人问问…"
                                },
                                {
                                    "id": "732330604",
                                    "speaker": "里夫",
                                    "text": "要是真不行，我…我就…我就去找点容易种，又容易成活的东西…"
                                },
                                {
                                    "id": "732330608",
                                    "speaker": "里夫",
                                    "text": "咳，总之…谢谢你帮我的忙，旅行者，这些报酬请你收下。"
                                },
                                {
                                    "id": "732330609",
                                    "speaker": "里夫",
                                    "text": "等会我就把其他的东西给内尔敏拿过去。"
                                },
                                {
                                    "id": "732330610",
                                    "speaker": "里夫",
                                    "text": "等等，这些园艺工具没附带使用说明书吗？我完全不知道怎么用它们啊！"
                                }
                            ]
                        },
                        {
                            "id": "732330605",
                            "text": "你之前没送过她花？",
                            "response": [
                                {
                                    "id": "732330606",
                                    "speaker": "里夫",
                                    "text": "也不能说没送过吧…只不过前几次我托人买的都是已经长成的花。等送到村里来的时候，那些花已经快被晒干了…"
                                },
                                {
                                    "id": "732330607",
                                    "speaker": "里夫",
                                    "text": "所以这次，我决定直接送内尔敏一盆刚种下的花。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7323307",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "732330701",
                    "speaker": "里夫",
                    "text": "唉，真希望内尔敏能快点好起来…"
                }
            ]
        },
        {
            "id": "7323308",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "732330801",
                    "speaker": "阿扎莱",
                    "text": "奇怪了，还有一批货物呢…"
                }
            ]
        },
        {
            "id": "7323309",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "732330901",
                    "speaker": "里夫",
                    "text": "我…我是不是买太多了…"
                }
            ]
        },
        {
            "id": "7323310",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "732331001",
                    "speaker": "内尔敏",
                    "text": "如果真的每天都要给花浇水，那得用多少水呢…"
                }
            ]
        }
    ]
}