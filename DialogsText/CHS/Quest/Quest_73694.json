    "talks": [
        {
            "id": "7369401",
            "objective": "与丹纳对话",
            "dialogues": [
                {
                    "id": "736940101",
                    "speaker": "丹纳",
                    "text": "唔，大家怎么都一副疲惫的样子…"
                },
                {
                    "id": "736940102",
                    "speaker": "Player",
                    "text": "这里在举办什么活动吗？"
                },
                {
                    "id": "736940103",
                    "speaker": "丹纳",
                    "text": "你是…旅行者对吧？哈哈哈，久仰大名了。"
                },
                {
                    "id": "736940104",
                    "speaker": "丹纳",
                    "text": "没错，我们伐护末那学院正在这里举办一个有关「考古」的小游戏。"
                },
                {
                    "id": "736940105",
                    "speaker": "丹纳",
                    "text": "毕竟我们学院里有不少研究历史的学者，在这些学者的研究过程里，自然就免不了去亲自「考古」了。"
                },
                {
                    "id": "736940106",
                    "speaker": "丹纳",
                    "text": "哎呀，别紧张，我们可不会让大家去真的考古啊。这次的活动，只是考古这种「行为」的一种模拟。"
                },
                {
                    "id": "736940107",
                    "speaker": "丹纳",
                    "text": "我们已经预先在须弥城周围埋了不少「文物模型」…我们就暂且把埋着这些东西的地方称作「考古区」吧。"
                },
                {
                    "id": "736940108",
                    "speaker": "丹纳",
                    "text": "参与活动的人，只需要拿上我们特别制作的探查器，在「考古区」内将埋藏的「文物模型」挖出来就好了。"
                },
                {
                    "id": "736940109",
                    "speaker": "丹纳",
                    "text": "多亏了其他学院的同学，帮忙特制了一批容器和对应的探查器。"
                },
                {
                    "id": "736940110",
                    "speaker": "丹纳",
                    "text": "怎么样，旅行者？你有没有兴趣试试看啊？",
                    "choices": [
                        {
                            "id": "736940111",
                            "text": "听起来倒也不难…",
                            "response": [
                                {
                                    "id": "736940113",
                                    "speaker": "丹纳",
                                    "text": "哈哈哈，好！这是探查器，你拿好了。我再把「考古区」所在的位置标在<color=#00E1FFFF>考古手册</color>上…"
                                },
                                {
                                    "id": "736940114",
                                    "speaker": "丹纳",
                                    "text": "这样就行了，快去体验考古的乐趣吧，旅行者。"
                                },
                                {
                                    "id": "736940115",
                                    "speaker": "丹纳",
                                    "text": "如果你把所有的「文物模型」都找到了，记得回来找我拿礼物啊。"
                                },
                                {
                                    "id": "736940116",
                                    "speaker": "丹纳",
                                    "text": "寻找模型的时候，只要跟着探查器走就好了。为了方便分类，还用元素类别做了区分。"
                                },
                                {
                                    "id": "736940117",
                                    "speaker": "丹纳",
                                    "text": "不过…那些探查器原来是用来探测元素的，被临时改造后，还是可能被一些特定的元素影响…"
                                },
                                {
                                    "id": "736940118",
                                    "speaker": "丹纳",
                                    "text": "总之，只要把所有的「文物模型」都挖出来，我们还有好礼相赠喔。"
                                }
                            ]
                        },
                        {
                            "id": "736940112",
                            "text": "试试也没问题…"
                        }
                    ]
                }
            ]
        }
    ]
}