    "talks": [
        {
            "id": "7110601",
            "objective": "回翘英庄找罗叔$HIDDEN",
            "dialogues": [
                {
                    "id": "711060101",
                    "speaker": "派蒙",
                    "text": "罗叔，我们回来啦！"
                },
                {
                    "id": "711060102",
                    "speaker": "罗叔",
                    "text": "哦哦，辛苦你们了！维护茶釜的技师已经到了，正在那边鼓捣着呢。"
                },
                {
                    "id": "711060103",
                    "speaker": "罗叔",
                    "text": "唉，也不知道是什么地方出了问题…"
                },
                {
                    "id": "711060104",
                    "speaker": "派蒙",
                    "text": "呃…所以她在干什么？"
                },
                {
                    "id": "711060105",
                    "speaker": "罗叔",
                    "text": "嗨，他们技师的行话我也听不懂，什么结构分析，什么键什么图的…反正就是在检查茶釜吧。"
                },
                {
                    "id": "711060106",
                    "speaker": "派蒙",
                    "text": "啊，去那边了…"
                },
                {
                    "id": "711060107",
                    "speaker": "罗叔",
                    "text": "……",
                    "choices": [
                        {
                            "id": "711060108",
                            "text": "……",
                            "response": [
                                {
                                    "id": "711060111",
                                    "speaker": "Black Screen",
                                    "text": "沃特蒙泰涅小姐身手轻盈地完成了检查…"
                                },
                                {
                                    "id": "711060112",
                                    "speaker": "沃特蒙泰涅",
                                    "text": "罗先生！茶釜的检查已经完成啦，目前来看…"
                                },
                                {
                                    "id": "711060113",
                                    "speaker": "沃特蒙泰涅",
                                    "text": "咦？你们两位也回来了呀！",
                                    "choices": [
                                        {
                                            "id": "711060114",
                                            "text": "有些担心茶釜的事情。",
                                            "response": [
                                                {
                                                    "id": "711060116",
                                                    "speaker": "沃特蒙泰涅",
                                                    "text": "哈哈，不必担心不必担心，只要是问题，就总有解决的办法嘛！"
                                                },
                                                {
                                                    "id": "711060117",
                                                    "speaker": "罗叔",
                                                    "text": "所以，怎么样？是不是大茶釜出了问题？"
                                                },
                                                {
                                                    "id": "711060118",
                                                    "speaker": "沃特蒙泰涅",
                                                    "text": "与其说是大茶釜出了问题，倒不如说…嗯，您看，我已经把键合图画在这里了。"
                                                },
                                                {
                                                    "id": "711060119",
                                                    "speaker": "沃特蒙泰涅",
                                                    "text": "流源本身应该没问题，但这边几个回能结的表现似乎有些不对劲…"
                                                },
                                                {
                                                    "id": "711060120",
                                                    "speaker": "派蒙",
                                                    "text": "流…呜哇，完全听不懂你在说什么！"
                                                },
                                                {
                                                    "id": "711060121",
                                                    "speaker": "沃特蒙泰涅",
                                                    "text": "啊哈哈…抱歉抱歉，习惯用这种说法了，一不小心就…"
                                                },
                                                {
                                                    "id": "711060122",
                                                    "speaker": "沃特蒙泰涅",
                                                    "text": "简单来说就是，茶釜本身应该没有损坏，但是与它相连的三处机关似乎出了问题，导致附近的元素力流动变得有些奇怪。"
                                                },
                                                {
                                                    "id": "711060123",
                                                    "speaker": "罗叔",
                                                    "text": "哼，我就知道！老陆头还非得跟我犟，说什么问题不在茶釜，而在土壤…"
                                                },
                                                {
                                                    "id": "711060124",
                                                    "speaker": "罗叔",
                                                    "text": "三处机关…欸，对咯！你们叫「机关」，我们叫「山镇」！山中地脉错综复杂，所以需用仙石镇住其中几股，以防元素力紊乱…",
                                                    "choices": [
                                                        {
                                                            "id": "711060125",
                                                            "text": "原来如此！",
                                                            "response": [
                                                                {
                                                                    "id": "711060126",
                                                                    "speaker": "沃特蒙泰涅",
                                                                    "text": "嗯…元素力紊乱是很可怕啦，但这些机关和地脉…应该关系不大，并没有直接相互连通就是。"
                                                                },
                                                                {
                                                                    "id": "711060129",
                                                                    "speaker": "沃特蒙泰涅",
                                                                    "text": "尽管看不到明确的机关结构，但运行的道理是相通的！那些传说中的「仙人」，一定也都是了不起的巧匠吧！"
                                                                },
                                                                {
                                                                    "id": "711060130",
                                                                    "speaker": "罗叔",
                                                                    "text": "嘿嘿，那还用说！我是不了解这里面的机构奥妙…但当初布置它们的那位留云借风真君，真是了不得的仙人！"
                                                                },
                                                                {
                                                                    "id": "711060131",
                                                                    "speaker": "沃特蒙泰涅",
                                                                    "text": "这些「山镇」…从功能上来说，更准确的叫法应该是「三相异步元素调谐器」。"
                                                                },
                                                                {
                                                                    "id": "711060132",
                                                                    "speaker": "派蒙",
                                                                    "text": "呃，调鞋器？"
                                                                },
                                                                {
                                                                    "id": "711060133",
                                                                    "speaker": "沃特蒙泰涅",
                                                                    "text": "是的！根据记载，枫丹动能工程科学研究院的创始人，阿兰·吉约丹大师，也曾经设计过一种约束阻尼减振装置，以调节元素力。"
                                                                },
                                                                {
                                                                    "id": "711060134",
                                                                    "speaker": "沃特蒙泰涅",
                                                                    "text": "虽然他的设计稿已经佚失了，但原理上应该是一样的…大概吧！"
                                                                },
                                                                {
                                                                    "id": "711060135",
                                                                    "speaker": "罗叔",
                                                                    "text": "哈哈…只可惜我岁数大了，这些东西学也学不会。所以呀，就让我再问一句啊，这问题是怎么来的？严重吗？能修吗？"
                                                                },
                                                                {
                                                                    "id": "711060136",
                                                                    "speaker": "沃特蒙泰涅",
                                                                    "text": "对我们技术工人来说，哪有什么严重不严重的问题！只有「能修好的」，和「修不好的」。至于手头上这个…若是修不好，我早就走人啦！"
                                                                },
                                                                {
                                                                    "id": "711060137",
                                                                    "speaker": "罗叔",
                                                                    "text": "哈哈，那就好，那就好！我还以为是仙人嫌我们怠慢，给这镇物略施仙术，让它再也没法修好了呢！"
                                                                },
                                                                {
                                                                    "id": "711060138",
                                                                    "speaker": "沃特蒙泰涅",
                                                                    "text": "罗先生，您要知道，任何装置都是一样的！如果太久不去维护修理，自然就会出现问题！"
                                                                },
                                                                {
                                                                    "id": "711060139",
                                                                    "speaker": "沃特蒙泰涅",
                                                                    "text": "吉约丹大师也说过，无论是什么样的系统，无论最初的设计多么精妙，若是放任它自发运行下去，最终都会不可避免地崩溃掉。"
                                                                },
                                                                {
                                                                    "id": "711060140",
                                                                    "speaker": "沃特蒙泰涅",
                                                                    "text": "如果真是茶釜出了问题，不去解决造成问题的根源，反而责备土壤生不出优质的茶叶，这样的想法就是不合理的！"
                                                                },
                                                                {
                                                                    "id": "711060141",
                                                                    "speaker": "派蒙",
                                                                    "text": "（唔，浮锦之前也说过，茶叶之所以会变得不好喝，是因为水土出了问题。要是把那个「调鞋器」修好的话，说不定也能调理水土…）"
                                                                },
                                                                {
                                                                    "id": "711060142",
                                                                    "speaker": "沃特蒙泰涅",
                                                                    "text": "总之，与茶釜相连的三处机关距离这里都不远，让我过去稍微调整一下，应该就能修好啦！"
                                                                },
                                                                {
                                                                    "id": "711060143",
                                                                    "speaker": "Player",
                                                                    "text": "我们也来帮忙吧。"
                                                                },
                                                                {
                                                                    "id": "711060144",
                                                                    "speaker": "沃特蒙泰涅",
                                                                    "text": "哎呀，那可真是太谢谢你们啦！既然如此，事不宜迟，我们快点出发吧！"
                                                                },
                                                                {
                                                                    "id": "711060145",
                                                                    "speaker": "罗叔",
                                                                    "text": "#哈哈…好，好呀，{NICKNAME}{M#少爷}{F#小姐}和小派，茶釜的事情，就拜托你们和这位技师姑娘了！"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "711060127",
                                                            "text": "罗叔您先别冲动…",
                                                            "response": [
                                                                {
                                                                    "id": "711060128",
                                                                    "speaker": "沃特蒙泰涅",
                                                                    "text": "罗先生大体说得没错，这些机关是专门用来防止元素力紊乱的装置，只是和地脉没什么关系…"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "711060115",
                                            "text": "有些担心茶叶的事情。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "711060109",
                            "text": "原来如此，这就是轻功…",
                            "response": [
                                {
                                    "id": "711060110",
                                    "speaker": "派蒙",
                                    "text": "不，好像完全不是一回事吧！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
