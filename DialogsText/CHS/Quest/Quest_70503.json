    "talks": [
        {
            "id": "7050301",
            "objective": "与卢卡对话，进入酒馆",
            "dialogues": [
                {
                    "id": "705030101",
                    "speaker": "优菈",
                    "text": "小杯远礁浮沫…谢谢。",
                    "choices": [
                        {
                            "id": "705030102",
                            "text": "优菈？",
                            "response": [
                                {
                                    "id": "705030104",
                                    "speaker": "优菈",
                                    "text": "我…我没事…"
                                },
                                {
                                    "id": "705030105",
                                    "speaker": "派蒙",
                                    "text": "唔…优菈的样子不太对劲，是来之前就喝了不少酒吗？"
                                },
                                {
                                    "id": "705030106",
                                    "speaker": "派蒙",
                                    "text": "我记得远礁浮沫是用咖啡泡的。喝完酒之后喝咖啡，哇，肚子会不会爆炸啊。"
                                },
                                {
                                    "id": "705030107",
                                    "speaker": "派蒙",
                                    "text": "为了肚子着想，端上去之前，偷偷帮她兑点水吧！"
                                }
                            ]
                        },
                        {
                            "id": "705030103",
                            "text": "你怎么了？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7050305",
            "objective": "前往吧台并完成营业准备",
            "dialogues": []
        },
        {
            "id": "7050304",
            "objective": "与优菈对话",
            "dialogues": []
        },
        {
            "id": "7050302",
            "objective": "为优菈调制指定饮品",
            "dialogues": [
                {
                    "id": "705030201",
                    "speaker": "优菈",
                    "text": "味道…不错…"
                },
                {
                    "id": "705030202",
                    "speaker": "派蒙",
                    "text": "哇，兑了那么多水都没察觉，优菈果然喝多了。"
                },
                {
                    "id": "705030203",
                    "speaker": "优菈",
                    "text": "酒保，再来…等、等等，怎么是你们？",
                    "choices": [
                        {
                            "id": "705030204",
                            "text": "正巧在体验酒保…",
                            "response": [
                                {
                                    "id": "705030206",
                                    "speaker": "优菈",
                                    "text": "……"
                                },
                                {
                                    "id": "705030207",
                                    "speaker": "优菈",
                                    "text": "不好意思。刚刚从猫尾酒馆过来，喝得可能稍微多了一些…",
                                    "choices": [
                                        {
                                            "id": "705030208",
                                            "text": "有什么烦心事吗？",
                                            "response": [
                                                {
                                                    "id": "705030210",
                                                    "speaker": "派蒙",
                                                    "text": "对啊。一个人喝闷酒多孤单，还是说出来，大家一起聊聊比较开心！"
                                                },
                                                {
                                                    "id": "705030211",
                                                    "speaker": "优菈",
                                                    "text": "……"
                                                },
                                                {
                                                    "id": "705030212",
                                                    "speaker": "优菈",
                                                    "text": "的确只有一个人喝。"
                                                },
                                                {
                                                    "id": "705030213",
                                                    "speaker": "优菈",
                                                    "text": "只要在蒙德，无论到哪个酒馆都不受待见。今天难得心情好，想喝上几杯，最后又被指指点点…"
                                                },
                                                {
                                                    "id": "705030214",
                                                    "speaker": "优菈",
                                                    "text": "#{NICKNAME}，你是怎么交到那么多朋友的呢？"
                                                },
                                                {
                                                    "id": "705030215",
                                                    "speaker": "优菈",
                                                    "text": "大家谈论你时，语气中总是很憧憬，脸上还带着笑容。"
                                                },
                                                {
                                                    "id": "705030216",
                                                    "speaker": "优菈",
                                                    "text": "而我，哪怕只是提到我的姓氏，都会…"
                                                },
                                                {
                                                    "id": "705030217",
                                                    "speaker": "Player",
                                                    "text": "别这样想。"
                                                },
                                                {
                                                    "id": "705030218",
                                                    "speaker": "派蒙",
                                                    "text": "出生在劳伦斯家族不是优菈自己能决定的事。但我们又不在乎这些，我们认识的优菈是个很好的人哦！"
                                                },
                                                {
                                                    "id": "705030219",
                                                    "speaker": "派蒙",
                                                    "text": "不过优菈就是不坦率，总爱装作记仇，把自己温柔的一面藏起来…"
                                                },
                                                {
                                                    "id": "705030220",
                                                    "speaker": "优菈",
                                                    "text": "喂，谁说是装作…",
                                                    "choices": [
                                                        {
                                                            "id": "705030221",
                                                            "text": "除了我们以外…",
                                                            "response": [
                                                                {
                                                                    "id": "705030223",
                                                                    "speaker": "优菈",
                                                                    "text": "真的吗？我喝醉了都不敢这么想…"
                                                                },
                                                                {
                                                                    "id": "705030224",
                                                                    "speaker": "优菈",
                                                                    "text": "那么久以来，哪怕加入了西风骑士团，大家都还…"
                                                                },
                                                                {
                                                                    "id": "705030225",
                                                                    "speaker": "Player",
                                                                    "text": "「风向是会转变的。」"
                                                                },
                                                                {
                                                                    "id": "705030226",
                                                                    "speaker": "派蒙",
                                                                    "text": "哦！那个卖唱的，也说过这种有道理的话啊。"
                                                                },
                                                                {
                                                                    "id": "705030227",
                                                                    "speaker": "派蒙",
                                                                    "text": "优菈，你就继续按你的方式前进吧。"
                                                                },
                                                                {
                                                                    "id": "705030228",
                                                                    "speaker": "派蒙",
                                                                    "text": "总有一天，你会改变大家对劳伦斯家族的印象！"
                                                                },
                                                                {
                                                                    "id": "705030229",
                                                                    "speaker": "Player",
                                                                    "text": "要耐心哦。"
                                                                },
                                                                {
                                                                    "id": "705030230",
                                                                    "speaker": "优菈",
                                                                    "text": "嗯，谢谢你们…"
                                                                },
                                                                {
                                                                    "id": "705030231",
                                                                    "speaker": "优菈",
                                                                    "text": "我，我…咳！就聊到这里吧，我先回去了。"
                                                                },
                                                                {
                                                                    "id": "705030232",
                                                                    "speaker": "Player",
                                                                    "text": "要送送你吗？"
                                                                },
                                                                {
                                                                    "id": "705030233",
                                                                    "speaker": "优菈",
                                                                    "text": "不必。我现在不能想别的事…得好好记住这些话，回去赶紧写在纸上…"
                                                                },
                                                                {
                                                                    "id": "705030234",
                                                                    "speaker": "派蒙",
                                                                    "text": "喝醉后的优菈，比平时坦率了不少。"
                                                                },
                                                                {
                                                                    "id": "705030235",
                                                                    "speaker": "派蒙",
                                                                    "text": "但没有听到那句标志性的话，总感觉缺了点什么。"
                                                                },
                                                                {
                                                                    "id": "705030236",
                                                                    "speaker": "派蒙",
                                                                    "text": "啊！等她酒醒之后，会不会气鼓鼓地威胁我们要把今天的事全部忘掉？"
                                                                },
                                                                {
                                                                    "id": "705030237",
                                                                    "speaker": "Player",
                                                                    "text": "说不定呢。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "705030222",
                                                            "text": "也会有更多的人认可优菈…"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "705030209",
                                            "text": "陪你聊聊吧。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "705030205",
                            "text": "现在才发现吗…"
                        }
                    ]
                }
            ]
        },
