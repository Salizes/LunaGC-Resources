    "talks": [
        {
            "id": "7152801",
            "objective": "对战「天崩石裂超级强者」",
            "dialogues": [
                {
                    "id": "716666001",
                    "speaker": "「超级强者的随行厨神」",
                    "text": "哟！各位好呀，最近玩得还开心吗？"
                },
                {
                    "id": "716666002",
                    "speaker": "派蒙",
                    "text": "香菱，锅巴！你们终于来了！放牛{RUBY#[D]「真剑斗虫大鬼王」}的现在可正在劲头上呢。"
                },
                {
                    "id": "716666003",
                    "speaker": "荒泷一斗",
                    "text": "总算等到这一天了！"
                },
                {
                    "id": "716666004",
                    "speaker": "荒泷一斗",
                    "text": "锅巴兄！就让你见识一下，经历了「荒泷甲光烈烈大修行」后，本大爷…哦不，是我和「赤红一杵」的实力！"
                },
                {
                    "id": "716666005",
                    "speaker": "荒泷一斗",
                    "text": "然后，就要麻烦你教教我了——如何跟「赤红一杵」，还有「水晶岛梆梆旋风」这些甲壳生物交流！"
                },
                {
                    "id": "716666006",
                    "speaker": "荒泷一斗",
                    "text": "等到我成为了斗虫界最有名望的强者，我就要…在荒泷派的鬼兜虫本阵，为你打造一座特大特威风的雕像！"
                },
                {
                    "id": "716666007",
                    "speaker": "「天崩石裂超级强者」",
                    "text": "♪~"
                },
                {
                    "id": "716666008",
                    "speaker": "荒泷一斗",
                    "text": "什么！这就是是锅巴兄自备的鬼兜虫吗…"
                },
                {
                    "id": "716666009",
                    "speaker": "派蒙",
                    "text": "质感看起来很不一般！"
                },
                {
                    "id": "716666010",
                    "speaker": "「花角玉将」",
                    "text": "不像是正常鬼兜虫的甲壳，而是某种坚韧的木质材料，难道它穿上了装甲？"
                },
                {
                    "id": "716666011",
                    "speaker": "烟绯",
                    "text": "姥姥听说了「荒泷甲光烈烈斗虫大修行」的前因后果，觉得「锅巴可能收徒」这件事很有意思…"
                },
                {
                    "id": "716666012",
                    "speaker": "烟绯",
                    "text": "正好，有位朋友给她制作了许多园艺机关，用来打理花坛里的霓裳花，名为「花羽叶月神机」。"
                },
                {
                    "id": "716666013",
                    "speaker": "「超级强者的随行厨神」",
                    "text": "「花羽叶月神机」可以化形为各种动物，自然地融入环境。松鼠、蝴蝶、团雀都不在话下，当然也包括鬼兜虫。"
                },
                {
                    "id": "716666014",
                    "speaker": "「超级强者的随行厨神」",
                    "text": "所以，师父给了锅巴一个「花羽叶月神机」，让它化形为鬼兜虫的模样，且来与你一战。"
                },
                {
                    "id": "716666015",
                    "speaker": "派蒙",
                    "text": "真的只是园艺机关而已吗？"
                },
                {
                    "id": "716666016",
                    "speaker": "派蒙",
                    "text": "香菱的师父是萍姥姥…萍姥姥的朋友…萍姥姥的朋友！",
                    "choices": [
                        {
                            "id": "716666017",
                            "text": "是谁来着？",
                            "response": [
                                {
                                    "id": "716666019",
                                    "speaker": "荒泷一斗",
                                    "text": "机关怎么可能模拟鬼兜虫的特点嘛！难道锅巴兄是想试探我们的实力，所以故意用了很弱的家伙来对阵？"
                                },
                                {
                                    "id": "716666020",
                                    "speaker": "「花角玉将」",
                                    "text": "还是小心为妙，鬼王，我好像感知不到那只机关鬼兜虫的气息…或者说，深不见底。"
                                },
                                {
                                    "id": "716666021",
                                    "speaker": "荒泷一斗",
                                    "text": "机关又不是活的，你感觉不到气势很正常。"
                                },
                                {
                                    "id": "716666022",
                                    "speaker": "荒泷一斗",
                                    "text": "呃咳，虽说锅巴兄的确强得没边，但强者也需要趁手的武器和默契的伙伴。我和「赤红一杵」的组合可不是吃素的哦！"
                                },
                                {
                                    "id": "716666023",
                                    "speaker": "荒泷一斗",
                                    "text": "开始对决吧，我会用接下来的一招一式，向锅巴兄好好证明我们的实力！"
                                },
                                {
                                    "id": "716666024",
                                    "speaker": "「天崩石裂超级强者」",
                                    "text": "♪——"
                                }
                            ]
                        },
                        {
                            "id": "716666018",
                            "text": "先别剧透…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7152802",
            "objective": "对战「天崩石裂超级强者」",
            "dialogues": []
        },
        {
            "id": "7152803",
            "objective": "与荒泷一斗一行对话",
            "dialogues": [
                {
                    "id": "715280101",
                    "speaker": "派蒙",
                    "text": "呜啊！放牛{RUBY#[D]「真剑斗虫大鬼王」}的居然这么顺利地打赢了「花羽叶月神机」！"
                },
                {
                    "id": "715280102",
                    "speaker": "荒泷一斗",
                    "text": "成功了！赢了！我和「赤红一杵」胜过了锅巴{RUBY#[D]「天崩石裂超级强者」}兄！"
                },
                {
                    "id": "715280103",
                    "speaker": "荒泷一斗",
                    "text": "接下来…嗯，咳咳！我要等不及了！"
                },
                {
                    "id": "715280104",
                    "speaker": "荒泷一斗",
                    "text": "希望锅巴兄能肯定我的实力，要教教我，怎么和甲壳生物交流…"
                },
                {
                    "id": "715280105",
                    "speaker": "锅巴",
                    "text": "♪~"
                },
                {
                    "id": "715280106",
                    "speaker": "荒泷一斗",
                    "text": "嗯？明明被我小胜一局，锅巴兄怎么好像更高兴了？"
                },
                {
                    "id": "715280107",
                    "speaker": "荒泷一斗",
                    "text": "难道说…是为我突飞猛进的实力而惊喜吗？"
                },
                {
                    "id": "715280108",
                    "speaker": "荒泷一斗",
                    "text": "这怎么好意思呢！哈哈哈哈哈哈不用这么夸我的锅巴兄！都是锅巴兄太谦虚，使用了普普通通的机关…"
                },
                {
                    "id": "715280109",
                    "speaker": "烟绯",
                    "text": "看样子，锅巴觉得热身结束了，可以启用这台「花羽叶月神机」的最大力道了。"
                },
                {
                    "id": "715280110",
                    "speaker": "香菱",
                    "text": "锅巴，我们就按照之前约定好的，把园艺机关的出力从千分之一调整到百分之一吧？"
                },
                {
                    "id": "715280111",
                    "speaker": "香菱",
                    "text": "再大的话，可能会把一斗先生的鬼兜虫直接打晕。"
                },
                {
                    "id": "715280112",
                    "speaker": "锅巴",
                    "text": "♪！"
                },
                {
                    "id": "715280113",
                    "speaker": "派蒙",
                    "text": "果然，我一点也不意外呢。",
                    "choices": [
                        {
                            "id": "715280114",
                            "text": "哎呀！千分之一！",
                            "response": [
                                {
                                    "id": "715280116",
                                    "speaker": "「花角玉将」",
                                    "text": "结果还真是深不见底…"
                                },
                                {
                                    "id": "715280117",
                                    "speaker": "荒泷一斗",
                                    "text": "等等！慢着！"
                                },
                                {
                                    "id": "715280118",
                                    "speaker": "荒泷一斗",
                                    "text": "千分之一？个十百千…千？"
                                },
                                {
                                    "id": "715280119",
                                    "speaker": "荒泷一斗",
                                    "text": "别别别开玩笑了，刚才那种级别的力量，只有…千分之一的力道？"
                                },
                                {
                                    "id": "715280120",
                                    "speaker": "锅巴",
                                    "text": "♪？"
                                },
                                {
                                    "id": "715280121",
                                    "speaker": "烟绯",
                                    "text": "锅巴有点疑惑，你不是想训练鬼兜虫，打败「水晶岛梆梆旋风」吗？"
                                },
                                {
                                    "id": "715280122",
                                    "speaker": "香菱",
                                    "text": "毕竟体型的差距摆在这里嘛，「花羽叶月神机」要搬开砂锅大小的石头，肯定需要这么多力气。"
                                },
                                {
                                    "id": "715280123",
                                    "speaker": "香菱",
                                    "text": "更别说比锅巴和我…甚至比你个子还大的「水晶岛梆梆旋风」了！"
                                },
                                {
                                    "id": "715280124",
                                    "speaker": "荒泷一斗",
                                    "text": "不可能，比刚才强两倍的对手还好说，强十倍…就已经不是输多少次才能打赢的问题了！"
                                },
                                {
                                    "id": "715280125",
                                    "speaker": "荒泷一斗",
                                    "text": "至于一千倍，简直是在做梦！"
                                },
                                {
                                    "id": "715280126",
                                    "speaker": "荒泷一斗",
                                    "text": "……"
                                },
                                {
                                    "id": "715280127",
                                    "speaker": "派蒙",
                                    "text": "#「一种战术行不通的时候，就要换个思路，我和{NICKNAME}在其他地方旅行的时候，常常灵活思考！」"
                                },
                                {
                                    "id": "715280128",
                                    "speaker": "派蒙",
                                    "text": "「只盯着一种方法做事的话，再用力也解决不了问题！」"
                                },
                                {
                                    "id": "715280129",
                                    "speaker": "荒泷一斗",
                                    "text": "锅巴兄，我明白了！"
                                },
                                {
                                    "id": "715280130",
                                    "speaker": "荒泷一斗",
                                    "text": "我要学习机关术！为「赤红一杵」打造一套装甲，让它突破自己的上限！"
                                },
                                {
                                    "id": "715280131",
                                    "speaker": "荒泷一斗",
                                    "text": "或者干脆…制造一台由「赤红一杵」驾驶的，更大的机关鬼兜虫，由我来指挥它操纵机关！"
                                },
                                {
                                    "id": "715280132",
                                    "speaker": "锅巴",
                                    "text": "？！"
                                },
                                {
                                    "id": "715280133",
                                    "speaker": "派蒙",
                                    "text": "鬼兜虫驾驶机关鬼兜虫…真的能办到这种事吗？还算是斗虫吗？",
                                    "choices": [
                                        {
                                            "id": "715280134",
                                            "text": "敢想就能做到！",
                                            "response": [
                                                {
                                                    "id": "715280136",
                                                    "speaker": "荒泷一斗",
                                                    "text": "见识到了「花羽叶月机关」的力量后，我意识到了…鬼兜虫的力量终究是有极限的！"
                                                },
                                                {
                                                    "id": "715280137",
                                                    "speaker": "荒泷一斗",
                                                    "text": "阿忍和玉将…尤其是「破空白铁小堇瓜」都提醒过我！认输很可耻，但一点都不知道变通的话，未免也太笨了！"
                                                },
                                                {
                                                    "id": "715280138",
                                                    "speaker": "荒泷一斗",
                                                    "text": "锅巴兄为我指明了一条新的道路——用机关术强化鬼兜虫！"
                                                },
                                                {
                                                    "id": "715280139",
                                                    "speaker": "荒泷一斗",
                                                    "text": "这样一来，就算有着超大的体型差距，本大爷的鬼兜虫，也不会输给那只「水晶岛梆梆旋风」！"
                                                },
                                                {
                                                    "id": "715280140",
                                                    "speaker": "锅巴",
                                                    "text": "♪♪？"
                                                },
                                                {
                                                    "id": "715280141",
                                                    "speaker": "烟绯",
                                                    "text": "唔，这方面的事，锅巴好像完全不懂？"
                                                },
                                                {
                                                    "id": "715280142",
                                                    "speaker": "香菱",
                                                    "text": "机关术这一类的东西，应该要托师父问问那位朋友，看看她乐不乐意…"
                                                },
                                                {
                                                    "id": "715280143",
                                                    "speaker": "荒泷一斗",
                                                    "text": "那就麻烦锅巴兄，厨神小姐和大恩人引荐…"
                                                },
                                                {
                                                    "id": "715280144",
                                                    "speaker": "久岐忍",
                                                    "text": "嗯哼？"
                                                },
                                                {
                                                    "id": "715280145",
                                                    "speaker": "久岐忍",
                                                    "text": "老大…你也想在璃月留学？"
                                                },
                                                {
                                                    "id": "715280146",
                                                    "speaker": "荒泷一斗",
                                                    "text": "阿忍！你什么时候来的！"
                                                },
                                                {
                                                    "id": "715280147",
                                                    "speaker": "久岐忍",
                                                    "text": "约定的时间到了，再不往港口赶过去，我们用最后的摩拉买到的船票就要报废了。"
                                                },
                                                {
                                                    "id": "715280148",
                                                    "speaker": "荒泷一斗",
                                                    "text": "你你你…你先等等！这边还在讨论很重要的事。"
                                                },
                                                {
                                                    "id": "715280149",
                                                    "speaker": "久岐忍",
                                                    "text": "我都听到了。"
                                                },
                                                {
                                                    "id": "715280150",
                                                    "speaker": "久岐忍",
                                                    "text": "你主动提出要「学」什么东西，我倒是挺欣慰的，这方面的经验，我可以直接写一本小手册给你。"
                                                },
                                                {
                                                    "id": "715280151",
                                                    "speaker": "久岐忍",
                                                    "text": "可惜在璃月留学需要资金，比荒泷派平常的开销多出许多倍的资金。这笔钱，你心里有数吗？"
                                                },
                                                {
                                                    "id": "715280152",
                                                    "speaker": "荒泷一斗",
                                                    "text": "大大大大不了…回稻妻以后，好好做一段时间的工！"
                                                },
                                                {
                                                    "id": "715280153",
                                                    "speaker": "荒泷一斗",
                                                    "text": "又不是没有打过工，挣过摩拉！我刚刚都说出那样的话了，当然做好了心理准备！只要多出点力，多少钱都挣得到！"
                                                },
                                                {
                                                    "id": "715280154",
                                                    "speaker": "荒泷一斗",
                                                    "text": "而且，我也不打算抛下你和荒泷派的兄弟们不管！一个人跑老远去钻研学问，还算个什么老大！"
                                                },
                                                {
                                                    "id": "715280155",
                                                    "speaker": "荒泷一斗",
                                                    "text": "要学就大家一起学！凑够所有人的学费，全荒泷派一起来留学，一起变强，到时候，我们就成了「天下无敌的荒泷派」！"
                                                },
                                                {
                                                    "id": "715280156",
                                                    "speaker": "久岐忍",
                                                    "text": "老大？你什么时候…学会说这种漂亮话了？"
                                                },
                                                {
                                                    "id": "715280157",
                                                    "speaker": "派蒙",
                                                    "text": "好！放牛{RUBY#[D]「真剑斗虫大鬼王」}的难得说出这种豪言壮语，你可要说到做到哦！",
                                                    "choices": [
                                                        {
                                                            "id": "715280158",
                                                            "text": "大男子汉言出必行！",
                                                            "response": [
                                                                {
                                                                    "id": "715280160",
                                                                    "speaker": "荒泷一斗",
                                                                    "text": "嘿！不过具体要做什么工，每天得挣多少钱，我还没仔细算过…"
                                                                },
                                                                {
                                                                    "id": "715280161",
                                                                    "speaker": "「花角玉将」",
                                                                    "text": "既然如此，鬼王，我就留在璃月好了。一方面可以跟着厨神姐姐，仔细询问学习机关术的事宜。"
                                                                },
                                                                {
                                                                    "id": "715280162",
                                                                    "speaker": "「花角玉将」",
                                                                    "text": "另一方面，「荒泷甲光烈烈斗虫大修行」刚刚被宣传开来，我可以考察更多斗虫强者，还有对培养鬼兜虫有益的食物。"
                                                                },
                                                                {
                                                                    "id": "715280163",
                                                                    "speaker": "「花角玉将」",
                                                                    "text": "#要是「鬼王的左膀右臂」殿下和「破空白铁小堇瓜」大人还想斗虫，或复盘，我也可以在这里陪{M#他们}{F#她们}继续玩。"
                                                                },
                                                                {
                                                                    "id": "715280164",
                                                                    "speaker": "荒泷一斗",
                                                                    "text": "好啊！正合我意，玉将！"
                                                                },
                                                                {
                                                                    "id": "715280165",
                                                                    "speaker": "荒泷一斗",
                                                                    "text": "那就按照惯例，我转告你的祖父，让他不必担心。"
                                                                },
                                                                {
                                                                    "id": "715280166",
                                                                    "speaker": "荒泷一斗",
                                                                    "text": "我很期待！下次再见面的时候，你会给我们带来什么样的惊喜！"
                                                                },
                                                                {
                                                                    "id": "715280167",
                                                                    "speaker": "香菱",
                                                                    "text": "先说好哦，我也不敢打包票，能说动那位仙人赐教…我和烟绯会尽力试试的，接下来就都看缘分了！"
                                                                },
                                                                {
                                                                    "id": "715280168",
                                                                    "speaker": "「花角玉将」",
                                                                    "text": "那位大师掌握如此之强的技艺，再高傲也没关系！重要的是，我也得替鬼王，替整个荒泷派表达诚心…"
                                                                },
                                                                {
                                                                    "id": "715280169",
                                                                    "speaker": "「花角玉将」",
                                                                    "text": "所以我必须好好考察一下，献上什么样的礼物，才能配得上制造这「花羽叶月神机」的高强本领。"
                                                                },
                                                                {
                                                                    "id": "715280170",
                                                                    "speaker": "久岐忍",
                                                                    "text": "再晚就来不及了，老大。"
                                                                },
                                                                {
                                                                    "id": "715280171",
                                                                    "speaker": "荒泷一斗",
                                                                    "text": "唉…没辙了！"
                                                                },
                                                                {
                                                                    "id": "715280172",
                                                                    "speaker": "久岐忍",
                                                                    "text": "#{NICKNAME}，派蒙，烟绯师姐，香菱小姐和锅巴先生，你们肯陪着老大举办这场斗虫大会，真是万分感谢…"
                                                                },
                                                                {
                                                                    "id": "715280173",
                                                                    "speaker": "久岐忍",
                                                                    "text": "请收下这份谢礼，希望它能在你们之后的旅途中派上用场。"
                                                                },
                                                                {
                                                                    "id": "715280174",
                                                                    "speaker": "派蒙",
                                                                    "text": "哇啊，真的准备了礼物…阿忍好细心！",
                                                                    "choices": [
                                                                        {
                                                                            "id": "715280175",
                                                                            "text": "开心开心！",
                                                                            "response": [
                                                                                {
                                                                                    "id": "715280177",
                                                                                    "speaker": "荒泷一斗",
                                                                                    "text": "是时候道别了，我的挚友，「破空白铁小堇瓜」，锅巴兄，厨神小姐还有大恩人！"
                                                                                },
                                                                                {
                                                                                    "id": "715280178",
                                                                                    "speaker": "荒泷一斗",
                                                                                    "text": "用不了多久！我们还会再见面的！"
                                                                                },
                                                                                {
                                                                                    "id": "715280179",
                                                                                    "speaker": "锅巴",
                                                                                    "text": "♪♫♩♪♬~"
                                                                                },
                                                                                {
                                                                                    "id": "715280180",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "就知道你要说这句话，放牛{RUBY#[D]「真剑斗虫大鬼王」}的！"
                                                                                },
                                                                                {
                                                                                    "id": "715280181",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "有志气是好事，不过也不要操之过急哦！还是要多听听阿忍的意见，考虑现实情况，劳逸结合！"
                                                                                },
                                                                                {
                                                                                    "id": "715280182",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "当然，我也希望——下次见面的时候，你真的能做出…超~级~大的，鬼兜虫驾驶的机关鬼兜虫！"
                                                                                },
                                                                                {
                                                                                    "id": "715280183",
                                                                                    "speaker": "「水晶岛梆梆旋风」",
                                                                                    "text": "……"
                                                                                },
                                                                                {
                                                                                    "id": "715280184",
                                                                                    "speaker": "「水晶岛梆梆旋风」",
                                                                                    "text": "？"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "715280176",
                                                                            "text": "双赢双赢！"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "715280159",
                                                            "text": "不求别人只靠自己！"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "715280135",
                                            "text": "我超相信一斗！"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "715280115",
                            "text": "哎呜！这怎么打！"
                        }
                    ]
                }
            ]
        }
    ]
