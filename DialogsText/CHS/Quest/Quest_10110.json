    "talks": [
        {
            "id": "1011001",
            "objective": "前往神像广场某处",
            "dialogues": [
                {
                    "id": "101100101",
                    "speaker": "派蒙",
                    "text": "#{NICKNAME}，看那边看那边！"
                },
                {
                    "id": "101100102",
                    "speaker": "派蒙",
                    "text": "她、她是一个人站着的吧？"
                },
                {
                    "id": "101100103",
                    "speaker": "派蒙",
                    "text": "可她明明在跟别人说话啊！你看、你看她还笑了！呜呜呜，好吓人…"
                },
                {
                    "id": "101100104",
                    "speaker": "Player",
                    "text": "我小时候也会和「幻想朋友」玩。"
                },
                {
                    "id": "101100105",
                    "speaker": "派蒙",
                    "text": "#呜哇？{NICKNAME}，你以前也会做这种事吗？！"
                },
                {
                    "id": "101100106",
                    "speaker": "派蒙",
                    "text": "难道是出现了幻觉？还是说，真的有那种看不见的朋友在陪你玩？",
                    "choices": [
                        {
                            "id": "101100107",
                            "text": "幻觉就是幻想朋友。",
                            "response": [
                                {
                                    "id": "101100108",
                                    "speaker": "派蒙",
                                    "text": "幻想朋友…"
                                },
                                {
                                    "id": "101100111",
                                    "speaker": "派蒙",
                                    "text": "哦，那就是…「想象出来的朋友」啦？"
                                },
                                {
                                    "id": "101100112",
                                    "speaker": "派蒙",
                                    "text": "你的「幻想朋友」长什么样子，给我看看！",
                                    "choices": [
                                        {
                                            "id": "101100113",
                                            "text": "现在不太出现了…",
                                            "response": [
                                                {
                                                    "id": "101100115",
                                                    "speaker": "派蒙",
                                                    "text": "哎？难道「幻想朋友」，在人长大以后就会消失吗？",
                                                    "choices": [
                                                        {
                                                            "id": "101100116",
                                                            "text": "是啊。",
                                                            "response": [
                                                                {
                                                                    "id": "101100118",
                                                                    "speaker": "派蒙",
                                                                    "text": "#唔…本来还想见识一下的…对了，你的{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTER]}也有幻想朋友吗？"
                                                                },
                                                                {
                                                                    "id": "101100119",
                                                                    "speaker": "Player",
                                                                    "text": "是有的喔。"
                                                                },
                                                                {
                                                                    "id": "101100120",
                                                                    "speaker": "派蒙",
                                                                    "text": "居然也有！这也太方便了…"
                                                                },
                                                                {
                                                                    "id": "101100121",
                                                                    "speaker": "派蒙",
                                                                    "text": "你有没有听过一种来自璃月的牌戏？一般是四个人玩，你们两个人就能玩了。"
                                                                },
                                                                {
                                                                    "id": "101100122",
                                                                    "speaker": "温迪",
                                                                    "text": "旅行者！真巧啊，你们也在这里。"
                                                                },
                                                                {
                                                                    "id": "101100123",
                                                                    "speaker": "派蒙",
                                                                    "text": "卖唱的，怎么又是你！"
                                                                },
                                                                {
                                                                    "id": "101100124",
                                                                    "speaker": "温迪",
                                                                    "text": "哈哈，是因为丽莎最近做了些有趣的东西。"
                                                                },
                                                                {
                                                                    "id": "101100125",
                                                                    "speaker": "派蒙",
                                                                    "text": "丽莎说的「有趣」，让我感觉怕怕的…"
                                                                },
                                                                {
                                                                    "id": "101100126",
                                                                    "speaker": "温迪",
                                                                    "text": "嘿，别这样评价一位淑女嘛。"
                                                                },
                                                                {
                                                                    "id": "101100127",
                                                                    "speaker": "温迪",
                                                                    "text": "为了做这件有趣的东西，她可是特地从须弥弄来了一批危险材料。"
                                                                },
                                                                {
                                                                    "id": "101100128",
                                                                    "speaker": "派蒙",
                                                                    "text": "你刚刚说「危险」了吧！",
                                                                    "choices": [
                                                                        {
                                                                            "id": "101100129",
                                                                            "text": "这是眼镜型探测仪吗？",
                                                                            "response": [
                                                                                {
                                                                                    "id": "101100130",
                                                                                    "speaker": "温迪",
                                                                                    "text": "没错，虽然长得像单片眼镜，但它是一台探测仪。"
                                                                                },
                                                                                {
                                                                                    "id": "101100133",
                                                                                    "speaker": "温迪",
                                                                                    "text": "可惜丽莎自己用不了，所以我就把它借来玩啦，顺便也帮她做做实验。"
                                                                                },
                                                                                {
                                                                                    "id": "101100134",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "咦？为什么丽莎用不了？"
                                                                                },
                                                                                {
                                                                                    "id": "101100135",
                                                                                    "speaker": "温迪",
                                                                                    "text": "这个嘛…该说是缺了一些自由自在的童心呢？还是因为别的什么原因呢？"
                                                                                },
                                                                                {
                                                                                    "id": "101100136",
                                                                                    "speaker": "温迪",
                                                                                    "text": "下次你们自己问问她就知道了。"
                                                                                },
                                                                                {
                                                                                    "id": "101100137",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "那么，温迪你能看见的吧？快告诉我，这家伙的幻想朋友长什么样！"
                                                                                },
                                                                                {
                                                                                    "id": "101100138",
                                                                                    "speaker": "温迪",
                                                                                    "text": "嗯，这个嘛…保密^_^"
                                                                                },
                                                                                {
                                                                                    "id": "101100139",
                                                                                    "speaker": "温迪",
                                                                                    "text": "总之东西已经给你了，你来试试，看诺拉的「幻想朋友」吧。"
                                                                                },
                                                                                {
                                                                                    "id": "101100140",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "怎么样怎么样？能看见吗？",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "101100141",
                                                                                            "text": "真的有！",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "101100143",
                                                                                                    "speaker": "温迪",
                                                                                                    "text": "果然，你戴上这个以后，也能看见…"
                                                                                                },
                                                                                                {
                                                                                                    "id": "101100144",
                                                                                                    "speaker": "派蒙",
                                                                                                    "text": "可恶，我也想看！——但这个探测仪的尺寸我没法戴！"
                                                                                                },
                                                                                                {
                                                                                                    "id": "101100145",
                                                                                                    "speaker": "派蒙",
                                                                                                    "text": "#{NICKNAME}，就靠你了！我们去看看<color=#00E1FFFF>其他人</color>的幻想朋友都长什么样吧。"
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "101100142",
                                                                                            "text": "是个和她很合得来的孩子。"
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "101100131",
                                                                            "text": "长得好像一副单片眼镜。",
                                                                            "response": [
                                                                                {
                                                                                    "id": "101100132",
                                                                                    "speaker": "温迪",
                                                                                    "text": "对吧？我也这么觉得。"
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "101100117",
                                                            "text": "很遗憾，但确实是这样。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "101100114",
                                            "text": "已经看不见了呢。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "101100109",
                            "text": "幻想朋友就是幻觉。",
                            "response": [
                                {
                                    "id": "101100110",
                                    "speaker": "派蒙",
                                    "text": "幻觉…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "1011002",
            "objective": "看看芙萝拉",
            "dialogues": [
                {
                    "id": "101100203",
                    "speaker": "温迪",
                    "text": "你看，那就是她的幻想朋友。嗯，一株轻飘飘的植物…是蓬蓬果。"
                },
                {
                    "id": "101100204",
                    "speaker": "派蒙",
                    "text": "幻想朋友也可以是植物吗！"
                },
                {
                    "id": "101100205",
                    "speaker": "芙萝拉",
                    "text": "呼呼，旅行者，诗人，你们好。",
                    "choices": [
                        {
                            "id": "101100206",
                            "text": "你好，可以问你一些事吗？",
                            "response": [
                                {
                                    "id": "101100208",
                                    "speaker": "芙萝拉",
                                    "text": "好啊，找芙萝拉有什么事呢？",
                                    "choices": [
                                        {
                                            "id": "101100209",
                                            "text": "你身边那个是…？",
                                            "response": [
                                                {
                                                    "id": "101100210",
                                                    "speaker": "芙萝拉",
                                                    "text": "咦？你能看到蓬蓬？别人都看不到蓬蓬的。"
                                                },
                                                {
                                                    "id": "101100211",
                                                    "speaker": "芙萝拉",
                                                    "text": "蓬蓬是我最好的朋友了，我们从小一起长大的哦！"
                                                },
                                                {
                                                    "id": "101100216",
                                                    "speaker": "派蒙",
                                                    "text": "（呃…这种只有我被排除在外的感觉…）"
                                                },
                                                {
                                                    "id": "101100217",
                                                    "speaker": "温迪",
                                                    "text": "芙萝拉，为什么你的朋友会是一株蓬蓬果呢？"
                                                },
                                                {
                                                    "id": "101100218",
                                                    "speaker": "芙萝拉",
                                                    "text": "为什么不可以呢？我一直很想跟会飞的植物做朋友。"
                                                },
                                                {
                                                    "id": "101100219",
                                                    "speaker": "派蒙",
                                                    "text": "会飞的植物？朋友？为什么？"
                                                },
                                                {
                                                    "id": "101100220",
                                                    "speaker": "芙萝拉",
                                                    "text": "呼呼，起风的时候，你和你的朋友就会飞上天空，到最远的地方去。多厉害啊。"
                                                },
                                                {
                                                    "id": "101100221",
                                                    "speaker": "派蒙",
                                                    "text": "那不就是被吹跑了吗！"
                                                },
                                                {
                                                    "id": "101100222",
                                                    "speaker": "芙萝拉",
                                                    "text": "呼呼，也有人这么说就是了…"
                                                },
                                                {
                                                    "id": "101100223",
                                                    "speaker": "芙萝拉",
                                                    "text": "我是听了别人的冒险故事，才知道世界上还有这么一种植物。"
                                                },
                                                {
                                                    "id": "101100224",
                                                    "speaker": "芙萝拉",
                                                    "text": "没记错的话，那个旅行家好像是叫做…斯坦利！",
                                                    "choices": [
                                                        {
                                                            "id": "101100225",
                                                            "text": "我也见过斯坦利。",
                                                            "response": [
                                                                {
                                                                    "id": "101100227",
                                                                    "speaker": "芙萝拉",
                                                                    "text": "斯坦利是个冒险家哟。"
                                                                },
                                                                {
                                                                    "id": "101100228",
                                                                    "speaker": "芙萝拉",
                                                                    "text": "听他讲故事，一开口就知道是老冒险家了，呼呼。"
                                                                },
                                                                {
                                                                    "id": "101100229",
                                                                    "speaker": "芙萝拉",
                                                                    "text": "「斯坦利的奇妙冒险」，在我们蒙德超级有名！"
                                                                },
                                                                {
                                                                    "id": "101100230",
                                                                    "speaker": "芙萝拉",
                                                                    "text": "他现在就在城里，你们要是想听，可以去找他哦。"
                                                                },
                                                                {
                                                                    "id": "101100231",
                                                                    "speaker": "温迪",
                                                                    "text": "真不错，我们下次会去听的，但现在，还有其它事要做…"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "101100226",
                                                            "text": "是不认识的朋友呢。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "101100212",
                                            "text": "这位是你的家人吗？",
                                            "response": [
                                                {
                                                    "id": "101100213",
                                                    "speaker": "芙萝拉",
                                                    "text": "呼呼，你说蓬蓬吗？"
                                                },
                                                {
                                                    "id": "101100214",
                                                    "speaker": "芙萝拉",
                                                    "text": "蓬蓬是我最好的朋友，和我住在一起哦。"
                                                },
                                                {
                                                    "id": "101100215",
                                                    "speaker": "芙萝拉",
                                                    "text": "蓬蓬，跟大家打个招呼吧，他们在看你。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "101100207",
                            "text": "你好，我想占用你一些时间。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1011003",
            "objective": "看看提米",
            "dialogues": [
                {
                    "id": "101100304",
                    "speaker": "派蒙",
                    "text": "什、什么！"
                },
                {
                    "id": "101100305",
                    "speaker": "温迪",
                    "text": "哦？真叫人意外。"
                },
                {
                    "id": "101100306",
                    "speaker": "派蒙",
                    "text": "这孩子的幻想朋友，竟然是遗迹守卫？！",
                    "choices": [
                        {
                            "id": "101100307",
                            "text": "不敢相信…眼睛…",
                            "response": [
                                {
                                    "id": "101100309",
                                    "speaker": "派蒙",
                                    "text": "呜呜…好可怕，会被攻击吗…"
                                },
                                {
                                    "id": "101100310",
                                    "speaker": "温迪",
                                    "text": "哈哈，要放弃和提米小朋友的交流吗？",
                                    "choices": [
                                        {
                                            "id": "101100311",
                                            "text": "派蒙，你不说那句话了吗？",
                                            "response": [
                                                {
                                                    "id": "101100313",
                                                    "speaker": "派蒙",
                                                    "text": "我？我该说什么话？"
                                                },
                                                {
                                                    "id": "101100314",
                                                    "speaker": "Player",
                                                    "text": "前面的区域，以后再来探索吧！"
                                                },
                                                {
                                                    "id": "101100315",
                                                    "speaker": "派蒙",
                                                    "text": "你是认真的吗？那好吧…"
                                                },
                                                {
                                                    "id": "101100316",
                                                    "speaker": "派蒙",
                                                    "text": "听我说——前面的区域，以后再来探索吧！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "101100312",
                                            "text": "派蒙，说你想说的话吧！"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "101100308",
                            "text": "这就是心灵上的巨人吗？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1011004",
            "objective": "看看酒馆的成年人",
            "dialogues": [
                {
                    "id": "101100404",
                    "speaker": "凯亚",
                    "text": "酒这东西，果然还是要在酒馆喝才有气氛。"
                },
                {
                    "id": "101100405",
                    "speaker": "迪卢克",
                    "text": "我看你一个人也可以喝得很开心。"
                },
                {
                    "id": "101100406",
                    "speaker": "凯亚",
                    "text": "哈哈，别说这么不近人情的话嘛。"
                },
                {
                    "id": "101100407",
                    "speaker": "迪卢克",
                    "text": "你最好别在这里喝醉。"
                },
                {
                    "id": "101100408",
                    "speaker": "凯亚",
                    "text": "嗯？难道说，喝醉会被卖给垃圾站？"
                },
                {
                    "id": "101100409",
                    "speaker": "迪卢克",
                    "text": "卖？"
                },
                {
                    "id": "101100410",
                    "speaker": "凯亚",
                    "text": "你不是常卖东西吗？父亲的旧宅也是你卖掉的。"
                },
                {
                    "id": "101100411",
                    "speaker": "迪卢克",
                    "text": "哼…没用的东西，留着干什么？"
                },
                {
                    "id": "101100412",
                    "speaker": "凯亚",
                    "text": "那么，花瓶也卖了？"
                },
                {
                    "id": "101100413",
                    "speaker": "迪卢克",
                    "text": "我没印象了。"
                },
                {
                    "id": "101100414",
                    "speaker": "冒失的帕拉德",
                    "text": "可是迪卢克老爷家里，好像确实摆着一个华丽的花瓶…"
                },
                {
                    "id": "101100415",
                    "speaker": "派蒙",
                    "text": "和你说的一样，大人们都没有幻想朋友呢…"
                },
                {
                    "id": "101100416",
                    "speaker": "温迪",
                    "text": "果然是因为缺乏童心吗？"
                },
                {
                    "id": "101100417",
                    "speaker": "Player",
                    "text": "看来每个地方的大人都差不多。"
                },
                {
                    "id": "101100418",
                    "speaker": "派蒙",
                    "text": "长大就会变成没有梦想的人吗…那我不要长大…"
                },
                {
                    "id": "101100419",
                    "speaker": "温迪",
                    "text": "这么说来，少年少女的幻想朋友，一般能维持到几岁呢？"
                },
                {
                    "id": "101100420",
                    "speaker": "温迪",
                    "text": "我们…去验证一下吧。"
                }
            ]
        },
        {
            "id": "1011005",
            "objective": "看看艾琳",
            "dialogues": [
                {
                    "id": "101100703",
                    "speaker": "派蒙",
                    "text": "是琴团长！她怎么会在这儿？"
                },
                {
                    "id": "101100704",
                    "speaker": "派蒙",
                    "text": "难道说，艾琳的幻想朋友是琴团长？",
                    "choices": [
                        {
                            "id": "101100705",
                            "text": "艾琳真是个努力的孩子啊。",
                            "response": [
                                {
                                    "id": "101100706",
                                    "speaker": "派蒙",
                                    "text": "努力成为骑士…的方向，有些奇怪呢。"
                                },
                                {
                                    "id": "101100709",
                                    "speaker": "艾琳",
                                    "text": "嗯？你们好呀，有什么事吗？"
                                },
                                {
                                    "id": "101100710",
                                    "speaker": "派蒙",
                                    "text": "你一直在这里练剑吗？"
                                },
                                {
                                    "id": "101100711",
                                    "speaker": "艾琳",
                                    "text": "是啊，今天听斯坦利先生说了他的冒险经历，太精彩了！听得我心潮澎湃。"
                                },
                                {
                                    "id": "101100712",
                                    "speaker": "艾琳",
                                    "text": "我希望自己有朝一日，也能成为斯坦利先生那样优秀的人。"
                                },
                                {
                                    "id": "101100713",
                                    "speaker": "温迪",
                                    "text": "是为了跟琴团长并肩作战吗？"
                                },
                                {
                                    "id": "101100714",
                                    "speaker": "艾琳",
                                    "text": "我、我当然是想成为骑士的啦！要是能跟琴团长一起去冒险…就更好了。"
                                },
                                {
                                    "id": "101100715",
                                    "speaker": "派蒙",
                                    "text": "艾琳真的很仰慕琴团长呢。",
                                    "choices": [
                                        {
                                            "id": "101100716",
                                            "text": "不也挺好吗？",
                                            "response": [
                                                {
                                                    "id": "101100718",
                                                    "speaker": "艾琳",
                                                    "text": "谢谢！"
                                                },
                                                {
                                                    "id": "101100719",
                                                    "speaker": "艾琳",
                                                    "text": "对了，荣誉骑士，机会难得，请陪我做一次<color=#00E1FFFF>剑术练习</color>…可以吗？"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "101100717",
                                            "text": "她一定会成功。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "101100707",
                            "text": "看来她非常想成为骑士。",
                            "response": [
                                {
                                    "id": "101100708",
                                    "speaker": "派蒙",
                                    "text": "是啊，好认真的人！我、我都吓到了…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "1011010",
            "objective": "同时摧毁所有木桩",
            "dialogues": []
        },
        {
            "id": "1011006",
            "objective": "(test)同时摧毁所有木桩$HIDDEN",
            "dialogues": []
        },
        {
            "id": "1011007",
            "objective": "(test)同时摧毁所有木桩$HIDDEN",
            "dialogues": [
                {
                    "id": "101100701",
                    "speaker": "温迪",
                    "text": "嗯，<color=#00E1FFFF>艾琳</color>如何？她这个年纪，想象力应该不至于完全消失了…"
                }
            ]
        },
        {
            "id": "1011008",
            "objective": "同时摧毁所有木桩",
            "dialogues": []
        },
        {
            "id": "1011009",
            "objective": "与艾琳对话",
            "dialogues": [
                {
                    "id": "101100901",
                    "speaker": "艾琳",
                    "text": "呼！谢谢你们，果然我还差得远呢。"
                },
                {
                    "id": "101100902",
                    "speaker": "温迪",
                    "text": "别客气嘛，艾琳也已经很厉害了。"
                },
                {
                    "id": "101100903",
                    "speaker": "艾琳",
                    "text": "我还在为练习感到疲劳，这就是不成熟的证明。但总有一天我会征服蒙德所有的木桩…"
                },
                {
                    "id": "101100904",
                    "speaker": "派蒙",
                    "text": "加油，你一定可以做到的！"
                },
                {
                    "id": "101100905",
                    "speaker": "艾琳",
                    "text": "谢谢…啊，糟了，专注练习，忘了本来要做的事！"
                },
                {
                    "id": "101100906",
                    "speaker": "艾琳",
                    "text": "呜…可我已经累得动不了了…"
                },
                {
                    "id": "101100907",
                    "speaker": "艾琳",
                    "text": "荣誉骑士，能不能帮我带个口信给杰克？",
                    "choices": [
                        {
                            "id": "101100908",
                            "text": "杰克是谁？",
                            "response": [
                                {
                                    "id": "101100909",
                                    "speaker": "艾琳",
                                    "text": "杰克是我的朋友，一位新人冒险家。"
                                },
                                {
                                    "id": "101100910",
                                    "speaker": "艾琳",
                                    "text": "原本我们约好，今晚一起讨论冒险计划…能麻烦你转告他改天见吗？"
                                },
                                {
                                    "id": "101100911",
                                    "speaker": "艾琳",
                                    "text": "我想，他今天应该是在<color=#00E1FFFF>「南风之狮的庙宇」</color>冒险吧，跟斯坦利先生一起。"
                                },
                                {
                                    "id": "101100912",
                                    "speaker": "艾琳",
                                    "text": "那是一位名震蒙德、曾经抵达「烬寂海」的传说级大冒险家。"
                                },
                                {
                                    "id": "101100917",
                                    "speaker": "Player",
                                    "text": "很久没去那里了，我也想再去看看。"
                                },
                                {
                                    "id": "101100918",
                                    "speaker": "艾琳",
                                    "text": "啊，那真是太谢谢你了！"
                                }
                            ]
                        },
                        {
                            "id": "101100913",
                            "text": "杰克在哪？",
                            "response": [
                                {
                                    "id": "101100914",
                                    "speaker": "艾琳",
                                    "text": "杰克今天跟斯坦利先生一起去<color=#00E1FFFF>「南风之狮的庙宇」</color>冒险了。"
                                },
                                {
                                    "id": "101100915",
                                    "speaker": "艾琳",
                                    "text": "那是一位名震蒙德、曾经抵达「烬寂海」的传说级大冒险家。"
                                },
                                {
                                    "id": "101100916",
                                    "speaker": "艾琳",
                                    "text": "原本我们约好，今晚一起讨论冒险计划…能麻烦你转告他改天见吗？"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}