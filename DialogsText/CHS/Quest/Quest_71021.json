            "dialogues": [
                {
                    "id": "710210101",
                    "speaker": "亨利莫顿",
                    "text": "这岛这么远，我可怎么过去啊…$UNRELEASED",
                    "choices": [
                        {
                            "id": "710210102",
                            "text": "用风之翼吧。$UNRELEASED",
                            "response": [
                                {
                                    "id": "710210103",
                                    "speaker": "亨利莫顿",
                                    "text": "算了吧，我去了教令院之后，就一年到头呆在屋内，基本上不去室外活动。$UNRELEASED"
                                },
                                {
                                    "id": "710210104",
                                    "speaker": "亨利莫顿",
                                    "text": "而且在教令院也基本用不上风之翼，我那些风之翼的操作已经全还给考官了…$UNRELEASED"
                                },
                                {
                                    "id": "710210105",
                                    "speaker": "亨利莫顿",
                                    "text": "要我用风之翼飞过去，飞一半我就要掉水里…$UNRELEASED"
                                }
                            ]
                        },
                        {
                            "id": "710210106",
                            "text": "雇船吧。$UNRELEASED",
                            "response": [
                                {
                                    "id": "710210107",
                                    "speaker": "亨利莫顿",
                                    "text": "我也这么想，我记得荆夫港那里可以雇到船，但是那里也太远了。$UNRELEASED"
                                },
                                {
                                    "id": "710210108",
                                    "speaker": "亨利莫顿",
                                    "text": "这一来一去也不知道要花多少时间…$UNRELEASED"
                                },
                                {
                                    "id": "710210109",
                                    "speaker": "亨利莫顿",
                                    "text": "但是我总不能自己造一艘吧，这教令院里也没教过啊…$UNRELEASED"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
