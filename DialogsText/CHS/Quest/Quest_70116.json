        {
            "id": "7011601",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "701160201",
                    "speaker": "拉佐列娃",
                    "text": "唉…一个人…一个人喝还是太寂寞了。"
                },
                {
                    "id": "701160202",
                    "speaker": "Player",
                    "text": "怎么了？"
                },
                {
                    "id": "701160203",
                    "speaker": "拉佐列娃",
                    "text": "呃…啊，抱歉，我知道您是好心，但是被人搭话还是让人觉得有点不安…"
                },
                {
                    "id": "701160204",
                    "speaker": "拉佐列娃",
                    "text": "唉，我，我不是很想一个人坐着，可是…如果真的有人坐在我的对面，那我非得…非得吓得逃走…"
                },
                {
                    "id": "701160205",
                    "speaker": "拉佐列娃",
                    "text": "如果有什么办法就好了…"
                }
            ]
        },
        {
            "id": "7011602",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7011603",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "701160301",
                    "speaker": "拉佐列娃",
                    "text": "啊…这样就…这样就好，真是感谢你…"
                },
                {
                    "id": "701160302",
                    "speaker": "拉佐列娃",
                    "text": "真不知道何以为报，呃…不知道这对你来说算不算报酬，刚才…刚才有个喝醉的雪精说…"
                },
                {
                    "id": "701160303",
                    "speaker": "拉佐列娃",
                    "text": "「隔壁房间，卧室的三幅画…藏有…密室…」"
                },
                {
                    "id": "701160304",
                    "speaker": "拉佐列娃",
                    "text": "好像就是那个叫阿格拉娅的雪孃特意空出来的房间吧…哼，这座公馆，还真有奇怪的秘密啊…"
                }
            ]
        },
        {
            "id": "7011604",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "701160401",
                    "speaker": "拉佐列娃",
                    "text": "「隔壁房间，卧室的三幅画…藏有…密室…」"
                },
                {
                    "id": "701160402",
                    "speaker": "拉佐列娃",
                    "text": "到底是什么意思呢…"
                }
            ]
        }
    ]
