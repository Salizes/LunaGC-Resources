    "talks": [
        {
            "id": "7052801",
            "objective": "前往蒙德城侧门，寻找卜劳恩",
            "dialogues": []
        },
        {
            "id": "7052802",
            "objective": "与卜劳恩对话",
            "dialogues": [
                {
                    "id": "705280401",
                    "speaker": "卜劳恩",
                    "text": "协会到底忙不忙得过来，唉…"
                },
                {
                    "id": "705280402",
                    "speaker": "卜劳恩",
                    "text": "旅行者！不好意思，我刚才在想一些协会里的事务，走了一会神…"
                },
                {
                    "id": "705280403",
                    "speaker": "卜劳恩",
                    "text": "你来蒙德城，应该是来参加风花节的吧。"
                },
                {
                    "id": "705280404",
                    "speaker": "卜劳恩",
                    "text": "我们冒险家协会正好推出了一个小游戏，保证轻松有趣，参与就有奖励！"
                },
                {
                    "id": "705280405",
                    "speaker": "卜劳恩",
                    "text": "怎么样，你要不要来试试看啊？"
                },
                {
                    "id": "705280406",
                    "speaker": "卜劳恩",
                    "text": "我先为你介绍一下这个小游戏。协会里设计这个游戏的人，把它取名叫做「逐花棋」。"
                },
                {
                    "id": "705280407",
                    "speaker": "卜劳恩",
                    "text": "他说自己的灵感是来自于飘飞的花瓣，还有追逐着花瓣的风…"
                },
                {
                    "id": "705280408",
                    "speaker": "卜劳恩",
                    "text": "整个游戏的感觉，也是想要模拟那种追逐花瓣的…浪漫感…",
                    "choices": [
                        {
                            "id": "705280409",
                            "text": "挺，挺有故事性…",
                            "response": [
                                {
                                    "id": "705280411",
                                    "speaker": "卜劳恩",
                                    "text": "这老兄是个吟游诗人…比较富有那个…想象力…"
                                },
                                {
                                    "id": "705280412",
                                    "speaker": "卜劳恩",
                                    "text": "简单来说，玩这种棋的时候，玩家需要去尽可能多地搜集棋盘内分布的「风花球」。"
                                },
                                {
                                    "id": "705280413",
                                    "speaker": "卜劳恩",
                                    "text": "在搜集的同时，还要规避各种阻碍…当然啦，棋盘里还有各种辅助性的道具…"
                                },
                                {
                                    "id": "705280414",
                                    "speaker": "卜劳恩",
                                    "text": "那位老兄可是专门写了一整本详细的游玩手册，等会你可以看看。"
                                },
                                {
                                    "id": "705280415",
                                    "speaker": "卜劳恩",
                                    "text": "如果有兴趣的话，欢迎你来试玩啊，参与就有奖励！"
                                }
                            ]
                        },
                        {
                            "id": "705280410",
                            "text": "这，这么复杂吗…"
                        }
                    ]
                }
            ]
        }
    ]
}