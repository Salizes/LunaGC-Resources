    },
    "talks": [
        {
            "id": "7300901",
            "objective": "",
            "dialogues": [
                {
                    "id": "730090101",
                    "speaker": "兰拉娜",
                    "text": "兰拉娜会照顾她。因为她是最重要的朋友。"
                },
                {
                    "id": "730090102",
                    "speaker": "兰拉娜",
                    "text": "#那菈{NICKNAME}，请你去「桓那兰那」，唱响「大梦的曲调」。然后，请他们帮忙准备「惟耶之实」。",
                    "choices": [
                        {
                            "id": "730090103",
                            "text": "听不懂…",
                            "response": [
                                {
                                    "id": "730090106",
                                    "speaker": "兰拉娜",
                                    "text": "就像云朵会明白要降下雨滴，雨水会明白要落入土地。种子会明白要茁壮成长，变成大树，结出饱满的果实。"
                                }
                            ]
                        },
                        {
                            "id": "730090104",
                            "text": "我、我知道了…",
                            "response": [
                                {
                                    "id": "730090105",
                                    "speaker": "兰拉娜",
                                    "text": "#那菈{NICKNAME}，看起来没有明白，但是没有关系。在正确的时候，那菈{NICKNAME}会明白应该做什么。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7300902",
            "objective": "",
            "dialogues": [
                {
                    "id": "730090201",
                    "speaker": "拉娜",
                    "text": "……",
                    "choices": [
                        {
                            "id": "730090202",
                            "text": "（要早点让拉娜恢复…）"
                        },
                        {
                            "id": "730090203",
                            "text": "（悄悄离开吧。）"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7300903",
            "objective": "",
            "dialogues": [
                {
                    "id": "730090301",
                    "speaker": "拉娜",
                    "text": "（拉娜依旧沉睡着。兰拉娜并不在周围。）"
                },
                {
                    "id": "730090302",
                    "speaker": "拉娜",
                    "text": "（从包裹拉娜的「气泡」当中隐约有什么景象浮现出来…）",
                    "choices": [
                        {
                            "id": "730090303",
                            "text": "（沉浸到景象中去…）",
                            "response": [
                                {
                                    "id": "730090304",
                                    "speaker": "Black Screen",
                                    "text": "你身处丛林当中，一切都是无比巨大，又无比幽深。但你在其中十分自在。\\n偶然透过树叶洒落的阳光如同金箔一般闪闪发亮，如同你一般高的野草低声地嬉笑着，在你走过时轻轻触碰你的手。"
                                },
                                {
                                    "id": "730090305",
                                    "speaker": "Black Screen",
                                    "text": "聆听风中树木的哼唱与流水的奏乐时，你注意到了不安的哭声。循着声音，你找到了一个小小的人儿。\\n似乎是因为哭得累了，她趴在草甸中睡着了。你走到她的身边，轻轻唱起了能令生灵平静的歌…"
                                },
                                {
                                    "id": "730090306",
                                    "speaker": "拉娜",
                                    "text": "（…拉娜的状况似乎没有恶化。）"
                                }
                            ]
                        },
                        {
                            "id": "730090307",
                            "text": "（静静离开吧。）"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7300904",
            "objective": "",
            "dialogues": [
                {
                    "id": "730090401",
                    "speaker": "拉娜",
                    "text": "（拉娜依旧沉睡着。既然有兰拉娜的兰迦拉梨，应该没什么问题吧。）"
                }
            ]
        },
        {
            "id": "7300905",
            "objective": "",
            "dialogues": [
                {
                    "id": "730090501",
                    "speaker": "兰拉迦",
                    "text": "#哦哦。是那菈{NICKNAME}。有什么事需要老身解答的吗？"
                }
            ]
        },
        {
            "id": "7300906",
            "objective": "",
            "dialogues": [
                {
                    "id": "730090601",
                    "speaker": "Player",
                    "text": "有没有什么需要帮忙的？"
                },
                {
                    "id": "730090602",
                    "speaker": "兰拉迦",
                    "text": "#哦哦，谢谢你，那菈{NICKNAME}。如你所见，老身相当自在。"
                }
            ]
        },
        {
            "id": "7300907",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "730090701",
                    "speaker": "Player",
                    "text": "有没有为什么事情发愁的兰那罗？"
                },
                {
                    "id": "730090702",
                    "speaker": "兰拉迦",
                    "text": "这个嘛…到桓那兰那的中心去，应该能遇到兰帕卡提。最近好像是在为什么事情发愁。"
                }
            ]
        },
        {
            "id": "7300908",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "730090801",
                    "speaker": "Player",
                    "text": "要准备无忧节，还有什么要做的？"
                },
                {
                    "id": "730090802",
                    "speaker": "兰拉迦",
                    "text": "说到这个，兰加惟应该在桓那兰那的中心。既然要办无忧节，他应该也有需要帮忙的事情。"
                }
            ]
        },
        {
            "id": "7300909",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "730090901",
                    "speaker": "Player",
                    "text": "关于「无留陀」…"
                },
                {
                    "id": "730090902",
                    "speaker": "兰拉迦",
                    "text": "那是很久以前的故事了…"
                },
                {
                    "id": "730090903",
                    "speaker": "兰拉迦",
                    "text": "在过去，兰那罗行走在大地上，和那菈及万物为友，而林中也没有无留陀。直到在很多很多个月亮以前的一次灾难…"
                },
                {
                    "id": "730090904",
                    "speaker": "兰拉迦",
                    "text": "树王归还了沙恒，无留陀开始在地上肆虐。而丛林终于恢复生机后，兰那罗为了保护自己，将真正的桓那兰那藏在了梦中。"
                },
                {
                    "id": "730090905",
                    "speaker": "兰拉迦",
                    "text": "森林本不知死为何物。直到有一天，树想起大地中充满了凋败的花、死去的兽。"
                },
                {
                    "id": "730090906",
                    "speaker": "兰拉迦",
                    "text": "正如在同一天，大地想起自己曾经或将要吞食漆黑的毒血。河流想到太阳降下，蒸发了所有水的红色的世界。"
                },
                {
                    "id": "730090907",
                    "speaker": "兰拉迦",
                    "text": "他们明白了，万物都将无可避免地死去。这时，「无留陀」就诞生了。此乃「死」之名，知晓它存在的，终究会死去。"
                },
                {
                    "id": "730090908",
                    "speaker": "兰拉迦",
                    "text": "无留陀的力量就是令一切走向死。而高大、阴暗、扭曲的东西就是无留陀选中的化身，带来死的使徒。"
                },
                {
                    "id": "730090909",
                    "speaker": "兰拉迦",
                    "text": "当然了，在老身的故事中，无留陀的化身形态是不定的。也许是走兽。也许是飞鸟。也许是那菈。也许是疫病…"
                },
                {
                    "id": "730090910",
                    "speaker": "兰拉迦",
                    "text": "但故事究竟是故事，那已经不是老身的记忆了。"
                }
            ]
        },
        {
            "id": "7300910",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "730091001",
                    "speaker": "Player",
                    "text": "关于「恒素果」…"
                },
                {
                    "id": "730091002",
                    "speaker": "兰拉迦",
                    "text": "那是充满了力量的果实。它汲取大地中的记忆与梦生长，再经兰那罗与那菈的努力才能结出。"
                },
                {
                    "id": "730091003",
                    "speaker": "兰拉迦",
                    "text": "以恒素果的力量供养「觉王之树」，就能结出惟耶之实。那是树王亲自种下的伟大之树，也是兰那罗一族的原点。"
                }
            ]
        },
        {
            "id": "7300911",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "730091101",
                    "speaker": "Player",
                    "text": "关于「森林书」…"
                },
                {
                    "id": "730091102",
                    "speaker": "兰拉迦",
                    "text": "#那是那菈法留纳留下的东西。{M#她}{F#他}是一个金灿灿的那菈，与你一样善良、勇敢、正直。"
                },
                {
                    "id": "730091103",
                    "speaker": "兰拉迦",
                    "text": "#还记得那个时期的兰那罗，都十分想念{M#她}{F#他}，也热爱{M#她}{F#他}的故事。但老身相信，既然如今有了那菈{NICKNAME}…"
                }
            ]
        },
        {
            "id": "7300912",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "730091201",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "730091202",
                    "speaker": "兰拉迦",
                    "text": "嗯。老身很期待和你们一起度过无忧节哪。"
                }
            ]
        },
        {
            "id": "7300913",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "730091301",
                    "speaker": "兰拉迦",
                    "text": "#老身能过上无忧节，都是托了那菈{NICKNAME}和派蒙的福。谢谢你们。"
                },
                {
                    "id": "730091302",
                    "speaker": "兰拉迦",
                    "text": "老身很遗憾，无法像兰罗摩他们那样，和你一起在外面冒险，也不能帮助你们。"
                },
                {
                    "id": "730091303",
                    "speaker": "兰拉迦",
                    "text": "但是，这个梦永远欢迎你们。如果对外面的世界感觉累了，就到桓那兰那来吧。"
                }
            ]
        },
        {
