        {
            "id": "2070230",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "207023001",
                    "speaker": "斯万",
                    "text": "最后一个问题。"
                },
                {
                    "id": "207023002",
                    "speaker": "斯万",
                    "text": "您应该已经见过安柏小姐了，哈哈哈，她的热情应该给您留下了很深的印象吧。"
                },
                {
                    "id": "207023003",
                    "speaker": "斯万",
                    "text": "那么，我的问题是，安柏小姐作为西风骑士团的一员，她的正式职务名称是？"
                }
            ]
        },
        {
            "id": "2070231",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "207023101",
                    "speaker": "Player",
                    "text": "飞行冠军。"
