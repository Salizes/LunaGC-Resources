    "talks": [
        {
            "id": "7051401",
            "objective": "与菲利斯·尤格对话",
            "dialogues": [
                {
                    "id": "705140101",
                    "speaker": "菲利斯·尤格",
                    "text": "蒙德的热情真是超乎我想象…真是名不虚传，就连那些丘丘人也这么有活力。"
                },
                {
                    "id": "705140102",
                    "speaker": "斯万",
                    "text": "无论如何…尤格先生，请您千万不要再自己外出了。"
                },
                {
                    "id": "705140103",
                    "speaker": "菲利斯·尤格",
                    "text": "什么？那我的机关怎么办，还差…呃…"
                },
                {
                    "id": "705140104",
                    "speaker": "菲利斯·尤格",
                    "text": "一、二、三…十八个…十九个部件啊！"
                },
                {
                    "id": "705140105",
                    "speaker": "斯万",
                    "text": "已经有冒险家在帮您找了，您就安安心心在城里等着吧…"
                },
                {
                    "id": "705140106",
                    "speaker": "菲利斯·尤格",
                    "text": "但没有那些机关，我的…我的灵感，你知道吗？我的灵感来了怎么办？"
                },
                {
                    "id": "705140107",
                    "speaker": "菲利斯·尤格",
                    "text": "灵感稍纵即逝啊，就像…就像喝完酒打出的嗝一样，稍纵即逝啊！"
                },
                {
                    "id": "705140108",
                    "speaker": "菲利斯·尤格",
                    "text": "喔，这个比喻不错，我得记下来，泽维尔一定会喜欢的…"
                },
                {
                    "id": "705140109",
                    "speaker": "斯万",
                    "text": "我…您…"
                },
                {
                    "id": "705140110",
                    "speaker": "斯万",
                    "text": "咦？荣誉骑士…太好了，荣誉骑士！请您快些过来！",
                    "choices": [
                        {
                            "id": "705140111",
                            "text": "怎么了？",
                            "response": [
                                {
                                    "id": "705140113",
                                    "speaker": "斯万",
                                    "text": "我介绍一下，这位是来自枫丹廷的…"
                                },
                                {
                                    "id": "705140114",
                                    "speaker": "菲利斯·尤格",
                                    "text": "空想家！我们这么称呼自己！"
                                },
                                {
                                    "id": "705140115",
                                    "speaker": "斯万",
                                    "text": "…尤格先生，这位是我们蒙德城的荣誉骑士…"
                                },
                                {
                                    "id": "705140116",
                                    "speaker": "菲利斯·尤格",
                                    "text": "啊哈！尤格，菲利斯·尤格！向您致敬，荣誉骑士！我早就听闻过您的诸多事迹了。"
                                },
                                {
                                    "id": "705140117",
                                    "speaker": "Player",
                                    "text": "你认识我？"
                                },
                                {
                                    "id": "705140118",
                                    "speaker": "菲利斯·尤格",
                                    "text": "当然，当然！我当然认识您了，谁能不认识您呀？"
                                },
                                {
                                    "id": "705140119",
                                    "speaker": "菲利斯·尤格",
                                    "text": "您之前在蒙德和风龙战斗的那段事迹，可是在《蒸汽鸟日报》的头条上占了足足三周啊。"
                                },
                                {
                                    "id": "705140120",
                                    "speaker": "菲利斯·尤格",
                                    "text": "哈哈哈，那帮记者如果知道我正在和您谈话，一定会嫉妒到睡不着的。"
                                },
                                {
                                    "id": "705140121",
                                    "speaker": "Player",
                                    "text": "《蒸汽鸟日报》是什么？"
                                },
                                {
                                    "id": "705140122",
                                    "speaker": "菲利斯·尤格",
                                    "text": "您不知道吗？《蒸汽鸟日报》是枫丹廷的一家…嗯…知名度颇高的报纸。"
                                },
                                {
                                    "id": "705140123",
                                    "speaker": "菲利斯·尤格",
                                    "text": "而您，曾经帮他们攀上了销量最高点。"
                                },
                                {
                                    "id": "705140125",
                                    "speaker": "Player",
                                    "text": "头、头条？"
                                },
                                {
                                    "id": "705140126",
                                    "speaker": "菲利斯·尤格",
                                    "text": "那当然，您可是曾经帮他们攀上了销量最高点啊。"
                                },
                                {
                                    "id": "705140127",
                                    "speaker": "菲利斯·尤格",
                                    "text": "头版头条，整刊篇幅，专家访谈，还搭配最好的手绘插图，哈！他们都赚疯了！"
                                },
                                {
                                    "id": "705140128",
                                    "speaker": "斯万",
                                    "text": "那…旅行者，菲利斯·尤格先生，你们先聊着，我…呃…我先去处理点别的事，先失陪了。"
                                },
                                {
                                    "id": "705140129",
                                    "speaker": "Black Screen",
                                    "text": "斯万飞快地离开了…"
                                },
                                {
                                    "id": "705140130",
                                    "speaker": "菲利斯·尤格",
                                    "text": "好吧，看来西风骑士团和我听说的一样，有着处理不完的事务…"
                                },
                                {
                                    "id": "705140131",
                                    "speaker": "Player",
                                    "text": "所以，你为什么会来蒙德？"
                                },
                                {
                                    "id": "705140132",
                                    "speaker": "菲利斯·尤格",
                                    "text": "我？事实上，我正计划着游历提瓦特。"
                                },
                                {
                                    "id": "705140133",
                                    "speaker": "菲利斯·尤格",
                                    "text": "而我游历的目的，则是要推销我制造的这种「动械核心」。"
                                },
                                {
                                    "id": "705140134",
                                    "speaker": "菲利斯·尤格",
                                    "text": "简单来说，它是一种发条式机关，只要隔段时间扭一扭发条，这种核心就能提供很长时间的动能。"
                                },
                                {
                                    "id": "705140135",
                                    "speaker": "菲利斯·尤格",
                                    "text": "为了展示这种机关，我还专门制作了一种以「动械核心」驱动的恒动型机关玩具，我将它命名为「恒动械画」。"
                                },
                                {
                                    "id": "705140136",
                                    "speaker": "菲利斯·尤格",
                                    "text": "呃…不过很遗憾，虽然我很想向您展示这种机关…"
                                },
                                {
                                    "id": "705140137",
                                    "speaker": "菲利斯·尤格",
                                    "text": "但这种机关实在是太出色，就连那些魔物也难抵它的魅力。"
                                },
                                {
                                    "id": "705140138",
                                    "speaker": "菲利斯·尤格",
                                    "text": "目前…我的机关正被魔物们不那么友好地分成了无数块，拿在手里细细把玩呢…"
                                },
                                {
                                    "id": "705140139",
                                    "speaker": "菲利斯·尤格",
                                    "text": "虽然我已经拜托了冒险家协会帮忙，但冒险家们也一直也没给我点消息…"
                                },
                                {
                                    "id": "705140140",
                                    "speaker": "菲利斯·尤格",
                                    "text": "荣誉骑士，如果您有兴趣的话，能不能帮我这个忙？"
                                },
                                {
                                    "id": "705140141",
                                    "speaker": "菲利斯·尤格",
                                    "text": "相信我，我的机关…和报酬，绝不会让您失望的！"
                                },
                                {
                                    "id": "705140142",
                                    "speaker": "Player",
                                    "text": "交给我吧。"
                                },
                                {
                                    "id": "705140143",
                                    "speaker": "菲利斯·尤格",
                                    "text": "太棒了，您果然和报纸上写的一样，既是个实力强大的冒险家，又富有同情心。"
                                },
                                {
                                    "id": "705140144",
                                    "speaker": "菲利斯·尤格",
                                    "text": "可惜现在咱们在蒙德，如果在枫丹廷，我一定要把《蒸汽鸟日报》的记者领到您这来，给您做个专访。"
                                },
                                {
                                    "id": "705140145",
                                    "speaker": "菲利斯·尤格",
                                    "text": "他们一定会再次被您的魅力折服，心甘情愿地把接下来三周的头版和稿酬都留给您！"
                                }
                            ]
                        },
                        {
                            "id": "705140112",
                            "text": "发生什么了吗？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7051402",
            "objective": "回收零件",
            "dialogues": []
        },
        {
            "id": "7051403",
            "objective": "与菲利斯·尤格对话",
            "dialogues": [
                {
                    "id": "705140301",
                    "speaker": "菲利斯·尤格",
                    "text": "荣誉骑士！您回来了，零件的事怎么样了？"
                },
                {
                    "id": "705140302",
                    "speaker": "Player",
                    "text": "是这些吗？"
                }
            ]
        },
        {
            "id": "7051404",
            "objective": "与菲利斯·尤格对话",
            "dialogues": [
                {
                    "id": "705140401",
                    "speaker": "菲利斯·尤格",
                    "text": "就是这些！就是这些！太棒了，我的零件，天呐！"
                },
                {
                    "id": "705140402",
                    "speaker": "菲利斯·尤格",
                    "text": "既然零件已经找齐了，那接下来只要把这些零件组合起来就好…"
                },
                {
                    "id": "705140403",
                    "speaker": "菲利斯·尤格",
                    "text": "唔…荣誉骑士，如果您有兴趣的话，也可以来试试拼接这幅「恒动械画」部件。"
                },
                {
                    "id": "705140404",
                    "speaker": "菲利斯·尤格",
                    "text": "相信我，这一定会很有趣的。"
                }
            ]
        },
        {
            "id": "7051405",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "705140501",
                    "speaker": "菲利斯·尤格",
                    "text": "#那么零件的事就拜托您了，荣誉骑士{M#先生}{F#小姐}。"
                }
            ]
        }
    ]
}