    "talks": [
        {
            "id": "7467401",
            "objective": "与乌尔曼对话",
            "dialogues": [
                {
                    "id": "746740101",
                    "speaker": "乌尔曼",
                    "text": "古铁钱…古铁钱…不错，非常不错！"
                },
                {
                    "id": "746740102",
                    "speaker": "乌尔曼",
                    "text": "#这么多古铁钱，肯定够我赚一笔小钱，多谢你们了啊，{NICKNAME}，还有派蒙。"
                },
                {
                    "id": "746740103",
                    "speaker": "Player",
                    "text": "你接下来准备做什么？"
                },
                {
                    "id": "746740104",
                    "speaker": "乌尔曼",
                    "text": "当然是…想想怎么把这些古铁钱换成一些摩拉，或者是其他方便日常使用的东西。"
                },
                {
                    "id": "746740105",
                    "speaker": "乌尔曼",
                    "text": "说真的，我真不想和之前那个中间人再做纠缠了，他每次的抽成都高的吓人。"
                },
                {
                    "id": "746740106",
                    "speaker": "乌尔曼",
                    "text": "而且，钱到我手里的时间也非常晚，真不知道他在做什么…"
                },
                {
                    "id": "746740107",
                    "speaker": "乌尔曼",
                    "text": "不过…我现在除了他之外，也根本找不到其他靠谱的人合作，唉…"
                },
                {
                    "id": "746740108",
                    "speaker": "乌尔曼",
                    "text": "不说这些了！这些东西给你们，算是咱们长期合作的额外雇佣金吧。"
                },
                {
                    "id": "746740109",
                    "speaker": "乌尔曼",
                    "text": "等枫丹的生意结束，我也要想想下一步怎么走了。总不能继续旅行吧…那也太累了…"
                }
            ]
        }
    ]
}