    "talks": [
        {
            "id": "4005401",
            "objective": "与稻妻的凯瑟琳谈谈",
            "dialogues": [
                {
                    "id": "400540101",
                    "speaker": "派蒙",
                    "text": "凯瑟琳，听说有新委托需要我们出马啦？"
                },
                {
                    "id": "400540102",
                    "speaker": "凯瑟琳",
                    "text": "没错，这里现在有一项委托人「指名」的工作要交给你们。"
                },
                {
                    "id": "400540103",
                    "speaker": "派蒙",
                    "text": "「指名」？听起来还有点紧张，是和什么有关的工作呀？"
                },
                {
                    "id": "400540104",
                    "speaker": "凯瑟琳",
                    "text": "呵呵，请放心吧，这次的工作并不危险。二位或许已经有所耳闻，近期，稻妻将举办一场名为「光华容彩祭」的盛大祭典。"
                },
                {
                    "id": "400540105",
                    "speaker": "派蒙",
                    "text": "好耶，是祭典！说起来，我们之前还没在稻妻参加过节日呢。"
                },
                {
                    "id": "400540106",
                    "speaker": "凯瑟琳",
                    "text": "此次祭典由社奉行与八重神子大人筹备，请求二位进行协助的，正是八重大人。"
                },
                {
                    "id": "400540107",
                    "speaker": "Player",
                    "text": "原来是神子。"
                },
                {
                    "id": "400540108",
                    "speaker": "派蒙",
                    "text": "嘻嘻，神子的脑袋里有许多稀奇古怪的主意，办祭典一定会很有意思的。"
                },
                {
                    "id": "400540109",
                    "speaker": "派蒙",
                    "text": "我们不如这就去鸣神大社找她，看看她到底想给我们什么任务吧。"
                },
                {
                    "id": "400540110",
                    "speaker": "凯瑟琳",
                    "text": "二位不必跑那么远，八重大人现在就在花见坂的八重堂。她之前交代过，让我请你们到那里与她会合。"
                },
                {
                    "id": "400540111",
                    "speaker": "派蒙",
                    "text": "原来她就在附近，那我们走吧。"
                }
            ]
        },
        {
            "id": "4005402",
            "objective": "前往八重堂找八重神子",
            "dialogues": [
                {
                    "id": "400540201",
                    "speaker": "八重神子",
                    "text": "荒谷，黑田，你们那边情况如何？"
                },
                {
                    "id": "400540202",
                    "speaker": "荒谷",
                    "text": "报告八重大人，八重堂的书籍与个人委托印刷物，昨天下午已经全部装订完毕发出了。"
                },
                {
                    "id": "400540203",
                    "speaker": "八重神子",
                    "text": "嗯，不错。村田呢？"
                },
                {
                    "id": "400540204",
                    "speaker": "村田",
                    "text": "天顶屋与远航之风发来了联络，《转生成为雷电将军，然后天下无敌》与《拜托了我的狐仙宫司》的相关物料都已经就位！"
                },
                {
                    "id": "400540205",
                    "speaker": "八重神子",
                    "text": "很好。小野寺？"
                },
                {
                    "id": "400540206",
                    "speaker": "小野寺",
                    "text": "……"
                },
                {
                    "id": "400540207",
                    "speaker": "八重神子",
                    "text": "小、野、寺？"
                },
                {
                    "id": "400540208",
                    "speaker": "小野寺",
                    "text": "啊，在…我在！报告八重大人，新刊发售会的准备一切正常！"
                },
                {
                    "id": "400540209",
                    "speaker": "八重神子",
                    "text": "小野寺，这次发售会的企划是你提出的，换言之你就是我们的「大将」，你可要拿出点自信来啊。"
                },
                {
                    "id": "400540210",
                    "speaker": "八重神子",
                    "text": "放心吧，这个企划一定能大获成功，我可是非常看好它的。"
                },
                {
                    "id": "400540211",
                    "speaker": "八重神子",
                    "text": "这两天我特批你假期，你就抓紧时间好好休息一下吧，毕竟发售会当天可有你忙的。"
                },
                {
                    "id": "400540212",
                    "speaker": "小野寺",
                    "text": "八重大人，非常感谢…"
                },
                {
                    "id": "400540213",
                    "speaker": "八重神子",
                    "text": "好了，大家都清楚自己的任务了吧。时间紧急，立刻行动起来，解散！"
                },
                {
                    "id": "400540215",
                    "speaker": "八重神子",
                    "text": "你们好啊，小家伙们，看样子是已经接到我的委托咯？"
                },
                {
                    "id": "400540216",
                    "speaker": "派蒙",
                    "text": "好你个神子，都要举办祭典了你也不回鸣神大社，竟然还有功夫在这儿折腾你的轻小说事业。"
                },
                {
                    "id": "400540217",
                    "speaker": "派蒙",
                    "text": "你找我们来，该不会是想把筹备祭典的事扔给我们代劳吧？哼，这种委托我是不会接的！"
                },
                {
                    "id": "400540218",
                    "speaker": "Player",
                    "text": "对，不会接的！"
                },
                {
                    "id": "400540219",
                    "speaker": "八重神子",
                    "text": "哎呀呀，我真是好伤心啊，明明人家就正在为祭典的事操劳，却被你们当成了不务正业。"
                },
                {
                    "id": "400540220",
                    "speaker": "八重神子",
                    "text": "小家伙们，是谁告诉你们，祭典就一定会和鸣神大社有关呢？"
                },
                {
                    "id": "400540221",
                    "speaker": "派蒙",
                    "text": "咦，难道不是这样吗？毕竟这里可是稻妻呀。"
                },
                {
                    "id": "400540222",
                    "speaker": "八重神子",
                    "text": "虽说这话是没错，不过现在，解除锁国令的稻妻，已经不是从前那个渴望一成不变的国度了。"
                },
                {
                    "id": "400540223",
                    "speaker": "八重神子",
                    "text": "所以，比起循规蹈矩的传统祭典，这次我与社奉行决定另辟蹊径，打造一场既有稻妻风格，又与众不同的国际化文化盛会。",
                    "choices": [
                        {
                            "id": "400540224",
                            "text": "国际化的…",
                            "response": [
                                {
                                    "id": "400540226",
                                    "speaker": "八重神子",
                                    "text": "呵呵，这件事就要从容彩祭的来历说起了。"
                                },
                                {
                                    "id": "400540227",
                                    "speaker": "八重神子",
                                    "text": "传说在古代稻妻，曾经活跃着五位能歌善赋的诗人，世人称他们为「五歌仙」。"
                                },
                                {
                                    "id": "400540228",
                                    "speaker": "八重神子",
                                    "text": "每年，五歌仙都会派出其中一位，将五人所作的诗集呈给将军品鉴，此事一时传为雅谈。"
                                },
                                {
                                    "id": "400540229",
                                    "speaker": "八重神子",
                                    "text": "托他们的福，稻妻的文化也在当时极为繁荣。"
                                },
                                {
                                    "id": "400540230",
                                    "speaker": "八重神子",
                                    "text": "后来人们以他们为原型，创作了许多风格各异的五歌仙故事，还发展出了「容彩祭」，感谢创作为我们的生活增添乐趣。"
                                },
                                {
                                    "id": "400540231",
                                    "speaker": "派蒙",
                                    "text": "果然是个文化气息浓郁的节日呢。"
                                },
                                {
                                    "id": "400540232",
                                    "speaker": "八重神子",
                                    "text": "嗯，用古话讲就是「风雅」吧。只可惜随着时间流逝，五歌仙与这一祭典已经逐渐被人们淡忘了。"
                                },
                                {
                                    "id": "400540233",
                                    "speaker": "八重神子",
                                    "text": "所以这次，我决心重振容彩祭——"
                                },
                                {
                                    "id": "400540234",
                                    "speaker": "八重神子",
                                    "text": "举办一场以轻小说创作为核心的文化交流展！"
                                },
                                {
                                    "id": "400540235",
                                    "speaker": "派蒙",
                                    "text": "欸，等一下…轻小说？！"
                                },
                                {
                                    "id": "400540236",
                                    "speaker": "Player",
                                    "text": "说好的「风雅」呢？"
                                },
                                {
                                    "id": "400540237",
                                    "speaker": "八重神子",
                                    "text": "不要露出这种难以置信的表情。在古代，诗歌也是一种流行的载体，只不过在今天，这种流行变成了「轻小说」而已。"
                                },
                                {
                                    "id": "400540238",
                                    "speaker": "八重神子",
                                    "text": "重要的不是形式，而是「创作」本身。如果一味盯着过去，拘泥于固定的形式或内容，可是写不出好作品的。"
                                },
                                {
                                    "id": "400540239",
                                    "speaker": "八重神子",
                                    "text": "说起来，你不觉得「关注当下」这个内核也很符合现在的稻妻吗？"
                                },
                                {
                                    "id": "400540240",
                                    "speaker": "八重神子",
                                    "text": "而且还能借此机会，让提瓦特通过轻小说重新认识稻妻，可谓一举两得。",
                                    "choices": [
                                        {
                                            "id": "400540241",
                                            "text": "这大概就是…",
                                            "response": [
                                                {
                                                    "id": "400540243",
                                                    "speaker": "派蒙",
                                                    "text": "呜哇，好险…要不是你提醒，我就要被神子绕进去了！"
                                                },
                                                {
                                                    "id": "400540244",
                                                    "speaker": "派蒙",
                                                    "text": "哼，神子，你可骗不了我们，凭我们对你的了解，这绝对是你基于个人趣味做出的决定！"
                                                },
                                                {
                                                    "id": "400540245",
                                                    "speaker": "八重神子",
                                                    "text": "呵呵，我从不否认自己的爱好。不过，无论小说还是祭典，以新颖的概念抓人眼球都是必须的。"
                                                },
                                                {
                                                    "id": "400540246",
                                                    "speaker": "八重神子",
                                                    "text": "怎么样，你们就不好奇，在容彩祭上能见到什么有趣的东西吗？"
                                                },
                                                {
                                                    "id": "400540247",
                                                    "speaker": "派蒙",
                                                    "text": "唔…好奇！老实说非常好奇！"
                                                },
                                                {
                                                    "id": "400540248",
                                                    "speaker": "八重神子",
                                                    "text": "呵呵，走，你们这就跟我到离岛的会场去看看吧，保证能让人耳目一新。"
                                                },
                                                {
                                                    "id": "400540249",
                                                    "speaker": "八重神子",
                                                    "text": "而且在那边，还有专人要讲解这次的任务呢。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "400540242",
                                            "text": "一本正经地胡说八道？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "400540225",
                            "text": "文化盛会？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "4005403",
            "objective": "前往离岛的容彩祭会场",
            "dialogues": [
                {
                    "id": "400540301",
                    "speaker": "八重神子",
                    "text": "…在容彩祭期间，远国监司周围将会承担轻小说的主展区功能。"
                },
                {
                    "id": "400540302",
                    "speaker": "八重神子",
                    "text": "届时不仅有大量官方与同人作品参展，还有限定赠品、抽奖、新刊发售会等丰富的活动。"
                },
                {
                    "id": "400540303",
                    "speaker": "八重神子",
                    "text": "万国商会前的这个小广场，祭典期间会被称作「五歌仙广场」，附近的店铺将贩售与轻小说联动的特别商品，请一定不要错过。"
                },
                {
                    "id": "400540304",
                    "speaker": "派蒙",
                    "text": "哇，该怎么说呢，虽然和普通的祭典感觉不太一样，但感到了另一种层面的厉害…"
                },
                {
                    "id": "400540305",
                    "speaker": "Player",
                    "text": "嗯，「轻小说浓度过高」。"
                },
                {
                    "id": "400540306",
                    "speaker": "派蒙",
                    "text": "咦，神子，广场中心这些空白的板子是什么呀？"
                },
                {
                    "id": "400540307",
                    "speaker": "八重神子",
                    "text": "嗯，这些呀…"
                },
                {
                    "id": "400540308",
                    "speaker": "神里绫人",
                    "text": "八重大人此前说会有可靠的帮手前来协助，果然是指你们。"
                },
                {
                    "id": "400540309",
                    "speaker": "神里绫人",
                    "text": "旅行者，派蒙，有段时间没见了，你们最近可好？"
                },
                {
                    "id": "400540310",
                    "speaker": "派蒙",
                    "text": "是绫人！这次的容彩祭，连你这个大忙人也亲自出马了呀。"
                },
                {
                    "id": "400540311",
                    "speaker": "神里绫人",
                    "text": "筹备祭典是社奉行分内之事，容彩祭又倾注了八重大人的心血，我也自当亲力亲为。"
                },
                {
                    "id": "400540312",
                    "speaker": "八重神子",
                    "text": "呵呵，绫人，大家都是熟人了，干嘛这么客气呀。"
                },
                {
                    "id": "400540313",
                    "speaker": "八重神子",
                    "text": "我们刚好说到这里的展板，它们跟小家伙们的任务也有些关系，你就来仔细讲讲吧。"
                },
                {
                    "id": "400540314",
                    "speaker": "神里绫人",
                    "text": "你们两个应该已经知道容彩祭来源于五歌仙，这五块展板，正是为了绘制他们的画像设置的。"
                },
                {
                    "id": "400540315",
                    "speaker": "神里绫人",
                    "text": "此次容彩祭，不仅是稻妻解除锁国令后的第一次大型祭典，并且还与文化艺术相关。"
                },
                {
                    "id": "400540316",
                    "speaker": "神里绫人",
                    "text": "因此社奉行出面，邀请了数位他国的文化名人前来。"
                },
                {
                    "id": "400540317",
                    "speaker": "神里绫人",
                    "text": "比如应邀绘制这几幅画像的，就是一位从蒙德远道而来的画家。"
                },
                {
                    "id": "400540318",
                    "speaker": "神里绫人",
                    "text": "各位嘉宾在稻妻的食宿社奉行会帮忙安排，但客人远到异乡，难免会不习惯。"
                },
                {
                    "id": "400540319",
                    "speaker": "神里绫人",
                    "text": "这时候如果能有一位既熟悉稻妻，又了解提瓦特其他国家的人作为接引向导，就再好不过了。",
                    "choices": [
                        {
                            "id": "400540320",
                            "text": "我明白了。",
                            "response": [
                                {
                                    "id": "400540322",
                                    "speaker": "神里绫人",
                                    "text": "正是。我们希望二位能从港口接引嘉宾们到万国商会下榻，并提供适当的帮助。"
                                },
                                {
                                    "id": "400540323",
                                    "speaker": "神里绫人",
                                    "text": "这份「到港时刻表」上，写明了嘉宾们乘坐船只的详细信息，只要按照上面的时间到港口便可。"
                                },
                                {
                                    "id": "400540324",
                                    "speaker": "八重神子",
                                    "text": "好啦，时候不早了，我还要和编辑们开会，就先走一步咯。"
                                },
                                {
                                    "id": "400540325",
                                    "speaker": "八重神子",
                                    "text": "祭典期间，八重堂的编辑大多都会待在远国监司附近，你们如果有事就过去找他们吧。"
                                },
                                {
                                    "id": "400540326",
                                    "speaker": "神里绫人",
                                    "text": "二位，这次祭典需三奉行通力合作，有许多琐事需要处理，我也先失陪了。接引嘉宾一事，就拜托你们了。"
                                }
                            ]
                        },
                        {
                            "id": "400540321",
                            "text": "这就是我们的任务。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "4005404",
            "objective": "与八重神子对话",
            "dialogues": []
        },
        {
            "id": "4005499",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "400549901",
                    "speaker": "派蒙",
                    "text": "绫人给我们的时刻表上，有船只的详细信息。"
                },
                {
                    "id": "400549902",
                    "speaker": "派蒙",
                    "text": "我们仔细看一下，然后就根据上面的时间去接人吧。"
                }
            ]
        }
    ]
}