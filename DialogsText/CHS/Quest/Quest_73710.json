        }
    },
    "talks": [
        {
            "id": "7371001",
            "objective": "返回拜达港一带",
            "dialogues": [
                {
                    "id": "737100101",
                    "speaker": "咚咚小圆帽",
                    "text": "♪~♪♪~♪~"
                },
                {
                    "id": "737100102",
                    "speaker": "欢腾之火",
                    "text": "♫♫~♫~♫♫~"
                },
                {
                    "id": "737100103",
                    "speaker": "派蒙",
                    "text": "我们回来啦，海妮耶，左右加！"
                },
                {
                    "id": "737100104",
                    "speaker": "海妮耶",
                    "text": "远远就听见「咚咚小圆帽」和「欢腾之火」欢乐的脚步声，看来你们这次确实玩了个痛快。"
                },
                {
                    "id": "737100105",
                    "speaker": "左右加",
                    "text": "这么远就能听出欢乐吗？我到现在都没法辨别蕈兽伙伴脚步声里传达的情绪…"
                },
                {
                    "id": "737100106",
                    "speaker": "左右加",
                    "text": "看来我还是得多学啊…学无止境！"
                },
                {
                    "id": "737100107",
                    "speaker": "派蒙",
                    "text": "欸嘿嘿，这次出游的感觉，确实很不一样！"
                },
                {
                    "id": "737100108",
                    "speaker": "派蒙",
                    "text": "带着蕈兽伙伴们玩了一圈，再回到「小小灵蕈乐园」附近，感觉和玩累了回家吃饭有点像。"
                },
                {
                    "id": "737100109",
                    "speaker": "派蒙",
                    "text": "不如，现在就一起合张影吧？我看《蒸汽鸟报》提到的许多知名游记，都把旅途的各种画片按时间连起来呢。"
                },
                {
                    "id": "737100110",
                    "speaker": "海妮耶",
                    "text": "「白银伴星」这么一说，我才想起，这些年来和蕈兽伙伴们相处得理所当然，没怎么合过影…"
                },
                {
                    "id": "737100111",
                    "speaker": "左右加",
                    "text": "嗯！两位大老板都很懂「完美收场」的仪式嘛！"
                },
                {
                    "id": "737100112",
                    "speaker": "咚咚小圆帽",
                    "text": "♪♪~"
                },
                {
                    "id": "737100113",
                    "speaker": "欢腾之火",
                    "text": "♫♫~"
                },
                {
                    "id": "737100114",
                    "speaker": "派蒙",
                    "text": "好哦，那就用「咚咚小圆帽」的这个相机，加上支架，来张定时合照！"
                },
                {
                    "id": "737100115",
                    "speaker": "派蒙",
                    "text": "等到海妮耶和左右加不那么忙了，我们还要一起，像这样开心地出去玩！"
                },
                {
                    "id": "737100147",
                    "speaker": "派蒙",
                    "text": "好耶！"
                },
                {
                    "id": "737100116",
                    "speaker": "派蒙",
                    "text": "说起来，「咚咚小圆帽」拍照的天赋很厉害哦！"
                },
                {
                    "id": "737100117",
                    "speaker": "派蒙",
                    "text": "我挑了几张拍得不错的，就和我们的合照放在一起，海妮耶和左右加也可以看看！",
                    "choices": [
                        {
                            "id": "737100118",
                            "text": "居然全都考虑好了…",
                            "response": [
                                {
                                    "id": "737100120",
                                    "speaker": "派蒙",
                                    "text": "还有还有…来，海妮耶和左右加，我给你们带了纪念品——"
                                },
                                {
                                    "id": "737100121",
                                    "speaker": "派蒙",
                                    "text": "是你们之前没吃到的马卡龙！"
                                },
                                {
                                    "id": "737100122",
                                    "speaker": "左右加",
                                    "text": "咦！我只是随口一说，你居然记住了吗？"
                                },
                                {
                                    "id": "737100123",
                                    "speaker": "海妮耶",
                                    "text": "「白银伴星」…令人感动…"
                                },
                                {
                                    "id": "737100124",
                                    "speaker": "海妮耶",
                                    "text": "为了以后不再这么麻烦你，我必须改掉毛病，出游前做好万全的规划…并且不能停留在纸面上。"
                                },
                                {
                                    "id": "737100125",
                                    "speaker": "派蒙",
                                    "text": "好朋友放松闲聊时候，随口说的事情，也能反映心里的真实想法嘛！",
                                    "choices": [
                                        {
                                            "id": "737100126",
                                            "text": "什么时候买的？",
                                            "response": [
                                                {
                                                    "id": "737100128",
                                                    "speaker": "派蒙",
                                                    "text": "在枫丹廷拍照的那会儿啦。"
                                                },
                                                {
                                                    "id": "737100129",
                                                    "speaker": "派蒙",
                                                    "text": "你陪着「咚咚小圆帽」关注眼前景色的时候，我找了个报童帮忙，给了她一些跑腿费。"
                                                },
                                                {
                                                    "id": "737100130",
                                                    "speaker": "派蒙",
                                                    "text": "放心，你的那份我当然也有准备啦，怎么会忘了你呢！"
                                                },
                                                {
                                                    "id": "737100131",
                                                    "speaker": "派蒙",
                                                    "text": "我有好好叮嘱过报童说，进店后，第一个就去找你最爱吃的口味哦！"
                                                },
                                                {
                                                    "id": "737100132",
                                                    "speaker": "派蒙",
                                                    "text": "不过我们早就吃遍了枫丹廷的甜点，应该没什么新鲜感…",
                                                    "choices": [
                                                        {
                                                            "id": "737100133",
                                                            "text": "只要是派蒙买的甜点，就好吃！",
                                                            "response": [
                                                                {
                                                                    "id": "737100135",
                                                                    "speaker": "派蒙",
                                                                    "text": "真的吗？嘿嘿…那我以后多多给你买！"
                                                                },
                                                                {
                                                                    "id": "737100136",
                                                                    "speaker": "派蒙",
                                                                    "text": "可惜没有专门给蕈兽伙伴们吃的甜点…要是能抱着蕈兽伙伴，一起享用桌上满满的美食，得有多好啊！"
                                                                },
                                                                {
                                                                    "id": "737100137",
                                                                    "speaker": "海妮耶",
                                                                    "text": "这方面不用担心，我在完善的《蕈兽族群综论》中，就有从底层研究蕈兽爱吃的食物。"
                                                                },
                                                                {
                                                                    "id": "737100138",
                                                                    "speaker": "海妮耶",
                                                                    "text": "目标是找出蕈兽和人类共通的食材，让伙伴们不用一年到头都吃各种口味的「妙妙琼脂」。"
                                                                },
                                                                {
                                                                    "id": "737100139",
                                                                    "speaker": "海妮耶",
                                                                    "text": "迟早有一天，我会找出兼顾人类和蕈兽味觉的食材，设计出双方共通的美味料理！"
                                                                },
                                                                {
                                                                    "id": "737100140",
                                                                    "speaker": "左右加",
                                                                    "text": "等到实践下厨，就由我来负责！以防海妮耶烧坏我们的第十一口锅。"
                                                                },
                                                                {
                                                                    "id": "737100141",
                                                                    "speaker": "派蒙",
                                                                    "text": "这么听来，以后和蕈兽伙伴们坐成一圈聚餐的那天，不远了？",
                                                                    "choices": [
                                                                        {
                                                                            "id": "737100142",
                                                                            "text": "就等海妮耶的好消息！",
                                                                            "response": [
                                                                                {
                                                                                    "id": "737100144",
                                                                                    "speaker": "海妮耶",
                                                                                    "text": "那还请常回「小小灵蕈乐园」来看看，我们和各位蕈兽伙伴随时等着你们。"
                                                                                },
                                                                                {
                                                                                    "id": "737100145",
                                                                                    "speaker": "左右加",
                                                                                    "text": "说不定，惊喜会比你们预想的来得更早呢！"
                                                                                },
                                                                                {
                                                                                    "id": "737100146",
                                                                                    "speaker": "咚咚小圆帽",
                                                                                    "text": "♪！"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "737100143",
                                                                            "text": "就等左右加的大餐了！"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "737100134",
                                                            "text": "派蒙给我主动买的，可不一样！"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "737100127",
                                            "text": "我都没有注意到…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "737100119",
                            "text": "派蒙，周到！"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7371099",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "737109901",
                    "speaker": "派蒙",
                    "text": "好啦，我们也和蕈兽伙伴好好享受了一次不短不长的旅行…"
                },
                {
                    "id": "737109902",
                    "speaker": "派蒙",
                    "text": "是时候回去找海妮耶和左右加啦！"
                }
            ]
        }
    ]
}