    "talks": [
        {
            "id": "2000801",
            "objective": "前往码头查看详情",
            "dialogues": [
                {
                    "id": "200080101",
                    "speaker": "阿瑟尔",
                    "text": "谢谢，谢谢你救了我。"
                },
                {
                    "id": "200080102",
                    "speaker": "阿瑟尔",
                    "text": "这些史莱姆突然冒出来，我没想到史莱姆会在这里出现，没来得及跑就被它们围住了。"
                },
                {
                    "id": "200080103",
                    "speaker": "阿瑟尔",
                    "text": "你们千万别告诉我爸。我爸本来要我一直呆在家里。他说最近这周围的史莱姆都特别凶。"
                },
                {
                    "id": "200080104",
                    "speaker": "阿瑟尔",
                    "text": "而且史莱姆都开始出现在蒙德城周围了，我已经闷在家里好几天了，今天是偷跑出来的。"
                },
                {
                    "id": "200080105",
                    "speaker": "阿瑟尔",
                    "text": "如果你们愿意的话，能去前面看看吗，如果有史莱姆的话，就请消灭它们吧。",
                    "choices": [
                        {
                            "id": "200080106",
                            "text": "没问题。",
                            "response": [
                                {
                                    "id": "200080108",
                                    "speaker": "阿瑟尔",
                                    "text": "太好了！我总算能安心去玩了。"
                                }
                            ]
                        },
                        {
                            "id": "200080107",
                            "text": "还有别的急事。",
                            "response": [
                                {
                                    "id": "200080109",
                                    "speaker": "阿瑟尔",
                                    "text": "可，可是，我不敢告诉我爸…能处理这事的只有你，拜托你了！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2000802",
            "objective": "消灭史莱姆",
            "dialogues": [
                {
                    "id": "200080201",
                    "speaker": "派蒙",
                    "text": "咦，这是什么？看着像是「灰尘」…但是却有元素的痕迹。"
                }
            ]
        },
        {
            "id": "2000803",
            "objective": "和阿瑟尔对话",
