{
    "quest": {
        "id": "71501",
        "title": "深泥奇谭",
        "description": "凯瑟琳似乎在为层岩巨渊的一项委托感到烦恼…",
        "rewards": [],
        "rewards_formatted": "",
        "chapter": {
            "icon": "",
            "id": "",
            "num": "",
            "title": ""
        },
        "total_dialogue_lines": 64,
        "total_speaker_counts": {
            "Player": 12,
            "凯瑟琳": 17,
            "派蒙": 10,
            "胡塞尼": 25
        }
    },
    "talks": [
        {
            "id": "7150101",
            "objective": "前往璃月冒险家协会找凯瑟琳",
            "dialogues": [
                {
                    "id": "715010101",
                    "speaker": "凯瑟琳",
                    "text": "嗯…这两天情况在越发恶化，勘探队的行动也会受限。"
                },
                {
                    "id": "715010102",
                    "speaker": "凯瑟琳",
                    "text": "有谁能解决这样的委托呢…",
                    "choices": [
                        {
                            "id": "715010103",
                            "text": "怎么了？",
                            "response": [
                                {
                                    "id": "715010105",
                                    "speaker": "凯瑟琳",
                                    "text": "#啊，是{NICKNAME}和派蒙，真是来得正好。"
                                },
                                {
                                    "id": "715010106",
                                    "speaker": "派蒙",
                                    "text": "来得正好？"
                                },
                                {
                                    "id": "715010107",
                                    "speaker": "派蒙",
                                    "text": "听上去又有发生了什么麻烦事。"
                                },
                                {
                                    "id": "715010108",
                                    "speaker": "凯瑟琳",
                                    "text": "这段时间，不知道为什么，层岩巨渊的矿洞和矿道突然涌出了大量的黑色泥状物。"
                                },
                                {
                                    "id": "715010109",
                                    "speaker": "凯瑟琳",
                                    "text": "因为是突发情况，勘探队也没法立刻做出应对，调查进度也一停再停，海迪夫也向冒险家协会委托寻找协助者…"
                                },
                                {
                                    "id": "715010110",
                                    "speaker": "派蒙",
                                    "text": "啊？黑色泥状物，难道是层岩巨渊下面那种…"
                                },
                                {
                                    "id": "715010111",
                                    "speaker": "凯瑟琳",
                                    "text": "对，就是那类黑泥，不知道为什么涌到了矿洞和矿道那边，勘探队调查进程受阻不说，就连日常的行动都要受到影响…"
                                },
                                {
                                    "id": "715010112",
                                    "speaker": "凯瑟琳",
                                    "text": "毕竟大量资源和材料都得倚靠矿道进行运输。"
                                },
                                {
                                    "id": "715010113",
                                    "speaker": "Player",
                                    "text": "这样多久了？"
                                },
                                {
                                    "id": "715010114",
                                    "speaker": "凯瑟琳",
                                    "text": "有一段时间了，虽然海迪夫说他找到了愿意帮忙的须弥学者，但是那名学者也需要协助…"
                                },
                                {
                                    "id": "715010115",
                                    "speaker": "凯瑟琳",
                                    "text": "我正为有谁能解决这件事而头疼呢。"
                                },
                                {
                                    "id": "715010116",
                                    "speaker": "派蒙",
                                    "text": "海迪夫的委托，酬劳应该很多吧！"
                                },
                                {
                                    "id": "715010117",
                                    "speaker": "派蒙",
                                    "text": "没有人愿意去吗？"
                                },
                                {
                                    "id": "715010118",
                                    "speaker": "凯瑟琳",
                                    "text": "毕竟那些黑色的泥状物还是很危险的…没有人愿意接这份委托啊。虽然因为酬金来的人很多…"
                                },
                                {
                                    "id": "715010119",
                                    "speaker": "凯瑟琳",
                                    "text": "但许多冒险家一听到是在层岩巨渊，就打起了退堂鼓。"
                                },
                                {
                                    "id": "715010120",
                                    "speaker": "凯瑟琳",
                                    "text": "而且，大部分冒险家对于层岩巨渊下的环境也并不熟悉。"
                                },
                                {
                                    "id": "715010121",
                                    "speaker": "凯瑟琳",
                                    "text": "能够接受这项委托的，应该是既不害怕危险，又对层岩巨渊环境十分了解的人…"
                                },
                                {
                                    "id": "715010122",
                                    "speaker": "凯瑟琳",
                                    "text": "我正烦恼如何找到可以担当此任的人，你们就路过了。"
                                },
                                {
                                    "id": "715010123",
                                    "speaker": "派蒙",
                                    "text": "#原来是这样，{NICKNAME}，看上去情况真的很危急呢…",
                                    "choices": [
                                        {
                                            "id": "715010124",
                                            "text": "嗯，得去看看才行…",
                                            "response": [
                                                {
                                                    "id": "715010126",
                                                    "speaker": "派蒙",
                                                    "text": "那我们现在就去层岩巨渊找海迪夫吧？"
                                                },
                                                {
                                                    "id": "715010127",
                                                    "speaker": "凯瑟琳",
                                                    "text": "啊，关于这点…海迪夫说你直接去找那位须弥学者就好。"
                                                },
                                                {
                                                    "id": "715010128",
                                                    "speaker": "凯瑟琳",
                                                    "text": "他的原句是这样说的：「如果有愿意来的人，就让他去层岩巨渊的营地前吧，那家伙一直在那边调整设备呢。」"
                                                },
                                                {
                                                    "id": "715010129",
                                                    "speaker": "Player",
                                                    "text": "好，我们马上就去。"
                                                },
                                                {
                                                    "id": "715010130",
                                                    "speaker": "凯瑟琳",
                                                    "text": "嗯，层岩巨渊的安全，就交给你们了！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "715010125",
                                            "text": "就当帮海迪夫一次吧…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "715010104",
                            "text": "发生什么事了吗？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7150102",
            "objective": "前往矿区营地前寻找须弥学者",
            "dialogues": [
                {
                    "id": "715010201",
                    "speaker": "胡塞尼",
                    "text": "没想到这里的环境这么特殊…这样的话，「普尔希娜光钉」的能源系统…"
                },
                {
                    "id": "715010202",
                    "speaker": "胡塞尼",
                    "text": "#嗯？{NICKNAME}和派蒙，真是好久不见了，你们怎么也来层岩巨渊了…"
                },
                {
                    "id": "715010203",
                    "speaker": "胡塞尼",
                    "text": "这么说来，我之前好像听海迪夫说过，你在层岩巨渊帮了勘探队许多忙。"
                },
                {
                    "id": "715010204",
                    "speaker": "胡塞尼",
                    "text": "不过现在的层岩巨渊环境相较之前变得更为恶劣和危险，可不是来散步的地方。"
                },
                {
                    "id": "715010205",
                    "speaker": "Player",
                    "text": "你是？"
                },
                {
                    "id": "715010206",
                    "speaker": "胡塞尼",
                    "text": "我们不是不久之前才刚见过吗？"
                },
                {
                    "id": "715010207",
                    "speaker": "胡塞尼",
                    "text": "虽然每次见面好像都麻烦你做了很多事，但也没必要装作不认识吧。"
                },
                {
                    "id": "715010208",
                    "speaker": "胡塞尼",
                    "text": "算了，那我就再自我介绍一下，我是须弥「教令院」的学者胡塞尼，之前进行「导能圆盘」的研究，还去稻妻进行了考察。"
                },
                {
                    "id": "715010209",
                    "speaker": "胡塞尼",
                    "text": "不过现在研究的经费用完了，所以不得不返回须弥…"
                },
                {
                    "id": "715010210",
                    "speaker": "派蒙",
                    "text": "哦，我好像有点印象…"
                },
                {
                    "id": "715010211",
                    "speaker": "胡塞尼",
                    "text": "你想起我了？"
                },
                {
                    "id": "715010212",
                    "speaker": "派蒙",
                    "text": "你就是——「圆盘人」！"
                },
                {
                    "id": "715010213",
                    "speaker": "胡塞尼",
                    "text": "…我很确定自己不是什么「圆盘人」。"
                },
                {
                    "id": "715010214",
                    "speaker": "胡塞尼",
                    "text": "总之，我在回须弥的路上，接到了同为「教令院」学者海迪夫的委托，从前海迪夫帮过我一些忙，主要是研究经费上的…"
                },
                {
                    "id": "715010215",
                    "speaker": "胡塞尼",
                    "text": "所以这次我就来层岩巨渊帮他解决这个问题。"
                },
                {
                    "id": "715010216",
                    "speaker": "胡塞尼",
                    "text": "我解释得够清楚了吧，你们呢，你们怎么会在这个时候来层岩巨渊？",
                    "choices": [
                        {
                            "id": "715010217",
                            "text": "我们接了海迪夫的委托…",
                            "response": [
                                {
                                    "id": "715010219",
                                    "speaker": "胡塞尼",
                                    "text": "哦哦，原来是你们。海迪夫之前说想要找人帮忙一起协助的时候，我还感到担忧。"
                                },
                                {
                                    "id": "715010220",
                                    "speaker": "胡塞尼",
                                    "text": "不过既然是你们的话，我就放心了。"
                                },
                                {
                                    "id": "715010221",
                                    "speaker": "胡塞尼",
                                    "text": "这次层岩巨渊的黑泥涌出事件，如果只有我一个人来处理，就要耗费更多的精力。有你们协助，解决的概率就…更高了一些。"
                                },
                                {
                                    "id": "715010222",
                                    "speaker": "Player",
                                    "text": "需要我们做什么吗？"
                                },
                                {
                                    "id": "715010223",
                                    "speaker": "胡塞尼",
                                    "text": "你听说过「普尔希娜光钉」吗？能够释放扰乱地脉的力量的仪器。"
                                },
                                {
                                    "id": "715010224",
                                    "speaker": "胡塞尼",
                                    "text": "按照我的推测，只要在黑泥涌出之处安置「普尔希娜光钉」，扰乱地脉活动，就能够清理掉黑泥。"
                                },
                                {
                                    "id": "715010225",
                                    "speaker": "派蒙",
                                    "text": "可是黑泥和地脉有什么关系啊？"
                                },
                                {
                                    "id": "715010226",
                                    "speaker": "胡塞尼",
                                    "text": "因为这些黑泥是随着地脉的变动出现在这里的，有很大概率与地脉有关…这是我和海迪夫一起讨论出来的结果。"
                                },
                                {
                                    "id": "715010227",
                                    "speaker": "胡塞尼",
                                    "text": "所以利用光钉来扰乱，甚至关闭此处地脉向外接洽的出口，即可停止黑泥的涌出。"
                                },
                                {
                                    "id": "715010228",
                                    "speaker": "Player",
                                    "text": "原来是这样…"
                                },
                                {
                                    "id": "715010229",
                                    "speaker": "胡塞尼",
                                    "text": "只不过，之前也只不过是用光钉「扰乱地脉」，这次要「完全封闭」，还是第一次尝试。"
                                },
                                {
                                    "id": "715010230",
                                    "speaker": "胡塞尼",
                                    "text": "我经过一些验算，调整了光钉里的一些参数，理论上不会出错。"
                                },
                                {
                                    "id": "715010231",
                                    "speaker": "胡塞尼",
                                    "text": "不过理论终究是理论，还是需要进行实验验证的，我刚才就在打算进行试启动，不过，实验代表着风险…"
                                },
                                {
                                    "id": "715010232",
                                    "speaker": "Player",
                                    "text": "我来试试吧…"
                                },
                                {
                                    "id": "715010233",
                                    "speaker": "胡塞尼",
                                    "text": "嗯…这样也好，就交给你了。"
                                },
                                {
                                    "id": "715010234",
                                    "speaker": "胡塞尼",
                                    "text": "我也会在一边进行观测的。"
                                }
                            ]
                        },
                        {
                            "id": "715010218",
                            "text": "我们是来帮忙的…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7150103",
            "objective": "开启「普尔希娜光钉」",
            "dialogues": []
        },
        {
            "id": "7150104",
            "objective": "与胡塞尼对话",
            "dialogues": []
        }
    ]
}