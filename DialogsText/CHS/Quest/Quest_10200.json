    "talks": [
        {
            "id": "1020001",
            "objective": "等待夜晚降临",
            "dialogues": [
                {
                    "id": "102000101",
                    "speaker": "琴",
                    "text": "深渊教团近期活跃的原因，还需要更进一步探明…"
                },
                {
                    "id": "102000102",
                    "speaker": "琴",
                    "text": "#{NICKNAME}，旅途中还请小心。"
                }
            ]
        },
        {
            "id": "1020002",
            "objective": "(test)派蒙巴顿开车$HIDDEN",
            "dialogues": [
                {
                    "id": "102000201",
                    "speaker": "巴顿",
                    "text": "唉，只能从窗外听到大家的讨论，连发言的机会都没有，好想参加他们的话题啊…"
                },
                {
                    "id": "102000202",
                    "speaker": "派蒙",
                    "text": "欸？什么什么？有什么好玩的事情吗？我也想听！"
                },
                {
                    "id": "102000203",
                    "speaker": "巴顿",
                    "text": "酒馆里的客人们，最近激烈地讨论起了一个话题——「谁，才是蒙德城最强战力」。"
                },
                {
                    "id": "102000204",
                    "speaker": "派蒙",
                    "text": "「最强」…？"
                },
                {
                    "id": "102000205",
                    "speaker": "派蒙",
                    "text": "强到一拳能放倒几只丘丘人，算最强吗？",
                    "choices": [
                        {
                            "id": "102000206",
                            "text": "应该没有那么简单吧。",
                            "response": [
                                {
                                    "id": "102000207",
                                    "speaker": "派蒙",
                                    "text": "唔…看来「最强」的称号，并不好拿啊。"
                                },
                                {
                                    "id": "102000210",
                                    "speaker": "派蒙",
                                    "text": "对了，巴顿先生，关于这个话题，大家讨论出什么共识了吗？"
                                },
                                {
                                    "id": "102000211",
                                    "speaker": "巴顿",
                                    "text": "嗯…指望「自由之都」的人轻而易举达成共识，就像期待天上掉渔人吐司一样难。"
                                },
                                {
                                    "id": "102000212",
                                    "speaker": "巴顿",
                                    "text": "每个人都有自己的想法，但谁手里的信息都不全面，所以讨论才会变得激烈又有趣吧。"
                                },
                                {
                                    "id": "102000213",
                                    "speaker": "巴顿",
                                    "text": "现在市面上占据主流的提名…我想想…"
                                },
                                {
                                    "id": "102000214",
                                    "speaker": "巴顿",
                                    "text": "应该是「蒲公英骑士派」和「暗夜英雄派」吧。",
                                    "choices": [
                                        {
                                            "id": "102000215",
                                            "text": "派蒙要把票投给谁？",
                                            "response": [
                                                {
                                                    "id": "102000217",
                                                    "speaker": "派蒙",
                                                    "text": "我支持你哦。"
                                                },
                                                {
                                                    "id": "102000218",
                                                    "speaker": "派蒙",
                                                    "text": "不过，我们还是进<color=#00E1FFFF>酒馆</color>打听看看吧。说不定会有什么逸闻呢？"
                                                },
                                                {
                                                    "id": "102000219",
                                                    "speaker": "巴顿",
                                                    "text": "哈，这份悠闲真让人羡慕。"
                                                },
                                                {
                                                    "id": "102000220",
                                                    "speaker": "巴顿",
                                                    "text": "你们不用管我…呜呜，我也得…继续工作了…"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "102000216",
                                            "text": "有人支持我吗？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "102000208",
                            "text": "我也可以。",
                            "response": [
                                {
                                    "id": "102000209",
                                    "speaker": "派蒙",
                                    "text": "好，那我要提名你。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "1020015",
            "objective": "向巴顿了解最近的话题",
            "dialogues": []
        },
        {
            "id": "1020003",
            "objective": "进入酒馆",
            "dialogues": [
                {
                    "id": "102000301",
                    "speaker": "派蒙",
                    "text": "果然就跟巴顿先生说得一样呢。",
                    "choices": [
                        {
                            "id": "102000302",
                            "text": "大家都有自己的看法。",
                            "response": [
                                {
                                    "id": "102000304",
                                    "speaker": "派蒙",
                                    "text": "但是，如果像这样，谁都说服不了谁的话…"
                                },
                                {
                                    "id": "102000305",
                                    "speaker": "派蒙",
                                    "text": "岂不是永远都不能知道「蒙德的最强战力」到底是谁了。"
                                },
                                {
                                    "id": "102000306",
                                    "speaker": "派蒙",
                                    "text": "啊，有了！"
                                },
                                {
                                    "id": "102000307",
                                    "speaker": "派蒙",
                                    "text": "我们去找<color=#00E1FFFF>琴团长</color>问问看吧？"
                                },
                                {
                                    "id": "102000308",
                                    "speaker": "派蒙",
                                    "text": "说不定会有，「西风骑士团认证的官方排行榜」！",
                                    "choices": [
                                        {
                                            "id": "102000309",
                                            "text": "真会有那种东西吗？",
                                            "response": [
                                                {
                                                    "id": "102000310",
                                                    "speaker": "派蒙",
                                                    "text": "走嘛走嘛，不试试怎么知道呢。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "102000311",
                                            "text": "我也可以有名次吗？",
                                            "response": [
                                                {
                                                    "id": "102000312",
                                                    "speaker": "派蒙",
                                                    "text": "那就要看他们有没有算上你的事迹了吧？"
                                                },
                                                {
                                                    "id": "102000313",
                                                    "speaker": "派蒙",
                                                    "text": "放心，我还是很信得过你的实力的！"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "102000303",
                            "text": "还听到了一些特别的人选。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1020004",
            "objective": "向酒客们打听「最强战力」的事",
            "dialogues": [
                {
                    "id": "102000701",
                    "speaker": "杰克",
                    "text": "关于「蒙德最强战力」。"
                },
                {
                    "id": "102000702",
                    "speaker": "杰克",
                    "text": "你问我心目中的「最强战力」？"
                },
                {
                    "id": "102000703",
                    "speaker": "杰克",
                    "text": "那应该就是光辉万丈的大冒险家——斯坦利先生了吧。"
                },
                {
                    "id": "102000704",
                    "speaker": "杰克",
                    "text": "虽然协会的塞琉斯会长也很厉害，但能够直面烬寂海魔兽的，只有斯坦利先生一个吧！"
                },
                {
                    "id": "102000705",
                    "speaker": "派蒙",
                    "text": "「烬寂海的魔兽」，听上去很凶猛呢。"
                },
                {
                    "id": "102000706",
                    "speaker": "派蒙",
                    "text": "要是出现在你面前，你会害怕吗？",
                    "choices": [
                        {
                            "id": "102000707",
                            "text": "我会把它打倒。",
                            "response": [
                                {
                                    "id": "102000708",
                                    "speaker": "派蒙",
                                    "text": "哦哦！真不愧是你呢。"
                                }
                            ]
                        },
                        {
                            "id": "102000709",
                            "text": "我会逃走。",
                            "response": [
                                {
                                    "id": "102000710",
                                    "speaker": "派蒙",
                                    "text": "唔，没错。毕竟，那个，安全第一。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "1020011",
            "objective": "向酒客们打听「最强战力」的事",
            "dialogues": [
                {
                    "id": "102000801",
                    "speaker": "布鲁斯",
                    "text": "关于「蒙德最强战力」。"
                },
                {
                    "id": "102000802",
                    "speaker": "布鲁斯",
                    "text": "嗝…要说最强的话。"
                },
                {
                    "id": "102000803",
                    "speaker": "布鲁斯",
                    "text": "那当然是我们的琴团长了…嗝。"
                },
                {
                    "id": "102000804",
                    "speaker": "布鲁斯",
                    "text": "就是因为…琴团长太厉害，甩几下剑…就能…击败遗迹守卫…"
                },
                {
                    "id": "102000805",
                    "speaker": "布鲁斯",
                    "text": "一个人就能…扫平达达乌帕谷的三大部族…"
                },
                {
                    "id": "102000806",
                    "speaker": "布鲁斯",
                    "text": "才会，让我们过得太安逸…无所事事…"
                },
                {
                    "id": "102000807",
                    "speaker": "派蒙",
                    "text": "嗯，琴团长给人的感觉，的确很可靠。"
                },
                {
                    "id": "102000808",
                    "speaker": "派蒙",
                    "text": "但是，总觉得这个家伙已经醉醺醺的了…"
                }
            ]
        },
        {
            "id": "1020012",
            "objective": "向酒客们打听「最强战力」的事",
            "dialogues": [
                {
                    "id": "102000901",
                    "speaker": "查尔斯",
                    "text": "关于「蒙德最强战力」。"
                },
                {
                    "id": "102000902",
                    "speaker": "查尔斯",
                    "text": "「最强战力」？我不太关心这类话题…"
                },
                {
                    "id": "102000903",
                    "speaker": "派蒙",
                    "text": "欸。我还以为会有什么，只有酒保先生才知道的消息渠道呢。"
                },
                {
                    "id": "102000904",
                    "speaker": "Player",
                    "text": "就像专供的酒源一样？"
                },
                {
                    "id": "102000905",
                    "speaker": "派蒙",
                    "text": "没错没错！就是这样。"
                },
                {
                    "id": "102000906",
                    "speaker": "查尔斯",
                    "text": "我可不做情报方面的工作。"
                },
                {
                    "id": "102000907",
                    "speaker": "查尔斯",
                    "text": "但真要我推选一个人选的话，「暗夜英雄」吧。"
                },
                {
                    "id": "102000908",
                    "speaker": "查尔斯",
                    "text": "我听人提起他的事迹，好像是从深渊教团手里救出过平民。"
                },
                {
                    "id": "102000909",
                    "speaker": "派蒙",
                    "text": "出现了，是隐藏情报！"
                },
                {
                    "id": "102000910",
                    "speaker": "派蒙",
                    "text": "话说回来，那些深渊教团的怪物，还真是四处作乱啊。"
                }
            ]
        },
        {
            "id": "1020013",
            "objective": "向酒客们打听「最强战力」的事",
            "dialogues": [
                {
                    "id": "102001001",
                    "speaker": "六指乔瑟",
                    "text": "关于「蒙德最强战力」。"
                },
                {
                    "id": "102001002",
                    "speaker": "六指乔瑟",
                    "text": "唔…「蒙德的最强战力」…"
                },
                {
                    "id": "102001003",
                    "speaker": "六指乔瑟",
                    "text": "我想…那是一个红衣服的小女孩。"
                },
                {
                    "id": "102001004",
                    "speaker": "Player",
                    "text": "红衣服的小女孩？"
                },
                {
                    "id": "102001005",
                    "speaker": "六指乔瑟",
                    "text": "没错。这就要说起半个月前的某一天，我去望风山地寻找新作的灵感，结果…"
                },
                {
                    "id": "102001006",
                    "speaker": "六指乔瑟",
                    "text": "你猜怎么着？"
                },
                {
                    "id": "102001007",
                    "speaker": "派蒙",
                    "text": "怎么着？"
                },
                {
                    "id": "102001008",
                    "speaker": "六指乔瑟",
                    "text": "我发现了一位极具破坏力的强者！"
                },
                {
                    "id": "102001009",
                    "speaker": "六指乔瑟",
                    "text": "望风山地的一大片地貌，都被那位强者改变了！"
                },
                {
                    "id": "102001010",
                    "speaker": "派蒙",
                    "text": "哇！！"
                },
                {
                    "id": "102001011",
                    "speaker": "六指乔瑟",
                    "text": "那时我躲在灌木丛后面，看到一个红衣服的小女孩跑远了，只留下面目全非的山地。"
                },
                {
                    "id": "102001012",
                    "speaker": "六指乔瑟",
                    "text": "唔…但是这样说了别人也不相信。"
                },
                {
                    "id": "102001013",
                    "speaker": "派蒙",
                    "text": "嗯…小女孩和那么强大的破坏力，很难联系在一起呢。"
                },
                {
                    "id": "102001014",
                    "speaker": "六指乔瑟",
                    "text": "要我说，她一定有什么大家都不知道的宝物。"
                },
                {
                    "id": "102001015",
                    "speaker": "六指乔瑟",
                    "text": "说不好，还是全蒙德最厉害的宝物！"
                },
                {
                    "id": "102001016",
                    "speaker": "派蒙",
                    "text": "你是说…宝物？！"
                },
                {
                    "id": "102001017",
                    "speaker": "派蒙",
                    "text": "#{NICKNAME}，你听见了吗。"
                },
                {
                    "id": "102001018",
                    "speaker": "六指乔瑟",
                    "text": "…这是我的猜测。唔…不对，是吟游诗人敏锐的感觉！",
                    "choices": [
                        {
                            "id": "102001019",
                            "text": "听上去没什么说服力。",
                            "response": [
                                {
                                    "id": "102001020",
                                    "speaker": "六指乔瑟",
                                    "text": "怎么这样…"
                                },
                                {
                                    "id": "102001023",
                                    "speaker": "派蒙",
                                    "text": "那个小女孩，叫什么名字呢？"
                                },
                                {
                                    "id": "102001024",
                                    "speaker": "六指乔瑟",
                                    "text": "唔…名字我就不知道了。不怎么在蒙德城里见过她。"
                                },
                                {
                                    "id": "102001025",
                                    "speaker": "六指乔瑟",
                                    "text": "唉，别不相信啊，我说的可都是实话！"
                                },
                                {
                                    "id": "102001026",
                                    "speaker": "派蒙",
                                    "text": "嗯唔…听上去还有点神神秘秘的呢。"
                                },
                                {
                                    "id": "102001027",
                                    "speaker": "派蒙",
                                    "text": "不过，谢谢你的情报！"
                                }
                            ]
                        },
                        {
                            "id": "102001021",
                            "text": "姑且相信你吧。",
                            "response": [
                                {
                                    "id": "102001022",
                                    "speaker": "六指乔瑟",
                                    "text": "谢谢你！啊，难得的知音？！我是多么喜悦， 居然在…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "1020014",
            "objective": "(test)向酒客们打听「最强战力」的事$HIDDEN",
            "dialogues": [
                {
                    "id": "102001401",
                    "speaker": "杰克",
                    "text": "再见。"
                },
                {
                    "id": "102001402",
                    "speaker": "杰克",
                    "text": "嗯，再见。祝你今后的冒险一切顺利。"
                }
            ]
        },
        {
            "id": "1020016",
            "objective": "(test)任务隔离，防止回滚$HIDDEN",
            "dialogues": [
                {
                    "id": "102001601",
                    "speaker": "Player",
                    "text": "…你是谁？"
                },
                {
                    "id": "102001602",
                    "speaker": "六指乔瑟",
                    "text": "叫我「六指乔瑟」就可以了。"
                },
                {
                    "id": "102001603",
                    "speaker": "六指乔瑟",
                    "text": "我是蒙德的人气吟游诗人，嗯…至少曾经很有人气。",
                    "choices": [
                        {
                            "id": "102001604",
                            "text": "你的新作？",
                            "response": [
                                {
                                    "id": "102001605",
                                    "speaker": "六指乔瑟",
                                    "text": "嗯？你要听我的新作「晨风颂曲」吗？"
                                },
                                {
                                    "id": "102001606",
                                    "speaker": "六指乔瑟",
                                    "text": "那么…请先容我调下琴。"
                                },
                                {
                                    "id": "102001607",
                                    "speaker": "六指乔瑟",
                                    "text": "唔……"
                                },
                                {
                                    "id": "102001608",
                                    "speaker": "六指乔瑟",
                                    "text": "不好意思，我这里已经很久没有听众来过了，弦的状态有点…还是下次吧。"
                                }
                            ]
                        },
                        {
                            "id": "102001609",
                            "text": "蒙德还有其他吟游诗人吗？",
                            "response": [
                                {
                                    "id": "102001610",
                                    "speaker": "六指乔瑟",
                                    "text": "当然，毕竟蒙德还有「牧歌之城」的叫法。"
                                },
                                {
                                    "id": "102001611",
                                    "speaker": "六指乔瑟",
                                    "text": "可最近出现了一个奇怪的吟游诗人，我调查了很久都没查出他的来头，可恶。"
                                },
                                {
                                    "id": "102001612",
                                    "speaker": "六指乔瑟",
                                    "text": "自从他出现，我的听众就明显越来越少了。"
                                },
                                {
                                    "id": "102001613",
                                    "speaker": "六指乔瑟",
                                    "text": "本想找他一决胜负把听众抢回来的…"
                                },
                                {
                                    "id": "102001614",
                                    "speaker": "六指乔瑟",
                                    "text": "可是那个人的歌声实在太美妙了，我自己也会沉醉其中…唔…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "1020005",
            "objective": "和派蒙一起总结情报",
            "dialogues": []
        },
        {
            "id": "1020006",
            "objective": "前往骑士团",
            "dialogues": [
                {
                    "id": "102000601",
                    "speaker": "？？？",
                    "text": "唔！我，我很好！对不起，撞到了你们。"
                },
                {
                    "id": "102000602",
                    "speaker": "Player",
                    "text": "你有东西掉了。"
                },
                {
                    "id": "102000603",
                    "speaker": "派蒙",
                    "text": "嗯唔…这上面写的是…"
                },
                {
                    "id": "102000604",
                    "speaker": "派蒙",
                    "text": "「城里放炮禁闭室报到」、「炸弹伤人琴找上门」、「放火烧山可莉完蛋」？"
                },
                {
                    "id": "102000605",
                    "speaker": "？？？",
                    "text": "呀？！"
                },
                {
                    "id": "102000606",
                    "speaker": "？？？",
                    "text": "这…这是凯亚哥哥帮我总结出的…总结出的…唔，生存守则！"
                },
                {
                    "id": "102000607",
                    "speaker": "派蒙",
                    "text": "生存守则？"
                },
                {
                    "id": "102000608",
                    "speaker": "？？？",
                    "text": "就…就是不论如何千万不能违反的东西。"
                },
                {
                    "id": "102000609",
                    "speaker": "？？？",
                    "text": "不然会发生很可怕、很可怕的事情。",
                    "choices": [
                        {
                            "id": "102000610",
                            "text": "凯亚哥哥？",
                            "response": [
                                {
                                    "id": "102000612",
                                    "speaker": "？？？",
                                    "text": "嗯！"
                                },
                                {
                                    "id": "102000613",
                                    "speaker": "？？？",
                                    "text": "啊啊啊，忘记做自我介绍了。"
                                },
                                {
                                    "id": "102000614",
                                    "speaker": "可莉",
                                    "text": "我的名字叫作可莉。",
                                    "choices": [
                                        {
                                            "id": "102000615",
                                            "text": "你好。",
                                            "response": [
                                                {
                                                    "id": "102000618",
                                                    "speaker": "可莉",
                                                    "text": "我知道你们的事情，是帮助了蒙德的荣誉骑士！"
                                                },
                                                {
                                                    "id": "102000619",
                                                    "speaker": "派蒙",
                                                    "text": "哇？！"
                                                },
                                                {
                                                    "id": "102000620",
                                                    "speaker": "派蒙",
                                                    "text": "好感动，又一次得到了肯定！"
                                                },
                                                {
                                                    "id": "102000621",
                                                    "speaker": "可莉",
                                                    "text": "我是听安柏…嗷呜。不对不对，来不及说这些了。"
                                                },
                                                {
                                                    "id": "102000622",
                                                    "speaker": "可莉",
                                                    "text": "我，我其实有件很紧急、很紧急的事情，所以才抱着地图跑来这里。"
                                                },
                                                {
                                                    "id": "102000623",
                                                    "speaker": "Player",
                                                    "text": "怎么了？"
                                                },
                                                {
                                                    "id": "102000624",
                                                    "speaker": "可莉",
                                                    "text": "我，我埋在<color=#00E1FFFF>低语森林</color>里的宝物不见了。"
                                                },
                                                {
                                                    "id": "102000625",
                                                    "speaker": "派蒙",
                                                    "text": "你是说…宝物？！",
                                                    "choices": [
                                                        {
                                                            "id": "102000626",
                                                            "text": "她看起来需要帮助…",
                                                            "response": [
                                                                {
                                                                    "id": "102000627",
                                                                    "speaker": "派蒙",
                                                                    "text": "没错，我也是这样想的！"
                                                                },
                                                                {
                                                                    "id": "102000631",
                                                                    "speaker": "派蒙",
                                                                    "text": "宝物失踪可是大事，要不我们帮你找回来吧！"
                                                                },
                                                                {
                                                                    "id": "102000632",
                                                                    "speaker": "可莉",
                                                                    "text": "好耶！谢谢你们！"
                                                                },
                                                                {
                                                                    "id": "102000633",
                                                                    "speaker": "可莉",
                                                                    "text": "我看看…喏！宝物就在地图上的这个位置。我圈出来了！"
                                                                },
                                                                {
                                                                    "id": "102000634",
                                                                    "speaker": "可莉",
                                                                    "text": "我在埋宝物的地方还插了一个小木牌，很好找的！"
                                                                },
                                                                {
                                                                    "id": "102000635",
                                                                    "speaker": "派蒙",
                                                                    "text": "（木牌…好像能明白宝物为什么会失踪了。）"
                                                                },
                                                                {
                                                                    "id": "102000636",
                                                                    "speaker": "可莉",
                                                                    "text": "#荣誉骑士{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}，我们赶快出发吧！"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "102000628",
                                                            "text": "红衣服的小女孩…",
                                                            "response": [
                                                                {
                                                                    "id": "102000629",
                                                                    "speaker": "派蒙",
                                                                    "text": "还带着宝物！"
                                                                },
                                                                {
                                                                    "id": "102000630",
                                                                    "speaker": "派蒙",
                                                                    "text": "（六指乔瑟先生说的「强者」，难道就是可莉吗…）"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "102000616",
                                            "text": "#我是{NICKNAME}。",
                                            "response": [
                                                {
                                                    "id": "102000617",
                                                    "speaker": "派蒙",
                                                    "text": "叫我派蒙就好啦。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "102000611",
                            "text": "可怕的事情？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1020007",
            "objective": "向琴了解「最强战力」的情报",
            "dialogues": [
                {
                    "id": "102000401",
                    "speaker": "派蒙",
                    "text": "琴团长！打扰你啦，我们在收集「蒙德最强战力」的情报。"
                },
                {
                    "id": "102000402",
                    "speaker": "派蒙",
                    "text": "有没有…那种…西风骑士团认证过的官方排名呢？"
                },
                {
                    "id": "102000403",
                    "speaker": "琴",
                    "text": "「蒙德最强战力」…？"
                },
                {
                    "id": "102000404",
                    "speaker": "琴",
                    "text": "抱歉，不能帮上忙了。我身边并没有这方面的资料…"
                },
                {
                    "id": "102000405",
                    "speaker": "派蒙",
                    "text": "欸…好可惜。"
                },
                {
                    "id": "102000406",
                    "speaker": "派蒙",
                    "text": "#我还希望看{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}排上前五呢。"
                },
                {
                    "id": "102000407",
                    "speaker": "琴",
                    "text": "哈哈。即使没有这方面的统计，我对这位荣誉骑士的实力也从未质疑过。"
                },
                {
                    "id": "102000408",
                    "speaker": "琴",
                    "text": "对了，说到这个…"
                },
                {
                    "id": "102000409",
                    "speaker": "琴",
                    "text": "最近又有深渊教团的法师，在蒙德城附近鬼鬼祟祟地出没。"
                },
                {
                    "id": "102000410",
                    "speaker": "琴",
                    "text": "如果你们在蒙德周边逗留，也希望能够帮忙留意一下。"
                },
                {
                    "id": "102000411",
                    "speaker": "琴",
                    "text": "以你的「战力」，守护人们的安全，应当不成问题。"
                },
                {
                    "id": "102000412",
                    "speaker": "派蒙",
                    "text": "#好！如果能够把深渊教团解决掉的话，{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}的排名又会上升一点吧。",
                    "choices": [
                        {
                            "id": "102000413",
                            "text": "没有那样的排名啦。",
                            "response": [
                                {
                                    "id": "102000415",
                                    "speaker": "派蒙",
                                    "text": "总之，打倒他们就对了啦！"
                                },
                                {
                                    "id": "102000416",
                                    "speaker": "琴",
                                    "text": "哈，感觉被你们的干劲激励了呢。"
                                },
                                {
                                    "id": "102000417",
                                    "speaker": "琴",
                                    "text": "那么，一路小心。"
                                }
                            ]
                        },
                        {
                            "id": "102000414",
                            "text": "会变成「最强」？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1020008",
            "objective": "离开骑士团办公室",
            "dialogues": []
        },
        {
            "id": "1020009",
            "objective": "(test)捡起地上的本子（不出现）$HIDDEN",
            "dialogues": []
        },
        {
            "id": "1020010",
            "objective": "询问小女孩的情况",
            "dialogues": []
        },
        {
            "id": "1020005",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "102000501",
                    "speaker": "查尔斯",
                    "text": "今天想喝点儿什么？"
                }
            ]
        },
        {
            "id": "1020011",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "102001101",
                    "speaker": "杰克",
                    "text": "你好！我在锻炼身为冒险家的酒量…你要不要一起？"
                }
            ]
        },
        {
            "id": "1020012",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "102001201",
                    "speaker": "杰克",
                    "text": "你好像喝了很多啊？"
                },
                {
                    "id": "102001202",
                    "speaker": "杰克",
                    "text": "很多吗？我数数…8杯啤酒…5杯葡萄酒…7杯苹果酒，也就这些吧。"
                },
                {
                    "id": "102001203",
                    "speaker": "杰克",
                    "text": "这点还差得远啊，那些传说中的蒙德冒险家，据说能喝下半个果酒湖那么多的酒…"
                },
                {
                    "id": "102001204",
                    "speaker": "杰克",
                    "text": "只是传说？嗯…原来是这样吗…怪不得，我一直想不通他们买酒的钱是哪里来的…"
                }
            ]
        },
        {
            "id": "1020013",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "102001301",
                    "speaker": "杰克",
                    "text": "你喜欢什么酒？"
                },
                {
                    "id": "102001302",
                    "speaker": "杰克",
                    "text": "我的话…啤酒吧，倒不是说特别喜欢…"
                },
                {
                    "id": "102001303",
                    "speaker": "杰克",
                    "text": "只是像我这样的贫穷冒险者，似乎没什么太多选择…"
                },
                {
                    "id": "102001304",
                    "speaker": "杰克",
                    "text": "能喝个痛快的就是好酒，你不觉得吗？"
                }
            ]
        },
        {
            "id": "1020015",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "102001501",
                    "speaker": "六指乔瑟",
                    "text": "嘿~朋友你好！"
                },
                {
                    "id": "102001502",
                    "speaker": "六指乔瑟",
                    "text": "怎么样？想听听六指乔瑟呕心沥血的最新作吗？"
                }
            ]
        },
        {
            "id": "1020017",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "102001701",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "102001702",
                    "speaker": "六指乔瑟",
                    "text": "要走了吗？看来你是个大忙人呢。"
                },
                {
                    "id": "102001703",
                    "speaker": "六指乔瑟",
                    "text": "如果稍微有空闲的话，也来我这边捧个场吧。"
                }
            ]
        },
        {
            "id": "1020018",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "102001801",
                    "speaker": "布鲁斯",
                    "text": "哦！你也是来品尝蒙德著名的好酒吗？"
                }
            ]
        },
        {
            "id": "1020019",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "102001901",
                    "speaker": "Player",
                    "text": "你怎么在这儿？"
                },
                {
                    "id": "102001902",
                    "speaker": "布鲁斯",
                    "text": "要说问什么…因为我下班了啊。"
                },
                {
                    "id": "102001903",
                    "speaker": "布鲁斯",
                    "text": "在工作后小酌一杯的话晚上会睡得好些。"
                },
                {
                    "id": "102001904",
                    "speaker": "布鲁斯",
                    "text": "唔？反正我工作的时候也是在偷懒？"
                },
                {
                    "id": "102001905",
                    "speaker": "布鲁斯",
                    "text": "那都是因为…蒙德实在是太平静了嘛。"
                },
                {
                    "id": "102001906",
                    "speaker": "布鲁斯",
                    "text": "要是我当初去了冒险家协会，生活大概会比现在有趣吧……"
                },
                {
                    "id": "102001907",
                    "speaker": "Player",
                    "text": "…为什么会这么想？"
                },
                {
                    "id": "102001908",
                    "speaker": "布鲁斯",
                    "text": "你想想，如果当上冒险家，就可以自由地在七国探索…"
                },
                {
                    "id": "102001909",
                    "speaker": "布鲁斯",
                    "text": "还能通过冒险养活自己，那样的生活不是很有趣吗？"
                }
            ]
        },
        {
            "id": "1020022",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "102002201",
                    "speaker": "杰克",
                    "text": "你好！我在锻炼身为冒险家的酒量…你要不要一起？"
                }
            ]
        },
        {
            "id": "1020023",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "102002301",
                    "speaker": "六指乔瑟",
                    "text": "嘿~朋友你好！"
                },
                {
                    "id": "102002302",
                    "speaker": "六指乔瑟",
                    "text": "怎么样？想听听六指乔瑟呕心沥血的最新作吗？"
                }
            ]
        },
        {
            "id": "1020024",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "102002401",
                    "speaker": "布鲁斯",
                    "text": "哦！你也是来品尝蒙德著名的好酒吗？"
                }
            ]
        },
        {
            "id": "1020025",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "102002501",
                    "speaker": "查尔斯",
                    "text": "有什么推荐吗？"
                },
                {
                    "id": "102002502",
                    "speaker": "查尔斯",
                    "text": "晨曦酒庄的精品苹果酒，可以说是「天使的馈赠」的主打酒品。"
                },
                {
                    "id": "102002503",
                    "speaker": "查尔斯",
                    "text": "感兴趣的话也可以尝尝我的调制酒，如果你是第一次喝，我可以送你一杯特调。"
                }
            ]
        },
        {
            "id": "1020026",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "102002601",
                    "speaker": "查尔斯",
                    "text": "关于你自己。"
                },
                {
                    "id": "102002602",
                    "speaker": "查尔斯",
                    "text": "居然对我感兴趣吗？"
                },
                {
                    "id": "102002603",
                    "speaker": "查尔斯",
                    "text": "我在这里做酒保大概有十多年了，和其他员工一样，都是直接受雇于晨曦酒庄。"
                },
                {
                    "id": "102002604",
                    "speaker": "查尔斯",
                    "text": "对酒本身谈不上喜爱，不过是我的工作而已…"
                },
                {
                    "id": "102002605",
                    "speaker": "查尔斯",
                    "text": "嗯…当然也不会像猫尾酒馆的迪奥娜那样，据说她好像很讨厌酒。"
                },
                {
                    "id": "102002606",
                    "speaker": "查尔斯",
                    "text": "偶尔酒庄老板迪卢克老爷会来带班。"
                },
                {
                    "id": "102002607",
                    "speaker": "查尔斯",
                    "text": "毕竟对我来说是难得的假期，这一点我还是很感谢老爷他的。"
                }
            ]
        },
        {
            "id": "1020027",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "102002701",
                    "speaker": "查尔斯",
                    "text": "不用了，谢谢。"
                },
                {
                    "id": "102002702",
                    "speaker": "查尔斯",
                    "text": "是吗，少喝一点总归没错。"
                }
            ]
        }
    ]
}