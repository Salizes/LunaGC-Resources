{
    "quest": {
        "id": "24001",
        "title": "枫丹廷，二三事",
        "description": "诗黛小姐似乎遇见了麻烦…",
        "rewards": [],
        "rewards_formatted": "",
        "chapter": {
            "icon": "",
            "id": "",
            "num": "",
            "title": ""
        },
        "total_dialogue_lines": 44,
        "total_speaker_counts": {
            "Player": 4,
            "布蕾莘": 25,
            "诗黛": 15
        }
    },
    "talks": [
        {
            "id": "2400101",
            "objective": "与诗黛对话",
            "dialogues": [
                {
                    "id": "240010101",
                    "speaker": "诗黛",
                    "text": "请您帮帮忙吧，我刚才正在想着小说的情节，一个不留神，巴里亚就跑没影了…"
                },
                {
                    "id": "240010102",
                    "speaker": "布蕾莘",
                    "text": "您确定巴里亚没有被您留在歌剧院的席位上，或者是拴在卫生间门口吗？"
                },
                {
                    "id": "240010103",
                    "speaker": "诗黛",
                    "text": "这些地方我都找过了。就连座位底下我都找了个遍，可就是没见着巴里亚。"
                },
                {
                    "id": "240010104",
                    "speaker": "诗黛",
                    "text": "我的小巴里亚，不会是被谁给拐走，或者是和谁一见钟情，懵懵懂懂地就跟着走了吧…"
                },
                {
                    "id": "240010105",
                    "speaker": "布蕾莘",
                    "text": "诗黛小姐，我很确信巴里亚不会在这种事情上犯第二次错误。"
                },
                {
                    "id": "240010106",
                    "speaker": "诗黛",
                    "text": "但巴里亚还那么小…年纪小就会不断地犯相同的错误，说不定巴里亚还会以此为乐啊。"
                },
                {
                    "id": "240010107",
                    "speaker": "布蕾莘",
                    "text": "巴里亚的年纪一定没有您认知中的那么小。",
                    "choices": [
                        {
                            "id": "240010108",
                            "text": "巴里亚是…",
                            "response": [
                                {
                                    "id": "240010110",
                                    "speaker": "布蕾莘",
                                    "text": "诗黛小姐的小狗…"
                                },
                                {
                                    "id": "240010111",
                                    "speaker": "诗黛",
                                    "text": "我的家人。"
                                },
                                {
                                    "id": "240010112",
                                    "speaker": "布蕾莘",
                                    "text": "她的家人，刚刚走失了，她正在寻求我的帮助。"
                                },
                                {
                                    "id": "240010113",
                                    "speaker": "布蕾莘",
                                    "text": "…诗黛小姐，这周围已经被咱们找了个遍，巴里亚大概已经跑去了野外。"
                                },
                                {
                                    "id": "240010114",
                                    "speaker": "诗黛",
                                    "text": "那咱们就去野外吧！"
                                },
                                {
                                    "id": "240010115",
                                    "speaker": "布蕾莘",
                                    "text": "我请求您待在城里，看看您的裙子，就算找到了巴里亚，您也是追不上它的。"
                                },
                                {
                                    "id": "240010116",
                                    "speaker": "诗黛",
                                    "text": "胡说，只要听见我说话，巴里亚准会马上跑过来！"
                                },
                                {
                                    "id": "240010117",
                                    "speaker": "布蕾莘",
                                    "text": "那咱们之前围着歌剧院嚷嚷了那么久，想必它是没听见了。"
                                },
                                {
                                    "id": "240010118",
                                    "speaker": "布蕾莘",
                                    "text": "让巴里亚乖乖回到诗黛小姐身边，不是我一个人能做到的事…"
                                },
                                {
                                    "id": "240010119",
                                    "speaker": "布蕾莘",
                                    "text": "考虑到我的工作职责，我不可能离开岗位太久，也不可能让另外一位同事和我一起暂时离岗。"
                                },
                                {
                                    "id": "240010120",
                                    "speaker": "布蕾莘",
                                    "text": "旅行者，如果您愿意的话，可以帮助一下我和诗黛小姐吗？",
                                    "choices": [
                                        {
                                            "id": "240010121",
                                            "text": "倒是没问题…",
                                            "response": [
                                                {
                                                    "id": "240010124",
                                                    "speaker": "布蕾莘",
                                                    "text": "那这件事就这么定了，请您和我一起去野外找找吧。"
                                                },
                                                {
                                                    "id": "240010125",
                                                    "speaker": "布蕾莘",
                                                    "text": "考虑到巴里亚的体重和体力，它想必跑不太远。"
                                                },
                                                {
                                                    "id": "240010126",
                                                    "speaker": "诗黛",
                                                    "text": "巴里亚可是很健康的！"
                                                },
                                                {
                                                    "id": "240010127",
                                                    "speaker": "布蕾莘",
                                                    "text": "如果您是指巴里亚的精神生活的话，我十分赞同。"
                                                },
                                                {
                                                    "id": "240010128",
                                                    "speaker": "布蕾莘",
                                                    "text": "那我们就出发吧，如果让巴里亚体会到了在野外的好处，它说不定就要跑得更远了。"
                                                },
                                                {
                                                    "id": "240010129",
                                                    "speaker": "诗黛",
                                                    "text": "喂！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "240010122",
                                            "text": "警官还管这事啊…",
                                            "response": [
                                                {
                                                    "id": "240010123",
                                                    "speaker": "布蕾莘",
                                                    "text": "枫丹廷的市民向我请求帮助，我没有拒绝的理由。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "240010109",
                            "text": "有什么麻烦事吗？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "2400102",
            "objective": "跟随布蕾莘",
            "dialogues": []
        },
        {
            "id": "2400103",
            "objective": "跟随布蕾莘",
            "dialogues": [
                {
                    "id": "240010301",
                    "speaker": "布蕾莘",
                    "text": "果然在这里，看来它的情况还不错。"
                },
                {
                    "id": "240010302",
                    "speaker": "布蕾莘",
                    "text": "诗黛小姐什么时候才能意识到，小狗不喜欢歌剧，也不喜欢听她的小说呢？"
                },
                {
                    "id": "240010303",
                    "speaker": "布蕾莘",
                    "text": "我们回去吧，诗黛小姐肯定等急了。"
                }
            ]
        },
        {
            "id": "2400104",
            "objective": "向诗黛回报",
            "dialogues": [
                {
                    "id": "240010401",
                    "speaker": "诗黛",
                    "text": "巴里亚！我的宝贝，天哪，你去哪里了？"
                },
                {
                    "id": "240010402",
                    "speaker": "布蕾莘",
                    "text": "它只是找了个清净的地方待了一会，给自己稍微放了个假。"
                },
                {
                    "id": "240010403",
                    "speaker": "诗黛",
                    "text": "我真是担心得要命，谢谢你，布蕾莘警官，我的下一部小说一定会提到您！"
                },
                {
                    "id": "240010404",
                    "speaker": "布蕾莘",
                    "text": "感谢您的好意，但还是请您省下这些笔墨吧，没人会对一名警官的日常生活感兴趣的。"
                },
                {
                    "id": "240010405",
                    "speaker": "诗黛",
                    "text": "那我就将您的故事写得跌宕起伏…保证有趣！"
                },
                {
                    "id": "240010406",
                    "speaker": "布蕾莘",
                    "text": "您这句有趣的承诺就足够让我的心情跌宕起伏了。"
                },
                {
                    "id": "240010407",
                    "speaker": "诗黛",
                    "text": "结尾还得发人深省！让我想想，给您安排个什么队友好呢…"
                }
            ]
        },
        {
            "id": "2400105",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "240010501",
                    "speaker": "诗黛",
                    "text": "难道是巴里亚不喜欢我新写的小说？唉，明明其他人都评价不错…"
                },
                {
                    "id": "240010502",
                    "speaker": "诗黛",
                    "text": "唉，下次我得挑一篇更好的念给它听了…"
                }
            ]
        },
        {
            "id": "2400199",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "240019901",
                    "speaker": "布蕾莘",
                    "text": "巴里亚不喜欢太热闹的地方，歌剧肯定让它烦躁不安，所以才逃开了。"
                },
                {
                    "id": "240019902",
                    "speaker": "布蕾莘",
                    "text": "它说不定会藏在草丛里…往前走走，去那片草丛里看看。"
                },
                {
                    "id": "240019903",
                    "speaker": "布蕾莘",
                    "text": "没有…唔，去别处找找…"
                }
            ]
        }
    ]
}