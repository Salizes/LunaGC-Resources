    "talks": [
        {
            "id": "2300001",
            "objective": "与玛达赫对话",
            "dialogues": [
                {
                    "id": "230000400",
                    "speaker": "Player",
                    "text": "以前在蒙德…"
                },
                {
                    "id": "230000401",
                    "speaker": "玛达赫",
                    "text": "嗯？风神眷顾的蒙德吗…我听商队的人说，那里出现了一头掀起狂风的巨龙，应该会是个不错的题材。"
                },
                {
                    "id": "230000402",
                    "speaker": "玛达赫",
                    "text": "但从商队那边能打听到的，也只是一些断断续续，听起来还不太靠谱的传言。"
                },
                {
                    "id": "230000403",
                    "speaker": "玛达赫",
                    "text": "比如说…「一名背生双翼的旅行者破空而来，在万米高空之上与巨龙展开追逐！」什么的。",
                    "choices": [
                        {
                            "id": "230000404",
                            "text": "确实是在空中追击过…",
                            "response": [
                                {
                                    "id": "230000406",
                                    "speaker": "玛达赫",
                                    "text": "#唔，再比如说…「{M#他}{F#她}只身潜入教会，盗取了寄宿着风神伟力的强大武器！」",
                                    "choices": [
                                        {
                                            "id": "230000407",
                                            "text": "确实是潜入过教会…",
                                            "response": [
                                                {
                                                    "id": "230000409",
                                                    "speaker": "玛达赫",
                                                    "text": "#欸！那这条呢？「最后{M#他}{F#她}看破巨龙弱点，击碎旧日创口。沐浴着龙血成为不死之身！」",
                                                    "choices": [
                                                        {
                                                            "id": "230000410",
                                                            "text": "确实是要瞄准某处…"
                                                        },
                                                        {
                                                            "id": "230000411",
                                                            "text": "只是在净化影响心智的毒血。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "230000408",
                                            "text": "「天空之琴」不是什么武器。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "230000405",
                            "text": "其实是靠风之翼啦…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "2300002",
            "objective": "等候至次日晚间（19-21点）",
            "dialogues": [
                {
                    "id": "230000201",
                    "speaker": "玛达赫",
                    "text": "（test）来来来！全体目光向我看齐！"
                },
                {
                    "id": "230000202",
                    "speaker": "玛达赫",
                    "text": "（test）今天！我宣布个事情！"
                },
                {
                    "id": "230000203",
                    "speaker": "玛达赫",
                    "text": "（test）我是傻逼！"
                }
            ]
        },
        {
            "id": "2300003",
            "objective": "前往咖啡馆与玛达赫对话",
            "dialogues": [
                {
                    "id": "230000301",
                    "speaker": "玛达赫",
                    "text": "欸，这故事都还没开始说，客人怎么就全走光了…"
                },
                {
                    "id": "230000302",
                    "speaker": "玛达赫",
                    "text": "完了，这回是真的连咖啡也要喝不起了…"
                },
                {
                    "id": "230000303",
                    "speaker": "Player",
                    "text": "你遇到什么麻烦了吗？"
                },
                {
                    "id": "230000304",
                    "speaker": "玛达赫",
                    "text": "呃，您是…旅行者？唉…就跟您见着的一样，我平时会在这咖啡馆里讲讲故事，换点咖啡钱。"
                },
                {
                    "id": "230000305",
                    "speaker": "玛达赫",
                    "text": "不过最近愿意捧场的听众越来越少，再这么下去，我怕是连咖啡沫都喝不起了。",
                    "choices": [
                        {
                            "id": "230000306",
                            "text": "像是蒙德的吟游诗人吗…",
                            "response": [
                                {
                                    "id": "230000308",
                                    "speaker": "玛达赫",
                                    "text": "呃…虽然我没亲眼见过，不过听起来，应该差不太多？"
                                },
                                {
                                    "id": "230000309",
                                    "speaker": "玛达赫",
                                    "text": "不过，这古代英雄的传说再怎么精彩，也架不住每天都讲…果然还是得找点新的故事。"
                                },
                                {
                                    "id": "230000310",
                                    "speaker": "玛达赫",
                                    "text": "唉，最好还得是发生在须弥之外的事情，一来足够新鲜好玩，二来嘛…"
                                },
                                {
                                    "id": "230000311",
                                    "speaker": "玛达赫",
                                    "text": "我也好再加工处理，也不担心被人说不对…反正大家都没听过…咳！"
                                },
                                {
                                    "id": "230000312",
                                    "speaker": "玛达赫",
                                    "text": "不过在那之前，我自己还是得先明白要讲的那些故事…"
                                },
                                {
                                    "id": "230000313",
                                    "speaker": "玛达赫",
                                    "text": "您看，我其实也搜集了不少世界各地的故事，比如风龙啦，送仙典仪啦…"
                                },
                                {
                                    "id": "230000314",
                                    "speaker": "玛达赫",
                                    "text": "但这些故事都是我从人家那边打听来的，故事内容肯定被添油加醋过，不太可靠。"
                                },
                                {
                                    "id": "230000315",
                                    "speaker": "玛达赫",
                                    "text": "旅行者，我从冒险家协会那边听说过，您是在到处旅行，对吧？"
                                },
                                {
                                    "id": "230000316",
                                    "speaker": "玛达赫",
                                    "text": "能不能请您和我说说，您在世界各地的见闻？"
                                },
                                {
                                    "id": "230000317",
                                    "speaker": "玛达赫",
                                    "text": "这样的话，我也能修正一下我搜集来的这些故事，不至于讲得太离谱…"
                                },
                                {
                                    "id": "230000318",
                                    "speaker": "玛达赫",
                                    "text": "当然！我讲故事拿到的报酬，也会分给您一份！",
                                    "choices": [
                                        {
                                            "id": "230000319",
                                            "text": "这倒是没问题…",
                                            "response": [
                                                {
                                                    "id": "230000320",
                                                    "speaker": "玛达赫",
                                                    "text": "那就拜托您了！您准备讲哪段见闻？"
                                                },
                                                {
                                                    "id": "230000325",
                                                    "speaker": "Player",
                                                    "text": "故事到处都能打听吧。"
                                                },
                                                {
                                                    "id": "230000326",
                                                    "speaker": "玛达赫",
                                                    "text": "这个么，我其实也搜集了不少世界各地的故事，比如风龙啦，送仙典仪啦…"
                                                },
                                                {
                                                    "id": "230000327",
                                                    "speaker": "玛达赫",
                                                    "text": "但这些故事传到我耳朵里，都不知道被转了多少道，内容肯定被添油加醋过，不太可靠。"
                                                },
                                                {
                                                    "id": "230000328",
                                                    "speaker": "玛达赫",
                                                    "text": "还是得听您这样游历过四方的旅行者讲讲，我才能修正好这些故事，不至于讲得太离谱。"
                                                },
                                                {
                                                    "id": "230000321",
                                                    "speaker": "Player",
                                                    "text": "添油加醋到什么程度？"
                                                },
                                                {
                                                    "id": "230000322",
                                                    "speaker": "玛达赫",
                                                    "text": "咳…就是那种，听起来就知道是胡说八道的程度…"
                                                },
                                                {
                                                    "id": "230000323",
                                                    "speaker": "玛达赫",
                                                    "text": "哈哈哈…比如什么背生双翼的骑士，一人一剑镇压魔神的剑客…我等会给您详细讲讲…"
                                                },
                                                {
                                                    "id": "230000324",
                                                    "speaker": "玛达赫",
                                                    "text": "那我们就开始吧，您准备讲哪段见闻？"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "230000321",
                                            "text": "添油加醋到什么程度？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "230000307",
                            "text": "像是璃月的说书人吗…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "2300004",
            "objective": "前往咖啡馆与玛达赫对话",
            "dialogues": [
                {
                    "id": "230001301",
                    "speaker": "玛达赫",
                    "text": "唉…您也来了啊，旅行者。今天的故事感觉怎么样？"
                },
                {
                    "id": "230001302",
                    "speaker": "Player",
                    "text": "故事挺离谱的…"
                },
                {
                    "id": "230001303",
                    "speaker": "玛达赫",
                    "text": "嗯…和其他客人的评价一样呢。看来是我修饰过度，反而忘了「真实感」。"
                },
                {
                    "id": "230001304",
                    "speaker": "玛达赫",
                    "text": "唉…看来我还得再改改这故事…"
                },
                {
                    "id": "230001305",
                    "speaker": "玛达赫",
                    "text": "多谢您提供的素材，这些报酬还请收下。"
                },
                {
                    "id": "230001306",
                    "speaker": "玛达赫",
                    "text": "以后还有什么故事，记着分享给我啊！"
                }
            ]
        },
        {
            "id": "2300005",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "230000500",
                    "speaker": "Player",
                    "text": "以前在璃月…"
                },
                {
                    "id": "230000501",
                    "speaker": "玛达赫",
                    "text": "嗯？璃月吗…我听商队的人说，那里的诸方势力在神明陨落之际明争暗斗，应该会是个不错的题材。"
                },
                {
                    "id": "230000502",
                    "speaker": "玛达赫",
                    "text": "但从商队那边能打听到的，也只是一些断断续续，听起来还不太靠谱的传言。"
                },
                {
                    "id": "230000503",
                    "speaker": "玛达赫",
                    "text": "比如说…「一名旅行者着手操办了送仙典仪，成为各方势力争相拉拢的对象」什么的。",
                    "choices": [
                        {
                            "id": "230000504",
                            "text": "确实是参与了送仙典仪…",
                            "response": [
                                {
                                    "id": "230000506",
                                    "speaker": "玛达赫",
                                    "text": "#唔，再比如说…「{M#他}{F#她}与漩涡之魔神在海上鏖战，就连那座群玉阁都被凌厉的剑气波及，生生坠入海中！」",
                                    "choices": [
                                        {
                                            "id": "230000507",
                                            "text": "确实是跟魔神对峙过…",
                                            "response": [
                                                {
                                                    "id": "230000509",
                                                    "speaker": "玛达赫",
                                                    "text": "#欸！那这条呢？「最后{M#他}{F#她}凭一己之力调停了仙凡间的矛盾，璃月港就此迎来了新的时代。」",
                                                    "choices": [
                                                        {
                                                            "id": "230000510",
                                                            "text": "确实是平息了矛盾…"
                                                        },
                                                        {
                                                            "id": "230000511",
                                                            "text": "是靠璃月人的共同努力。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "230000508",
                                            "text": "击退魔神的关键是群玉阁。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "230000505",
                            "text": "其实都是在和某人跑腿…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "2300006",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "230000600",
                    "speaker": "Player",
                    "text": "以前在稻妻…"
                },
                {
                    "id": "230000601",
                    "speaker": "玛达赫",
                    "text": "嗯？雷神庇佑的稻妻吗…我听商队的人说，那里有人忤逆了神明颁布的「眼狩令」，应该会是个不错的题材。"
                },
                {
                    "id": "230000602",
                    "speaker": "玛达赫",
                    "text": "但从商队那边能打听到的，都是一些断断续续，听起来还不太靠谱的传言…"
                },
                {
                    "id": "230000603",
                    "speaker": "玛达赫",
                    "text": "比如说，「一位异乡人向愚人众执行官发起决斗，一刀就将对手化为灰烬！」什么的。",
                    "choices": [
                        {
                            "id": "230000604",
                            "text": "确实是赢下了决斗…",
                            "response": [
                                {
                                    "id": "230000606",
                                    "speaker": "玛达赫",
                                    "text": "#唔，再比如说，「{M#他}{F#她}直面将军的威压，毫发无伤地从『无想的一刀』下逃出生天！」",
                                    "choices": [
                                        {
                                            "id": "230000607",
                                            "text": "确实是从刀下逃生了…",
                                            "response": [
                                                {
                                                    "id": "230000609",
                                                    "speaker": "玛达赫",
                                                    "text": "#欸！那这条呢？「最后{M#他}{F#她}从千手百眼神像中汲取力量，扭转了神明的意志…」",
                                                    "choices": [
                                                        {
                                                            "id": "230000610",
                                                            "text": "确实改变了将军的心意…"
                                                        },
                                                        {
                                                            "id": "230000611",
                                                            "text": "制胜关键是大家的「愿望」。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "230000608",
                                            "text": "挡下那一刀的是别人。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "230000605",
                            "text": "降下制裁的是将军啦。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "2300007",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "230000701",
                    "speaker": "玛达赫",
                    "text": "原来如此…虽然没有传言说得那么厉害，但是「真实感」却明显提高了一个层次啊。"
                },
                {
                    "id": "230000702",
                    "speaker": "玛达赫",
                    "text": "简直就像是在向事件的亲历者取材一样，这下传闻里逻辑不通的地方也都能理顺了…"
                },
                {
                    "id": "230000703",
                    "speaker": "玛达赫",
                    "text": "多谢您了，旅行者。这故事我已经想好要怎么讲了，明晚一定要来捧个场啊！"
                }
            ]
        },
        {
            "id": "2300008",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "230000801",
                    "speaker": "玛达赫",
                    "text": "原来如此…这些传言，居然大多都是真的吗？现实果然比故事还要不可思议啊。"
                },
                {
                    "id": "230000802",
                    "speaker": "玛达赫",
                    "text": "不过就是因为不可思议，这些传闻才会广为流传吧？看来我还能再加工一下…"
                },
                {
                    "id": "230000803",
                    "speaker": "玛达赫",
                    "text": "多谢你了，旅行者。这故事我已经想好要怎么讲了，明晚一定要来捧个场啊！"
                }
            ]
        },
        {
            "id": "2300009",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "230000901",
                    "speaker": "玛达赫",
                    "text": "嗯…这里还要再稍作润色…"
                }
            ]
        },
        {
            "id": "2300010",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "230001001",
                    "speaker": "玛达赫",
                    "text": "咳咳，今天要讲的故事发生在遥远的异国。各位请听：「风与巨龙之诗」！"
                },
                {
                    "id": "230001002",
                    "speaker": "玛达赫",
                    "text": "…彼时那巨龙已降临，无人知晓其真名。谁人能解蒙德危急，谁人能救此地生灵？"
                },
                {
                    "id": "230001003",
                    "speaker": "玛达赫",
                    "text": "…命定的勇士展开双翼，手持风神的天空琴。琴弦拨动千风骤起，于此重现移山之伟力！"
                },
                {
                    "id": "230001004",
                    "speaker": "玛达赫",
                    "text": "…勇士怒吼！剑光一闪如陨星！巨龙陨于墟，降龙勇士更无敌！"
                },
                {
                    "id": "230001005",
                    "speaker": "乃亚卜",
                    "text": "这故事…新是新了，怎么感觉处处都讲不通。"
                },
                {
                    "id": "230001006",
                    "speaker": "伊泽姆",
                    "text": "主角一上来就动手，不由分说就把巨龙打倒…总感觉这个故事哪里怪怪的…"
                },
                {
                    "id": "230001007",
                    "speaker": "玛达赫",
                    "text": "呃…那个…今天的故事就到这里，欢迎各位下次再来！哈哈…"
                }
            ]
        },
        {
            "id": "2300011",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "230001101",
                    "speaker": "玛达赫",
                    "text": "咳咳，今天要讲的故事发生在遥远的异国。各位请听：「金发剑侠英雄传」！"
                },
                {
                    "id": "230001102",
                    "speaker": "玛达赫",
                    "text": "…仙祖法蜕自天降，千年岩港生乱象。幸有旅人长袖舞，合纵连横安四方。"
                },
                {
                    "id": "230001103",
                    "speaker": "玛达赫",
                    "text": "…奈何海中大魔陡现，胜负终须战场相见。这二位战至天地色变，周遭万物竟无一幸免。尽皆化作齑粉碎片，群玉阁也生生磨灭！"
                },
                {
                    "id": "230001104",
                    "speaker": "玛达赫",
                    "text": "…沧海既定，争端未平。但见仙凡起龃龉，旅人一龙分二虎。陈词慷慨万众拜服，璃月从此踏上新途！"
                },
                {
                    "id": "230001105",
                    "speaker": "乃亚卜",
                    "text": "这故事…新是新了，怎么感觉处处都讲不通。"
                },
                {
                    "id": "230001106",
                    "speaker": "伊泽姆",
                    "text": "就是啊，主角怎么随随便便就说服了两派人，明明前面连话都不怎么说…"
                },
                {
                    "id": "230001107",
                    "speaker": "玛达赫",
                    "text": "呃…那个…今天的故事就到这里，欢迎各位下次再来！哈哈…"
                }
            ]
        },
        {
            "id": "2300012",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "230001201",
                    "speaker": "玛达赫",
                    "text": "咳咳，今天要讲的故事发生在遥远的异国。各位请听：「异邦人稻妻剑刃谭」！"
                },
                {
                    "id": "230001202",
                    "speaker": "玛达赫",
                    "text": "#…雷鸣响彻远海之外，宿命的旅人将到来。{M#他}{F#她}于诸岛如电光穿梭，{M#他}{F#她}的义举被天下人诉说。"
                },
                {
                    "id": "230001203",
                    "speaker": "玛达赫",
                    "text": "…那魔女恣意跋扈，逃不过败北之命数。那一刀劈山开海，也拦不住旅人的去路！"
                },
                {
                    "id": "230001204",
                    "speaker": "玛达赫",
                    "text": "…还有那千手百眼的石人巨像，驱之以万千愿望的力量。发出雷鸣般轰隆巨响，将阻于道前的诸敌一拍四散！"
                },
                {
                    "id": "230001205",
                    "speaker": "乃亚卜",
                    "text": "这故事…新是新了，怎么感觉处处都讲不通。"
                },
                {
                    "id": "230001206",
                    "speaker": "伊泽姆",
                    "text": "最后突然冒出个巨大石像来解围，感觉像是编不下去了…"
                },
                {
                    "id": "230001207",
                    "speaker": "玛达赫",
                    "text": "呃…那个…今天的故事就到这里，欢迎各位下次再来！哈哈…"
                }
            ]
        },
        {
            "id": "2300014",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "230001401",
                    "speaker": "玛达赫",
                    "text": "咳咳，今天要讲的故事发生在遥远的异国。各位请听：「风与巨龙之诗」！"
                },
                {
                    "id": "230001402",
                    "speaker": "玛达赫",
                    "text": "…彼时那巨龙已降临，无人知晓其真名。谁人能解蒙德危急，谁人能救此地生灵？"
                },
                {
                    "id": "230001403",
                    "speaker": "玛达赫",
                    "text": "…勇士伴风而行，诗人抚琴低吟：何故千年守护一朝弃，只因深渊毒血乱龙心。"
                },
                {
                    "id": "230001404",
                    "speaker": "玛达赫",
                    "text": "…魔风息，毒血净。后世之子孙，勿忘其名姓，此诗献予东风之龙特瓦林！"
                },
                {
                    "id": "230001405",
                    "speaker": "乃亚卜",
                    "text": "嘿！这回的故事可算有点意思了。"
                },
                {
                    "id": "230001406",
                    "speaker": "伊泽姆",
                    "text": "被视作反派的角色其实有着无可奈何的背景…不管在什么故事里都让人动容啊。"
                },
                {
                    "id": "230001407",
                    "speaker": "玛达赫",
                    "text": "今天的故事就到这里，欢迎各位下次再来！"
                }
            ]
        },
        {
            "id": "2300015",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "230001501",
                    "speaker": "玛达赫",
                    "text": "咳咳，今天要讲的故事发生在遥远的异国。各位请听：「金发剑侠英雄传」！"
                },
                {
                    "id": "230001502",
                    "speaker": "玛达赫",
                    "text": "…仙祖法蜕自天降，千年岩港生乱象。云来海下暗潮动，无心旅人入局中。"
                },
                {
                    "id": "230001503",
                    "speaker": "玛达赫",
                    "text": "…纵各方有百千般算计，合力御敌成当务之急。海生漩涡奥赛尔，天悬掩月群玉阁。雕梁画栋付之一陨，散尽千金降下一击！"
                },
                {
                    "id": "230001504",
                    "speaker": "玛达赫",
                    "text": "…岩神治下璃月古来包容万象，而今迎接无神之世又有何妨。离巢雏鸟任翱翔，千年岩港焕新光！"
                },
                {
                    "id": "230001505",
                    "speaker": "乃亚卜",
                    "text": "嘿！这回的故事可算有点意思了。"
                },
                {
                    "id": "230001506",
                    "speaker": "伊泽姆",
                    "text": "起初互有矛盾的双方，在并肩作战的过程中建立了信赖…这种展开真是百听不厌啊。"
                },
                {
                    "id": "230001507",
                    "speaker": "玛达赫",
                    "text": "今天的故事就到这里，欢迎各位下次再来！"
                }
            ]
        },
        {
            "id": "2300016",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "230001601",
                    "speaker": "玛达赫",
                    "text": "咳咳，今天要讲的故事发生在遥远的异国。各位请听：「异邦人稻妻剑刃谭」！"
                },
                {
                    "id": "230001602",
                    "speaker": "玛达赫",
                    "text": "#…雷鸣响彻远海之外，宿命的旅人将到来。{M#他}{F#她}于诸岛如电光穿梭，{M#他}{F#她}的义举被天下人诉说。"
                },
                {
                    "id": "230001603",
                    "speaker": "玛达赫",
                    "text": "…那执行官折戟御前，自食傲慢苦果。旅人的同伴们挺身相救，挡下雷霆之祸！"
                },
                {
                    "id": "230001604",
                    "speaker": "玛达赫",
                    "text": "…净土高悬万千星光，正是凡人心中梦想。终有地上生灵，能撼天上威光！"
                },
                {
                    "id": "230001605",
                    "speaker": "乃亚卜",
                    "text": "嘿！这回的故事可算有点意思了。"
                },
                {
                    "id": "230001606",
                    "speaker": "伊泽姆",
                    "text": "嗯…和伙伴一起渡过难关吗，这才是英雄故事该有的样子嘛。"
                },
                {
                    "id": "230001607",
                    "speaker": "玛达赫",
                    "text": "今天的故事就到这里，欢迎各位下次再来！"
                }
            ]
        },
        {
            "id": "2300017",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "230001701",
                    "speaker": "玛达赫",
                    "text": "嘿！您也来了啊，旅行者。今天的故事感觉怎么样？",
                    "choices": [
                        {
                            "id": "230001702",
                            "text": "还挺有意思。",
                            "response": [
                                {
                                    "id": "230001704",
                                    "speaker": "玛达赫",
                                    "text": "哈哈，和其他客人的评价一样呢。一个新的时代里，会出现新的英雄、新的故事。"
                                },
                                {
                                    "id": "230001705",
                                    "speaker": "玛达赫",
                                    "text": "多亏了他们，我们这行才能干得长远…哦，当然也得谢谢您，这下我应该能喝杯好点的咖啡了。"
                                },
                                {
                                    "id": "230001706",
                                    "speaker": "玛达赫",
                                    "text": "多谢您提供的素材，这些报酬还请收下。"
                                },
                                {
                                    "id": "230001707",
                                    "speaker": "玛达赫",
                                    "text": "以后还有什么故事，记着分享给我啊！"
                                }
