    "talks": [
        {
            "id": "7051701",
            "objective": "前往派蒙指示的地点",
            "dialogues": [
                {
                    "id": "705170101",
                    "speaker": "派蒙",
                    "text": "这一带看起来很普通呢。"
                },
                {
                    "id": "705170102",
                    "speaker": "派蒙",
                    "text": "好像找不到什么吃的…",
                    "choices": [
                        {
                            "id": "705170103",
                            "text": "说漏嘴了，派蒙。",
                            "response": [
                                {
                                    "id": "705170105",
                                    "speaker": "派蒙",
                                    "text": "咳咳，调查秘密的过程中也是要吃东西的，这是人之常情嘛！"
                                },
                                {
                                    "id": "705170106",
                                    "speaker": "派蒙",
                                    "text": "再说了，最近我们图省事，吃了好多好多烧烤，你也有点腻了吧？"
                                },
                                {
                                    "id": "705170107",
                                    "speaker": "派蒙",
                                    "text": "如果我们能在沙滩上捡到贝壳或海螺，就把它们和水果一起炖着吃。"
                                },
                                {
                                    "id": "705170108",
                                    "speaker": "派蒙",
                                    "text": "鲜鲜的，甜甜的，弹弹的…",
                                    "choices": [
                                        {
                                            "id": "705170109",
                                            "text": "听起来好黑暗，我才不要。",
                                            "response": [
                                                {
                                                    "id": "705170110",
                                                    "speaker": "派蒙",
                                                    "text": "试试看嘛，说不定会打开新世界的大门！"
                                                },
                                                {
                                                    "id": "705170113",
                                                    "speaker": "派蒙",
                                                    "text": "#等等，{NICKNAME}，你看那边。"
                                                },
                                                {
                                                    "id": "705170114",
                                                    "speaker": "派蒙",
                                                    "text": "突然出现的机关…好像有蹊跷？"
                                                },
                                                {
                                                    "id": "705170115",
                                                    "speaker": "派蒙",
                                                    "text": "附近还有一些行李货物，是愚人众的东西吗？"
                                                },
                                                {
                                                    "id": "705170116",
                                                    "speaker": "Player",
                                                    "text": "还真被派蒙说中了，好耶。"
                                                },
                                                {
                                                    "id": "705170117",
                                                    "speaker": "派蒙",
                                                    "text": "我的预感果然很靠谱，好耶…"
                                                },
                                                {
                                                    "id": "705170118",
                                                    "speaker": "派蒙",
                                                    "text": "什么好耶，呸呸呸！明明是我们有麻烦了！"
                                                },
                                                {
                                                    "id": "705170119",
                                                    "speaker": "派蒙",
                                                    "text": "既然是和愚人众有关的东西，出现在这里，就很可能有阴谋。"
                                                },
                                                {
                                                    "id": "705170120",
                                                    "speaker": "派蒙",
                                                    "text": "如果放着它们不管，说不定又会不停发展，变得很难办。"
                                                },
                                                {
                                                    "id": "705170121",
                                                    "speaker": "派蒙",
                                                    "text": "总之，先试着处理那个机关吧？如果你觉得有必要，再调查一下愚人众的货物。"
                                                },
                                                {
                                                    "id": "705170122",
                                                    "speaker": "派蒙",
                                                    "text": "#{NICKNAME}，拿出以前的干劲，搞定它们以后，我们就能安心找食材了！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "705170111",
                                            "text": "听起来是派蒙会有的口感。",
                                            "response": [
                                                {
                                                    "id": "705170112",
                                                    "speaker": "派蒙",
                                                    "text": "喂！人家可不是水产！"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "705170104",
                            "text": "难怪你这么积极。"
                        }
                    ]
                }
            ]
        }
    ]
}