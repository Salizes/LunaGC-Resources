    "talks": [
        {
            "id": "7471101",
            "objective": "与希格雯对话",
            "dialogues": [
                {
                    "id": "747110101",
                    "speaker": "希格雯",
                    "text": "嗯！一切顺利…"
                },
                {
                    "id": "747110102",
                    "speaker": "希格雯",
                    "text": "现在我可以确定了，救治狂暴鱼儿们的工作，已经进入了最后阶段。"
                },
                {
                    "id": "747110103",
                    "speaker": "希格雯",
                    "text": "除了再找回一些病患鱼儿，查漏补缺，还有一个特别的任务——"
                },
                {
                    "id": "747110104",
                    "speaker": "希格雯",
                    "text": "从受到影响的水域，找出关键的水下机关，回收它们的探测设备所记录的资料…",
                    "choices": [
                        {
                            "id": "747110105",
                            "text": "然后从中找出相关的规律…",
                            "response": [
                                {
                                    "id": "747110107",
                                    "speaker": "希格雯",
                                    "text": "没错哦。"
                                },
                                {
                                    "id": "747110108",
                                    "speaker": "派蒙",
                                    "text": "还要给船主和潜水员提个醒，总结一下这次的教训。"
                                },
                                {
                                    "id": "747110109",
                                    "speaker": "希格雯",
                                    "text": "嗯，还有渔民和游客，在水面上坐船，在水下潜水的人…"
                                },
                                {
                                    "id": "747110110",
                                    "speaker": "希格雯",
                                    "text": "所有和水域打交道的人都要留个心眼，可别随意乱丢东西，搞得水域环境一团糟。"
                                },
                                {
                                    "id": "747110111",
                                    "speaker": "希格雯",
                                    "text": "不然，可能会有暴躁的鱼儿来掀翻你的小船哦。"
                                }
                            ]
                        },
                        {
                            "id": "747110106",
                            "text": "以便之后防治类似的事故？"
                        }
                    ]
                }
            ]
        }
    ]
}