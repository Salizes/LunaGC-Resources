    "talks": [
        {
            "id": "7503301",
            "objective": "与众人对话",
            "dialogues": [
                {
                    "id": "750330101",
                    "speaker": "阿科米蒂",
                    "text": "为什么我非得坚持不可，我就不能放弃吗…我不干了！姐姐，你帮帮我。"
                },
                {
                    "id": "750330102",
                    "speaker": "马塔伽",
                    "text": "丢人！白长了这么大个子，碰到一点困难就想逃跑还算是勇士吗？你这家伙居然是我的同胞哥哥。"
                },
                {
                    "id": "750330103",
                    "speaker": "阿科米蒂",
                    "text": "你就没有想不出办法，要找人帮忙的时候吗？"
                },
                {
                    "id": "750330104",
                    "speaker": "马塔伽",
                    "text": "有。我是回来找爸爸和姐姐，让他们检验我特训成果的。我不会像你那么没骨气！"
                },
                {
                    "id": "750330105",
                    "speaker": "曼尤雅",
                    "text": "阿科米蒂，我觉得队长拒绝你的退队申请是希望你想想清楚，不要在情绪剧烈波动的时候做决定。"
                },
                {
                    "id": "750330106",
                    "speaker": "曼尤雅",
                    "text": "平静下来之后靠你自己做出决定吧，将来别后悔就好。"
                },
                {
                    "id": "750330107",
                    "speaker": "曼尤雅",
                    "text": "我已经退役了，自己都不知道自己该干什么，恐怕没资格指导你。"
                },
                {
                    "id": "750330108",
                    "speaker": "派蒙",
                    "text": "没想到你们三个人是一家子。",
                    "choices": [
                        {
                            "id": "750330109",
                            "text": "好意外。",
                            "response": [
                                {
                                    "id": "750330111",
                                    "speaker": "三人",
                                    "text": "是你们？！"
                                },
                                {
                                    "id": "750330112",
                                    "speaker": "阿科米蒂",
                                    "text": "坏消息，恩人，逃跑计划失败了。",
                                    "choices": [
                                        {
                                            "id": "750330113",
                                            "text": "意料之中。",
                                            "response": [
                                                {
                                                    "id": "750330115",
                                                    "speaker": "阿科米蒂",
                                                    "text": "就没有办法让我摆脱这种痛苦吗？当勇士怎么这么累，所有的一切凭什么不能简单点？"
                                                },
                                                {
                                                    "id": "750330116",
                                                    "speaker": "？？？",
                                                    "text": "还在想飞行队的事啊…"
                                                },
                                                {
                                                    "id": "750330117",
                                                    "speaker": "？？？",
                                                    "text": "抱歉，阿科米蒂，按我的经验来看，应该简单不了。"
                                                },
                                                {
                                                    "id": "750330118",
                                                    "speaker": "？？？",
                                                    "text": "我刚修好马塔伽的护手，曼尤雅，你的护手要不要顺带修了…哦？我们有客人来了。"
                                                },
                                                {
                                                    "id": "750330119",
                                                    "speaker": "曼尤雅",
                                                    "text": "#爸爸，这是我们在外面训练的时候遇到的冒险家，{M#他们}{F#她们}还帮了阿科米蒂的忙。"
                                                },
                                                {
                                                    "id": "750330120",
                                                    "speaker": "库约尼",
                                                    "text": "你们好，热心的朋友。叫我库约尼就行，我是个训练师，也是这几个孩子的父亲。"
                                                },
                                                {
                                                    "id": "750330121",
                                                    "speaker": "派蒙",
                                                    "text": "阿科米蒂的状态好像很糟糕，大叔，需要帮忙的话可以叫我们。"
                                                },
                                                {
                                                    "id": "750330122",
                                                    "speaker": "库约尼",
                                                    "text": "谢谢你们，不过我不觉得阿科米蒂有什么问题。"
                                                },
                                                {
                                                    "id": "750330123",
                                                    "speaker": "派蒙",
                                                    "text": "欸，大叔不打算管他了吗？"
                                                },
                                                {
                                                    "id": "750330124",
                                                    "speaker": "库约尼",
                                                    "text": "哈哈，我的意思是…这样说吧，你们是冒险家的话，应该加入过冒险家协会吧。"
                                                },
                                                {
                                                    "id": "750330125",
                                                    "speaker": "库约尼",
                                                    "text": "了不起啊，这样的组织，所谓冒险家是为了探索世界才行动的人对吧？"
                                                },
                                                {
                                                    "id": "750330126",
                                                    "speaker": "库约尼",
                                                    "text": "要问具体动机的话，每个冒险家都不同。有的是为了金钱，有的是出于求知欲，有的单纯是闲着无聊。"
                                                },
                                                {
                                                    "id": "750330127",
                                                    "speaker": "库约尼",
                                                    "text": "把这样的人统合起来，让他们承认同一个口号，是很厉害的事。"
                                                },
                                                {
                                                    "id": "750330128",
                                                    "speaker": "库约尼",
                                                    "text": "像我，一个从飞行队驭龙师的位置上退役了的大叔，后来去做了部族里的训练师，就没法想象六个部族的训练师联合起来建立一个协会是什么样子。"
                                                },
                                                {
                                                    "id": "750330129",
                                                    "speaker": "派蒙",
                                                    "text": "唔…这和阿科米蒂的事情有关系吗？"
                                                },
                                                {
                                                    "id": "750330130",
                                                    "speaker": "曼尤雅",
                                                    "text": "爸爸说话就是这样。以前他还在飞行队的时候，包括绒翼龙在内，所有的飞行队成员都愿意听他的意见。"
                                                },
                                                {
                                                    "id": "750330131",
                                                    "speaker": "曼尤雅",
                                                    "text": "现在爸爸是部族的训练师，所有想要成为勇士的人都会来问他的意见，不用急，听听他的话吧。"
                                                },
                                                {
                                                    "id": "750330132",
                                                    "speaker": "库约尼",
                                                    "text": "那都是过去的事了，曼尤雅，不过我还是说完吧。"
                                                },
                                                {
                                                    "id": "750330133",
                                                    "speaker": "库约尼",
                                                    "text": "我们所有的训练师都是因为向往「勇士」这个形象，才会花那么多精力去布置、设计训练项目。"
                                                },
                                                {
                                                    "id": "750330134",
                                                    "speaker": "库约尼",
                                                    "text": "大家都想要看见自己梦想中那个最了不起的勇士出现，但那个勇士到底该是什么样子，谁也不能规定。"
                                                },
                                                {
                                                    "id": "750330135",
                                                    "speaker": "库约尼",
                                                    "text": "所以我们这些训练师根本没办法搞出个协会，什么原则、章程，根本写不出来嘛。"
                                                },
                                                {
                                                    "id": "750330136",
                                                    "speaker": "库约尼",
                                                    "text": "那个最了不起的勇士拥有一千万张脸，一千万种性格。"
                                                },
                                                {
                                                    "id": "750330137",
                                                    "speaker": "库约尼",
                                                    "text": "那个谁都想成为的勇士一会儿意志坚定，一会儿自我怀疑，还会衰老，会死亡。"
                                                },
                                                {
                                                    "id": "750330138",
                                                    "speaker": "库约尼",
                                                    "text": "勇士不会倦怠吗？我可以举出记载在织物上的很多例子，证明自我怀疑和倦怠会平等地困扰每一个人。"
                                                },
                                                {
                                                    "id": "750330139",
                                                    "speaker": "库约尼",
                                                    "text": "勇士非得生得高大吗？我知道很多长得有巨人那么高，但是卑劣得让人呕吐的人，他们的事也被记载在织物上了。"
                                                },
                                                {
                                                    "id": "750330140",
                                                    "speaker": "库约尼",
                                                    "text": "勇士当然也会衰弱，这是自然的规律。"
                                                },
                                                {
                                                    "id": "750330141",
                                                    "speaker": "库约尼",
                                                    "text": "我的孩子们称呼我为勇士，但看看我吧，我现在已经不飞了，老鸟是没有力气再飞的。"
                                                },
                                                {
                                                    "id": "750330142",
                                                    "speaker": "库约尼",
                                                    "text": "一个长着一张完美的脸的勇士，一切都合乎一个无聊标准的人，不会是我们纳塔承认的英雄。"
                                                },
                                                {
                                                    "id": "750330143",
                                                    "speaker": "库约尼",
                                                    "text": "我的曼尤雅、阿科米蒂、马塔伽，我带你们到飞屋上来，因为你们要做花羽会的英雄，从很高的地方往下看。"
                                                },
                                                {
                                                    "id": "750330144",
                                                    "speaker": "库约尼",
                                                    "text": "你们的烦恼与渴望都是英雄漫长征途上一瞬的状态，不是什么该被解决的问题。"
                                                },
                                                {
                                                    "id": "750330145",
                                                    "speaker": "库约尼",
                                                    "text": "离开飞行队就不是勇士了吗？进入飞行队就一定是勇士了吗？没有这种话。"
                                                },
                                                {
                                                    "id": "750330146",
                                                    "speaker": "库约尼",
                                                    "text": "有雄心壮志也行，犹豫不决也没什么，失落也正常，你是个勇士，勇士必须有所经历才成为英雄。"
                                                },
                                                {
                                                    "id": "750330147",
                                                    "speaker": "库约尼",
                                                    "text": "和自己的状态共存，靠自己习惯它，战胜它，不要反过来被它支配。"
                                                },
                                                {
                                                    "id": "750330148",
                                                    "speaker": "库约尼",
                                                    "text": "这是纳塔的做法，英雄的做法，明白吗？"
                                                },
                                                {
                                                    "id": "750330149",
                                                    "speaker": "曼尤雅",
                                                    "text": "我知道你的意思了，爸爸。"
                                                },
                                                {
                                                    "id": "750330150",
                                                    "speaker": "库约尼",
                                                    "text": "阿科米蒂，你还是犹豫吗？"
                                                },
                                                {
                                                    "id": "750330151",
                                                    "speaker": "阿科米蒂",
                                                    "text": "……"
                                                },
                                                {
                                                    "id": "750330152",
                                                    "speaker": "库约尼",
                                                    "text": "一个劲地讲大道理不是我们家的作风，去跟你的姐姐还有弟弟飞一次吧，就像你小时候那样。"
                                                },
                                                {
                                                    "id": "750330153",
                                                    "speaker": "库约尼",
                                                    "text": "让你的身心一起做决定，窝在屋子里闷闷地动死脑筋想不出好主意。"
                                                },
                                                {
                                                    "id": "750330154",
                                                    "speaker": "阿科米蒂",
                                                    "text": "我知道了，爸爸。"
                                                },
                                                {
                                                    "id": "750330155",
                                                    "speaker": "派蒙",
                                                    "text": "#训练大师说话这么抽象的吗？我感觉自己没有听懂，{NICKNAME}你听懂了吗？",
                                                    "choices": [
                                                        {
                                                            "id": "750330156",
                                                            "text": "听懂了，总之是飞行挑战。",
                                                            "response": [
                                                                {
                                                                    "id": "750330158",
                                                                    "speaker": "库约尼",
                                                                    "text": "冒险家，我听孩子们说了你的事，你是个有意思的年轻人。"
                                                                },
                                                                {
                                                                    "id": "750330159",
                                                                    "speaker": "库约尼",
                                                                    "text": "有胆量和曼尤雅比赛，帮阿科米蒂这小子的忙，马塔伽也认同你，是个勇士。"
                                                                },
                                                                {
                                                                    "id": "750330160",
                                                                    "speaker": "库约尼",
                                                                    "text": "我想邀请你跟这几个孩子一起飞一次。你觉得怎么样？",
                                                                    "choices": [
                                                                        {
                                                                            "id": "750330161",
                                                                            "text": "来吧。",
                                                                            "response": [
                                                                                {
                                                                                    "id": "750330163",
                                                                                    "speaker": "库约尼",
                                                                                    "text": "哈哈，好。你要是想好了就过来和我们说一声。"
                                                                                },
                                                                                {
                                                                                    "id": "750330164",
                                                                                    "speaker": "库约尼",
                                                                                    "text": "我这三个孩子都是花羽会顶尖的飞行好手，你们一起飞应该会很痛快的。"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "750330162",
                                                                            "text": "让我考虑一下。"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "750330157",
                                                            "text": "没听懂，家庭教育太深奥了。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "750330114",
                                            "text": "（耸耸肩）"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "750330110",
                            "text": "倒是不难猜到。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7503308",
            "objective": "(test)失败原因-离开范围or超出保底时间$HIDDEN",
            "dialogues": [
                {
                    "id": "750330801",
                    "speaker": "马塔伽",
                    "text": "又是追逐赛吗？哈哈，你们等着瞧吧！"
                },
                {
                    "id": "750330802",
                    "speaker": "曼尤雅",
                    "text": "你小子很有自信嘛，阿科米蒂，我们两个可不能输啊。"
                },
                {
                    "id": "750330803",
                    "speaker": "阿科米蒂",
                    "text": "输给大姐就算了，马塔伽这个家伙我绝对不要输给他。"
                },
                {
                    "id": "750330804",
                    "speaker": "阿科米蒂",
                    "text": "#{NICKNAME}，你也加油，当心马塔伽这小子留后手，他从以前就喜欢来这招。"
                },
                {
                    "id": "750330805",
                    "speaker": "阿科米蒂",
                    "text": "你准备好了之后，记得找爸爸说一声，我们一起飞。"
                }
            ]
        },
        {
            "id": "7503307",
            "objective": "(test)失败原因-距离目标物太远$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7503302",
            "objective": "与库约尼对话开启飞行比赛",
            "dialogues": [
                {
                    "id": "750331001",
                    "speaker": "库约尼",
                    "text": "飞得不错，年轻人！哈哈哈哈！"
                },
                {
                    "id": "750331002",
                    "speaker": "库约尼",
                    "text": "不过想要超过这几个孩子还得再多练习几次，很少有人能一蹴而就，别放在心上。"
                },
                {
                    "id": "750331003",
                    "speaker": "库约尼",
                    "text": "还想再试试的话，来找我就好。"
                }
            ]
        },
        {
            "id": "7503305",
            "objective": "完成飞行比赛",
            "dialogues": [
                {
                    "id": "750330501",
                    "speaker": "马塔伽",
                    "text": "哈哈，抱歉，这次被我抢先了！"
                },
                {
                    "id": "750330502",
                    "speaker": "阿科米蒂",
                    "text": "这小子从以前就这样，总是半道发力，你很烦啊马塔伽！"
                },
                {
                    "id": "750330503",
                    "speaker": "马塔伽",
                    "text": "不服气的话，就努力追上我吧！哈哈！"
                }
            ]
        },
        {
            "id": "7503306",
            "objective": "与马塔伽对话",
            "dialogues": []
        },
        {
            "id": "7503303",
            "objective": "完成飞行比赛",
            "dialogues": []
        },
        {
            "id": "7503304",
            "objective": "与库约尼对话",
            "dialogues": [
                {
                    "id": "750330401",
                    "speaker": "库约尼",
                    "text": "飞得不错，年轻人！"
                },
                {
                    "id": "750330402",
                    "speaker": "阿科米蒂",
                    "text": "恩人，刚才你觉得我飞得怎么样？",
                    "choices": [
                        {
                            "id": "750330403",
                            "text": "很好。",
                            "response": [
                                {
                                    "id": "750330405",
                                    "speaker": "阿科米蒂",
                                    "text": "谢谢你愿意给我这些肯定，我看得出来和你相比，我飞得并不好。"
                                },
                                {
                                    "id": "750330406",
                                    "speaker": "马塔伽",
                                    "text": "阿科米蒂…"
                                },
                                {
                                    "id": "750330407",
                                    "speaker": "阿科米蒂",
                                    "text": "不是你们想的那样，我不是因为比不过别人又沮丧了。我是能飞的，我自己知道。"
                                },
                                {
                                    "id": "750330408",
                                    "speaker": "阿科米蒂",
                                    "text": "只是长期处在糟糕的状态里，破坏了我对自己的信任，就算能飞好也没办法从容面对。"
                                },
                                {
                                    "id": "750330409",
                                    "speaker": "阿科米蒂",
                                    "text": "#{NICKNAME}不会这样，{M#他}{F#她}的飞姿就自在得多，大家都能看出来。"
                                },
                                {
                                    "id": "750330410",
                                    "speaker": "阿科米蒂",
                                    "text": "爸爸，我知道你和姐姐希望我自己做决定，不要逃避。"
                                },
                                {
                                    "id": "750330411",
                                    "speaker": "阿科米蒂",
                                    "text": "如果我现在告诉你们，不管是我的身体，大脑还是心…"
                                },
                                {
                                    "id": "750330412",
                                    "speaker": "阿科米蒂",
                                    "text": "都不愿意在不适合自己的道路上继续走下去，你们还会支持我吗？"
                                },
                                {
                                    "id": "750330413",
                                    "speaker": "曼尤雅",
                                    "text": "没关系，只要是你自己做出的决定，只要你愿意承担后果。"
                                },
                                {
                                    "id": "750330414",
                                    "speaker": "阿科米蒂",
                                    "text": "马塔伽，你会…"
                                },
                                {
                                    "id": "750330415",
                                    "speaker": "马塔伽",
                                    "text": "停！别以为我会在这时候跳出来指责你，我哥哥是什么性格我一直知道。"
                                },
                                {
                                    "id": "750330416",
                                    "speaker": "马塔伽",
                                    "text": "受不了就果断放弃，只要坦荡你就算勇士，谁也没资格批评你。"
                                },
                                {
                                    "id": "750330417",
                                    "speaker": "库约尼",
                                    "text": "有的时候，训练大师的工作还是挺轻松的，我为勇士们制定训练计划，自己却不用上场。"
                                },
                                {
                                    "id": "750330418",
                                    "speaker": "库约尼",
                                    "text": "不过，你们的父亲我曾经也过着成天和龙一起飞来飞去的日子，知道这种生活的真正滋味。"
                                },
                                {
                                    "id": "750330419",
                                    "speaker": "库约尼",
                                    "text": "批评别人很容易，放手去做永远比简单动动嘴皮子难。"
                                },
                                {
                                    "id": "750330420",
                                    "speaker": "库约尼",
                                    "text": "作为一个训练师，我建议你申请休假调整身心状态，哪怕这会引起队里的不满，你也该这么做。"
                                },
                                {
                                    "id": "750330421",
                                    "speaker": "库约尼",
                                    "text": "作为一个父亲，知道你不愿意再继续，我尊重你的选择。"
                                },
                                {
                                    "id": "750330422",
                                    "speaker": "库约尼",
                                    "text": "就算不在飞行队待着了，也没什么大不了，花羽会的勇士也不是只有通过飞行才能证明自己的价值。"
                                },
                                {
                                    "id": "750330423",
                                    "speaker": "阿科米蒂",
                                    "text": "谢谢你们…我还担心…"
                                },
                                {
                                    "id": "750330424",
                                    "speaker": "曼尤雅",
                                    "text": "别想太多，我们是你的家人，有什么事我们都会帮你一起想办法。"
                                },
                                {
                                    "id": "750330425",
                                    "speaker": "派蒙",
                                    "text": "做勇士也不容易啊，没想到进入花羽会的飞行队这么辛苦。",
                                    "choices": [
                                        {
                                            "id": "750330426",
                                            "text": "我们有我们的辛苦。",
                                            "response": [
                                                {
                                                    "id": "750330427",
                                                    "speaker": "派蒙",
                                                    "text": "也是哦，想想我们这一路上遇到的各种事情，都挺过来了我还觉得怪骄傲的。"
                                                },
                                                {
                                                    "id": "750330430",
                                                    "speaker": "库约尼",
                                                    "text": "成为勇士本来就不简单，要从勇士成长为英雄更难。"
                                                },
                                                {
                                                    "id": "750330431",
                                                    "speaker": "库约尼",
                                                    "text": "见的勇士多了，什么样的人拥有成为英雄的气度，我还是能看得出来的。"
                                                },
                                                {
                                                    "id": "750330432",
                                                    "speaker": "库约尼",
                                                    "text": "年轻人，你已经经历了很多磨炼吧，你的眼睛这样告诉我。",
                                                    "choices": [
                                                        {
                                                            "id": "750330433",
                                                            "text": "你难以想象。",
                                                            "response": [
                                                                {
                                                                    "id": "750330435",
                                                                    "speaker": "库约尼",
                                                                    "text": "看来我没有看走眼。你的路和我们不同，或许你还要走很远，而我很乐意为未来的英雄提供助力。"
                                                                },
                                                                {
                                                                    "id": "750330436",
                                                                    "speaker": "库约尼",
                                                                    "text": "更何况你和我们一家相识一场，这样吧，我也没有什么其他能做的事。"
                                                                },
                                                                {
                                                                    "id": "750330437",
                                                                    "speaker": "库约尼",
                                                                    "text": "如果你想要使用这里的训练赛道，只要和我说一声，随时都可以从这里起飞。"
                                                                },
                                                                {
                                                                    "id": "750330438",
                                                                    "speaker": "Player",
                                                                    "text": "谢谢。"
                                                                },
                                                                {
                                                                    "id": "750330439",
                                                                    "speaker": "库约尼",
                                                                    "text": "不用客气，我很期待看到你成为英雄，在天空闪耀的那一刻。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "750330434",
                                                            "text": "（保持沉默）"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "750330428",
                                            "text": "勇士不是谁都可以当的。",
                                            "response": [
                                                {
                                                    "id": "750330429",
                                                    "speaker": "派蒙",
                                                    "text": "好严格啊，但想想也是。算啦，反正我可不想为了成为勇士，每天那么辛苦训练。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "750330404",
                            "text": "还行。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7503309",
            "objective": "与库约尼对话",
            "dialogues": []
        },
        {
            "id": "7503302",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "750330201",
                    "speaker": "库约尼",
                    "text": "来跟我的孩子飞一次吧，年轻人，能跟花羽会的飞行好手一起竞速的机会可不多。"
                },
                {
                    "id": "750330202",
                    "speaker": "库约尼",
                    "text": "去追追看赛道上的<color=#00E1FFFF>飞行火炬</color>，谁先追上谁就是赢家，这几个孩子还小的时候我就是这么训练他们的。"
                },
                {
                    "id": "750330203",
                    "speaker": "库约尼",
                    "text": "<color=#00E1FFFF>火炬被一个气球提着，点缀着红色的羽毛</color>，象征着勇士应当承担的责任与荣誉，是我做给他们的。"
                },
                {
                    "id": "750330204",
                    "speaker": "库约尼",
                    "text": "你看到就能认出来，怎么样，来试试？",
                    "choices": [
                        {
                            "id": "750330205",
                            "text": "我准备好了。",
                            "response": [
                                {
                                    "id": "750330206",
                                    "speaker": "库约尼",
                                    "text": "哈哈好，那就去起点预备吧。"
                                }
                            ]
                        },
                        {
                            "id": "750330207",
                            "text": "我还要再准备一下。",
                            "response": [
                                {
                                    "id": "750330208",
                                    "speaker": "库约尼",
                                    "text": "那我们就等你准备好再说。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7503306",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "750330601",
                    "speaker": "马塔伽",
                    "text": "#哎呀，我又输了，练了这么久结果还是输给{M#他}{F#她}了。"
                },
                {
                    "id": "750330602",
                    "speaker": "阿科米蒂",
                    "text": "早就告诉你了，总是想着赢是不会有尽头的，我真羡慕你这种只知道往前冲，什么都不怕的劲头。"
                },
                {
                    "id": "750330603",
                    "speaker": "曼尤雅",
                    "text": "阿科米蒂小一点的时候也是这样的，那会儿天天跟在我屁股后面说想要当驯龙大师呢。"
                },
                {
                    "id": "750330604",
                    "speaker": "阿科米蒂",
                    "text": "别取笑我了，姐姐…"
                },
                {
                    "id": "750330605",
                    "speaker": "库约尼",
                    "text": "你们都是我的好孩子，也都是勇士，所有的勇士在不同的阶段要面对不同的问题。"
                },
                {
                    "id": "750330606",
                    "speaker": "库约尼",
                    "text": "这没关系，只要做到无愧于心，我以你们为傲。"
                }
            ]
        },
        {
            "id": "7503311",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "750331101",
                    "speaker": "库约尼",
                    "text": "飞得不错，年轻人！哈哈哈哈！"
                },
                {
                    "id": "750331102",
                    "speaker": "库约尼",
                    "text": "不过想要超过这几个孩子还得再多练习几次，很少有人能一蹴而就，别放在心上。"
                },
                {
                    "id": "750331103",
                    "speaker": "库约尼",
                    "text": "还想再试试的话，来找我就好。"
                }
            ]
        },
        {
            "id": "7503399",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "750339901",
                    "speaker": "(test)派蒙",
                    "text": "(test)可恶，快追上去！不要轻敌啊！"
                }
            ]
        }
    ]
}