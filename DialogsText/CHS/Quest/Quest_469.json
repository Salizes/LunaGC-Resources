        {
            "id": "46902",
            "objective": "将风神瞳供奉给神像",
            "dialogues": [
                {
                    "id": "4690201",
                    "speaker": "派蒙",
                    "text": "感受到七天神像的赐福了吗？"
                },
                {
                    "id": "4690202",
                    "speaker": "派蒙",
                    "text": "在蒙德，人们把那种凝固的风叫做「散失的风神瞳」。"
                },
                {
                    "id": "4690203",
                    "speaker": "派蒙",
                    "text": "这个名字代表的是：它有资格被镶嵌在神像的眼眶里。"
                },
                {
                    "id": "4690204",
                    "speaker": "派蒙",
                    "text": "有童话说，是燕子衔走了作为眼睛的宝石…"
                },
                {
                    "id": "4690205",
                    "speaker": "派蒙",
                    "text": "但其实「散失的风神瞳」本来就没有实体。"
                },
                {
                    "id": "4690207",
                    "speaker": "派蒙",
                    "text": "拥有「神之眼」的人会注意收集它们，送去七天神像，获取赐福。"
                },
                {
                    "id": "4690208",
                    "speaker": "派蒙",
                    "text": "虽然你没有「神之眼」，但你超脱这个世界的常理…"
                },
                {
                    "id": "4690209",
                    "speaker": "派蒙",
                    "text": "继续向神像供奉风神瞳，也许会获得更多赐福哦！"
                }
            ]
        },
        {
            "id": "46903",
            "objective": "与派蒙对话",
            "dialogues": []
        },
        {
            "id": "46900",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "4690001",
                    "speaker": "派蒙",
                    "text": "是七天神像！"
                },
                {
                    "id": "4690002",
                    "speaker": "派蒙",
                    "text": "#来看看{NICKNAME}的供奉，能不能得到神的回应吧。"
                },
                {
                    "id": "4690003",
                    "speaker": "派蒙",
                    "text": "啊，是这种好像凝固的风一样的东西…"
                },
                {
                    "id": "4690004",
                    "speaker": "派蒙",
                    "text": "#{NICKNAME}，我们去风起地的那座七天神像一趟吧！去把它供奉给神。"
                },
                {
                    "id": "4690005",
                    "speaker": "派蒙",
                    "text": "嗯…总之先跟我来，详细的事我一会再告诉你。"
                }
            ]
        }
    ]
