    "talks": [
        {
            "id": "1201801",
            "objective": "前往鹰司家的隐秘驻地",
            "dialogues": []
        },
        {
            "id": "1201802",
            "objective": "进入隐秘驻地",
            "dialogues": []
        },
        {
            "id": "1201803",
            "objective": "与影交谈",
            "dialogues": [
                {
                    "id": "120180301",
                    "speaker": "派蒙",
                    "text": "呜哇，居然有这么隐蔽的地方！"
                },
                {
                    "id": "120180302",
                    "speaker": "影",
                    "text": "一般来说，没有理由在深山中修建这样的建筑。",
                    "choices": [
                        {
                            "id": "120180303",
                            "text": "可能是危机避难所。",
                            "response": [
                                {
                                    "id": "120180305",
                                    "speaker": "影",
                                    "text": "我感觉到了不属于此地的气息，危险的气息。"
                                },
                                {
                                    "id": "120180306",
                                    "speaker": "派蒙",
                                    "text": "欸？"
                                },
                                {
                                    "id": "120180307",
                                    "speaker": "影",
                                    "text": "小心点前进吧。那位九条家的后人，可能已经受困其中。"
                                }
                            ]
                        },
                        {
                            "id": "120180304",
                            "text": "可能是为了避人耳目。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1201804",
            "objective": "抵达最深处",
            "dialogues": []
        },
        {
            "id": "1201805",
            "objective": "与九条镰治与鹰司进交谈",
            "dialogues": [
                {
                    "id": "120180506",
                    "speaker": "鹰司进",
                    "text": "将军大人！"
                },
                {
                    "id": "120180507",
                    "speaker": "九条镰治",
                    "text": "将军大人怎么会…"
                },
                {
                    "id": "120180508",
                    "speaker": "影",
                    "text": "把这个地方的情况讲给我听，鹰司家的后人。"
                },
                {
                    "id": "120180509",
                    "speaker": "鹰司进",
                    "text": "我们只是在讨论最近发生在天领奉行里的一些琐事，并不值得将军大人费心…"
                },
                {
                    "id": "120180510",
                    "speaker": "影",
                    "text": "为此，专门选了这么隐蔽的地方，还找了一群流浪武士和海乱鬼在外镇守？"
                },
                {
                    "id": "120180511",
                    "speaker": "鹰司进",
                    "text": "那是因为最近颇为动荡，要考虑安全方面的问题…"
                },
                {
                    "id": "120180512",
                    "speaker": "影",
                    "text": "住口。"
                },
                {
                    "id": "120180513",
                    "speaker": "影",
                    "text": "九条家的后人，你来讲。"
                },
                {
                    "id": "120180514",
                    "speaker": "九条镰治",
                    "text": "好的。原本我也是抱着谈判的目的前来，结果他们想要的，只是九条家的认罪书而已。"
                },
                {
                    "id": "120180515",
                    "speaker": "影",
                    "text": "认罪书？"
                },
                {
                    "id": "120180516",
                    "speaker": "九条镰治",
                    "text": "对，陈述九条家从眼狩令起所犯下的诸条罪责，也包括了这段时间的各类失职…"
                },
                {
                    "id": "120180517",
                    "speaker": "鹰司进",
                    "text": "都是根据事实在陈述，并无捏造虚构。"
                },
                {
                    "id": "120180518",
                    "speaker": "九条镰治",
                    "text": "确实没有，但认罪书里还多次强调鹰司家的功劳，提到了鹰司家临危不乱，试图力挽狂澜…"
                },
                {
                    "id": "120180519",
                    "speaker": "九条镰治",
                    "text": "但这些，就全是子虚乌有之事了。"
                },
                {
                    "id": "120180520",
                    "speaker": "鹰司进",
                    "text": "谁说的？你…你怎么能突然变脸，出尔反尔！"
                },
                {
                    "id": "120180521",
                    "speaker": "九条镰治",
                    "text": "我也是在陈述事实，将军大人自会明断。鹰司家的想法，不过就是想要树立正面的形象，谋求替代九条家！"
                },
                {
                    "id": "120180522",
                    "speaker": "九条镰治",
                    "text": "不然，为什么要在九条家的认罪书里强调从不存在的功劳，还要用软禁的方式逼迫我签下名字呢？"
                },
                {
                    "id": "120180523",
                    "speaker": "鹰司进",
                    "text": "你在说什么？谁软禁你了！这是谈判！这和刚刚谈的完全不一样！"
                },
                {
                    "id": "120180524",
                    "speaker": "影",
                    "text": "情况我大概知晓了。"
                },
                {
                    "id": "120180525",
                    "speaker": "鹰司进",
                    "text": "不要听这小子一派胡言，九条家之前犯了多大的错，将军大人应该知道，他们的话一句都不可信！"
                },
                {
                    "id": "120180526",
                    "speaker": "影",
                    "text": "哼，你们的纠纷，我并无兴趣。但鹰司家的后人，你想要成为天领奉行，没错吧。"
                },
                {
                    "id": "120180527",
                    "speaker": "鹰司进",
                    "text": "呃，这个…是的，为将军大人肝脑涂地，这是每一位天领奉行众的永恒追求。"
                },
                {
                    "id": "120180528",
                    "speaker": "影",
                    "text": "那大可不必如此麻烦，毕竟任命天领奉行的是我。只要有人能在决斗中胜过我，他就是新的天领奉行。"
                },
                {
                    "id": "120180529",
                    "speaker": "鹰司进",
                    "text": "这…要和将军大人决斗？"
                },
                {
                    "id": "120180530",
                    "speaker": "影",
                    "text": "初代的天领奉行就是用手中的刀剑证明了他的意志，才会有传承到现在的九条家。"
                },
                {
                    "id": "120180531",
                    "speaker": "影",
                    "text": "想要我认可一个新的名字，那么自然要重新经历我的考验。"
                },
                {
                    "id": "120180532",
                    "speaker": "鹰司进",
                    "text": "这…"
                },
                {
                    "id": "120180533",
                    "speaker": "影",
                    "text": "难道你不会剑术吗？还是说，因为年迈体弱失去了信心呢？"
                },
                {
                    "id": "120180534",
                    "speaker": "影",
                    "text": "口口声声要为我肝脑涂地，却不敢面对我的刀？"
                },
                {
                    "id": "120180535",
                    "speaker": "鹰司进",
                    "text": "呃…"
                },
                {
                    "id": "120180536",
                    "speaker": "影",
                    "text": "也罢，你们呢？不管是鹰司还是什么，只要有人能战胜我，他就是新的天领奉行。"
                },
                {
                    "id": "120180537",
                    "speaker": "家臣们",
                    "text": "……"
                },
                {
                    "id": "120180538",
                    "speaker": "影",
                    "text": "敢站出来的人，一个都没有吗？"
                },
                {
                    "id": "120180539",
                    "speaker": "影",
                    "text": "……"
                },
                {
                    "id": "120180540",
                    "speaker": "九条镰治",
                    "text": "我…"
                },
                {
                    "id": "120180541",
                    "speaker": "九条镰治",
                    "text": "我想要挑战你，将军大人！"
                },
                {
                    "id": "120180542",
                    "speaker": "派蒙",
                    "text": "欸？！"
                },
                {
                    "id": "120180543",
                    "speaker": "影",
                    "text": "九条家的后人，很遗憾，就算你赢了我，九条家所犯下的错误，也无法一笔勾销。"
                },
                {
                    "id": "120180544",
                    "speaker": "九条镰治",
                    "text": "不，我不觉得我有胜算，我也心知肚明，家主犯下那样的过错，九条家在天领奉行中的传承，理应结束了…"
                },
                {
                    "id": "120180545",
                    "speaker": "九条镰治",
                    "text": "在执行眼狩令的时候，我对父亲的想法一直抱有怀疑，我也觉得我在做错误的事。"
                },
                {
                    "id": "120180546",
                    "speaker": "九条镰治",
                    "text": "但就是一直在怀疑，一直在反思，明明什么都明白，却没有任何行动，也没有拯救任何人。"
                },
                {
                    "id": "120180547",
                    "speaker": "九条镰治",
                    "text": "如今九条家败落的境遇，就是对我的惩罚吧。我不是什么都没有做到，而是什么都没有去做。"
                },
                {
                    "id": "120180548",
                    "speaker": "影",
                    "text": "残酷地说，你的力量，也做不到什么。"
                },
                {
                    "id": "120180549",
                    "speaker": "九条镰治",
                    "text": "是的，我的力量很弱小，父亲不听我的，兄长也帮不了我，有时候一平都能教训我，一直以来都是这样…！"
                },
                {
                    "id": "120180550",
                    "speaker": "九条镰治",
                    "text": "但是至少现在，在九条家的最后时光中，我是九条家的名代！履行和父亲相同的职责！"
                },
                {
                    "id": "120180551",
                    "speaker": "九条镰治",
                    "text": "就像将军所说，我的祖先以刀剑证明了自身的意志…"
                },
                {
                    "id": "120180552",
                    "speaker": "九条镰治",
                    "text": "那么，也请让我，九条镰治，以这样的方式来结束！"
                },
                {
                    "id": "120180553",
                    "speaker": "九条镰治",
                    "text": "这是我最后「能做些什么」的机会了！"
                },
                {
                    "id": "120180554",
                    "speaker": "影",
                    "text": "明明，没有意义。"
                },
                {
                    "id": "120180555",
                    "speaker": "影",
                    "text": "不过我接受了，上前来吧。"
                }
            ]
        },
        {
            "id": "1201806",
            "objective": "目睹双方的决斗",
            "dialogues": [
                {
                    "id": "120180601",
                    "speaker": "影",
                    "text": "九条家的荣耀，始于豪胆，扬于赤诚，超脱于生死。"
                }
            ]
        },
        {
            "id": "1201807",
            "objective": "聆听影的决断",
            "dialogues": [
                {
                    "id": "120180701",
                    "speaker": "影",
                    "text": "九条镰治受了伤，鹰司家的后人，你们负责照顾好他。"
                },
                {
                    "id": "120180702",
                    "speaker": "影",
                    "text": "没有挑战的勇气，这种小事总归做得到吧。"
                },
                {
                    "id": "120180703",
                    "speaker": "鹰司进",
                    "text": "是的，对不起，实在抱歉，非常抱歉。"
                },
                {
                    "id": "120180704",
                    "speaker": "影",
                    "text": "如今的九条家难支大局，这件事我之前也听说了，本来寻找天领奉行的继任者的确是当务之急…"
                },
                {
                    "id": "120180705",
                    "speaker": "影",
                    "text": "但这番决斗之后，我认为可以暂缓对九条家的处置。"
                },
                {
                    "id": "120180706",
                    "speaker": "影",
                    "text": "在这段时间里，鹰司家就依然像以前一样，为九条家提供帮助吧。"
                },
                {
                    "id": "120180707",
                    "speaker": "鹰司进",
                    "text": "全依将军大人指示，绝无二心。"
                },
                {
                    "id": "120180708",
                    "speaker": "影",
                    "text": "如果你们还觉得，可以如法炮制愚人众的策略，靠提供错误的信息，让我做出错误的判断。"
                },
                {
                    "id": "120180709",
                    "speaker": "影",
                    "text": "那我就会像今天这样再次出现，我的刀也不会再留情。"
                },
                {
                    "id": "120180710",
                    "speaker": "鹰司进",
                    "text": "明白，感谢将军大人，将军大人英明！"
                },
                {
                    "id": "120180711",
                    "speaker": "影",
                    "text": "行了，其他的调查我会让奥诘众负责的。"
                },
                {
                    "id": "120180712",
                    "speaker": "影",
                    "text": "你们也跟我走吧，去个安静的地方，我有话和你们说。"
                }
            ]
        },
        {
            "id": "1201808",
            "objective": "随影离开驻地",
            "dialogues": []
        },
        {
            "id": "1201809",
            "objective": "前往影的身边",
            "dialogues": []
        },
        {
            "id": "1201810",
            "objective": "与雷电影交谈",
            "dialogues": [
                {
                    "id": "120181001",
                    "speaker": "派蒙",
                    "text": "影在处理事情的时候，果然还是将军的感觉，特别威严呢。"
                },
                {
                    "id": "120181002",
                    "speaker": "影",
                    "text": "这样吗？我觉得我已经很会变通了，如果是将军的话，很有可能…会毫不留情地斩掉九条镰治。",
                    "choices": [
                        {
                            "id": "120181003",
                            "text": "他也算运气好。",
                            "response": [
                                {
                                    "id": "120181005",
                                    "speaker": "影",
                                    "text": "我觉得他做好这样的准备了，我从他的眼睛里能看出来。"
                                },
                                {
                                    "id": "120181006",
                                    "speaker": "影",
                                    "text": "九条家从辉煌到没落，实在是发生了难以想象的巨大变化，九条镰治并不是什么优秀的继承者，但…"
                                },
                                {
                                    "id": "120181007",
                                    "speaker": "影",
                                    "text": "他让我在巨大的变化中，看到了那些仍没有改变的东西。"
                                },
                                {
                                    "id": "120181008",
                                    "speaker": "影",
                                    "text": "这也是多亏了你们，是在街道中闲逛，还有你们的画片，让我意识到这件事的。"
                                },
                                {
                                    "id": "120181009",
                                    "speaker": "派蒙",
                                    "text": "接下来九条家会怎么样呢？有可能继续当天领奉行吗？"
                                },
                                {
                                    "id": "120181010",
                                    "speaker": "影",
                                    "text": "那还是不行，就算是这位继承者有闪光点，也不能抹平之前所犯下的过错。"
                                },
                                {
                                    "id": "120181011",
                                    "speaker": "影",
                                    "text": "但…多留一些时间吧，毕竟犯下错误的也不只是他们。"
                                },
                                {
                                    "id": "120181012",
                                    "speaker": "影",
                                    "text": "将军是不会错，也是不能错的。但作为「影」，我还是想要表达我的歉意。"
                                },
                                {
                                    "id": "120181013",
                                    "speaker": "影",
                                    "text": "接下来的日子需要思考的东西还有很多，不过至少现在我能看清方向了。"
                                },
                                {
                                    "id": "120181014",
                                    "speaker": "Player",
                                    "text": "那你会直接管理稻妻吗？"
                                },
                                {
                                    "id": "120181015",
                                    "speaker": "影",
                                    "text": "还是会交给将军去做吧，最威胁永恒的，始终还是时间带来的「磨损」。"
                                },
                                {
                                    "id": "120181016",
                                    "speaker": "影",
                                    "text": "我说过将军有自我保护的机制，就是预想到了我会因为时间而产生改变。"
                                },
                                {
                                    "id": "120181017",
                                    "speaker": "影",
                                    "text": "但既然是已经想通的事，就算再困难我也会去做。"
                                },
                                {
                                    "id": "120181018",
                                    "speaker": "影",
                                    "text": "嗯…"
                                },
                                {
                                    "id": "120181019",
                                    "speaker": "影",
                                    "text": "果然很值得纪念啊，这一段时光。"
                                },
                                {
                                    "id": "120181020",
                                    "speaker": "派蒙",
                                    "text": "是啊，天领奉行的事解决了，城里的人也见到了健康的将军，不好的猜想都会自然而然地消失。"
                                },
                                {
                                    "id": "120181021",
                                    "speaker": "派蒙",
                                    "text": "你要是很喜欢出来玩，下次我们再来邀请你！",
                                    "choices": [
                                        {
                                            "id": "120181022",
                                            "text": "再带些土特产。",
                                            "response": [
                                                {
                                                    "id": "120181024",
                                                    "speaker": "影",
                                                    "text": "不必了，这并非我生活的一部分。"
                                                },
                                                {
                                                    "id": "120181025",
                                                    "speaker": "影",
                                                    "text": "而且，不要说得我很需要陪伴似的。"
                                                },
                                                {
                                                    "id": "120181026",
                                                    "speaker": "影",
                                                    "text": "好了，那么我准备回去了。"
                                                },
                                                {
                                                    "id": "120181027",
                                                    "speaker": "影",
                                                    "text": "闭门静养还会持续一段时间，但不会太久。有些小事，就交给你们这些人类处理吧。"
                                                },
                                                {
                                                    "id": "120181028",
                                                    "speaker": "派蒙",
                                                    "text": "那就下次再见！"
                                                },
                                                {
                                                    "id": "120181029",
                                                    "speaker": "派蒙",
                                                    "text": "虽然发生了很多意料之外的事，但最后好像格外顺利啊。"
                                                },
                                                {
                                                    "id": "120181030",
                                                    "speaker": "派蒙",
                                                    "text": "最后，就只剩下把通行证还给八重神子了。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "120181023",
                                            "text": "再带些新鲜玩意儿。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "120181004",
                            "text": "可能这也在他意料之中。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1201811",
            "objective": "将通行证明还给八重神子",
            "dialogues": []
        },
        {
            "id": "1201812",
            "objective": "与八重神子交谈",
            "dialogues": [
                {
                    "id": "120181201",
                    "speaker": "派蒙",
                    "text": "神子，我们回来啦，一路上很顺利！"
                },
                {
                    "id": "120181202",
                    "speaker": "八重神子",
                    "text": "哦，那可要和我好好讲讲你们的故事了。"
                },
                {
                    "id": "120181203",
                    "speaker": "八重神子",
                    "text": "呵呵，太有意思了，堂堂的将军大人，进城逛街的时候就像个从乡下来的土妹子一样。"
                },
                {
                    "id": "120181204",
                    "speaker": "八重神子",
                    "text": "没能亲眼目睹，真是可惜了。",
                    "choices": [
                        {
                            "id": "120181205",
                            "text": "也就你敢这么说吧。",
                            "response": [
                                {
                                    "id": "120181207",
                                    "speaker": "八重神子",
                                    "text": "没事啦，她不会介意的，肯定不会介意。"
                                },
                                {
                                    "id": "120181208",
                                    "speaker": "八重神子",
                                    "text": "不过，听你们说，她好像隐约触及到了「永恒」该有的样子？"
                                },
                                {
                                    "id": "120181209",
                                    "speaker": "八重神子",
                                    "text": "那就是最重要的收获了。说实话，借给你们通行证明的时候，我也没想到会有这么大的进展。"
                                },
                                {
                                    "id": "120181210",
                                    "speaker": "派蒙",
                                    "text": "嗯，她好像不会再强求一切都静止下来了。"
                                },
                                {
                                    "id": "120181211",
                                    "speaker": "八重神子",
                                    "text": "说好听点，这叫神明的一厢情愿。说难听点，即便是「尘世七执政」，在面对更强大的存在时，也有做不到的事。",
                                    "choices": [
                                        {
                                            "id": "120181212",
                                            "text": "是指人心吗？",
                                            "response": [
                                                {
                                                    "id": "120181214",
                                                    "speaker": "八重神子",
                                                    "text": "呵呵，你猜吧。"
                                                },
                                                {
                                                    "id": "120181215",
                                                    "speaker": "八重神子",
                                                    "text": "总之听你们讲下来，这一路上都挺愉快的吧，你们应该也见识到影她不那么刻板的一面了。"
                                                },
                                                {
                                                    "id": "120181216",
                                                    "speaker": "八重神子",
                                                    "text": "以后还要见她的时候，再来找我借通行证吧，她虽然嘴上不会说，但其实还是挺容易寂寞的。"
                                                },
                                                {
                                                    "id": "120181217",
                                                    "speaker": "派蒙",
                                                    "text": "欸？但她说了她不需要陪伴…"
                                                },
                                                {
                                                    "id": "120181218",
                                                    "speaker": "八重神子",
                                                    "text": "因为她是神啊，神不是不需要陪伴，而是「陪伴」太奢侈了。"
                                                },
                                                {
                                                    "id": "120181219",
                                                    "speaker": "八重神子",
                                                    "text": "但你，不属于此世之人，说不定是很好的选择呢。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "120181213",
                                            "text": "是指天理吗？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "120181206",
                            "text": "你们好像乐于互相挖苦。"
                        }
                    ]
                }
            ]
        }
    ]
}