                {
                    "id": "190871201",
                    "speaker": "诺艾尔的学习笔记",
                    "text": "「风车菊常见于风龙废墟与风起地」、「攻击遗迹守卫的弱点来制造机会」…"
                },
                {
                    "id": "190871202",
                    "speaker": "诺艾尔的学习笔记",
                    "text": "端正的字体巨细靡遗地记录着冒险中值得注意的细节，只是越到后面笔画的结构越是松散。"
                },
                {
                    "id": "190871203",
                    "speaker": "诺艾尔的学习笔记",
                    "text": "某些模糊的描述之后又紧跟着严谨的补注，似乎是笔记的主人曾与困意努力斗争过的证明。"
                }
            ]
        },
        {
            "id": "1908709",
            "objective": "回到图书馆寻找诺艾尔",
            "dialogues": [
                {
                    "id": "190870901",
                    "speaker": "诺艾尔",
                    "text": "唔…还不能松懈…"
                },
                {
                    "id": "190870902",
                    "speaker": "诺艾尔",
                    "text": "至少…要先把这本书看完…再去休息…"
                }
            ]
        }
    ]
