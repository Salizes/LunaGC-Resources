            "dialogues": []
        },
        {
            "id": "102110",
            "objective": "寻找派蒙想要的材料",
            "dialogues": []
        },
        {
            "id": "102101",
            "objective": "寻找派蒙想要的材料",
            "dialogues": [
                {
                    "id": "10210201",
                    "speaker": "派蒙",
                    "text": "嗯？空气里有强烈的甜香味…"
                },
                {
                    "id": "10210202",
                    "speaker": "派蒙",
                    "text": "而且…你有没有听到什么声音？",
                    "choices": [
                        {
                            "id": "10210203",
                            "text": "好像有人呼救。",
                            "response": [
                                {
                                    "id": "10210204",
                                    "speaker": "派蒙",
                                    "text": "听起来，是从那个遗迹里发出的声音…"
                                },
                                {
                                    "id": "10210207",
                                    "speaker": "派蒙",
                                    "text": "…啊，是那些盗宝团把什么人关起来了吗？"
                                }
                            ]
                        },
                        {
                            "id": "10210205",
                            "text": "好像有人在唱歌。",
                            "response": [
                                {
                                    "id": "10210206",
                                    "speaker": "派蒙",
                                    "text": "不对，是呼救声！是从那个遗迹里发出来的…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "102102",
            "objective": "解救笼子里的人",
            "dialogues": []
        },
        {
            "id": "102107",
            "objective": "打开牢笼",
            "dialogues": []
        },
        {
            "id": "102108",
            "objective": "与笼中人对话",
            "dialogues": [
                {
                    "id": "10210801",
                    "speaker": "孟丹",
                    "text": "多谢阁下出手相救，否则我就要烂在牢里了！那些盗宝团，心情好就修剪一下那几盆甜甜花，心情不好就修理一下我…"
                },
                {
                    "id": "10210802",
                    "speaker": "派蒙",
                    "text": "小事一桩~小事一桩~千万~不要太感谢我们哦！"
                },
                {
                    "id": "10210803",
                    "speaker": "孟丹",
                    "text": "哈哈…我明白我明白，谢礼自当备上。"
                },
                {
                    "id": "10210804",
                    "speaker": "Player",
                    "text": "真的不用了。"
                },
                {
                    "id": "10210805",
                    "speaker": "孟丹",
                    "text": "别这么说！多亏了您，我才能逃过一劫。"
                },
                {
                    "id": "10210806",
                    "speaker": "孟丹",
                    "text": "我是璃月港内「明星斋」的供货商，孟丹，平时常在山里走动，四处搜集古董。"
                },
                {
                    "id": "10210807",
                    "speaker": "孟丹",
                    "text": "没想到这回跟盗宝团看上了同一座遗迹，一不小心…就被抓住关起来了，唉！"
                },
                {
                    "id": "10210808",
                    "speaker": "孟丹",
                    "text": "这位恩人，您手头还缺什么吗？古董、珍玩、各色摆件…只要您要，只要我有！"
                },
                {
                    "id": "10210809",
                    "speaker": "Player",
                    "text": "好意我心领了。"
                },
                {
                    "id": "10210810",
                    "speaker": "派蒙",
                    "text": "等等，我们确实在找一件东西！"
                },
                {
                    "id": "10210811",
                    "speaker": "孟丹",
                    "text": "哦？是什么东西？"
                },
                {
                    "id": "10210812",
                    "speaker": "派蒙",
                    "text": "你有没有可以装礼物的盒子？要漂亮一些的…嗯，用来放点心的那种。"
                },
                {
                    "id": "10210813",
                    "speaker": "孟丹",
                    "text": "这当然有，做古玩的怎么能不备礼盒？<color=#00E1FFFF>「明星斋」</color>里自有七国第一流的送礼包装。"
                },
                {
                    "id": "10210814",
                    "speaker": "孟丹",
                    "text": "您等着，我去跟老板打个招呼。您什么时候需要，到店里直接找她就行。"
                },
                {
                    "id": "10210815",
                    "speaker": "派蒙",
                    "text": "太好了，我们的「糖霜史莱姆」有豪华包装盒啦！"
                }
            ]
        },
        {
            "id": "102111",
            "objective": "前往「明星斋」",
            "dialogues": [
                {
                    "id": "10211101",
                    "speaker": "派蒙",
                    "text": "你好，有个叫孟丹的人说，我们可以来店里领一个漂亮盒子…"
                },
                {
                    "id": "10211102",
                    "speaker": "星稀",
                    "text": "老孟都跟我说了，二位，真是多亏你们相救。"
                },
                {
                    "id": "10211103",
                    "speaker": "星稀",
                    "text": "我店里最好的那些货品，许多都是老孟搜集来的。万一他有个三长两短，我的生意也做不下去。"
                },
                {
                    "id": "10211104",
                    "speaker": "星稀",
                    "text": "来，这礼盒本身就是古物，起码有一百四十年的历史，已经洗净备好了。请过目…还合适吗？"
                },
                {
                    "id": "10211105",
                    "speaker": "派蒙",
                    "text": "可以可以，非常合适！"
                },
                {
                    "id": "10211106",
                    "speaker": "派蒙",
                    "text": "对了，可以再借用一样东西吗？"
                },
                {
                    "id": "10211107",
                    "speaker": "星稀",
                    "text": "当然。东西都在架子上，您随意。"
                },
                {
                    "id": "10211108",
                    "speaker": "派蒙",
                    "text": "旅行者，这个大陶罐看起来很厉害！"
                },
                {
                    "id": "10211109",
                    "speaker": "派蒙",
                    "text": "用古董做搅拌盆，做出来的点心一定好吃！"
                },
                {
                    "id": "10211110",
                    "speaker": "派蒙",
                    "text": "做好了！独一无二的糖霜史莱姆！把它小心翼翼地摆进礼盒，点缀一些糖粉…"
                },
                {
                    "id": "10211111",
                    "speaker": "星稀",
                    "text": "这儿有刚摘下的鲜花，摆两朵吧。"
                },
                {
                    "id": "10211112",
                    "speaker": "派蒙",
                    "text": "太好了，真漂亮！"
                },
                {
                    "id": "10211113",
                    "speaker": "Player",
                    "text": "（不知怎么，有点心虚…）"
                },
                {
                    "id": "10211114",
                    "speaker": "派蒙",
                    "text": "好，我们的荣华富贵都在这个盒子里了。现在就去「群玉阁」找凝光吧！"
                }
            ]
        },
        {
            "id": "102103",
            "objective": "寻找群玉阁引路人",
            "dialogues": [
                {
                    "id": "10210301",
                    "speaker": "派蒙",
                    "text": "（按照刻晴教的，现在应该这样说…）"
                },
                {
                    "id": "10210302",
                    "speaker": "派蒙",
                    "text": "你好，这里卖月亮吗？"
                },
                {
                    "id": "10210303",
                    "speaker": "步云",
                    "text": "是的，要几个？"
                },
                {
                    "id": "10210304",
                    "speaker": "派蒙",
                    "text": "数量不方便透露。"
                },
                {
                    "id": "10210305",
                    "speaker": "步云",
                    "text": "答得好，二位请由此登阁。对了，二位就是凝光大人今天安排的客人吧？"
                },
                {
                    "id": "10210306",
                    "speaker": "派蒙",
                    "text": "没错！"
                },
                {
                    "id": "10210307",
                    "speaker": "步云",
                    "text": "（但这不是「客人」的暗号，而是「玉衡特许」的暗号。这又是怎么回事呢…）"
                }
            ]
        },
        {
            "id": "102104",
            "objective": "登上群玉阁",
            "dialogues": [
                {
                    "id": "10210401",
                    "speaker": "凝光",
                    "text": "恭候多时了，绝云间归来之人。"
                },
                {
                    "id": "10210402",
                    "speaker": "派蒙",
                    "text": "呀，是凝光！"
                },
                {
                    "id": "10210403",
                    "speaker": "派蒙",
                    "text": "初次见面，我们准备了一份礼物，希望你能喜欢！"
                },
                {
                    "id": "10210404",
                    "speaker": "凝光",
                    "text": "给我的？真是多谢。我请二位来，反倒让二位费心了。"
                },
                {
                    "id": "10210405",
                    "speaker": "派蒙",
                    "text": "不费心，不费心，嘿嘿~",
                    "choices": [
                        {
                            "id": "10210406",
                            "text": "「群玉阁」很漂亮。",
                            "response": [
                                {
                                    "id": "10210407",
                                    "speaker": "凝光",
                                    "text": "哈哈，很高兴你也喜欢它。"
                                },
                                {
                                    "id": "10210409",
                                    "speaker": "凝光",
                                    "text": "这座宫殿浮空的位置，高于一切山脉，从这里能清楚地看见璃月港的全貌。"
                                },
                                {
                                    "id": "10210410",
                                    "speaker": "凝光",
                                    "text": "从学做生意的年纪起，我就开始为它积攒建造资金了。成为「天权」以后，我更是邀请顶级工匠，不断扩建…"
                                },
                                {
                                    "id": "10210411",
                                    "speaker": "凝光",
                                    "text": "起初，它只有房间大小，如今已能遮蔽璃月上空真正的银月了。"
                                },
                                {
                                    "id": "10210412",
                                    "speaker": "凝光",
                                    "text": "我相信终有一日…它的影子会笼罩七国。"
                                },
                                {
                                    "id": "10210413",
                                    "speaker": "Player",
                                    "text": "（这位「天权」大人，很有野心…）"
                                },
                                {
                                    "id": "10210414",
                                    "speaker": "凝光",
                                    "text": "有资格登上「群玉阁」的外客不多，但西风骑士团的代理团长与我有书信往来，对你赞赏有加。"
                                },
                                {
                                    "id": "10210415",
                                    "speaker": "凝光",
                                    "text": "所以，从你到璃月的第一天起，我就开始散出眼线…"
                                },
                                {
                                    "id": "10210416",
                                    "speaker": "派蒙",
                                    "text": "什么？！"
                                },
                                {
                                    "id": "10210417",
                                    "speaker": "凝光",
                                    "text": "终于在你们前往望舒客栈时，大致掌握了你们的动向。"
                                },
                                {
                                    "id": "10210418",
                                    "speaker": "派蒙",
                                    "text": "难道菲尔戈黛特老板，是你们的人？！"
                                },
                                {
                                    "id": "10210419",
                                    "speaker": "凝光",
                                    "text": "不是的。"
                                },
                                {
                                    "id": "10210420",
                                    "speaker": "凝光",
                                    "text": "整座望舒客栈里，全都是我们的人。"
                                },
                                {
                                    "id": "10210421",
                                    "speaker": "派蒙",
                                    "text": "##%^%*&……！！"
                                },
                                {
                                    "id": "10210422",
                                    "speaker": "Player",
                                    "text": "不久前，还遇到了「玉衡星」…"
                                },
                                {
                                    "id": "10210423",
                                    "speaker": "凝光",
                                    "text": "在归终机旁见了一面，对么？"
                                },
                                {
                                    "id": "10210424",
                                    "speaker": "派蒙",
                                    "text": "你该不会一直在天上偷看吧？"
                                },
                                {
                                    "id": "10210425",
                                    "speaker": "凝光",
                                    "text": "哈哈…这么远的距离，偷看有些难吧。"
                                },
                                {
                                    "id": "10210426",
                                    "speaker": "凝光",
                                    "text": "…凭借「耳目」即可。我对你们很感兴趣，关注也是理所应当。"
                                },
                                {
                                    "id": "10210427",
                                    "speaker": "Player",
                                    "text": "刻晴说，七星不会暗害帝君。"
                                },
                                {
                                    "id": "10210428",
                                    "speaker": "凝光",
                                    "text": "嗯，你与仙人往来颇多，对我们不信任，也是理所当然。这次请你来，就是想要解开一些误会。"
                                }
                            ]
                        },
                        {
                            "id": "10210408",
                            "text": "第一次到这么高的地方…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "102113",
            "objective": "与凝光对话",
            "dialogues": [
                {
                    "id": "10211301",
                    "speaker": "凝光",
                    "text": "你应该听说过「魔神战争」吧？",
                    "choices": [
                        {
                            "id": "10211302",
                            "text": "不太清楚…",
                            "response": [
                                {
                                    "id": "10211304",
                                    "speaker": "凝光",
                                    "text": "世上曾有诸多魔神，也曾有旷日持久的战争，直到两千年前方才终结。期间生灵涂炭，流血无数。"
                                },
                                {
                                    "id": "10211305",
                                    "speaker": "凝光",
                                    "text": "最终，提瓦特大陆上只剩下七位胜利者。他们在败者的残骸上建立国度与城邦，开始了七神的时代。"
                                },
                                {
                                    "id": "10211306",
                                    "speaker": "凝光",
                                    "text": "看见「孤云阁」了吗？那并不是天然的地貌，而是战争期间，帝君投下的巨大岩枪。"
                                },
                                {
                                    "id": "10211307",
                                    "speaker": "凝光",
                                    "text": "在岩枪之下，镇压着帝君当年的手下败将：未能取得七神之位的昔日魔神。"
                                },
                                {
                                    "id": "10211308",
                                    "speaker": "凝光",
                                    "text": "不仅魔神会死，即使是「尘世七执政」，两千年来亦有更迭。帝君的逝去是璃月无法想象的灾难，但提瓦特的七神体系…不会崩溃。"
                                },
                                {
                                    "id": "10211309",
                                    "speaker": "凝光",
                                    "text": "下一位岩神迟早会出现，但我们又怎会遗忘帝君？到那时，璃月人与仙神的关系，必定会与过往不同。"
                                },
                                {
                                    "id": "10211310",
                                    "speaker": "凝光",
                                    "text": "即使在新的时代，「璃月七星」也是帝君的旧日子民。向帝君举刀的罪名…你认为，我们担得起吗？"
                                },
                                {
                                    "id": "10211311",
                                    "speaker": "Player",
                                    "text": "可是，你们为什么要藏起「仙祖法蜕」？"
                                },
                                {
                                    "id": "10211312",
                                    "speaker": "凝光",
                                    "text": "呵呵…"
                                },
                                {
                                    "id": "10211313",
                                    "speaker": "凝光",
                                    "text": "那天在玉京台，事出突然，我也毫无防备。你当时在现场，应该都看见了。"
                                },
                                {
                                    "id": "10211314",
                                    "speaker": "凝光",
                                    "text": "七星的敌人，早已潜伏在璃月港内。若不采取行动，就会落于下风。"
                                },
                                {
                                    "id": "10211315",
                                    "speaker": "凝光",
                                    "text": "藏起仙祖法蜕是必要之举，借此，我才能转明为暗，以静制动。"
                                },
                                {
                                    "id": "10211316",
                                    "speaker": "派蒙",
                                    "text": "你说的「敌人」是谁呀？"
                                },
                                {
                                    "id": "10211317",
                                    "speaker": "凝光",
                                    "text": "旅者，你觉得呢？",
                                    "choices": [
                                        {
                                            "id": "10211318",
                                            "text": "难道是他？",
                                            "response": [
                                                {
                                                    "id": "10211320",
                                                    "speaker": "派蒙",
                                                    "text": "嗯？你和凝光在打什么哑谜？"
                                                },
                                                {
                                                    "id": "10211321",
                                                    "speaker": "凝光",
                                                    "text": "正确的答案。"
                                                },
                                                {
                                                    "id": "10211322",
                                                    "speaker": "派蒙",
                                                    "text": "唔——？？？"
                                                },
                                                {
                                                    "id": "10211323",
                                                    "speaker": "凝光",
                                                    "text": "哈…外面景致虽好，但高空的风还是略大了些。二位，殿内已经做好了待客的准备，请随我进来。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "10211319",
                                            "text": "就是他吧。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "10211303",
                            "text": "只对这个词语有点印象。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "102105",
            "objective": "进入群玉阁建筑内",
            "dialogues": []
        },
        {
            "id": "102106",
            "objective": "与凝光对话",
            "dialogues": [
                {
                    "id": "10210601",
                    "speaker": "派蒙",
                    "text": "呜哇——！好、好大的客厅啊！从来没见过这么豪华的房间…"
                },
                {
                    "id": "10210602",
                    "speaker": "凝光",
                    "text": "二位随意，把这里当成自己家也可以。"
                },
                {
                    "id": "10210603",
                    "speaker": "派蒙",
                    "text": "真的可以吗？！"
                },
                {
                    "id": "10210604",
                    "speaker": "凝光",
                    "text": "我请你们来，自然是把你们当成朋友。朋友来玩，当然是开心第一。"
                },
                {
                    "id": "10210605",
                    "speaker": "Player",
                    "text": "那里是…"
                },
                {
                    "id": "10210606",
                    "speaker": "派蒙",
                    "text": "哎？这就是「传说中的那面墙」吗？"
                },
                {
                    "id": "10210607",
                    "speaker": "凝光",
                    "text": "哦？你的消息很灵通嘛。"
                },
                {
                    "id": "10210608",
                    "speaker": "派蒙",
                    "text": "因为连说书先生都在说…好多人都在求购墙上的纸张，可有名了！"
                },
                {
                    "id": "10210609",
                    "speaker": "凝光",
                    "text": "因为那面墙上记录着璃月的秘密。商人对秘密，总是充满热情。"
                },
                {
                    "id": "10210610",
                    "speaker": "凝光",
                    "text": "但旅行者，璃月的商业秘密对你来说并无意义，你很特别，你自己也很清楚这一点吧？"
                },
                {
                    "id": "10210611",
                    "speaker": "凝光",
                    "text": "如果可能，我想获取你的信任。"
                },
                {
                    "id": "10210612",
                    "speaker": "凝光",
                    "text": "但假如要你在我和刻晴当中，选择一个更值得信任的人…",
                    "choices": [
                        {
                            "id": "10210613",
                            "text": "凝光的敬神和刻晴的不敬神…",
                            "response": [
                                {
                                    "id": "10210615",
                                    "speaker": "凝光",
                                    "text": "…哈哈，你会选刻晴吧？这种程度的直觉，我还是有的。"
                                },
                                {
                                    "id": "10210616",
                                    "speaker": "凝光",
                                    "text": "我原本觉得，过刚易折。以她那样的性格当上七星，有些事还需要我在背后打点。"
                                },
                                {
                                    "id": "10210617",
                                    "speaker": "凝光",
                                    "text": "但在她说出「仙人的时代已经过去了，如果连璃月七星都不敢正视这一点，那璃月的未来要怎么办」这句话以后…"
                                },
                                {
                                    "id": "10210618",
                                    "speaker": "凝光",
                                    "text": "我心中的一些疑虑，倒是被打消了不少。"
                                },
                                {
                                    "id": "10210619",
                                    "speaker": "凝光",
                                    "text": "不错，我不否认帝君的逝去看似对七星有利。但为了璃月，我也不能被「七星篡位」的流言束缚住应有的行动。"
                                },
                                {
                                    "id": "10210620",
                                    "speaker": "Player",
                                    "text": "这些流言的背后，也有愚人众的身影？"
                                },
                                {
                                    "id": "10210621",
                                    "speaker": "凝光",
                                    "text": "嗯…看来你从刚才开始，就已经完全明白我要说什么了。"
                                },
                                {
                                    "id": "10210622",
                                    "speaker": "凝光",
                                    "text": "我下令封锁消息、藏匿仙体，一来是为暂时稳定局面，二来也是为了避免…在蒙德发生过的那种事。"
                                },
                                {
                                    "id": "10210623",
                                    "speaker": "凝光",
                                    "text": "愚人众借帝君之死，已经有了太多超出外交底线的暗中行动。我身为对璃月负责的「天权」，对抗时也顾不得姿态优雅了。"
                                },
                                {
                                    "id": "10210624",
                                    "speaker": "凝光",
                                    "text": "批准「送仙典仪」的筹办，也只是为七星全面接管璃月，争取一些缓冲时间…"
                                },
                                {
                                    "id": "10210625",
                                    "speaker": "派蒙",
                                    "text": "唔…果然和钟离说的一样，七星提供了仪式场地，只是因为可以利用我们达成自己的目的呢。"
                                },
                                {
                                    "id": "10210626",
                                    "speaker": "派蒙",
                                    "text": "对了！说到「达成目的」…还有一件事，我可以说吗？"
                                },
                                {
                                    "id": "10210627",
                                    "speaker": "凝光",
                                    "text": "但说无妨。"
                                },
                                {
                                    "id": "10210628",
                                    "speaker": "派蒙",
                                    "text": "听说，送了见面礼的客人，都能得到一些好处…那我们有份吗？"
                                },
                                {
                                    "id": "10210629",
                                    "speaker": "Player",
                                    "text": "派蒙，你就不能说些别的吗！"
                                },
                                {
                                    "id": "10210630",
                                    "speaker": "凝光",
                                    "text": "哈哈哈…没关系，我很喜欢直白的人。"
                                },
                                {
                                    "id": "10210631",
                                    "speaker": "凝光",
                                    "text": "最近这段时间，麻烦你们的事情也算是不少。这样吧，作为赔礼，你可以从我这里任选一件喜欢的东西带走。"
                                },
                                {
                                    "id": "10210632",
                                    "speaker": "派蒙",
                                    "text": "好！就等着这句了——我早就想好了！我想要的是…"
                                },
                                {
                                    "id": "10210633",
                                    "speaker": "派蒙",
                                    "text": "那面墙上的<color=#00E1FFFF>纸片</color>！"
                                },
                                {
                                    "id": "10210634",
                                    "speaker": "Player",
                                    "text": "？？？"
                                },
                                {
                                    "id": "10210635",
                                    "speaker": "派蒙",
                                    "text": "别用那种眼神看着我！你不明白吗？这面墙上的纸，哪怕只有指甲盖大小，也能卖出天价！"
                                },
                                {
                                    "id": "10210636",
                                    "speaker": "派蒙",
                                    "text": "要是…要是没有撕碎的一整张…唔！我都不敢想象它值多少摩拉！"
                                }
                            ]
                        },
                        {
                            "id": "10210614",
                            "text": "还是刻晴的「不敬」更可信一些。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "102112",
            "objective": "选取一张「碎雪」",
            "dialogues": [
                {
                    "id": "10211201",
                    "speaker": "派蒙",
                    "text": "咦？认真一看，根本不用挑嘛。最大的一张笔记就钉在最显眼的位置。好，就选定这张吧！"
                },
                {
                    "id": "10211202",
                    "speaker": "派蒙",
                    "text": "啦啦啦…先来看看上面写了什么…"
                },
                {
                    "id": "10211203",
                    "speaker": "派蒙",
                    "text": "嗯？这里有个圈出来的地点，难道是宝藏！或者是别的什么发财机会？我看看，边上这些字写的是…"
                },
                {
                    "id": "10211204",
                    "speaker": "派蒙",
                    "text": "「百无」…「禁忌箓」…什么什么…「愚人众」…「研究」…「复制」…嗯？"
                },
                {
                    "id": "10211205",
                    "speaker": "派蒙",
                    "text": "好像…不是宝藏。"
                },
                {
                    "id": "10211206",
                    "speaker": "派蒙",
                    "text": "这张纸上写的，是愚人众对<color=#00E1FFFF>「百无禁忌箓」</color>的秘密研究，被七星布下的眼线发现了踪迹。"
                },
                {
                    "id": "10211207",
                    "speaker": "派蒙",
                    "text": "唔…凝光刚才说，愚人众在璃月暗中做了很多坏事，比如散布流言、觊觎仙体什么的。"
                },
                {
                    "id": "10211208",
                    "speaker": "派蒙",
                    "text": "但「研究百无禁忌箓」，算是什么类型的坏事呢？"
                },
                {
                    "id": "10211209",
                    "speaker": "派蒙",
                    "text": "#{NICKNAME}，说起来「百无禁忌箓」和你也有点关系，要不要去探查一下？",
                    "choices": [
                        {
                            "id": "10211210",
                            "text": "事情的发展…有点刻意。",
                            "response": [
                                {
                                    "id": "10211212",
                                    "speaker": "派蒙",
                                    "text": "欸？是这样吗？"
                                },
                                {
                                    "id": "10211213",
                                    "speaker": "派蒙",
                                    "text": "那…那我们就不去了？"
                                },
                                {
                                    "id": "10211214",
                                    "speaker": "Player",
                                    "text": "不，我是这样想的…"
                                },
                                {
                                    "id": "10211215",
                                    "speaker": "派蒙",
                                    "text": "喔，原来你的意思是，「越是不能全盘尽信凝光，越是需要亲自去印证一下凝光的说法」。"
                                },
                                {
                                    "id": "10211216",
                                    "speaker": "派蒙",
                                    "text": "唔…有点超过我的理解范围。我觉得她对我们很亲切，是个好人。"
                                },
                                {
                                    "id": "10211217",
                                    "speaker": "派蒙",
                                    "text": "不管了，就照你说的，先行动吧！"
                                },
                                {
                                    "id": "10211218",
                                    "speaker": "派蒙",
                                    "text": "在去荻花洲找钟离之前，我们先去这份资料里说的地方看看，愚人众是不是真的在做一些见不得人的勾当？"
                                }
                            ]
                        },
                        {
                            "id": "10211211",
                            "text": "明显是凝光想引我们去那里…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "102130",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "10213001",
                    "speaker": "星稀",
                    "text": "多谢你们救了老孟，路上小心。"
                },
                {
                    "id": "10213002",
                    "speaker": "星稀",
                    "text": "嗯，接下来…我得洗洗陶罐了。"
                }
            ]
        },
        {
            "id": "102131",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "10213101",
                    "speaker": "凝光",
                    "text": "怎么，挑完了吗？"
                },
                {
                    "id": "10213102",
                    "speaker": "凝光",
                    "text": "啊，决定了的话也不用问我，直接拿走就好。"
                },
                {
                    "id": "10213103",
                    "speaker": "凝光",
                    "text": "然后，就在「群玉阁」坐一会、逛一逛吧。旅途当中的休息，也是很重要的一环。",
                    "choices": [
                        {
                            "id": "10213104",
                            "text": "多谢款待。",
                            "response": [
                                {
                                    "id": "10213105",
                                    "speaker": "凝光",
                                    "text": "别这么客气，请随意些。"
                                }
                            ]
                        },
                        {
                            "id": "10213106",
                            "text": "是时候动身了，再见…",
                            "response": [
                                {
                                    "id": "10213107",
                                    "speaker": "凝光",
                                    "text": "要走了么？也好。希望我们下次相遇时，你已经做了正确的事…或者将要作出正确的选择。"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}