    "talks": [
        {
            "id": "7007823",
            "objective": "(test)废弃$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7007801",
            "objective": "与在酒馆喝酒的人对话$HIDDEN",
            "dialogues": [
                {
                    "id": "700780101",
                    "speaker": "马泰奥",
                    "text": "奥多夫，你不知道，骑士团的人都去过很多次了…"
                },
                {
                    "id": "700780102",
                    "speaker": "奥多夫",
                    "text": "啊呀，我这段时间都在至冬嘛。骑士团的人都去过塔里这件事，今天还是第一次知道呢…结果呢？"
                },
                {
                    "id": "700780103",
                    "speaker": "伦纳特",
                    "text": "能有什么结果，现在旧灯塔里的警报还时不时会闪上一会儿呢，温斯洛那个家伙一开始还说，「深渊，是深渊！」"
                },
                {
                    "id": "700780104",
                    "speaker": "马泰奥",
                    "text": "听了他的话，骑士团如临大敌，结果全副武装到了那儿一看，一点深渊的痕迹也没有…"
                },
                {
                    "id": "700780105",
                    "speaker": "马泰奥",
                    "text": "这样来回几次，那些骑士们也被折腾得够呛。"
                },
                {
                    "id": "700780106",
                    "speaker": "伦纳特",
                    "text": "要我说，其实就是旧灯塔底下那些警戒机关老化了，不过…嗯…最近倒是有些传言…"
                },
                {
                    "id": "700780107",
                    "speaker": "奥多夫",
                    "text": "呵呵，这还能有什么传言？"
                },
                {
                    "id": "700780108",
                    "speaker": "伦纳特",
                    "text": "有传言说，在那里出没的，其实是从前战死的骑士的幽灵…"
                },
                {
                    "id": "700780109",
                    "speaker": "派蒙",
                    "text": "幽、幽灵！"
                },
                {
                    "id": "700780110",
                    "speaker": "马泰奥",
                    "text": "哇——两位，不要在谈论恐怖话题时突然这样大喊大叫，你们这样可比幽灵还吓人啊。"
                },
                {
                    "id": "700780111",
                    "speaker": "派蒙",
                    "text": "不、不好意思，我也不是故意的…"
                },
                {
                    "id": "700780112",
                    "speaker": "奥多夫",
                    "text": "没事没事，聊天的时候总是人越多越热闹才对，两位是…"
                },
                {
                    "id": "700780113",
                    "speaker": "Black Screen",
                    "text": "和酒桌边聊天的几位互相作了自我介绍…"
                },
                {
                    "id": "700780114",
                    "speaker": "奥多夫",
                    "text": "#{NICKNAME}和派蒙…啊呀，原来如此…"
                },
                {
                    "id": "700780115",
                    "speaker": "奥多夫",
                    "text": "对了，说起来，温斯洛现在还好吗？"
                },
                {
                    "id": "700780116",
                    "speaker": "马泰奥",
                    "text": "他被那个警戒机关发出的光亮吓得不轻，住在旧灯塔里，时不时就有机关发生动静，是谁都受不了吧。"
                },
                {
                    "id": "700780117",
                    "speaker": "马泰奥",
                    "text": "听说最近都有点疯疯癫癫的了…不过那也算是种报应，你管他做什么…"
                },
                {
                    "id": "700780118",
                    "speaker": "奥多夫",
                    "text": "这警戒机关总不能就这样吧，我可就住在旧灯塔周围，更何况…"
                },
                {
                    "id": "700780119",
                    "speaker": "奥多夫",
                    "text": "说不定有别的东西在下面，不去看看总是有点担心，也不能就让温斯洛就那样待在那，对吧。"
                },
                {
                    "id": "700780120",
                    "speaker": "派蒙",
                    "text": "啊，这么说来，难道说我们之前在旧灯塔前遇到的…",
                    "choices": [
                        {
                            "id": "700780121",
                            "text": "差点被派蒙吃掉的那个…",
                            "response": [
                                {
                                    "id": "700780122",
                                    "speaker": "派蒙",
                                    "text": "？"
                                },
                                {
                                    "id": "700780124",
                                    "speaker": "奥多夫",
                                    "text": "嗯？两位在旧灯塔前遇到什么…哈哈，难道是遇到幽灵了？"
                                },
                                {
                                    "id": "700780125",
                                    "speaker": "派蒙",
                                    "text": "不是，我们遇到了一个看上去慌慌张张，疯疯癫癫的人，大概就是那个住在旧灯塔里的人吧？"
                                },
                                {
                                    "id": "700780126",
                                    "speaker": "奥多夫",
                                    "text": "…温斯洛。"
                                },
                                {
                                    "id": "700780127",
                                    "speaker": "伦纳特",
                                    "text": "你想去帮温斯洛？"
                                },
                                {
                                    "id": "700780128",
                                    "speaker": "伦纳特",
                                    "text": "先说好，那底下原先是古战场，我可不去那里冒险。更何况，骑士团都去过了，问题也没有解决…"
                                },
                                {
                                    "id": "700780129",
                                    "speaker": "奥多夫",
                                    "text": "那我们就得找比西风骑士团的骑士们更可靠的人了，比如曾经拯救过蒙德的大英雄之类的…"
                                },
                                {
                                    "id": "700780130",
                                    "speaker": "派蒙",
                                    "text": "哼哼，这样的大英雄去哪里找呢！",
                                    "choices": [
                                        {
                                            "id": "700780131",
                                            "text": "大英雄，正在此处！",
                                            "response": [
                                                {
                                                    "id": "700780134",
                                                    "speaker": "奥多夫",
                                                    "text": "哈哈，两位英雄，恕我直言，能接受我的不情之请吗？"
                                                },
                                                {
                                                    "id": "700780135",
                                                    "speaker": "派蒙",
                                                    "text": "吔，但是有讨人厌的作怪幽灵…"
                                                },
                                                {
                                                    "id": "700780136",
                                                    "speaker": "奥多夫",
                                                    "text": "啊呀，也有故事里的幽灵徘徊不去只为守护深藏山林之中的财宝…"
                                                },
                                                {
                                                    "id": "700780137",
                                                    "speaker": "派蒙",
                                                    "text": "哦！财宝！",
                                                    "choices": [
                                                        {
                                                            "id": "700780138",
                                                            "text": "哦！小财迷派蒙！",
                                                            "response": [
                                                                {
                                                                    "id": "700780140",
                                                                    "speaker": "派蒙",
                                                                    "text": "#才不是因为财宝啦，{NICKNAME}，那个住在旧灯塔里的人听上去真的很可怜嘛。"
                                                                },
                                                                {
                                                                    "id": "700780141",
                                                                    "speaker": "Player",
                                                                    "text": "好吧好吧。"
                                                                },
                                                                {
                                                                    "id": "700780142",
                                                                    "speaker": "奥多夫",
                                                                    "text": "我就知道二位不吝相助，啊呀，即使没有财宝，我也愿意为这番冒险付出一些酬劳。"
                                                                },
                                                                {
                                                                    "id": "700780143",
                                                                    "speaker": "奥多夫",
                                                                    "text": "#…嗯，我也要稍微做点准备，{NICKNAME}，不如待会儿就在旧灯塔的底部相见吧！"
                                                                },
                                                                {
                                                                    "id": "700780144",
                                                                    "speaker": "伦纳特",
                                                                    "text": "真是够呛，我可不管这件事，我喝多了，待会儿得回家躺会儿。"
                                                                },
                                                                {
                                                                    "id": "700780145",
                                                                    "speaker": "马泰奥",
                                                                    "text": "#回家好好休息吧，伦纳特。唉，那就祝你们顺利，虽然有{NICKNAME}在，但是奥多夫，别干什么危险的事。"
                                                                },
                                                                {
                                                                    "id": "700780146",
                                                                    "speaker": "奥多夫",
                                                                    "text": "这是自然。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "700780139",
                                                            "text": "派蒙太好上钩了…"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "700780132",
                                            "text": "不好，是冲着我们来的！",
                                            "response": [
                                                {
                                                    "id": "700780133",
                                                    "speaker": "奥多夫",
                                                    "text": "只是两位正好在此…世上最美丽的莫过于诗歌与巧合嘛。实话说，如果没有两位，我也打算独自去看看情况。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "700780123",
                            "text": "确实，看着很可疑的那个…"
                        }
                    ]
                }
            ]
        },
