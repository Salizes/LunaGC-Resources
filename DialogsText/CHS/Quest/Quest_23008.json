    },
    "talks": [
        {
            "id": "2300801",
            "objective": "与阿金对话",
            "dialogues": [
                {
                    "id": "230080101",
                    "speaker": "阿金",
                    "text": "也许马上就要成功了…"
                },
                {
                    "id": "230080102",
                    "speaker": "阿金",
                    "text": "旅行者！请你留步，旅行者！",
                    "choices": [
                        {
                            "id": "230080103",
                            "text": "怎么了？",
                            "response": [
                                {
                                    "id": "230080105",
                                    "speaker": "阿金",
                                    "text": "我要找史莱姆凝液！"
                                },
                                {
                                    "id": "230080106",
                                    "speaker": "阿金",
                                    "text": "事情是这样，我这几天一直在试验，把你之前帮我拿回来的泥土用各种比例混合。"
                                },
                                {
                                    "id": "230080107",
                                    "speaker": "阿金",
                                    "text": "虽然失败了很多次…但我最终还是找到了一个可用的混合比例！"
                                },
                                {
                                    "id": "230080108",
                                    "speaker": "阿金",
                                    "text": "用这种比例混合出来的「凝成泥土」虽然在凝固前没什么可塑性，但凝固后却坚固耐用。"
                                },
                                {
                                    "id": "230080109",
                                    "speaker": "阿金",
                                    "text": "我猜，也许是那种混合了史莱姆凝液的泥土加入少了…"
                                },
                                {
                                    "id": "230080110",
                                    "speaker": "阿金",
                                    "text": "旅行者，请你快去帮我再拿三份史莱姆凝液回来吧！"
                                },
                                {
                                    "id": "230080111",
                                    "speaker": "阿金",
                                    "text": "有了这些史莱姆凝液，我一定能做出我想要的泥土！"
                                }
                            ]
                        },
                        {
                            "id": "230080104",
                            "text": "你又要找什么东西？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "2300802",
            "objective": "将三份史莱姆凝液交给阿金",
            "dialogues": [
                {
                    "id": "230080201",
                    "speaker": "阿金",
                    "text": "你拿到史莱姆凝液了吗？"
                }
            ]
        },
        {
            "id": "2300803",
            "objective": "继续与阿金对话",
            "dialogues": [
                {
                    "id": "230080301",
                    "speaker": "阿金",
                    "text": "太好了！就是这些，请稍等我一下，马上就好！"
                },
                {
                    "id": "230080302",
                    "speaker": "Black Screen",
                    "text": "等待了一段时间之后。"
                },
                {
                    "id": "230080303",
                    "speaker": "阿金",
                    "text": "果然，我的猜想没错。"
                },
                {
                    "id": "230080304",
                    "speaker": "阿金",
                    "text": "潮湿的泥土粘合性好，凝固后却容易断裂，但和骗骗花的泥土样本混合之后，凝固后的泥土居然有了一些柔韧性。"
                },
                {
                    "id": "230080305",
                    "speaker": "阿金",
                    "text": "但这种泥土在凝固前的可塑性很差…"
                },
                {
                    "id": "230080306",
                    "speaker": "阿金",
                    "text": "但加上史莱姆栖息地的泥土之后，这种泥土在凝固前的可塑性突然好了起来。"
                },
                {
                    "id": "230080307",
                    "speaker": "阿金",
                    "text": "我也不知道为什么，硬要形容的话，就是这种泥土变成了史莱姆一样…",
                    "choices": [
                        {
                            "id": "230080308",
                            "text": "「史莱姆土」。",
                            "response": [
                                {
                                    "id": "230080311",
                                    "speaker": "阿金",
                                    "text": "我猜是史莱姆的某种特质影响了泥土，所以就在想如果直接加入史莱姆凝液会不会更有效果。"
                                },
                                {
                                    "id": "230080312",
                                    "speaker": "阿金",
                                    "text": "结果刚刚测试了一下，根据史莱姆凝液加入量的不同，泥土的可塑性与强度都会随之变化。"
                                },
                                {
                                    "id": "230080313",
                                    "speaker": "阿金",
                                    "text": "换句话说，不只是建筑材料，它还能用来做陶器，还有许多其他东西！",
                                    "choices": [
                                        {
                                            "id": "230080314",
                                            "text": "祝贺你。",
                                            "response": [
                                                {
                                                    "id": "230080316",
                                                    "speaker": "阿金",
                                                    "text": "谢谢，这就是上面的聪明人常说的，「聚沙成塔」吧。"
                                                },
                                                {
                                                    "id": "230080317",
                                                    "speaker": "阿金",
                                                    "text": "别看这泥土很不起眼，现在也许它真的能造出一座通天高塔。"
                                                },
                                                {
                                                    "id": "230080318",
                                                    "speaker": "阿金",
                                                    "text": "我决定把这些混合型的泥土取名为「凝成泥土」。"
                                                },
                                                {
                                                    "id": "230080319",
                                                    "speaker": "阿金",
                                                    "text": "接下来我要做的，就是试验这种「凝成泥土」能用来做什么了…"
                                                },
                                                {
                                                    "id": "230080320",
                                                    "speaker": "阿金",
                                                    "text": "长时间困扰大家的房屋问题，现在也有解决的希望了。"
                                                },
                                                {
                                                    "id": "230080321",
                                                    "speaker": "阿金",
                                                    "text": "非常感谢你，旅行者，这些是报酬，请你收下吧。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "230080315",
                                            "text": "总算有成果了。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "230080309",
                            "text": "派蒙会喜欢吗？",
                            "response": [
                                {
                                    "id": "230080310",
                                    "speaker": "派蒙",
                                    "text": "派蒙才不会去吃土嘞！"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}