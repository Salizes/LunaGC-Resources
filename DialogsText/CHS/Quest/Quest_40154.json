    "talks": [
        {
            "id": "4015401",
            "objective": "返回店铺",
            "dialogues": [
                {
                    "id": "401540101",
                    "speaker": "Black Screen",
                    "text": "经过这段时间的努力经营，炼金店铺的营业额达到了比预期中更高的数据…"
                },
                {
                    "id": "401540102",
                    "speaker": "丽莎",
                    "text": "哎呀，想不到短短一段时间，小可爱居然能把营业额提升到这个程度…"
                },
                {
                    "id": "401540103",
                    "speaker": "丽莎",
                    "text": "莫非你是商业天才吗？",
                    "choices": [
                        {
                            "id": "401540104",
                            "text": "多亏了丽莎的帮助。",
                            "response": [
                                {
                                    "id": "401540105",
                                    "speaker": "丽莎",
                                    "text": "呵呵，你还是那么谦虚。"
                                },
                                {
                                    "id": "401540106",
                                    "speaker": "丽莎",
                                    "text": "得到这么厉害的成果，可以再自豪一点的哦。"
                                },
                                {
                                    "id": "401540109",
                                    "speaker": "丽莎",
                                    "text": "要是能把你留在身边当助手，我的假期应该能再增加一倍吧。"
                                },
                                {
                                    "id": "401540110",
                                    "speaker": "丽莎",
                                    "text": "现阶段收集到的销售数据已经足够了。这段时间辛苦你们啦。"
                                },
                                {
                                    "id": "401540111",
                                    "speaker": "丽莎",
                                    "text": "当然，如果你愿意继续帮忙照看店铺，姐姐也会很高兴哦。"
                                },
                                {
                                    "id": "401540112",
                                    "speaker": "丽莎",
                                    "text": "这下，我也能跟琴交差了，呵呵…"
                                },
                                {
                                    "id": "401540113",
                                    "speaker": "琴",
                                    "text": "#{NICKNAME}，派蒙，好久不见。"
                                },
                                {
                                    "id": "401540114",
                                    "speaker": "派蒙",
                                    "text": "琴团长！"
                                },
                                {
                                    "id": "401540115",
                                    "speaker": "丽莎",
                                    "text": "你来了，我正想着跟小可爱交接完工作，就回骑士团找你呢。"
                                },
                                {
                                    "id": "401540116",
                                    "speaker": "琴",
                                    "text": "嗯，我已经从其他骑士那里了解了大致情况。"
                                },
                                {
                                    "id": "401540117",
                                    "speaker": "琴",
                                    "text": "#想不到，这次你也让{NICKNAME}来帮忙了。"
                                },
                                {
                                    "id": "401540118",
                                    "speaker": "丽莎",
                                    "text": "哎呀，这种重要的工作要想取得突破，精明能干的合作伙伴是不可或缺的。"
                                },
                                {
                                    "id": "401540119",
                                    "speaker": "丽莎",
                                    "text": "你看，只有我的话可达不到这样的效率呢。"
                                },
                                {
                                    "id": "401540120",
                                    "speaker": "琴",
                                    "text": "确实，你们的成绩非常惊人。"
                                },
                                {
                                    "id": "401540121",
                                    "speaker": "琴",
                                    "text": "本想将其他事务安排妥当之后就过来看看你们的情况，却一直抽不出时间…至少我想亲口表达对你们的感谢。",
                                    "choices": [
                                        {
                                            "id": "401540122",
                                            "text": "琴团长一直在背后支持我们。",
                                            "response": [
                                                {
                                                    "id": "401540124",
                                                    "speaker": "琴",
                                                    "text": "嗯，有你们这样优秀的同伴，实在是令人安心。"
                                                },
                                                {
                                                    "id": "401540125",
                                                    "speaker": "丽莎",
                                                    "text": "呵呵，等事情告一段落，我是不是可以好好休个假了？"
                                                },
                                                {
                                                    "id": "401540126",
                                                    "speaker": "丽莎",
                                                    "text": "最近似乎头发都多掉了几根呢。"
                                                },
                                                {
                                                    "id": "401540127",
                                                    "speaker": "琴",
                                                    "text": "没问题。这段时间辛苦你了。"
                                                },
                                                {
                                                    "id": "401540128",
                                                    "speaker": "琴",
                                                    "text": "之前我看你每天待在图书馆，时间长了或许会感到无聊，所以想安排一些更能发挥你才能的工作。"
                                                },
                                                {
                                                    "id": "401540129",
                                                    "speaker": "琴",
                                                    "text": "是不是一下子给你增加太多压力了？"
                                                },
                                                {
                                                    "id": "401540130",
                                                    "speaker": "丽莎",
                                                    "text": "#其实也还好啦，毕竟有骑士团各位的支援，还有得力的同伴{NICKNAME}帮我分担工作。"
                                                },
                                                {
                                                    "id": "401540131",
                                                    "speaker": "丽莎",
                                                    "text": "偶尔干回老本行，搞搞研究，也还挺有意思的。"
                                                },
                                                {
                                                    "id": "401540132",
                                                    "speaker": "琴",
                                                    "text": "嗯，你能这么想就好了。"
                                                },
                                                {
                                                    "id": "401540133",
                                                    "speaker": "琴",
                                                    "text": "#{NICKNAME}，再次感谢你的付出。请收下这些报酬。"
                                                },
                                                {
                                                    "id": "401540134",
                                                    "speaker": "丽莎",
                                                    "text": "说到这个，姐姐我也为你做了个纪念品，希望你能喜欢哦。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "401540123",
                                            "text": "这是所有人一起努力的成果。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "401540107",
                            "text": "不知不觉就找到诀窍了。",
                            "response": [
                                {
                                    "id": "401540108",
                                    "speaker": "丽莎",
                                    "text": "嗯，你的学习能力果然非常强呢。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
