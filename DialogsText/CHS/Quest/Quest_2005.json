    "talks": [
        {
            "id": "200501",
            "objective": "寻找下一位被夺去神之眼的人",
            "dialogues": [
                {
                    "id": "20050101",
                    "speaker": "派蒙",
                    "text": "奇怪，据说「天领奉行」直属于将军管辖，统管稻妻治安方面的事宜，眼狩令就是他们在执行。"
                },
                {
                    "id": "20050102",
                    "speaker": "派蒙",
                    "text": "可为什么他们要对自己的同伴下手呢？"
                },
                {
                    "id": "20050103",
                    "speaker": "派蒙",
                    "text": "想不明白…等等，那边似乎发生了争吵，我们先过去看看吧。"
                },
                {
                    "id": "20050104",
                    "speaker": "大森",
                    "text": "我说，这个月的救济粮，你是打算不给了吗？"
                },
                {
                    "id": "20050105",
                    "speaker": "悠也",
                    "text": "我们一家人可都等着这些粮食养活呢！今天不给我们一个说法，你就别想走！"
                },
                {
                    "id": "20050106",
                    "speaker": "黑泽京之介",
                    "text": "说了多少遍，我不知道什么救济粮…"
                },
                {
                    "id": "20050107",
                    "speaker": "大森",
                    "text": "还在骗人，那可是救命的粮食，不是给你们这些武士中饱私囊用的！"
                },
                {
                    "id": "20050108",
                    "speaker": "悠也",
                    "text": "武士就能为所欲为了吗！我要去天领奉行所告你！"
                },
                {
                    "id": "20050109",
                    "speaker": "Player",
                    "text": "「救济粮」指的是…"
                },
                {
                    "id": "20050110",
                    "speaker": "大森",
                    "text": "你是谁？跟黑泽是一伙的吗？"
                },
                {
                    "id": "20050111",
                    "speaker": "派蒙",
                    "text": "不不不，我们只是路过的普通人。"
                },
                {
                    "id": "20050112",
                    "speaker": "派蒙",
                    "text": "听到你们在争吵，就想过来看看情况。"
                },
                {
                    "id": "20050113",
                    "speaker": "大森",
                    "text": "原来是这样。正好，你来帮我们评评理——"
                },
                {
                    "id": "20050114",
                    "speaker": "大森",
                    "text": "这个叫黑泽的武士，是幕府军的人。幕府军在这附近派发救济粮，他就是负责人。"
                },
                {
                    "id": "20050115",
                    "speaker": "大森",
                    "text": "以前我们只要找到他就可以领到粮食，但现在他突然不给了。"
                },
                {
                    "id": "20050116",
                    "speaker": "大森",
                    "text": "一定是他起了贪念，打算自己吞掉这批粮食！可是没有这批粮食，我们就要饿肚子了啊！"
                },
                {
                    "id": "20050117",
                    "speaker": "悠也",
                    "text": "根本就没人考虑我们的感受…以前还觉得他是个有良心的人，现在看来他和别的武士一样坏。"
                },
                {
                    "id": "20050118",
                    "speaker": "悠也",
                    "text": "怪不得连「神之眼」都被收回去了，雷电将军治理国家也不想要这样的人协助吧。"
                },
                {
                    "id": "20050119",
                    "speaker": "派蒙",
                    "text": "原来这个人就是绫华说的人呀，可绫华为什么要我们帮助这种人呢？"
                },
                {
                    "id": "20050120",
                    "speaker": "派蒙",
                    "text": "我们还是问问这位叫黑泽的武士是怎么想的吧。"
                }
            ]
        },
        {
            "id": "200506",
            "objective": "与武士黑泽对话",
            "dialogues": [
                {
                    "id": "20050501",
                    "speaker": "黑泽京之介",
                    "text": "什么救济粮，我听都没听说过这种事！"
                },
                {
                    "id": "20050502",
                    "speaker": "黑泽京之介",
                    "text": "不知道这些人从哪听说了一些传闻，就想跑过来讹诈我。可笑，我要是有救济粮可以私吞，还会穷成现在这个样子？"
                },
                {
                    "id": "20050503",
                    "speaker": "黑泽京之介",
                    "text": "我自己家都揭不开锅了…没什么事就让开吧，我还有事要做。"
                },
                {
                    "id": "20050504",
                    "speaker": "Player",
                    "text": "听说你失去了神之眼…"
                },
                {
                    "id": "20050505",
                    "speaker": "黑泽京之介",
                    "text": "这倒是真的。幕府军的人说我对眼狩令不满，一直在消极怠工，还说我对不起雷电将军，就把我的神之眼收走了。"
                },
                {
                    "id": "20050506",
                    "speaker": "派蒙",
                    "text": "奇怪，你是眼狩令的执行者呀，为什么会对眼狩令不满呢？"
                },
                {
                    "id": "20050507",
                    "speaker": "黑泽京之介",
                    "text": "这个…说实话，我也记不清了。"
                },
                {
                    "id": "20050508",
                    "speaker": "黑泽京之介",
                    "text": "我只记得，那时候我好像每个月都会做些什么事情，不过现在完全不想做了。"
                },
                {
                    "id": "20050509",
                    "speaker": "黑泽京之介",
                    "text": "不仅不记得了，还隐约觉得心里不太舒服…好像谁欠了我什么东西一样。"
                },
                {
                    "id": "20050510",
                    "speaker": "派蒙",
                    "text": "跟「救济粮」有关吗？"
                },
                {
                    "id": "20050511",
                    "speaker": "黑泽京之介",
                    "text": "我没有私吞救济粮！还是那句话，如果有救济粮可以拿，谁愿意像我现在这样过苦日子？"
                },
                {
                    "id": "20050512",
                    "speaker": "黑泽京之介",
                    "text": "而且我家刚刚还被盗宝团洗劫了…对了，我刚刚是追着盗宝团来这里，突然被拦下来的。"
                },
                {
                    "id": "20050513",
                    "speaker": "黑泽京之介",
                    "text": "你们要是不信的话，去教训一下盗宝团，问问他们，我家到底有没有「救济粮」？"
                },
                {
                    "id": "20050514",
                    "speaker": "派蒙",
                    "text": "唔…感觉他看上去不像是在说谎呢。"
                },
                {
                    "id": "20050515",
                    "speaker": "派蒙",
                    "text": "但是也不能确定…我们还是抓个盗宝团的人问问看吧。"
                },
                {
                    "id": "20050516",
                    "speaker": "派蒙",
                    "text": "顺着盗宝团留下的痕迹，应该就可以找到他们了。趁盗宝团还没有跑远，我们快追上去吧。"
                }
            ]
        },
        {
            "id": "200507",
            "objective": "前往阻拦洗劫黑泽家的盗宝团",
            "dialogues": [
                {
                    "id": "20050801",
                    "speaker": "阿贤",
                    "text": "大哥，今天的收获好像不错啊。"
                },
                {
                    "id": "20050802",
                    "speaker": "阿贤",
                    "text": "咱们去的那几个武士家，除了其中一个特别穷之外，基本都富得流油，这下可发财了。"
                },
                {
                    "id": "20050803",
                    "speaker": "忠夫",
                    "text": "这点钱算什么，这只是咱们兄弟发家致富的第一步！"
                },
                {
                    "id": "20050804",
                    "speaker": "忠夫",
                    "text": "今天开始，我会带着你们在盗宝行业闯出一番名堂，让我们威名远扬！"
                },
                {
                    "id": "20050805",
                    "speaker": "阿豪",
                    "text": "老大威武！"
                },
                {
                    "id": "20050806",
                    "speaker": "派蒙",
                    "text": "…看来他们就是我们要找的盗宝团了，让我们去教训他们一下吧。"
                }
            ]
        },
        {
            "id": "200502",
            "objective": "击败盗宝团",
            "dialogues": [
                {
                    "id": "20050201",
                    "speaker": "阿贤",
                    "text": "可恶，怎么会这样…我的钱，那可是我们辛辛苦苦偷来的啊……"
                },
                {
                    "id": "20050202",
                    "speaker": "阿贤",
                    "text": "老大，快想想办法啊！"
                },
                {
                    "id": "20050203",
                    "speaker": "忠夫",
                    "text": "咳咳，这个…我看你身手不错，不知道有没有兴趣加入盗宝团，与我们共谋大事？",
                    "choices": [
                        {
                            "id": "20050204",
                            "text": "先把黑泽的事情告诉我。",
                            "response": [
                                {
                                    "id": "20050206",
                                    "speaker": "忠夫",
                                    "text": "黑泽？哦哦…我想起来了。"
                                },
                                {
                                    "id": "20050207",
                                    "speaker": "忠夫",
                                    "text": "你们原来是他派来的？晦气，真是晦气，我就不应该顺路去他家…"
                                },
                                {
                                    "id": "20050208",
                                    "speaker": "派蒙",
                                    "text": "黑泽的家里怎么样？有很多粮食吧？"
                                },
                                {
                                    "id": "20050209",
                                    "speaker": "忠夫",
                                    "text": "粮食？没有没有，而且家里乱糟糟的，倒是…有个盒子挺别致的，我猜里面准有宝贝。"
                                },
                                {
                                    "id": "20050210",
                                    "speaker": "忠夫",
                                    "text": "本想回去再打开的，担心被什么其他人盯上。"
                                },
                                {
                                    "id": "20050211",
                                    "speaker": "忠夫",
                                    "text": "但既然被你们抓了，干脆就拿这盒子来赎我们自己吧，你看成不？"
                                },
                                {
                                    "id": "20050212",
                                    "speaker": "派蒙",
                                    "text": "算你们有诚意，快打开看看吧！"
                                },
                                {
                                    "id": "20050213",
                                    "speaker": "阿贤",
                                    "text": "啊！"
                                },
                                {
                                    "id": "20050214",
                                    "speaker": "忠夫",
                                    "text": "这是！"
                                },
                                {
                                    "id": "20050215",
                                    "speaker": "阿豪",
                                    "text": "欠、欠条？"
                                },
                                {
                                    "id": "20050216",
                                    "speaker": "派蒙",
                                    "text": "还有好多的样子…"
                                },
                                {
                                    "id": "20050217",
                                    "speaker": "派蒙",
                                    "text": "好像是写给杂货店葵小姐的欠条，哇…欠了好多钱呢。"
                                },
                                {
                                    "id": "20050218",
                                    "speaker": "派蒙",
                                    "text": "究竟是怎么回事呢…我们去杂货店问问吧。"
                                },
                                {
                                    "id": "20050219",
                                    "speaker": "派蒙",
                                    "text": "喂，你们走吧！当心下次不要再被我们逮到！"
                                },
                                {
                                    "id": "20050220",
                                    "speaker": "阿贤",
                                    "text": "好！好！谢谢小老爷。"
                                },
                                {
                                    "id": "20050221",
                                    "speaker": "阿豪",
                                    "text": "拿欠条赎了我们的身…是不是算我们赚钱了呢？"
                                },
                                {
                                    "id": "20050222",
                                    "speaker": "忠夫",
                                    "text": "快走吧你！"
                                }
                            ]
                        },
                        {
                            "id": "20050205",
                            "text": "听说你们洗劫了黑泽的家。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "200503",
            "objective": "与盗宝团对话",
            "dialogues": []
        },
        {
            "id": "200504",
            "objective": "与杂货店的葵小姐对话，了解情况",
            "dialogues": [
                {
                    "id": "20050301",
                    "speaker": "葵",
                    "text": "「九十九物」，无所不有。客人想要买点什么？"
                },
                {
                    "id": "20050302",
                    "speaker": "葵",
                    "text": "还是说…想要打听些什么？"
                },
                {
                    "id": "20050303",
                    "speaker": "Player",
                    "text": "这欠条…"
                },
                {
                    "id": "20050304",
                    "speaker": "葵",
                    "text": "呵呵，原来是黑泽先生的朋友，客人是来替黑泽先生偿还债务的吗？"
                },
                {
                    "id": "20050305",
                    "speaker": "派蒙",
                    "text": "不不不，我们只是想打听一下「欠条」的来历…"
                },
                {
                    "id": "20050306",
                    "speaker": "派蒙",
                    "text": "黑泽为什么会欠这么多钱，他在这里买了什么贵重的东西吗？"
                },
                {
                    "id": "20050307",
                    "speaker": "葵",
                    "text": "让我想想…"
                },
                {
                    "id": "20050308",
                    "speaker": "葵",
                    "text": "黑泽先生会定期在我们这里购买大量粮食，不过用的是他自己的薪水。"
                },
                {
                    "id": "20050309",
                    "speaker": "葵",
                    "text": "但是最近粮价上涨，黑泽先生自己的薪水已经不够了。他就开始向我们打欠条，通过赊账来换取等量的粮食。"
                },
                {
                    "id": "20050310",
                    "speaker": "派蒙",
                    "text": "原来「救济粮」是这么来的。"
                },
                {
                    "id": "20050311",
                    "speaker": "派蒙",
                    "text": "可是黑泽为什么一定要买「等量」的粮食呢？粮价上涨的话，少买一些不就可以了吗？"
                },
                {
                    "id": "20050312",
                    "speaker": "葵",
                    "text": "客人不妨想一下。领取「救济粮」的民众，在拿到这些粮食之前，一定会反复思考这些粮食能支撑多久。"
                },
                {
                    "id": "20050313",
                    "speaker": "葵",
                    "text": "他们精打细算，日夜核对，拿到手的时候却发现数量比预想中要少…黑泽先生认为，这会让他们感到很失望。"
                },
                {
                    "id": "20050314",
                    "speaker": "葵",
                    "text": "为了照顾他们的感受，黑泽先生宁愿通过赊账来换取等量的粮食。"
                },
                {
                    "id": "20050315",
                    "speaker": "派蒙",
                    "text": "这些粮食，实际上是黑泽自己买下来的…"
                },
                {
                    "id": "20050316",
                    "speaker": "派蒙",
                    "text": "他们没有感谢黑泽，反而还在不停地责怪他…"
                },
                {
                    "id": "20050317",
                    "speaker": "葵",
                    "text": "人的态度往往取决于他们的处境，在生存问题面前，大多数人是不会顾虑那么多的。"
                },
                {
                    "id": "20050318",
                    "speaker": "葵",
                    "text": "在我看来，如果黑泽从一开始就公布「救济粮」的来源，现在面临的麻烦应该会少一点…"
                },
                {
                    "id": "20050319",
                    "speaker": "葵",
                    "text": "当然，也只是少一点而已。他所做的，本来就是一件出力不讨好的事情。"
                },
                {
                    "id": "20050320",
                    "speaker": "葵",
                    "text": "至于他为什么要花钱购买粮食救灾，又为什么不愿留下姓名供人感激…这些我就不清楚了。"
                },
                {
                    "id": "20050321",
                    "speaker": "葵",
                    "text": "如果你们好奇的话，直接去问问黑泽先生如何？"
                },
                {
                    "id": "20050322",
                    "speaker": "Player",
                    "text": "他也不记得了。"
                },
                {
                    "id": "20050323",
                    "speaker": "葵",
                    "text": "哦…说起来，他好像刚刚被收缴了「神之眼」…"
                },
                {
                    "id": "20050324",
                    "speaker": "葵",
                    "text": "这就有点麻烦了…如果黑泽先生还不清欠款的话，他大概就只能卖掉那把他很珍视的刀了。"
                },
                {
                    "id": "20050325",
                    "speaker": "派蒙",
                    "text": "刀？那是什么？"
                },
                {
                    "id": "20050326",
                    "speaker": "葵",
                    "text": "黑泽先生没有跟你们说吗？他有一把很宝贝的刀，常年带在身上。"
                },
                {
                    "id": "20050327",
                    "speaker": "葵",
                    "text": "我也曾向他询问过刀的来历，黑泽先生说是他的父亲送的，再高的价格都不会卖掉。"
                },
                {
                    "id": "20050328",
                    "speaker": "葵",
                    "text": "当时我还感到有些遗憾，毕竟在我看来，世间万物都有价格，只要能开出相应的价码，应该什么都买得到。"
                },
                {
                    "id": "20050329",
                    "speaker": "葵",
                    "text": "你们也可以问问黑泽先生关于刀的事情。说不定你们要找的答案，就在那把刀上。"
                },
                {
                    "id": "20050330",
                    "speaker": "葵",
                    "text": "当然，在那之前，也请客人先结清一下这次的账单…"
                },
                {
                    "id": "20050331",
                    "speaker": "派蒙",
                    "text": "但我们明明什么也没有买呀？"
                },
                {
                    "id": "20050332",
                    "speaker": "葵",
                    "text": "呵呵，「情报」也是货物的一种，不是吗？"
                },
                {
                    "id": "20050333",
                    "speaker": "葵",
                    "text": "不过，关于黑泽先生的情报倒是并不贵，毕竟黑泽先生也没有特别叮嘱我们要保守秘密。让我想想…两千摩拉就好。"
                },
                {
                    "id": "20050334",
                    "speaker": "Player",
                    "text": "好吧。"
                },
                {
                    "id": "20050335",
                    "speaker": "派蒙",
                    "text": "至少我们知道了「救济粮」的来历，还有黑泽一直带着的那把刀…"
                },
                {
                    "id": "20050336",
                    "speaker": "派蒙",
                    "text": "再去找黑泽问问吧，看看他能不能想起来什么…"
                }
            ]
        },
        {
            "id": "200505",
            "objective": "与武士黑泽对话",
            "dialogues": [
                {
                    "id": "20050401",
                    "speaker": "派蒙",
                    "text": "怎么只有你一个人在这里呀，刚刚缠住你的那两个人呢？"
                },
                {
                    "id": "20050402",
                    "speaker": "黑泽京之介",
                    "text": "我对他们说，再不走的话，我就拔刀了。他们就走了。"
                },
                {
                    "id": "20050403",
                    "speaker": "黑泽京之介",
                    "text": "果然，这比用言语说服他们方便多了。或许，今后我也应该…"
                },
                {
                    "id": "20050404",
                    "speaker": "黑泽京之介",
                    "text": "盗宝团的事情查清楚了？我没有骗你们吧。"
                },
                {
                    "id": "20050405",
                    "speaker": "Player",
                    "text": "其实…"
                },
                {
                    "id": "20050406",
                    "speaker": "派蒙",
                    "text": "大概就是这样。其实你真的有发「救济粮」，只不过这些粮食是你自己掏钱买的。"
                },
                {
                    "id": "20050407",
                    "speaker": "黑泽京之介",
                    "text": "怎么会…以前的我是这样的人吗…"
                },
                {
                    "id": "20050408",
                    "speaker": "黑泽京之介",
                    "text": "我完全没有印象了。就算你告诉我了这些事情，我也想不起来了。"
                },
                {
                    "id": "20050409",
                    "speaker": "黑泽京之介",
                    "text": "以前的我为什么要做这种事？这不是自讨苦吃吗？真是难以理解…"
                },
                {
                    "id": "20050410",
                    "speaker": "黑泽京之介",
                    "text": "不过确实，刚刚握住这把刀，对他们两个施加威胁的时候，我也感受到了身体在本能地抗拒。",
                    "choices": [
                        {
                            "id": "20050411",
                            "text": "这把刀…",
                            "response": [
                                {
                                    "id": "20050413",
                                    "speaker": "黑泽京之介",
                                    "text": "这把刀，曾经是我老爹的佩刀。"
                                },
                                {
                                    "id": "20050414",
                                    "speaker": "黑泽京之介",
                                    "text": "我记得小时候有一次，我从老爹那里偷出来了这把刀，想要在邻居家的孩子面前炫耀一番，结果被老爹狠狠地教训了一顿。"
                                },
                                {
                                    "id": "20050415",
                                    "speaker": "黑泽京之介",
                                    "text": "他跟我说…说什么来着…奇怪，我又记不清了。"
                                },
                                {
                                    "id": "20050416",
                                    "speaker": "黑泽京之介",
                                    "text": "「神之眼」被夺走之后，我好像忘记了很多重要的事情。记忆里是大段大段的空白，不管怎么想都想不起来。"
                                },
                                {
                                    "id": "20050417",
                                    "speaker": "黑泽京之介",
                                    "text": "只记得老爹好像说过，这把刀上面，有他一生的信条。而他在离开这个世界之前，亲手把刀交到了我的手里…"
                                },
                                {
                                    "id": "20050418",
                                    "speaker": "黑泽京之介",
                                    "text": "还对我说，拿着这把刀，就应该…"
                                },
                                {
                                    "id": "20050419",
                                    "speaker": "派蒙",
                                    "text": "嗯…仔细看看的话，这个刀柄上是不是刻着字？"
                                },
                                {
                                    "id": "20050420",
                                    "speaker": "派蒙",
                                    "text": "旅行者，你能看出来上面刻着什么吗？"
                                },
                                {
                                    "id": "20050421",
                                    "speaker": "Player",
                                    "text": "是「仁义」。"
                                },
                                {
                                    "id": "20050422",
                                    "speaker": "黑泽京之介",
                                    "text": "「仁义」？"
                                },
                                {
                                    "id": "20050423",
                                    "speaker": "黑泽京之介",
                                    "text": "这么说的话，好像就能解释得通了…"
                                },
                                {
                                    "id": "20050424",
                                    "speaker": "黑泽京之介",
                                    "text": "不惜负债累累，也要让他人获得幸福，这就是我曾经最大的愿望吧。"
                                },
                                {
                                    "id": "20050425",
                                    "speaker": "黑泽京之介",
                                    "text": "但「仁义」，有什么用？我践行此道，用自己的钱买粮食救济他们，可结果呢？"
                                },
                                {
                                    "id": "20050426",
                                    "speaker": "黑泽京之介",
                                    "text": "天领奉行夺走了我的神之眼，而那些被我救济的人也不愿意理解我！"
                                },
                                {
                                    "id": "20050427",
                                    "speaker": "黑泽京之介",
                                    "text": "最讽刺的是，我朝他们拔刀的时候，还会感受到心痛。"
                                },
                                {
                                    "id": "20050428",
                                    "speaker": "黑泽京之介",
                                    "text": "我做不了好人，连坏人都当不了！我到底…到底该怎么办啊…"
                                },
                                {
                                    "id": "20050429",
                                    "speaker": "派蒙",
                                    "text": "又是一个好可怜的人…"
                                },
                                {
                                    "id": "20050430",
                                    "speaker": "派蒙",
                                    "text": "关于他欠钱的事，有空我们和托马他们说一下吧，社奉行应该会支援他一下的吧？"
                                },
                                {
                                    "id": "20050431",
                                    "speaker": "派蒙",
                                    "text": "总不能真的让他把自己珍视的刀也卖掉…",
                                    "choices": [
                                        {
                                            "id": "20050432",
                                            "text": "失去神之眼…",
                                            "response": [
                                                {
                                                    "id": "20050434",
                                                    "speaker": "派蒙",
                                                    "text": "嗯…原来失去愿望是这么可怕的一件事。"
                                                },
                                                {
                                                    "id": "20050435",
                                                    "speaker": "派蒙",
                                                    "text": "好在你没有神之眼，对吧？"
                                                },
                                                {
                                                    "id": "20050436",
                                                    "speaker": "派蒙",
                                                    "text": "我们还是去下一个失去神之眼的人那里吧。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "20050433",
                                            "text": "好像确实很可怕。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "20050412",
                            "text": "能让我们看一下吗？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "200509",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "20050901",
                    "speaker": "悠也",
                    "text": "救济粮，我的救济粮…"
                }
            ]
        },
        {
            "id": "200510",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "20051001",
                    "speaker": "大森",
                    "text": "做人做事，可得讲良心啊！"
                }
            ]
        },
        {
            "id": "200511",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "20051101",
                    "speaker": "大森",
                    "text": "别骗人了，快点把粮食交出来！"
                }
            ]
        },
        {
            "id": "200512",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "20051201",
                    "speaker": "悠也",
                    "text": "呜呜，没有救济粮我可怎么活啊…"
                }
            ]
        },
        {
            "id": "200513",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "20051301",
                    "speaker": "黑泽京之介",
                    "text": "想不到有一天，需要靠盗宝团来证明我的清白…"
                }
            ]
        }
    ]
}