    "talks": [
        {
            "id": "7618401",
            "objective": "前往月矩力试验设计局高处开启茶会",
            "dialogues": [
                {
                    "id": "761840101",
                    "speaker": "「公子」",
                    "text": "哟，真是新奇。想不到我还有一天能被邀请参加桑多涅你的茶会。"
                },
                {
                    "id": "761840102",
                    "speaker": "「木偶」",
                    "text": "要是你的茶会礼仪好一些的话，我以前说不定还会考虑考虑多邀请你几次。"
                },
                {
                    "id": "761840103",
                    "speaker": "「仆人」",
                    "text": "同意。而且最好不要每次都提出要和我们当中的人比试一番。"
                },
                {
                    "id": "761840104",
                    "speaker": "「公子」",
                    "text": "你们怎么和我家里的哥哥姐姐一样，老这么说我。没办法，以前在野外接受师父训练的时候，不太注意这些。"
                },
                {
                    "id": "761840105",
                    "speaker": "「木偶」",
                    "text": "算了，能这么聚在一起的机会也不多。还是安心享受当下的时光吧。"
                },
                {
                    "id": "761840106",
                    "speaker": "「公子」",
                    "text": "哦？这就是你的最新机器？"
                },
                {
                    "id": "761840107",
                    "speaker": "「木偶」",
                    "text": "她叫法洁欧。全功能通用型自动机关。"
                },
                {
                    "id": "761840108",
                    "speaker": "「公子」",
                    "text": "这么看来，普隆尼亚那个大家伙是真的无法被修复了吗…我很遗憾，桑多涅。"
                },
                {
                    "id": "761840109",
                    "speaker": "「木偶」",
                    "text": "没事的，我…"
                },
                {
                    "id": "761840110",
                    "speaker": "「公子」",
                    "text": "我很遗憾没能和他打上一场。"
                },
                {
                    "id": "761840111",
                    "speaker": "「木偶」",
                    "text": "我就知道…"
                },
                {
                    "id": "761840112",
                    "speaker": "「公子」",
                    "text": "那个大家伙看起来真的挺强，法洁欧看起来…"
                },
                {
                    "id": "761840113",
                    "speaker": "「木偶」",
                    "text": "…你是想说她看起来很弱吗？"
                },
                {
                    "id": "761840114",
                    "speaker": "「公子」",
                    "text": "呃…哈哈，没有没有。只是，看起来没普隆尼亚那个大家伙那么强而已。"
                },
                {
                    "id": "761840115",
                    "speaker": "「木偶」",
                    "text": "啧，普隆尼亚是算术机械，他的战斗能力是我在不影响他算力的基础上添加的。"
                },
                {
                    "id": "761840116",
                    "speaker": "「木偶」",
                    "text": "但法洁欧无需处理复杂的术式，换言之，她的所有算力，都能够用于处理战斗模块。"
                },
                {
                    "id": "761840117",
                    "speaker": "「公子」",
                    "text": "也就是…比普隆尼亚更厉害的意思？真的假的…"
                },
                {
                    "id": "761840118",
                    "speaker": "「木偶」",
                    "text": "我看你是真的想开开眼界是吧？"
                },
                {
                    "id": "761840119",
                    "speaker": "「公子」",
                    "text": "先说好，打坏了我可不付维修费。"
                },
                {
                    "id": "761840120",
                    "speaker": "「木偶」",
                    "text": "我可不付医药费。"
                },
                {
                    "id": "761840121",
                    "speaker": "「仆人」",
                    "text": "（哎…果然还是发展成这样了。）"
                },
                {
                    "id": "761840122",
                    "speaker": "「少女」",
                    "text": "（嚼嚼…）"
                }
            ]
        },
        {
            "id": "7618402",
            "objective": "前往月矩力试验设计局高处开启茶会",
            "dialogues": []
        },
        {
            "id": "7618403",
            "objective": "享受茶会时光",
            "dialogues": []
        },
        {
            "id": "7618404",
            "objective": "享受茶会时光",
            "dialogues": [
                {
                    "id": "761840301",
                    "speaker": "「公子」",
                    "text": "不错的茶会。早知道我以前就该多参加几次。",
                    "choices": [
                        {
                            "id": "761840302",
                            "text": "（再这么坐一会儿吧。）",
                            "response": [
                                {
                                    "id": "761840304",
                                    "speaker": "「公子」",
                                    "text": "好啊，我们下次再见！"
                                }
                            ]
                        },
                        {
                            "id": "761840303",
                            "text": "茶会时间该结束了。"
                        }
                    ]
                }
            ]
        }
    ]
}