        {
            "id": "2005412",
            "objective": "将战利品和信交给特纳",
            "dialogues": [
                {
                    "id": "2005407101",
                    "speaker": "特纳",
                    "text": "你好，客人，欢迎来到晨曦酒庄…"
                },
                {
                    "id": "2005407102",
                    "speaker": "Player",
                    "text": "这是盖伊的信。"
                },
                {
                    "id": "2005407103",
                    "speaker": "特纳",
                    "text": "他写信给我了吗？谢谢，还麻烦你给我带来…"
                },
                {
                    "id": "2005407104",
                    "speaker": "特纳",
                    "text": "和骑士团的骑士们一起在野外清除丘丘人？"
                },
                {
                    "id": "2005407105",
                    "speaker": "特纳",
                    "text": "他才刚进去没多久，就已经开始在外出任务了吗？"
                },
                {
                    "id": "2005407106",
                    "speaker": "Player",
                    "text": "这是他的战利品。"
                },
                {
                    "id": "2005407107",
                    "speaker": "派蒙",
                    "text": "盖伊先生很厉害哦，一口气把那些丘丘人都消灭掉了！"
                },
                {
                    "id": "2005407108",
                    "speaker": "派蒙",
                    "text": "我们都是在旁边亲眼看到的！"
                },
                {
                    "id": "2005407109",
                    "speaker": "特纳",
                    "text": "哦…哦，是这样吗…还真是丘丘人的战利品…"
                },
                {
                    "id": "2005407110",
                    "speaker": "特纳",
                    "text": "哼，这些普普通通的东西嘛，老头子我年轻时也能轻易拿到…"
                },
                {
                    "id": "2005407111",
                    "speaker": "特纳",
                    "text": "不过，那小子也算是在努力吧！"
                },
                {
                    "id": "2005407112",
                    "speaker": "特纳",
                    "text": "客人，实在是麻烦您了，您要不在这休息一下？",
                    "choices": [
                        {
                            "id": "2005407113",
                            "text": "不用了。",
                            "response": [
                                {
                                    "id": "2005407115",
                                    "speaker": "特纳",
                                    "text": "好，您急着回去对吧，就不耽误您了。"
                                },
                                {
                                    "id": "2005407117",
                                    "speaker": "特纳",
                                    "text": "这些您拿着，留着路上用。还有那些战利品，老头子我也用不上，您也留着吧。"
                                },
                                {
                                    "id": "2005407118",
                                    "speaker": "特纳",
                                    "text": "西风骑士…加油啊，臭小子。"
                                }
                            ]
                        },
                        {
                            "id": "2005407114",
                            "text": "您要给他回信吗？",
                            "response": [
                                {
                                    "id": "2005407116",
                                    "speaker": "特纳",
                                    "text": "不用了，哼…他还要继续努力才行。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
