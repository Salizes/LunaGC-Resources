    "talks": [
        {
            "id": "1480101",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "698450101",
                    "speaker": "那维莱特",
                    "text": "……"
                },
                {
                    "id": "698450102",
                    "speaker": "Player",
                    "text": "（那维莱特？竟然一个人在这里淋雨…难道是心情不好？）"
                },
                {
                    "id": "698450103",
                    "speaker": "Player",
                    "text": "（相逢是缘，去打个招呼吧。）"
                },
                {
                    "id": "698450104",
                    "speaker": "Player",
                    "text": "你好。"
                },
                {
                    "id": "698450105",
                    "speaker": "那维莱特",
                    "text": "#是你啊，{NICKNAME}，你也好。"
                },
                {
                    "id": "698450106",
                    "speaker": "Player",
                    "text": "最近还好吗？"
                },
                {
                    "id": "698450107",
                    "speaker": "那维莱特",
                    "text": "一切如常，多谢关心。"
                },
                {
                    "id": "698450108",
                    "speaker": "Player",
                    "text": "心情不错？"
                },
                {
                    "id": "698450109",
                    "speaker": "那维莱特",
                    "text": "嗯，你看出来了？"
                },
                {
                    "id": "698450110",
                    "speaker": "那维莱特",
                    "text": "晨报的天气预测栏目说今日此时此地会有降雨。"
                },
                {
                    "id": "698450111",
                    "speaker": "那维莱特",
                    "text": "以我的经验来看，这类预测的准确性总是有待考证…"
                },
                {
                    "id": "698450112",
                    "speaker": "那维莱特",
                    "text": "但今天很幸运，大雨如期而至了。"
                },
                {
                    "id": "698450113",
                    "speaker": "Player",
                    "text": "太好了，为你高兴。"
                },
                {
                    "id": "698450114",
                    "speaker": "那维莱特",
                    "text": "谢谢。"
                },
                {
                    "id": "698450115",
                    "speaker": "那维莱特",
                    "text": "不过我也知道，淋雨只是我的私人爱好，一般人并没有这样的习惯。"
                },
                {
                    "id": "698450116",
                    "speaker": "那维莱特",
                    "text": "雨势如此之大，你站在这里陪我，没问题吗？",
                    "choices": [
                        {
                            "id": "698450117",
                            "text": "没关系。",
                            "response": [
                                {
                                    "id": "698450119",
                                    "speaker": "那维莱特",
                                    "text": "唔…原来如此…"
                                },
                                {
                                    "id": "698450120",
                                    "speaker": "Player",
                                    "text": "怎么了？"
                                },
                                {
                                    "id": "698450121",
                                    "speaker": "那维莱特",
                                    "text": "是这样…之前我曾听到美露莘们在聊天，抱怨天气经常不配合自己的准备。"
                                },
                                {
                                    "id": "698450122",
                                    "speaker": "那维莱特",
                                    "text": "比如为了可能出现的雨天带伞出门的时候反而晴空万里，然而一旦抱着侥幸心理没有带伞，当天反而会倾盆大雨。"
                                },
                                {
                                    "id": "698450123",
                                    "speaker": "那维莱特",
                                    "text": "当然，我知道这之间并没有什么必然联系，毕竟我也亲自尝试过…"
                                },
                                {
                                    "id": "698450124",
                                    "speaker": "那维莱特",
                                    "text": "嗯…简而言之，收效甚微。"
                                },
                                {
                                    "id": "698450125",
                                    "speaker": "那维莱特",
                                    "text": "不过既然你此时提及，我难免会觉得，今日能遇上这场大雨，没准是托了你的福。",
                                    "choices": [
                                        {
                                            "id": "698450126",
                                            "text": "我真厉害。",
                                            "response": [
                                                {
                                                    "id": "698450128",
                                                    "speaker": "那维莱特",
                                                    "text": "呵呵…这是在开玩笑，对吧？"
                                                },
                                                {
                                                    "id": "698450129",
                                                    "speaker": "那维莱特",
                                                    "text": "本以为这场大雨会影响你的行程，但看起来并没有影响你的心情。"
                                                },
                                                {
                                                    "id": "698450130",
                                                    "speaker": "Player",
                                                    "text": "能停下脚步思考也是难得的体验。"
                                                },
                                                {
                                                    "id": "698450131",
                                                    "speaker": "那维莱特",
                                                    "text": "的确，独自安静地站在雨中，很容易让思绪飘到很远的地方…"
                                                },
                                                {
                                                    "id": "698450132",
                                                    "speaker": "那维莱特",
                                                    "text": "就比如现在，我在想，雨水在天空中落下，和气泡从水中升起，其实可以算是同一种现象。"
                                                },
                                                {
                                                    "id": "698450133",
                                                    "speaker": "那维莱特",
                                                    "text": "对吧？"
                                                },
                                                {
                                                    "id": "698450134",
                                                    "speaker": "Player",
                                                    "text": "欸…"
                                                },
                                                {
                                                    "id": "698450135",
                                                    "speaker": "那维莱特",
                                                    "text": "怎么样，是不错的玩笑吧？",
                                                    "choices": [
                                                        {
                                                            "id": "698450136",
                                                            "text": "是玩笑？其实还挺有道理的。",
                                                            "response": [
                                                                {
                                                                    "id": "698450138",
                                                                    "speaker": "那维莱特",
                                                                    "text": "好，我记下来了。"
                                                                },
                                                                {
                                                                    "id": "698450139",
                                                                    "speaker": "那维莱特",
                                                                    "text": "能得到你的认可，我很高兴。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "698450137",
                                                            "text": "挺好的，下次可以讲给别人听。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "698450127",
                                            "text": "实不相瞒，我是雨神。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "698450118",
                            "text": "反正我也没带伞。"
                        }
                    ]
                }
            ]
        }
    ]
}