    "talks": [
        {
            "id": "7211801",
            "objective": "（test）隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "721180101",
                    "speaker": "泽维尔",
                    "text": "终于！全部完成了，幸好我还记得那些制作规范…"
                },
                {
                    "id": "721180102",
                    "speaker": "Player",
                    "text": "要进去净化那些「祟神」了吗？"
                },
                {
                    "id": "721180103",
                    "speaker": "泽维尔",
                    "text": "我是很想直接进去彻底了结这件事，但对付「祟神」的时候可不能掉以轻心。"
                },
                {
                    "id": "721180104",
                    "speaker": "泽维尔",
                    "text": "而且，因为有些材料实在找不到，只能拿另外的材料临时替代，所以这架装置的可靠性有些…"
                },
                {
                    "id": "721180105",
                    "speaker": "泽维尔",
                    "text": "呃…应该这么说，「在某些情况下，存在无法达到预期运行状态的情况」。"
                },
                {
                    "id": "721180106",
                    "speaker": "泽维尔",
                    "text": "虽然正常使用应该是没问题，但以这架装置的状态，应该不太经得起意外情况，要是遇见点颠簸，说不定连零件都会颠出来几个…"
                },
                {
                    "id": "721180107",
                    "speaker": "泽维尔",
                    "text": "所以，在把这位新伙计运进去干活之前，我们还得做点准备工作。"
                },
                {
                    "id": "721180108",
                    "speaker": "泽维尔",
                    "text": "我想请您先去「御影炉心」附近，记录一下数据。",
                    "choices": [
                        {
                            "id": "721180109",
                            "text": "交给我吧。",
                            "response": [
                                {
                                    "id": "721180110",
                                    "speaker": "泽维尔",
                                    "text": "那就拜托您了，我就在这里等着您。"
                                }
                            ]
                        },
                        {
                            "id": "721180111",
                            "text": "这么谨慎的吗…",
                            "response": [
                                {
                                    "id": "721180112",
                                    "speaker": "泽维尔",
                                    "text": "那当然了。我还是略过了很多步骤，要是弗洛瓦先生来，按他的流程，我们至少还得多花一周。"
                                },
                                {
                                    "id": "721180113",
                                    "speaker": "泽维尔",
                                    "text": "总之，这次我们就特事特办吧，反正我代表特别评议小组…现在我授权我们，依照现场状况见机行事。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7211802",
            "objective": "与泽维尔对话",
            "dialogues": []
        },
        {
            "id": "7211803",
            "objective": "拍摄「御影炉心」的状况",
            "dialogues": [
                {
                    "id": "721180301",
                    "speaker": "泽维尔",
                    "text": "怎么，状况记录好了吗？"
                },
                {
                    "id": "721180302",
                    "speaker": "Player",
                    "text": "已经记录好了。"
                }
            ]
        },
        {
            "id": "7211804",
            "objective": "拍摄「御影炉心」的状况",
            "dialogues": [
                {
                    "id": "721180401",
                    "speaker": "泽维尔",
                    "text": "太好了，让我看看…"
                },
                {
                    "id": "721180402",
                    "speaker": "泽维尔",
                    "text": "我们的运气还不错，「御影炉心」的状态很稳定，而且周围的「祟神」能量也不算太浓重。"
                },
                {
                    "id": "721180403",
                    "speaker": "泽维尔",
                    "text": "这种浓度的话，我的那架装置应该还能撑得住。"
                },
                {
                    "id": "721180404",
                    "speaker": "Player",
                    "text": "是要净化掉所有「祟神」能量吗？"
                },
                {
                    "id": "721180405",
                    "speaker": "泽维尔",
                    "text": "这台装置如果能做到这种程度的事情的话，我早该提交专利申请了。这位新伙计顶多只能降低局部区域的能量指标而已。"
                },
                {
                    "id": "721180406",
                    "speaker": "泽维尔",
                    "text": "不过，「御影炉心」之所以停机，连自动重启程序也无法执行，就是因为被高浓度的「祟神」能量包裹。"
                },
                {
                    "id": "721180407",
                    "speaker": "泽维尔",
                    "text": "只要我们去找到「祟神」浓度最高的地方，净化掉它，让核心重新运行起来。"
                },
                {
                    "id": "721180408",
                    "speaker": "泽维尔",
                    "text": "然后，「御影炉心」应该就会重启。再之后，就没有我们需要操心的事情了。"
                },
                {
                    "id": "721180409",
                    "speaker": "泽维尔",
                    "text": "这就是我全部的计划，在那之前，我还得再做些准备。"
                }
            ]
        },
        {
            "id": "7211805",
            "objective": "（test）废弃$HIDDEN",
            "dialogues": [
                {
                    "id": "721180501",
                    "speaker": "泽维尔",
                    "text": "最近那些愚人众的活动越来越怪异了，他们似乎都集中在核心的区域。"
                },
                {
                    "id": "721180502",
                    "speaker": "泽维尔",
                    "text": "希望这群家伙别是又在打什么鬼主意…或者说，不要做什么我们收拾不了的事情…"
                }
            ]
        },
        {
            "id": "7211808",
            "objective": "向泽维尔回报",
            "dialogues": []
        },
        {
            "id": "7211809",
            "objective": "向泽维尔回报",
            "dialogues": []
        },
        {
            "id": "7211802",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "721180201",
                    "speaker": "泽维尔",
                    "text": "真不知道稻妻这边有没有给「御影炉心」派一个项目管理…"
                }
            ]
        }
    ]
