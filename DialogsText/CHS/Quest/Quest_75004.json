        {
            "id": "7500410",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "750041001",
                    "speaker": "「西弗安雅」",
                    "text": "「离…离开，封印此处——就如——约定那样——」"
                },
                {
                    "id": "750041002",
                    "speaker": "「西弗安雅」",
                    "text": "（那声音仿佛来自岿然不动的造像的深处，话语中的拒绝之意犹如坚毅的双手那样，企图将你推离此处…）"
                }
            ]
        },
        {
            "id": "7500499",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "750049901",
                    "speaker": "？？？",
                    "text": "过来…来这里…"
                },
                {
                    "id": "750049902",
                    "speaker": "？？？",
                    "text": "你带来了许多，许多应得安息的长眠者…"
                }
            ]
