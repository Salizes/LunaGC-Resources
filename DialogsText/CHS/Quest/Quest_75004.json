    "talks": [
        {
            "id": "7500401",
            "objective": "调查下方的洞窟",
            "dialogues": [
                {
                    "id": "750040101",
                    "speaker": "派蒙",
                    "text": "咦，在这里怎么会有一块石碑…"
                },
                {
                    "id": "750040102",
                    "speaker": "蒂图",
                    "text": "大概是以前部族里的人留下来的吧，经常会有这样的东西，在很久以前作为警告的界碑，告诉你「你已经越界！」"
                },
                {
                    "id": "750040103",
                    "speaker": "蒂图",
                    "text": "你们在纳塔路边有时能看到一些刻有白色纹路的石头，也是差不多的作用，只不过那些现在都已经被废弃了。"
                },
                {
                    "id": "750040104",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "唔！"
                },
                {
                    "id": "750040105",
                    "speaker": "派蒙",
                    "text": "原来是这样。"
                },
                {
                    "id": "750040106",
                    "speaker": "蒂图",
                    "text": "边界，在纳塔也是很严肃的事情…生者与死者，内与外，上与下，只有真正行于界线中的人才能掌握好危险的分寸。"
                },
                {
                    "id": "750040107",
                    "speaker": "蒂图",
                    "text": "据说以前也曾有过古遗迹中的石碑：「任何怀有不轨之心之人踏过此碑，我将用手化作龙爪扼住其人的脖颈。」"
                },
                {
                    "id": "750040108",
                    "speaker": "派蒙",
                    "text": "啊，那如果这块石碑上写着什么警告或者诅咒之类的…可怎么办啊…"
                },
                {
                    "id": "750040109",
                    "speaker": "蒂图",
                    "text": "看看就知道了…这是陶奥鲁留下的，居然，欸…",
                    "choices": [
                        {
                            "id": "750040110",
                            "text": "好像在哪听到过…",
                            "response": [
                                {
                                    "id": "750040111",
                                    "speaker": "派蒙",
                                    "text": "是之前蒂图讲过的，在深渊侵蚀纳塔的时候，带领部族里的人和深渊…还有两位坎瑞亚士兵交战的人啦。"
                                },
                                {
                                    "id": "750040113",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "呀！"
                                },
                                {
                                    "id": "750040114",
                                    "speaker": "蒂图",
                                    "text": "哦哦，你们记得很清楚嘛。讲故事的人大多数的时候都很喜欢这种能够记住故事的人哦。"
                                },
                                {
                                    "id": "750040115",
                                    "speaker": "蒂图",
                                    "text": "毕竟…记住故事也是成为讲故事的人最基础的素质。"
                                },
                                {
                                    "id": "750040116",
                                    "speaker": "蒂图",
                                    "text": "我看看…"
                                },
                                {
                                    "id": "750040117",
                                    "speaker": "派蒙",
                                    "text": "上面写着，异邦的朋友…「西弗安雅与伊利萨」…"
                                },
                                {
                                    "id": "750040118",
                                    "speaker": "派蒙",
                                    "text": "嗯…「你们更希望在故事里你们是懦夫、暴徒或悬挂的钉刺，就像咬龙的蜜虫那样让部族的人们不敢懈怠，世代警惕。」"
                                },
                                {
                                    "id": "750040119",
                                    "speaker": "派蒙",
                                    "text": "嗯…「但我要在这里说出真相。因你们永远是与部族共进退的豪杰，永远是回声之子的兄弟。」"
                                },
                                {
                                    "id": "750040120",
                                    "speaker": "派蒙",
                                    "text": "啊，原来那两个坎瑞亚人，还和部族一起战斗过？"
                                },
                                {
                                    "id": "750040121",
                                    "speaker": "蒂图",
                                    "text": "…这是，那两位坎瑞亚士兵的名字，在、在所有的故事里他们都是邪恶的化身，我甚至在噩梦中也看到过他们的身形。"
                                },
                                {
                                    "id": "750040122",
                                    "speaker": "蒂图",
                                    "text": "「再不停止哭泣，坎瑞亚士兵的亡灵就将循声找到你的影子」…结果其实都是假的，是一场骗局？"
                                },
                                {
                                    "id": "750040123",
                                    "speaker": "蒂图",
                                    "text": "可是这对他们不公平…凭什么，为部族付出那么大牺牲的人却要背负那么久的骂名。"
                                },
                                {
                                    "id": "750040124",
                                    "speaker": "派蒙",
                                    "text": "是啊，那也太可怜了吧。"
                                },
                                {
                                    "id": "750040125",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "呜…"
                                },
                                {
                                    "id": "750040126",
                                    "speaker": "Player",
                                    "text": "他们并不在乎是否得享美誉…"
                                },
                                {
                                    "id": "750040127",
                                    "speaker": "Player",
                                    "text": "他们只在乎意志是否得到执行。"
                                },
                                {
                                    "id": "750040128",
                                    "speaker": "派蒙",
                                    "text": "是这样吗…啊，我，我明白了！"
                                },
                                {
                                    "id": "750040129",
                                    "speaker": "派蒙",
                                    "text": "就像大部分的英雄，并不是为了得到赞扬才去做那些让他们成为英雄的事。"
                                },
                                {
                                    "id": "750040130",
                                    "speaker": "派蒙",
                                    "text": "他们是去「做了那些事」，才成为了英雄，所以才不在乎别人怎么评价他们吧…"
                                },
                                {
                                    "id": "750040131",
                                    "speaker": "蒂图",
                                    "text": "……"
                                },
                                {
                                    "id": "750040132",
                                    "speaker": "蒂图",
                                    "text": "唉，也许真的是这样，可是…"
                                },
                                {
                                    "id": "750040133",
                                    "speaker": "派蒙",
                                    "text": "啊，「镌光铭印」继续向前飞了！"
                                },
                                {
                                    "id": "750040134",
                                    "speaker": "派蒙",
                                    "text": "#哇，这里就是…就是他们最终封印了深渊的地方，看，{NICKNAME}，那个中间，有好多金色的花纹…"
                                },
                                {
                                    "id": "750040135",
                                    "speaker": "Player",
                                    "text": "也有泄露的深渊的痕迹。"
                                },
                                {
                                    "id": "750040136",
                                    "speaker": "蒂图",
                                    "text": "看来，就是那个在吸引「镌光铭印」，无论如何我们得到那里看看才行…"
                                }
                            ]
                        },
                        {
                            "id": "750040112",
                            "text": "啊，是抵抗深渊的长老…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7500420",
            "objective": "调查下方的洞窟",
            "dialogues": []
        },
        {
            "id": "7500402",
            "objective": "调查下方的洞窟",
            "dialogues": [
                {
                    "id": "750040201",
                    "speaker": "？？？",
                    "text": "咝——呃，啊啊啊啊——都说了——危险，离、离开——"
                },
                {
                    "id": "750040202",
                    "speaker": "？？？",
                    "text": "灾厄——将封印——撕碎——"
                },
                {
                    "id": "750040203",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "呜…呜…"
                },
                {
                    "id": "750040204",
                    "speaker": "蒂图",
                    "text": "那个声音，更加完整，但是…不知道为什么，感觉并没有之前那么害怕。"
                },
                {
                    "id": "750040205",
                    "speaker": "蒂图",
                    "text": "只不过头还是有点疼。"
                },
                {
                    "id": "750040206",
                    "speaker": "派蒙",
                    "text": "#{NICKNAME}呢，有什么感觉吗？",
                    "choices": [
                        {
                            "id": "750040207",
                            "text": "没什么大碍…",
                            "response": [
                                {
                                    "id": "750040208",
                                    "speaker": "派蒙",
                                    "text": "那就好那就好。"
                                },
                                {
                                    "id": "750040211",
                                    "speaker": "派蒙",
                                    "text": "#那，{REALNAME[ID(2)|SHOWHOST(true)]}，有没有觉得不舒服呀？"
                                },
                                {
                                    "id": "750040212",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "嗯？"
                                },
                                {
                                    "id": "750040213",
                                    "speaker": "派蒙",
                                    "text": "看来好像暂时也没什么事…"
                                },
                                {
                                    "id": "750040214",
                                    "speaker": "蒂图",
                                    "text": "到了这里就能很明显感知到，声音是从石柱子上来的…那应该是…"
                                },
                                {
                                    "id": "750040215",
                                    "speaker": "Player",
                                    "text": "一起被封印的坎瑞亚士兵…"
                                },
                                {
                                    "id": "750040216",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "呜…"
                                },
                                {
                                    "id": "750040217",
                                    "speaker": "派蒙",
                                    "text": "也就是说，他们的意识也和深渊一起，被封印了那么多年…可是，这里到底出了什么问题呢？"
                                },
                                {
                                    "id": "750040218",
                                    "speaker": "蒂图",
                                    "text": "其实…这里的问题和在上面的「小缝影针」很像，深渊的涌动让「镌光铭印」的力量破碎并被挤压出了大的封印之柱中…"
                                },
                                {
                                    "id": "750040219",
                                    "speaker": "派蒙",
                                    "text": "所以我们需要找到在这里的大「镌光铭印」的碎片，然后想办法把「蛋壳」重新拼起来。"
                                },
                                {
                                    "id": "750040220",
                                    "speaker": "蒂图",
                                    "text": "对，这样，封印就能恢复完整，深渊也能持续被封印在此，然后…一切估计就能够恢复原样了。"
                                },
                                {
                                    "id": "750040221",
                                    "speaker": "蒂图",
                                    "text": "不过就和之前在「小缝影针」那里一样。固态燃素构建的地面和深渊会有剧烈的冲突反应，这也是地面起伏不定的原因…"
                                },
                                {
                                    "id": "750040222",
                                    "speaker": "蒂图",
                                    "text": "这点请一定要小心啊。"
                                },
                                {
                                    "id": "750040223",
                                    "speaker": "派蒙",
                                    "text": "不过，大「镌光铭印」的碎片啊，到底应该怎么找呢…"
                                },
                                {
                                    "id": "750040224",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "呀…呀！"
                                },
                                {
                                    "id": "750040225",
                                    "speaker": "派蒙",
                                    "text": "#什么，有铭印的力量藏在那个里面吗，{REALNAME[ID(2)|SHOWHOST(true)]}的鼻子很灵哦…呃，你用的是鼻子吗？"
                                },
                                {
                                    "id": "750040226",
                                    "speaker": "派蒙",
                                    "text": "不过之前有这样一块石头吗？"
                                },
                                {
                                    "id": "750040227",
                                    "speaker": "蒂图",
                                    "text": "#刚才，{NICKNAME}靠近大「镌光铭印」的时候…好像是那时候出现的？"
                                },
                                {
                                    "id": "750040228",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "嗯？"
                                },
                                {
                                    "id": "750040229",
                                    "speaker": "派蒙",
                                    "text": "好啦，总之，我们先到那块石块周围看看！"
                                }
                            ]
                        },
                        {
                            "id": "750040209",
                            "text": "感觉声音挺立体的。",
                            "response": [
                                {
                                    "id": "750040210",
                                    "speaker": "派蒙",
                                    "text": "谁问你这个啦！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7500403",
            "objective": "触碰铭印",
            "dialogues": []
        },
        {
            "id": "7500404",
            "objective": "触碰铭印",
            "dialogues": [
                {
                    "id": "750040401",
                    "speaker": "派蒙",
                    "text": "奇怪，刚才看见好多散落的光…然后我们就到这里来了？"
                },
                {
                    "id": "750040402",
                    "speaker": "派蒙",
                    "text": "咦，那个是…"
                },
                {
                    "id": "750040403",
                    "speaker": "「毛发如夜的野兽」",
                    "text": "过来…来这里…"
                },
                {
                    "id": "750040404",
                    "speaker": "「毛发如夜的野兽」",
                    "text": "你带来了许多，许多应得安息的长眠者…"
                },
                {
                    "id": "750040405",
                    "speaker": "「毛发如夜的野兽」",
                    "text": "或许他们向不应祈求的灵祈求了…"
                },
                {
                    "id": "750040406",
                    "speaker": "「毛发如夜的野兽」",
                    "text": "但那是在不可伸手视物的无月之夜，所以夜晚早就原谅了他们。只是恨意与污秽永不能停息，他们也永远无法真正睡去。"
                },
                {
                    "id": "750040407",
                    "speaker": "「毛发如夜的野兽」",
                    "text": "感谢你，受钟爱之人…你抚平他们暗中流涌的愤怒，将他们带入夜晚的倒影，而异邦的灵魂也得以回归他们所向之处…"
                },
                {
                    "id": "750040408",
                    "speaker": "「毛发如夜的野兽」",
                    "text": "……"
                },
                {
                    "id": "750040409",
                    "speaker": "「毛发如夜的野兽」",
                    "text": "去吧，但要小心危险的唆使，要小心阴险者谋划的结局。"
                }
            ]
        },
        {
            "id": "7500405",
            "objective": "跟随铭印",
            "dialogues": []
        },
        {
            "id": "7500418",
            "objective": "(test)隐藏-talk中改状态$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7500406",
            "objective": "寻找铭印的碎片",
            "dialogues": [
                {
                    "id": "750040601",
                    "speaker": "蒂图",
                    "text": "#哈…怎么样，{NICKNAME}，现在，可以解开「镌光铭印」的封印？",
                    "choices": [
                        {
                            "id": "750040602",
                            "text": "嗯，现在开始吧。",
                            "response": [
                                {
                                    "id": "750040603",
                                    "speaker": "蒂图",
                                    "text": "那我这就…打开封印，还请一切小心。"
                                }
                            ]
                        },
                        {
                            "id": "750040604",
                            "text": "让我再准备一下。",
                            "response": [
                                {
                                    "id": "750040605",
                                    "speaker": "蒂图",
                                    "text": "好的，如果准备好了，还请随时和我说…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7500407",
            "objective": "寻找铭印的碎片",
            "dialogues": []
        },
        {
            "id": "7500408",
            "objective": "寻找铭印的碎片",
            "dialogues": []
        },
        {
            "id": "7500409",
            "objective": "前往封印之柱",
            "dialogues": []
        },
        {
            "id": "7500410",
            "objective": "解放铭印的封锁",
            "dialogues": [
                {
                    "id": "750040301",
                    "speaker": "蒂图",
                    "text": "只要再触摸一次，让燃素的力量在「镌光铭印」完整地流转一遍「蛋壳」就能完整封上了吧…深渊也没有办法跑出来了。"
                },
                {
                    "id": "750040302",
                    "speaker": "派蒙",
                    "text": "唔，这样问题就能得到解决了…"
                },
                {
                    "id": "750040303",
                    "speaker": "蒂图",
                    "text": "嗯…我来试试…"
                },
                {
                    "id": "750040304",
                    "speaker": "？？？",
                    "text": "快，快把我们一起封印进去——就像说好的那样——"
                },
                {
                    "id": "750040305",
                    "speaker": "？？？",
                    "text": "咝—然后离开，离开——你们为什么还不离开——灾厄——"
                },
                {
                    "id": "750040306",
                    "speaker": "蒂图",
                    "text": "仔细听，不只有…那下面不只有两位士兵说话的声音。"
                },
                {
                    "id": "750040307",
                    "speaker": "Black Screen",
                    "text": "从那发光纹路的背后，从那痛苦的嘶吼更为遥远之处…\\n你听到有人在怒吼，你听到有龙在忍痛低吟。\\n你听到血肉交融至一处的声音，和话语无法形容的黏腻巨物缓缓向前行进的脚步。\\n但你也听到，仿佛有千万只手，千万只手在不断抗拒，在向外推搡…"
                },
                {
                    "id": "750040308",
                    "speaker": "Black Screen",
                    "text": "你听到你听到你听到…在狭小的黑暗里，那是一场永远无法停息的战斗。\\n那是一场…持续到永恒终结之时的折磨。",
                    "choices": [
                        {
                            "id": "750040309",
                            "text": "他们无法获得安息…",
                            "response": [
                                {
                                    "id": "750040311",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "呜！"
                                },
                                {
                                    "id": "750040312",
                                    "speaker": "蒂图",
                                    "text": "那些英雄们，他们直到今日也在不停战斗…为了不让深渊从「镌光铭印」之后涌出。"
                                },
                                {
                                    "id": "750040313",
                                    "speaker": "蒂图",
                                    "text": "我叙说那些故事是有意义的，我们一直铭记着这些勇士的牺牲，不忘记他们的所有付出。"
                                },
                                {
                                    "id": "750040314",
                                    "speaker": "蒂图",
                                    "text": "…可是，可是这份痛苦太沉重了。这跟故事不一样，故事里我们说：「英雄们受了伤，抖了抖身子，就跟没事人一样站了起来。」"
                                },
                                {
                                    "id": "750040315",
                                    "speaker": "蒂图",
                                    "text": "但是，真正的受伤，真正的折磨不是那样轻松的东西…他们一直在承受那样巨大的痛苦，在那狭小无光的世界，承受了那么多年。"
                                },
                                {
                                    "id": "750040316",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "呜！"
                                },
                                {
                                    "id": "750040317",
                                    "speaker": "派蒙",
                                    "text": "怎么会这样，我们就不能做些什么吗？"
                                },
                                {
                                    "id": "750040318",
                                    "speaker": "蒂图",
                                    "text": "我…我也想为他们做些什么，可是，那可是深渊…"
                                },
                                {
                                    "id": "750040319",
                                    "speaker": "蒂图",
                                    "text": "也许唯一能做的就是继承他们的意志，重新将「镌光铭印」封上…在部族的故事里，「缝影针」并不是第一次掉落。"
                                },
                                {
                                    "id": "750040320",
                                    "speaker": "蒂图",
                                    "text": "从前肯定也有人到这里，从前也有人…看到过陶奥鲁的碑文。那些修复「镌光铭印」的人，一定也看到了我们看到的那些。"
                                },
                                {
                                    "id": "750040321",
                                    "speaker": "蒂图",
                                    "text": "但是…部族里的故事没有更改过。因为故事里的警告是真实的警告，危险也是真实的危险。"
                                },
                                {
                                    "id": "750040322",
                                    "speaker": "蒂图",
                                    "text": "我们只能修复完「镌光铭印」，然后离开，我们只能…铭记一切，不遗忘在这里看到的任何事…"
                                },
                                {
                                    "id": "750040323",
                                    "speaker": "派蒙",
                                    "text": "可是…呜，可是他们明明是英雄，却要一直在这里受折磨…"
                                },
                                {
                                    "id": "750040324",
                                    "speaker": "Player",
                                    "text": "派蒙说得对。"
                                },
                                {
                                    "id": "750040325",
                                    "speaker": "Player",
                                    "text": "英雄不该落得这样的结局。"
                                },
                                {
                                    "id": "750040326",
                                    "speaker": "蒂图",
                                    "text": "我知道，我也想让那些仍然受苦的战士们得到安息，可是…我没有那样的力量，我、我只是个叙事人…"
                                },
                                {
                                    "id": "750040327",
                                    "speaker": "派蒙",
                                    "text": "#{NICKNAME}…"
                                },
                                {
                                    "id": "750040328",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "唔！",
                                    "choices": [
                                        {
                                            "id": "750040329",
                                            "text": "没关系，我们有力量。",
                                            "response": [
                                                {
                                                    "id": "750040331",
                                                    "speaker": "蒂图",
                                                    "text": "#…{NICKNAME}，真的吗，你们真的愿意帮忙？"
                                                },
                                                {
                                                    "id": "750040332",
                                                    "speaker": "派蒙",
                                                    "text": "#嗯，我就知道{NICKNAME}一定会愿意出手。"
                                                },
                                                {
                                                    "id": "750040333",
                                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                                    "text": "呀！"
                                                },
                                                {
                                                    "id": "750040334",
                                                    "speaker": "蒂图",
                                                    "text": "#深渊可是很危险的…不过，我这么说并不是质疑{NICKNAME}的实力，只是…不希望你们勉强自己。"
                                                },
                                                {
                                                    "id": "750040335",
                                                    "speaker": "派蒙",
                                                    "text": "没关系，对付深渊，我们可谓是经验丰富啦。而且，不是还有那个「镌光铭印」在嘛。"
                                                },
                                                {
                                                    "id": "750040336",
                                                    "speaker": "蒂图",
                                                    "text": "嗯…"
                                                },
                                                {
                                                    "id": "750040337",
                                                    "speaker": "蒂图",
                                                    "text": "唉，你们比我想象的还要了不起。你们愿意为解决他人的痛苦而付出自己的力量，真的，真的是很了不起的英雄。"
                                                },
                                                {
                                                    "id": "750040338",
                                                    "speaker": "蒂图",
                                                    "text": "#对，我是叙事人…我要记录下英雄的故事。异邦而来的英雄{NICKNAME}啊，请务必…请务必让我看看你们战胜深渊的英姿吧。"
                                                },
                                                {
                                                    "id": "750040339",
                                                    "speaker": "Player",
                                                    "text": "嗯，一定能赢的！"
                                                },
                                                {
                                                    "id": "750040340",
                                                    "speaker": "蒂图",
                                                    "text": "那么…要现在解开「镌光铭印」吗，还是，再做一些准备？",
                                                    "choices": [
                                                        {
                                                            "id": "750040341",
                                                            "text": "现在就解开吧。",
                                                            "response": [
                                                                {
                                                                    "id": "750040342",
                                                                    "speaker": "蒂图",
                                                                    "text": "#好的，{NICKNAME}，祝你…不，是希望你能够成功！"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "750040343",
                                                            "text": "稍等，再做些准备。",
                                                            "response": [
                                                                {
                                                                    "id": "750040344",
                                                                    "speaker": "蒂图",
                                                                    "text": "#好的，尽可能做些准备吧…小心一些，{NICKNAME}。"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "750040330",
                                            "text": "重新书写一下故事的结局吧。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "750040310",
                            "text": "他们仍然在战斗…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7500419",
            "objective": "解放铭印的封锁",
            "dialogues": []
        },
        {
            "id": "7500411",
            "objective": "让战士们得到安宁",
            "dialogues": [
                {
                    "id": "750041101",
                    "speaker": "「伊利萨」",
                    "text": "「快走，快走吧…我可不想我狼狈的样子——被他知晓——」"
                },
                {
                    "id": "750041102",
                    "speaker": "「伊利萨」",
                    "text": "（那声音仿佛来自岿然不动的造像深处，而话语中仍然遗留着对于某人的崇敬之意…）"
                }
            ]
        },
        {
            "id": "7500412",
            "objective": "让战士们得到安宁",
            "dialogues": []
        },
        {
            "id": "7500415",
            "objective": "前往封印之柱",
            "dialogues": [
                {
                    "id": "750041501",
                    "speaker": "尤考姆",
                    "text": "唔，你们平安无事吗？真不知道刚才发生了什么。"
                },
                {
                    "id": "750041502",
                    "speaker": "尤考姆",
                    "text": "突然发生了很大的地震，我还担心你们呢，看到你们安然无恙就好了。"
                },
                {
                    "id": "750041503",
                    "speaker": "尤考姆",
                    "text": "至于蒂图？蒂图，这家伙怎么还不过来接我的岗，真是的，不如被刚才的地震震死算了！"
                }
            ]
        },
        {
            "id": "7500413",
            "objective": "聆听夜的低语",
            "dialogues": []
        },
        {
            "id": "7500414",
            "objective": "与蒂图对话",
            "dialogues": [
                {
                    "id": "750040501",
                    "speaker": "蒂图",
                    "text": "#你们终于回来了，我和{REALNAME[ID(2)|SHOWHOST(true)]}都很担心。"
                },
                {
                    "id": "750040502",
                    "speaker": "蒂图",
                    "text": "不过你看，我说了，小家伙，他们会平安无事地回来的。"
                },
                {
                    "id": "750040503",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "呜呜…"
                },
                {
                    "id": "750040504",
                    "speaker": "派蒙",
                    "text": "哎呀，我们也没法解释刚才到了哪里…",
                    "choices": [
                        {
                            "id": "750040505",
                            "text": "一时半会儿也说不清…",
                            "response": [
                                {
                                    "id": "750040508",
                                    "speaker": "蒂图",
                                    "text": "#多谢你，{NICKNAME}，没想到，此处的深渊真的得以净化。"
                                },
                                {
                                    "id": "750040509",
                                    "speaker": "蒂图",
                                    "text": "就像是…不用在此停留了一样，那些「镌光铭印」也消失不见了。那些痛苦的声音也得到平息。"
                                },
                                {
                                    "id": "750040510",
                                    "speaker": "蒂图",
                                    "text": "金色的光芒啊，金色的光芒如流水一般融散入地面。"
                                },
                                {
                                    "id": "750040511",
                                    "speaker": "蒂图",
                                    "text": "我甚至觉得那些光芒里好像有人在跟我们招手…"
                                },
                                {
                                    "id": "750040512",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "呀！"
                                },
                                {
                                    "id": "750040513",
                                    "speaker": "蒂图",
                                    "text": "小家伙你也看到啦？我看到那些光芒围绕着你们，然后你们就不见了。"
                                },
                                {
                                    "id": "750040514",
                                    "speaker": "派蒙",
                                    "text": "是嘛…我们倒是什么都没看见。"
                                },
                                {
                                    "id": "750040515",
                                    "speaker": "蒂图",
                                    "text": "#唉，真是感谢你们，{NICKNAME}，派蒙，还有{REALNAME[ID(2)|SHOWHOST(true)]}。"
                                },
                                {
                                    "id": "750040516",
                                    "speaker": "蒂图",
                                    "text": "你们是真的了不起的英雄，我替那些终于得以安息的战士们感谢你，陶奥鲁的遗愿也被达成，还有…"
                                },
                                {
                                    "id": "750040517",
                                    "speaker": "蒂图",
                                    "text": "还有那两位坎瑞亚的士兵，不，那两位坎瑞亚的英雄，既然这里的深渊已经不在，也不需要他们背负骂名以作警示。"
                                },
                                {
                                    "id": "750040518",
                                    "speaker": "蒂图",
                                    "text": "我一定要写关于他们拯救了回声之子的故事…其实之前有一个瞬间，我感觉完全理解了他们的想法。"
                                },
                                {
                                    "id": "750040519",
                                    "speaker": "蒂图",
                                    "text": "这里有的可是深渊，这么危险，如果是我，我也一定要编造点恐怖故事，不让…不让后来的部族人靠近。"
                                },
                                {
                                    "id": "750040520",
                                    "speaker": "蒂图",
                                    "text": "唉…没想到今天之前还在为写什么故事而烦恼，现在倒是有很多想写的。比如，金发的异邦人，会飞的白色精灵，还有小嵴锋龙拯救了部族的故事。"
                                },
                                {
                                    "id": "750040521",
                                    "speaker": "派蒙",
                                    "text": "嘿嘿，这个听上去就很了不起！"
                                },
                                {
                                    "id": "750040522",
                                    "speaker": "蒂图",
                                    "text": "嗯，故事会流转，也会变化，说不定等传到很久很久以后，派蒙也会变成山一样大的派蒙呢。"
                                },
                                {
                                    "id": "750040523",
                                    "speaker": "Player",
                                    "text": "吼吼，山一样大的勇士派蒙！"
                                },
                                {
                                    "id": "750040524",
                                    "speaker": "派蒙",
                                    "text": "哼，山一样大的勇士派蒙，一口一个驮兽那么大的甜甜花酿鸡！"
                                },
                                {
                                    "id": "750040525",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "呀！呀！"
                                },
                                {
                                    "id": "750040526",
                                    "speaker": "蒂图",
                                    "text": "哈哈，驮兽那么大的甜甜花酿鸡可没有那么多呀。"
                                },
                                {
                                    "id": "750040527",
                                    "speaker": "蒂图",
                                    "text": "然后那两位士兵…在故事的继续流传之后，也会逐渐成为英雄吧。他们或许对此没什么所谓，可我知道那是我应该做的。"
                                },
                                {
                                    "id": "750040528",
                                    "speaker": "蒂图",
                                    "text": "#哎呀，真是太感谢你了…{NICKNAME}，派蒙…对，还有知觉灵敏的{REALNAME[ID(2)|SHOWHOST(true)]}。"
                                },
                                {
                                    "id": "750040529",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "呀！"
                                },
                                {
                                    "id": "750040530",
                                    "speaker": "蒂图",
                                    "text": "…我以叙事人的身份起誓，一定会为你们写一个最精彩的故事。"
                                },
                                {
                                    "id": "750040531",
                                    "speaker": "蒂图",
                                    "text": "啊，不过说起来…我还得先回去接哨站里站岗的班。"
                                },
                                {
                                    "id": "750040532",
                                    "speaker": "蒂图",
                                    "text": "唔，经历了那么多事，都快忘了。"
                                },
                                {
                                    "id": "750040533",
                                    "speaker": "蒂图",
                                    "text": "这下完蛋了，这么久还没回去，尤考姆得活剥了我！"
                                },
                                {
                                    "id": "750040534",
                                    "speaker": "派蒙",
                                    "text": "对哦！你还是先回去站岗吧！"
                                }
                            ]
                        },
                        {
                            "id": "750040506",
                            "text": "看到了发光的猫…",
                            "response": [
                                {
                                    "id": "750040507",
                                    "speaker": "蒂图",
                                    "text": "…是、是嘛。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
