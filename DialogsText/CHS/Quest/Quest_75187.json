    "talks": [
        {
            "id": "7518703",
            "objective": "(test)初始计时$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7518701",
            "objective": "(test)任务接取$HIDDEN",
            "dialogues": [
                {
                    "id": "751870101",
                    "speaker": "派蒙",
                    "text": "#角上没有火焰一样的花纹…不是{REALNAME[ID(2)|SHOWHOST(true)]}…"
                },
                {
                    "id": "751870102",
                    "speaker": "派蒙",
                    "text": "唔，这个小家伙又是哪来的？"
                },
                {
                    "id": "751870103",
                    "speaker": "Player",
                    "text": "奥奇卡纳塔的龙蛋…"
                },
                {
                    "id": "751870104",
                    "speaker": "派蒙",
                    "text": "哦，是那个时候的龙蛋！"
                },
                {
                    "id": "751870105",
                    "speaker": "幼小的嵴锋龙",
                    "text": "呜呀？"
                },
                {
                    "id": "751870106",
                    "speaker": "派蒙",
                    "text": "没想到蛋里的也是一只嵴锋龙呢…"
                },
                {
                    "id": "751870107",
                    "speaker": "派蒙",
                    "text": "我记得之前保护这枚龙蛋的人给它取名…这个小家伙的名字是「阿瓜拉」？"
                },
                {
                    "id": "751870108",
                    "speaker": "阿瓜拉",
                    "text": "呀！"
                },
                {
                    "id": "751870109",
                    "speaker": "派蒙",
                    "text": "哦哦，看来你对自己的名字有反应呢！"
                },
                {
                    "id": "751870110",
                    "speaker": "阿瓜拉",
                    "text": "唔嗯？"
                },
                {
                    "id": "751870111",
                    "speaker": "派蒙",
                    "text": "#就跟{REALNAME[ID(2)|SHOWHOST(true)]}一样，这家伙也没有家了呢…"
                },
                {
                    "id": "751870112",
                    "speaker": "派蒙",
                    "text": "#那不然就跟我们一起吧！嘿嘿，我和{NICKNAME}，可会和嵴锋龙做朋友了！"
                },
                {
                    "id": "751870113",
                    "speaker": "阿瓜拉",
                    "text": "呀！呀！"
                },
                {
                    "id": "751870114",
                    "speaker": "派蒙",
                    "text": "嘿嘿…我就知道你会答应的！"
                },
                {
                    "id": "751870115",
                    "speaker": "Black Screen",
                    "text": "你像一度为曾经的伙伴那样，为它系上了丝巾。"
                },
                {
                    "id": "751870116",
                    "speaker": "派蒙",
                    "text": "嗯，上一只戴着丝巾的小龙，最后成长成了很了不起，很了不起的家伙！"
                },
                {
                    "id": "751870117",
                    "speaker": "派蒙",
                    "text": "阿瓜拉！希望、希望你也能像它一样，健康长大！"
                }
            ]
        },
        {
            "id": "7518702",
