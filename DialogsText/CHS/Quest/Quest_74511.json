    "talks": [
        {
            "id": "7451101",
            "objective": "与警备队成员对话",
            "dialogues": [
                {
                    "id": "745110101",
                    "speaker": "弗雷瑞斯",
                    "text": "两位朋友，你们好。"
                },
                {
                    "id": "745110102",
                    "speaker": "派蒙",
                    "text": "你们是…警备队？找我们有什么事吗？"
                },
                {
                    "id": "745110103",
                    "speaker": "谢妮",
                    "text": "嘿嘿，猜猜看？",
                    "choices": [
                        {
                            "id": "745110104",
                            "text": "难道说是在城里飞檐走壁…",
                            "response": [
                                {
                                    "id": "745110106",
                                    "speaker": "谢妮",
                                    "text": "你们居然还做过这种事呀！慢点说，我立刻记录在案。"
                                },
                                {
                                    "id": "745110107",
                                    "speaker": "派蒙",
                                    "text": "原来是在诈我们！"
                                },
                                {
                                    "id": "745110108",
                                    "speaker": "谢妮",
                                    "text": "开个玩笑。介绍一下，我叫谢妮，这位是我的前辈，弗雷瑞斯。"
                                },
                                {
                                    "id": "745110109",
                                    "speaker": "谢妮",
                                    "text": "前辈最近做了一款新发明，想找人帮忙尝试一下，不知道两位有没有兴趣？"
                                },
                                {
                                    "id": "745110110",
                                    "speaker": "派蒙",
                                    "text": "发明？什么新发明呀？"
                                },
                                {
                                    "id": "745110111",
                                    "speaker": "弗雷瑞斯",
                                    "text": "一种可以远程控制的炮台。"
                                },
                                {
                                    "id": "745110112",
                                    "speaker": "谢妮",
                                    "text": "你们看，以前的炮台需要有人在旁边操控吧？那敌方只要瞄准炮台，就可以把我们一锅端掉啦。但是如果我们可以远程操控的话…"
                                },
                                {
                                    "id": "745110113",
                                    "speaker": "弗雷瑞斯",
                                    "text": "就可以尽量减少伤亡了。"
                                },
                                {
                                    "id": "745110114",
                                    "speaker": "谢妮",
                                    "text": "就是这样！不愧是「曾三次拒绝枫丹科学院邀请」的弗雷瑞斯前辈，居然能轻松做出这么神奇的发明！"
                                },
                                {
                                    "id": "745110115",
                                    "speaker": "Player",
                                    "text": "三次拒绝枫丹科学院邀请？"
                                },
                                {
                                    "id": "745110116",
                                    "speaker": "弗雷瑞斯",
                                    "text": "这个…"
                                },
                                {
                                    "id": "745110117",
                                    "speaker": "谢妮",
                                    "text": "没错！我跟你们说哦，枫丹科学院曾经看中弗雷瑞斯前辈的才华，三次花重金聘请他去做高端研究。"
                                },
                                {
                                    "id": "745110118",
                                    "speaker": "谢妮",
                                    "text": "前辈因为热爱警备队的工作，所以一直留在这里，多么感人！"
                                },
                                {
                                    "id": "745110119",
                                    "speaker": "谢妮",
                                    "text": "即便如此，前辈还是不忍自己的才华被浪费，所以时不时会创造出一些新发明，为我们解决各种苦恼！"
                                },
                                {
                                    "id": "745110120",
                                    "speaker": "派蒙",
                                    "text": "听起来好厉害！"
                                },
                                {
                                    "id": "745110121",
                                    "speaker": "弗雷瑞斯",
                                    "text": "咳。过誉了。谢妮，还记得我对你的教导吗？越是聪明的人，越懂得谦虚的可贵。"
                                },
                                {
                                    "id": "745110122",
                                    "speaker": "谢妮",
                                    "text": "是，弗雷瑞斯前辈！"
                                },
                                {
                                    "id": "745110123",
                                    "speaker": "弗雷瑞斯",
                                    "text": "总之，我们想请两位帮忙验证这款远程炮台的可行性。「场地」和「标靶」我们已经准备好了，关于酬劳，我们也绝对不会吝啬。"
                                },
                                {
                                    "id": "745110124",
                                    "speaker": "派蒙",
                                    "text": "嘿嘿，这你可找对人啦。"
                                },
                                {
                                    "id": "745110125",
                                    "speaker": "派蒙",
                                    "text": "#我和{NICKNAME}一路走来，见过各种各样的新鲜东西。就让我们帮你鉴定一下，你的发明到底好不好用！"
                                },
                                {
                                    "id": "745110126",
                                    "speaker": "谢妮",
                                    "text": "加油，两位。加油，弗雷瑞斯前辈！"
                                },
                                {
                                    "id": "745110127",
                                    "speaker": "弗雷瑞斯",
                                    "text": "呃…总之，这边请吧。"
                                }
                            ]
                        },
                        {
                            "id": "745110105",
                            "text": "难道说是在城里舞刀弄剑…"
                        }
                    ]
                }
            ]
        }
    ]
}