            "dialogues": [
                {
                    "id": "740752901",
                    "speaker": "Black Screen",
                    "text": "仔细检查了机关顶部的空间，什么都没有发现。"
                },
                {
                    "id": "740752902",
                    "speaker": "派蒙",
                    "text": "这里的东西…也被人拿走了吗？"
                }
            ]
        },
        {
            "id": "7407599",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "740759901",
                    "speaker": "派蒙",
                    "text": "不是说是封印吗？这里的门已经打开了欸。"
                },
                {
                    "id": "740759902",
                    "speaker": "卡特皮拉",
                    "text": "……"
                },
                {
                    "id": "740759903",
                    "speaker": "西摩尔",
                    "text": "是这里吗？视野内确认也有石碑。"
                }
            ]
        }
    ]
}