        {
            "id": "7524001",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "752400101",
                    "speaker": "纳瓦特拉利",
                    "text": "朋友，欢迎来到阿亚尔英雄杯的比赛现场，我是这里的主持人。"
                },
                {
                    "id": "752400102",
                    "speaker": "纳瓦特拉利",
                    "text": "今天已经是赛程的最后一天，如果你想夺冠，你必须连续击败排名前三的勇士。"
                },
                {
                    "id": "752400107",
                    "speaker": "Player",
                    "text": "阿亚尔英雄杯是什么？"
                },
                {
                    "id": "752400108",
                    "speaker": "纳瓦特拉利",
                    "text": "是角逐阿亚尔荣耀的战斗，用你的拳头或者武器或者任何方式击倒对手吧！"
                },
                {
                    "id": "752400109",
                    "speaker": "Player",
                    "text": "阿亚尔又是什么人？"
                },
                {
                    "id": "752400110",
                    "speaker": "纳瓦特拉利",
                    "text": "朋友，在这里只有冠军才有发问的资格。"
                },
                {
                    "id": "752400111",
                    "speaker": "纳瓦特拉利",
                    "text": "上台吧，让我看看你有没有实力获得尊敬。"
                }
            ]
        },
        {
            "id": "7524002",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "752400201",
                    "speaker": "图瓦哈克",
                    "text": "小个子，小心你的胳膊别被我砸断了。"
                },
                {
                    "id": "752400202",
                    "speaker": "Player",
                    "text": "我要挑战你。"
