    "talks": [
        {
            "id": "7369601",
            "objective": "与巴哈尔对话",
            "dialogues": [
                {
                    "id": "736960101",
                    "speaker": "巴哈尔",
                    "text": "你好，旅行者，看你样子…应该是来这里参加学院游乐会的吧？"
                },
                {
                    "id": "736960102",
                    "speaker": "巴哈尔",
                    "text": "有兴趣的话，要不要来体验一下我们室罗婆耽学院举办的活动？"
                },
                {
                    "id": "736960103",
                    "speaker": "Player",
                    "text": "我记得室罗婆耽学院研究的是…"
                },
                {
                    "id": "736960104",
                    "speaker": "巴哈尔",
                    "text": "用一个词组不严谨概括的话，就是…「语言」。"
                },
                {
                    "id": "736960105",
                    "speaker": "巴哈尔",
                    "text": "这就是我们室罗婆耽学院所研究的东西。"
                },
                {
                    "id": "736960106",
                    "speaker": "巴哈尔",
                    "text": "怎么样？是不是一听就和学院游乐会欢乐轻松的氛围不搭？"
                },
                {
                    "id": "736960107",
                    "speaker": "巴哈尔",
                    "text": "我们学院里的不少同学也是这么想的，大家都在热热闹闹地玩，我们总不可能出去让人猜谜吧？"
                },
                {
                    "id": "736960108",
                    "speaker": "巴哈尔",
                    "text": "而且猜谜这种小游戏，实在也无法引起大家的兴趣…"
                },
                {
                    "id": "736960109",
                    "speaker": "巴哈尔",
                    "text": "在经过很多天的…友好讨论后，我们研究出了这种名为「追溯求真」的小游戏。"
                },
                {
                    "id": "736960110",
                    "speaker": "巴哈尔",
                    "text": "这个小游戏也不需要太多道具，只要你调整好自己的思维就行。"
                },
                {
                    "id": "736960111",
                    "speaker": "巴哈尔",
                    "text": "在这个游戏的开始，我会向你讲一个小故事。这个小故事也许听起来没头没尾，有些地方甚至有悖常理。"
                },
                {
                    "id": "736960112",
                    "speaker": "巴哈尔",
                    "text": "而你可以向我「提问」。对于你的提问，我会做出<color=#00E1FFFF>「是」</color>，<color=#00E1FFFF>「否」</color>和<color=#00E1FFFF>「没有关系」</color>三种回答。"
                },
                {
                    "id": "736960113",
                    "speaker": "巴哈尔",
                    "text": "你所要做的，就是用你的「提问」来找出这个故事的「真相」。"
                },
                {
                    "id": "736960114",
                    "speaker": "巴哈尔",
                    "text": "但你也不用太紧张，这个故事的真相不会太复杂的。"
                },
                {
                    "id": "736960115",
                    "speaker": "巴哈尔",
                    "text": "怎么样？如果有兴趣的话，我们现在就开始吧？",
                    "choices": [
                        {
                            "id": "736960116",
                            "text": "那就开始吧。",
                            "response": [
                                {
                                    "id": "736960117",
                                    "speaker": "巴哈尔",
                                    "text": "没问题，请你听好第一个故事。"
                                }
                            ]
                        },
                        {
                            "id": "736960118",
                            "text": "还有别的事。",
                            "response": [
                                {
                                    "id": "736960119",
                                    "speaker": "巴哈尔",
                                    "text": "这段时间，我会一直在这里，你想玩的话可以随时来找我。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7369699",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "736969901",
                    "speaker": "巴哈尔",
                    "text": "（追溯，还求真，最后还是猜谜语…唉…）"
                }
            ]
        }
    ]
}