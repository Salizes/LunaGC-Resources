    "talks": [
        {
            "id": "7273401",
            "objective": "(test)任务npc对话block$HIDDEN",
            "dialogues": [
                {
                    "id": "727340101",
                    "speaker": "「金龟奇术番长」",
                    "text": "不严谨，不优雅，不精彩，不奇妙，什么都不搭。"
                },
                {
                    "id": "727340102",
                    "speaker": "荒泷一斗",
                    "text": "你在神神叨叨什么，评价你那些败下阵来的同伴吗？"
                },
                {
                    "id": "727340103",
                    "speaker": "「金龟奇术番长」",
                    "text": "……"
                },
                {
                    "id": "727340104",
                    "speaker": "「金龟奇术番长」",
                    "text": "说的是你们斗虫的风格。"
                },
                {
                    "id": "727340105",
                    "speaker": "荒泷一斗",
                    "text": "啊？你的脑袋被漂浮灵砸过吗？本大爷又不是来表演节目的！本大爷讲究的是热血、强劲和势不可当！你要来领教一下吗？"
                },
                {
                    "id": "727340106",
                    "speaker": "「金龟奇术番长」",
                    "text": "想起了不好的回忆…我不能和你这种大大咧咧的家伙对阵。"
                },
                {
                    "id": "727340107",
                    "speaker": "「金龟奇术番长」",
                    "text": "#唔，这位金发的{M#先生}{F#小姐}看起来很好对付…决定了！我要挑战{M#他}{F#她}！"
                },
                {
                    "id": "727340108",
                    "speaker": "荒泷一斗",
                    "text": "噗…哈哈哈哈哈哈哈！"
                },
                {
                    "id": "727340109",
                    "speaker": "荒泷一斗",
                    "text": "我的挚友，听见了吗？他说你好对付！你快来好好招待这家伙！",
                    "choices": [
                        {
                            "id": "727340110",
                            "text": "哈哈，我就不客气啦！",
                            "response": [
                                {
                                    "id": "727340112",
                                    "speaker": "派蒙",
                                    "text": "真是让人看不懂呢，这些人根本就没有收集对手的情报嘛，一个接一个地过来送战果。"
                                },
                                {
                                    "id": "727340113",
                                    "speaker": "派蒙",
                                    "text": "「花角玉将」的团队简直就像是散装的！策略这方面远远不如我们三个嘛！"
                                }
                            ]
                        },
                        {
                            "id": "727340111",
                            "text": "呜呜，请不要欺负我…"
                        }
                    ]
                }
            ]
        }
    ]
}