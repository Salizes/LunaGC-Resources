    "talks": [
        {
            "id": "7093201",
            "objective": "",
            "dialogues": [
                {
                    "id": "709320101",
                    "speaker": "Player",
                    "text": "你的家族…"
                },
                {
                    "id": "709320102",
                    "speaker": "芬德",
                    "text": "多数人平静的生活，往往需要少数人付出牺牲，而我的家族恰好正是这少数人的一份子。"
                },
                {
                    "id": "709320103",
                    "speaker": "芬德",
                    "text": "不过我的家族在得到温妮莎大人的命令时，便已经有了觉悟。"
                },
                {
                    "id": "709320104",
                    "speaker": "芬德",
                    "text": "…你听说过「风神杂烩菜」吗？传闻中是温妮莎大人击败旧贵族后，庆功宴上的一道名菜。"
                },
                {
                    "id": "709320105",
                    "speaker": "芬德",
                    "text": "我的祖先也有幸与温妮莎大人共享盛宴，事后还根据味道请大厨推断出了菜谱。"
                },
                {
                    "id": "709320106",
                    "speaker": "芬德",
                    "text": "那味道如同清风拂过耳畔，胸中仿佛回荡着风神对于安宁与自由的祝愿…正是这道菜支撑着我们一族度过千百个守望风暴的日日夜夜。"
                },
                {
                    "id": "709320107",
                    "speaker": "芬德",
                    "text": "…感谢你的聆听，我想把这种感觉也传达给你，菜谱就请你收下吧，不必客气。"
                }
            ]
        }
    ]
}