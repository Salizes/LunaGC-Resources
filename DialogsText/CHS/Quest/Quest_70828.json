    "talks": [
        {
            "id": "7082801",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "708280101",
                    "speaker": "埃尔西",
                    "text": "啊！那边那位金发的冒险家，请等一下！",
                    "choices": [
                        {
                            "id": "708280103",
                            "text": "需要帮忙吗？",
                            "response": [
                                {
                                    "id": "708280102",
                                    "speaker": "埃尔西",
                                    "text": "不是不是，只是想问你有没有关于爱情的诗集。"
                                },
                                {
                                    "id": "708280107",
                                    "speaker": "埃尔西",
                                    "text": "你看，本小姐是超厉害的吟游诗人，也许是蒙德历史上除了巴巴托斯大人以外最厉害的吟游诗人…总之就是特别厉害！"
                                },
                                {
                                    "id": "708280108",
                                    "speaker": "埃尔西",
                                    "text": "但那个叫莱纳斯的吟游诗人似乎总是不服气，一天到晚跑来找本小姐念诗！不管怎么看都是在故意挑衅，对吧？"
                                },
                                {
                                    "id": "708280109",
                                    "speaker": "埃尔西",
                                    "text": "更可气的是，他念的还都是什么爱情啊、恋人啊…都是本小姐完全没写过的主题。"
                                },
                                {
                                    "id": "708280110",
                                    "speaker": "埃尔西",
                                    "text": "所以，我决定亲自出马，写一首震撼全蒙德的伟大爱情诗，让他见识一下什么叫真正的才华！"
                                },
                                {
                                    "id": "708280111",
                                    "speaker": "埃尔西",
                                    "text": "不过嘛…本小姐把时间都奉献给了伟大的艺术，暂时还没空去体验爱情。"
                                },
                                {
                                    "id": "708280112",
                                    "speaker": "埃尔西",
                                    "text": "所以，要是有什么关于爱情的诗集，可以卖给我！只要让我随便翻翻，以本小姐的天赋，绝对立刻就能文思泉涌！"
                                }
                            ]
                        },
                        {
                            "id": "708280104",
                            "text": "帮不了，我还有事，告辞。",
                            "response": [
                                {
                                    "id": "708280105",
                                    "speaker": "埃尔西",
                                    "text": "不是让你帮忙啦！话又说回来，要是人人遇到问题，都靠在路边随便拉一个陌生人解决，那大家恐怕都不敢上路了吧？"
                                },
                                {
                                    "id": "708280106",
                                    "speaker": "埃尔西",
                                    "text": "咳咳，只是想问你有没有关于爱情的诗集而已。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7082802",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "708280201",
                    "speaker": "Player",
                    "text": "（交出《阿伊·哈努姆之歌》。）"
                },
                {
                    "id": "708280202",
                    "speaker": "埃尔西",
                    "text": "哇哦，好漂亮的书！让我看看里面写了什么…"
                },
                {
                    "id": "708280203",
                    "speaker": "埃尔西",
                    "text": "「…没有无蛇的宝座，没有无刺的蔷薇。把苦痛一饮而尽吧，菲莉吉丝啊，再用你甜美的双眸，与我彼此许下…许下…」"
                },
                {
                    "id": "708280204",
                    "speaker": "埃尔西",
                    "text": "…呃，后面这字儿念什么来着？"
                },
                {
                    "id": "708280205",
                    "speaker": "埃尔西",
                    "text": "不行，太深奥啦！舌头都要打结了！总之我先买回去慢慢读…谢谢你啦，金发的冒险家！"
                }
            ]
        },
        {
            "id": "7082803",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "708280301",
                    "speaker": "Player",
                    "text": "（交出《爱、圣启与美德的典律》。）"
                },
                {
                    "id": "708280302",
                    "speaker": "埃尔西",
                    "text": "啊，我听说过这个！是西风教会的诗集，对吧？"
                },
                {
                    "id": "708280303",
                    "speaker": "埃尔西",
                    "text": "我看看…「她的灵魂如焚烧的原野，向风发出炙热的歌唱；在星辰、月光与日轮间，灼伤了我的光芒…」"
                },
                {
                    "id": "708280304",
                    "speaker": "埃尔西",
                    "text": "写的什么玩意儿啊，怪吓人的。而且西风教会的人一看就不会写诗嘛，星星、月亮和太阳怎么可能一块儿出现呢？"
                },
                {
                    "id": "708280305",
                    "speaker": "埃尔西",
                    "text": "好，有自信了！本小姐再怎么说也能比这诗集的作者写得好！这书我买下了，谢谢你啦，金发的冒险家！"
                }
            ]
        },
        {
            "id": "7082804",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "708280401",
                    "speaker": "Player",
                    "text": "（交出《罗纳布韦之梦》。）"
                },
                {
                    "id": "708280402",
                    "speaker": "埃尔西",
                    "text": "哦哦，是枫丹的诗集！让我看看…"
                },
                {
                    "id": "708280403",
                    "speaker": "埃尔西",
                    "text": "…回到过去…纯水骑士的王庭…和侍女一见钟情…"
                },
                {
                    "id": "708280404",
                    "speaker": "埃尔西",
                    "text": "笑死我了，怎么会有这么傻的人啊！明明有机会回到过去，结果满脑子居然只有怎么找和自己祖宗一个年龄的人谈恋爱！"
                },
                {
                    "id": "708280405",
                    "speaker": "埃尔西",
                    "text": "这不是爱情诗嘛！"
                },
                {
                    "id": "708280406",
                    "speaker": "埃尔西",
                    "text": "唉，我懂了，爱情就是让人发昏。总之我先买回去慢慢读，谢谢你啦，金发的冒险家！"
                }
            ]
        },
        {
            "id": "7082806",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "708280601",
                    "speaker": "埃尔西",
                    "text": "哦哦，是金发的冒险家！怎么样，有可以卖给本小姐的爱情诗歌参考资料吗？"
                }
            ]
        },
        {
            "id": "7082808",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "708280801",
                    "speaker": "Player",
                    "text": "（交出《侍从骑士之歌》。）"
                },
                {
                    "id": "708280802",
                    "speaker": "埃尔西",
                    "text": "啊，是莱艮芬德家的故事，对吧？"
                },
                {
                    "id": "708280803",
                    "speaker": "埃尔西",
                    "text": "不过这本也不能算情诗啦。那位枫丹乐师从头到尾都没有爱上过侍从骑士，就只是死掉了而已。"
                },
                {
                    "id": "708280804",
                    "speaker": "埃尔西",
                    "text": "只有活人才能谈恋爱。所以…还有别的诗集吗？"
                }
            ]
        },
        {
            "id": "7082809",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "708280901",
                    "speaker": "Player",
                    "text": "（交出《日月前事》。）"
                },
                {
                    "id": "708280902",
                    "speaker": "埃尔西",
                    "text": "欸，石板？我看看…"
                },
                {
                    "id": "708280903",
                    "speaker": "埃尔西",
                    "text": "「鸽子…鸽子…」"
                },
                {
                    "id": "708280904",
                    "speaker": "埃尔西",
                    "text": "…呃啊，后面这个字念什么来着？不行，就算买下来我也搬不动啦！还有别的诗集吗？"
                }
            ]
        },
        {
            "id": "7082810",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7082807",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "708280701",
                    "speaker": "Player",
                    "text": "（交出《林间风》。）"
                },
                {
                    "id": "708280702",
                    "speaker": "埃尔西",
                    "text": "哈哈，这不是《林间风》嘛！本小姐可是超厉害的吟游诗人，这种作品早就翻烂啦！还有别的诗集吗？"
                }
            ]
        },
        {
            "id": "7082805",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "708280501",
                    "speaker": "埃尔西",
                    "text": "哈哈，谢谢你啦，金发的冒险家！你真是我的大大大英雄！"
                },
                {
                    "id": "708280502",
                    "speaker": "埃尔西",
                    "text": "我现在感觉脑海中的灵感就像风龙废墟的狂风、沉玉谷的瘴气、清籁岛的雷霆，正在呼啸着往外涌——"
                },
                {
                    "id": "708280503",
                    "speaker": "Player",
                    "text": "听起来好危险！"
                },
                {
                    "id": "708280504",
                    "speaker": "埃尔西",
                    "text": "哼哼，你就等着吧！我这就把它们写下来！"
                },
                {
                    "id": "708280505",
                    "speaker": "埃尔西",
                    "text": "莱纳斯那种酸溜溜的诗歌根本不堪一击，等我的旷世巨作完成，全提瓦特的酒馆都会为本小姐沸腾的！"
                }
            ]
        }
    ]
}