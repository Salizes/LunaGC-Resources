    "talks": [
        {
            "id": "7469001",
            "objective": "寻找争吵声的来源",
            "dialogues": [
                {
                    "id": "746900101",
                    "speaker": "小露米埃尔",
                    "text": "来了来了，主角入场，准备开机！"
                },
                {
                    "id": "746900102",
                    "speaker": "梅里爱",
                    "text": "——呵！不对不对！商业合作的模式应该像是映影的脚本一样，有起承转合才是！"
                },
                {
                    "id": "746900103",
                    "speaker": "梅里爱",
                    "text": "按照惯例，邀请大明星入伙的第一步通常是递上名片，辅以华丽的自我介绍以抬高身价，随后再提出一个美好的合作愿景。"
                },
                {
                    "id": "746900104",
                    "speaker": "梅里爱",
                    "text": "待对方显露出一定兴趣后，才可以开始深入探讨合作形式，就像你提出的速览映影想法一样，实在是太过激进了！"
                },
                {
                    "id": "746900105",
                    "speaker": "小露米埃尔",
                    "text": "梅里爱小姐，坦率而言，如果你的第一部「实验映影」没有亏损这么严重的话，你的理论或许会更有说服力一些。"
                },
                {
                    "id": "746900106",
                    "speaker": "小露米埃尔",
                    "text": "#况且，在映影欢乐城的时候，你肯定尝试过和{NICKNAME}搭话吧？不过我认为，对方估计没有很深的印象吧？"
                },
                {
                    "id": "746900107",
                    "speaker": "梅里爱",
                    "text": "…你的想法不过是小孩子的一厢情愿罢了！大人的世界可复杂得多了！没有这么简单。"
                },
                {
                    "id": "746900108",
                    "speaker": "小露米埃尔",
                    "text": "唉，试图用年龄来衡量正确性，实在是非常肤浅的行为，梅里爱女士。你现今的言行，正好为我的正确性提供了更多佐证。"
                },
                {
                    "id": "746900109",
                    "speaker": "梅里爱",
                    "text": "你说什么？啊——你这个喜欢装大人的臭小鬼！"
                },
                {
                    "id": "746900110",
                    "speaker": "派蒙",
                    "text": "呜哇！等一下等一下，不要吵架啊！有什么事情，不能心平气和地坐下来谈谈吗？",
                    "choices": [
                        {
                            "id": "746900111",
                            "text": "别动气别动气…",
                            "response": [
                                {
                                    "id": "746900113",
                                    "speaker": "梅里爱",
                                    "text": "#这…{NICKNAME}和派蒙真的过来搭话了？这么简单的伎俩，居然有用？"
                                },
                                {
                                    "id": "746900114",
                                    "speaker": "小露米埃尔",
                                    "text": "梅里爱小姐你看，正如我所说的，相比冗长的铺垫，人们更在意抓人眼球的部分。"
                                },
                                {
                                    "id": "746900115",
                                    "speaker": "小露米埃尔",
                                    "text": "#要知道，{M#他们}{F#她们}可是需要排队三天三夜都无法接近的大名人，现在却因为目睹了我们的争吵主动来搭话了。"
                                },
                                {
                                    "id": "746900116",
                                    "speaker": "小露米埃尔",
                                    "text": "接下来，就到了直接说明我们的合作意愿的部分了…"
                                },
                                {
                                    "id": "746900117",
                                    "speaker": "小露米埃尔",
                                    "text": "咳，来得正好，两位。你觉得我们的「实验速览映影」效果如何？是否很有吸人眼球的能力？"
                                },
                                {
                                    "id": "746900118",
                                    "speaker": "派蒙",
                                    "text": "欸？「映影」？你们不是在…？"
                                },
                                {
                                    "id": "746900119",
                                    "speaker": "小露米埃尔",
                                    "text": "吵架？呵呵，没有没有，端庄的大人一定不会因为小鬼的几句话而生气吧。"
                                },
                                {
                                    "id": "746900120",
                                    "speaker": "梅里爱",
                                    "text": "哼，确实。尤其面对的是那种喜欢装老成的小鬼的时候。"
                                },
                                {
                                    "id": "746900121",
                                    "speaker": "Player",
                                    "text": "你们这明明就是真吵架吧…"
                                },
                                {
                                    "id": "746900122",
                                    "speaker": "小露米埃尔",
                                    "text": "言归正传，两位你们不觉得，一见面，就撞上了非常有情绪张力的画面，会令观者产生强烈观影欲望吗？"
                                },
                                {
                                    "id": "746900123",
                                    "speaker": "派蒙",
                                    "text": "一般人会上来劝架才对吧！"
                                },
                                {
                                    "id": "746900124",
                                    "speaker": "小露米埃尔",
                                    "text": "但倘若你们刚才就知道，这是映影呢？"
                                },
                                {
                                    "id": "746900125",
                                    "speaker": "派蒙",
                                    "text": "你这么一说也对哦…如果一上来就是那种我感兴趣的场面的话，我一定会想继续看下去的吧…"
                                },
                                {
                                    "id": "746900126",
                                    "speaker": "小露米埃尔",
                                    "text": "这就是「速览映影」的优势所在——观者只需花最短的时间就能看到最具张力的片段！"
                                },
                                {
                                    "id": "746900127",
                                    "speaker": "梅里爱",
                                    "text": "不仅如此，映影通常需要较长的时间观看，而这种速览映影只需碎片化的时间，甚至可以在冒险途中的休息间隙观看！"
                                },
                                {
                                    "id": "746900128",
                                    "speaker": "梅里爱",
                                    "text": "制作者也不一定要是专业的导演和摄影师。任何人、任何时间、任何地点，都可以创作或欣赏。"
                                },
                                {
                                    "id": "746900129",
                                    "speaker": "梅里爱",
                                    "text": "而内容也不一定局限于故事，甚至可能只是一段好看的舞蹈，或者一片令人赏心悦目的风景。这样的形式是不是很有吸引力？"
                                },
                                {
                                    "id": "746900130",
                                    "speaker": "派蒙",
                                    "text": "唔，没错。你这么一说我都想自己拍摄一下试试了…"
                                },
                                {
                                    "id": "746900131",
                                    "speaker": "梅里爱",
                                    "text": "当然，想要达成这种吸引力还需要强大的「明星效应」，只有闻名整个提瓦特的名人，才能引来人们对「速览映影」的兴趣！"
                                },
                                {
                                    "id": "746900132",
                                    "speaker": "梅里爱",
                                    "text": "没错，我说的就是你们二位！",
                                    "choices": [
                                        {
                                            "id": "746900133",
                                            "text": "明星的出场费可是很高的哦…",
                                            "response": [
                                                {
                                                    "id": "746900135",
                                                    "speaker": "梅里爱",
                                                    "text": "这一点你们放心好了，我和小露米埃尔先生在映影欢乐城历练之后，筹集了足够的资金，用来充当你们的出场费绝对没有问题！"
                                                },
                                                {
                                                    "id": "746900136",
                                                    "speaker": "梅里爱",
                                                    "text": "#更何况，等到「速览映影」风靡提瓦特，你们说不定还能获得速览映影之{M#父}{F#母}的殊荣！"
                                                },
                                                {
                                                    "id": "746900137",
                                                    "speaker": "小露米埃尔",
                                                    "text": "不仅如此，「速览映影」这一形式还放大了镜头语言的作用。像你们这样熟练的拍摄者，甚至可以做到不使用对白进行叙事。"
                                                },
                                                {
                                                    "id": "746900138",
                                                    "speaker": "派蒙",
                                                    "text": "#感觉好像很有趣！{NICKNAME}，要不我们参与一下试试吧！",
                                                    "choices": [
                                                        {
                                                            "id": "746900139",
                                                            "text": "有趣！那就交给我们吧！",
                                                            "response": [
                                                                {
                                                                    "id": "746900141",
                                                                    "speaker": "小露米埃尔",
                                                                    "text": "太好了！那等你们两位准备好，我们就开拍。具体的机位我已经选好了。"
                                                                },
                                                                {
                                                                    "id": "746900142",
                                                                    "speaker": "梅里爱",
                                                                    "text": "映影机、道具和后期工作我这边也准备好了！你们只需要随心所欲地操作就好！"
                                                                },
                                                                {
                                                                    "id": "746900143",
                                                                    "speaker": "梅里爱",
                                                                    "text": "那事不宜迟，我们快点开始吧！"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "746900140",
                                                            "text": "有钱？那就试试看吧！"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "746900134",
                                            "text": "如果这是委托的话。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "746900112",
                            "text": "一切都好商量…"
                        }
                    ]
                }
            ]
        }
    ]
}