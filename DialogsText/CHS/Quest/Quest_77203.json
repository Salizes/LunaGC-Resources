    "talks": [
        {
            "id": "7720301",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "772030101",
                    "speaker": "马尔托斯",
                    "text": "呼呼…等到了雪精们的公馆，不管付出什么样的代价，我也一定要学会雕塑的技艺…"
                },
                {
                    "id": "772030102",
                    "speaker": "马尔托斯",
                    "text": "啊，不过，还是休息一会儿再动身吧。恩人说得对，不能再贸然前进…"
                }
            ]
        },
        {
            "id": "7720302",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "772030201",
                    "speaker": "马尔托斯",
                    "text": "虽然有点可惜，不过…能看到这些作品也很不错…",
                    "choices": [
                        {
                            "id": "772030202",
                            "text": "你到公馆来了。",
                            "response": [
                                {
                                    "id": "772030203",
                                    "speaker": "马尔托斯",
                                    "text": "啊，是的，路上遇到了许多人的帮忙，最终还是抵达了这里。"
                                },
                                {
                                    "id": "772030204",
                                    "speaker": "马尔托斯",
                                    "text": "可惜…听说那位雪孃的王公不知为何去世，没法当面向她请教…"
                                },
                                {
                                    "id": "772030205",
                                    "speaker": "马尔托斯",
                                    "text": "不过，只是看她留下的作品，也让人觉得受益匪浅…"
                                }
                            ]
                        },
                        {
                            "id": "772030206",
                            "text": "在这里还好吗？",
                            "response": [
                                {
                                    "id": "772030207",
                                    "speaker": "马尔托斯",
                                    "text": "过得很好，在这里…虽然雪精们不太用火，所以整个公馆有点冷冰冰的，但是总比在风雪里好多了…"
                                },
                                {
                                    "id": "772030208",
                                    "speaker": "马尔托斯",
                                    "text": "在这里，也有许多雪精对于艺术和雕塑有着十足的造诣，能够跟他们交流也是十分大的幸事了…"
                                }
                            ]
                        },
                        {
                            "id": "772030209",
                            "text": "希望一切顺利。",
                            "response": [
                                {
                                    "id": "772030210",
                                    "speaker": "马尔托斯",
                                    "text": "你也一样，希望您的一切也顺利。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
