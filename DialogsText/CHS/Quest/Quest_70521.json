        }
    },
    "talks": [
        {
            "id": "7052101",
            "objective": "",
            "dialogues": [
                {
                    "id": "705210101",
                    "speaker": "派蒙",
                    "text": "优菈和安柏！你们也来玩了！"
                },
                {
                    "id": "705210102",
                    "speaker": "优菈",
                    "text": "#找到你们了，{NICKNAME}和派蒙。"
                },
                {
                    "id": "705210103",
                    "speaker": "派蒙",
                    "text": "咦？你俩是专程来看望我们的吗？"
                },
                {
                    "id": "705210104",
                    "speaker": "安柏",
                    "text": "当然了，你们的店铺名气可大了，人们都在议论呢——"
                },
                {
                    "id": "705210105",
                    "speaker": "安柏",
                    "text": "「荣誉骑士和白色小帮手的『西风哗哗义卖联盟』在出售各种宝物，还有神奇的赠品，不容错过！」"
                },
                {
                    "id": "705210106",
                    "speaker": "派蒙",
                    "text": "结果我又变成「白色小帮手」了…不过听见大家这么评价我们的店铺，还是很开心的！",
                    "choices": [
                        {
                            "id": "705210107",
                            "text": "还是多亏了顾客们。",
                            "response": [
                                {
                                    "id": "705210109",
                                    "speaker": "派蒙",
                                    "text": "说起来，之前一直没有看见安柏和优菈呢，你们俩出远门了吗？"
                                },
                                {
                                    "id": "705210110",
                                    "speaker": "安柏",
                                    "text": "哈哈，我们还在工作嘛。"
                                },
                                {
                                    "id": "705210111",
                                    "speaker": "派蒙",
                                    "text": "欸？还在工作？",
                                    "choices": [
                                        {
                                            "id": "705210112",
                                            "text": "节日无休？",
                                            "response": [
                                                {
                                                    "id": "705210114",
                                                    "speaker": "优菈",
                                                    "text": "确切地说，我和安柏属于骑士团中的「半休假人员」。"
                                                },
                                                {
                                                    "id": "705210115",
                                                    "speaker": "优菈",
                                                    "text": "佳酿节期间，荆夫港和蒙德城之间的商队来往频繁，正是需要加强戒备的时候。"
                                                },
                                                {
                                                    "id": "705210116",
                                                    "speaker": "派蒙",
                                                    "text": "因为魔物和歹徒会出来捣乱吗？"
                                                },
                                                {
                                                    "id": "705210117",
                                                    "speaker": "优菈",
                                                    "text": "没错。游击小队的任务就是在两地之间巡逻…"
                                                },
                                                {
                                                    "id": "705210118",
                                                    "speaker": "优菈",
                                                    "text": "跟随商队，保护大宗货物的同时，还要主动出击，调查可疑地点，提前排除威胁。"
                                                },
                                                {
                                                    "id": "705210119",
                                                    "speaker": "派蒙",
                                                    "text": "哇，听上去好辛苦。你们要这样连轴转…一直忙到佳酿节结束吗？"
                                                },
                                                {
                                                    "id": "705210120",
                                                    "speaker": "优菈",
                                                    "text": "那倒不至于，我们会轮班。"
                                                },
                                                {
                                                    "id": "705210121",
                                                    "speaker": "优菈",
                                                    "text": "一组人手在岗巡逻，一组人手放假休息，还有一组人手机动待命，作为预备队。"
                                                },
                                                {
                                                    "id": "705210122",
                                                    "speaker": "优菈",
                                                    "text": "每隔一段时间，各个小组就进行轮换。"
                                                },
                                                {
                                                    "id": "705210123",
                                                    "speaker": "安柏",
                                                    "text": "毕竟优菈是经验丰富的队长嘛。多亏了优菈的安排，游击小队才能一直高强度执勤。"
                                                },
                                                {
                                                    "id": "705210124",
                                                    "speaker": "优菈",
                                                    "text": "这不是什么要夸一句的事情…",
                                                    "choices": [
                                                        {
                                                            "id": "705210125",
                                                            "text": "好热情啊，侦察骑士。",
                                                            "response": [
                                                                {
                                                                    "id": "705210126",
                                                                    "speaker": "安柏",
                                                                    "text": "嘿嘿，下次有机会，再和你说说优菈刚当上队长时候的事吧，可精彩了。"
                                                                },
                                                                {
                                                                    "id": "705210129",
                                                                    "speaker": "安柏",
                                                                    "text": "咳咳…我们今天来还是有正事的，让优菈讲——"
                                                                },
                                                                {
                                                                    "id": "705210130",
                                                                    "speaker": "优菈",
                                                                    "text": "嗯，麻烦你们准备40份「骑士团特色北地烟熏鸡」，40份「西风加护堆高高」…"
                                                                },
                                                                {
                                                                    "id": "705210131",
                                                                    "speaker": "派蒙",
                                                                    "text": "好惊人的数量！一次买这么多吃的？"
                                                                },
                                                                {
                                                                    "id": "705210132",
                                                                    "speaker": "派蒙",
                                                                    "text": "难道…骑士团准备办宴会了？怎么没人通知我们呀。"
                                                                },
                                                                {
                                                                    "id": "705210133",
                                                                    "speaker": "安柏",
                                                                    "text": "哈哈，没有那么夸张哦，优菈队长是准备犒赏她的队员们呢。"
                                                                },
                                                                {
                                                                    "id": "705210134",
                                                                    "speaker": "优菈",
                                                                    "text": "嗯…游击小队成员们的日常消耗量很大，一顿…确实能吃掉四五人份的食物。"
                                                                },
                                                                {
                                                                    "id": "705210135",
                                                                    "speaker": "优菈",
                                                                    "text": "加上最近有位老队员归队了，就想着好好庆祝一番。"
                                                                },
                                                                {
                                                                    "id": "705210136",
                                                                    "speaker": "优菈",
                                                                    "text": "与其买别的，倒不如用这笔钱来支援你们，还能充实慈善资金…"
                                                                },
                                                                {
                                                                    "id": "705210137",
                                                                    "speaker": "派蒙",
                                                                    "text": "喔噢噢！优菈的决定真是太明智了！一举两得！"
                                                                },
                                                                {
                                                                    "id": "705210138",
                                                                    "speaker": "Player",
                                                                    "text": "谢谢惠顾！"
                                                                },
                                                                {
                                                                    "id": "705210139",
                                                                    "speaker": "派蒙",
                                                                    "text": "对了…优菈刚刚提到的「老队员」，该不会就是我们之前见过的那位吧…"
                                                                },
                                                                {
                                                                    "id": "705210140",
                                                                    "speaker": "优菈",
                                                                    "text": "前进测绘员米卡。在跟随大团长出征前，他一直是我们小队的核心队员。"
                                                                },
                                                                {
                                                                    "id": "705210141",
                                                                    "speaker": "派蒙",
                                                                    "text": "对，就是他！没想到那个看起来很腼腆的小骑士这么厉害啊！",
                                                                    "choices": [
                                                                        {
                                                                            "id": "705210142",
                                                                            "text": "但他好像害怕我们。",
                                                                            "response": [
                                                                                {
                                                                                    "id": "705210144",
                                                                                    "speaker": "安柏",
                                                                                    "text": "米卡并不是害怕你们啦，虽然有那么一点点绕弯子，但这是他对你们的「尊重」。"
                                                                                },
                                                                                {
                                                                                    "id": "705210145",
                                                                                    "speaker": "安柏",
                                                                                    "text": "他认为强大的人都有独特的个性，要了解这些人，理解对方的想法后，再和他们深入交流。"
                                                                                },
                                                                                {
                                                                                    "id": "705210146",
                                                                                    "speaker": "安柏",
                                                                                    "text": "这样，就能做到轻松愉快的沟通。"
                                                                                },
                                                                                {
                                                                                    "id": "705210147",
                                                                                    "speaker": "优菈",
                                                                                    "text": "最初他对我和安柏也这样。和我们逐渐熟悉以后，他才表现得自然起来。"
                                                                                },
                                                                                {
                                                                                    "id": "705210148",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "原来是这样…米卡的性格还真是独特呢…",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "705210149",
                                                                                            "text": "我记下了。",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "705210151",
                                                                                                    "speaker": "优菈",
                                                                                                    "text": "嗯，等之后有时间，多接触几次就好。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "705210152",
                                                                                                    "speaker": "优菈",
                                                                                                    "text": "你是骑士团的重要人物，我作为他的长官，有义务防止你们误解彼此。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "705210153",
                                                                                                    "speaker": "派蒙",
                                                                                                    "text": "嘿嘿，优菈不用这样解释啦。你其实是在关照他，我们都懂的啦。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "705210154",
                                                                                                    "speaker": "安柏",
                                                                                                    "text": "啊，优菈，刚刚你把我的份也算上了吧？"
                                                                                                },
                                                                                                {
                                                                                                    "id": "705210155",
                                                                                                    "speaker": "安柏",
                                                                                                    "text": "摩拉我得单独给才行，毕竟我不是游击小队的成员呢。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "705210156",
                                                                                                    "speaker": "优菈",
                                                                                                    "text": "一样是我请客，就别客气了。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "705210157",
                                                                                                    "speaker": "Black Screen",
                                                                                                    "text": "向优菈和安柏交付了指定的菜肴，两人道谢后离去了。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "705210158",
                                                                                                    "speaker": "派蒙",
                                                                                                    "text": "嘿嘿，多亏了优菈和安柏，一下子就挣到了之前一整天的摩拉！"
                                                                                                },
                                                                                                {
                                                                                                    "id": "705210159",
                                                                                                    "speaker": "伯恩哈德",
                                                                                                    "text": "荣誉骑士，派蒙！特大喜讯——"
                                                                                                },
                                                                                                {
                                                                                                    "id": "705210160",
                                                                                                    "speaker": "伯恩哈德",
                                                                                                    "text": "多亏你们两位，这次活动筹集的资金远超预期！可以说是大成功！"
                                                                                                },
                                                                                                {
                                                                                                    "id": "705210161",
                                                                                                    "speaker": "派蒙",
                                                                                                    "text": "哼哼，我就说吧，我们肯定能搞定所有麻烦！",
                                                                                                    "choices": [
                                                                                                        {
                                                                                                            "id": "705210162",
                                                                                                            "text": "大家都辛苦了。",
                                                                                                            "response": [
                                                                                                                {
                                                                                                                    "id": "705210164",
                                                                                                                    "speaker": "伯恩哈德",
                                                                                                                    "text": "还得是你们两位的功劳，你们指导有方，义卖才能如此顺利。"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "705210165",
                                                                                                                    "speaker": "伯恩哈德",
                                                                                                                    "text": "我已经将所有收益交给了慈善资金的负责人，这次义卖活动到这里就圆满结束了。"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "705210166",
                                                                                                                    "speaker": "伯恩哈德",
                                                                                                                    "text": "为表谢意，我们想给两位一笔辛苦费，请两位务必收下！"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "705210167",
                                                                                                                    "speaker": "伯恩哈德",
                                                                                                                    "text": "我感觉自己再也不怕开店了，希望以后还能与你们合作！"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "705210168",
                                                                                                                    "speaker": "派蒙",
                                                                                                                    "text": "#嘿嘿，{NICKNAME}，我也觉得很充实！"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "705210169",
                                                                                                                    "speaker": "派蒙",
                                                                                                                    "text": "下次如果还有这种机会，我们再来试试吧！"
                                                                                                                }
                                                                                                            ]
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "705210163",
                                                                                                            "text": "伯恩哈德也受累了。"
                                                                                                        }
                                                                                                    ]
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "705210150",
                                                                                            "text": "我差不多习惯了。"
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "705210143",
                                                                            "text": "没聊几句就逃走了。"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "705210127",
                                                            "text": "开眼界了，优菈队长。",
                                                            "response": [
                                                                {
                                                                    "id": "705210128",
                                                                    "speaker": "优菈",
                                                                    "text": "好啊，你们。一个两个笑那么起劲，是都被节日气氛影响了吗？"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "705210113",
                                            "text": "坚守岗位？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "705210108",
                            "text": "很欣慰。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7052102",
            "objective": "返回店铺，了解义卖的进展",
            "dialogues": []
        },
        {
            "id": "7052199",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "705219901",
                    "speaker": "派蒙",
                    "text": "时间过得好快啊，义卖活动已经持续很久了吧，不知道赚到了多少钱…"
                },
                {
                    "id": "705219902",
                    "speaker": "派蒙",
                    "text": "我们回「西风哗哗义卖联盟」看看吧！"
                }
            ]
        }
    ]
}