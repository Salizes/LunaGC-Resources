    "talks": [
        {
            "id": "7153401",
            "objective": "等待至次日的8时至18时",
            "dialogues": [
                {
                    "id": "715340101",
                    "speaker": "九条裟罗",
                    "text": "唔，还是先参考一下其他「祝柬」吧…"
                },
                {
                    "id": "715340102",
                    "speaker": "九条裟罗",
                    "text": "#{NICKNAME}，许久未见……你为什么一副惊讶的表情？"
                },
                {
                    "id": "715340103",
                    "speaker": "Player",
                    "text": "不，就是没想到…"
                },
                {
                    "id": "715340104",
                    "speaker": "九条裟罗",
                    "text": "没想到我一介武人，也有来海灯节的雅致？"
                },
                {
                    "id": "715340105",
                    "speaker": "Player",
                    "text": "平时都没见你怎么放松过…"
                },
                {
                    "id": "715340106",
                    "speaker": "九条裟罗",
                    "text": "「天领奉行」责任重大，我身为其中一员，平时容不得一丝一毫的放松。"
                },
                {
                    "id": "715340107",
                    "speaker": "九条裟罗",
                    "text": "在旁人看来，我或许的确是一位不懂雅致的武人…与花见坂里的那些舞乐之声格格不入。"
                },
                {
                    "id": "715340108",
                    "speaker": "九条裟罗",
                    "text": "但是，如果我在平日里随意放松心神，让宵小之徒有可乘之机，那…只怕不仅是我，整个花见坂的舞乐声都会沉寂下去吧。"
                },
                {
                    "id": "715340109",
                    "speaker": "九条裟罗",
                    "text": "最多，就像这样见缝插针，勉强抽出些空闲来四处走走。"
                },
                {
                    "id": "715340110",
                    "speaker": "九条裟罗",
                    "text": "抱歉，佳节当前，不该说这些严肃的事。"
                },
                {
                    "id": "715340111",
                    "speaker": "九条裟罗",
                    "text": "我正在试着做一封「祝柬」，但始终不得其法，如果你愿意的话，能给我一些制作的建议么？"
                },
                {
                    "id": "715340112",
                    "speaker": "Player",
                    "text": "好啊，让我想想…"
                }
            ]
        },
        {
            "id": "7153402",
            "objective": "与九条裟罗对话",
            "dialogues": []
        },
        {
            "id": "7153403",
            "objective": "和九条裟罗一同完成祝柬",
            "dialogues": [
                {
                    "id": "715340301",
                    "speaker": "九条裟罗",
                    "text": "原来如此。这样做出来的「祝柬」的确好看。"
                },
                {
                    "id": "715340302",
                    "speaker": "九条裟罗",
                    "text": "谢谢你帮我做了这份「祝柬」。这样我也算是有了份纪念品，不算白来一趟。"
                },
                {
                    "id": "715340303",
                    "speaker": "九条裟罗",
                    "text": "多谢你费心了，下次来稻妻，我请你喝茶。"
                }
            ]
        },
        {
            "id": "7153404",
            "objective": "与九条裟罗对话",
            "dialogues": []
        },
        {
