    "talks": [
        {
            "id": "7509101",
            "objective": "",
            "dialogues": [
                {
                    "id": "750910101",
                    "speaker": "基斯庇",
                    "text": "一颗，两颗，嗯，三颗…"
                },
                {
                    "id": "750910102",
                    "speaker": "基斯庇",
                    "text": "哼，哼，一颗…两颗…"
                },
                {
                    "id": "750910103",
                    "speaker": "派蒙",
                    "text": "呜哇，这里有个好奇怪的部族人。"
                },
                {
                    "id": "750910104",
                    "speaker": "基斯庇",
                    "text": "奇怪的应该是你们这些异邦人才对，呵，呵呵，这可不是异邦人应该来的地方啊…"
                },
                {
                    "id": "750910105",
                    "speaker": "派蒙",
                    "text": "这是什么禁地…或者圣地之类的吗？"
                },
                {
                    "id": "750910106",
                    "speaker": "基斯庇",
                    "text": "并不是，这只是我偶然发现的，宝藏之地。哼，来吧，两位，靠近点，你有没有听见，这块特殊的岩石…「宝藏岩」…"
                },
                {
                    "id": "750910107",
                    "speaker": "基斯庇",
                    "text": "其中传来的，犹如低鸣般起伏，就仿佛，啊，就仿佛有人在呼吸一般的声音。",
                    "choices": [
                        {
                            "id": "750910108",
                            "text": "石头也很辛苦嘛。",
                            "response": [
                                {
                                    "id": "750910109",
                                    "speaker": "派蒙",
                                    "text": "只是呼吸而已，算什么辛苦啦，不对…"
                                },
                                {
                                    "id": "750910112",
                                    "speaker": "派蒙",
                                    "text": "石头，石头也会呼吸吗？"
                                },
                                {
                                    "id": "750910113",
                                    "speaker": "基斯庇",
                                    "text": "不仅有呼吸，如果将耳朵贴上去，还能听到它在律动，听到这粗糙的表皮之下，岩石摩擦的声音…"
                                },
                                {
                                    "id": "750910114",
                                    "speaker": "基斯庇",
                                    "text": "嘿，嘿，真是美妙的声响啊。"
                                },
                                {
                                    "id": "750910115",
                                    "speaker": "基斯庇",
                                    "text": "而且，而且哦，只要将一些小的石头喂给它，甚至能够吐出更好，更漂亮的石头来…"
                                },
                                {
                                    "id": "750910116",
                                    "speaker": "基斯庇",
                                    "text": "啊啊，很不可思议吧，你看，这些宝石，一颗，两颗…"
                                },
                                {
                                    "id": "750910117",
                                    "speaker": "派蒙",
                                    "text": "原来刚才我们过来的时候，你在数这些宝石啊。"
                                },
                                {
                                    "id": "750910118",
                                    "speaker": "基斯庇",
                                    "text": "对，而且，我能感受到，吃下不同石头的这块「宝藏岩」，变得更加强壮了…"
                                },
                                {
                                    "id": "750910119",
                                    "speaker": "基斯庇",
                                    "text": "这一定是，了不起的奇迹，啊啊，「宝藏岩」…",
                                    "choices": [
                                        {
                                            "id": "750910120",
                                            "text": "听上去很可疑…",
                                            "response": [
                                                {
                                                    "id": "750910122",
                                                    "speaker": "基斯庇",
                                                    "text": "呵，呵呵，本来就不指望你们这些异邦人会相信。如果不尝试一下的话，没人会相信。"
                                                },
                                                {
                                                    "id": "750910123",
                                                    "speaker": "基斯庇",
                                                    "text": "我也是偶然把收集到的矿石放在「宝藏岩」边上，才发现的…"
                                                },
                                                {
                                                    "id": "750910124",
                                                    "speaker": "基斯庇",
                                                    "text": "对了，就让你们试一试吧！试一试你们就会相信了。"
                                                },
                                                {
                                                    "id": "750910125",
                                                    "speaker": "基斯庇",
                                                    "text": "正好，附近的石头，它已经全部吃过一遍了，得让它吃点新的石头…可是我没法去找给它吃…"
                                                },
                                                {
                                                    "id": "750910126",
                                                    "speaker": "派蒙",
                                                    "text": "欸，为什么？"
                                                },
                                                {
                                                    "id": "750910127",
                                                    "speaker": "基斯庇",
                                                    "text": "当然！我当然要一直看着「宝藏岩」啊！要是、要是在我离开的时候，它钻入地底，那该怎么办？"
                                                },
                                                {
                                                    "id": "750910128",
                                                    "speaker": "基斯庇",
                                                    "text": "我已经在这里看守很久了…身上所有的石头都已经给它吃过一遍了…"
                                                },
                                                {
                                                    "id": "750910129",
                                                    "speaker": "基斯庇",
                                                    "text": "你们，你们给我点新的石头吧，我来把石头喂给它，证明给你们看！"
                                                },
                                                {
                                                    "id": "750910130",
                                                    "speaker": "派蒙",
                                                    "text": "唔，听上去好像一个骗子哦…"
                                                },
                                                {
                                                    "id": "750910131",
                                                    "speaker": "派蒙",
                                                    "text": "#怎么办，{NICKNAME}，要试试看吗？"
                                                },
                                                {
                                                    "id": "750910132",
                                                    "speaker": "Player",
                                                    "text": "反正只是石头的话…"
                                                },
                                                {
                                                    "id": "750910133",
                                                    "speaker": "基斯庇",
                                                    "text": "嘿嘿，那就，挑些石头交给我吧…「宝藏岩」一定会吐出更好的…"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "750910121",
                                            "text": "真的吗，很像在骗人欸…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "750910110",
                            "text": "我也会呼吸。",
                            "response": [
                                {
                                    "id": "750910111",
                                    "speaker": "派蒙",
                                    "text": "对啊，会呼吸有什么了不起…唔，没人在说这个！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7509102",
            "objective": "",
            "dialogues": [
                {
                    "id": "750910201",
                    "speaker": "基斯庇",
                    "text": "嗯…要耐心一些，等到，等到安静的时候，我会将这些石头喂给「宝藏岩」…"
                },
                {
                    "id": "750910202",
                    "speaker": "基斯庇",
                    "text": "只要再过段时间，嘿，就会长出更好的石头的，嘿嘿，一颗…一颗，两颗…"
                }
            ]
        },
        {
            "id": "7509103",
            "objective": "",
            "dialogues": [
                {
                    "id": "750910301",
                    "speaker": "派蒙",
                    "text": "呜哇，没想到上面真的长出来了…"
                },
                {
                    "id": "750910302",
                    "speaker": "派蒙",
                    "text": "「宝藏岩」，好厉害…不对，不会是基斯庇你放在「宝藏岩」上的吧？"
                },
                {
                    "id": "750910303",
                    "speaker": "基斯庇",
                    "text": "…呵，呵呵，我怎么会做如此愚蠢之事。"
                },
                {
                    "id": "750910304",
                    "speaker": "基斯庇",
                    "text": "多亏了你们给的石头，「宝藏岩」也变得更具活力，啊，你们听不见吗…"
                },
                {
                    "id": "750910305",
                    "speaker": "基斯庇",
                    "text": "那仿佛地中流焰鼓动的声响，就像是…啊，就像是脉搏一般…"
                },
                {
                    "id": "750910306",
                    "speaker": "基斯庇",
                    "text": "果然，让它吃点别的石头…是对的…"
                },
                {
                    "id": "750910307",
                    "speaker": "派蒙",
                    "text": "唔，什么都听不到啦…"
                },
                {
                    "id": "750910308",
                    "speaker": "派蒙",
                    "text": "#{NICKNAME}你能听到吗？",
                    "choices": [
                        {
                            "id": "750910309",
                            "text": "感觉只是正常岩石…",
                            "response": [
                                {
                                    "id": "750910310",
                                    "speaker": "派蒙",
                                    "text": "是哦…"
                                },
                                {
                                    "id": "750910313",
                                    "speaker": "基斯庇",
                                    "text": "哼哼，异邦的…啊，两位了不起的异邦的客人…"
                                },
                                {
                                    "id": "750910314",
                                    "speaker": "基斯庇",
                                    "text": "如果可以的话，再给我一些石头吧，更好的，更漂亮的石头…相信，「宝藏岩」的力量不会让你们失望的…"
                                },
                                {
                                    "id": "750910315",
                                    "speaker": "基斯庇",
                                    "text": "我能感受到，我能感受到，这样一定对它也是有好处的…"
                                },
                                {
                                    "id": "750910316",
                                    "speaker": "派蒙",
                                    "text": "总有种逐渐深入陷阱了的感觉…"
                                },
                                {
                                    "id": "750910317",
                                    "speaker": "派蒙",
                                    "text": "#{NICKNAME}，你觉得呢…"
                                },
                                {
                                    "id": "750910318",
                                    "speaker": "Player",
                                    "text": "能拿到更好的石头的话…"
                                },
                                {
                                    "id": "750910319",
                                    "speaker": "派蒙",
                                    "text": "确实有继续试试的价值呢…"
                                },
                                {
                                    "id": "750910320",
                                    "speaker": "基斯庇",
                                    "text": "嘿嘿，那就，挑些比以前更好的石头交给我吧…啊，更好的石头，这样，「宝藏岩」的力量，也一定会有所增长…"
                                }
                            ]
                        },
                        {
                            "id": "750910311",
                            "text": "「宝藏岩」在大叫！「呜哇哇」！",
                            "response": [
                                {
                                    "id": "750910312",
                                    "speaker": "派蒙",
                                    "text": "才不会呢！你又在吓我！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7509104",
            "objective": "",
            "dialogues": [
                {
                    "id": "750910401",
                    "speaker": "基斯庇",
                    "text": "嗯…要耐心一些，等到，等到安静的时候，我会将这些石头喂给「宝藏岩」…嘿嘿，谢谢你们带来的石头…"
                },
                {
                    "id": "750910402",
                    "speaker": "基斯庇",
                    "text": "一定要长出更好的石头啊，「宝藏岩」，嘿嘿，一颗…一颗，两颗…"
                }
            ]
        },
        {
            "id": "7509105",
            "objective": "",
            "dialogues": [
                {
                    "id": "750910501",
                    "speaker": "派蒙",
                    "text": "嗯，确实长出了更好的石头，虽然已经是第二次看到了，但感觉还是很神奇…"
                },
                {
                    "id": "750910502",
                    "speaker": "基斯庇",
                    "text": "呵，呵呵，多疑的外邦人。"
                },
                {
                    "id": "750910503",
                    "speaker": "基斯庇",
                    "text": "这下你们终于能够明白…「宝藏岩」的伟大之处了吧。"
                },
                {
                    "id": "750910504",
                    "speaker": "基斯庇",
                    "text": "啊啊，「宝藏岩」，得益于你们拿来的石头，「宝藏岩」的力量也变得更加深厚了…"
                },
                {
                    "id": "750910505",
                    "speaker": "基斯庇",
                    "text": "真不知道它最后会变成什么样…"
                },
                {
                    "id": "750910506",
                    "speaker": "派蒙",
                    "text": "嗯，这么一说，就连我都有些好奇了。"
                },
                {
                    "id": "750910507",
                    "speaker": "派蒙",
                    "text": "到底是为什么，只要吃进去石头，就能吐出一些更好的？不如…我们把它打开来看看？"
                },
                {
                    "id": "750910508",
                    "speaker": "基斯庇",
                    "text": "你、你在说什么，决不允许这样做！"
                },
                {
                    "id": "750910509",
                    "speaker": "基斯庇",
                    "text": "要是…要是你们想要把「宝藏岩」打开的话，首先就要从我的尸体上踏过…"
                },
                {
                    "id": "750910510",
                    "speaker": "派蒙",
                    "text": "唔，我只是随口一说啦。"
                },
                {
                    "id": "750910511",
                    "speaker": "基斯庇",
                    "text": "哼，看在你们之前为「宝藏岩」拿来石头的份上…这次就饶过你的冒犯…"
                },
                {
                    "id": "750910512",
                    "speaker": "派蒙",
                    "text": "好、好吧…"
                },
                {
                    "id": "750910513",
                    "speaker": "基斯庇",
                    "text": "我已经，哼哼，我已经感受到了，只要再给「宝藏岩」吃下更高级的石头，它一定能够产生了不起的变化…"
                },
                {
                    "id": "750910514",
                    "speaker": "基斯庇",
                    "text": "异邦的旅人啊，我曾听外来的行商说，在沙漠之中有一种特殊的辉石，蕴藏了不起的力量…"
                },
                {
                    "id": "750910515",
                    "speaker": "基斯庇",
                    "text": "它的名字，是…对，它的名字是「万相石」。如果、如果能够将那种石头带来，喂给「宝藏岩」的话…"
                },
                {
                    "id": "750910516",
                    "speaker": "基斯庇",
                    "text": "一定，一定就可以…"
                },
                {
                    "id": "750910517",
                    "speaker": "派蒙",
                    "text": "#唔，{NICKNAME}，你觉得呢…"
                },
                {
                    "id": "750910518",
                    "speaker": "Player",
                    "text": "那就试试吧！"
                },
                {
                    "id": "750910519",
                    "speaker": "派蒙",
                    "text": "确实，很好奇会发生什么呢…"
                },
                {
                    "id": "750910520",
                    "speaker": "基斯庇",
                    "text": "如、如果有「万相石」的话…给我，只需要给我一枚就好…"
                }
            ]
        },
        {
            "id": "7509106",
            "objective": "",
            "dialogues": [
                {
                    "id": "750910601",
                    "speaker": "基斯庇",
                    "text": "啊，「宝藏岩」啊…这下终于…这下终于可以…"
                }
            ]
        },
        {
            "id": "7509107",
            "objective": "",
            "dialogues": [
                {
                    "id": "750910701",
                    "speaker": "基斯庇",
                    "text": "嗯…等到，等到安静的时候，我会将这些石头喂给「宝藏岩」…"
                },
                {
                    "id": "750910702",
                    "speaker": "基斯庇",
                    "text": "只要再过段时间，嘿，就会长出更好的石头的，嘿嘿，一颗…一颗，两颗…"
                }
            ]
        },
        {
            "id": "7509108",
            "objective": "",
            "dialogues": [
                {
                    "id": "750910801",
                    "speaker": "基斯庇",
                    "text": "嗯…等到，等到安静的时候，我会将你交给我的石头喂给「宝藏岩」…哈哈，真是些好石头啊…"
                },
                {
                    "id": "750910802",
                    "speaker": "基斯庇",
                    "text": "只要再过段时间，嘿，就会长出更好的石头的，嘿嘿，一颗…一颗，两颗…"
                }
            ]
        },
        {
            "id": "7509109",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "750910901",
                    "speaker": "基斯庇",
                    "text": "哈哈…原来这就是「万相石」，这是纳塔没有的石头，「宝藏岩」吃下以后，一定可以…吸收其中的力量。"
                },
                {
                    "id": "750910902",
                    "speaker": "基斯庇",
                    "text": "啊，真想知道，真想知道，「宝藏岩」啊…"
                }
            ]
        },
        {
            "id": "7509110",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "750911001",
                    "speaker": "基斯庇",
                    "text": "怎么了，嘿嘿，就跟之前说的那样，挑些石头交给我吧…「宝藏岩」一定会吐出更好的…"
                }
            ]
        },
        {
            "id": "7509111",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "750911101",
                    "speaker": "基斯庇",
                    "text": "嘿嘿，那就，挑些比以前更好的石头交给我吧…啊，更好的石头，这样，「宝藏岩」的力量，也一定会有所增长…"
                }
            ]
        },
        {
