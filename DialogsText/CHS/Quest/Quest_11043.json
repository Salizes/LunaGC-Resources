    "talks": [
        {
            "id": "1104301",
            "objective": "前往下一项实验的地点",
            "dialogues": [
                {
                    "id": "110430101",
                    "speaker": "派蒙",
                    "text": "不会是要我们从这么高的地方跳下去吧？"
                },
                {
                    "id": "110430102",
                    "speaker": "阿贝多",
                    "text": "不一定，如果你们有更好的办法的话。",
                    "choices": [
                        {
                            "id": "110430103",
                            "text": "必须得有吧。",
                            "response": [
                                {
                                    "id": "110430105",
                                    "speaker": "阿贝多",
                                    "text": "无论用什么办法，只要能够抵达下面的湖的对岸，就算完成了实验。"
                                },
                                {
                                    "id": "110430106",
                                    "speaker": "阿贝多",
                                    "text": "根据你完成的时间，以及达到的最快速度，我会进行分析与比较的。"
                                },
                                {
                                    "id": "110430107",
                                    "speaker": "派蒙",
                                    "text": "#在湖的对岸，也就是说，想让{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}在雪山游泳？！"
                                },
                                {
                                    "id": "110430108",
                                    "speaker": "阿贝多",
                                    "text": "当不限制条件的时候，人就会本能地去选择自己认为最合理的方式完成目标。"
                                },
                                {
                                    "id": "110430109",
                                    "speaker": "阿贝多",
                                    "text": "可能有人觉得冰雪中的湖水难以忍受，但可能另外的人就喜欢这种冰冷刺骨的方式。"
                                },
                                {
                                    "id": "110430110",
                                    "speaker": "阿贝多",
                                    "text": "无论你们做出了什么选择，都是实验的一部分，对我来说，都具有十足的研究价值。",
                                    "choices": [
                                        {
                                            "id": "110430111",
                                            "text": "交给我吧。",
                                            "response": [
                                                {
                                                    "id": "110430113",
                                                    "speaker": "阿贝多",
                                                    "text": "拜托你了，非常期待你交出的答卷。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "110430112",
                                            "text": "比起超能力这要轻松多了。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "110430104",
                            "text": "这种模棱两可的回答最让人紧张。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1104305",
            "objective": "(test)倒计时(release后隐藏)$HIDDEN",
            "dialogues": []
        },
        {
            "id": "1104302",
            "objective": "抵达阿贝多指定的终点",
            "dialogues": []
        },
        {
            "id": "1104304",
            "objective": "重新与阿贝多对话",
            "dialogues": []
        },
        {
            "id": "1104303",
            "objective": "与阿贝多交谈，获取结论",
            "dialogues": [
                {
                    "id": "110430301",
                    "speaker": "阿贝多",
                    "text": "辛苦你了，你的表现令我刮目相看。"
                },
                {
                    "id": "110430302",
                    "speaker": "阿贝多",
                    "text": "不愧是传闻中的旅行者，各项数据都已经远超蒙德的平均水平。"
                },
                {
                    "id": "110430303",
                    "speaker": "派蒙",
                    "text": "可是看你一直跟着我们，好像也没有气喘吁吁嘛。"
                },
                {
                    "id": "110430304",
                    "speaker": "阿贝多",
                    "text": "我吗？其实我用炼金术偷了一些懒，不过这些都不重要。"
                },
                {
                    "id": "110430305",
                    "speaker": "阿贝多",
                    "text": "如果提瓦特的法则没有影响你，那我可以获得几种对异世界文明的猜想。"
                },
                {
                    "id": "110430306",
                    "speaker": "阿贝多",
                    "text": "如果提瓦特的法则影响了你，那我也可以推测在没有影响的状况下，会发生怎样的演化。"
                },
                {
                    "id": "110430307",
                    "speaker": "阿贝多",
                    "text": "其中蕴含的无数可能性，实在太有趣了，值得反复品味。"
                },
                {
                    "id": "110430308",
                    "speaker": "派蒙",
                    "text": "但是…这对你的研究又有什么帮助呢？"
                },
                {
                    "id": "110430309",
                    "speaker": "阿贝多",
                    "text": "困扰我多时的问题已经解开，等回到营地之后，我应该能为你们呈现一些独特的东西。"
                },
                {
                    "id": "110430310",
                    "speaker": "Player",
                    "text": "你有像这样研究过其他东西吗？"
                },
                {
                    "id": "110430311",
                    "speaker": "阿贝多",
                    "text": "那你可能马上要被和很多奇奇怪怪的东西一起类比了，你可能会不乐意吧。"
                },
                {
                    "id": "110430312",
                    "speaker": "阿贝多",
                    "text": "黄金，石化古树，八倍大的太阳——"
                },
                {
                    "id": "110430313",
                    "speaker": "阿贝多",
                    "text": "探究本质的过程令人着迷。可惜，这种着迷的时光，注定只是须臾。"
                },
                {
                    "id": "110430314",
                    "speaker": "阿贝多",
                    "text": "我宁愿将我一切的精力都倾注其中，然而样本终究是有限的，当未知逐渐变为已知，那种趣味也就会逐渐消失。"
                },
                {
                    "id": "110430315",
                    "speaker": "阿贝多",
                    "text": "最终它们都会变为日落果，甜甜花这样平淡无奇的存在，不再值得花时间去关注了。"
                },
                {
                    "id": "110430316",
                    "speaker": "派蒙",
                    "text": "哦，所以你画的那副丘丘人的画，不同的丘丘人之间才会有那么明显的区分啊。"
                },
                {
                    "id": "110430317",
                    "speaker": "阿贝多",
                    "text": "对，当时我也说了，「很无聊，不值得浪费时间」。因为对我来说，它们的趣味早就消失了。"
                },
                {
                    "id": "110430318",
                    "speaker": "派蒙",
                    "text": "那在实验之后，我们在你的眼里也会变成这样吗？变成…呃，草稿？"
                },
                {
                    "id": "110430319",
                    "speaker": "阿贝多",
                    "text": "这个不必担心，你们是我的协助者，这份情谊我是不会忘记的。"
                },
                {
                    "id": "110430320",
                    "speaker": "阿贝多",
                    "text": "好了，在返回营地之前，让我们进行最后一项，也就是智能方面的实验吧。"
                },
                {
                    "id": "110430321",
                    "speaker": "阿贝多",
                    "text": "跟我来，现在我们去另一侧的遗迹。"
                }
            ]
        },
        {
            "id": "1104302",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "110430211",
                    "speaker": "派蒙",
                    "text": "那如果我们游泳，你会跟着游吗？"
                },
                {
                    "id": "110430212",
                    "speaker": "阿贝多",
                    "text": "不会，除非你想和我比赛。"
                },
                {
                    "id": "110430213",
                    "speaker": "派蒙",
                    "text": "我…呃，当我没说好了。"
                }
            ]
        }
    ]
}