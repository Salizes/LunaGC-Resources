{
    "quest": {
        "id": "76051",
        "title": "伴月的小画家·其二",
        "description": "在「银月之庭」，「少女」似乎遇到了一些困难…",
        "rewards": [],
        "rewards_formatted": "",
        "chapter": {
            "icon": "",
            "id": "",
