        }
    },
    "talks": [
        {
            "id": "7605101",
            "objective": "同「少女」见面",
            "dialogues": [
                {
                    "id": "760510101",
                    "speaker": "「少女」",
                    "text": "#{NICKNAME}，派蒙…"
                },
                {
                    "id": "760510102",
                    "speaker": "派蒙",
                    "text": "怎么了？哥伦比娅。你看起来像是遇到了什么麻烦一样。"
                },
                {
                    "id": "760510103",
                    "speaker": "「少女」",
                    "text": "你们身边有颜料吗？"
                },
                {
                    "id": "760510104",
                    "speaker": "梅拉",
                    "text": "！！"
                },
                {
                    "id": "760510105",
                    "speaker": "派蒙",
                    "text": "呀！你是…是梅拉对吧！"
                },
                {
                    "id": "760510106",
                    "speaker": "梅拉",
                    "text": "~！"
                },
                {
                    "id": "760510107",
                    "speaker": "派蒙",
                    "text": "你又想要画画了吗？怎么还把自己身上弄得到处都是颜料…"
                },
                {
                    "id": "760510108",
                    "speaker": "「少女」",
                    "text": "它出去一趟回来之后，就变成了这样子。这些颜料一时间也洗不掉。"
                },
                {
                    "id": "760510109",
                    "speaker": "派蒙",
                    "text": "难道是外出取材的时候遇到麻烦？"
                },
                {
                    "id": "760510110",
                    "speaker": "派蒙",
                    "text": "不过这样看起来也不错啦，很有艺术气息！"
                },
                {
                    "id": "760510111",
                    "speaker": "梅拉",
                    "text": "？？"
                },
                {
                    "id": "760510112",
                    "speaker": "派蒙",
                    "text": "哦！说回颜料，只要像上次一样给它些带颜色的东西就行了吧？"
                },
                {
                    "id": "760510113",
                    "speaker": "梅拉",
                    "text": "~~！"
                },
                {
                    "id": "760510114",
                    "speaker": "派蒙",
                    "text": "嘿嘿，看它这么开心，一定是取材的时候找到了些不错的灵感吧！还是很欢快的那种。"
                },
                {
                    "id": "760510115",
                    "speaker": "派蒙",
                    "text": "那我们这次找些温暖、愉快的颜色给梅拉吧！"
                }
            ]
        },
        {
            "id": "7605102",
            "objective": "将一些色彩丰富的东西交给月灵",
            "dialogues": [
                {
                    "id": "760510201",
                    "speaker": "Player",
                    "text": "（温暖愉快的颜色…）"
                }
            ]
        },
        {
            "id": "7605103",
            "objective": "观看月灵的画作",
            "dialogues": [
                {
                    "id": "760510301",
                    "speaker": "派蒙",
                    "text": "这样就可以了吧？"
                },
                {
                    "id": "760510302",
                    "speaker": "梅拉",
                    "text": "~~！"
                },
                {
                    "id": "760510303",
                    "speaker": "派蒙",
                    "text": "哦！它已经开始画起来了呢！"
                },
                {
                    "id": "760510304",
                    "speaker": "派蒙",
                    "text": "咳咳，请各位评委拭目以待，这次天才月灵画家梅拉，又会为我们呈现出怎样的…"
                },
                {
                    "id": "760510305",
                    "speaker": "梅拉",
                    "text": "！！"
                },
                {
                    "id": "760510306",
                    "speaker": "派蒙",
                    "text": "欸！这就画好了？我好不容易为你编的热场词都还没说完呢！"
                },
                {
                    "id": "760510307",
                    "speaker": "派蒙",
                    "text": "哦！果然这次画的也是哥伦比娅嘛。",
                    "choices": [
                        {
                            "id": "760510308",
                            "text": "看起来真美好…",
                            "response": [
                                {
                                    "id": "760510310",
                                    "speaker": "派蒙",
                                    "text": "这是…在挪德卡莱的森林里吗？有好多小动物欸！"
                                },
                                {
                                    "id": "760510311",
                                    "speaker": "「少女」",
                                    "text": "那恐怕…是我还没离开「霜月之子」的时候才有的景色吧。"
                                },
                                {
                                    "id": "760510312",
                                    "speaker": "派蒙",
                                    "text": "哇，好羡慕，那些小动物真的会这么聚集过来吗？"
                                },
                                {
                                    "id": "760510313",
                                    "speaker": "「少女」",
                                    "text": "嗯，它们大多是喜欢我散发出的月矩力，觉得趴在我身旁睡觉会很安心。"
                                },
                                {
                                    "id": "760510314",
                                    "speaker": "派蒙",
                                    "text": "天哪！那岂不是可以随便摸它们也不会乱跑！"
                                },
                                {
                                    "id": "760510315",
                                    "speaker": "「少女」",
                                    "text": "唔…最好摸的应该是帔髦獾，它的尾巴又大又蓬。"
                                },
                                {
                                    "id": "760510316",
                                    "speaker": "「少女」",
                                    "text": "凛角鹿脖子上的毛也很软，用来当枕头会睡得很舒服。"
                                },
                                {
                                    "id": "760510317",
                                    "speaker": "「少女」",
                                    "text": "你们喜欢哪一种呢？"
                                },
                                {
                                    "id": "760510318",
                                    "speaker": "派蒙",
                                    "text": "为什么是以我们也体验过为前提问的呀…"
                                },
                                {
                                    "id": "760510319",
                                    "speaker": "派蒙",
                                    "text": "但要说试的话…我可能会想摸摸帔髦獾的尾巴吧。"
                                },
                                {
                                    "id": "760510320",
                                    "speaker": "「少女」",
                                    "text": "有些帔髦獾很怕生，如果周围不是很安全的话，它们是不会让人摸的。"
                                },
                                {
                                    "id": "760510321",
                                    "speaker": "「少女」",
                                    "text": "啊…不过派蒙要小心一些。"
                                },
                                {
                                    "id": "760510322",
                                    "speaker": "派蒙",
                                    "text": "欸？怎么了？它们会咬人吗？我…我不会把它们摸生气的啦。"
                                },
                                {
                                    "id": "760510323",
                                    "speaker": "「少女」",
                                    "text": "不，是要小心天上。"
                                },
                                {
                                    "id": "760510324",
                                    "speaker": "派蒙",
                                    "text": "天上？"
                                },
                                {
                                    "id": "760510325",
                                    "speaker": "「少女」",
                                    "text": "嗯，有的长翎鹮会捕捉小体型的动物。以前也是在我提醒之后，它们才慢慢改掉了捕捉月灵的习惯。"
                                },
                                {
                                    "id": "760510326",
                                    "speaker": "派蒙",
                                    "text": "这种危险在我们第一次见面的时候就该说呀！我到今天都没被抓走已经是奇迹了！"
                                },
                                {
                                    "id": "760510327",
                                    "speaker": "「少女」",
                                    "text": "唔…好吧，下次见到长翎鹮的时候，我会提醒它们的。"
                                },
                                {
                                    "id": "760510328",
                                    "speaker": "派蒙",
                                    "text": "现在就去提醒吧！不然我都不敢出这个门了呀！"
                                },
                                {
                                    "id": "760510329",
                                    "speaker": "「少女」",
                                    "text": "那我应该和长翎鹮们说，派蒙是…",
                                    "choices": [
                                        {
                                            "id": "760510330",
                                            "text": "最好的伙伴。",
                                            "response": [
                                                {
                                                    "id": "760510331",
                                                    "speaker": "派蒙",
                                                    "text": "对对，不能把好伙伴抓走哦！"
                                                },
                                                {
                                                    "id": "760510336",
                                                    "speaker": "梅拉",
                                                    "text": "！！"
                                                },
                                                {
                                                    "id": "760510337",
                                                    "speaker": "「少女」",
                                                    "text": "这孩子…好像对派蒙被长翎鹮抓走的样子很感兴趣。"
                                                },
                                                {
                                                    "id": "760510338",
                                                    "speaker": "派蒙",
                                                    "text": "不要拿这种画面来当素材呀喂！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "760510332",
                                            "text": "最好的向导。",
                                            "response": [
                                                {
                                                    "id": "760510333",
                                                    "speaker": "派蒙",
                                                    "text": "呃…你这么记着我倒是很开心，但长翎鹮不知道什么叫「向导」吧…"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "760510334",
                                            "text": "吃了会坏肚子的东西。",
                                            "response": [
                                                {
                                                    "id": "760510335",
                                                    "speaker": "派蒙",
                                                    "text": "不要以吃进肚子为前提啦！万一长翎鹮真想试试怎么办！"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "760510309",
                            "text": "看起来真开心…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7605104",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "760510401",
                    "speaker": "「少女」",
                    "text": "唔…想去揉揉小动物了。"
                }
            ]
        }
    ]
}