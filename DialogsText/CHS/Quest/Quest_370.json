    "talks": [
        {
            "id": "37001",
            "objective": "回到蒙德城",
            "dialogues": []
        },
        {
            "id": "37002",
            "objective": "听听琴和神秘人的对话",
            "dialogues": [
                {
                    "id": "3700201",
                    "speaker": "派蒙",
                    "text": "咦？那不是琴团长吗？"
                },
                {
                    "id": "3700202",
                    "speaker": "派蒙",
                    "text": "她好像在和什么人说话…"
                },
                {
                    "id": "3700203",
                    "speaker": "派蒙",
                    "text": "等她们说完，过去打个招呼吧？"
                },
                {
                    "id": "3700204",
                    "speaker": "安娜斯塔西娅",
                    "text": "…所以，我们的态度就是这样。"
                },
                {
                    "id": "3700205",
                    "speaker": "安娜斯塔西娅",
                    "text": "若无法立刻剿灭作乱的魔龙，不如将蒙德的城防移交给「愚人众」。"
                },
                {
                    "id": "3700206",
                    "speaker": "安娜斯塔西娅",
                    "text": "蒙德的龙灾是可以处理的，只要让我们把那头野兽…"
                },
                {
                    "id": "3700207",
                    "speaker": "琴",
                    "text": "「野兽」？"
                },
                {
                    "id": "3700208",
                    "speaker": "安娜斯塔西娅",
                    "text": "嗯？代理团长大人的意思是？"
                },
                {
                    "id": "3700209",
                    "speaker": "琴",
                    "text": "呼…"
                },
                {
                    "id": "3700210",
                    "speaker": "琴",
                    "text": "希望贵国的外交官能拿出更职业的态度来。"
                },
                {
                    "id": "3700211",
                    "speaker": "琴",
                    "text": "你们想「处理」蒙德的四风守护之一？"
                },
                {
                    "id": "3700212",
                    "speaker": "琴",
                    "text": "我不希望有人在西风骑士面前说这种疯话。"
                },
                {
                    "id": "3700213",
                    "speaker": "安娜斯塔西娅",
                    "text": "呵…呵呵呵…也没你说的那么疯吧。"
                },
                {
                    "id": "3700214",
                    "speaker": "安娜斯塔西娅",
                    "text": "很好，今天的磋商到此为止。"
                },
                {
                    "id": "3700215",
                    "speaker": "安娜斯塔西娅",
                    "text": "这次的成果就是「双方坦诚地交换了建设性的意见」，对吗？"
                },
                {
                    "id": "3700216",
                    "speaker": "安娜斯塔西娅",
                    "text": "我会…如实记录的…"
                },
                {
                    "id": "3700217",
                    "speaker": "琴",
                    "text": "#啊，{NICKNAME}，你回来了。"
                },
                {
                    "id": "3700218",
                    "speaker": "琴",
                    "text": "十分感谢你的协助，城市周围的元素循环终于安定了。"
                },
                {
                    "id": "3700219",
                    "speaker": "琴",
                    "text": "风魔龙上次袭击的余波，算是暂时告一段落了吧。"
                },
                {
                    "id": "3700220",
                    "speaker": "琴",
                    "text": "不过，使团那边施加的压力，也已经大到了很难无视的地步……"
                },
                {
                    "id": "3700221",
                    "speaker": "派蒙",
                    "text": "使团？"
                },
                {
                    "id": "3700222",
                    "speaker": "派蒙",
                    "text": "是外交使团吗…来自璃月港吗？还是稻妻城？"
                },
                {
                    "id": "3700223",
                    "speaker": "琴",
                    "text": "是至冬国，在七神中信奉冰神的国家。"
                },
                {
                    "id": "3700224",
                    "speaker": "琴",
                    "text": "他们的使者有个特殊的名字：愚人众——听说过么？"
                },
                {
                    "id": "3700225",
                    "speaker": "派蒙",
                    "text": "啊，原来是「愚人众」。确实有听过！"
                },
                {
                    "id": "3700226",
                    "speaker": "派蒙",
                    "text": "不过，是那种不太好的名声呢。"
                },
                {
                    "id": "3700227",
                    "speaker": "琴",
                    "text": "我不认为直接杀死风魔龙是正确的行为。"
                },
                {
                    "id": "3700228",
                    "speaker": "琴",
                    "text": "而且，冰之神统率的「愚人众」，觊觎着风神眷属的力量…"
                },
                {
                    "id": "3700229",
                    "speaker": "琴",
                    "text": "这件事本身就已经非常可疑了。"
                },
                {
                    "id": "3700230",
                    "speaker": "Player",
                    "text": "说到「力量」…"
                },
                {
                    "id": "3700231",
                    "speaker": "琴",
                    "text": "#怎么了，{NICKNAME}？"
                },
                {
                    "id": "3700232",
                    "speaker": "Player",
                    "text": "有件东西想让骑士团看看…"
                },
                {
                    "id": "3700233",
                    "speaker": "琴",
                    "text": "嗯？好，那我们就回骑士团总部吧。"
                },
                {
                    "id": "3700234",
                    "speaker": "琴",
                    "text": "不要在…这种地方，谈论重要的事。"
                }
            ]
        },
        {
            "id": "37004",
            "objective": "与琴一同回到骑士团总部",
            "dialogues": [
                {
                    "id": "3700401",
                    "speaker": "琴",
                    "text": "是蕴含着某种力量的结晶…但，丽莎，你能分析它的构成吗？"
                },
                {
                    "id": "3700402",
                    "speaker": "丽莎",
                    "text": "嗯，我来看看。"
                },
                {
                    "id": "3700403",
                    "speaker": "丽莎",
                    "text": "可以发现结晶内部有些污秽杂质，不过更进一步的研究就…"
                },
                {
                    "id": "3700404",
                    "speaker": "丽莎",
                    "text": "很抱歉，现在还得不出有用的结论。给我一点时间，我去禁书区找些资料吧。"
                },
                {
                    "id": "3700405",
                    "speaker": "琴",
                    "text": "那么丽莎，之后的研究调查就交给你了。"
                },
                {
                    "id": "3700406",
                    "speaker": "丽莎",
                    "text": "嗯，如果有什么进展，我会通知大家的。"
                },
                {
                    "id": "3700407",
                    "speaker": "丽莎",
                    "text": "不过嘛，不要太期待上古的文献能有什么帮助。而且——咿啊！"
                },
                {
                    "id": "3700408",
                    "speaker": "丽莎",
                    "text": "呜…好痛…"
                },
                {
                    "id": "3700409",
                    "speaker": "丽莎",
                    "text": "结晶里的那种污秽杂质，稍稍靠近，就会让我感到刺痛…"
                },
                {
                    "id": "3700410",
                    "speaker": "丽莎",
                    "text": "是了，原来是这样啊…是与「神之眼」的互斥呢。"
                },
                {
                    "id": "3700411",
                    "speaker": "丽莎",
                    "text": "那种污秽的力量，会和我们体内的元素之力相互排斥，纠缠相杀。"
                },
                {
                    "id": "3700412",
                    "speaker": "丽莎",
                    "text": "#不过，真是奇怪。{NICKNAME}明明也能使用元素之力，却不受影响呢。"
                },
                {
                    "id": "3700413",
                    "speaker": "Player",
                    "text": "……"
                },
                {
                    "id": "3700414",
                    "speaker": "丽莎",
                    "text": "总之，这枚结晶还是让小可爱保管吧。放在我们手里也只是徒增疼痛。",
                    "choices": [
                        {
                            "id": "3700415",
                            "text": "小可爱？",
                            "response": [
                                {
                                    "id": "3700417",
                                    "speaker": "琴",
                                    "text": "…真是不可思议的现象。"
                                },
                                {
                                    "id": "3700418",
                                    "speaker": "琴",
                                    "text": "你对这一切——对自己身上这些特殊的地方，有什么头绪吗？"
                                },
                                {
                                    "id": "3700419",
                                    "speaker": "Player",
                                    "text": "……（主角摇头）"
                                },
                                {
                                    "id": "3700420",
                                    "speaker": "琴",
                                    "text": "我想也是…"
                                },
                                {
                                    "id": "3700421",
                                    "speaker": "琴",
                                    "text": "#那么，{NICKNAME}。这是骑士团第二次的不情之请："
                                },
                                {
                                    "id": "3700422",
                                    "speaker": "琴",
                                    "text": "请接受西风骑士团荣誉骑士的爵位…与代理团长的谢意。"
                                },
                                {
                                    "id": "3700423",
                                    "speaker": "Player",
                                    "text": "……（主角微微惊讶）"
                                },
                                {
                                    "id": "3700424",
                                    "speaker": "派蒙",
                                    "text": "西风的…荣誉骑士？！"
                                },
                                {
                                    "id": "3700425",
                                    "speaker": "琴",
                                    "text": "……（琴点头）"
                                },
                                {
                                    "id": "3700426",
                                    "speaker": "琴",
                                    "text": "也请你再次帮助我们，寻找这些谜团的答案。"
                                },
                                {
                                    "id": "3700427",
                                    "speaker": "琴",
                                    "text": "魔龙的狂乱，与怪异的结晶…我想，这背后的答案一定关系着蒙德的和平。"
                                },
                                {
                                    "id": "3700428",
                                    "speaker": "琴",
                                    "text": "愿风擦拭你的双眼，让你看清真相。"
                                },
                                {
                                    "id": "3700429",
                                    "speaker": "琴",
                                    "text": "如果有什么最新发现，我们就在这里再会吧。"
                                }
                            ]
                        },
                        {
                            "id": "3700416",
                            "text": "行，就这样办。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "37005",
            "objective": "与琴对话",
            "dialogues": []
        },
        {
            "id": "37003",
            "objective": "(test)你一进门我就触发接对话$HIDDEN",
            "dialogues": [
                {
                    "id": "3700301",
                    "speaker": "琴",
                    "text": "蒙德与至冬是平等的，同为此世七国之一。"
                },
                {
                    "id": "3700302",
                    "speaker": "琴",
                    "text": "蒙德是独立城邦，不属于别的什么国家。"
                },
                {
                    "id": "3700303",
                    "speaker": "琴",
                    "text": "至冬「国」也只是建立时政体不同，所以称呼不同而已。"
                },
                {
                    "id": "3700304",
                    "speaker": "琴",
                    "text": "但在外交方面，至冬国的「愚人众」恐怕可以算是大陆上最强势的一方…"
                },
                {
                    "id": "3700305",
                    "speaker": "派蒙",
                    "text": "嗯，没错。比如刚才的家伙，语气就非常讨厌呢。"
                }
            ]
        },
        {
            "id": "48202",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "4820221",
                    "speaker": "安柏",
                    "text": "按照我给你<color=#00E1FFFF>标记好的路线</color>，一路平稳地飞到终点吧。"
                }
            ]
        }
    ]
}