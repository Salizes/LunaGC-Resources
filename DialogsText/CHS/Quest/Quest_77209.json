        {
            "id": "7720906",
            "objective": "寻找声音的来源",
            "dialogues": []
        },
        {
            "id": "7720905",
            "objective": "与神秘声音对话",
            "dialogues": [
                {
                    "id": "772090301",
                    "speaker": "冰下的声音",
                    "text": "我听到了脚步声，岸上的旅者。请您停一停，劳驾。"
                },
                {
                    "id": "772090302",
                    "speaker": "派蒙",
                    "text": "又出现了！冰面下的声音。好可怕，这里不会有幽灵吧…"
                },
                {
                    "id": "772090303",
                    "speaker": "Player",
                    "text": "你是谁？"
                },
                {
                    "id": "772090304",
                    "speaker": "冰下的声音",
                    "text": "不必害怕，旅者。说到幽灵，我或许真是历史的幽灵，但请你们相信，我绝无恶意。"
                },
                {
                    "id": "772090305",
                    "speaker": "冰下的声音",
                    "text": "你们眼前的巨大浮冰，实则是我栖息地的根基。现今，我的栖息地为碎冰所困，在这湖面倒悬。"
                },
                {
                    "id": "772090306",
                    "speaker": "冰下的声音",
                    "text": "若您能施以援手，<color=cyan>将湖面上其它碎冰去除</color>，我将感激不尽。"
                }
            ]
        },
        {
            "id": "7720901",
            "objective": "清除周围的碎冰",
            "dialogues": [
                {
                    "id": "772090101",
                    "speaker": "冰上的木屋",
                    "text": "感激不尽，岸上的旅者。蒙您襄助，我的困厄稍解。"
                },
                {
                    "id": "772090102",
                    "speaker": "冰上的木屋",
                    "text": "如您仍愿施以援手，可否请您将这船屋<color=cyan>牵引至岸边</color>，使它不必永远停滞在此处的水面？"
                },
                {
                    "id": "772090103",
                    "speaker": "派蒙",
                    "text": "唔…我对这个人有点好奇了！如果把他的房子拉上岸，是不是就能看见他长什么样？"
                },
                {
                    "id": "772090104",
                    "speaker": "Player",
                    "text": "要怎么做？"
                },
                {
                    "id": "772090105",
                    "speaker": "冰上的木屋",
                    "text": "请您在四周寻找臻冰装置，将它们安放在合宜之处。船屋会得到它们的牵引。"
                }
            ]
        },
        {
            "id": "7720907",
            "objective": "与木屋中人对话",
            "dialogues": []
        },
        {
            "id": "7720902",
            "objective": "将木屋牵至岸边",
            "dialogues": [
                {
                    "id": "772090201",
                    "speaker": "冰上的木屋",
                    "text": "感激不尽，岸上的旅者。您的义举，我铭记于心。"
                },
                {
                    "id": "772090202",
                    "speaker": "派蒙",
                    "text": "如果要感谢别人，得当面说才礼貌吧！"
                },
                {
                    "id": "772090203",
                    "speaker": "冰上的木屋",
                    "text": "失礼，请您原谅。我并非不懂得世人的礼节，只是我这张旧日的面孔，太久未见天日，怕是会冒犯到岸上的旅者。"
                },
                {
                    "id": "772090204",
                    "speaker": "冰上的木屋",
                    "text": "请您原谅一个多余的人吧，请您原谅这个终会被历史遗忘的、来自雪原上最后的旧贵族，他的名字是丘尔卡图林。"
                },
                {
                    "id": "772090205",
                    "speaker": "丘尔卡图林",
                    "text": "请您原谅他的选择：他早将自己寄寓在这冰上的房屋，不再踏上至冬的陆地，如今已有三百二十一年。"
                },
                {
                    "id": "772090206",
                    "speaker": "派蒙",
                    "text": "等等…你已经在这个到处漂的木房子里三百多年没出来！"
                },
                {
                    "id": "772090207",
                    "speaker": "Player",
                    "text": "你不是人类。"
                },
                {
                    "id": "772090208",
                    "speaker": "丘尔卡图林",
                    "text": "不错，岸上的旅者。我是被遗忘的，旧日的幽灵，来自那个仍然还属于妖精的时代。"
                },
                {
                    "id": "772090209",
                    "speaker": "丘尔卡图林",
                    "text": "在比三百年前更早的岁月，我们被从这片土地上连根拔除。旧的时代落幕，陆地上再没有我们的归属。"
                },
                {
                    "id": "772090210",
                    "speaker": "丘尔卡图林",
                    "text": "属于我们的荣光，都已化作尘埃。我们的家园…那些雪杨，都被砍倒在了地上。"
                },
                {
                    "id": "772090211",
                    "speaker": "丘尔卡图林",
                    "text": "与我们共享着同一种记忆的人，或者慢慢消失，或者与自己的过去决裂。直到最后，所有人里，只剩下我一个。"
                },
                {
                    "id": "772090212",
                    "speaker": "丘尔卡图林",
                    "text": "我无法在这两条道路中做出抉择，所以把命运交给了这冰上的房屋…"
                },
                {
                    "id": "772090213",
                    "speaker": "丘尔卡图林",
                    "text": "我用被砍下的雪杨，做成了这间房屋，从此任由它带着我的命运，在湖泊与河流上漂荡。"
                },
                {
                    "id": "772090214",
                    "speaker": "丘尔卡图林",
                    "text": "要起风了。流水会带着我的命运离开。"
                },
                {
                    "id": "772090215",
                    "speaker": "丘尔卡图林",
                    "text": "也许我们还会再次相遇，岸上的旅者。如果那时，你们仍对我的故事感兴趣，我再向你们讲述。"
                },
                {
                    "id": "772090216",
                    "speaker": "Black Screen",
                    "text": "浮在冰上的木屋顺着水流缓缓漂向远方，直至在你们的视线中消失。"
                }
            ]
        },
