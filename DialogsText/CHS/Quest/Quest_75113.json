    "talks": [
        {
            "id": "7511301",
            "objective": "(test)与牧龙人对话$HIDDEN",
            "dialogues": [
                {
                    "id": "751130101",
                    "speaker": "乌鲁班巴",
                    "text": "好心的勇士，我的小龙全都安然无恙，多亏有你帮忙！"
                },
                {
                    "id": "751130106",
                    "speaker": "乌鲁班巴",
                    "text": "像你这种又善良又有勇气的人，我乌鲁班巴愿意无偿帮助你进行「勇士挑战」训练！",
                    "choices": [
                        {
                            "id": "751130104",
                            "text": "现在开始吧！"
                        },
                        {
                            "id": "751130105",
                            "text": "让我稍做准备..."
                        }
                    ]
                }
            ]
        },
        {
            "id": "7511302",
            "objective": "(test)完成挑战$HIDDEN",
            "dialogues": [
                {
                    "id": "751130201",
                    "speaker": "乌鲁班巴",
                    "text": "一旦决定了，不要多想，使劲往前冲就好！"
                }
            ]
        },
        {
            "id": "7511303",
            "objective": "(test)完成最高难度奖励$HIDDEN",
            "dialogues": [
                {
                    "id": "751130401",
                    "speaker": "乌鲁班巴",
                    "text": "啊，我倒是没想到你能冲出这么好的成绩，是我小看人了。"
                },
                {
                    "id": "751130402",
                    "speaker": "乌鲁班巴",
                    "text": "精心准备好的挑战奖品被半路杀出来的陌生人轻松拿走，这种事…"
                },
                {
                    "id": "751130403",
                    "speaker": "乌鲁班巴",
                    "text": "简直就像织物里说的英雄故事！"
                },
                {
                    "id": "751130405",
                    "speaker": "乌鲁班巴",
                    "text": "说不定将来你也会成为被写进织物里的英雄，嗯…很有可能！"
                },
                {
                    "id": "751130406",
                    "speaker": "乌鲁班巴",
                    "text": "英雄，要不要一起来留个影？将来有一天，说不定我还能拿这张画片出去吹吹牛。"
                }
            ]
        }
    ]
