        }
    },
    "talks": [
        {
            "id": "2210501",
            "objective": "与菲尔戈黛特对话",
            "dialogues": [
                {
                    "id": "221050101",
                    "speaker": "菲尔戈黛特",
                    "text": "真烦人…"
                },
                {
                    "id": "221050102",
                    "speaker": "Player",
                    "text": "怎么了？"
                },
                {
                    "id": "221050103",
                    "speaker": "菲尔戈黛特",
                    "text": "我总感觉这客栈周围怪怪的，又说不出来个所以然。"
                },
                {
                    "id": "221050104",
                    "speaker": "菲尔戈黛特",
                    "text": "而且我们这客栈里，又都是住着些格外敏感的人…"
                },
                {
                    "id": "221050105",
                    "speaker": "菲尔戈黛特",
                    "text": "一有什么风吹草动，门窗总会掉几扇，说不定楼板都要破几块。"
                },
                {
                    "id": "221050106",
                    "speaker": "菲尔戈黛特",
                    "text": "虽然客人们都会自己出钱修，但是这东一块西一块的，太难看了。"
                },
                {
                    "id": "221050107",
                    "speaker": "菲尔戈黛特",
                    "text": "您能帮我去客栈周围看看吗？有什么怪地方，就…处理一下，我还要在这接待客人。",
                    "choices": [
                        {
                            "id": "221050108",
                            "text": "我知道了。",
                            "response": [
                                {
                                    "id": "221050110",
                                    "speaker": "菲尔戈黛特",
                                    "text": "那就拜托您了。"
                                }
                            ]
                        },
                        {
                            "id": "221050109",
                            "text": "这些客人…",
                            "response": [
                                {
                                    "id": "221050111",
                                    "speaker": "菲尔戈黛特",
                                    "text": "客人？哎呀，不用在意，常年在野外摸爬滚打的人，免不了过度敏感。"
                                },
                                {
                                    "id": "221050112",
                                    "speaker": "菲尔戈黛特",
                                    "text": "那么就拜托您了，就是去周围看看，应该也不会出什么事。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2210502",
            "objective": "前往可疑地点查看",
            "dialogues": [
                {
                    "id": "221050201",
                    "speaker": "菲尔戈黛特",
                    "text": "都处理好了吗？"
                },
                {
                    "id": "221050202",
                    "speaker": "Player",
                    "text": "还没有…"
                },
                {
                    "id": "221050203",
                    "speaker": "菲尔戈黛特",
                    "text": "请您快些吧，不然等入了夜，某些客人就会更加敏感了。"
                }
            ]
        },
        {
            "id": "2210503",
            "objective": "消灭所有魔物",
            "dialogues": [
                {
                    "id": "221050301",
                    "speaker": "菲尔戈黛特",
                    "text": "都处理好了吗？"
                },
                {
                    "id": "221050302",
                    "speaker": "Player",
                    "text": "处理好了。"
                },
                {
                    "id": "221050303",
                    "speaker": "菲尔戈黛特",
                    "text": "太好了，今天晚上应该能安生一会了。"
                },
                {
                    "id": "221050304",
                    "speaker": "菲尔戈黛特",
                    "text": "这是给你的酬谢，辛苦您了。"
                }
            ]
        },
        {
            "id": "2210504",
            "objective": "向菲尔戈黛特回报",
            "dialogues": []
        }
    ]
}