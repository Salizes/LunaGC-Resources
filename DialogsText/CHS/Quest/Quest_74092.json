    "talks": [
        {
            "id": "7409201",
            "objective": "(test)和女记者对话$HIDDEN",
            "dialogues": [
                {
                    "id": "740920101",
                    "speaker": "克洛妮艾",
                    "text": "为什么…为什么会这样…可恶…",
                    "choices": [
                        {
                            "id": "740920102",
                            "text": "克洛妮艾小姐？",
                            "response": [
                                {
                                    "id": "740920104",
                                    "speaker": "克洛妮艾",
                                    "text": "#{NICKNAME}！你来了，太好了…你…至少你还知道真相…"
                                },
                                {
                                    "id": "740920105",
                                    "speaker": "派蒙",
                                    "text": "克洛妮艾小姐，你冷静一点，你…你怎么了？"
                                },
                                {
                                    "id": "740920106",
                                    "speaker": "克洛妮艾",
                                    "text": "就算…就算我的报道没办法登上报纸…"
                                },
                                {
                                    "id": "740920107",
                                    "speaker": "Player",
                                    "text": "你的报道怎么样了？"
                                },
                                {
                                    "id": "740920108",
                                    "speaker": "派蒙",
                                    "text": "嗯，我们还在奇怪，什么时候才会看见你的报道呢。"
                                },
                                {
                                    "id": "740920109",
                                    "speaker": "克洛妮艾",
                                    "text": "没看到…没看到，对，对…你们应该没看到…"
                                },
                                {
                                    "id": "740920110",
                                    "speaker": "Player",
                                    "text": "你怎么…一副慌张的样子？"
                                },
                                {
                                    "id": "740920111",
                                    "speaker": "克洛妮艾",
                                    "text": "事情是这样的…自从那天从枫丹科学院回来之后，我就开始着手编撰文章。"
                                },
                                {
                                    "id": "740920112",
                                    "speaker": "克洛妮艾",
                                    "text": "我把所有我看见的，我听见的，我感受到的全部如实写了上去。"
                                },
                                {
                                    "id": "740920113",
                                    "speaker": "克洛妮艾",
                                    "text": "比如，枫丹科学院并没有完全清除始基矿。反而重新启动了另一项和始基矿有关的项目。"
                                },
                                {
                                    "id": "740920114",
                                    "speaker": "克洛妮艾",
                                    "text": "一个艾德温曾经的部下被派去探索枫丹科学院废墟，但却在爆炸中丧生。"
                                },
                                {
                                    "id": "740920115",
                                    "speaker": "克洛妮艾",
                                    "text": "枫丹科学院高级技官雷蒙多拒绝承认他的身亡，并且坚持那些爆炸本就在计划内。"
                                },
                                {
                                    "id": "740920116",
                                    "speaker": "克洛妮艾",
                                    "text": "还有废墟里那个失控的大机器，被污染的水体…"
                                },
                                {
                                    "id": "740920117",
                                    "speaker": "克洛妮艾",
                                    "text": "所有枫丹科学院想要隐瞒的事情，我全都写进了文章里！"
                                },
                                {
                                    "id": "740920118",
                                    "speaker": "克洛妮艾",
                                    "text": "但是…就在我递交了这篇报道后，却被告知，枫丹科学院对我发起了诉讼！"
                                },
                                {
                                    "id": "740920119",
                                    "speaker": "克洛妮艾",
                                    "text": "按照报社规定，我所有和枫丹科学院有关的报道文章都必须接受「可信度审查」。"
                                },
                                {
                                    "id": "740920120",
                                    "speaker": "克洛妮艾",
                                    "text": "那一篇对枫丹科学院的报道，也被撤了下来…",
                                    "choices": [
                                        {
                                            "id": "740920121",
                                            "text": "可信度审查？",
                                            "response": [
                                                {
                                                    "id": "740920123",
                                                    "speaker": "克洛妮艾",
                                                    "text": "不，这种审查并非是针对某篇报道，而是针对于我这个人…"
                                                },
                                                {
                                                    "id": "740920124",
                                                    "speaker": "克洛妮艾",
                                                    "text": "简单来说，枫丹科学院控告我因为利益冲突，而将主观情绪代入了报道事务，向大众传达了错误信息…"
                                                },
                                                {
                                                    "id": "740920125",
                                                    "speaker": "Player",
                                                    "text": "但…你和枫丹科学院有利益冲突吗？"
                                                },
                                                {
                                                    "id": "740920126",
                                                    "speaker": "派蒙",
                                                    "text": "克洛妮艾小姐只是拍了几张画片，里面全是烂石头和不会动的大机器…这有什么「利益冲突」呀？"
                                                },
                                                {
                                                    "id": "740920127",
                                                    "speaker": "Player",
                                                    "text": "天哪，你泄露他们的道德水平了？"
                                                },
                                                {
                                                    "id": "740920128",
                                                    "speaker": "克洛妮艾",
                                                    "text": "他们…指控我泄露了最新型的枫达品类。"
                                                },
                                                {
                                                    "id": "740920129",
                                                    "speaker": "克洛妮艾",
                                                    "text": "枫丹科学院的人坚持说，我之前在废墟中所拍的画片，有一部分涉及到了新型枫达的设计方案。"
                                                },
                                                {
                                                    "id": "740920130",
                                                    "speaker": "克洛妮艾",
                                                    "text": "他们必须检查每一张画片。在那之前，枫丹科学院不会解除诉讼，我也要一直接受可信度审查。"
                                                },
                                                {
                                                    "id": "740920131",
                                                    "speaker": "克洛妮艾",
                                                    "text": "很确定，这就是枫丹科学院为了阻止我发布报道而采取的手段…但我不会放弃的。"
                                                },
                                                {
                                                    "id": "740920132",
                                                    "speaker": "克洛妮艾",
                                                    "text": "来，拿好！这份报纸是我自己偷偷去印的，等会我就出去把这些报纸散发出去。"
                                                },
                                                {
                                                    "id": "740920133",
                                                    "speaker": "克洛妮艾",
                                                    "text": "我一定要让所有人都知道真相和枫丹科学院的真面目，还有…"
                                                },
                                                {
                                                    "id": "740920134",
                                                    "speaker": "缪妮",
                                                    "text": "克洛妮艾小姐！您怎么还在这里，我找您好久了。"
                                                },
                                                {
                                                    "id": "740920135",
                                                    "speaker": "克洛妮艾",
                                                    "text": "天哪！有人过来了，我不能再待在这里了…"
                                                },
                                                {
                                                    "id": "740920136",
                                                    "speaker": "克洛妮艾",
                                                    "text": "这份报纸给你，一定要收好，我把所有的真相都写在上面了！"
                                                },
                                                {
                                                    "id": "740920137",
                                                    "speaker": "缪妮",
                                                    "text": "按照规定，您现在必须去复律庭接受每天的例行审查…"
                                                },
                                                {
                                                    "id": "740920138",
                                                    "speaker": "缪妮",
                                                    "text": "欸！您别跑啊，克洛妮艾小姐！"
                                                },
                                                {
                                                    "id": "740920139",
                                                    "speaker": "缪妮",
                                                    "text": "只不过是枫达而已，说不定是场误会！只要解释清楚就…"
                                                },
                                                {
                                                    "id": "740920140",
                                                    "speaker": "缪妮",
                                                    "text": "等等！请等等啊，克洛妮艾小姐！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "740920122",
                                            "text": "报社认为你的报道不可信吗？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "740920103",
                            "text": "你在这里做什么呢？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7409202",
            "objective": "(test)和女记者对话$HIDDEN",
            "dialogues": []
        }
    ]
