{
    "quest": {
        "id": "20041",
        "title": "冒险就要勇于前进！",
        "description": "徘徊在千风神殿附近的帕琪小姐，正在烦恼着进入神殿的方法…",
        "rewards": [],
        "rewards_formatted": "",
        "chapter": {
            "icon": "",
            "id": "",
            "num": "",
            "title": ""
        },
        "total_dialogue_lines": 20,
        "total_speaker_counts": {
            "Player": 5,
            "好奇的帕琪": 14,
            "杜兰": 1
        }
    },
    "talks": [
        {
            "id": "2004101",
            "objective": "与帕琪对话",
            "dialogues": [
                {
                    "id": "200410101",
                    "speaker": "好奇的帕琪",
                    "text": "冒险不可能有完美的方案！这么拖下去，什么时候才能有进展？"
                },
                {
                    "id": "200410102",
                    "speaker": "杜兰",
                    "text": "就算没有完美的方案，也要做好万全的准备！"
                },
                {
                    "id": "200410103",
                    "speaker": "Player",
                    "text": "你们在吵什么呢？"
                },
                {
                    "id": "200410104",
                    "speaker": "好奇的帕琪",
                    "text": "我是研究古代遗迹的学者，想要去千风神殿里考察。但我不太擅长对付需要战斗的场合。"
                },
                {
                    "id": "200410105",
                    "speaker": "好奇的帕琪",
                    "text": "杜兰先生说自己是个冒险家，把调查神殿的任务都揽了下来。"
                },
                {
                    "id": "200410106",
                    "speaker": "好奇的帕琪",
                    "text": "我，我并不是说杜兰先生怎么样，我也知道那个遗迹守卫很麻烦，但是他说要制订一个完美的冒险方案，不停地拉着我开会研究…"
                },
                {
                    "id": "200410107",
                    "speaker": "好奇的帕琪",
                    "text": "研究…调查…调整，然后再调查…研究…调整…我已经受不了了！"
                },
                {
                    "id": "200410108",
                    "speaker": "好奇的帕琪",
                    "text": "他刚才又找到了一条线索，说是神殿旁边有一片怪物营地。"
                },
                {
                    "id": "200410109",
                    "speaker": "好奇的帕琪",
                    "text": "拜托你，去把那片营地给清理掉吧！就算不能进神殿，把他的嘴堵住也好。",
                    "choices": [
                        {
                            "id": "200410110",
                            "text": "我，我知道了…"
                        },
                        {
                            "id": "200410111",
                            "text": "我来和杜兰先生开会。",
                            "response": [
                                {
                                    "id": "200410112",
                                    "speaker": "好奇的帕琪",
                                    "text": "谢谢你的好意，但是相信我…"
                                },
                                {
                                    "id": "200410113",
                                    "speaker": "好奇的帕琪",
                                    "text": "比起开会，你会更愿意对付魔物的。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2004102",
            "objective": "清剿魔物营地",
            "dialogues": [
                {
                    "id": "200410201",
                    "speaker": "好奇的帕琪",
                    "text": "你把那片怪物营地清理掉了吗？"
                },
                {
                    "id": "200410202",
                    "speaker": "Player",
                    "text": "还没有…"
                },
                {
                    "id": "200410203",
                    "speaker": "好奇的帕琪",
                    "text": "请您快点吧，再这么下去，杜兰先生又要找到新线索了…"
                }
            ]
        },
        {
            "id": "2004103",
            "objective": "与帕琪对话",
            "dialogues": [
                {
                    "id": "200410301",
                    "speaker": "好奇的帕琪",
                    "text": "你把那片怪物营地清理掉了吗？"
                },
                {
                    "id": "200410302",
                    "speaker": "Player",
                    "text": "清理掉了。"
                },
                {
                    "id": "200410303",
                    "speaker": "好奇的帕琪",
                    "text": "太好了，我现在就去找他商量进入神殿的方法。"
                },
                {
                    "id": "200410304",
                    "speaker": "好奇的帕琪",
                    "text": "这次他不能用其他的借口拉着我开会了！"
                }
            ]
        }
    ]
}