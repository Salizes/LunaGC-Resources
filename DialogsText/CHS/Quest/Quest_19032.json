        {
            "id": "1903205",
            "objective": "与芊芊交谈",
            "dialogues": [
                {
                    "id": "1903203101",
                    "speaker": "芊芊",
                    "text": "唔…唔唔…"
                },
                {
                    "id": "1903203102",
                    "speaker": "芊芊",
                    "text": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，芊芊有件事，需要你帮忙。",
                    "choices": [
                        {
                            "id": "1903203103",
                            "text": "找我帮忙？",
                            "response": [
                                {
                                    "id": "1903203105",
                                    "speaker": "芊芊",
                                    "text": "那个蓝色头发的方士，很可怕！"
                                },
                                {
                                    "id": "1903203106",
                                    "speaker": "芊芊",
                                    "text": "芊芊害怕，能不能把他带走？",
                                    "choices": [
                                        {
                                            "id": "1903203107",
                                            "text": "你也会受到纯阳之体的影响？",
                                            "response": [
                                                {
                                                    "id": "1903203109",
                                                    "speaker": "芊芊",
                                                    "text": "芊芊根本不敢靠近他，他的体内放出的那种力量，太可怕了，会让我消失的！"
                                                },
                                                {
                                                    "id": "1903203110",
                                                    "speaker": "芊芊",
                                                    "text": "芊芊还不想消失，所以，求求你了…",
                                                    "choices": [
                                                        {
                                                            "id": "1903203111",
                                                            "text": "不知道你在他眼里算不算妖邪。",
                                                            "response": [
                                                                {
                                                                    "id": "1903203113",
                                                                    "speaker": "芊芊",
                                                                    "text": "那这样吧，芊芊有个主意。"
                                                                },
                                                                {
                                                                    "id": "1903203114",
                                                                    "speaker": "芊芊",
                                                                    "text": "我刚刚在远处，看到蓝色头发的方士正在和人争吵。"
                                                                },
                                                                {
                                                                    "id": "1903203115",
                                                                    "speaker": "芊芊",
                                                                    "text": "芊芊能把找麻烦的人都吓跑，但你要让他放过芊芊，可以吗？",
                                                                    "choices": [
                                                                        {
                                                                            "id": "1903203116",
                                                                            "text": "你说的是真的吗？",
                                                                            "response": [
                                                                                {
                                                                                    "id": "1903203117",
                                                                                    "speaker": "芊芊",
                                                                                    "text": "千真万确，芊芊说的都是实话。"
                                                                                },
                                                                                {
                                                                                    "id": "1903203120",
                                                                                    "speaker": "芊芊",
                                                                                    "text": "怎么样，可以吗？"
                                                                                },
                                                                                {
                                                                                    "id": "1903203121",
                                                                                    "speaker": "Player",
                                                                                    "text": "我不能替他做主，只能说明情况。"
                                                                                },
                                                                                {
                                                                                    "id": "1903203122",
                                                                                    "speaker": "芊芊",
                                                                                    "text": "好吧，芊芊就当你答应了。"
                                                                                },
                                                                                {
                                                                                    "id": "1903203123",
                                                                                    "speaker": "芊芊",
                                                                                    "text": "希望那个蓝色头发的方士，是个好人。"
                                                                                },
                                                                                {
                                                                                    "id": "1903203124",
                                                                                    "speaker": "芊芊",
                                                                                    "text": "芊芊去帮他，你也要去帮他，然后…你再帮帮芊芊。"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "1903203118",
                                                                            "text": "我也能帮他摆脱麻烦。",
                                                                            "response": [
                                                                                {
                                                                                    "id": "1903203119",
                                                                                    "speaker": "芊芊",
                                                                                    "text": "唔，但是会很麻烦，芊芊已经有好办法了，你要相信芊芊。"
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "1903203112",
                                                            "text": "我不能替他做主啊。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "1903203108",
                                            "text": "怪不得今天没有看见你。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "1903203104",
                            "text": "为什么是我？"
                        }
                    ]
                }
            ]
