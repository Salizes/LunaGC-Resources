            "id": "60501",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "6051101",
                    "speaker": "砂糖",
                    "text": "#阿贝多先生！{NICKNAME}！"
                },
                {
                    "id": "6051102",
                    "speaker": "阿贝多",
                    "text": "情况应该还好吧。"
                },
                {
                    "id": "6051103",
                    "speaker": "砂糖",
                    "text": "嗯！刚才有一些怪物冲进了城内，不过我跟迪卢克老爷和凯亚先生一起击退了他们。"
                },
                {
                    "id": "6051104",
                    "speaker": "砂糖",
                    "text": "趁现在有空，我打算做些药剂分发给附近的战士，应该能够帮上些忙！"
                },
                {
                    "id": "6051105",
                    "speaker": "阿贝多",
                    "text": "稳妥的判断，辛苦你了。"
                },
                {
                    "id": "6051106",
                    "speaker": "阿贝多",
                    "text": "注意安全。虽然我不觉得会有这种情况，但如果出现你无法应对的情况，立刻撤离到安全地区。不用担心阵线问题。"
                },
                {
                    "id": "6051107",
                    "speaker": "砂糖",
                    "text": "是，我明白了！"
                }
            ]
        },
        {
            "id": "60502",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "6050201",
                    "speaker": "凯亚",
                    "text": "两位辛苦了，防御得非常完美。"
                },
                {
                    "id": "6050202",
                    "speaker": "迪卢克",
                    "text": "接下来这里交给我们就行。"
                },
                {
                    "id": "6050203",
                    "speaker": "劳伦斯",
                    "text": "凯亚队长，斯万他…"
                },
                {
                    "id": "6050204",
                    "speaker": "斯万",
                    "text": "喂！我没事。倒是你的小腿…"
                },
                {
                    "id": "6050205",
                    "speaker": "凯亚",
                    "text": "斯万，劳伦斯，都到西风教会接受治疗吧，别勉强。我们会接手这一带。"
                },
                {
                    "id": "6050206",
                    "speaker": "斯万",
                    "text": "可是，迪卢克老爷也…您不是早就已经离开骑士团了吗？"
                },
                {
                    "id": "6050207",
                    "speaker": "迪卢克",
                    "text": "是啊，但也不是只有骑士团的人才能看守这扇大门。"
                },
                {
                    "id": "6050208",
                    "speaker": "凯亚",
                    "text": "老爷一向很热心，哎，你就别管了。市民愿意做些什么，那就让他做呗，也没什么不好，不是吗？"
                },
                {
                    "id": "6050209",
                    "speaker": "斯万",
                    "text": "…我明白了。非常抱歉，我衷心感谢您能支援我们！"
                },
                {
                    "id": "6050210",
                    "speaker": "劳伦斯",
                    "text": "我们会尽快回来，多谢二位！"
                },
                {
                    "id": "6050211",
                    "speaker": "Black Screen",
                    "text": "(test)时间回到现在..."
                }
            ]
        },
