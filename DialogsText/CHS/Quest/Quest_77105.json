    "talks": [
        {
            "id": "7710504",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7710507",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7710501",
            "objective": "前往标记的地点",
            "dialogues": [
                {
                    "id": "771050101",
                    "speaker": "「灰眸」",
                    "text": "原来如此，碎片就在园中，更准确地说，在园中那棵大树上。"
                },
                {
                    "id": "771050122",
                    "speaker": "派蒙",
                    "text": "好，我们这就去看看…"
                },
                {
                    "id": "771050102",
                    "speaker": "派蒙",
                    "text": "你好，我们想进去逛逛，可以吗？"
                },
                {
                    "id": "771050103",
                    "speaker": "拉冬",
                    "text": "……"
                },
                {
                    "id": "771050104",
                    "speaker": "派蒙",
                    "text": "呃，我们是从很远的地方来的，还从没见过这么气派的花园呢…"
                },
                {
                    "id": "771050105",
                    "speaker": "拉冬",
                    "text": "原来是远道而来的客人，感谢你的夸赞。拉莉莎还在时，也常亲自来打理照顾，将花草树木都养护得很好。"
                },
                {
                    "id": "771050106",
                    "speaker": "拉冬",
                    "text": "那时大树还会结出丰硕的果实，但自她永远地离开我们，不管我多么精心照料，那棵树都再也没结过果…"
                },
                {
                    "id": "771050107",
                    "speaker": "拉冬",
                    "text": "不过除了那不结果的树，这园子毕竟还是有很多值得一看的，不是么。"
                },
                {
                    "id": "771050108",
                    "speaker": "派蒙",
                    "text": "那，我们能走进去，呃，更近距离地欣赏一下吗？"
                },
                {
                    "id": "771050109",
                    "speaker": "拉冬",
                    "text": "哈哈，不行。"
                },
                {
                    "id": "771050110",
                    "speaker": "拉冬",
                    "text": "规矩就是规矩，现在园子正在维护，除了帮忙的霜精，任何人都不得入内。"
                },
                {
                    "id": "771050111",
                    "speaker": "拉冬",
                    "text": "如果只是站在这里远远地欣赏，没有任何问题。正好，你说你们是从别处来的？给我讲讲其他地方的事吧。"
                },
                {
                    "id": "771050112",
                    "speaker": "派蒙",
                    "text": "你先等一下喔！"
                },
                {
                    "id": "771050113",
                    "speaker": "Black Screen",
                    "text": "被派蒙拉到一旁说话也不会被看守花园的雪精听到的地方…"
                },
                {
                    "id": "771050114",
                    "speaker": "派蒙",
                    "text": "这家伙…中途我差点以为可以就这么顺利进去了，结果竟然不行！现在该怎么办呢？"
                },
                {
                    "id": "771050115",
                    "speaker": "派蒙",
                    "text": "#{NICKNAME}，要不我们绕到旁边，偷偷翻进去！"
                },
                {
                    "id": "771050116",
                    "speaker": "派蒙",
                    "text": "啊，不过我俩要是都不见了，会不会有点不自然，他会注意到的吧。"
                },
                {
                    "id": "771050117",
                    "speaker": "Player",
                    "text": "那吸引注意的工作就交给派蒙了。"
                },
                {
                    "id": "771050118",
                    "speaker": "派蒙",
                    "text": "欸？我吗？"
                },
                {
                    "id": "771050119",
                    "speaker": "Player",
                    "text": "你知道，我向来不是个健谈的人。"
                },
                {
                    "id": "771050120",
                    "speaker": "派蒙",
                    "text": "这么说也是…好吧，那就交给我了！"
                },
                {
                    "id": "771050121",
                    "speaker": "派蒙",
                    "text": "不过你要快去快回哦，就算是提瓦特最好的向导，能讲的故事也有穷尽的时候。"
                }
            ]
        },
        {
            "id": "7710502",
            "objective": "潜入花园，回收碎片",
            "dialogues": [
                {
                    "id": "771050201",
                    "speaker": "拉冬",
                    "text": "好了，小家伙，再给我讲讲其他地方的事吧。"
                },
                {
                    "id": "771050202",
                    "speaker": "派蒙",
                    "text": "好哦…"
                },
                {
                    "id": "771050203",
                    "speaker": "派蒙",
                    "text": "#（{NICKNAME}，就跟之前说好的，我和他聊天，你从边上翻过去！）"
                }
            ]
        },
        {
            "id": "7710503",
            "objective": "与派蒙对话",
            "dialogues": [
                {
                    "id": "771050301",
                    "speaker": "拉冬",
                    "text": "…哦，居然还有这样的事，真是让我增长了不少见识。"
                },
                {
                    "id": "771050302",
                    "speaker": "派蒙",
                    "text": "是呀是呀…啊，我的伙伴来找我了。我、我们还有其他事，就先不打扰了。"
                },
                {
                    "id": "771050303",
                    "speaker": "拉冬",
                    "text": "哪里，和你聊天非常开心，如果还有机会的话，请务必赏光！"
                },
                {
                    "id": "771050304",
                    "speaker": "派蒙",
                    "text": "啊哈哈，如果有机会的话…"
                },
                {
                    "id": "771050305",
                    "speaker": "Player",
                    "text": "看你们聊得投机，我是不是打扰了？"
                },
                {
                    "id": "771050306",
                    "speaker": "派蒙",
                    "text": "#{NICKNAME}，你可算回来了！我头一次觉得说话是一件这么累人的事…"
                },
                {
                    "id": "771050307",
                    "speaker": "派蒙",
                    "text": "之后一段时间我都要少说一点，嗯，就这么定了。"
                }
            ]
        },
        {
            "id": "7710505",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7710506",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7710599",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "771059901",
                    "speaker": "Player",
                    "text": "(派蒙在和守卫说话.….吸引了他的注意力,看看有没有别的路能够进这个花园..)"
                },
                {
                    "id": "771059903",
                    "speaker": "派蒙",
                    "text": "哇，这里居然有花有草的！这还是在雪山上吗？"
                },
                {
                    "id": "771059904",
                    "speaker": "「灰眸」",
                    "text": "感觉…越来越近了，我能感应到力量的碎片就在这里。"
                }
            ]
        }
    ]
}