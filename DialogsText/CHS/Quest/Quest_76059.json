        {
            "id": "7605901",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "760590101",
                    "speaker": "执着于食物的幽影",
                    "text": "啊，就是这个味道！"
                },
                {
                    "id": "760590102",
                    "speaker": "执着于食物的幽影",
                    "text": "我十几岁的时候开始学做菜，奶奶做给我吃的烟熏鱼排就是这个味道。"
                },
                {
                    "id": "760590103",
                    "speaker": "执着于食物的幽影",
                    "text": "也只有老一辈人才会做这种味道的烟熏鱼了，真怀念啊。"
                },
                {
                    "id": "760590104",
                    "speaker": "执着于食物的幽影",
                    "text": "奶奶会叫着我的名字，喊我去吃饭：「雅科皮，来吃鱼，奶奶刚做的。」"
                },
                {
                    "id": "760590105",
                    "speaker": "执着于食物的幽影",
                    "text": "好久没见到奶奶了…下个月休假的时候去看她吧…下个月…已经多久了…"
                }
            ]
        },
