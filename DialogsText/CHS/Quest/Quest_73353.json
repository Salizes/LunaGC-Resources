    "talks": [
        {
            "id": "7335301",
            "objective": "与陀罗诘利对话",
            "dialogues": [
                {
                    "id": "733530101",
                    "speaker": "陀罗诘利",
                    "text": "#打扰一下，请问是{NICKNAME}吗？",
                    "choices": [
                        {
                            "id": "733530102",
                            "text": "是我。",
                            "response": [
                                {
                                    "id": "733530104",
                                    "speaker": "陀罗诘利",
                                    "text": "你好你好，幸好没有认错人。"
                                },
                                {
                                    "id": "733530105",
                                    "speaker": "陀罗诘利",
                                    "text": "自我介绍一下，我是生论派的陀裟多，名字是陀罗诘利。"
                                },
                                {
                                    "id": "733530106",
                                    "speaker": "陀罗诘利",
                                    "text": "之前虽然听说过您的事情，但我们其实并不了解您本人。"
                                },
                                {
                                    "id": "733530107",
                                    "speaker": "陀罗诘利",
                                    "text": "正好我们最近在做与梦境相关的研究，草神大人便告诉我们您在辨别梦与现实方面，比她见过的所有人都要冷静。"
                                },
                                {
                                    "id": "733530108",
                                    "speaker": "Player",
                                    "text": "过奖过奖…"
                                },
                                {
                                    "id": "733530109",
                                    "speaker": "陀罗诘利",
                                    "text": "您太谦虚了，我们项目处理的就是梦与现实的问题，数据告诉我，入眠后能主动醒来是件很难的事。"
                                },
                                {
                                    "id": "733530110",
                                    "speaker": "陀罗诘利",
                                    "text": "我们的研究是利用梦境对人的心理影响，调节人们的各种心理障碍。"
                                },
                                {
                                    "id": "733530111",
                                    "speaker": "陀罗诘利",
                                    "text": "具体来说，我们会根据每个病人的情况，通过针对性的环境暗示与引导，塑造一个合适的梦境。"
                                },
                                {
                                    "id": "733530112",
                                    "speaker": "陀罗诘利",
                                    "text": "进入共同梦境的这部分技术还不成熟，中间依靠草神大人做了许多改进，简单来说我们的目标是在梦境中调整病人的认知，以改善心理问题。"
                                },
                                {
                                    "id": "733530113",
                                    "speaker": "Player",
                                    "text": "听起来好复杂。"
                                },
                                {
                                    "id": "733530114",
                                    "speaker": "陀罗诘利",
                                    "text": "啊，不好意思，说到自己项目的事就变得话多了起来，是有些复杂。"
                                },
                                {
                                    "id": "733530115",
                                    "speaker": "陀罗诘利",
                                    "text": "说白了，我们在做梦境影响心理的医学研究，比较糟的是，现在卡在了实践这一步…",
                                    "choices": [
                                        {
                                            "id": "733530116",
                                            "text": "你们要我帮忙？",
                                            "response": [
                                                {
                                                    "id": "733530118",
                                                    "speaker": "陀罗诘利",
                                                    "text": "被您一下子猜到了，真是不好意思。"
                                                },
                                                {
                                                    "id": "733530119",
                                                    "speaker": "陀罗诘利",
                                                    "text": "我们项目组的成员都没办法在梦境中保持清醒的认知，本来沮丧得不行，知道有您这样的人存在才燃起了希望。"
                                                },
                                                {
                                                    "id": "733530120",
                                                    "speaker": "陀罗诘利",
                                                    "text": "还得感谢草神大人，要不是她听完我们的汇报之后建议我们找您商量，这个项目大概就得搁浅了。"
                                                },
                                                {
                                                    "id": "733530121",
                                                    "speaker": "陀罗诘利",
                                                    "text": "我有信心，如果能把这套心理疗法推广开的话…教令院的年度心理疾病统计数能降不少。"
                                                },
                                                {
                                                    "id": "733530122",
                                                    "speaker": "陀罗诘利",
                                                    "text": "所以您刚才的意思是愿意帮忙吗？"
                                                },
                                                {
                                                    "id": "733530123",
                                                    "speaker": "Player",
                                                    "text": "没问题。"
                                                },
                                                {
                                                    "id": "733530124",
                                                    "speaker": "陀罗诘利",
                                                    "text": "太好了！我马上就整理安排病人的资料，您方便的时候可以来找我。"
                                                },
                                                {
                                                    "id": "733530125",
                                                    "speaker": "陀罗诘利",
                                                    "text": "实验流程是这样的，您只需要放松，和病人一起进入梦境就完成了一半。"
                                                },
                                                {
                                                    "id": "733530126",
                                                    "speaker": "陀罗诘利",
                                                    "text": "接下来只需要根据资料中的指示，找到梦中与病人有关的扭曲异常之处，纠正它们，再离开梦境就可以了。"
                                                },
                                                {
                                                    "id": "733530127",
                                                    "speaker": "陀罗诘利",
                                                    "text": "放心，我们准备了脱离梦境的应急措施，比起实验成功，志愿者和病人的安全更重要。"
                                                },
                                                {
                                                    "id": "733530128",
                                                    "speaker": "陀罗诘利",
                                                    "text": "每一位病人的情况各有不同，需要酌情应对。只要您有空，请随时来找我。"
                                                },
                                                {
                                                    "id": "733530129",
                                                    "speaker": "Player",
                                                    "text": "明白了。"
                                                },
                                                {
                                                    "id": "733530130",
                                                    "speaker": "陀罗诘利",
                                                    "text": "感谢您的慷慨，我们稍后见！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "733530117",
                                            "text": "帮忙的报酬怎么算？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "733530103",
                            "text": "有什么事吗？"
                        }
                    ]
                }
            ]
        }
    ]
}