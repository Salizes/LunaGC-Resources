            "dialogues": []
        },
        {
            "id": "7304202",
            "objective": "扮演「长鬓虎」，抓到所有「兰那罗」",
            "dialogues": [
                {
                    "id": "730420201",
                    "speaker": "兰犍多",
                    "text": "怎么样？那菈愿意现在和兰犍多玩游戏吗？"
                }
            ]
        },
        {
            "id": "7304203",
            "objective": "与兰犍多对话",
            "dialogues": [
                {
                    "id": "730420501",
                    "speaker": "兰犍多",
                    "text": "那菈没有「赢」…不过没关系，兰犍多愿意再和那菈玩！"
                }
            ]
        },
        {
            "id": "7304204",
            "objective": "与兰犍多对话",
            "dialogues": [
                {
                    "id": "730420601",
                    "speaker": "兰犍多",
                    "text": "玩得真开心！和金色的那菈玩游戏，兰犍多太高兴了！而且，那菈好快、好厉害，就和真正的长鬓虎一样！"
                },
                {
                    "id": "730420602",
                    "speaker": "兰犍多",
                    "text": "和其他兰那罗、真正的长鬓虎一起玩也开心，但是和新朋友，那菈朋友一起玩，有更多开心！"
                },
                {
                    "id": "730420603",
                    "speaker": "Player",
                    "text": "为什么长鬓虎要追兰那罗？"
                },
                {
                    "id": "730420604",
                    "speaker": "兰犍多",
                    "text": "长鬓虎和兰那罗都是朋友，朋友就会一起玩。不过，兰犍多发现，那菈会害怕长鬓虎。所以，为了无忧节，想了新的游戏！"
                },
                {
                    "id": "730420605",
                    "speaker": "兰犍多",
                    "text": "谢谢你，那菈。兰那罗的花花，送给金色的那菈！"
                }
            ]
        },
        {
            "id": "7304201",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "730420101",
                    "speaker": "兰犍多",
                    "text": "金色的那菈，兰犍多听说了好多好多你的事情。你是个好那菈，愿意和兰犍多玩游戏吗？"
                },
                {
                    "id": "730420102",
                    "speaker": "兰犍多",
                    "text": "兰犍多的游戏简单，好玩！给那菈讲讲「规则」…"
                },
                {
                    "id": "730420103",
                    "speaker": "兰犍多",
                    "text": "兰犍多会变出好多好多的草微粒，是「兰那罗」，藏在圈里。那菈是又大又厉害的「长鬓虎」，来追「兰那罗」！"
                },
                {
                    "id": "730420104",
                    "speaker": "兰犍多",
                    "text": "在「一小会儿」里，如果「长鬓虎」追上所有「兰那罗」，就算那菈「赢」！"
                },
                {
                    "id": "730420105",
                    "speaker": "兰犍多",
                    "text": "怎么样？那菈愿意现在和兰犍多玩游戏吗？"
                }
            ]
        },
        {
            "id": "7304204",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "730420401",
                    "speaker": "Player",
                    "text": "待会儿再说吧。"
                },
                {
                    "id": "730420402",
                    "speaker": "兰犍多",
                    "text": "好吧，兰犍多等你！"
                }
            ]
        }
    ]
}