            "dialogues": []
        },
        {
            "id": "1504006",
            "objective": "与众人对话",
            "dialogues": [
                {
                    "id": "150400601",
                    "speaker": "班尼特",
                    "text": "哈…满足了满足了！谢谢你，我的好对手，我和阿夏玩得都很尽兴！",
                    "choices": [
                        {
                            "id": "150400602",
                            "text": "旗鼓相当的对手。",
                            "response": [
                                {
                                    "id": "150400606",
                                    "speaker": "玛拉妮",
                                    "text": "辛苦你们啦！"
                                },
                                {
                                    "id": "150400607",
                                    "speaker": "提可菈",
                                    "text": "#恭喜{NICKNAME}取得了最终胜利，也要感谢救星先生和阿夏展现出的精彩配合。"
                                },
                                {
                                    "id": "150400608",
                                    "speaker": "阿夏",
                                    "text": "♪"
                                },
                                {
                                    "id": "150400609",
                                    "speaker": "提可菈",
                                    "text": "先前听到你解读阿夏语句的时候，我还不太相信呢。但经过这一场比赛，不得不说，我是开眼界了…"
                                },
                                {
                                    "id": "150400610",
                                    "speaker": "玛拉妮",
                                    "text": "我也是我也是，我为两边都捏了一把汗，感觉就像在旁观「归火圣夜巡礼」的决赛一样。"
                                },
                                {
                                    "id": "150400611",
                                    "speaker": "恰斯卡",
                                    "text": "能理解。「争斗」到了白热化的阶段，我都手痒得想飞上来，再丢几发子弹。"
                                },
                                {
                                    "id": "150400612",
                                    "speaker": "玛拉妮",
                                    "text": "你的子弹还能染色？"
                                },
                                {
                                    "id": "150400613",
                                    "speaker": "恰斯卡",
                                    "text": "能，但具体染上什么颜色我就不好说了。恐怕会变成「咚咚坠落阿夏」。"
                                },
                                {
                                    "id": "150400614",
                                    "speaker": "派蒙",
                                    "text": "呃——"
                                },
                                {
                                    "id": "150400615",
                                    "speaker": "提可菈",
                                    "text": "哈哈，现在，距离「飘飘巡风阿夏」的完成只差最后一步了。"
                                },
                                {
                                    "id": "150400616",
                                    "speaker": "提可菈",
                                    "text": "#请{M#两位救星先生}{F#救星小姐和救星先生}点亮「飘飘巡风阿夏」的笔刷吧！"
                                },
                                {
                                    "id": "150400617",
                                    "speaker": "Black Screen",
                                    "text": "（播放涂鸦灵地标的timeline）"
                                },
                                {
                                    "id": "150400618",
                                    "speaker": "提可菈",
                                    "text": "很棒吧？我给大家推荐一个观景点，用来拍合照特别好！"
                                }
                            ]
                        },
                        {
                            "id": "150400603",
                            "text": "精彩的连携技。"
                        },
                        {
                            "id": "150400604",
                            "text": "我应该喊派蒙帮忙。",
                            "response": [
                                {
                                    "id": "150400605",
                                    "speaker": "派蒙",
                                    "text": "这种时候才想起我已经晚了！彻底晚了啦！"
                                }
                            ]
                        }
                    ]
                }
            ]
