    "talks": [
        {
            "id": "7114901",
            "objective": "与萍溪对话",
            "dialogues": [
                {
                    "id": "711490101",
                    "speaker": "萍溪",
                    "text": "今年的安排应该没问题，呼…总算不用麻烦刻晴大人再来亲自核算了…"
                },
                {
                    "id": "711490116",
                    "speaker": "萍溪",
                    "text": "呃！不能想着这些，我是招财神我是招财神我是招财神…"
                },
                {
                    "id": "711490103",
                    "speaker": "Player",
                    "text": "请问您是…"
                },
                {
                    "id": "711490117",
                    "speaker": "萍溪",
                    "text": "我是招财神！",
                    "choices": [
                        {
                            "id": "711490118",
                            "text": "看、看得出来…",
                            "response": [
                                {
                                    "id": "711490120",
                                    "speaker": "萍溪",
                                    "text": "#欸？这不是{NICKNAME}吗？嗨，早知道是你过来，我就不用背那么多词了…"
                                },
                                {
                                    "id": "711490121",
                                    "speaker": "萍溪",
                                    "text": "看你的样子，也是来璃月过海灯节的，对吧？"
                                },
                                {
                                    "id": "711490122",
                                    "speaker": "萍溪",
                                    "text": "今年你算是来着了，瞧瞧周围的氛围，是不是比去年的海灯节更热闹了？",
                                    "choices": [
                                        {
                                            "id": "711490123",
                                            "text": "感觉每一年的海灯节…",
                                            "response": [
                                                {
                                                    "id": "711490125",
                                                    "speaker": "萍溪",
                                                    "text": "那是当然，俗话说「霄灯飞起节节高」，无论做什么事都要求一个进步嘛。"
                                                },
                                                {
                                                    "id": "711490126",
                                                    "speaker": "萍溪",
                                                    "text": "哎呀，大过节的不说这些，来来来，我给你指指哪里有好玩的。"
                                                },
                                                {
                                                    "id": "711490127",
                                                    "speaker": "萍溪",
                                                    "text": "我看看喔…嗯…有了！来海灯节，当然要先放霄灯了。"
                                                },
                                                {
                                                    "id": "711490128",
                                                    "speaker": "萍溪",
                                                    "text": "然后呢，我们今年还在璃月港的各处放了许多「吉事宝树」，只要为它好好修剪枝干，里面的「吉语钱」就归你啦。"
                                                },
                                                {
                                                    "id": "711490129",
                                                    "speaker": "萍溪",
                                                    "text": "我们一共放了多少个来着？好像是…21，对，就是21个。"
                                                },
                                                {
                                                    "id": "711490130",
                                                    "speaker": "萍溪",
                                                    "text": "而且…其实在这附近，就有一棵「吉事宝树」喔，要是有兴趣的话，你就直接去修剪一下吧，很简单的。"
                                                },
                                                {
                                                    "id": "711490131",
                                                    "speaker": "萍溪",
                                                    "text": "最后…嗯，要是你有兴趣的话，也可以去旁边的「告事板」那边看看，喏，就在我旁边。"
                                                },
                                                {
                                                    "id": "711490132",
                                                    "speaker": "萍溪",
                                                    "text": "最近几年的海灯节有许多外国游客参加，我们总务司也专门为他们设置了「告事板」。"
                                                },
                                                {
                                                    "id": "711490102",
                                                    "speaker": "萍溪",
                                                    "text": "无论他们有什么问题，或者是遇见了需要解决的麻烦，都可以写下来挂在「告事板」上。"
                                                },
                                                {
                                                    "id": "711490133",
                                                    "speaker": "萍溪",
                                                    "text": "哼哼，我们总务司，绝对会让所有来璃月过海灯节的人，都满意而归！",
                                                    "choices": [
                                                        {
                                                            "id": "711490134",
                                                            "text": "不愧是总务司。",
                                                            "response": [
                                                                {
                                                                    "id": "711490136",
                                                                    "speaker": "萍溪",
                                                                    "text": "那是当然！"
                                                                },
                                                                {
                                                                    "id": "711490137",
                                                                    "speaker": "萍溪",
                                                                    "text": "#对了，{NICKNAME}，我记得你很擅长留影，对吧？",
                                                                    "choices": [
                                                                        {
                                                                            "id": "711490138",
                                                                            "text": "略懂而已。",
                                                                            "response": [
                                                                                {
                                                                                    "id": "711490140",
                                                                                    "speaker": "萍溪",
                                                                                    "text": "哈哈哈，别这么谦虚嘛。我就是…想拜托你帮一个小小的忙。"
                                                                                },
                                                                                {
                                                                                    "id": "711490141",
                                                                                    "speaker": "萍溪",
                                                                                    "text": "很简单的，我保证！你只需要帮几位游客拍一张「纪念留影」就好。"
                                                                                },
                                                                                {
                                                                                    "id": "711490142",
                                                                                    "speaker": "萍溪",
                                                                                    "text": "本来我们雇了几位留影师，专门为大家拍「纪念留影」，但没想到，今年来了这么多游客，留影师一下子就不够用了。"
                                                                                },
                                                                                {
                                                                                    "id": "711490143",
                                                                                    "speaker": "萍溪",
                                                                                    "text": "#临时雇新的留影师已经来不及了，所以，我就只能拜托你了，{NICKNAME}！"
                                                                                },
                                                                                {
                                                                                    "id": "711490144",
                                                                                    "speaker": "萍溪",
                                                                                    "text": "拜托！为了各位游客，为了海灯节，为了璃月！只有你能帮我们这个忙了！",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "711490145",
                                                                                            "text": "包在我身上！",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "711490147",
                                                                                                    "speaker": "萍溪",
                                                                                                    "text": "#哦！不愧是{NICKNAME}，我就把那几位游客的名字，还有预定的地点告诉你。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "711490148",
                                                                                                    "speaker": "萍溪",
                                                                                                    "text": "那就拜托你了，有你帮忙，今年的海灯节一定会完美无缺的！"
                                                                                                },
                                                                                                {
                                                                                                    "id": "711490149",
                                                                                                    "speaker": "萍溪",
                                                                                                    "text": "这几盏霄灯送给你，嘿嘿，海灯节快乐！"
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "711490146",
                                                                                            "text": "为了海灯节！"
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "711490139",
                                                                            "text": "根本不明白。"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "711490135",
                                                            "text": "不愧是璃月…"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "711490124",
                                            "text": "都比前一年更厉害…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "711490119",
                            "text": "很吉利的服装…"
                        }
                    ]
                }
            ]
        }
    ]
}