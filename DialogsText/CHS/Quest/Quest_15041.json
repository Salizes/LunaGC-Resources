    "talks": [
        {
            "id": "1504101",
            "objective": "前往刺梨岩",
            "dialogues": [
                {
                    "id": "150410101",
                    "speaker": "？？？",
                    "text": "勇敢的冒险家们，欢迎来到刺梨镇，度过一年一度的梨果之夜！"
                },
                {
                    "id": "150410102",
                    "speaker": "派蒙",
                    "text": "噢噢噢，好有说法。这就已经开始营造气氛了吗？"
                },
                {
                    "id": "150410103",
                    "speaker": "班尼特",
                    "text": "您好，这位…"
                },
                {
                    "id": "150410104",
                    "speaker": "「维拉庇」",
                    "text": "娜娜丝梨人。"
                },
                {
                    "id": "150410105",
                    "speaker": "班尼特",
                    "text": "这位娜娜丝梨人，请问刺梨镇怎么走？我们需要准备些什么吗？"
                },
                {
                    "id": "150410106",
                    "speaker": "「维拉庇」",
                    "text": "哈哈，一听您的问题，就知道您是位心思缜密、经验丰富的老冒险家。"
                },
                {
                    "id": "150410107",
                    "speaker": "「维拉庇」",
                    "text": "您和您的同伴只需要由此向下，就能抵达美丽的刺梨镇了。"
                },
                {
                    "id": "150410108",
                    "speaker": "「维拉庇」",
                    "text": "至于准备嘛…请带上自信的头巾，乐于助人的心灵，和一点点直面困难的勇气。"
                },
                {
                    "id": "150410109",
                    "speaker": "阿夏",
                    "text": "♪"
                },
                {
                    "id": "150410110",
                    "speaker": "「维拉庇」",
                    "text": "啊，看来您身边还有一位小小的搭档。可以让它暂时待在您的包里吗？以免出现意外。"
                },
                {
                    "id": "150410111",
                    "speaker": "阿夏",
                    "text": "♪~"
                },
                {
                    "id": "150410112",
                    "speaker": "「维拉庇」",
                    "text": "好的，那就没问题了。冒险即将开幕，无畏的挑战者们，预祝你们在此度过愉快的一夜！"
                }
            ]
        },
        {
            "id": "1504112",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": []
        },
        {
            "id": "1504102",
            "objective": "进入山洞",
            "dialogues": [
                {
                    "id": "150410201",
                    "speaker": "派蒙",
                    "text": "哇噢，没想到山洞里面这么大啊，这个小镇看起来还挺精致的。"
                },
                {
                    "id": "150410202",
                    "speaker": "班尼特",
                    "text": "那是…悬赏板？"
                },
                {
                    "id": "150410203",
                    "speaker": "派蒙",
                    "text": "我看看…个十百千万…"
                },
                {
                    "id": "150410204",
                    "speaker": "恰斯卡",
                    "text": "……"
                },
                {
                    "id": "150410205",
                    "speaker": "派蒙",
                    "text": "十万、百万…五百万摩拉！呜啊——什么东西过来了！"
                },
                {
                    "id": "150410206",
                    "speaker": "绵驮兽警长",
                    "text": "尊贵的客人们，欢迎来到我美丽的家乡，刺梨镇。"
                },
                {
                    "id": "150410207",
                    "speaker": "派蒙",
                    "text": "…吓死我了。"
                },
                {
                    "id": "150410208",
                    "speaker": "绵驮兽警长",
                    "text": "你们是为梨果之夜来的吧？唉，可惜今年这节恐怕是过不了了。"
                },
                {
                    "id": "150410209",
                    "speaker": "玛拉妮",
                    "text": "嗯？发生什么事了？"
                },
                {
                    "id": "150410210",
                    "speaker": "绵驮兽警长",
                    "text": "不久之前，诺奇特梨恶霸席卷村庄，抢走了我们的金银财宝。"
                },
                {
                    "id": "150410211",
                    "speaker": "绵驮兽警长",
                    "text": "直到现在，他还盘踞在镇上不肯出来，扬言要做我们所有人的老大。"
                },
                {
                    "id": "150410212",
                    "speaker": "班尼特",
                    "text": "太坏了，这怎么能答应！"
                },
                {
                    "id": "150410213",
                    "speaker": "绵驮兽警长",
                    "text": "说来话长。几位远道而来也不容易，就请随我来酒吧里小坐一下吧。"
                }
            ]
        },
        {
            "id": "1504103",
            "objective": "乘坐游船",
            "dialogues": []
        },
        {
            "id": "1504104",
            "objective": "跟随警长前往酒吧",
            "dialogues": []
        },
        {
            "id": "1504105",
            "objective": "追击劫匪",
            "dialogues": []
        },
        {
            "id": "1504106",
            "objective": "与警长对话",
            "dialogues": [
                {
                    "id": "150410601",
                    "speaker": "班尼特",
                    "text": "警长，故事的后续呢？"
                },
                {
                    "id": "150410602",
                    "speaker": "绵驮兽警长",
                    "text": "英雄消失了，没有人知道后面发生了什么事…"
                },
                {
                    "id": "150410603",
                    "speaker": "绵驮兽警长",
                    "text": "有人说他更名改姓，也有人说他和朋友们踏上了不归的远征，去往了如骄阳般灼热的地方…"
                },
                {
                    "id": "150410604",
                    "speaker": "绵驮兽警长",
                    "text": "如果你们之中有谁见到了那位英雄，请替我转告他，我们很感激他所做的一切，也很想他。"
                },
                {
                    "id": "150410605",
                    "speaker": "恰斯卡",
                    "text": "见到的话，一定把话带到。"
                },
                {
                    "id": "150410606",
                    "speaker": "绵驮兽警长",
                    "text": "嗯，这里就是诺奇特梨老巢了。我曾偷偷跟踪过爪牙，知道启动机关的方法。我来为各位开门。"
                },
                {
                    "id": "150410607",
                    "speaker": "绵驮兽警长",
                    "text": "……"
                },
                {
                    "id": "150410608",
                    "speaker": "绵驮兽警长",
                    "text": "但这里眼目众多，单独行动容易成为敌人的目标，还请几位替我做些掩护。"
                },
                {
                    "id": "150410609",
                    "speaker": "恰斯卡",
                    "text": "怎么掩护？"
                },
                {
                    "id": "150410610",
                    "speaker": "绵驮兽警长",
                    "text": "请将妨碍在我前进路上的爪牙及时击倒。"
                },
                {
                    "id": "150410611",
                    "speaker": "班尼特",
                    "text": "哈哈，真是个有魄力的请求。"
                },
                {
                    "id": "150410612",
                    "speaker": "恰斯卡",
                    "text": "包在我身上。"
                },
                {
                    "id": "150410613",
                    "speaker": "玛拉妮",
                    "text": "我就知道那话说到恰斯卡心坎上去了…"
                },
                {
                    "id": "150410614",
                    "speaker": "恰斯卡",
                    "text": "#{NICKNAME}，那边的枪交给你了。"
                },
                {
                    "id": "150410615",
                    "speaker": "Player",
                    "text": "收到，我来解决。"
                },
                {
                    "id": "150410616",
                    "speaker": "派蒙",
                    "text": "唉，我们需要潜行的时候怎么就没人这么帮我们…"
                }
            ]
        },
        {
            "id": "1504107",
            "objective": "协助警长启动机关",
            "dialogues": [
                {
                    "id": "150410701",
                    "speaker": "恰斯卡",
                    "text": "是你赢了。你的枪法挺有两下子，在其他地方练过？"
                },
                {
                    "id": "150410702",
                    "speaker": "恰斯卡",
                    "text": "我教你点连发子弹的技巧吧，说不定今后也用得上。"
                },
                {
                    "id": "150410703",
                    "speaker": "班尼特",
                    "text": "不好了！"
                },
                {
                    "id": "150410704",
                    "speaker": "派蒙",
                    "text": "怎么了怎么了？"
                },
                {
                    "id": "150410705",
                    "speaker": "班尼特",
                    "text": "一说话的工夫，绵驮兽警长…被抓走了…"
                },
                {
                    "id": "150410706",
                    "speaker": "恰斯卡",
                    "text": "我们追。"
                }
            ]
        },
        {
            "id": "1504108",
            "objective": "与恰斯卡对话",
            "dialogues": [
                {
                    "id": "150410801",
                    "speaker": "恰斯卡",
                    "text": "可惜了。我看你拿起枪来有模有样的，或许还是使用的机会少了。"
                },
                {
                    "id": "150410802",
                    "speaker": "恰斯卡",
                    "text": "我教你点连发子弹的技巧吧，说不定今后也用得上。"
                },
                {
                    "id": "150410803",
                    "speaker": "班尼特",
                    "text": "不好了！"
                },
                {
                    "id": "150410804",
                    "speaker": "派蒙",
                    "text": "怎么了怎么了？"
                },
                {
                    "id": "150410805",
                    "speaker": "班尼特",
                    "text": "一说话的工夫，绵驮兽警长…被抓走了…"
                },
                {
                    "id": "150410806",
                    "speaker": "恰斯卡",
                    "text": "我们追。"
                }
            ]
        },
        {
            "id": "1504109",
            "objective": "乘坐游船继续追击",
            "dialogues": []
        },
        {
            "id": "1504110",
            "objective": "与诺奇特梨恶霸对峙",
            "dialogues": [
                {
                    "id": "150411001",
                    "speaker": "诺奇特梨恶霸",
                    "text": "吼？这就是那几个爱管闲事的异乡人？"
                },
                {
                    "id": "150411002",
                    "speaker": "诺奇特梨爪牙",
                    "text": "老大！小心啊，他们有枪！"
                },
                {
                    "id": "150411003",
                    "speaker": "诺奇特梨恶霸",
                    "text": "有杆枪就让你们怕成这个样子，丢不丢人。"
                },
                {
                    "id": "150411004",
                    "speaker": "诺奇特梨恶霸",
                    "text": "来啊，爱出风头的家伙们，看看我们谁的子弹更快。"
                },
                {
                    "id": "150411005",
                    "speaker": "班尼特",
                    "text": "那边好大的烟，情况怎么样了？"
                },
                {
                    "id": "150411006",
                    "speaker": "恰斯卡",
                    "text": "它跑了。"
                },
                {
                    "id": "150411007",
                    "speaker": "玛拉妮",
                    "text": "从你的枪口下跑了？"
                },
                {
                    "id": "150411008",
                    "speaker": "恰斯卡",
                    "text": "准确地说，那位老大从一开始就没有攻击的意图。甩下狠话是个制造空隙的障眼法。它想好要跑了。"
                },
                {
                    "id": "150411009",
                    "speaker": "派蒙",
                    "text": "结果自己还说那种话，丢不丢人。"
                },
                {
                    "id": "150411010",
                    "speaker": "玛拉妮",
                    "text": "不好…出口被堵住了，恐怕同样是对方的诡计。"
                },
                {
                    "id": "150411011",
                    "speaker": "派蒙",
                    "text": "那要怎么办？有什么机关吗？"
                },
                {
                    "id": "150411012",
                    "speaker": "班尼特",
                    "text": "峡谷下方有不少笼子…各位，我们先去救人。"
                }
            ]
        },
        {
            "id": "1504111",
            "objective": "寻找开启闸门的方法",
            "dialogues": []
        },
        {
            "id": "1504124",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": []
        },
        {
            "id": "1504113",
            "objective": "前往山洞",
            "dialogues": []
        },
        {
            "id": "1504114",
            "objective": "在山洞内部四处调查",
            "dialogues": []
        },
        {
            "id": "1504115",
            "objective": "与众人对话",
            "dialogues": [
                {
                    "id": "150411501",
                    "speaker": "恰斯卡",
                    "text": "……"
                },
                {
                    "id": "150411502",
                    "speaker": "恰斯卡",
                    "text": "好，魔物清除完毕，现在这里也没有其他残留的深渊气息了。"
                },
                {
                    "id": "150411503",
                    "speaker": "恰斯卡",
                    "text": "都没受伤吧？"
                },
                {
                    "id": "150411504",
                    "speaker": "班尼特",
                    "text": "手臂上擦到了一点，不过不痛的，没什么感觉。"
                },
                {
                    "id": "150411505",
                    "speaker": "Player",
                    "text": "让我看看。"
                },
                {
                    "id": "150411506",
                    "speaker": "班尼特",
                    "text": "噢，好的…真不好意思啊，让你担心了…",
                    "choices": [
                        {
                            "id": "150411507",
                            "text": "只是皮外伤。",
                            "response": [
                                {
                                    "id": "150411509",
                                    "speaker": "恰斯卡",
                                    "text": "那就好。"
                                },
                                {
                                    "id": "150411510",
                                    "speaker": "玛拉妮",
                                    "text": "但这不太寻常吧？"
                                },
                                {
                                    "id": "150411511",
                                    "speaker": "玛拉妮",
                                    "text": "我是说…丘丘游侠可能是请来的演员，但深渊魔物怎么想都不应该出现啊！"
                                },
                                {
                                    "id": "150411512",
                                    "speaker": "恰斯卡",
                                    "text": "嗯，这不可能是正常游乐体验。"
                                },
                                {
                                    "id": "150411513",
                                    "speaker": "派蒙",
                                    "text": "而且，我们进来的通路也被堵上了，魔物出现之前还是好好的…"
                                },
                                {
                                    "id": "150411514",
                                    "speaker": "班尼特",
                                    "text": "该不会是…我的厄运突然出现了…连累了大家…"
                                },
                                {
                                    "id": "150411515",
                                    "speaker": "恰斯卡",
                                    "text": "别往那方面想。"
                                },
                                {
                                    "id": "150411516",
                                    "speaker": "班尼特",
                                    "text": "……"
                                },
                                {
                                    "id": "150411517",
                                    "speaker": "恰斯卡",
                                    "text": "深渊魔物出现的原因有很多，被人或物吸引而来的确是一种可能。"
                                },
                                {
                                    "id": "150411518",
                                    "speaker": "恰斯卡",
                                    "text": "但现在，比起怀疑是自己招致了灾祸，更需要做的事是彻底排查隐患。"
                                },
                                {
                                    "id": "150411519",
                                    "speaker": "恰斯卡",
                                    "text": "我们还不知道山洞外有没有发生什么。"
                                },
                                {
                                    "id": "150411520",
                                    "speaker": "班尼特",
                                    "text": "你说得对，好，那就由我负责先行探路吧！"
                                },
                                {
                                    "id": "150411521",
                                    "speaker": "恰斯卡",
                                    "text": "哈，我可不能把这个机会让给你。"
                                },
                                {
                                    "id": "150411522",
                                    "speaker": "恰斯卡",
                                    "text": "这里应该遵守纳塔的规则，让机动性最高的「花羽会」成员负责侦察。"
                                },
                                {
                                    "id": "150411523",
                                    "speaker": "恰斯卡",
                                    "text": "各位，我先去打探外面的情况了。晚点见。"
                                },
                                {
                                    "id": "150411524",
                                    "speaker": "派蒙",
                                    "text": "但山洞不还…"
                                },
                                {
                                    "id": "150411525",
                                    "speaker": "恰斯卡",
                                    "text": "后退。"
                                },
                                {
                                    "id": "150411526",
                                    "speaker": "玛拉妮",
                                    "text": "等一下等一下啦还没准备好…"
                                },
                                {
                                    "id": "150411527",
                                    "speaker": "Black Screen",
                                    "text": "轰——"
                                },
                                {
                                    "id": "150411528",
                                    "speaker": "班尼特",
                                    "text": "哈，真的飞得好快…已经看不见人影了…"
                                },
                                {
                                    "id": "150411529",
                                    "speaker": "派蒙",
                                    "text": "#这下出去的路倒是不缺了。嗯？{NICKNAME}，你在看什么呀？"
                                },
                                {
                                    "id": "150411530",
                                    "speaker": "Black Screen",
                                    "text": "（弹出阅读物）"
                                },
                                {
                                    "id": "150411531",
                                    "speaker": "派蒙",
                                    "text": "「燧石之锋」冒险团，安洁娅，马坎尼…都是些陌生的名字啊。"
                                },
                                {
                                    "id": "150411532",
                                    "speaker": "玛拉妮",
                                    "text": "嗯…我也没听说过。",
                                    "choices": [
                                        {
                                            "id": "150411533",
                                            "text": "内容看着没什么问题…",
                                            "response": [
                                                {
                                                    "id": "150411535",
                                                    "speaker": "派蒙",
                                                    "text": "根据已有的信息，目前还是一头雾水。只能先记下来，继续向前了吧？"
                                                },
                                                {
                                                    "id": "150411536",
                                                    "speaker": "班尼特",
                                                    "text": "……"
                                                },
                                                {
                                                    "id": "150411537",
                                                    "speaker": "派蒙",
                                                    "text": "班尼特？你还好吗？"
                                                },
                                                {
                                                    "id": "150411538",
                                                    "speaker": "班尼特",
                                                    "text": "啊，嗯，我没事。游玩场地里的东西不要挪动位置比较好对吧？"
                                                },
                                                {
                                                    "id": "150411539",
                                                    "speaker": "派蒙",
                                                    "text": "是这样的。"
                                                },
                                                {
                                                    "id": "150411540",
                                                    "speaker": "班尼特",
                                                    "text": "好，那我们出发。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "150411534",
                                            "text": "没提到后来有没有发生其他事…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "150411508",
                            "text": "没有被污染。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1504116",
