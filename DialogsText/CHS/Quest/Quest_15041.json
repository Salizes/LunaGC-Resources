        },
        {
            "id": "1504118",
            "objective": "追击「乔克力老大」",
            "dialogues": []
        },
        {
            "id": "1504119",
            "objective": "击落「乔克力老大」的热气球",
            "dialogues": []
        },
        {
            "id": "1504120",
            "objective": "前往山顶热气球坠毁处",
            "dialogues": [
                {
                    "id": "150412001",
                    "speaker": "恰斯卡",
                    "text": "放开那个人。"
                },
                {
                    "id": "150412002",
                    "speaker": "「乔克力老大」",
                    "text": "要他活命的话，就乖乖向我投降。"
                },
                {
                    "id": "150412003",
                    "speaker": "派蒙",
                    "text": "好高的山坡，爬一爬头发都吹干了…恰斯卡！"
                },
                {
                    "id": "150412004",
                    "speaker": "派蒙",
                    "text": "「乔克力老大」！"
                },
                {
                    "id": "150412005",
                    "speaker": "派蒙",
                    "text": "…记不住名字的什么大梨人！"
                },
                {
                    "id": "150412006",
                    "speaker": "「维拉庇」",
                    "text": "嘘，嘘…"
                },
                {
                    "id": "150412007",
                    "speaker": "「乔克力老大」",
                    "text": "我再说一遍，这是最后一遍。要他活命的话，就乖乖向我投降。"
                },
                {
                    "id": "150412008",
                    "speaker": "「乔克力老大」",
                    "text": "只要你敢开枪，或者你们之中有谁胆敢轻举妄动，我就把他从这里丢下去。"
                },
                {
                    "id": "150412009",
                    "speaker": "「维拉庇」",
                    "text": "呃啊…求求你，不要这么做…"
                },
                {
                    "id": "150412010",
                    "speaker": "恰斯卡",
                    "text": "……"
                },
                {
                    "id": "150412011",
                    "speaker": "玛拉妮",
                    "text": "奇怪。恰斯卡…为什么还不行动？",
                    "choices": [
                        {
                            "id": "150412012",
                            "text": "会不会真有一位坏人…",
                            "response": [
                                {
                                    "id": "150412014",
                                    "speaker": "班尼特",
                                    "text": "啊！你是说…有人取代了原本的工作人员？"
                                },
                                {
                                    "id": "150412015",
                                    "speaker": "玛拉妮",
                                    "text": "考虑到不合理出现的深渊魔物…难道是想…"
                                },
                                {
                                    "id": "150412016",
                                    "speaker": "派蒙",
                                    "text": "假戏真做？！"
                                },
                                {
                                    "id": "150412017",
                                    "speaker": "「乔克力老大」",
                                    "text": "够了！我的忍耐不是没有限度的。"
                                },
                                {
                                    "id": "150412018",
                                    "speaker": "「乔克力老大」",
                                    "text": "现在就给我后退！你们全部人！离开山崖！"
                                },
                                {
                                    "id": "150412019",
                                    "speaker": "「维拉庇」",
                                    "text": "冒险家们，快逃，离开小镇，别管我了！"
                                },
                                {
                                    "id": "150412020",
                                    "speaker": "恰斯卡",
                                    "text": "——♪"
                                },
                                {
                                    "id": "150412021",
                                    "speaker": "Player",
                                    "text": "（这是…！）"
                                },
                                {
                                    "id": "150412022",
                                    "speaker": "Black Screen",
                                    "text": "（插入恰斯卡QTE的对决）"
                                },
                                {
                                    "id": "150412023",
                                    "speaker": "枪声",
                                    "text": "砰——"
                                },
                                {
                                    "id": "150412024",
                                    "speaker": "Player",
                                    "text": "已经没事了。"
                                },
                                {
                                    "id": "150412025",
                                    "speaker": "「维拉庇」",
                                    "text": "谢谢你，勇敢的冒险家！你们是拯救了刺梨镇，也拯救了我的英雄！"
                                },
                                {
                                    "id": "150412026",
                                    "speaker": "派蒙",
                                    "text": "啊…你们快看！"
                                },
                                {
                                    "id": "150412027",
                                    "speaker": "班尼特",
                                    "text": "阿夏？"
                                },
                                {
                                    "id": "150412028",
                                    "speaker": "玛拉妮",
                                    "text": "「乔克力老大」…是由阿夏们扮演的？"
                                },
                                {
                                    "id": "150412029",
                                    "speaker": "「维拉庇」",
                                    "text": "恭喜各位！做出了勇敢和正义的选择，成功击败了为非作歹的「乔克力老大」！"
                                },
                                {
                                    "id": "150412030",
                                    "speaker": "阿夏们",
                                    "text": "♪"
                                },
                                {
                                    "id": "150412031",
                                    "speaker": "派蒙",
                                    "text": "等等，我有点反应不过来。所以…不是假戏真做？搞半天是虚惊一场？"
                                },
                                {
                                    "id": "150412032",
                                    "speaker": "恰斯卡",
                                    "text": "我明白你们在担心什么，那也是我所顾虑的。"
                                },
                                {
                                    "id": "150412033",
                                    "speaker": "恰斯卡",
                                    "text": "来的路上，我没有发现其他深渊魔物，但我也没有放松警惕。"
                                },
                                {
                                    "id": "150412034",
                                    "speaker": "恰斯卡",
                                    "text": "放在平时，我的确会直接开枪。要是对方真敢对人质出手，我也有自信骑上灵枪救回人质。"
                                },
                                {
                                    "id": "150412035",
                                    "speaker": "恰斯卡",
                                    "text": "但这次的对手掺杂了深渊，不可侥幸，必须做好最坏打算。"
                                },
                                {
                                    "id": "150412036",
                                    "speaker": "恰斯卡",
                                    "text": "#所以我需要和{NICKNAME}在同一时刻出手，确保「击倒反派」和「救下人质」两个目标同时达成。"
                                },
                                {
                                    "id": "150412037",
                                    "speaker": "派蒙",
                                    "text": "还好你们在打爪牙的时候培养了默契…"
                                },
                                {
                                    "id": "150412038",
                                    "speaker": "恰斯卡",
                                    "text": "现在可以确认，唯一出现过问题的就是那处山洞。"
                                },
                                {
                                    "id": "150412039",
                                    "speaker": "玛拉妮",
                                    "text": "你确定清除完魔物后，已经不会再有危险了对吧？"
                                },
                                {
                                    "id": "150412040",
                                    "speaker": "恰斯卡",
                                    "text": "是的。"
                                },
                                {
                                    "id": "150412041",
                                    "speaker": "「维拉庇」",
                                    "text": "不好意思…我没听明白，几位口中的「山洞」，是在说这里的场所吗？"
                                },
                                {
                                    "id": "150412042",
                                    "speaker": "玛拉妮",
                                    "text": "对啊，山洞里有个冒险家营地，在绵驮兽警长倒下的那块地方附近…唉，这样形容真对不起警长…"
                                },
                                {
                                    "id": "150412043",
                                    "speaker": "「维拉庇」",
                                    "text": "真的假的？那里根本没有山洞或者营地啊…"
                                },
                                {
                                    "id": "150412044",
                                    "speaker": "「维拉庇」",
                                    "text": "你们…确定不是看错了？"
                                },
                                {
                                    "id": "150412045",
                                    "speaker": "班尼特",
                                    "text": "不会的。我们先是遭到了魔物的偷袭，后来又读到了冒险家的手记，再怎么说也不可能都是幻觉。"
                                },
                                {
                                    "id": "150412046",
                                    "speaker": "班尼特",
                                    "text": "噢，就连我手臂上的擦伤也在…竟然可以作为证据，哈哈，这就是「因祸得福」吗？"
                                },
                                {
                                    "id": "150412047",
                                    "speaker": "「维拉庇」",
                                    "text": "啊？但是，这不应该啊…"
                                },
                                {
                                    "id": "150412048",
                                    "speaker": "「维拉庇」",
                                    "text": "为了让游客身临其境地感受刺梨镇氛围，我们怎么会留和主题完全无关的穿帮设计呢？"
                                },
                                {
                                    "id": "150412049",
                                    "speaker": "派蒙",
                                    "text": "好像…也有道理…"
                                },
                                {
                                    "id": "150412050",
                                    "speaker": "派蒙",
                                    "text": "怎么办？我突然感觉背后…凉飕飕的…"
                                }
                            ]
                        },
                        {
                            "id": "150412013",
                            "text": "藏身在反派的演员服装内…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1504126",
            "objective": "（可选）继续探索「刺梨镇」$HIDDEN",
            "dialogues": []
        },
        {
            "id": "1504121",
            "objective": "返回乘坐游船",
            "dialogues": []
        },
        {
            "id": "1504122",
            "objective": "乘坐游船向前",
            "dialogues": []
        },
        {
            "id": "1504123",
            "objective": "与众人对话",
            "dialogues": [
                {
                    "id": "150412301",
                    "speaker": "玛拉妮",
                    "text": "呼，感觉放松下来一点了。"
                },
                {
                    "id": "150412302",
                    "speaker": "派蒙",
                    "text": "我觉得主要得怪我们玩到了不该玩到的东西。弄得这趟下来，心情和坐过山车一样。"
                },
                {
                    "id": "150412303",
                    "speaker": "班尼特",
                    "text": "……"
                },
                {
                    "id": "150412304",
                    "speaker": "派蒙",
                    "text": "唔，你俩还在想呢？",
                    "choices": [
                        {
                            "id": "150412305",
                            "text": "如果山洞是预料之外的存在…",
                            "response": [
                                {
                                    "id": "150412307",
                                    "speaker": "班尼特",
                                    "text": "嗯。我也认为冒险团的故事是真实的，但时间可能发生在很久以前。"
                                },
                                {
                                    "id": "150412308",
                                    "speaker": "班尼特",
                                    "text": "比如说，当这里还没有建起度假村的时候…"
                                },
                                {
                                    "id": "150412309",
                                    "speaker": "「维拉庇」",
                                    "text": "来了来了，是在等我们一起拍合照吧？"
                                },
                                {
                                    "id": "150412310",
                                    "speaker": "「乔克力老大」",
                                    "text": "♪"
                                },
                                {
                                    "id": "150412311",
                                    "speaker": "派蒙",
                                    "text": "听到这家伙的叫声我想起来了。摩拉呢？悬赏「乔克力老大」的整整五百万摩拉！"
                                },
                                {
                                    "id": "150412312",
                                    "speaker": "恰斯卡",
                                    "text": "恐怕不会真的给吧。如果每抓一次都要付摩拉的话，刺梨镇早就亏本了。"
                                },
                                {
                                    "id": "150412313",
                                    "speaker": "「维拉庇」",
                                    "text": "哈哈，正是！那并不是真摩拉，而是印有这串数字的摩拉形状纪念巧克力。"
                                },
                                {
                                    "id": "150412314",
                                    "speaker": "「维拉庇」",
                                    "text": "但因为巧克力还没做出来…我给各位发些「悠悠徽章」吧，大家可以兑换感兴趣的商品。"
                                },
                                {
                                    "id": "150412315",
                                    "speaker": "派蒙",
                                    "text": "好吧，虽然更想要摩拉巧克力，但小礼物也能接受。"
                                },
                                {
                                    "id": "150412316",
                                    "speaker": "玛拉妮",
                                    "text": "我来准备留影机。"
                                },
                                {
                                    "id": "150412317",
                                    "speaker": "玛拉妮",
                                    "text": "三、二、一——"
                                },
                                {
                                    "id": "150412318",
                                    "speaker": "派蒙",
                                    "text": "巧克力！"
                                },
                                {
                                    "id": "150412319",
                                    "speaker": "？？？",
                                    "text": "……"
                                }
                            ]
                        },
                        {
                            "id": "150412306",
                            "text": "会不会和特诺奇兹托克有关…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1504150",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "150415001",
                    "speaker": "「维拉庇」",
                    "text": "那几位客人不像开玩笑…可这哪来山洞啊…"
                },
                {
                    "id": "150415002",
                    "speaker": "阿夏",
                    "text": "？"
                }
            ]
        },
        {
            "id": "1504199",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "150419901",
                    "speaker": "绵驮兽警长",
                    "text": "唉，不知英雄什么时候才会回来…"
                },
                {
                    "id": "150419902",
                    "speaker": "班尼特",
                    "text": "警长，您说的英雄是…"
                },
                {
                    "id": "150419903",
                    "speaker": "绵驮兽警长",
                    "text": "很久以前，我们镇上生活着一位见义勇为的神枪手。"
                },
                {
                    "id": "150419904",
                    "speaker": "绵驮兽警长",
                    "text": "他心怀正义，英勇无比，曾帮上小镇许多忙…"
                },
                {
                    "id": "150419905",
                    "speaker": "派蒙",
                    "text": "啊——真是一群坏家伙，心眼和刺一样多，逃得又那么快！"
                },
                {
                    "id": "150419906",
                    "speaker": "派蒙",
                    "text": "去那个被炸开的山洞看看吧，希望能有离开这里的线索。"
                },
                {
                    "id": "150419916",
                    "speaker": "派蒙",
                    "text": "「乔克力老大」往山崖那边逃跑了，别放过它！"
                },
                {
                    "id": "150419917",
                    "speaker": "派蒙",
                    "text": "其实…我们也做了件好事！至少为小镇排查了隐患！"
                },
                {
                    "id": "150419918",
                    "speaker": "派蒙",
                    "text": "之后如果再遇到魔物…再消灭就行了！"
                },
                {
                    "id": "150419919",
                    "speaker": "派蒙",
                    "text": "其实…我们也做了件好事！至少为小镇排查了隐患！"
                },
                {
                    "id": "150419920",
                    "speaker": "派蒙",
                    "text": "之后如果再遇到魔物…再消灭就行了！"
                }
            ]
        }
    ]
}