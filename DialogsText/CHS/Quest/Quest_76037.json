    "talks": [
        {
            "id": "7603701",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "760370101",
                    "speaker": "勒塞克",
                    "text": "四个悬赏目标的信息都在板上，问我也行，但赏金多少没有商量的余地。",
                    "choices": [
                        {
                            "id": "760370107",
                            "text": "提交解决了悬赏目标的证据。"
                        },
                        {
                            "id": "760370102",
                            "text": "关于悬赏目标…",
                            "response": [
                                {
                                    "id": "760370103",
                                    "speaker": "勒塞克",
                                    "text": "目前有四个目标，但只有三个有线索。被人指控欺诈而悬赏的须弥占卜师希丁芭，常在<color=#00E1FFFF>南边港口附近</color>出没。"
                                },
                                {
                                    "id": "760370104",
                                    "speaker": "勒塞克",
                                    "text": "发狂的稻妻海乱鬼，途经<color=#00E1FFFF>空寂走廊</color>的游商中，已有多人命丧他手。"
                                },
                                {
                                    "id": "760370105",
                                    "speaker": "勒塞克",
                                    "text": "走私危险物品的帮派成员，据说盘踞在<color=#00E1FFFF>镇子北面海滩的营地</color>。"
                                },
                                {
                                    "id": "760370106",
                                    "speaker": "勒塞克",
                                    "text": "穷凶极恶的海盗，「裂颚」哈尔克，暂时没有线索，或许在什么地方潜伏起来了。"
                                }
                            ]
                        },
                        {
                            "id": "760370108",
                            "text": "再见。",
                            "response": [
                                {
                                    "id": "760370109",
                                    "speaker": "勒塞克",
                                    "text": "不送。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7603702",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "760370201",
                    "speaker": "悬赏",
                    "text": "（告示板上写有悬赏目标的详细信息…）"
                }
            ]
        },
        {
            "id": "7603703",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "760370301",
                    "speaker": "Player",
                    "text": "（关于希丁芭…）"
                },
                {
                    "id": "760370302",
                    "speaker": "悬赏",
                    "text": "「悬赏目标：须弥占卜师希丁芭，女，年龄不详。悬赏事由：涉嫌诅咒他人与巨额财物诈骗。」"
                },
                {
                    "id": "760370303",
                    "speaker": "悬赏",
                    "text": "「那女人骗了老子整整一千八百万摩拉，说是只要戴上她从恋爱之神阿赫玛尔那里苦苦求得的项链，就能让姑娘们一见倾心。」"
                },
                {
                    "id": "760370304",
                    "speaker": "悬赏",
                    "text": "「后来老子才知道，那个阿赫玛尔根本就不是恋爱之神，死了几千年不说，一辈子都没追到过心爱的姑娘。」"
                },
                {
                    "id": "760370305",
                    "speaker": "悬赏",
                    "text": "「由此可见，她卖给老子的项链虽然是真货，却是诅咒老子无法恋爱的真货。凡能找到她下落帮我解咒的，本人将予以重谢。」"
                }
            ]
        },
        {
            "id": "7603704",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "760370401",
                    "speaker": "Player",
                    "text": "（关于海乱鬼…）"
                },
                {
                    "id": "760370402",
                    "speaker": "悬赏",
                    "text": "「悬赏目标：权八，稻妻人，海乱鬼装束。悬赏事由：无差别袭击往来游商，已有数人不幸丧命。」"
                },
                {
                    "id": "760370403",
                    "speaker": "悬赏",
                    "text": "「目标曾被目睹在<color=#00E1FFFF>空寂走廊</color>附近出没。讨伐并证明其已死者，商会将予以重赏。」"
                }
            ]
        },
        {
            "id": "7603705",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "760370801",
                    "speaker": "勒塞克",
                    "text": "不错。赏金归你了。"
                }
            ]
        },
        {
            "id": "7603706",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "760370601",
                    "speaker": "Player",
                    "text": "（关于「裂颚」哈尔克…）"
                },
                {
                    "id": "760370602",
                    "speaker": "悬赏",
                    "text": "「悬赏目标：『阿特拉号』前舵手，『裂颚』哈尔克。悬赏事由：身负多起命案，手段残忍，现下落不明。」"
                },
                {
                    "id": "760370603",
                    "speaker": "悬赏",
                    "text": "「任何能提供其线索者，一经证实，将予以重赏。」"
                }
            ]
        },
        {
            "id": "7603705",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "760370501",
                    "speaker": "Player",
                    "text": "（关于走私者…）"
                },
                {
                    "id": "760370502",
                    "speaker": "悬赏",
                    "text": "「悬赏目标：新铁盐会。悬赏事由：涉嫌大规模走私及贩运危险管制物品。」"
                },
                {
                    "id": "760370503",
                    "speaker": "悬赏",
                    "text": "「据调查，该帮派在<color=#00E1FFFF>镇子北面海滩的营地</color>有一临时据点。协助制止其走私行为者，刺玫会将予以重奖。」"
                }
            ]
        },
        {
            "id": "7603707",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "760370701",
                    "speaker": "Player",
                    "text": "（先不看了。）"
                }
            ]
        },
        {
