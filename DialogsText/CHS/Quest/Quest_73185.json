    "talks": [
        {
            "id": "7318511",
            "objective": "",
            "dialogues": [
                {
                    "id": "731851101",
                    "speaker": "Player",
                    "text": "关于这些货物…"
                }
            ]
        },
        {
            "id": "7318501",
            "objective": "解救被魔物围攻的人",
            "dialogues": [
                {
                    "id": "731850101",
                    "speaker": "阿尔伯",
                    "text": "呼…呼…谢谢你旅行者…",
                    "choices": [
                        {
                            "id": "731850102",
                            "text": "没事就好。",
                            "response": [
                                {
                                    "id": "731850104",
                                    "speaker": "阿尔伯",
                                    "text": "我叫阿尔伯，是个商人，本来只是在这里休息一下…"
                                },
                                {
                                    "id": "731850105",
                                    "speaker": "阿尔伯",
                                    "text": "但没想到，却被那些丘丘人突然袭击了…",
                                    "choices": [
                                        {
                                            "id": "731850106",
                                            "text": "你没有护卫吗？",
                                            "response": [
                                                {
                                                    "id": "731850108",
                                                    "speaker": "派蒙",
                                                    "text": "对呀，我们在城里听说，外出运货的商人们一般都会雇佣「镀金旅团」的人来帮忙呢。"
                                                },
                                                {
                                                    "id": "731850109",
                                                    "speaker": "阿尔伯",
                                                    "text": "哎呀，我…我不是舍不得那些钱吗？"
                                                },
                                                {
                                                    "id": "731850110",
                                                    "speaker": "阿尔伯",
                                                    "text": "那些「镀金旅团」的人出价时个个都是狮子大开口，要的数目一个比一个夸张。"
                                                },
                                                {
                                                    "id": "731850111",
                                                    "speaker": "阿尔伯",
                                                    "text": "我本来做的就是小本生意，可付不起那么多钱…"
                                                },
                                                {
                                                    "id": "731850112",
                                                    "speaker": "阿尔伯",
                                                    "text": "我就想，反正我也会一点武艺，运货的路程也不远，干脆直接出发算了。"
                                                },
                                                {
                                                    "id": "731850113",
                                                    "speaker": "阿尔伯",
                                                    "text": "但没想到，那些丘丘人袭击的时候，把我的两只驮兽惊到了。"
                                                },
                                                {
                                                    "id": "731850114",
                                                    "speaker": "阿尔伯",
                                                    "text": "我还没反应过来，就先被一只驮兽撞到了地上，站起来之后，又挨了另外一只驮兽一蹄。"
                                                },
                                                {
                                                    "id": "731850115",
                                                    "speaker": "派蒙",
                                                    "text": "呜哇…"
                                                },
                                                {
                                                    "id": "731850116",
                                                    "speaker": "阿尔伯",
                                                    "text": "然后，两只驮兽夺路而跑，我则被那群丘丘人围攻…还好有你们帮忙。"
                                                },
                                                {
                                                    "id": "731850117",
                                                    "speaker": "阿尔伯",
                                                    "text": "但我的全部身家都在那两头驮兽的身上…旅行者，能不能请你去帮我把它们带回来？",
                                                    "choices": [
                                                        {
                                                            "id": "731850118",
                                                            "text": "我，我不想被踢…",
                                                            "response": [
                                                                {
                                                                    "id": "731850120",
                                                                    "speaker": "阿尔伯",
                                                                    "text": "没事，没事，不用担心。它们的性情本来很温和的，只是那些丘丘人把它们的食物给打翻了。"
                                                                },
                                                                {
                                                                    "id": "731850121",
                                                                    "speaker": "阿尔伯",
                                                                    "text": "它们驮着货物走了这么远，已经非常饿了，被打翻食物之后就变得格外暴躁…"
                                                                },
                                                                {
                                                                    "id": "731850122",
                                                                    "speaker": "派蒙",
                                                                    "text": "原来如此…在吃饭的时候被打扰，吃的东西还都被打翻了…"
                                                                },
                                                                {
                                                                    "id": "731850123",
                                                                    "speaker": "派蒙",
                                                                    "text": "唔唔唔，光是想想都很生气了！"
                                                                },
                                                                {
                                                                    "id": "731850124",
                                                                    "speaker": "Player",
                                                                    "text": "派蒙理解得可真快啊…"
                                                                },
                                                                {
                                                                    "id": "731850125",
                                                                    "speaker": "阿尔伯",
                                                                    "text": "这样好了…来，这些食物给你。"
                                                                },
                                                                {
                                                                    "id": "731850126",
                                                                    "speaker": "阿尔伯",
                                                                    "text": "你找到驮兽之后，就把这些食物喂给它们吧。"
                                                                },
                                                                {
                                                                    "id": "731850127",
                                                                    "speaker": "阿尔伯",
                                                                    "text": "只要有吃的，它们就不会乱发脾气了。"
                                                                },
                                                                {
                                                                    "id": "731850128",
                                                                    "speaker": "阿尔伯",
                                                                    "text": "我之前留意到，有一只驮兽撞开了那些丘丘人，自顾自地跑远…"
                                                                },
                                                                {
                                                                    "id": "731850129",
                                                                    "speaker": "阿尔伯",
                                                                    "text": "另外一只好像被那些丘丘人抓住带走了。"
                                                                },
                                                                {
                                                                    "id": "731850130",
                                                                    "speaker": "阿尔伯",
                                                                    "text": "我把那两只驮兽离开的方向大致给你标记一下…这件事就交给你了，旅行者。"
                                                                },
                                                                {
                                                                    "id": "731850131",
                                                                    "speaker": "阿尔伯",
                                                                    "text": "只要能把货物找回来，我一定会付给你一笔丰厚报酬的！"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "731850119",
                                                            "text": "我，我担心被撞…"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "731850107",
                                            "text": "没有人保护你？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "731850103",
                            "text": "小事而已。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7318502",
            "objective": "与阿尔伯对话",
            "dialogues": []
        },
        {
            "id": "7318503",
            "objective": "寻找走失的驮兽",
            "dialogues": [
                {
                    "id": "731850301",
                    "speaker": "希拉非",
                    "text": "（test）啊！驮驮！可找到你了！"
                }
            ]
        },
        {
            "id": "7318504",
            "objective": "打倒所有丘丘人",
            "dialogues": [
                {
                    "id": "731850401",
                    "speaker": "派蒙",
                    "text": "呜哇！这只驮兽好大，被它撞一下肯定不好受…"
                },
                {
                    "id": "731850402",
                    "speaker": "派蒙",
                    "text": "快把阿尔伯先生给我们的食物拿出来给它吧。"
                },
                {
                    "id": "731850403",
                    "speaker": "Player",
                    "text": "请慢用…"
                },
                {
                    "id": "731850404",
                    "speaker": "Player",
                    "text": "这些真的能吃饱吗…"
                },
                {
                    "id": "731850405",
                    "speaker": "派蒙",
                    "text": "看起来，它好像心情不错呢。"
                },
                {
                    "id": "731850406",
                    "speaker": "派蒙",
                    "text": "快，我们把它带回去吧。"
                },
                {
                    "id": "731850407",
                    "speaker": "Black Screen",
                    "text": "和驮兽一同回到了阿尔伯身边…"
                },
                {
                    "id": "731850408",
                    "speaker": "Black Screen",
                    "text": "驮兽飞快地吞下了食物，似乎心情变好了一些…"
                },
                {
                    "id": "731850409",
                    "speaker": "阿尔伯",
                    "text": "太好了…我还以为这只驮兽真跑丢了…"
                },
                {
                    "id": "731850410",
                    "speaker": "阿尔伯",
                    "text": "谢谢你旅行者，真是太谢谢你了。"
                },
                {
                    "id": "731850411",
                    "speaker": "阿尔伯",
                    "text": "我得赶紧检查一下这只驮兽的状况，希望它没有受什么伤…"
                },
                {
                    "id": "731850412",
                    "speaker": "阿尔伯",
                    "text": "请你再帮我找找另外一只驮兽吧，旅行者。"
                },
                {
                    "id": "731850413",
                    "speaker": "阿尔伯",
                    "text": "太好了，这下两只驮兽都找回来了！太感谢你了，旅行者。"
                },
                {
                    "id": "731850414",
                    "speaker": "阿尔伯",
                    "text": "等我把这些货物归整好之后，就回城里去。"
                },
                {
                    "id": "731850415",
                    "speaker": "阿尔伯",
                    "text": "唉，下次运货的时候，我必须得请几个护卫了…"
                },
                {
                    "id": "731850416",
                    "speaker": "Player",
                    "text": "关于捡到的货物…"
                }
            ]
        },
        {
            "id": "7318505",
            "objective": "安抚驮兽",
            "dialogues": []
        },
        {
            "id": "7318506",
            "objective": "寻找走失的驮兽",
            "dialogues": [
                {
                    "id": "731850601",
                    "speaker": "阿尔伯",
                    "text": "这下两只驮兽就都回来了…真是太感谢你了，旅行者。"
                },
                {
                    "id": "731850602",
                    "speaker": "Player",
                    "text": "关于这些货物…"
                }
            ]
        },
        {
            "id": "7318507",
            "objective": "安抚驮兽",
            "dialogues": [
                {
                    "id": "731850501",
                    "speaker": "派蒙",
                    "text": "这只驮兽…好像心情不太好…"
                },
                {
                    "id": "731850502",
                    "speaker": "派蒙",
                    "text": "呜哇，你看它的蹄子，感觉好结实的样子…"
                },
                {
                    "id": "731850503",
                    "speaker": "派蒙",
                    "text": "要是被踢上一下，一般人应该会直接昏过去吧…"
                },
                {
                    "id": "731850504",
                    "speaker": "Player",
                    "text": "派蒙把这些食物送过去吧…"
                },
                {
                    "id": "731850505",
                    "speaker": "派蒙",
                    "text": "你，你去啦！快点快点！",
                    "choices": [
                        {
                            "id": "731850506",
                            "text": "请您慢用…",
                            "response": [
                                {
                                    "id": "731850508",
                                    "speaker": "派蒙",
                                    "text": "它看起来好像没那么生气了。"
                                },
                                {
                                    "id": "731850509",
                                    "speaker": "派蒙",
                                    "text": "我们快把它带回去吧，小心啊！可别被踢到了…"
                                },
                                {
                                    "id": "731850510",
                                    "speaker": "Black Screen",
                                    "text": "驮兽缓缓地吞下了食物，蹄子似乎安分了一些…"
                                },
                                {
                                    "id": "731850511",
                                    "speaker": "Black Screen",
                                    "text": "和驮兽一同回到了阿尔伯身边…"
                                },
                                {
                                    "id": "731850512",
                                    "speaker": "阿尔伯",
                                    "text": "太好了…我还以为这只驮兽真跑丢了…"
                                },
                                {
                                    "id": "731850513",
                                    "speaker": "阿尔伯",
                                    "text": "谢谢你旅行者，真是太谢谢你了。"
                                },
                                {
                                    "id": "731850514",
                                    "speaker": "阿尔伯",
                                    "text": "我得赶紧检查一下这只驮兽的状况，希望它没有受什么伤…"
                                },
                                {
                                    "id": "731850515",
                                    "speaker": "阿尔伯",
                                    "text": "请你再帮我找找另外一只驮兽吧，旅行者。"
                                },
                                {
                                    "id": "731850516",
                                    "speaker": "阿尔伯",
                                    "text": "太好了，这下两只驮兽都找回来了！太感谢你了，旅行者。"
                                },
                                {
                                    "id": "731850517",
                                    "speaker": "阿尔伯",
                                    "text": "等我把这些剩下的货物归整好之后，就回城里去。"
                                },
                                {
                                    "id": "731850518",
                                    "speaker": "阿尔伯",
                                    "text": "唉，下次运货的时候，我必须得请几个护卫了…"
                                },
                                {
                                    "id": "731850519",
                                    "speaker": "Player",
                                    "text": "关于捡到的货物…"
                                }
                            ]
                        },
                        {
                            "id": "731850507",
                            "text": "我无意冒犯您的蹄子…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7318508",
            "objective": "（test）保护环$HIDDEN",
            "dialogues": [
                {
                    "id": "731850801",
                    "speaker": "阿尔伯",
                    "text": "除了这只之外，还有一只驮兽不知道跑到哪里去了。"
                },
                {
                    "id": "731850802",
                    "speaker": "阿尔伯",
                    "text": "这只驮兽的状态看起来还不错，真是万幸…"
                },
                {
                    "id": "731850803",
                    "speaker": "阿尔伯",
                    "text": "旅行者，请你再帮我去找找那一只吧。"
                }
            ]
        },
        {
            "id": "7318509",
            "objective": "将货物带给阿尔伯",
            "dialogues": []
        },
        {
            "id": "7318510",
            "objective": "与阿尔伯对话",
            "dialogues": [
                {
                    "id": "731850701",
                    "speaker": "阿尔伯",
                    "text": "太好了！真是太感谢你了旅行者！"
                },
                {
                    "id": "731850702",
                    "speaker": "阿尔伯",
                    "text": "这两只驮兽和货物要是全丢了，我今天非得破产不可。",
                    "choices": [
                        {
                            "id": "731850703",
                            "text": "不用客气。",
                            "response": [
                                {
                                    "id": "731850705",
                                    "speaker": "阿尔伯",
                                    "text": "喔！对了，还得给你报酬，稍等一下…"
                                },
                                {
                                    "id": "731850706",
                                    "speaker": "阿尔伯",
                                    "text": "这些东西请你收下吧。看你的样子，肯定常年都在野外冒险。"
                                },
                                {
                                    "id": "731850707",
                                    "speaker": "阿尔伯",
                                    "text": "我做的正好就是和冒险用具相关的生意，这些东西你肯定都用得上。"
                                },
                                {
                                    "id": "731850708",
                                    "speaker": "阿尔伯",
                                    "text": "呼…驮兽找回来了，货物也基本上完好，我得赶紧离开这里了。"
                                },
                                {
                                    "id": "731850709",
                                    "speaker": "阿尔伯",
                                    "text": "再次谢谢你，旅行者。"
                                }
                            ]
                        },
                        {
                            "id": "731850704",
                            "text": "关于报酬…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7318502",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "731850201",
                    "speaker": "阿尔伯",
                    "text": "唉…真是不能在驮兽吃饭的时候打扰它们啊。"
                }
            ]
        },
        {
            "id": "7318599",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "731859901",
                    "speaker": "阿尔伯",
                    "text": "救，救命啊！谁来帮帮我！"
                },
                {
                    "id": "731859902",
                    "speaker": "派蒙",
                    "text": "那边有人遇见危险了！我们快去帮忙！"
                },
                {
                    "id": "731859903",
                    "speaker": "派蒙",
                    "text": "这里就是阿尔伯先生给我们标记的位置之一了…"
                },
                {
                    "id": "731859904",
                    "speaker": "派蒙",
                    "text": "你看那边的水洼，旁边有一圈脚印，那会不会就是驮兽留下的？"
                },
                {
                    "id": "731859905",
                    "speaker": "派蒙",
                    "text": "如果那只驮兽踩过了这片水洼…蹄子上一定会带着水…"
                },
                {
                    "id": "731859906",
                    "speaker": "派蒙",
                    "text": "嘿嘿，是用「元素视野」的时候了，跟着「水」的痕迹找到那只驮兽吧。"
                },
                {
                    "id": "731859911",
                    "speaker": "派蒙",
                    "text": "这个箱子里面装着好多东西，也许是那只驮兽奔逃的时候掉下来的货物。"
                },
                {
                    "id": "731859912",
                    "speaker": "派蒙",
                    "text": "它应该就在前面了，继续前进吧。"
                },
                {
                    "id": "731859913",
                    "speaker": "派蒙",
                    "text": "对了，记得把这些货物带回去给阿尔伯先生喔。"
                }
            ]
        }
    ]
}