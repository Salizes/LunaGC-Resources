    "talks": [
        {
            "id": "7107501",
            "objective": "test隐藏-创建小轻策$HIDDEN",
            "dialogues": [
                {
                    "id": "710750101",
                    "speaker": "？？？",
                    "text": "嘿，就是你！"
                },
                {
                    "id": "710750102",
                    "speaker": "？？？",
                    "text": "那个什么二哥，翻了半天翻不到，你这个对这个地方熟悉的家伙总能找到吧！"
                },
                {
                    "id": "710750103",
                    "speaker": "？？？",
                    "text": "找不到？只要等到一个能找到的人，逼你们把找到的东西交出来不就行了。"
                },
                {
                    "id": "710750104",
                    "speaker": "「小轻策」",
                    "text": "我江湖人称「小轻策」，区区层岩巨渊这儿一群挖矿的摆不平，还怎么在外面混？来，把东西给我吧。"
                },
                {
                    "id": "710750105",
                    "speaker": "「小轻策」",
                    "text": "千岩军的宝藏，我们盗宝团就收下了！",
                    "choices": [
                        {
                            "id": "710750106",
                            "text": "无论你想要什么…",
                            "response": [
                                {
                                    "id": "710750108",
                                    "speaker": "「小轻策」",
                                    "text": "你说没有就没有？"
                                },
                                {
                                    "id": "710750109",
                                    "speaker": "「小轻策」",
                                    "text": "…哼，我还以为你们每天跑上跑下，身子板看上去能结实点呢。"
                                },
                                {
                                    "id": "710750110",
                                    "speaker": "「小轻策」",
                                    "text": "你选吧，是被我一拳撂倒搜个全身，还是自己亲手把「庇佑之冠」呈上来？"
                                },
                                {
                                    "id": "710750111",
                                    "speaker": "Player",
                                    "text": "我觉得你不会想和我打的…"
                                },
                                {
                                    "id": "710750112",
                                    "speaker": "「小轻策」",
                                    "text": "呦，语气很大嘛…"
                                },
                                {
                                    "id": "710750113",
                                    "speaker": "「小轻策」",
                                    "text": "我看你这是敬酒不吃吃罚酒了！"
                                }
                            ]
                        },
                        {
                            "id": "710750107",
                            "text": "这里都没有。"
                        }
                    ]
                }
            ]
