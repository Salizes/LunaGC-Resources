    "talks": [
        {
            "id": "7150801",
            "objective": "回报胡塞尼",
            "dialogues": [
                {
                    "id": "715080101",
                    "speaker": "胡塞尼",
                    "text": "真不愧是你啊…在「普尔希娜光钉」没有受到什么损伤的情况下，也清理了周围的黑泥和怪物。"
                },
                {
                    "id": "715080102",
                    "speaker": "胡塞尼",
                    "text": "我有点庆幸海迪夫找来的帮手是你，如果是其他冒险家，可能真的没法解决这些问题。"
                },
                {
                    "id": "715080103",
                    "speaker": "Player",
                    "text": "我可是很厉害的。"
                },
                {
                    "id": "715080104",
                    "speaker": "胡塞尼",
                    "text": "嗯，是有目共睹的厉害。"
                },
                {
                    "id": "715080105",
                    "speaker": "胡塞尼",
                    "text": "两位矿工，也就是老图和阿昊，已经回去休息了，不过…看这样子，也很难直接将「光钉」搬进去…"
                },
                {
                    "id": "715080106",
                    "speaker": "胡塞尼",
                    "text": "一路清理并不是一个好的办法，因为越接近喷口，黑泥重新涌出和覆盖的速率越高，必须直接处理掉黑泥源头才行。"
                },
                {
                    "id": "715080107",
                    "speaker": "胡塞尼",
                    "text": "…看来得想一些别的方法了。"
                }
            ]
        }
    ]
}