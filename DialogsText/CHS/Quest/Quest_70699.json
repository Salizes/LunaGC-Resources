    "talks": [
        {
            "id": "7069901",
            "objective": "与米卡对话",
            "dialogues": [
                {
                    "id": "706990101",
                    "speaker": "米卡",
                    "text": "能请到荣誉骑士前辈试玩游艺项目，实在是太幸运了，感觉安心了不少！"
                },
                {
                    "id": "706990102",
                    "speaker": "米卡",
                    "text": "说实话，我还是第一次参与这种开发工作呢，有点紧张，感觉脑力常常不够用…"
                },
                {
                    "id": "706990103",
                    "speaker": "米卡",
                    "text": "明明只是给一个成熟的机关装上外壳，却要顾及方方面面的设计，调试许多参数…"
                },
                {
                    "id": "706990104",
                    "speaker": "米卡",
                    "text": "要是像阿贝多长官那样，从零开始制作专用装备，不知道会遇见多少难题！",
                    "choices": [
                        {
                            "id": "706990105",
                            "text": "现在的成品已经很稳定了。",
                            "response": [
                                {
                                    "id": "706990107",
                                    "speaker": "米卡",
                                    "text": "呜啊…谢谢…谢谢荣誉骑士前辈的肯定！"
                                },
                                {
                                    "id": "706990108",
                                    "speaker": "米卡",
                                    "text": "我，我会加油的，争取以后能独自为游击小队开发出更多实用的东西…"
                                },
                                {
                                    "id": "706990109",
                                    "speaker": "米卡",
                                    "text": "之前我赢来了几只玩偶，这一只送给你…"
                                },
                                {
                                    "id": "706990110",
                                    "speaker": "米卡",
                                    "text": "我有一只一样的，以后，只要看到这个玩偶，我就能想起你给我的鼓励！"
                                }
                            ]
                        },
                        {
                            "id": "706990106",
                            "text": "相信自己，你会不断进步。"
                        }
                    ]
                }
            ]
        }
    ]
