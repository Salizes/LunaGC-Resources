    "talks": [
        {
            "id": "7273601",
            "objective": "(test)任务npc对话block$HIDDEN",
            "dialogues": [
                {
                    "id": "727360101",
                    "speaker": "「花角玉将」",
                    "text": "难能可贵，难能可贵！"
                },
                {
                    "id": "727360102",
                    "speaker": "「花角玉将」",
                    "text": "真没想到，荒泷派居然能打败这么多斗虫强者。看来你们对斗虫也有着独特的理解…"
                },
                {
                    "id": "727360103",
                    "speaker": "「花角玉将」",
                    "text": "我收回之前的成见。接下来，我会将你们当成值得尊敬的对手，全力和你们比试一场！"
                },
                {
                    "id": "727360104",
                    "speaker": "派蒙",
                    "text": "放牛的，到你这个老大登场的时候啦！"
                },
                {
                    "id": "727360105",
                    "speaker": "派蒙",
                    "text": "可别把之前的话当真！",
                    "choices": [
                        {
                            "id": "727360106",
                            "text": "出阵吧，「真剑斗虫大鬼王」！",
                            "response": [
                                {
                                    "id": "727360108",
                                    "speaker": "荒泷一斗",
                                    "text": "哈哈哈哈哈哈哈，那是当然了！最后对决，也一定会是我赢！"
                                },
                                {
                                    "id": "727360109",
                                    "speaker": "荒泷一斗",
                                    "text": "虽然不知道你到底是怎么指导部下的，但结果已经没有悬念了，是本大爷的荒泷派更胜一筹！"
                                },
                                {
                                    "id": "727360110",
                                    "speaker": "荒泷一斗",
                                    "text": "准备接招吧！「花角玉将」！"
                                }
                            ]
                        },
                        {
                            "id": "727360107",
                            "text": "大激斗，鬼王对玉将！"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7273602",
            "objective": "（test）挑战花椒鱼酱$HIDDEN",
            "dialogues": [
                {
                    "id": "727360201",
                    "speaker": "「花角玉将」",
                    "text": "原来如此，原来如此啊…再打一场吧，我一定能看透你斗虫的门道。"
                },
                {
                    "id": "727360202",
                    "speaker": "「花角玉将」",
                    "text": "比试的胜负似乎已经没那么重要了，我们就斗个爽快，如何？"
                },
                {
                    "id": "727360203",
                    "speaker": "「花角玉将」",
                    "text": "难得有这么合拍的对手，短短几分钟就结束，未免也太不尽兴了？"
                },
                {
                    "id": "727360204",
                    "speaker": "荒泷一斗",
                    "text": "哈！来就来！"
                },
                {
                    "id": "727360205",
                    "speaker": "荒泷一斗",
                    "text": "不过…看穿本大爷斗虫的秘技？你可别痴心妄想啊！"
                },
                {
                    "id": "727360206",
                    "speaker": "荒泷一斗",
                    "text": "如果你肯承认，是我斗虫的本领更强，无论斗多少场，我都会奉陪到底！"
                },
                {
                    "id": "727360207",
                    "speaker": "派蒙",
                    "text": "唔，放牛的和「花角玉将」还是热血沸腾呢，就让他们继续斗虫吧，斗到他们完全满足！"
                }
            ]
        }
    ]
}