    "talks": [
        {
            "id": "7080901",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "708090101",
                    "speaker": "Player",
                    "text": "你是不是在找这个？"
                }
            ]
        },
        {
            "id": "7080904",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "708090301",
                    "speaker": "Black Screen",
                    "text": "（鸟巢内有许多零散的碎纸条，似乎还有七零八落的字迹…）"
                },
                {
                    "id": "708090302",
                    "speaker": "派蒙",
                    "text": "这些纸条…不会是它们为了筑巢特意撕开的吧？"
                },
                {
                    "id": "708090303",
                    "speaker": "派蒙",
                    "text": "上面好像还有字呢，要不要拼起来看看写了什么？"
                },
                {
                    "id": "708090304",
                    "speaker": "Player",
                    "text": "搞半天还是要自己拼…"
                },
                {
                    "id": "708090305",
                    "speaker": "派蒙",
                    "text": "你就不好奇吗？说不定是什么藏宝图呢！"
                },
                {
                    "id": "708090306",
                    "speaker": "Black Screen",
                    "text": "在派蒙的连声催促下拼好了纸条…"
                },
                {
                    "id": "708090307",
                    "speaker": "派蒙",
                    "text": "让我看看…这是…"
                },
                {
                    "id": "708090308",
                    "speaker": "派蒙",
                    "text": "这…这难道是…「犯罪计划书」吗！",
                    "choices": [
                        {
                            "id": "708090309",
                            "text": "谁的犯罪计划会被鸟叼走啊！",
                            "response": [
                                {
                                    "id": "708090310",
                                    "speaker": "派蒙",
                                    "text": "但…但是小说里经常有这种情节吧！万无一失的计划，偏偏就在最不可能的地方出了疏漏…"
                                },
                                {
                                    "id": "708090313",
                                    "speaker": "派蒙",
                                    "text": "我们去附近的酒馆里打听一下吧？看看有没有谁听说过，「最近有人要犯罪了！」什么的…"
                                }
                            ]
                        },
                        {
                            "id": "708090311",
                            "text": "宁可信其有，不可信其无…",
                            "response": [
                                {
                                    "id": "708090312",
                                    "speaker": "派蒙",
                                    "text": "你…你说得对，不怕一万，就怕万一…如果真有人打算犯罪，回头后悔可就晚了！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7080902",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "708090201",
                    "speaker": "Player",
                    "text": "我在鸟巢里找到了这个…"
                }
            ]
        },
        {
            "id": "7080903",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7080907",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "708090401",
                    "speaker": "内田幸太郎",
                    "text": "这…这是…我的「作案手法」！"
                },
                {
                    "id": "708090402",
                    "speaker": "派蒙",
                    "text": "#{NICKNAME}！他居然直接就承认了！"
                },
                {
                    "id": "708090403",
                    "speaker": "内田幸太郎",
                    "text": "啊！请别误会，这是我打算写进下一部小说里的诡计，是我之前喝酒的时候想出来的。"
                },
                {
                    "id": "708090404",
                    "speaker": "内田幸太郎",
                    "text": "没想到酒一醒这页纸就消失了…我差点以为自己是在做梦呢。"
                },
                {
                    "id": "708090405",
                    "speaker": "内田幸太郎",
                    "text": "总之，多谢你帮忙找回它啦。这下我的小说应该就能顺产了，到时候我先送你一本！带签名的！"
                }
            ]
        },
        {
            "id": "7080906",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "708090501",
                    "speaker": "洛恩",
                    "text": "哦？有点意思，让我看看…嗯，创意可以给六分，可行性大概就四分吧…"
                },
                {
                    "id": "708090502",
                    "speaker": "派蒙",
                    "text": "这…这是「犯罪计划书」吗？"
                },
                {
                    "id": "708090503",
                    "speaker": "洛恩",
                    "text": "哈哈，其实我从驻地跑来这里，就是听说了有人在这儿盘算一些稀奇古怪的「犯罪计划」。"
                },
                {
                    "id": "708090504",
                    "speaker": "洛恩",
                    "text": "…不过看过这页笔记之后，我大概知道那些流言是怎么起来的了。"
                },
                {
                    "id": "708090505",
                    "speaker": "洛恩",
                    "text": "这份「犯罪计划书」就交给骑士团来处理吧，回头要是有空就来我的驻地逛逛？没准会有好戏呢。"
                }
            ]
        },
        {
            "id": "7080905",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "618011501",
                    "speaker": "内田幸太郎",
                    "text": "…骑士先生！那真的就只是一个小说里的点子而已！不是什么「犯罪计划」。"
                },
                {
                    "id": "618011502",
                    "speaker": "洛恩",
                    "text": "嗯嗯我明白，不必那么激动，内田先生，先喝杯茶冷静一下吧。"
                },
                {
                    "id": "618011503",
                    "speaker": "洛恩",
                    "text": "根据重要线人提供的情报…你的手稿确实不像「犯罪计划」，毕竟那要实施起来可太不现实了。"
                },
                {
                    "id": "618011505",
                    "speaker": "内田幸太郎",
                    "text": "什么——哪…哪里不现实了！你倒是说说啊？"
                },
                {
                    "id": "618011506",
                    "speaker": "洛恩",
                    "text": "条件太多，环节太杂，既要有符合你需求的毒药，又得有符合你需求的建筑…"
                },
                {
                    "id": "618011507",
                    "speaker": "内田幸太郎",
                    "text": "呃…唔…"
                },
                {
                    "id": "618011508",
                    "speaker": "洛恩",
                    "text": "哪一步出了纰漏都会马上败露，不是么？更别说还掺了这么多设定，理解起来都困难。"
                },
                {
                    "id": "618011509",
                    "speaker": "内田幸太郎",
                    "text": "…你这么一说，还真有点道理？那该怎么完善这个手法呢？"
                },
                {
                    "id": "618011510",
                    "speaker": "洛恩",
                    "text": "嗯，我碰巧也对药物有点兴趣，不如就这样…再那样…"
                },
                {
                    "id": "618011511",
                    "speaker": "内田幸太郎",
                    "text": "…哦哦！您当骑士可真是屈才了！骑士先生！"
                }
            ]
        }
    ]
}