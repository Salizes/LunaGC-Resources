    },
    "talks": [
        {
            "id": "7468001",
            "objective": "与工作人员对话",
            "dialogues": [
                {
                    "id": "746800101",
                    "speaker": "伊莲",
                    "text": "「千灵映影节」…你做的好呀！干得漂亮！"
                },
                {
                    "id": "746800102",
                    "speaker": "伊莲",
                    "text": "这样一来，想在截止日期前完成项目，根本就是痴人说梦…"
                },
                {
                    "id": "746800103",
                    "speaker": "伊莲",
                    "text": "呜呜呜…噫啊啊…这次老板不会痛骂我了…应该会直接干掉我吧！"
                },
                {
                    "id": "746800104",
                    "speaker": "派蒙",
                    "text": "这位小姐怎么自顾自地哭起来了？"
                },
                {
                    "id": "746800105",
                    "speaker": "派蒙",
                    "text": "我们需要帮她找位医生吗？不知道枫丹有没有专门治疗心情的医生？"
                },
                {
                    "id": "746800106",
                    "speaker": "伊莲",
                    "text": "唔姆…你们什么时候来的…"
                },
                {
                    "id": "746800107",
                    "speaker": "伊莲",
                    "text": "谢谢两位的关心，现在我更需要…能复活我即将死亡的职业生涯的医生。"
                },
                {
                    "id": "746800108",
                    "speaker": "派蒙",
                    "text": "这应该不属于医生的工作吧！",
                    "choices": [
                        {
                            "id": "746800109",
                            "text": "不就是工作嘛！大不了换一个！",
                            "response": [
                                {
                                    "id": "746800110",
                                    "speaker": "伊莲",
                                    "text": "呀！换工作比死还折磨啊，所有熟悉的做事方法都不管用了，全都要重新学！"
                                },
                                {
                                    "id": "746800113",
                                    "speaker": "派蒙",
                                    "text": "这样聊下去也不是个办法，还是请你先说明一下吧，你现在遇见了什么困难？"
                                },
                                {
                                    "id": "746800114",
                                    "speaker": "伊莲",
                                    "text": "有点难，这可是技术问题，我想想该怎么总结…"
                                },
                                {
                                    "id": "746800115",
                                    "speaker": "伊莲",
                                    "text": "简单来说，我是「千灵映影节」器材供应商的工程师伊莲，主要负责开发摄影器材。"
                                },
                                {
                                    "id": "746800116",
                                    "speaker": "伊莲",
                                    "text": "为了追求映影的效果，我们的甲方提出，需要一种能够载着映影机快速移动的「稳像平台」…"
                                },
                                {
                                    "id": "746800117",
                                    "speaker": "伊莲",
                                    "text": "同时，这种「稳像平台」还需要搭载模仿演员的人偶或动物模型，扮演集群的远景。"
                                },
                                {
                                    "id": "746800118",
                                    "speaker": "伊莲",
                                    "text": "如此一来，他们就能在高速运动中稳定跟拍演员，或者省下雇佣大量演员的费用了。"
                                },
                                {
                                    "id": "746800119",
                                    "speaker": "伊莲",
                                    "text": "而且，他们要求每个平台的采购价，不能高于一台留影机的三分之一，使用寿命不能低于三十年。"
                                },
                                {
                                    "id": "746800120",
                                    "speaker": "派蒙",
                                    "text": "哪有这么提要求的！就算是超级厉害的工匠，也不可能做出又便宜好用又耐用的道具吧！"
                                },
                                {
                                    "id": "746800121",
                                    "speaker": "伊莲",
                                    "text": "我做完了。"
                                },
                                {
                                    "id": "746800122",
                                    "speaker": "伊莲",
                                    "text": "毕竟甲方是不可忤逆之人，以前甲方提过更过分的需求，我也豁出半条命满足了他们。"
                                },
                                {
                                    "id": "746800123",
                                    "speaker": "Player",
                                    "text": "……"
                                },
                                {
                                    "id": "746800124",
                                    "speaker": "派蒙",
                                    "text": "…那你在愁什么啦！"
                                },
                                {
                                    "id": "746800125",
                                    "speaker": "伊莲",
                                    "text": "问题是我没有测试员！好不容易做出了产品，不经过全面检测，项目就不算完成！"
                                },
                                {
                                    "id": "746800126",
                                    "speaker": "伊莲",
                                    "text": "稍微懂一点机关原理，或是体力足够好的测试员，都被「千灵映影节」雇佣去检查更重要的东西了…"
                                },
                                {
                                    "id": "746800127",
                                    "speaker": "伊莲",
                                    "text": "不经过测试的产品，交到甲方手里的话，要是被找出什么大问题，我还要倒赔钱，赔十倍！"
                                },
                                {
                                    "id": "746800128",
                                    "speaker": "伊莲",
                                    "text": "我只能在这里一边推销自家的产品，一边寻找外援…"
                                },
                                {
                                    "id": "746800129",
                                    "speaker": "伊莲",
                                    "text": "就算最后入不敷出也只能认了，毕竟和甲方的合同是老板签的，但要十倍赔钱的话，就是我个人来担责了。"
                                },
                                {
                                    "id": "746800130",
                                    "speaker": "Player",
                                    "text": "事已至此，先说说测试内容…"
                                },
                                {
                                    "id": "746800131",
                                    "speaker": "派蒙",
                                    "text": "#没错，如果不是特别困难的测试内容，说不定我和{NICKNAME}能替你做点简单的活。"
                                },
                                {
                                    "id": "746800132",
                                    "speaker": "伊莲",
                                    "text": "听起来没什么难点，实践起来可不容易——"
                                },
                                {
                                    "id": "746800133",
                                    "speaker": "伊莲",
                                    "text": "为了确认「稳像平台」在极限速度下的运转情况，我将它们调成了「避开一切接近者」的被动运动模式。"
                                },
                                {
                                    "id": "746800134",
                                    "speaker": "伊莲",
                                    "text": "测试员需要在特定场地内追逐「稳像平台」，尽可能在短时间内将更多平台驱赶至目标区域。"
                                },
                                {
                                    "id": "746800135",
                                    "speaker": "伊莲",
                                    "text": "像我这种体力差的人，稍微追着「稳像平台」跑两步，就完全没力气了…",
                                    "choices": [
                                        {
                                            "id": "746800136",
                                            "text": "这还不好办！",
                                            "response": [
                                                {
                                                    "id": "746800138",
                                                    "speaker": "派蒙",
                                                    "text": "你这么一说，我们反而放心了！"
                                                },
                                                {
                                                    "id": "746800139",
                                                    "speaker": "派蒙",
                                                    "text": "只不过是几个机关而已，看我们赶着它们呼呼跑，说不定还会被我们超过呢，测试极限什么的太简单了！"
                                                },
                                                {
                                                    "id": "746800140",
                                                    "speaker": "伊莲",
                                                    "text": "当真？当真？你们认真的吗？"
                                                },
                                                {
                                                    "id": "746800141",
                                                    "speaker": "伊莲",
                                                    "text": "那我我我，我给你们钱！"
                                                },
                                                {
                                                    "id": "746800142",
                                                    "speaker": "派蒙",
                                                    "text": "啊呀，辛苦费…我们也不会拒绝！不过，要是在这种情况下收你太多钱，我们的良心也会抗议的。"
                                                },
                                                {
                                                    "id": "746800143",
                                                    "speaker": "派蒙",
                                                    "text": "你按照正常支付给测试员的费用，给我们适当的摩拉就行了哦。"
                                                },
                                                {
                                                    "id": "746800144",
                                                    "speaker": "伊莲",
                                                    "text": "神医！您们就是能让我即将死亡的职业生涯复活的神医！"
                                                },
                                                {
                                                    "id": "746800145",
                                                    "speaker": "伊莲",
                                                    "text": "测试场就在城区附近的一座无人秘境中，那，那就交给您们两位了！我伊莲感激不尽！"
                                                },
                                                {
                                                    "id": "746800146",
                                                    "speaker": "伊莲",
                                                    "text": "从业这么多年，终于走运了一回！明天我不用被老板干掉了！"
                                                },
                                                {
                                                    "id": "746800147",
                                                    "speaker": "派蒙",
                                                    "text": "呃啊…干完这一单以后，还是建议你换个老板比较好…"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "746800137",
                                            "text": "不就是跑步！"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "746800111",
                            "text": "工作很重要，我们要不帮帮忙？",
                            "response": [
                                {
                                    "id": "746800112",
                                    "speaker": "派蒙",
                                    "text": "听她说得这么夸张，确实不能再袖手旁观了。"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}