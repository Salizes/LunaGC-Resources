    "talks": [
        {
            "id": "7002501",
            "objective": "向冒险家协会回报",
            "dialogues": [
                {
                    "id": "700250101",
                    "speaker": "凯瑟琳",
                    "text": "您好，冒险家！关于委托的完成情况我都已经了解了，感谢您为冒险家协会的付出！这里是您应得的报酬。"
                },
                {
                    "id": "700250102",
                    "speaker": "凯瑟琳",
                    "text": "虽然没能捕获那个奇怪的丘丘人，也没能找到这次骚乱的原因…但野外的安全至少得到了保障，辛苦您了。"
                },
                {
                    "id": "700250103",
                    "speaker": "凯瑟琳",
                    "text": "顺便一提，艾拉·马斯克小姐在图书馆等您。"
                }
            ]
        },
        {
            "id": "7002502",
            "objective": "与艾拉·马斯克对话",
            "dialogues": [
                {
                    "id": "700250201",
                    "speaker": "艾拉·马斯克",
                    "text": "Homu…mimi tomo…唔…"
                },
                {
                    "id": "700250202",
                    "speaker": "Player",
                    "text": "你好？"
                },
                {
                    "id": "700250203",
                    "speaker": "艾拉·马斯克",
                    "text": "Ya ika！！啊…是你们啊…吓我一跳…请不要打扰我。"
                },
                {
                    "id": "700250204",
                    "speaker": "派蒙",
                    "text": "欸，不是你叫我们来的吗？"
                },
                {
                    "id": "700250212",
                    "speaker": "艾拉·马斯克",
                    "text": "嗯？哦哦…是你们啊！多谢你们的帮助。"
                },
                {
                    "id": "700250205",
                    "speaker": "艾拉·马斯克",
                    "text": "不过手册中的内容准确吗？能够用来与丘丘人和平交流吗？",
                    "choices": [
                        {
                            "id": "700250206",
                            "text": "举手之劳。",
                            "response": [
                                {
                                    "id": "700250208",
                                    "speaker": "艾拉·马斯克",
                                    "text": "哼哼，我的词典工作又前进了一大步！人类能与丘丘人和平共存的论据又增加了！"
                                },
                                {
                                    "id": "700250209",
                                    "speaker": "艾拉·马斯克",
                                    "text": "只可惜没能和那个奇怪的丘丘人搭上话…"
                                },
                                {
                                    "id": "700250210",
                                    "speaker": "艾拉·马斯克",
                                    "text": "从我收集的语料来看，或许它也只是很想在这片陌生的大地上结交新朋友吧。"
                                },
                                {
                                    "id": "700250213",
                                    "speaker": "艾拉·马斯克",
                                    "text": "没能好好交流，真是遗憾。"
                                },
                                {
                                    "id": "700250214",
                                    "speaker": "艾拉·马斯克",
                                    "text": "啊，顺便，这里是给你的谢礼。"
                                },
                                {
                                    "id": "700250215",
                                    "speaker": "艾拉·马斯克",
                                    "text": "先前麻烦了你们那么多，实在不好意思。有机会还希望能够一起合作。"
                                },
                                {
                                    "id": "700250211",
                                    "speaker": "派蒙",
                                    "text": "什么嘛，原来这家伙还是会好好说话的…"
                                }
                            ]
                        },
                        {
                            "id": "700250207",
                            "text": "我还是更喜欢自己的方式。"
                        }
                    ]
                }
            ]
        }
    ]
}