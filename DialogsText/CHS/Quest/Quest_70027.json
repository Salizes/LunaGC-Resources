    "talks": [
        {
            "id": "7002701",
            "objective": "与胡塞尼对话",
            "dialogues": [
                {
                    "id": "700270101",
                    "speaker": "胡塞尼",
                    "text": "你来的正好，「普尔希娜光钉」的维修工作一切顺利。"
                },
                {
                    "id": "700270102",
                    "speaker": "胡塞尼",
                    "text": "只要有了这些元件，我有把握以最快的速度修好。"
                },
                {
                    "id": "700270103",
                    "speaker": "Player",
                    "text": "我收集了一些。"
                },
                {
                    "id": "700270104",
                    "speaker": "胡塞尼",
                    "text": "太好了，这真是帮了大忙。"
                },
                {
                    "id": "700270105",
                    "speaker": "胡塞尼",
                    "text": "只要有了这些元件，我有把握以最快的速度修好"
                },
                {
                    "id": "700270106",
                    "speaker": "胡塞尼",
                    "text": "不过还有件小事，我想还是先跟你商量一下比较好。"
                },
                {
                    "id": "700270107",
                    "speaker": "胡塞尼",
                    "text": "在你收集元件的这几天里，我仔细研究了一下「普尔希娜光钉」的内部结构。"
                },
                {
                    "id": "700270108",
                    "speaker": "胡塞尼",
                    "text": "它的结构非常巧妙，不愧是那位普尔希娜前辈制作出来的精妙仪器。"
                },
                {
                    "id": "700270109",
                    "speaker": "胡塞尼",
                    "text": "任何一处调整都有可能影响到整体功能，所以我有些担心调整是否能达到预期效果。"
                },
                {
                    "id": "700270110",
                    "speaker": "胡塞尼",
                    "text": "保险起见，我希望能拜托你先试用数次，我会根据你试用期间的数据对它进行再校准。"
                },
                {
                    "id": "700270111",
                    "speaker": "胡塞尼",
                    "text": "这样才能保证「普尔希娜光钉」的最终效果，要不然，等到你在与特异体交手的时候，万一它出现了故障，那可就糟了。",
                    "choices": [
                        {
                            "id": "700270112",
                            "text": "真是谨慎啊。",
                            "response": [
                                {
                                    "id": "700270114",
                                    "speaker": "胡塞尼",
                                    "text": "这也是我第一次实际操作「普尔希娜光钉」，我们还是谨慎些为好。"
                                },
                                {
                                    "id": "700270115",
                                    "speaker": "胡塞尼",
                                    "text": "那么，就拜托你多多试用了。"
                                }
                            ]
                        },
                        {
                            "id": "700270113",
                            "text": "我明白了。"
                        }
                    ]
                }
            ]
        },
