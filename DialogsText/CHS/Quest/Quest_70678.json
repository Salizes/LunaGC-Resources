    "talks": [
        {
            "id": "7067801",
            "objective": "(test)用于挂载小狼闲置对话$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7067802",
            "objective": "(test)用于监听第三轮挑战是否完成$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7067803",
            "objective": "(test)第三轮挑战结束后与小狼对话$HIDDEN",
            "dialogues": [
                {
                    "id": "706780301",
                    "speaker": "小狼",
                    "text": "哎呀哎呀，看来客人的演出进行得很顺利呢。"
                },
                {
                    "id": "706780302",
                    "speaker": "小狼",
                    "text": "如果客人想要学习新的「表演诀窍」…帅气或者优雅的姿势！作为友谊的证明，就用从宝箱里得到的玩具勋章来交换吧。"
                },
                {
                    "id": "706780303",
                    "speaker": "小狼",
                    "text": "友谊是很好的东西，对吧？光是提到这个词，就觉得心里和胃里都暖暖的…",
                    "choices": [
                        {
                            "id": "706780304",
                            "text": "友谊的确是好东西。",
                            "response": [
                                {
                                    "id": "706780305",
                                    "speaker": "派蒙",
                                    "text": "我也这么觉得！不过胃里暖暖的…这个说法多少有点让人在意…"
                                },
                                {
                                    "id": "706780308",
                                    "speaker": "派蒙",
                                    "text": "不过话说回来，用玩具勋章来交换…不过是玩具而已，真的有这样的价值吗？"
                                },
                                {
                                    "id": "706780309",
                                    "speaker": "小狼",
                                    "text": "只要「相信」，玩具勋章也可以有超越黄金的价值，这就是幻想的魔法的窍门。魔女小姐这样说过，虽然我不太懂…"
                                },
                                {
                                    "id": "706780310",
                                    "speaker": "小狼",
                                    "text": "不过关于「表演诀窍」的知识也是向魔女小姐许愿得来的，只要魔女小姐认定是公平的交易就没问题了吧？"
                                },
                                {
                                    "id": "706780311",
                                    "speaker": "派蒙",
                                    "text": "唔，不知为什么总觉得有点担心…故事里不是常有这样的情节吗？轻率地向女巫许愿，事后被收取根本无法支付的代价之类的…"
                                },
                                {
                                    "id": "706780312",
                                    "speaker": "小狼",
                                    "text": "客人真糊涂，根本没什么可担心的啊。首先，魔女和女巫根本不一样嘛。其次，代价不就是玩具勋章吗？"
                                },
                                {
                                    "id": "706780313",
                                    "speaker": "派蒙",
                                    "text": "是、是这样吗？"
                                },
                                {
                                    "id": "706780314",
                                    "speaker": "小狼",
                                    "text": "是呀是呀，而且…向魔女许愿的是我，所以就算有什么代价，也是由我承担的！",
                                    "choices": [
                                        {
                                            "id": "706780315",
                                            "text": "…为什么一副自豪的样子？",
                                            "response": [
                                                {
                                                    "id": "706780317",
                                                    "speaker": "小狼",
                                                    "text": "因为我也很喜欢客人带来的演出嘛，这一切都是值得的。不知道故事书的空白书页还剩多少，还够写几篇…"
                                                },
                                                {
                                                    "id": "706780318",
                                                    "speaker": "小狼",
                                                    "text": "啊，两位不用担心，就算现在暂时写满了，之后也会增添新的空白书页的！"
                                                },
                                                {
                                                    "id": "706780319",
                                                    "speaker": "小狼",
                                                    "text": "真期待啊，所有空白书页都被故事填满的那一天…"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "706780316",
                                            "text": "总觉得有些不好意思…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "706780306",
                            "text": "胃里暖暖的…",
                            "response": [
                                {
                                    "id": "706780307",
                                    "speaker": "派蒙",
                                    "text": "你这家伙可不要一提到「最好的伙伴」就马上想到「应急食品」啊！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7067851",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "706785101",
                    "speaker": "小狼",
                    "text": "准备工作还没有全部完成…请客人再稍等一下。"
                },
                {
                    "id": "706785102",
                    "speaker": "小狼",
                    "text": "如果愿意的话，客人不妨再试试登台表演，之后可以从宝箱里获得玩具勋章作为奖励哦！"
                }
            ]
        }
    ]
}