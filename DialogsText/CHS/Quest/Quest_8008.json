    "talks": [
        {
            "id": "800801",
            "objective": "",
            "dialogues": [
                {
                    "id": "80080101",
                    "speaker": "派蒙",
                    "text": "矿工大哥，我们是来汇报委托结果的！"
                },
                {
                    "id": "80080102",
                    "speaker": "玥辉",
                    "text": "哦！总算又见到你们了！之前我还有些担心，虽然付了钱，可仔细想想，委托别人调查那么诡异的地方，别出什么事才好…"
                },
                {
                    "id": "80080103",
                    "speaker": "玥辉",
                    "text": "万一有什么，我会一辈子良心不安的啊！"
                },
                {
                    "id": "80080104",
                    "speaker": "派蒙",
                    "text": "没事没事，我们是谁呀！你看，我们不是好好的回来了吗？情况也都调查清楚了。"
                },
                {
                    "id": "80080105",
                    "speaker": "玥辉",
                    "text": "厉害厉害！所以，下面是什么情况？"
                },
                {
                    "id": "80080106",
                    "speaker": "派蒙",
                    "text": "唔…欸…嗯…",
                    "choices": [
                        {
                            "id": "80080107",
                            "text": "有一群丘丘人在下面养老。",
                            "response": [
                                {
                                    "id": "80080108",
                                    "speaker": "玥辉",
                                    "text": "养老？"
                                },
                                {
                                    "id": "80080111",
                                    "speaker": "派蒙",
                                    "text": "总、总之，到下面去的那些丘丘人都没有什么攻击性了，也希望矿工们不要故意打搅它们。",
                                    "choices": [
                                        {
                                            "id": "80080112",
                                            "text": "没错。",
                                            "response": [
                                                {
                                                    "id": "80080114",
                                                    "speaker": "玥辉",
                                                    "text": "我们这些矿工可怕麻烦了，绝对不会主动招惹它们。我们眼里啊，只有亮晶晶的东西和金灿灿的东西。"
                                                },
                                                {
                                                    "id": "80080115",
                                                    "speaker": "派蒙",
                                                    "text": "唔，唔…很可信。"
                                                },
                                                {
                                                    "id": "80080116",
                                                    "speaker": "玥辉",
                                                    "text": "虽然不太明白你们在说什么，但有二位做担保，我就放心了，随时可以继续开工。"
                                                },
                                                {
                                                    "id": "80080117",
                                                    "speaker": "玥辉",
                                                    "text": "这回多亏二位！跑这么一趟，辛苦你们了，这些谢礼就请收下吧。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "80080113",
                                            "text": "可以放心了。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "80080109",
                            "text": "下面是丘丘人们的理想乡。",
                            "response": [
                                {
                                    "id": "80080110",
                                    "speaker": "玥辉",
                                    "text": "理想乡？"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}