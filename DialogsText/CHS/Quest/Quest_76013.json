    "talks": [
        {
            "id": "7601301",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "760130101",
                    "speaker": "维娜",
                    "text": "#啊，是可靠的{NICKNAME}！又见面啦！果然，这就是月光连接的「命运」吧？",
                    "choices": [
                        {
                            "id": "760130102",
                            "text": "关于你的处罚…",
                            "response": [
                                {
                                    "id": "760130103",
                                    "speaker": "维娜",
                                    "text": "哼哼，菈乌玛可比莱赫妲尔阿姨讲理多啦！我把事情的缘由跟她说清楚以后，她先是沉默了一分钟左右…"
                                },
                                {
                                    "id": "760130104",
                                    "speaker": "维娜",
                                    "text": "随后就让我来书库帮安洛丝整理文献、抄写祷歌，说是在我端正心念之前，不用再去那夏镇工作啦！还有比这更棒的奖赏吗？"
                                },
                                {
                                    "id": "760130105",
                                    "speaker": "维娜",
                                    "text": "#对了对了！我这几天抄写祷歌的时候，也理解爱依菈大人之前说的一些话是什么意思了！果然，{NICKNAME}就是我的幸运符呢！"
                                }
                            ]
                        },
                        {
                            "id": "760130106",
                            "text": "关于先前的事…",
                            "response": [
                                {
                                    "id": "760130107",
                                    "speaker": "维娜",
                                    "text": "#嗯嗯！{NICKNAME}想要问什么呢？",
                                    "choices": [
                                        {
                                            "id": "760130108",
                                            "text": "关于爱依菈说的那些话…",
                                            "response": [
                                                {
                                                    "id": "760130109",
                                                    "speaker": "维娜",
                                                    "text": "哼哼，这你就问对人啦！我这几天一直在思考，爱依菈大人那些话究竟是在什么时候记录下来的，她说的「毒蛇」又是什么。"
                                                },
                                                {
                                                    "id": "760130110",
                                                    "speaker": "维娜",
                                                    "text": "#现在，我已经完全理解了一切！{NICKNAME}还记不记得，影像里，爱依菈大人管交谈的对象叫「索洛维先生」？"
                                                },
                                                {
                                                    "id": "760130111",
                                                    "speaker": "维娜",
                                                    "text": "那个啊，毫无疑问，应该就是执灯人最初的创立者，至冬贵族出身的「索洛维」啦。"
                                                },
                                                {
                                                    "id": "760130112",
                                                    "speaker": "维娜",
                                                    "text": "根据记载，爱依菈大人正是在索洛维的请求下，前往北方的<color=#00E1FFFF>厄布拉神柱</color>，平息了深渊的灾厄。"
                                                },
                                                {
                                                    "id": "760130113",
                                                    "speaker": "维娜",
                                                    "text": "「像是早已知晓他的来意一般，新月的女使为他点燃了驱散黑暗的…」呃，总之就是帮了他的忙！"
                                                },
                                                {
                                                    "id": "760130114",
                                                    "speaker": "维娜",
                                                    "text": "所以呀，我猜她说的「毒蛇」，应该也就是深渊的隐喻吧？怎么样怎么样，是不是完美无缺的可靠推理！"
                                                },
                                                {
                                                    "id": "760130115",
                                                    "speaker": "维娜",
                                                    "text": "#至于爱依菈大人提到的「娄维娅」…嗯，我想想，{NICKNAME}知道<color=#00E1FFFF>亥珀波瑞亚</color>这个名字吗？",
                                                    "choices": [
                                                        {
                                                            "id": "760130116",
                                                            "text": "听说过。",
                                                            "response": [
                                                                {
                                                                    "id": "760130117",
                                                                    "speaker": "维娜",
                                                                    "text": "#原来如此原来如此，不愧是无比可靠的{NICKNAME}！这样解释起来就方便多啦。"
                                                                },
                                                                {
                                                                    "id": "760130118",
                                                                    "speaker": "维娜",
                                                                    "text": "「霜月之子」是亥珀波瑞亚的后裔，直到五百年前——也就是月之{RUBY#[D]库塔尔}少女诞生以前，沿用的都是亥珀波瑞亚那些古老的祭祀仪式。"
                                                                },
                                                                {
                                                                    "id": "760130119",
                                                                    "speaker": "维娜",
                                                                    "text": "「咏月使」是圣女爱依菈大人最初开始使用的头衔，在那之前，主持那些祭祀仪式的领袖被称作「主祭之人」。"
                                                                },
                                                                {
                                                                    "id": "760130120",
                                                                    "speaker": "维娜",
                                                                    "text": "而那位「娄维娅」，就是在爱依菈大人改革了霜月之子的信仰前，领导着亥珀波瑞亚遗民的最后一位「主祭之人」。"
                                                                },
                                                                {
                                                                    "id": "760130121",
                                                                    "speaker": "维娜",
                                                                    "text": "月之{RUBY#[D]库塔尔}少女尚未诞生、月光的{RUBY#[S]月矩力}祝福日渐枯竭的岁月里，她为了维持亥珀波瑞亚的古老仪式，犯下了亵渎神明的罪行。"
                                                                },
                                                                {
                                                                    "id": "760130122",
                                                                    "speaker": "维娜",
                                                                    "text": "因为她被施加了除忆…就是抹去了她的历史记录，所以具体的我也不清楚，只知道她和外面的坏家伙勾结，谋害了许多无辜的人。"
                                                                },
                                                                {
                                                                    "id": "760130123",
                                                                    "speaker": "维娜",
                                                                    "text": "据说，在爱依菈大人出生前，有位追随者只是因为爱上了至冬的军官，就在私奔后，被她直接派人…很过分吧？"
                                                                },
                                                                {
                                                                    "id": "760130124",
                                                                    "speaker": "维娜",
                                                                    "text": "总之，爱依菈大人就是从她手中接过了「霜月之子」，废止了亥珀波瑞亚的礼仪，要求我们全心全意敬奉月光。"
                                                                },
                                                                {
                                                                    "id": "760130125",
                                                                    "speaker": "维娜",
                                                                    "text": "#原则上来说，只有执祭以上的追随者才有资格知道这个名字…不过既然是{NICKNAME}，破例也没问题吧？嗯，没问题的！大概！"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "760130126",
                                                            "text": "不太清楚。",
                                                            "response": [
                                                                {
                                                                    "id": "760130127",
                                                                    "speaker": "维娜",
                                                                    "text": "嗯嗯，那我就从头说起好啦！哼哼，别担心，毕竟我可是无比可靠的执祭，领受月秩的…呃，总之我会说清楚的，大概！"
                                                                },
                                                                {
                                                                    "id": "760130128",
                                                                    "speaker": "维娜",
                                                                    "text": "「亥珀波瑞亚」是个已经灭亡的古代国家，我们「霜月之子」呢，就是那个国家流亡到这里的遗民后裔。"
                                                                },
                                                                {
                                                                    "id": "760130129",
                                                                    "speaker": "维娜",
                                                                    "text": "我们的祖先传承了很多古老的祭祀仪式，但那些仪式都是要依靠月光的{RUBY#[S]月矩力}祝福才能起效的。"
                                                                },
                                                                {
                                                                    "id": "760130130",
                                                                    "speaker": "维娜",
                                                                    "text": "那位「娄维娅」，就是在爱依菈大人改革了霜月之子的信仰前，领导着霜月之子的、很坏的大祭司。"
                                                                },
                                                                {
                                                                    "id": "760130131",
                                                                    "speaker": "维娜",
                                                                    "text": "但是呢，那个时候，月之{RUBY#[D]库塔尔}少女还没有诞生，月光的{RUBY#[S]月矩力}祝福也非常稀薄，很多仪式都没有办法起效了…"
                                                                },
                                                                {
                                                                    "id": "760130132",
                                                                    "speaker": "维娜",
                                                                    "text": "为了让仪式能像往常那样正常进行，那位很坏的大祭司做了很多坏事，还和霜月之子外的坏人勾结，伤害了许多人。"
                                                                },
                                                                {
                                                                    "id": "760130133",
                                                                    "speaker": "维娜",
                                                                    "text": "至于那位很坏的大祭司具体做了什么，我也不清楚，因为她的事迹已经被彻底从历史记录中抹去了。总之就是很坏！"
                                                                },
                                                                {
                                                                    "id": "760130134",
                                                                    "speaker": "维娜",
                                                                    "text": "据说，在爱依菈大人出生前，有位追随者只是因为爱上了至冬的军官，就在私奔后，被她直接派人…很过分吧？"
                                                                },
                                                                {
                                                                    "id": "760130135",
                                                                    "speaker": "维娜",
                                                                    "text": "后来，爱依菈大人从很坏的大祭司手里接过了「霜月之子」，废止了那些古代的仪式，要求我们全心全意敬奉月光。"
                                                                },
                                                                {
                                                                    "id": "760130136",
                                                                    "speaker": "维娜",
                                                                    "text": "#原则上来说，只有执祭以上的追随者才有资格知道这个名字…不过既然是{NICKNAME}，破例也没问题吧？嗯，没问题的！大概！"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "760130137",
                                            "text": "关于那把剑…",
                                            "response": [
                                                {
                                                    "id": "760130138",
                                                    "speaker": "维娜",
                                                    "text": "哦哦，不必担心！那把剑的事，我也已经和菈乌玛说过啦。既然爱依菈大人说要送给你，那就请随意使用吧。"
                                                },
                                                {
                                                    "id": "760130139",
                                                    "speaker": "维娜",
                                                    "text": "不过——呜啊，真是令人羡慕！传说中，爱依菈大人正是用这柄剑，向新诞生的月之{RUBY#[D]库塔尔}少女献上了第一滴银血…"
                                                },
                                                {
                                                    "id": "760130140",
                                                    "speaker": "维娜",
                                                    "text": "#那可是真正蒙受了祝福的无垢之剑，唯有纯净的人才有资格使用…{NICKNAME}果然是受神明眷爱的人呢。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "760130141",
                            "text": "再见。",
                            "response": [
                                {
                                    "id": "760130142",
                                    "speaker": "维娜",
                                    "text": "#嗯嗯，那就下次再见啦！一路顺——咳，不对，愿月光照亮你的前路，{NICKNAME}。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
