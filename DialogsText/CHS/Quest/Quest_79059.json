        {
            "id": "7905901",
            "objective": "(test)阅读广告牌$HIDDEN",
            "dialogues": [
                {
                    "id": "790590101",
                    "speaker": "片场备注",
                    "text": "此处为短剧《东行·旅途的开始》片场的弃用场景"
                },
                {
                    "id": "790590102",
                    "speaker": "片场备注",
                    "text": "原本构想的是试图从枫丹出发，向东前往须弥城寻找智慧宫不智之智的旅者的故事。"
                },
                {
                    "id": "790590103",
                    "speaker": "片场备注",
                    "text": "这一幕是他在路上解救了被巨岩压身的「变幻大师」，与之一起踏上旅途的情节。"
                },
                {
                    "id": "790590104",
                    "speaker": "片场备注",
                    "text": "啊不过，不管是饰演旅者的水形幻灵，还是饰演「变幻大师」的水形幻灵都不知道到哪去了。"
                },
                {
                    "id": "790590105",
                    "speaker": "片场备注",
                    "text": "如果能<color=#00E1FFFF>把他们全都找回来</color>，捕捉到在巨岩边练习的时刻…"
                }
            ]
        },
