    "talks": [
        {
            "id": "7616301",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "761630101",
                    "speaker": "卡侬",
                    "text": "…桑娜妲。仔细想想，最近这些年，你丢下工作，偷偷跑出去找人类玩的次数，好像越来越多了。"
                },
                {
                    "id": "761630102",
                    "speaker": "桑娜妲",
                    "text": "有、有什么关系嘛！工作丢给那些月使处理就可以了吧？"
                },
                {
                    "id": "761630103",
                    "speaker": "桑娜妲",
                    "text": "既然姐姐们看上的新主人愿意派手下分担我们的工作，那我也只好勉为其难地接受了！"
                },
                {
                    "id": "761630104",
                    "speaker": "桑娜妲",
                    "text": "更何况，卡侬姐姐不是也玩得很开心嘛！甚至都去参加人类的庆典了！"
                },
                {
                    "id": "761630105",
                    "speaker": "卡侬",
                    "text": "…那是我本职工作的一部分。他们的主祭呼唤我的名字，我当然要回应他们的声音。"
                },
                {
                    "id": "761630106",
                    "speaker": "艾莉亚",
                    "text": "嗯？假扮成普通人类少女，对着自己的神像跳舞也算是本职工作吗？"
                },
                {
                    "id": "761630107",
                    "speaker": "卡侬",
                    "text": "…艾莉亚。"
                },
                {
                    "id": "761630108",
                    "speaker": "艾莉亚",
                    "text": "卡侬妹妹。"
                },
                {
                    "id": "761630109",
                    "speaker": "卡侬",
                    "text": "…不是让你互叫名字…算了。既然那位新来的月使对于帮桑娜妲处理工作这件事也没什么意见…"
                },
                {
                    "id": "761630110",
                    "speaker": "艾莉亚",
                    "text": "兹白。她的名字是兹白。要好好记住别人的名字啦。"
                },
                {
                    "id": "761630111",
                    "speaker": "卡侬",
                    "text": "…既然兹白没有意见，那我也不多说什么了。不过，桑娜妲，作为月之意志，维系世界运转的术式基础是不能忘的。"
                },
                {
                    "id": "761630112",
                    "speaker": "卡侬",
                    "text": "做好心理准备。我要给你出些验证态射同构的基础题目。直到全部算完为止，不许再到地上去。"
                },
                {
                    "id": "761630113",
                    "speaker": "艾莉亚",
                    "text": "呵呵，真是坏心眼呢。简直就像是地上人的小说里，要把逃亡的公主抓回月亮上的反派一样。"
                },
                {
                    "id": "761630114",
                    "speaker": "桑娜妲",
                    "text": "就是就是！"
                },
                {
                    "id": "761630115",
                    "speaker": "卡侬",
                    "text": "…你自己就是月亮，不要说这种话。"
                }
            ]
        },
