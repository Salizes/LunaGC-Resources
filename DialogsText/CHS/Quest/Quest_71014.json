    "talks": [
        {
            "id": "7101401",
            "objective": "与落霞对话",
            "dialogues": [
                {
                    "id": "710140101",
                    "speaker": "落霞",
                    "text": "…用这种方式造访我们这「珠钿舫」，尊驾实在不同寻常。"
                },
                {
                    "id": "710140102",
                    "speaker": "Player",
                    "text": "只是想来看看…"
                },
                {
                    "id": "710140103",
                    "speaker": "落霞",
                    "text": "呵呵，这船上的人，谁又不是「只想来看看」，看着看着，却是再也离不开了。"
                },
                {
                    "id": "710140104",
                    "speaker": "落霞",
                    "text": "远来都是客，虽然您做客的方式突兀了些，但把您直接从船上赶走，也未免有失礼数。"
                },
                {
                    "id": "710140105",
                    "speaker": "落霞",
                    "text": "但是，这「珠钿舫」上的规矩也不能坏了，不然老板可就要来问奴家的罪了。"
                },
                {
                    "id": "710140106",
                    "speaker": "Player",
                    "text": "什么规矩？"
                },
                {
                    "id": "710140107",
                    "speaker": "落霞",
                    "text": "很简单，想要做客，自然要有人「邀请」才是客。"
                },
                {
                    "id": "710140108",
                    "speaker": "落霞",
                    "text": "明知规矩却又擅闯者，大多是心怀叵测的小贼罢了。"
                },
                {
                    "id": "710140109",
                    "speaker": "落霞",
                    "text": "呵呵，您不用在意，您不知规矩才无意闯入，不在小贼之列。"
                },
                {
                    "id": "710140110",
                    "speaker": "落霞",
                    "text": "您看这船上的人，都是受到了「邀请」的客人，而按照我们老板的规矩，他们也可以对人发出邀请。"
                },
                {
                    "id": "710140111",
                    "speaker": "落霞",
                    "text": "所以。您要是想时常来这做客，那去找船上的客人们讨得一份邀请函，是最快捷的路数了。",
                    "choices": [
                        {
                            "id": "710140112",
                            "text": "我知道了。",
                            "response": [
                                {
                                    "id": "710140113",
                                    "speaker": "落霞",
                                    "text": "不错，是个利落的人，奴家就在这等着您。"
                                }
                            ]
                        },
                        {
                            "id": "710140114",
                            "text": "你不能直接邀请我吗？",
                            "response": [
                                {
                                    "id": "710140115",
                                    "speaker": "落霞",
                                    "text": "呵呵，您倒是大胆，但奴家手里的邀请函，可不能随便交出去。"
                                },
                                {
                                    "id": "710140116",
                                    "speaker": "落霞",
                                    "text": "您还是找船上的宾客讨一份邀请函吧，奴家就在这等着您。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7101402",
            "objective": "向船上的人讨要邀请函",
            "dialogues": [
                {
                    "id": "710146201",
                    "speaker": "秋歌",
                    "text": "您拿到清心了吗？"
                },
                {
                    "id": "710146202",
                    "speaker": "Player",
                    "text": "找到了。"
                },
                {
                    "id": "710146203",
                    "speaker": "秋歌",
                    "text": "我看看…这些就足够了。希望师父的这个方子能让我的嗓子轻松点…"
                },
                {
                    "id": "710146204",
                    "speaker": "秋歌",
                    "text": "好啦，按照我们说好的。我已经把您的名字排在戏班的名单上了。"
                },
                {
                    "id": "710146205",
                    "speaker": "秋歌",
                    "text": "这样，在我们离船之前，您都可以留在船上。"
                },
                {
                    "id": "710146206",
                    "speaker": "秋歌",
                    "text": "您就趁着这个时间，去把那个邀请函拿到手吧。"
                },
                {
                    "id": "710146207",
                    "speaker": "Player",
                    "text": "你为什么帮我？"
                },
                {
                    "id": "710146208",
                    "speaker": "秋歌",
                    "text": "为什么帮您…怎么说呢…"
                },
                {
                    "id": "710146209",
                    "speaker": "秋歌",
                    "text": "我在做学徒的时候也曾经和您一样啦，想要抓住各种机会，出人头地证明自己…"
                },
                {
                    "id": "710146210",
                    "speaker": "秋歌",
                    "text": "一个人努力的滋味可不太好受，我也是因为有师父帮了一把，才有了现在的我。"
                },
                {
                    "id": "710146211",
                    "speaker": "秋歌",
                    "text": "现在我有了一点点能力，就轮到我来帮助别人啦。"
                },
                {
                    "id": "710146212",
                    "speaker": "秋歌",
                    "text": "哎呀，说太多了。我把您加入名单之后，也已经和落霞小姐说过了，她让您去见她。"
                },
                {
                    "id": "710146213",
                    "speaker": "秋歌",
                    "text": "别担心，我已经和她说好了，不会有问题的。"
                }
            ]
        },
        {
            "id": "7101403",
            "objective": "与翠儿对话",
            "dialogues": [
                {
                    "id": "710141101",
                    "speaker": "翠儿",
                    "text": "潮先生今天会来吗…"
                },
                {
                    "id": "710141102",
                    "speaker": "Player",
                    "text": "关于邀请函…"
                },
                {
                    "id": "710141103",
                    "speaker": "翠儿",
                    "text": "邀请函？抱歉，您找错人啦，我只是这艘船上的接待啦，没办法给您发邀请函。"
                },
                {
                    "id": "710141104",
                    "speaker": "翠儿",
                    "text": "不过，你没邀请函还能待在船上可真稀奇啊，一般来说，没拿邀请函上船的人，直接就会被送走了。"
                },
                {
                    "id": "710141105",
                    "speaker": "翠儿",
                    "text": "你是想要从船上的人手里拿到邀请函吗？那可是很难的啊，没人会轻易对陌生人发出邀请呢…"
                },
                {
                    "id": "710141106",
                    "speaker": "翠儿",
                    "text": "唔，这样吧，我帮你留意一下船上的客人，但作为交换，你要帮我个忙。"
                },
                {
                    "id": "710141107",
                    "speaker": "翠儿",
                    "text": "我的恋人叫做潮汐，我们俩约好，下次见面的时候他就会接我离开这里。"
                },
                {
                    "id": "710141108",
                    "speaker": "翠儿",
                    "text": "但我已经等了很久了，他却一直没有消息，我又一直在船上工作，没法上岸去找他…"
                },
                {
                    "id": "710141109",
                    "speaker": "翠儿",
                    "text": "你能帮我去送封信给他，问问他的情况吗？",
                    "choices": [
                        {
                            "id": "710141110",
                            "text": "交给我吧。",
                            "response": [
                                {
                                    "id": "710141111",
                                    "speaker": "翠儿",
                                    "text": "太好了，那就拜托你啦，我在船上等着你的消息，要快点回来啊。"
                                }
                            ]
                        },
                        {
                            "id": "710141112",
                            "text": "这名字有点熟悉…",
                            "response": [
                                {
                                    "id": "710141113",
                                    "speaker": "翠儿",
                                    "text": "他是一位很厉害的水手，听说过他的名字很正常啦。"
                                },
                                {
                                    "id": "710141114",
                                    "speaker": "翠儿",
                                    "text": "请你帮我把这封信送给他吧，我在船上等着你的消息，要快点回来啊。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7101404",
            "objective": "与关宏对话",
            "dialogues": [
                {
                    "id": "710142101",
                    "speaker": "关宏",
                    "text": "人生真是短暂啊…"
                },
                {
                    "id": "710142102",
                    "speaker": "Player",
                    "text": "关于邀请函…"
                },
                {
                    "id": "710142103",
                    "speaker": "关宏",
                    "text": "邀请函？你想要我邀请你吗？"
                },
                {
                    "id": "710142104",
                    "speaker": "关宏",
                    "text": "这可真是稀奇，居然有人先上了船，再找人要邀请函。"
                },
                {
                    "id": "710142105",
                    "speaker": "关宏",
                    "text": "不过很抱歉，我不会邀请你的。毕竟…我可信不过你这个生面孔。"
                }
            ]
        },
        {
            "id": "7101405",
            "objective": "与李九郎对话",
            "dialogues": [
                {
                    "id": "710143101",
                    "speaker": "李九郎",
                    "text": "好酒…好酒…哈哈哈，果然好酒…"
                },
                {
                    "id": "710143102",
                    "speaker": "Player",
                    "text": "关于邀请函…"
                },
                {
                    "id": "710143103",
                    "speaker": "李九郎",
                    "text": "好酒…好诗，嘿嘿，还有好人…"
                },
                {
                    "id": "710143104",
                    "speaker": "李九郎",
                    "text": "这么多东西，你想要哪一个？"
                },
                {
                    "id": "710143105",
                    "speaker": "李九郎",
                    "text": "我就只想要好酒，哈哈哈，一杯入喉，思如泉涌…"
                },
                {
                    "id": "710143106",
                    "speaker": "派蒙",
                    "text": "这人根本就听不进我们说话了，还是找别人吧…"
                }
            ]
        },
        {
            "id": "7101406",
            "objective": "与骆丰对话",
            "dialogues": [
                {
                    "id": "710144101",
                    "speaker": "骆丰",
                    "text": "咦？之前在船上从来没见过你。"
                },
                {
                    "id": "710144102",
                    "speaker": "骆丰",
                    "text": "难道…是新来的贵客，哎呀，这看上去果然是一表人才啊。"
                },
                {
                    "id": "710144103",
                    "speaker": "Player",
                    "text": "关于邀请函…"
                },
                {
                    "id": "710144104",
                    "speaker": "骆丰",
                    "text": "邀请函…您是还没收到邀请就上了船了？"
                },
                {
                    "id": "710144105",
                    "speaker": "骆丰",
                    "text": "这可真是稀奇，哈哈哈，阁下这也算是别有一番手段了。"
                },
                {
                    "id": "710144106",
                    "speaker": "骆丰",
                    "text": "唉，但是恕在下直言，这邀请函，可不是随便就能讨的东西啊…"
                },
                {
                    "id": "710144107",
                    "speaker": "骆丰",
                    "text": "我也不敢随意邀请他人，还请贵客海涵。"
                }
            ]
        },
        {
            "id": "7101407",
            "objective": "与马克西姆对话",
            "dialogues": [
                {
                    "id": "710145101",
                    "speaker": "马克西姆",
                    "text": "「珠钿舫」真是名不虚传呐…"
                },
                {
                    "id": "710145102",
                    "speaker": "Player",
                    "text": "关于邀请函…"
                },
                {
                    "id": "710145103",
                    "speaker": "马克西姆",
                    "text": "邀请函？你没收到邀请就上了船，到现在还没被赶下去？哈哈哈，这倒是挺稀奇的。"
                },
                {
                    "id": "710145104",
                    "speaker": "马克西姆",
                    "text": "不过，想从我这拿到邀请函的念头，你还是别想了。"
                },
                {
                    "id": "710145105",
                    "speaker": "马克西姆",
                    "text": "我在这还没玩够呢，可不想被突然赶下船。"
                }
            ]
        },
        {
            "id": "7101408",
            "objective": "与秋歌对话",
            "dialogues": [
                {
                    "id": "710146101",
                    "speaker": "秋歌",
                    "text": "咳咳，嗓子好痛…"
                },
                {
                    "id": "710146102",
                    "speaker": "秋歌",
                    "text": "咦，您是来听戏的吗？抱歉，我的喉咙不舒服，可能暂时不能唱戏了…"
                },
                {
                    "id": "710146103",
                    "speaker": "Player",
                    "text": "关于邀请函。"
                },
                {
                    "id": "710146104",
                    "speaker": "秋歌",
                    "text": "邀请函…您是还没收到邀请吗？但是很抱歉，我可没办法给您发邀请…"
                },
                {
                    "id": "710146105",
                    "speaker": "秋歌",
                    "text": "我不是客人，只是被雇来这里唱戏的，等戏唱完了，我也要下船的。"
                },
                {
                    "id": "710146106",
                    "speaker": "秋歌",
                    "text": "但是…咳咳，我这嗓子…这台戏估计还要点时间才能唱完了。"
                },
                {
                    "id": "710146107",
                    "speaker": "Player",
                    "text": "哪里才能拿到邀请函…"
                },
                {
                    "id": "710146108",
                    "speaker": "秋歌",
                    "text": "您想从这艘船上的客人手里拿到邀请函吗？我劝您还是别想啦。"
                },
                {
                    "id": "710146109",
                    "speaker": "秋歌",
                    "text": "来这艘「珠钿舫」上做客的人，基本上是不会有人对陌生人发出邀请的。"
                },
                {
                    "id": "710146110",
                    "speaker": "秋歌",
                    "text": "这么说可能有点不客气，但毕竟事关自己，不想担风险也正常啦。"
                },
                {
                    "id": "710146111",
                    "speaker": "秋歌",
                    "text": "您也是来这里玩的吗？虽然看起来装束有点不太像会来这里的人…"
                },
                {
                    "id": "710146112",
                    "speaker": "秋歌",
                    "text": "但我也能理解啦，想要开开眼界啦，想要结交些人啦之类的想法，毕竟这种机会可不常有。"
                },
                {
                    "id": "710146113",
                    "speaker": "秋歌",
                    "text": "唔，虽然我不能给您找到邀请函，但我有个能让您合理待在船上的办法。"
                },
                {
                    "id": "710146114",
                    "speaker": "秋歌",
                    "text": "不过作为交换，您得帮我个忙。我的嗓子很痛…想要找三份清心泡水喝，但一直没下船的机会。"
                },
                {
                    "id": "710146115",
                    "speaker": "秋歌",
                    "text": "您能帮我拿三份清心回来吗？",
                    "choices": [
                        {
                            "id": "710146116",
                            "text": "交给我吧。",
                            "response": [
                                {
                                    "id": "710146117",
                                    "speaker": "秋歌",
                                    "text": "那就拜托您啦，等您回来，我会把那个办法告诉您的。"
                                }
                            ]
                        },
                        {
                            "id": "710146118",
                            "text": "只要这些？",
                            "response": [
                                {
                                    "id": "710146119",
                                    "speaker": "秋歌",
                                    "text": "不是什么大事，这些就足够了。等您回来，我会把那个办法告诉您的。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7101409",
            "objective": "将信件交给潮汐",
            "dialogues": [
                {
                    "id": "710141201",
                    "speaker": "潮汐",
                    "text": "思妹妹，我刚从海上回来，想要先休息一下，我们先别谈这件事了。"
                },
                {
                    "id": "710141202",
                    "speaker": "思思",
                    "text": "可我前几天就看见你在港口里…"
                },
                {
                    "id": "710141203",
                    "speaker": "潮汐",
                    "text": "那是船上的人临时派我回来港口购置物资。"
                },
                {
                    "id": "710141204",
                    "speaker": "潮汐",
                    "text": "这次我回来也是临时告假，为了让船长准我的假可费了大功夫…"
                },
                {
                    "id": "710141205",
                    "speaker": "思思",
                    "text": "汐哥哥…",
                    "choices": [
                        {
                            "id": "710141206",
                            "text": "这封信是给你的。",
                            "response": [
                                {
                                    "id": "710141207",
                                    "speaker": "潮汐",
                                    "text": "信？给我的？我看看，这笔迹是…"
                                },
                                {
                                    "id": "710141208",
                                    "speaker": "潮汐",
                                    "text": "这…这说来就来啊…这准是船上的人催我回去的信。"
                                },
                                {
                                    "id": "710141209",
                                    "speaker": "思思",
                                    "text": "可是，你才待了多久，难道又要回去了吗？"
                                },
                                {
                                    "id": "710141210",
                                    "speaker": "潮汐",
                                    "text": "唉，思妹妹，你不要急，我已经有准备了。"
                                },
                                {
                                    "id": "710141211",
                                    "speaker": "潮汐",
                                    "text": "这位朋友，你把这封信带回去吧，让船上的人再宽限我几天。"
                                }
                            ]
                        },
                        {
                            "id": "710141212",
                            "text": "翠儿给你的信。",
                            "response": [
                                {
                                    "id": "710141213",
                                    "speaker": "思思",
                                    "text": "翠儿？怎么听着像女孩的名字？"
                                },
                                {
                                    "id": "710141214",
                                    "speaker": "潮汐",
                                    "text": "的确是女孩。她是我们船上的水手，字写得最好了，船上对外的书信都是找她代笔。"
                                },
                                {
                                    "id": "710141215",
                                    "speaker": "潮汐",
                                    "text": "唉，我不看都知道，这封信准是船上送来催我回去的…"
                                },
                                {
                                    "id": "710141216",
                                    "speaker": "思思",
                                    "text": "可是，你才待了多久，难道又要回去了吗？"
                                },
                                {
                                    "id": "710141217",
                                    "speaker": "潮汐",
                                    "text": "唉，思妹妹，你不要急，我已经有准备了。"
                                },
                                {
                                    "id": "710141218",
                                    "speaker": "潮汐",
                                    "text": "这位朋友，你把这封信带回去吧，让船上的人再宽限我几天。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7101410",
            "objective": "将回信带给翠儿",
            "dialogues": [
                {
                    "id": "710141301",
                    "speaker": "翠儿",
                    "text": "你们把信送给潮先生了吗？"
                },
                {
                    "id": "710141302",
                    "speaker": "Player",
                    "text": "这是他的回信。"
                },
                {
                    "id": "710141303",
                    "speaker": "翠儿",
                    "text": "谢谢你们！潮先生居然给我回信了，太好了…"
                },
                {
                    "id": "710141304",
                    "speaker": "翠儿",
                    "text": "邀请函的事，我也会帮你们留意的，如果有消息的话一定马上告诉你们。"
                },
                {
                    "id": "710141305",
                    "speaker": "翠儿",
                    "text": "嗯…不过，你们可别抱太大的希望喔，很少有客人愿意对陌生人发出邀请。"
                },
                {
                    "id": "710141306",
                    "speaker": "翠儿",
                    "text": "如果一位被邀请人做出了什么坏规矩的事，被取消了邀请…"
                },
                {
                    "id": "710141307",
                    "speaker": "翠儿",
                    "text": "那对他发出邀请的人，也同样会被取消邀请的。"
                },
                {
                    "id": "710141308",
                    "speaker": "翠儿",
                    "text": "不过你们也别气馁啦，试一试总是好的，我会帮你留意的。"
                },
                {
                    "id": "710141309",
                    "speaker": "翠儿",
                    "text": "潮先生给我的回信不知道里面写了什么，嘿嘿，我要留到晚上好好地看…"
                }
            ]
        },
        {
            "id": "7101411",
            "objective": "将三份清心带给秋歌",
            "dialogues": []
        },
        {
            "id": "7101412",
            "objective": "与秋歌对话",
            "dialogues": []
        },
        {
            "id": "7101413",
            "objective": "与落霞对话",
            "dialogues": [
                {
                    "id": "710146301",
                    "speaker": "落霞",
                    "text": "看来，您没有拿到邀请函呢。",
                    "choices": [
                        {
                            "id": "710146302",
                            "text": "我会拿到的。",
                            "response": [
                                {
                                    "id": "710146303",
                                    "speaker": "落霞",
                                    "text": "就和我们老板说得一样…您似乎永远不会气馁。"
                                },
                                {
                                    "id": "710146304",
                                    "speaker": "落霞",
                                    "text": "但现在您做的事，已经足够了。"
                                },
                                {
                                    "id": "710146308",
                                    "speaker": "落霞",
                                    "text": "您在船上其他的客人那里碰壁的事，我已经听说了。不过，除了这些事，我还听说了别的事。"
                                },
                                {
                                    "id": "710146309",
                                    "speaker": "落霞",
                                    "text": "翠儿正在船上到处悄悄地问侍者，哪些客人比较好说话，哪些客人比较容易亲近。"
                                },
                                {
                                    "id": "710146310",
                                    "speaker": "落霞",
                                    "text": "秋歌刚刚把您的名字写进了她们戏班里，还和我说，您是她刚刚请来的人，让我别忙着把您赶下船。"
                                },
                                {
                                    "id": "710146311",
                                    "speaker": "落霞",
                                    "text": "您不觉得有意思吗？那些贵客轻易地将您拒之门外，反而是普通的人更愿意向您伸出援手。"
                                },
                                {
                                    "id": "710146312",
                                    "speaker": "落霞",
                                    "text": "呵呵，这些事您就自己想一想吧，至于邀请函的事，您就不用担心了。"
                                },
                                {
                                    "id": "710146313",
                                    "speaker": "落霞",
                                    "text": "让您去讨邀请函的事，只是我们老板给您安排的一点小事。"
                                },
                                {
                                    "id": "710146314",
                                    "speaker": "落霞",
                                    "text": "至于您的邀请函，他其实早就亲自写给我了，他让我在您办完这些事后，再把邀请函的事告诉您。"
                                },
                                {
                                    "id": "710146315",
                                    "speaker": "落霞",
                                    "text": "从此之后，您可以在「珠钿舫」上自由来去。",
                                    "choices": [
                                        {
                                            "id": "710146316",
                                            "text": "你们老板是谁？",
                                            "response": [
                                                {
                                                    "id": "710146317",
                                                    "speaker": "落霞",
                                                    "text": "我们老板名叫柔然，说不定…您在哪里已经见过他了，"
                                                },
                                                {
                                                    "id": "710146320",
                                                    "speaker": "落霞",
                                                    "text": "好了，奴家能告诉您的事，已经全部告诉您了。"
                                                },
                                                {
                                                    "id": "710146321",
                                                    "speaker": "落霞",
                                                    "text": "如果您以后再想来这「珠钿舫」上玩一玩，就不用费力飞过来了。"
                                                },
                                                {
                                                    "id": "710146322",
                                                    "speaker": "落霞",
                                                    "text": "我们在港口派有一位名叫平海的摆渡人，负责客人在船上的来去，您想来的话，和他打个招呼就是。"
                                                },
                                                {
                                                    "id": "710146323",
                                                    "speaker": "落霞",
                                                    "text": "我已经把他招到了船上，您想要回港的话，就和他说一声吧。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "710146318",
                                            "text": "为什么要给我安排这些？",
                                            "response": [
                                                {
                                                    "id": "710146319",
                                                    "speaker": "落霞",
                                                    "text": "这是老板的意思，奴家可不敢妄自揣测。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "710146305",
                            "text": "还要一段时间。",
                            "response": [
                                {
                                    "id": "710146306",
                                    "speaker": "落霞",
                                    "text": "呵呵，我不怀疑您的能力，只要给您足够的时间，无论是什么事您都能办好。"
                                },
                                {
                                    "id": "710146307",
                                    "speaker": "落霞",
                                    "text": "但现在您做的事，已经足够了。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7101414",
            "objective": "与平海对话，返回璃月港",
            "dialogues": [
                {
                    "id": "710146501",
                    "speaker": "Player",
                    "text": "我要回港。"
                },
                {
                    "id": "710146502",
                    "speaker": "平海",
                    "text": "好嘞，您这边登船。"
                }
            ]
        },
        {
            "id": "7101415",
            "objective": "保护TransmitPlayer$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7101402",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "710140201",
                    "speaker": "落霞",
                    "text": "您想要回港的话，和船上的平海说一声就是。"
                },
                {
                    "id": "710140202",
                    "speaker": "落霞",
                    "text": "以后您想再来这，也可以去港口边找他，他会直接送你过来。"
                }
            ]
        },
        {
            "id": "7101403",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "710140301",
                    "speaker": "落霞",
                    "text": "用这种方式造访我们这「珠钿舫」，尊驾实在不同寻常…"
                },
                {
                    "id": "710140302",
                    "speaker": "落霞",
                    "text": "不过想要在这长留，您还是得拿到一份邀请函才行。"
                }
            ]
        },
        {
            "id": "7101414",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "710141401",
                    "speaker": "翠儿",
                    "text": "潮先生现在到底在做什么呢…"
                }
            ]
        },
        {
            "id": "7101464",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "710146401",
                    "speaker": "平海",
                    "text": "您就是那位贵客吧？要回港的话，和小的说一声就是。"
                }
            ]
        },
        {
            "id": "7101466",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "710146601",
                    "speaker": "Player",
                    "text": "暂时不回港。"
                },
                {
                    "id": "710146602",
                    "speaker": "平海",
                    "text": "您要回港的时候和我说一声就行。"
                }
            ]
        },
        {
            "id": "7101467",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "710146701",
                    "speaker": "落霞",
                    "text": "用这种方式造访我们这「珠钿舫」，尊驾实在不同寻常…"
                },
                {
                    "id": "710146702",
                    "speaker": "落霞",
                    "text": "不过想要在这长留，您还是得拿到一份邀请函才行。"
                }
            ]
        },
        {
            "id": "7101468",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "710146801",
                    "speaker": "落霞",
                    "text": "您想要回港的话，和船上的平海说一声就是。"
                },
                {
                    "id": "710146802",
                    "speaker": "落霞",
                    "text": "以后您想再来这，也可以去港口边找他，他会直接送你过来。"
                }
            ]
        },
        {
            "id": "7101469",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "710146901",
                    "speaker": "秋歌",
                    "text": "找到清心之后就回来吧，我已经想好办法了。"
                }
            ]
        },
        {
            "id": "7101491",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "710149101",
                    "speaker": "翠儿",
                    "text": "放心吧，有什么消息的话，我就会告诉你的。"
                }
            ]
        },
        {
            "id": "7101492",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "710149201",
                    "speaker": "关宏",
                    "text": "抱歉，我是不会邀请你这么一位生面孔的。"
                }
            ]
        },
        {
            "id": "7101493",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "710149301",
                    "speaker": "李九郎",
                    "text": "好酒…好酒…哈哈哈，果然好酒…"
                }
            ]
        },
        {
            "id": "7101494",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "710149401",
                    "speaker": "骆丰",
                    "text": "我实在是不敢随意邀请他人，还请贵客海涵。"
                }
            ]
        },
        {
            "id": "7101495",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "710149501",
                    "speaker": "马克西姆",
                    "text": "别想了，我是不会邀请你的。"
                }
            ]
        },
        {
            "id": "7101496",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "710149601",
                    "speaker": "秋歌",
                    "text": "快去找落霞小姐吧，别担心，我已经和她说好了。"
                }
            ]
        },
        {
            "id": "7101497",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "710149701",
                    "speaker": "秋歌",
                    "text": "怎么样，落霞小姐答应让你在船上呆着了吧。"
                },
                {
                    "id": "710149702",
                    "speaker": "Player",
                    "text": "我拿到邀请函了。"
                },
                {
                    "id": "710149703",
                    "speaker": "秋歌",
                    "text": "咦？邀请函…是落霞小姐给你的吗？"
                },
                {
                    "id": "710149704",
                    "speaker": "秋歌",
                    "text": "你到底…是什么来历呀，居然能让落霞小姐亲自给你发邀请函。"
                },
                {
                    "id": "710149705",
                    "speaker": "秋歌",
                    "text": "总之还是恭喜你啦，这份邀请函可是很珍贵的，我师父都没有。"
                },
                {
                    "id": "710149706",
                    "speaker": "秋歌",
                    "text": "哎呀，但是你的名字我刚写进戏班的名册里，也已经报上去了，一时半会还划不掉…",
                    "choices": [
                        {
                            "id": "710149707",
                            "text": "这样挺好的。",
                            "response": [
                                {
                                    "id": "710149708",
                                    "speaker": "秋歌",
                                    "text": "你不介意的话就最好了，那以后记得多来戏班里玩啊，我嗓子好了之后，就可以唱戏啦。"
                                },
                                {
                                    "id": "710149712",
                                    "speaker": "秋歌",
                                    "text": "邀请函…什么时候我也能有一份呢…"
                                }
                            ]
                        },
                        {
                            "id": "710149709",
                            "text": "以后可以找我帮忙。",
                            "response": [
                                {
                                    "id": "710149710",
                                    "speaker": "秋歌",
                                    "text": "不会的，不会的！我只是帮你挂个名，不会有什么事情麻烦你的。"
                                },
                                {
                                    "id": "710149711",
                                    "speaker": "秋歌",
                                    "text": "可以的话，以后你就多来戏班里玩玩吧，我嗓子好了之后，就可以唱戏啦。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7101498",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "710149801",
                    "speaker": "思思",
                    "text": "汐哥哥，那你不是过不了多久又要回船上去了？"
                },
                {
                    "id": "710149802",
                    "speaker": "潮汐",
                    "text": "唉，我也不想，可能这就是水手的宿命吧…"
                },
                {
                    "id": "710149803",
                    "speaker": "思思",
                    "text": "汐哥哥…"
                }
            ]
        }
    ]
}