            "dialogues": [
                {
                    "id": "750861801",
                    "speaker": "拉密萨纳",
                    "text": "筹备得怎么样了？"
                },
                {
                    "id": "750861802",
                    "speaker": "帕朗",
                    "text": "还算顺利吧…不过真的要这么做吗？时间上会不会有点太苛刻了…"
                },
                {
                    "id": "750861803",
                    "speaker": "拉密萨纳",
                    "text": "这样才显得真实嘛。而且可以掩盖很多问题…总之听我的准没错。"
                },
                {
                    "id": "750861804",
                    "speaker": "帕朗",
                    "text": "既然你都这么说了…"
                }
