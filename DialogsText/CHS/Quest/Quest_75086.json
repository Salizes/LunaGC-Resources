        {
            "id": "7508602",
            "objective": "前往飞行竞赛的起点",
            "dialogues": [
                {
                    "id": "750860201",
                    "speaker": "莉瓦",
                    "text": "准备好了吗？"
                }
            ]
        },
        {
            "id": "7508603",
            "objective": "与莉瓦对话",
            "dialogues": [
                {
                    "id": "750861901",
                    "speaker": "Player",
                    "text": "现在开始吧。"
                }
            ]
        },
        {
            "id": "7508601",
            "objective": "(test)子任务描述Test$HIDDEN",
            "dialogues": [
                {
                    "id": "750862001",
                    "speaker": "Player",
                    "text": "还要再准备一下。"
                },
                {
                    "id": "750862002",
                    "speaker": "莉瓦",
                    "text": "嗯，我等你。"
                }
            ]
        },
        {
            "id": "7508604",
            "objective": "通过飞行竞赛的全部挑战",
            "dialogues": [
                {
                    "id": "750860401",
                    "speaker": "派蒙",
                    "text": "呼——现在应该没事了。"
                },
                {
                    "id": "750860402",
                    "speaker": "派蒙",
                    "text": "本来应该付报酬的委托人不知所踪，现在还被人误会成坏蛋的帮手，真是倒霉！"
                },
                {
                    "id": "750860403",
                    "speaker": "派蒙",
                    "text": "不过被动挨打可不是我们的作风，就由我们来查明真相吧，也很担心塔卢加和奥伯龙呢。"
                },
                {
                    "id": "750860404",
                    "speaker": "派蒙",
                    "text": "要是靠拉密萨纳…根本靠不住嘛！现在也没有其他线索，不如回事发现场…终点看看？"
                }
            ]
        },
        {
            "id": "7508615",
            "objective": "抵达终点",
            "dialogues": [
                {
                    "id": "750861501",
                    "speaker": "派蒙",
                    "text": "我们顺利到终点啦！"
                },
                {
                    "id": "750861502",
                    "speaker": "特马乔",
                    "text": "恭喜！以你的实力来当教练都绰绰有余了吧？"
                },
                {
                    "id": "750861503",
                    "speaker": "派蒙",
                    "text": "莉瓦好像没落后太多，应该马上就能到吧…希望她和龙都没事。"
                },
                {
                    "id": "750861504",
                    "speaker": "派蒙",
                    "text": "不过，塔卢加和奥伯龙怎么不在终点…是在别的地方休息吗？要不要找找看呢？"
                }
            ]
        },
        {
            "id": "7508616",
            "objective": "寻找塔卢加",
            "dialogues": [
                {
                    "id": "750861601",
                    "speaker": "塔卢加",
                    "text": "他肯定在谋划些什么危险的事…"
                },
                {
                    "id": "750861602",
                    "speaker": "奥伯龙",
                    "text": "呜？"
                },
                {
                    "id": "750861603",
                    "speaker": "塔卢加",
                    "text": "唉，你就好了，除了吃饼干和飞行，什么都不用想。"
                },
                {
                    "id": "750861604",
                    "speaker": "奥伯龙",
                    "text": "啊呜！"
                },
                {
                    "id": "750861605",
                    "speaker": "塔卢加",
                    "text": "我没在夸你啦。"
                }
            ]
        },
        {
            "id": "7508605",
            "objective": "帮助拉密萨纳",
            "dialogues": [
                {
                    "id": "750860501",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "呀！呀呀！"
                },
                {
                    "id": "750860502",
                    "speaker": "派蒙",
                    "text": "#{REALNAME[ID(2)|SHOWHOST(true)]}，你发现什么了？欸？这不是什么都没有吗？"
                },
                {
                    "id": "750860503",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "呜…呀！呀呀呀！"
                },
                {
                    "id": "750860504",
                    "speaker": "派蒙",
                    "text": "看得出来你是真的很想告诉我们什么，唉，要是能听懂你在说什么就好了，可我毕竟不是龙嘛。"
                },
                {
                    "id": "750860505",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "呜…"
                },
                {
                    "id": "750860506",
                    "speaker": "Player",
                    "text": "让我试试。"
                },
                {
                    "id": "750860507",
                    "speaker": "派蒙",
                    "text": "对哦，说不定是只有龙才能发现的线索。"
                },
                {
                    "id": "750860508",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "呀呀！"
                }
            ]
        },
        {
            "id": "7508606",
            "objective": "与拉密萨纳对话",
            "dialogues": [
                {
                    "id": "750860601",
                    "speaker": "拉密萨纳",
                    "text": "怎么会搞成这样！"
                },
                {
                    "id": "750860602",
                    "speaker": "派蒙",
                    "text": "我们还想问你呢！到底发生什么事了？还有，塔卢加和奥伯龙怎么不在？"
                },
                {
                    "id": "750860603",
                    "speaker": "帕朗",
                    "text": "抱歉我来晚了！其他选手的龙出了点状况…咦？"
                },
                {
                    "id": "750860604",
                    "speaker": "拉密萨纳",
                    "text": "你们怎么才来？这下全都不对了，没有哪怕一件事是按计划进行的…"
                },
                {
                    "id": "750860605",
                    "speaker": "莉瓦",
                    "text": "你们到底在说什么，我怎么一点也听不懂…塔卢加呢？怎么不见他？"
                },
                {
                    "id": "750860606",
                    "speaker": "拉密萨纳",
                    "text": "他被掳走了，奥伯龙也和他一起。就是刚才那群龙，发了疯似的攻击我们，趁着我招架的工夫把他带走了。"
                },
                {
                    "id": "750860607",
                    "speaker": "莉瓦",
                    "text": "欸？！我、我得去找他！"
                },
                {
                    "id": "750860608",
                    "speaker": "派蒙",
                    "text": "就算要找他也得有线索才行吧，你先等一下！现在总算可以找本人问问清楚了，那个我们一直想知道的问题。"
                },
                {
                    "id": "750860609",
                    "speaker": "Player",
                    "text": "拉密萨纳的计划。"
                },
                {
                    "id": "750860610",
                    "speaker": "Black Screen",
                    "text": "简短地向众人说明了塔卢加对拉密萨纳的怀疑，为了免去解释的麻烦，隐去了潜入营地调查的部分…"
                },
                {
                    "id": "750860611",
                    "speaker": "帕朗",
                    "text": "#拉密萨纳，全都告诉{M#他们}{F#她们}吧，现在隐瞒只会让事情变得更复杂。"
                },
                {
                    "id": "750860612",
                    "speaker": "拉密萨纳",
                    "text": "可恶…但现在不是顾忌面子的时候，你说的对。好吧，我的确有一个计划，而且是塔卢加不会喜欢的计划。"
                },
                {
                    "id": "750860613",
                    "speaker": "拉密萨纳",
                    "text": "我的计划原本是很完美的。我和塔卢加的赛道跟你们不同，但终点一样，我们先出发，自然也会先到。"
                },
                {
                    "id": "750860614",
                    "speaker": "拉密萨纳",
                    "text": "按计划，你们…莉瓦抵达终点时，就会看到那个傲慢的小鬼…咳，看到塔卢加被「失控的龙」围攻，他们还小，当然不是对手。"
                },
                {
                    "id": "750860615",
                    "speaker": "拉密萨纳",
                    "text": "莉瓦肯定想解救自己的弟弟，但你的龙也不是擅长战斗的类型吧。那么唯一可以依靠的自然就只有我了。"
                },
                {
                    "id": "750860616",
                    "speaker": "拉密萨纳",
                    "text": "只要这时候我展示出可靠的一面，赶走「失控的龙」，救下姐弟俩，莉瓦对我的评价也会和现在不同吧。"
                },
                {
                    "id": "750860617",
                    "speaker": "拉密萨纳",
                    "text": "不是常说，紧张的悸动和恋爱的心动十分相似，甚至很容易误认…",
                    "choices": [
                        {
                            "id": "750860618",
                            "text": "等一下，怎么没有我的戏份？",
                            "response": [
                                {
                                    "id": "750860619",
                                    "speaker": "拉密萨纳",
                                    "text": "你不是只是来凑数…"
                                },
                                {
                                    "id": "750860620",
                                    "speaker": "帕朗",
                                    "text": "你是出于意外临时顶替的选手！而且原本如果一切顺利，这件事应该能在不给你添太多麻烦的情况下收尾的…"
                                },
                                {
                                    "id": "750860622",
                                    "speaker": "帕朗",
                                    "text": "要让这么多人…和龙，在指定的时间段做指定的事，变数太大，我也劝过他了…"
                                },
                                {
                                    "id": "750860623",
                                    "speaker": "莉瓦",
                                    "text": "如果不是我的龙突然状态不好，我是应该能赶上的！要是有我在，怎么会眼睁睁看着塔卢加被带走…"
                                },
                                {
                                    "id": "750860624",
                                    "speaker": "派蒙",
                                    "text": "唔…可是这个计划里并没有塔卢加真的被掳走的部分吧？"
                                },
                                {
                                    "id": "750860625",
                                    "speaker": "拉密萨纳",
                                    "text": "问题就在这里，「失控的龙」不应该真的失控，毕竟它们都是经过训练，能够听懂指令的…"
                                },
                                {
                                    "id": "750860626",
                                    "speaker": "拉密萨纳",
                                    "text": "葵莉娅小姐，我认为你需要给我一个合理的解释。"
                                },
                                {
                                    "id": "750860627",
                                    "speaker": "葵莉娅",
                                    "text": "你在怀疑我吗？那可真叫人寒心。我们家那可都是训练有素的好孩子，能准确无误地执行我下达的指令。"
                                },
                                {
                                    "id": "750860628",
                                    "speaker": "葵莉娅",
                                    "text": "绝不会无故伤人，更别提把奥伯龙和塔卢加掳走了。除非…除非有人用了邪术之类的控制了它们，逼迫它们这样做。"
                                },
                                {
                                    "id": "750860629",
                                    "speaker": "葵莉娅",
                                    "text": "说起来，近来有龙贩子在附近出没呢，就是那个臭名昭著的豪卡。我想帕朗应该对他很了解？"
                                },
                                {
                                    "id": "750860630",
                                    "speaker": "葵莉娅",
                                    "text": "我因为生意上的关系，对他的事迹也有所耳闻。只要是他盯上的龙，没有他得不了手的。"
                                },
                                {
                                    "id": "750860631",
                                    "speaker": "葵莉娅",
                                    "text": "而且听说豪卡最近找了个得力的帮手，是个金发的年轻人，还带着只白色的宠物，和他的身份很不相称吧？"
                                },
                                {
                                    "id": "750860632",
                                    "speaker": "葵莉娅",
                                    "text": "依我看，说不定目标不是塔卢加而是奥伯龙，那只小绒翼龙只要稍加训练，今后一定前途无量。"
                                },
                                {
                                    "id": "750860633",
                                    "speaker": "葵莉娅",
                                    "text": "很有可能是豪卡看上了这只小龙，所以借着帮手的关系潜入了飞行学校内部，意外发现可以利用这个机会…"
                                },
                                {
                                    "id": "750860634",
                                    "speaker": "拉密萨纳",
                                    "text": "#最近潜入飞行学校的金发的年轻人，还带着白色的宠物…那不就是{NICKNAME}和旁边那个白色的家伙吗？"
                                },
                                {
                                    "id": "750860635",
                                    "speaker": "派蒙",
                                    "text": "我才不是什么白色宠物啦！而且我们根本就不认识什么豪卡…"
                                },
                                {
                                    "id": "750860636",
                                    "speaker": "帕朗",
                                    "text": "豪卡叔叔…豪卡是我的叔叔，很早之前就被部族放逐了，我也几乎没有和他联络过。"
                                },
                                {
                                    "id": "750860637",
                                    "speaker": "派蒙",
                                    "text": "哦，这么说来，帕朗和加勒弗大汪不也是金发年轻人和白色宠物的组合吗！啊…坏了，塔卢加明明提醒过我不要说这种话…"
                                },
                                {
                                    "id": "750860638",
                                    "speaker": "葵莉娅",
                                    "text": "说句公道话，如果是帕朗的话，的确有很多作案的机会。你和我敲定计划细节的那天，他在里间，不是吗？"
                                },
                                {
                                    "id": "750860639",
                                    "speaker": "拉密萨纳",
                                    "text": "不，帕朗是个诚实的人，这一点大家有目共睹，我不相信他会做这种事。"
                                },
                                {
                                    "id": "750860640",
                                    "speaker": "莉瓦",
                                    "text": "他对塔卢加和奥伯龙也一向很关照，我也不认为他会做出这种伤害他们的事。"
                                },
                                {
                                    "id": "750860641",
                                    "speaker": "帕朗",
                                    "text": "谢谢你们…"
                                },
                                {
                                    "id": "750860642",
                                    "speaker": "拉密萨纳",
                                    "text": "#那果然还是{NICKNAME}这边比较可疑…"
                                },
                                {
                                    "id": "750860643",
                                    "speaker": "派蒙",
                                    "text": "#呜哇，{NICKNAME}快把冒险之证亮给他们看看，我们是正牌冒险家，一点也不可疑！而且…而且…对了！没有动机！"
                                },
                                {
                                    "id": "750860644",
                                    "speaker": "派蒙",
                                    "text": "我们可是接了塔卢加的委托呢，他好好待在这里才能给我们委托的报酬，我们的收入来源很正规的！"
                                },
                                {
                                    "id": "750860645",
                                    "speaker": "拉密萨纳",
                                    "text": "似乎也有些道理。可是这样就没有其他金发的嫌疑人了…"
                                },
                                {
                                    "id": "750860646",
                                    "speaker": "拉密萨纳",
                                    "text": "不对，也有可能根本没有金发的嫌疑人，果然还是葵莉娅小姐更可疑，用假消息来误导我们…"
                                },
                                {
                                    "id": "750860647",
                                    "speaker": "葵莉娅",
                                    "text": "唉…你不会接受帕朗背叛了你们的信任这种说法是吗？"
                                },
                                {
                                    "id": "750860648",
                                    "speaker": "拉密萨纳",
                                    "text": "当然，我是不会怀疑自己的朋友的。"
                                },
                                {
                                    "id": "750860649",
                                    "speaker": "葵莉娅",
                                    "text": "好吧，我刚刚想起了一件事，就在我们商讨细节的第二天晚上，我在营地见到了一只小嵴锋龙。"
                                },
                                {
                                    "id": "750860650",
                                    "speaker": "葵莉娅",
                                    "text": "那只小嵴锋龙很有活力，角上还有特别的花纹…这里为什么会有「迷路」的小嵴锋龙？除非它的人类同伴就在附近。"
                                },
                                {
                                    "id": "750860651",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "呜？"
                                },
                                {
                                    "id": "750860652",
                                    "speaker": "拉密萨纳",
                                    "text": "原来你们真是龙贩子的同伙，破坏了我完美的计划…"
                                },
                                {
                                    "id": "750860653",
                                    "speaker": "莉瓦",
                                    "text": "难道你们接近塔卢加就是为了抢走奥伯龙？他明明夸了你们那么多，要是知道了真相，得有多伤心啊。"
                                },
                                {
                                    "id": "750860654",
                                    "speaker": "派蒙",
                                    "text": "不对不对，我们明明就是同一天去的，还不是因为塔卢加拜托我们…哦！难怪之前觉得帕朗的声音耳熟…"
                                },
                                {
                                    "id": "750860655",
                                    "speaker": "葵莉娅",
                                    "text": "所以说你也承认你们的确潜入了我的营地？真是可怕，我一点也没发现你们的所作所为！"
                                },
                                {
                                    "id": "750860656",
                                    "speaker": "Player",
                                    "text": "派蒙…"
                                },
                                {
                                    "id": "750860657",
                                    "speaker": "派蒙",
                                    "text": "原来是在套我的话！我们只是听到一点对话啦，最、最多就是打翻了些饼干…应该没那么严重吧？"
                                },
                                {
                                    "id": "750860658",
                                    "speaker": "拉密萨纳",
                                    "text": "#帕朗、莉瓦，和我一起抓住{M#他们}{F#她们}！不管用什么手段，一定要问出塔卢加和奥伯龙的下落！",
                                    "choices": [
                                        {
                                            "id": "750860659",
                                            "text": "我想要的不是这样的戏份。",
                                            "response": [
                                                {
                                                    "id": "750860660",
                                                    "speaker": "派蒙",
                                                    "text": "#跟他们完全讲不通，{NICKNAME}，我们先避一避吧！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "750860661",
                                            "text": "走为上策！",
                                            "response": [
                                                {
                                                    "id": "750860662",
                                                    "speaker": "派蒙",
                                                    "text": "嗯！现在和他们纠缠不是个好主意…"
                                                },
                                                {
                                                    "id": "750860663",
                                                    "speaker": "Black Screen",
                                                    "text": "费了一番工夫，好不容易摆脱了拉密萨纳等人…"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "750860621",
                            "text": "这计划真够潦草的。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7508609",
            "objective": "摆脱追捕，想想下一步的计划",
            "dialogues": []
        },
        {
