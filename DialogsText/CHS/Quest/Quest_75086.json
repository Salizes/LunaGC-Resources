            "objective": "返回事发现场",
            "dialogues": []
        },
        {
            "id": "7508611",
            "objective": "和龙伙伴一起寻找线索",
            "dialogues": []
        },
        {
            "id": "7508603",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "750860301",
                    "speaker": "莉瓦",
                    "text": "你来了！塔卢加一直说你很厉害，让我在飞行竞赛时不要跟丢你了。"
                },
                {
                    "id": "750860302",
                    "speaker": "莉瓦",
                    "text": "这孩子，话里话外没一点觉得我能赢的意思，让我做姐姐的面子往哪里摆？"
                },
                {
                    "id": "750860303",
                    "speaker": "莉瓦",
                    "text": "所以待会儿的比试我是不会放水的，你也不要有所保留，让我们各自全力以赴，分个高下吧！",
                    "choices": [
                        {
                            "id": "750860304",
                            "text": "你会后悔让我动真格的。",
                            "response": [
                                {
                                    "id": "750860305",
                                    "speaker": "莉瓦",
                                    "text": "就是这份气势！"
                                },
                                {
                                    "id": "750860308",
                                    "speaker": "莉瓦",
                                    "text": "话不多说，你准备好了的话，我们这就开始吧。"
                                }
                            ]
                        },
                        {
                            "id": "750860306",
                            "text": "我的目标是参与奖。",
                            "response": [
                                {
                                    "id": "750860307",
                                    "speaker": "莉瓦",
                                    "text": "你这么说难道是想让我放松警惕？哼哼，我可不会上当！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7508617",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "750861701",
                    "speaker": "莉瓦",
                    "text": "真期待啊，飞行竞赛…"
                },
                {
                    "id": "750861702",
                    "speaker": "莉瓦",
                    "text": "可以明确地感知到自己和龙伙伴的进步，对训练来说也是件好事呢！"
                }
