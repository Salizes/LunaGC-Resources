        },
        {
            "id": "7508758",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "750875801",
                    "speaker": "特马乔",
                    "text": "我们这儿还有几项飞行挑战，具体内容都写在告示牌上了，如果你感兴趣不妨试试，当然也会有对应的奖励。",
                    "choices": [
                        {
                            "id": "750875802",
                            "text": "关于帕帕卡飞行学校…",
                            "response": [
                                {
                                    "id": "750875803",
                                    "speaker": "特马乔",
                                    "text": "其实我也不知道为什么会叫这个名字，说起帕帕卡…你听过昆图尔和坏巫师茹米的故事吗？"
                                },
                                {
                                    "id": "750875804",
                                    "speaker": "特马乔",
                                    "text": "部族的战士输给了坏巫师茹米，被他变成了帕帕卡…听起来好像不是什么好事？可能帕帕卡真的飞得很快吧，谁知道呢。"
                                }
                            ]
                        },
                        {
                            "id": "750875805",
                            "text": "关于拉密萨纳…",
                            "response": [
                                {
                                    "id": "750875806",
                                    "speaker": "特马乔",
                                    "text": "哈哈…他是个好手，但不擅长教人。当飞行竞赛的对手…还算说得过去？"
                                },
                                {
                                    "id": "750875807",
                                    "speaker": "特马乔",
                                    "text": "要不是飞得不好，谁会来这里呢？这时候如果太过严厉…唉，以前可不是没发生过这种事。"
                                },
                                {
                                    "id": "750875808",
                                    "speaker": "特马乔",
                                    "text": "所以现在的方针已经改成鼓励为主了，相信多夸夸也能有进步的。"
                                }
                            ]
                        },
                        {
                            "id": "750875809",
                            "text": "再见。",
                            "response": [
                                {
                                    "id": "750875810",
                                    "speaker": "特马乔",
                                    "text": "再见，也欢迎你随时回来。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7508762",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "750876201",
                    "speaker": "琪希可",
                    "text": "欢迎来到帕帕卡飞行学校！",
                    "choices": [
