    "talks": [
        {
            "id": "7104601",
            "objective": "test隐藏-璃月三阶段完成前-千岩军的对话$HIDDEN",
            "dialogues": [
                {
                    "id": "710460101",
                    "speaker": "千岩军兵士",
                    "text": "请留步！层岩巨渊重地，闲人勿入！"
                }
            ]
        },
        {
            "id": "7104602",
            "objective": "test隐藏-璃月三阶段完成后-千岩军的对话$HIDDEN",
            "dialogues": [
                {
                    "id": "710460201",
                    "speaker": "铁弘",
                    "text": "请留步！层岩巨渊禁地，外来旅客请…啊，是你！"
                },
                {
                    "id": "710460202",
                    "speaker": "派蒙",
                    "text": "糟了，快跑！",
                    "choices": [
                        {
                            "id": "710460203",
                            "text": "派蒙，别闹。",
                            "response": [
                                {
                                    "id": "710460206",
                                    "speaker": "铁弘",
                                    "text": "哈哈哈哈…抱歉吓到你们了。救命恩人我怎么能不记得！"
                                },
                                {
                                    "id": "710460207",
                                    "speaker": "铁弘",
                                    "text": "我也是最近才换防过来的…没想到正巧能在这里遇到恩人，真是好运气呀。"
                                },
                                {
                                    "id": "710460208",
                                    "speaker": "派蒙",
                                    "text": "恩人…？我们做过什么好事吗？"
                                },
                                {
                                    "id": "710460209",
                                    "speaker": "铁弘",
                                    "text": "哪里的话！大家对付海中大魔那时候，我也在群玉阁呀。受了点伤，前阵子才好利索…"
                                },
                                {
                                    "id": "710460210",
                                    "speaker": "铁弘",
                                    "text": "可能你对我没什么印象，不过我可忘不了你。并肩作战的兄弟们都见证了你对璃月的付出。"
                                },
                                {
                                    "id": "710460211",
                                    "speaker": "Player",
                                    "text": "关于层岩巨渊…"
                                },
                                {
                                    "id": "710460212",
                                    "speaker": "铁弘",
                                    "text": "前两年矿洞里发生了不明原因的事故，被七星下令关停了。矿工也大多安然无恙地疏散了出来…"
                                },
                                {
                                    "id": "710460213",
                                    "speaker": "铁弘",
                                    "text": "只不过呀，可惜了，这么大的一座矿就这样停产了。工人们领了补贴就各做各的营生去了…唉，一朝人散了，再重聚就难了。"
                                },
                                {
                                    "id": "710460214",
                                    "speaker": "铁弘",
                                    "text": "啊，抱歉扯远了。我相信你是有要事才会来这里，就不先拦着你了。有什么事请直接去找沐宁吧，他就在入口处的营地里。"
                                },
                                {
                                    "id": "710460215",
                                    "speaker": "铁弘",
                                    "text": "呃…不是不信任，只是职责所系。我还是要叮嘱一句，可不要在这里做违法乱纪的事情哦！"
                                },
                                {
                                    "id": "710460216",
                                    "speaker": "派蒙",
                                    "text": "放心吧，你还信不过我们吗！"
                                }
                            ]
                        },
                        {
                            "id": "710460204",
                            "text": "你认得我？"
                        },
                        {
                            "id": "710460205",
                            "text": "被认出来了，快跑！"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7104603",
