    },
    "talks": [
        {
            "id": "2004401",
            "objective": "与艾琳对话",
            "dialogues": [
                {
                    "id": "200440101",
                    "speaker": "艾琳",
                    "text": "伤脑筋…这里要怎么解决啊…"
                },
                {
                    "id": "200440102",
                    "speaker": "Player",
                    "text": "你在做什么呢？"
                },
                {
                    "id": "200440103",
                    "speaker": "艾琳",
                    "text": "为了下一次的骑士选拔，我正在训练呢。"
                },
                {
                    "id": "200440104",
                    "speaker": "艾琳",
                    "text": "唔…不过，我可没有琴大人那样的力量。"
                },
                {
                    "id": "200440105",
                    "speaker": "艾琳",
                    "text": "比起锻炼「力量」，我觉得学习「技巧」更适合我。"
                },
                {
                    "id": "200440106",
                    "speaker": "艾琳",
                    "text": "比如，一口气把这些木桩全部破坏掉的方法…"
                },
                {
                    "id": "200440107",
                    "speaker": "艾琳",
                    "text": "你有空的话，也和我一起来想一想吧。",
                    "choices": [
                        {
                            "id": "200440108",
                            "text": "我想一想。",
                            "response": [
                                {
                                    "id": "200440110",
                                    "speaker": "艾琳",
                                    "text": "没关系，好好想喔，木桩不会自己跑掉。"
                                },
                                {
                                    "id": "200440111",
                                    "speaker": "艾琳",
                                    "text": "唯一会自己跑掉的只有被消耗的时间和生命，唔…"
                                },
                                {
                                    "id": "200440114",
                                    "speaker": "艾琳",
                                    "text": "要是能用更大一些的武器，或者和琴大人一样，使用元素的力量，也许就能轻松破坏掉全部木桩了吧。"
                                }
                            ]
                        },
                        {
                            "id": "200440109",
                            "text": "我们两个一起上…",
                            "response": [
                                {
                                    "id": "200440112",
                                    "speaker": "艾琳",
                                    "text": "你习惯团体作战吗？真羡慕啊…随时都能叫到帮手的人。"
                                },
                                {
                                    "id": "200440113",
                                    "speaker": "艾琳",
                                    "text": "像我这样的，只能学习独自作战啦。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2004402",
            "objective": "在2秒内摧毁所有木桩",
            "dialogues": [
                {
                    "id": "200440201",
                    "speaker": "艾琳",
                    "text": "怎么样？想到好方法了吗？"
                },
                {
                    "id": "200440202",
                    "speaker": "Player",
                    "text": "还没有想好…"
                },
                {
                    "id": "200440203",
                    "speaker": "艾琳",
                    "text": "嗯…我之前遇见的冒险家，有些也偶尔会这样呢。"
                },
                {
                    "id": "200440204",
                    "speaker": "艾琳",
                    "text": "面对怪物时能利落地战斗，打木桩的时候却手忙脚乱。"
                },
                {
                    "id": "200440205",
                    "speaker": "艾琳",
                    "text": "而且还用各种手段加固木桩，就像生怕自己能轻松击碎一样…"
                },
                {
                    "id": "200440206",
                    "speaker": "艾琳",
                    "text": "这么想寻求挑战的话，直接去野外找强大的魔物不就好了吗？"
                }
            ]
        },
        {
            "id": "2004403",
            "objective": "与艾琳对话",
            "dialogues": [
                {
                    "id": "200440301",
                    "speaker": "艾琳",
                    "text": "做到了！"
                },
                {
                    "id": "200440302",
                    "speaker": "艾琳",
                    "text": "原来还能这么解决…这种方法我想都没想过。"
                },
                {
                    "id": "200440303",
                    "speaker": "艾琳",
                    "text": "谢谢你，我自己去再试试看！"
                }
            ]
        }
    ]
}