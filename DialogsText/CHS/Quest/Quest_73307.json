    "talks": [
        {
            "id": "7330701",
            "objective": "(test)(隐藏)获得斯露莎小道具后才能接取任务$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7330705",
            "objective": "(test)(隐藏)判断是否获取过羽毛，设置reminder group变量$HIDDEN",
            "dialogues": [
                {
                    "id": "733070501",
                    "speaker": "祖尔宛",
                    "text": "嗯，流散在大地上的花灵，似乎都已经回到花海来了。"
                },
                {
                    "id": "733070502",
                    "speaker": "祖尔宛",
                    "text": "真是辛苦你们了，不愧是被斯露莎选定的「谒颂主」。"
                },
                {
                    "id": "733070503",
                    "speaker": "斯露莎",
                    "text": "前辈这话我就当是夸我了。"
                },
                {
                    "id": "733070504",
                    "speaker": "派蒙",
                    "text": "嘿嘿，花海看起来也热闹了很多的样子。"
                },
                {
                    "id": "733070505",
                    "speaker": "派蒙",
                    "text": "天上的大窟窿也解决掉了，看来已经完全恢复生机了呢！"
                },
                {
                    "id": "733070506",
                    "speaker": "派蒙",
                    "text": "不过说起来还真是神奇，既然花灵本来都是从水里面诞生的，那样的话不是应该叫「水灵」才对吗？"
                },
                {
                    "id": "733070507",
                    "speaker": "斯露莎",
                    "text": "白飘飘怎么还乱给我们起名字的！"
                },
                {
                    "id": "733070508",
                    "speaker": "祖尔宛",
                    "text": "呵呵，不过说到「水灵」，我倒是想起了些过去的事…",
                    "choices": [
                        {
                            "id": "733070509",
                            "text": "关于「水灵」的事情吗？",
                            "response": [
                                {
                                    "id": "733070511",
                                    "speaker": "祖尔宛",
                                    "text": "很久很久以前，曾有许多来自异乡的纯水之灵穿越重重阻隔来到这里。"
                                },
                                {
                                    "id": "733070512",
                                    "speaker": "祖尔宛",
                                    "text": "那时花海外除了黄沙之外，尚有不少魔物肆虐。对于这些水之亲眷而言，这番旅途想必也很辛苦吧。"
                                },
                                {
                                    "id": "733070513",
                                    "speaker": "祖尔宛",
                                    "text": "虽然她们似乎是为了那位已殁之神而来，但结果却并没有在这里找到她们想要的东西。"
                                },
                                {
                                    "id": "733070514",
                                    "speaker": "祖尔宛",
                                    "text": "在看到万种母树的模样后，她们很快便四散离开了。"
                                },
                                {
                                    "id": "733070515",
                                    "speaker": "祖尔宛",
                                    "text": "后来，纯水之灵的传说流传开来，又有很多异国之人，沿着她们所走过的道路行进，试图寻找她们的秘密。"
                                },
                                {
                                    "id": "733070516",
                                    "speaker": "祖尔宛",
                                    "text": "虽说最初不过是以讹传讹，不过久而久之，这条道路本身也被赋予了舍弃自我，寻找纯真之类的意义。"
                                },
                                {
                                    "id": "733070517",
                                    "speaker": "祖尔宛",
                                    "text": "即便后来花海不再对外开放，他们的朝圣之旅也持续了相当长的一段时间。"
                                },
                                {
                                    "id": "733070518",
                                    "speaker": "祖尔宛",
                                    "text": "或许对于他们而言，比起到达终点，旅途的过程可能更有意义吧。"
                                },
                                {
                                    "id": "733070519",
                                    "speaker": "祖尔宛",
                                    "text": "就像是比起一劳永逸的牺牲，为了使命而努力的过程才更有意义一样呢。"
                                },
                                {
                                    "id": "733070520",
                                    "speaker": "斯露莎",
                                    "text": "怎么说到最后，结果又落到我头上了啦！"
                                }
                            ]
                        },
                        {
                            "id": "733070510",
                            "text": "希望不会太长…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7330706",
            "objective": "「灵谷木」的秘密",
            "dialogues": [
                {
                    "id": "733070601",
                    "speaker": "祖尔宛",
                    "text": "是斯露莎和她的「谒颂主」…嚯呀，连派蒙也在。"
                },
                {
                    "id": "733070602",
                    "speaker": "派蒙",
                    "text": "喂，我怎么就是「连」和「也」啦！"
                },
                {
                    "id": "733070603",
                    "speaker": "祖尔宛",
                    "text": "这个先不提，看你们的样子是发现了什么有趣的事吗？"
                },
                {
                    "id": "733070604",
                    "speaker": "派蒙",
                    "text": "也不算是有趣的事啦…"
                },
                {
                    "id": "733070605",
                    "speaker": "Black Screen",
                    "text": "向祖尔宛转述了「灵谷木」的事情…"
                },
                {
                    "id": "733070606",
                    "speaker": "祖尔宛",
                    "text": "嗯…该从哪说起呢？"
                },
                {
                    "id": "733070607",
                    "speaker": "祖尔宛",
                    "text": "你们遇到的确实是花灵所化的「灵谷木」没错，不过寄宿在其中的，与其说是残存的魂灵，不如说是记忆的破片才对。"
                },
                {
                    "id": "733070608",
                    "speaker": "祖尔宛",
                    "text": "就像你们拿到的那个「净光翎」，其中可就蕴藏着未能回归大地的记忆呢。",
                    "choices": [
                        {
                            "id": "733070609",
                            "text": "未能回归大地…",
                            "response": [
                                {
                                    "id": "733070613",
                                    "speaker": "祖尔宛",
                                    "text": "我们花灵从花海的甘露中诞生，最终也会回归到花海当中。"
                                },
                                {
                                    "id": "733070614",
                                    "speaker": "祖尔宛",
                                    "text": "与镇护此处的神明一样，我们是被流淌在大地中的时轮之流所拒绝的种类。"
                                },
                                {
                                    "id": "733070615",
                                    "speaker": "祖尔宛",
                                    "text": "当然这也是我们的衷心所愿，不使漆黑之物同我们一起流入大地是我们的使命。"
                                },
                                {
                                    "id": "733070616",
                                    "speaker": "祖尔宛",
                                    "text": "在「甘露池」中，我们得以用甘露洗净所沾染的污秽。"
                                },
                                {
                                    "id": "733070617",
                                    "speaker": "祖尔宛",
                                    "text": "只要将你们手中的「净光翎」供奉到「甘露池」中，那流散在外的花灵便能重回花海的怀抱。"
                                },
                                {
                                    "id": "733070618",
                                    "speaker": "派蒙",
                                    "text": "哦哦，看来我们还真是做了件好事呢。"
                                },
                                {
                                    "id": "733070619",
                                    "speaker": "斯露莎",
                                    "text": "哼，白飘飘一副了不起的样子，其实还不是靠了我的伟力。"
                                },
                                {
                                    "id": "733070620",
                                    "speaker": "派蒙",
                                    "text": "嗯嗯，斯露莎也很厉害啦！"
                                },
                                {
                                    "id": "733070621",
                                    "speaker": "斯露莎",
                                    "text": "这还差不多…不对，我可不需要白飘飘的夸赞，我只要有「谒颂主」就够了。"
                                },
                                {
                                    "id": "733070622",
                                    "speaker": "祖尔宛",
                                    "text": "说到「谒颂主」，既然你也算是接受了这一名号，那倒还真是完成这一仪式的不二人选了。"
                                },
                                {
                                    "id": "733070623",
                                    "speaker": "祖尔宛",
                                    "text": "在古时，与花灵同行的人类勇士，会为流散在沙漠中的花灵举行净罪的仪式，将她们带回花海。"
                                },
                                {
                                    "id": "733070624",
                                    "speaker": "祖尔宛",
                                    "text": "而这些与花灵建立起了特殊连结的人，便被称为「谒颂主」。"
                                },
                                {
                                    "id": "733070625",
                                    "speaker": "派蒙",
                                    "text": "这跟斯露莎说的可完全不一样！"
                                },
                                {
                                    "id": "733070626",
                                    "speaker": "祖尔宛",
                                    "text": "哎呀哎呀，这样也算是歪打正着了。作为「谒颂主」，你们可肩负着救助失落花灵的责任呢。"
                                },
                                {
                                    "id": "733070627",
                                    "speaker": "祖尔宛",
                                    "text": "若是再遇到那样的「灵谷木」，便拜托将其结出的「净光翎」带回花海来吧。"
                                },
                                {
                                    "id": "733070628",
                                    "speaker": "派蒙",
                                    "text": "就算你不这样说，我们也是会帮助那些花灵的啦！"
                                }
                            ]
                        },
                        {
                            "id": "733070610",
                            "text": "供奉到「甘露池」的也是…",
                            "response": [
                                {
                                    "id": "733070611",
                                    "speaker": "祖尔宛",
                                    "text": "「净光翎」是神鸟「西摩格」的灵光所化，而我们花灵最初也是因着灵光与甘露的结合而诞生的。"
                                },
                                {
                                    "id": "733070612",
                                    "speaker": "祖尔宛",
                                    "text": "也正因此我们才被称为灵光的后嗣。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
