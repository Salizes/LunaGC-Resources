        {
            "id": "7407699",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "740769901",
                    "speaker": "派蒙",
                    "text": "前面就是最后的地方了吧？"
                },
                {
                    "id": "740769902",
                    "speaker": "派蒙",
                    "text": "一定要赶上啊。"
                },
                {
                    "id": "740769903",
                    "speaker": "？？？",
                    "text": "那我就视作你收下我们的邀请函了。"
                },
                {
                    "id": "740769904",
                    "speaker": "派蒙",
                    "text": "发生什么事了？！"
                }
            ]
