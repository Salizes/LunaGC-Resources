    "talks": [
        {
            "id": "7407607",
            "objective": "前往最后的封印",
            "dialogues": []
        },
        {
            "id": "7407601",
            "objective": "前往最后的封印",
            "dialogues": [
                {
                    "id": "740760101",
                    "speaker": "卡特皮拉",
                    "text": "最后只剩下这里了。"
                },
                {
                    "id": "740760102",
                    "speaker": "安",
                    "text": "好在入口还是封住的状态。"
                },
                {
                    "id": "740760103",
                    "speaker": "安",
                    "text": "看来那个雅各布并没有解答这里的谜题。"
                },
                {
                    "id": "740760104",
                    "speaker": "卡特皮拉",
                    "text": "或者他解答出来了，却无法奉上谜底。"
                },
                {
                    "id": "740760105",
                    "speaker": "派蒙",
                    "text": "我想想，之前的答案分别是「影子」、「生命」和「爱」。"
                },
                {
                    "id": "740760106",
                    "speaker": "西摩尔",
                    "text": "然后根据之前的规律，我的逻辑模块推测碑文如下："
                },
                {
                    "id": "740760107",
                    "speaker": "西摩尔",
                    "text": "「从不分离」…「生于一瞬，常与相违，伴你长眠」…"
                },
                {
                    "id": "740760108",
                    "speaker": "派蒙",
                    "text": "然后最后一句写的是——「原初一滴」。"
                },
                {
                    "id": "740760109",
                    "speaker": "派蒙",
                    "text": "卡特皮拉、西摩尔，你们知不知道这个答案的谜底啊？"
                }
            ]
        },
        {
            "id": "7407602",
            "objective": "与大家对话",
            "dialogues": [
                {
                    "id": "740760401",
                    "speaker": "卡特皮拉",
                    "text": "我对「原初一滴」这个词有些想法。"
                },
                {
                    "id": "740760402",
                    "speaker": "卡特皮拉",
                    "text": "听起来像是说世界创造之后的第一场雨。这种意象应该是古枫丹和水仙十字结社都很喜欢的。"
                },
                {
                    "id": "740760403",
                    "speaker": "派蒙",
                    "text": "那这怎么可能找得到嘛！"
                },
                {
                    "id": "740760404",
                    "speaker": "卡特皮拉",
                    "text": "所以这一滴水已经融在所有水之中了。每一滴水都是原初的一滴。"
                },
                {
                    "id": "740760405",
                    "speaker": "卡特皮拉",
                    "text": "就像是原初的神把伟大的潜力散布了开来。我们每个人身体里也都有神圣的成分。"
                },
                {
                    "id": "740760406",
                    "speaker": "派蒙",
                    "text": "但是答案这么简单的话，前面那人应该可以很简单就供奉出答案啊。"
                },
                {
                    "id": "740760407",
                    "speaker": "卡特皮拉",
                    "text": "确实如此。应该是我错了。"
                },
                {
                    "id": "740760408",
                    "speaker": "卡特皮拉",
                    "text": "虽然它不是正确答案，但它仍然是个好答案。我只能觉得设置谜题的人不懂浪漫了。"
                },
                {
                    "id": "740760409",
                    "speaker": "派蒙",
                    "text": "他还笑你不懂安保呢！"
                },
                {
                    "id": "740760410",
                    "speaker": "西摩尔",
                    "text": "我无法作答。关于原初一滴的搜索结果有一千二百条。"
                },
                {
                    "id": "740760411",
                    "speaker": "西摩尔",
                    "text": "「世界上第一滴酒传说是风神…」",
                    "choices": [
                        {
                            "id": "740760412",
                            "text": "好了，不用继续了。",
                            "response": [
                                {
                                    "id": "740760413",
                                    "speaker": "西摩尔",
                                    "text": "好的。"
                                },
                                {
                                    "id": "740760416",
                                    "speaker": "安",
                                    "text": "这个，我似乎有些东西可以分享。"
                                },
                                {
                                    "id": "740760417",
                                    "speaker": "安",
                                    "text": "有一个传说，纯水精灵是前代水神的第一滴泪。"
                                },
                                {
                                    "id": "740760418",
                                    "speaker": "安",
                                    "text": "而大地上的第一滴泪，正是最早纯水精灵理解了人类之后流下的。"
                                },
                                {
                                    "id": "740760419",
                                    "speaker": "派蒙",
                                    "text": "世界上最早的眼泪不应该是第一个人类的婴儿哭出来吗？"
                                },
                                {
                                    "id": "740760420",
                                    "speaker": "安",
                                    "text": "动物的流泪其实是排出盐分，而人类在那个平稳的年代，就连出生时都是欢笑着呼吸的。"
                                },
                                {
                                    "id": "740760421",
                                    "speaker": "安",
                                    "text": "——传说是这么说的啦。"
                                },
                                {
                                    "id": "740760422",
                                    "speaker": "西摩尔",
                                    "text": "其实我认为婴儿的哭泣和动物的排盐可以视作类似的非感性行为。"
                                },
                                {
                                    "id": "740760423",
                                    "speaker": "西摩尔",
                                    "text": "婴儿哭泣有外界刺激和为了尽快填充肺部的双重原因。须弥的生论派教材是这么写的。"
                                },
                                {
                                    "id": "740760424",
                                    "speaker": "派蒙",
                                    "text": "所以答案是，纯水精灵吗？"
                                },
                                {
                                    "id": "740760425",
                                    "speaker": "派蒙",
                                    "text": "那确实前面那人可能供奉不出正确答案呢。",
                                    "choices": [
                                        {
                                            "id": "740760426",
                                            "text": "死马当活马医吧。",
                                            "response": [
                                                {
                                                    "id": "740760427",
                                                    "speaker": "派蒙",
                                                    "text": "我觉得这个方向还是很靠谱的！"
                                                },
                                                {
                                                    "id": "740760430",
                                                    "speaker": "卡特皮拉",
                                                    "text": "这个以我对水仙十字结社的理解来说，似乎也很合理。"
                                                },
                                                {
                                                    "id": "740760431",
                                                    "speaker": "卡特皮拉",
                                                    "text": "不知在何处做梦的「红女皇」，永远口是心非的「梦中人」。"
                                                },
                                                {
                                                    "id": "740760432",
                                                    "speaker": "派蒙",
                                                    "text": "你说的这些话比谜语本身还难懂欸。"
                                                },
                                                {
                                                    "id": "740760433",
                                                    "speaker": "卡特皮拉",
                                                    "text": "有什么关系嘛。已经是最后的关头了。不论怎么样，在这件事最后，谜底就会揭晓。"
                                                },
                                                {
                                                    "id": "740760434",
                                                    "speaker": "Player",
                                                    "text": "安，那就麻烦你了。"
                                                },
                                                {
                                                    "id": "740760435",
                                                    "speaker": "安",
                                                    "text": "嗯，让我试试吧。万一我失败了，你们赶紧想想别的答案吧。"
                                                },
                                                {
                                                    "id": "740760436",
                                                    "speaker": "派蒙",
                                                    "text": "打开了！"
                                                },
                                                {
                                                    "id": "740760437",
                                                    "speaker": "卡特皮拉",
                                                    "text": "一定要拿到最后这块，不然圣剑就会落到水仙十字结社的手里了。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "740760428",
                                            "text": "我觉得这个方向还是很靠谱的！",
                                            "response": [
                                                {
                                                    "id": "740760429",
                                                    "speaker": "派蒙",
                                                    "text": "比起找风神之酒的死马当活马医行为好多了！"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "740760414",
                            "text": "试试吧，咱们去蒙德…",
                            "response": [
                                {
                                    "id": "740760415",
                                    "speaker": "派蒙",
                                    "text": "你要死马当活马医的话可以换个靠谱的方向吧！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7407603",
            "objective": "解开象限内的谜题",
            "dialogues": [
                {
                    "id": "740760301",
                    "speaker": "卡特皮拉",
                    "text": "最后只剩下这里了。"
                },
                {
                    "id": "740760302",
                    "speaker": "派蒙",
                    "text": "之前的探索都没有收获…"
                },
                {
                    "id": "740760303",
                    "speaker": "卡特皮拉",
                    "text": "嗯。但是，这里的入口还关着，说明我们还有机会。"
                },
                {
                    "id": "740760304",
                    "speaker": "卡特皮拉",
                    "text": "看来我们的竞争者没有解出这里的谜题。"
                },
                {
                    "id": "740760305",
                    "speaker": "派蒙",
                    "text": "不过，说到底，到底是谁会跟我们抢这个呀？"
                },
                {
                    "id": "740760306",
                    "speaker": "卡特皮拉",
                    "text": "假定数百年的岁月里水仙十字结社没能再度兴起，而是陷入沉寂，我所具有的知识依旧具有意义，那结合此前的情况来看——"
                },
                {
                    "id": "740760307",
                    "speaker": "卡特皮拉",
                    "text": "恐怕是雅各布吧。"
                },
                {
                    "id": "740760308",
                    "speaker": "安",
                    "text": "是那个欺负西摩尔的坏人？他要这些东西干什么…"
                },
                {
                    "id": "740760309",
                    "speaker": "卡特皮拉",
                    "text": "他的目的恐怕与我们的目的相同：寻找锻铸水仙十字圣剑的材料。"
                },
                {
                    "id": "740760310",
                    "speaker": "卡特皮拉",
                    "text": "水仙十字结社依据地下之国与古枫丹的神秘哲学，在物质世界重现了必要的四种架空物质。"
                },
                {
                    "id": "740760311",
                    "speaker": "西摩尔",
                    "text": "无法理解。"
                },
                {
                    "id": "740760312",
                    "speaker": "卡特皮拉",
                    "text": "神秘的东西本身只作用于体验，可以说比元素力还要跳脱常理呢。"
                },
                {
                    "id": "740760313",
                    "speaker": "西摩尔",
                    "text": "几十年前我录入过教令院的素论派入门至中级教材，元素力也没有那么神奇。"
                },
                {
                    "id": "740760314",
                    "speaker": "卡特皮拉",
                    "text": "是吗。那反正结论上来说，这是枫丹古法与地下古国技术的交汇。"
                },
                {
                    "id": "740760315",
                    "speaker": "卡特皮拉",
                    "text": "世界上出现了「记忆」、「愿望」、「灵魂」与「人格」这四种物质。"
                },
                {
                    "id": "740760316",
                    "speaker": "卡特皮拉",
                    "text": "为了防止歧义，我们把它们叫做「记忆」之块、「愿望」之块、「灵魂」之块与「人格」之块好了。"
                },
                {
                    "id": "740760317",
                    "speaker": "派蒙",
                    "text": "为什么这些东西会用来打造圣剑啊？"
                },
                {
                    "id": "740760318",
                    "speaker": "卡特皮拉",
                    "text": "水仙十字结社的神秘哲学里，神殿是宇宙的缩影，社员是众神的代行，圣油是锤炼的意志。"
                },
                {
                    "id": "740760319",
                    "speaker": "卡特皮拉",
                    "text": "圣剑，则是破开一切的「理性」。它需由完整的人之意志诞生而出。"
                },
                {
                    "id": "740760320",
                    "speaker": "Player",
                    "text": "好玄乎。"
                },
                {
                    "id": "740760321",
                    "speaker": "卡特皮拉",
                    "text": "哎呀，神秘哲学是这样的。看着相似就可以攀附。当这种东西变成魔法了就假成真的了。"
                },
                {
                    "id": "740760322",
                    "speaker": "卡特皮拉",
                    "text": "无论如何，我们的对手没有解开谜题；抑或是他解答出来了，却无法奉上谜底。既然对手是雅各布，那看来情况是后者。"
                },
                {
                    "id": "740760323",
                    "speaker": "西摩尔",
                    "text": "此处的碑文写着：「从不分离」…「生于一瞬，常与相违，伴你长眠」…"
                },
                {
                    "id": "740760324",
                    "speaker": "派蒙",
                    "text": "然后最后一句写的是——「原初一滴」。"
                },
                {
                    "id": "740760325",
                    "speaker": "卡特皮拉",
                    "text": "之前几处地方应该也有这种谜题吧。那些谜底，你们还记得吗？"
                },
                {
                    "id": "740760326",
                    "speaker": "Player",
                    "text": "「影子」。"
                },
                {
                    "id": "740760327",
                    "speaker": "Player",
                    "text": "「生命」。"
                },
                {
                    "id": "740760328",
                    "speaker": "Player",
                    "text": "「爱」。"
                },
                {
                    "id": "740760329",
                    "speaker": "派蒙",
                    "text": "唔，答案逐步抽象了起来。"
                },
                {
                    "id": "740760330",
                    "speaker": "派蒙",
                    "text": "卡特皮拉、西摩尔，你们知不知道这个谜题的答案呀？"
                }
            ]
        },
        {
            "id": "7407604",
            "objective": "获取「人格」之块",
            "dialogues": []
        },
        {
            "id": "7407605",
            "objective": "与大家对话",
            "dialogues": [
                {
                    "id": "740760501",
                    "speaker": "安",
                    "text": "前方就是「人格」之块吗？"
                },
                {
                    "id": "740760502",
                    "speaker": "西摩尔",
                    "text": "无法从密度分析眼前的物质。似乎重量为…零。"
                },
                {
                    "id": "740760503",
                    "speaker": "卡特皮拉",
                    "text": "看来我们拿下了最后一分。这样至少就可以和对面斡旋一下了。"
                },
                {
                    "id": "740760504",
                    "speaker": "派蒙",
                    "text": "往好处想的话，至少我们就可以阻止水仙十字结社最后锻造出圣剑了。"
                },
                {
                    "id": "740760505",
                    "speaker": "卡特皮拉",
                    "text": "并不是，派蒙。我们的最终目的是铸造出圣剑，并且用圣剑去阻止他们的计划。"
                },
                {
                    "id": "740760506",
                    "speaker": "卡特皮拉",
                    "text": "当然，安，我并没有忘记这柄剑对于你的意义。"
                },
                {
                    "id": "740760507",
                    "speaker": "卡特皮拉",
                    "text": "能够切割意志的圣剑，对于你是解开谜题的钥匙。其实它对我来说也一样重要。"
                },
                {
                    "id": "740760508",
                    "speaker": "卡特皮拉",
                    "text": "只不过我们有更重要、更紧迫的事情。我们之后再解答关于自身的谜，你可以接受吗？"
                },
                {
                    "id": "740760509",
                    "speaker": "安",
                    "text": "我没有问题。"
                },
                {
                    "id": "740760510",
                    "speaker": "卡特皮拉",
                    "text": "#那么{NICKNAME}，请你去收下「人格」吧。"
                }
            ]
        },
        {
