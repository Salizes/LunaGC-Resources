        {
            "id": "1011301",
            "objective": "前往「天使的馈赠」",
            "dialogues": [
                {
                    "id": "101130101",
                    "speaker": "斯坦利",
                    "text": "斯坦利，斯坦利…"
                }
            ]
        },
        {
            "id": "1011302",
            "objective": "坐到斯坦利身后",
            "dialogues": [
                {
                    "id": "101130201",
                    "speaker": "迪卢克",
                    "text": "今天，难得来一次「天使的馈赠」。"
                },
                {
                    "id": "101130202",
                    "speaker": "迪卢克",
                    "text": "酒馆里人也不太多，我也乐得清静。"
                }
            ]
        },
        {
            "id": "1011303",
            "objective": "(test)自动对话$HIDDEN",
            "dialogues": [
                {
                    "id": "101130301",
                    "speaker": "斯坦利",
                    "text": "斯坦利…告诉我，我该怎么办…"
                },
                {
                    "id": "101130302",
                    "speaker": "派蒙",
                    "text": "咦？他怎么在喊自己的名字啊？",
                    "choices": [
                        {
                            "id": "101130303",
                            "text": "莫非有什么隐情？",
                            "response": [
                                {
                                    "id": "101130304",
                                    "speaker": "派蒙",
                                    "text": "该不会，还有其他叫斯坦利的人？"
                                },
                                {
                                    "id": "101130307",
                                    "speaker": "斯坦利",
                                    "text": "呜呜！呜呃…斯坦利…"
                                },
                                {
                                    "id": "101130308",
                                    "speaker": "斯坦利",
                                    "text": "当年在烬寂海死的…为什么不是我啊！为什么我冒用你的名字，你的灵魂都不来阻止我？斯坦利！"
                                },
                                {
                                    "id": "101130309",
                                    "speaker": "斯坦利",
                                    "text": "要不是为了保护我这个新人，你也不会死在那个无风的地方！"
                                },
                                {
                                    "id": "101130310",
                                    "speaker": "斯坦利",
                                    "text": "你已经有了大冒险家的名号，可，可就为了我这种废物，你再也不能变成传奇了…"
                                },
                                {
                                    "id": "101130311",
                                    "speaker": "派蒙",
                                    "text": "这…究竟是怎么回事？"
                                },
                                {
                                    "id": "101130312",
                                    "speaker": "温迪",
                                    "text": "…我想，当年他确实找到了烬寂海。在那里遇到的危机，也是真的吧。"
                                },
                                {
                                    "id": "101130313",
                                    "speaker": "温迪",
                                    "text": "只不过，那个和他一起探险的同伴，才是真正的「大冒险家斯坦利」。"
                                },
                                {
                                    "id": "101130314",
                                    "speaker": "温迪",
                                    "text": "真正的斯坦利，是为了救我们认识的这个「斯坦利」而死的吧。"
                                },
                                {
                                    "id": "101130315",
                                    "speaker": "派蒙",
                                    "text": "啊…那这个「斯坦利」之所以叫斯坦利，是因为他「偷」了别人的名字咯？"
                                },
                                {
                                    "id": "101130316",
                                    "speaker": "温迪",
                                    "text": "恐怕就是这么回事。"
                                },
                                {
                                    "id": "101130317",
                                    "speaker": "斯坦利",
                                    "text": "斯坦利…我害怕了这么多年，我怕蒙德城里的人把你忘得一干二净，所以到处说你的冒险故事…"
                                },
                                {
                                    "id": "101130318",
                                    "speaker": "斯坦利",
                                    "text": "我要让蒙德人都记住，斯坦利抵达过烬寂海的中心…他是最伟大的冒险家，他还活着！"
                                },
                                {
                                    "id": "101130319",
                                    "speaker": "斯坦利",
                                    "text": "斯坦利不会死，因为我就是！…因为我就是…斯坦利…"
                                },
                                {
                                    "id": "101130320",
                                    "speaker": "斯坦利",
                                    "text": "对不起，斯坦利…连我也老了，我也老了啊…"
                                },
                                {
                                    "id": "101130321",
                                    "speaker": "斯坦利",
                                    "text": "唉…"
                                },
                                {
                                    "id": "101130322",
                                    "speaker": "斯坦利",
                                    "text": "你们几个，还想偷听到什么时候？"
                                },
                                {
                                    "id": "101130323",
                                    "speaker": "派蒙",
                                    "text": "糟了！他发现了…！"
                                }
                            ]
                        },
                        {
                            "id": "101130305",
                            "text": "还有别人叫斯坦利吗？",
                            "response": [
                                {
                                    "id": "101130306",
                                    "speaker": "温迪",
                                    "text": "不会吧，连我都没听说过第二个斯坦利。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "1011304",
            "objective": "试着与斯坦利交谈",
            "dialogues": [
                {
                    "id": "101130401",
                    "speaker": "斯坦利",
                    "text": "走吧，什么都别问，让我一个人安静一会儿…"
                },
                {
                    "id": "101130402",
                    "speaker": "派蒙",
                    "text": "可是…"
                },
                {
                    "id": "101130403",
                    "speaker": "斯坦利",
                    "text": "走！别让我说第二次！"
                },
                {
                    "id": "101130404",
                    "speaker": "杰克",
                    "text": "荣誉骑士、温迪，还有派蒙！太好了，你们都在这儿！"
                },
                {
                    "id": "101130405",
                    "speaker": "杰克",
                    "text": "我到处找你们！我是来道谢的，多亏你帮我找的剑和盾，我父母同意了！"
                },
                {
                    "id": "101130406",
                    "speaker": "温迪",
                    "text": "哦？真的吗？"
                },
                {
                    "id": "101130407",
                    "speaker": "杰克",
                    "text": "真的！他们还说要出钱找人把「辉煌勇气之剑」和「光耀意志之盾」修好，让我带着上路。"
                },
                {
                    "id": "101130408",
                    "speaker": "温迪",
                    "text": "那真好。杰克，你要离开蒙德、启程巡游提瓦特大陆了吗？"
                },
                {
                    "id": "101130409",
                    "speaker": "杰克",
                    "text": "不，暂时还不走。以我现在的能力，恐怕走不了太远的路。"
                },
                {
                    "id": "101130410",
                    "speaker": "杰克",
                    "text": "而且，我还想再听听斯坦利先生的故事。嘿嘿…毕竟，他是我梦想的起点。"
                },
                {
                    "id": "101130411",
                    "speaker": "杰克",
                    "text": "斯坦利先…啊，他又喝醉了…"
                },
                {
                    "id": "101130412",
                    "speaker": "杰克",
                    "text": "明天见，先生。等你酒醒了，再给我讲点故事好吗？"
                },
                {
                    "id": "101130413",
                    "speaker": "温迪",
                    "text": "我认为斯坦利挺喜欢这孩子，你觉得呢？"
                },
                {
                    "id": "101130414",
                    "speaker": "斯坦利",
                    "text": "杰克？杰克！"
                },
                {
                    "id": "101130415",
                    "speaker": "温迪",
                    "text": "杰克已经回去了。"
                },
                {
                    "id": "101130416",
                    "speaker": "斯坦利",
                    "text": "是吗…那，谢谢你们没把我的秘密说出去。"
                },
                {
                    "id": "101130417",
                    "speaker": "温迪",
                    "text": "欸？突然直视现实了吗？这可不像之前的你哦。"
                },
                {
                    "id": "101130418",
                    "speaker": "斯坦利",
                    "text": "我…刚才我都不敢看他一眼。他对冒险的真心不带一点杂质…"
                },
                {
                    "id": "101130419",
                    "speaker": "斯坦利",
                    "text": "我是个疲惫没用的骗子，但那孩子还是个闪闪发亮的新人，可不能毁灭了他的梦想啊。"
                },
                {
                    "id": "101130421",
                    "speaker": "斯坦利",
                    "text": "故事…经历…呵，算了吧。"
                },
                {
                    "id": "101130423",
                    "speaker": "斯坦利",
                    "text": "这才是我最大的秘密、最大的恐惧…"
                },
                {
                    "id": "101130425",
                    "speaker": "斯坦利",
                    "text": "我唯一不能忘记的，是他死在了无风的烬寂海，风带不走他的灵魂！",
                    "choices": [
                        {
                            "id": "101130426",
                            "text": "他的人生被负罪感淹没了…",
                            "response": [
                                {
                                    "id": "101130428",
                                    "speaker": "温迪",
                                    "text": "嗯，没错…真正的斯坦利，在他的记忆里，甚至已经不再是那个鲜活的友人。"
                                },
                                {
                                    "id": "101130429",
                                    "speaker": "温迪",
                                    "text": "而是永远定格在伤痕累累的战士模样，束缚着他所有的人生。"
                                },
                                {
                                    "id": "101130430",
                                    "speaker": "斯坦利",
                                    "text": "我老了…再怎么不愿放下，也留不住多少东西…"
                                },
                                {
                                    "id": "101130431",
                                    "speaker": "斯坦利",
                                    "text": "我真没用！没用…"
                                },
                                {
                                    "id": "101130432",
                                    "speaker": "斯坦利",
                                    "text": "但冒险家不能以那种方式死去…不能…"
                                },
                                {
                                    "id": "101130433",
                                    "speaker": "斯坦利",
                                    "text": "真…真是不可思议…"
                                },
                                {
                                    "id": "101130434",
                                    "speaker": "斯坦利",
                                    "text": "谢谢你们…谢谢你，巴巴托斯大人…"
                                },
                                {
                                    "id": "101130435",
                                    "speaker": "斯坦利",
                                    "text": "对不起，我还需要一些时间，调整心情…"
                                },
                                {
                                    "id": "101130436",
                                    "speaker": "斯坦利",
                                    "text": "但我想，我会没事的…"
                                },
                                {
                                    "id": "101130437",
                                    "speaker": "温迪",
                                    "text": "嗯，真不错！斯坦利找到了真正的自己，杰克也成功自立了。"
                                },
                                {
                                    "id": "101130438",
                                    "speaker": "温迪",
                                    "text": "这么多好事加在一起，值得喝一杯庆祝庆祝！"
                                },
                                {
                                    "id": "101130439",
                                    "speaker": "派蒙",
                                    "text": "你要在这个酒馆就地不醉不归吗？"
                                },
                                {
                                    "id": "101130440",
                                    "speaker": "温迪",
                                    "text": "哈哈，这里的酒太贵了。杰克欠我的报酬还没给，他许诺我的报酬是珍贵名酒，还记得吗？"
                                },
                                {
                                    "id": "101130441",
                                    "speaker": "温迪",
                                    "text": "我先去找他要那瓶酒，一会儿就在<color=#00E1FFFF>「老地方」</color>集合吧！"
                                },
                                {
                                    "id": "101130442",
                                    "speaker": "派蒙",
                                    "text": "哎？什么老地方，我怎么不知道？喂！喂，卖唱的！",
                                    "choices": [
                                        {
                                            "id": "101130443",
                                            "text": "只能猜猜看了…",
                                            "response": [
                                                {
                                                    "id": "101130446",
                                                    "speaker": "派蒙",
                                                    "text": "喂！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "101130444",
                                            "text": "我想我可能知道…也许吧。"
                                        },
                                        {
                                            "id": "101130445",
                                            "text": "嗯，<color=#00E1FFFF>「老地方」</color>，不见不散！"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "101130427",
                            "text": "已经只剩下「幻想朋友」了…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1011305",
            "objective": "寻找「老地方」…？",
            "dialogues": [
                {
                    "id": "101130501",
                    "speaker": "温迪",
                    "text": "可算来了。"
                },
                {
                    "id": "101130502",
                    "speaker": "派蒙",
                    "text": "真难找！下次别打这种哑谜了！"
                },
                {
                    "id": "101130503",
                    "speaker": "派蒙",
                    "text": "对了，卖唱的，你拿到酒了吗？"
                },
                {
                    "id": "101130504",
                    "speaker": "温迪",
                    "text": "拿到了。杰克这家伙，说是什么「珍藏又珍贵的好酒」…"
                },
                {
                    "id": "101130505",
                    "speaker": "温迪",
                    "text": "结果只不过是半瓶苹果酿而已嘛。"
                },
                {
                    "id": "101130506",
                    "speaker": "温迪",
                    "text": "真怀念啊。"
                },
                {
                    "id": "101130507",
                    "speaker": "温迪",
                    "text": "第一次在这儿看风景的时候，我还不是「这副模样」。"
                },
                {
                    "id": "101130508",
                    "speaker": "Player",
                    "text": "不是…这副模样？"
                },
                {
                    "id": "101130509",
                    "speaker": "温迪",
                    "text": "大约两千六百年前，尘世尚未划归七神所有。"
                },
                {
                    "id": "101130510",
                    "speaker": "温迪",
                    "text": "那时，「旧蒙德」被暴君吹起的飓风包围，连飞鸟也不得通行。"
                },
                {
                    "id": "101130511",
                    "speaker": "派蒙",
                    "text": "「旧蒙德」？啊，我想起来了，就是现在的风龙废墟吧？你以前提过！"
                },
                {
                    "id": "101130512",
                    "speaker": "温迪",
                    "text": "是的。曾经统治那座高塔的风之暴君，是「龙卷的魔神」迭卡拉庇安。"
                },
                {
                    "id": "101130513",
                    "speaker": "温迪",
                    "text": "而那时的我，只是千风中的一缕。并无神灵之格，也不成人形…"
                },
                {
                    "id": "101130514",
                    "speaker": "温迪",
                    "text": "只是风中细微的元素精灵，是一缕「能够带来细小的转机与希望之风」。"
                },
                {
                    "id": "101130515",
                    "speaker": "派蒙",
                    "text": "只是元素精灵？不是人形？咦？温迪，你以前不长现在这样吗？"
                },
                {
                    "id": "101130516",
                    "speaker": "温迪",
                    "text": "嗯。我现在的样子，其实也和那位假斯坦利先生一样，是借用「朋友」的喔。"
                },
                {
                    "id": "101130517",
                    "speaker": "派蒙",
                    "text": "后来呢？"
                },
                {
                    "id": "101130518",
                    "speaker": "派蒙",
                    "text": "你说的那个朋友，他后来怎么样了？"
                },
                {
                    "id": "101130519",
                    "speaker": "Player",
                    "text": "（温迪的朋友，和斯坦利一样…）"
                },
                {
                    "id": "101130520",
                    "speaker": "温迪",
                    "text": "派蒙，你想知道后面的故事吗？"
                },
                {
                    "id": "101130521",
                    "speaker": "派蒙",
                    "text": "当然当然！别吊我胃口，快说吧！",
                    "choices": [
                        {
                            "id": "101130522",
                            "text": "派蒙，去采两个苹果来。",
                            "response": [
                                {
                                    "id": "101130523",
                                    "speaker": "派蒙",
                                    "text": "为什么现在突然想吃这个啊！"
                                },
                                {
                                    "id": "101130526",
                                    "speaker": "温迪",
                                    "text": "哈哈哈，你肚子饿了吗？"
                                },
                                {
                                    "id": "101130527",
                                    "speaker": "Player",
                                    "text": "是啊。"
                                },
                                {
                                    "id": "101130528",
                                    "speaker": "派蒙",
                                    "text": "呜…真是拿你没办法！"
                                },
                                {
                                    "id": "101130529",
                                    "speaker": "温迪",
                                    "text": "啊——有时我会觉得，你有些过于聪明了。"
                                },
                                {
                                    "id": "101130530",
                                    "speaker": "温迪",
                                    "text": "不过，朋友之间，也许就是要心知肚明才好。"
                                },
                                {
                                    "id": "101130531",
                                    "speaker": "温迪",
                                    "text": "美酒，微风…这样的时刻，总会让我忍不住想起…"
                                },
                                {
                                    "id": "101130532",
                                    "speaker": "温迪",
                                    "text": "想起那首，从他那里听来的歌…"
                                },
                                {
                                    "id": "101130533",
                                    "speaker": "Player",
                                    "text": "我会好好听着的。"
                                }
                            ]
                        },
                        {
                            "id": "101130524",
                            "text": "派蒙，能帮我找些鱼肉吗？",
                            "response": [
                                {
                                    "id": "101130525",
                                    "speaker": "派蒙",
                                    "text": "咦？不是在听故事吗？怎么突然要吃这种东西！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "1011306",
            "objective": "(test)温迪cs，完$HIDDEN",
            "dialogues": [
                {
                    "id": "101130601",
                    "speaker": "温迪",
                    "text": "我要说的故事开始于「旧蒙德」，"
                }
            ]
        },
        {
            "id": "1011302",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "101130211",
                    "speaker": "迪卢克",
                    "text": "斯坦利…"
                },
                {
                    "id": "101130212",
                    "speaker": "迪卢克",
                    "text": "这么多年过去，束缚他的甚至已经不再是「朋友」本人。"
                },
                {
                    "id": "101130213",
                    "speaker": "迪卢克",
                    "text": "但那位朋友的故事，想必不会在蒙德被人忘却吧。"
                }
            ]
        }
    ]
}