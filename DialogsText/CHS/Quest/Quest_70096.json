    "talks": [
        {
            "id": "7009601",
            "objective": "前往荆夫港",
            "dialogues": [
                {
                    "id": "700960101",
                    "speaker": "斯莱日涅夫",
                    "text": "…要说最强的战士，那还得是我们的「队长」！只凭肉体的力量就能硬扛深渊！"
                },
                {
                    "id": "700960102",
                    "speaker": "莱夫赫姆",
                    "text": "这就是典型的没见过强敌也不懂战斗的言论！你觉得所有强者都只会站着打木桩吗？况且只论力量，我们大团长也…"
                },
                {
                    "id": "700960103",
                    "speaker": "洛恩",
                    "text": "——够了。我让你们两个过来，不是为了这种无聊的争论。"
                },
                {
                    "id": "700960104",
                    "speaker": "派蒙",
                    "text": "洛恩？还有你们两个？好罕见的组合…你们平时不都待在挪德卡莱吗？"
                },
                {
                    "id": "700960105",
                    "speaker": "洛恩",
                    "text": "哈…我听说挪德卡莱有两位「战力学」专家，还想请过来编撰一份「强敌图鉴」。"
                },
                {
                    "id": "700960106",
                    "speaker": "洛恩",
                    "text": "哪知道他们才聊了两句就讨论不下去了，看来…我得想点办法，让你们再认真点了啊。"
                },
                {
                    "id": "700960107",
                    "speaker": "斯莱日涅夫",
                    "text": "唔…我…我这就开始编！呃…"
                },
                {
                    "id": "700960108",
                    "speaker": "莱夫赫姆",
                    "text": "洛…洛恩队长！我也不想啊，但「强敌」的定义实在太模糊了。"
                },
                {
                    "id": "700960109",
                    "speaker": "莱夫赫姆",
                    "text": "别说普通魔物，就连魔神之间也差得天高地远。要是不找个合适的标杆，恐怕还是讨论不出结果…"
                },
                {
                    "id": "700960110",
                    "speaker": "斯莱日涅夫",
                    "text": "要、要说有什么大众认知里都觉得「强大」的标杆…那大概就是「龙」了吧？"
                },
                {
                    "id": "700960111",
                    "speaker": "洛恩",
                    "text": "…「龙」？"
                },
                {
                    "id": "700960112",
                    "speaker": "派蒙",
                    "text": "真的假的，我怎么觉得龙与龙之间的差距，大概就跟魔神与魔神之间的差距一样大…",
                    "choices": [
                        {
                            "id": "700960113",
                            "text": "你为什么要编「强敌图鉴」？",
                            "response": [
                                {
                                    "id": "700960115",
                                    "speaker": "洛恩",
                                    "text": "这个么…经过前阵子的反思，我觉得继续变强的最好方法——还得是挑战诸国的强敌。"
                                },
                                {
                                    "id": "700960116",
                                    "speaker": "Player",
                                    "text": "（跟反思之前也没啥变化啊…）"
                                },
                                {
                                    "id": "700960117",
                                    "speaker": "洛恩",
                                    "text": "可就在我今早准备出门的时候…有一个长得怪模怪样的东西，跟我说了些没头没尾的话。"
                                },
                                {
                                    "id": "700960118",
                                    "speaker": "怪模怪样的某物",
                                    "text": "「迷途的人类啊，你将三次直面龙威，随后理解强大的意义。」"
                                },
                                {
                                    "id": "700960119",
                                    "speaker": "Player",
                                    "text": "（这描述…怎么听都是芭比洛斯了吧！）"
                                },
                                {
                                    "id": "700960120",
                                    "speaker": "洛恩",
                                    "text": "我倒是没把什么预言放在心上，不过现在的走向…哼，处处被人掌握的感觉，真让人不爽。"
                                },
                                {
                                    "id": "700960121",
                                    "speaker": "莱夫赫姆",
                                    "text": "「龙」啊…在蒙德要提到龙，就是「东风守护」、「魔龙乌萨」，跟雪山上的传说了…其他还有什么？"
                                },
                                {
                                    "id": "700960122",
                                    "speaker": "斯莱日涅夫",
                                    "text": "哼哼，这你就不知道了吧！根据我在挪德卡莱掌握的绝密情报，一头强大的古龙，已经悄无声息地来到了荆夫港！"
                                },
                                {
                                    "id": "700960123",
                                    "speaker": "派蒙",
                                    "text": "还有这种事？真的假的…"
                                },
                                {
                                    "id": "700960124",
                                    "speaker": "洛恩",
                                    "text": "呵，真的假的，去会一会不就知道了。"
                                }
                            ]
                        },
                        {
                            "id": "700960114",
                            "text": "你看起来对「龙」有些在意？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7009602",
            "objective": "寻访谜之古龙",
            "dialogues": [
                {
                    "id": "700960301",
                    "speaker": "爱诺",
                    "text": "伊涅芙伊涅芙！你看那个风车！快把它的结构记录下来！"
                },
                {
                    "id": "700960302",
                    "speaker": "伊涅芙",
                    "text": "收到——正在准备为风车拍照。这次想要合影吗，爱诺？"
                },
                {
                    "id": "700960303",
                    "speaker": "爱诺",
                    "text": "#欸？{NICKNAME}？派蒙——还有洛恩！嗨！"
                },
                {
                    "id": "700960304",
                    "speaker": "派蒙",
                    "text": "来自挪德卡莱的「强大古龙」…我早该想到是谁的。"
                },
                {
                    "id": "700960305",
                    "speaker": "伊涅芙",
                    "text": "情况总结中…所以，洛恩先生是想要找我进行战斗训练？"
                },
                {
                    "id": "700960306",
                    "speaker": "洛恩",
                    "text": "跳过所有前因后果，确实是这么回事。在挪德卡莱远征的时候还真没想到，你居然有这么曲折的来历。"
                },
                {
                    "id": "700960307",
                    "speaker": "洛恩",
                    "text": "不过这都无关紧要，从前我就想领教一下你的身手了，怎么样？"
                },
                {
                    "id": "700960308",
                    "speaker": "爱诺",
                    "text": "哼哼！伊涅芙！给他点颜色看看！"
                },
                {
                    "id": "700960309",
                    "speaker": "伊涅芙",
                    "text": "抱歉——根据今日日程安排，我们还要去收集蒙德的特殊零件。根据评估，与您交战，可能会影响后续的行动。"
                },
                {
                    "id": "700960310",
                    "speaker": "爱诺",
                    "text": "对哦…差点忘了还有这回事。明明是听说了蒙德有特别的大机器人才过来的…一不小心就全在玩了。"
                },
                {
                    "id": "700960311",
                    "speaker": "洛恩",
                    "text": "好吧…我明白了。"
                },
                {
                    "id": "700960312",
                    "speaker": "派蒙",
                    "text": "洛恩…居然这就放弃了！"
                },
                {
                    "id": "700960313",
                    "speaker": "洛恩",
                    "text": "——只要帮你们干掉那些遗迹守卫，你就能腾出日程了吧。"
                }
            ]
        },
        {
            "id": "7009603",
            "objective": "协助伊涅芙收集素材",
            "dialogues": [
                {
                    "id": "700960801",
                    "speaker": "洛恩",
                    "text": "——就是这个家伙？"
                },
                {
                    "id": "700960802",
                    "speaker": "爱诺",
                    "text": "伊涅芙！上去拆了它！"
                }
            ]
        },
        {
            "id": "7009609",
            "objective": "协助伊涅芙收集素材",
            "dialogues": []
        },
        {
            "id": "7009604",
            "objective": "击败遗迹守卫",
            "dialogues": [
                {
                    "id": "700960401",
                    "speaker": "洛恩",
                    "text": "很流畅的身法，完全看不出是机械。"
                },
                {
                    "id": "700960402",
                    "speaker": "伊涅芙",
                    "text": "洛恩先生的攻击也很精准，就像机械一样。"
                },
                {
                    "id": "700960403",
                    "speaker": "爱诺",
                    "text": "好耶！是新零件！可以拿回去做新的模块了！"
                },
                {
                    "id": "700960404",
                    "speaker": "洛恩",
                    "text": "哦？那现在…"
                },
                {
                    "id": "700960405",
                    "speaker": "爱诺",
                    "text": "伊涅芙！再去多找几个！样本越多越好！"
                },
                {
                    "id": "700960406",
                    "speaker": "伊涅芙",
                    "text": "是…抱歉，我们回头再谈吧。"
                },
                {
                    "id": "700960407",
                    "speaker": "Black Screen",
                    "text": "一番探索之后…"
                },
                {
                    "id": "700960408",
                    "speaker": "爱诺",
                    "text": "呼…呼…"
                },
                {
                    "id": "700960409",
                    "speaker": "派蒙",
                    "text": "居然睡着了…是因为之前在荆夫港玩得太累了吗？"
                },
                {
                    "id": "700960410",
                    "speaker": "伊涅芙",
                    "text": "爱诺经常这样，精力来得快去得也快。抱歉，洛恩先生，我现在无法移动，需要等爱诺再睡熟一些…"
                },
                {
                    "id": "700960411",
                    "speaker": "洛恩",
                    "text": "…算了，你的力量，我已经看过了。"
                },
                {
                    "id": "700960412",
                    "speaker": "伊涅芙",
                    "text": "…希望我的战斗数据，对您有所帮助。"
                },
                {
                    "id": "700960413",
                    "speaker": "伊涅芙",
                    "text": "对了，告诉我们特殊机关信息的人，还提到过「雪山」，也许各位可以再去那边看看？"
                }
            ]
        },
        {
            "id": "7009607",
            "objective": "与伊涅芙对话",
            "dialogues": []
        },
        {
            "id": "7009608",
            "objective": "前往龙脊雪山",
            "dialogues": []
        },
        {
            "id": "7009605",
            "objective": "寻访雪山之龙",
            "dialogues": [
                {
                    "id": "700960501",
                    "speaker": "杜林",
                    "text": "…追寻力量之人，依循命运的指引，终于来到了这里。"
                },
                {
                    "id": "700960502",
                    "speaker": "派蒙",
                    "text": "果然是杜林…我怎么一点都不意外呢。"
                },
                {
                    "id": "700960503",
                    "speaker": "Player",
                    "text": "但语气有点不一样？"
                },
                {
                    "id": "700960504",
                    "speaker": "杜林",
                    "text": "至高领主、魔女造物、天使孑遗…行使着各不相同的力量，却都被冠以「龙」的名字。"
                },
                {
                    "id": "700960505",
                    "speaker": "杜林",
                    "text": "…只因「龙」，即是强大的象征。"
                },
                {
                    "id": "700960506",
                    "speaker": "洛恩",
                    "text": "所以「与巨龙战斗」也就成了力量的证明？——我有点理解当初的大团长了。"
                },
                {
                    "id": "700960507",
                    "speaker": "杜林",
                    "text": "…欸？"
                },
                {
                    "id": "700960508",
                    "speaker": "洛恩",
                    "text": "虽然你看起来还想说什么，不过接下来就用兵刃交流吧？这样更好懂一点。"
                },
                {
                    "id": "700960509",
                    "speaker": "杜林",
                    "text": "等等！年…年轻的人类啊，你想找的试炼不在这里，前往风龙废墟吧去直面最后一次预言！",
                    "choices": [
                        {
                            "id": "700960510",
                            "text": "语速好快！",
                            "response": [
                                {
                                    "id": "700960512",
                                    "speaker": "派蒙",
                                    "text": "你没事吧？杜林？总感觉你今天说话怪怪的？"
                                },
                                {
                                    "id": "700960513",
                                    "speaker": "杜林",
                                    "text": "（哈…该念的应该都念了吧…虽然跳过了很多！）"
                                },
                                {
                                    "id": "700960514",
                                    "speaker": "杜林",
                                    "text": "那个，阿贝多喊我去帮他做实验，我就先回去了。抱歉了，各位！"
                                },
                                {
                                    "id": "700960515",
                                    "speaker": "洛恩",
                                    "text": "这就飞走了？…真遗憾。"
                                },
                                {
                                    "id": "700960516",
                                    "speaker": "洛恩",
                                    "text": "嗯？这是…"
                                },
                                {
                                    "id": "700960517",
                                    "speaker": "派蒙",
                                    "text": "呃…所以杜林究竟是来做什么的？除了最后那句「前往风龙废墟」好像没什么有效信息…",
                                    "choices": [
                                        {
                                            "id": "700960518",
                                            "text": "我有种预感。",
                                            "response": [
                                                {
                                                    "id": "700960520",
                                                    "speaker": "洛恩",
                                                    "text": "有意思，我现在倒是想去见证一下，这「预言」会怎么实现了。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "700960519",
                                            "text": "是为了凑「三」这个数。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "700960511",
                            "text": "像赶着下场的演员！"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7009606",
            "objective": "寻访东风之龙",
            "dialogues": [
                {
                    "id": "700960601",
                    "speaker": "尼可",
                    "text": "很好…按照芭比洛斯的预言，那个需要指引的人类再过一会就会来了。"
                },
                {
                    "id": "700960602",
                    "speaker": "尼可",
                    "text": "登场台词…记住了。出场效果…确认过了。嗯，这次绝对万无一失！"
                },
                {
                    "id": "700960603",
                    "speaker": "派蒙",
                    "text": "你们说…最后一则预言，为什么要洛恩来这儿啊？"
                },
                {
                    "id": "700960604",
                    "speaker": "尼可",
                    "text": "现在就来了？难道杜林没念完他的台词？不好…要小声…"
                },
                {
                    "id": "700960605",
                    "speaker": "派蒙",
                    "text": "难道最后一次「直面龙威」…说的是特瓦林？不过它今天是不是不在呀？"
                },
                {
                    "id": "700960606",
                    "speaker": "洛恩",
                    "text": "严格来说，我之前已经见过「东风守护」了。在我刚从挪德卡莱返回的时候，就在你们旁边。"
                },
                {
                    "id": "700960607",
                    "speaker": "派蒙",
                    "text": "对哦，是在奔狼领替法尔伽送信的那次吧！这样算起来，你的「预言」其实已经结束了？"
                },
                {
                    "id": "700960608",
                    "speaker": "洛恩",
                    "text": "至少「三次直面龙威」，满打满算的话大概可以结束了。"
                },
                {
                    "id": "700960609",
                    "speaker": "Player",
                    "text": "还剩下「理解强大的意义」…"
                },
                {
                    "id": "700960610",
                    "speaker": "洛恩",
                    "text": "嗯，估计这才是「预言」指引我来这的理由吧。"
                },
                {
                    "id": "700960611",
                    "speaker": "洛恩",
                    "text": "这个地方在被称作「风龙废墟」之前，曾是龙卷之魔神的领域。"
                },
                {
                    "id": "700960612",
                    "speaker": "洛恩",
                    "text": "能卷起飓风庇护一切的强大魔神，却拦不住风墙之内对于自由的向往。"
                },
                {
                    "id": "700960613",
                    "speaker": "洛恩",
                    "text": "曾与它角逐神座的北风之魔神，却在放弃力量之后，找到了一直追寻的答案。"
                },
                {
                    "id": "700960614",
                    "speaker": "尼可",
                    "text": "咦？这孩子…好像也没有法尔伽说的那么偏执？"
                },
                {
                    "id": "700960615",
                    "speaker": "洛恩",
                    "text": "「明晨之镜」、「魔龙杜林」…也都曾陷入过不解与迷茫，而令他们走向强大的，却从不只是力量。"
                },
                {
                    "id": "700960616",
                    "speaker": "尼可",
                    "text": "嗯嗯…悟性不错呀。"
                },
                {
                    "id": "700960617",
                    "speaker": "洛恩",
                    "text": "还有曾经的天使——「乌萨」。"
                },
                {
                    "id": "700960618",
                    "speaker": "尼可",
                    "text": "…嗯？"
                },
                {
                    "id": "700960619",
                    "speaker": "派蒙",
                    "text": "虽然话说得很有道理…但这真是洛恩你会说出来的台词吗！",
                    "choices": [
                        {
                            "id": "700960620",
                            "text": "先是杜林…又是洛恩…",
                            "response": [
                                {
                                    "id": "700960622",
                                    "speaker": "洛恩",
                                    "text": "「选择了力量的天使，依旧渴望靠近人类，竟至堕落为了可悲的魔物…」"
                                },
                                {
                                    "id": "700960623",
                                    "speaker": "洛恩",
                                    "text": "「见证过这一切的人类啊，依旧执着于力量吗？」"
                                },
                                {
                                    "id": "700960624",
                                    "speaker": "尼可",
                                    "text": "——这全是我的词啊！"
                                },
                                {
                                    "id": "700960625",
                                    "speaker": "派蒙",
                                    "text": "呜哇！"
                                },
                                {
                                    "id": "700960626",
                                    "speaker": "尼可",
                                    "text": "啊…一不小心就…"
                                },
                                {
                                    "id": "700960627",
                                    "speaker": "洛恩",
                                    "text": "幸会，尼可女士。您写的剧本，我已经拜读过了。"
                                },
                                {
                                    "id": "700960628",
                                    "speaker": "尼可",
                                    "text": "唉…是从杜林那里捡到的吧？"
                                },
                                {
                                    "id": "700960629",
                                    "speaker": "洛恩",
                                    "text": "哦？难不成这也是预言？"
                                },
                                {
                                    "id": "700960630",
                                    "speaker": "尼可",
                                    "text": "只是我的猜测而已。要是这也能预言到，我刚才也不会…咳。"
                                },
                                {
                                    "id": "700960631",
                                    "speaker": "洛恩",
                                    "text": "总之，这剧本写得不错，当成童话来读读还挺解闷的。不过我不太喜欢被人说教…就算是「天使」也不行。"
                                },
                                {
                                    "id": "700960632",
                                    "speaker": "尼可",
                                    "text": "…我就当你是在说我那位选择力量的前同事了。"
                                },
                                {
                                    "id": "700960633",
                                    "speaker": "尼可",
                                    "text": "既然你捡到了剧本，那我想要说的话，你应该也全看到了？"
                                },
                                {
                                    "id": "700960634",
                                    "speaker": "洛恩",
                                    "text": "嗯，我会把这些台词，都当成宝贵的建议记下来。如果没什么事，我就回去继续编我的强敌图鉴了？",
                                    "choices": [
                                        {
                                            "id": "700960635",
                                            "text": "（没说会听从这建议呢…）",
                                            "response": [
                                                {
                                                    "id": "700960637",
                                                    "speaker": "洛恩",
                                                    "text": "不过我今天确实也收获了不少，嗯…大概是有变强了那么一点吧？"
                                                },
                                                {
                                                    "id": "700960638",
                                                    "speaker": "洛恩",
                                                    "text": "谢谢咯，各位…也代我向「幕后人员」们都问声好。"
                                                },
                                                {
                                                    "id": "700960639",
                                                    "speaker": "尼可",
                                                    "text": "唉…果然又是一个难对付的人类。"
                                                },
                                                {
                                                    "id": "700960640",
                                                    "speaker": "派蒙",
                                                    "text": "所以，这到底是什么情况啊？谁来帮我理一理…"
                                                },
                                                {
                                                    "id": "700960641",
                                                    "speaker": "尼可",
                                                    "text": "你们之前不是解决了多托雷，还有乌萨留在蒙德的「遗毒」吗？听说洛恩在那时候，也遭了不少罪？"
                                                },
                                                {
                                                    "id": "700960642",
                                                    "speaker": "尼可",
                                                    "text": "既然是从前的「天使」留下的祸患，那当然得靠现在的「天使」来导正…虽然跟我一开始预想的是有一点偏离…"
                                                },
                                                {
                                                    "id": "700960643",
                                                    "speaker": "尼可",
                                                    "text": "以后人类的命运，恐怕会变得更加不可预测吧？天使对人类的引导，也不再是通往未来的唯一解。"
                                                },
                                                {
                                                    "id": "700960644",
                                                    "speaker": "尼可",
                                                    "text": "但这些无限的可能性…也许正是人类的「强大」之处呢？"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "700960636",
                                            "text": "（还是要继续编图鉴啊…）"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "700960621",
                            "text": "怎么都开始念剧本了？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7009602",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "700960201",
                    "speaker": "斯莱日涅夫",
                    "text": "「队长」不仅武力超群，还开发过对抗深渊的特效药！这你不知道了吧？还敢说我是啥都没见识过的假学者吗？"
                },
                {
                    "id": "700960202",
                    "speaker": "莱夫赫姆",
                    "text": "那你知道我们团长的神速吗！他曾经只用一眨眼的功夫，就从挪德卡莱顺着地脉跑回了蒙德！"
                }
            ]
        },
        {
            "id": "7009607",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "700960701",
                    "speaker": "尼可",
                    "text": "唉，第一次亲自上手，居然会变成这样…",
                    "choices": [
                        {
                            "id": "700960702",
                            "text": "万事开头难嘛…",
                            "response": [
                                {
                                    "id": "700960703",
                                    "speaker": "派蒙",
                                    "text": "而且，结果也不算坏嘛！"
                                }
                            ]
                        },
                        {
                            "id": "700960704",
                            "text": "第一次上手什么？",
                            "response": [
                                {
                                    "id": "700960705",
                                    "speaker": "尼可",
                                    "text": "嗯…是「魔女的课业」，回头再向你解释吧。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7009609",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "700960903",
                    "speaker": "<UNKNOWN>",
                    "text": "(test)台词文本"
                }
            ]
        },
        {
            "id": "7009699",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "700969901",
                    "speaker": "洛恩",
                    "text": "——就是这个家伙？"
                },
                {
                    "id": "700969902",
                    "speaker": "爱诺",
                    "text": "伊涅芙！上去拆了它！"
                }
            ]
        }
    ]
}