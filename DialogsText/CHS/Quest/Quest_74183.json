            "dialogues": [
                {
                    "id": "741832101",
                    "speaker": "Player",
                    "text": "没想到龙蜥能长这么大。"
                },
                {
                    "id": "741832102",
                    "speaker": "呜斯先生",
                    "text": "哼，毕竟是些缺乏教养，野蛮生长的族群，就算长成更加奇怪的样子也不意外吧。"
                }
            ]
        },
        {
            "id": "7418322",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "741832201",
                    "speaker": "Player",
                    "text": "说起来那维莱特不就是…"
                },
                {
                    "id": "741832202",
                    "speaker": "派蒙",
                    "text": "对啊，那维莱特不就是水之龙吗？这样说来这家伙该不会比那维莱特的年纪还要大得多？"
                },
                {
                    "id": "741832203",
                    "speaker": "呜斯先生",
                    "text": "已经有新的水之龙诞生了吗？也对，毕竟就连曾经的那位众水之主也早已逝去了…已经过去太久了…"
                }
            ]
        },
        {
            "id": "7418323",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "741832301",
                    "speaker": "呜斯先生",
                    "text": "总之，恶龙斯库拉曾是至尊的朋友。但他却在我们雷穆利亚人与…枫丹人决战的关键时刻发起了叛乱。"
                },
                {
                    "id": "741832302",
                    "speaker": "呜斯先生",
                    "text": "彼时，恶龙率领暴虐的龙裔直抵「马其莫斯」，并试图攻入至尊所在的内城「卡皮托利姆」。",
                    "choices": [
                        {
                            "id": "741832303",
                            "text": "「马其莫斯」？",
                            "response": [
                                {
                                    "id": "741832305",
                                    "speaker": "派蒙",
                                    "text": "嗯，在镇上的时候那些居民也一直在说什么「马其莫斯」，还有钟楼之类的…"
                                },
                                {
                                    "id": "741832306",
                                    "speaker": "呜斯先生",
                                    "text": "没错，「马其莫斯」是王城的外城，但恶龙要想去往内城就必须穿过「雅努斯之门」。"
                                },
                                {
                                    "id": "741832307",
                                    "speaker": "呜斯先生",
                                    "text": "那是隔绝王城内外的屏障，曾经至尊与乐师们编织的乐章，也是通过横穿「雅努斯之门」的金色水道覆盖到雷穆利亚全域的。"
                                },
                                {
                                    "id": "741832308",
                                    "speaker": "呜斯先生",
                                    "text": "波爱修斯和他的军团正是利用了这一点，竭力关闭了「雅努斯之门」，才最终将恶龙封印。"
                                },
                                {
                                    "id": "741832309",
                                    "speaker": "呜斯先生",
                                    "text": "斯库拉或许是想去到至尊御前吧，但再没有这样的机会了。之后恶龙随雷穆利亚一道沉入深水，至尊也从此不知所踪，直至今日…",
                                    "choices": [
                                        {
                                            "id": "741832310",
                                            "text": "（似乎有哪里不对…）",
                                            "response": [
                                                {
                                                    "id": "741832313",
                                                    "speaker": "呜斯先生",
                                                    "text": "#{NICKNAME}，你想起什么来了吗？"
                                                },
                                                {
                                                    "id": "741832314",
                                                    "speaker": "Player",
                                                    "text": "感觉有些混乱。"
                                                },
                                                {
                                                    "id": "741832315",
                                                    "speaker": "呜斯先生",
                                                    "text": "嗯…这些事情也是后来我才听说的，毕竟灾难发生的时候，我也并不在王城…"
                                                },
                                                {
                                                    "id": "741832316",
                                                    "speaker": "呜斯先生",
                                                    "text": "那个时候，至尊身边到底发生了什么无人知晓，恐怕只有继续前进才能找到更多线索了。"
                                                },
                                                {
                                                    "id": "741832317",
                                                    "speaker": "呜斯先生",
                                                    "text": "我们在城堡里见到的那条发光的大鱼，应该是斯库拉从那石质监牢的裂隙中逸散出来的思绪。"
                                                },
                                                {
                                                    "id": "741832318",
                                                    "speaker": "呜斯先生",
                                                    "text": "他怕是早就注意到了我们吧。封印在这里这么久，好不容易察觉到外面来的人，当然会想办法吸引我们。"
                                                },
                                                {
                                                    "id": "741832319",
                                                    "speaker": "派蒙",
                                                    "text": "原来是这样…"
                                                },
                                                {
                                                    "id": "741832320",
                                                    "speaker": "派蒙",
                                                    "text": "等一下，你说要去黄金宫殿的话就得穿过那道什么门，但是那道门已经被波爱修斯关上了？那不是根本去不了了吗？"
                                                },
                                                {
                                                    "id": "741832321",
                                                    "speaker": "呜斯先生",
                                                    "text": "这的确是件难事…"
                                                },
                                                {
                                                    "id": "741832322",
                                                    "speaker": "派蒙",
                                                    "text": "哇，没礼貌就是没礼貌，还装模作样地说什么「我在黄金宫殿等你」…结果连门都没给我们留！"
                                                },
                                                {
                                                    "id": "741832323",
                                                    "speaker": "派蒙",
                                                    "text": "要我看，不如我们想办法解开他镇压恶龙的封印，让他曾经的手下败将把门给撞开…"
                                                },
                                                {
                                                    "id": "741832324",
                                                    "speaker": "呜斯先生",
                                                    "text": "那怎么行？！再怎么说…那也是雷穆利亚的仇敌…",
                                                    "choices": [
                                                        {
                                                            "id": "741832325",
                                                            "text": "敌人的敌人就是朋友！",
                                                            "response": [
                                                                {
                                                                    "id": "741832327",
                                                                    "speaker": "派蒙",
                                                                    "text": "对呀，而且都过去这么久了，说不定他愿意改变想法，做条好龙呢。"
                                                                },
                                                                {
                                                                    "id": "741832328",
                                                                    "speaker": "呜斯先生",
                                                                    "text": "可那毕竟是龙…"
                                                                },
                                                                {
                                                                    "id": "741832329",
                                                                    "speaker": "派蒙",
                                                                    "text": "#什么嘛，就算是龙，说不定也很通情达理呢。我们也不是没有跟龙打交道的经验，对吧，{NICKNAME}？"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "741832326",
                                                            "text": "可是雷穆利亚早就不在了啊。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "741832311",
                                            "text": "（之前的梦境里…那个时候…）"
                                        },
                                        {
                                            "id": "741832312",
                                            "text": "（斯库拉应该来见过雷穆斯…）"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "741832304",
                            "text": "在镇上也听人提起过呢。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7418324",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "741832401",
                    "speaker": "Player",
                    "text": "比如风魔龙特瓦林…"
                },
                {
                    "id": "741832402",
                    "speaker": "派蒙",
                    "text": "嗯，因为特瓦林受到了诅咒的影响，在蒙德掀起了风灾，我们为此还大打了一架呢…"
                }
            ]
        },
        {
            "id": "7418325",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "741832501",
                    "speaker": "Player",
                    "text": "比如若陀龙王…"
                },
                {
                    "id": "741832502",
                    "speaker": "派蒙",
                    "text": "对，因为他想要突破封印，我们和大家一起击败了他，才将他重新封印了起来…"
                }
            ]
        },
        {
            "id": "7418326",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "741832601",
                    "speaker": "Player",
                    "text": "比如沙漠里的阿佩普…"
                },
                {
                    "id": "741832602",
                    "speaker": "派蒙",
                    "text": "没错，她还说什么要毁灭须弥…后来我们一起打败了她身体里面的变异生命体，才帮她恢复了健康…"
                }
            ]
        }
    ]
}