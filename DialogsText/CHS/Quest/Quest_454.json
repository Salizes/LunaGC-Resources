    "talks": [
        {
            "id": "45407",
            "objective": "前往奔狼领",
            "dialogues": []
        },
        {
            "id": "45401",
            "objective": "与雷泽对话",
            "dialogues": [
                {
                    "id": "4540101",
                    "speaker": "雷泽",
                    "text": "是谁？！"
                },
                {
                    "id": "4540102",
                    "speaker": "派蒙",
                    "text": "别紧张，雷泽，是我们！"
                },
                {
                    "id": "4540103",
                    "speaker": "雷泽",
                    "text": "你是…你也是骑士团的人？"
                },
                {
                    "id": "4540104",
                    "speaker": "派蒙",
                    "text": "什么，原来你们不认识吗？！",
                    "choices": [
                        {
                            "id": "4540105",
                            "text": "「红色，很烫的女孩子」——",
                            "response": [
                                {
                                    "id": "4540107",
                                    "speaker": "雷泽",
                                    "text": "不认识。 虽然也是红色，但是没有那个人那么烫。"
                                },
                                {
                                    "id": "4540108",
                                    "speaker": "安柏",
                                    "text": "啊，我明白了。 你们之前说的狼少年就是他吗？"
                                },
                                {
                                    "id": "4540109",
                                    "speaker": "派蒙",
                                    "text": "正是。 他叫做雷泽。"
                                },
                                {
                                    "id": "4540110",
                                    "speaker": "雷泽",
                                    "text": "帮我一个忙。"
                                },
                                {
                                    "id": "4540111",
                                    "speaker": "安柏",
                                    "text": "嗯？"
                                },
                                {
                                    "id": "4540112",
                                    "speaker": "雷泽",
                                    "text": "来不及解释了。我让卢皮卡散开了。因为那群人来了。他们没有善意。"
                                },
                                {
                                    "id": "4540113",
                                    "speaker": "派蒙",
                                    "text": "就是刚才那些家伙吧？"
                                },
                                {
                                    "id": "4540114",
                                    "speaker": "安柏",
                                    "text": "明白了。不过在那之前，我有些事情想要问你——"
                                },
                                {
                                    "id": "4540115",
                                    "speaker": "雷泽",
                                    "text": "有血的气味。我们要快点。"
                                },
                                {
                                    "id": "4540116",
                                    "speaker": "安柏",
                                    "text": "难道说是那群傻子被狼袭击了？！"
                                }
                            ]
                        },
                        {
                            "id": "4540106",
                            "text": "真的不是安柏吗？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "45410",
            "objective": "查看沿路的异样",
            "dialogues": []
        },
        {
            "id": "45411",
            "objective": "与安柏对话",
            "dialogues": [
                {
                    "id": "4541101",
                    "speaker": "安柏",
                    "text": "是血迹！"
                },
                {
                    "id": "4541102",
                    "speaker": "雷泽",
                    "text": "不是人，是狼的。是卢皮卡的…"
                },
                {
                    "id": "4541103",
                    "speaker": "派蒙",
                    "text": "所以卢皮卡究竟是什么啊？"
                },
                {
                    "id": "4541104",
                    "speaker": "雷泽",
                    "text": "卢皮卡——是命运的家族。如果狼接纳了人，或者人接纳了狼。他们就是卢皮卡。"
                },
                {
                    "id": "4541105",
                    "speaker": "派蒙",
                    "text": "听起来不像是人的语言啊。"
                },
                {
                    "id": "4541106",
                    "speaker": "安柏",
                    "text": "这话就很奇怪了。难道狼的交流还会用语言的吗？"
                },
                {
                    "id": "4541107",
                    "speaker": "雷泽",
                    "text": "是它定下的名字。"
                },
                {
                    "id": "4541108",
                    "speaker": "安柏",
                    "text": "…它，说的是谁？"
                },
                {
                    "id": "4541109",
                    "speaker": "雷泽",
                    "text": "这片土地的领主。"
                },
                {
                    "id": "4541110",
                    "speaker": "派蒙",
                    "text": "蒙德的主人，不应该就是巴巴托斯吗？"
                },
                {
                    "id": "4541111",
                    "speaker": "雷泽",
                    "text": "之后再说，我好像又找到线索了。跟我来。"
                },
                {
                    "id": "4541112",
                    "speaker": "安柏",
                    "text": "欸，你等等！我可是在给你机会解释自己的清白哦。"
                },
                {
                    "id": "4541113",
                    "speaker": "派蒙",
                    "text": "啊，雷泽已经走了。"
                }
            ]
        },
        {
            "id": "45412",
            "objective": "跟上雷泽",
            "dialogues": []
        },
        {
            "id": "45413",
            "objective": "与雷泽对话",
            "dialogues": [
                {
                    "id": "4541301",
                    "speaker": "雷泽",
                    "text": "是它。被那群人抓住了。"
                },
                {
                    "id": "4541302",
                    "speaker": "派蒙",
                    "text": "真是过分…"
                },
                {
                    "id": "4541303",
                    "speaker": "安柏",
                    "text": "虽然我也觉得很凄惨，但是我的立场…"
                },
                {
                    "id": "4541304",
                    "speaker": "雷泽",
                    "text": "袭击村子的不是我们！"
                },
                {
                    "id": "4541305",
                    "speaker": "雷泽",
                    "text": "是流浪而来的黑狼，还有它的狼群。它们想要领地。它们破坏了它定下的规矩。"
                },
                {
                    "id": "4541306",
                    "speaker": "派蒙",
                    "text": "<color=#00E1FFFF>它？</color>"
                },
                {
                    "id": "4541307",
                    "speaker": "雷泽",
                    "text": "这片土地的领主。"
                },
                {
                    "id": "4541308",
                    "speaker": "安柏",
                    "text": "这句话刚才听过了。你还是解释一下吧。"
                },
                {
                    "id": "4541309",
                    "speaker": "雷泽",
                    "text": "我要把卢皮卡抱到深处去。和我一起来吧。或许它会现身回答你。"
                }
            ]
        },
        {
            "id": "45414",
            "objective": "前往奔狼领深处",
            "dialogues": []
        },
        {
            "id": "45408",
            "objective": "巨大爪痕开车$HIDDEN",
            "dialogues": [
                {
                    "id": "4540801",
                    "speaker": "派蒙",
                    "text": "这是什么东西……"
                }
            ]
        },
        {
            "id": "45409",
            "objective": "大号脚印开车$HIDDEN",
            "dialogues": [
                {
                    "id": "4540901",
                    "speaker": "派蒙",
                    "text": "呜啊，之前那个就有两米。"
                }
            ]
        },
        {
            "id": "45415",
            "objective": "向雷泽了解救治伤狼的办法",
            "dialogues": [
                {
                    "id": "4541501",
                    "speaker": "派蒙",
                    "text": "这里是……"
                },
                {
                    "id": "4541502",
                    "speaker": "雷泽",
                    "text": "#{NICKNAME}，请你帮我一个忙。帮我收集这个。"
                },
                {
                    "id": "4541503",
                    "speaker": "派蒙",
                    "text": "这个不是钩钩果的种子嘛？"
                },
                {
                    "id": "4541504",
                    "speaker": "雷泽",
                    "text": "它碾碎了包扎，可以止血。"
                },
                {
                    "id": "4541505",
                    "speaker": "安柏",
                    "text": "的确。钩钩果的种子上面有层汁液，不仅能轻微麻醉痛觉，还能止血。"
                },
                {
                    "id": "4541506",
                    "speaker": "安柏",
                    "text": "书上这么说的。"
                },
                {
                    "id": "4541507",
                    "speaker": "派蒙",
                    "text": "为什么会这样啊？"
                },
                {
                    "id": "4541508",
                    "speaker": "安柏",
                    "text": "这我就不知道了。"
                },
                {
                    "id": "4541509",
                    "speaker": "雷泽",
                    "text": "钩子让种子散布。麻醉与止血，为了不痛。"
                },
                {
                    "id": "4541510",
                    "speaker": "雷泽",
                    "text": "我们会更难察觉它，把它带得更远。"
                },
                {
                    "id": "4541511",
                    "speaker": "雷泽",
                    "text": "…紫色的老师，是这么和我说的。"
                },
                {
                    "id": "4541512",
                    "speaker": "雷泽",
                    "text": "我要留在这里照看它。还有，回答另一个红色女孩子的问题。"
                },
                {
                    "id": "4541513",
                    "speaker": "安柏",
                    "text": "嗯，如果人群回来了，骑士团的面子应该有点作用。"
                },
                {
                    "id": "4541514",
                    "speaker": "安柏",
                    "text": "#你的狼朋友们并没有洗脱嫌疑呢。不过，{NICKNAME}，草药还是麻烦你了。"
                }
            ]
        },
        {
            "id": "45402",
            "objective": "采集钩钩果",
            "dialogues": [
                {
                    "id": "4540201",
                    "speaker": "安柏",
                    "text": "麻烦你去收集一下钩钩果了。我在这里有些事情要问他。"
                }
            ]
        },
        {
            "id": "45403",
            "objective": "将一枚钩钩果交给雷泽",
            "dialogues": [
                {
                    "id": "4540301",
                    "speaker": "派蒙",
                    "text": "我们回来啦！你看看这些够吗？"
                },
                {
                    "id": "4540302",
                    "speaker": "雷泽",
                    "text": "足够了。"
                },
                {
                    "id": "4540303",
                    "speaker": "安柏",
                    "text": "刚才和他谈了一下。狼群世界的规则，很不可思议啊。"
                },
                {
                    "id": "4540304",
                    "speaker": "雷泽",
                    "text": "谢谢你们。"
                },
                {
                    "id": "4540305",
                    "speaker": "神奇的霍普金斯",
                    "text": "绕了一圈都没有找到其他狼。"
                },
                {
                    "id": "4540307",
                    "speaker": "约顿",
                    "text": "狼平常是这样的。刚才抓到那条明显是智力有点问题。"
                },
                {
                    "id": "4540308",
                    "speaker": "神奇的霍普金斯",
                    "text": "干、干什么？"
                },
                {
                    "id": "4540309",
                    "speaker": "雷泽",
                    "text": "找你算账。"
                },
                {
                    "id": "4540310",
                    "speaker": "约顿",
                    "text": "就是他，传闻里被狼养大的人！"
                },
                {
                    "id": "4540311",
                    "speaker": "神奇的霍普金斯",
                    "text": "嚯？"
                },
                {
                    "id": "4540312",
                    "speaker": "神奇的霍普金斯",
                    "text": "原来就是你。我还在想狼怎么这么聪明了。"
                },
                {
                    "id": "4540313",
                    "speaker": "神奇的霍普金斯",
                    "text": "是你在帮着畜生算计人啊？"
                },
                {
                    "id": "4540314",
                    "speaker": "神奇的霍普金斯",
                    "text": "谁给吃谁就是父母吗，你忘了自己是个什么东西了？"
                },
                {
                    "id": "4540315",
                    "speaker": "安柏",
                    "text": "够了！"
                },
                {
                    "id": "4540316",
                    "speaker": "派蒙",
                    "text": "你们这是欺负雷泽不擅长说话！"
                },
                {
                    "id": "4540317",
                    "speaker": "约顿",
                    "text": "嗯？！骑士团要袒护这个人吗！"
                },
                {
                    "id": "4540318",
                    "speaker": "雷泽",
                    "text": "不是我们，袭击的村子——"
                }
            ]
        },
        {
            "id": "45404",
            "objective": "标记对话完成$HIDDEN",
            "dialogues": []
        },
        {
            "id": "45416",
            "objective": "前往北风之狼墓地",
            "dialogues": []
        },
        {
            "id": "45417",
            "objective": "结束后刷新group$HIDDEN",
            "dialogues": []
        },
        {
            "id": "45405",
            "objective": "挑战北风之狼",
            "dialogues": [
                {
                    "id": "4540501",
                    "speaker": "雷泽",
                    "text": "「请你…息怒」"
                }
            ]
        },
        {
            "id": "45406",
            "objective": "与雷泽、北风狼对话$HIDDEN",
            "dialogues": [
                {
                    "id": "4540601",
                    "speaker": "雷泽",
                    "text": "请你，息怒。"
                },
                {
                    "id": "4540602",
                    "speaker": "玻瑞亚斯",
                    "text": "哼，罢了。"
                },
                {
                    "id": "4540603",
                    "speaker": "玻瑞亚斯",
                    "text": "就像之前，这小子说的。外来的狼群破坏了这里的规矩。它们必然会被制裁。"
                },
                {
                    "id": "4540604",
                    "speaker": "玻瑞亚斯",
                    "text": "但是你——雷泽，你不准参与讨伐。因为这是狼的问题。"
                },
                {
                    "id": "4540605",
                    "speaker": "玻瑞亚斯",
                    "text": "你使用钢铁而不是爪牙，驾驭雷电而不是利齿…"
                },
                {
                    "id": "4540606",
                    "speaker": "玻瑞亚斯",
                    "text": "你属于人类。"
                },
                {
                    "id": "4540607",
                    "speaker": "雷泽",
                    "text": "我和他们，不一样！我才不属于他们！"
                },
                {
                    "id": "4540608",
                    "speaker": "玻瑞亚斯",
                    "text": "你…不是狼。这是狼之间的事情。"
                },
                {
                    "id": "4540609",
                    "speaker": "玻瑞亚斯",
                    "text": "倒是你，雷泽在人类中的卢皮卡。你倒是高尚又特殊之人。"
                },
                {
                    "id": "4540610",
                    "speaker": "玻瑞亚斯",
                    "text": "如果有心，可以向我来寻求试炼。"
                },
                {
                    "id": "4540611",
                    "speaker": "玻瑞亚斯",
                    "text": "我言尽于此，有缘再见吧，雷泽，和陌生的人类…"
                },
                {
                    "id": "4540612",
                    "speaker": "安柏",
                    "text": "唔…雷泽，别露出那种表情嘛。对了！要不要去城内住几天？"
                },
                {
                    "id": "4540613",
                    "speaker": "派蒙",
                    "text": "对啊，你在蒙德城也有一个朋友，不是吗？"
                },
                {
                    "id": "4540614",
                    "speaker": "派蒙",
                    "text": "那个「红色的、很烫的，女孩子」…"
                },
                {
                    "id": "4540615",
                    "speaker": "安柏",
                    "text": "现在野外的行人对你也很危险。我知道你不想伤害他们。"
                },
                {
                    "id": "4540616",
                    "speaker": "雷泽",
                    "text": "我没事，你们，放心。 但我不属于城市…"
                },
                {
                    "id": "4540617",
                    "speaker": "雷泽",
                    "text": "我，也不属于这里…",
                    "choices": [
                        {
                            "id": "4540618",
                            "text": "雷泽…",
                            "response": [
                                {
                                    "id": "4540621",
                                    "speaker": "雷泽",
                                    "text": "#谢谢你们。{NICKNAME}，派蒙，还有……另一个红色的女孩。"
                                },
                                {
                                    "id": "4540622",
                                    "speaker": "安柏",
                                    "text": "我陪你聊了那么久，你居然不记得我叫安柏——？！"
                                },
                                {
                                    "id": "4540623",
                                    "speaker": "雷泽",
                                    "text": "那么，再见了。"
                                }
                            ]
                        },
                        {
                            "id": "4540619",
                            "text": "不要太消沉了。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "45402",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "4540202",
                    "speaker": "雷泽",
                    "text": "钩钩果，就是这样的。它处理一下能止血。麻烦你了。"
                }
            ]
        }
    ]
}