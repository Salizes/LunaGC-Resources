            "icon": "UI_ChapterIcon_Sumeru",
            "id": "10076",
            "num": "森林书 第二章",
            "title": "梦中的苗圃"
        },
        "total_dialogue_lines": 35,
        "total_speaker_counts": {
            "Black Screen": 1,
            "Player": 6,
            "兰加惟": 13,
            "兰罗摩": 8,
            "兰罗摩和兰加惟": 1,
