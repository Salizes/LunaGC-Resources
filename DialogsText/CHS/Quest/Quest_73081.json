        }
    },
    "talks": [
        {
            "id": "7308102",
            "objective": "与兰加惟对话$HIDDEN",
            "dialogues": [
                {
                    "id": "730810301",
                    "speaker": "兰加惟",
                    "text": "是兰罗摩和金色的那菈呀，你可真高。但边上这个银色的…"
                },
                {
                    "id": "730810302",
                    "speaker": "派蒙",
                    "text": "嗯？银色的怎样？"
                },
                {
                    "id": "730810303",
                    "speaker": "兰加惟",
                    "text": "该怎么说呢…应该可以钻进很狭窄的树洞吧，很方便很方便！太好了！"
                },
                {
                    "id": "730810304",
                    "speaker": "兰罗摩",
                    "text": "#嗯！按照那菈的习俗，应该要先介绍。这是那菈{NICKNAME}和派蒙，这是兰加惟。你们握手。"
                },
                {
                    "id": "730810305",
                    "speaker": "Black Screen",
                    "text": "有点不知所措地和兰加惟握手了…\\n不敢太用力。\\n触感很特别。"
                },
                {
                    "id": "730810306",
                    "speaker": "兰加惟",
                    "text": "真有趣。以前我也听大家说过许多那菈的事，但接触到那菈的身体还是第一次。感觉很奇妙呢！"
                },
                {
                    "id": "730810307",
                    "speaker": "兰加惟",
                    "text": "上一次有那菈到我们这来，已经过了很久。许多的种子都长成了大树，许多的故事都变成了传说。据说，那是很好的那菈。"
                },
                {
                    "id": "730810308",
                    "speaker": "兰罗摩",
                    "text": "#那菈{NICKNAME}也是很好的那菈，勇敢又强壮，就像在岩壁上长出来的小树一样。而且，他们要帮助兰拉娜，才来的。"
                },
                {
                    "id": "730810309",
                    "speaker": "兰加惟",
                    "text": "哦哦，兰拉娜吗…好久没见到了，希望一切都好。也希望维摩庄的小那菈们一切都好。"
                },
                {
                    "id": "730810310",
                    "speaker": "Player",
                    "text": "你也认识维摩庄的孩子吗？"
                },
                {
                    "id": "730810311",
                    "speaker": "兰加惟",
                    "text": "当然认识呀！"
                },
                {
                    "id": "730810312",
                    "speaker": "兰罗摩",
                    "text": "我们都认识！兰拉娜回来，都跟我们说小那菈的故事。所以，那菈优丹、那菈巴兰、那菈拉娜他们，就是我们的那菈朋友。"
                },
                {
                    "id": "730810313",
                    "speaker": "派蒙",
                    "text": "这样倒也不算是认识啦…"
                },
                {
                    "id": "730810314",
                    "speaker": "兰加惟",
                    "text": "那，要怎样才算认识呢？要像那菈那样，「介绍」以后，「握手」吗？"
                },
                {
                    "id": "730810315",
                    "speaker": "兰罗摩",
                    "text": "嗯嗯，派蒙说的，我明白。那菈还要一起吃饭、一起找「宝藏」，才算认识。对不对？",
                    "choices": [
                        {
                            "id": "730810316",
                            "text": "也不是那么简单的事情…",
                            "response": [
                                {
                                    "id": "730810321",
                                    "speaker": "兰加惟",
                                    "text": "只要知道故事，就算认识。因为兰那罗的世界是歌的世界、梦的世界。"
                                },
                                {
                                    "id": "730810322",
                                    "speaker": "兰罗摩",
                                    "text": "#嗯，兰加惟说得对。对兰那罗来说，只要听到了描绘那菈{NICKNAME}的歌、梦中见到了那菈{NICKNAME}的样子，就认识了。"
                                },
                                {
                                    "id": "730810323",
                                    "speaker": "派蒙",
                                    "text": "我觉得，这个可以先放一边…因为，我们已经是兰那罗的朋友了！"
                                },
                                {
                                    "id": "730810324",
                                    "speaker": "兰罗摩和兰加惟",
                                    "text": "好朋友！",
                                    "choices": [
                                        {
                                            "id": "730810325",
                                            "text": "好朋友！",
                                            "response": [
                                                {
                                                    "id": "730810328",
                                                    "speaker": "派蒙",
                                                    "text": "嗯，我们要举办无忧节，兰加惟要做好准备！"
                                                },
                                                {
                                                    "id": "730810329",
                                                    "speaker": "兰加惟",
                                                    "text": "果然如此。是为了惟耶之实吧？我已经让兰耶娑、兰陀娑和兰修提袈去寻找「觉树之堂」了。"
                                                },
                                                {
                                                    "id": "730810330",
                                                    "speaker": "派蒙",
                                                    "text": "直觉真准…不过，为什么你们不知道觉树之堂在哪呢？"
                                                },
                                                {
                                                    "id": "730810331",
                                                    "speaker": "兰罗摩",
                                                    "text": "觉树之堂是很神圣很神圣的地方，我们一般不会去。就让莎兰树静静地沉睡在梦中吧。直到一切记忆在沙恒中交汇。"
                                                },
                                                {
                                                    "id": "730810332",
                                                    "speaker": "兰加惟",
                                                    "text": "森林会记住一切。一切美好的事物都不会消散。一切痛苦都会成为美好事物的养分…"
                                                },
                                                {
                                                    "id": "730810333",
                                                    "speaker": "兰加惟",
                                                    "text": "总之，兰耶娑、兰陀娑和兰修提袈他们在外面寻找觉树之堂。兰罗摩，你去帮帮他们吧。"
                                                },
                                                {
                                                    "id": "730810334",
                                                    "speaker": "兰罗摩",
                                                    "text": "#嗯。我会去的。如果那菈{NICKNAME}、派蒙在森林里遇到了我们，就一起冒险吧！"
                                                },
                                                {
                                                    "id": "730810335",
                                                    "speaker": "兰加惟",
                                                    "text": "#很好很好。很高兴认识你们，那菈{NICKNAME}和派蒙！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "730810327",
                                            "text": "还是先谈正事…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "730810317",
                            "text": "该怎么说呢…"
                        },
                        {
                            "id": "730810318",
                            "text": "我和派蒙一起吃饭、一起找宝藏。",
                            "response": [
                                {
                                    "id": "730810319",
                                    "speaker": "派蒙",
                                    "text": "嗯！我们不但认识，而且是最好的伙伴！"
                                },
                                {
                                    "id": "730810320",
                                    "speaker": "兰罗摩",
                                    "text": "#那菈{NICKNAME}和派蒙，真好！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7308103",
            "objective": "与兰加惟对话",
            "dialogues": []
        },
        {
            "id": "7308104",
            "objective": "找到并探索「觉树之堂」",
            "dialogues": [
                {
                    "id": "730810401",
                    "speaker": "兰加惟",
                    "text": "很高兴认识你们！等到了无忧节的时候，我们要一起开心地唱歌！"
                }
            ]
        },
