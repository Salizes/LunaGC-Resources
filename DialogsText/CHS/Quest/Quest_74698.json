    "talks": [
        {
            "id": "7469801",
            "objective": "与八重神子对话",
            "dialogues": [
                {
                    "id": "746980101",
                    "speaker": "派蒙",
                    "text": "唔…那边是神子啊，总感觉事情会变得麻烦起来呢…"
                },
                {
                    "id": "746980102",
                    "speaker": "派蒙",
                    "text": "比如上一次「三川花祭」，虽然结果上很开心啦，只不过过程上就…"
                },
                {
                    "id": "746980103",
                    "speaker": "Player",
                    "text": "而且见面就让我们签卖身契。"
                },
                {
                    "id": "746980104",
                    "speaker": "派蒙",
                    "text": "不过这次…嘿嘿，不是我们出力，肯定不会被…"
                },
                {
                    "id": "746980105",
                    "speaker": "Player",
                    "text": "小声小声…"
                },
                {
                    "id": "746980106",
                    "speaker": "八重神子",
                    "text": "#哎呀…{NICKNAME}，小派蒙。亏我们好不容易在枫丹偶遇，你们原来…"
                },
                {
                    "id": "746980107",
                    "speaker": "派蒙",
                    "text": "呜哇！神神神神子，你刚才都听到了？"
                },
                {
                    "id": "746980108",
                    "speaker": "八重神子",
                    "text": "没有。我什么都没听见，但看小派蒙的样子，应该不是什么…好话？"
                },
                {
                    "id": "746980109",
                    "speaker": "派蒙",
                    "text": "没有没有，我们也很高兴能在这里见到神子呢，嘿嘿嘿…神子来这里是干什么的呀？",
                    "choices": [
                        {
                            "id": "746980110",
                            "text": "（话题转移得好生硬…）",
                            "response": [
                                {
                                    "id": "746980112",
                                    "speaker": "八重神子",
                                    "text": "我这个苦命的主编，还能做什么？当然是为了八重堂的生意出来奔波啊。"
                                },
                                {
                                    "id": "746980113",
                                    "speaker": "八重神子",
                                    "text": "本来刚买了一箱子新书，准备带回去，让八重堂里的编辑们好好研读。"
                                },
                                {
                                    "id": "746980114",
                                    "speaker": "八重神子",
                                    "text": "没想到，却偶然看见了我的某位「老朋友」，在这个占卜摊前停了很久。"
                                },
                                {
                                    "id": "746980115",
                                    "speaker": "八重神子",
                                    "text": "她平时都不怎么来神社里抽「御神签」，现在却突然对占卜起了兴趣…"
                                },
                                {
                                    "id": "746980116",
                                    "speaker": "八重神子",
                                    "text": "但在城里闲逛的时候，听说城外有一个很灵验的占卜摊位。"
                                },
                                {
                                    "id": "746980117",
                                    "speaker": "八重神子",
                                    "text": "所以，我也过来占卜了一轮，就算是…满足一下好奇心吧。"
                                },
                                {
                                    "id": "746980118",
                                    "speaker": "派蒙",
                                    "text": "欸？已经抽过了吗？亏我还想了这么半天！"
                                },
                                {
                                    "id": "746980119",
                                    "speaker": "Player",
                                    "text": "抽到什么牌了？"
                                },
                                {
                                    "id": "746980120",
                                    "speaker": "八重神子",
                                    "text": "哎呀，对我的未来这么感兴趣啊？呵，想知道的话，我也不是不可以让你们看看。不过，你们也得付出点代价才行。"
                                },
                                {
                                    "id": "746980121",
                                    "speaker": "八重神子",
                                    "text": "我想想…要不小家伙你干脆就加入八重堂，负责把你们的冒险经历整理成书吧？"
                                },
                                {
                                    "id": "746980122",
                                    "speaker": "八重神子",
                                    "text": "就按时下流行的起名方式，叫《开局捡到应急食品，而后天下无敌》好了，想想就一定能大卖。"
                                },
                                {
                                    "id": "746980123",
                                    "speaker": "Player",
                                    "text": "那这本书还挺厚的…"
                                },
                                {
                                    "id": "746980124",
                                    "speaker": "八重神子",
                                    "text": "没关系。只要有趣，多厚都行。本社之前还出版过一部叫《悖论后的地平线》的轻小说呢。"
                                },
                                {
                                    "id": "746980125",
                                    "speaker": "八重神子",
                                    "text": "那本书，可是厚得和字典一样，而且还足足出了八部，算上三本设定集和六本衍生外传，叠起来都能顶到天花板了。"
                                },
                                {
                                    "id": "746980126",
                                    "speaker": "八重神子",
                                    "text": "小家伙，你要是能写这么多，那我这个主编，就亲自来做你的责任编辑，怎么样？",
                                    "choices": [
                                        {
                                            "id": "746980127",
                                            "text": "你就是想催我稿！",
                                            "response": [
                                                {
                                                    "id": "746980129",
                                                    "speaker": "八重神子",
                                                    "text": "哎呀，那你对我抽到的牌也不感兴趣喽？"
                                                },
                                                {
                                                    "id": "746980130",
                                                    "speaker": "Player",
                                                    "text": "我突然也没这么想看了…"
                                                },
                                                {
                                                    "id": "746980131",
                                                    "speaker": "派蒙",
                                                    "text": "是啊！其实我们也没有那么——"
                                                },
                                                {
                                                    "id": "746980132",
                                                    "speaker": "八重神子",
                                                    "text": "啊，这就是我抽到的牌。"
                                                },
                                                {
                                                    "id": "746980133",
                                                    "speaker": "八重神子",
                                                    "text": "用这位芭比洛斯女士的描述就是…逆位的「正义」。",
                                                    "choices": [
                                                        {
                                                            "id": "746980134",
                                                            "text": "我蒙住眼睛了！",
                                                            "response": [
                                                                {
                                                                    "id": "746980136",
                                                                    "speaker": "八重神子",
                                                                    "text": "不想看？好吧，唉，这么不喜欢占卜，那下次你们来抽「御神签」的时候，我这个不讨人喜欢的宫司，就不帮你抽了。"
                                                                },
                                                                {
                                                                    "id": "746980137",
                                                                    "speaker": "八重神子",
                                                                    "text": "这么说来，你们最近是不是经常来神社挂绘马来着？不如…",
                                                                    "choices": [
                                                                        {
                                                                            "id": "746980138",
                                                                            "text": "这张牌抽得真好！",
                                                                            "response": [
                                                                                {
                                                                                    "id": "746980140",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "我说你啊——"
                                                                                },
                                                                                {
                                                                                    "id": "746980141",
                                                                                    "speaker": "八重神子",
                                                                                    "text": "好是好，但可惜，我抽到的这张「正义」是逆位的…是在说，我是一个坏人吗？占卜师女士。"
                                                                                },
                                                                                {
                                                                                    "id": "746980142",
                                                                                    "speaker": "芭比洛斯",
                                                                                    "text": "虽然牌名为「正义」，但它并不代指普遍意义上的「好人」或「坏人」。"
                                                                                },
                                                                                {
                                                                                    "id": "746980160",
                                                                                    "speaker": "芭比洛斯",
                                                                                    "text": "不如说…如今处于逆位的它，所指代的是「不诚实的人」。"
                                                                                },
                                                                                {
                                                                                    "id": "746980143",
                                                                                    "speaker": "八重神子",
                                                                                    "text": "不诚实。怎么会呢，我平时给这小家伙解签的时候，可都是诚实得要命呢…是不是？"
                                                                                },
                                                                                {
                                                                                    "id": "746980144",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "#我只记得，每次神子帮{NICKNAME}主持抽签的时候，{NICKNAME}抽到的都是大吉…"
                                                                                },
                                                                                {
                                                                                    "id": "746980145",
                                                                                    "speaker": "八重神子",
                                                                                    "text": "#那是这小家伙运气好，或者说，{M#他}{F#她}待在本宫司身边的时候，运气很好。"
                                                                                },
                                                                                {
                                                                                    "id": "746980146",
                                                                                    "speaker": "芭比洛斯",
                                                                                    "text": "运气…那倒是巧了。逆位的「正义」，确实象征着偏差的因果、失衡、不诚实…还有不满足。"
                                                                                },
                                                                                {
                                                                                    "id": "746980147",
                                                                                    "speaker": "芭比洛斯",
                                                                                    "text": "这位妖怪小姐，应该听得懂。毕竟，「妖怪」的诞生，本就和「欲望」关系紧密。"
                                                                                },
                                                                                {
                                                                                    "id": "746980148",
                                                                                    "speaker": "芭比洛斯",
                                                                                    "text": "对于某物的渴求，未曾完成的梦想，未竟的某种大业，被某种情感吸引…"
                                                                                },
                                                                                {
                                                                                    "id": "746980149",
                                                                                    "speaker": "芭比洛斯",
                                                                                    "text": "只要些许契机，这些未曾被满足的「欲望」，就会生根成长，蔓延出意料之外的根芽。"
                                                                                },
                                                                                {
                                                                                    "id": "746980150",
                                                                                    "speaker": "芭比洛斯",
                                                                                    "text": "而你这位稻妻的「大妖怪」，心中大概也埋着更为庞大的「欲望」…"
                                                                                },
                                                                                {
                                                                                    "id": "746980151",
                                                                                    "speaker": "八重神子",
                                                                                    "text": "……"
                                                                                },
                                                                                {
                                                                                    "id": "746980152",
                                                                                    "speaker": "芭比洛斯",
                                                                                    "text": "但更多的我也看不见了。毕竟只抽了一张牌嘛，而且逆位的「正义」也很擅长掩盖和谎言，无论是对他人，还是对自己。"
                                                                                },
                                                                                {
                                                                                    "id": "746980153",
                                                                                    "speaker": "八重神子",
                                                                                    "text": "听着云山雾罩的，很像是我神社里各位巫女解签时候的说法。没想到来这一趟，还能收获这种全新的占卜话术，还挺有趣的。"
                                                                                },
                                                                                {
                                                                                    "id": "746980154",
                                                                                    "speaker": "八重神子",
                                                                                    "text": "不过，有趣归有趣，但这种话术和本社的经营理念不符，不能教给各位巫女了。"
                                                                                },
                                                                                {
                                                                                    "id": "746980155",
                                                                                    "speaker": "八重神子",
                                                                                    "text": "但总归，感谢这位魔女的占卜。有机会的话，请你也去鸣神大社坐坐，让我也为你做一做占卜，怎么样？"
                                                                                },
                                                                                {
                                                                                    "id": "746980156",
                                                                                    "speaker": "芭比洛斯",
                                                                                    "text": "可惜，水占术就够我忙的了，可分不出空来体验其他的占卜形式。"
                                                                                },
                                                                                {
                                                                                    "id": "746980157",
                                                                                    "speaker": "芭比洛斯",
                                                                                    "text": "但这「御神签」听着像是尼可和艾莉丝会喜欢的游乐项目，我会告诉她们的。"
                                                                                },
                                                                                {
                                                                                    "id": "746980158",
                                                                                    "speaker": "八重神子",
                                                                                    "text": "好啊，到时候，我来主持各位魔女的抽签仪式。"
                                                                                },
                                                                                {
                                                                                    "id": "746980159",
                                                                                    "speaker": "八重神子",
                                                                                    "text": "我保证，各位都能抽到上好的吉签。"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "746980139",
                                                                            "text": "正义这牌，听着就好！"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "746980135",
                                                            "text": "我捂住耳朵了！"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "746980128",
                                            "text": "不了不了我还要冒险…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "746980111",
                            "text": "（完全被神子诈到了…）"
                        }
                    ]
                }
            ]
        },
