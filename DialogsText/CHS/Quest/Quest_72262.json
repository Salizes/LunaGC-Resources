    "talks": [
        {
            "id": "7226201",
            "objective": "(test)在活动界面接取第5天任务$HIDDEN",
            "dialogues": [
                {
                    "id": "722620101",
                    "speaker": "「吉法师」",
                    "text": "哇。这里的大海，漂亮。"
                },
                {
                    "id": "722620102",
                    "speaker": "派蒙",
                    "text": "欸？荻花洲不是大海啦。"
                },
                {
                    "id": "722620103",
                    "speaker": "Player",
                    "text": "但荻花洲的水域确实和海连在一起…"
                },
                {
                    "id": "722620104",
                    "speaker": "派蒙",
                    "text": "嗯，说得也是…不过，如果要说荻花洲是海，感觉还是不对。"
                },
                {
                    "id": "722620105",
                    "speaker": "「吉法师」",
                    "text": "呶…不是很明白。「大海」和「不是大海」，区别是什么？",
                    "choices": [
                        {
                            "id": "722620106",
                            "text": "水的味道？",
                            "response": [
                                {
                                    "id": "722620107",
                                    "speaker": "「吉法师」",
                                    "text": "喔！森林的溪水有点甜味，所以不是海。"
                                },
                                {
                                    "id": "722620108",
                                    "speaker": "派蒙",
                                    "text": "但是，如果果酒湖里都是果酒的话，应该算什么呢…？"
                                },
                                {
                                    "id": "722620109",
                                    "speaker": "Player",
                                    "text": "那样的话温迪会很快乐吧。"
                                },
                                {
                                    "id": "722620120",
                                    "speaker": "派蒙",
                                    "text": "不过，这个问题先放一边，吉法师是不是越来越会说话了？",
                                    "choices": [
                                        {
                                            "id": "722620121",
                                            "text": "按照之前五百藏的说法…",
                                            "response": [
                                                {
                                                    "id": "722620123",
                                                    "speaker": "派蒙",
                                                    "text": "五百藏说了什么来着？「吾辈乃是名震天下的妖狸」…不对，不是这个…"
                                                },
                                                {
                                                    "id": "722620124",
                                                    "speaker": "派蒙",
                                                    "text": "「想挠肚皮，呜呶呶。」…「咿！」…也不是…"
                                                },
                                                {
                                                    "id": "722620125",
                                                    "speaker": "「吉法师」",
                                                    "text": "呶哈哈，派蒙学得好像。好好笑哦。"
                                                },
                                                {
                                                    "id": "722620126",
                                                    "speaker": "Player",
                                                    "text": "「适应吉法师的气息…」"
                                                },
                                                {
                                                    "id": "722620127",
                                                    "speaker": "派蒙",
                                                    "text": "啊，对哦！我们越适应吉法师的气息，就越能理解吉法师的意思。"
                                                },
                                                {
                                                    "id": "722620128",
                                                    "speaker": "「吉法师」",
                                                    "text": "#还有修行呶！和{NICKNAME}、派蒙一起，吉法师学会了好多好多事情！",
                                                    "choices": [
                                                        {
                                                            "id": "722620129",
                                                            "text": "派蒙可是个好向导呢。",
                                                            "response": [
                                                                {
                                                                    "id": "722620130",
                                                                    "speaker": "派蒙",
                                                                    "text": "欸…"
                                                                },
                                                                {
                                                                    "id": "722620131",
                                                                    "speaker": "派蒙",
                                                                    "text": "#那么久以前的事，{NICKNAME}还记得呀。好开心。"
                                                                },
                                                                {
                                                                    "id": "722620132",
                                                                    "speaker": "「吉法师」",
                                                                    "text": "#嗯！谢谢派蒙和{NICKNAME}。"
                                                                },
                                                                {
                                                                    "id": "722620136",
                                                                    "speaker": "「吉法师」",
                                                                    "text": "这里的「不知道算不算大海」很漂亮，后面还有好高好高的漂亮房子。帮吉法师拍照？"
                                                                },
                                                                {
                                                                    "id": "722620137",
                                                                    "speaker": "Player",
                                                                    "text": "交给我吧。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "722620133",
                                                            "text": "一起冒险的伙伴，能一起成长。",
                                                            "response": [
                                                                {
                                                                    "id": "722620134",
                                                                    "speaker": "「吉法师」",
                                                                    "text": "嗯！伙伴。"
                                                                },
                                                                {
                                                                    "id": "722620135",
                                                                    "speaker": "派蒙",
                                                                    "text": "最好的伙伴！"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "722620122",
                                            "text": "出发前，五百藏好像说过…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "722620110",
                            "text": "陆地主体之外的大型水域是海？",
                            "response": [
                                {
                                    "id": "722620111",
                                    "speaker": "派蒙",
                                    "text": "哇，听起来好严谨的答案！但是，这样的话，问题又回到了「分界」上呢。"
                                },
                                {
                                    "id": "722620112",
                                    "speaker": "「吉法师」",
                                    "text": "#{NICKNAME}刚刚说，荻花洲的水和大海连在一起。那「陆地煮煮」和不是「陆地煮煮」，区别又是什么哩？"
                                },
                                {
                                    "id": "722620113",
                                    "speaker": "派蒙",
                                    "text": "…虽然听起来严谨，却没有解决任何问题呢！"
                                }
                            ]
                        },
                        {
                            "id": "722620114",
                            "text": "这些概念都是人强加的。没有意义。",
                            "response": [
                                {
                                    "id": "722620115",
                                    "speaker": "Player",
                                    "text": "荻花洲觉得自己是大海，就是大海。"
                                },
                                {
                                    "id": "722620116",
                                    "speaker": "「吉法师」",
                                    "text": "吉法师觉得自己是仙人，就是仙人呶？"
                                },
                                {
                                    "id": "722620117",
                                    "speaker": "派蒙",
                                    "text": "#喂！吉法师别听{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}的。{NICKNAME}，你在说什么呀…"
                                },
                                {
                                    "id": "722620118",
                                    "speaker": "派蒙",
                                    "text": "…不过，虽然是歪理，也不是完全没道理啦。吉法师想成为什么样的妖狸，就能成为什么样的妖狸！说不定未来能变成仙狸呢！"
                                },
                                {
                                    "id": "722620119",
                                    "speaker": "「吉法师」",
                                    "text": "仙狸！耶！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7226202",
            "objective": "前往能望到荻花洲的地方",
            "dialogues": []
        },
        {
            "id": "7226203",
            "objective": "为吉法师拍照",
            "dialogues": [
                {
                    "id": "722620301",
                    "speaker": "「吉法师」",
                    "text": "呜呶呶…为什么…"
                },
                {
                    "id": "722620302",
                    "speaker": "派蒙",
                    "text": "吉法师真是的！怎么就冲进丘丘人的据点里了呢？"
                },
                {
                    "id": "722620303",
                    "speaker": "「吉法师」",
                    "text": "本来以为…能和丘丘人一起玩…"
                },
                {
                    "id": "722620304",
                    "speaker": "派蒙",
                    "text": "欸？为什么这么想？丘丘人是很危险的魔物…",
                    "choices": [
                        {
                            "id": "722620305",
                            "text": "噗，丘丘人也没有很危险啦…",
                            "response": [
                                {
                                    "id": "722620306",
                                    "speaker": "派蒙",
                                    "text": "喂！吉法师可不是像你这样身经百战的旅行者啦！"
                                },
                                {
                                    "id": "722620309",
                                    "speaker": "Player",
                                    "text": "在镇守之森第一次见面的时候…"
                                },
                                {
                                    "id": "722620310",
                                    "speaker": "派蒙",
                                    "text": "对呀，当时吉法师不是被丘丘人包围着，变成了什么东西躲起来了吗？"
                                },
                                {
                                    "id": "722620311",
                                    "speaker": "「吉法师」",
                                    "text": "刚刚见到你们的时候…我想想…我想想…啊，对了。"
                                },
                                {
                                    "id": "722620312",
                                    "speaker": "「吉法师」",
                                    "text": "那时候，是在和丘丘人捉迷藏。森林里的丘丘人，是不会攻击妖狸的。而且，经常陪我们玩。"
                                },
                                {
                                    "id": "722620313",
                                    "speaker": "派蒙",
                                    "text": "欸？是形成了什么和谐共生的关系吗…"
                                },
                                {
                                    "id": "722620314",
                                    "speaker": "「吉法师」",
                                    "text": "不知道为什么，这里的丘丘人会这样。呜呶呶…"
                                },
                                {
                                    "id": "722620315",
                                    "speaker": "派蒙",
                                    "text": "总之，在外面要多加小心啦！即使是丘丘人…不对，应该说，正因为是丘丘人…"
                                },
                                {
                                    "id": "722620316",
                                    "speaker": "派蒙",
                                    "text": "#呜哇，好复杂…{NICKNAME}，你来帮我说！"
                                },
                                {
                                    "id": "722620317",
                                    "speaker": "Player",
                                    "text": "要学会分辨好人和坏人。"
                                },
                                {
                                    "id": "722620318",
                                    "speaker": "派蒙",
                                    "text": "嗯！这样才能在外面，保护好自己。"
                                },
                                {
                                    "id": "722620319",
                                    "speaker": "Player",
                                    "text": "但是也不要忘了善良和开放的心。"
                                },
                                {
                                    "id": "722620320",
                                    "speaker": "派蒙",
                                    "text": "嗯嗯，没错！这样才能容纳美好的事物。"
                                },
                                {
                                    "id": "722620321",
                                    "speaker": "「吉法师」",
                                    "text": "呶…"
                                },
                                {
                                    "id": "722620322",
                                    "speaker": "「吉法师」",
                                    "text": "#{NICKNAME}和派蒙说得好复杂，吉法师听不懂。"
                                },
                                {
                                    "id": "722620323",
                                    "speaker": "「吉法师」",
                                    "text": "但是，吉法师知道，你们是好人。所以，吉法师要学你们。"
                                },
                                {
                                    "id": "722620324",
                                    "speaker": "派蒙",
                                    "text": "#好啦，不说这个了。先跟{NICKNAME}学习钓鱼吧！"
                                },
                                {
                                    "id": "722620325",
                                    "speaker": "「吉法师」",
                                    "text": "嗯！钓鱼！"
                                }
                            ]
                        },
                        {
                            "id": "722620307",
                            "text": "哎吔，非常恐怖！",
                            "response": [
                                {
                                    "id": "722620308",
                                    "speaker": "派蒙",
                                    "text": "也不用这样吓唬他啦！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7226204",
            "objective": "与吉法师对话",
            "dialogues": [
                {
                    "id": "722620201",
                    "speaker": "派蒙",
                    "text": "拍好了！"
                },
                {
                    "id": "722620202",
                    "speaker": "派蒙",
                    "text": "接下来的话…"
                },
                {
                    "id": "722620203",
                    "speaker": "派蒙",
                    "text": "嗯，就这么办吧！吉法师，钓过鱼吗？"
                },
                {
                    "id": "722620204",
                    "speaker": "「吉法师」",
                    "text": "钓鱼？"
                },
                {
                    "id": "722620205",
                    "speaker": "派蒙",
                    "text": "看来没试过呢！走，我们到水边去吧！"
                },
                {
                    "id": "722620206",
                    "speaker": "「吉法师」",
                    "text": "好！"
                }
            ]
        },
        {
            "id": "7226205",
            "objective": "跟上吉法师",
            "dialogues": [
                {
                    "id": "722620501",
                    "speaker": "「吉法师」",
                    "text": "好想玩水呶。"
                },
                {
                    "id": "722620502",
                    "speaker": "Player",
                    "text": "现在不可以，会把鱼儿吓跑的。"
                },
                {
                    "id": "722620503",
                    "speaker": "「吉法师」",
                    "text": "嗯。知道了。"
                }
            ]
        },
        {
            "id": "7226206",
            "objective": "打败丘丘人",
            "dialogues": [
                {
                    "id": "722620601",
                    "speaker": "「吉法师」",
                    "text": "呶，为什么不能直接到水里去抓鱼呢？",
                    "choices": [
                        {
                            "id": "722620602",
                            "text": "有的鱼是捉不到的。",
                            "response": [
                                {
                                    "id": "722620605",
                                    "speaker": "派蒙",
                                    "text": "嗯，钓鱼也是一种很好的修行方式喔！",
                                    "choices": [
                                        {
                                            "id": "722620606",
                                            "text": "吉法师，你来试试。",
                                            "response": [
                                                {
                                                    "id": "722620607",
                                                    "speaker": "「吉法师」",
                                                    "text": "呶？"
                                                },
                                                {
                                                    "id": "722620610",
                                                    "speaker": "Black Screen",
                                                    "text": "最终还是让吉法师来尝试钓鱼。\\n应该算是理所应当吧，并没有什么收获。\\n最终三人放弃了钓鱼，在水边玩闹了一番。"
                                                },
                                                {
                                                    "id": "722620611",
                                                    "speaker": "派蒙",
                                                    "text": "虽然被水弄湿很不舒服，但玩水真开心呢！"
                                                },
                                                {
                                                    "id": "722620612",
                                                    "speaker": "「吉法师」",
                                                    "text": "吉法师很开心！不过，钓鱼好难。"
                                                },
                                                {
                                                    "id": "722620613",
                                                    "speaker": "派蒙",
                                                    "text": "#嗯，不过如果学会钓鱼，说不定能结交意想不到的朋友，对吧{NICKNAME}？",
                                                    "choices": [
                                                        {
                                                            "id": "722620614",
                                                            "text": "没错。",
                                                            "response": [
                                                                {
                                                                    "id": "722620617",
                                                                    "speaker": "「吉法师」",
                                                                    "text": "虽然不是很明白，不过又好像明白了呶。"
                                                                },
                                                                {
                                                                    "id": "722620618",
                                                                    "speaker": "「吉法师」",
                                                                    "text": "#和{NICKNAME}、派蒙一起玩，很开心。{NICKNAME}和派蒙是吉法师的好朋友。"
                                                                },
                                                                {
                                                                    "id": "722620619",
                                                                    "speaker": "「吉法师」",
                                                                    "text": "修行真好！"
                                                                },
                                                                {
                                                                    "id": "722620620",
                                                                    "speaker": "派蒙",
                                                                    "text": "这么说来，一开始五百藏定下的目标，是去八个地方修行…"
                                                                },
                                                                {
                                                                    "id": "722620621",
                                                                    "speaker": "派蒙",
                                                                    "text": "龙脊雪山、孤云阁、蒙德城、璃月港、琥牢山，加上今天…这次修行，已经完成一大半了！"
                                                                },
                                                                {
                                                                    "id": "722620622",
                                                                    "speaker": "「吉法师」",
                                                                    "text": "是的呶…"
                                                                },
                                                                {
                                                                    "id": "722620623",
                                                                    "speaker": "派蒙",
                                                                    "text": "嗯，接下来应该去什么地方呢…"
                                                                },
                                                                {
                                                                    "id": "722620624",
                                                                    "speaker": "Player",
                                                                    "text": "交给你了。"
                                                                },
                                                                {
                                                                    "id": "722620625",
                                                                    "speaker": "派蒙",
                                                                    "text": "#呜哇，是{NICKNAME}很少有机会说的台词！"
                                                                },
                                                                {
                                                                    "id": "722620626",
                                                                    "speaker": "派蒙",
                                                                    "text": "嗯，交给我吧！"
                                                                },
                                                                {
                                                                    "id": "722620627",
                                                                    "speaker": "「吉法师」",
                                                                    "text": "交给派蒙呶！"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "722620615",
                                                            "text": "没错，不过伙食开销也可能会变大。",
                                                            "response": [
                                                                {
                                                                    "id": "722620616",
                                                                    "speaker": "派蒙",
                                                                    "text": "喂！"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "722620608",
                                            "text": "派蒙，你来试试。",
                                            "response": [
                                                {
                                                    "id": "722620609",
                                                    "speaker": "派蒙",
                                                    "text": "派蒙会被拖到海里去的啦！"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "722620603",
                            "text": "虽然麻烦，但可能比较有趣。"
                        },
                        {
                            "id": "722620604",
                            "text": "这也是一种修行。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7226207",
            "objective": "与吉法师对话",
            "dialogues": []
        },
        {
            "id": "7226208",
            "objective": "前往目的地",
            "dialogues": [
                {
                    "id": "722620401",
                    "speaker": "派蒙",
                    "text": "嗯，这边应该不错！"
                },
                {
                    "id": "722620402",
                    "speaker": "「吉法师」",
                    "text": "吉法师想玩水！"
                },
                {
                    "id": "722620403",
                    "speaker": "派蒙",
                    "text": "喂，现在不行！会把鱼儿吓跑的！"
                },
                {
                    "id": "722620404",
                    "speaker": "Black Screen",
                    "text": "简单扼要地教了教钓鱼的基础。\\n虽说教学尽量简明扼要，但究竟能听懂多少呢…"
                },
                {
                    "id": "722620405",
                    "speaker": "「吉法师」",
                    "text": "鱼儿！"
                },
                {
                    "id": "722620406",
                    "speaker": "Player",
                    "text": "听明白了吗？"
                },
                {
                    "id": "722620407",
                    "speaker": "「吉法师」",
                    "text": "呶哈哈，鱼儿好笨哦。会被吃的东西骗。",
                    "choices": [
                        {
