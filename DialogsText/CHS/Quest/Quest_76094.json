    "talks": [
        {
            "id": "7609401",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "760940101",
                    "speaker": "瓦加劳",
                    "text": "到底要怎么把那家伙弄出来呢，真是伤脑筋啊…"
                },
                {
                    "id": "760940102",
                    "speaker": "Player",
                    "text": "有什么能帮上忙的吗？"
                },
                {
                    "id": "760940103",
                    "speaker": "瓦加劳",
                    "text": "嗯？哦哦，是热心的冒险家啊，遇上你真是太好了。"
                },
                {
                    "id": "760940104",
                    "speaker": "瓦加劳",
                    "text": "事情是这样的，穿过这里的岩洞原本有一条通往北方的道路，不过前段时间因为月矩力的异变而发生了坍塌。"
                },
                {
                    "id": "760940105",
                    "speaker": "瓦加劳",
                    "text": "虽然所幸没造成什么人员伤亡，但有位异国的行商说他的「伙伴」 被困在了里面…"
                },
                {
                    "id": "760940106",
                    "speaker": "瓦加劳",
                    "text": "那是一只他在附近结识的獭懒羊。你要是在这里待得够久就会知道，獭懒羊跟着你多半只是为了把携带的种子播撒到远方。"
                },
                {
                    "id": "760940107",
                    "speaker": "瓦加劳",
                    "text": "但那位先生怎么跟他解释都不听，一定要我们想办法把它救出来。"
                },
                {
                    "id": "760940108",
                    "speaker": "瓦加劳",
                    "text": "要想重新连接通往洞穴深处的道路，只能利用这些璇珑花。可惜我既不会霜月之子的魔法，也没有强力的月矩力机关…"
                },
                {
                    "id": "760940109",
                    "speaker": "瓦加劳",
                    "text": "不过幸好遇上了你，如果是冒险家的话，应该能有办法把里面的獭懒羊带出来吧？"
                },
                {
                    "id": "760940110",
                    "speaker": "瓦加劳",
                    "text": "我会替那位先生感谢你的。"
                }
            ]
        },
        {
            "id": "7609402",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7609404",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7609403",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "760940301",
                    "speaker": "瓦加劳",
                    "text": "如果是冒险家的话，应该能有办法把里面的獭懒羊带出来吧？我会替那位先生感谢你的。"
                }
            ]
        },
        {
            "id": "7609405",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "760940201",
                    "speaker": "瓦加劳",
                    "text": "太好了，我就知道你果然会有办法！"
                },
                {
                    "id": "760940202",
                    "speaker": "瓦加劳",
                    "text": "虽说獭懒羊无法在没有月矩力的环境下生存，不过至少在挪德卡莱的这段时间里也能给那位先生一点慰藉吧。"
                },
                {
                    "id": "760940203",
                    "speaker": "瓦加劳",
                    "text": "那么我就先行告退了，这是一点小小的感谢，不成敬意…"
                }
            ]
        },
        {
            "id": "7609405",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "760940501",
                    "speaker": "瓦加劳",
                    "text": "哎呀，这是之前有位异国的行商被困在洞穴里的「伙伴」 ，没想到被你救了出来。"
                },
                {
                    "id": "760940502",
                    "speaker": "瓦加劳",
                    "text": "虽说我们都知道獭懒羊会跟着你多半只是为了把携带的种子播撒到远方，但那位先生怎么跟他解释都不听。"
                },
                {
                    "id": "760940503",
                    "speaker": "瓦加劳",
                    "text": "我正为此发愁呢，幸好遇到了你这样热心的冒险家。"
                },
                {
                    "id": "760940504",
                    "speaker": "瓦加劳",
                    "text": "这是一点小小的感谢，不成敬意…"
                }
            ]
        }
    ]
}