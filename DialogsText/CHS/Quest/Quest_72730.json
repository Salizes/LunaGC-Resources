    "talks": [
        {
            "id": "7273001",
            "objective": "前往冒险家协会",
            "dialogues": []
        },
        {
            "id": "7273002",
            "objective": "旁听荒泷派的讨论",
            "dialogues": [
                {
                    "id": "727300201",
                    "speaker": "阿守",
                    "text": "老大，不能就这么算了啊！"
                },
                {
                    "id": "727300202",
                    "speaker": "阿守",
                    "text": "你好不容易打响了「真剑斗虫大鬼王」的名号，怎么能让那个小鬼得逞！"
                },
                {
                    "id": "727300203",
                    "speaker": "阿晃",
                    "text": "对，那个小鬼一定使诈了，他暗算了老大！"
                },
                {
                    "id": "727300204",
                    "speaker": "荒泷一斗",
                    "text": "你们两个，慌什么！"
                },
                {
                    "id": "727300205",
                    "speaker": "荒泷一斗",
                    "text": "之前的那一仗，本大爷也有点轻敌。谁让那个小鬼看起来太普通了嘛！不算数，不算数！"
                },
                {
                    "id": "727300206",
                    "speaker": "荒泷一斗",
                    "text": "别管那小鬼耍了什么把戏，我们就按计划，摆开「荒泷极意堂堂斗虫大试合」的阵势，再拿出本大爷锤炼多年的「赤红一杵」！"
                },
                {
                    "id": "727300207",
                    "speaker": "荒泷一斗",
                    "text": "到时候，满场都是观众们为本大爷叫好的呼声，再加上「赤红一杵」碾压性的实力…"
                },
                {
                    "id": "727300208",
                    "speaker": "荒泷一斗",
                    "text": "那个小鬼绝对会吓得两腿发抖吧，什么伎俩都使不出来！本大爷轻轻松松就能把他拿下，啊哈哈哈哈哈哈哈哈哈！"
                },
                {
                    "id": "727300209",
                    "speaker": "阿守",
                    "text": "老大英明！！！"
                },
                {
                    "id": "727300210",
                    "speaker": "阿晃",
                    "text": "可是，忍姐不知道什么时候才会回来，要举办这场「荒泷极意堂堂斗虫大试合」，从什么地方下手才好？"
                },
                {
                    "id": "727300211",
                    "speaker": "阿晃",
                    "text": "根据「荒泷极上盛世豪鼓大祭典」的经验，我们需要提前向天领奉行报备，拿到活动举办许可…好像还有个场地租用凭证。"
                },
                {
                    "id": "727300212",
                    "speaker": "阿晃",
                    "text": "这些好像都需要经费，考虑到要把「极意大试合」举办得比「豪鼓大祭典」更热闹，至少得花三倍的摩拉…"
                },
                {
                    "id": "727300213",
                    "speaker": "荒泷一斗",
                    "text": "停停停停停！一听到天领奉行这四个字，我就头疼得厉害！"
                },
                {
                    "id": "727300214",
                    "speaker": "荒泷一斗",
                    "text": "至于经费…大不了我们就别做一休三了！加把劲，做二休四！这样我们加起来多做了四天工，整整多赚四倍摩拉，肯定够了！"
                },
                {
                    "id": "727300215",
                    "speaker": "阿晃",
                    "text": "不愧是老大！这样一来，我们只需要考虑参战的将士了！参战的将士也不用太强，能帮老大应付对方的杂兵就行！"
                },
                {
                    "id": "727300216",
                    "speaker": "阿守",
                    "text": "对哦！那小鬼说过，他还会带五个斗虫好手过来，和我们公正对决。问题是荒泷派里精通斗虫的，就只有老大你了…"
                },
                {
                    "id": "727300217",
                    "speaker": "阿守",
                    "text": "要是他们对老大发起车轮战，就算老大的实力再强，也会吃不消的！"
                },
                {
                    "id": "727300218",
                    "speaker": "荒泷一斗",
                    "text": "你们两个！明明还没开始准备，怎么就畏手畏脚了？"
                },
                {
                    "id": "727300219",
                    "speaker": "荒泷一斗",
                    "text": "拿出荒泷派的志气来！这点小问题，本大爷会想办法解决的！"
                },
                {
                    "id": "727300220",
                    "speaker": "荒泷一斗",
                    "text": "要不然，先去把以前斗虫的小友们找过来，商量一下？或者去长野原烟花店看看，问问她能不能参战…"
                },
                {
                    "id": "727300221",
                    "speaker": "荒泷一斗",
                    "text": "不成！那样的话，本大爷败给一个小鬼的事，很快就会传遍整个花见坂，谁丢得起那个脸！"
                },
                {
                    "id": "727300222",
                    "speaker": "派蒙",
                    "text": "嗯哼！放牛的，你又在搞什么名堂？"
                },
                {
                    "id": "727300223",
                    "speaker": "荒泷一斗",
                    "text": "喂！吓死本大爷了，你们什么时候来的！"
                },
                {
                    "id": "727300224",
                    "speaker": "派蒙",
                    "text": "居然还好意思问我们，我们站在这里很久了哦。"
                },
                {
                    "id": "727300225",
                    "speaker": "派蒙",
                    "text": "#我和{NICKNAME}本来想去冒险家协会，结果远远就看见你们在这里吵吵嚷嚷，说着一大堆不明所以的话…",
                    "choices": [
                        {
                            "id": "727300226",
                            "text": "「真剑斗虫大鬼王」？",
                            "response": [
                                {
                                    "id": "727300228",
                                    "speaker": "荒泷一斗",
                                    "text": "是「大」试合！少了一个大字，可就完全不够热血了！"
                                },
                                {
                                    "id": "727300229",
                                    "speaker": "荒泷一斗",
                                    "text": "我的挚友啊，如果你也多多斗虫，一定能明白斗虫激动人心的地方！"
                                },
                                {
                                    "id": "727300230",
                                    "speaker": "派蒙",
                                    "text": "所以说，你是不是被什么人打败了，正琢磨着怎么挽回面子？"
                                },
                                {
                                    "id": "727300231",
                                    "speaker": "荒泷一斗",
                                    "text": "话可不能这么说，那都是暗算，暗算！"
                                },
                                {
                                    "id": "727300232",
                                    "speaker": "阿守",
                                    "text": "没错，有个叫「花角玉将」的小鬼，看准老大和其他小友切磋后的疲劳时期，突然加入对局，向老大发起了挑战。"
                                },
                                {
                                    "id": "727300233",
                                    "speaker": "阿守",
                                    "text": "用一只大得夸张的鬼兜虫，哐哐两下就把老大的虫子挑翻了。"
                                },
                                {
                                    "id": "727300234",
                                    "speaker": "阿守",
                                    "text": "还说什么，要让老大了解「斗虫强者的真实世界」…"
                                },
                                {
                                    "id": "727300235",
                                    "speaker": "荒泷一斗",
                                    "text": "喂，阿守！不用把我战败的过程说得这么清楚！"
                                },
                                {
                                    "id": "727300236",
                                    "speaker": "Player",
                                    "text": "好像明白了原委…"
                                },
                                {
                                    "id": "727300237",
                                    "speaker": "荒泷一斗",
                                    "text": "言归正传，我好像听说过，我的挚友无论干什么都很有天赋，两三下就能学会一门新技艺，而且比大部分人还厉害…"
                                },
                                {
                                    "id": "727300238",
                                    "speaker": "派蒙",
                                    "text": "我已经猜到你要说什么了，放牛的！"
                                },
                                {
                                    "id": "727300239",
                                    "speaker": "派蒙",
                                    "text": "你是不是想拜托我们帮你报仇，打败那个什么「花角玉将」，让我们打白工了？"
                                },
                                {
                                    "id": "727300240",
                                    "speaker": "荒泷一斗",
                                    "text": "打白工？飞行矮堇瓜，我荒泷一斗是那么不讲义气的人吗？"
                                },
                                {
                                    "id": "727300241",
                                    "speaker": "荒泷一斗",
                                    "text": "要是我的挚友答应帮我，我就包下你们两个月的午饭，每天都请你们吃一碗招牌拉面，怎么样？"
                                },
                                {
                                    "id": "727300242",
                                    "speaker": "派蒙",
                                    "text": "每，每天一碗？那我们确实可以考虑考虑…",
                                    "choices": [
                                        {
                                            "id": "727300243",
                                            "text": "一斗居然这么阔绰？",
                                            "response": [
                                                {
                                                    "id": "727300245",
                                                    "speaker": "阿晃",
                                                    "text": "哈哈哈，这可是老大用宝贵的胜利换来的！"
                                                },
                                                {
                                                    "id": "727300246",
                                                    "speaker": "阿晃",
                                                    "text": "之前有一位小友自称「真剑斗虫大鬼王」，老大听说后很不服气，就向他发起了挑战。如果那位小友输了，就要让出这个称号。"
                                                },
                                                {
                                                    "id": "727300247",
                                                    "speaker": "阿晃",
                                                    "text": "经过长达一天一夜的九十二次苦战，老大终于险胜一场！",
                                                    "choices": [
                                                        {
                                                            "id": "727300248",
                                                            "text": "怎么听起来…",
                                                            "response": [
                                                                {
                                                                    "id": "727300250",
                                                                    "speaker": "阿守",
                                                                    "text": "不过，那位小友想用他家拉面摊「每天免费吃一碗招牌拉面」的优惠券，让老大网开一面，两个月后就把这个称号还给他。"
                                                                },
                                                                {
                                                                    "id": "727300251",
                                                                    "speaker": "阿守",
                                                                    "text": "虽然不知道他家的拉面有多少斤两，但光冲这个分量，就是很诱人的提议。"
                                                                },
                                                                {
                                                                    "id": "727300252",
                                                                    "speaker": "阿守",
                                                                    "text": "而且，凭老大斗虫技艺的进步速度，两个月后肯定会有更威风的绰号，这笔生意确实很划算！"
                                                                },
                                                                {
                                                                    "id": "727300253",
                                                                    "speaker": "阿守",
                                                                    "text": "只不过，我们都忘了问那位小友，他家的拉面摊在哪…"
                                                                },
                                                                {
                                                                    "id": "727300254",
                                                                    "speaker": "荒泷一斗",
                                                                    "text": "咳咳咳！都打住，都打住！过程不重要！总之，这些拉面都送给我的挚友和飞行矮堇瓜了！"
                                                                },
                                                                {
                                                                    "id": "727300255",
                                                                    "speaker": "派蒙",
                                                                    "text": "等等，我们还没想好呢！"
                                                                },
                                                                {
                                                                    "id": "727300256",
                                                                    "speaker": "荒泷一斗",
                                                                    "text": "我已经向「玉将」发出战书了，他也答应，会带着几个外援，应对我们荒泷派的攻势。"
                                                                },
                                                                {
                                                                    "id": "727300257",
                                                                    "speaker": "荒泷一斗",
                                                                    "text": "至于场地，我好像知道要去哪了。首先要拜托我的挚友，把天领奉行那边的复杂手续统统搞定！"
                                                                },
                                                                {
                                                                    "id": "727300258",
                                                                    "speaker": "荒泷一斗",
                                                                    "text": "事不宜迟，我的挚友，还有飞行矮堇瓜，现在就出发吧！"
                                                                },
                                                                {
                                                                    "id": "727300259",
                                                                    "speaker": "派蒙",
                                                                    "text": "话都说到这份上了，好像也推脱不了了…看一斗这么激动，我们就跟过去看看吧。"
                                                                },
                                                                {
                                                                    "id": "727300260",
                                                                    "speaker": "派蒙",
                                                                    "text": "反正学学斗虫，帮他打败对手就行了吧？听起来也不复杂！",
                                                                    "choices": [
                                                                        {
                                                                            "id": "727300261",
                                                                            "text": "我也想吃招牌拉面到撑。",
                                                                            "response": [
                                                                                {
                                                                                    "id": "727300263",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "唔…难道放牛的有什么「孩子气光环」吗？你也被影响了啦！"
                                                                                },
                                                                                {
                                                                                    "id": "727300264",
                                                                                    "speaker": "Black Screen",
                                                                                    "text": "前往天领奉行，帮助荒泷派办理了举办「荒泷极意堂堂斗虫大试合」的手续，随后来到了一斗所说的场地…"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "727300262",
                                                                            "text": "我也想试试斗虫的乐趣。"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "727300249",
                                                            "text": "像是对方受不了了…"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "727300244",
                                            "text": "难道打工挣了大钱？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "727300227",
                            "text": "「极意堂堂斗虫试合」？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7273003",
            "objective": "前往「斗虫大试合」的场地",
            "dialogues": []
        },
        {
            "id": "7273004",
            "objective": "与荒泷一斗对话",
            "dialogues": [
                {
                    "id": "727300401",
                    "speaker": "荒泷一斗",
                    "text": "不错，阿守和阿晃准备的原材料都就位了，我们开始布置场地吧！"
                },
                {
                    "id": "727300402",
                    "speaker": "Black Screen",
                    "text": "根据以前的经验，试着搭建了「荒泷极意堂堂斗虫大试合」的擂台…"
                },
                {
                    "id": "727300403",
                    "speaker": "荒泷一斗",
                    "text": "哈哈哈哈哈哈哈！这擂台很有气势嘛，不错不错！"
                },
                {
                    "id": "727300404",
                    "speaker": "荒泷一斗",
                    "text": "我的挚友，没想到你在这方面也有才能！"
                },
                {
                    "id": "727300405",
                    "speaker": "荒泷一斗",
                    "text": "配合本大爷这精妙的宣传画，气氛不能更到位了，啊哈哈哈哈哈哈哈！"
                },
                {
                    "id": "727300406",
                    "speaker": "阿晃",
                    "text": "#{NICKNAME}好木工！老大好画功！"
                },
                {
                    "id": "727300407",
                    "speaker": "派蒙",
                    "text": "可是，这里好像离稻妻城太远了，真的会有人过来看吗？"
                },
                {
                    "id": "727300408",
                    "speaker": "荒泷一斗",
                    "text": "没问题没问题！以本大爷的名气，还怕没人来看吗？"
                },
                {
                    "id": "727300409",
                    "speaker": "荒泷一斗",
                    "text": "听说容彩祭的时候，这里就举办了一场剑术比试，当然也是鬼兜虫对决的不二之选！"
                },
                {
                    "id": "727300410",
                    "speaker": "荒泷一斗",
                    "text": "接下来，是时候给你们看看我天下无敌的鬼兜虫「赤红一杵」了。"
                },
                {
                    "id": "727300411",
                    "speaker": "派蒙",
                    "text": "居然还真是红色的鬼兜虫，好威风！",
                    "choices": [
                        {
                            "id": "727300412",
                            "text": "就像被火元素影响了一样…",
                            "response": [
                                {
                                    "id": "727300414",
                                    "speaker": "派蒙",
                                    "text": "放牛的，没想到你还挺用功的，从哪找来了这么一只鬼兜虫啊？"
                                },
                                {
                                    "id": "727300415",
                                    "speaker": "派蒙",
                                    "text": "能让我凑近看看吗？"
                                },
                                {
                                    "id": "727300416",
                                    "speaker": "荒泷一斗",
                                    "text": "哈！随便看随便看，仔细观瞻一番吧！不过，我可不会随随便便就把培养「赤红一杵」的秘密告诉你们！"
                                },
                                {
                                    "id": "727300417",
                                    "speaker": "派蒙",
                                    "text": "嗯？怎么有股熟悉的香味，好像是落落莓的果酱？"
                                },
                                {
                                    "id": "727300418",
                                    "speaker": "荒泷一斗",
                                    "text": "这！一定是你的错觉，你太饿了！"
                                },
                                {
                                    "id": "727300419",
                                    "speaker": "阿守",
                                    "text": "说起来，老大，你还没给「震慑涂装」加上保护涂层吧？要是下雨的话，我们花了九千摩拉才买到的那瓶舶来果酱，就都白费了…"
                                },
                                {
                                    "id": "727300420",
                                    "speaker": "荒泷一斗",
                                    "text": "没问题！反正「荒泷极意堂堂斗虫大试合」还没开始，还有时间给「赤红一杵」涂上最后的保护层。"
                                },
                                {
                                    "id": "727300421",
                                    "speaker": "荒泷一斗",
                                    "text": "你们先去准备传单，拉拢足够的观众。本大爷就在这里稍微指点一下挚友和飞行矮堇瓜，带他们上手。"
                                },
                                {
                                    "id": "727300422",
                                    "speaker": "荒泷一斗",
                                    "text": "然后，我们就先一起吃个饭，庆祝一下吧。哎呀，做了这么多事，真是辛苦本大爷了，哈…"
                                },
                                {
                                    "id": "727300423",
                                    "speaker": "「花角玉将」",
                                    "text": "哦？没想到你们的阵仗还挺大？"
                                },
                                {
                                    "id": "727300424",
                                    "speaker": "阿晃",
                                    "text": "出现了！「花角玉将」！"
                                },
                                {
                                    "id": "727300425",
                                    "speaker": "荒泷一斗",
                                    "text": "不应该啊！你是怎么知道这个地方的？"
                                },
                                {
                                    "id": "727300426",
                                    "speaker": "「花角玉将」",
                                    "text": "「真剑斗虫大鬼王」，你该不会忘了吧？斗虫的强者能够互相感应，上次不也是这样吗？"
                                },
                                {
                                    "id": "727300427",
                                    "speaker": "「花角玉将」",
                                    "text": "难道说，你还不知道该怎么面对我们，正在慌张地做准备？"
                                },
                                {
                                    "id": "727300428",
                                    "speaker": "荒泷一斗",
                                    "text": "什，什么话！要知道…没有和鬼兜虫心意合一时，本大爷会隐藏强者的气息，尽量保持低调！"
                                },
                                {
                                    "id": "727300429",
                                    "speaker": "荒泷一斗",
                                    "text": "我只是小看了你的洞察力！"
                                },
                                {
                                    "id": "727300430",
                                    "speaker": "派蒙",
                                    "text": "哦？他就是打败过一斗的人吗？看起来的确只是个普通的小孩呢…"
                                },
                                {
                                    "id": "727300431",
                                    "speaker": "派蒙",
                                    "text": "但他说话的风格很特别，感觉…和放牛的天生就要对着干！",
                                    "choices": [
                                        {
                                            "id": "727300432",
                                            "text": "其实他们很合拍吧…",
                                            "response": [
                                                {
                                                    "id": "727300434",
                                                    "speaker": "荒泷一斗",
                                                    "text": "「花角玉将」！能找到这里来，算你有点本事，值得我「真剑斗虫大鬼王」再认真一点！"
                                                },
                                                {
                                                    "id": "727300435",
                                                    "speaker": "荒泷一斗",
                                                    "text": "你们很快就会后悔了，因为你们这一次的行动太莽撞，就像是提前把脑袋伸过来挨揍。"
                                                },
                                                {
                                                    "id": "727300436",
                                                    "speaker": "「花角玉将」",
                                                    "text": "嗯，这次的态度更自信了，看来你也拿出了最强的底牌。"
                                                },
                                                {
                                                    "id": "727300437",
                                                    "speaker": "「花角玉将」",
                                                    "text": "最开始就让你一败涂地的话，一定会错过很多乐子。就由我的部下先陪你们玩玩吧。"
                                                },
                                                {
                                                    "id": "727300438",
                                                    "speaker": "荒泷一斗",
                                                    "text": "哼！想用小弟来试探我们吗？"
                                                },
                                                {
                                                    "id": "727300439",
                                                    "speaker": "荒泷一斗",
                                                    "text": "那我们这边就派出飞行矮…"
                                                },
                                                {
                                                    "id": "727300440",
                                                    "speaker": "荒泷一斗",
                                                    "text": "咳咳，不行，飞行矮堇瓜代表我荒泷派出战，气势绝不能输给那小鬼，那称号也得威风一点…"
                                                },
                                                {
                                                    "id": "727300441",
                                                    "speaker": "荒泷一斗",
                                                    "text": "我明白了，就让「破空白铁小堇瓜」给你们一点教训！"
                                                },
                                                {
                                                    "id": "727300442",
                                                    "speaker": "派蒙",
                                                    "text": "噫！为什么是我？",
                                                    "choices": [
                                                        {
                                                            "id": "727300443",
                                                            "text": "速度提升型的派蒙？",
                                                            "response": [
                                                                {
                                                                    "id": "727300445",
                                                                    "speaker": "阿晃",
                                                                    "text": "老大！现在就要和他们对决吗？"
                                                                },
                                                                {
                                                                    "id": "727300446",
                                                                    "speaker": "阿守",
                                                                    "text": "我们还没来得及宣传这场比试呢，你的挚友和挚友的瓜也还没经历过斗虫的实战。"
                                                                },
                                                                {
                                                                    "id": "727300447",
                                                                    "speaker": "荒泷一斗",
                                                                    "text": "对哦！但那小鬼都打上门来了，本大爷不可能当缩头乌龟！宣传的事之后再说！"
                                                                },
                                                                {
                                                                    "id": "727300448",
                                                                    "speaker": "荒泷一斗",
                                                                    "text": "至于斗虫的技巧，我会在旁边指导飞行矮堇瓜的…不对，是「破空白铁小堇瓜」！实战也是一种学习，输掉也没关系！"
                                                                },
                                                                {
                                                                    "id": "727300449",
                                                                    "speaker": "派蒙",
                                                                    "text": "好过分…还没开打就假设我会输…"
                                                                },
                                                                {
                                                                    "id": "727300450",
                                                                    "speaker": "荒泷一斗",
                                                                    "text": "白铁小堇瓜！你要拿出荒泷派的气势来！"
                                                                },
                                                                {
                                                                    "id": "727300451",
                                                                    "speaker": "荒泷一斗",
                                                                    "text": "让你第一个出战，可是我深思熟虑的策略！这个策略的灵感，可是我从阿忍那里听说过的璃月故事！"
                                                                },
                                                                {
                                                                    "id": "727300452",
                                                                    "speaker": "荒泷一斗",
                                                                    "text": "「用我方最弱去迎战对方的最强，我方中等迎战对方最弱，我方最强迎战敌方中等，这样一来，就能保证三局两胜！」"
                                                                },
                                                                {
                                                                    "id": "727300453",
                                                                    "speaker": "荒泷一斗",
                                                                    "text": "虽然你的确很有天分，但没多少实战的经验，在我们这一群斗虫强者中间，只能算是呆瓜。"
                                                                },
                                                                {
                                                                    "id": "727300454",
                                                                    "speaker": "荒泷一斗",
                                                                    "text": "派一个斗虫呆瓜上阵，就能让对方的一位好手失去用武之地，我们这边真是赚大了！哈哈哈哈哈哈哈！"
                                                                },
                                                                {
                                                                    "id": "727300455",
                                                                    "speaker": "派蒙",
                                                                    "text": "可是，按这个说法，你要亲自去和他们的头儿「花角玉将」一较高下，你不才是我们这边最弱的那个吗？"
                                                                },
                                                                {
                                                                    "id": "727300456",
                                                                    "speaker": "荒泷一斗",
                                                                    "text": "等等，是这样吗？"
                                                                },
                                                                {
                                                                    "id": "727300457",
                                                                    "speaker": "荒泷一斗",
                                                                    "text": "你…你好烦啊！我没说过我的策略和故事里完全一样吧！"
                                                                },
                                                                {
                                                                    "id": "727300458",
                                                                    "speaker": "派蒙",
                                                                    "text": "行啦行啦，我上就我上，我可不想被小瞧！"
                                                                },
                                                                {
                                                                    "id": "727300459",
                                                                    "speaker": "派蒙",
                                                                    "text": "看好了哦，我派蒙可绝不是斗虫呆瓜！"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "727300444",
                                                            "text": "防御强化型的派蒙？"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "727300433",
                                            "text": "先让他们寒暄一番…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "727300413",
                            "text": "确实有一股独特的威慑力…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7273008",
            "objective": "(test)刷出场地$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7273005",
            "objective": "与「电气鞘翅」对话",
            "dialogues": [
                {
                    "id": "727300501",
                    "speaker": "「电气鞘翅」",
                    "text": "真是平平无奇的对手，出战的鬼兜虫也花里胡哨…"
                },
                {
                    "id": "727300502",
                    "speaker": "「电气鞘翅」",
                    "text": "肤浅！外观根本是无所谓的东西，鬼兜虫最重要的「性能」，是对雷之力的共鸣。"
                },
                {
                    "id": "727300503",
                    "speaker": "「电气鞘翅」",
                    "text": "所以说，挑选鬼兜虫的眼光，就决定了斗虫生涯的一切！"
                },
                {
                    "id": "727300504",
                    "speaker": "派蒙",
                    "text": "什么奇怪的理论…就连我都明白，最重要的应该是实战的表现吧？应该把主要的精力花费在训练斗虫的技巧上吧！"
                },
                {
                    "id": "727300505",
                    "speaker": "荒泷一斗",
                    "text": "就是啊！小堇瓜说得对！"
                },
                {
                    "id": "727300506",
                    "speaker": "荒泷一斗",
                    "text": "你斗都不会斗，还谈什么性能！"
                },
                {
                    "id": "727300507",
                    "speaker": "荒泷一斗",
                    "text": "听好了，白铁小堇瓜！你要观察对方鬼兜虫的动作，及时让我方鬼兜虫避开攻击，挑准对方出招后的破绽，发起猛攻！"
                },
                {
                    "id": "727300508",
                    "speaker": "荒泷一斗",
                    "text": "只要进入攻击范围，「赤红一杵」就会给对方狠狠一击！"
                },
                {
                    "id": "727300509",
                    "speaker": "派蒙",
                    "text": "也就是说，对方准备攻击时，我就让鬼兜虫后退，对方露出破绽时，我就让鬼兜虫前进，打他个措手不及！"
                },
                {
                    "id": "727300510",
                    "speaker": "派蒙",
                    "text": "#听起来很简单嘛，我试试看！{NICKNAME}听了一遍，应该也学会了！"
                },
                {
                    "id": "727300511",
                    "speaker": "「电气鞘翅」",
                    "text": "居然临阵学习斗虫的技巧？可别把人看扁了啊！"
                },
                {
                    "id": "727300512",
                    "speaker": "「电气鞘翅」",
                    "text": "那就别废话了，拿出你们的鬼兜虫，让我看看你们的斤两吧！"
                }
            ]
        },
        {
            "id": "7273006",
            "objective": "击败「电气鞘翅」",
            "dialogues": [
                {
                    "id": "727300601",
                    "speaker": "派蒙",
                    "text": "嘿嘿，轻轻松松！是我「破空白铁小堇瓜」派蒙赢啦！"
                },
                {
                    "id": "727300602",
                    "speaker": "阿守&阿晃",
                    "text": "小堇瓜威武！！！"
                },
                {
                    "id": "727300603",
                    "speaker": "荒泷一斗",
                    "text": "哦哟！哦哟哟！你还挺有天分嘛，白铁小堇瓜！狠狠地给了他们一个下马威！"
                },
                {
                    "id": "727300604",
                    "speaker": "荒泷一斗",
                    "text": "待会儿奖励你一碗鸟蛋烧！",
                    "choices": [
                        {
                            "id": "727300605",
                            "text": "派蒙，强！",
                            "response": [
                                {
                                    "id": "727300607",
                                    "speaker": "「电气鞘翅」",
                                    "text": "「花角玉将」，我居然败给了一个新手…我愧对你！"
                                },
                                {
                                    "id": "727300608",
                                    "speaker": "「花角玉将」",
                                    "text": "放宽心，放宽心。看来对方找来的援军不是等闲之辈，我们也要让其他部将备甲上阵了。"
                                },
                                {
                                    "id": "727300609",
                                    "speaker": "「花角玉将」",
                                    "text": "「真剑斗虫大鬼王」，没想到你在如此之短的时间内就找来了可靠的将士，稳住了阵脚。"
                                },
                                {
                                    "id": "727300610",
                                    "speaker": "「花角玉将」",
                                    "text": "从今往后，我每天都会派遣一名部将，来到你们的主场掠阵。"
                                },
                                {
                                    "id": "727300611",
                                    "speaker": "「花角玉将」",
                                    "text": "你可要撑到最后啊，不然，你们荒泷派的战书就会成为斗虫界的笑柄哦…"
                                },
                                {
                                    "id": "727300612",
                                    "speaker": "荒泷一斗",
                                    "text": "喂喂喂，走什么呀？难不成是怕了！"
                                },
                                {
                                    "id": "727300613",
                                    "speaker": "荒泷一斗",
                                    "text": "突然出现又突然开溜，嘴上还嚣张得很，真让人恼火…"
                                },
                                {
                                    "id": "727300614",
                                    "speaker": "派蒙",
                                    "text": "听他的意思，「花角玉将」还会派出好几个部下来挑战我们，那岂不是再过不久就要开始对决了？"
                                },
                                {
                                    "id": "727300615",
                                    "speaker": "荒泷一斗",
                                    "text": "没错，看来我们的时间不够了，来不及把「极意堂堂斗虫大试合」办成荒泷派最盛大的活动了…"
                                },
                                {
                                    "id": "727300616",
                                    "speaker": "荒泷一斗",
                                    "text": "还好，相比热闹的气氛，现在本大爷更看重之后的对决！"
                                },
                                {
                                    "id": "727300617",
                                    "speaker": "荒泷一斗",
                                    "text": "刚才飞行矮…呃咳！刚才「破空白铁小堇瓜」打败劲敌，一战成名，看得本大爷斗志昂扬！"
                                },
                                {
                                    "id": "727300618",
                                    "speaker": "荒泷一斗",
                                    "text": "让本大爷想起了我还是个斗虫新手时，第一次向花见坂的强者发起挑战的情景…",
                                    "choices": [
                                        {
                                            "id": "727300619",
                                            "text": "斗志倒是有了。",
                                            "response": [
                                                {
                                                    "id": "727300621",
                                                    "speaker": "派蒙",
                                                    "text": "难道说，放牛的也有刚刚学会斗虫，就打翻了某个老手的高光时刻？"
                                                },
                                                {
                                                    "id": "727300622",
                                                    "speaker": "阿晃",
                                                    "text": "当时老大一败涂地…"
                                                },
                                                {
                                                    "id": "727300623",
                                                    "speaker": "阿守",
                                                    "text": "就是因为当时被打败了，才会被白铁小堇瓜大人斗虫时的英姿打动吧。"
                                                },
                                                {
                                                    "id": "727300624",
                                                    "speaker": "荒泷一斗",
                                                    "text": "不重要，那些事都不重要了！"
                                                },
                                                {
                                                    "id": "727300625",
                                                    "speaker": "荒泷一斗",
                                                    "text": "#接下来，「真剑斗虫大鬼王」，「破空白铁小堇瓜」，还有…「鬼王的左膀右臂」{NICKNAME}！"
                                                },
                                                {
                                                    "id": "727300626",
                                                    "speaker": "荒泷一斗",
                                                    "text": "我们三人要团结一心，好好对付「花角玉将」和他的部众！"
                                                },
                                                {
                                                    "id": "727300627",
                                                    "speaker": "荒泷一斗",
                                                    "text": "迎战每个对手之前，我们都要商量对策。只要我们获胜的次数比对方更多，「花角玉将」就必须亲自迎战我！"
                                                },
                                                {
                                                    "id": "727300628",
                                                    "speaker": "派蒙",
                                                    "text": "总觉得进入正题的节奏有点快呢。"
                                                },
                                                {
                                                    "id": "727300629",
                                                    "speaker": "派蒙",
                                                    "text": "但刚才斗虫的感觉还不错，而且帮放牛的赢过对方后，还有两月份的拉面，不如就专心一点，好好配合放牛的吧！",
                                                    "choices": [
                                                        {
                                                            "id": "727300630",
                                                            "text": "我还没上场表演呢。",
                                                            "response": [
                                                                {
                                                                    "id": "727300632",
                                                                    "speaker": "荒泷一斗",
                                                                    "text": "哈哈哈哈哈哈哈哈！这才像话嘛！只要好好听本大爷指挥，拿出全力应战，绝对能把「花角玉将」打得落花流水！"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "727300631",
                                                            "text": "我也要威风一回哦。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "727300620",
                                            "text": "可也还不算成名吧？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "727300606",
                            "text": "对手，逊！"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7273007",
            "objective": "与「花角玉将」对话",
            "dialogues": []
        }
    ]
}