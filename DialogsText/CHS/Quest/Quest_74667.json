    "talks": [
        {
            "id": "7466701",
            "objective": "与凯瑟琳对话",
            "dialogues": [
                {
                    "id": "746670201",
                    "speaker": "凯瑟琳",
                    "text": "向着星辰与深渊！欢迎来到冒险家协会，请问有什么可以帮您的吗？"
                },
                {
                    "id": "746670202",
                    "speaker": "派蒙",
                    "text": "又，又是凯瑟琳。这一位应该也是「人偶」吧…",
                    "choices": [
                        {
                            "id": "746670203",
                            "text": "应该是吧…",
                            "response": [
                                {
                                    "id": "746670205",
                                    "speaker": "凯瑟琳",
                                    "text": "请问我有什么可以帮您的吗？您是想要接取委托，还是发放委托？"
                                },
                                {
                                    "id": "746670206",
                                    "speaker": "Player",
                                    "text": "我只是顺便来看一眼…"
                                },
                                {
                                    "id": "746670207",
                                    "speaker": "凯瑟琳",
                                    "text": "这样啊…如果您遇见了任何和协会有关的问题，都可以来问我。"
                                },
                                {
                                    "id": "746670208",
                                    "speaker": "凯瑟琳",
                                    "text": "我会竭诚为您提供最完善的服务，解答一切能够解答的问题。"
                                },
                                {
                                    "id": "746670209",
                                    "speaker": "凯瑟琳",
                                    "text": "那么，感谢您对协会做出的贡献，冒险家。祝您的冒险旅途一帆风顺！"
                                }
                            ]
                        },
                        {
                            "id": "746670204",
                            "text": "应该没有第二种可能…"
                        }
                    ]
                }
            ]
        }
    ]
