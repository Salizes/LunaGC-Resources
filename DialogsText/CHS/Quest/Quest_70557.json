    "talks": [
        {
            "id": "7055701",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "705570101",
                    "speaker": "赫得蔚格",
                    "text": "我还是有点遗憾！应该让代理团长的「剑压」更有威势一点，最好一剑直接劈开山峦，这才符合「狮牙骑士」的威名！"
                },
                {
                    "id": "705570102",
                    "speaker": "凯亚",
                    "text": "嗯，从士气的角度，我支持，从演出效果的角度，我觉得目前的艺术加工程度，已经完全达标了。"
                },
                {
                    "id": "705570103",
                    "speaker": "霍肯",
                    "text": "代理团长同意我们适当让她的形象来小游戏里客串的时候，应该没想到我们会办得这么夸张。"
                },
                {
                    "id": "705570104",
                    "speaker": "派蒙",
                    "text": "这是在聊什么呢？"
                },
                {
                    "id": "705570105",
                    "speaker": "凯亚",
                    "text": "哎呀，正好！荣誉骑士和派蒙，要不要来体验一下骑兵小队准备的「骑士话剧」？",
                    "choices": [
                        {
                            "id": "705570106",
                            "text": "为什么有骑士的前缀？",
                            "response": [
                                {
                                    "id": "705570108",
                                    "speaker": "赫得蔚格",
                                    "text": "本质上，它是一种结合了蒙德服化道与枫丹映影技术的「实景战斗体验游戏」…"
                                },
                                {
                                    "id": "705570109",
                                    "speaker": "赫得蔚格",
                                    "text": "进入我们搭建的影棚后，与强敌尽情战斗，体验各种故事中英雄般的豪情。"
                                },
                                {
                                    "id": "705570110",
                                    "speaker": "赫得蔚格",
                                    "text": "而骑士一词，指的是，在战斗中，一旦你的「信念」达到强烈的水准，就能唤来「狮牙骑士」的幻影…"
                                },
                                {
                                    "id": "705570111",
                                    "speaker": "赫得蔚格",
                                    "text": "进而用「蒲公英剑压」风卷落叶般成片击倒邪恶势力！"
                                },
                                {
                                    "id": "705570112",
                                    "speaker": "派蒙",
                                    "text": "哦？狮牙骑士，那不就是琴吗…"
                                },
                                {
                                    "id": "705570113",
                                    "speaker": "派蒙",
                                    "text": "听起来，这两位骑士好像特别敬重琴？"
                                },
                                {
                                    "id": "705570114",
                                    "speaker": "凯亚",
                                    "text": "哈哈，是啊。这个项目本来只有适度的切磋——归来的骑士需要好好放松，但如果只顾着休息，丢了实战的手感也不太好。"
                                },
                                {
                                    "id": "705570115",
                                    "speaker": "凯亚",
                                    "text": "后来，赫得蔚格提议引入「狮牙骑士之影」，丰富切磋的表现力。打得花哨点倒也不错，我就帮忙旁侧敲击了两句。"
                                },
                                {
                                    "id": "705570116",
                                    "speaker": "赫得蔚格",
                                    "text": "多谢凯亚队长…毕竟，远征队离开了好几年，我想让大家知道，代理团长这些年来也在不断变强…"
                                },
                                {
                                    "id": "705570117",
                                    "speaker": "赫得蔚格",
                                    "text": "文职工作上，代理团长已经达到了无可挑剔的境界，而战斗的技巧，也抵达了我们这些骑士一辈子都仰望的高峰…"
                                },
                                {
                                    "id": "705570118",
                                    "speaker": "派蒙",
                                    "text": "原来如此！赫得蔚格小姐真是有心了！"
                                },
                                {
                                    "id": "705570119",
                                    "speaker": "派蒙",
                                    "text": "听你这么一说，我马上就想试试看，蒲公英剑压会是什么样的呢…",
                                    "choices": [
                                        {
                                            "id": "705570120",
                                            "text": "我和派蒙就来试试这个话剧吧！",
                                            "response": [
                                                {
                                                    "id": "705570122",
                                                    "speaker": "霍肯",
                                                    "text": "有你们两位来当骑士话剧的观众，我可太放心了…这边请。"
                                                },
                                                {
                                                    "id": "705570123",
                                                    "speaker": "凯亚",
                                                    "text": "那，希望这场互动表演能让你们两位好好享受一番！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "705570121",
                                            "text": "我们就来见识狮牙骑士之影吧！"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "705570107",
                            "text": "和一般的话剧有什么不同？"
                        }
                    ]
                }
            ]
        }
    ]
}