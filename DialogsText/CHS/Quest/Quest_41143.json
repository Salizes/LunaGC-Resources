            "objective": "与莎拉对话",
            "dialogues": [
                {
                    "id": "411430101",
                    "speaker": "Player",
                    "text": "我这就送过去。"
                },
                {
                    "id": "411430102",
                    "speaker": "莎拉",
                    "text": "那就最好了，谢谢你。"
                },
                {
                    "id": "411430103",
                    "speaker": "莎拉",
                    "text": "送的时候千万要小心一些，<color=#00E1FFFF>别让它沾了奇怪的元素</color>。"
                },
                {
                    "id": "411430104",
                    "speaker": "莎拉",
                    "text": "还有<color=#00E1FFFF>千万绕着魔物走，别被它们把菜撞翻了</color>。"
                },
                {
                    "id": "411430105",
                    "speaker": "莎拉",
                    "text": "好了，快点把这道菜送过去吧，凉了就不好吃了。"
                }
            ]
        },
        {
            "id": "4114302",
            "objective": "将餐品送给急躁的瓦里特",
            "dialogues": [
                {
                    "id": "411430201",
                    "speaker": "急躁的瓦里特",
                    "text": "我订的餐怎么还没送来，真是磨磨蹭蹭的…"
                }
            ]
        },
        {
            "id": "4114303",
            "objective": "与急躁的瓦里特对话",
            "dialogues": [
                {
                    "id": "411430601",
                    "speaker": "Player",
                    "text": "这是您订的餐。"
                },
                {
                    "id": "411430602",
                    "speaker": "急躁的瓦里特",
                    "text": "终于送来了，多谢，多谢。"
                },
                {
                    "id": "411430603",
                    "speaker": "急躁的瓦里特",
                    "text": "我得快点吃完，还有一堆事要办…"
                }
            ]
        },
        {
            "id": "4114303",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "411430301",
                    "speaker": "Player",
                    "text": "听说有特别订单…"
                },
                {
                    "id": "411430302",
                    "speaker": "莎拉",
                    "text": "对啊，你来得正是时候，我刚把这份甜甜花酿鸡准备好。"
                },
                {
                    "id": "411430303",
                    "speaker": "莎拉",
                    "text": "瓦里特先生早些时候在我们这边订了这道菜，要我们过一会送到晨曦酒庄西面的一个地方…"
                },
                {
                    "id": "411430304",
                    "speaker": "莎拉",
                    "text": "如果你愿意帮忙的话，就快把这份订单送过去吧。"
                }
            ]
        },
