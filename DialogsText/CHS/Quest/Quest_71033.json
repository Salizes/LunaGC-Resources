    "talks": [
        {
            "id": "7103313",
            "objective": "(test)领取任务用任务$HIDDEN",
            "dialogues": [
                {
                    "id": "710331301",
                    "speaker": "派蒙",
                    "text": "他们俩好像比试得很起劲呢，不会影响到其他人吧…"
                }
            ]
        },
        {
            "id": "7103301",
            "objective": "与梵米尔对话",
            "dialogues": [
                {
                    "id": "710330101",
                    "speaker": "梵米尔",
                    "text": "旅行者，旅行者，这里！"
                },
                {
                    "id": "710330102",
                    "speaker": "Player",
                    "text": "你是上次和清昼定了约定的画家…"
                },
                {
                    "id": "710330103",
                    "speaker": "梵米尔",
                    "text": "就是我，我和那个诗人约定好，要各自创作一份艺术品概括海灯节。"
                },
                {
                    "id": "710330104",
                    "speaker": "梵米尔",
                    "text": "你上次还帮我去拿了材料呢，你应该还记得吧。",
                    "choices": [
                        {
                            "id": "710330105",
                            "text": "还记得…",
                            "response": [
                                {
                                    "id": "710330107",
                                    "speaker": "梵米尔",
                                    "text": "我的画…咳，这个嘛…我其实已经画了很多了，场景、人物，甚至是动物…"
                                },
                                {
                                    "id": "710330108",
                                    "speaker": "梵米尔",
                                    "text": "我自信这些画都精确表达了应该表达的内容，但是…这些画里没有一幅能称得上可以概括海灯节的…"
                                },
                                {
                                    "id": "710330109",
                                    "speaker": "梵米尔",
                                    "text": "唉，我这几天吃不下睡不着，画材也都要用完了，还是没有画出那幅画。"
                                },
                                {
                                    "id": "710330110",
                                    "speaker": "梵米尔",
                                    "text": "所以，我就想去找找那诗人，看看他的诗写得怎么样了…"
                                },
                                {
                                    "id": "710330111",
                                    "speaker": "梵米尔",
                                    "text": "旅行者，你知道那个诗人去哪了吗？"
                                },
                                {
                                    "id": "710330112",
                                    "speaker": "Player",
                                    "text": "他去轻策庄了。"
                                },
                                {
                                    "id": "710330113",
                                    "speaker": "梵米尔",
                                    "text": "轻策庄？他去那干嘛…难道，是他找到取材点了…"
                                },
                                {
                                    "id": "710330114",
                                    "speaker": "梵米尔",
                                    "text": "快，旅行者，我们快去轻策庄找他去！要是那个地方合适，说不定我也能找到点灵感…"
                                },
                                {
                                    "id": "710330115",
                                    "speaker": "梵米尔",
                                    "text": "咳！总之，我们快出发吧！"
                                }
                            ]
                        },
                        {
                            "id": "710330106",
                            "text": "那你的画…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7103302",
            "objective": "前往轻策庄",
            "dialogues": []
        },
        {
            "id": "7103303",
            "objective": "与梵米尔对话",
            "dialogues": [
                {
                    "id": "710330301",
                    "speaker": "梵米尔",
                    "text": "这就是轻策庄了吧…那个诗人呢？跑去哪取材了？"
                },
                {
                    "id": "710330302",
                    "speaker": "Player",
                    "text": "上次他正在和孩子们玩猜灯谜…"
                },
                {
                    "id": "710330303",
                    "speaker": "梵米尔",
                    "text": "猜、猜灯谜？这都什么…事情。"
                },
                {
                    "id": "710330304",
                    "speaker": "梵米尔",
                    "text": "他是不是因为找不到灵感，准备自己认输了？"
                },
                {
                    "id": "710330305",
                    "speaker": "梵米尔",
                    "text": "算了，不管他是在干什么，这海灯节眼看着没剩几天了，可不能再拖下去了。"
                },
                {
                    "id": "710330306",
                    "speaker": "梵米尔",
                    "text": "我们去找这里管事的问问吧，今天我非要和他分出个高下来。"
                }
            ]
        },
        {
            "id": "7103304",
            "objective": "与若心对话",
            "dialogues": [
                {
                    "id": "710330401",
                    "speaker": "若心",
                    "text": "哎呀，你好啊旅行者，多谢你，现在这轻策庄里总算有了些过节的氛围啦…"
                },
                {
                    "id": "710330402",
                    "speaker": "若心",
                    "text": "咦？你身边的这位看着面生，这位是…"
                },
                {
                    "id": "710330403",
                    "speaker": "Player",
                    "text": "这是位画家，来找清昼的。"
                },
                {
                    "id": "710330404",
                    "speaker": "若心",
                    "text": "来找清昼先生的？唔，那正好…"
                },
                {
                    "id": "710330405",
                    "speaker": "若心",
                    "text": "望雅小姐前几天离开的时候，清昼先生说还要在这里待一段时间。"
                },
                {
                    "id": "710330406",
                    "speaker": "若心",
                    "text": "他现在应该还在和孩子们玩猜灯谜呢，我想想，他带着孩子们去外面了…"
                },
                {
                    "id": "710330407",
                    "speaker": "若心",
                    "text": "要是想要找他的话，估计得去外面找找了。"
                },
                {
                    "id": "710330408",
                    "speaker": "梵米尔",
                    "text": "他还真的在玩灯谜…旅行者，那就麻烦你帮我跑一趟吧。"
                },
                {
                    "id": "710330409",
                    "speaker": "梵米尔",
                    "text": "你去告诉那个诗人我过来了，我在这里再准备准备。"
                },
                {
                    "id": "710330410",
                    "speaker": "梵米尔",
                    "text": "无论如何，今天一定要和他分出个胜负…"
                }
            ]
        },
        {
            "id": "7103305",
            "objective": "与清昼对话",
            "dialogues": [
                {
                    "id": "710330501",
                    "speaker": "清昼",
                    "text": "哈哈哈，你们也逐渐摸到窍门了，猜得越来越快了。",
                    "choices": [
                        {
                            "id": "710330502",
                            "text": "梵米尔来了。",
                            "response": [
                                {
                                    "id": "710330504",
                                    "speaker": "清昼",
                                    "text": "梵米尔…啊，那个画家，我算算日子，也确实该是履行约定的时候。"
                                },
                                {
                                    "id": "710330505",
                                    "speaker": "清昼",
                                    "text": "可惜了，我的诗最后还是没有写好，这群孩子们的灯谜也还没玩尽兴…"
                                },
                                {
                                    "id": "710330506",
                                    "speaker": "清昼",
                                    "text": "呵呵，也许真是我诗材有限吧…这样，你再陪我去找找灵感吧。"
                                },
                                {
                                    "id": "710330507",
                                    "speaker": "清昼",
                                    "text": "嗯…也不能说是找灵感，再陪我去散散步吧。"
                                },
                                {
                                    "id": "710330508",
                                    "speaker": "阿佐",
                                    "text": "清昼叔叔！不猜灯谜了吗？？我还想猜猜看…"
                                },
                                {
                                    "id": "710330509",
                                    "speaker": "小六",
                                    "text": "我也想猜灯谜，清昼叔叔…"
                                },
                                {
                                    "id": "710330510",
                                    "speaker": "阿佑",
                                    "text": "唔，我也想再猜几个…"
                                },
                                {
                                    "id": "710330511",
                                    "speaker": "清昼",
                                    "text": "#哈哈哈，莫急，等我和这位{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}去旁边转一圈，回来就有新灯谜了。"
                                },
                                {
                                    "id": "710330512",
                                    "speaker": "清昼",
                                    "text": "你们先回轻策庄里去吧，到时候我再找你们，这样可好？"
                                },
                                {
                                    "id": "710330513",
                                    "speaker": "阿佐",
                                    "text": "好哎！清昼叔叔真厉害，能想出这么多灯谜！"
                                },
                                {
                                    "id": "710330514",
                                    "speaker": "小六",
                                    "text": "清昼叔叔肯定读了好多好多书吧…"
                                },
                                {
                                    "id": "710330515",
                                    "speaker": "阿佑",
                                    "text": "我要是以后也能像清昼叔叔这么厉害就好了…"
                                },
                                {
                                    "id": "710330516",
                                    "speaker": "清昼",
                                    "text": "……"
                                },
                                {
                                    "id": "710330517",
                                    "speaker": "清昼",
                                    "text": "旅行者，我们快出发吧，快把那些琐事解决了，别让这群孩子们等急了。"
                                }
                            ]
                        },
                        {
                            "id": "710330503",
                            "text": "你还记得和梵米尔的约定吗？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7103306",
            "objective": "跟随清昼",
            "dialogues": [
                {
                    "id": "710330601",
                    "speaker": "清昼",
                    "text": "如此景致，倒是…呵呵，倒是很适合做一句灯谜。"
                }
            ]
        },
        {
            "id": "7103307",
            "objective": "跟随清昼",
            "dialogues": [
                {
                    "id": "710330701",
                    "speaker": "清昼",
                    "text": "不错，这里也够我写一句灯谜了。"
                }
            ]
        },
        {
            "id": "7103308",
            "objective": "跟随清昼",
            "dialogues": [
                {
                    "id": "710330801",
                    "speaker": "清昼",
                    "text": "唔…好，我想出来了，灯谜有了一句"
                }
            ]
        },
        {
            "id": "7103309",
            "objective": "与清昼对话",
            "dialogues": [
                {
                    "id": "710330901",
                    "speaker": "清昼",
                    "text": "好了，这样灯谜就写好了，我们去轻策庄里去吧。"
                },
                {
                    "id": "710330902",
                    "speaker": "清昼",
                    "text": "去了那边，我再把灯谜告诉你。"
                }
            ]
        },
        {
            "id": "7103310",
            "objective": "与孩子们对话",
            "dialogues": [
                {
                    "id": "710331001",
                    "speaker": "小六",
                    "text": "清昼叔叔回来啦！清昼叔叔，你已经写好新的灯谜了吗？"
                },
                {
                    "id": "710331002",
                    "speaker": "阿佐",
                    "text": "这次我大概…肯定能猜对！"
                },
                {
                    "id": "710331003",
                    "speaker": "阿佑",
                    "text": "我这次要好好想想…"
                },
                {
                    "id": "710331004",
                    "speaker": "清昼",
                    "text": "哈哈哈，我已经把这次的灯谜写好了。"
                },
                {
                    "id": "710331005",
                    "speaker": "清昼",
                    "text": "旅行者，请你帮我个忙吧，把这霄灯挂起来，挂高点。"
                }
            ]
        },
        {
            "id": "7103315",
            "objective": "把灯谜挂起来",
            "dialogues": [
                {
                    "id": "710331501",
                    "speaker": "灯谜",
                    "text": "「万千扁舟拂波去，烛映孤云峭岩间。身负流光浮沧海，终与龙宫彩鱼眠」"
                }
            ]
        },
        {
            "id": "7103314",
            "objective": "与清昼对话",
            "dialogues": [
                {
                    "id": "710331401",
                    "speaker": "清昼",
                    "text": "孩子们，看这霄灯，这是打一这海灯节里的「事物」，你们猜一猜吧。"
                },
                {
                    "id": "710331402",
                    "speaker": "清昼",
                    "text": "#我要和这位{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}去办件事，办完了再回来陪你们接着玩。"
                },
                {
                    "id": "710331403",
                    "speaker": "小六",
                    "text": "咦，清昼叔叔，你要去办什么事呀？"
                },
                {
                    "id": "710331404",
                    "speaker": "清昼",
                    "text": "我和一位画家定下了个…比试，要写一首最好的诗，和他画的画做比试，看看谁最好。"
                },
                {
                    "id": "710331405",
                    "speaker": "阿佐",
                    "text": "哎呀，那肯定是清昼叔叔赢啦，那么多灯谜，哪一首都是很好很好的！"
                },
                {
                    "id": "710331406",
                    "speaker": "清昼",
                    "text": "是吗，谢谢你们的夸奖。你们先拿着这盏霄灯回轻策庄去慢慢猜吧，野外可不太安全。"
                },
                {
                    "id": "710331407",
                    "speaker": "阿佐",
                    "text": "放心吧叔叔，这里我们可熟了，我们自己就能回去，你快去把那个画家打败吧！"
                },
                {
                    "id": "710331408",
                    "speaker": "阿佑",
                    "text": "那…叔叔，你和那个画家比试完了之后，要快点过来呀。"
                },
                {
                    "id": "710331409",
                    "speaker": "清昼",
                    "text": "那是当然，等事情结束了，我就去找你们。",
                    "choices": [
                        {
                            "id": "710331410",
                            "text": "这确实是一首好诗。",
                            "response": [
                                {
                                    "id": "710331411",
                                    "speaker": "Player",
                                    "text": "这首诗是可以胜的。"
                                },
                                {
                                    "id": "710331412",
                                    "speaker": "清昼",
                                    "text": "呵呵，什么诗，这只是一首灯谜而已。"
                                },
                                {
                                    "id": "710331413",
                                    "speaker": "清昼",
                                    "text": "好了，我们去找那个画家吧，他肯定等急了。"
                                }
                            ]
                        },
                        {
                            "id": "710331411",
                            "text": "这首诗是可以胜的。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7103311",
            "objective": "与梵米尔对话",
            "dialogues": [
                {
                    "id": "710331101",
                    "speaker": "梵米尔",
                    "text": "你总算是来了，你做好诗了吗？"
                },
                {
                    "id": "710331102",
                    "speaker": "清昼",
                    "text": "我没有写出一首合适的诗。"
                },
                {
                    "id": "710331103",
                    "speaker": "梵米尔",
                    "text": "你、你也…咳，你怎么没写出来？"
                },
                {
                    "id": "710331104",
                    "speaker": "清昼",
                    "text": "璃月大地，万家霄灯，我想来想去，都没能用一首诗概括，你画好了画吗？"
                },
                {
                    "id": "710331105",
                    "speaker": "梵米尔",
                    "text": "我…我也没有…璃月那么大！怎么画得下，我要是想画下来，就得用天来做画纸…"
                },
                {
                    "id": "710331106",
                    "speaker": "清昼",
                    "text": "如此说来，我们两个倒是都没有创作出能概括璃月港和海灯节的诗和画。"
                },
                {
                    "id": "710331107",
                    "speaker": "清昼",
                    "text": "那么，就该算是「平局」了。"
                },
                {
                    "id": "710331108",
                    "speaker": "梵米尔",
                    "text": "嗯…好吧，那就…"
                },
                {
                    "id": "710331109",
                    "speaker": "阿佐",
                    "text": "清昼叔叔！清昼叔叔！你给我们出的灯谜，我们猜出来啦！"
                },
                {
                    "id": "710331110",
                    "speaker": "梵米尔",
                    "text": "灯、灯谜？什么灯谜？"
                },
                {
                    "id": "710331111",
                    "speaker": "清昼",
                    "text": "不须在意，是我陪着这群孩子们玩，给他们出的灯谜。"
                },
                {
                    "id": "710331112",
                    "speaker": "梵米尔",
                    "text": "噢？是什么灯谜，能说给我听听吗？"
                },
                {
                    "id": "710331113",
                    "speaker": "清昼",
                    "text": "「万千扁舟拂波去，烛映孤云峭岩间。身负流光浮沧海，终与龙宫彩鱼眠。」"
                },
                {
                    "id": "710331114",
                    "speaker": "梵米尔",
                    "text": "这是你给这群孩子们写的灯谜？这…"
                },
                {
                    "id": "710331115",
                    "speaker": "阿佐",
                    "text": "清昼叔叔，这个叔叔又是谁啊？",
                    "choices": [
                        {
                            "id": "710331116",
                            "text": "他就是那位画家。",
                            "response": [
                                {
                                    "id": "710331118",
                                    "speaker": "梵米尔",
                                    "text": "你这诗人，要真不想与我比试，那和我约定个什么劲？"
                                },
                                {
                                    "id": "710331119",
                                    "speaker": "清昼",
                                    "text": "你误会了，我最开始确实抱着和你…一决胜负的心思，四处取材，殚精竭力…想要写出一首好诗。"
                                },
                                {
                                    "id": "710331120",
                                    "speaker": "清昼",
                                    "text": "但你应该也感到了吧，只凭只言片语，是无法概括璃月港和海灯节的。所以…"
                                },
                                {
                                    "id": "710331121",
                                    "speaker": "梵米尔",
                                    "text": "所以，你就跑到这里来陪孩子们玩？给他们出灯谜？"
                                },
                                {
                                    "id": "710331122",
                                    "speaker": "清昼",
                                    "text": "正是这样，所以我来这里陪孩子们，给他们出灯谜，想再找到写那首诗的灵感。"
                                },
                                {
                                    "id": "710331123",
                                    "speaker": "清昼",
                                    "text": "呵呵，但是灵感没找到，灯谜倒是出了不少，孩子们也很开心。"
                                },
                                {
                                    "id": "710331124",
                                    "speaker": "清昼",
                                    "text": "或许…这就是我在找的那首「诗」了。可惜，我没办法把它写下来，也无法和你分出胜负来。"
                                },
                                {
                                    "id": "710331125",
                                    "speaker": "梵米尔",
                                    "text": "你…你们璃月人，真是怪得很！那你我之间的比试，到底怎么算？谁输谁赢？我可不接受平局。"
                                },
                                {
                                    "id": "710331126",
                                    "speaker": "阿佐",
                                    "text": "这个叔叔怎么这么啰嗦…肯定是清昼叔叔赢啦。"
                                },
                                {
                                    "id": "710331127",
                                    "speaker": "阿佐",
                                    "text": "他可厉害了，出了好多好多灯谜，你肯定都猜不到谜底！"
                                },
                                {
                                    "id": "710331128",
                                    "speaker": "梵米尔",
                                    "text": "你这诗人…嗯？等等，我有个主意…"
                                },
                                {
                                    "id": "710331129",
                                    "speaker": "梵米尔",
                                    "text": "那，这样！你我之间，重新比过！"
                                },
                                {
                                    "id": "710331130",
                                    "speaker": "清昼",
                                    "text": "哦？那你想要怎么重新比过？"
                                },
                                {
                                    "id": "710331131",
                                    "speaker": "梵米尔",
                                    "text": "你不是给这群孩子们出灯谜吗？我在取材的时候，也看到了许多霄灯的纹样。"
                                },
                                {
                                    "id": "710331132",
                                    "speaker": "梵米尔",
                                    "text": "我们俩，一个出灯谜，一个画霄灯，让这群孩子们做评委，看他们更喜欢谁，你看怎么样？"
                                },
                                {
                                    "id": "710331133",
                                    "speaker": "清昼",
                                    "text": "好！正合我意，也合了这海灯节之意，如此再好不过了。"
                                },
                                {
                                    "id": "710331134",
                                    "speaker": "梵米尔",
                                    "text": "那就这样，等我收拾收拾画具，我们就在这里，重新比过！",
                                    "choices": [
                                        {
                                            "id": "710331135",
                                            "text": "你们俩可真来劲…",
                                            "response": [
                                                {
                                                    "id": "710331137",
                                                    "speaker": "梵米尔",
                                                    "text": "来，孩子们，把这个诗人写的灯谜给我看看，我给你们画个漂漂亮亮的霄灯！"
                                                },
                                                {
                                                    "id": "710331138",
                                                    "speaker": "清昼",
                                                    "text": "呵呵，只怕你画霄灯的速度，跟不上我出灯谜的速度。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "710331136",
                                            "text": "你们俩继续加油…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "710331117",
                            "text": "和清昼做比试的人。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7103312",
            "objective": "与若心对话",
            "dialogues": [
                {
                    "id": "710331201",
                    "speaker": "若心",
                    "text": "嗯？你们有什么事吗？"
                },
                {
                    "id": "710331202",
                    "speaker": "Player",
                    "text": "关于清昼和梵米尔的比试…"
                },
                {
                    "id": "710331203",
                    "speaker": "若心",
                    "text": "你说那两位啊，没事，没事，他们愿意陪孩子们玩就最好了。"
                },
                {
                    "id": "710331204",
                    "speaker": "若心",
                    "text": "这大过节的，还是要热热闹闹的才好。"
                },
                {
                    "id": "710331205",
                    "speaker": "若心",
                    "text": "倒是你，孩子，一直为我们这轻策庄东奔西跑的，辛苦你了。",
                    "choices": [
                        {
                            "id": "710331206",
                            "text": "没关系的。",
                            "response": [
                                {
                                    "id": "710331208",
                                    "speaker": "若心",
                                    "text": "你这孩子倒是热心…这些东西请你收下吧，谢谢你啦，你也要过个好节啊。"
                                },
                                {
                                    "id": "710331209",
                                    "speaker": "若心",
                                    "text": "希望之后的海灯节，这里也能这么热闹啊…"
                                }
                            ]
                        },
                        {
                            "id": "710331207",
                            "text": "您客气了。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7103350",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "710335001",
                    "speaker": "若心",
                    "text": "您找清昼先生，是有什么重要的事吗？"
                },
                {
                    "id": "710335002",
                    "speaker": "梵米尔",
                    "text": "嗯…也不算什么重要的事吧，只是一幅画和一首诗而已…"
                }
            ]
        },
        {
            "id": "7103351",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "710335101",
                    "speaker": "小六",
                    "text": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，你猜到谜底了吗？"
                }
            ]
        },
        {
            "id": "7103352",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "710335201",
                    "speaker": "阿佑",
                    "text": "清昼叔叔可真厉害啊，到底读了多少书才能这么厉害…"
                }
            ]
        },
        {
            "id": "7103353",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "710335301",
                    "speaker": "阿佐",
                    "text": "谜底到底是什么，不然，我们一起想想？"
                }
            ]
        }
    ]
}