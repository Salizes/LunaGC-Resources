        {
            "id": "7324901",
            "objective": "",
            "dialogues": [
                {
                    "id": "732490201",
                    "speaker": "Player",
                    "text": "好啊，我们玩什么？"
                },
                {
                    "id": "732490202",
                    "speaker": "兰陀尼什",
                    "text": "兰陀尼什准备，那菈来找，因为那菈聪明，肯定能猜到。但是光猜到还不够，还要很快。"
                },
                {
                    "id": "732490203",
                    "speaker": "兰陀尼什",
                    "text": "这次，兰陀尼什想要的东西…是<color=#00E1FFFF>石块，好多石块，叠起来</color>！金色的那菈，一定立刻找到吧。"
                }
            ]
        },
        {
            "id": "7324905",
            "objective": "",
            "dialogues": [
                {
                    "id": "732490501",
                    "speaker": "兰陀尼什",
                    "text": "哈哈，不对不对，兰陀尼什不想要这个。那菈要再想想。"
                },
                {
                    "id": "732490502",
                    "speaker": "兰陀尼什",
                    "text": "兰陀尼什一直在，那菈还想玩游戏的话，随时都可以哦。"
                }
            ]
        },
        {
            "id": "7324903",
            "objective": "",
            "dialogues": [
                {
                    "id": "732490401",
                    "speaker": "兰陀尼什",
                    "text": "金色的那菈，果然像传闻里提到的那样「眼疾手快」！"
                },
                {
                    "id": "732490402",
                    "speaker": "兰陀尼什",
                    "text": "陪兰陀尼什玩游戏，是好那菈，这个送给那菈朋友！"
                }
            ]
        },
        {
            "id": "7324901",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "732490101",
                    "speaker": "兰陀尼什",
                    "text": "兰陀尼什找到了！金色的那菈！来玩吗？"
                }
            ]
        },
        {
            "id": "7324903",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "732490301",
                    "speaker": "Player",
                    "text": "现在没空。"
                },
                {
                    "id": "732490302",
                    "speaker": "兰陀尼什",
                    "text": "那兰陀尼什等，等到那菈「有空」。"
                }
            ]
        }
    ]
