    "talks": [
        {
            "id": "7220201",
            "objective": "",
            "dialogues": [
                {
                    "id": "722020101",
                    "speaker": "知世",
                    "text": "雷鸟大人…抛弃了我吗…",
                    "choices": [
                        {
                            "id": "722020102",
                            "text": "你好？",
                            "response": [
                                {
                                    "id": "722020104",
                                    "speaker": "知世",
                                    "text": "雷鸟大人…请您不要动怒…"
                                },
                                {
                                    "id": "722020105",
                                    "speaker": "知世",
                                    "text": "我会尽我之力，阅读您的旨意，阅读您的教谕…但是…但是…"
                                },
                                {
                                    "id": "722020106",
                                    "speaker": "知世",
                                    "text": "但是…为什么您在拒绝我…为什么…呜呜…呜呜呜…"
                                },
                                {
                                    "id": "722020107",
                                    "speaker": "知世",
                                    "text": "为什么…我无法深入您的迷雾…",
                                    "choices": [
                                        {
                                            "id": "722020108",
                                            "text": "阅读…你在说什么呀？",
                                            "response": [
                                                {
                                                    "id": "722020109",
                                                    "speaker": "知世",
                                                    "text": "您留下的雷石…我会再想办法的…银璨璨的船来了，我的时间不多了…"
                                                },
                                                {
                                                    "id": "722020110",
                                                    "speaker": "Player",
                                                    "text": "雷石…那是什么？"
                                                },
                                                {
                                                    "id": "722020111",
                                                    "speaker": "知世",
                                                    "text": "逢岳之野的雷石…只有操使雷电的人才能够让它们活起来…只有在迷雾中寻觅通路的人，才能找到它们…"
                                                },
                                                {
                                                    "id": "722020112",
                                                    "speaker": "知世",
                                                    "text": "如雷鸟伫立…如雷鸟展翼…"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "722020113",
                                            "text": "迷雾…不是已经消散了吗？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "722020103",
                            "text": "需要帮忙吗？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7220202",
            "objective": "",
            "dialogues": [
                {
                    "id": "722020201",
                    "speaker": "知世",
                    "text": "啊…雷鸟大人…您原谅我了吗…？"
                }
            ]
        },
        {
            "id": "7220203",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "722020301",
                    "speaker": "知世",
                    "text": "我的时间不多了…"
                }
            ]
        }
    ]
