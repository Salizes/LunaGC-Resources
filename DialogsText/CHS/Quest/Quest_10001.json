            "objective": "Additional",
            "dialogues": [
                {
                    "id": "10001001",
                    "speaker": "(test)玉京台 潜入AI1",
                    "text": "有恶徒暗害帝君！请配合我们的调查！"
                },
                {
                    "id": "10001002",
                    "speaker": "(test)玉京台 潜入AI2",
                    "text": "竟有人谋害岩王帝君！不可置信！"
                },
                {
                    "id": "10001003",
                    "speaker": "(test)玉京台 潜入AI3",
                    "text": "这里究竟发生了什么？！"
                },
                {
                    "id": "10001004",
                    "speaker": "(test)玉京台 潜入AI4",
                    "text": "光天化日之下！究竟用了什么妖术！"
                },
                {
                    "id": "10001021",
                    "speaker": "民众",
                    "text": "我…我什么都不知道啊…"
                },
                {
                    "id": "10001022",
                    "speaker": "民众",
                    "text": "烟霞太浓了，什么都看不清…"
                },
                {
                    "id": "10001023",
                    "speaker": "民众",
                    "text": "不是我干的！大人请明察！"
                },
                {
                    "id": "10001024",
                    "speaker": "民众",
                    "text": "岩王帝君…岩王帝君…怎么会…"
                },
                {
                    "id": "10001051",
                    "speaker": "派蒙",
                    "text": "我们现在的位置，有点太招摇了呢…"
                }
            ]
        },
        {
            "id": "100012",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "10001201",
                    "speaker": "(test)玉京台 潜入AI1",
                    "text": "哪里逃！"
                },
                {
                    "id": "10001202",
                    "speaker": "「公子」",
                    "text": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOY|INFO_FEMALE_PRONOUN_GIRLC]}，小心别动哦。"
                },
                {
                    "id": "10001203",
                    "speaker": "Player",
                    "text": "嗯？"
                },
                {
                    "id": "10001204",
                    "speaker": "「公子」",
                    "text": "跟我来。"
                },
                {
                    "id": "10001205",
                    "speaker": "(test)玉京台 潜入AI1",
                    "text": "#{M#他}{F#她}们在这里！"
                },
                {
                    "id": "10001206",
                    "speaker": "(test)玉京台 潜入AI1",
                    "text": "#抓住{M#他}{F#她}们！"
                },
                {
                    "id": "10001207",
                    "speaker": "(test)玉京台 潜入AI1",
                    "text": "跟上！跟上！"
                }
            ]
        },
        {
            "id": "100015",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "10001521",
                    "speaker": "派蒙",
                    "text": "#呜…{NICKNAME}，外面也有很多士兵啊。"
                },
                {
                    "id": "10001522",
                    "speaker": "派蒙",
                    "text": "刚才你说得没错…你身份特殊，虽然不是刺客，但也不能在这里被抓到！"
                },
                {
                    "id": "10001523",
                    "speaker": "派蒙",
                    "text": "但…我们真的能安全离开吗…"
                }
            ]
