            "dialogues": [
                {
                    "id": "732579701",
                    "speaker": "米希尔",
                    "text": "我也好，斯露莎也好，每一个花灵都有必须要履行的职责。"
                },
                {
                    "id": "732579702",
                    "speaker": "米希尔",
                    "text": "不过你们就不一样了，是出于本心才来帮助我们的，所以谢谢你们。"
                }
            ]
        },
        {
            "id": "7325798",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "732579801",
                    "speaker": "拉沙鲁",
                    "text": "好累…好想…回去睡觉。呼……"
                }
            ]
        },
        {
            "id": "7325799",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "732579902",
                    "speaker": "斯露莎",
                    "text": "毕竟「灵光绝唱」的本质就是对过去的追忆嘛。"
                },
                {
                    "id": "732579904",
                    "speaker": "斯露莎",
                    "text": "「无罪的幼苗」应该已经长出来了。"
                },
                {
                    "id": "732579910",
                    "speaker": "Black Screen",
                    "text": "距离太远，斯露莎无法继续完成净化…"
                }
            ]
        }
