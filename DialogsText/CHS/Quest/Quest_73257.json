    "talks": [
        {
            "id": "7325715",
            "objective": "前往甘露花海",
            "dialogues": [
                {
                    "id": "732571501",
                    "speaker": "那先朱那",
                    "text": "那么「双角的花冠」的事情就拜托你们了，我也要去处理剩余的工作了。"
                },
                {
                    "id": "732571502",
                    "speaker": "那先朱那",
                    "text": "相信不管是什么人，都将会慑服于你们和尊使大人的威光之下的。"
                },
                {
                    "id": "732571503",
                    "speaker": "那先朱那",
                    "text": "等所有事情都完成之后，我们就在铁穆山的营地会合吧！"
                }
            ]
        },
        {
            "id": "7325701",
            "objective": "(test)回到花海自动进对话$HIDDEN",
            "dialogues": [
                {
                    "id": "732570101",
                    "speaker": "派蒙",
                    "text": "说来，从遗迹工场出来之后，斯露莎好像一直都没说过话的样子。"
                },
                {
                    "id": "732570102",
                    "speaker": "派蒙",
                    "text": "明明之前一路上都没停下来过，现在这么安静，都有点不习惯了。",
                    "choices": [
                        {
                            "id": "732570103",
                            "text": "该不会是吓傻了吧。",
                            "response": [
                                {
                                    "id": "732570106",
                                    "speaker": "派蒙",
                                    "text": "打起精神来呀，斯露莎，我们还有很多事情要做呢！"
                                },
                                {
                                    "id": "732570107",
                                    "speaker": "派蒙",
                                    "text": "比如完成那个…就是那个什么很难记的仪式，然后赶紧解决掉那个大窟窿。"
                                },
                                {
                                    "id": "732570108",
                                    "speaker": "派蒙",
                                    "text": "等所有事情都完成之后，我们去吃好吃的吧，毕竟大家都辛苦了一番呢。"
                                },
                                {
                                    "id": "732570109",
                                    "speaker": "派蒙",
                                    "text": "比如说…唔，不过我也不知道花灵会喜欢吃什么…"
                                },
                                {
                                    "id": "732570110",
                                    "speaker": "斯露莎",
                                    "text": "……"
                                },
                                {
                                    "id": "732570111",
                                    "speaker": "斯露莎",
                                    "text": "…花灵是不用吃东西的啦，笨飘飘。"
                                },
                                {
                                    "id": "732570112",
                                    "speaker": "斯露莎",
                                    "text": "哎，没想到我竟然有一天会沦落到被白飘飘安慰，这也实在太丢人了吧。"
                                },
                                {
                                    "id": "732570113",
                                    "speaker": "斯露莎",
                                    "text": "简直恨不得现在就被封印到「灰余晶」里面，要不然就找个可以一睡不醒的山洞躲起来，直到认识我的家伙都消失好了。"
                                },
                                {
                                    "id": "732570114",
                                    "speaker": "派蒙",
                                    "text": "说了不许叫我白飘飘，不过真的有这种山洞吗？",
                                    "choices": [
                                        {
                                            "id": "732570115",
                                            "text": "逃避不是解决问题的办法。",
                                            "response": [
                                                {
                                                    "id": "732570116",
                                                    "speaker": "斯露莎",
                                                    "text": "我已经什么都不想管啦！"
                                                },
                                                {
                                                    "id": "732570119",
                                                    "speaker": "斯露莎",
                                                    "text": "一想到被那先朱那那个家伙耍得团团转的滑稽模样，我就羞耻到受不了。"
                                                },
                                                {
                                                    "id": "732570120",
                                                    "speaker": "斯露莎",
                                                    "text": "反正「灵光绝唱」都已经到手了，你们要想解决那个什么天象的话，就去花海那边找米希尔或者拉沙鲁好了。"
                                                },
                                                {
                                                    "id": "732570121",
                                                    "speaker": "斯露莎",
                                                    "text": "总之不管怎么样还是拜托你们放过我吧，你们之前听到的那些话就当我从来没说过好了。"
                                                },
                                                {
                                                    "id": "732570122",
                                                    "speaker": "派蒙",
                                                    "text": "唔，虽然你是说过很多奇怪的话啦…",
                                                    "choices": [
                                                        {
                                                            "id": "732570123",
                                                            "text": "「我的谒颂主」？",
                                                            "response": [
                                                                {
                                                                    "id": "732570126",
                                                                    "speaker": "斯露莎",
                                                                    "text": "呜啊，求求你不要再说了。"
                                                                },
                                                                {
                                                                    "id": "732570127",
                                                                    "speaker": "派蒙",
                                                                    "text": "#{NICKNAME}，这个时候就别逗斯露莎了啦。毕竟我们一起冒险了这么久，要是半途而废了可不行。"
                                                                },
                                                                {
                                                                    "id": "732570128",
                                                                    "speaker": "派蒙",
                                                                    "text": "而且，斯露莎也有很厉害的地方吧，比如…唔…"
                                                                },
                                                                {
                                                                    "id": "732570129",
                                                                    "speaker": "斯露莎",
                                                                    "text": "你刚才犹豫了对吧！呜呜呜…别再哄我了…",
                                                                    "choices": [
                                                                        {
                                                                            "id": "732570130",
                                                                            "text": "比如行动力很强。",
                                                                            "response": [
                                                                                {
                                                                                    "id": "732570132",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "嗯嗯，没错，而且我们不是一直都在为了解决那个天象而努力吗？"
                                                                                },
                                                                                {
                                                                                    "id": "732570133",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "能走到这里也都是多亏了斯露莎呢！"
                                                                                },
                                                                                {
                                                                                    "id": "732570134",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "那句话怎么说的来着？啊对，「只要不停下脚步继续前进，成为一名卓越的冒险家也只是时间问题。」"
                                                                                },
                                                                                {
                                                                                    "id": "732570135",
                                                                                    "speaker": "斯露莎",
                                                                                    "text": "真的吗？你们是在真心诚意地夸我的对吧。"
                                                                                },
                                                                                {
                                                                                    "id": "732570136",
                                                                                    "speaker": "Player",
                                                                                    "text": "这是朋友的夸赞。"
                                                                                },
                                                                                {
                                                                                    "id": "732570137",
                                                                                    "speaker": "斯露莎",
                                                                                    "text": "嘿嘿，哎呀，该说果然不愧是我嘛！"
                                                                                },
                                                                                {
                                                                                    "id": "732570138",
                                                                                    "speaker": "斯露莎",
                                                                                    "text": "突然就有动力起来了。"
                                                                                },
                                                                                {
                                                                                    "id": "732570139",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "既然斯露莎也有干劲了，那么我们就赶紧去找祖尔宛吧，快点解决掉那个大窟窿拿到报酬，我都迫不及待要大吃一顿了！"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "732570131",
                                                                            "text": "比如很有责任感。"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "732570124",
                                                            "text": "「英武的身姿」？"
                                                        },
                                                        {
                                                            "id": "732570125",
                                                            "text": "「命定的牺牲」？"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "732570117",
                                            "text": "你还有必须要做的事吧。",
                                            "response": [
                                                {
                                                    "id": "732570118",
                                                    "speaker": "斯露莎",
                                                    "text": "虽然好像是有这么回事啦，不过…"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "732570104",
                            "text": "毕竟经历了这种事…"
                        },
                        {
                            "id": "732570105",
                            "text": "也许她只是累了。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7325702",
            "objective": "与祖尔宛对话",
            "dialogues": [
                {
                    "id": "732570201",
                    "speaker": "派蒙",
                    "text": "祖尔宛，我们回来啦！"
                },
                {
                    "id": "732570202",
                    "speaker": "祖尔宛",
                    "text": "#啊呀，是{NICKNAME}、斯露莎还有派蒙。"
                },
                {
                    "id": "732570203",
                    "speaker": "祖尔宛",
                    "text": "看你们的样子，应该是已经成功拿到所有的「灵光绝唱」了呢。",
                    "choices": [
                        {
                            "id": "732570204",
                            "text": "虽然经过了一些曲折。",
                            "response": [
                                {
                                    "id": "732570206",
                                    "speaker": "祖尔宛",
                                    "text": "不管怎么样，最终的结果是好的，拜托你们果然没错。"
                                },
                                {
                                    "id": "732570207",
                                    "speaker": "祖尔宛",
                                    "text": "若不是有你们在，恐怕「灵光绝唱」早就被那些心怀叵测的家伙夺走了。"
                                },
                                {
                                    "id": "732570208",
                                    "speaker": "派蒙",
                                    "text": "欸，祖尔宛的话，怎么听起来像是早就知道些什么的样子啊？"
                                },
                                {
                                    "id": "732570209",
                                    "speaker": "祖尔宛",
                                    "text": "欸嘿，还真的被我说中了啊，你们该不会真的遇到了那些侍奉黑渊的家伙吧？",
                                    "choices": [
                                        {
                                            "id": "732570210",
                                            "text": "你怎么知道的？",
                                            "response": [
                                                {
                                                    "id": "732570211",
                                                    "speaker": "祖尔宛",
                                                    "text": "这个嘛…与其深究于此，不如先跟我说说到底发生了什么吧。"
                                                },
                                                {
                                                    "id": "732570214",
                                                    "speaker": "Black Screen",
                                                    "text": "同祖尔宛讲述了在地下遗迹中的冒险，以及那先朱那背叛的事情。"
                                                },
                                                {
                                                    "id": "732570215",
                                                    "speaker": "祖尔宛",
                                                    "text": "呵呵，没想到竟然连矫论团的「识主」都投向了黑渊，虽说原本就没对他们抱有什么期待，但这样听来也有些骇人了。"
                                                },
                                                {
                                                    "id": "732570216",
                                                    "speaker": "祖尔宛",
                                                    "text": "而且如果我猜的没错的话，他之所以会盯上「灵光绝唱」，也是受与你们战斗的黑渊之人的蛊惑，毕竟此人也算是我的旧相识。"
                                                },
                                                {
                                                    "id": "732570217",
                                                    "speaker": "派蒙",
                                                    "text": "欸？祖尔宛竟然还认识深渊教团的家伙吗？"
                                                },
                                                {
                                                    "id": "732570218",
                                                    "speaker": "祖尔宛",
                                                    "text": "哼，那家伙原本也曾是矫论团的一员。数百年前，曾有自森林而来的调查团为了探寻荼诃人的秘密而造访此地。"
                                                },
                                                {
                                                    "id": "732570219",
                                                    "speaker": "祖尔宛",
                                                    "text": "他们不顾矫论团的劝阻，执意要进入荼诃人留下的遗迹。为了防止意外发生，当时的识主便命他一同前去。"
                                                },
                                                {
                                                    "id": "732570220",
                                                    "speaker": "祖尔宛",
                                                    "text": "然而不知是在遗迹中遭遇了什么，当我们再次见到他时，他已经接受了污秽的「赐福」，而调查团的人也不知所踪。"
                                                },
                                                {
                                                    "id": "732570221",
                                                    "speaker": "祖尔宛",
                                                    "text": "黑渊的信徒随之聚集而来，他们盯上了「灵光绝唱」，为此还唤来了众多的迪弗魔兽进攻花海。"
                                                },
                                                {
                                                    "id": "732570222",
                                                    "speaker": "祖尔宛",
                                                    "text": "虽然依靠众多的花灵与人类勇士，花海最终得以保全。但我们却没能彻底消灭那些黑渊的信徒。"
                                                },
                                                {
                                                    "id": "732570223",
                                                    "speaker": "祖尔宛",
                                                    "text": "为了不让他们趁虚而入，我用「灵光绝唱」的力量封禁了花海与各处遗迹。"
                                                },
                                                {
                                                    "id": "732570224",
                                                    "speaker": "祖尔宛",
                                                    "text": "而矫论团也因为这次背叛而元气大伤，传承的典籍焚失一空。在那之后便慢慢变成了现在这幅样子。"
                                                },
                                                {
                                                    "id": "732570225",
                                                    "speaker": "祖尔宛",
                                                    "text": "之前听你们说，我便怀疑背后有他们的影子，但没想到这次就连矫论团的首领也成了被他们利用的工具。"
                                                },
                                                {
                                                    "id": "732570226",
                                                    "speaker": "派蒙",
                                                    "text": "不过那先朱那说的话还是有些令人在意，关于矫论团先辈的事情，祖尔宛应该知道些什么吧？"
                                                },
                                                {
                                                    "id": "732570227",
                                                    "speaker": "Player",
                                                    "text": "毕竟祖尔宛曾同他们并肩作战。"
                                                },
                                                {
                                                    "id": "732570228",
                                                    "speaker": "祖尔宛",
                                                    "text": "呵呵，历史化为传说，传说变为故事，所谓传承究其本质也不过是这样，遗忘原本也是故事的一部分。"
                                                },
                                                {
                                                    "id": "732570229",
                                                    "speaker": "祖尔宛",
                                                    "text": "越是执着于传承的人，便越会去选择记住那些自己想要的故事，最终迷失在故事的迷宫当中。"
                                                },
                                                {
                                                    "id": "732570230",
                                                    "speaker": "祖尔宛",
                                                    "text": "在这不断遗忘的世界中，比起轻飘飘的颂歌，我们在大地上所镌刻下的痕迹，才是更加可靠的事物。"
                                                },
                                                {
                                                    "id": "732570231",
                                                    "speaker": "祖尔宛",
                                                    "text": "因此我才会相信你们，毕竟你们看起来就像是不会在意什么评价的直率之人啊！"
                                                },
                                                {
                                                    "id": "732570232",
                                                    "speaker": "派蒙",
                                                    "text": "虽然好像是在夸我们，不过不知道为什么听上去感觉怪怪的。"
                                                },
                                                {
                                                    "id": "732570233",
                                                    "speaker": "Player",
                                                    "text": "感觉阴阳怪气的。"
                                                },
                                                {
                                                    "id": "732570234",
                                                    "speaker": "斯露莎",
                                                    "text": "前辈根本就是在暗示我吧…"
                                                },
                                                {
                                                    "id": "732570235",
                                                    "speaker": "祖尔宛",
                                                    "text": "至于五百年前的事情，你们与其再从我这里听到另一个故事，还不如亲身去见证吧。"
                                                },
                                                {
                                                    "id": "732570236",
                                                    "speaker": "祖尔宛",
                                                    "text": "恰好如今也正有这样的机会。"
                                                },
                                                {
                                                    "id": "732570237",
                                                    "speaker": "祖尔宛",
                                                    "text": "说来斯露莎你看上去也可靠了不少嘛，经历了这些也差不多该从那些人类的呓语中清醒过来了吧。"
                                                },
                                                {
                                                    "id": "732570238",
                                                    "speaker": "斯露莎",
                                                    "text": "前辈！过去的事情就别再提了！"
                                                },
                                                {
                                                    "id": "732570239",
                                                    "speaker": "祖尔宛",
                                                    "text": "#看来拜托{NICKNAME}和派蒙果然有用。这样的话，我也能放心地把完成「祭水之仪」的工作交给你们了。"
                                                },
                                                {
                                                    "id": "732570240",
                                                    "speaker": "Player",
                                                    "text": "「祭水之仪」…"
                                                },
                                                {
                                                    "id": "732570241",
                                                    "speaker": "派蒙",
                                                    "text": "好像之前也听祖尔宛说过吧！我记得是清除什么污秽之类的来着？"
                                                },
                                                {
                                                    "id": "732570242",
                                                    "speaker": "祖尔宛",
                                                    "text": "「祭水之仪」是为「万种母树」祓除污秽的仪式，一般情况下只要在镇压黑渊的巨木下举行就可以了。"
                                                },
                                                {
                                                    "id": "732570243",
                                                    "speaker": "祖尔宛",
                                                    "text": "但现在黑渊的封印松动，天空中的异象也再次出现，已经不是光靠普通的仪式就能解决的了。"
                                                },
                                                {
                                                    "id": "732570244",
                                                    "speaker": "祖尔宛",
                                                    "text": "本来这个异象之所以会出现在母树之上，便是由于母树吸收了大量污秽的原因。"
                                                },
                                                {
                                                    "id": "732570245",
                                                    "speaker": "祖尔宛",
                                                    "text": "「万种母树」中积累了太多的污秽，又受到异象的侵蚀，已经无法维持灵光的力量。"
                                                },
                                                {
                                                    "id": "732570246",
                                                    "speaker": "祖尔宛",
                                                    "text": "现在唯一的办法就是进入到「万种母树」当中，清除掉其中的污秽，唤醒神明大人的神识了。"
                                                },
                                                {
                                                    "id": "732570247",
                                                    "speaker": "派蒙",
                                                    "text": "原来可以进到树的里面吗？"
                                                },
                                                {
                                                    "id": "732570248",
                                                    "speaker": "祖尔宛",
                                                    "text": "不然难道你们该不会以为「离渡之仪」是要进到那个黑渊里面吗？就算是花灵也没办法承受那样的污秽。"
                                                },
                                                {
                                                    "id": "732570249",
                                                    "speaker": "祖尔宛",
                                                    "text": "寄宿着神识的巨莲「伽乌迦那」就在万种母树当中，只要祓除了污秽，便会重新开出圣洁之花。"
                                                },
                                                {
                                                    "id": "732570250",
                                                    "speaker": "祖尔宛",
                                                    "text": "然后甘露便会洁净整个大地。虽然有些复杂，不过既然是你们的话，应该能够轻松解决吧。"
                                                },
                                                {
                                                    "id": "732570251",
                                                    "speaker": "祖尔宛",
                                                    "text": "那么，我已让拉沙鲁和米希尔提前去到「荼泥黑渊」那边了，只要把「灵光绝唱」带过去，便能聚集起灵光的力量。"
                                                },
                                                {
                                                    "id": "732570252",
                                                    "speaker": "祖尔宛",
                                                    "text": "灵光将会唤醒镇压黑渊的巨木，洁净渊底的污泥。然后就可以举行「离渡之仪」，打开进入「万种母树」的道路了。"
                                                },
                                                {
                                                    "id": "732570253",
                                                    "speaker": "祖尔宛",
                                                    "text": "至于古时那些英雄们的伟业，只要进到母树当中，花冠便会向斯露莎显现。"
                                                },
                                                {
                                                    "id": "732570254",
                                                    "speaker": "祖尔宛",
                                                    "text": "毕竟所有与灵光相关的记忆，最后都回归了「万种母树」。无论世间流传的民话如何变迁，这些记忆也不会随之褪色。"
                                                },
                                                {
                                                    "id": "732570255",
                                                    "speaker": "斯露莎",
                                                    "text": "这种事情我还是第一次听说！"
                                                },
                                                {
                                                    "id": "732570256",
                                                    "speaker": "祖尔宛",
                                                    "text": "呵呵，花冠原本便是母树的一部分，等到时候你就知道了。"
                                                },
                                                {
                                                    "id": "732570257",
                                                    "speaker": "祖尔宛",
                                                    "text": "那么，请去熄灭那个「焚真之天象」吧。等到天空降下甘露之时，我们还会见面的。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "732570212",
                                            "text": "还真是…",
                                            "response": [
                                                {
                                                    "id": "732570213",
                                                    "speaker": "祖尔宛",
                                                    "text": "既然这样，不如先跟我说说到底发生了什么吧。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "732570205",
                            "text": "累死我了。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7325703",
            "objective": "前往荼泥黑渊",
            "dialogues": []
        },
        {
            "id": "7325704",
            "objective": "与米希尔和拉沙鲁对话",
            "dialogues": [
                {
                    "id": "732570401",
                    "speaker": "拉沙鲁",
                    "text": "好慢啊…斯露莎。"
                },
                {
                    "id": "732570402",
                    "speaker": "米希尔",
                    "text": "我们都在这里等好久了。"
                },
                {
                    "id": "732570403",
                    "speaker": "拉沙鲁",
                    "text": "好累…好想…回去睡觉。呼……"
                },
                {
                    "id": "732570404",
                    "speaker": "斯露莎",
                    "text": "什么啦，明明你们什么都没做，一直是我在干活吧！"
                },
                {
                    "id": "732570405",
                    "speaker": "米希尔",
                    "text": "不能这么说，等待也是件重要的工作呢，不如说比起短暂的行动，等待才是永恒的事业。"
                },
                {
                    "id": "732570406",
                    "speaker": "派蒙",
                    "text": "这是什么歪理啊…"
                },
                {
                    "id": "732570407",
                    "speaker": "米希尔",
                    "text": "应该说是我们花灵的哲学吧。"
                },
                {
                    "id": "732570408",
                    "speaker": "米希尔",
                    "text": "不过比起空谈哲学…现在要紧的是「灵光绝唱」，你们当然已经集齐了吧？"
                },
                {
                    "id": "732570409",
                    "speaker": "派蒙",
                    "text": "那当然咯！"
                },
                {
                    "id": "732570410",
                    "speaker": "米希尔",
                    "text": "既然这样就由我们来解开这里的封印，然后便可以用「灵光绝唱」聚集起灵光的力量了。"
                },
                {
                    "id": "732570411",
                    "speaker": "米希尔",
                    "text": "不过请小心，毕竟淤积了这么多年的污秽，不知道会有什么东西被释放出来呢。"
                }
            ]
        },
        {
            "id": "7325705",
            "objective": "放置「灵光绝唱」",
            "dialogues": []
        },
        {
            "id": "7325706",
            "objective": "(test)树壳恢复cs$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7325730",
            "objective": "与米希尔对话",
            "dialogues": [
                {
                    "id": "732573001",
                    "speaker": "派蒙",
                    "text": "放置好大灵光之后，这附近看上去也恢复生机了呢！"
                },
                {
                    "id": "732573002",
                    "speaker": "米希尔",
                    "text": "这些树木本来就是由灵光的力量培育用于抵御灾厄的侵蚀的，只不过在漫长的时间里慢慢耗尽了力量。"
                },
                {
                    "id": "732573003",
                    "speaker": "米希尔",
                    "text": "现在有了「灵光绝唱」的滋养，它便能够恢复往日的光辉了。"
                },
                {
                    "id": "732573004",
                    "speaker": "米希尔",
                    "text": "不过封印既然解除，那么属于过去的污秽应该也一并被释放出来了。"
                },
                {
                    "id": "732573005",
                    "speaker": "米希尔",
                    "text": "若是我和拉沙鲁在这里耗尽力量可就没办法进行仪式了，接下来的几处就拜托你们了。"
                },
                {
                    "id": "732573006",
                    "speaker": "斯露莎",
                    "text": "哼哼，就交给我吧，毕竟对抗污秽可是勇者的工作呢！"
                }
            ]
        },
        {
            "id": "7325718",
            "objective": "放置剩下的「灵光绝唱」",
            "dialogues": []
        },
        {
            "id": "7325719",
            "objective": "放置剩下的「灵光绝唱」",
            "dialogues": []
        },
        {
            "id": "7325720",
            "objective": "放置剩下的「灵光绝唱」",
            "dialogues": []
        },
        {
            "id": "7325721",
            "objective": "放置剩下的「灵光绝唱」",
            "dialogues": []
        },
        {
            "id": "7325722",
            "objective": "(test)防回滚$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7325717",
            "objective": "与米希尔对话",
            "dialogues": [
                {
                    "id": "732571701",
                    "speaker": "派蒙",
                    "text": "嗯，这样我们就算是完成了。"
                },
                {
                    "id": "732571702",
                    "speaker": "派蒙",
                    "text": "看上去有花朵从树上生长出来了，不过接下来该怎么办呢？"
                },
                {
                    "id": "732571703",
                    "speaker": "米希尔",
                    "text": "哎呀，你们别看我，我也不知道。"
                },
                {
                    "id": "732571704",
                    "speaker": "米希尔",
                    "text": "说来斯露莎不是已经戴上了「双角的花冠」吗？只要依靠花冠，便可以连接母树的记忆与智慧。"
                },
                {
                    "id": "732571705",
                    "speaker": "米希尔",
                    "text": "斯露莎快点用那个想想吧。"
                },
                {
                    "id": "732571706",
                    "speaker": "斯露莎",
                    "text": "虽然是这样说，我还没有习惯这个花冠呢！"
                },
                {
                    "id": "732571707",
                    "speaker": "斯露莎",
                    "text": "唔，我好像看到了，虽然新生的枝芽已经长出，但污秽还没被完全清除。"
                },
                {
                    "id": "732571708",
                    "speaker": "斯露莎",
                    "text": "我们还必须得净化这些花朵才行。"
                },
                {
                    "id": "732571709",
                    "speaker": "斯露莎",
                    "text": "然后纯净的灵光之力才能再次生长出来。"
                }
            ]
        },
