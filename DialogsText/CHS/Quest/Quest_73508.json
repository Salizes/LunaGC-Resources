    "talks": [
        {
            "id": "7350802",
            "objective": "等到第二天上午（次日8~12点）",
            "dialogues": []
        },
        {
            "id": "7350801",
            "objective": "与海妮耶和贝尔福对话",
            "dialogues": [
                {
                    "id": "735080101",
                    "speaker": "贝尔福",
                    "text": "#这些天来多谢你们了，「黄金流星」{NICKNAME}和「白银伴星」！"
                },
                {
                    "id": "735080102",
                    "speaker": "贝尔福",
                    "text": "我记录下了你们每次游玩「灵蕈棋阵」的过程，根据你们的游玩记录，可以得出许多数据。"
                },
                {
                    "id": "735080103",
                    "speaker": "贝尔福",
                    "text": "你们属于「顶尖水准」的试玩者，将你们的记录和普通试玩者的相结合，就能分析出稳妥的改进方案。"
                },
                {
                    "id": "735080104",
                    "speaker": "海妮耶",
                    "text": "当然，最后还要请你们发表关于总体风格的建议。"
                },
                {
                    "id": "735080105",
                    "speaker": "海妮耶",
                    "text": "你们的反馈不止对「灵蕈棋阵」这个游戏有正面意义，还在一定程度上影响着下一届大赛的玩法。"
                },
                {
                    "id": "735080106",
                    "speaker": "贝尔福",
                    "text": "还请你们大概说说自己的倾向。比如…是更重视趣味性，还是竞技性呢？",
                    "choices": [
                        {
                            "id": "735080107",
                            "text": "我更看重与伙伴们的合作。",
                            "response": [
                                {
                                    "id": "735080108",
                                    "speaker": "派蒙",
                                    "text": "对哦！比赛和对抗确实很重要，不过，我们希望之后的挑战更能考验我们和蕈兽伙伴的默契！"
                                },
                                {
                                    "id": "735080109",
                                    "speaker": "海妮耶",
                                    "text": "和蕈兽伙伴们的默契吗…我明白了。"
                                },
                                {
                                    "id": "735080110",
                                    "speaker": "海妮耶",
                                    "text": "贝尔福先生，记得我之前和你说过的，最重要的理念吧？"
                                },
                                {
                                    "id": "735080111",
                                    "speaker": "贝尔福",
                                    "text": "理解！下次大赛，我会争取设计一些考验你们配合的挑战，让你们和蕈兽伙伴在高效的沟通中发挥全力！"
                                },
                                {
                                    "id": "735080121",
                                    "speaker": "海妮耶",
                                    "text": "你们两位还真是一点都没变呢…"
                                },
                                {
                                    "id": "735080122",
                                    "speaker": "海妮耶",
                                    "text": "总之，这样一来，本次「灵蕈棋阵」的测试就大功告成了。",
                                    "choices": [
                                        {
                                            "id": "735080123",
                                            "text": "有劳你们了！",
                                            "response": [
                                                {
                                                    "id": "735080124",
                                                    "speaker": "派蒙",
                                                    "text": "好耶！完成工作后，我们就能拿到一笔辛苦费，买些好吃的犒劳自己啦！"
                                                },
                                                {
                                                    "id": "735080127",
                                                    "speaker": "派蒙",
                                                    "text": "等等…不对不对！我们是下次大赛的主办方，而海妮耶和贝尔福在为下次大赛做准备…"
                                                },
                                                {
                                                    "id": "735080128",
                                                    "speaker": "派蒙",
                                                    "text": "海妮耶是我们的好帮手，理论上来说，贝尔福也算是我们的员工了…"
                                                },
                                                {
                                                    "id": "735080129",
                                                    "speaker": "派蒙",
                                                    "text": "那是不是应该…唔…由我们给好帮手辛苦费，给员工发工资？"
                                                },
                                                {
                                                    "id": "735080130",
                                                    "speaker": "海妮耶",
                                                    "text": "不不不！你们未免也太好心了！这都是我自愿开展的工作，我也有非常多的收获！"
                                                },
                                                {
                                                    "id": "735080131",
                                                    "speaker": "海妮耶",
                                                    "text": "我毕竟也算是个商业人士，这次开发并运营「灵蕈棋阵」的经验和履历，对于我们这类人弥足珍贵。"
                                                },
                                                {
                                                    "id": "735080132",
                                                    "speaker": "海妮耶",
                                                    "text": "要是这份工作对外开放，不知道会有多少人拿着一大笔钱来求你们授权呢！"
                                                },
                                                {
                                                    "id": "735080133",
                                                    "speaker": "海妮耶",
                                                    "text": "而且，「灵蕈棋阵」盈利后，贝尔福先生投入的钱也有着落了，他还会将大部分收入交给我。"
                                                },
                                                {
                                                    "id": "735080134",
                                                    "speaker": "海妮耶",
                                                    "text": "我会将一部分收入储存起来，作为下次大赛的预备资金，一部分用来好好照顾蕈兽伙伴们。"
                                                },
                                                {
                                                    "id": "735080135",
                                                    "speaker": "海妮耶",
                                                    "text": "不止是「咚咚小圆帽」它们，还有诸如「信风舞姬」那样的，选手们托我照顾的伙伴。"
                                                },
                                                {
                                                    "id": "735080136",
                                                    "speaker": "海妮耶",
                                                    "text": "也就是说，你们帮助我们改进了「灵蕈棋阵」，可以带来大量的收益，还为蕈兽伙伴们提供了保障。"
                                                },
                                                {
                                                    "id": "735080137",
                                                    "speaker": "派蒙",
                                                    "text": "原来是这样吗…虽然听不太懂什么盈利，收入之类的，但感觉好像，所有人都有很大的收获？"
                                                },
                                                {
                                                    "id": "735080138",
                                                    "speaker": "派蒙",
                                                    "text": "那我也更有成就感了！"
                                                },
                                                {
                                                    "id": "735080139",
                                                    "speaker": "派蒙",
                                                    "text": "#{NICKNAME}，有机会的话，我们也和须弥的朋友们说说「灵蕈棋阵」的事，让更多人知道这个游戏吧！"
                                                },
                                                {
                                                    "id": "735080140",
                                                    "speaker": "Player",
                                                    "text": "当然当然！"
                                                },
                                                {
                                                    "id": "735080141",
                                                    "speaker": "海妮耶",
                                                    "text": "接下来，我就要和蕈兽伙伴们先行一步，去城外会合助手，回营地去了。"
                                                },
                                                {
                                                    "id": "735080142",
                                                    "speaker": "海妮耶",
                                                    "text": "如果离开营地太久，留守的蕈兽伙伴们会担心的。"
                                                },
                                                {
                                                    "id": "735080143",
                                                    "speaker": "海妮耶",
                                                    "text": "贝尔福先生还会在这里继续宣传测试版的「灵蕈棋阵」，如果你们还没尽兴，可以继续玩玩。"
                                                },
                                                {
                                                    "id": "735080144",
                                                    "speaker": "贝尔福",
                                                    "text": "对，玩个痛快吧！"
                                                },
                                                {
                                                    "id": "735080145",
                                                    "speaker": "派蒙",
                                                    "text": "呜，海妮耶要走了吗？要带着「咚咚小圆帽」它们离开了？"
                                                },
                                                {
                                                    "id": "735080146",
                                                    "speaker": "派蒙",
                                                    "text": "我还想和「咚咚小圆帽」再玩一会儿呢…"
                                                },
                                                {
                                                    "id": "735080147",
                                                    "speaker": "派蒙",
                                                    "text": "不过…这次见到海妮耶后，我越来越安心了。"
                                                },
                                                {
                                                    "id": "735080148",
                                                    "speaker": "派蒙",
                                                    "text": "特别是确认了蕈兽伙伴们都健健康康，和我们的默契一点也没有减少！"
                                                },
                                                {
                                                    "id": "735080149",
                                                    "speaker": "海妮耶",
                                                    "text": "放心，也许不过多久，我们就会再见面的。"
                                                },
                                                {
                                                    "id": "735080150",
                                                    "speaker": "海妮耶",
                                                    "text": "虽说你们经常四处旅行，但我也有办法和你们联络。比如通过冒险家协会把信件转达给你们。"
                                                },
                                                {
                                                    "id": "735080151",
                                                    "speaker": "海妮耶",
                                                    "text": "我保证，之后与你们再见时，我和蕈兽伙伴们都健健康康，精力充沛！"
                                                },
                                                {
                                                    "id": "735080152",
                                                    "speaker": "海妮耶",
                                                    "text": "请静候佳音吧。"
                                                },
                                                {
                                                    "id": "735080153",
                                                    "speaker": "派蒙",
                                                    "text": "嗯！我们相信你，海妮耶！",
                                                    "choices": [
                                                        {
                                                            "id": "735080154",
                                                            "text": "加油啊，海妮耶。",
                                                            "response": [
                                                                {
                                                                    "id": "735080157",
                                                                    "speaker": "海妮耶",
                                                                    "text": "#那就下次再见了，「黄金流星」{NICKNAME}和「白银伴星」派蒙！"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "735080155",
                                                            "text": "照顾好蕈兽伙伴们。"
                                                        },
                                                        {
                                                            "id": "735080156",
                                                            "text": "也别忘了照顾好自己。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "735080125",
                                            "text": "记得报酬哦。",
                                            "response": [
                                                {
                                                    "id": "735080126",
                                                    "speaker": "派蒙",
                                                    "text": "对对对，用工作挣到的摩拉买到的吃的，好像都更香一点！"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "735080112",
                            "text": "我更倾向于战斗的华丽和爽快。",
                            "response": [
                                {
                                    "id": "735080113",
                                    "speaker": "派蒙",
                                    "text": "嗯！这次和蕈兽伙伴们见面后，我更加确定了，我们和蕈兽伙伴们之间的默契，只会变强，不会被时间冲淡！"
                                },
                                {
                                    "id": "735080114",
                                    "speaker": "派蒙",
                                    "text": "下次再和蕈兽伙伴们一起参赛时，我们的配合不知道会有多厉害，肯定要用华丽的战斗体现出来！"
                                },
                                {
                                    "id": "735080115",
                                    "speaker": "海妮耶",
                                    "text": "原来如此，你们觉得适当的挑战，可以展现出蕈兽伙伴的全部实力。"
                                },
                                {
                                    "id": "735080116",
                                    "speaker": "贝尔福",
                                    "text": "那下次比赛，就要适当增加一些挑战性的内容了！"
                                }
                            ]
                        },
                        {
                            "id": "735080117",
                            "text": "我没什么所谓，开心就好！",
                            "response": [
                                {
                                    "id": "735080118",
                                    "speaker": "派蒙",
                                    "text": "嗯！不管怎么样，只要能和蕈兽伙伴们一起玩，一起通过考验，战胜困难，我们就很开心啦！"
                                },
                                {
                                    "id": "735080119",
                                    "speaker": "海妮耶",
                                    "text": "明白了，乐趣和挑战并存，这句话说着简单，不过做起来很难…"
                                },
                                {
                                    "id": "735080120",
                                    "speaker": "贝尔福",
                                    "text": "都交给我了，我会尽全力拿出让你们满意的方案的！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7350899",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "735089901",
                    "speaker": "派蒙",
                    "text": "嗯，时间刚刚好，我们也好好体验了「灵蕈棋阵」。"
                },
                {
                    "id": "735089902",
                    "speaker": "派蒙",
                    "text": "差不多该去找海妮耶和贝尔福，给他们一些反馈了吧！"
                }
            ]
        }
    ]
}