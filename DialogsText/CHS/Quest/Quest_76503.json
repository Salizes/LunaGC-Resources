    "talks": [
        {
            "id": "7650301",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "765030101",
                    "speaker": "菲林斯",
                    "text": "#哦？是{NICKNAME}和派蒙两位。没想到会在如此偏僻的地方与你们重逢。"
                },
                {
                    "id": "765030102",
                    "speaker": "菲林斯",
                    "text": "你们是追寻着某种线索而来，还是意外地迷路至此？",
                    "choices": [
                        {
                            "id": "765030103",
                            "text": "我们正在四处参观。",
                            "response": [
                                {
                                    "id": "765030105",
                                    "speaker": "菲林斯",
                                    "text": "原来如此。从这艘废船的甲板望去，月矩力试验设计局那庞大的轮廓，确实有种…异样的壮观，如同蛰伏的巨兽。"
                                },
                                {
                                    "id": "765030106",
                                    "speaker": "派蒙",
                                    "text": "是啊，光是这样远远地看着，都很有压迫力呢。不知道里面到底藏着多少秘密…"
                                },
                                {
                                    "id": "765030107",
                                    "speaker": "菲林斯",
                                    "text": "嗯，对于寻求独特素材的你们而言，它能提供不少的灵感。"
                                },
                                {
                                    "id": "765030108",
                                    "speaker": "菲林斯",
                                    "text": "毕竟，光明与黑暗的交界，往往最能诞生引人入胜的故事。"
                                },
                                {
                                    "id": "765030109",
                                    "speaker": "派蒙",
                                    "text": "嘿嘿，菲林斯站在这里，身边总伴着那盏幽蓝的灯，看起来就很有故事性呢！"
                                },
                                {
                                    "id": "765030110",
                                    "speaker": "派蒙",
                                    "text": "说起来，你今天不用驻守在…呃…那个地方吗？是在休假？还是在巡逻？"
                                },
                                {
                                    "id": "765030111",
                                    "speaker": "菲林斯",
                                    "text": "算是两者兼而有之吧。守望那些可能从阴影中滋生的灾祸，便是我们「执灯士」永恒的职责。无论身处何地，这份警惕都不能松懈。"
                                },
                                {
                                    "id": "765030112",
                                    "speaker": "菲林斯",
                                    "text": "不过，目前为止，此地的气息还算平稳。你们大可不必过于紧张，安心进行你们的创作吧。",
                                    "choices": [
                                        {
                                            "id": "765030113",
                                            "text": "机会难得…",
                                            "response": [
                                                {
                                                    "id": "765030115",
                                                    "speaker": "菲林斯",
                                                    "text": "为我留影么？这倒是有些出乎我的意料。说实话，我并不太习惯站在镜头面前，成为被审视的对象。"
                                                },
                                                {
                                                    "id": "765030116",
                                                    "speaker": "菲林斯",
                                                    "text": "你们一定能够理解的。我更习惯与沉默的墓碑为邻，与逝者的低语为伴。"
                                                },
                                                {
                                                    "id": "765030117",
                                                    "speaker": "菲林斯",
                                                    "text": "不过，若是拒绝朋友这份真诚的请求，未免也太不解风情，失了待客之道。"
                                                },
                                                {
                                                    "id": "765030118",
                                                    "speaker": "菲林斯",
                                                    "text": "请随意，记录你们认为值得留存的瞬间。我很乐意为你们的艺术创作增添一份微不足道的灵感。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "765030114",
                                            "text": "可以为你拍摄画片吗？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "765030104",
                            "text": "顺便寻找拍摄素材。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7650302",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7650304",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "765030401",
                    "speaker": "菲林斯",
                    "text": "关于如何捕捉此刻的瞬间，你心中是否已有了清晰的想法？"
                }
            ]
        },
        {
            "id": "7650305",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "765030501",
                    "speaker": "Player",
                    "text": "没问题，我们开始留影吧！"
                }
            ]
        },
        {
            "id": "7650306",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "765030601",
                    "speaker": "Player",
                    "text": "请稍等，我再找找灵感。"
                }
            ]
        },
        {
            "id": "7650307",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "765030701",
                    "speaker": "菲林斯",
                    "text": "#哦？是{NICKNAME}和派蒙两位。你们是追寻着某种线索而来，还是意外地迷路至此？",
                    "choices": [
                        {
                            "id": "765030702",
                            "text": "我们正在四处参观。",
                            "response": [
                                {
                                    "id": "765030704",
                                    "speaker": "菲林斯",
                                    "text": "原来如此。希望这座沉默的庞然大物，能为你提供些许灵感。"
                                },
                                {
                                    "id": "765030705",
                                    "speaker": "菲林斯",
                                    "text": "不过，我似乎并未在你身上看到留影机的踪影。是遗落在别处了吗?"
                                }
                            ]
                        },
                        {
                            "id": "765030703",
                            "text": "顺便寻找拍摄素材。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7650308",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "765030801",
                    "speaker": "菲林斯",
                    "text": "看你们的神情，似乎还在寻找合适的拍摄素材？时间尚有余裕，真正的佳作往往诞生于不经意间的灵感。",
                    "choices": [
                        {
                            "id": "765030803",
                            "text": "没问题，我们开始留影吧！",
                            "response": [
                                {
                                    "id": "765030804",
                                    "speaker": "菲林斯",
                                    "text": "看来你已有所得。不过，我似乎并未在你身上看到留影机的踪影。是遗落在别处了吗?"
                                }
                            ]
                        },
                        {
                            "id": "765030802",
                            "text": "请稍等，我再找找灵感。"
                        }
                    ]
                }
            ]
        }
    ]
