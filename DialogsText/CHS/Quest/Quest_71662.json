        "total_dialogue_lines": 77,
        "total_speaker_counts": {
            "Player": 16,
            "凯瑟琳": 7,
            "宏朗": 45,
            "派蒙": 9
        }
    },
    "talks": [
        {
            "id": "7166201",
            "objective": "与凯瑟琳对话",
            "dialogues": [
                {
                    "id": "716620101",
                    "speaker": "凯瑟琳",
                    "text": "旅行者，你来得正好，这里有一份委托，我觉得必须要请你来接下。",
                    "choices": [
                        {
                            "id": "716620102",
                            "text": "是什么危险的委托吗？",
                            "response": [
                                {
                                    "id": "716620104",
                                    "speaker": "凯瑟琳",
                                    "text": "这份委托涉及到一座未知的秘境。"
                                },
                                {
                                    "id": "716620105",
                                    "speaker": "凯瑟琳",
                                    "text": "虽然协会对那座秘境展开了长时间的调查，但一直没收集到什么有价值的资料。"
                                },
                                {
                                    "id": "716620106",
                                    "speaker": "凯瑟琳",
                                    "text": "负责这次调查行动的宏朗先生说，他需要找一位善于随机应变的冒险家来协助调查…"
                                },
                                {
                                    "id": "716620107",
                                    "speaker": "凯瑟琳",
                                    "text": "我第一时间就想到了你，旅行者。"
                                },
                                {
                                    "id": "716620108",
                                    "speaker": "Player",
                                    "text": "到底是什么秘境…"
                                },
                                {
                                    "id": "716620109",
                                    "speaker": "凯瑟琳",
                                    "text": "宏朗先生就在那座秘境的入口旁边，如果你愿意帮忙的话，可以去问问他。"
                                },
                                {
                                    "id": "716620110",
                                    "speaker": "凯瑟琳",
                                    "text": "那就拜托你了，旅行者。"
                                }
                            ]
                        },
                        {
                            "id": "716620103",
                            "text": "是什么很难的委托吗？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7166202",
            "objective": "与宏朗对话",
            "dialogues": [
                {
                    "id": "716620201",
                    "speaker": "宏朗",
                    "text": "这秘境到底是怎么回事…"
                },
                {
                    "id": "716620202",
                    "speaker": "Player",
                    "text": "关于委托…"
                },
                {
                    "id": "716620203",
                    "speaker": "宏朗",
                    "text": "咦？你…等一下，你难道就是凯瑟琳小姐说的那位冒险家吗？"
                },
                {
                    "id": "716620204",
                    "speaker": "宏朗",
                    "text": "我听说，你善于随机应变，精通各种冒险知识，身手也数一数二…",
                    "choices": [
                        {
                            "id": "716620205",
                            "text": "没错。",
                            "response": [
                                {
                                    "id": "716620207",
                                    "speaker": "宏朗",
                                    "text": "太好了，有你过来帮忙的话，我心里总算有点底了…"
                                },
                                {
                                    "id": "716620208",
                                    "speaker": "Player",
                                    "text": "但是，这秘境到底是…"
                                },
                                {
                                    "id": "716620209",
                                    "speaker": "宏朗",
                                    "text": "我差点忘了…还得向你介绍一下情况…"
                                },
                                {
                                    "id": "716620210",
                                    "speaker": "宏朗",
                                    "text": "事情是这样的。在一段时间之前，协会里的一支冒险家小队在野外发现了一扇奇怪的大门…就是我身边这扇。"
                                },
                                {
                                    "id": "716620211",
                                    "speaker": "宏朗",
                                    "text": "通过大门之后，这支小队来到了一座未知的秘境中。"
                                },
                                {
                                    "id": "716620212",
                                    "speaker": "宏朗",
                                    "text": "据第一批进入秘境的冒险家说，当他们进入秘境时，这个秘境就像是一座「空荡荡的屋子」。",
                                    "choices": [
                                        {
                                            "id": "716620213",
                                            "text": "什么意思？",
                                            "response": [
                                                {
                                                    "id": "716620215",
                                                    "speaker": "宏朗",
                                                    "text": "这只是个比喻，准确来说「长大约五十二步，宽大约五十二步，高未知」的一个区域。"
                                                },
                                                {
                                                    "id": "716620216",
                                                    "speaker": "宏朗",
                                                    "text": "在这个区域的五十二步之内，都是铺着石砖的平常区域，但五十二步之外的区域，全都被某种深灰色的浓雾所填充。"
                                                },
                                                {
                                                    "id": "716620217",
                                                    "speaker": "宏朗",
                                                    "text": "而且，当有人想要跨越边界，到五十二步之外的区域中去时…"
                                                },
                                                {
                                                    "id": "716620218",
                                                    "speaker": "宏朗",
                                                    "text": "这个人要么会莫名其妙地转向，向着相反的方向前进…要么就是突然消失，然后再出现在所有人的身后。"
                                                },
                                                {
                                                    "id": "716620219",
                                                    "speaker": "宏朗",
                                                    "text": "总之，无论用任何方法，都没人能跨越到五十二步之外的区域中。"
                                                },
                                                {
                                                    "id": "716620220",
                                                    "speaker": "Player",
                                                    "text": "试过用其他工具探索吗？"
                                                },
                                                {
                                                    "id": "716620221",
                                                    "speaker": "宏朗",
                                                    "text": "他们当然试过，但丢出去的东西会回到原地，连火把的光芒都无法探入五十二步之外的区域。"
                                                },
                                                {
                                                    "id": "716620222",
                                                    "speaker": "派蒙",
                                                    "text": "所以，你是想要让我们来帮你探索这座秘境吗？"
                                                },
                                                {
                                                    "id": "716620223",
                                                    "speaker": "宏朗",
                                                    "text": "是的，不过…你们要做的，也许不仅仅是「探索」这么简单。"
                                                },
                                                {
                                                    "id": "716620224",
                                                    "speaker": "宏朗",
                                                    "text": "在这里也说不清楚，我们先去秘境里看看吧。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "716620214",
                                            "text": "空荡荡的…屋子？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "716620206",
                            "text": "算、算是吧…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7166203",
            "objective": "进入秘境",
            "dialogues": [
                {
                    "id": "716620301",
                    "speaker": "派蒙",
                    "text": "这里…"
                },
                {
                    "id": "716620302",
                    "speaker": "派蒙",
                    "text": "就是你说的那座和「空荡荡的屋子」一样的秘境？",
                    "choices": [
                        {
                            "id": "716620303",
                            "text": "这就是一般的秘境吧…",
                            "response": [
                                {
                                    "id": "716620305",
                                    "speaker": "派蒙",
                                    "text": "对啊！这不就是我们经常去探索的那种遗迹吗？！"
                                },
                                {
                                    "id": "716620306",
                                    "speaker": "宏朗",
                                    "text": "这里确实就是我们正在探索的那座秘境。"
                                },
                                {
                                    "id": "716620307",
                                    "speaker": "宏朗",
                                    "text": "这座秘境之所以是现在这个样子，是因为…"
                                },
                                {
                                    "id": "716620308",
                                    "speaker": "宏朗",
                                    "text": "在不久前，它变成了这样。"
                                },
                                {
                                    "id": "716620309",
                                    "speaker": "派蒙",
                                    "text": "欸？"
                                },
                                {
                                    "id": "716620310",
                                    "speaker": "Player",
                                    "text": "「变」成了这样？"
                                },
                                {
                                    "id": "716620311",
                                    "speaker": "宏朗",
                                    "text": "没错。这座秘境…会随着人的心意而变化。"
                                },
                                {
                                    "id": "716620312",
                                    "speaker": "宏朗",
                                    "text": "据当时领导冒险的冒险队队长说，他们在那个灰蒙蒙的环境里折腾了很久，大家都开始有些失去耐心了。"
                                },
                                {
                                    "id": "716620313",
                                    "speaker": "宏朗",
                                    "text": "这个时候，其中一位成员开始小声抱怨了起来。"
                                },
                                {
                                    "id": "716620314",
                                    "speaker": "宏朗",
                                    "text": "「如果这里是一座普通的遗迹，那我们早就探索完了。」"
                                },
                                {
                                    "id": "716620315",
                                    "speaker": "宏朗",
                                    "text": "冒险队的人又饿又困，纷纷对他的看法表示同意。"
                                },
                                {
                                    "id": "716620316",
                                    "speaker": "宏朗",
                                    "text": "随着越来越多的人同意这个看法，不知道在哪个刹那，冒险队突然发现自己已经处在一个「普通的遗迹」里了。"
                                },
                                {
                                    "id": "716620317",
                                    "speaker": "宏朗",
                                    "text": "这座「普通的遗迹」里有机关，有道路，有宝藏…甚至火把都还在燃烧。"
                                },
                                {
                                    "id": "716620318",
                                    "speaker": "宏朗",
                                    "text": "冒险队判断自己无法处理这种情况，就马上回到了协会报告了这件事。"
                                },
                                {
                                    "id": "716620319",
                                    "speaker": "宏朗",
                                    "text": "我们迅速加派人手，对这处秘境展开了更深入的研究。"
                                },
                                {
                                    "id": "716620320",
                                    "speaker": "宏朗",
                                    "text": "但到了现在，我们也只知道，这座秘境会随人的心意而变化。"
                                },
                                {
                                    "id": "716620321",
                                    "speaker": "宏朗",
                                    "text": "如果有多人同时进入秘境，那这个秘境则会根据心愿最强烈的人的想法而变化。"
                                },
                                {
                                    "id": "716620322",
                                    "speaker": "派蒙",
                                    "text": "哇！那这里不是可以再变出一个璃月港来？"
                                },
                                {
                                    "id": "716620323",
                                    "speaker": "宏朗",
                                    "text": "这个我们试过了，可是一直没成功…我想，也许是我们想要再变出个璃月港的心愿不够强烈吧。"
                                },
                                {
                                    "id": "716620324",
                                    "speaker": "宏朗",
                                    "text": "总之，我们现在正在招募冒险家进入秘境，拜托他们依照自己的心愿，让这座秘境不断地变化。"
                                },
                                {
                                    "id": "716620325",
                                    "speaker": "宏朗",
                                    "text": "在这样的过程中，我们也许能找出这个秘境变化的某些规律，从而找到我们想要的答案。",
                                    "choices": [
                                        {
                                            "id": "716620326",
                                            "text": "那我要怎么操作？",
                                            "response": [
                                                {
                                                    "id": "716620328",
                                                    "speaker": "宏朗",
                                                    "text": "你看到那边的机关了吗？那就是我们设置的「触发器」，是一个冒险家想出来的办法。"
                                                },
                                                {
                                                    "id": "716620329",
                                                    "speaker": "宏朗",
                                                    "text": "简单来说，他的心愿是「只有触摸这个机关才能让秘境开始变化」。"
                                                },
                                                {
                                                    "id": "716620330",
                                                    "speaker": "宏朗",
                                                    "text": "然后，这座秘境也回应了他的心愿，但为了保证这个机关一直存在，我们隔段时间就要让他重新回来一趟…"
                                                },
                                                {
                                                    "id": "716620331",
                                                    "speaker": "Player",
                                                    "text": "居然有这种方法…"
                                                },
                                                {
                                                    "id": "716620332",
                                                    "speaker": "宏朗",
                                                    "text": "这也是一种应急方案啦，不然，这座秘境说不定就要变化个不停了…"
                                                },
                                                {
                                                    "id": "716620333",
                                                    "speaker": "宏朗",
                                                    "text": "不过从另外一个角度来说，这座秘境还挺适合锻炼冒险家的，毕竟只要一动念头，各种机关和地形都能变出来。"
                                                },
                                                {
                                                    "id": "716620334",
                                                    "speaker": "宏朗",
                                                    "text": "光是说你肯定也不明白，干脆你亲手来试试看吧。"
                                                },
                                                {
                                                    "id": "716620335",
                                                    "speaker": "宏朗",
                                                    "text": "你看见那边的金色「冒险币」了吗？那也是我们用心愿变出来的小玩意。"
                                                },
                                                {
                                                    "id": "716620336",
                                                    "speaker": "宏朗",
                                                    "text": "旅行者，你先来试试拿到那枚「冒险币」吧。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "716620327",
                                            "text": "要用什么特殊方式吗？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "716620304",
                            "text": "看起来还挺熟悉的…"
                        }
                    ]
                }
            ]
        },
        {
