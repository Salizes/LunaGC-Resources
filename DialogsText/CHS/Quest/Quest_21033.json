    "talks": [
        {
            "id": "2103301",
            "objective": "与岚姐对话",
            "dialogues": [
                {
                    "id": "210330101",
                    "speaker": "岚姐",
                    "text": "不知道…这个思路能不能管用…"
                },
                {
                    "id": "210330102",
                    "speaker": "Player",
                    "text": "你还在找那把剑吗？"
                },
                {
                    "id": "210330103",
                    "speaker": "岚姐",
                    "text": "旅行者？是你啊…是的，我还在找那把「藏锋」呢。"
                },
                {
                    "id": "210330104",
                    "speaker": "岚姐",
                    "text": "但到现在，我也没有找到什么有价值的线索。"
                },
                {
                    "id": "210330105",
                    "speaker": "岚姐",
                    "text": "不过这也是没办法的事，毕竟在整个璃月寻找一把剑…实在是太难了。"
                },
                {
                    "id": "210330106",
                    "speaker": "岚姐",
                    "text": "有人和我说，那把剑也许早就被魔物毁了…但即使它碎了，我也要把所有碎片都找到。"
                },
                {
                    "id": "210330107",
                    "speaker": "岚姐",
                    "text": "抱歉，自顾自地说了这么多。这次的委托地点我已经标在你的地图上了，拜托你了，旅行者。"
                },
                {
                    "id": "210330108",
                    "speaker": "岚姐",
                    "text": "希望…那把剑不要真的碎了…"
                }
            ]
        },
        {
            "id": "2103302",
            "objective": "打倒所有魔物",
            "dialogues": [
                {
                    "id": "210330201",
                    "speaker": "岚姐",
                    "text": "希望…那把剑不要真的碎了…"
                }
            ]
        },
        {
            "id": "2103303",
            "objective": "在营地搜寻一番",
            "dialogues": []
        },
        {
            "id": "2103304",
            "objective": "与岚姐对话",
            "dialogues": [
                {
                    "id": "210330401",
                    "speaker": "岚姐",
                    "text": "怎么样，旅行者？这次你找到什么东西了吗？"
                },
                {
                    "id": "210330402",
                    "speaker": "Player",
                    "text": "找到了这个剑柄…"
                }
            ]
        },
        {
            "id": "2103306",
            "objective": "与岚姐对话",
            "dialogues": [
                {
                    "id": "210330403",
                    "speaker": "岚姐",
                    "text": "这剑柄…倒是还算完整。"
                },
                {
                    "id": "210330404",
                    "speaker": "Player",
                    "text": "它和「藏锋」有关吗？"
                },
                {
                    "id": "210330405",
                    "speaker": "岚姐",
                    "text": "我还要仔细分辨后才知道…喔，忘了告诉你，我前段时间就开始四处搜集武器的碎片了。"
                },
                {
                    "id": "210330406",
                    "speaker": "岚姐",
                    "text": "我从市场上，野外，还有冒险家的手里得到了不少碎片，想着也许能从这方面找到「藏锋」的线索…"
                },
                {
                    "id": "210330407",
                    "speaker": "岚姐",
                    "text": "但直到现在，我也没能找到它的任何踪迹…"
                },
                {
                    "id": "210330408",
                    "speaker": "岚姐",
                    "text": "没关系，我们璃月有句话叫「有志者，事竟成」，我还是会一直找下去…直到找到「藏锋」。"
                },
                {
                    "id": "210330409",
                    "speaker": "岚姐",
                    "text": "啊，这些报酬给你，辛苦你了，旅行者。"
                }
            ]
        },
        {
