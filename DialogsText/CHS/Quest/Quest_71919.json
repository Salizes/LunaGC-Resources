            "dialogues": [
                {
                    "id": "719190101",
                    "speaker": "Player",
                    "text": "教头？"
                },
                {
                    "id": "719190102",
                    "speaker": "逢岩",
                    "text": "只是虚名罢了，在下的拳脚功夫比同僚好些，因此在军中负责给新兵传授拳法。"
                },
                {
                    "id": "719190103",
                    "speaker": "逢岩",
                    "text": "你的眼神…让我想起了曾经教过的一个士兵，本来他应该会接替我的位置…"
                },
                {
                    "id": "719190104",
                    "speaker": "逢岩",
                    "text": "…可后来他因为一场意外丧生了，我也再没机会在他升任教头那天，亲自为他佩戴上这朵胸花了…"
                },
                {
                    "id": "719190105",
                    "speaker": "逢岩",
                    "text": "不好意思，自说自话说了许多，这个送给你吧，也算是弥补了我的遗憾。"
                }
            ]
        }
