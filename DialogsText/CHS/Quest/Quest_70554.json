    "talks": [
        {
            "id": "7055401",
            "objective": "与赫塔对话",
            "dialogues": [
                {
                    "id": "705540101",
                    "speaker": "赫塔",
                    "text": "荣誉骑士和白色小帮手，你们好啊！"
                },
                {
                    "id": "705540102",
                    "speaker": "格兰菲狄",
                    "text": "初次见面，荣誉骑士和派蒙长官，在下格兰菲狄，听候调遣。"
                },
                {
                    "id": "705540103",
                    "speaker": "派蒙",
                    "text": "心情不错嘛，赫塔！还有这位骑士小姐，很高兴认识你！"
                },
                {
                    "id": "705540104",
                    "speaker": "派蒙",
                    "text": "看样子，你们正准备开张了？"
                },
                {
                    "id": "705540105",
                    "speaker": "赫塔",
                    "text": "嗯！得益于「天使的馈赠」和「猫尾酒馆」的协助，饮品小站的一切都准备就绪了。"
                },
                {
                    "id": "705540106",
                    "speaker": "赫塔",
                    "text": "除了经典的纯饮，我们这里也提供调制饮品，以及限时饮品外送服务…"
                },
                {
                    "id": "705540107",
                    "speaker": "派蒙",
                    "text": "调制饮品？"
                },
                {
                    "id": "705540108",
                    "speaker": "派蒙",
                    "text": "很久以前，我们在「天使的馈赠」当过调饮师来着？最近你在挪德卡莱的「旗舰」也露过几手…",
                    "choices": [
                        {
                            "id": "705540109",
                            "text": "确实呢，好久好久了。",
                            "response": [
                                {
                                    "id": "705540111",
                                    "speaker": "赫塔",
                                    "text": "不过，目前的饮品都比较传统，远征开始前，所有人就习以为常了。为了给大家提供新鲜的选择，我们打算改进酒单。"
                                },
                                {
                                    "id": "705540112",
                                    "speaker": "赫塔",
                                    "text": "但我还得回去管理居民请求的事宜，格兰菲狄调制饮品的经验又不足，还有外送的订单要处理…"
                                },
                                {
                                    "id": "705540113",
                                    "speaker": "赫塔",
                                    "text": "如果荣誉骑士有空，能麻烦你暂时帮帮忙吗？一段时间后，我的另一组部下就会从望风山地回来顶班。"
                                },
                                {
                                    "id": "705540114",
                                    "speaker": "格兰菲狄",
                                    "text": "当然，我们会支付报酬，还有双倍的加班绩效！",
                                    "choices": [
                                        {
                                            "id": "705540115",
                                            "text": "我确实对调制饮品颇有心得。",
                                            "response": [
                                                {
                                                    "id": "705540117",
                                                    "speaker": "派蒙",
                                                    "text": "虽然听不懂绩效是什么，但我也可以帮忙处理外送订单的事！"
                                                },
                                                {
                                                    "id": "705540118",
                                                    "speaker": "派蒙",
                                                    "text": "作为提瓦特最好的向导，我也要与时俱进，多在城里转转，了解一下蒙德最近的变化！"
                                                },
                                                {
                                                    "id": "705540119",
                                                    "speaker": "赫塔",
                                                    "text": "哎呀，和你们两位合作起来，简直顺利得就像呼吸一样自然！"
                                                },
                                                {
                                                    "id": "705540120",
                                                    "speaker": "格兰菲狄",
                                                    "text": "我就全力支援派蒙长官。分装饮品之类的工作，我非常熟练。"
                                                },
                                                {
                                                    "id": "705540121",
                                                    "speaker": "派蒙",
                                                    "text": "那事不宜迟，开工开工！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "705540116",
                                            "text": "整个吧台可以完全交给我哦。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "705540110",
                            "text": "记不太清了，不过没关系。"
                        }
                    ]
                }
            ]
        }
    ]
}