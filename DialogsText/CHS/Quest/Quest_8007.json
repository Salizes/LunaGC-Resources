    "talks": [
        {
            "id": "800701",
            "objective": "前往遗迹顶层中心的房间查看情况",
            "dialogues": [
                {
                    "id": "80070101",
                    "speaker": "戴因斯雷布",
                    "text": "本以为会在一瞬间灰飞烟灭…哈夫丹的灵魂竟然如此强韧。"
                },
                {
                    "id": "80070102",
                    "speaker": "深渊司铎",
                    "text": "碍事的东西！给我闪开…"
                },
                {
                    "id": "80070103",
                    "speaker": "戴因斯雷布",
                    "text": "你在看哪里？机会难得，你总算能除掉我了，不是吗？"
                },
                {
                    "id": "80070104",
                    "speaker": "深渊司铎",
                    "text": "…戴因斯雷布！"
                },
                {
                    "id": "80070105",
                    "speaker": "戴因斯雷布",
                    "text": "干掉他，关闭那个装置！"
                }
            ]
        },
        {
            "id": "800711",
            "objective": "与戴因斯雷布对话",
            "dialogues": []
        },
        {
            "id": "800702",
            "objective": "击败深渊司铎",
            "dialogues": []
        },
        {
            "id": "800703",
            "objective": "与戴因斯雷布对话",
            "dialogues": [
                {
                    "id": "80070301",
                    "speaker": "派蒙",
                    "text": "怎么办，把那个深渊司铎解决了，装置却还是没有停下来…"
                },
                {
                    "id": "80070302",
                    "speaker": "派蒙",
                    "text": "哈夫丹他…",
                    "choices": [
                        {
                            "id": "80070303",
                            "text": "让我来代替他吧。",
                            "response": [
                                {
                                    "id": "80070305",
                                    "speaker": "戴因斯雷布",
                                    "text": "不行！只要装置还保持启动状态，我们这些受过诅咒的人就无法发挥出原本实力，只有你才是深渊的对手。"
                                },
                                {
                                    "id": "80070306",
                                    "speaker": "戴因斯雷布",
                                    "text": "如果你珍惜他的献身，就别在这里浪费时间。"
                                },
                                {
                                    "id": "80070307",
                                    "speaker": "戴因斯雷布",
                                    "text": "看到周围那些光线和传送门了吗？他们一定把能源装置分散安置在别处了，过去确认情况，要快！"
                                },
                                {
                                    "id": "80070308",
                                    "speaker": "派蒙",
                                    "text": "是要穿过那些深渊的传送门吗…喂等等我！"
                                }
                            ]
                        },
                        {
                            "id": "80070304",
                            "text": "我不会受到诅咒净化效果的影响。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "800704",
            "objective": "破坏所有供能机关",
            "dialogues": []
        },
        {
            "id": "800705",
            "objective": "破坏所有供能机关",
            "dialogues": []
        },
        {
            "id": "800706",
            "objective": "破坏所有供能机关",
            "dialogues": []
        },
        {
            "id": "800707",
            "objective": "破坏所有供能机关",
            "dialogues": []
        },
        {
            "id": "800709",
            "objective": "前往哈夫丹附近",
            "dialogues": [
                {
                    "id": "80070901",
                    "speaker": "派蒙",
                    "text": "这下总算是把装置彻底关掉了吧？"
                },
                {
                    "id": "80070902",
                    "speaker": "戴因斯雷布",
                    "text": "烧灼感消失了…"
                },
                {
                    "id": "80070903",
                    "speaker": "派蒙",
                    "text": "我们成功阻止了深渊的计划吗？",
                    "choices": [
                        {
                            "id": "80070904",
                            "text": "只是哈夫丹…",
                            "response": [
                                {
                                    "id": "80070906",
                                    "speaker": "戴因斯雷布",
                                    "text": "……"
                                },
                                {
                                    "id": "80070907",
                                    "speaker": "戴因斯雷布",
                                    "text": "我再确认一下。"
                                },
                                {
                                    "id": "80070908",
                                    "speaker": "派蒙",
                                    "text": "戴因他…其实很难过吧？"
                                },
                                {
                                    "id": "80070909",
                                    "speaker": "派蒙",
                                    "text": "昔日的战友，以这样的形式再会…"
                                },
                                {
                                    "id": "80070910",
                                    "speaker": "戴因斯雷布",
                                    "text": "……"
                                },
                                {
                                    "id": "80070911",
                                    "speaker": "戴因斯雷布",
                                    "text": "…走吧。"
                                }
                            ]
                        },
                        {
                            "id": "80070905",
                            "text": "他似乎没有生命的气息了。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "800710",
            "objective": "与戴因斯雷布对话",
            "dialogues": [
                {
                    "id": "80071001",
                    "speaker": "派蒙",
                    "text": "刚才那是…哈夫丹的灵魂…"
                },
                {
                    "id": "80071002",
                    "speaker": "戴因斯雷布",
                    "text": "这里汇聚着不止一种诡异力量。就算见到魂魄也不奇怪。"
                },
                {
                    "id": "80071003",
                    "speaker": "戴因斯雷布",
                    "text": "不过，如果你们想继续前往深处探索，就要小心了。"
                },
                {
                    "id": "80071004",
                    "speaker": "戴因斯雷布",
                    "text": "咳咳…"
                },
                {
                    "id": "80071005",
                    "speaker": "派蒙",
                    "text": "嗯，我们会小心的。欸对了，戴因难道不跟我们一起走吗？"
                },
                {
                    "id": "80071006",
                    "speaker": "戴因斯雷布",
                    "text": "刚才那台装置同样给我造成了不小的创伤，我需要一点时间来恢复。"
                },
                {
                    "id": "80071007",
                    "speaker": "派蒙",
                    "text": "原来如此…不对，我其实早就看出来了，你一直是在硬撑而已！"
                },
                {
                    "id": "80071008",
                    "speaker": "派蒙",
                    "text": "也该休息了，戴因…比如说，给自己放个假什么的！"
                },
                {
                    "id": "80071009",
                    "speaker": "戴因斯雷布",
                    "text": "放假？这不是该出现在我身上的词语。"
                },
                {
                    "id": "80071010",
                    "speaker": "戴因斯雷布",
                    "text": "我还有重要的事。「命运的织机」计划还在进行。"
                },
                {
                    "id": "80071011",
                    "speaker": "戴因斯雷布",
                    "text": "我甚至怀疑，这里的增幅装置也跟那个计划有关。",
                    "choices": [
                        {
                            "id": "80071012",
                            "text": "我也会留意。",
                            "response": [
                                {
                                    "id": "80071014",
                                    "speaker": "戴因斯雷布",
                                    "text": "感谢你的体谅，「雇主」。"
                                },
                                {
                                    "id": "80071015",
                                    "speaker": "戴因斯雷布",
                                    "text": "只希望下次见面时，你不会站在「那边」。"
                                },
                                {
                                    "id": "80071016",
                                    "speaker": "派蒙",
                                    "text": "喂，戴因他是不是有点记仇呀，最后才那么说…"
                                },
                                {
                                    "id": "80071017",
                                    "speaker": "派蒙",
                                    "text": "#虽然还是没能再一次见到你的{PLAYERAVATAR#SEXPRO[INFO_FEMALE_PRONOUN_SISTER|INFO_MALE_PRONOUN_BROTHER]}，但也算是了解了很多有用的信息吧？"
                                },
                                {
                                    "id": "80071018",
                                    "speaker": "派蒙",
                                    "text": "只要继续旅行，你们总会相遇，然后和好如初的，对吧？"
                                },
                                {
                                    "id": "80071019",
                                    "speaker": "派蒙",
                                    "text": "哦对了，还记得我们一开始是为了调查丘丘人们的诡异行踪才过来的吗？"
                                },
                                {
                                    "id": "80071020",
                                    "speaker": "派蒙",
                                    "text": "这下应该可以找那位矿工大哥报告了吧，只是…好像有点不知道怎么说，这里发生的事对普通人来说有些太过复杂了吧！"
                                },
                                {
                                    "id": "80071021",
                                    "speaker": "派蒙",
                                    "text": "总之，别把那份委托给忘了就行。"
                                }
                            ]
                        },
                        {
                            "id": "80071013",
                            "text": "等你恢复了，我会再和你好好聊聊。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "800799",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "80079901",
                    "speaker": "派蒙",
                    "text": "那些丘丘人看起来真的很痛苦…啊！难道说，现在的戴因也在忍受这样的痛苦吗？"
                },
                {
                    "id": "80079902",
                    "speaker": "戴因斯雷布",
                    "text": "不必介意。哈夫丹他们所承受的苦痛远胜于我。抓紧时间！"
                },
                {
                    "id": "80079904",
                    "speaker": "派蒙",
                    "text": "四周都暗下来了，我们回去中央的房间看看吧？"
                }
            ]
        }
    ]
}