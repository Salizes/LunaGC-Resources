    "talks": [
        {
            "id": "7302801",
            "objective": "寻找被水淹没的洞窟",
            "dialogues": [
                {
                    "id": "730280101",
                    "speaker": "派蒙",
                    "text": "看来这里也有大机器人的零件，要是让加扎里先生看到的话，估计又要掏出他的那台留影机了。"
                },
                {
                    "id": "730280102",
                    "speaker": "派蒙",
                    "text": "说起来，之前兰利遮说，秘密基地里的大零件是兰利遮搬过去的，该不会是真的吧？"
                },
                {
                    "id": "730280103",
                    "speaker": "兰利遮",
                    "text": "当然是真的，兰利遮不骗那菈。",
                    "choices": [
                        {
                            "id": "730280104",
                            "text": "果然…",
                            "response": [
                                {
                                    "id": "730280106",
                                    "speaker": "派蒙",
                                    "text": "兰利遮就是当初陪着孩子们在秘密基地里玩耍的兰那罗吧。"
                                },
                                {
                                    "id": "730280107",
                                    "speaker": "派蒙",
                                    "text": "不过兰利遮也什么都不记得了…",
                                    "choices": [
                                        {
                                            "id": "730280108",
                                            "text": "或许和笔记里的花有关吧…",
                                            "response": [
                                                {
                                                    "id": "730280110",
                                                    "speaker": "派蒙",
                                                    "text": "嗯，之前无郁稠林的兰那罗把花花给我们之后，也忘记了所有的事情。"
                                                },
                                                {
                                                    "id": "730280111",
                                                    "speaker": "派蒙",
                                                    "text": "或许他们三个也经历过和我们一样的冒险吧。"
                                                },
                                                {
                                                    "id": "730280112",
                                                    "speaker": "兰利遮",
                                                    "text": "兰利遮不知道你们说的是什么，也想不起来。不过，和小那菈玩，很开心！"
                                                },
                                                {
                                                    "id": "730280113",
                                                    "speaker": "派蒙",
                                                    "text": "嗯，要一直开心哦，兰利遮。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "730280109",
                                            "text": "我们之前也遇到过…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "730280105",
                            "text": "如果没猜错的话…"
                        }
                    ]
                }
            ]
        },
