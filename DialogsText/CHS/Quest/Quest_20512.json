    "talks": [
        {
            "id": "2051201",
            "objective": "与安东尼对话",
            "dialogues": [
                {
                    "id": "205120101",
                    "speaker": "安东尼",
                    "text": "药方越来越怪了…"
                },
                {
                    "id": "205120102",
                    "speaker": "Player",
                    "text": "安娜怎么样了？"
                },
                {
                    "id": "205120103",
                    "speaker": "安东尼",
                    "text": "是你啊，呃，虽然说出来你可能不信，但是安娜说自己确实感觉好多了。"
                },
                {
                    "id": "205120104",
                    "speaker": "安东尼",
                    "text": "难道是那位医生的药方真的起作用了？我自己都不信…"
                },
                {
                    "id": "205120105",
                    "speaker": "安东尼",
                    "text": "不过，不管是不是真的，总之还是先吃药吧。"
                },
                {
                    "id": "205120106",
                    "speaker": "安东尼",
                    "text": "这次的药方是…我看看，你能帮我找一份「水史莱姆的浓厚凝液」来吗？",
                    "choices": [
                        {
                            "id": "205120107",
                            "text": "这次的还算正常。",
                            "response": [
                                {
                                    "id": "205120108",
                                    "speaker": "安东尼",
                                    "text": "…呃，正常吗？我觉得这次的反而更不正常了。"
                                },
                                {
                                    "id": "205120109",
                                    "speaker": "安东尼",
                                    "text": "不过，这次倒是挺好找的，「浓厚凝液」我也问过别人，只要消灭大型史莱姆应该就能拿到。"
                                },
                                {
                                    "id": "205120110",
                                    "speaker": "安东尼",
                                    "text": "我还听杰克说，如果想引出大型史莱姆，就要先不断消灭小型的史莱姆。"
                                },
                                {
                                    "id": "205120111",
                                    "speaker": "安东尼",
                                    "text": "我是没这种战斗力的，所以，就拜托你了！"
                                }
                            ]
                        },
                        {
                            "id": "205120112",
                            "text": "也许能入口，放心吧。",
                            "response": [
                                {
                                    "id": "205120113",
                                    "speaker": "安东尼",
                                    "text": "你怎么知道的，你难道尝试过吗？呃，你怎么突然不说话了…"
                                },
                                {
                                    "id": "205120114",
                                    "speaker": "安东尼",
                                    "text": "算了先不说这个，水史莱姆应该很好找。「浓厚凝液」我问过别人，只要消灭大型史莱姆应该就能拿到。"
                                },
                                {
                                    "id": "205120115",
                                    "speaker": "安东尼",
                                    "text": "我还听杰克说，如果想引出大型史莱姆，就要先不断消灭小型的史莱姆。"
                                },
                                {
                                    "id": "205120116",
                                    "speaker": "安东尼",
                                    "text": "我是没这种战斗力的啦，就拜托你了！"
                                }
                            ]
                        },
                        {
                            "id": "205120117",
                            "text": "好说，我知道在哪。",
                            "response": [
                                {
                                    "id": "205120118",
                                    "speaker": "安东尼",
                                    "text": "嚯…真可靠啊，看来你已经很熟悉怎么对付史莱姆了呢。"
                                },
                                {
                                    "id": "205120119",
                                    "speaker": "安东尼",
                                    "text": "那就麻烦你了。「浓厚凝液」，只要消灭大型史莱姆应该就能拿到。"
                                },
                                {
                                    "id": "205120120",
                                    "speaker": "安东尼",
                                    "text": "我还听杰克说，如果想引出大型史莱姆，就要先不断消灭小型的史莱姆。"
                                },
                                {
                                    "id": "205120121",
                                    "speaker": "安东尼",
                                    "text": "那么，就万事拜托了。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2051202",
            "objective": "取得「水史莱姆的浓厚凝液」",
            "dialogues": [
                {
                    "id": "205120201",
                    "speaker": "安东尼",
                    "text": "你找到东西了吗？"
                },
                {
                    "id": "205120202",
                    "speaker": "Player",
                    "text": "还没有。"
                },
                {
                    "id": "205120203",
                    "speaker": "安东尼",
                    "text": "毕竟还是要战斗，请做好准备再去吧。"
                }
            ]
        },
        {
            "id": "2051203",
            "objective": "与安东尼对话",
            "dialogues": [
                {
                    "id": "205120301",
                    "speaker": "安东尼",
                    "text": "你找到东西了吗？"
                },
                {
                    "id": "205120302",
                    "speaker": "Player",
                    "text": "找到了。"
                },
                {
                    "id": "205120303",
                    "speaker": "安东尼",
                    "text": "这…看起来确实…很浓郁啊…"
                },
                {
                    "id": "205120304",
                    "speaker": "安东尼",
                    "text": "这东西真的能入药吗，做好了药，我得自己先试试。"
                },
                {
                    "id": "205120305",
                    "speaker": "安东尼",
                    "text": "假如我出了什么事，安娜就拜托你…"
                },
                {
                    "id": "205120306",
                    "speaker": "安东尼",
                    "text": "…交给葛瑞丝修女照顾了。"
                },
                {
                    "id": "205120307",
                    "speaker": "安东尼",
                    "text": "然后告诉她，我去很远的地方工作了，拜托你了，这是我最后的愿望。"
                },
                {
                    "id": "205120308",
                    "speaker": "Player",
                    "text": "没事的，你别自己吓自己…"
                },
                {
                    "id": "205120309",
                    "speaker": "安东尼",
                    "text": "因为这药看着就很吓人啊！总之，这些你先收下吧。"
                },
                {
                    "id": "205120310",
                    "speaker": "安东尼",
                    "text": "一定要记得我说的话啊！"
                }
            ]
        }
    ]
