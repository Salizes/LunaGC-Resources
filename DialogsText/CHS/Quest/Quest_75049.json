            "dialogues": []
        },
        {
            "id": "7504904",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "750490401",
                    "speaker": "夜魂之灵",
                    "text": "嗯…没有想到你居然能找到这里的入口，这里已，许久未有人来了…"
                },
                {
                    "id": "750490402",
                    "speaker": "夜魂之灵",
                    "text": "此处，嗯，此处是夜魂们游荡之处…呵呵，不过，太阳所照的大地之上，恐怕就连夜魂的名讳业已无人记得。"
                },
                {
                    "id": "750490403",
                    "speaker": "夜魂之灵",
                    "text": "夜魂啊…在我们的主人睡着时，我们就是她的梦。在我们的神偶尔醒来时，我们就是她思绪的一缕。"
                },
                {
                    "id": "750490404",
                    "speaker": "夜魂之灵",
                    "text": "竟然有能来到此处的生人，呵呵，那些渴求战斗的家伙们已按捺不住…异邦的勇者，受宠爱之人…"
                },
                {
                    "id": "750490405",
                    "speaker": "夜魂之灵",
                    "text": "用炽烈的战斗安抚这些躁动不安的魂灵吧，取得胜利，而深眠此处的灵必有嘉奖…如何？"
                }
            ]
        },
        {
            "id": "7504905",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "750490501",
                    "speaker": "夜魂之灵",
                    "text": "哦…改变主意了吗？"
                },
                {
                    "id": "750490502",
                    "speaker": "夜魂之灵",
                    "text": "要尝试与此处的夜魂战斗吗？"
                }
            ]
        }
    ]
