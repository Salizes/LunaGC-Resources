    "talks": [
        {
            "id": "38806",
            "objective": "前往风龙废墟入口",
            "dialogues": []
        },
        {
            "id": "38801",
            "objective": "(test)与温迪对话$HIDDEN",
            "dialogues": [
                {
                    "id": "3880101",
                    "speaker": "派蒙",
                    "text": "是暴风的<color=#00E1FFFF>障壁</color>！"
                },
                {
                    "id": "3880102",
                    "speaker": "派蒙",
                    "text": "哇…真是看起来非常危险的景观。"
                },
                {
                    "id": "3880103",
                    "speaker": "温迪",
                    "text": "交给我吧。"
                },
                {
                    "id": "3880104",
                    "speaker": "温迪",
                    "text": "虽然手里只有一把普通的木琴…"
                },
                {
                    "id": "3880105",
                    "speaker": "温迪",
                    "text": "但要打破这种风障，也用不上「天空」——咦？那是什么？"
                },
                {
                    "id": "3880106",
                    "speaker": "琴",
                    "text": "敌袭！各位，准备迎战。"
                }
            ]
        },
        {
            "id": "38802",
            "objective": "击败来袭的敌人",
            "dialogues": []
        },
        {
            "id": "38805",
            "objective": "(test)失败任务回滚$HIDDEN",
            "dialogues": []
        },
        {
            "id": "38803",
            "objective": "开启风障",
            "dialogues": [
                {
                    "id": "3880301",
                    "speaker": "温迪",
                    "text": "呼…"
                },
                {
                    "id": "3880302",
                    "speaker": "温迪",
                    "text": "丘丘人…通常，它们不太会在元素浓度过高的区域活动。"
                },
                {
                    "id": "3880303",
                    "speaker": "温迪",
                    "text": "在这里，它们的身体要承受更大的负担…"
                },
                {
                    "id": "3880304",
                    "speaker": "迪卢克",
                    "text": "想必就是深渊教团在背后操控吧，但它们应该不能确定我们会来这里。"
                },
                {
                    "id": "3880305",
                    "speaker": "迪卢克",
                    "text": "为了阻止我们的行动，教团恐怕正在向四处投放兵力。"
                },
                {
                    "id": "3880306",
                    "speaker": "温迪",
                    "text": "那么，事不宜迟——"
                },
                {
                    "id": "3880307",
                    "speaker": "温迪",
                    "text": "这次的听众只是「风」而已，拨弦的速度加快一点也无所谓吧。"
                }
            ]
        },
        {
            "id": "38804",
            "objective": "与温迪对话",
            "dialogues": [
                {
                    "id": "3880401",
                    "speaker": "派蒙",
                    "text": "哇，真的能打开耶。你偶尔也会有点用嘛，卖唱的。"
                },
                {
                    "id": "3880402",
                    "speaker": "琴",
                    "text": "从这里开始，就算是正式进入<color=#00E1FFFF>「风龙废墟」</color>了。"
                },
                {
                    "id": "3880403",
                    "speaker": "琴",
                    "text": "请各位务必小心。我们走吧。"
                }
            ]
        },
        {
            "id": "38408",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "3840801",
                    "speaker": "温迪",
                    "text": "我会用这双眼见证到最后。"
                },
                {
                    "id": "3840802",
                    "speaker": "琴",
                    "text": "为了蒙德，骑士团会竭尽所能。"
                },
                {
                    "id": "3840803",
                    "speaker": "迪卢克",
                    "text": "还不动身吗。"
                }
            ]
        }
    ]
