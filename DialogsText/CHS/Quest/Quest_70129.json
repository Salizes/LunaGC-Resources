    "talks": [
        {
            "id": "7012901",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "701290101",
                    "speaker": "丘林",
                    "text": "呜…可是布拉金老师，我、我感觉有点坚持不住了。"
                },
                {
                    "id": "701290102",
                    "speaker": "布拉金",
                    "text": "你们要是连这点寒冷都无法抵抗，还怎么像那些可恶的雪精那样感受风雪的伟力啊！"
                },
                {
                    "id": "701290103",
                    "speaker": "布拉金",
                    "text": "再坚持一会儿，丘林、法捷夫！"
                },
                {
                    "id": "701290104",
                    "speaker": "丘林",
                    "text": "呜…"
                },
                {
                    "id": "701290105",
                    "speaker": "法捷夫",
                    "text": "老师、老师说得对！"
                },
                {
                    "id": "701290106",
                    "speaker": "派蒙",
                    "text": "哇，你们在干什么，在这个冰天雪地里…"
                },
                {
                    "id": "701290107",
                    "speaker": "布拉金",
                    "text": "哦，没想到如此偏远寒冷的冰雕工坊还能迎来访客，难道二位也是寻求冰雕舞道的求道者吗？"
                },
                {
                    "id": "701290108",
                    "speaker": "布拉金",
                    "text": "呼呼，金发的这位，即使在这凛冽寒风之中，步伐也没有丝毫的杂乱，想必是了不得的强者啊…"
                },
                {
                    "id": "701290109",
                    "speaker": "派蒙",
                    "text": "这个什么冰雕舞道是什么？臻冰做的跳舞毯吗？"
                },
                {
                    "id": "701290110",
                    "speaker": "布拉金",
                    "text": "看来这位小姐还不是很明白，利用臻冰的技艺以打造冰雕，是至冬独一无二的艺术。"
                },
                {
                    "id": "701290111",
                    "speaker": "布拉金",
                    "text": "雕刻这一行为，也应像跳舞一般优雅。"
                },
                {
                    "id": "701290112",
                    "speaker": "布拉金",
                    "text": "曾几何时，我也曾凭借一手徒手切削臻冰的技法，进入白冕宫，在白沙皇陛下御前表演。"
                },
                {
                    "id": "701290113",
                    "speaker": "布拉金",
                    "text": "可惜，雪孃的王公评价我的雕塑缺少了自然风雪的气息…那位名为帕芙琳娜大人的点评点醒了我…"
                },
                {
                    "id": "701290114",
                    "speaker": "布拉金",
                    "text": "自那以后，我就在此处开辟道场，在寒风中进行雕塑，以寻求更高的境界！"
                },
                {
                    "id": "701290115",
                    "speaker": "派蒙",
                    "text": "哦哦…"
                },
                {
                    "id": "701290116",
                    "speaker": "布拉金",
                    "text": "两位难道不是出于同样的原因来到此处的吗？"
                },
                {
                    "id": "701290117",
                    "speaker": "Player",
                    "text": "我们只是冒险家…"
                },
                {
                    "id": "701290118",
                    "speaker": "布拉金",
                    "text": "竟然…了不起，能够到达此处的冒险家吗…"
                },
                {
                    "id": "701290119",
                    "speaker": "布拉金",
                    "text": "对了，我听我的弟子说，冒险家协会的冒险家们有的时候也会接受委托，是吗，丘林？"
                },
                {
                    "id": "701290120",
                    "speaker": "丘林",
                    "text": "是的…布拉金老师！不过得付出酬劳…"
                },
                {
                    "id": "701290121",
                    "speaker": "布拉金",
                    "text": "区区酬劳我还是能出得起的，这位冒险家，能不能委托您和我们进行比试！"
                },
                {
                    "id": "701290122",
                    "speaker": "派蒙",
                    "text": "比试？比试做…臻冰雕塑？"
                },
                {
                    "id": "701290123",
                    "speaker": "布拉金",
                    "text": "哦，这倒不是，只是进行一些躯体能力的切磋，因为冰雕舞道，也是一种武道…"
                },
                {
                    "id": "701290124",
                    "speaker": "布拉金",
                    "text": "怎么样，要来试试吗？"
                },
                {
                    "id": "701290125",
                    "speaker": "派蒙",
                    "text": "原来还是打架啊…那就放马过来吧，我们可不会怕！"
                }
            ]
        },
        {
            "id": "7012902",
            "objective": "(test)废弃$HIDDEN",
            "dialogues": [
                {
                    "id": "701290201",
                    "speaker": "布拉金",
                    "text": "怎么样，这位了不起的冒险家…愿意和我们这些追求冰雕之道的矮灵们切磋切磋吗？",
                    "choices": [
                        {
                            "id": "701290202",
                            "text": "好啊，放马过来！",
                            "response": [
                                {
                                    "id": "701290203",
                                    "speaker": "布拉金",
                                    "text": "嗯，感谢您愿意出手，这无疑是让我的徒弟见见世面的好机会。"
                                }
                            ]
                        },
                        {
                            "id": "701290204",
                            "text": "不，暂时没这兴致…",
                            "response": [
                                {
                                    "id": "701290205",
                                    "speaker": "布拉金",
                                    "text": "是嘛，强大的冒险家啊…如果您愿意的话，还请跟我说吧。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7012903",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": []
        },
        {
