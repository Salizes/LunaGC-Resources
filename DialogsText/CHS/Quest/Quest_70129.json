        },
        {
            "id": "7012907",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7012908",
            "objective": "(test)废弃$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7012909",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "701290901",
                    "speaker": "布拉金",
                    "text": "了不起啊，冒险家，没想到还能遇到你这样的强者。"
                },
                {
                    "id": "701290902",
                    "speaker": "布拉金",
                    "text": "跟你切磋过后，灵感也如泉水般涌出…了不起…"
                },
                {
                    "id": "701290903",
                    "speaker": "布拉金",
                    "text": "这就是给您的酬劳…哈哈，打上这么一场，感觉筋骨也舒展开，身体也热了起来…"
                },
                {
                    "id": "701290904",
                    "speaker": "布拉金",
                    "text": "不过其实我们当中，丘林其实是最能打的，只不过雕塑水平上他还需要练习…"
                },
                {
                    "id": "701290905",
                    "speaker": "布拉金",
                    "text": "如果你想要和他进行切磋，就尽管找他吧！这对他来说也是好事。"
                }
            ]
        },
        {
            "id": "7012910",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "701291001",
                    "speaker": "法捷夫",
                    "text": "唉…老师，您的办法真的有用吗？"
                },
                {
                    "id": "701291002",
                    "speaker": "法捷夫",
                    "text": "我也没觉得自己做臻冰雕塑的水平有提高…我只觉得自己做雕塑快了很多。"
                },
                {
                    "id": "701291003",
                    "speaker": "布拉金",
                    "text": "这不就是进步吗？"
                },
                {
                    "id": "701291004",
                    "speaker": "法捷夫",
                    "text": "啊？"
                },
                {
                    "id": "701291005",
                    "speaker": "布拉金",
                    "text": "当初老师我就是因为做得快才被叫去白冕宫表演的啊。"
                },
                {
                    "id": "701291006",
                    "speaker": "布拉金",
                    "text": "一尊雕像，瞬间就能做出来，不然怎么表演，让白沙皇陛下坐在那里看一天吗？"
                },
                {
                    "id": "701291007",
                    "speaker": "法捷夫",
                    "text": "原、原来如此…"
                }
            ]
        },
        {
            "id": "7012913",
            "objective": "(test)废弃$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7012911",
            "objective": "(test)废弃$HIDDEN",
            "dialogues": [
                {
                    "id": "701291101",
                    "speaker": "丘林",
                    "text": "嗯…怎么了？冒险家，找我还有什么事吗？",
                    "choices": [
                        {
                            "id": "701291102",
                            "text": "想要再切磋切磋…",
                            "response": [
                                {
                                    "id": "701291103",
                                    "speaker": "丘林",
                                    "text": "好、好吧，老师也说…这样的切磋对我来说有好处。"
                                }
                            ]
                        },
                        {
                            "id": "701291104",
                            "text": "不，没有什么事…",
                            "response": [
                                {
                                    "id": "701291105",
                                    "speaker": "丘林",
                                    "text": "那就…那就不打扰了，我还得完成今天的雕塑呢。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
