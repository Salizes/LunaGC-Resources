    "talks": [
        {
            "id": "7327401",
            "objective": "(test)完成对话$HIDDEN",
            "dialogues": [
                {
                    "id": "732750301",
                    "speaker": "阿凡",
                    "text": "♪…是你啊，来看看，这些花长得不错吧？"
                },
                {
                    "id": "732750302",
                    "speaker": "Player",
                    "text": "种出了金蔷薇花苗。"
                },
                {
                    "id": "732750303",
                    "speaker": "阿凡",
                    "text": "这些…嘿哟，你这小娃娃是在哪里找到这些花种的？"
                },
                {
                    "id": "732750304",
                    "speaker": "Player",
                    "text": "在很远的地方捡到的。"
                },
                {
                    "id": "732750305",
                    "speaker": "阿凡",
                    "text": "沙法卡特叔叔撒下的种子还真是去到了沙漠的各个角落，不过最后兜兜转转又回到这里来喽。"
                },
                {
                    "id": "732750307",
                    "speaker": "阿凡",
                    "text": "这些花苗可得小心保存啊，我都要留给赛芭那孩子的。等到我也不在了，这些花就交给她了。"
                },
                {
                    "id": "732750308",
                    "speaker": "阿凡",
                    "text": "你帮了我老头的大忙，虽然你这孩子没跟我要报酬，但我要是不给心里可过意不去。"
                },
                {
                    "id": "732750309",
                    "speaker": "阿凡",
                    "text": "这株花苗最近刚刚破土，赛芭提议把它送给你，还费心把它装了起来。"
                },
                {
                    "id": "732750310",
                    "speaker": "阿凡",
                    "text": "我们把它当作纪念送给你，希望你像它一样坚韧，永远不丧失信心。"
                }
            ]
        }
    ]
}