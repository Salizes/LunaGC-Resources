    "talks": [
        {
            "id": "7067901",
            "objective": "(test)隐藏任务与吉盖克斯对话$HIDDEN",
            "dialogues": [
                {
                    "id": "706790101",
                    "speaker": "吉盖克斯",
                    "text": "您好，您好！哎呀，真是巧了，咱们又见面啦。",
                    "choices": [
                        {
                            "id": "706790102",
                            "text": "抱歉，你是…",
                            "response": [
                                {
                                    "id": "706790103",
                                    "speaker": "吉盖克斯",
                                    "text": "我是吉盖克斯！风行迷踪，您想起来了吗？"
                                },
                                {
                                    "id": "706790106",
                                    "speaker": "派蒙",
                                    "text": "原来是你呀！"
                                },
                                {
                                    "id": "706790107",
                                    "speaker": "Player",
                                    "text": "完全想起来了！"
                                },
                                {
                                    "id": "706790108",
                                    "speaker": "吉盖克斯",
                                    "text": "您这副表情，完全是没有想起来嘛…"
                                },
                                {
                                    "id": "706790109",
                                    "speaker": "吉盖克斯",
                                    "text": "无论如何，请您看这边。这一副「风行迷踪」您肯定记得。"
                                },
                                {
                                    "id": "706790110",
                                    "speaker": "吉盖克斯",
                                    "text": "您上次帮我试玩了过后，不是也给我提出了很多意见吗？那都是好主意，我基本上都采纳了。"
                                },
                                {
                                    "id": "706790111",
                                    "speaker": "吉盖克斯",
                                    "text": "我对游戏规则和玩法进行了又一次…呃，准确来说是好几次的改进。",
                                    "choices": [
                                        {
                                            "id": "706790112",
                                            "text": "不会很难理解吗？",
                                            "response": [
                                                {
                                                    "id": "706790114",
                                                    "speaker": "吉盖克斯",
                                                    "text": "您放心吧，这些新玩法您肯定会喜欢的，容我为您简单解释一下。"
                                                },
                                                {
                                                    "id": "706790115",
                                                    "speaker": "吉盖克斯",
                                                    "text": "首先，在这副全新的「风行迷踪」里，我首次加入了名为「发信机」的东西。"
                                                },
                                                {
                                                    "id": "706790116",
                                                    "speaker": "吉盖克斯",
                                                    "text": "游侠只要成功启动四个「发信机」，就可以击败猎手，获得胜利！"
                                                },
                                                {
                                                    "id": "706790117",
                                                    "speaker": "吉盖克斯",
                                                    "text": "而猎手要做的事嘛…还是不变，只要把所有游侠抓住，就算他们赢。"
                                                },
                                                {
                                                    "id": "706790118",
                                                    "speaker": "吉盖克斯",
                                                    "text": "但在这次的「风行迷踪」里，游侠被猎手抓住后，不会直接出局，而是会被投入一个叫做「监控地」的地方。"
                                                },
                                                {
                                                    "id": "706790119",
                                                    "speaker": "吉盖克斯",
                                                    "text": "只要过段时间，或者是有其他游侠帮忙，被抓住的人就可以从「监控地」逃脱，继续和猎手周旋啦。"
                                                },
                                                {
                                                    "id": "706790120",
                                                    "speaker": "吉盖克斯",
                                                    "text": "不过，如果被抓住过的人再次被抓住…那就不得不被判出局啦。",
                                                    "choices": [
                                                        {
                                                            "id": "706790121",
                                                            "text": "听起来有点复杂…",
                                                            "response": [
                                                                {
                                                                    "id": "706790123",
                                                                    "speaker": "吉盖克斯",
                                                                    "text": "放心，也就是听起来复杂，只要多玩几局，您就全明白了。",
                                                                    "choices": [
                                                                        {
                                                                            "id": "706790124",
                                                                            "text": "那我来试试。",
                                                                            "response": [
                                                                                {
                                                                                    "id": "706790125",
                                                                                    "speaker": "吉盖克斯",
                                                                                    "text": "好！您来这边…"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "706790126",
                                                                            "text": "还有别的事。",
                                                                            "response": [
                                                                                {
                                                                                    "id": "706790127",
                                                                                    "speaker": "吉盖克斯",
                                                                                    "text": "没事，您有空的时候再来也行，我还会在这待一段时间。"
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "706790122",
                                                            "text": "这么多新规则啊…"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "706790113",
                                            "text": "你没有加入奇怪的玩法吧？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "706790104",
                            "text": "你是…风行迷踪！",
                            "response": [
                                {
                                    "id": "706790105",
                                    "speaker": "吉盖克斯",
                                    "text": "我是吉盖克斯！好吧，您说的也没错，我倒也情愿风行迷踪比我更出名。"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}