    "talks": [
        {
            "id": "7102001",
            "objective": "与小昭对话",
            "dialogues": []
        },
        {
            "id": "7102003",
            "objective": "将单据带给小安",
            "dialogues": [
                {
                    "id": "710202001",
                    "speaker": "小安",
                    "text": "唉，我算了一下，实在不行…我再加把劲。"
                },
                {
                    "id": "710202002",
                    "speaker": "小安",
                    "text": "拼几个晚上不睡觉，把港口船只情况的统计表给统计出来交上去。"
                },
                {
                    "id": "710202003",
                    "speaker": "小安",
                    "text": "毕竟这张表我开始做的时间最早，如果最晚交的话，也确实有点不太像话…"
                }
            ]
        },
        {
            "id": "7102005",
            "objective": "为小安对话打开心情值$HIDDEN",
            "dialogues": [
                {
                    "id": "710201001",
                    "speaker": "小安",
                    "text": "这下可麻烦了…"
                },
                {
                    "id": "710201002",
                    "speaker": "Player",
                    "text": "小昭让我送这个给你…"
                },
                {
                    "id": "710201003",
                    "speaker": "小安",
                    "text": "啊？港口里的船只情况统计表。"
                },
                {
                    "id": "710201004",
                    "speaker": "小安",
                    "text": "这个，怎么说呢，虽然我其实最开始就准备好了…"
                },
                {
                    "id": "710201005",
                    "speaker": "小安",
                    "text": "但是还有新入货物统计表、各种船只报上来的船员情况、出入港口的外国人…"
                },
                {
                    "id": "710201006",
                    "speaker": "小安",
                    "text": "要统计的表实在是太多了，我做了这个，又做那个，压根忙不过来了。"
                }
            ]
        },
        {
            "id": "7102006",
            "objective": "小安A1$HIDDEN",
            "dialogues": [
                {
                    "id": "710201101",
                    "speaker": "Player",
                    "text": "多招点人来帮忙…"
                },
                {
                    "id": "710201102",
                    "speaker": "小安",
                    "text": "我也想啊，但是临时怎么可能招来马上就能帮忙的人…"
                }
            ]
        },
        {
            "id": "7102007",
            "objective": "小安A2$HIDDEN",
            "dialogues": [
                {
                    "id": "710201201",
                    "speaker": "Player",
                    "text": "先把小昭要的表统计了。"
                },
                {
                    "id": "710201202",
                    "speaker": "小安",
                    "text": "哈哈哈，我今天记起来的时候已经来不及了…"
                }
            ]
        },
        {
            "id": "7102008",
            "objective": "小安A3$HIDDEN",
            "dialogues": [
                {
                    "id": "710201301",
                    "speaker": "Player",
                    "text": "先统计最重要的吧。"
                },
                {
                    "id": "710201302",
                    "speaker": "小安",
                    "text": "这些表在我看来，呃…都差不多重要。"
                }
            ]
        },
        {
            "id": "7102009",
            "objective": "小安B1$HIDDEN",
            "dialogues": [
                {
                    "id": "710201401",
                    "speaker": "Player",
                    "text": "时间不够了…"
                },
                {
                    "id": "710201402",
                    "speaker": "小安",
                    "text": "我知道啊，所以我在努力，看能不能把所有的表格全部统计完毕。"
                }
            ]
        },
        {
            "id": "7102010",
            "objective": "小安B2$HIDDEN",
            "dialogues": [
                {
                    "id": "710201501",
                    "speaker": "Player",
                    "text": "不如直接去说明…"
                },
                {
                    "id": "710201502",
                    "speaker": "小安",
                    "text": "有那个时间，我不如再多努力统计好一些表格…"
                }
            ]
        },
        {
            "id": "7102011",
            "objective": "小安B3$HIDDEN",
            "dialogues": [
                {
                    "id": "710201601",
                    "speaker": "Player",
                    "text": "我来帮你。"
                },
                {
                    "id": "710201602",
                    "speaker": "小安",
                    "text": "谢谢你的好意，但是统计表格这个活，不是熟手的话只会帮倒忙。"
                }
            ]
        },
        {
            "id": "7102012",
            "objective": "小安C1$HIDDEN",
            "dialogues": [
                {
                    "id": "710201701",
                    "speaker": "Player",
                    "text": "还要延期吗？"
                },
                {
                    "id": "710201702",
                    "speaker": "小安",
                    "text": "我努努力吧，尽量不再延期了，但是看我手上的这些工作，哈哈…说实话，挺难的。"
                }
            ]
        },
        {
            "id": "7102013",
            "objective": "小安C2$HIDDEN",
            "dialogues": [
                {
                    "id": "710201801",
                    "speaker": "Player",
                    "text": "那你只能自己想办法了…"
                },
                {
                    "id": "710201802",
                    "speaker": "小安",
                    "text": "我知道啊，我自己的工作，难道还能指望别人吗？"
                }
            ]
        },
        {
            "id": "7102014",
            "objective": "小安C3$HIDDEN",
            "dialogues": [
                {
                    "id": "710201901",
                    "speaker": "Player",
                    "text": "下次先划分优先级。"
                },
                {
                    "id": "710201902",
                    "speaker": "小安",
                    "text": "哈哈哈，每次我都这么想，但每次工作一多我就开始手忙脚乱，分优先级的事不知道忘到哪去了。"
                }
            ]
        },
        {
            "id": "7102030",
            "objective": "小安衔接$HIDDEN",
            "dialogues": [
                {
                    "id": "710203001",
                    "speaker": "小昭",
                    "text": "这么多单子结不了…"
                }
            ]
        },
        {
            "id": "7102015",
            "objective": "小安判定心情值$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7102002",
            "objective": "将单据带给江舟",
            "dialogues": [
                {
                    "id": "710205001",
                    "speaker": "江舟",
                    "text": "嗯…好吧，最后给我一点时间，我最后补全一些小问题。"
                },
                {
                    "id": "710205002",
                    "speaker": "江舟",
                    "text": "等我补全了之后，我就把策划案总结一下交上去了。"
                },
                {
                    "id": "710205003",
                    "speaker": "江舟",
                    "text": "希望璃月港的大家会喜欢这一届海灯节…"
                }
            ]
        },
        {
            "id": "7102016",
            "objective": "为江舟对话打开心情值$HIDDEN",
            "dialogues": [
                {
                    "id": "710204001",
                    "speaker": "江舟",
                    "text": "这样还不行…还得改改…"
                },
                {
                    "id": "710204002",
                    "speaker": "Player",
                    "text": "小昭让我送这个给你…"
                },
                {
                    "id": "710204003",
                    "speaker": "江舟",
                    "text": "嗯？关于下届海灯节的策划案…"
                },
                {
                    "id": "710204004",
                    "speaker": "江舟",
                    "text": "这个啊，我正在写了，可是一直觉得遗漏了什么地方，所以一直在修改。"
                },
                {
                    "id": "710204005",
                    "speaker": "江舟",
                    "text": "海灯节这种重大节日，当然要尽善尽美啊，所以…这个策划案还交不上去啦。"
                }
            ]
        },
        {
            "id": "7102017",
            "objective": "江舟A1$HIDDEN",
            "dialogues": [
                {
                    "id": "710204101",
                    "speaker": "Player",
                    "text": "时间要来不及了…"
                },
                {
                    "id": "710204102",
                    "speaker": "江舟",
                    "text": "我一定会整理出最好的方案的，只要再给我点时间…"
                }
            ]
        },
        {
            "id": "7102018",
            "objective": "江舟A2$HIDDEN",
            "dialogues": [
                {
                    "id": "710204201",
                    "speaker": "Player",
                    "text": "先交上去吧。"
                },
                {
                    "id": "710204202",
                    "speaker": "江舟",
                    "text": "这怎么行，怎么能交一份随随便便的方案上去？这可是璃月最重要的节日啊。"
                }
            ]
        },
        {
            "id": "7102019",
            "objective": "江舟A3$HIDDEN",
            "dialogues": [
                {
                    "id": "710204301",
                    "speaker": "Player",
                    "text": "不会有完美的方案。"
                },
                {
                    "id": "710204302",
                    "speaker": "江舟",
                    "text": "虽然话是这么说，但也要向完美努努力吧。"
                }
            ]
        },
        {
            "id": "7102020",
            "objective": "江舟B1$HIDDEN",
            "dialogues": [
                {
                    "id": "710204401",
                    "speaker": "Player",
                    "text": "有方案总比没有好。"
                },
                {
                    "id": "710204402",
                    "speaker": "江舟",
                    "text": "话是这么说，但总不能交一份有问题的方案出去吧…"
                }
            ]
        },
        {
            "id": "7102021",
            "objective": "江舟B2$HIDDEN",
            "dialogues": [
                {
                    "id": "710204501",
                    "speaker": "Player",
                    "text": "你的方案没问题的。"
                },
                {
                    "id": "710204502",
                    "speaker": "江舟",
                    "text": "嗯…你说得也有道理，但至少容我再完善一下。"
                }
            ]
        },
        {
            "id": "7102022",
            "objective": "江舟B3$HIDDEN",
            "dialogues": [
                {
                    "id": "710204601",
                    "speaker": "Player",
                    "text": "可以先交再改…"
                },
                {
                    "id": "710204602",
                    "speaker": "江舟",
                    "text": "别开玩笑了，海灯节可不是这么随随便便的节日。"
                }
            ]
        },
        {
            "id": "7102023",
            "objective": "江舟C1$HIDDEN",
            "dialogues": [
                {
                    "id": "710204701",
                    "speaker": "Player",
                    "text": "参考上届海灯节…"
                },
                {
                    "id": "710204702",
                    "speaker": "江舟",
                    "text": "我就是参考上届海灯节，虽然上一届市民们很喜欢，但是…我还是想要做出一点突破。"
                }
            ]
        },
        {
            "id": "7102024",
            "objective": "江舟C2$HIDDEN",
            "dialogues": [
                {
                    "id": "710204801",
                    "speaker": "Player",
                    "text": "相信自己…"
                },
                {
                    "id": "710204802",
                    "speaker": "江舟",
                    "text": "相信自己有什么用，市民们不喜欢的话就全完了。"
                }
            ]
        },
        {
            "id": "7102025",
            "objective": "江舟C3$HIDDEN",
            "dialogues": [
                {
                    "id": "710204901",
                    "speaker": "Player",
                    "text": "那你再好好想想？"
                },
                {
                    "id": "710204902",
                    "speaker": "江舟",
                    "text": "嗯！再给我一点时间，我一定能想出完美的方案。"
                }
            ]
        },
