    },
    "talks": [
        {
            "id": "7268201",
            "objective": "与茅葺对话",
            "dialogues": [
                {
                    "id": "726820101",
                    "speaker": "茅葺一庆",
                    "text": "嗨！那边那位金发异乡人…",
                    "choices": [
                        {
                            "id": "726820102",
                            "text": "又见面了。",
                            "response": [
                                {
                                    "id": "726820104",
                                    "speaker": "茅葺一庆",
                                    "text": "嗯…你这头金发，越看越眼熟…难道是…"
                                },
                                {
                                    "id": "726820105",
                                    "speaker": "茅葺一庆",
                                    "text": "啊，对了！是上次「百人一揆」中，表现无比亮眼的「黄金旋风」…"
                                },
                                {
                                    "id": "726820106",
                                    "speaker": "Player",
                                    "text": "黄、黄金旋风…？"
                                },
                                {
                                    "id": "726820107",
                                    "speaker": "茅葺一庆",
                                    "text": "上次，我在乱斗的场馆一隅，观察着参加者的活跃表现，想将其中最为精彩的场面收为素材。而你战斗的身姿，如刈草的黄金之风一般，横扫各路敌手…",
                                    "choices": [
                                        {
                                            "id": "726820108",
                                            "text": "奉承的话就免了。",
                                            "response": [
                                                {
                                                    "id": "726820113",
                                                    "speaker": "茅葺一庆",
                                                    "text": "无论如何，最近又有好事之徒举办「百人一揆」了。",
                                                    "choices": [
                                                        {
                                                            "id": "726820114",
                                                            "text": "「百人一揆」是什么来着？",
                                                            "response": [
                                                                {
                                                                    "id": "726820115",
                                                                    "speaker": "茅葺一庆",
                                                                    "text": "通过酣畅淋漓的打斗，来进行庆祝、或者消除晦气的乱斗大会。无论是武人还是魔物，都能摈弃成见不问身份，在其中为了纯粹的热血而混战的祭典。"
                                                                },
                                                                {
                                                                    "id": "726820116",
                                                                    "speaker": "茅葺一庆",
                                                                    "text": "在其中脱颖而出者，据说也能得到各种宝藏。"
                                                                },
                                                                {
                                                                    "id": "726820117",
                                                                    "speaker": "茅葺一庆",
                                                                    "text": "虽然举办者、赞助者究竟是何许人也，至今都是谜团就是了。"
                                                                },
                                                                {
                                                                    "id": "726820119",
                                                                    "speaker": "茅葺一庆",
                                                                    "text": "总之，这些事情不适合在人多口杂的地方讨论。跟我来…"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "726820118",
                                                            "text": "原来如此，我明白了。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "726820109",
                                            "text": "…再多说点？",
                                            "response": [
                                                {
                                                    "id": "726820110",
                                                    "speaker": "茅葺一庆",
                                                    "text": "咳咳…「想必观众当中拥有剑豪般动态视力的人已经看出来了，这位金发异人所使用的正是在古武术中也被视为禁忌的『苟兰茄大龙卷』…！」"
                                                },
                                                {
                                                    "id": "726820111",
                                                    "speaker": "Player",
                                                    "text": "？"
                                                },
                                                {
                                                    "id": "726820112",
                                                    "speaker": "茅葺一庆",
                                                    "text": "这是受你战斗的身影启发，而写的情节。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "726820103",
                            "text": "有什么委托吗？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7268202",
            "objective": "与茅葺对话",
            "dialogues": [
                {
                    "id": "726820201",
                    "speaker": "茅葺一庆",
                    "text": "我们到了。"
                },
                {
                    "id": "726820202",
                    "speaker": "茅葺一庆",
                    "text": "只要踏入这扇看起来十分可疑的大门，就能进入这回的战斗场馆。",
                    "choices": [
                        {
                            "id": "726820203",
                            "text": "好兴奋。",
                            "response": [
                                {
                                    "id": "726820205",
                                    "speaker": "茅葺一庆",
                                    "text": "这次的规则和上次应该差不多。来自世界各地，渴求争斗的魔物、冒险者、战士，在它的舞台上酣畅淋漓地大打出手。"
                                },
                                {
                                    "id": "726820206",
                                    "speaker": "茅葺一庆",
                                    "text": "与之前一样，你可以和志同道合的同伴、战友一起去参战。毕竟，所谓「百人」，自然是人数越多越好啦。"
                                },
                                {
                                    "id": "726820207",
                                    "speaker": "茅葺一庆",
                                    "text": "我很期待你的表现。"
                                },
                                {
                                    "id": "726820208",
                                    "speaker": "Player",
                                    "text": "这次你也不参加吗？"
                                },
                                {
                                    "id": "726820209",
                                    "speaker": "茅葺一庆",
                                    "text": "我吗？我会以旁观者的身份参与，为你喝彩。"
                                },
                                {
                                    "id": "726820210",
                                    "speaker": "茅葺一庆",
                                    "text": "毕竟，我的目标还是写出最精彩的格斗小说，而不是成为像你这样耀眼的战士。"
                                },
                                {
                                    "id": "726820211",
                                    "speaker": "茅葺一庆",
                                    "text": "而我的直觉告诉我，你一定会是格斗场上最耀眼的明星。",
                                    "choices": [
                                        {
                                            "id": "726820212",
                                            "text": "我会尽力。",
                                            "response": [
                                                {
                                                    "id": "726820214",
                                                    "speaker": "茅葺一庆",
                                                    "text": "嗯。想必这次你也能展现出耀眼无比的剑之舞吧。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "726820213",
                                            "text": "拭目以待吧。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "726820204",
                            "text": "好麻烦。"
                        }
                    ]
                }
            ]
        }
    ]
}