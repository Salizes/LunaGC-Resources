    "talks": [
        {
            "id": "7266201",
            "objective": "与鲸井椛对话",
            "dialogues": [
                {
                    "id": "726620101",
                    "speaker": "鲸井椛",
                    "text": "你们来看！我又翻了一遍父亲的航海日志。"
                },
                {
                    "id": "726620102",
                    "speaker": "鲸井椛",
                    "text": "里面有一份附录，提到了他们曾经开发过的特殊鱼饵配方。"
                },
                {
                    "id": "726620103",
                    "speaker": "鲸井椛",
                    "text": "他们遇见「海中月」那次，使用了一种混合了海草与魔晶矿的特殊鱼饵。"
                },
                {
                    "id": "726620104",
                    "speaker": "鲸井椛",
                    "text": "如果我们也能做出这个，或许能够吸引到「海中月」。"
                },
                {
                    "id": "726620105",
                    "speaker": "鲸井椛",
                    "text": "海草我倒是有很多，只是魔晶矿…"
                },
                {
                    "id": "726620106",
                    "speaker": "Player",
                    "text": "别担心，我这里有。"
                },
                {
                    "id": "726620107",
                    "speaker": "鲸井椛",
                    "text": "欸？真的吗？是在荒海那边开采的吗？"
                },
                {
                    "id": "726620108",
                    "speaker": "鲸井椛",
                    "text": "父亲的日志中有提到，魔晶矿一定要在荒海那边的废墟里发掘。"
                },
                {
                    "id": "726620109",
                    "speaker": "鲸井椛",
                    "text": "虽然不清楚和普通的魔晶矿有什么区别，但是既然已经决定要这么做了，我们还是严谨一些，遵循书训比较好。"
                },
                {
                    "id": "726620110",
                    "speaker": "鲸井椛",
                    "text": "说起来，荒海那边有很多魔物，很危险。我们去冒险家协会挂一个委托吧。"
                },
                {
                    "id": "726620111",
                    "speaker": "Player",
                    "text": "不用，我来搞定。"
                },
                {
                    "id": "726620112",
                    "speaker": "鲸井椛",
                    "text": "啊…对了，我都忘了你本来就是个强大的冒险家了！"
                },
                {
                    "id": "726620113",
                    "speaker": "鲸井椛",
                    "text": "有你帮忙实在是太幸运了，那就拜托你了！"
                },
                {
                    "id": "726620114",
                    "speaker": "鲸井椛",
                    "text": "我先回去取一些制饵工具，稍后我们在荒海西侧的沙滩那儿汇合吧。"
                }
            ]
        },
        {
            "id": "7266202",
            "objective": "前往荒海附近寻找特殊的魔晶矿",
            "dialogues": [
                {
                    "id": "726620201",
                    "speaker": "鲸井椛",
                    "text": "这么快就找到了吗？不愧是强大的冒险家啊！"
                },
                {
                    "id": "726620202",
                    "speaker": "Player",
                    "text": "这些够吗？"
                },
                {
                    "id": "726620203",
                    "speaker": "鲸井椛",
                    "text": "嗯，接下来看我的吧，只要这样…这样…再这样…"
                },
                {
                    "id": "726620204",
                    "speaker": "鲸井椛",
                    "text": "做好了，就是这些了。"
                },
                {
                    "id": "726620205",
                    "speaker": "派蒙",
                    "text": "接下来要做的就是把鱼饵撒下去，然后等着「海中月」出现了吧？"
                },
                {
                    "id": "726620206",
                    "speaker": "鲸井椛",
                    "text": "嗯，我特意选了这个地方，当年我们就是从这里上岸的。"
                },
                {
                    "id": "726620207",
                    "speaker": "鲸井椛",
                    "text": "那条指引我们返航的「海中月」，也是在这里消失的。"
                },
                {
                    "id": "726620208",
                    "speaker": "鲸井椛",
                    "text": "所以，大家准备好了吗？见到「海中月」可别忘了许愿哦。"
                },
                {
                    "id": "726620209",
                    "speaker": "Player",
                    "text": "如果没有成功怎么办？"
                },
                {
                    "id": "726620210",
                    "speaker": "鲸井椛",
                    "text": "……"
                },
                {
                    "id": "726620211",
                    "speaker": "鲸井椛",
                    "text": "别说丧气话，会成功的，「海中月」一定会来的。"
                },
                {
                    "id": "726620212",
                    "speaker": "派蒙",
                    "text": "嗯！会成功的！大鱼大鱼，你一定要乖乖上钩呀！拜托你了！"
                },
                {
                    "id": "726620213",
                    "speaker": "鲸井椛",
                    "text": "你们看！你们快看！水下在发光！有什么过来了！"
                },
                {
                    "id": "726620214",
                    "speaker": "派蒙",
                    "text": "真的吗？真的是「海中月」来了吗？"
                },
                {
                    "id": "726620215",
                    "speaker": "派蒙",
                    "text": "呜哇——遗迹守卫！"
                },
                {
                    "id": "726620216",
                    "speaker": "派蒙",
                    "text": "怎么会是这家伙！"
                }
            ]
        },
        {
            "id": "7266203",
            "objective": "收集3块特殊的魔晶矿",
            "dialogues": [
                {
                    "id": "726620301",
                    "speaker": "鲸井椛",
                    "text": "怎么…怎么会这样，连父亲的鱼饵配方也没有用吗？"
                },
                {
                    "id": "726620302",
                    "speaker": "派蒙",
                    "text": "不要难过，都怪那个遗迹守卫！一定是它把「海中月」吓跑了！我们再试试吧！"
                },
                {
                    "id": "726620303",
                    "speaker": "Player",
                    "text": "嗯，要不我们再试试。"
                },
                {
                    "id": "726620304",
                    "speaker": "鲸井椛",
                    "text": "……"
                },
                {
                    "id": "726620305",
                    "speaker": "鲸井椛",
                    "text": "……"
                },
                {
                    "id": "726620306",
                    "speaker": "鲸井椛",
                    "text": "先算了吧，我有点累了。或许楠塔克是对的？"
                },
                {
                    "id": "726620307",
                    "speaker": "鲸井椛",
                    "text": "唉…我现在想去外面散散心，我得好好想想之后的事。"
                },
                {
                    "id": "726620308",
                    "speaker": "鲸井椛",
                    "text": "这些是报酬，不管怎么说，还是非常感谢你们的帮助。"
                },
                {
                    "id": "726620309",
                    "speaker": "派蒙",
                    "text": "看来鲸井小姐现在想要一个人静静呢，我们过一阵子再来看看她吧。"
                }
            ]
        },
