    "talks": [
        {
            "id": "7521901",
            "objective": "(test)相框礼物-女主已做水神线$HIDDEN",
            "dialogues": [
                {
                    "id": "752190101",
                    "speaker": "胡奇鲁",
                    "text": "#啊…那边的，是{NICKNAME}吧，还请留步！"
                },
                {
                    "id": "752190102",
                    "speaker": "胡奇鲁",
                    "text": "这里有…"
                },
                {
                    "id": "752190103",
                    "speaker": "派蒙",
                    "text": "哦，怎么了？有什么需要帮忙的事吗？"
                },
                {
                    "id": "752190104",
                    "speaker": "胡奇鲁",
                    "text": "哈哈，不是，是你们有一封快件，真是凑巧，我正想着要去哪里找你们呢…"
                },
                {
                    "id": "752190105",
                    "speaker": "胡奇鲁",
                    "text": "你们就出现在我面前了。"
                },
                {
                    "id": "752190106",
                    "speaker": "派蒙",
                    "text": "咦，是谁寄过来的呀？"
                },
                {
                    "id": "752190107",
                    "speaker": "胡奇鲁",
                    "text": "说到这个，这可是长途跋涉来到这里的快件啊，辗转了很多手，才从冒险家协会转到悬木人的讯使这里…"
                },
                {
                    "id": "752190108",
                    "speaker": "胡奇鲁",
                    "text": "毕竟纳塔最近的情况比较特殊，正常的商队往来都搁置了好一段时间，没写寄件人，不过看落款…似乎是从枫丹来的。"
                },
                {
                    "id": "752190109",
                    "speaker": "胡奇鲁",
                    "text": "看来你们在枫丹也有不少朋友啊。",
                    "choices": [
                        {
                            "id": "752190110",
                            "text": "那我就收下了。",
                            "response": [
                                {
                                    "id": "752190112",
                                    "speaker": "胡奇鲁",
                                    "text": "嗯，真是火神保佑，刚拿到的快件就找到了收货人，今天的工作有了个好的开头啊。"
                                },
                                {
                                    "id": "752190113",
                                    "speaker": "胡奇鲁",
                                    "text": "好了，我接下来要去送其他东西了，祝你们今天也一切顺利！"
                                },
                                {
                                    "id": "752190114",
                                    "speaker": "派蒙",
                                    "text": "好哦，你也工作顺利！"
                                },
                                {
                                    "id": "752190115",
                                    "speaker": "派蒙",
                                    "text": "唔，是枫丹来的，看上去轻飘飘的，与其说是快件，看上去就像是一封信。"
                                },
                                {
                                    "id": "752190116",
                                    "speaker": "派蒙",
                                    "text": "我们快拆开来看看吧！"
                                },
                                {
                                    "id": "752190117",
                                    "speaker": "派蒙",
                                    "text": "啊，原来是夏洛蒂寄过来的，唔，原来是离开枫丹的时候拍摄的画片呀…"
                                },
                                {
                                    "id": "752190118",
                                    "speaker": "派蒙",
                                    "text": "明明离拍这张画片的时候还没有多久，可是又觉得已经隔了很长很长的时间了呢。"
                                },
                                {
                                    "id": "752190119",
                                    "speaker": "派蒙",
                                    "text": "嘿嘿，我们这就把这张画片好好收起来吧！"
                                }
                            ]
                        },
                        {
                            "id": "752190111",
                            "text": "嗯，交给我吧！"
                        }
                    ]
                }
            ]
        }
    ]
}