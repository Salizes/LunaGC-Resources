    "talks": [
        {
            "id": "7272701",
            "objective": "与茅葺对话",
            "dialogues": [
                {
                    "id": "727270101",
                    "speaker": "茅葺一庆",
                    "text": "嗨！那边那位异乡的武者！",
                    "choices": [
                        {
                            "id": "727270102",
                            "text": "又见面了。",
                            "response": [
                                {
                                    "id": "727270103",
                                    "speaker": "茅葺一庆",
                                    "text": "是啊，又见面了！你的身影，果然还是像从前一样耀眼…"
                                },
                                {
                                    "id": "727270106",
                                    "speaker": "茅葺一庆",
                                    "text": "…咳，总而言之，这几天，似乎又有人在秘密举办「百人一揆」了。",
                                    "choices": [
                                        {
                                            "id": "727270107",
                                            "text": "「百人一揆」是什么来着？",
                                            "response": [
                                                {
                                                    "id": "727270108",
                                                    "speaker": "茅葺一庆",
                                                    "text": "「百人一揆」最初是由「天狗党人」们举办的祭典，通过酣畅淋漓的乱斗，来庆祝值得纪念的喜事、或是排解失落的心情。"
                                                },
                                                {
                                                    "id": "727270109",
                                                    "speaker": "茅葺一庆",
                                                    "text": "祭典上，无论是武者还是魔物，都能摈弃成见、不问身份，为了纯粹的热血而混战。"
                                                },
                                                {
                                                    "id": "727270110",
                                                    "speaker": "茅葺一庆",
                                                    "text": "据说，在祭典中脱颖而出的武者，还可以赢得各种各样的财宝…"
                                                },
                                                {
                                                    "id": "727270111",
                                                    "speaker": "茅葺一庆",
                                                    "text": "…话虽如此，「天狗党」已经被取缔的情况下，究竟是什么人在举办祭典、胜者的奖品又是从何而来，我也不太清楚。"
                                                },
                                                {
                                                    "id": "727270115",
                                                    "speaker": "茅葺一庆",
                                                    "text": "总之，这里人多眼杂，不太适合讨论这些事情。还是老样子，请跟我来…"
                                                },
                                                {
                                                    "id": "727270116",
                                                    "speaker": "Black Screen",
                                                    "text": "茅葺一庆将你带到了稻妻城外的小岛上…"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "727270112",
                                            "text": "…又来？",
                                            "response": [
                                                {
                                                    "id": "727270113",
                                                    "speaker": "茅葺一庆",
                                                    "text": "是啊，也许是你战斗时的英姿吸引了更多人，就连观众们也看得热血沸腾、跃跃欲试，想要亲自参加祭典吧。"
                                                },
                                                {
                                                    "id": "727270114",
                                                    "speaker": "茅葺一庆",
                                                    "text": "实话说，我也没想到，这次的「百人一揆」会来得这么快…"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "727270104",
                            "text": "…你是？",
                            "response": [
                                {
                                    "id": "727270105",
                                    "speaker": "茅葺一庆",
                                    "text": "不记得我了吗？…啊，抱歉，上次「百人一揆」的时候，我可能光顾着记录你战斗时的英姿了，没怎么大声喝彩…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7272702",
            "objective": "与茅葺对话",
            "dialogues": [
                {
                    "id": "727270201",
                    "speaker": "茅葺一庆",
                    "text": "到了，就是这里。"
                },
                {
                    "id": "727270202",
                    "speaker": "茅葺一庆",
                    "text": "还是老规矩，只要踏入这扇看起来十分可疑的大门，就能进入这回的战斗场馆。",
                    "choices": [
                        {
                            "id": "727270203",
                            "text": "…这次也十分可疑呢。",
                            "response": [
                                {
                                    "id": "727270207",
                                    "speaker": "茅葺一庆",
                                    "text": "总之，这次我也会记录下你战斗时的英姿、为你高声喝彩的。",
                                    "choices": [
                                        {
                                            "id": "727270208",
                                            "text": "好，我已经迫不及待了。",
                                            "response": [
                                                {
                                                    "id": "727270210",
                                                    "speaker": "茅葺一庆",
                                                    "text": "嗯，这次也请让我见证你闪耀的剑之舞吧！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "727270209",
                                            "text": "总觉得好麻烦…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "727270204",
                            "text": "「百人一揆」的规则是？",
                            "response": [
                                {
                                    "id": "727270205",
                                    "speaker": "茅葺一庆",
                                    "text": "这次的规则和上次差不多。渴求争斗的魔物、冒险者与武者，会从提瓦特各地赶来，在祭典的舞台上，酣畅淋漓地大打出手。"
                                },
                                {
                                    "id": "727270206",
                                    "speaker": "茅葺一庆",
                                    "text": "当然，与之前一样，你可以和志同道合的伙伴或战友一起参战。毕竟，所谓「百人」一揆，自然是人数越多越好啦。"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}