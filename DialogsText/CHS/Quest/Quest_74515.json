    "talks": [
        {
            "id": "7451501",
            "objective": "",
            "dialogues": [
                {
                    "id": "745150101",
                    "speaker": "胡塞尼",
                    "text": "#欸？是{NICKNAME}和派蒙？太好了，你们出现的正是时候！我正准备去冒险家协会发布委托呢！"
                },
                {
                    "id": "745150102",
                    "speaker": "派蒙",
                    "text": "#竟然有送上门来的委托？好哎，{NICKNAME}今晚我们可以吃大餐了！"
                },
                {
                    "id": "745150103",
                    "speaker": "Player",
                    "text": "咳咳，派蒙…"
                },
                {
                    "id": "745150104",
                    "speaker": "派蒙",
                    "text": "啊…我是说，作为知名冒险家，我们对出场费可是有一定要求的哦。"
                },
                {
                    "id": "745150105",
                    "speaker": "胡塞尼",
                    "text": "报酬的事情你们不必担心。只要你们像以前那样负责好具体的实验模块，报酬绝对管够！"
                },
                {
                    "id": "745150106",
                    "speaker": "派蒙",
                    "text": "像、像以前那样？唔——那个…这位先生，我们以前见过吗？"
                },
                {
                    "id": "745150107",
                    "speaker": "胡塞尼",
                    "text": "唉…你们又把我忘了吗？是我啊，须弥的教令院学者胡塞尼，我们明明都合作过那么多次了…"
                },
                {
                    "id": "745150108",
                    "speaker": "派蒙",
                    "text": "对、对不起，完全没有印象…"
                },
                {
                    "id": "745150109",
                    "speaker": "胡塞尼",
                    "text": "那「导能原盘」呢，总该有些记忆吧。",
                    "choices": [
                        {
                            "id": "745150110",
                            "text": "难道是「圆盘人」？",
                            "response": [
                                {
                                    "id": "745150113",
                                    "speaker": "派蒙",
                                    "text": "「圆盘人」——？哦，我想起来了，是之前在离岛和层岩巨渊见过的那位！"
                                },
                                {
                                    "id": "745150114",
                                    "speaker": "派蒙",
                                    "text": "你变化好大，唔——感觉变得阳光了不少，怪不得一下子认不出来了呢。"
                                },
                                {
                                    "id": "745150115",
                                    "speaker": "胡塞尼",
                                    "text": "呵呵，有么？那应该是因为我现在太开心了吧，说实话，我已经好久没这么走运过了。"
                                },
                                {
                                    "id": "745150116",
                                    "speaker": "派蒙",
                                    "text": "哇！发生了什么好事啊？也讲给我们听听！"
                                },
                                {
                                    "id": "745150117",
                                    "speaker": "胡塞尼",
                                    "text": "这就说来话长了，话说在上次分别之后，我直接就回到了「教令院」，并根据收集到的数据提出了人造导能原盘的设想。"
                                },
                                {
                                    "id": "745150118",
                                    "speaker": "胡塞尼",
                                    "text": "在看到立项书的第一刻，导师他神情十分激动，当场给予了立项书以「高度的赞扬」，然后就…"
                                },
                                {
                                    "id": "745150119",
                                    "speaker": "派蒙",
                                    "text": "然后就…？"
                                },
                                {
                                    "id": "745150120",
                                    "speaker": "胡塞尼",
                                    "text": "然后他就把我赶出了须弥，让我在枫丹替他跑腿。"
                                },
                                {
                                    "id": "745150121",
                                    "speaker": "派蒙",
                                    "text": "啊？为什么？不是夸奖么？"
                                },
                                {
                                    "id": "745150122",
                                    "speaker": "胡塞尼",
                                    "text": "他夸我十分勇敢，竟然敢把幻想文学当做立项书提交给他。"
                                },
                                {
                                    "id": "745150123",
                                    "speaker": "派蒙",
                                    "text": "这怎么看都不是夸奖吧…"
                                },
                                {
                                    "id": "745150124",
                                    "speaker": "胡塞尼",
                                    "text": "的确，我也因此心灰意冷了一阵子。不过幸运的是，我在枫丹遇到了不错的合伙人和投资方，他们一眼就看上了我的项目。"
                                },
                                {
                                    "id": "745150125",
                                    "speaker": "胡塞尼",
                                    "text": "在他们的协助下，我成功地将之前的研究与枫丹的技术相融合，制造出了人造导能原盘的原型机，也就是「胡塞尼原盘」。"
                                },
                                {
                                    "id": "745150126",
                                    "speaker": "胡塞尼",
                                    "text": "只要「胡塞尼原盘」按照我的计算中的那样通过实验，别说智慧之神的考验，就连成为贤者都不是没有可能。"
                                },
                                {
                                    "id": "745150127",
                                    "speaker": "Player",
                                    "text": "你竟然还没有毕业啊？"
                                },
                                {
                                    "id": "745150128",
                                    "speaker": "胡塞尼",
                                    "text": "咳咳，不要在意这种没有意义的混淆变量，这不过是我通往成功之路的一点小波折而已。"
                                },
                                {
                                    "id": "745150129",
                                    "speaker": "胡塞尼",
                                    "text": "现在最重要的，就是验证「胡塞尼原盘」的具体表现，为此我需要召集志愿者在秘境中使用并对它进行验证。"
                                },
                                {
                                    "id": "745150130",
                                    "speaker": "胡塞尼",
                                    "text": "#那么{NICKNAME}，我想请问，你愿不愿以志愿者的身份参加这次对「胡塞尼原盘」的实验工作呢？",
                                    "choices": [
                                        {
                                            "id": "745150131",
                                            "text": "简单来说，就是用它战斗吧。",
                                            "response": [
                                                {
                                                    "id": "745150132",
                                                    "speaker": "胡塞尼",
                                                    "text": "嗯，没错。我相信你的战斗能力，但现在的「胡塞尼原盘」还尚未达到它的设计预期，请注意安全。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "745150133",
                                            "text": "好的，交给我吧！",
                                            "response": [
                                                {
                                                    "id": "745150134",
                                                    "speaker": "胡塞尼",
                                                    "text": "#{NICKNAME}，我相信你的战斗能力，但现在的「胡塞尼原盘」还尚未达到它的设计预期，请注意安全。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "745150111",
                            "text": "好像也没有…",
                            "response": [
                                {
                                    "id": "745150112",
                                    "speaker": "胡塞尼",
                                    "text": "那「圆盘人」呢？这个称号你们总该有印象了吧。"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}