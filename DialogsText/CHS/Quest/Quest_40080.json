    "talks": [
        {
            "id": "4008001",
            "objective": "等到两天后",
            "dialogues": []
        },
        {
            "id": "4008002",
            "objective": "前往西风骑士团",
            "dialogues": [
                {
                    "id": "400800201",
                    "speaker": "派蒙",
                    "text": "也不知道雷泽那边，「补课」的进展是不是顺利…"
                },
                {
                    "id": "400800202",
                    "speaker": "诺艾尔",
                    "text": "砂糖小姐，请等一下！"
                },
                {
                    "id": "400800203",
                    "speaker": "诺艾尔",
                    "text": "#{NICKNAME}前辈，派蒙，请帮我拦住她！"
                },
                {
                    "id": "400800204",
                    "speaker": "派蒙",
                    "text": "哇，吓我一跳！"
                },
                {
                    "id": "400800205",
                    "speaker": "派蒙",
                    "text": "你们两个，怎么慌慌张张的？"
                },
                {
                    "id": "400800206",
                    "speaker": "诺艾尔",
                    "text": "是这样的，我和砂糖小姐说好要一起把酿酒材料交给你们，可她一听说雷泽也要来，说什么都不肯留在这里。"
                },
                {
                    "id": "400800207",
                    "speaker": "砂糖",
                    "text": "我…我不擅长和陌生人打交道，只要材料能平安送到就可以了…"
                },
                {
                    "id": "400800208",
                    "speaker": "诺艾尔",
                    "text": "这怎么行呢！既然是我们两人合作完成的，就应该一起出面。我不能抢了砂糖小姐的功劳。"
                },
                {
                    "id": "400800209",
                    "speaker": "砂糖",
                    "text": "不是…功劳什么的…"
                },
                {
                    "id": "400800210",
                    "speaker": "派蒙",
                    "text": "这么看来，骑士团准备的材料是「生物炼金」的产物咯？"
                },
                {
                    "id": "400800211",
                    "speaker": "诺艾尔",
                    "text": "对，是「四倍甜日落果」。"
                },
                {
                    "id": "400800212",
                    "speaker": "派蒙",
                    "text": "四倍甜？普通的甜度还不够吗？"
                },
                {
                    "id": "400800213",
                    "speaker": "派蒙",
                    "text": "而且…为什么是日落果？"
                },
                {
                    "id": "400800214",
                    "speaker": "诺艾尔",
                    "text": "嗯，这就要从头说起了。"
                },
                {
                    "id": "400800215",
                    "speaker": "诺艾尔",
                    "text": "我很喜欢闻酒的味道，对酿酒这件事情，也学习和总结过一些经验。"
                },
                {
                    "id": "400800216",
                    "speaker": "诺艾尔",
                    "text": "从结论来说，原材料的甜味是必不可少的！"
                },
                {
                    "id": "400800217",
                    "speaker": "诺艾尔",
                    "text": "为了选出最合适的那一种，我找来了蒙德周边所有含有甜味的植物和果实，逐一试吃并记录了一份完整的清单。"
                },
                {
                    "id": "400800218",
                    "speaker": "诺艾尔",
                    "text": "不同地点的同种素材也纳入了考量，比如清泉镇附近的甜甜花会比誓言岬的更甜一些。"
                },
                {
                    "id": "400800219",
                    "speaker": "派蒙",
                    "text": "哇，听上去工作量好大…"
                },
                {
                    "id": "400800220",
                    "speaker": "诺艾尔",
                    "text": "没关系，这就是我身为「骑士团女仆」应该做的！"
                },
                {
                    "id": "400800221",
                    "speaker": "诺艾尔",
                    "text": "能够代表骑士团，找到「守护的执着」，对我来说也是无上的荣幸！"
                },
                {
                    "id": "400800222",
                    "speaker": "派蒙",
                    "text": "诺艾尔的眼睛，在发光…"
                },
                {
                    "id": "400800223",
                    "speaker": "派蒙",
                    "text": "但我觉得，她是被丽莎小姐给…"
                },
                {
                    "id": "400800224",
                    "speaker": "Player",
                    "text": "派蒙，嘘。"
                },
                {
                    "id": "400800225",
                    "speaker": "诺艾尔",
                    "text": "啊，说回正题。只有我独自进行评测的话，我会担心陷入主观。那天正好遇到了从实验室里出来的砂糖小姐，就问了问她…"
                },
                {
                    "id": "400800226",
                    "speaker": "砂糖",
                    "text": "啊！"
                },
                {
                    "id": "400800227",
                    "speaker": "诺艾尔",
                    "text": "怎么了，砂糖？"
                },
                {
                    "id": "400800228",
                    "speaker": "砂糖",
                    "text": "我突然想起来…我出门是为了去领最近进口的一批实验器材…"
                },
                {
                    "id": "400800229",
                    "speaker": "诺艾尔",
                    "text": "……"
                },
                {
                    "id": "400800230",
                    "speaker": "派蒙",
                    "text": "看你们的脸色…该不会是把这事情忘记了，一直在实验室里待到今天吧…"
                },
                {
                    "id": "400800231",
                    "speaker": "诺艾尔",
                    "text": "嗯，是的…对不起…"
                },
                {
                    "id": "400800232",
                    "speaker": "砂糖",
                    "text": "唉，别在意，我也有责任。器材我晚些再去找玛乔丽小姐吧。诺艾尔，你先继续说吧。"
                },
                {
                    "id": "400800233",
                    "speaker": "诺艾尔",
                    "text": "是，是！"
                },
                {
                    "id": "400800234",
                    "speaker": "诺艾尔",
                    "text": "砂糖小姐不愧是专业的研究员！对我的清单提出了宝贵的建议…"
                },
                {
                    "id": "400800235",
                    "speaker": "砂糖",
                    "text": "就不用特意夸我了啦…"
                },
                {
                    "id": "400800236",
                    "speaker": "砂糖",
                    "text": "在那之后，诺艾尔也告诉了我事情的经过。"
                },
                {
                    "id": "400800237",
                    "speaker": "砂糖",
                    "text": "她明明不认识那位名叫雷泽的少年，却做得那么认真…让我很感动。但在我看来，现有材料都不足以达到「完美」这一要求。"
                },
                {
                    "id": "400800238",
                    "speaker": "砂糖",
                    "text": "我们需要的是一种含糖量高又便于发酵的水果，最后，我从清单里选择了果酒湖周围采集的日落果样本作为基础，将它改良。"
                },
                {
                    "id": "400800239",
                    "speaker": "砂糖",
                    "text": "通过「生物炼金」放大甜味的特征，再加以实验对照…"
                },
                {
                    "id": "400800240",
                    "speaker": "诺艾尔",
                    "text": "一旦开始做实验，砂糖小姐的毅力就令我自愧不如！"
                },
                {
                    "id": "400800241",
                    "speaker": "砂糖",
                    "text": "啊，都说了请不要夸奖我…"
                },
                {
                    "id": "400800242",
                    "speaker": "砂糖",
                    "text": "总之…「伍式日落果改陆叁号四倍甜度版」，终于研发成功了，甜度经过严格测量，色泽和饱满度也是一流的。"
                },
                {
                    "id": "400800243",
                    "speaker": "砂糖",
                    "text": "诺艾尔把它简称为「四倍甜日落果」。"
                },
                {
                    "id": "400800244",
                    "speaker": "砂糖",
                    "text": "可惜现在的条件还不支持大规模量产…这次能帮上雷泽就好了。",
                    "choices": [
                        {
                            "id": "400800245",
                            "text": "一定可以的。",
                            "response": [
                                {
                                    "id": "400800248",
                                    "speaker": "砂糖",
                                    "text": "#{NICKNAME}，我还有一些话想说。"
                                },
                                {
                                    "id": "400800249",
                                    "speaker": "砂糖",
                                    "text": "从小到大…我都生活得很幸福。虽然一直不太擅长跟人打交道，但父母从没对我提过要求。"
                                },
                                {
                                    "id": "400800250",
                                    "speaker": "砂糖",
                                    "text": "他们从没对我说过「你应该表现得更开朗一点」，只是告诉我「做自己喜欢的事就好。」"
                                },
                                {
                                    "id": "400800251",
                                    "speaker": "砂糖",
                                    "text": "我知道…我是幸运的。"
                                },
                                {
                                    "id": "400800252",
                                    "speaker": "砂糖",
                                    "text": "雷泽的生活，我从未经历过，也无从想象。贸然说这些话只会是冒犯。但我真心希望他能过得快乐，能去做自己想做的事。"
                                },
                                {
                                    "id": "400800253",
                                    "speaker": "诺艾尔",
                                    "text": "砂糖小姐…"
                                },
                                {
                                    "id": "400800254",
                                    "speaker": "图书馆的门",
                                    "text": "「咔嗒——」"
                                },
                                {
                                    "id": "400800255",
                                    "speaker": "雷泽",
                                    "text": "对不起，我又来晚了。"
                                },
                                {
                                    "id": "400800256",
                                    "speaker": "雷泽",
                                    "text": "师父，忘记看时间，一直，在说话。"
                                },
                                {
                                    "id": "400800257",
                                    "speaker": "派蒙",
                                    "text": "没事哦，我们刚好也在聊天呢。欸，总感觉这两天说过一模一样的话…"
                                },
                                {
                                    "id": "400800258",
                                    "speaker": "派蒙",
                                    "text": "（咦，等等，砂糖怎么不见了？）"
                                },
                                {
                                    "id": "400800259",
                                    "speaker": "诺艾尔",
                                    "text": "（竟然趁他推门出来的时机跑掉了？！）"
                                },
                                {
                                    "id": "400800260",
                                    "speaker": "诺艾尔",
                                    "text": "你好！我是西风骑士团的女仆诺艾尔。"
                                },
                                {
                                    "id": "400800261",
                                    "speaker": "雷泽",
                                    "text": "你好。"
                                },
                                {
                                    "id": "400800262",
                                    "speaker": "诺艾尔",
                                    "text": "这份材料请你收下。这并不是我一个人准备的！另一位炼金术士，她现在…那个…"
                                },
                                {
                                    "id": "400800263",
                                    "speaker": "Player",
                                    "text": "她工作有点忙。"
                                },
                                {
                                    "id": "400800264",
                                    "speaker": "诺艾尔",
                                    "text": "啊，对…很遗憾，不能亲手交给你。"
                                },
                                {
                                    "id": "400800265",
                                    "speaker": "雷泽",
                                    "text": "药剂，花蜜，还有风晶蝶一样的味道…对吗？"
                                },
                                {
                                    "id": "400800266",
                                    "speaker": "派蒙",
                                    "text": "哇，果然瞒不过雷泽的嗅觉呀。"
                                },
                                {
                                    "id": "400800267",
                                    "speaker": "雷泽",
                                    "text": "日落果，比之前闻到过的，都甜。可莉说过，炼金术，超级厉害，能让东西变好。"
                                },
                                {
                                    "id": "400800268",
                                    "speaker": "诺艾尔",
                                    "text": "嗯！希望这种甜蜜的果子，能为你们酿出最甜最好的酒。",
                                    "choices": [
                                        {
                                            "id": "400800269",
                                            "text": "那位女孩子还想说…",
                                            "response": [
                                                {
                                                    "id": "400800271",
                                                    "speaker": "雷泽",
                                                    "text": "…谢谢你们。"
                                                },
                                                {
                                                    "id": "400800272",
                                                    "speaker": "雷泽",
                                                    "text": "下次，等她，有空，想当面说谢谢。"
                                                },
                                                {
                                                    "id": "400800273",
                                                    "speaker": "诺艾尔",
                                                    "text": "交给我吧！我来想办法说服她…说服她不要每天都这么忙，然后就把她介绍给你认识！"
                                                },
                                                {
                                                    "id": "400800274",
                                                    "speaker": "雷泽",
                                                    "text": "好，我会等。"
                                                },
                                                {
                                                    "id": "400800275",
                                                    "speaker": "派蒙",
                                                    "text": "嗯，这下材料也收齐了，终于可以酿酒啦。酒桶的话，我记得放在「天使的馈赠」摊位那边了！"
                                                },
                                                {
                                                    "id": "400800276",
                                                    "speaker": "派蒙",
                                                    "text": "诺艾尔，那我们就先走了。"
                                                },
                                                {
                                                    "id": "400800277",
                                                    "speaker": "诺艾尔",
                                                    "text": "再见，祝你们一切顺利！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "400800270",
                                            "text": "「做自己喜欢的事就好。」"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "400800246",
                            "text": "我能先尝一口吗？",
                            "response": [
                                {
                                    "id": "400800247",
                                    "speaker": "派蒙",
                                    "text": "喂！你怎么回事啊？"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "4008003",
            "objective": "前往佳酿节会场进行酒浆调制",
            "dialogues": [
                {
                    "id": "400800301",
                    "speaker": "可莉",
                    "text": "#荣誉骑士{M#哥哥}{F#姐姐}，雷泽，这里这里！你们看看谁来啦！"
                },
                {
                    "id": "400800302",
                    "speaker": "派蒙",
                    "text": "哇，这不是迪奥娜吗？我还以为你会来猫尾酒馆的摊位，结果好几天都没看见你！"
                },
                {
                    "id": "400800303",
                    "speaker": "迪奥娜",
                    "text": "呜…不可原谅…"
                },
                {
                    "id": "400800304",
                    "speaker": "派蒙",
                    "text": "欸？欸——你怎么了？"
                },
                {
                    "id": "400800305",
                    "speaker": "迪奥娜",
                    "text": "唔呃呃呃呃呃——气死我啦！"
                },
                {
                    "id": "400800306",
                    "speaker": "迪奥娜",
                    "text": "可莉都告诉我了，都是你们两个干的好事，竟然让雷泽…让爸爸的朋友，可靠的好人！也对酒产生了兴趣！"
                },
                {
                    "id": "400800307",
                    "speaker": "迪奥娜",
                    "text": "雷泽，你绝对不可以变成趴在酒桌上哇哇大哭的臭大叔！"
                },
                {
                    "id": "400800308",
                    "speaker": "雷泽",
                    "text": "我，呃…不明白。"
                },
                {
                    "id": "400800309",
                    "speaker": "派蒙",
                    "text": "听起来像是有什么误会…"
                },
                {
                    "id": "400800310",
                    "speaker": "派蒙",
                    "text": "小可莉，你到底是怎么说的呀？"
                },
                {
                    "id": "400800311",
                    "speaker": "可莉",
                    "text": "#唔…我和迪奥娜姐姐说，雷泽要找妈妈，荣誉骑士{M#哥哥}{F#姐姐}在帮他，他们很难过，他们需要酒，所以想要你帮忙…"
                },
                {
                    "id": "400800312",
                    "speaker": "可莉",
                    "text": "还没说完，迪奥娜姐姐就回答：「可莉，你不用再说了，这件事我一定要管。」然后，我们就一起过来了…"
                },
                {
                    "id": "400800313",
                    "speaker": "Player",
                    "text": "……"
                },
                {
                    "id": "400800314",
                    "speaker": "雷泽",
                    "text": "呃…"
                },
                {
                    "id": "400800315",
                    "speaker": "派蒙",
                    "text": "好…好吧，我都不知道该怎么接话了。迪奥娜，关于这件事，传达环节出现了一点问题…"
                },
                {
                    "id": "400800316",
                    "speaker": "Black Screen",
                    "text": "向迪奥娜讲述了来龙去脉…"
                },
                {
                    "id": "400800317",
                    "speaker": "迪奥娜",
                    "text": "你们的意思是说，雷泽是想通过制作父母从前酿造的酒，来了解他们的过去…不是刚编了一个说辞在骗我吧？",
                    "choices": [
                        {
                            "id": "400800318",
                            "text": "没有没有。",
                            "response": [
                                {
                                    "id": "400800320",
                                    "speaker": "可莉",
                                    "text": "迪奥娜姐姐对不起，是可莉不好，没有说清楚。"
                                },
                                {
                                    "id": "400800321",
                                    "speaker": "可莉",
                                    "text": "你可不可以不要生气，帮帮雷泽做酒？"
                                },
                                {
                                    "id": "400800322",
                                    "speaker": "可莉",
                                    "text": "我抓好多鱼跟你一起吃，喏，嘟嘟可也给你摸摸。"
                                },
                                {
                                    "id": "400800323",
                                    "speaker": "迪奥娜",
                                    "text": "我…我才没有多生气呢。"
                                },
                                {
                                    "id": "400800324",
                                    "speaker": "迪奥娜",
                                    "text": "可莉是想帮忙做好事，我明白。"
                                },
                                {
                                    "id": "400800325",
                                    "speaker": "迪奥娜",
                                    "text": "我刚才是因为不想雷泽被带坏，才不小心把声音抬高了一点点…既然不是要自己喝，那就勉为其难地帮你们一下好了。"
                                },
                                {
                                    "id": "400800326",
                                    "speaker": "迪奥娜",
                                    "text": "但有些事先说好，我平时调制的都是酿好的酒。现在突然要从混合原料开始制作，我也不知道会变成怎么样哦…"
                                },
                                {
                                    "id": "400800327",
                                    "speaker": "可莉",
                                    "text": "太好啦！迪奥娜姐姐是大好人！"
                                },
                                {
                                    "id": "400800328",
                                    "speaker": "雷泽",
                                    "text": "嗯。",
                                    "choices": [
                                        {
                                            "id": "400800329",
                                            "text": "有迪奥娜出手，事半功倍。",
                                            "response": [
                                                {
                                                    "id": "400800331",
                                                    "speaker": "迪奥娜",
                                                    "text": "哼，你们就会说好听的。看我的吧。"
                                                },
                                                {
                                                    "id": "400800332",
                                                    "speaker": "Black Screen",
                                                    "text": "迪奥娜亮出她享誉蒙德的招牌调酒师手势，往酒桶里捣鼓了几下…"
                                                },
                                                {
                                                    "id": "400800333",
                                                    "speaker": "派蒙",
                                                    "text": "搞定了，真不费力！"
                                                },
                                                {
                                                    "id": "400800334",
                                                    "speaker": "派蒙",
                                                    "text": "接下来，就得把它找个地方储存起来了。"
                                                },
                                                {
                                                    "id": "400800335",
                                                    "speaker": "派蒙",
                                                    "text": "「等啊，等啊，等着风起涌。」…唔，是要放在有风的地方吗？"
                                                },
                                                {
                                                    "id": "400800336",
                                                    "speaker": "雷泽",
                                                    "text": "风起地，可以吗？风很大。"
                                                },
                                                {
                                                    "id": "400800337",
                                                    "speaker": "派蒙",
                                                    "text": "嗯！在蒙德只要说起风，第一时间想到的就是那里呢。"
                                                },
                                                {
                                                    "id": "400800338",
                                                    "speaker": "可莉",
                                                    "text": "好呀好呀，可莉也要一起去！"
                                                },
                                                {
                                                    "id": "400800339",
                                                    "speaker": "迪奥娜",
                                                    "text": "我还要监督我那个笨蛋老爹，就不跟过去了。"
                                                },
                                                {
                                                    "id": "400800340",
                                                    "speaker": "迪奥娜",
                                                    "text": "可莉，下次再一起玩吧。"
                                                },
                                                {
                                                    "id": "400800341",
                                                    "speaker": "可莉",
                                                    "text": "好哦，约好啦！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "400800330",
                                            "text": "加油啊，迪奥娜！"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "400800319",
                            "text": "绝对没有。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "4008004",
            "objective": "前往风起地",
            "dialogues": [
                {
                    "id": "400800401",
                    "speaker": "温迪",
                    "text": "好巧好巧，你们也来啦。"
                },
                {
                    "id": "400800402",
                    "speaker": "派蒙",
                    "text": "卖唱的，你怎么会在这里？"
                },
                {
                    "id": "400800403",
                    "speaker": "温迪",
                    "text": "我一觉醒来，空中飘来一阵特别好闻的味道。顺着果子的甜味一路走，就到这里了哦。"
                },
                {
                    "id": "400800404",
                    "speaker": "可莉",
                    "text": "对的，果子好甜，可莉也闻得到！"
                },
                {
                    "id": "400800405",
                    "speaker": "Player",
                    "text": "还有别的原因吧？"
                },
                {
                    "id": "400800406",
                    "speaker": "温迪",
                    "text": "嗯，因为我想起了一件重要的事。在你们封上木桶、把酒埋进泥土之前，还需要再做一件事。"
                },
                {
                    "id": "400800407",
                    "speaker": "可莉",
                    "text": "欸！还缺什么东西吗？"
                },
                {
                    "id": "400800408",
                    "speaker": "温迪",
                    "text": "雷泽，还记得那半瓶「千风佳酿」的味道吧？里面是不是有一点苦味？"
                },
                {
                    "id": "400800409",
                    "speaker": "雷泽",
                    "text": "嗯，有。"
                },
                {
                    "id": "400800410",
                    "speaker": "温迪",
                    "text": "啊哈哈，那种苦味大有来头，就是…这个。"
                },
                {
                    "id": "400800411",
                    "speaker": "派蒙",
                    "text": "蒲公英籽？"
                },
                {
                    "id": "400800412",
                    "speaker": "温迪",
                    "text": "你们知道蒲公英酒吧。在蒙德人心中，风能够带回灵魂，也可以保存记忆。"
                },
                {
                    "id": "400800413",
                    "speaker": "温迪",
                    "text": "蒲公英籽就像自然的宝石，汇聚着每年第一缕风。人们把它放进酒桶，就是把当下的风放了进去。"
                },
                {
                    "id": "400800414",
                    "speaker": "温迪",
                    "text": "美酒因而保留下此刻的记忆，直到永远。"
                },
                {
                    "id": "400800415",
                    "speaker": "温迪",
                    "text": "所以，「千风佳酿」就是最初的「蒲公英酒」。"
                },
                {
                    "id": "400800416",
                    "speaker": "派蒙",
                    "text": "喔——！"
                },
                {
                    "id": "400800417",
                    "speaker": "可莉",
                    "text": "好厉害——我们的事情被酒记下来啦！"
                },
                {
                    "id": "400800418",
                    "speaker": "温迪",
                    "text": "至于为什么没有固定的味道嘛，因为放进去的材料完全自由，欸嘿。"
                },
                {
                    "id": "400800419",
                    "speaker": "雷泽",
                    "text": "唔…"
                },
                {
                    "id": "400800420",
                    "speaker": "可莉",
                    "text": "怎么了，雷泽，你在想什么？"
                },
                {
                    "id": "400800421",
                    "speaker": "雷泽",
                    "text": "爸爸妈妈的酒里，蒲公英籽以外，不知道。"
                },
                {
                    "id": "400800422",
                    "speaker": "雷泽",
                    "text": "我的酒里，有很多，朋友的情感。"
                },
                {
                    "id": "400800423",
                    "speaker": "雷泽",
                    "text": "爸爸妈妈，还是不明白。但…有大家。"
                },
                {
                    "id": "400800424",
                    "speaker": "雷泽",
                    "text": "大家，很努力。"
                },
                {
                    "id": "400800425",
                    "speaker": "雷泽",
                    "text": "法尔伽，师父，可莉，班尼特，棕色猫叔叔，冷冷的姐姐，装笑的大人…"
                },
                {
                    "id": "400800426",
                    "speaker": "雷泽",
                    "text": "灰灰硬硬的女孩子，风晶蝶味道的人，猫叔叔的女儿…"
                },
                {
                    "id": "400800427",
                    "speaker": "雷泽",
                    "text": "#绿诗人，派蒙，{NICKNAME}。"
                },
                {
                    "id": "400800428",
                    "speaker": "雷泽",
                    "text": "每个人，都记着。"
                },
                {
                    "id": "400800429",
                    "speaker": "雷泽",
                    "text": "酒，做起来，很难。"
                },
                {
                    "id": "400800430",
                    "speaker": "雷泽",
                    "text": "没有大家…不会有，今天的酒。"
                },
                {
                    "id": "400800431",
                    "speaker": "雷泽",
                    "text": "和朋友一起，困难，不是困难。"
                },
                {
                    "id": "400800432",
                    "speaker": "雷泽",
                    "text": "我…很开心。",
                    "choices": [
                        {
                            "id": "400800433",
                            "text": "能够帮上雷泽…",
                            "response": [
                                {
                                    "id": "400800435",
                                    "speaker": "雷泽",
                                    "text": "嗯，谢谢。"
                                },
                                {
                                    "id": "400800436",
                                    "speaker": "雷泽",
                                    "text": "朋友…也是「卢皮卡」。"
                                },
                                {
                                    "id": "400800437",
                                    "speaker": "雷泽",
                                    "text": "未来，大家一起。我是人，我是狼…都没有关系。"
                                },
                                {
                                    "id": "400800438",
                                    "speaker": "雷泽",
                                    "text": "长大…再一起来开，这桶酒。"
                                },
                                {
                                    "id": "400800439",
                                    "speaker": "温迪",
                                    "text": "精彩的发言。我这个吟游诗人，已经没有什么想补充的呢。"
                                },
                                {
                                    "id": "400800440",
                                    "speaker": "温迪",
                                    "text": "接下来就把酒埋好，慢慢等待它变得甘醇吧。"
                                },
                                {
                                    "id": "400800441",
                                    "speaker": "Black Screen",
                                    "text": "大家一起把酒桶埋进了土里…"
                                },
                                {
                                    "id": "400800442",
                                    "speaker": "派蒙",
                                    "text": "终于完工啦，我也想好好庆祝一下了！"
                                },
                                {
                                    "id": "400800443",
                                    "speaker": "派蒙",
                                    "text": "没记错的话，明天就是「归风日」对吧？"
                                },
                                {
                                    "id": "400800444",
                                    "speaker": "可莉",
                                    "text": "哇！风神大人要回来啦——"
                                },
                                {
                                    "id": "400800445",
                                    "speaker": "温迪",
                                    "text": "啊哈哈，提醒我了。歌谣还没有背完，我得回去准备举杯仪式。各位朋友，明天再见喽。"
                                },
                                {
                                    "id": "400800446",
                                    "speaker": "温迪",
                                    "text": "今晚好好睡一觉，明天早晨记得迎着清风叫醒你们的耳朵，然后，来听最好的吟游诗人演出。"
                                }
                            ]
                        },
                        {
                            "id": "400800434",
                            "text": "所有人都很开心哦。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "4008005",
            "objective": "等到第二天（10-14点）",
            "dialogues": []
        },
        {
            "id": "4008006",
            "objective": "前往会场参加举杯仪式",
            "dialogues": [
                {
                    "id": "400800601",
                    "speaker": "派蒙",
                    "text": "好多人啊，大家都来迎接风神了呢。咦，怎么都围在「天使的馈赠」摊位前？"
                },
                {
                    "id": "400800602",
                    "speaker": "丽莎",
                    "text": "按照惯例，佳酿节上品质最好的酒，要等到举杯仪式献给风神大人品尝过之后才能开售，大家都在排队等着呢。"
                },
                {
                    "id": "400800603",
                    "speaker": "派蒙",
                    "text": "哼，对这些家伙来说，迎接风神只是个过场吧。丽莎小姐，你是来看雷泽的吗？"
                },
                {
                    "id": "400800604",
                    "speaker": "丽莎",
                    "text": "嗯，之前还有些不放心，刚才和雷泽聊过几句，听说你们的酿酒之旅还算顺利。今天我也能安心喝一杯了。"
                },
                {
                    "id": "400800605",
                    "speaker": "派蒙",
                    "text": "哇…你也…"
                },
                {
                    "id": "400800606",
                    "speaker": "丽莎",
                    "text": "呵呵，雷泽他们已经在那边了，赶快过去吧。"
                },
                {
                    "id": "400800607",
                    "speaker": "班尼特",
                    "text": "呦，你们来啦！"
                },
                {
                    "id": "400800608",
                    "speaker": "派蒙",
                    "text": "哇，这么多酒瓶是怎么回事？如果不知道，还以为你们也摆了个卖酒的摊位呢。"
                },
                {
                    "id": "400800609",
                    "speaker": "班尼特",
                    "text": "哈哈哈，这些都是我们帮雷泽准备的！"
                },
                {
                    "id": "400800610",
                    "speaker": "可莉",
                    "text": "妈妈说过，今天大家要迎接风神大人，要请他喝酒。如果风神大人高兴，就会变成风来祝福大家。"
                },
                {
                    "id": "400800611",
                    "speaker": "可莉",
                    "text": "#我们想让风神大人高兴，让他帮帮雷泽。荣誉骑士{M#哥哥}{F#姐姐}你看，这是阿贝多哥哥借给我的。"
                },
                {
                    "id": "400800612",
                    "speaker": "班尼特",
                    "text": "这瓶是我的老爹们给的，还好没在路上摔了…也就装装样子，用完得给他们带回去。"
                },
                {
                    "id": "400800613",
                    "speaker": "可莉",
                    "text": "妈妈说，风神大人的酒量特别大，只要他想，一口气能把果酒湖喝干！"
                },
                {
                    "id": "400800614",
                    "speaker": "可莉",
                    "text": "这些，再加上雷泽爸爸妈妈留下的酒…够不够呀？"
                },
                {
                    "id": "400800615",
                    "speaker": "雷泽",
                    "text": "啊，绿诗人。"
                },
                {
                    "id": "400800616",
                    "speaker": "温迪",
                    "text": "咳咳，各位，非常荣幸来到这里。今天我受西风骑士团代理团长琴小姐邀请，为大家弹奏一曲——「千风佳酿」。"
                },
                {
                    "id": "400800617",
                    "speaker": "温迪",
                    "text": "我会把最好的歌谣献给风，也献给在场的你们——"
                },
                {
                    "id": "400800618",
                    "speaker": "温迪",
                    "text": "「我们把这些东西封进桶，\\n等啊，等啊，等着风起涌。\\n把佳酿的瓶口先蜡上，\\n南风和煦，北风猛。」"
                },
                {
                    "id": "400800619",
                    "speaker": "温迪",
                    "text": "「佳酿味道像什么？\\n蒙德的名字，自由的梦。\\n究竟是什么发酵成佳酿？\\n探索的勇气，慈爱的温柔。」"
                },
                {
                    "id": "400800620",
                    "speaker": "温迪",
                    "text": "「守护的执着一如初，\\n伴着千风起祝颂，\\n酸汁变甜，糙桶润透，\\n等啊，等啊，等着风起涌。」"
                },
                {
                    "id": "400800621",
                    "speaker": "温迪",
                    "text": "「酒桶里面放了啥？\\n小麦的金黄，潜荟葱茏。\\n佳酿出桶，飘来了什么？\\n风铃的声音，万古的长空。」"
                },
                {
                    "id": "400800622",
                    "speaker": "温迪",
                    "text": "「我们伴着这些美酒唱起歌，\\n等啊，等啊，等着风起咏。\\n千风带走了什么下酒？\\n琴弦上的故事，今夜的美梦。」"
                },
                {
                    "id": "400800623",
                    "speaker": "琴",
                    "text": "朋友们，让我们共同开启美酒——"
                },
                {
                    "id": "400800624",
                    "speaker": "众人",
                    "text": "敬献风神！"
                },
                {
                    "id": "400800628",
                    "speaker": "雷泽",
                    "text": "敬献风神…"
                },
                {
                    "id": "400800629",
                    "speaker": "Player",
                    "text": "敬献风神。"
                },
                {
                    "id": "400800630",
                    "speaker": "可莉",
                    "text": "欸…没有风…"
                },
                {
                    "id": "400800631",
                    "speaker": "雷泽",
                    "text": "可莉，别难过。"
                },
                {
                    "id": "400800632",
                    "speaker": "可莉",
                    "text": "怎么会这样，雷泽，风神大人没有回来，是不是他不喜欢我们准备的酒？"
                },
                {
                    "id": "400800633",
                    "speaker": "Player",
                    "text": "应该不是…"
                },
                {
                    "id": "400800634",
                    "speaker": "派蒙",
                    "text": "才不会呢！小可莉知道吗？风神大人不仅会变成风，也会变成其他样子，所以今年他一定是变成其他样子回来了！"
                },
                {
                    "id": "400800635",
                    "speaker": "可莉",
                    "text": "唔？是吗？变成…变成蹦蹦？"
                },
                {
                    "id": "400800636",
                    "speaker": "派蒙",
                    "text": "好，就变成蹦蹦！听见了吗风神！"
                },
                {
                    "id": "400800637",
                    "speaker": "可莉",
                    "text": "嘿嘿…雷泽，风神大人给你带来祝福了吗？"
                },
                {
                    "id": "400800638",
                    "speaker": "雷泽",
                    "text": "嗯。"
                },
                {
                    "id": "400800639",
                    "speaker": "雷泽",
                    "text": "跟你们一起，说很多，学会了很多。"
                },
                {
                    "id": "400800640",
                    "speaker": "雷泽",
                    "text": "现在，不会害怕。"
                },
                {
                    "id": "400800641",
                    "speaker": "雷泽",
                    "text": "这个…就是祝福。"
                },
                {
                    "id": "400800642",
                    "speaker": "班尼特",
                    "text": "别忘了，将来等你的酒酿成之后，我也要来喝一口哦！",
                    "choices": [
                        {
                            "id": "400800643",
                            "text": "也有我的份吧？",
                            "response": [
                                {
                                    "id": "400800645",
                                    "speaker": "雷泽",
                                    "text": "嗯，一起分享，一起，回忆。"
                                },
                                {
                                    "id": "400800646",
                                    "speaker": "可莉",
                                    "text": "嗯嗯！不过…可莉口渴了…"
                                },
                                {
                                    "id": "400800647",
                                    "speaker": "派蒙",
                                    "text": "光顾着说话了，我们去喝饮料吧？"
                                },
                                {
                                    "id": "400800648",
                                    "speaker": "班尼特",
                                    "text": "我听说「天使的馈赠」摊位上新开卖的「假日果酿」，可好喝了！"
                                },
                                {
                                    "id": "400800649",
                                    "speaker": "可莉",
                                    "text": "我要喝我要喝！"
                                },
                                {
                                    "id": "400800650",
                                    "speaker": "雷泽",
                                    "text": "嗯，大家，我们走吧。"
                                }
                            ]
                        },
                        {
                            "id": "400800644",
                            "text": "会回忆起现在吧。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "4008009",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "400800901",
                    "speaker": "可莉",
                    "text": "雷泽刚刚很帅哦！"
                },
                {
                    "id": "400800902",
                    "speaker": "雷泽",
                    "text": "帅…是什么意思？"
                },
                {
                    "id": "400800903",
                    "speaker": "可莉",
                    "text": "就是厉害！"
                },
                {
                    "id": "400800904",
                    "speaker": "雷泽",
                    "text": "唔…没有。可莉才帅。"
                }
            ]
        },
        {
            "id": "4008050",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "400805001",
                    "speaker": "诺艾尔",
                    "text": "这次的任务，也算顺利完成了吧…"
                },
                {
                    "id": "400805002",
                    "speaker": "诺艾尔",
                    "text": "啊！砂糖小姐的实验器材！我得去帮忙搬运才行！"
                }
            ]
        },
        {
            "id": "4008099",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "400809903",
                    "speaker": "派蒙",
