    "talks": [
        {
            "id": "7467101",
            "objective": "与玛卡德尔对话",
            "dialogues": [
                {
                    "id": "746710101",
                    "speaker": "玛卡德尔",
                    "text": "见鬼！这核心的输出频率还是太不稳定了，这样下去，我的项目可就要彻底完蛋了…"
                },
                {
                    "id": "746710102",
                    "speaker": "Player",
                    "text": "你在做什么？"
                },
                {
                    "id": "746710103",
                    "speaker": "玛卡德尔",
                    "text": "欸！您…您吓我一跳，要是我手里的按钮按下去，说不定就要出大乱子了！"
                },
                {
                    "id": "746710104",
                    "speaker": "玛卡德尔",
                    "text": "看您的样子…也不像是冒险家协会派来的人。",
                    "choices": [
                        {
                            "id": "746710105",
                            "text": "你在协会里发布委托了？",
                            "response": [
                                {
                                    "id": "746710106",
                                    "speaker": "玛卡德尔",
                                    "text": "不是，我可没有钱来发布委托…而且我最不擅长和冒险家交流了。"
                                },
                                {
                                    "id": "746710109",
                                    "speaker": "玛卡德尔",
                                    "text": "我只不过是正在和冒险家协会进行一场「合作」…"
                                },
                                {
                                    "id": "746710110",
                                    "speaker": "玛卡德尔",
                                    "text": "哎哟，我都忘了介绍我自己，我叫玛卡德尔，是一名枫丹科学院的研究员。"
                                },
                                {
                                    "id": "746710111",
                                    "speaker": "玛卡德尔",
                                    "text": "我所在的项目的研究方向是「小型便携式芒荒能量存储装置」。"
                                },
                                {
                                    "id": "746710112",
                                    "speaker": "玛卡德尔",
                                    "text": "在所有组员的共同努力下，研究顺利地推进着，第一台原型机也被制造了出来。"
                                },
                                {
                                    "id": "746710113",
                                    "speaker": "玛卡德尔",
                                    "text": "然后…就像所有人都知道的那样，枫丹科学院发生了一场巨大的爆炸。"
                                },
                                {
                                    "id": "746710114",
                                    "speaker": "玛卡德尔",
                                    "text": "在这场爆炸中，我所在研究项目组的组长和大部分组员都不幸遇难。"
                                },
                                {
                                    "id": "746710115",
                                    "speaker": "玛卡德尔",
                                    "text": "除了我之外，几乎没有人能继续工作并且推进研究…"
                                },
                                {
                                    "id": "746710116",
                                    "speaker": "玛卡德尔",
                                    "text": "但是…以目前院内的这种情况，我所在的这个项目想要继续存在的话，就必须尽快体现出项目的价值所在。"
                                },
                                {
                                    "id": "746710117",
                                    "speaker": "玛卡德尔",
                                    "text": "所以，在征询了各方意见后，我和冒险家协会达成了合作。"
                                },
                                {
                                    "id": "746710118",
                                    "speaker": "玛卡德尔",
                                    "text": "我想以「小型便携式芒荒能量存储装置」原型机为核心，制作了一台「超高压冲击器」。"
                                },
                                {
                                    "id": "746710119",
                                    "speaker": "玛卡德尔",
                                    "text": "我想以这台「超高压冲击器」的运行状态，来证明「小型便携式芒荒能量存储装置」的可靠性。"
                                },
                                {
                                    "id": "746710120",
                                    "speaker": "玛卡德尔",
                                    "text": "我确实也顺利地把这台机器给制造了出来，并且让它开始运转。",
                                    "choices": [
                                        {
                                            "id": "746710121",
                                            "text": "听起来还挺顺利的。",
                                            "response": [
                                                {
                                                    "id": "746710122",
                                                    "speaker": "玛卡德尔",
                                                    "text": "哈哈哈，是的…一切都非常顺利，直到这台「超高压冲击器」开始工作。"
                                                },
                                                {
                                                    "id": "746710125",
                                                    "speaker": "玛卡德尔",
                                                    "text": "唉…每次说这件事的时候我都会头痛。"
                                                },
                                                {
                                                    "id": "746710126",
                                                    "speaker": "玛卡德尔",
                                                    "text": "不知道是那台原型机的设计有问题，还是我造的「超高压冲击器」的能量传输方式有缺陷…"
                                                },
                                                {
                                                    "id": "746710127",
                                                    "speaker": "玛卡德尔",
                                                    "text": "从「小型便携式芒荒能量存储装置」输入「超高压冲击器」的能量，总是忽大忽小。"
                                                },
                                                {
                                                    "id": "746710128",
                                                    "speaker": "玛卡德尔",
                                                    "text": "这让「超高压冲击器」的出力强度…也总是忽大忽小！"
                                                },
                                                {
                                                    "id": "746710129",
                                                    "speaker": "玛卡德尔",
                                                    "text": "出力大的时候，这台机器能轻松击碎石头。但在出力小的时候，它连在泥巴上钻个洞都费劲。"
                                                },
                                                {
                                                    "id": "746710130",
                                                    "speaker": "玛卡德尔",
                                                    "text": "以院内现在的情况，我想要回去重新改造「小型便携式芒荒能量存储装置」基本上不可能了…"
                                                },
                                                {
                                                    "id": "746710131",
                                                    "speaker": "玛卡德尔",
                                                    "text": "我只能在原型机上额外安装了一个监测装置，时刻监控原型机所输出的能量强度。"
                                                },
                                                {
                                                    "id": "746710132",
                                                    "speaker": "玛卡德尔",
                                                    "text": "只要在输出能量强度高的时候启动「超高压冲击器」，就一定能让它以最大强度出力！",
                                                    "choices": [
                                                        {
                                                            "id": "746710133",
                                                            "text": "太复杂了！",
                                                            "response": [
                                                                {
                                                                    "id": "746710134",
                                                                    "speaker": "玛卡德尔",
                                                                    "text": "但这已经是我能想出的最好且成本最低的解决方案了，这下可怎么办…"
                                                                },
                                                                {
                                                                    "id": "746710137",
                                                                    "speaker": "玛卡德尔",
                                                                    "text": "唉，难道冒险家协会的人也这么想，所以他们才迟迟没有派人过来…"
                                                                },
                                                                {
                                                                    "id": "746710138",
                                                                    "speaker": "玛卡德尔",
                                                                    "text": "这可怎么办，要是没测试数据，我可怎么回院里做报告…"
                                                                },
                                                                {
                                                                    "id": "746710139",
                                                                    "speaker": "玛卡德尔",
                                                                    "text": "旅行者…如果您愿意的话，能帮帮我吗？"
                                                                },
                                                                {
                                                                    "id": "746710140",
                                                                    "speaker": "玛卡德尔",
                                                                    "text": "我向您保证，这台装置绝对可靠！我甚至还为它做了不少额外的挂件，能够增强它的各种功能！",
                                                                    "choices": [
                                                                        {
                                                                            "id": "746710141",
                                                                            "text": "我要是把握不住时机怎么办？",
                                                                            "response": [
                                                                                {
                                                                                    "id": "746710142",
                                                                                    "speaker": "玛卡德尔",
                                                                                    "text": "没关系，最多也就是…也就是出力的强度偏低，这台机器也不会爆炸。"
                                                                                },
                                                                                {
                                                                                    "id": "746710143",
                                                                                    "speaker": "玛卡德尔",
                                                                                    "text": "您只需要等着下一个能量波峰到来，然后启动这台机器，让它以最大强度出力就好。"
                                                                                },
                                                                                {
                                                                                    "id": "746710148",
                                                                                    "speaker": "玛卡德尔",
                                                                                    "text": "放心吧，旅行者，这台机器绝对安全，而且…测试完成后，我还会付您钱呢。"
                                                                                },
                                                                                {
                                                                                    "id": "746710149",
                                                                                    "speaker": "玛卡德尔",
                                                                                    "text": "那就交给您了！我的未来，这台机器的未来…还有我所在项目的未来，都托付给您了。"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "746710144",
                                                                            "text": "它不会突然在我身边爆炸吧？",
                                                                            "response": [
                                                                                {
                                                                                    "id": "746710145",
                                                                                    "speaker": "玛卡德尔",
                                                                                    "text": "绝无可能，我为它配置了大量的安全与监测装置，最多也就是出力强度偏低，爆炸是不可能的。"
                                                                                },
                                                                                {
                                                                                    "id": "746710146",
                                                                                    "speaker": "玛卡德尔",
                                                                                    "text": "就算是您没有把握住能量波峰，那也没有任何关系。"
                                                                                },
                                                                                {
                                                                                    "id": "746710147",
                                                                                    "speaker": "玛卡德尔",
                                                                                    "text": "只需要等着下一个能量波峰到来，然后启动这台机器，让它以最大强度出力就好。"
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "746710135",
                                                            "text": "这根本没法用嘛…",
                                                            "response": [
                                                                {
                                                                    "id": "746710136",
                                                                    "speaker": "玛卡德尔",
                                                                    "text": "别啊！这是我能想到的最好方案了，我保证这东西真的能用！"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "746710123",
                                            "text": "听起来没什么问题。",
                                            "response": [
                                                {
                                                    "id": "746710124",
                                                    "speaker": "玛卡德尔",
                                                    "text": "是的，除了这台机器本身之外，一切都几乎没什么问题。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "746710107",
                            "text": "你雇佣冒险家保护你了？",
                            "response": [
                                {
                                    "id": "746710108",
                                    "speaker": "玛卡德尔",
                                    "text": "我可雇不起那些冒险家，他们的开价实在太高了…"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}