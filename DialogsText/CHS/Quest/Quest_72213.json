    "talks": [
        {
            "id": "7221301",
            "objective": "test 与寝子对话 隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "722130101",
                    "speaker": "「寝子」",
                    "text": "「抱愁」…"
                },
                {
                    "id": "722130102",
                    "speaker": "Player",
                    "text": "雕像如何了？"
                },
                {
                    "id": "722130103",
                    "speaker": "「寝子」",
                    "text": "那个石头人类可真厉害啊，喵喵喵。"
                },
                {
                    "id": "722130104",
                    "speaker": "Player",
                    "text": "已经做好了吗？"
                },
                {
                    "id": "722130105",
                    "speaker": "「寝子」",
                    "text": "不是，只是转眼间就弄来了一块好大好大的石头。"
                },
                {
                    "id": "722130106",
                    "speaker": "「寝子」",
                    "text": "然后念叨着，「宫前」、「抱愁」之类的东西，然后一边对着石头咚咚咚。"
                },
                {
                    "id": "722130107",
                    "speaker": "「寝子」",
                    "text": "说起来，请汝回答奴家吧。「宫前」、「抱愁」到底是什么呢？"
                },
                {
                    "id": "722130108",
                    "speaker": "Player",
                    "text": "是「工钱」、「报酬」吧。"
                },
                {
                    "id": "722130109",
                    "speaker": "派蒙",
                    "text": "也就是为了报答他的劳动，给他的好东西。"
                },
                {
                    "id": "722130110",
                    "speaker": "「寝子」",
                    "text": "是这样吗？人类原来讲究这个啊…那好吧，奴家就恩准他摸奴家的耳朵好了。"
                },
                {
                    "id": "722130111",
                    "speaker": "派蒙",
                    "text": "可、可能不太够…"
                },
                {
                    "id": "722130112",
                    "speaker": "「寝子」",
                    "text": "不够吗？那，汝给他…吃的东西好了。"
                },
                {
                    "id": "722130113",
                    "speaker": "Player",
                    "text": "可能他想要的是钱…"
                },
                {
                    "id": "722130114",
                    "speaker": "「寝子」",
                    "text": "钱？这种东西不是用来放进「塞钱箱」的吗？真奇怪，人类竟然中意这个。"
                },
                {
                    "id": "722130115",
                    "speaker": "Player",
                    "text": "工钱是很重要的。"
                },
                {
                    "id": "722130116",
                    "speaker": "「寝子」",
                    "text": "哼，汝姑且也帮奴家做了不少事，奴家相信汝便是。回头，奴家再跟他谈谈。"
                },
                {
                    "id": "722130117",
                    "speaker": "「寝子」",
                    "text": "不过，石头人类现在没有咚咚咚了。看他拿着好短的木头棍子，不知道在做什么。"
                },
                {
                    "id": "722130118",
                    "speaker": "派蒙",
                    "text": "木头棍子？雕塑不是要用锤子、凿子之类的东西吗？"
                },
                {
                    "id": "722130119",
                    "speaker": "Player",
                    "text": "难不成工具坏了…"
                },
                {
                    "id": "722130120",
                    "speaker": "派蒙",
                    "text": "#那{NICKNAME}，我们去找大岛先生吧！说不定我们能帮上什么忙！"
                }
            ]
        },
        {
            "id": "7221302",
            "objective": "询问大岛纯平",
            "dialogues": [
                {
                    "id": "722130301",
                    "speaker": "大岛纯平",
                    "text": "唉，这没锤子，没凿子，怎么干活呢…"
                },
                {
                    "id": "722130302",
                    "speaker": "Player",
                    "text": "遇见什么难题了吗？"
                },
                {
                    "id": "722130303",
                    "speaker": "大岛纯平",
                    "text": "喔，是你们啊。哎呀…真是大意了，来的时候没检查工具，结果工作的时候太入神，不小心把锤子和凿子都弄坏了…"
                },
                {
                    "id": "722130304",
                    "speaker": "大岛纯平",
                    "text": "虽然我也想回去鸣神岛买点工具，但是…"
                },
                {
                    "id": "722130305",
                    "speaker": "大岛纯平",
                    "text": "怎么说呢…雕刻雕像这种事情，我习惯一口气做好。"
                },
                {
                    "id": "722130306",
                    "speaker": "大岛纯平",
                    "text": "虽然锤子和凿子坏了，但我还能稍微比划一下，想一想后面怎么雕刻。"
                },
                {
                    "id": "722130307",
                    "speaker": "大岛纯平",
                    "text": "要是现在离开这座雕像，去鸣神岛买工具的话…回来之后，我又要从头回忆雕刻的手感了…"
                },
                {
                    "id": "722130308",
                    "speaker": "大岛纯平",
                    "text": "而且，这块石头的质地也太硬了，用一般的工具雕刻的话，工具肯定还是会很快坏掉。"
                },
                {
                    "id": "722130309",
                    "speaker": "大岛纯平",
                    "text": "唔…没办法了…"
                },
                {
                    "id": "722130310",
                    "speaker": "大岛纯平",
                    "text": "旅行者，能请你们去帮我找三份铁块回来吗？"
                },
                {
                    "id": "722130311",
                    "speaker": "大岛纯平",
                    "text": "我得想个办法，自己亲手造几份可靠的工具才行。",
                    "choices": [
                        {
                            "id": "722130312",
                            "text": "交给我吧。",
                            "response": [
                                {
                                    "id": "722130313",
                                    "speaker": "大岛纯平",
                                    "text": "喔！那就拜托你们了！"
                                }
                            ]
                        },
                        {
                            "id": "722130314",
                            "text": "你…自己开始铸造？",
                            "response": [
                                {
                                    "id": "722130315",
                                    "speaker": "大岛纯平",
                                    "text": "我好歹也是在踏鞴砂做工的，锻冶当然也会一些。"
                                },
                                {
                                    "id": "722130316",
                                    "speaker": "大岛纯平",
                                    "text": "不过，我可不能在神社开炉，不然代宫司大人准会生气…嘿嘿，毕竟它是猫嘛。"
                                },
                                {
                                    "id": "722130317",
                                    "speaker": "大岛纯平",
                                    "text": "总之，请你先找三份铁块给我吧。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7221303",
            "objective": "将三份铁矿石交给大岛纯平",
            "dialogues": []
        },
        {
            "id": "7221305",
            "objective": "将三份铁矿石交给大岛纯平",
            "dialogues": [
                {
                    "id": "722130501",
                    "speaker": "大岛纯平",
                    "text": "太好了，有这些铁块就足够了。"
                },
                {
                    "id": "722130502",
                    "speaker": "大岛纯平",
                    "text": "等会我就去外面找个合适的位置搭炉，然后制作工具。"
                },
                {
                    "id": "722130503",
                    "speaker": "大岛纯平",
                    "text": "请你们代我去向代宫司大人说一声吧，我先在这里收拾收拾。"
                }
            ]
        },
        {
            "id": "7221304",
            "objective": "向寝子回报",
            "dialogues": [
                {
                    "id": "722130601",
                    "speaker": "「寝子」",
                    "text": "喵喵喵，有什么事吗？奴家会准备充足的「抱愁」的。",
                    "choices": [
                        {
                            "id": "722130602",
                            "text": "是「报酬」。",
                            "response": [
                                {
                                    "id": "722130605",
                                    "speaker": "派蒙",
                                    "text": "总之，石头人…大岛先生的工具坏了。不过我们已经给他维修的材料了，应该没什么问题！"
                                },
                                {
                                    "id": "722130606",
                                    "speaker": "「寝子」",
                                    "text": "问题？有什么问题吗？",
                                    "choices": [
                                        {
                                            "id": "722130607",
                                            "text": "……",
                                            "response": [
                                                {
                                                    "id": "722130609",
                                                    "speaker": "「寝子」",
                                                    "text": "那就好。奴家很期待哪，那个奴家的石头。"
                                                },
                                                {
                                                    "id": "722130610",
                                                    "speaker": "「寝子」",
                                                    "text": "阿响说，那个石头的奴家做好了以后，一定会发生什么好事。"
                                                },
                                                {
                                                    "id": "722130611",
                                                    "speaker": "「寝子」",
                                                    "text": "奴家很期待哪。到底是什么好事呢…难道，阿响会回来么…"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "722130608",
                                            "text": "没有问题，一切正常。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "722130603",
                            "text": "有多少？",
                            "response": [
                                {
                                    "id": "722130604",
                                    "speaker": "「寝子」",
                                    "text": "啊？多少是什么意思？"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7221302",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "722130201",
                    "speaker": "「寝子」",
                    "text": "「抱愁」对人类来说很重要，奴家记住了。"
                }
            ]
        },
        {
            "id": "7221304",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "722130401",
                    "speaker": "大岛纯平",
                    "text": "怎么样，你们找到三份铁块了吗？"
                }
            ]
        }
    ]
}