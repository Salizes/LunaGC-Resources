    "talks": [
        {
            "id": "2102401",
            "objective": "与兰达对话$HIDDEN",
            "dialogues": [
                {
                    "id": "210240101",
                    "speaker": "兰达",
                    "text": "这下可糟糕了…"
                },
                {
                    "id": "210240102",
                    "speaker": "Player",
                    "text": "发生什么了？"
                },
                {
                    "id": "210240103",
                    "speaker": "兰达",
                    "text": "啊？是旅行者啊…是这样，我是个商人，一直在蒙德城和璃月港之间跑生意。"
                },
                {
                    "id": "210240104",
                    "speaker": "兰达",
                    "text": "我刚在蒙德城做了笔大生意，正准备把货单带回去给老板…"
                },
                {
                    "id": "210240105",
                    "speaker": "兰达",
                    "text": "但是没想到，刚走到这附近，就被一群怪物袭击了。"
                },
                {
                    "id": "210240106",
                    "speaker": "兰达",
                    "text": "我又打不过这群怪物，只能掉头就跑，跌跌撞撞一直跑到了这客栈里面。"
                },
                {
                    "id": "210240107",
                    "speaker": "兰达",
                    "text": "但是我人跑掉了，货单却全部弄丢了…您能帮我找回来吗？",
                    "choices": [
                        {
                            "id": "210240108",
                            "text": "我知道了。",
                            "response": [
                                {
                                    "id": "210240109",
                                    "speaker": "兰达",
                                    "text": "太好了，我大概能记得我跑过的地方，这就给您标上…"
                                },
                                {
                                    "id": "210240110",
                                    "speaker": "兰达",
                                    "text": "那些货单我都放在盒子里了，应该也不难找，就拜托您了。"
                                }
                            ]
                        },
                        {
                            "id": "210240111",
                            "text": "什么货单？",
                            "response": [
                                {
                                    "id": "210240112",
                                    "speaker": "兰达",
                                    "text": "当然是酒啊，从蒙德还能跑什么生意。"
                                },
                                {
                                    "id": "210240113",
                                    "speaker": "兰达",
                                    "text": "这可是笔大生意，要是出了问题，老板准要怪罪我。"
                                },
                                {
                                    "id": "210240114",
                                    "speaker": "兰达",
                                    "text": "您就帮帮我吧。我把记得的大概位置都给标好了。"
                                },
                                {
                                    "id": "210240115",
                                    "speaker": "兰达",
                                    "text": "那些货单我都放在盒子里了，应该也不难找，就拜托您了。"
                                }
                            ]
                        },
                        {
                            "id": "210240116",
                            "text": "你老板是谁？",
                            "response": [
                                {
                                    "id": "210240117",
                                    "speaker": "兰达",
                                    "text": "我老板？啊…那个，是璃月港里一个很有钱的商人，很有钱。"
                                },
                                {
                                    "id": "210240118",
                                    "speaker": "兰达",
                                    "text": "哎呀，你就别多问了，我就是个跑腿的，老板的事我也不清楚。"
                                },
                                {
                                    "id": "210240119",
                                    "speaker": "兰达",
                                    "text": "但我要是把这笔生意给弄黄了，估计连跑腿的工作都没了。"
                                },
                                {
                                    "id": "210240120",
                                    "speaker": "兰达",
                                    "text": "您就帮帮我吧。我把记得的大概位置都给标好了。"
                                },
                                {
                                    "id": "210240121",
                                    "speaker": "兰达",
                                    "text": "那些货单我都放在盒子里了，应该也不难找，就拜托您了。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2102402",
            "objective": "拿到货单总$HIDDEN",
            "dialogues": []
        },
        {
            "id": "2102405",
            "objective": "拿到货单",
            "dialogues": []
        },
        {
            "id": "2102404",
            "objective": "拿到货单",
            "dialogues": []
        },
        {
            "id": "2102403",
            "objective": "拿到货单",
            "dialogues": []
        },
        {
            "id": "2102406",
            "objective": "与宝儿对话$HIDDEN",
            "dialogues": [
                {
                    "id": "210240601",
                    "speaker": "宝儿",
                    "text": "看起来没什么用…"
                },
                {
                    "id": "210240602",
                    "speaker": "Player",
                    "text": "请问你见过一个盒子吗…"
                },
                {
                    "id": "210240603",
                    "speaker": "宝儿",
                    "text": "盒子？哦，我确实捡到了一个盒子。"
                },
                {
                    "id": "210240604",
                    "speaker": "宝儿",
                    "text": "我已经打开看过了，是一批货单呢，看起来还是一笔很大的生意。"
                },
                {
                    "id": "210240605",
                    "speaker": "宝儿",
                    "text": "哎呀，不知道这个盒子的主人，愿意付多少钱把盒子拿回去呢…"
                },
                {
                    "id": "210240606",
                    "speaker": "Player",
                    "text": "…什么意思？"
                },
                {
                    "id": "210240607",
                    "speaker": "宝儿",
                    "text": "别这么一副紧张的样子，我就是和你开个玩笑。"
                },
                {
                    "id": "210240608",
                    "speaker": "宝儿",
                    "text": "这货单上记的货物价值可不低，也不知道是璃月港里哪位大老板的大手笔。"
                },
                {
                    "id": "210240609",
                    "speaker": "宝儿",
                    "text": "我可不是不识时务的人，既然知道大概是块铁板，那就没有还硬往上踢的理由。"
                },
                {
                    "id": "210240610",
                    "speaker": "宝儿",
                    "text": "不过，我费心费力保管着这货单，你一句话就想要走，是不是…有点说不过去？"
                },
                {
                    "id": "210240611",
                    "speaker": "宝儿",
                    "text": "这样好了，我们就用最传统的「以物易物」来解决这个问题。"
                },
                {
                    "id": "210240612",
                    "speaker": "宝儿",
                    "text": "你去给我找三颗「夜泊石」来，我就把这货单给你，怎么样？"
                },
                {
                    "id": "210240613",
                    "speaker": "宝儿",
                    "text": "毕竟，和这些货单上记着的大买卖相比…这三颗「夜泊石」可真算不上什么。",
                    "choices": [
                        {
                            "id": "210240614",
                            "text": "我知道了。",
                            "response": [
                                {
                                    "id": "210240615",
                                    "speaker": "宝儿",
                                    "text": "那你就快去找吧，找到了之后，我们再一手交石，一手交货。"
                                }
                            ]
                        },
                        {
                            "id": "210240616",
                            "text": "…这上面记了什么买卖？",
                            "response": [
                                {
                                    "id": "210240618",
                                    "speaker": "宝儿",
                                    "text": "你不知道吗？你只是来帮别人办事…哼，这样也好。"
                                },
                                {
                                    "id": "210240619",
                                    "speaker": "宝儿",
                                    "text": "听我一句劝，这种规模的买卖，你还是不要多打听比较好。"
                                },
                                {
                                    "id": "210240620",
                                    "speaker": "宝儿",
                                    "text": "好了，你去把「夜泊石」拿来给我，我把货单给你，你再把货单给那个托你办事的人。"
                                },
                                {
                                    "id": "210240621",
                                    "speaker": "宝儿",
                                    "text": "事情办完，干净利落，一点麻烦也不惹。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2102407",
            "objective": "击败所有怪物",
            "dialogues": []
        },
        {
            "id": "2102408",
            "objective": "与宝儿对话",
            "dialogues": [
                {
                    "id": "210240801",
                    "speaker": "宝儿",
                    "text": "你把「夜泊石」拿来了吗？"
                }
            ]
        },
        {
            "id": "2102409",
            "objective": "与兰达对话",
            "dialogues": [
                {
                    "id": "210240901",
                    "speaker": "兰达",
                    "text": "您找到了货单了吗？"
                },
                {
                    "id": "210240902",
                    "speaker": "Player",
                    "text": "全部找到了。"
                },
                {
                    "id": "210240903",
                    "speaker": "兰达",
                    "text": "谢谢您，太感谢您了，太好了，总算没出大问题。"
                },
                {
                    "id": "210240904",
                    "speaker": "兰达",
                    "text": "要是这些货单丢了，老板不知道会发多大火。"
                },
                {
                    "id": "210240905",
                    "speaker": "兰达",
                    "text": "呃，您是想问「这些货单到底是什么生意」吧？"
                },
                {
                    "id": "210240906",
                    "speaker": "兰达",
                    "text": "抱歉，我真的不能告诉您，这些都是机密。"
                },
                {
                    "id": "210240907",
                    "speaker": "兰达",
                    "text": "这是您的报酬，请收…等会，这个盒子怎么被打开过？"
                },
                {
                    "id": "210240908",
                    "speaker": "兰达",
                    "text": "…在野外遇见了一个人，她捡到盒子之后打开看了？！"
                },
                {
                    "id": "210240909",
                    "speaker": "兰达",
                    "text": "完了，完了，全完了！不行…得快点去告诉老板…"
                },
                {
                    "id": "210240910",
                    "speaker": "兰达",
                    "text": "哦，您放心，我不会怀疑您的，毕竟您的事迹我已经…"
                },
                {
                    "id": "210240911",
                    "speaker": "兰达",
                    "text": "咳！我，我得想办法和老板联系了，请您去忙自己的事吧。"
                }
            ]
        },
        {
            "id": "2102410",
            "objective": "与宝儿对话$HIDDEN",
            "dialogues": [
                {
                    "id": "210240802",
                    "speaker": "宝儿",
                    "text": "不错，这些「夜泊石」我就收下了。这是货单，你拿好了。"
                },
                {
                    "id": "210240803",
                    "speaker": "宝儿",
                    "text": "好了，拿到了就快点走吧。那个托你办事的人，想必已经等得心急如焚了。"
                }
            ]
        },
        {
            "id": "2102408",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "210240820",
                    "speaker": "宝儿",
                    "text": "…只是看了一眼，应该不会惹上麻烦吧。"
                }
            ]
        }
    ]
}