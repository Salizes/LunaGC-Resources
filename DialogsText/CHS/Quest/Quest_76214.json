    "talks": [
        {
            "id": "7621401",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "762140101",
                    "speaker": "「灰猫先生」",
                    "text": "喵呜…已经是茶会的时间了喵，她们会不会迷路了喵…"
                },
                {
                    "id": "762140102",
                    "speaker": "「灰猫先生」",
                    "text": "#啊，黄金的旅人{M#先生}{F#小姐}，您一定是被选中的勇者喵！能请您帮我找找看我的两位朋友吗？",
                    "choices": [
                        {
                            "id": "762140103",
                            "text": "你的朋友是…",
                            "response": [
                                {
                                    "id": "762140106",
                                    "speaker": "「灰猫先生」",
                                    "text": "还没有到场的两位小姐，一位是和我一样、会说话的猫，不过是橘色的喵。"
                                },
                                {
                                    "id": "762140107",
                                    "speaker": "「灰猫先生」",
                                    "text": "另一位则是很有礼貌的淑女犬，虽然是犬类，但是很温柔喵。"
                                },
                                {
                                    "id": "762140108",
                                    "speaker": "「灰猫先生」",
                                    "text": "就算一方是猫，一方是狗，只要能坐在一起喝茶，大家就一定会很开心喵！"
                                },
                                {
                                    "id": "762140109",
                                    "speaker": "「灰猫先生」",
                                    "text": "为了喵呜兰诺珀里斯的和平，请您帮帮我喵！"
                                }
                            ]
                        },
                        {
                            "id": "762140104",
                            "text": "勇者的标准好随便！",
                            "response": [
                                {
                                    "id": "762140105",
                                    "speaker": "「灰猫先生」",
                                    "text": "不要在意那种细节喵。就算没有传说中的圣剑，就算没有找到传说中的纯水之杯，勇者也是勇者喵。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7621406",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "762140601",
                    "speaker": "「灰猫先生」",
                    "text": "原本约定的碰面地点是这里…但是我的朋友们都没有来喵。"
                },
                {
                    "id": "762140602",
                    "speaker": "「灰猫先生」",
                    "text": "#被选中的勇者{M#先生}{F#小姐}，可以请您在这附近帮忙找找她们吗？"
                }
            ]
        },
        {
            "id": "7621405",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "762140501",
                    "speaker": "「灰猫先生」",
                    "text": "原本约定的碰面地点是这里…但是我的朋友们都没有来喵。"
                },
                {
                    "id": "762140502",
                    "speaker": "「灰猫先生」",
                    "text": "#被选中的勇者{M#先生}{F#小姐}，可以请您在这附近帮忙找找她们吗？"
                }
            ]
        },
        {
            "id": "7621407",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7621402",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "762140201",
                    "speaker": "「橘猫小姐」",
                    "text": "…喵。你的剑技…令猫印象深刻。"
                },
                {
                    "id": "762140209",
                    "speaker": "「橘猫小姐」",
                    "text": "感谢你，可敬的异邦骑士。那些高傲而强大的凶恶之徒不会再侵扰我子民的家园了。"
                },
                {
                    "id": "762140210",
                    "speaker": "「橘猫小姐」",
                    "text": "那么，请说吧。阁下为何来到我的王庭？",
                    "choices": [
                        {
                            "id": "762140202",
                            "text": "王庭？",
                            "response": [
                                {
                                    "id": "762140203",
                                    "speaker": "派蒙",
                                    "text": "呃…既然是童话，那这个应该也是设定的一部分吧？"
                                },
                                {
                                    "id": "762140206",
                                    "speaker": "Black Screen",
                                    "text": "向橘猫小姐转达了灰猫先生的茶会邀请…"
                                },
                                {
                                    "id": "762140207",
                                    "speaker": "「橘猫小姐」",
                                    "text": "……"
                                },
                                {
                                    "id": "762140208",
                                    "speaker": "「橘猫小姐」",
                                    "text": "…我知道了。谢谢你，可敬的异邦骑士。那么，我便听从你的良言，动身前往吧。"
                                }
                            ]
                        },
                        {
                            "id": "762140204",
                            "text": "王上啊，让我来报告您…",
                            "response": [
                                {
                                    "id": "762140205",
                                    "speaker": "派蒙",
                                    "text": "入戏好快！咳咳，既然是设定的一部分…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7621403",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "762140301",
                    "speaker": "「淑女犬小姐」",
                    "text": "#呜汪？怎么了，黄金的旅人{M#先生}{F#小姐}？有什么我可以帮您做的事吗？"
                },
                {
                    "id": "762140302",
                    "speaker": "Black Screen",
                    "text": "向淑女犬小姐转达了灰猫先生的茶会邀请…"
                },
                {
                    "id": "762140303",
                    "speaker": "「淑女犬小姐」",
                    "text": "欸？原来已经到这个时间了吗？！"
                },
                {
                    "id": "762140304",
                    "speaker": "「淑女犬小姐」",
                    "text": "谢谢您！呜汪，要不是太忙，我就亲自去邀请橘猫小姐了…那样的话，灰猫先生说不定也不会…"
                },
                {
                    "id": "762140305",
                    "speaker": "「淑女犬小姐」",
                    "text": "无论是猫还是狗，大家都是可以和平共处的…一定可以的。总之，我现在就去参加茶会啦，谢谢您提醒！"
                }
            ]
        },
        {
            "id": "7621404",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "762140401",
                    "speaker": "「灰猫先生」",
                    "text": "#喵喵！这样一来，大家就到齐了喵！感谢黄金的旅人{M#先生}{F#小姐}，开心的茶会终于可以开始了喵！"
                },
                {
                    "id": "762140402",
                    "speaker": "「橘猫小姐」",
                    "text": "……"
                },
                {
                    "id": "762140403",
                    "speaker": "「淑女犬小姐」",
                    "text": "呵呵，不要总是苦着脸嘛，橘猫小姐。喝些甜甜的东西，心情自然也会好起来喔？"
                }
            ]
        },
        {
            "id": "7621408",
            "objective": "(test)废弃$HIDDEN",
            "dialogues": []
        }
    ]
