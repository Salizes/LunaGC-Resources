    "talks": [
        {
            "id": "2000601",
            "objective": "前往猎鹿人餐馆询问莎拉",
            "dialogues": [
                {
                    "id": "200060101",
                    "speaker": "莎拉",
                    "text": "餐品外送订单"
                },
                {
                    "id": "200060102",
                    "speaker": "莎拉",
                    "text": "欢迎光临猎鹿人…旅行者？你来得正好。"
                },
                {
                    "id": "200060103",
                    "speaker": "莎拉",
                    "text": "抱歉啦，我知道你饿着肚子，但是能请你帮我个忙吗？"
                },
                {
                    "id": "200060104",
                    "speaker": "莎拉",
                    "text": "清泉镇里的欧琳小姐订了一份<color=#00E1FFFF>蜜酱胡萝卜煎肉</color>，但是我听说，清泉镇最近总是有史莱姆出来捣乱…"
                },
                {
                    "id": "200060105",
                    "speaker": "莎拉",
                    "text": "我自己不敢过去…能请你帮我把餐品送给<color=#00E1FFFF>清泉镇的欧琳</color>吗？",
                    "choices": [
                        {
                            "id": "200060106",
                            "text": "好吧，但是…",
                            "response": [
                                {
                                    "id": "200060108",
                                    "speaker": "莎拉",
                                    "text": "等你回来的时候，会有一顿大餐做回报的！"
                                },
                                {
                                    "id": "200060109",
                                    "speaker": "莎拉",
                                    "text": "拜托了！"
                                }
                            ]
                        },
                        {
                            "id": "200060107",
                            "text": "太饿了，我只是来吃饭的。",
                            "response": [
                                {
                                    "id": "200060110",
                                    "speaker": "莎拉",
                                    "text": "等你帮完我的忙之后，我，我就请你吃猎鹿人特制料理，就拜托你了！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2000602",
            "objective": "与莎拉对话",
            "dialogues": []
        },
        {
            "id": "2000603",
            "objective": "(test)运送餐品给活跃的欧琳$HIDDEN",
            "dialogues": [
                {
                    "id": "200060201",
                    "speaker": "活跃的欧琳",
                    "text": "谢谢你，这些史莱姆真讨厌。"
                },
                {
                    "id": "200060202",
                    "speaker": "活跃的欧琳",
                    "text": "要不是我饿到没力气了，这些家伙…"
                },
                {
                    "id": "200060203",
                    "speaker": "Player",
                    "text": "这是你订的餐。"
                },
                {
                    "id": "200060204",
                    "speaker": "活跃的欧琳",
                    "text": "唔——是胡萝卜和肉的香气…要是能早点吃到，那些史莱姆早就被我打飞了！"
                },
                {
                    "id": "200060205",
                    "speaker": "活跃的欧琳",
                    "text": "算了不管了，这是餐费，带回去给莎拉小姐吧。"
                }
            ]
        },
        {
            "id": "2000605",
            "objective": "(test)桥接$HIDDEN",
