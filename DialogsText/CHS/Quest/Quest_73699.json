            "祖尔宛": 7
        }
    },
    "talks": [
        {
            "id": "7369901",
            "objective": "与祖尔宛对话",
            "dialogues": [
                {
                    "id": "736990101",
                    "speaker": "祖尔宛",
                    "text": "哦，看来你们已经顺利完成了之前的训练。"
                },
                {
                    "id": "736990102",
                    "speaker": "派蒙",
                    "text": "完成是完成了，不过斯露莎这家伙…"
                },
                {
                    "id": "736990103",
                    "speaker": "派蒙",
                    "text": "看到几百年前的沙虫结晶，明明前一刻还一本正经地说什么虽然它已经存在了几百年，但总有一天还是会不留任何痕迹地消失…"
                },
                {
                    "id": "736990104",
                    "speaker": "派蒙",
                    "text": "后一刻说到赞美她的颂诗可能会更快被传得面目全非，马上就换了个脸色。"
                },
                {
                    "id": "736990105",
                    "speaker": "斯露莎",
                    "text": "哼，那当然了，我的伟业…我是说，吾辈花灵的伟业，应该是不朽的。怎么能跟那些随时都有可能烟消云散的存在相比。"
                },
                {
                    "id": "736990106",
                    "speaker": "斯露莎",
                    "text": "不能正确地保存，那就一定是方法有问题。前辈也是为了提醒我这一点才让我去重新审视沙虫结晶的吧？"
                },
                {
                    "id": "736990107",
                    "speaker": "祖尔宛",
                    "text": "原来斯露莎是这样想的，倒也有些意思。"
                },
                {
                    "id": "736990108",
                    "speaker": "斯露莎",
                    "text": "难道前辈就不在乎花灵一族的声名吗？"
                },
                {
                    "id": "736990109",
                    "speaker": "祖尔宛",
                    "text": "如果说是人类之中流传的声名，或许并不那么在乎吧。不管怎么说，现在的矫论团可是无趣得很呐。"
                },
                {
                    "id": "736990110",
                    "speaker": "祖尔宛",
                    "text": "#当然，要是多几个像{NICKNAME}和派蒙这样有趣的人物，那就另当别论。"
                },
                {
                    "id": "736990111",
                    "speaker": "派蒙",
                    "text": "嘿嘿，祖尔宛夸我们了欸。",
                    "choices": [
                        {
                            "id": "736990112",
                            "text": "好欸！谢谢前辈夸奖！",
                            "response": [
                                {
                                    "id": "736990113",
                                    "speaker": "斯露莎",
                                    "text": "等等…你、你怎么乱认前辈！"
                                },
                                {
                                    "id": "736990114",
                                    "speaker": "派蒙",
                                    "text": "斯露莎不要这么小气嘛，反正祖尔宛是这里的长者，我们叫一声前辈也很合理，对吧？"
                                },
                                {
                                    "id": "736990117",
                                    "speaker": "祖尔宛",
                                    "text": "不说闲话了，既然斯露莎还将在人类之中的声名看得这般重要，那么接下来的训练或许刚刚好吧。"
                                },
                                {
                                    "id": "736990118",
                                    "speaker": "祖尔宛",
                                    "text": "嗯，我就等你们的好消息了。"
                                }
                            ]
                        },
                        {
                            "id": "736990115",
                            "text": "「有趣」能算是夸奖吗？",
                            "response": [
                                {
                                    "id": "736990116",
                                    "speaker": "祖尔宛",
                                    "text": "以我的标准来说，的确是夸奖的词汇。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7369902",
            "objective": "前往指定地点并完成试炼",
            "dialogues": []
        },
        {
            "id": "7369903",
            "objective": "完成训练任务",
            "dialogues": []
        },
        {
            "id": "7369904",
            "objective": "前往指定地点并完成试炼",
            "dialogues": []
        },
        {
            "id": "7369905",
            "objective": "见证斯露莎回顾过往",
            "dialogues": []
        },
        {
            "id": "7369906",
            "objective": "与斯露莎对话",
            "dialogues": [
                {
                    "id": "736990601",
                    "speaker": "派蒙",
                    "text": "哈，这不是之前来找米希尔时经过的地方么。不过米希尔现在应该不在这里吧？"
                },
                {
                    "id": "736990602",
                    "speaker": "派蒙",
                    "text": "周围这些荆棘…应该都是米希尔的伙伴吧，看起来都还不错。说起来，我们之前还受过它们不少帮助呢。"
                },
                {
                    "id": "736990603",
                    "speaker": "斯露莎",
                    "text": "白飘飘还真是…该不会把我的功劳全都忘了吧？"
                },
                {
                    "id": "736990604",
                    "speaker": "派蒙",
                    "text": "怎么会，斯露莎虽然嘴上抱怨个不停，但是到底还是会将同族之谊放在心上的，对吧？",
                    "choices": [
                        {
                            "id": "736990605",
                            "text": "斯露莎做了什么来着…想不起来了。",
                            "response": [
                                {
                                    "id": "736990606",
                                    "speaker": "斯露莎",
                                    "text": "身为「谒颂主」怎能这样健忘？罚你多写几篇颂诗！"
                                },
                                {
                                    "id": "736990609",
                                    "speaker": "派蒙",
                                    "text": "嘿嘿，我知道，斯露莎这就叫「刀子嘴豆腐心」！"
                                },
                                {
                                    "id": "736990610",
                                    "speaker": "斯露莎",
                                    "text": "才不是这样，我只是为了得到花冠…要不是前辈非让我来，哼…"
                                },
                                {
                                    "id": "736990611",
                                    "speaker": "派蒙",
                                    "text": "不管怎么说，斯露莎能获得「双角的花冠」，也是因为有米希尔，那岂不是应该好好感谢她？"
                                },
                                {
                                    "id": "736990612",
                                    "speaker": "斯露莎",
                                    "text": "那种曾经沾染污秽还难看挣扎的家伙…要我说，再走十遍「净罪的巡礼路」还差不多。"
                                },
                                {
                                    "id": "736990613",
                                    "speaker": "派蒙",
                                    "text": "十遍也太多了吧！等等…仔细想想好像也不是不能接受？",
                                    "choices": [
                                        {
                                            "id": "736990614",
                                            "text": "其实路途不算很长。",
                                            "response": [
                                                {
                                                    "id": "736990615",
                                                    "speaker": "派蒙",
                                                    "text": "嗯，偶尔锻炼一下也不错？"
                                                },
                                                {
                                                    "id": "736990618",
                                                    "speaker": "派蒙",
                                                    "text": "光听名字还以为要走上十天十夜呢，结果实际上也没走多久嘛。怎么说呢，路程短到让人怀疑效果的程度…"
                                                },
                                                {
                                                    "id": "736990619",
                                                    "speaker": "斯露莎",
                                                    "text": "如果有纯水精灵的朝圣之路那样的长度，那我或许也会钦佩她吧。现在这样嘛，只能说和米希尔十分相称。"
                                                },
                                                {
                                                    "id": "736990620",
                                                    "speaker": "派蒙",
                                                    "text": "纯水精灵的朝圣之路？"
                                                },
                                                {
                                                    "id": "736990621",
                                                    "speaker": "斯露莎",
                                                    "text": "大灾厄发生之后，陆陆续续有许多纯水精灵从枫丹来到须弥，她们途经的道路就是所谓的朝圣之路了。"
                                                },
                                                {
                                                    "id": "736990622",
                                                    "speaker": "派蒙",
                                                    "text": "奇怪，纯水精灵为什么要来须弥呢？朝圣…说的又是谁呢？"
                                                },
                                                {
                                                    "id": "736990623",
                                                    "speaker": "斯露莎",
                                                    "text": "唔…我也只是听前辈提起过这件事，虽然过去的确见过从枫丹远道而来的纯水精灵，但是并没有去打听…"
                                                },
                                                {
                                                    "id": "736990624",
                                                    "speaker": "Player",
                                                    "text": "难道是「万种母树」？"
                                                },
                                                {
                                                    "id": "736990625",
                                                    "speaker": "派蒙",
                                                    "text": "对哦，斯露莎说过那是让花灵得以降生的神明大人，要说尊贵的话，这里最尊贵的一定就是万种母树了。"
                                                },
                                                {
                                                    "id": "736990626",
                                                    "speaker": "派蒙",
                                                    "text": "不过，纯水精灵和万种母树又有什么关系…啊，难不成，纯水精灵和花灵其实是远房亲戚？"
                                                },
                                                {
                                                    "id": "736990627",
                                                    "speaker": "派蒙",
                                                    "text": "唔…仔细看看斯露莎，越看越觉得跟纯水精灵有几分相似呢！"
                                                },
                                                {
                                                    "id": "736990628",
                                                    "speaker": "派蒙",
                                                    "text": "哈哈，我该不会发现了什么惊天大秘密吧？",
                                                    "choices": [
                                                        {
                                                            "id": "736990629",
                                                            "text": "倒也没那么相似吧。",
                                                            "response": [
                                                                {
                                                                    "id": "736990631",
                                                                    "speaker": "斯露莎",
                                                                    "text": "白飘飘又在信口胡说了…我可不认识什么纯水精灵。"
                                                                },
                                                                {
                                                                    "id": "736990632",
                                                                    "speaker": "派蒙",
                                                                    "text": "唉，说得也是。毕竟斯露莎刚才都说了，纯水精灵们走的朝圣之路可比米希尔走过的净罪的巡礼路长得多了。"
                                                                },
                                                                {
                                                                    "id": "736990633",
                                                                    "speaker": "派蒙",
                                                                    "text": "这么说，纯水精灵比花灵厉害！斯露莎要输了，呜呜。"
                                                                },
                                                                {
                                                                    "id": "736990634",
                                                                    "speaker": "斯露莎",
                                                                    "text": "什、什么？！我可不是这个意思…"
                                                                },
                                                                {
                                                                    "id": "736990635",
                                                                    "speaker": "斯露莎",
                                                                    "text": "…正经地说，「净罪的巡礼路」并不单指实际走过的距离，而是象征一种上升的，回归的趋势。"
                                                                },
                                                                {
                                                                    "id": "736990636",
                                                                    "speaker": "派蒙",
                                                                    "text": "唔…听起来好像很厉害，可是…"
                                                                },
                                                                {
                                                                    "id": "736990637",
                                                                    "speaker": "斯露莎",
                                                                    "text": "总之，片面地断定花灵不如纯水精灵是不合道理的！这可不是因为我在偏袒米希尔哦。"
                                                                },
                                                                {
                                                                    "id": "736990638",
                                                                    "speaker": "派蒙",
                                                                    "text": "话说回来，祖尔宛为什么说接下来的训练对斯露莎来说刚刚好呢？这里看起来并没有什么特别之处，而且米希尔也不在…"
                                                                },
                                                                {
                                                                    "id": "736990639",
                                                                    "speaker": "派蒙",
                                                                    "text": "不过如果她在这里，斯露莎应该也不会好好跟她说话吧，毕竟她们两个在很多方面都正相反呢。",
                                                                    "choices": [
                                                                        {
                                                                            "id": "736990640",
                                                                            "text": "一个圆圆的一个刺刺的？",
                                                                            "response": [
                                                                                {
                                                                                    "id": "736990641",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "是这样没错…但我想说的不是这个啦！"
                                                                                },
                                                                                {
                                                                                    "id": "736990644",
                                                                                    "speaker": "斯露莎",
                                                                                    "text": "那呆子…如果她的存在，和她在这几百年的付出都被人遗忘了，那这一切还有什么意义呢？"
                                                                                },
                                                                                {
                                                                                    "id": "736990645",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "可能这就是祖尔宛希望斯露莎思考的问题吧？"
                                                                                },
                                                                                {
                                                                                    "id": "736990646",
                                                                                    "speaker": "斯露莎",
                                                                                    "text": "……"
                                                                                },
                                                                                {
                                                                                    "id": "736990647",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "看来斯露莎还需要一些时间呢。"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "736990642",
                                                                            "text": "米希尔并不需要「谒颂主」。",
                                                                            "response": [
                                                                                {
                                                                                    "id": "736990643",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "嗯，她还说，被遗忘才是好事。"
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "736990630",
                                                            "text": "我也觉得有点像…"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "736990616",
                                            "text": "虽然路不长，可是重复跑路好累…",
                                            "response": [
                                                {
                                                    "id": "736990617",
                                                    "speaker": "斯露莎",
                                                    "text": "欸？我还以为冒险家早就习惯这种生活了呢。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "736990607",
                            "text": "斯露莎才是主角嘛。",
                            "response": [
                                {
                                    "id": "736990608",
                                    "speaker": "斯露莎",
                                    "text": "这样才对嘛，哼哼。"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}