    "talks": [
        {
            "id": "2400301",
            "objective": "与韦吕对话",
            "dialogues": [
                {
                    "id": "240030101",
                    "speaker": "韦吕",
                    "text": "我这次藏的地方，你一定找不到！"
                },
                {
                    "id": "240030102",
                    "speaker": "奥雷勒",
                    "text": "如果你藏在那些地方，去找你的人就不是我，而是爸和妈了。"
                },
                {
                    "id": "240030103",
                    "speaker": "Player",
                    "text": "你们在做什么？"
                },
                {
                    "id": "240030104",
                    "speaker": "韦吕",
                    "text": "我正在和哥哥捉迷藏呢！但是…我藏的每一个地方他都知道…"
                },
                {
                    "id": "240030105",
                    "speaker": "奥雷勒",
                    "text": "韦吕…我们都在这里玩多久了，每一个能藏的角落都被你藏过了。"
                },
                {
                    "id": "240030106",
                    "speaker": "奥雷勒",
                    "text": "至于那些不能藏的地方…我已经和你说过很多次不能藏那里的原因了。"
                },
                {
                    "id": "240030107",
                    "speaker": "韦吕",
                    "text": "那些地方又没什么危险，爸和妈总是说得那么夸张…"
                },
                {
                    "id": "240030108",
                    "speaker": "奥雷勒",
                    "text": "但你藏到那种地方会把衣服和裤子弄脏或者弄破，爸和妈工作已经很辛苦了，别让他们再费这种心。"
                },
                {
                    "id": "240030109",
                    "speaker": "韦吕",
                    "text": "唔…好吧…",
                    "choices": [
                        {
                            "id": "240030110",
                            "text": "不然…我陪你们玩玩？",
                            "response": [
                                {
                                    "id": "240030112",
                                    "speaker": "韦吕",
                                    "text": "#真的吗？！{M#大哥哥}{F#大姐姐}，你愿意陪我玩吗？"
                                },
                                {
                                    "id": "240030113",
                                    "speaker": "奥雷勒",
                                    "text": "韦吕，别给人家添麻烦！抱歉，我弟弟满脑子都想着玩…",
                                    "choices": [
                                        {
                                            "id": "240030114",
                                            "text": "没关系，我正好有空。",
                                            "response": [
                                                {
                                                    "id": "240030116",
                                                    "speaker": "韦吕",
                                                    "text": "好欸！哥哥你看，人家都答应了！我一定躲得比你好！"
                                                },
                                                {
                                                    "id": "240030117",
                                                    "speaker": "奥雷勒",
                                                    "text": "#好吧…那就麻烦您了，{M#大哥哥}{F#大姐姐}。"
                                                },
                                                {
                                                    "id": "240030118",
                                                    "speaker": "奥雷勒",
                                                    "text": "韦吕，不要躲在我和你说过的那些地方，今天晚上爸妈会晚点回来，把衣服弄破了可没人帮你补。"
                                                },
                                                {
                                                    "id": "240030119",
                                                    "speaker": "韦吕",
                                                    "text": "知道啦，哥哥真唠叨…我先去躲着了，哥哥也一起玩嘛，快点快点。"
                                                },
                                                {
                                                    "id": "240030120",
                                                    "speaker": "奥雷勒",
                                                    "text": "你先去吧，我已经想好躲在哪了。"
                                                },
                                                {
                                                    "id": "240030121",
                                                    "speaker": "韦吕",
                                                    "text": "#真的？哥哥又吹牛…肯定第一个被{M#大哥哥}{F#大姐姐}找到！"
                                                },
                                                {
                                                    "id": "240030122",
                                                    "speaker": "Black Screen",
                                                    "text": "奥雷勒和韦吕先分别去躲了起来…"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "240030115",
                                            "text": "没关系，不算添麻烦。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "240030111",
                            "text": "我应该找不到你。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "2400302",
            "objective": "寻找奥雷勒和韦吕",
            "dialogues": [
                {
                    "id": "240030201",
                    "speaker": "韦吕",
                    "text": "呜哇！被找到了！是不是哥哥告诉你这个地方的呀…"
                },
                {
                    "id": "240030202",
                    "speaker": "韦吕",
                    "text": "好吧…算你厉害！我去集合点啦。"
                }
            ]
        },
        {
