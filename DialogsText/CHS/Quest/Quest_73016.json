    "talks": [
        {
            "id": "7301601",
            "objective": "前往荼诃之座寻找兰百梨迦",
            "dialogues": []
        },
        {
            "id": "7301602",
            "objective": "与兰百梨迦对话",
            "dialogues": []
        },
        {
            "id": "7301603",
            "objective": "与兰百梨迦对话",
            "dialogues": [
                {
                    "id": "730160301",
                    "speaker": "兰百梨迦",
                    "text": "那菈…和会飞的？"
                },
                {
                    "id": "730160302",
                    "speaker": "派蒙",
                    "text": "#对啦，我是会飞的派蒙，{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}是{NICKNAME}。"
                },
                {
                    "id": "730160303",
                    "speaker": "派蒙",
                    "text": "你应该就是兰百梨迦了吧，话说回来，你一点也不怕我们呢。"
                },
                {
                    "id": "730160304",
                    "speaker": "兰百梨迦",
                    "text": "金色的那菈，有兰般度的气息。"
                },
                {
                    "id": "730160305",
                    "speaker": "派蒙",
                    "text": "啊，这个嘛，的确是兰般度让我们来的…"
                },
                {
                    "id": "730160306",
                    "speaker": "兰百梨迦",
                    "text": "感受不到恶意。想对我下手，应该趁大铁块还能动的时候。"
                },
                {
                    "id": "730160307",
                    "speaker": "派蒙",
                    "text": "确实，这就叫「趁兰那罗之危」吗…不对不对，我们才不会做那种事啦。"
                },
                {
                    "id": "730160308",
                    "speaker": "兰百梨迦",
                    "text": "为什么不做？如果我是敌人，包夹敌人是好的方法，连动物捕猎时都会用。"
                },
                {
                    "id": "730160309",
                    "speaker": "派蒙",
                    "text": "唔…好有道理…"
                },
                {
                    "id": "730160310",
                    "speaker": "Player",
                    "text": "派蒙糊涂啦。"
                },
                {
                    "id": "730160311",
                    "speaker": "派蒙",
                    "text": "…总之，总之！我们肯定不会「趁兰那罗之危」就对了！"
                },
                {
                    "id": "730160312",
                    "speaker": "Player",
                    "text": "因为兰那罗是朋友。"
                },
                {
                    "id": "730160313",
                    "speaker": "派蒙",
                    "text": "#对对对，就是这个，因为兰那罗都是朋友！我和{NICKNAME}是不会做对不起朋友的事情的！"
                },
                {
                    "id": "730160314",
                    "speaker": "兰百梨迦",
                    "text": "哼。"
                },
                {
                    "id": "730160315",
                    "speaker": "派蒙",
                    "text": "呃…怎么感觉他好像很不满意的样子…",
                    "choices": [
                        {
                            "id": "730160316",
                            "text": "派蒙没有留下好的第一印象。",
                            "response": [
                                {
                                    "id": "730160317",
                                    "speaker": "派蒙",
                                    "text": "可是我也没觉得自己做错了什么呀…唔…兰那罗的脾气真难捉摸…"
                                },
                                {
                                    "id": "730160320",
                                    "speaker": "派蒙",
                                    "text": "对了，兰般度说过，兰百梨迦的「兰迦拉梨」非常厉害。刚才他能够击败遗迹守卫，一定就是靠的「兰迦拉梨」吧！"
                                },
                                {
                                    "id": "730160321",
                                    "speaker": "兰百梨迦",
                                    "text": "派蒙知道兰迦拉梨？"
                                },
                                {
                                    "id": "730160322",
                                    "speaker": "派蒙",
                                    "text": "…哦、哦！我当然知道啦！就是…就是那个嘛！很厉害很厉害的…什么能力！"
                                },
                                {
                                    "id": "730160323",
                                    "speaker": "兰百梨迦",
                                    "text": "哼。"
                                },
                                {
                                    "id": "730160324",
                                    "speaker": "派蒙",
                                    "text": "呜哇！感觉又被瞧不起了…"
                                },
                                {
                                    "id": "730160325",
                                    "speaker": "Player",
                                    "text": "还是说正事吧。"
                                },
                                {
                                    "id": "730160326",
                                    "speaker": "派蒙",
                                    "text": "嗯…我们是来帮忙治好法留纳神机的！这里应该也有法留纳神机的「枝」和「叶」吧，不过好像没看到呢。"
                                },
                                {
                                    "id": "730160327",
                                    "speaker": "兰百梨迦",
                                    "text": "什么「枝」和「叶」，更像是「根」才对。"
                                },
                                {
                                    "id": "730160328",
                                    "speaker": "派蒙",
                                    "text": "诶？是这样吗？可是兰般度说…"
                                },
                                {
                                    "id": "730160329",
                                    "speaker": "兰百梨迦",
                                    "text": "有了遍布桓那的「根系」，法留纳神机才能从桓那获得力量。"
                                },
                                {
                                    "id": "730160330",
                                    "speaker": "派蒙",
                                    "text": "哦…好像也有点道理…"
                                },
                                {
                                    "id": "730160331",
                                    "speaker": "兰百梨迦",
                                    "text": "而且，「根」在地下。"
                                },
                                {
                                    "id": "730160332",
                                    "speaker": "兰百梨迦",
                                    "text": "这里的石头和铁块，不属于兰那罗。要下去，得先打败铁块。铁块很强，但是金色的那菈也不弱。"
                                },
                                {
                                    "id": "730160333",
                                    "speaker": "派蒙",
                                    "text": "#那是当然，{NICKNAME}已经不知道打败过多少大铁块啦。"
                                },
                                {
                                    "id": "730160334",
                                    "speaker": "兰百梨迦",
                                    "text": "哦？那就让兰百梨迦也见识一下那菈的本领！"
                                },
                                {
                                    "id": "730160335",
                                    "speaker": "派蒙",
                                    "text": "诶？！他怎么钻进土里了…啊！难道是已经去遗迹守卫那边了吗？"
                                },
                                {
                                    "id": "730160336",
                                    "speaker": "派蒙",
                                    "text": "#{NICKNAME}，我们快跟上他吧！"
                                }
                            ]
                        },
                        {
                            "id": "730160318",
                            "text": "可能他对谁都是这样。",
                            "response": [
                                {
                                    "id": "730160319",
                                    "speaker": "派蒙",
                                    "text": "怎么会这样呢？明明外表这样可爱，脾气却这么坏…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7301604",
            "objective": "击败遗迹守卫",
            "dialogues": []
        },
        {
            "id": "7301605",
            "objective": "击败遗迹守卫",
            "dialogues": []
        },
        {
            "id": "7301606",
            "objective": "击败遗迹守卫",
            "dialogues": []
        },
        {
            "id": "7301616",
            "objective": "与兰百梨迦对话",
            "dialogues": [
                {
                    "id": "730161601",
                    "speaker": "兰百梨迦",
                    "text": "哼。的确有些本事。"
                },
                {
                    "id": "730161602",
                    "speaker": "派蒙",
                    "text": "他夸我们了欸！嘿嘿。"
                },
                {
                    "id": "730161603",
                    "speaker": "兰百梨迦",
                    "text": "现在可以准备去地下了，快点跟上吧。"
                },
                {
                    "id": "730161604",
                    "speaker": "派蒙",
                    "text": "好欸，我们快跟上兰百梨迦吧。"
                }
            ]
        },
        {
            "id": "7301607",
            "objective": "跟上兰百梨迦",
            "dialogues": [
                {
                    "id": "730160701",
                    "speaker": "兰百梨迦",
                    "text": "我们已经打败了大铁块，现在只要让水流走，就可以下到地下了。"
                },
                {
                    "id": "730160702",
                    "speaker": "兰百梨迦",
                    "text": "但是，很久没有来，全都和过去不一样了，说不定地下也有大铁块，能感受到铁的味道，是不好的味道，所以要小心。"
                },
                {
                    "id": "730160703",
                    "speaker": "兰百梨迦",
                    "text": "#那菈{NICKNAME}是有本领的，不用担心。但是派蒙，和兰那库拉一样弱，小心被蘑菇吞掉。"
                },
                {
                    "id": "730160704",
                    "speaker": "派蒙",
                    "text": "唔…是兰百梨迦太强啦！我们之前也遇到过很多兰那罗，应该还没有谁能一击就让遗迹守卫倒下的吧…"
                },
                {
                    "id": "730160705",
                    "speaker": "兰百梨迦",
                    "text": "派蒙对兰那罗知道得太少，如果是兰帝裟，闭上眼睛再睁开的工夫，大铁块就被解决了。"
                },
                {
                    "id": "730160706",
                    "speaker": "兰百梨迦",
                    "text": "兰帝裟的兰迦拉梨，过去是顶厉害的。"
                },
                {
                    "id": "730160707",
                    "speaker": "派蒙",
                    "text": "过去？那现在呢？"
                },
                {
                    "id": "730160708",
                    "speaker": "兰百梨迦",
                    "text": "现在，兰帝裟不在现在，所以兰百梨迦才要更努力修炼兰迦拉梨。"
                },
                {
                    "id": "730160709",
                    "speaker": "派蒙",
                    "text": "要是我也能学会「兰迦拉梨」…",
                    "choices": [
                        {
                            "id": "730160710",
                            "text": "那以后战斗就交给派蒙了。",
                            "response": [
                                {
                                    "id": "730160711",
                                    "speaker": "派蒙",
                                    "text": "#嘿嘿，就让我来保护{NICKNAME}吧！"
                                },
                                {
                                    "id": "730160712",
                                    "speaker": "Player",
                                    "text": "派蒙，加油！"
                                },
                                {
                                    "id": "730160713",
                                    "speaker": "派蒙",
                                    "text": "交给我吧！全都可以交给我！"
                                },
                                {
                                    "id": "730160718",
                                    "speaker": "兰百梨迦",
                                    "text": "派蒙很会做梦，不知道是好事还是坏事。但是现在我们要找到石头的机关，让水流走，否则没办法到地下。"
                                },
                                {
                                    "id": "730160719",
                                    "speaker": "兰百梨迦",
                                    "text": "兰那罗可以钻进土里，不能钻进水里。"
                                },
                                {
                                    "id": "730160720",
                                    "speaker": "派蒙",
                                    "text": "#嗯，{NICKNAME}，我们在附近找找看吧！"
                                }
                            ]
                        },
                        {
                            "id": "730160714",
                            "text": "派蒙应该学不会的。",
                            "response": [
                                {
                                    "id": "730160715",
                                    "speaker": "派蒙",
                                    "text": "我只要想学肯定也能学会的啦！"
                                },
                                {
                                    "id": "730160716",
                                    "speaker": "Player",
                                    "text": "会这样说的人多半都…"
                                },
                                {
                                    "id": "730160717",
                                    "speaker": "派蒙",
                                    "text": "要不等我们到了安全的地方，吃过饭，休息好了，再拜托兰百梨迦教我？"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7301608",
            "objective": "找到并启动机关",
            "dialogues": []
        },
        {
            "id": "7301609",
            "objective": "和兰百梨迦一起找到「枝」",
            "dialogues": []
        },
        {
            "id": "7301610",
            "objective": "与兰百梨迦对话",
            "dialogues": [
                {
                    "id": "730161001",
                    "speaker": "派蒙",
                    "text": "好像…好像都是坏掉的？都不会动欸！吓、吓死我了。"
                },
                {
                    "id": "730161002",
                    "speaker": "派蒙",
                    "text": "哼哼，什么嘛，不就是些生锈的铁块而已。"
                },
                {
                    "id": "730161003",
                    "speaker": "兰百梨迦",
                    "text": "现在的桓那是危险的桓那，派蒙大意，会吃大亏。"
                },
                {
                    "id": "730161004",
                    "speaker": "派蒙",
                    "text": "唔…兰百梨迦好严格哦。"
                },
                {
                    "id": "730161005",
                    "speaker": "Player",
                    "text": "是派蒙太散漫了。"
                },
                {
                    "id": "730161006",
                    "speaker": "派蒙",
                    "text": "是这样吗？那…那我也像兰百梨迦那样严格的话，也能像他一样强吗？"
                },
                {
                    "id": "730161007",
                    "speaker": "Player",
                    "text": "派蒙应该对自己严格而不是对别人。"
                },
                {
                    "id": "730161008",
                    "speaker": "派蒙",
                    "text": "好哦，那就从明天开始对自己严格要求吧！"
                },
                {
                    "id": "730161009",
                    "speaker": "派蒙",
                    "text": "总之，既然石头的「枝」就在这里，接下来只要…"
                },
                {
                    "id": "730161010",
                    "speaker": "兰百梨迦",
                    "text": "找到三个石头都朝向这里就可以了。"
                },
                {
                    "id": "730161011",
                    "speaker": "派蒙",
                    "text": "被、被抢答了…"
                },
                {
                    "id": "730161012",
                    "speaker": "派蒙",
                    "text": "说起来，兰百梨迦的说话风格和兰般度差好多，完全不会用比喻。",
                    "choices": [
                        {
                            "id": "730161013",
                            "text": "不过这样更好懂。",
                            "response": [
                                {
                                    "id": "730161014",
                                    "speaker": "派蒙",
                                    "text": "直来直去确实很明白呢！"
                                },
                                {
                                    "id": "730161017",
                                    "speaker": "兰百梨迦",
                                    "text": "因为兰般度想很多，兰百梨迦想很少。我只懂保护。"
                                },
                                {
                                    "id": "730161018",
                                    "speaker": "兰百梨迦",
                                    "text": "兰般度曾经和那菈法留纳一起保护桓那，他们一起赶走了黑色的不祥的污泥，治好了法留纳神机。"
                                },
                                {
                                    "id": "730161019",
                                    "speaker": "兰百梨迦",
                                    "text": "#那菈法留纳离开桓那已经很久，无忧节，{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}或许也不会来了。"
                                },
                                {
                                    "id": "730161020",
                                    "speaker": "兰百梨迦",
                                    "text": "兰般度一定知道。已经不知道过去了多久，时间足够一粒种子长成参天大树，离开桓那的那菈不会再回来了。"
                                },
                                {
                                    "id": "730161021",
                                    "speaker": "兰百梨迦",
                                    "text": "但是兰般度想要又一次治好法留纳神机，为了桓那，为了无忧节，也为那菈法留纳。"
                                },
                                {
                                    "id": "730161022",
                                    "speaker": "派蒙",
                                    "text": "原来是这样…"
                                },
                                {
                                    "id": "730161023",
                                    "speaker": "兰百梨迦",
                                    "text": "#兰百梨迦没有见过那菈法留纳，但是{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}的事，桓那知道。"
                                },
                                {
                                    "id": "730161024",
                                    "speaker": "兰百梨迦",
                                    "text": "兰百梨迦不会像兰般度一样想很多，只知道，兰百梨迦足够强，可以保护兰那罗，也可以保护桓那。"
                                },
                                {
                                    "id": "730161025",
                                    "speaker": "兰百梨迦",
                                    "text": "那菈法留纳不在了，兰那罗也可以治好法留纳神机。"
                                },
                                {
                                    "id": "730161026",
                                    "speaker": "派蒙",
                                    "text": "#嗯！而且还有我和{NICKNAME}帮忙呢！"
                                },
                                {
                                    "id": "730161027",
                                    "speaker": "兰百梨迦",
                                    "text": "#这里的铁的味道，不对劲。那菈{NICKNAME}，就交给你了。我在这里等你们。"
                                },
                                {
                                    "id": "730161028",
                                    "speaker": "派蒙",
                                    "text": "不知道兰百梨迦感知到了什么…不过森林的事情，兰那罗肯定知道得更清楚吧！"
                                },
                                {
                                    "id": "730161029",
                                    "speaker": "派蒙",
                                    "text": "#{NICKNAME}，总之，我们在附近找找三个分散的「叶」吧。"
                                }
                            ]
                        },
                        {
                            "id": "730161015",
                            "text": "有点不像兰那罗…",
                            "response": [
                                {
                                    "id": "730161016",
                                    "speaker": "派蒙",
                                    "text": "不过，什么才叫「像兰那罗」呢？唔…搞不懂。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7301613",
            "objective": "让三个「叶」都朝向「枝」的方向",
            "dialogues": [
                {
                    "id": "730161301",
                    "speaker": "兰百梨迦",
                    "text": "铁的味道太多了，不好。"
                }
            ]
        },
        {
            "id": "7301611",
            "objective": "击败遗迹重机",
            "dialogues": []
        },
        {
            "id": "7301615",
            "objective": "与兰百梨迦对话",
            "dialogues": [
                {
                    "id": "730161501",
                    "speaker": "派蒙",
                    "text": "呼…真的吓到了，幸好有兰百梨迦帮忙。"
                },
                {
                    "id": "730161502",
                    "speaker": "兰百梨迦",
                    "text": "早说过，派蒙大意，会吃大亏。"
                },
                {
                    "id": "730161503",
                    "speaker": "派蒙",
                    "text": "唔…我知道错啦。"
                },
                {
                    "id": "730161504",
                    "speaker": "Player",
                    "text": "遗迹里有守卫，那就一定是会动的。"
                },
                {
                    "id": "730161505",
                    "speaker": "派蒙",
                    "text": "说的也是，这就叫「名副其实」吗？毕竟对它们来说，我们才是外来者呢。"
                },
                {
                    "id": "730161506",
                    "speaker": "兰百梨迦",
                    "text": "#那菈{NICKNAME}和派蒙是桓那的外来者，兰百梨迦不是，所以是大大铁块不懂道理。"
                },
                {
                    "id": "730161507",
                    "speaker": "兰百梨迦",
                    "text": "大大铁块不懂道理，兰百梨迦就让它懂道理。"
                },
                {
                    "id": "730161508",
                    "speaker": "派蒙",
                    "text": "呜…派蒙会当懂道理的好孩子的！"
                },
                {
                    "id": "730161509",
                    "speaker": "Player",
                    "text": "派蒙要说话算话哦。"
                },
                {
                    "id": "730161510",
                    "speaker": "派蒙",
                    "text": "那当然啦！明天…不，现在就开始！"
                },
                {
                    "id": "730161511",
                    "speaker": "兰百梨迦",
                    "text": "#这里的石头，只有兰那罗才能唤醒它。那菈{NICKNAME}和派蒙，之后就交给兰百梨迦了。"
                },
                {
                    "id": "730161512",
                    "speaker": "派蒙",
                    "text": "哦！"
                },
                {
                    "id": "730161513",
                    "speaker": "派蒙",
                    "text": "这样离治好法留纳神机又近了一步呢！等治好了法留纳神机，水天丛林就不会再飘着那么多孢子了吧…想起来都鼻子痒痒的…"
                },
                {
                    "id": "730161514",
                    "speaker": "兰百梨迦",
                    "text": "法留纳神机会净化雨水，不会再有黑色的雨，也不会再有这么多「孢子」。"
                },
                {
                    "id": "730161515",
                    "speaker": "兰百梨迦",
                    "text": "不过蘑菇…应该还是会有。派蒙要小心，不要像兰那库拉一样，差点被蘑菇吞掉。"
                },
                {
                    "id": "730161516",
                    "speaker": "派蒙",
                    "text": "嗯…我会小心的！"
                },
                {
                    "id": "730161517",
                    "speaker": "兰百梨迦",
                    "text": "#这里已经不需要兰百梨迦了，我会回「歇脚处」找兰般度。那菈{NICKNAME}和派蒙，要不要一起回去？",
                    "choices": [
                        {
                            "id": "730161518",
                            "text": "那我们一起走吧。",
                            "response": [
                                {
                                    "id": "730161519",
                                    "speaker": "兰百梨迦",
                                    "text": "嗯。桓那危险，一起走安全。"
                                }
                            ]
                        },
                        {
                            "id": "730161520",
                            "text": "还有其他事。",
                            "response": [
                                {
                                    "id": "730161521",
                                    "speaker": "兰百梨迦",
                                    "text": "#那菈{NICKNAME}和派蒙要小心，不要大意。兰穆护昆达看顾你们。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
