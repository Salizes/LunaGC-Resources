    "talks": [
        {
            "id": "4002110",
            "objective": "等待至翌日8点至12点",
            "dialogues": []
        },
        {
            "id": "4002101",
            "objective": "与辛焱碰面",
            "dialogues": [
                {
                    "id": "400210101",
                    "speaker": "辛焱",
                    "text": "旅行者，派蒙！"
                },
                {
                    "id": "400210102",
                    "speaker": "辛焱",
                    "text": "刚才九条裟罗来了，就在那边。"
                },
                {
                    "id": "400210103",
                    "speaker": "派蒙",
                    "text": "她这去而复返的样子，是真对我们放心不下吧…警惕心很重呢。"
                },
                {
                    "id": "400210104",
                    "speaker": "Player",
                    "text": "是认真负责的表现啦。"
                },
                {
                    "id": "400210105",
                    "speaker": "辛焱",
                    "text": "情况有些复杂，我们先去跟她沟通吧。"
                }
            ]
        },
        {
            "id": "4002102",
            "objective": "与九条裟罗对话",
            "dialogues": [
                {
                    "id": "400210201",
                    "speaker": "九条裟罗",
                    "text": "三位，这段时间有劳你们了。"
                },
                {
                    "id": "400210202",
                    "speaker": "九条裟罗",
                    "text": "我带人手过来了，可以说，最危急的时刻已然过去。之后，我们只需扼守这条要道就能有效防备魔物，如有逃窜者，也可将它们封堵在荒海一带。"
                },
                {
                    "id": "400210203",
                    "speaker": "九条裟罗",
                    "text": "先前我听见秘境内有巨大的响声，恐怕这里面有大量机关…我们正在筹备，打算等一个合适的时机举兵攻入。"
                },
                {
                    "id": "400210204",
                    "speaker": "派蒙",
                    "text": "你们不打算驻扎在离秘境更近的地方吗？"
                },
                {
                    "id": "400210205",
                    "speaker": "九条裟罗",
                    "text": "上次行动时，武士们没想到要跟秘境保持足够的距离。魔物突袭，他们只能仓皇后撤。"
                },
                {
                    "id": "400210206",
                    "speaker": "九条裟罗",
                    "text": "一次是意外，两次是失误。我不会允许这种事再次发生。"
                },
                {
                    "id": "400210207",
                    "speaker": "派蒙",
                    "text": "原来是这样…"
                },
                {
                    "id": "400210208",
                    "speaker": "Player",
                    "text": "（正好，给了我们机会。）"
                },
                {
                    "id": "400210209",
                    "speaker": "九条裟罗",
                    "text": "稍后我将返回九条阵屋，统筹其他地区的防务。"
                },
                {
                    "id": "400210210",
                    "speaker": "九条裟罗",
                    "text": "虽然来得晚了些，但天领奉行已接手这里，感谢三位鼎力相助。承诺的报酬，我也记着。"
                },
                {
                    "id": "400210211",
                    "speaker": "九条裟罗",
                    "text": "辛焱小姐，请拿着这封信，里面有我亲自为你开具的「通行凭证」。"
                },
                {
                    "id": "400210223",
                    "speaker": "九条裟罗",
                    "text": "我为你申请了最长的停留时限，希望你能利用这段时间在稻妻好好游览一番。"
                },
                {
                    "id": "400210212",
                    "speaker": "九条裟罗",
                    "text": "此外我还为你安排了食宿，等回到城里，你直接照信中指示前往下榻处即可。"
                },
                {
                    "id": "400210213",
                    "speaker": "辛焱",
                    "text": "天哪！这得算天降横财了吧？食宿全免，畅游稻妻！"
                },
                {
                    "id": "400210214",
                    "speaker": "九条裟罗",
                    "text": "不必客气，理应如此。"
                },
                {
                    "id": "400210215",
                    "speaker": "辛焱",
                    "text": "谢谢你啦。看你最近这么忙，也不知道什么时候才能闲下来…要是你休假时我还在稻妻，请来看看我的街演吧！"
                },
                {
                    "id": "400210216",
                    "speaker": "九条裟罗",
                    "text": "实不相瞒，我对诗歌音律兴趣不大。但你帮了天领奉行许多，我想…有机会的话，我会去的。"
                },
                {
                    "id": "400210217",
                    "speaker": "派蒙",
                    "text": "这么一来，辛焱最操心的事就解决啦！"
                },
                {
                    "id": "400210218",
                    "speaker": "辛焱",
                    "text": "不不，最让人操心的是「式大将」才对吧！接下来就无关我的个人利益了…作为朋友，我还得回去帮它。"
                },
                {
                    "id": "400210219",
                    "speaker": "辛焱",
                    "text": "还有那位小哥，旅行者，我们肯定得去救他吧？",
                    "choices": [
                        {
                            "id": "400210220",
                            "text": "虽然他应该没事…",
                            "response": [
                                {
                                    "id": "400210222",
                                    "speaker": "辛焱",
                                    "text": "那走吧，我们偷偷去找「式大将」会合！"
                                }
                            ]
                        },
                        {
                            "id": "400210221",
                            "text": "但也不能放着不管。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "4002103",
            "objective": "前往「诀箓阴阳寮」",
            "dialogues": [
                {
                    "id": "400210301",
                    "speaker": "「式大将」",
                    "text": "辛焱，旅行者，派蒙！"
                },
                {
                    "id": "400210302",
                    "speaker": "「式大将」",
                    "text": "刚才有位女将领带着一些人手到这附近侦察。"
                },
                {
                    "id": "400210303",
                    "speaker": "派蒙",
                    "text": "她是天领奉行的人，九条裟罗。"
                },
                {
                    "id": "400210304",
                    "speaker": "「式大将」",
                    "text": "九条裟罗…天领奉行有这么一号人吗？"
                },
                {
                    "id": "400210305",
                    "speaker": "「式大将」",
                    "text": "我似乎听说过天领奉行主将的名字，是一位男性，叫九条…呃，什么来着？"
                },
                {
                    "id": "400210306",
                    "speaker": "「式大将」",
                    "text": "有些记不清了，但我想起了一些琐事。我记得，晴之介和那位天领奉行的主将下过棋。"
                },
                {
                    "id": "400210307",
                    "speaker": "派蒙",
                    "text": "这个晴之介，莫非还是个有头有脸的人物？"
                },
                {
                    "id": "400210308",
                    "speaker": "辛焱",
                    "text": "闲话稍后再说吧，趁没人发现，我们赶紧溜到阴阳寮里去。"
                },
                {
                    "id": "400210309",
                    "speaker": "派蒙",
                    "text": "对哦，还要找那个丢了的家伙呢！快走快走！"
                },
                {
                    "id": "400210310",
                    "speaker": "「式大将」",
                    "text": "好，各位，请随我来。"
                }
            ]
        },
        {
            "id": "4002113",
            "objective": "与「式大将」碰面",
            "dialogues": []
        },
        {
            "id": "4002104",
            "objective": "进入「凶煞折行之寮」",
            "dialogues": []
        },
        {
            "id": "4002105",
            "objective": "与公子对话",
            "dialogues": [
                {
                    "id": "400210501",
                    "speaker": "派蒙",
                    "text": "哇！你在这里啊！"
                },
                {
                    "id": "400210502",
                    "speaker": "「公子」",
                    "text": "哟，都来了吗。让我等了好久啊。"
                },
                {
                    "id": "400210503",
                    "speaker": "「公子」",
                    "text": "你们错过了一场好戏，实在可惜。"
                },
                {
                    "id": "400210504",
                    "speaker": "派蒙",
                    "text": "这家伙，状态看起来还不错嘛，看来没受伤。"
                },
                {
                    "id": "400210505",
                    "speaker": "「公子」",
                    "text": "嗯？你们担心我了吗？",
                    "choices": [
                        {
                            "id": "400210506",
                            "text": "并没有。",
                            "response": [
                                {
                                    "id": "400210507",
                                    "speaker": "「公子」",
                                    "text": "看来你很信得过我的实力啊。"
                                },
                                {
                                    "id": "400210510",
                                    "speaker": "「公子」",
                                    "text": "作为伙伴兼老对手，你一定知道的，这种出其不意的战斗场合最合我胃口。"
                                },
                                {
                                    "id": "400210511",
                                    "speaker": "「公子」",
                                    "text": "秘境重组期间，房间会上下移动，魔物也被带着四处乱窜。嗯！这几天，我打得很尽兴。"
                                },
                                {
                                    "id": "400210512",
                                    "speaker": "「公子」",
                                    "text": "还找到一些「拓本」，就是「式大将」需要的那种。里面应该藏有它的记忆和力量。"
                                },
                                {
                                    "id": "400210513",
                                    "speaker": "辛焱",
                                    "text": "正所谓来得早不如来得巧，赶快回收它们吧，「式大将」！"
                                }
                            ]
                        },
                        {
                            "id": "400210508",
                            "text": "只有一点点。",
                            "response": [
                                {
                                    "id": "400210509",
                                    "speaker": "「公子」",
                                    "text": "真的？能让你操一点心，我还是挺有面子的嘛。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "4002115",
            "objective": "进入「凶煞折行之寮」",
            "dialogues": []
        },
        {
            "id": "4002111",
            "objective": "回收「式大将」的「拓本」",
            "dialogues": []
        },
        {
            "id": "4002114",
            "objective": "与「式大将」对话",
            "dialogues": [
                {
                    "id": "400211401",
                    "speaker": "「式大将」",
                    "text": "「拓本」里残留的符法之力有限，我能找回的记忆也有限。"
                },
                {
                    "id": "400211402",
                    "speaker": "「公子」",
                    "text": "还不够吗？那就按计划，继续朝秘境深处前进吧。"
                },
                {
                    "id": "400211403",
                    "speaker": "派蒙",
                    "text": "不对不对，秘境重组过，我们好不容易找到的路线早就没用啦！"
                },
                {
                    "id": "400211404",
                    "speaker": "「式大将」",
                    "text": "关于这一点，请不必担心，秘境的重组也是有规律的，我隐约记得方向。"
                },
                {
                    "id": "400211405",
                    "speaker": "「式大将」",
                    "text": "朝那边走，应该不会有错。"
                },
                {
                    "id": "400211406",
                    "speaker": "派蒙",
                    "text": "等一下，我有问题！「式大将」，你刚才说「拓本」里残留的力量不够，记忆恢复得也很有限。"
                },
                {
                    "id": "400211407",
                    "speaker": "派蒙",
                    "text": "那你怎么知道自己走的路就是正确的呢？"
                },
                {
                    "id": "400211408",
                    "speaker": "派蒙",
                    "text": "上次跟着你穿过那道门之后，我们就被送出了秘境…说明这个地方的门并不一定都是真门！"
                },
                {
                    "id": "400211409",
                    "speaker": "派蒙",
                    "text": "要是你分辨不清把我们带到了危险的地方，岂不是完蛋了。"
                },
                {
                    "id": "400211410",
                    "speaker": "「式大将」",
                    "text": "你有这样的担心并不奇怪，可惜我还给不出令人信服的答案…"
                },
                {
                    "id": "400211411",
                    "speaker": "「式大将」",
                    "text": "如果我说，这是作为「寮司」的直觉，你能接受吗？"
                },
                {
                    "id": "400211412",
                    "speaker": "派蒙",
                    "text": "总感觉心里好没底啊…"
                },
                {
                    "id": "400211413",
                    "speaker": "辛焱",
                    "text": "派蒙的问题不无道理，但我们也只能相信「式大将」这个领路人，否则，难道要一直在这里等着吗？"
                },
                {
                    "id": "400211414",
                    "speaker": "辛焱",
                    "text": "而且，万一秘境再次动起来…到那时，说不定我们就更没方向了。"
                },
                {
                    "id": "400211415",
                    "speaker": "「公子」",
                    "text": "嗯，出去一趟回来，变得心急了些。"
                },
                {
                    "id": "400211416",
                    "speaker": "「公子」",
                    "text": "我猜猜…是遇到什么麻烦了吧？"
                },
                {
                    "id": "400211417",
                    "speaker": "「公子」",
                    "text": "据我所知，现阶段稻妻的局势还没完全稳定下来。像这样的秘境应该归天领奉行处理，可天领奉行人手短缺，不足以控住全局。"
                },
                {
                    "id": "400211418",
                    "speaker": "「公子」",
                    "text": "所以，你们来这里是受人所托，而且很有可能就是受天领奉行所托。你们领了他们的命令。"
                },
                {
                    "id": "400211419",
                    "speaker": "「公子」",
                    "text": "以那些人的作风，恐怕会直接杀入秘境，碾碎一切。要是在那之前找不回「式大将」的记忆，它就没有机会了。"
                },
                {
                    "id": "400211420",
                    "speaker": "「公子」",
                    "text": "所以你变得有些心急，对吗？"
                },
                {
                    "id": "400211421",
                    "speaker": "Player",
                    "text": "你果然在调查稻妻。"
                },
                {
                    "id": "400211422",
                    "speaker": "派蒙",
                    "text": "这一切还是你们的阴谋吗！"
                },
                {
                    "id": "400211423",
                    "speaker": "「公子」",
                    "text": "我确实在调查一些事，不过不是你想的那些。这件事稍后再说，现在先解决眼前的问题吧。"
                },
                {
                    "id": "400211424",
                    "speaker": "「公子」",
                    "text": "旅行者，我跟你有交情，没必要在这些地方故意撒谎。抵达稻妻之后，我在周边地区发现了魔物的踪迹，自然就追到这座秘境里来了。"
                },
                {
                    "id": "400211425",
                    "speaker": "「公子」",
                    "text": "这里就像是一座为斗士而设的训练场…只有战斗，只有厮杀。在这里，我能尽情释放自己，尽情享受！"
                },
                {
                    "id": "400211426",
                    "speaker": "「公子」",
                    "text": "这话可能不太好听，但除了旅行者和派蒙，我跟另外两位是第一次见。你们应该不知道，我并不是那么在乎立场的人。"
                },
                {
                    "id": "400211427",
                    "speaker": "「公子」",
                    "text": "善恶、正邪、使命…这些事真有那么重要吗？能比极致的战斗，酣畅的厮杀更吸引人吗？"
                },
                {
                    "id": "400211428",
                    "speaker": "辛焱",
                    "text": "果然是好战之人。小哥，那你的意思是…？"
                },
                {
                    "id": "400211429",
                    "speaker": "「公子」",
                    "text": "我没什么特别的想法，只是告诉你们，尽管前进吧，别畏惧路上的魔物。"
                },
                {
                    "id": "400211430",
                    "speaker": "「公子」",
                    "text": "假如你们无法全力以赴，我会代替你们碾碎一切。假如你们对此有所抗拒，我将扛下一切杀戮之事。"
                },
                {
                    "id": "400211431",
                    "speaker": "「公子」",
                    "text": "因为…战斗才是我最擅长的事。"
                },
                {
                    "id": "400211432",
                    "speaker": "辛焱",
                    "text": "……"
                },
                {
                    "id": "400211433",
                    "speaker": "派蒙",
                    "text": "别、别都看我啊！那我走，我走行了吧！"
                }
            ]
        },
        {
            "id": "4002116",
            "objective": "进入「凶煞折行之寮」",
            "dialogues": []
        },
        {
            "id": "4002106",
            "objective": "前往「凶煞折行之寮」的深处",
            "dialogues": []
        },
        {
            "id": "4002117",
            "objective": "进入「凶煞折行之寮」",
            "dialogues": []
        },
        {
            "id": "4002107",
            "objective": "回收「式大将」的「拓本」",
            "dialogues": []
        },
        {
            "id": "4002108",
            "objective": "与「式大将」对话",
            "dialogues": [
                {
                    "id": "400210801",
                    "speaker": "「式大将」",
                    "text": "这座房间已经非常接近阴阳寮的最深处了。我记得…我和晴之介在这里停留了很久。"
                },
                {
                    "id": "400210802",
                    "speaker": "「式大将」",
                    "text": "我们一直在观察那些来自稻妻各地的武人。他们喝酒庆祝时，总是高声呼喊着：「我们也拥有战胜强大魔物的力量了！」"
                },
                {
                    "id": "400210803",
                    "speaker": "辛焱",
                    "text": "莫非，你和惟神晴之介，是带着那些武士前来铲除魔物的？"
                },
                {
                    "id": "400210804",
                    "speaker": "「式大将」",
                    "text": "有这种可能，但也不止一种可能。"
                },
                {
                    "id": "400210805",
                    "speaker": "「式大将」",
                    "text": "换句话说，那样的景象也有可能是晴之介故意安排的。为了重新掌握失控的阴阳寮，他征召这些武士，命令他们进入秘境铲除魔物。"
                },
                {
                    "id": "400210806",
                    "speaker": "派蒙",
                    "text": "「式大将」是在猜测达达利亚的想法吗？"
                },
                {
                    "id": "400210807",
                    "speaker": "「公子」",
                    "text": "什么嘛，我也不是每次都往坏处想的啊！"
                },
                {
                    "id": "400210808",
                    "speaker": "「式大将」",
                    "text": "只是合理全面的猜测而已，并不是要冒犯几位。"
                },
                {
                    "id": "400210809",
                    "speaker": "「式大将」",
                    "text": "我的记忆还不完整，但缺失的部分越来越少，应该就快要全部复原了。"
                },
                {
                    "id": "400210810",
                    "speaker": "「式大将」",
                    "text": "而且，我有种感觉…继续向前的话，我们说不定真会遇见晴之介。"
                },
                {
                    "id": "400210811",
                    "speaker": "派蒙",
                    "text": "这座阴阳寮也不是最近才建成的吧？那他一直在里面吗？呜哇…",
                    "choices": [
                        {
                            "id": "400210812",
                            "text": "「式大将」。",
                            "response": [
                                {
                                    "id": "400210814",
                                    "speaker": "辛焱",
                                    "text": "旅行者？等一下，你该不会…"
                                },
                                {
                                    "id": "400210815",
                                    "speaker": "Player",
                                    "text": "有些话，需要由我来说。"
                                },
                                {
                                    "id": "400210816",
                                    "speaker": "「式大将」",
                                    "text": "看几位严肃的神情…应该是有很重要的事吧。"
                                },
                                {
                                    "id": "400210817",
                                    "speaker": "派蒙",
                                    "text": "我说，太严肃也不好吧？这里本来就有点阴森了，再这么一来，像在内斗一样！还是我来说吧。"
                                },
                                {
                                    "id": "400210818",
                                    "speaker": "派蒙",
                                    "text": "是这样的，最开始，我们听说秘境里有魔物逃出来，就和天领奉行的武士们一起赶到这里。"
                                },
                                {
                                    "id": "400210819",
                                    "speaker": "派蒙",
                                    "text": "我们遇到你的时候，你完全不知道秘境的来历，也不知道自己是为何而生…但我们相信那时你真的一无所知。"
                                },
                                {
                                    "id": "400210820",
                                    "speaker": "派蒙",
                                    "text": "就算不相信你，我们也要相信辛焱。辛焱认可了你，我们就和你一起行动。"
                                },
                                {
                                    "id": "400210821",
                                    "speaker": "Player",
                                    "text": "嗯。"
                                },
                                {
                                    "id": "400210822",
                                    "speaker": "派蒙",
                                    "text": "随着探索，我们不断深入秘境，眼看就要找到真相了…"
                                },
                                {
                                    "id": "400210873",
                                    "speaker": "派蒙",
                                    "text": "可直到现在，我们也无法确定这座秘境是不是为了某种…邪恶的目的…而被制造出来。"
                                },
                                {
                                    "id": "400210823",
                                    "speaker": "派蒙",
                                    "text": "一只箱子里可能藏着宝藏也可能藏着灾难，那我们就是到了开箱前的最后时刻呀！总不能毫无准备地打开它吧！",
                                    "choices": [
                                        {
                                            "id": "400210824",
                                            "text": "如果惟神包藏祸心…",
                                            "response": [
                                                {
                                                    "id": "400210827",
                                                    "speaker": "辛焱",
                                                    "text": "……"
                                                },
                                                {
                                                    "id": "400210828",
                                                    "speaker": "辛焱",
                                                    "text": "我不喜欢看别人做没有退路的选择，但…就像旅行者说的那样，我们确实应该做好准备，我们要对彼此负责。"
                                                },
                                                {
                                                    "id": "400210829",
                                                    "speaker": "「式大将」",
                                                    "text": "我明白…到我做决定的时候了。"
                                                },
                                                {
                                                    "id": "400210830",
                                                    "speaker": "「式大将」",
                                                    "text": "迄今为止，我始终是带着谜团来承受你们的帮助。即使只并肩战斗了短短几天，我们之间也不该有隐瞒。"
                                                },
                                                {
                                                    "id": "400210831",
                                                    "speaker": "「式大将」",
                                                    "text": "单凭目前的信息，我不能给出保证。我想去相信晴之介，可我不知道这些年他是不是变了，又或者我的记忆是假的…"
                                                },
                                                {
                                                    "id": "400210832",
                                                    "speaker": "「式大将」",
                                                    "text": "我是「阴阳师」创造出来的「式神」，记忆残缺不全。对如今的我而言，你们四位朋友是我能够完全信赖、托付一切的人。"
                                                },
                                                {
                                                    "id": "400210833",
                                                    "speaker": "「式大将」",
                                                    "text": "我对你们是信任，对晴之介…是责任。"
                                                },
                                                {
                                                    "id": "400210834",
                                                    "speaker": "「式大将」",
                                                    "text": "他创造了我，我有义务跟随他。要是如你们所说，他是个坏人，那被他所掌控，也是我的命运…"
                                                },
                                                {
                                                    "id": "400210835",
                                                    "speaker": "「式大将」",
                                                    "text": "要是可能，我想保持这颗善良的心直到最后一刻。但武器不能违背主人的意志，他能创造我，就能控制我。"
                                                },
                                                {
                                                    "id": "400210836",
                                                    "speaker": "「式大将」",
                                                    "text": "如果之后我和晴之介做出了伤天害理之事，我也相信…你们会为我们安排一个合适的结局。"
                                                },
                                                {
                                                    "id": "400210837",
                                                    "speaker": "派蒙",
                                                    "text": "呜…竟然反过来把难题抛给我们…"
                                                },
                                                {
                                                    "id": "400210838",
                                                    "speaker": "派蒙",
                                                    "text": "但它意想不到地诚实呢，还说了那么大义凛然的话！"
                                                },
                                                {
                                                    "id": "400210839",
                                                    "speaker": "派蒙",
                                                    "text": "#{NICKNAME}，这个回答完全符合你的期待吧！",
                                                    "choices": [
                                                        {
                                                            "id": "400210840",
                                                            "text": "嗯。「式大将」。",
                                                            "response": [
                                                                {
                                                                    "id": "400210842",
                                                                    "speaker": "辛焱",
                                                                    "text": "你们俩…该不会早就串通好了吧？一个唱红脸，一个唱黑脸？"
                                                                },
                                                                {
                                                                    "id": "400210843",
                                                                    "speaker": "「公子」",
                                                                    "text": "哈哈哈，不错的手法。用这种方式「试探」「式大将」的记忆是否还有缺损…旅行者，你成长了啊。"
                                                                },
                                                                {
                                                                    "id": "400210844",
                                                                    "speaker": "派蒙",
                                                                    "text": "什么叫「试探」！我们这是有预谋的一搭一唱，一次成功的智取！"
                                                                },
                                                                {
                                                                    "id": "400210845",
                                                                    "speaker": "派蒙",
                                                                    "text": "辛焱不是说过吗？她会用她的方式确认同伴是否可信，我们也有我们的办法。"
                                                                },
                                                                {
                                                                    "id": "400210846",
                                                                    "speaker": "派蒙",
                                                                    "text": "而且，趁着现在说，还能给「式大将」打打气呢！让它知道，就算它还很迷茫，我们也愿意信任它，愿意跟它一起前进！"
                                                                },
                                                                {
                                                                    "id": "400210847",
                                                                    "speaker": "「公子」",
                                                                    "text": "假如「式大将」真是伙伴，就不会过快地选择阵营。只有老实说出自身存在的威胁，才是对同伴负责。"
                                                                },
                                                                {
                                                                    "id": "400210848",
                                                                    "speaker": "Player",
                                                                    "text": "我能感知到真诚。"
                                                                },
                                                                {
                                                                    "id": "400210849",
                                                                    "speaker": "「式大将」",
                                                                    "text": "我不擅长撒谎…谢谢你能感受到我的真心。"
                                                                },
                                                                {
                                                                    "id": "400210850",
                                                                    "speaker": "「公子」",
                                                                    "text": "好人也会有欺骗他人、利用他人的时候，反之，坏人也会有顾虑和牵挂。"
                                                                },
                                                                {
                                                                    "id": "400210851",
                                                                    "speaker": "「公子」",
                                                                    "text": "能说出对自己而言无比残忍的答案…你确实做好了觉悟。"
                                                                },
                                                                {
                                                                    "id": "400210852",
                                                                    "speaker": "派蒙",
                                                                    "text": "就像辛焱说的，呃…怎么说来着…"
                                                                },
                                                                {
                                                                    "id": "400210853",
                                                                    "speaker": "辛焱",
                                                                    "text": "哪句啊？"
                                                                },
                                                                {
                                                                    "id": "400210854",
                                                                    "speaker": "派蒙",
                                                                    "text": "想起来了想起来了！「这种语言非常诚实，只会触动人心底最真诚的部分」！"
                                                                },
                                                                {
                                                                    "id": "400210855",
                                                                    "speaker": "辛焱",
                                                                    "text": "只字不差，真亏你记得这么牢…"
                                                                },
                                                                {
                                                                    "id": "400210856",
                                                                    "speaker": "「公子」",
                                                                    "text": "所以，我们的战前动员会开完了吗？"
                                                                },
                                                                {
                                                                    "id": "400210857",
                                                                    "speaker": "「公子」",
                                                                    "text": "开完了就走吧，速战速决！"
                                                                },
                                                                {
                                                                    "id": "400210858",
                                                                    "speaker": "辛焱",
                                                                    "text": "「式大将」，别太担心，我们都在你身边。"
                                                                },
                                                                {
                                                                    "id": "400210859",
                                                                    "speaker": "「式大将」",
                                                                    "text": "我明白。我会全力以赴，不给你们添麻烦。"
                                                                },
                                                                {
                                                                    "id": "400210860",
                                                                    "speaker": "派蒙",
                                                                    "text": "添一点也没关系啦！只要我们能赢就行。"
                                                                },
                                                                {
                                                                    "id": "400210861",
                                                                    "speaker": "Player",
                                                                    "text": "只要打赢关键的一战…"
                                                                },
                                                                {
                                                                    "id": "400210862",
                                                                    "speaker": "「公子」",
                                                                    "text": "不，也要做好最坏的打算。假如这扇门并不通向秘境深处，而是一道机关…"
                                                                },
                                                                {
                                                                    "id": "400210863",
                                                                    "speaker": "派蒙",
                                                                    "text": "不会吧？你不要乌鸦嘴！"
                                                                },
                                                                {
                                                                    "id": "400210864",
                                                                    "speaker": "「公子」",
                                                                    "text": "万一嘛。谁也不能保证这件事绝对不会发生，对吧？"
                                                                },
                                                                {
                                                                    "id": "400210865",
                                                                    "speaker": "「式大将」",
                                                                    "text": "遗憾的是，就算真是如此，凭目前的我多半也无法阻止…"
                                                                },
                                                                {
                                                                    "id": "400210866",
                                                                    "speaker": "「式大将」",
                                                                    "text": "我还没能完全掌控这里。抱歉。"
                                                                },
                                                                {
                                                                    "id": "400210867",
                                                                    "speaker": "「公子」",
                                                                    "text": "我倒觉得没什么。像这样机会难得的挑战圣地，再重组十次都行。"
                                                                },
                                                                {
                                                                    "id": "400210868",
                                                                    "speaker": "派蒙",
                                                                    "text": "呜呜…我才不要，你自己一个人去享受吧！"
                                                                },
                                                                {
                                                                    "id": "400210869",
                                                                    "speaker": "「公子」",
                                                                    "text": "总之，如果触发重组，你们就在确保自身安全的前提下尽量集体行动吧。"
                                                                },
                                                                {
                                                                    "id": "400210870",
                                                                    "speaker": "辛焱",
                                                                    "text": "那你呢？又要去战斗了吗？"
                                                                },
                                                                {
                                                                    "id": "400210871",
                                                                    "speaker": "「公子」",
                                                                    "text": "不用担心，我啊…"
                                                                },
                                                                {
                                                                    "id": "400210872",
                                                                    "speaker": "「公子」",
                                                                    "text": "当然是要好好享受一切危险了。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "400210841",
                                                            "text": "现在我完全信任你了。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "400210825",
                                            "text": "如果他想要危害稻妻。"
                                        },
                                        {
                                            "id": "400210826",
                                            "text": "你会站在我们这边吗？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "400210813",
                            "text": "我有事要坦白。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "4002112",
            "objective": "前往「凶煞折行之寮」的深处",
            "dialogues": []
        },
        {
            "id": "4002109",
            "objective": "与辛焱对话",
            "dialogues": [
                {
                    "id": "400210901",
                    "speaker": "派蒙",
                    "text": "可恶，我们又被弹出来了！"
                },
                {
                    "id": "400210902",
                    "speaker": "辛焱",
                    "text": "下次别让小哥开口了，这乌鸦嘴…未免太过灵验…"
                },
                {
                    "id": "400210903",
                    "speaker": "派蒙",
                    "text": "我受不了这个秘境啦——！惟神晴之介是不是不敢面对我们，他是不是胆小鬼！"
                },
                {
                    "id": "400210904",
                    "speaker": "辛焱",
                    "text": "不过，考虑到附近还有天领奉行的武士驻扎，小哥和「式大将」待在里面，也算是避开了一些麻烦吧。"
                },
                {
                    "id": "400210905",
                    "speaker": "Player",
                    "text": "（惟神…究竟在哪儿呢？）"
                },
                {
                    "id": "400210906",
                    "speaker": "辛焱",
                    "text": "老规矩，等秘境重组完进去找他们会合。"
                },
                {
                    "id": "400210907",
                    "speaker": "辛焱",
                    "text": "在此之前我们得隐藏好自己，别被天领奉行的人发现我们还在这一带徘徊。"
                },
                {
                    "id": "400210908",
                    "speaker": "派蒙",
                    "text": "下次进去，一定要把罪魁祸首揪出来！"
                }
            ]
        }
    ]
}