        {
            "id": "7612706",
            "objective": "救出黑蛋",
            "dialogues": [
                {
                    "id": "761270601",
                    "speaker": "派蒙",
                    "text": "黑蛋！我们来救你啦！"
                },
                {
                    "id": "761270602",
                    "speaker": "黑蛋",
                    "text": "…放开我…"
                },
                {
                    "id": "761270603",
                    "speaker": "派蒙",
                    "text": "喂！黑蛋，醒醒！是我们！"
                },
                {
                    "id": "761270604",
                    "speaker": "黑蛋",
                    "text": "…你们…放开我…"
                },
                {
                    "id": "761270605",
                    "speaker": "派蒙",
                    "text": "清醒一点啊！我们是来救你的！你已经安全了！"
                },
                {
                    "id": "761270606",
                    "speaker": "黑蛋",
                    "text": "哦…哦…对不起…是你们…"
                },
                {
                    "id": "761270607",
                    "speaker": "派蒙",
                    "text": "你怎么被那些东西抓走了啊？你知道这是什么地方吗？"
                },
                {
                    "id": "761270608",
                    "speaker": "黑蛋",
                    "text": "…不知道…但是…"
                },
                {
                    "id": "761270609",
                    "speaker": "黑蛋",
                    "text": "…请让我…接入终端…"
                },
                {
                    "id": "761270610",
                    "speaker": "派蒙",
                    "text": "终端？终端是什么？"
                },
                {
                    "id": "761270611",
                    "speaker": "黑蛋",
                    "text": "…它就在入口…终端有…信息…"
                },
                {
                    "id": "761270612",
                    "speaker": "派蒙",
                    "text": "哦！是不是我们来的时候看见的那个？我们快去找找。"
                }
            ]
        },
        {
            "id": "7612713",
            "objective": "返回入口的终端",
            "dialogues": []
        },
        {
            "id": "7612734",
            "objective": "激活终端",
            "dialogues": [
                {
                    "id": "761270301",
                    "speaker": "派蒙",
                    "text": "黑蛋，你说的终端就是这个吧？"
                },
                {
                    "id": "761270302",
                    "speaker": "黑蛋",
                    "text": "没错…"
                },
                {
                    "id": "761270303",
                    "speaker": "黑蛋",
                    "text": "啊…"
                },
                {
                    "id": "761270304",
                    "speaker": "Player",
                    "text": "你还好吗？"
                },
                {
                    "id": "761270305",
                    "speaker": "黑蛋",
                    "text": "宁…宁…"
                },
                {
                    "id": "761270306",
                    "speaker": "派蒙",
                    "text": "什么？"
                },
                {
                    "id": "761270307",
                    "speaker": "黑蛋",
                    "text": "我的名字…"
                },
                {
                    "id": "761270308",
                    "speaker": "派蒙",
                    "text": "这里面有你的名字？你叫宁宁？"
                },
                {
                    "id": "761270309",
                    "speaker": "黑蛋",
                    "text": "月亮的力量…能够记录…信息…"
                },
                {
                    "id": "761270310",
                    "speaker": "黑蛋",
                    "text": "它们…就储存在终端里…"
                },
                {
                    "id": "761270311",
                    "speaker": "派蒙",
                    "text": "原来黑蛋能够读取终端的信息吗？那你知道这里是什么地方了吗？"
                },
                {
                    "id": "761270312",
                    "speaker": "黑蛋",
                    "text": "是一个能源发生站…用来制造…存储能源…"
                },
                {
                    "id": "761270313",
                    "speaker": "派蒙",
                    "text": "这么说，刚才那些光球，应该就是某种能源了吧。"
                },
                {
                    "id": "761270314",
                    "speaker": "派蒙",
                    "text": "黑蛋一定是因为身上有同样的力量，才被当成能源抓走了。"
                },
                {
                    "id": "761270315",
                    "speaker": "Player",
                    "text": "能源发生站是用来做什么的？"
                },
                {
                    "id": "761270316",
                    "speaker": "黑蛋",
                    "text": "为…「伊比尼伯龙之眼」…供能…"
                },
                {
                    "id": "761270317",
                    "speaker": "派蒙",
                    "text": "伊比尼伯龙…之眼？那又是什么？听起来有些耳熟。"
                },
                {
                    "id": "761270318",
                    "speaker": "Player",
                    "text": "是飞船降落地点之一。"
                },
                {
                    "id": "761270319",
                    "speaker": "派蒙",
                    "text": "伊比尼伯龙…之眼？那又是什么？"
                },
                {
                    "id": "761270320",
                    "speaker": "黑蛋",
                    "text": "这里有工程蓝图…给你们看…"
                },
                {
                    "id": "761270321",
                    "speaker": "黑蛋",
                    "text": "中间的高塔…就是「伊比尼伯龙之眼」…"
                },
                {
                    "id": "761270322",
                    "speaker": "派蒙",
                    "text": "好厉害！旁边那三个矮一些的呢？是能源发生站吗？"
                },
                {
                    "id": "761270323",
                    "speaker": "黑蛋",
                    "text": "嗯…我们就在其中一个里面…"
                },
                {
                    "id": "761270324",
                    "speaker": "Player",
                    "text": "「伊比尼伯龙之眼」具体是干什么的？"
                },
                {
                    "id": "761270325",
                    "speaker": "黑蛋",
                    "text": "工作日志里记录…它是一座月球表面监测站…能够监测月球全表面。"
                },
                {
                    "id": "761270326",
                    "speaker": "派蒙",
                    "text": "监测月球表面？这么厉害！"
                },
                {
                    "id": "761270327",
                    "speaker": "派蒙",
                    "text": "这样说，它岂不是能帮我们搜索哥伦比娅的位置？"
                },
                {
                    "id": "761270328",
                    "speaker": "黑蛋",
                    "text": "我不知道…但是…存在这种可能性…"
                },
                {
                    "id": "761270329",
                    "speaker": "Player",
                    "text": "看来我们得去那里看看。"
                },
                {
                    "id": "761270330",
                    "speaker": "黑蛋",
                    "text": "我们已经启动了…第一座…"
                },
                {
                    "id": "761270331",
                    "speaker": "派蒙",
                    "text": "意思是还要解决另外两座能源发生站对吧？没问题，这种事情我们做过很多了。"
                },
                {
                    "id": "761270332",
                    "speaker": "派蒙",
                    "text": "黑蛋，现在就跟我们来吧。"
                },
                {
                    "id": "761270333",
                    "speaker": "黑蛋",
                    "text": "不是黑蛋…是宁宁…"
                },
                {
                    "id": "761270334",
                    "speaker": "派蒙",
                    "text": "是宁宁，也是黑蛋。"
                },
                {
                    "id": "761270335",
                    "speaker": "黑蛋",
                    "text": "是宁宁…"
                },
                {
                    "id": "761270336",
                    "speaker": "派蒙",
                    "text": "好好，宁宁·黑蛋，这样行了吧？"
                },
                {
                    "id": "761270337",
                    "speaker": "黑蛋",
                    "text": "就只是宁宁…"
                },
                {
                    "id": "761270338",
                    "speaker": "派蒙",
                    "text": "喂！你这只得寸进尺的黑蛋！"
                },
                {
                    "id": "761270339",
                    "speaker": "派蒙",
                    "text": "不要忘了是谁害我们流落到这个找不到餐厅的荒原…你还想不想要零食了？"
                },
                {
                    "id": "761270340",
                    "speaker": "黑蛋",
                    "text": "……"
                },
                {
                    "id": "761270341",
                    "speaker": "黑蛋",
                    "text": "好吧…宁宁·黑蛋。"
                },
                {
                    "id": "761270342",
                    "speaker": "Player",
                    "text": "什么零食？"
                },
                {
                    "id": "761270343",
                    "speaker": "派蒙",
                    "text": "哎呀，这是我们的小秘密啦。"
                },
                {
                    "id": "761270344",
                    "speaker": "派蒙",
                    "text": "快，我们该出发去其它能源发生站了！"
                }
            ]
        },
