        {
            "id": "7612721",
            "objective": "与黑蛋交谈",
            "dialogues": [
                {
                    "id": "761272101",
                    "speaker": "派蒙",
                    "text": "这座终端，孤零零地露在外面，真可怜。"
                },
                {
                    "id": "761272102",
                    "speaker": "派蒙",
                    "text": "它是能源发生站的终端吗？黑蛋，你来试试看吧？"
                },
                {
                    "id": "761272103",
                    "speaker": "黑蛋",
                    "text": "嗯…"
                },
                {
                    "id": "761272104",
                    "speaker": "派蒙",
                    "text": "怎么样？有没有什么新情报？"
                },
                {
                    "id": "761272105",
                    "speaker": "黑蛋",
                    "text": "确认为能源发生站终端…但是…没有读取到新信息…"
                },
                {
                    "id": "761272106",
                    "speaker": "派蒙",
                    "text": "唔…虽然没有新情报，但是能够顺利启动第二座能源发生站也很好了。"
                },
                {
                    "id": "761272107",
                    "speaker": "黑蛋",
                    "text": "等一下…检测到讯号定位器故障…能源无法传输到「伊比尼伯龙之眼」。"
                },
                {
                    "id": "761272108",
                    "speaker": "派蒙",
                    "text": "欸？那怎么办？"
                },
                {
                    "id": "761272109",
                    "speaker": "黑蛋",
                    "text": "讯号定位器…在最顶部…需要手动调整…"
                },
                {
                    "id": "761272110",
                    "speaker": "派蒙",
                    "text": "这样么…那我们先想办法上去看看吧。"
                }
            ]
        },
        {
