    "talks": [
        {
            "id": "7612729",
            "objective": "航行中…",
            "dialogues": [
                {
                    "id": "761270101",
                    "speaker": "Player",
                    "text": "（怎么…回事…？）"
                },
                {
                    "id": "761270102",
                    "speaker": "Player",
                    "text": "（对了，是飞船发生了事故…我们进入了逃生舱…已经成功降落了吗？）"
                },
                {
                    "id": "761270103",
                    "speaker": "Player",
                    "text": "（我似乎还在逃生舱里…得赶紧去确认派蒙的情况…）"
                },
                {
                    "id": "761270104",
                    "speaker": "Player",
                    "text": "（离开逃生舱。）"
                }
            ]
        },
        {
            "id": "7612701",
            "objective": "想办法回到地面",
            "dialogues": []
        },
        {
            "id": "7612728",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7612702",
            "objective": "与派蒙交谈",
            "dialogues": [
                {
                    "id": "761270201",
                    "speaker": "派蒙",
                    "text": "#呜呜呜，{NICKNAME}！我就知道你一定会没事的。"
                },
                {
                    "id": "761270202",
                    "speaker": "Player",
                    "text": "派蒙还好吗？"
                },
                {
                    "id": "761270203",
                    "speaker": "派蒙",
                    "text": "刚才很不好，我从逃生舱里出来一看，你们都不见了，差点吓死我了。"
                },
                {
                    "id": "761270204",
                    "speaker": "派蒙",
                    "text": "不过现在找到了你，一下就好多了，嘿嘿嘿嘿。"
                },
                {
                    "id": "761270205",
                    "speaker": "派蒙",
                    "text": "快让我看看，你有没有哪里受伤？"
                },
                {
                    "id": "761270206",
                    "speaker": "Player",
                    "text": "放心，我也没事。"
                },
                {
                    "id": "761270207",
                    "speaker": "派蒙",
                    "text": "这样我就不担心了，没想到飞船居然出了问题…不对，其实这种事早就该想到的…"
                },
                {
                    "id": "761270208",
                    "speaker": "派蒙",
                    "text": "毕竟它都被埋在地下不知道多少年了，能飞起来已经是奇迹了。"
                },
                {
                    "id": "761270209",
                    "speaker": "派蒙",
                    "text": "而且虽然过程有些糟糕…但我们最后还是成功来到了月球上…"
                },
                {
                    "id": "761270210",
                    "speaker": "Player",
                    "text": "真是强劲的龙族科技。"
                },
                {
                    "id": "761270211",
                    "speaker": "派蒙",
                    "text": "都怪刚才黑蛋太引人注意，让我忘记好好检查一下飞船。"
                },
                {
                    "id": "761270212",
                    "speaker": "派蒙",
                    "text": "啊对了！黑蛋呢？我记得她也钻进了逃生舱。"
                },
                {
                    "id": "761270213",
                    "speaker": "Player",
                    "text": "我们得去找她。"
                },
                {
                    "id": "761270214",
                    "speaker": "派蒙",
                    "text": "希望她不要有事！"
                }
            ]
        },
        {
            "id": "7612704",
            "objective": "寻找黑蛋",
            "dialogues": [
                {
                    "id": "761270401",
                    "speaker": "派蒙",
                    "text": "这样就成功了吧！比预想中要顺利呢。"
                },
                {
                    "id": "761270402",
                    "speaker": "派蒙",
                    "text": "现在是不是还需要去激活第三座能源发生站？"
                },
                {
                    "id": "761270403",
                    "speaker": "黑蛋",
                    "text": "看…那个已经是激活状态了。"
                },
                {
                    "id": "761270404",
                    "speaker": "派蒙",
                    "text": "真的欸…第三座能源发生站居然是好的吗？龙族科技果然强劲…"
                },
                {
                    "id": "761270405",
                    "speaker": "Player",
                    "text": "也有可能是其他人激活的。"
                },
                {
                    "id": "761270406",
                    "speaker": "派蒙",
                    "text": "其他人？你是说…哥伦比娅？这么一想也只能是她了…可她为什么只激活了一座呢？"
                },
                {
                    "id": "761270407",
                    "speaker": "派蒙",
                    "text": "该不会…她发现了什么不对劲的地方吧？难道这里面有什么问题？"
                },
                {
                    "id": "761270408",
                    "speaker": "派蒙",
                    "text": "喂…黑蛋，你不会又坑了我们吧？那我可要扣你的好感度了！"
                },
                {
                    "id": "761270409",
                    "speaker": "黑蛋",
                    "text": "虽然不知道…我的使命是什么…"
                },
                {
                    "id": "761270410",
                    "speaker": "黑蛋",
                    "text": "但是一定不包括…提升谁的好感度…"
                },
                {
                    "id": "761270411",
                    "speaker": "派蒙",
                    "text": "哈呀？黑蛋，你变了！是终端的信息让你膨胀了吗？"
                },
                {
                    "id": "761270412",
                    "speaker": "Player",
                    "text": "还是先去「伊比尼伯龙之眼」看看吧。"
                },
                {
                    "id": "761270413",
                    "speaker": "黑蛋",
                    "text": "#嗯…{NICKNAME}…更加理性…稳重…擅于思考…是更好的合作伙伴…不像派蒙…"
                },
                {
                    "id": "761270414",
                    "speaker": "黑蛋",
                    "text": "#我们出发吧…{NICKNAME}…我跟着你走…"
                },
                {
                    "id": "761270415",
                    "speaker": "派蒙",
                    "text": "哈呀？！黑蛋！我要再扣你一成零食！"
                }
            ]
        },
        {
            "id": "7612705",
            "objective": "前往地下",
            "dialogues": [
                {
                    "id": "761270501",
                    "speaker": "派蒙",
                    "text": "看！逃生舱！这是黑蛋的逃生舱吧？"
                },
                {
                    "id": "761270502",
                    "speaker": "派蒙",
                    "text": "但她好像已经不在里面了…应该也是顺利逃出来了吧。"
                },
                {
                    "id": "761270503",
                    "speaker": "派蒙",
                    "text": "会是逃进了这个像遗迹一样的地方吗…感觉我们得进去找一找了。"
                }
            ]
        },
