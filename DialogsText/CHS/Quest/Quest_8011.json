    "talks": [
        {
            "id": "801113",
            "objective": "进入屋内",
            "dialogues": []
        },
        {
            "id": "801101",
            "objective": "跟上丘丘人",
            "dialogues": [
                {
                    "id": "80110101",
                    "speaker": "埃德",
                    "text": "好像…不是卡利贝尔。",
                    "choices": [
                        {
                            "id": "80110102",
                            "text": "不是他…",
                            "response": [
                                {
                                    "id": "80110104",
                                    "speaker": "埃德",
                                    "text": "嗯。卡利贝尔胳膊上的丝巾是我曾经送给他母亲的礼物，如今被我拿来做记号。"
                                },
                                {
                                    "id": "80110105",
                                    "speaker": "埃德",
                                    "text": "我怕是眼睛也快撑不住了，连自己的儿子都认不清了，这副身体…唉。",
                                    "choices": [
                                        {
                                            "id": "80110106",
                                            "text": "不过这个丘丘人…",
                                            "response": [
                                                {
                                                    "id": "80110108",
                                                    "speaker": "埃德",
                                                    "text": "是啊，好像对我们完全没有兴趣，只是坚定地往那个方向走…那边有什么吗？",
                                                    "choices": [
                                                        {
                                                            "id": "80110109",
                                                            "text": "不清楚。",
                                                            "response": [
                                                                {
                                                                    "id": "80110111",
                                                                    "speaker": "埃德",
                                                                    "text": "嗯，关于丘丘人…知道的越多越好。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "80110110",
                                                            "text": "跟上去看看吧。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "80110107",
                                            "text": "稍微有些奇怪。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "80110103",
                            "text": "他的胳膊上没有丝巾。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "801102",
            "objective": "跟上丘丘人",
            "dialogues": [
                {
                    "id": "80110201",
                    "speaker": "埃德",
                    "text": "这里好阴森，这个地方…以前也存在吗？好像从来没有发现过这里。",
                    "choices": [
                        {
                            "id": "80110202",
                            "text": "你看…",
                            "response": [
                                {
                                    "id": "80110204",
                                    "speaker": "埃德",
                                    "text": "啊？他们…他们是在膜拜什么吗？一边走，一边跪拜…看起来很虔诚。"
                                },
                                {
                                    "id": "80110205",
                                    "speaker": "埃德",
                                    "text": "我从未见过这样的景象，这个地方究竟藏了些什么…"
                                },
                                {
                                    "id": "80110206",
                                    "speaker": "埃德",
                                    "text": "只有一探究竟了。"
                                },
                                {
                                    "id": "80110207",
                                    "speaker": "Player",
                                    "text": "（这里的气氛，诡异的情景，难道…）"
                                }
                            ]
                        },
                        {
                            "id": "80110203",
                            "text": "那些丘丘人在做什么？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "801114",
            "objective": "跟着丘丘人进入洞窟",
            "dialogues": []
        },
        {
            "id": "801103",
            "objective": "跟着丘丘人进入洞窟",
            "dialogues": [
                {
                    "id": "80110301",
                    "speaker": "？？？",
                    "text": "停下，人类。汝等并未获准来此地探寻「命运」…"
                },
                {
                    "id": "80110302",
                    "speaker": "Player",
                    "text": "（深渊使徒？不对，好像从未在深渊教团见过这样的家伙…）"
                },
                {
                    "id": "80110303",
                    "speaker": "？？？",
                    "text": "怎么，汝等执意要「觐见」么？"
                },
                {
                    "id": "80110304",
                    "speaker": "？？？",
                    "text": "…也无妨，那就赐予汝等「命运的试炼」吧。"
                }
            ]
        },
        {
            "id": "801104",
            "objective": "与埃德对话",
            "dialogues": []
        },
        {
            "id": "801105",
            "objective": "向前继续探索",
            "dialogues": [
                {
                    "id": "80110501",
                    "speaker": "埃德",
                    "text": "这里就是…终点？"
                },
                {
                    "id": "80110502",
                    "speaker": "Player",
                    "text": "那个东西是！？"
                },
                {
                    "id": "80110503",
                    "speaker": "Player",
                    "text": "（锁链层层缠绕，悬吊在空中，散发着不祥的气息…没错，和「污秽逆位神像」非常类似！）"
                },
                {
                    "id": "80110504",
                    "speaker": "Player",
                    "text": "（果然和深渊教团有关系吗，这些正在膜拜的丘丘人，也像极了当时的「那个家伙」…）"
                },
                {
                    "id": "80110505",
                    "speaker": "Player",
                    "text": "埃德，这里很不吉利，快走！"
                },
                {
                    "id": "80110506",
                    "speaker": "埃德",
                    "text": "……"
                },
                {
                    "id": "80110507",
                    "speaker": "Player",
                    "text": "埃德？"
                },
                {
                    "id": "80110508",
                    "speaker": "脑海中回荡的声音",
                    "text": "…生命啊，为何在跪拜呢，因恐惧未知而跪拜？因贪图力量而跪拜？"
                },
                {
                    "id": "80110509",
                    "speaker": "Player",
                    "text": "（什么声音，好像从我头脑里传来的…埃德，好像听不到？）"
                },
                {
                    "id": "80110510",
                    "speaker": "脑海中回荡的声音",
                    "text": "…生命啊，为何在跪拜呢，我又不是什么神明，我只是——「罪人」。"
                },
                {
                    "id": "80110511",
                    "speaker": "Player",
                    "text": "（「罪人」…）"
                },
                {
                    "id": "80110512",
                    "speaker": "脑海中回荡的声音",
                    "text": "诞生于罪孽，但尚且无垢的花朵啊，我通晓你的命运。"
                },
                {
                    "id": "80110513",
                    "speaker": "脑海中回荡的声音",
                    "text": "无需压抑你一切的不甘，无需容忍那全部的谎言。"
                },
                {
                    "id": "80110514",
                    "speaker": "脑海中回荡的声音",
                    "text": "去成为「超然」的存在吧，超越一切「被赋予的命运」。"
                },
                {
                    "id": "80110515",
                    "speaker": "脑海中回荡的声音",
                    "text": "我将在时间的尽头垂泪…回望你的一切。"
                },
                {
                    "id": "80110516",
                    "speaker": "Player",
                    "text": "（…你究竟是谁，这些话是什么意思？）"
                },
                {
                    "id": "80110517",
                    "speaker": "脑海中回荡的声音",
                    "text": "……"
                },
                {
                    "id": "80110518",
                    "speaker": "Player",
                    "text": "（声音…消失了么…）"
                },
                {
                    "id": "80110519",
                    "speaker": "Player",
                    "text": "！！"
                },
                {
                    "id": "80110520",
                    "speaker": "Player",
                    "text": "…埃德？"
                },
                {
                    "id": "80110521",
                    "speaker": "埃德",
                    "text": "呼…呼…刚才发生了什么？"
                },
                {
                    "id": "80110522",
                    "speaker": "埃德",
                    "text": "我好像见到那东西的瞬间，内心所有的情绪都平息了，只剩下说不出是敬畏…还是幸福的感觉。"
                },
                {
                    "id": "80110523",
                    "speaker": "Player",
                    "text": "你现在没事了么？"
                },
                {
                    "id": "80110524",
                    "speaker": "埃德",
                    "text": "没事，我感觉很好，不如说…比刚进来这里的时候要好多了，真是奇怪…"
                },
                {
                    "id": "80110525",
                    "speaker": "Player",
                    "text": "这里有问题，我们赶紧离开吧。"
                },
                {
                    "id": "80110526",
                    "speaker": "埃德",
                    "text": "是、是吗…好吧，那先听你的。"
                }
            ]
        },
        {
            "id": "801116",
            "objective": "与埃德对话",
            "dialogues": [
                {
                    "id": "80110801",
                    "speaker": "埃德",
                    "text": "（……）"
                }
            ]
        },
        {
            "id": "801117",
            "objective": "向前继续探索",
            "dialogues": []
        },
        {
            "id": "801120",
            "objective": "与埃德对话",
            "dialogues": []
        },
        {
            "id": "801121",
            "objective": "向前继续探索",
            "dialogues": []
        },
        {
            "id": "801106",
            "objective": "与埃德对话",
            "dialogues": []
        },
        {
            "id": "801107",
            "objective": "击败命运使徒",
            "dialogues": []
        },
        {
            "id": "801108",
            "objective": "与埃德对话",
            "dialogues": [
                {
                    "id": "80110401",
                    "speaker": "埃德",
                    "text": "刚才那个家伙到底是什么？简直是…",
                    "choices": [
                        {
                            "id": "80110402",
                            "text": "吓到了么？",
                            "response": [
                                {
                                    "id": "80110404",
                                    "speaker": "埃德",
                                    "text": "…简直是完美的生命体，令人赞叹。"
                                },
                                {
                                    "id": "80110405",
                                    "speaker": "Player",
                                    "text": "嗯？"
                                },
                                {
                                    "id": "80110406",
                                    "speaker": "埃德",
                                    "text": "他身上透露着的那股神秘的气息，危险却又优雅的力量，真是太吸引人了。"
                                },
                                {
                                    "id": "80110407",
                                    "speaker": "埃德",
                                    "text": "真亏你能将这样的存在击败，你的实力有些超乎我的想象了。",
                                    "choices": [
                                        {
                                            "id": "80110408",
                                            "text": "你的品味还真是独特。",
                                            "response": [
                                                {
                                                    "id": "80110410",
                                                    "speaker": "埃德",
                                                    "text": "我们继续前进吧，我已经越来越好奇，越来越兴奋了。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "80110409",
                                            "text": "我只是经验丰富罢了。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "80110403",
                            "text": "我以前见过类似的家伙。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "801109",
            "objective": "向前继续探索",
            "dialogues": []
        },
        {
            "id": "801110",
            "objective": "向前继续探索",
            "dialogues": []
        },
        {
            "id": "801112",
            "objective": "",
            "dialogues": [
                {
                    "id": "80110601",
                    "speaker": "埃德",
                    "text": "卡利贝尔，谢天谢地，这里一切如常。",
                    "choices": [
                        {
                            "id": "80110602",
                            "text": "不去祭拜七天神像了么？",
                            "response": [
                                {
                                    "id": "80110604",
                                    "speaker": "埃德",
                                    "text": "我…只是隐隐有种感觉，刚刚的事是某种命运的安排。"
                                },
                                {
                                    "id": "80110605",
                                    "speaker": "埃德",
                                    "text": "在我最不想祭拜神像的时候，发生了刚才的那件事，仿佛是对我的某种引导…"
                                },
                                {
                                    "id": "80110606",
                                    "speaker": "埃德",
                                    "text": "听你说，我好像在「那个东西」前跪拜了，说不定…效果也差不多呢？",
                                    "choices": [
                                        {
                                            "id": "80110607",
                                            "text": "简直莫名其妙…",
                                            "response": [
                                                {
                                                    "id": "80110609",
                                                    "speaker": "埃德",
                                                    "text": "不管你怎么说，我都要先尝试一下…是你说过的，「总归要尝试所有的可能性」。"
                                                },
                                                {
                                                    "id": "80110610",
                                                    "speaker": "Black Screen",
                                                    "text": "再一次将药喂给了丘丘人…"
                                                },
                                                {
                                                    "id": "80110611",
                                                    "speaker": "埃德",
                                                    "text": "卡利贝尔…？"
                                                },
                                                {
                                                    "id": "80110612",
                                                    "speaker": "卡利贝尔",
                                                    "text": "……"
                                                },
                                                {
                                                    "id": "80110613",
                                                    "speaker": "卡利贝尔",
                                                    "text": "爸…爸…？"
                                                },
                                                {
                                                    "id": "80110614",
                                                    "speaker": "埃德",
                                                    "text": "啊…卡利贝尔！天哪，这是真的，这是奇迹，我的卡利贝尔！！",
                                                    "choices": [
                                                        {
                                                            "id": "80110615",
                                                            "text": "居然…",
                                                            "response": [
                                                                {
                                                                    "id": "80110617",
                                                                    "speaker": "埃德",
                                                                    "text": "看到了吧，有效果了，卡利贝尔又能说话了！"
                                                                },
                                                                {
                                                                    "id": "80110618",
                                                                    "speaker": "卡利贝尔",
                                                                    "text": "妈妈呢…？"
                                                                },
                                                                {
                                                                    "id": "80110619",
                                                                    "speaker": "埃德",
                                                                    "text": "妈妈她…卡利贝尔，你先看着我，你认得出我吧？"
                                                                },
                                                                {
                                                                    "id": "80110620",
                                                                    "speaker": "卡利贝尔",
                                                                    "text": "嗯，你是爸爸。"
                                                                },
                                                                {
                                                                    "id": "80110621",
                                                                    "speaker": "埃德",
                                                                    "text": "哈…哈哈哈…救赎，这就是被救赎的感觉吗…"
                                                                },
                                                                {
                                                                    "id": "80110622",
                                                                    "speaker": "埃德",
                                                                    "text": "你现在感觉还好吗，卡利贝尔，意识还清醒吗？"
                                                                },
                                                                {
                                                                    "id": "80110623",
                                                                    "speaker": "卡利贝尔",
                                                                    "text": "嗯…我好像睡了很久，梦里我躲在一个小房间里，一直一直不敢出去，但也不想出去…"
                                                                },
                                                                {
                                                                    "id": "80110624",
                                                                    "speaker": "卡利贝尔",
                                                                    "text": "我…"
                                                                },
                                                                {
                                                                    "id": "80110625",
                                                                    "speaker": "卡利贝尔",
                                                                    "text": "我的身体！我的身体怎么了！这、这是我吗？"
                                                                },
                                                                {
                                                                    "id": "80110626",
                                                                    "speaker": "卡利贝尔",
                                                                    "text": "爸爸…这是怎么回事！？"
                                                                },
                                                                {
                                                                    "id": "80110627",
                                                                    "speaker": "埃德",
                                                                    "text": "……"
                                                                },
                                                                {
                                                                    "id": "80110628",
                                                                    "speaker": "埃德",
                                                                    "text": "…不要慌张，儿子，只是…只是在你睡着的时候，我们到了一个童话里的世界。"
                                                                },
                                                                {
                                                                    "id": "80110629",
                                                                    "speaker": "埃德",
                                                                    "text": "这个世界不再有坎瑞亚，不再有我们的家园，但同样也没有了红色的天空和末日一样的灾难。"
                                                                },
                                                                {
                                                                    "id": "80110630",
                                                                    "speaker": "埃德",
                                                                    "text": "你会像这样，作为一个小怪兽的模样，和爸爸永远在一起。"
                                                                },
                                                                {
                                                                    "id": "80110631",
                                                                    "speaker": "卡利贝尔",
                                                                    "text": "我…我是死了么？"
                                                                },
                                                                {
                                                                    "id": "80110632",
                                                                    "speaker": "埃德",
                                                                    "text": "没有，说什么呢，卡利贝尔…你看你的胳膊上还有妈妈的丝巾，她也在祝福和保佑你呢，你怎么可能死去。"
                                                                },
                                                                {
                                                                    "id": "80110633",
                                                                    "speaker": "卡利贝尔",
                                                                    "text": "这样吗…"
                                                                },
                                                                {
                                                                    "id": "80110634",
                                                                    "speaker": "埃德",
                                                                    "text": "嗯，刚醒来的你可能有些混乱，你就先在这里好好休息吧…一切都会好起来。"
                                                                },
                                                                {
                                                                    "id": "80110635",
                                                                    "speaker": "埃德",
                                                                    "text": "哦对了…你一定要记得…"
                                                                },
                                                                {
                                                                    "id": "80110636",
                                                                    "speaker": "埃德",
                                                                    "text": "不要摘下面具。"
                                                                },
                                                                {
                                                                    "id": "80110637",
                                                                    "speaker": "埃德",
                                                                    "text": "记住了吗？不要摘下面具…"
                                                                },
                                                                {
                                                                    "id": "80110638",
                                                                    "speaker": "卡利贝尔",
                                                                    "text": "好的…好的爸爸，我知道了…"
                                                                },
                                                                {
                                                                    "id": "80110639",
                                                                    "speaker": "Black Screen",
                                                                    "text": "父子间的对话持续了很久，埃德仿佛得到了救赎一般…"
                                                                },
                                                                {
                                                                    "id": "80110640",
                                                                    "speaker": "埃德",
                                                                    "text": "从那一天起，我就从来没有像现在这样开心过…这居然是真的…",
                                                                    "choices": [
                                                                        {
                                                                            "id": "80110641",
                                                                            "text": "是啊…",
                                                                            "response": [
                                                                                {
                                                                                    "id": "80110643",
                                                                                    "speaker": "埃德",
                                                                                    "text": "哼，我就知道什么七神根本不可能指望得上，呸…我居然还祭拜了七天神像，简直是我此生最大的耻辱…"
                                                                                },
                                                                                {
                                                                                    "id": "80110644",
                                                                                    "speaker": "埃德",
                                                                                    "text": "凶手，永远都会是凶手，想要他们拯救什么，我可真是太天真了。"
                                                                                },
                                                                                {
                                                                                    "id": "80110645",
                                                                                    "speaker": "埃德",
                                                                                    "text": "反倒是，我们在洞穴里见到的那位不知名的神，那才是真正伟大的神明，和七神什么的不一样！"
                                                                                },
                                                                                {
                                                                                    "id": "80110646",
                                                                                    "speaker": "埃德",
                                                                                    "text": "那神秘的力量，令人痴迷…一定是我之前虔诚跪拜的缘故，对吧？"
                                                                                },
                                                                                {
                                                                                    "id": "80110647",
                                                                                    "speaker": "埃德",
                                                                                    "text": "哦这么说来，向神明许愿，愿望得以实现之后，是不是应该…应该那个叫什么「还愿」来着？"
                                                                                },
                                                                                {
                                                                                    "id": "80110648",
                                                                                    "speaker": "埃德",
                                                                                    "text": "反正求神的事我不太懂，但这次我觉得一定有必要去「还愿」。",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "80110649",
                                                                                            "text": "可是…那并不是神明，埃德。",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "80110651",
                                                                                                    "speaker": "埃德",
                                                                                                    "text": "「罪人」？喂，你在胡说什么，你对那位神明有什么了解，怎么敢如此出言亵渎。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "80110652",
                                                                                                    "speaker": "埃德",
                                                                                                    "text": "他的神力你也已经看到了，七神怎么可能带来这样的奇迹？他只会是高于七神之上的神，「罪人」什么的简直莫名其妙！"
                                                                                                },
                                                                                                {
                                                                                                    "id": "80110653",
                                                                                                    "speaker": "埃德",
                                                                                                    "text": "算了…不管你如何看待，都影响不了我的虔诚。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "80110654",
                                                                                                    "speaker": "埃德",
                                                                                                    "text": "我现在就去还愿，你不跟着来也无所谓。",
                                                                                                    "choices": [
                                                                                                        {
                                                                                                            "id": "80110655",
                                                                                                            "text": "你这家伙…",
                                                                                                            "response": [
                                                                                                                {
                                                                                                                    "id": "80110657",
                                                                                                                    "speaker": "Player",
                                                                                                                    "text": "（埃德的心智好像受到了影响…虽说他本来就不太正常，但现在这种狂热实在有些…）"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "80110658",
                                                                                                                    "speaker": "Player",
                                                                                                                    "text": "（唉，还是追上去看看吧，记得那附近魔物不少，总不能眼睁睁看着他落在魔物手里…）"
                                                                                                                }
                                                                                                            ]
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "80110656",
                                                                                                            "text": "随便你吧。"
                                                                                                        }
                                                                                                    ]
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "80110650",
                                                                                            "text": "那是…「罪人」。"
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "80110642",
                                                                            "text": "的确不可思议。"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "80110616",
                                                            "text": "不可思议。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "80110608",
                                            "text": "好吧，如果你执意要这么认为…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "80110603",
                            "text": "怎么直接回来了。"
                        }
                    ]
                }
            ]
        },
