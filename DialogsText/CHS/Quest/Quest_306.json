    "talks": [
        {
            "id": "30600",
            "objective": "在庙宇门口跟安柏见面",
            "dialogues": []
        },
        {
            "id": "30601",
            "objective": "与安柏对话",
            "dialogues": [
                {
                    "id": "3061101",
                    "speaker": "安柏",
                    "text": "就是这里了，被废弃的<color=#00E1FFFF>四风守护庙宇</color>之一。"
                },
                {
                    "id": "3061102",
                    "speaker": "安柏",
                    "text": "这些庙宇已经荒废好多年了，蒙德的民众也根本不会来。"
                },
                {
                    "id": "3061103",
                    "speaker": "安柏",
                    "text": "搞不好里面会有野兽筑巢，或者丘丘人建立营地呢。"
                },
                {
                    "id": "3061104",
                    "speaker": "安柏",
                    "text": "唉…毕竟连风魔龙自己，都放弃了自己的庙宇…",
                    "choices": [
                        {
                            "id": "3061105",
                            "text": "你说风魔龙…？",
                            "response": [
                                {
                                    "id": "3061107",
                                    "speaker": "安柏",
                                    "text": "…是的。"
                                },
                                {
                                    "id": "3061108",
                                    "speaker": "安柏",
                                    "text": "虽然我也很不愿意接受，但…风魔龙，曾经也是「四风守护」之一。"
                                },
                                {
                                    "id": "3061109",
                                    "speaker": "派蒙",
                                    "text": "欸——"
                                },
                                {
                                    "id": "3061110",
                                    "speaker": "安柏",
                                    "text": "先不提这些了。你感受到了吗？"
                                },
                                {
                                    "id": "3061111",
                                    "speaker": "安柏",
                                    "text": "这里面的「风」，有些不对劲…"
                                },
                                {
                                    "id": "3061112",
                                    "speaker": "安柏",
                                    "text": "#进去看看吧，{NICKNAME}。要小心，龙的力量正在影响这里。"
                                }
                            ]
                        },
                        {
                            "id": "3061106",
                            "text": "你说「自己的庙宇」…？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "30602",
            "objective": "进入庙宇",
            "dialogues": []
        },
        {
            "id": "30607",
            "objective": "(test)到教学点1$HIDDEN",
            "dialogues": []
        },
        {
            "id": "30608",
            "objective": "(test)到教学点2$HIDDEN",
            "dialogues": []
        },
        {
            "id": "30609",
            "objective": "(test)到教学点3$HIDDEN",
            "dialogues": []
        },
        {
            "id": "30612",
            "objective": "(test)到垂直风场$HIDDEN",
            "dialogues": [
                {
                    "id": "3061201",
                    "speaker": "安柏",
                    "text": "蒙德城的大家还在被风灾困扰着…"
                },
                {
                    "id": "3061202",
                    "speaker": "安柏",
                    "text": "每耽搁一秒都是骑士的失职！我们赶快到庙宇里去吧？"
                }
            ]
        },
        {
            "id": "30611",
            "objective": "(test)地城失败$HIDDEN",
            "dialogues": []
        },
        {
            "id": "30603",
            "objective": "探索庙宇深处",
            "dialogues": []
        },
        {
            "id": "30610",
            "objective": "(test)与安柏对话$HIDDEN",
            "dialogues": [
                {
                    "id": "3061001",
                    "speaker": "安柏",
                    "text": "呼…真累人。"
                },
                {
                    "id": "3061002",
                    "speaker": "安柏",
                    "text": "不过，这样就能为琴团长分担一些辛劳了。"
                },
                {
                    "id": "3061003",
                    "speaker": "安柏",
                    "text": "以前我们的防御力量，起码还能守住城里的安全。"
                },
                {
                    "id": "3061004",
                    "speaker": "安柏",
                    "text": "简单来说主要是因为有琴在。"
                },
                {
                    "id": "3061005",
                    "speaker": "安柏",
                    "text": "但现在风魔龙已经直接袭击了蒙德内部…"
                },
                {
                    "id": "3061006",
                    "speaker": "安柏",
                    "text": "「风向变了，我们的策略也会作出相应的变化。」",
                    "choices": [
                        {
                            "id": "3061007",
                            "text": "听起来很有哲理。",
                            "response": [
                                {
                                    "id": "3061009",
                                    "speaker": "安柏",
                                    "text": "这是丽莎喜欢说的话。"
                                },
                                {
                                    "id": "3061010",
                                    "speaker": "安柏",
                                    "text": "对了，之前我们聊到的「四风守护」话题——"
                                },
                                {
                                    "id": "3061011",
                                    "speaker": "安柏",
                                    "text": "如果想知道过往的历史，也可以去问丽莎。"
                                },
                                {
                                    "id": "3061012",
                                    "speaker": "安柏",
                                    "text": "…先说明，不是因为我历史学得不好！"
                                },
                                {
                                    "id": "3061013",
                                    "speaker": "安柏",
                                    "text": "图书管理员的知识储备，总之…就是会比侦察骑士更完备一点吧？"
                                }
                            ]
                        },
                        {
                            "id": "3061008",
                            "text": "你原创的吗？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "30604",
            "objective": "退出秘境",
