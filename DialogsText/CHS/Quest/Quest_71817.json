    "talks": [
        {
            "id": "7181720",
            "objective": "(test)隐藏任务UI界面领取用$HIDDEN",
            "dialogues": [
                {
                    "id": "718172001",
                    "speaker": "言笑",
                    "text": "对了，那两位客人点的菜我已经让毓华带下去了，客人很满意，谢谢你帮我跑那一趟啊。"
                },
                {
                    "id": "718172002",
                    "speaker": "言笑",
                    "text": "那么，其他事情都办妥了吗？"
                },
                {
                    "id": "718172003",
                    "speaker": "Player",
                    "text": "餐已经送到。"
                },
                {
                    "id": "718172004",
                    "speaker": "言笑",
                    "text": "不错不错，那食材也买好了吗？"
                }
            ]
        },
        {
            "id": "7181701",
            "objective": "在晚上与言笑对话（19点~23点）",
            "dialogues": [
                {
                    "id": "718170201",
                    "speaker": "言笑",
                    "text": "不行了，我已经手酸到提不起锅了…"
                },
                {
                    "id": "718170202",
                    "speaker": "Player",
                    "text": "怎么了？"
                },
                {
                    "id": "718170203",
                    "speaker": "言笑",
                    "text": "哎，旅行者，我刚才还在想要是有个人来帮忙就好了…你愿意给我帮帮忙吗？"
                },
                {
                    "id": "718170204",
                    "speaker": "Player",
                    "text": "什么忙…"
                },
                {
                    "id": "718170205",
                    "speaker": "言笑",
                    "text": "海灯节期间，客栈里的人差不多都回去过节了，没多少能干活的人手，我们都忙得不可开交，多一个人来帮忙都是好事。"
                },
                {
                    "id": "718170206",
                    "speaker": "言笑",
                    "text": "你也不用太担心，不用你帮什么重活，只要你帮忙上上菜、采购点材料就行了。"
                },
                {
                    "id": "718170207",
                    "speaker": "言笑",
                    "text": "你等会啊，我瞧瞧，现在有什么可以叫你帮忙的…"
                }
            ]
        },
        {
            "id": "7181702",
            "objective": "与言笑对话",
            "dialogues": [
                {
                    "id": "718170301",
                    "speaker": "言笑",
                    "text": "哎哟，都给我忙忘了，楼下那桌客人的菜还没点。"
                },
                {
                    "id": "718170302",
                    "speaker": "言笑",
                    "text": "这样吧，你来给楼下两个外国客人那桌点单，就是荷尔德林和卡斯帕那桌。"
                },
                {
                    "id": "718170303",
                    "speaker": "言笑",
                    "text": "他们应该已经等了好一会儿了，可能有些等烦了，你记得先给他们上<color=#00E1FFFF>两份</color>小菜，<color=#00E1FFFF>美味的野菇鸡肉串</color>就好。"
                },
                {
                    "id": "718170304",
                    "speaker": "言笑",
                    "text": "上完小菜之后再问问他们想吃些什么主菜，免得再跑一趟。"
                },
                {
                    "id": "718170305",
                    "speaker": "言笑",
                    "text": "快去吧，别让客人等急了。"
                }
            ]
        },
        {
            "id": "7181703",
            "objective": "(test)挑战开启倒计时$HIDDEN",
            "dialogues": [
                {
                    "id": "718171801",
                    "speaker": "茱萸",
                    "text": "好了好了，青莲你看，外送来了，谢谢你专门跑一趟。"
                }
            ]
        },
        {
            "id": "7181709",
            "objective": "制作两份美味的野菇鸡肉串",
            "dialogues": [
                {
                    "id": "718170901",
                    "speaker": "Player",
                    "text": "金丝虾球。"
                },
                {
                    "id": "718170902",
                    "speaker": "言笑",
                    "text": "没问题，这个不难。"
                },
                {
                    "id": "718170903",
                    "speaker": "言笑",
                    "text": "那卡斯帕想吃什么菜？"
                }
            ]
        },
        {
            "id": "7181710",
            "objective": "给荷尔德林和卡斯帕上菜",
            "dialogues": [
                {
                    "id": "718171001",
                    "speaker": "Player",
                    "text": "香嫩椒椒鸡。"
                },
                {
                    "id": "718171002",
                    "speaker": "言笑",
                    "text": "没问题，这个不难。"
                },
                {
                    "id": "718171003",
                    "speaker": "言笑",
                    "text": "那卡斯帕想吃什么菜？"
                }
            ]
        },
        {
            "id": "7181704",
            "objective": "给荷尔德林和卡斯帕上菜",
            "dialogues": [
                {
                    "id": "718170601",
                    "speaker": "荷尔德林",
                    "text": "总算是来了，再不来我都想走了…"
                },
                {
                    "id": "718170602",
                    "speaker": "Player",
                    "text": "请问你们想点些什么菜？"
                },
                {
                    "id": "718170603",
                    "speaker": "荷尔德林",
                    "text": "一直听说璃月人做海鲜有一套，我倒想试一试…"
                },
                {
                    "id": "718170604",
                    "speaker": "荷尔德林",
                    "text": "不过，我最近正在尝试素食主义的生活方式，不能吃肉，不知道有没有那种…有海鲜味道的素菜…"
                },
                {
                    "id": "718170605",
                    "speaker": "卡斯帕",
                    "text": "自从上次在万民堂品尝到了辣味料理，我已经完全爱上了这种味道，现在每顿饭没有辣味就吃不下去。"
                },
                {
                    "id": "718170606",
                    "speaker": "卡斯帕",
                    "text": "海鲜我还是算了，最近吃腻了海鲜，不过，要是能有禽肉就最好了。"
                },
                {
                    "id": "718170607",
                    "speaker": "卡斯帕",
                    "text": "我不熟悉璃月菜，点什么就由你来定好了，那就拜托你了。"
                }
            ]
        },
        {
            "id": "7181705",
            "objective": "向言笑回报",
            "dialogues": [
                {
                    "id": "718171401",
                    "speaker": "言笑",
                    "text": "行行行，我都记下了，呼…这下有得忙了。"
                },
                {
                    "id": "718171402",
                    "speaker": "言笑",
                    "text": "我看看还有什么要请你帮忙的，哦对了，这里还有两份外送订单，得麻烦你送一下。"
                },
                {
                    "id": "718171403",
                    "speaker": "言笑",
                    "text": "一份杏仁豆腐给乔姨，一份金丝虾球给茱萸。"
                },
                {
                    "id": "718171404",
                    "speaker": "言笑",
                    "text": "一下做了这么多菜，厨房的食材也不够用了。"
                },
                {
                    "id": "718171405",
                    "speaker": "言笑",
                    "text": "这样吧，你这趟出去一起带点食材回来，<color=#00E1FFFF>稻米、杏仁、豆腐</color>各<color=#00E1FFFF>三份</color>吧。"
                },
                {
                    "id": "718171406",
                    "speaker": "言笑",
                    "text": "现在厨房这点食材真是不够用的，辛苦你出去买了，璃月港的<color=#00E1FFFF>荣发商铺</color>就能买，回头找我报销就成。"
                }
            ]
        },
        {
            "id": "7181706",
            "objective": "(test)选择都正确$HIDDEN",
            "dialogues": [
                {
                    "id": "718170801",
                    "speaker": "Player",
                    "text": "素鲍鱼。"
                },
                {
                    "id": "718170802",
                    "speaker": "言笑",
                    "text": "哦，这菜可不容易做啊。这外国人倒会挑。"
                },
                {
                    "id": "718170803",
                    "speaker": "言笑",
                    "text": "那卡斯帕想吃什么菜？"
                }
            ]
        },
        {
            "id": "7181707",
            "objective": "将餐品送给乔姨",
            "dialogues": [
                {
                    "id": "718170701",
                    "speaker": "言笑",
                    "text": "怎么样，你问过了吧？"
                },
                {
                    "id": "718170702",
                    "speaker": "言笑",
                    "text": "荷尔德林想吃些什么菜？"
                }
            ]
        },
        {
            "id": "7181708",
            "objective": "将餐品送给乔姨",
            "dialogues": [
                {
                    "id": "718171601",
                    "speaker": "乔姨",
                    "text": "哦？这是…望舒客栈的外送吗？"
                },
                {
                    "id": "718171602",
                    "speaker": "乔姨",
                    "text": "好好好，哎呀…过节的时候，吃点望舒客栈的杏仁豆腐还挺好。"
                },
                {
                    "id": "718171603",
                    "speaker": "乔姨",
                    "text": "谢谢你了啊，年轻人。"
                }
            ]
        },
        {
            "id": "7181711",
            "objective": "将餐品送给茱萸",
            "dialogues": [
                {
                    "id": "718171101",
                    "speaker": "Player",
                    "text": "素鲍鱼。"
                },
                {
                    "id": "718171102",
                    "speaker": "言笑",
                    "text": "好，我知道了。"
                }
            ]
        },
        {
            "id": "7181712",
            "objective": "将餐品送给茱萸",
            "dialogues": []
        },
        {
            "id": "7181713",
            "objective": "采购豆腐、杏仁和稻米各三份",
            "dialogues": [
                {
                    "id": "718171301",
                    "speaker": "Player",
                    "text": "香嫩椒椒鸡。"
                },
                {
                    "id": "718171302",
                    "speaker": "言笑",
                    "text": "这外国人喜欢吃辣？嚯，可以啊。"
                }
            ]
        },
        {
            "id": "7181714",
            "objective": "向言笑回报",
            "dialogues": []
        },
        {
            "id": "7181715",
            "objective": "向言笑回报",
            "dialogues": [
                {
                    "id": "718173201",
                    "speaker": "言笑",
                    "text": "谢谢了啊，有你帮忙，真是轻松不少。"
                },
                {
                    "id": "718173202",
                    "speaker": "言笑",
                    "text": "这给我忙的，明明是海灯节，霄灯也没编一盏…"
                },
                {
                    "id": "718173203",
                    "speaker": "言笑",
                    "text": "对了旅行者，你会编霄灯吗？"
                },
                {
                    "id": "718173204",
                    "speaker": "言笑",
                    "text": "还让你帮忙真不大好意思，但我真没空去置办材料编霄灯了。"
                },
                {
                    "id": "718173205",
                    "speaker": "言笑",
                    "text": "你愿意帮忙的话，能不能帮我也编一盏…啊不，两盏，两盏霄灯。"
                },
                {
                    "id": "718173206",
                    "speaker": "言笑",
                    "text": "一盏我自己留着，一盏请你帮我送去给江雪，他一直在客栈旁边钓鱼来着。"
                },
                {
                    "id": "718173207",
                    "speaker": "言笑",
                    "text": "那个吃白食的家伙…也不知道怎么了，平时来蹭吃蹭喝，今天倒是不来了…"
                }
            ]
        },
        {
            "id": "7181716",
            "objective": "将霄灯交给言笑",
            "dialogues": []
        },
        {
            "id": "7181717",
            "objective": "与言笑对话",
            "dialogues": [
                {
                    "id": "718172201",
                    "speaker": "言笑",
                    "text": "你倒是手巧，谢了啊，等会我就去把霄灯给放飞了。"
                },
                {
                    "id": "718172202",
                    "speaker": "言笑",
                    "text": "还有一盏霄灯，请你帮我送给江雪，可别忘了。"
                }
            ]
        },
        {
            "id": "7181718",
            "objective": "将霄灯交给江雪",
            "dialogues": []
        },
        {
            "id": "7181719",
            "objective": "与江雪对话",
            "dialogues": [
                {
                    "id": "718172401",
                    "speaker": "江雪",
                    "text": "霄灯？怎么突然…"
                },
                {
                    "id": "718172402",
                    "speaker": "Player",
                    "text": "是言笑拜托我送给你的。"
                },
                {
                    "id": "718172403",
                    "speaker": "江雪",
                    "text": "那个厨子也是心思细腻，和我刚认识他的时候…已经完全不一样了。"
                },
                {
                    "id": "718172404",
                    "speaker": "江雪",
                    "text": "时光荏苒，我却还是这副拿不起，放不下的模样，真是惭愧。"
                },
                {
                    "id": "718172405",
                    "speaker": "Player",
                    "text": "放不下什么？"
                },
                {
                    "id": "718172406",
                    "speaker": "江雪",
                    "text": "没事，一些琐事，不提也罢。有劳你跑这一趟，还送了我这盏霄灯。"
                },
                {
                    "id": "718172407",
                    "speaker": "江雪",
                    "text": "虽然我没有什么想许的心愿，也很多年不放霄灯了…"
                },
                {
                    "id": "718172408",
                    "speaker": "江雪",
                    "text": "但有一盏霄灯在身边，看看也是好的，多谢你了。"
                }
            ]
        },
        {
            "id": "7181721",
            "objective": "(test)隐藏言笑白天闲置对话判断$HIDDEN",
            "dialogues": [
                {
                    "id": "718170101",
                    "speaker": "言笑",
                    "text": "这下糟糕了…"
                },
                {
                    "id": "718170102",
                    "speaker": "Player",
                    "text": "怎么了？"
                },
                {
                    "id": "718170103",
                    "speaker": "言笑",
                    "text": "海灯节啊，客栈里一堆人回去过节了，干活的人少了一堆，忙得要命。"
                },
                {
                    "id": "718170104",
                    "speaker": "言笑",
                    "text": "现在我没闲功夫跟你说话，得赶紧准备着，等晚上客人都来点菜了，我估计水都赶不上喝。"
                },
                {
                    "id": "718170105",
                    "speaker": "言笑",
                    "text": "你既然这么热心来关心我，那干脆晚上来帮忙吧。"
                },
                {
                    "id": "718170106",
                    "speaker": "言笑",
                    "text": "唉，能抓一个帮工是一个，毓华跑哪儿去了…"
                }
            ]
        },
