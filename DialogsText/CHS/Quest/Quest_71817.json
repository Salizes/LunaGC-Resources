        {
            "id": "7181705",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "718170501",
                    "speaker": "荷尔德林",
                    "text": "等了半天，怎么没人来招呼？"
                }
            ]
        },
        {
            "id": "7181712",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "718171201",
                    "speaker": "Player",
                    "text": "金丝虾球。"
                },
                {
                    "id": "718171202",
                    "speaker": "言笑",
                    "text": "好，我知道了。"
                }
            ]
        },
        {
            "id": "7181715",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "718171501",
                    "speaker": "乔姨",
                    "text": "有什么事吗年轻人？"
                }
            ]
        },
        {
            "id": "7181717",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "718171701",
                    "speaker": "茱萸",
                    "text": "青莲，除了金丝虾球，你还有什么想吃的吗？"
                },
                {
                    "id": "718171702",
                    "speaker": "青莲",
                    "text": "咳咳，没事的，再等等好了，外送订单应该快来了。"
                },
                {
                    "id": "718171703",
                    "speaker": "茱萸",
                    "text": "嗯？你有什么事吗？"
                }
            ]
        },
        {
            "id": "7181719",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "718171901",
                    "speaker": "言笑",
                    "text": "你的手脚还真是麻利，不愧是冒险家啊…"
                }
            ]
        },
        {
            "id": "7181721",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "718172101",
                    "speaker": "言笑",
                    "text": "这个吃白食的今天是怎么了…"
                }
            ]
        },
        {
            "id": "7181723",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "718172301",
                    "speaker": "江雪",
                    "text": "又是一年海灯节…"
                }
            ]
        },
        {
            "id": "7181725",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "718172501",
                    "speaker": "言笑",
                    "text": "毓华那丫头怎么还不上来厨房帮忙…"
                }
            ]
        },
        {
            "id": "7181726",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "718172601",
                    "speaker": "言笑",
                    "text": "订单外送、购置食材、出餐…还有什么事来着…"
                }
            ]
        },
        {
            "id": "7181727",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "718172701",
                    "speaker": "荷尔德林",
                    "text": "希望上菜能够快点啊…"
                },
                {
                    "id": "718172702",
                    "speaker": "卡斯帕",
                    "text": "不知道会上什么菜呢…"
