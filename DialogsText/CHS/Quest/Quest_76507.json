    "talks": [
        {
            "id": "7650701",
            "objective": "前往那夏镇",
            "dialogues": [
                {
                    "id": "765070101",
                    "speaker": "派蒙",
                    "text": "#哇，{NICKNAME}，你看你看！不知不觉，这本留影册已经被我们拍得满满当当的啦！每一张都好好看哦！",
                    "choices": [
                        {
                            "id": "765070102",
                            "text": "是啊，时间过得真快。",
                            "response": [
                                {
                                    "id": "765070104",
                                    "speaker": "派蒙",
                                    "text": "嘿嘿，想不到这次能找到这么多漂亮的地方，还给这么多朋友拍了画片。"
                                },
                                {
                                    "id": "765070105",
                                    "speaker": "派蒙",
                                    "text": "你看这张，当时为了找到这个绝佳的拍摄角度，可是费了好大一番功夫呢。不过拍出来的效果真是太棒了！",
                                    "choices": [
                                        {
                                            "id": "765070106",
                                            "text": "多亏了派蒙的找路天赋。",
                                            "response": [
                                                {
                                                    "id": "765070108",
                                                    "speaker": "派蒙",
                                                    "text": "嘿嘿，那当然啦，我可是你最贴心称职的向导嘛。"
                                                },
                                                {
                                                    "id": "765070109",
                                                    "speaker": "派蒙",
                                                    "text": "能换来这么多开心的回忆，也算是物超所值啦！"
                                                },
                                                {
                                                    "id": "765070110",
                                                    "speaker": "派蒙",
                                                    "text": "#{NICKNAME}，你用这台留影机拍照，感觉怎么样？有没有觉得自己的摄影技术突飞猛进，快要赶上勒布朗大师啦？",
                                                    "choices": [
                                                        {
                                                            "id": "765070111",
                                                            "text": "技术嘛…还有很长的路要走。",
                                                            "response": [
                                                                {
                                                                    "id": "765070113",
                                                                    "speaker": "派蒙",
                                                                    "text": "#嗯，说得没错，最重要的就是开心！而且呀，我觉得{NICKNAME}拍的画片，一点也不比那些摄影大师差哦。"
                                                                },
                                                                {
                                                                    "id": "765070114",
                                                                    "speaker": "派蒙",
                                                                    "text": "因为每一张里面，都有我们一起经历的故事，这对我来说，就是无可替代的作品哦。"
                                                                },
                                                                {
                                                                    "id": "765070115",
                                                                    "speaker": "派蒙",
                                                                    "text": "等我们以后…嗯，去别的地方冒险了，回想起来这些美好的时光，一定会特别有意思。"
                                                                },
                                                                {
                                                                    "id": "765070116",
                                                                    "speaker": "Player",
                                                                    "text": "以后也一起拍下更多的画片吧。"
                                                                },
                                                                {
                                                                    "id": "765070117",
                                                                    "speaker": "派蒙",
                                                                    "text": "好！那我们就约定好了，下一本留影册，要比这本更精彩！去创造更多独一无二的回忆吧！"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "765070112",
                                                            "text": "重要的是享受过程。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "765070107",
                                            "text": "也多亏了「应急储备金」。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "765070103",
                            "text": "每一张画片背后，都是一段回忆呢。"
                        }
                    ]
                }
            ]
        }
    ]
}