    "talks": [
        {
            "id": "1913401",
            "objective": "前往拍卖会现场",
            "dialogues": []
        },
        {
            "id": "1913402",
            "objective": "与负责准备的秘书交谈",
            "dialogues": [
                {
                    "id": "191340201",
                    "speaker": "观察花瓶",
                    "text": "（看上去平平无奇的花瓶，好像还有明显的使用痕迹。）"
                },
                {
                    "id": "191340202",
                    "speaker": "观察花瓶",
                    "text": "（这种成色的拍品，应该没有为它出价的理由吧。）"
                }
            ]
        },
        {
            "id": "1913403",
            "objective": "观察拍品的情况",
            "dialogues": []
        },
        {
            "id": "1913404",
            "objective": "观察拍品的情况",
            "dialogues": [
                {
                    "id": "191340301",
                    "speaker": "观察文具",
                    "text": "（没什么特别之处的文房用具，或许摆在房间里还算不错。）"
                },
                {
                    "id": "191340302",
                    "speaker": "观察文具",
                    "text": "（如果想要这个的话，去博来那里买一个应该更划算…）"
                }
            ]
        },
        {
            "id": "1913405",
            "objective": "观察拍品的情况",
            "dialogues": [
                {
                    "id": "191340401",
                    "speaker": "观察发簪",
                    "text": "（做工还算精细的发簪，但看不出其他的特点了。）"
                },
                {
                    "id": "191340402",
                    "speaker": "观察发簪",
                    "text": "（作为商品是合格的，但作为拍卖品，真的卖得出好价吗？）"
                }
            ]
        },
        {
            "id": "1913406",
            "objective": "(test)回滚保护$HIDDEN",
            "dialogues": [
                {
                    "id": "191340601",
                    "speaker": "盈丰",
                    "text": "你们钱带够了吗？"
                },
                {
                    "id": "191340602",
                    "speaker": "盈丰",
                    "text": "凝光大人的拍卖会，这么说吧，买到就是赚到，多买就是多赚。"
                }
            ]
        },
        {
            "id": "1913407",
            "objective": "等待拍卖会开始（16-18点）",
            "dialogues": [
                {
                    "id": "191340701",
                    "speaker": "小斌",
                    "text": "好像没看到特别吸引我的东西…"
                },
                {
                    "id": "191340702",
                    "speaker": "小斌",
                    "text": "凝光大人一定也深知这一点吧，那她一定也有她的考虑。"
                }
            ]
        },
        {
            "id": "1913408",
            "objective": "参与拍卖会",
            "dialogues": []
        },
        {
            "id": "1913409",
            "objective": "了解参拍者的想法",
            "dialogues": [
                {
                    "id": "191340901",
                    "speaker": "晓飞",
                    "text": "欸？你问我为什么要出这么高的价？"
                },
                {
                    "id": "191340902",
                    "speaker": "晓飞",
                    "text": "那还用说嘛，因为这是凝光的东西啊。"
                },
                {
                    "id": "191340903",
                    "speaker": "晓飞",
                    "text": "虽然东西看上去很一般，但只是因为我的眼光一般，知识储备也不足…"
                },
                {
                    "id": "191340904",
                    "speaker": "晓飞",
                    "text": "总之先买下来，然后赶快找个人帮我鉴定一下，我就发财了，嘿嘿。"
                }
            ]
        },
        {
            "id": "1913410",
            "objective": "了解参拍者的想法",
            "dialogues": [
                {
                    "id": "191341001",
                    "speaker": "盈丰",
                    "text": "这可算是下了血本，不过最后的结果也很让我满意，哼。"
                },
                {
                    "id": "191341002",
                    "speaker": "Player",
                    "text": "你不担心价格虚高吗？"
                },
                {
                    "id": "191341003",
                    "speaker": "盈丰",
                    "text": "只要是从凝光这里买的东西，就永远不会虚高。"
                },
                {
                    "id": "191341004",
                    "speaker": "盈丰",
                    "text": "像我这么相信凝光大人的买家大有人在，我能赚多少，就看有多少人比我更狂热了。"
                }
            ]
        },
        {
            "id": "1913411",
            "objective": "了解参拍者的想法",
            "dialogues": [
                {
                    "id": "191341101",
                    "speaker": "小斌",
                    "text": "唉，运气不好，没买到几个东西。"
                },
                {
                    "id": "191341102",
                    "speaker": "小斌",
                    "text": "竞争的人实在太多了，看来都是懂行的。"
                },
                {
                    "id": "191341103",
                    "speaker": "小斌",
                    "text": "没办法，我只能下次再来碰碰运气了，我总会被命运眷顾的。"
                }
            ]
        },
        {
            "id": "1913412",
            "objective": "(test)回滚保护$HIDDEN",
            "dialogues": []
        },
        {
            "id": "1913413",
            "objective": "再次与凝光交谈",
            "dialogues": [
                {
                    "id": "191341301",
                    "speaker": "<UNKNOWN>",
                    "text": "(test)你先逛逛会场吧，晚上我们就开始。"
                }
            ]
        },
        {
            "id": "1913414",
            "objective": "",
            "dialogues": [
                {
                    "id": "191341401",
                    "speaker": "凝光",
                    "text": "拍卖会开始之前，你可以看看拍品，或者随意逛逛。"
                },
                {
                    "id": "191341402",
                    "speaker": "凝光",
                    "text": "说不定会发现你感兴趣的东西。"
                }
            ]
        },
        {
            "id": "1913215",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "191321501",
                    "speaker": "鸿如",
                    "text": "欢迎下次光临。"
                }
            ]
        },
        {
            "id": "1913401",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "191340114",
                    "speaker": "凝光",
                    "text": "去看看拍品吧，看看有没有你感兴趣的东西。"
                }
            ]
        },
        {
            "id": "1913405",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "191340501",
                    "speaker": "晓飞",
                    "text": "凝光大人的东西，价值应该都有保障吧。"
                },
                {
                    "id": "191340502",
                    "speaker": "晓飞",
                    "text": "既然如此，价格稍微溢出一点问题应该也不大…"
                }
            ]
        },
        {
            "id": "1913415",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "191341501",
                    "speaker": "凝光",
                    "text": "直接去问问吧，他们会给你满意的回答。"
                },
                {
                    "id": "191341502",
                    "speaker": "凝光",
                    "text": "我相信你能够看清其中的原因。"
                }
            ]
        }
    ]
}