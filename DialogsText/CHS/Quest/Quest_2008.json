    "talks": [
        {
            "id": "200807",
            "objective": "(test)特殊显示逻辑控制任务$HIDDEN",
            "dialogues": []
        },
        {
            "id": "200805",
            "objective": "等到第二天，再次前往木漏茶室",
            "dialogues": []
        },
        {
            "id": "200806",
            "objective": "前往木漏茶室",
            "dialogues": [
                {
                    "id": "20080301",
                    "speaker": "派蒙",
                    "text": "奇怪，今天怎么这么安静，和平时完全不一样。"
                },
                {
                    "id": "20080302",
                    "speaker": "太郎丸",
                    "text": "汪汪…汪！"
                },
                {
                    "id": "20080303",
                    "speaker": "派蒙",
                    "text": "难道说，又是这种双簧演出吗？"
                },
                {
                    "id": "20080304",
                    "speaker": "派蒙",
                    "text": "托马——托马——"
                },
                {
                    "id": "20080305",
                    "speaker": "太郎丸",
                    "text": "汪！汪！…汪！"
                },
                {
                    "id": "20080306",
                    "speaker": "派蒙",
                    "text": "喂——不要再躲了，我已经看见你啦——"
                },
                {
                    "id": "20080307",
                    "speaker": "派蒙",
                    "text": "嗯？完全没有人回应，托马跑到哪里去了？"
                },
                {
                    "id": "20080308",
                    "speaker": "太郎丸",
                    "text": "汪汪汪！汪！"
                },
                {
                    "id": "20080309",
                    "speaker": "派蒙",
                    "text": "咦？平时一直那么老实的太郎丸，今天好像很急躁的样子…"
                },
                {
                    "id": "20080310",
                    "speaker": "神里绫华",
                    "text": "两位，有看到托马吗？"
                },
                {
                    "id": "20080311",
                    "speaker": "派蒙",
                    "text": "我们还以为他跟你在一起呢，发生什么事了吗？"
                },
                {
                    "id": "20080312",
                    "speaker": "神里绫华",
                    "text": "糟糕…我在来这里的路上，听说托马被天领奉行的人抓走了。"
                },
                {
                    "id": "20080313",
                    "speaker": "神里绫华",
                    "text": "我没办法判断消息是真是假，就立刻跑过来确认。如果托马没有按照约定出现在这里，意味着传闻大概率是真的。"
                },
                {
                    "id": "20080314",
                    "speaker": "神里绫华",
                    "text": "雷电将军会在千手百眼神像前，举办第一百颗神之眼的「狩眼仪式」。"
                },
                {
                    "id": "20080315",
                    "speaker": "神里绫华",
                    "text": "而那第一百颗神之眼的持有者…也就是即将被公开狩眼的对象，恐怕…就是托马。"
                },
                {
                    "id": "20080316",
                    "speaker": "派蒙",
                    "text": "难道托马之前听说的，天领奉行正在筹备的「仪式」，刚好就是为他准备的「狩眼仪式」？"
                },
                {
                    "id": "20080317",
                    "speaker": "神里绫华",
                    "text": "应该…是的，将军和天领奉行的人准备以第一百颗神之眼的「狩眼仪式」，来证明眼狩令的阶段性成果。"
                },
                {
                    "id": "20080318",
                    "speaker": "神里绫华",
                    "text": "…不行，我必须去救他！"
                },
                {
                    "id": "20080319",
                    "speaker": "太郎丸",
                    "text": "汪汪！汪！"
                },
                {
                    "id": "20080320",
                    "speaker": "Player",
                    "text": "冷静。"
                },
                {
                    "id": "20080321",
                    "speaker": "Player",
                    "text": "但「白鹭公主」也代表了社奉行。"
                },
                {
                    "id": "20080322",
                    "speaker": "派蒙",
                    "text": "是呀，如果你亲自过去的话，不就代表社奉行要和雷电将军为敌了吗？"
                },
                {
                    "id": "20080323",
                    "speaker": "派蒙",
                    "text": "公然反抗雷电将军的话，社奉行那些普通人也会被牵连进来吧…"
                },
                {
                    "id": "20080324",
                    "speaker": "神里绫华",
                    "text": "这也是没办法的事…时间已经不多了，仪式就要开始，我不能就这样放弃托马。"
                },
                {
                    "id": "20080325",
                    "speaker": "神里绫华",
                    "text": "他是我的朋友，明明不久之前，我们大家还一起…"
                },
                {
                    "id": "20080326",
                    "speaker": "Player",
                    "text": "他也是我的朋友，我去救他。"
                },
                {
                    "id": "20080327",
                    "speaker": "神里绫华",
                    "text": "可是…"
                },
                {
                    "id": "20080328",
                    "speaker": "Player",
                    "text": "你刚才说过吧？——时间不多了。"
                },
                {
                    "id": "20080329",
                    "speaker": "神里绫华",
                    "text": "……"
                },
                {
                    "id": "20080330",
                    "speaker": "神里绫华",
                    "text": "…嗯，我会…等你们平安回来。"
                },
                {
                    "id": "20080331",
                    "speaker": "派蒙",
                    "text": "放心吧，绫华，事关朋友的性命，我们绝对不会失手的！"
                }
            ]
        },
        {
