        {
            "id": "200804",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "20080401",
                    "speaker": "神里绫华",
                    "text": "请务必小心…"
                }
            ]
        },
        {
            "id": "200899",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "20089901",
                    "speaker": "派蒙",
                    "text": "在稻妻城的日子好像也还不错呢，不过…好像到了托马和绫华所说的「下一步行动」的时间了吧？"
                },
                {
                    "id": "20089902",
                    "speaker": "派蒙",
                    "text": "还是到木漏茶室集合，准备好了就去见他们吧？"
                }
            ]
        },
        {
            "id": "4002015",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "400201501",
                    "speaker": "渡部",
                    "text": "唉！这次的失败，真是耻辱！"
                },
                {
                    "id": "400201502",
                    "speaker": "Player",
                    "text": "关于天领奉行…"
                },
                {
                    "id": "400201503",
                    "speaker": "渡部",
                    "text": "如你所见，时局改变了，天领奉行正对稻妻全境重新布防。"
                },
                {
                    "id": "400201504",
                    "speaker": "渡部",
                    "text": "虽说我们远不如九条裟罗大人那般迅捷骁勇，但也要倾尽全力，守护稻妻，绝不能让魔物再猖狂下去了…"
                }
            ]
        },
        {
            "id": "4002115",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "400211501",
                    "speaker": "渡部",
                    "text": "不愧是九条裟罗大人！她抽调来的人手，全都是战斗经验丰富的老兵！"
                },
                {
                    "id": "400211502",
                    "speaker": "渡部",
                    "text": "有这些老兵坐镇，再多魔物也没法攻破这道关口！"
                },
                {
                    "id": "400211503",
                    "speaker": "Player",
                    "text": "关于你的伤势…"
                },
                {
                    "id": "400211504",
                    "speaker": "渡部",
                    "text": "这点轻伤不碍事！关键时刻，天领奉行的武士可不能退缩！"
                },
                {
                    "id": "400211505",
                    "speaker": "派蒙",
                    "text": "好强的气势！真让人安心呢！"
                }
            ]
        },
        {
            "id": "4002212",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "400221201",
                    "speaker": "渡部",
                    "text": "局势似乎稳定下来了…这样一来，九条裟罗大人就不必心急了。"
                },
                {
                    "id": "400221202",
                    "speaker": "渡部",
                    "text": "稳妥第一，等到九条裟罗大人将城中事务都处理好，我们再发起总攻，一举拿下这座秘境！"
                },
                {
                    "id": "400221203",
                    "speaker": "派蒙",
                    "text": "他们还真是斗志昂扬啊，我们得抓紧时间了…"
                }
            ]
        },
        {
            "id": "4002303",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "400230301",
                    "speaker": "「式大将」",
                    "text": "追求极致武艺的人，都能在这座「诀箓阴阳寮」中，得到最有效的锤炼。"
                },
                {
                    "id": "400230302",
                    "speaker": "「式大将」",
                    "text": "当然，要是急于挑战强敌，反而有可能遭遇挫折。还请量力而行，不必勉强自己。"
                }
            ]
        }
    ]
}