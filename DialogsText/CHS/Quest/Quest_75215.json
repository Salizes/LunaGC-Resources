    "talks": [
        {
            "id": "7521501",
            "objective": "(test)完成玩法$HIDDEN",
            "dialogues": [
                {
                    "id": "752150101",
                    "speaker": "科里",
                    "text": "怎么了，你也对力量训练营有兴趣吗？"
                },
                {
                    "id": "752150102",
                    "speaker": "科里",
                    "text": "器械可以随意试用，但看你细胳膊细腿的，可别把自己弄伤了。",
                    "choices": [
                        {
                            "id": "752150103",
                            "text": "我每天运动量可大了。",
                            "response": [
                                {
                                    "id": "752150105",
                                    "speaker": "科里",
                                    "text": "真的吗？在和我吹牛之前，不如先和旁边的大方块较较劲吧。"
                                },
                                {
                                    "id": "752150106",
                                    "speaker": "科里",
                                    "text": "<color=#00E1FFFF>攻击</color>或者<color=#00E1FFFF>撞击</color>大方块，根据力量的大小就能得到不同的分数。让我看看你有多大能耐。"
                                }
                            ]
                        },
                        {
                            "id": "752150104",
                            "text": "我能一拳打飞丘丘人。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7521502",
            "objective": "(test)与科里对话$HIDDEN",
            "dialogues": [
                {
                    "id": "752150201",
                    "speaker": "科里",
                    "text": "不会吧，你居然把大方块撞碎了一角？"
                },
                {
                    "id": "752150202",
                    "speaker": "科里",
                    "text": "上一位能有这种力气的人还是瓦雷莎前辈…看来你和她一样，都是天赋型选手啊！",
                    "choices": [
                        {
                            "id": "752150203",
                            "text": "还是有点费劲的。",
                            "response": [
                                {
                                    "id": "752150205",
                                    "speaker": "科里",
                                    "text": "真是人不可貌相啊，有机会的话真想请你来当教练。"
                                },
                                {
                                    "id": "752150206",
                                    "speaker": "科里",
                                    "text": "对了，这瓶沃陆果饮据说能提升运动效果，学员们都爱喝，你也拿去尝尝吧。"
                                }
                            ]
                        },
                        {
                            "id": "752150204",
                            "text": "这种程度的话，轻轻松松。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7521503",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "752150301",
                    "speaker": "科里",
                    "text": "招揽新人其实不难，问题在于训练一段时间之后，就有不少人找借口请假，或者干脆不来了。"
                },
                {
                    "id": "752150302",
                    "speaker": "科里",
                    "text": "教练为了提高大家的积极性，想了很多办法，那个方块挑战就是其中一项。"
                },
                {
                    "id": "752150303",
                    "speaker": "科里",
                    "text": "结果有些人为了提高分数，一个劲地往大方块上面撞，最后搞得鼻青脸肿的，请假的人更多了…"
                }
            ]
        },
        {
            "id": "7521504",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "752150401",
                    "speaker": "科里",
                    "text": "攻击或者撞击大方块，根据力量的大小就能得到不同的分数。还是说这就打算放弃了？"
                }
            ]
        },
        {
            "id": "7521506",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "752150601",
                    "speaker": "科里",
                    "text": "好长时间没见到这么厉害的新人了，真是令人惊叹！"
                }
            ]
        }
    ]
}