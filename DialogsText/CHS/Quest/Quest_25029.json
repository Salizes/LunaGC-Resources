        {
            "id": "2502904",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "250290401",
                    "speaker": "特拉忒",
                    "text": "#{M#大哥哥}{F#大姐姐}好厉害！我都没能看清你爬上去的动作…但是你爬山的速度，比马伊塔还要快！",
                    "choices": [
                        {
                            "id": "250290402",
                            "text": "发挥得一般。",
                            "response": [
                                {
                                    "id": "250290405",
                                    "speaker": "特拉忒",
                                    "text": "但是，这么短的登山时间…奇卡应该暂时没法做到啦…"
                                },
                                {
                                    "id": "250290406",
                                    "speaker": "奇卡",
                                    "text": "呜，呜呜…"
                                },
                                {
                                    "id": "250290407",
                                    "speaker": "特拉忒",
                                    "text": "#没关系，我等下拿着{M#大哥哥}{F#大姐姐}的爬山时间去找马伊塔。说不定，他能帮我制订一个…合理的训练计划。"
                                },
                                {
                                    "id": "250290408",
                                    "speaker": "特拉忒",
                                    "text": "#{M#大哥哥}{F#大姐姐}，谢谢你帮忙，这些「苦种」给你。"
                                },
                                {
                                    "id": "250290409",
                                    "speaker": "特拉忒",
                                    "text": "这是我们刚摘下来的，可新鲜了，做成巧克力一定好吃！"
                                },
                                {
                                    "id": "250290410",
                                    "speaker": "奇卡",
                                    "text": "呜呜，呜呜！"
                                },
                                {
                                    "id": "250290411",
                                    "speaker": "特拉忒",
                                    "text": "那我们就出发吧，不知道马伊塔在不在部族里。他不会又出去攀岩了吧…"
                                }
                            ]
                        },
                        {
                            "id": "250290403",
                            "text": "马伊塔是谁？",
                            "response": [
                                {
                                    "id": "250290404",
                                    "speaker": "特拉忒",
                                    "text": "他是我的朋友，特别擅长攀岩。除了洛娅姐姐之外，几乎没人能在攀岩这个项目里胜过他。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2502905",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "250290501",
                    "speaker": "特拉忒",
                    "text": "#嘿嘿，那就拜托{M#大哥哥}{F#大姐姐}啦，我们会在底下算好时间的。"
                },
                {
                    "id": "250290502",
                    "speaker": "奇卡",
                    "text": "呜，呜？呜呜…"
                }
            ]
        },
        {
            "id": "2502907",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "250290701",
                    "speaker": "奇卡",
                    "text": "山，高高，好累…"
                }
            ]
        },
        {
            "id": "2502908",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "250290801",
                    "speaker": "特拉忒",
                    "text": "#那就拜托你啦，{M#大哥哥}{F#大姐姐}。我们会在地上仔细看着你的动作，算好时间的。"
                }
            ]
        },
        {
