    "talks": [
        {
            "id": "2502901",
            "objective": "与特拉忒对话",
            "dialogues": [
                {
                    "id": "250290101",
                    "speaker": "特拉忒",
                    "text": "乖乖喔，不要灰心，只要你身体好了，然后…加油学习！一定能很快爬到山顶的！"
                },
                {
                    "id": "250290102",
                    "speaker": "奇卡",
                    "text": "呜呜…呜…"
                },
                {
                    "id": "250290103",
                    "speaker": "特拉忒",
                    "text": "你是不是肚子饿了？嗯…那我去给你拿点吃的喔。"
                },
                {
                    "id": "250290104",
                    "speaker": "奇卡",
                    "text": "呜…呜…"
                },
                {
                    "id": "250290105",
                    "speaker": "Player",
                    "text": "你在做什么呢？"
                },
                {
                    "id": "250290106",
                    "speaker": "特拉忒",
                    "text": "我在陪我的伙伴奇卡玩呢。虽然它还很小，但我妈妈说，它长大后，肯定会和其他匿叶龙一样厉害！"
                },
                {
                    "id": "250290107",
                    "speaker": "奇卡",
                    "text": "呜…呜呜…"
                },
                {
                    "id": "250290108",
                    "speaker": "特拉忒",
                    "text": "别难过啦。你只是身子太弱了，之前还受过伤。"
                },
                {
                    "id": "250290109",
                    "speaker": "特拉忒",
                    "text": "妈妈说，只要你多吃好吃的，然后和我一起多多锻炼，肯定会好起来的。"
                },
                {
                    "id": "250290110",
                    "speaker": "奇卡",
                    "text": "呜？呜呜…",
                    "choices": [
                        {
                            "id": "250290111",
                            "text": "（摸摸奇卡。）",
                            "response": [
                                {
                                    "id": "250290112",
                                    "speaker": "奇卡",
                                    "text": "呜呜…呜…"
                                },
                                {
                                    "id": "250290119",
                                    "speaker": "特拉忒",
                                    "text": "哎呀，说了这么多话，马上就要锻炼了，先吃点东西好了。"
                                },
                                {
                                    "id": "250290120",
                                    "speaker": "特拉忒",
                                    "text": "这可是我妈妈特制的果干，先在大锅里炒啊炒，然后加入很多香香的调料…"
                                },
                                {
                                    "id": "250290121",
                                    "speaker": "特拉忒",
                                    "text": "而且还要加好多糖和花瓣…总之，味道可好了！我这就给你欸？…"
                                },
                                {
                                    "id": "250290122",
                                    "speaker": "特拉忒",
                                    "text": "我的果干呢？明明放在包里的…"
                                },
                                {
                                    "id": "250290123",
                                    "speaker": "奇卡",
                                    "text": "…呜，呜…"
                                },
                                {
                                    "id": "250290124",
                                    "speaker": "特拉忒",
                                    "text": "呜哇！奇卡！难道都被你偷吃了？都说了不要馋嘴，吃多了就跑不动啦！"
                                },
                                {
                                    "id": "250290125",
                                    "speaker": "奇卡",
                                    "text": "唔唔，呜…",
                                    "choices": [
                                        {
                                            "id": "250290126",
                                            "text": "有食欲是好事。",
                                            "response": [
                                                {
                                                    "id": "250290128",
                                                    "speaker": "奇卡",
                                                    "text": "呜呜，呜呜呜！"
                                                },
                                                {
                                                    "id": "250290129",
                                                    "speaker": "特拉忒",
                                                    "text": "是这样吗？那…我也要和奇卡一样。吃好多东西，快快长大，然后帮妈妈的忙。"
                                                },
                                                {
                                                    "id": "250290130",
                                                    "speaker": "特拉忒",
                                                    "text": "好，那我们就开始锻炼吧，奇卡！"
                                                },
                                                {
                                                    "id": "250290131",
                                                    "speaker": "奇卡",
                                                    "text": "呜！"
                                                },
                                                {
                                                    "id": "250290132",
                                                    "speaker": "特拉忒",
                                                    "text": "我看看喔…那今天就训练一下登山吧。"
                                                },
                                                {
                                                    "id": "250290133",
                                                    "speaker": "奇卡",
                                                    "text": "呜，呜…"
                                                },
                                                {
                                                    "id": "250290134",
                                                    "speaker": "特拉忒",
                                                    "text": "还是和上次一样，不会很难的。打起劲来呀，奇卡。"
                                                },
                                                {
                                                    "id": "250290135",
                                                    "speaker": "奇卡",
                                                    "text": "…呜！"
                                                },
                                                {
                                                    "id": "250290136",
                                                    "speaker": "特拉忒",
                                                    "text": "对了，亚瓦尔叔叔上次和我说，如果想要正经训练的话，就需要找到一个合理的「训练目标」…"
                                                },
                                                {
                                                    "id": "250290137",
                                                    "speaker": "特拉忒",
                                                    "text": "要是我能找到一个很厉害的冒险家，让他帮我制订目标就好了…",
                                                    "choices": [
                                                        {
                                                            "id": "250290138",
                                                            "text": "我是比较厉害的冒险家。",
                                                            "response": [
                                                                {
                                                                    "id": "250290140",
                                                                    "speaker": "特拉忒",
                                                                    "text": "#真的？那…{M#大哥哥}{F#大姐姐}，你愿意帮我吗？",
                                                                    "choices": [
                                                                        {
                                                                            "id": "250290141",
                                                                            "text": "要我带着你们爬山吗？",
                                                                            "response": [
                                                                                {
                                                                                    "id": "250290143",
                                                                                    "speaker": "特拉忒",
                                                                                    "text": "#不是不是，如果{M#大哥哥}{F#大姐姐}真的那么厉害，我们可追不上啦。"
                                                                                },
                                                                                {
                                                                                    "id": "250290144",
                                                                                    "speaker": "特拉忒",
                                                                                    "text": "#我们会在地上看着{M#大哥哥}{F#大姐姐}，算好时间的。"
                                                                                },
                                                                                {
                                                                                    "id": "250290145",
                                                                                    "speaker": "特拉忒",
                                                                                    "text": "#拜托{M#大哥哥}{F#大姐姐}用出全力，以最快的速度爬上山顶吧！"
                                                                                },
                                                                                {
                                                                                    "id": "250290146",
                                                                                    "speaker": "奇卡",
                                                                                    "text": "呜！呜！"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "250290142",
                                                                            "text": "好，跟着我，现在就开始！"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "250290139",
                                                            "text": "厉害的冒险家就在你身边。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "250290127",
                                            "text": "吃得多长得壮。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "250290113",
                            "text": "它是怎么受伤的？",
                            "response": [
                                {
                                    "id": "250290114",
                                    "speaker": "特拉忒",
                                    "text": "我不知道…也许妈妈知道！但妈妈把奇卡带回来的时候，它就生着病呢。"
                                },
                                {
                                    "id": "250290115",
                                    "speaker": "特拉忒",
                                    "text": "奇卡吃不下东西，也没力气动。我只能每天把药化在水里，然后喂它喝下去。"
                                },
                                {
                                    "id": "250290116",
                                    "speaker": "特拉忒",
                                    "text": "虽然奇卡最后病好了，但是…它的身体很弱。没办法像其他的匿叶龙一样，在悬崖旁边窜来窜去。"
                                },
                                {
                                    "id": "250290117",
                                    "speaker": "特拉忒",
                                    "text": "它因为这件事一直很难过，所以我想要帮它！让它恢复健康，然后…变得比其他匿叶龙还要强！"
                                },
                                {
                                    "id": "250290118",
                                    "speaker": "奇卡",
                                    "text": "呜！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2502902",
            "objective": "爬上山顶",
            "dialogues": [
                {
                    "id": "250290201",
                    "speaker": "特拉忒",
                    "text": "乖乖喔，今天吃饱了吗？有没有力气训练呀？"
                },
                {
                    "id": "250290202",
                    "speaker": "奇卡",
                    "text": "呜，呜呜，呜！"
                },
                {
                    "id": "250290203",
                    "speaker": "特拉忒",
                    "text": "呜哇，这么有活力？好！那今天可要加把劲了！"
                },
                {
                    "id": "250290204",
                    "speaker": "Player",
                    "text": "一起加把劲吧！"
                },
                {
                    "id": "250290206",
                    "speaker": "特拉忒",
                    "text": "#欸？您好呀，{M#大哥哥}{F#大姐姐}！我们正在进行爬山训练呢。"
                },
                {
                    "id": "250290207",
                    "speaker": "奇卡",
                    "text": "呜呜！呜呜！"
                },
                {
                    "id": "250290208",
                    "speaker": "奇卡",
                    "text": "呜呜，呜…",
                    "choices": [
                        {
                            "id": "250290209",
                            "text": "训练得怎么样？",
                            "response": [
                                {
                                    "id": "250290210",
                                    "speaker": "特拉忒",
                                    "text": "那个…至少能说「有进步」吧。这次奇卡爬的比上次高多了。"
                                },
                                {
                                    "id": "250290211",
                                    "speaker": "特拉忒",
                                    "text": "就是在爬山的时候，奇卡的动作有些不熟练…"
                                },
                                {
                                    "id": "250290216",
                                    "speaker": "特拉忒",
                                    "text": "#{M#大哥哥}{F#大姐姐}，你能再为我们示范一遍吗？",
                                    "choices": [
                                        {
                                            "id": "250290217",
                                            "text": "没问题。",
                                            "response": [
                                                {
                                                    "id": "250290218",
                                                    "speaker": "特拉忒",
                                                    "text": "#谢谢你！这次我一定能看清{M#大哥哥}{F#大姐姐}的动作。"
                                                },
                                                {
                                                    "id": "250290219",
                                                    "speaker": "特拉忒",
                                                    "text": "奇卡，你也要睁大眼睛喔。"
                                                },
                                                {
                                                    "id": "250290220",
                                                    "speaker": "奇卡",
                                                    "text": "呜！"
                                                },
                                                {
                                                    "id": "250290223",
                                                    "speaker": "特拉忒",
                                                    "text": "#那就拜托你啦，{M#大哥哥}{F#大姐姐}。"
                                                },
                                                {
                                                    "id": "250290224",
                                                    "speaker": "特拉忒",
                                                    "text": "#我们会在地上看着{M#大哥哥}{F#大姐姐}，算好时间的。"
                                                },
                                                {
                                                    "id": "250290225",
                                                    "speaker": "奇卡",
                                                    "text": "呜，呜呜…"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "250290221",
                                            "text": "这次可要看清我的动作。",
                                            "response": [
                                                {
                                                    "id": "250290222",
                                                    "speaker": "特拉忒",
                                                    "text": "当然啦。我和奇卡都会睁大眼睛仔细看的，这次一定能看清！"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "250290212",
                            "text": "看起来它恢复得不错。",
                            "response": [
                                {
                                    "id": "250290213",
                                    "speaker": "特拉忒",
                                    "text": "当然啦。妈妈都说，我可擅长照料奇卡了。"
                                },
                                {
                                    "id": "250290214",
                                    "speaker": "特拉忒",
                                    "text": "奇卡的进步可大了，爬的高度也比上次高很多。"
                                },
                                {
                                    "id": "250290215",
                                    "speaker": "特拉忒",
                                    "text": "就是在爬山的时候，奇卡的动作有些不熟练…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2502903",
            "objective": "(test)隐藏任务用于判断是达成时限要求$HIDDEN",
            "dialogues": [
                {
                    "id": "250290301",
                    "speaker": "特拉忒",
                    "text": "#{M#大哥哥}{F#大姐姐}好厉害！爬得和马伊塔一样快！",
                    "choices": [
                        {
                            "id": "250290302",
                            "text": "有，有点失误…",
                            "response": [
                                {
                                    "id": "250290303",
                                    "speaker": "特拉忒",
                                    "text": "#失误？难道{M#大哥哥}{F#大姐姐}还能爬得更快？这就是超厉害冒险家的实力吗…"
                                },
                                {
                                    "id": "250290306",
                                    "speaker": "特拉忒",
                                    "text": "把这个爬山时间作为目标的话…嗯…"
                                },
                                {
                                    "id": "250290307",
                                    "speaker": "奇卡",
                                    "text": "呜，呜呜…"
                                },
                                {
                                    "id": "250290308",
                                    "speaker": "特拉忒",
                                    "text": "…哈哈，好像还是有些难为你了呢。"
                                },
                                {
                                    "id": "250290309",
                                    "speaker": "特拉忒",
                                    "text": "#没关系，我等下拿着{M#大哥哥}{F#大姐姐}的爬山时间去找马伊塔。说不定，他能帮我制订一个…合理的训练计划。"
                                },
                                {
                                    "id": "250290310",
                                    "speaker": "特拉忒",
                                    "text": "#{M#大哥哥}{F#大姐姐}，谢谢你帮忙，这枚「苦种」给你。"
                                },
                                {
                                    "id": "250290311",
                                    "speaker": "特拉忒",
                                    "text": "这是我们刚摘下来的，可新鲜了，做成巧克力一定好吃！"
                                },
                                {
                                    "id": "250290312",
                                    "speaker": "奇卡",
                                    "text": "呜呜，呜呜！"
                                },
                                {
                                    "id": "250290313",
                                    "speaker": "特拉忒",
                                    "text": "那我们就出发吧，不知道马伊塔在不在部族里。他不会又出去攀岩了吧…"
                                }
                            ]
                        },
                        {
                            "id": "250290304",
                            "text": "马伊塔是谁？",
                            "response": [
                                {
                                    "id": "250290305",
                                    "speaker": "特拉忒",
                                    "text": "他是我的朋友，特别擅长攀岩。除了洛娅姐姐之外，几乎没人能在攀岩这个项目里胜过他。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
