                }
            ]
        },
        {
            "id": "4133418",
            "objective": "与朱老板对话",
            "dialogues": []
        },
        {
            "id": "4133419",
            "objective": "与鉴秋对话",
            "dialogues": [
                {
                    "id": "413342701",
                    "speaker": "鉴秋",
                    "text": "旅行者，抱歉打扰你，请问…你愿不愿意护送我们上山去放霄灯？",
                    "choices": [
                        {
                            "id": "413342702",
                            "text": "交给我了。",
                            "response": [
                                {
                                    "id": "413342704",
                                    "speaker": "鉴秋",
                                    "text": "抱歉，因为一些事…我们暂时不好回城里。"
                                },
                                {
                                    "id": "413342705",
                                    "speaker": "鉴秋",
                                    "text": "那就拜托你护送一下我们了，快些出发吧。"
                                },
                                {
                                    "id": "413342706",
                                    "speaker": "鉴秋",
                                    "text": "放完霄灯后…我们就要接着赶路了。"
                                }
                            ]
                        },
                        {
                            "id": "413342703",
                            "text": "为什么你们不回城里去？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "4133420",
            "objective": "护送两人前往高处放飞霄灯",
            "dialogues": [
                {
                    "id": "413342001",
                    "speaker": "花初",
                    "text": "对不起…我只是…"
                },
                {
                    "id": "413342002",
                    "speaker": "鉴秋",
                    "text": "小姐，不要这么说，现在再看看霄灯也好，以后…"
                }
            ]
        },
        {
            "id": "4133421",
            "objective": "护送两人前往高处放飞霄灯",
            "dialogues": [
                {
                    "id": "413342101",
                    "speaker": "鉴秋",
                    "text": "在这里放霄灯确实不错，谢谢你，旅行者。"
                },
                {
                    "id": "413342102",
                    "speaker": "Player",
                    "text": "不客气。"
                },
                {
                    "id": "413342103",
                    "speaker": "鉴秋",
                    "text": "希望…小姐的愿望能够实现。"
                },
                {
                    "id": "413342104",
                    "speaker": "花初",
                    "text": "……"
                },
                {
                    "id": "413342105",
                    "speaker": "鉴秋",
                    "text": "谢谢你旅行者，我们这就接着去赶路了。"
                }
            ]
        },
        {
            "id": "4133422",
            "objective": "与朱老板对话",
            "dialogues": [
                {
                    "id": "413342801",
                    "speaker": "朱老板",
                    "text": "你回来了啊，哎呀…这大过节的，是真的不好招揽客人…"
                },
                {
                    "id": "413342802",
                    "speaker": "朱老板",
                    "text": "咦？刚才那两位呢，走了？"
                },
                {
                    "id": "413342803",
                    "speaker": "Player",
                    "text": "接着赶路去了。"
                },
                {
                    "id": "413342804",
                    "speaker": "朱老板",
                    "text": "噢，这样啊…大过节的还要赶路，也是挺辛苦的。"
                },
                {
                    "id": "413342805",
                    "speaker": "朱老板",
                    "text": "不过，说起来倒也很怪啊，人家赶路要么是从璃月往外走，要么是从外面往璃月走，一路走个不停。"
                },
                {
                    "id": "413342806",
                    "speaker": "朱老板",
                    "text": "我遇见这两位的时候，看他们的神情，完全是一副不知道该往哪里走的样子。"
                },
                {
                    "id": "413342807",
                    "speaker": "朱老板",
                    "text": "我招呼他们的时候，他们还被吓了一跳。而且看他们的穿着打扮…我也总觉得哪里怪怪的…"
                },
                {
                    "id": "413342808",
                    "speaker": "朱老板",
                    "text": "算了，不说这些了，这些是说好的报酬，收下吧。"
                },
                {
                    "id": "413342809",
                    "speaker": "朱老板",
                    "text": "谢谢你帮我的忙，我要接着去打理生意了。"
                }
            ]
        },
        {
            "id": "4133424",
            "objective": "",
            "dialogues": [
                {
                    "id": "413342401",
                    "speaker": "老刘伯",
                    "text": "（test）说了不去就是不去。"
                }
            ]
        },
        {
            "id": "4133423",
            "objective": "",
            "dialogues": [
                {
                    "id": "413342301",
                    "speaker": "阿笨",
                    "text": "还得再编几盏霄灯才行，但是还缺<color=#00E1FFFF>两份灯纸纤维</color>、<color=#00E1FFFF>两份灯芯绒材</color>，不过老板说了会想办法…"
                }
            ]
        },
        {
            "id": "4133407",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "413340701",
                    "speaker": "阿笨",
                    "text": "(test)呼，终于做好了。麻烦你帮忙挂到客栈正门的飞檐上吧。"
                },
                {
                    "id": "413340702",
                    "speaker": "Player",
                    "text": "(test)为什么不自己挂"
                },
                {
                    "id": "413340703",
                    "speaker": "阿笨",
                    "text": "(test)太高了爬不上去。"
                },
                {
                    "id": "413340704",
                    "speaker": "Player",
                    "text": "(test)好吧。"
                },
                {
                    "id": "413340705",
                    "speaker": "阿笨",
                    "text": "(test)麻烦了。"
                }
            ]
        },
        {
            "id": "4133415",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "413341501",
                    "speaker": "老刘伯",
                    "text": "不好意思啊，他那个店离这里太远了，我可走不了那么远的路。"
                }
            ]
        }
    ]
