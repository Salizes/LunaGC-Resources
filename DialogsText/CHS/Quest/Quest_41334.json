    "talks": [
        {
            "id": "4133426",
            "objective": "",
            "dialogues": [
                {
                    "id": "413342601",
                    "speaker": "鉴秋",
                    "text": "谢谢老板招待了，这是钱，您点一点。"
                },
                {
                    "id": "413342602",
                    "speaker": "朱老板",
                    "text": "好好，这些钱够了…看二位的样子，是要接着赶路？还是说，要回去城里看看？"
                },
                {
                    "id": "413342603",
                    "speaker": "朱老板",
                    "text": "我听说今年那「明霄灯」可不一般，神气得很呐。"
                },
                {
                    "id": "413342604",
                    "speaker": "花初",
                    "text": "我们…"
                },
                {
                    "id": "413342605",
                    "speaker": "鉴秋",
                    "text": "如果有机会的话，我们会去看的，谢谢老板提醒了。"
                },
                {
                    "id": "413342606",
                    "speaker": "花初",
                    "text": "不过…老板，可否再卖我们一盏霄灯？"
                },
                {
                    "id": "413342607",
                    "speaker": "花初",
                    "text": "就算是没机会去城里看「明霄灯」，放一放霄灯也是好的…对吗？"
                },
                {
                    "id": "413342608",
                    "speaker": "鉴秋",
                    "text": "小姐说的是，海灯节当然应该放霄灯。"
                },
                {
                    "id": "413342609",
                    "speaker": "朱老板",
                    "text": "那好说，没问题，我手头上正好有几盏新编的霄灯。"
                },
                {
                    "id": "413342610",
                    "speaker": "朱老板",
                    "text": "喏，送给你们一盏了，大过节的，霄灯就不收你们钱了。"
                },
                {
                    "id": "413342611",
                    "speaker": "鉴秋",
                    "text": "多谢老板了，那我再多问一句，这周围有什么适合放霄灯的地方吗？"
                },
                {
                    "id": "413342612",
                    "speaker": "朱老板",
                    "text": "放霄灯的地方…那得高一点，沿着这条路往山上走，我记得有个适合放霄灯的地方。"
                },
                {
                    "id": "413342613",
                    "speaker": "朱老板",
                    "text": "不过，我听说这山里有魔物出没，你们可要小心点啊。"
                }
            ]
        },
        {
            "id": "4133401",
            "objective": "与朱老板对话",
            "dialogues": [
                {
                    "id": "413340101",
                    "speaker": "朱老板",
                    "text": "得想个办法…"
                },
                {
                    "id": "413340102",
                    "speaker": "Player",
                    "text": "想什么办法？"
                },
                {
                    "id": "413340103",
                    "speaker": "朱老板",
                    "text": "啊…是旅行者啊，这不是过海灯节了吗？我想要借着这次海灯节，让我这里的生意红火一点…"
                },
                {
                    "id": "413340104",
                    "speaker": "朱老板",
                    "text": "你看，我这里的位置也不错，环境也挺好，菜色嘛…也不少。"
                },
                {
                    "id": "413340105",
                    "speaker": "朱老板",
                    "text": "等城里放飞「明霄灯」的时候，坐在我这里，好景好酒好菜，感觉肯定很不错。"
                },
                {
                    "id": "413340106",
                    "speaker": "朱老板",
                    "text": "我准备就以这个为卖点招揽客人，你觉得怎么样？",
                    "choices": [
                        {
                            "id": "413340107",
                            "text": "这里看得到「明霄灯」吗？",
                            "response": [
                                {
                                    "id": "413340109",
                                    "speaker": "朱老板",
                                    "text": "呃…应该看得到吧，「明霄灯」那么大，怎么样都能看到一点…"
                                },
                                {
                                    "id": "413340110",
                                    "speaker": "朱老板",
                                    "text": "这个…没关系，到时候再说吧，我得先把店里打理打理…"
                                },
                                {
                                    "id": "413340111",
                                    "speaker": "朱老板",
                                    "text": "旅行者，能请你帮忙搜集些做霄灯的材料来吗？我想要挂点霄灯在店里。",
                                    "choices": [
                                        {
                                            "id": "413340112",
                                            "text": "不如我直接编了给你…",
                                            "response": [
                                                {
                                                    "id": "413340114",
                                                    "speaker": "朱老板",
                                                    "text": "没关系，只要材料就行，编霄灯也挺麻烦的…"
                                                },
                                                {
                                                    "id": "413340115",
                                                    "speaker": "朱老板",
                                                    "text": "你搜集好了之后，就直接把材料给阿笨吧，他会把霄灯编好的。我也得去准备点其他的事…"
                                                },
                                                {
                                                    "id": "413340116",
                                                    "speaker": "朱老板",
                                                    "text": "当然，我肯定也不会让你白忙活，等到时候招揽到了客人，做好了生意，自然有报酬奉上。"
                                                },
                                                {
                                                    "id": "413340117",
                                                    "speaker": "Player",
                                                    "text": "那要是没客人…"
                                                },
                                                {
                                                    "id": "413340118",
                                                    "speaker": "朱老板",
                                                    "text": "呃…就算是…没客人，我也会给您准备好报酬的，请您尽管放心。"
                                                },
                                                {
                                                    "id": "413340119",
                                                    "speaker": "朱老板",
                                                    "text": "总归，等把店整理好了，客人们也差不多就该来了。"
                                                },
                                                {
                                                    "id": "413340120",
                                                    "speaker": "朱老板",
                                                    "text": "咳…那你把材料交给阿笨就行了，等明天我看情况给你结算报酬。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "413340113",
                                            "text": "只要材料吗？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "413340108",
                            "text": "这里应该看不到「明霄灯」吧…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "4133411",
            "objective": "",
            "dialogues": [
                {
                    "id": "413341101",
                    "speaker": "朱老板",
                    "text": "好不容易来了贵客，「美味的珍珠翡翠白玉汤」还得拜托你赶紧准备上，不能怠慢了客人。"
                }
            ]
        },
        {
            "id": "4133402",
            "objective": "搜集两份制作「霄灯」的材料",
            "dialogues": [
                {
                    "id": "413340201",
                    "speaker": "朱老板",
                    "text": "这里真看不见「明霄灯」吗…"
                }
            ]
        },
        {
            "id": "4133403",
            "objective": "搜集两份制作「霄灯」的材料",
            "dialogues": [
                {
                    "id": "413340301",
                    "speaker": "阿笨",
                    "text": "还得再编些霄灯才行啊…"
                }
            ]
        },
        {
            "id": "4133404",
            "objective": "",
            "dialogues": [
                {
                    "id": "413340401",
                    "speaker": "朱老板",
                    "text": "我接着去招揽招揽客人，稍后就算给你报酬。"
                },
                {
                    "id": "413340402",
                    "speaker": "朱老板",
                    "text": "明华钱庄…明华钱庄…嗯…"
                }
            ]
        },
        {
            "id": "4133405",
            "objective": "",
            "dialogues": [
                {
                    "id": "413340501",
                    "speaker": "阿笨",
                    "text": "我正发愁材料快不够了，谢谢你。"
                },
                {
                    "id": "413340502",
                    "speaker": "阿笨",
                    "text": "请你稍等一下，我再编一些霄灯，请你一起把这些霄灯挂上去吧。"
                },
                {
                    "id": "413340503",
                    "speaker": "阿笨",
                    "text": "好了，这些应该差不多了，请你把这些霄灯挂到店门上去吧。"
                },
                {
                    "id": "413340504",
                    "speaker": "阿笨",
                    "text": "我还得再编一些，免得之后还要用…"
                }
            ]
        },
        {
            "id": "4133406",
            "objective": "将制作「霄灯」的材料交给阿笨",
            "dialogues": [
                {
                    "id": "413340601",
                    "speaker": "阿笨",
                    "text": "霄灯…嗯…还得再编几个才行啊…"
                },
                {
                    "id": "413340602",
                    "speaker": "Player",
                    "text": "关于制作霄灯的材料…"
                },
                {
                    "id": "413340603",
                    "speaker": "阿笨",
                    "text": "对，这些材料给我就行，我来编就好。"
                }
            ]
        },
        {
            "id": "4133410",
            "objective": "与阿笨对话",
            "dialogues": []
        },
        {
            "id": "4133408",
            "objective": "将「霄灯」挂在店门一侧",
            "dialogues": [
                {
                    "id": "413340801",
                    "speaker": "朱老板",
                    "text": "奇了怪了，怎么没客人呢…"
                }
            ]
        },
        {
            "id": "4133409",
            "objective": "将「霄灯」挂在店门另一侧",
            "dialogues": [
                {
                    "id": "413340901",
                    "speaker": "振翔",
                    "text": "抱歉，我不能擅自离岗，你们的好意我心领了。"
                }
            ]
        },
        {
            "id": "4133425",
            "objective": "等到第二天白天去找朱老板（12点~18点）",
            "dialogues": [
                {
                    "id": "413342501",
                    "speaker": "朱老板",
                    "text": "二位这边请，这边请，我们这什么都备齐了，这边坐就好。"
                },
                {
                    "id": "413342502",
                    "speaker": "Player",
                    "text": "老板，这两位是…"
                },
                {
                    "id": "413342503",
                    "speaker": "朱老板",
                    "text": "哦，我刚才也自己出去招揽客人了，走到下面的时候，就遇见了这两位。"
                },
                {
                    "id": "413342504",
                    "speaker": "鉴秋",
                    "text": "是的，这位是明华钱庄的小姐，我是明华钱庄的雇员。"
                },
                {
                    "id": "413342505",
                    "speaker": "鉴秋",
                    "text": "我和小姐本来正在出行远游，恰逢海灯节，小姐有些…想家。"
                },
                {
                    "id": "413342506",
                    "speaker": "鉴秋",
                    "text": "所以我们就想要挑个地方看看霄灯，恰巧走到这里，就遇见这位老板。"
                },
                {
                    "id": "413342507",
                    "speaker": "朱老板",
                    "text": "那是，我这店里正好新编了许多霄灯，这不是巧了。但是…明华钱庄？这…"
                },
                {
                    "id": "413342508",
                    "speaker": "朱老板",
                    "text": "啊…咳咳！我不多问了，不多问了。"
                },
                {
                    "id": "413342509",
                    "speaker": "朱老板",
                    "text": "二位走了这么长的路肯定累了，请在这里先歇着吧，我去给你们准备饭菜。"
                },
                {
                    "id": "413342510",
                    "speaker": "朱老板",
                    "text": "旅行者，请你也帮个忙吧，他们两个人，上菜可不能慢了。"
                },
                {
                    "id": "413342511",
                    "speaker": "朱老板",
                    "text": "请你帮我准备一道「美味的珍珠翡翠白玉汤」来吧，拜托了，报酬到时候我一起算给你。"
                }
            ]
        },
        {
            "id": "4133412",
            "objective": "与朱老板对话",
            "dialogues": [
                {
                    "id": "413341201",
                    "speaker": "朱老板",
                    "text": "奇怪了，奇怪啊，这是怎么回事…"
                },
                {
                    "id": "413341202",
                    "speaker": "Player",
                    "text": "怎么了？"
                },
                {
                    "id": "413341203",
                    "speaker": "朱老板",
                    "text": "昨天…压根没多少客人过来啊，这是怎么回事，这大过节的，客人不是应该很多吗？",
                    "choices": [
                        {
                            "id": "413341204",
                            "text": "没多少人会经过这里吧…",
                            "response": [
                                {
                                    "id": "413341206",
                                    "speaker": "朱老板",
                                    "text": "不可能啊，这怎么可能…不对，一定是我招揽客人的手法错了。"
                                },
                                {
                                    "id": "413341207",
                                    "speaker": "朱老板",
                                    "text": "要是直接去招揽客人，会不会效果好一些…"
                                },
                                {
                                    "id": "413341208",
                                    "speaker": "朱老板",
                                    "text": "旅行者，你能再帮我去周围招揽招揽客人吗？"
                                },
                                {
                                    "id": "413341209",
                                    "speaker": "朱老板",
                                    "text": "就说…我这有好菜和好环境，很适合在海灯节期间观景。"
                                },
                                {
                                    "id": "413341210",
                                    "speaker": "朱老板",
                                    "text": "我也再想想有什么能招揽客人的方式…"
                                }
                            ]
                        },
                        {
                            "id": "413341205",
                            "text": "海灯节期间外出的人很少吧…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "4133413",
            "objective": "向周围的人发出邀请",
            "dialogues": [
                {
                    "id": "413341301",
                    "speaker": "振翔",
                    "text": "你好，请接受检查。"
                },
                {
                    "id": "413341302",
                    "speaker": "Player",
                    "text": "关于朱老板的邀请…"
                },
                {
                    "id": "413341303",
                    "speaker": "振翔",
                    "text": "嗯？那位朱老板开的店，我倒是听说过。"
                },
                {
                    "id": "413341304",
                    "speaker": "振翔",
                    "text": "不过很抱歉，我正在工作，不能擅自离岗，你们的好意我心领了。"
                }
            ]
        },
        {
            "id": "4133414",
            "objective": "向周围的人发出邀请",
            "dialogues": [
                {
                    "id": "413341401",
                    "speaker": "老刘伯",
                    "text": "咦？年轻人，有什么事吗？"
                },
                {
                    "id": "413341402",
                    "speaker": "Player",
                    "text": "关于朱老板的邀请…"
                },
                {
                    "id": "413341403",
                    "speaker": "老刘伯",
                    "text": "哦…朱老板啊，我知道他那个店。"
                },
                {
                    "id": "413341404",
                    "speaker": "老刘伯",
                    "text": "但是不好意思啊，他那个店离这里太远了，我可走不了那么远的路。"
                }
            ]
        },
        {
