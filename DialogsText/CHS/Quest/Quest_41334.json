        },
        {
            "id": "4133407",
            "objective": "将「美味的珍珠翡翠白玉汤」交给朱老板",
            "dialogues": [
                {
                    "id": "413342201",
                    "speaker": "朱老板",
                    "text": "怎么样，菜做好了吗？"
                },
                {
                    "id": "413342202",
                    "speaker": "Player",
                    "text": "准备好了。"
                },
                {
                    "id": "413342203",
                    "speaker": "朱老板",
                    "text": "好，好，这样菜就齐了。谢谢你了。"
                },
                {
                    "id": "413342204",
                    "speaker": "朱老板",
                    "text": "二位，久等了啊，哈哈哈，请慢用，请慢用。"
                },
                {
                    "id": "413342205",
                    "speaker": "鉴秋",
                    "text": "谢谢老板。这位旅行者…帮忙跑前跑后的，很是辛苦，就请坐下一起吃吧。"
                },
                {
                    "id": "413342206",
                    "speaker": "Player",
                    "text": "谢谢。"
                },
                {
                    "id": "413342207",
                    "speaker": "鉴秋",
                    "text": "呵呵，看你模样，应该和我们一样也是远游之人，大过节的，大家一起吃一顿饭，好歹也有些热闹劲。"
                },
                {
                    "id": "413342208",
                    "speaker": "花初",
                    "text": "嗯，请老板也一起吃吧。"
                },
                {
                    "id": "413342209",
                    "speaker": "朱老板",
                    "text": "哎哟，那好，那我也就不客气了啊。"
                }
            ]
        },
        {
            "id": "4133417",
            "objective": "和三人坐在同一桌",
            "dialogues": [
                {
                    "id": "413341701",
