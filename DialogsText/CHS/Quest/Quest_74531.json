    "talks": [
        {
            "id": "7453101",
            "objective": "与妮内特对话",
            "dialogues": [
                {
                    "id": "745310101",
                    "speaker": "妮内特",
                    "text": "#{NICKNAME}大人，派蒙，你们回来啦！",
                    "choices": [
                        {
                            "id": "745310102",
                            "text": "这回拍了不少画片。",
                            "response": [
                                {
                                    "id": "745310104",
                                    "speaker": "妮内特",
                                    "text": "太好了！这次真的非常感谢你们！"
                                },
                                {
                                    "id": "745310105",
                                    "speaker": "妮内特",
                                    "text": "在你们帮忙留影的时候，我想着，我不能什么都不做，要不然，就会一直原地踏步了…"
                                },
                                {
                                    "id": "745310106",
                                    "speaker": "妮内特",
                                    "text": "所以，我鼓起勇气，去拜托了一些路人。然后，我也努力拍了很多画片哦！测试数据应该这样就足够了！"
                                },
                                {
                                    "id": "745310107",
                                    "speaker": "乐平波琳",
                                    "text": "#哼哼，不愧是我的徒弟！也多亏了{NICKNAME}愿意出手相助啦！"
                                },
                                {
                                    "id": "745310108",
                                    "speaker": "派蒙",
                                    "text": "乐平波琳！你什么时候回来的？妮内特说你最近在忙别的事情。"
                                },
                                {
                                    "id": "745310109",
                                    "speaker": "乐平波琳",
                                    "text": "那当然是能让我赚到盆满钵满的大——生——意——了！"
                                },
                                {
                                    "id": "745310110",
                                    "speaker": "乐平波琳",
                                    "text": "前阵子实在是抽不开身，妮内特多亏有你们关照了。"
                                },
                                {
                                    "id": "745310111",
                                    "speaker": "乐平波琳",
                                    "text": "这孩子，技术和审美都没得说，就是胆子小了点。有你们帮忙，她也算是踏出重要的一步了。"
                                },
                                {
                                    "id": "745310112",
                                    "speaker": "派蒙",
                                    "text": "所以你到底在忙什么大生意啦？神神秘秘的。不会又听说了什么奇怪的新闻，要把全部身家砸进去了吧？"
                                },
                                {
                                    "id": "745310113",
                                    "speaker": "乐平波琳",
                                    "text": "怎么可能！我乐平波琳也是会吸取教训的好吧！这次可是千真万确、稳赚不赔的超级大项目！"
                                },
                                {
                                    "id": "745310114",
                                    "speaker": "Player",
                                    "text": "（总觉得有点不放心…）"
                                },
                                {
                                    "id": "745310115",
                                    "speaker": "乐平波琳",
                                    "text": "哼哼，现在说出来就没意思了。等成品出来，我会第一时间邀请你们来体验的！"
                                }
                            ]
                        },
                        {
                            "id": "745310103",
                            "text": "「瞬影」镜头的效果很不错。"
                        }
                    ]
                }
            ]
        }
    ]
