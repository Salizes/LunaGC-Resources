    "talks": [
        {
            "id": "7608401",
            "objective": "同「少女」见面",
            "dialogues": [
                {
                    "id": "760490603",
                    "speaker": "Player",
                    "text": "平和的乐调…"
                },
                {
                    "id": "760490604",
                    "speaker": "「少女」",
                    "text": "好听。我平时哼的旋律，原来你都记下来了。"
                },
                {
                    "id": "760490605",
                    "speaker": "派蒙",
                    "text": "嘿嘿，因为你唱歌很好听嘛，我们有时会悄悄在旁边听上一会儿。"
                },
                {
                    "id": "760490606",
                    "speaker": "「少女」",
                    "text": "月灵们也听得入迷了。不知道它们有没有学会。"
                },
                {
                    "id": "760490607",
                    "speaker": "「少女」",
                    "text": "说不定，以后还得多请你们教几次。"
                },
                {
                    "id": "760490608",
                    "speaker": "「少女」",
                    "text": "来吧，把手给我。"
                },
                {
                    "id": "760490609",
                    "speaker": "派蒙",
                    "text": "欸？我们这是无偿演出，不用收学费的！"
                },
                {
                    "id": "760490610",
                    "speaker": "「少女」",
                    "text": "嗯？学费？"
                },
                {
                    "id": "760490611",
                    "speaker": "「少女」",
                    "text": "我只是觉得，好听的旋律，应该有美丽的月光相伴。"
                }
            ]
        },
        {
            "id": "7604903",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "760490301",
                    "speaker": "「少女」",
                    "text": "今天月灵们很满足了。但以后，或许还会再麻烦你们来教它们。"
                }
            ]
        },
        {
            "id": "7604907",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "760490709",
                    "speaker": "「少女」",
                    "text": "如今我们穿过云雾，一同见到了月亮上的那个答案…它的美好就如你此刻的琴声。"
                }
            ]
        },
        {
            "id": "7608401",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "760840101",
                    "speaker": "「少女」",
                    "text": "你们来了？今天月灵们又在玩琴。能像上次一样弹一首给它们听吗？"
                },
                {
                    "id": "760840102",
                    "speaker": "「少女」",
                    "text": "我正好也想听些不一样的曲调。"
                },
                {
                    "id": "760840103",
                    "speaker": "Player",
                    "text": "（弹什么好呢…）"
                }
            ]
        },
        {
            "id": "7608402",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "760840201",
                    "speaker": "Player",
                    "text": "演奏哥伦比娅常哼的歌…"
                },
                {
                    "id": "760490202",
                    "speaker": "Player",
                    "text": "演奏哥伦比娅常哼的歌…"
                },
                {
                    "id": "760490201",
                    "speaker": "Player",
                    "text": "（以什么样的情绪演奏呢…）",
                    "choices": [
                        {
                            "id": "760490603",
                            "text": "平和的乐调…"
                        },
                        {
                            "id": "760490701",
                            "text": "愉快的乐调…",
                            "response": [
                                {
                                    "id": "760490702",
                                    "speaker": "「少女」",
                                    "text": "结束了？感觉都还没听够…"
                                },
                                {
                                    "id": "760490703",
                                    "speaker": "「少女」",
                                    "text": "我曾说过这是我唯一记得的「摇篮曲」。"
                                },
                                {
                                    "id": "760490704",
                                    "speaker": "「少女」",
                                    "text": "尽管还没找到其中的意义，但听你弹过之后，我开始觉得在月亮上等待着我的那个答案，至少是美好的。"
                                },
                                {
                                    "id": "760490705",
                                    "speaker": "「少女」",
                                    "text": "来，把手给我。"
                                },
                                {
                                    "id": "760490706",
                                    "speaker": "派蒙",
                                    "text": "这次就不用回报啦。"
                                },
                                {
                                    "id": "760490707",
                                    "speaker": "「少女」",
                                    "text": "不，我只是想为这旋律添上一束美好的月光。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7608403",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "760840301",
                    "speaker": "<UNKNOWN>",
                    "text": "(test)台词文本"
                }
            ]
        },
        {
            "id": "7608405",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "760840501",
                    "speaker": "Player",
                    "text": "愉快的乐调…"
                }
            ]
        },
        {
            "id": "7608406",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "760840601",
                    "speaker": "Player",
                    "text": "演奏他国的音乐…"
                },
                {
                    "id": "760490801",
                    "speaker": "Player",
                    "text": "演奏他国的音乐…"
                },
                {
                    "id": "760490802",
                    "speaker": "「少女」",
                    "text": "奇妙的感觉。以前偶尔也听过类似的旋律，但听你弹的感受很不一样。"
                },
                {
                    "id": "760490803",
                    "speaker": "派蒙",
                    "text": "#可能其中包含了{M#他}{F#她}对那个国家的感情吧。"
                },
                {
                    "id": "760490804",
                    "speaker": "「少女」",
                    "text": "奇妙的是，我能够从乐调中想象出风景…不知道现实和我的想象会有多少区别呢…"
                },
                {
                    "id": "760490805",
                    "speaker": "派蒙",
                    "text": "想看还不简单？到时候就让我们来当你的导游吧！"
                },
                {
                    "id": "760490806",
                    "speaker": "「少女」",
                    "text": "嗯…如果能有那么一天的话。"
                }
            ]
        }
    ]
}