{
    "quest": {
        "id": "74708",
        "title": "暴躁鱼儿在出没？",
        "description": "希格雯似乎有事找我们…",
        "rewards": [],
        "rewards_formatted": "",
        "chapter": {
            "icon": "",
            "id": "",
