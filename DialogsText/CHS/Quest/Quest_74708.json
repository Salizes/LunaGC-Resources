        }
    },
    "talks": [
        {
            "id": "7470801",
            "objective": "与希格雯对话",
            "dialogues": [
                {
                    "id": "747080101",
                    "speaker": "希格雯",
                    "text": "#你们好呀，{NICKNAME}和派蒙。"
                },
                {
                    "id": "747080102",
                    "speaker": "希格雯",
                    "text": "听吉约丹小姐说你们最近在打理水族馆。我就受她邀请，来当水族馆的鱼类顾问啦！",
                    "choices": [
                        {
                            "id": "747080103",
                            "text": "欢迎欢迎。",
                            "response": [
                                {
                                    "id": "747080105",
                                    "speaker": "派蒙",
                                    "text": "太好了，有希格雯护士长在，我们就不用担心它们生病啦！"
                                },
                                {
                                    "id": "747080106",
                                    "speaker": "希格雯",
                                    "text": "嘿嘿，多亏你们之前邀请我看管「海薇玛映影欢乐城」的动物庄园，我也总结了一些窍门…"
                                },
                                {
                                    "id": "747080107",
                                    "speaker": "希格雯",
                                    "text": "照顾病人和懂事的动物客人之间，有着好多相通的道理。"
                                },
                                {
                                    "id": "747080108",
                                    "speaker": "希格雯",
                                    "text": "#不过这次，除了展示普通的鱼类，我还有些「疗养」的计划，想和{NICKNAME}商量看看。"
                                },
                                {
                                    "id": "747080109",
                                    "speaker": "Player",
                                    "text": "请说请说，我都好说。"
                                },
                                {
                                    "id": "747080110",
                                    "speaker": "希格雯",
                                    "text": "听希娅警官说，最近有些鱼儿变得格外狂躁，狠狠攻击附近的生物，甚至是潜水员和小船。"
                                },
                                {
                                    "id": "747080111",
                                    "speaker": "希格雯",
                                    "text": "我在想，可不可以将它们请到水族馆里来冷静一下，至少别再造成更大的破坏。"
                                },
                                {
                                    "id": "747080112",
                                    "speaker": "希格雯",
                                    "text": "然后，我来找找办法，治好它们突然出现的坏脾气。"
                                },
                                {
                                    "id": "747080113",
                                    "speaker": "希格雯",
                                    "text": "这样不仅能帮助鱼儿和水域恢复正常，也算是为水族馆增添独特的演员。"
                                },
                                {
                                    "id": "747080114",
                                    "speaker": "派蒙",
                                    "text": "听起来确实是个办法！"
                                },
                                {
                                    "id": "747080115",
                                    "speaker": "Player",
                                    "text": "我也支持。"
                                },
                                {
                                    "id": "747080116",
                                    "speaker": "希格雯",
                                    "text": "那，我就给你们提供一些暴躁鱼儿出没水域的消息，之后就拜托你们啦。"
                                }
                            ]
                        },
                        {
                            "id": "747080104",
                            "text": "帮大忙了！"
                        }
                    ]
                }
            ]
        }
    ]
}