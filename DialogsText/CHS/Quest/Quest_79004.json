    "talks": [
        {
            "id": "7900401",
            "objective": "交互壁画（隐藏）$HIDDEN",
            "dialogues": [
                {
                    "id": "790040101",
                    "speaker": "派蒙",
                    "text": "咦？你看这里，石头上好像…画着什么东西。"
                },
                {
                    "id": "790040102",
                    "speaker": "派蒙",
                    "text": "看起来，像是一艘船遇上了海难…然后还有好多人…"
                },
                {
                    "id": "790040103",
                    "speaker": "派蒙",
                    "text": "真难懂…总之先把这幅壁画记录下来吧。"
                }
            ]
        },
        {
            "id": "7900402",
            "objective": "寻找其他壁画",
            "dialogues": []
        },
        {
            "id": "7900413",
