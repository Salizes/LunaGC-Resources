        {
            "id": "7900413",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "790041301",
                    "speaker": "派蒙",
                    "text": "这幅壁画，到底记录着什么故事呢…"
                }
            ]
        },
        {
