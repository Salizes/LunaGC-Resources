    "talks": [
        {
            "id": "4011801",
            "objective": "(test)第二天结束后的闲置环$HIDDEN",
            "dialogues": []
        },
        {
            "id": "4011809",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "401180901",
                    "speaker": "莱斯格",
                    "text": "尊贵的劳伦斯家后裔，一路旅行也学了不少技巧…比如，做烤饼！"
                },
                {
                    "id": "401180902",
                    "speaker": "莱斯格",
                    "text": "…嗯，这个火候应该没问题吧…"
                },
                {
                    "id": "401180903",
                    "speaker": "优菈",
                    "text": "没想到你居然会做烤饼…你不是那种从来不洗碗的人吗…"
                },
                {
                    "id": "401180904",
                    "speaker": "莱斯格",
                    "text": "来得正好，你之后有时间吗？能不能教教我做点心？"
                },
                {
                    "id": "401180905",
                    "speaker": "优菈",
                    "text": "欸？那可得花上不少时间…我们不是来这里增进家族情谊的吧。"
                },
                {
                    "id": "401180906",
                    "speaker": "莱斯格",
                    "text": "行啦，这时候又在意这些了？你也说了我们是普通人，像普通的表亲一样互相学习吧。"
                }
            ]
        },
        {
            "id": "4011810",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "401181001",
                    "speaker": "可莉",
                    "text": "真想和「军师」姐姐一起呼呼——地坐飞车呀！可是，她好像会晕倒…"
                },
                {
                    "id": "401181002",
                    "speaker": "凯亚",
                    "text": "可莉真敏锐啊，一定是从「军师」姐姐眼睛里看到了旋转的星星吧。"
                },
                {
                    "id": "401181003",
                    "speaker": "可莉",
                    "text": "今天的少了一点哦！昨天有很多很多金色的星星。"
                },
                {
                    "id": "401181004",
                    "speaker": "可莉",
                    "text": "妈妈要是在的话，可能会说这些星星全是掉进云朵的鱼吧！"
                }
            ]
        },
        {
            "id": "4011811",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "401181101",
                    "speaker": "柯莱",
                    "text": "这种味道的茶我还是第一次喝到，果然稻妻的茶叶跟须弥饮料很不一样呢。"
                },
                {
                    "id": "401181102",
                    "speaker": "珊瑚宫心海",
                    "text": "这样说来，须弥人会往茶里放香料吗？"
                },
                {
                    "id": "401181103",
                    "speaker": "柯莱",
                    "text": "会的，不过我喝不惯，如果让我选的话，还是咖啡好一点，就是喝了容易失眠…"
                }
            ]
        },
        {
            "id": "4011812",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "401181201",
                    "speaker": "伊迪娅",
                    "text": "#哎呀，{NICKNAME}，怎么样，在蜃境里有什么新发现吗？"
                },
                {
                    "id": "401181202",
                    "speaker": "伊迪娅",
                    "text": "如果觉得有趣的话，跟我说说也行哦。"
                }
            ]
        }
    ]
}