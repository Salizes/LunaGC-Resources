    "talks": [
        {
            "id": "4121401",
            "objective": "寻找阿贝多",
            "dialogues": [
                {
                    "id": "412140101",
                    "speaker": "派蒙",
                    "text": "又来了哦！又是我们哦！"
                },
                {
                    "id": "412140102",
                    "speaker": "阿贝多",
                    "text": "旅行者，派蒙。你们来了。"
                },
                {
                    "id": "412140103",
                    "speaker": "派蒙",
                    "text": "已经习惯像这样和阿贝多见面了呢。",
                    "choices": [
                        {
                            "id": "412140104",
                            "text": "我完成你的委托了。",
                            "response": [
                                {
                                    "id": "412140106",
                                    "speaker": "阿贝多",
                                    "text": "非常感谢，找你果然是正确的选择。"
                                },
                                {
                                    "id": "412140107",
                                    "speaker": "Player",
                                    "text": "帮上你的忙了吗？"
                                },
                                {
                                    "id": "412140108",
                                    "speaker": "阿贝多",
                                    "text": "当然，你对我的研究工作给予了极大帮助。"
                                },
                                {
                                    "id": "412140109",
                                    "speaker": "派蒙",
                                    "text": "嘿嘿，你知道就好~"
                                },
                                {
                                    "id": "412140110",
                                    "speaker": "阿贝多",
                                    "text": "这份恩情我会牢记在心。"
                                },
                                {
                                    "id": "412140111",
                                    "speaker": "Player",
                                    "text": "这把剑还给你。"
                                },
                                {
                                    "id": "412140112",
                                    "speaker": "派蒙",
                                    "text": "应该足够强了吧？"
                                },
                                {
                                    "id": "412140113",
                                    "speaker": "阿贝多",
                                    "text": "差不多了。你身体感觉如何？"
                                },
                                {
                                    "id": "412140114",
                                    "speaker": "Player",
                                    "text": "和平时一样。"
                                },
                                {
                                    "id": "412140115",
                                    "speaker": "阿贝多",
                                    "text": "那就行，没有副作用，也没有污染和毒。"
                                },
                                {
                                    "id": "412140116",
                                    "speaker": "阿贝多",
                                    "text": "看来…我的认知是正确的。"
                                },
                                {
                                    "id": "412140117",
                                    "speaker": "派蒙",
                                    "text": "摆出了一副料事如神的表情呢，这家伙！"
                                },
                                {
                                    "id": "412140118",
                                    "speaker": "阿贝多",
                                    "text": "剑好用吗？",
                                    "choices": [
                                        {
                                            "id": "412140119",
                                            "text": "好用。",
                                            "response": [
                                                {
                                                    "id": "412140121",
                                                    "speaker": "阿贝多",
                                                    "text": "是吗。不管怎么说，它也达到了我想要的状态。"
                                                },
                                                {
                                                    "id": "412140122",
                                                    "speaker": "派蒙",
                                                    "text": "把剑拿起来了…阿贝多，你要用它吗？你、你不要做傻事啊！"
                                                },
                                                {
                                                    "id": "412140123",
                                                    "speaker": "阿贝多",
                                                    "text": "我要把被你净化过的纯粹生命之力提取出来。"
                                                },
                                                {
                                                    "id": "412140124",
                                                    "speaker": "派蒙",
                                                    "text": "力量也能单独存在吗？"
                                                },
                                                {
                                                    "id": "412140125",
                                                    "speaker": "阿贝多",
                                                    "text": "或许别人做不到，但我可以。"
                                                },
                                                {
                                                    "id": "412140126",
                                                    "speaker": "阿贝多",
                                                    "text": "…好了。"
                                                },
                                                {
                                                    "id": "412140127",
                                                    "speaker": "派蒙",
                                                    "text": "哇，这种力量，好像一个光球…"
                                                },
                                                {
                                                    "id": "412140128",
                                                    "speaker": "派蒙",
                                                    "text": "啊！放到神秘的瓶子里了！"
                                                },
                                                {
                                                    "id": "412140129",
                                                    "speaker": "阿贝多",
                                                    "text": "虽然这把剑算不上神兵利器…"
                                                },
                                                {
                                                    "id": "412140130",
                                                    "speaker": "阿贝多",
                                                    "text": "做个纪念吧。希望以后它也能在旅途中帮助你。",
                                                    "choices": [
                                                        {
                                                            "id": "412140131",
                                                            "text": "真的可以吗？",
                                                            "response": [
                                                                {
                                                                    "id": "412140133",
                                                                    "speaker": "阿贝多",
                                                                    "text": "我要的是与它有关的实验结果，现在我得到了我要的东西，剑应该留给擅长使用它的你。"
                                                                },
                                                                {
                                                                    "id": "412140134",
                                                                    "speaker": "阿贝多",
                                                                    "text": "旅行者，谢谢你帮我完成这次研究。那么，再见了。"
                                                                },
                                                                {
                                                                    "id": "412140135",
                                                                    "speaker": "阿贝多",
                                                                    "text": "能与我发生共鸣的，龙的生命之力…"
                                                                },
                                                                {
                                                                    "id": "412140136",
                                                                    "speaker": "阿贝多",
                                                                    "text": "并非因为它是龙，而是因为我的缘故。"
                                                                },
                                                                {
                                                                    "id": "412140137",
                                                                    "speaker": "阿贝多",
                                                                    "text": "莱茵多特…师父…这就是你曾经创造的巨龙「杜林」吗？"
                                                                },
                                                                {
                                                                    "id": "412140138",
                                                                    "speaker": "阿贝多",
                                                                    "text": "……"
                                                                },
                                                                {
                                                                    "id": "412140139",
                                                                    "speaker": "阿贝多",
                                                                    "text": "我与它的相会，真的是一件好事吗？"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "412140132",
                                                            "text": "你不需要它了吗？"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "412140120",
                                            "text": "不好用。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "412140105",
                            "text": "答应你的事，我都做完了。"
                        }
                    ]
                }
            ]
        },
