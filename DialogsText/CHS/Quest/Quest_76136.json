        {
            "id": "7613608",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "761360301",
                    "speaker": "Player",
                    "text": "（或许<color=#FFCC33FF>雅珂达</color>想看看箱子的情况…）"
                },
                {
                    "id": "761360302",
                    "speaker": "雅珂达",
                    "text": "嘿嘿…让我看看最近赚了多少钱。"
                },
                {
                    "id": "761360303",
                    "speaker": "雅珂达",
                    "text": "上次老板说要给我加奖金呢，不如我现在就…"
                },
                {
                    "id": "761360304",
                    "speaker": "雅珂达",
                    "text": "里面怎么没钱啊？只有一张纸条…"
                },
                {
                    "id": "761360305",
                    "speaker": "雅珂达",
                    "text": "「亲爱的雅珂达，把盒子关好。你的奖金不从这里面出。」"
                },
                {
                    "id": "761360306",
                    "speaker": "雅珂达",
                    "text": "嘁，老板又在吓人了，是不是有夹层…"
                },
                {
                    "id": "761360307",
                    "speaker": "奈芙尔",
                    "text": "没有夹层，你的奖金在这里。"
                },
                {
                    "id": "761360308",
                    "speaker": "雅珂达",
                    "text": "喔，谢谢老板，我…"
                },
                {
                    "id": "761360309",
                    "speaker": "雅珂达",
                    "text": "呜啊啊啊啊啊啊啊——老老老老板，我就是清点一下！"
                },
                {
                    "id": "761360310",
                    "speaker": "雅珂达",
                    "text": "我这就去工作，马上去——"
                },
                {
                    "id": "761360311",
                    "speaker": "奈芙尔",
                    "text": "站住。"
                },
                {
                    "id": "761360312",
                    "speaker": "雅珂达",
                    "text": "是！"
                },
                {
                    "id": "761360313",
                    "speaker": "奈芙尔",
                    "text": "锁好盒子。"
                },
                {
                    "id": "761360314",
                    "speaker": "雅珂达",
                    "text": "是！"
                },
                {
                    "id": "761360315",
                    "speaker": "奈芙尔",
                    "text": "去吧。"
                },
                {
                    "id": "761360316",
                    "speaker": "雅珂达",
                    "text": "是！"
                }
            ]
        },
        {
