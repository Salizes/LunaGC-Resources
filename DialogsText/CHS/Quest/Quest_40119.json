    "talks": [
        {
            "id": "4011901",
            "objective": "前往蜃境的核心",
            "dialogues": []
        },
        {
            "id": "4011902",
            "objective": "与伊迪娅对话",
            "dialogues": [
                {
                    "id": "401190201",
                    "speaker": "派蒙",
                    "text": "啊，优菈和柯莱，你们已经回来了!"
                },
                {
                    "id": "401190202",
                    "speaker": "优菈",
                    "text": "嗯，演出快结束的时候，我们接到了伊迪娅小姐拜托「小水珠」送来的消息，就先一步到这里等各位了。"
                },
                {
                    "id": "401190203",
                    "speaker": "伊迪娅",
                    "text": "那莱斯格先生…"
                },
                {
                    "id": "401190204",
                    "speaker": "柯莱",
                    "text": "他揽下了所有体力活，卖力过头了，现在在房间里睡得正香呢。"
                },
                {
                    "id": "401190205",
                    "speaker": "伊迪娅",
                    "text": "唔，有点过意不去…"
                },
                {
                    "id": "401190206",
                    "speaker": "优菈",
                    "text": "就当他做的一切都是赎罪吧。做完这些才能睡个安稳觉，本该如此。不用管他。"
                },
                {
                    "id": "401190207",
                    "speaker": "伊迪娅",
                    "text": "这样吗…好，那我们就抓紧时间，修复「琉形蜃境」的核心吧。"
                },
                {
                    "id": "401190208",
                    "speaker": "派蒙",
                    "text": "这不就是我们一开始遇到「小水珠」的地方吗？"
                },
                {
                    "id": "401190209",
                    "speaker": "伊迪娅",
                    "text": "没错，「琉形蜃境」的核心就是最大的「聚流映灯」，而整个蜃境就是一张最为庞大的「先成图」。"
                },
                {
                    "id": "401190210",
                    "speaker": "柯莱",
                    "text": "我们看到的一切，都是由它生成出来的吗？太不可思议了…"
                },
                {
                    "id": "401190211",
                    "speaker": "派蒙",
                    "text": "现在就该像之前一样，利用核心的「先成图」来修复它了吧？"
                },
                {
                    "id": "401190212",
                    "speaker": "伊迪娅",
                    "text": "没错，就是这样。你理解得真快。"
                },
                {
                    "id": "401190213",
                    "speaker": "派蒙",
                    "text": "嘿嘿，修了这么多次，再怎么也都记住啦。"
                },
                {
                    "id": "401190214",
                    "speaker": "伊迪娅",
                    "text": "那开始吧，这就是最后一步！"
                },
                {
                    "id": "401190215",
                    "speaker": "派蒙",
                    "text": "哦！突然充满了干劲呢！"
                }
            ]
        },
        {
            "id": "4011903",
            "objective": "利用「先成图」修复核心轮縠",
            "dialogues": [
                {
                    "id": "401190301",
                    "speaker": "柯莱",
                    "text": "能够转动的东西…水车也行吗？"
                }
            ]
        },
        {
            "id": "4011904",
            "objective": "与伊迪娅对话",
            "dialogues": [
                {
                    "id": "401190401",
                    "speaker": "派蒙",
                    "text": "成功啦！"
                },
                {
                    "id": "401190402",
                    "speaker": "柯莱",
                    "text": "可是轮縠并没有转动…"
                },
                {
                    "id": "401190403",
                    "speaker": "伊迪娅",
                    "text": "零件回到了蜃境核心，轮縠的形状也通过它们补全了。"
                },
                {
                    "id": "401190404",
                    "speaker": "伊迪娅",
                    "text": "哈哈，这样就没问题了，好比伤口会慢慢愈合，说不定在某个夜深人静的时候，「核心轮縠」就会悄悄转动呢…"
                },
                {
                    "id": "401190405",
                    "speaker": "凯亚",
                    "text": "哦？我还以为，靠伊迪娅小姐的本事，现在就能让它运转起来呢。"
                },
                {
                    "id": "401190406",
                    "speaker": "伊迪娅",
                    "text": "这…"
                },
                {
                    "id": "401190407",
                    "speaker": "派蒙",
                    "text": "嗯？"
                },
                {
                    "id": "401190408",
                    "speaker": "珊瑚宫心海",
                    "text": "不管是蜃境原本的样子，还是伊迪娅小姐深藏不露的美丽姿态，都很令人期待呢。"
                },
                {
                    "id": "401190409",
                    "speaker": "可莉",
                    "text": "可莉也想看伊迪娅姐姐用魔法的样子！一定很——厉害吧！"
                },
                {
                    "id": "401190410",
                    "speaker": "派蒙",
                    "text": "你…你们都在说什么呀？为什么小可莉都知道？"
                },
                {
                    "id": "401190411",
                    "speaker": "Player",
                    "text": "派蒙果然没有发现吗？"
                },
                {
                    "id": "401190412",
                    "speaker": "优菈",
                    "text": "就是在说…「吉祥物小姐的真身」。"
                },
                {
                    "id": "401190413",
                    "speaker": "珊瑚宫心海",
                    "text": "之前就说过，伊迪娅小姐绝不是自己以为的那样。她有她独特的力量，我们之中也有人隐约感觉到了这一点哦。"
                },
                {
                    "id": "401190414",
                    "speaker": "柯莱",
                    "text": "「军师」小姐从一开始就发现了吗？我是后来和优菈聊天的时候才意识到的。"
                },
                {
                    "id": "401190415",
                    "speaker": "凯亚",
                    "text": "看上去悠闲无比的「军师」小姐成了第一个察觉真相的人啊。"
                },
                {
                    "id": "401190416",
                    "speaker": "优菈",
                    "text": "我看你也知道的挺清楚哦。"
                },
                {
                    "id": "401190417",
                    "speaker": "伊迪娅",
                    "text": "你们…全都知道了吗…我保证，不是有意瞒着你们的！"
                },
                {
                    "id": "401190418",
                    "speaker": "伊迪娅",
                    "text": "只是…对误入蜃境的旅人来说，比起真身，我现在的样子要更容易亲近吧。我…我不想被人投以害怕的眼神…",
                    "choices": [
                        {
                            "id": "401190419",
                            "text": "居然一直没细想！",
                            "response": [
                                {
                                    "id": "401190421",
                                    "speaker": "派蒙",
                                    "text": "啊？究竟是什么呀？大家是怎么知道的？"
                                },
                                {
                                    "id": "401190422",
                                    "speaker": "珊瑚宫心海",
                                    "text": "嗯…怎么说呢，蜃境里的居民没有神之眼，我却能从他们身上感受到水元素力。"
                                },
                                {
                                    "id": "401190423",
                                    "speaker": "珊瑚宫心海",
                                    "text": "看小说的时候走了神，忽然想到一种可能性。水形幻灵能够变为各种样子，同样也能幻化成常人的模样吧？"
                                },
                                {
                                    "id": "401190424",
                                    "speaker": "伊迪娅",
                                    "text": "还真是敏锐啊…"
                                },
                                {
                                    "id": "401190425",
                                    "speaker": "伊迪娅",
                                    "text": "那么，就允许我重新做个自我介绍吧——"
                                },
                                {
                                    "id": "401190426",
                                    "speaker": "伊迪娅",
                                    "text": "我是旧水神崩殁时流亡至此的纯水精灵，我的名字叫伊迪娅。"
                                },
                                {
                                    "id": "401190427",
                                    "speaker": "Player",
                                    "text": "居然是纯水精灵…"
                                },
                                {
                                    "id": "401190428",
                                    "speaker": "可莉",
                                    "text": "伊迪娅姐姐好漂亮！"
                                },
                                {
                                    "id": "401190429",
                                    "speaker": "伊迪娅",
                                    "text": "唔…突然用自己的真身说话还有点不好意思…"
                                },
                                {
                                    "id": "401190430",
                                    "speaker": "优菈",
                                    "text": "如此优美的身姿，就该大大方方展示出来才对。"
                                },
                                {
                                    "id": "401190431",
                                    "speaker": "伊迪娅",
                                    "text": "我没有那么勇敢啦！"
                                },
                                {
                                    "id": "401190432",
                                    "speaker": "派蒙",
                                    "text": "咦？那难道说我们之前遇到的那些人…"
                                },
                                {
                                    "id": "401190433",
                                    "speaker": "凯亚",
                                    "text": "我猜，这些「水形居民」的「原型」，都已经不在此处了吧？"
                                },
                                {
                                    "id": "401190434",
                                    "speaker": "伊迪娅",
                                    "text": "没错，当他们想要离开的时候，我就会把他们送到沙漠的边沿…"
                                },
                                {
                                    "id": "401190435",
                                    "speaker": "伊迪娅",
                                    "text": "之前的这些「零件」，其实都是他们留下的礼物。"
                                },
                                {
                                    "id": "401190436",
                                    "speaker": "伊迪娅",
                                    "text": "但我总会很好奇他们进来的原因…就使用「聚流映灯」，塑造出了他们的愿景。"
                                },
                                {
                                    "id": "401190437",
                                    "speaker": "珊瑚宫心海",
                                    "text": "「能实现愿望，但即使能实现，也只限于瓶子里。」"
                                },
                                {
                                    "id": "401190438",
                                    "speaker": "伊迪娅",
                                    "text": "就是这么回事。"
                                },
                                {
                                    "id": "401190439",
                                    "speaker": "凯亚",
                                    "text": "真是一抹耀眼的光芒啊。"
                                },
                                {
                                    "id": "401190440",
                                    "speaker": "珊瑚宫心海",
                                    "text": "这么说来，从蜃境核心里掉出来的「零件」，并不是回到了他们的主人那里…"
                                },
                                {
                                    "id": "401190441",
                                    "speaker": "珊瑚宫心海",
                                    "text": "而是先有「零件」掉到了相应位置，与他们息息相关的「主人」与「区域」才被幻化出来。"
                                },
                                {
                                    "id": "401190442",
                                    "speaker": "柯莱",
                                    "text": "但现在「零件」都被收回来了，难道他们也…"
                                },
                                {
                                    "id": "401190443",
                                    "speaker": "伊迪娅",
                                    "text": "放心吧，他们不会消失的…只要我不忘记他们。"
                                },
                                {
                                    "id": "401190444",
                                    "speaker": "伊迪娅",
                                    "text": "互相批评也好，一起打闹也罢…在这片幻境里，他们永远是我的朋友。"
                                },
                                {
                                    "id": "401190445",
                                    "speaker": "可莉",
                                    "text": "「呼呼飞车」和「导演」先生都很有趣！可莉不会忘记的！"
                                },
                                {
                                    "id": "401190446",
                                    "speaker": "柯莱",
                                    "text": "我也是。不会忘记这一场奇幻冒险。"
                                },
                                {
                                    "id": "401190447",
                                    "speaker": "伊迪娅",
                                    "text": "哈哈，好了，那我也差不多该让轮縠恢复运转了。"
                                },
                                {
                                    "id": "401190448",
                                    "speaker": "柯莱",
                                    "text": "看你的了，像流水一样温柔的「吉祥物」小姐！"
                                },
                                {
                                    "id": "401190449",
                                    "speaker": "派蒙",
                                    "text": "好…好紧张…"
                                },
                                {
                                    "id": "401190450",
                                    "speaker": "伊迪娅",
                                    "text": "……"
                                },
                                {
                                    "id": "401190451",
                                    "speaker": "伊迪娅",
                                    "text": "……"
                                },
                                {
                                    "id": "401190452",
                                    "speaker": "Player",
                                    "text": "……"
                                },
                                {
                                    "id": "401190453",
                                    "speaker": "伊迪娅",
                                    "text": "咦…不会吧，居然没有反应…难道因为之前蜃境的故障导致力量不足…"
                                },
                                {
                                    "id": "401190454",
                                    "speaker": "伊迪娅",
                                    "text": "完了完了…刚才大家还把我捧上了天…我也大言不惭地夸下海口…"
                                },
                                {
                                    "id": "401190455",
                                    "speaker": "伊迪娅",
                                    "text": "呜呜…给个瓶子让我藏进去吧！藏一百年！"
                                },
                                {
                                    "id": "401190456",
                                    "speaker": "派蒙",
                                    "text": "呃…你现在就是在瓶子里啦…"
                                },
                                {
                                    "id": "401190457",
                                    "speaker": "伊迪娅",
                                    "text": "怎么办…这下真的没办法让大家看到「蜃境」原本的样子了…"
                                },
                                {
                                    "id": "401190458",
                                    "speaker": "珊瑚宫心海",
                                    "text": "其实，我有一计。"
                                },
                                {
                                    "id": "401190459",
                                    "speaker": "伊迪娅",
                                    "text": "「军师」小姐！"
                                },
                                {
                                    "id": "401190460",
                                    "speaker": "珊瑚宫心海",
                                    "text": "伊迪娅小姐，如果可以的话，能将蜃境核心中的「蜃楼玉匣」借我一用吗？"
                                },
                                {
                                    "id": "401190461",
                                    "speaker": "伊迪娅",
                                    "text": "好像确实听过这个名字，请稍等…"
                                },
                                {
                                    "id": "401190462",
                                    "speaker": "伊迪娅",
                                    "text": "喏，是它吧？"
                                },
                                {
                                    "id": "401190463",
                                    "speaker": "可莉",
                                    "text": "哇！好大的贝壳！"
                                },
                                {
                                    "id": "401190464",
                                    "speaker": "派蒙",
                                    "text": "心海之前提到的古物，原来藏在这里！"
                                },
                                {
                                    "id": "401190465",
                                    "speaker": "珊瑚宫心海",
                                    "text": "嗯，它是从前供奉在曚云神社中的礼器，用名为「蜃气楼」的妖怪遗蜕制作而成，能听取往来祈祷者的愿望，蓄积蜃气。"
                                },
                                {
                                    "id": "401190466",
                                    "speaker": "珊瑚宫心海",
                                    "text": "数百年前，此物随最后一代八酝守征战未归遗失在外…"
                                },
                                {
                                    "id": "401190467",
                                    "speaker": "珊瑚宫心海",
                                    "text": "与之相配的宝珠本应能感应到「玉匣」所在，谁料「玉匣」被藏进了「蜃境核心」中，宝珠也就此褪去了光芒。"
                                },
                                {
                                    "id": "401190468",
                                    "speaker": "可莉",
                                    "text": "欸？这是为什么呀？"
                                },
                                {
                                    "id": "401190469",
                                    "speaker": "凯亚",
                                    "text": "假如把声音关进很深、很深的房间里面，外面也会听不见对吧？"
                                },
                                {
                                    "id": "401190470",
                                    "speaker": "可莉",
                                    "text": "啊！明白了，贝壳太贪玩了，所以在禁闭室里…"
                                },
                                {
                                    "id": "401190471",
                                    "speaker": "伊迪娅",
                                    "text": "那我也明白了！蜃境的核心近来老化了…所以「军师」小姐才会捧着宝珠一路走进来。"
                                },
                                {
                                    "id": "401190472",
                                    "speaker": "Player",
                                    "text": "（听着像我会用的寻宝罗盘…）"
                                },
                                {
                                    "id": "401190473",
                                    "speaker": "珊瑚宫心海",
                                    "text": "…言归正传。本来，离开了神社的供奉，这件礼器会迅速失去灵气…"
                                },
                                {
                                    "id": "401190474",
                                    "speaker": "珊瑚宫心海",
                                    "text": "但在这片蜃境之内，无数人留下了自己的愿望和礼物，成为了它的「供物」。"
                                },
                                {
                                    "id": "401190475",
                                    "speaker": "伊迪娅",
                                    "text": "这…原来这是这么厉害的东西吗…"
                                },
                                {
                                    "id": "401190476",
                                    "speaker": "珊瑚宫心海",
                                    "text": "没错，它能够帮助伊迪娅小姐修复「蜃境」。"
                                },
                                {
                                    "id": "401190477",
                                    "speaker": "伊迪娅",
                                    "text": "可…我要怎么做…"
                                },
                                {
                                    "id": "401190478",
                                    "speaker": "珊瑚宫心海",
                                    "text": "很简单，用愿望唤醒它就好了…"
                                },
                                {
                                    "id": "401190479",
                                    "speaker": "珊瑚宫心海",
                                    "text": "比如…我的名字是珊瑚宫心海，是海祇岛的「现人神巫女」。"
                                },
                                {
                                    "id": "401190480",
                                    "speaker": "珊瑚宫心海",
                                    "text": "我的愿望是通过自己的思考和决策，让海祇岛的大家和我珍视的人…能够稍稍过得幸福，再幸福一些。"
                                },
                                {
                                    "id": "401190481",
                                    "speaker": "珊瑚宫心海",
                                    "text": "伊迪娅小姐，你的愿望是什么呢…"
                                },
                                {
                                    "id": "401190482",
                                    "speaker": "伊迪娅",
                                    "text": "我的愿望？我…"
                                },
                                {
                                    "id": "401190483",
                                    "speaker": "伊迪娅",
                                    "text": "我的愿望是，那些曾经来到「琉形蜃境」中的旅人，不仅仅是在蜃境里，也能够在蜃境外实现他们真正想达成的愿望。"
                                },
                                {
                                    "id": "401190484",
                                    "speaker": "伊迪娅",
                                    "text": "即使我知道…在蜃境外铺就飞车的轨道无异于痴人说梦，我知道迈蒙还是会回去当她的学者…"
                                },
                                {
                                    "id": "401190485",
                                    "speaker": "伊迪娅",
                                    "text": "我知道佐西摩斯写故事的水平还有待提高，回到枫丹还会在这方面吃很多苦头，逐梦可没那么简单！"
                                },
                                {
                                    "id": "401190486",
                                    "speaker": "伊迪娅",
                                    "text": "但是我还是好希望…"
                                },
                                {
                                    "id": "401190487",
                                    "speaker": "伊迪娅",
                                    "text": "好希望他们能达成自己的愿望。"
                                }
                            ]
                        },
                        {
                            "id": "401190420",
                            "text": "倒是有所察觉…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "4011905",
            "objective": "恢复蜃境的运转",
            "dialogues": []
        },
        {
            "id": "4011906",
            "objective": "与众人交谈",
            "dialogues": [
                {
                    "id": "401190601",
                    "speaker": "可莉",
                    "text": "哇，伊迪娅姐姐又变回来了！"
                },
                {
                    "id": "401190602",
                    "speaker": "伊迪娅",
                    "text": "……"
                },
                {
                    "id": "401190603",
                    "speaker": "Player",
                    "text": "你还好吗？"
                },
                {
                    "id": "401190604",
                    "speaker": "伊迪娅",
                    "text": "在别人的夸奖和询问里得意忘形，一口气说了好多不堪回首的话…我…失去了活着的勇气…"
                },
                {
                    "id": "401190605",
                    "speaker": "珊瑚宫心海",
                    "text": "请不要这么说，明明都是很了不起的愿望。"
                },
                {
                    "id": "401190606",
                    "speaker": "柯莱",
                    "text": "对，伊迪娅小姐并不是在为自己许愿，而是在为别人许愿。"
                },
                {
                    "id": "401190607",
                    "speaker": "柯莱",
                    "text": "我有些朋友也是这样！会为别人的愿望而行动，为了让他人露出笑容不懈努力。"
                },
                {
                    "id": "401190608",
                    "speaker": "柯莱",
                    "text": "我想…这样的人才最高尚。"
                },
                {
                    "id": "401190609",
                    "speaker": "伊迪娅",
                    "text": "别再夸我了，我…我真的好不习惯…好羞耻…"
                },
                {
                    "id": "401190610",
                    "speaker": "伊迪娅",
                    "text": "我这种人也能被这么多人表扬…好像做梦一样…"
                },
                {
                    "id": "401190611",
                    "speaker": "优菈",
                    "text": "不过，这下蜃境总算恢复了，也算把那家伙欠的东西还上了吧。"
                },
                {
                    "id": "401190612",
                    "speaker": "可莉",
                    "text": "唔…"
                },
                {
                    "id": "401190613",
                    "speaker": "凯亚",
                    "text": "怎么了？可莉。"
                },
                {
                    "id": "401190614",
                    "speaker": "可莉",
                    "text": "可莉突然有好多好多愿望！想坐「呼呼飞车」，还想到大大的转轮上去看看。"
                },
                {
                    "id": "401190615",
                    "speaker": "可莉",
                    "text": "伊迪娅姐姐，有没有上去的办法啊？"
                },
                {
                    "id": "401190616",
                    "speaker": "伊迪娅",
                    "text": "有倒是有啦，不过只能站上去很少的人…"
                },
                {
                    "id": "401190617",
                    "speaker": "可莉",
                    "text": "#可莉一个人上去也不好玩…呜，荣誉骑士{M#哥哥}{F#姐姐}…"
                },
                {
                    "id": "401190618",
                    "speaker": "Player",
                    "text": "伴您左右，「魔女」小姐。"
                },
                {
                    "id": "401190619",
                    "speaker": "派蒙",
                    "text": "真的吗，那个看上去好高啊…"
                },
                {
                    "id": "401190620",
                    "speaker": "派蒙",
                    "text": "要是一不小心掉下来怎么办？"
                },
                {
                    "id": "401190621",
                    "speaker": "Player",
                    "text": "…你不是飞着的吗？"
                },
                {
                    "id": "401190622",
                    "speaker": "派蒙",
                    "text": "我，我是替你感到担心！"
                },
                {
                    "id": "401190623",
                    "speaker": "伊迪娅",
                    "text": "没事，我和你们一起去，我也好久没上去过了。"
                }
            ]
        },
        {
            "id": "4011909",
            "objective": "前往核心轮縠的登亭处",
            "dialogues": [
                {
                    "id": "401190901",
                    "speaker": "可莉",
                    "text": "#荣誉骑士{M#哥哥}{F#姐姐}好像在做拼图游戏哦…"
                }
            ]
        },
        {
            "id": "4011910",
            "objective": "登上核心轮縠的飞亭",
            "dialogues": []
        },
        {
            "id": "4011907",
            "objective": "乘坐飞亭前往核心轮縠的顶端",
            "dialogues": []
        },
        {
            "id": "4011908",
            "objective": "与可莉对话",
            "dialogues": [
                {
                    "id": "401190801",
                    "speaker": "伊迪娅",
                    "text": "每次送大家离开蜃境之后，我都会一个人到这里待一会儿。"
                },
                {
                    "id": "401190802",
                    "speaker": "伊迪娅",
                    "text": "他们呀，一开始在蜃境里做出各种东西的时候可开心了…"
                },
                {
                    "id": "401190803",
                    "speaker": "伊迪娅",
                    "text": "可是一知道这些东西没法带出去，就会变得有些苦恼，要么不舍，要么一脸遗憾地离开。"
                },
                {
                    "id": "401190804",
                    "speaker": "可莉",
                    "text": "伊迪娅姐姐会难过吗？"
                },
                {
                    "id": "401190805",
                    "speaker": "伊迪娅",
                    "text": "…虽然偶尔会感到寂寞，但我不难过。"
                },
                {
                    "id": "401190806",
                    "speaker": "伊迪娅",
                    "text": "有些人会在离开蜃境时毁掉自己创造的一切，而有些则不同，比如你们看到的那些居民。"
                },
                {
                    "id": "401190807",
                    "speaker": "伊迪娅",
                    "text": "在离开蜃境时，他们托我用水形幻灵模拟「自己」，替他们维护蜃境中的造物，就像是看管他们的梦一样。"
                },
                {
                    "id": "401190808",
                    "speaker": "派蒙",
                    "text": "听起来好浪漫呀。"
                },
                {
                    "id": "401190809",
                    "speaker": "伊迪娅",
                    "text": "嗯，虽然不知道他们在外面过得如何，但光是想到他们有可能实现梦想，成为这个蜃境中的样子，就觉得开心。"
                },
                {
                    "id": "401190810",
                    "speaker": "伊迪娅",
                    "text": "仿佛我是在梦想的终点等着他们一样…"
                },
                {
                    "id": "401190811",
                    "speaker": "Player",
                    "text": "伊迪娅人真好。"
                },
                {
                    "id": "401190812",
                    "speaker": "伊迪娅",
                    "text": "呃…有吗？"
                },
                {
                    "id": "401190813",
                    "speaker": "伊迪娅",
                    "text": "我只是觉得，每个梦想和愿望就像一束瓶中之光。"
                },
                {
                    "id": "401190814",
                    "speaker": "伊迪娅",
                    "text": "不管你是在追寻梦想的途中，还是已经达成了梦想…"
                },
                {
                    "id": "401190815",
                    "speaker": "伊迪娅",
                    "text": "只要回想起这束属于自己的光芒时能够会心一笑，就已经足够了…"
                },
                {
                    "id": "401190816",
                    "speaker": "可莉",
                    "text": "可莉现在就觉得很开心！"
                },
                {
                    "id": "401190817",
                    "speaker": "伊迪娅",
                    "text": "哈哈，那我也算报答了当年艾莉丝女士的恩情。沙漠这地方，怎么看都是污泥汤…"
                },
                {
                    "id": "401190818",
                    "speaker": "派蒙",
                    "text": "那我给你起个外号吧，就叫泥水精灵！哇，伊迪娅是泥水精灵！"
                },
                {
                    "id": "401190819",
                    "speaker": "伊迪娅",
                    "text": "还敢笑我？啊呜一口把你吃掉哦！"
                },
                {
                    "id": "401190820",
                    "speaker": "伊迪娅",
                    "text": "…虽然让你们见到了难堪的一面，但恢复运转的蜃境会变得越来越热闹，大家就再好好放松一下吧。"
                },
                {
                    "id": "401190821",
                    "speaker": "Player",
                    "text": "为了大家的梦想！"
                },
                {
                    "id": "401190822",
                    "speaker": "可莉",
                    "text": "嗯，可莉想要叫上所有人——"
                },
                {
                    "id": "401190823",
                    "speaker": "可莉",
                    "text": "大家一起坐「呼呼飞车」吧！"
                }
            ]
        },
        {
            "id": "4011921",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "401192101",
                    "speaker": "珊瑚宫心海",
                    "text": "嗯…按照我之前的印象，好像有一个较小的轮子在右侧。"
                },
                {
                    "id": "401192102",
                    "speaker": "珊瑚宫心海",
                    "text": "会不会就是这个糖果盒？"
                }
            ]
        },
        {
            "id": "4011924",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "401192401",
                    "speaker": "优菈",
                    "text": "嗯…等到修复完毕，应该就可以出去了吧。"
                }
            ]
        },
        {
            "id": "4011925",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "401192501",
                    "speaker": "凯亚",
                    "text": "投下这个影子的是…绳索吗？"
                },
                {
                    "id": "401192502",
                    "speaker": "凯亚",
                    "text": "唔…总觉得绳索应该搭在什么东西上面，把什么连接起来…"
                }
            ]
        },
        {
            "id": "4011927",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "401192701",
                    "speaker": "佐西摩斯",
                    "text": "接下来你们应该要恢复蜃境的核心了吧…那就祝你们一切顺利。"
                },
                {
                    "id": "401192702",
                    "speaker": "佐西摩斯",
                    "text": "我很荣幸能在这里遇到各位，你们就是我最初的「班底」了！谢谢，感谢你们带给我的一切。"
                }
            ]
        },
        {
            "id": "4011934",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "401193401",
                    "speaker": "伊迪娅",
                    "text": "啊，这是佐西摩斯的瓶子灯…"
                },
                {
                    "id": "401193402",
                    "speaker": "伊迪娅",
                    "text": "不如随便塞在什么结构有空缺的地方吧，我猜右边就行。"
                }
            ]
        },
        {
            "id": "4011999",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "401199904",
                    "speaker": "伊迪娅",
                    "text": "轮縠本身就是由零件构成的，现在将零件放在底座上，拼成原来的形状就好了…"
                },
                {
                    "id": "401199905",
                    "speaker": "派蒙",
                    "text": "哎，可是我们没见过原来的形状…"
                },
                {
                    "id": "401199906",
                    "speaker": "伊迪娅",
                    "text": "没关系…大差不差，只要是个能转的东西就好了！嗯嗯，一定行…"
                },
                {
                    "id": "401199907",
                    "speaker": "派蒙",
                    "text": "你这个人…随便起来可真随便呀…"
                }
            ]
        },
        {
            "id": "4012513",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "401251301",
                    "speaker": "伊迪娅",
                    "text": "「欢迎来到『琉形蜃境』，希望你们能够在这里稍微忘记旅途的疲惫，好好休息一番。」"
                },
                {
                    "id": "401251302",
                    "speaker": "伊迪娅",
                    "text": "本来应该在初次见面的时候说这种欢迎辞的，唉，没想到居然发生了那么多事。"
                },
                {
                    "id": "401251303",
                    "speaker": "伊迪娅",
                    "text": "既然一切恢复了，那就为你补上这句开场…怎么样，听上去还是挺正经的吧！"
                }
            ]
        }
    ]
}