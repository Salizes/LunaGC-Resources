    "talks": [
        {
            "id": "7001601",
            "objective": "与丘丘人对话",
            "dialogues": [
                {
                    "id": "700160101",
                    "speaker": "孤独的丘丘人",
                    "text": "…Yaya dala?"
                },
                {
                    "id": "700160102",
                    "speaker": "艾拉·马斯克",
                    "text": "Mimi tomo, mimi mosi mita, Muhe mita?"
                },
                {
                    "id": "700160103",
                    "speaker": "孤独的丘丘人",
                    "text": "Mita…? Gusha… Dada ika odomu Plata mimi, mimi mosi gusha…"
                },
                {
                    "id": "700160104",
                    "speaker": "艾拉·马斯克",
                    "text": "Mimi tomo, mimi plata yaya ika! Mimi mani ye!"
                },
                {
                    "id": "700160105",
                    "speaker": "孤独的丘丘人",
                    "text": "Mani…? Dada! Kundala zido mi, mi dada, mimi tomo!"
                },
                {
                    "id": "700160106",
                    "speaker": "派蒙",
                    "text": "他们两个聊得很开心的样子呢…",
                    "choices": [
                        {
                            "id": "700160107",
                            "text": "不愧是马斯克小姐。",
                            "response": [
                                {
                                    "id": "700160109",
                                    "speaker": "艾拉·马斯克",
                                    "text": "其实它只是不爱说话而已，不过我已经问到需要的信息了。"
                                },
                                {
                                    "id": "700160110",
                                    "speaker": "艾拉·马斯克",
                                    "text": "帮助它打败敌人就好，接下来就交给你们啦！"
                                },
                                {
                                    "id": "700160111",
                                    "speaker": "孤独的丘丘人",
                                    "text": "Dada, Valo!"
                                }
                            ]
                        },
                        {
                            "id": "700160108",
                            "text": "对话进行得很顺利呢。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7001602",
            "objective": "前往指定地点战斗",
            "dialogues": [
                {
                    "id": "700160201",
                    "speaker": "孤独的丘丘人",
                    "text": "Yoyo dada! Mimi tomo!"
                },
                {
                    "id": "700160202",
                    "speaker": "艾拉·马斯克",
                    "text": "Mimi muhe du, du ya Wei zido dala si."
                },
                {
                    "id": "700160203",
                    "speaker": "孤独的丘丘人",
                    "text": "Mi mito nye. Mi mito du, du ya mito Wei."
                },
                {
                    "id": "700160204",
                    "speaker": "艾拉·马斯克",
                    "text": "它把我们指到了这个地方。说这里应该有人看过。"
                },
                {
                    "id": "700160205",
                    "speaker": "Player",
                    "text": "Valo! Tomo!"
                },
                {
                    "id": "700160206",
                    "speaker": "孤独的丘丘人",
                    "text": "Valo, valo…"
                }
            ]
        },
