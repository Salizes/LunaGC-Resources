    "talks": [
        {
            "id": "7114501",
            "objective": "与苏定对话",
            "dialogues": [
                {
                    "id": "711450101",
                    "speaker": "苏定",
                    "text": "#有劳两位了，{NICKNAME}顾问和这位才智出众的帮手！"
                },
                {
                    "id": "711450102",
                    "speaker": "苏定",
                    "text": "经过这段时间的推演，我们获得了充足的对抗案例，足以拆解出各种复杂战况的分析样本。"
                },
                {
                    "id": "711450103",
                    "speaker": "苏定",
                    "text": "接下来，只需根据推演兵种的特性，建立更宽泛的模型，就能撰写多种想定脚本，将它们交给多个单位的各级将士钻研。"
                },
                {
                    "id": "711450104",
                    "speaker": "苏定",
                    "text": "如果两位有兴趣，下次见面时，我也会为你们提供对应的想定脚本，以供你们在闲暇之时锻炼才思。",
                    "choices": [
                        {
                            "id": "711450105",
                            "text": "这就搞定了？好像还没玩几局…",
                            "response": [
                                {
                                    "id": "711450106",
                                    "speaker": "苏定",
                                    "text": "我们深知两位事务繁忙，尽量排除了相似的推演，避免重复工作。当然，如果两位还没尽兴，再来多少次都没问题。"
                                },
                                {
                                    "id": "711450109",
                                    "speaker": "苏定",
                                    "text": "总而言之，我代表千岩军的参谋部，以及其他参会单位的代表，向你们表示郑重的感谢！"
                                },
                                {
                                    "id": "711450110",
                                    "speaker": "苏定",
                                    "text": "希望以后还有机会与两位合作，进一步加强各单位清除魔物，改善治安状况的能力。",
                                    "choices": [
                                        {
                                            "id": "711450111",
                                            "text": "乐意至极！",
                                            "response": [
                                                {
                                                    "id": "711450113",
                                                    "speaker": "派蒙",
                                                    "text": "哼哼，这次的进展真是超级顺利。感觉，我们和以前就认识的各种团队搞好了关系，还帮到了提瓦特各种地方的人！"
                                                },
                                                {
                                                    "id": "711450114",
                                                    "speaker": "派蒙",
                                                    "text": "而且，看着你进行推演，我好像也学到了不少知识？"
                                                },
                                                {
                                                    "id": "711450115",
                                                    "speaker": "派蒙",
                                                    "text": "说不定，以后我们闲着无聊的时候，也可以来分析分析…"
                                                },
                                                {
                                                    "id": "711450116",
                                                    "speaker": "派蒙",
                                                    "text": "比如，唔…深渊法师和大雪猪王对对碰，谁会赢？"
                                                },
                                                {
                                                    "id": "711450117",
                                                    "speaker": "派蒙",
                                                    "text": "或者…遗迹守卫和岩龙蜥，谁的脑袋更硬！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "711450112",
                                            "text": "有空就来！"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "711450107",
                            "text": "终于完成了！辛苦我和派蒙啦…",
                            "response": [
                                {
                                    "id": "711450108",
                                    "speaker": "派蒙",
                                    "text": "嘿嘿，虽然我还没完全搞明白各种规则，但玩得还挺开心的！看起来结果也不错嘛！"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}