    "talks": [
        {
            "id": "1402402",
            "objective": "去附近的海边寻找「仆人」",
            "dialogues": [
                {
                    "id": "140240201",
                    "speaker": "派蒙",
                    "text": "「仆人」…还有「公子」！！"
                },
                {
                    "id": "140240202",
                    "speaker": "派蒙",
                    "text": "喂，你不是回至冬养伤去了吗？怎么还在枫丹呀！"
                },
                {
                    "id": "140240203",
                    "speaker": "「公子」",
                    "text": "噢，两位，没想到还能在这里再见面…咳咳、咳！"
                },
                {
                    "id": "140240204",
                    "speaker": "「公子」",
                    "text": "从原始胎海离开后，我昏迷了很久。再次醒来时，发现自己正被送往至冬。"
                },
                {
                    "id": "140240205",
                    "speaker": "「公子」",
                    "text": "这怎么行？我在枫丹还有没做完的事情。于是我强撑着爬起来，又一个人回来了。"
                },
                {
                    "id": "140240206",
                    "speaker": "派蒙",
                    "text": "嗯？什么事情？"
                },
                {
                    "id": "140240207",
                    "speaker": "「公子」",
                    "text": "关于「丝柯克」…我的师父。我很想见她一面，可惜等我回来的时候，她已经离开了。"
                },
                {
                    "id": "140240208",
                    "speaker": "「公子」",
                    "text": "我还有很多问题想问她。没办法，只好拜托「仆人」帮我查查师父的踪迹。她既然来了枫丹，应该会留下些蛛丝马迹才对。"
                },
                {
                    "id": "140240209",
                    "speaker": "派蒙",
                    "text": "原来如此，那你们找到什么线索了吗？"
                },
                {
                    "id": "140240210",
                    "speaker": "「仆人」",
                    "text": "很遗憾。虽然壁炉之家可以搞定绝大部分情报，但面对那样的存在，我们也无可奈何。"
                },
                {
                    "id": "140240211",
                    "speaker": "「公子」",
                    "text": "说到底，还是师父认为现在没有见我的必要。"
                },
                {
                    "id": "140240212",
                    "speaker": "「公子」",
                    "text": "不过这个问题也容易解决。只要我变得更强…咳咳、咳咳咳！"
                },
                {
                    "id": "140240213",
                    "speaker": "派蒙",
                    "text": "你还是先把伤养好再说吧！"
                },
                {
                    "id": "140240214",
                    "speaker": "「公子」",
                    "text": "哈哈，我已经好得差不多了。"
                },
                {
                    "id": "140240215",
                    "speaker": "「公子」",
                    "text": "多亏了壁炉之家。那个叫埃卢瓦尔的孩子配了些乱七八糟的药剂给我，喝了之后浑身都疼，但恢复速度确实快了不少。"
                },
                {
                    "id": "140240216",
                    "speaker": "「公子」",
                    "text": "这次真的要道别了。老爷子派人来催了，让我回去参加什么计划…"
                },
                {
                    "id": "140240217",
                    "speaker": "「仆人」",
                    "text": "「严冬计划」？"
                },
                {
                    "id": "140240218",
                    "speaker": "「公子」",
                    "text": "对对。唉，听说还有「富人」的事，我可不想回去听他的长篇大论。要不你想个办法，让我在枫丹多待一段时间？"
                },
                {
                    "id": "140240219",
                    "speaker": "「公子」",
                    "text": "我还是觉得教林尼他们武艺比较有趣，如果你能和我切磋一下就更好了，我还没见过你全力以赴的样子。"
                },
                {
                    "id": "140240220",
                    "speaker": "「仆人」",
                    "text": "想多了。我也在接下来的计划中，用不了多久就会从这里离开。"
                },
                {
                    "id": "140240221",
                    "speaker": "「仆人」",
                    "text": "再说，那些留在至冬的富商政要点名要你回去，不也是一种「荣耀」吗？"
                },
                {
                    "id": "140240222",
                    "speaker": "「公子」",
                    "text": "哈哈…饶了我吧。"
                },
                {
                    "id": "140240223",
                    "speaker": "派蒙",
                    "text": "感觉这两个人…"
                },
                {
                    "id": "140240224",
                    "speaker": "Player",
                    "text": "一本正经地在背后议论同事…"
                },
                {
                    "id": "140240225",
                    "speaker": "「仆人」",
                    "text": "所以，两位壁炉之家的「客人」，来找我做什么？"
                },
                {
                    "id": "140240226",
                    "speaker": "派蒙",
                    "text": "啊…这个…"
                },
                {
                    "id": "140240227",
                    "speaker": "Player",
                    "text": "想多了解一下壁炉之家的「父亲」。"
                },
                {
                    "id": "140240228",
                    "speaker": "派蒙",
                    "text": "没错！我们跟林尼他们已经很熟了，反倒是对你还不怎么了解呢。"
                },
                {
                    "id": "140240229",
                    "speaker": "「仆人」",
                    "text": "是吗？我记得自己做过自我介绍。"
                },
                {
                    "id": "140240230",
                    "speaker": "派蒙",
                    "text": "那种简短的自我介绍有什么用啦，起码告诉我们，为什么你要自称「父亲」吧？"
                },
                {
                    "id": "140240231",
                    "speaker": "「公子」",
                    "text": "哦，好问题！我其实也想知道。"
                },
                {
                    "id": "140240232",
                    "speaker": "「仆人」",
                    "text": "既然你们都不知道，说明我们的情报工作做得很好，应该继续保持下去。"
                },
                {
                    "id": "140240233",
                    "speaker": "「公子」",
                    "text": "不愧是外交官啊，轻易就化解了我们的进攻。"
                },
                {
                    "id": "140240234",
                    "speaker": "「仆人」",
                    "text": "没事的话，我就先回去了，家里还有件麻烦事要处理。"
                },
                {
                    "id": "140240235",
                    "speaker": "派蒙",
                    "text": "欸…欸！等一下！"
                },
                {
                    "id": "140240236",
                    "speaker": "Player",
                    "text": "（如果「仆人」就这么回去的话，可能会正好撞上林尼和克雷薇…！）"
                },
                {
                    "id": "140240237",
                    "speaker": "Player",
                    "text": "（要放飞林尼的魔术飞鸟吗？不，在那之前，先试着寻找一些别的话题吧。）",
                    "choices": [
                        {
                            "id": "140240238",
                            "text": "关于壁炉之家…",
                            "response": [
                                {
                                    "id": "140240240",
                                    "speaker": "「公子」",
                                    "text": "哦，这个问题我也有点好奇。"
                                },
                                {
                                    "id": "140240241",
                                    "speaker": "「公子」",
                                    "text": "我和壁炉之家那些孩子们接触过，他们都是些好孩子。见到他们，我就会想起冬妮娅和托克。"
                                },
                                {
                                    "id": "140240242",
                                    "speaker": "「公子」",
                                    "text": "如果有一天你「背叛」了他们，我一定会找你打一架。"
                                },
                                {
                                    "id": "140240243",
                                    "speaker": "「仆人」",
                                    "text": "我为什么会背叛他们？"
                                },
                                {
                                    "id": "140240244",
                                    "speaker": "「公子」",
                                    "text": "我听说你已经背叛过一次「壁炉之家」了，不知道是真是假。"
                                },
                                {
                                    "id": "140240245",
                                    "speaker": "「仆人」",
                                    "text": "……"
                                },
                                {
                                    "id": "140240246",
                                    "speaker": "「公子」",
                                    "text": "好吧，我承认，是老爷子…就是「公鸡」告诉我的。"
                                },
                                {
                                    "id": "140240247",
                                    "speaker": "Player",
                                    "text": "（背叛…难道说克雷薇说的是真的吗？「仆人」她把壁炉之家的孩子当做实验品？）"
                                },
                                {
                                    "id": "140240248",
                                    "speaker": "派蒙",
                                    "text": "你，你真的对那些孩子做过什么坏事吗？"
                                },
                                {
                                    "id": "140240249",
                                    "speaker": "「仆人」",
                                    "text": "比起我做过什么，我更想听听伟大的「公鸡」先生是如何评价我的。"
                                },
                                {
                                    "id": "140240250",
                                    "speaker": "「公子」",
                                    "text": "我想想啊，大致就是干掉了许多「同伴」、最后还对「亲人」动手之类的。"
                                },
                                {
                                    "id": "140240251",
                                    "speaker": "「仆人」",
                                    "text": "哦。"
                                },
                                {
                                    "id": "140240252",
                                    "speaker": "「公子」",
                                    "text": "看你的反应，这些传闻是假的？"
                                },
                                {
                                    "id": "140240253",
                                    "speaker": "「仆人」",
                                    "text": "不，虽然这种表述我不太喜欢，但也算是事实。"
                                },
                                {
                                    "id": "140240254",
                                    "speaker": "「仆人」",
                                    "text": "严格来讲，算是某种偏见。我暂时不打算澄清，偏见会将真相包裹起来，对我来说是一件好事。"
                                },
                                {
                                    "id": "140240255",
                                    "speaker": "「仆人」",
                                    "text": "就像我经常自称「枫丹人」，但我只是在枫丹长大而已。"
                                },
                                {
                                    "id": "140240256",
                                    "speaker": "派蒙",
                                    "text": "啊？？你、你不是枫丹人吗？那你为什么要帮枫丹度过危机？"
                                },
                                {
                                    "id": "140240257",
                                    "speaker": "「仆人」",
                                    "text": "在枫丹做事，这个身份比较好用，不会被怀疑是别有用心。谁不想拯救自己的家乡呢？我真正想要保护的，是那些出身枫丹的孩子。"
                                },
                                {
                                    "id": "140240258",
                                    "speaker": "「仆人」",
                                    "text": "原始胎海对我没有影响，但会给壁炉之家带来损失。希望我透露的信息可以满足你们的好奇心。"
                                },
                                {
                                    "id": "140240259",
                                    "speaker": "Player",
                                    "text": "（仆人主动聊起自己的秘密，将话题从「背叛壁炉之家」上引开了。她似乎还不愿意提起自己的过去…）"
                                },
                                {
                                    "id": "140240260",
                                    "speaker": "「公子」",
                                    "text": "既然你为了他们留在枫丹，那我相信你不会背叛那些「孩子们」…抱歉，之前我对你的看法有些偏颇。"
                                },
                                {
                                    "id": "140240261",
                                    "speaker": "「仆人」",
                                    "text": "我说了，这是一件好事。"
                                },
                                {
                                    "id": "140240262",
                                    "speaker": "「公子」",
                                    "text": "说起来，在壁炉之家养伤的时候，我还听说了一件很对我胃口的事情。"
                                },
                                {
                                    "id": "140240263",
                                    "speaker": "「公子」",
                                    "text": "据说在壁炉之家，每次家人出现争执的时候就会打一场，输的一方要主动做出让步。那岂不是可以经常光明正大地切磋？"
                                },
                                {
                                    "id": "140240264",
                                    "speaker": "「仆人」",
                                    "text": "你说的是近些年的事情，更早的时候可没有这么美好，输的一方会失去一切，包括自己的生命。"
                                },
                                {
                                    "id": "140240265",
                                    "speaker": "派蒙",
                                    "text": "这么危险！幸亏改掉了！"
                                },
                                {
                                    "id": "140240266",
                                    "speaker": "「公子」",
                                    "text": "现在的氛围我很喜欢，或者说有点羡慕。你有这么多家人，而且可以和他们生活在一起。"
                                },
                                {
                                    "id": "140240267",
                                    "speaker": "「仆人」",
                                    "text": "家人太多，就会开始吵闹，开始勾心斗角。等冬妮娅和托克都进入叛逆期，你就明白这种感受了。"
                                },
                                {
                                    "id": "140240268",
                                    "speaker": "「仆人」",
                                    "text": "想象一下：托克迷上了拔「公鸡」的胡子，冬妮娅把自己的头发染出四十二种颜色…"
                                },
                                {
                                    "id": "140240269",
                                    "speaker": "「公子」",
                                    "text": "停停，我完全能够理解了。"
                                },
                                {
                                    "id": "140240270",
                                    "speaker": "Black Screen",
                                    "text": "聊到冬妮娅和托克，「公子」立刻打开话匣子，滔滔不绝地讲起故事。"
                                },
                                {
                                    "id": "140240271",
                                    "speaker": "Black Screen",
                                    "text": "往常听到最后可能会打瞌睡，这次却由衷地感谢他帮忙拖延了时间。"
                                },
                                {
                                    "id": "140240272",
                                    "speaker": "「公子」",
                                    "text": "一晃都到这个时间了，我该走了。"
                                },
                                {
                                    "id": "140240273",
                                    "speaker": "「公子」",
                                    "text": "#{NICKNAME}、派蒙，下次不知道会在哪里再见。到时候有机会的话，我们再比试一番…咳咳、咳！"
                                },
                                {
                                    "id": "140240274",
                                    "speaker": "派蒙",
                                    "text": "都说啦，你还是先把伤养好再说吧。"
                                },
                                {
                                    "id": "140240275",
                                    "speaker": "「公子」",
                                    "text": "好、好。还有，这次多谢你了，阿蕾奇诺。"
                                },
                                {
                                    "id": "140240276",
                                    "speaker": "「仆人」",
                                    "text": "不客气，拿到神之心有你的一份贡献，我们互不相欠。"
                                },
                                {
                                    "id": "140240277",
                                    "speaker": "「公子」",
                                    "text": "这样也不错。那我走了，下次再会，各位。"
                                },
                                {
                                    "id": "140240278",
                                    "speaker": "派蒙",
                                    "text": "我们也走吧…你要跟我们一起回去吗？"
                                },
                                {
                                    "id": "140240279",
                                    "speaker": "「仆人」",
                                    "text": "怎么，你们希望我现在就走？"
                                },
                                {
                                    "id": "140240280",
                                    "speaker": "派蒙",
                                    "text": "啊…这个…"
                                },
                                {
                                    "id": "140240281",
                                    "speaker": "「仆人」",
                                    "text": "晚风很舒适，我留下来思考一些事情。"
                                },
                                {
                                    "id": "140240282",
                                    "speaker": "「仆人」",
                                    "text": "招待不周，敬请谅解。希望你们住得开心。"
                                }
                            ]
                        },
                        {
                            "id": "140240239",
                            "text": "你是怎么看待壁炉之家的呢？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1402403",
            "objective": "回到白淞镇",
            "dialogues": [
                {
                    "id": "140240301",
                    "speaker": "派蒙",
                    "text": "林尼！怎么样，有什么进展吗？"
                },
                {
                    "id": "140240302",
                    "speaker": "林尼",
                    "text": "说来话长，我这边遇到了一点麻烦——克雷薇没办法去有阳光的地方。"
                },
                {
                    "id": "140240303",
                    "speaker": "Player",
                    "text": "什么意思？"
                },
                {
                    "id": "140240304",
                    "speaker": "林尼",
                    "text": "我让她跟在我身旁，然后带她到地面上。最开始一切都很顺利。"
                },
                {
                    "id": "140240305",
                    "speaker": "林尼",
                    "text": "但是当我领着她穿过阴影，走入阳光的时候，我突然发现她不见了。"
                },
                {
                    "id": "140240306",
                    "speaker": "林尼",
                    "text": "回过头，就看到她停留在阴影的边缘，静静地望着我。"
                },
                {
                    "id": "140240307",
                    "speaker": "派蒙",
                    "text": "难道她害怕阳光吗？不对不对，如果是这样的话，她就不会提出「在阳光下生活」的愿望了。"
                },
                {
                    "id": "140240308",
                    "speaker": "派蒙",
                    "text": "呃…要不推她一下试试？"
                },
                {
                    "id": "140240309",
                    "speaker": "Player",
                    "text": "能推的话就不叫「亡魂」了吧。"
                },
                {
                    "id": "140240310",
                    "speaker": "派蒙",
                    "text": "也对哦…"
                },
                {
                    "id": "140240311",
                    "speaker": "林尼",
                    "text": "总之，我尝试了各种方法，都没能成功。眼见太阳落山，我只能先带着克雷薇回来了。"
                },
                {
                    "id": "140240312",
                    "speaker": "林尼",
                    "text": "琳妮特，你那边情况怎么样？"
                },
                {
                    "id": "140240313",
                    "speaker": "琳妮特",
                    "text": "我拿到名单了，在这里。"
                },
                {
                    "id": "140240314",
                    "speaker": "派蒙",
                    "text": "真的吗？快让我看看…"
                },
                {
                    "id": "140240315",
                    "speaker": "派蒙",
                    "text": "居然有这么多！要完整看完要花多长时间呀！"
                },
                {
                    "id": "140240316",
                    "speaker": "林尼",
                    "text": "我们分一分吧，每人看一部分，给。"
                },
                {
                    "id": "140240317",
                    "speaker": "派蒙",
                    "text": "拉普亚德…朗杜瓦…让贝尔…奥尔内…"
                },
                {
                    "id": "140240318",
                    "speaker": "派蒙",
                    "text": "呜哇，这个奥尔内脸上有好深的疤痕，看上去就是个很可怕的家伙。"
                },
                {
                    "id": "140240319",
                    "speaker": "林尼",
                    "text": "哦，我跟他接触过。他是某次执行任务的时候受的伤，当时他还跟我开玩笑，说以后要被爱人嫌弃了。"
                },
                {
                    "id": "140240320",
                    "speaker": "派蒙",
                    "text": "那你怎么说？"
                },
                {
                    "id": "140240321",
                    "speaker": "林尼",
                    "text": "我问他有爱人吗，他说没有，聊天到这里就结束了。"
                },
                {
                    "id": "140240322",
                    "speaker": "林尼",
                    "text": "后来我听说他真的喜欢上了一个人，为了她不惜从家里逃跑，但没能成功。有一天他被「父亲」叫出去…之后我就再也没有见过他。"
                },
                {
                    "id": "140240323",
                    "speaker": "派蒙",
                    "text": "也就是说，他被「仆人」给…"
                },
                {
                    "id": "140240324",
                    "speaker": "林尼",
                    "text": "虽然残酷，但这就是家的规矩。"
                },
                {
                    "id": "140240325",
                    "speaker": "林尼",
                    "text": "在壁炉之家，每个人都知道太多秘密，所以这里容不下背叛。想从家里离开，必须付出生命的代价。"
                },
                {
                    "id": "140240326",
                    "speaker": "Black Screen",
                    "text": "众人怀着沉重的心情看完了处刑名单，但里面并没有克雷薇的名字。"
                },
                {
                    "id": "140240327",
                    "speaker": "林尼",
                    "text": "没有啊…这也在预料之中。这份名单并不完整，只有近五年的记录。"
                },
                {
                    "id": "140240328",
                    "speaker": "林尼",
                    "text": "还是从别的地方入手吧，菲米尼，你打听到什么情报了吗？"
                },
                {
                    "id": "140240329",
                    "speaker": "菲米尼",
                    "text": "……"
                },
                {
                    "id": "140240330",
                    "speaker": "林尼",
                    "text": "菲米尼？"
                },
                {
                    "id": "140240331",
                    "speaker": "菲米尼",
                    "text": "抱歉，我刚刚在想事情。"
                },
                {
                    "id": "140240332",
                    "speaker": "菲米尼",
                    "text": "我认真地跟其他人聊了聊，感觉家里的气氛有点奇怪。"
                },
                {
                    "id": "140240333",
                    "speaker": "琳妮特",
                    "text": "奇怪？"
                },
                {
                    "id": "140240334",
                    "speaker": "菲米尼",
                    "text": "嗯。其实以前，家里就有许多争吵。比如沙普洛和菲约尔之间…"
                },
                {
                    "id": "140240335",
                    "speaker": "派蒙",
                    "text": "是我们分发物资的时候见过的那些人吗？他们看起来确实不太一样，聊的话题也完全不同…"
                },
                {
                    "id": "140240336",
                    "speaker": "林尼",
                    "text": "很简单。「父亲」将我们带到壁炉之家，教我们知识和武艺，但并非每个人都发自内心地想留在这里。"
                },
                {
                    "id": "140240337",
                    "speaker": "林尼",
                    "text": "在加入壁炉之家后，我们就带上了「愚人众」的标签。在很多人看来，这并非是一个光明正大的身份。"
                },
                {
                    "id": "140240338",
                    "speaker": "林尼",
                    "text": "随着年龄增长，一部分人的心里有了别的想法。只是囿于壁炉之家的规矩，不敢轻易开口。"
                },
                {
                    "id": "140240339",
                    "speaker": "林尼",
                    "text": "沙普洛、福尔茨他们更拥护和认可「父亲」，以身为愚人众为傲。而在菲约尔、南特伊心里，这种感情要平淡许多。"
                },
                {
                    "id": "140240340",
                    "speaker": "琳妮特",
                    "text": "这种矛盾一直都存在，「父亲」应该也知道。"
                },
                {
                    "id": "140240341",
                    "speaker": "菲米尼",
                    "text": "但我觉得情况好像变严重了。菲约尔他们…似乎私下里会聚在一起聊什么东西。"
                },
                {
                    "id": "140240342",
                    "speaker": "菲米尼",
                    "text": "虽然只是我的猜测，但我觉得他们应该见过克雷薇。"
                },
                {
                    "id": "140240343",
                    "speaker": "林尼",
                    "text": "你觉得克雷薇在煽动他们？"
                },
                {
                    "id": "140240344",
                    "speaker": "菲米尼",
                    "text": "不像，但克雷薇可能跟他们说了一些「家里不为人知的黑暗」。"
                },
                {
                    "id": "140240345",
                    "speaker": "菲米尼",
                    "text": "她也跟我说过这些，比如拿孩子们做实验、强迫没有力量的人上战场…"
                },
                {
                    "id": "140240346",
                    "speaker": "林尼",
                    "text": "菲约尔他们相信了？这些事完全没有证据。"
                },
                {
                    "id": "140240347",
                    "speaker": "琳妮特",
                    "text": "我觉得他们未必相信，但克雷薇的话提供了一个借口。"
                },
                {
                    "id": "140240348",
                    "speaker": "林尼",
                    "text": "唉…根源还是在「严冬计划」上吗？"
                },
                {
                    "id": "140240349",
                    "speaker": "派蒙",
                    "text": "等一下，你们讲慢点啦！"
                },
                {
                    "id": "140240350",
                    "speaker": "派蒙",
                    "text": "「仆人」好像也提到了「严冬计划」，这个到底是什么？"
                },
                {
                    "id": "140240351",
                    "speaker": "林尼",
                    "text": "抱歉，具体内容我也不了解。"
                },
                {
                    "id": "140240352",
                    "speaker": "林尼",
                    "text": "我只是听「父亲」说过，是由「公鸡」与「富人」两位执行官联手推动的计划，涉及到愚人众接下来的战略安排。"
                },
                {
                    "id": "140240353",
                    "speaker": "林尼",
                    "text": "因为顺利拿到了神之心，壁炉之家得到了嘉奖，并将在严冬计划中承担非常重要的工作。"
                },
                {
                    "id": "140240354",
                    "speaker": "派蒙",
                    "text": "这对你们来说不是好事吗？"
                },
                {
                    "id": "140240355",
                    "speaker": "林尼",
                    "text": "「重要」等同于「危险」，对我们来说是很大的麻烦。"
                },
                {
                    "id": "140240356",
                    "speaker": "林尼",
                    "text": "「父亲」也很头疼，但又没法拒绝。他们的计划合情合理，甚至给我们调拨了大量经费。"
                },
                {
                    "id": "140240357",
                    "speaker": "林尼",
                    "text": "但是——按照这个计划执行，我们会牺牲很多人。这也算一种变相打压，他们对不受掌握的情报部门感到不安。"
                },
                {
                    "id": "140240358",
                    "speaker": "Player",
                    "text": "（看来愚人众内部正在策划什么大事。不过林尼他们对此并不知情，打听不到太多情报。）"
                },
                {
                    "id": "140240359",
                    "speaker": "Player",
                    "text": "（今后和愚人众接触的时候，仔细观察一下吧。）"
                },
                {
                    "id": "140240360",
                    "speaker": "派蒙",
                    "text": "没想到愚人众内部这么复杂，不过这和你们家里的矛盾有什么关系吗？"
                },
                {
                    "id": "140240361",
                    "speaker": "林尼",
                    "text": "外界的压力会加速内部的分化。死亡的恐惧压在心头，可能会让一些人做出错误的举动。"
                },
                {
                    "id": "140240362",
                    "speaker": "林尼",
                    "text": "我本来以为解决克雷薇的事情，一切就可以恢复正常。"
                },
                {
                    "id": "140240363",
                    "speaker": "林尼",
                    "text": "现在看来情况比我预想的更麻烦。如果放任菲约尔他们不管，「父亲」迟早会对他们动手。"
                },
                {
                    "id": "140240364",
                    "speaker": "琳妮特",
                    "text": "哥哥，我们只能做好眼前的事情。"
                },
                {
                    "id": "140240365",
                    "speaker": "林尼",
                    "text": "也是。现在去找菲约尔他们，一时间也不会有什么结果，反倒会适得其反。还是先想办法送别克雷薇吧。"
                },
                {
                    "id": "140240366",
                    "speaker": "林尼",
                    "text": "今天很晚了，我们先各自去休息。明天太阳升起，立刻出发。"
                },
                {
                    "id": "140240367",
                    "speaker": "林尼",
                    "text": "琳妮特，这次你跟我一起去外面。菲米尼，拜托你盯着菲约尔他们，尽量不要让他们做错事。"
                },
                {
                    "id": "140240368",
                    "speaker": "林尼",
                    "text": "今天辛苦大家了。晚安，明天再见。"
                }
            ]
        },
        {
            "id": "1402404",
            "objective": "在临时住所休息",
            "dialogues": [
                {
                    "id": "140240401",
                    "speaker": "派蒙",
                    "text": "呼哇…说着要早点睡，结果完全睡不着…"
                },
                {
                    "id": "140240402",
                    "speaker": "派蒙",
                    "text": "你说，「仆人」如果知道了林尼他们做的事，会不会很生气？"
                },
                {
                    "id": "140240403",
                    "speaker": "派蒙",
                    "text": "她平时笑着的时候，我就觉得有点吓人。要是她发起火来…呜呜，到时候你一定要保护我呀。",
                    "choices": [
                        {
                            "id": "140240404",
                            "text": "其实我也有点怕…",
                            "response": [
                                {
                                    "id": "140240405",
                                    "speaker": "派蒙",
                                    "text": "你也有同样的感觉吗？那、那到时候我们一起逃跑吧！拉着林尼他们，有多快跑多快！"
                                },
                                {
                                    "id": "140240408",
                                    "speaker": "派蒙",
                                    "text": "……"
                                },
                                {
                                    "id": "140240409",
                                    "speaker": "派蒙",
                                    "text": "你你、你快看那边！",
                                    "choices": [
                                        {
                                            "id": "140240410",
                                            "text": "克雷薇？",
                                            "response": [
                                                {
                                                    "id": "140240412",
                                                    "speaker": "派蒙",
                                                    "text": "要是被人发现就糟糕了…我们快跟上去看看！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "140240411",
                                            "text": "她怎么跑出来了！"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "140240406",
                            "text": "放心躲在我身后就好。",
                            "response": [
                                {
                                    "id": "140240407",
                                    "speaker": "派蒙",
                                    "text": "嘿嘿，我就知道你靠得住！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "1402401",
            "objective": "跟随克雷薇",
            "dialogues": []
        },
        {
            "id": "1402405",
            "objective": "跟随克雷薇",
            "dialogues": [
                {
                    "id": "140240501",
                    "speaker": "「仆人」",
                    "text": "还想再多待一会儿？那就一起看看海吧。"
                }
            ]
        },
        {
            "id": "1402407",
            "objective": "跟随克雷薇",
            "dialogues": []
        },
        {
            "id": "1402406",
            "objective": "寻找克雷薇的身影",
            "dialogues": [
                {
                    "id": "140240601",
                    "speaker": "派蒙",
                    "text": "克雷薇！"
                },
                {
                    "id": "140240602",
                    "speaker": "克雷薇",
                    "text": "嘘…"
                },
                {
                    "id": "140240603",
                    "speaker": "克雷薇",
                    "text": "趁没有人盯着，我把窗户打开了。"
                },
                {
                    "id": "140240604",
                    "speaker": "克雷薇",
                    "text": "你们看，外面的景色很漂亮吧。",
                    "choices": [
                        {
                            "id": "140240605",
                            "text": "窗户？",
                            "response": [
                                {
                                    "id": "140240607",
                                    "speaker": "克雷薇",
                                    "text": "只可惜，这就是我能做的极限了。"
                                },
                                {
                                    "id": "140240608",
                                    "speaker": "克雷薇",
                                    "text": "在你们眼中，我所做的事情是不是很可笑呢？相较于这种看不到希望的反抗，还是生活在美好的梦里比较轻松。"
                                },
                                {
                                    "id": "140240609",
                                    "speaker": "派蒙",
                                    "text": "克雷薇，你到底知道什么呀？能和我们具体说说吗？"
                                },
                                {
                                    "id": "140240610",
                                    "speaker": "克雷薇",
                                    "text": "可以呀，虽然你们可能会后悔听到这些事情。"
                                },
                                {
                                    "id": "140240611",
                                    "speaker": "克雷薇",
                                    "text": "包括我在内，这个家里的所有人都只是「工具」与「消耗品」。"
                                },
                                {
                                    "id": "140240612",
                                    "speaker": "克雷薇",
                                    "text": "有利用价值的人暂时留着，没有价值的人，被送给「博士」做实验。我亲眼见过许多人生不如死的模样，我已经受够了。"
                                },
                                {
                                    "id": "140240613",
                                    "speaker": "派蒙",
                                    "text": "你说的这些都是「仆人」做的？"
                                },
                                {
                                    "id": "140240614",
                                    "speaker": "派蒙",
                                    "text": "我觉得不像吧。虽说她看起来很可怕，但好像也没坏到这个程度。"
                                },
                                {
                                    "id": "140240615",
                                    "speaker": "克雷薇",
                                    "text": "嗯，我知道你们不会相信我的。"
                                },
                                {
                                    "id": "140240616",
                                    "speaker": "克雷薇",
                                    "text": "每个人都觉得她是个好人，都觉得她是一位真正的「母亲」…"
                                },
                                {
                                    "id": "140240617",
                                    "speaker": "派蒙",
                                    "text": "「母亲」？"
                                },
                                {
                                    "id": "140240618",
                                    "speaker": "克雷薇",
                                    "text": "可她玷污了这个称呼。如果可以，我永远都不想再见到她。"
                                },
                                {
                                    "id": "140240619",
                                    "speaker": "克雷薇",
                                    "text": "假如佩佩在这里就好了，她一定能明白我的想法。"
                                },
                                {
                                    "id": "140240620",
                                    "speaker": "派蒙",
                                    "text": "佩佩…又是这个名字。"
                                },
                                {
                                    "id": "140240621",
                                    "speaker": "派蒙",
                                    "text": "#说起来，{NICKNAME}，你有没有一种奇怪的感觉？"
                                },
                                {
                                    "id": "140240622",
                                    "speaker": "派蒙",
                                    "text": "她和我们之间就好像隔着什么东西一样。她真的是在和我们说话吗，还是把我们错认成了别人？",
                                    "choices": [
                                        {
                                            "id": "140240623",
                                            "text": "我也想不明白。",
                                            "response": [
                                                {
                                                    "id": "140240625",
                                                    "speaker": "派蒙",
                                                    "text": "好吧，不过我感觉她好像很愿意向我们倾诉，不如我们就多陪她一会儿。"
                                                },
                                                {
                                                    "id": "140240626",
                                                    "speaker": "派蒙",
                                                    "text": "她看起来年龄很小，不过心里好像藏着许多事呢。"
                                                },
                                                {
                                                    "id": "140240627",
                                                    "speaker": "克雷薇",
                                                    "text": "起风了，该关上窗了…"
                                                },
                                                {
                                                    "id": "140240628",
                                                    "speaker": "克雷薇",
                                                    "text": "月色很漂亮吧？悄悄告诉你们哦，据说至冬夜里的极光，比今晚的月亮还要美丽。"
                                                },
                                                {
                                                    "id": "140240629",
                                                    "speaker": "Player",
                                                    "text": "真想看看。"
                                                },
                                                {
                                                    "id": "140240630",
                                                    "speaker": "克雷薇",
                                                    "text": "我跟佩佩约好了，长大后一起去看。"
                                                },
                                                {
                                                    "id": "140240631",
                                                    "speaker": "克雷薇",
                                                    "text": "可我最近找不到佩佩了。难道说她也被…不对，她是「特别」的，母亲很喜欢她。"
                                                },
                                                {
                                                    "id": "140240632",
                                                    "speaker": "克雷薇",
                                                    "text": "我得去找母亲大人谈谈。但我们刚吵了架，她不想见我，我也不敢见她。"
                                                },
                                                {
                                                    "id": "140240633",
                                                    "speaker": "克雷薇",
                                                    "text": "我到底该怎么做…"
                                                },
                                                {
                                                    "id": "140240634",
                                                    "speaker": "Black Screen",
                                                    "text": "之后，克雷薇像是陷入思考。她静静地站在那里不再说话。"
                                                },
                                                {
                                                    "id": "140240635",
                                                    "speaker": "Black Screen",
                                                    "text": "许久后，克雷薇才回过神，虚弱地笑了一下，独自走了回去。"
                                                },
                                                {
                                                    "id": "140240636",
                                                    "speaker": "派蒙",
                                                    "text": "呼…真是搞不懂她在想什么。"
                                                },
                                                {
                                                    "id": "140240637",
                                                    "speaker": "派蒙",
                                                    "text": "我们也回去吧，明天还要早起呢！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "140240624",
                                            "text": "毕竟是难以理解的「亡魂」。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "140240606",
                            "text": "这里什么也没有吧？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1402321",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "140232101",
                    "speaker": "菲米尼",
                    "text": "该从哪里开始调查比较好呢…"
                }
            ]
        },
        {
            "id": "1402322",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "140232201",
                    "speaker": "林尼",
                    "text": "克雷薇，我想带你去个地方。你愿意跟我一起来吗？"
                },
                {
                    "id": "140232202",
                    "speaker": "克雷薇",
                    "text": "可以呀。我们要去哪呢？"
                }
            ]
        },
        {
            "id": "1402499",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "140249903",
                    "speaker": "派蒙",
                    "text": "在那边！"
                },
                {
                    "id": "140249904",
                    "speaker": "派蒙",
                    "text": "她到底要去哪？唔，千万别被人看到呀…"
                },
                {
                    "id": "140249905",
                    "speaker": "派蒙",
                    "text": "咦…快看，她停下来了！"
                }
            ]
        }
    ]
}