    "talks": [
        {
            "id": "7614901",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "761490101",
                    "speaker": "？？？",
                    "text": "是谁？是谁！？"
                },
                {
                    "id": "761490102",
                    "speaker": "Player",
                    "text": "#{NICKNAME}。如今这个时代的人。"
                },
                {
                    "id": "761490103",
                    "speaker": "阿罗逻",
                    "text": "虽然我不知道你们的时代，但是我叫阿罗逻，本是寂静期行者。"
                },
                {
                    "id": "761490104",
                    "speaker": "阿罗逻",
                    "text": "来到这里已经记不得时间了。甚至这里把我的寂静之修行破掉了。"
                },
                {
                    "id": "761490105",
                    "speaker": "阿罗逻",
                    "text": "果然，无念无想的修行会让人投生无想恶天啊。"
                },
                {
                    "id": "761490106",
                    "speaker": "Player",
                    "text": "举手之劳。"
                },
                {
                    "id": "761490107",
                    "speaker": "Player",
                    "text": "千万别谢谢我。"
                },
                {
                    "id": "761490108",
                    "speaker": "阿罗逻",
                    "text": "谢谢啊！"
                },
                {
                    "id": "761490109",
                    "speaker": "伊斯托利亚",
                    "text": "虽然救你是顺手而为。不过我们准备找找冥想之外的办法离开这里。"
                },
                {
                    "id": "761490110",
                    "speaker": "阿罗逻",
                    "text": "你们不擅长冥想吗？或者你们的时代不教授这种技术？"
                },
                {
                    "id": "761490111",
                    "speaker": "伊斯托利亚",
                    "text": "我第一次离开这里花了数百年的岁月。我舍弃了我对真理的追求，舍弃了见到亲朋的渴爱。"
                },
                {
                    "id": "761490112",
                    "speaker": "伊斯托利亚",
                    "text": "这一次我不愿意再放弃这些了。"
                },
                {
                    "id": "761490113",
                    "speaker": "阿罗逻",
                    "text": "算我一个。"
                },
                {
                    "id": "761490114",
                    "speaker": "小右",
                    "text": "！"
                },
                {
                    "id": "761490115",
                    "speaker": "伊斯托利亚",
                    "text": "小右又捡到一个「念亡碎片」。"
                },
                {
                    "id": "761490116",
                    "speaker": "阿罗逻",
                    "text": "念亡？哦，死随念这种冥想技术我也知道。它能让人锻炼面对死亡之时的心境。"
                },
                {
                    "id": "761490117",
                    "speaker": "伊斯托利亚",
                    "text": "既然找到琳德了。我们就去找找出去的办法吧。"
                },
                {
                    "id": "761490118",
                    "speaker": "阿罗逻",
                    "text": "这里真的可以靠实力出去吗？"
                },
                {
                    "id": "761490119",
                    "speaker": "伊斯托利亚",
                    "text": "既然梅兰塔和尼西里塔可以自由往来，通常都还会带人出入。那小右应该也可以。"
                },
                {
                    "id": "761490120",
                    "speaker": "小右",
                    "text": "♪~"
                },
                {
                    "id": "761490121",
                    "speaker": "伊斯托利亚",
                    "text": "现在收集到了三枚「念亡碎片」。"
                },
                {
                    "id": "761490122",
                    "speaker": "伊斯托利亚",
                    "text": "哦，这个是暂定名。因为我也不知道小右收集这个要做什么。"
                },
                {
                    "id": "761490123",
                    "speaker": "伊斯托利亚",
                    "text": "小右，接下来怎么办？"
                },
                {
                    "id": "761490124",
                    "speaker": "小右",
                    "text": "！"
                },
                {
                    "id": "761490125",
                    "speaker": "伊斯托利亚",
                    "text": "跟着它指示的方向走吧。"
                }
            ]
        },
        {
            "id": "7614903",
            "objective": "(test)废弃$HIDDEN",
            "dialogues": []
