        "rewards_formatted": "冒险阅历 x200, 原石 x30, 摩拉 x35000",
        "chapter": {
            "icon": "UI_ChapterIcon_NodKrai",
            "id": "10241",
            "num": "",
            "title": "月谕的半步舞"
        },
        "total_dialogue_lines": 70,
        "total_speaker_counts": {
            "Player": 8,
            "卡夏": 39,
            "派蒙": 23
        }
    },
    "talks": [
        {
            "id": "7600902",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "760090201",
                    "speaker": "卡夏",
                    "text": "嗯…好像也不是这一块…"
                },
                {
                    "id": "760090202",
                    "speaker": "卡夏",
                    "text": "#啊，你们好呀，没见过的{M#大哥哥}{F#大姐姐}，还有…嗯，白白的精灵小姐？"
                },
                {
                    "id": "760090203",
                    "speaker": "卡夏",
                    "text": "#欢迎{M#哥哥姐姐}{F#姐姐们}来到霜月之坊！有什么需要帮助的吗？"
                },
                {
                    "id": "760090204",
                    "speaker": "派蒙",
                    "text": "#没有没有，只是看你一个人在这里，稍微有点好奇而已啦。顺带一提，我是派蒙，{M#他}{F#她}是{NICKNAME}。"
                },
                {
                    "id": "760090205",
                    "speaker": "卡夏",
                    "text": "#嗯嗯，那就是{NICKNAME}{M#哥哥}{F#姐姐}和派蒙姐姐！看样子，你们好像不是那夏镇那边的人呢。",
                    "choices": [
                        {
                            "id": "760090206",
                            "text": "我们是冒险家。",
                            "response": [
                                {
                                    "id": "760090207",
                                    "speaker": "派蒙",
                                    "text": "#是的，{NICKNAME}和我可是超厉害的冒险家！"
                                },
                                {
                                    "id": "760090211",
                                    "speaker": "卡夏",
                                    "text": "真好呀。能和好朋友一起去各种各样的地方探险，见到不同的风景…"
                                },
                                {
                                    "id": "760090212",
                                    "speaker": "派蒙",
                                    "text": "没错没错，我们已经去过好多好多地方啦。所以你刚才一个人在这边做什么呢？是在找什么东西吗？"
                                },
                                {
                                    "id": "760090213",
                                    "speaker": "卡夏",
                                    "text": "嗯，我在找漂亮的石头呢。"
                                },
                                {
                                    "id": "760090214",
                                    "speaker": "派蒙",
                                    "text": "啊，我明白了，是用来收藏的吧！不只是小孩子，有些大人也有这样的爱好呢！"
                                },
                                {
                                    "id": "760090215",
                                    "speaker": "卡夏",
                                    "text": "欸，不是喔？我是要用漂亮的石头收买小梅，让她拐走我啦。"
                                },
                                {
                                    "id": "760090216",
                                    "speaker": "派蒙",
                                    "text": "哦哦，原来如此，是为了让她拐…等等，你在说什么东西？！",
                                    "choices": [
                                        {
                                            "id": "760090217",
                                            "text": "听起来有点离谱…",
                                            "response": [
                                                {
                                                    "id": "760090220",
                                                    "speaker": "卡夏",
                                                    "text": "#欸？{NICKNAME}{M#哥哥}{F#姐姐}没听过大盗雷德·米勒与妖精公主的故事吗？小梅和我说，外面人人都听过…"
                                                },
                                                {
                                                    "id": "760090221",
                                                    "speaker": "卡夏",
                                                    "text": "「来吧，月色明瞳的小姐，就让我用这与你眼眸相称的宝钻收买下你的心，将你拐离这镀金的囚笼…」"
                                                },
                                                {
                                                    "id": "760090222",
                                                    "speaker": "卡夏",
                                                    "text": "虽然我也不太懂这个故事到底是什么意思，但只要送出别人喜欢的东西，就可以和对方一起去冒险了吧！",
                                                    "choices": [
                                                        {
                                                            "id": "760090223",
                                                            "text": "那句话应该不是这个意思…",
                                                            "response": [
                                                                {
                                                                    "id": "760090224",
                                                                    "speaker": "派蒙",
                                                                    "text": "是、是呀，那句话的意思其实是…呃啊，总之不是给小孩子看的东西啦！"
                                                                },
                                                                {
                                                                    "id": "760090227",
                                                                    "speaker": "派蒙",
                                                                    "text": "说起来，你说的这个小梅是什么人啊？会给小孩子讲这种奇怪的东西，总觉得是什么居心不良的坏家伙…"
                                                                },
                                                                {
                                                                    "id": "760090228",
                                                                    "speaker": "卡夏",
                                                                    "text": "小梅不是什么坏家伙啦，年龄也和我差不多来着。"
                                                                },
                                                                {
                                                                    "id": "760090229",
                                                                    "speaker": "卡夏",
                                                                    "text": "#和{M#哥哥姐姐}{F#姐姐们}一样，是从外面来的冒险家哦！她之前一个人在营地附近鬼鬼祟祟的，被我抓到啦。"
                                                                },
                                                                {
                                                                    "id": "760090230",
                                                                    "speaker": "卡夏",
                                                                    "text": "不知道为什么，她好像觉得我们是什么可怕的怪人团伙，会把抓到的小孩子献祭给月神大人，一边假装冷静，一边劝我别杀她…"
                                                                },
                                                                {
                                                                    "id": "760090231",
                                                                    "speaker": "派蒙",
                                                                    "text": "好、好奇怪的误解…"
                                                                },
                                                                {
                                                                    "id": "760090232",
                                                                    "speaker": "卡夏",
                                                                    "text": "对吧？我也不知道小梅是从哪里听来了这种传言，好奇怪哦。不过因为看上去很有趣，所以我也没有反驳她就是了。"
                                                                },
                                                                {
                                                                    "id": "760090233",
                                                                    "speaker": "派蒙",
                                                                    "text": "这种时候你倒是反驳一下啦！"
                                                                },
                                                                {
                                                                    "id": "760090234",
                                                                    "speaker": "卡夏",
                                                                    "text": "总之呢，作为交换，小梅答应做我最好的朋友啦，还给我讲了好多好多外面的故事。"
                                                                },
                                                                {
                                                                    "id": "760090235",
                                                                    "speaker": "卡夏",
                                                                    "text": "爸爸妈妈平时都不让我看外面的故事，说是只有无信者才会喜欢那样的糟粕…可是，小梅讲的故事就是很有趣嘛。"
                                                                },
                                                                {
                                                                    "id": "760090236",
                                                                    "speaker": "卡夏",
                                                                    "text": "比方说，爱上了精灵的渔夫呀，三度死去却又三度从冥府的女主人手中逃脱的大盗呀，渴望成为人类的换生灵呀…"
                                                                },
                                                                {
                                                                    "id": "760090237",
                                                                    "speaker": "卡夏",
                                                                    "text": "善良的人，没有那么善良的人，很坏很坏的坏人，无论富有还是贫穷，正义还是邪恶，最后大家都一样，在苦难中死掉啦。",
                                                                    "choices": [
                                                                        {
                                                                            "id": "760090238",
                                                                            "text": "我觉得你父母说得对，确实是糟粕…",
                                                                            "response": [
                                                                                {
                                                                                    "id": "760090239",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "是啊，这种故事确实不适合讲给小孩子听…"
                                                                                },
                                                                                {
                                                                                    "id": "760090243",
                                                                                    "speaker": "卡夏",
                                                                                    "text": "可是，我已经不是小孩子了呀。小梅之前也说，外面的世界太乱，不适合像我这样的小孩子…"
                                                                                },
                                                                                {
                                                                                    "id": "760090244",
                                                                                    "speaker": "卡夏",
                                                                                    "text": "明明她连月神大人{RUBY#[S]月矩力}的祝福都没法用，年龄也和我差不多。"
                                                                                },
                                                                                {
                                                                                    "id": "760090245",
                                                                                    "speaker": "卡夏",
                                                                                    "text": "不过没关系，我可是超聪明的。小梅被我抓到之前，一直在念叨「石头」什么的，说明她的目的就是收集漂亮的石头…"
                                                                                },
                                                                                {
                                                                                    "id": "760090246",
                                                                                    "speaker": "卡夏",
                                                                                    "text": "只要找到<color=#00E1FFFF>漂亮的石头</color>，她就一定会被我收买，然后像雷德·米勒拐走妖精小姐那样，把我从这里带走了吧？"
                                                                                },
                                                                                {
                                                                                    "id": "760090247",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "不要再用「收买」这种词啦！其实就是要找到漂亮的石头送给好朋友，没必要用这种奇怪的说法吧！"
                                                                                },
                                                                                {
                                                                                    "id": "760090248",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "嗯…反正我们接下来应该也会在附近转转，要是看到了什么漂亮的碎片，就拿回来给你吧。"
                                                                                },
                                                                                {
                                                                                    "id": "760090249",
                                                                                    "speaker": "卡夏",
                                                                                    "text": "#哇，真的吗？那就谢谢你们啦，好心的{M#哥哥姐姐}{F#姐姐们}！"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "760090240",
                                                                            "text": "好想听，能不能细讲一下？",
                                                                            "response": [
                                                                                {
                                                                                    "id": "760090241",
                                                                                    "speaker": "卡夏",
                                                                                    "text": "嗯？好哦。就比如说，雷德·米勒的同伴，发誓永远不会再踏入月光的「影鼬」…"
                                                                                },
                                                                                {
                                                                                    "id": "760090242",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "喂，现在不是聊这种事情的时候吧！而且这种故事也不适合讲给小孩子听吧！"
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "760090225",
                                                            "text": "没错，派蒙就是这样被我拐上了路…",
                                                            "response": [
                                                                {
                                                                    "id": "760090226",
                                                                    "speaker": "派蒙",
                                                                    "text": "#喂，不要乱教小孩子啦！虽然我最喜欢的也确实是{NICKNAME}做的料理…但、但是不能叫拐走吧！"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "760090218",
                                            "text": "在挪德卡莱倒也正常…",
                                            "response": [
                                                {
                                                    "id": "760090219",
                                                    "speaker": "派蒙",
                                                    "text": "就算在挪德卡莱也不正常吧！"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "760090208",
                            "text": "我其实是那夏镇幕后真正的操纵者…",
                            "response": [
                                {
                                    "id": "760090209",
                                    "speaker": "卡夏",
                                    "text": "#哇啊，听起来好帅气！那我也可以成为{NICKNAME}{M#哥哥}{F#姐姐}的随从吗？就像故事里一样！"
                                },
                                {
                                    "id": "760090210",
                                    "speaker": "派蒙",
                                    "text": "你在胡说什么啦，我们只是经过这里的冒险家吧！才没有什么在幕后操纵那夏镇各方势力的打算…应该没有吧？"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7600903",
            "objective": "在附近寻找「漂亮的石头」",
            "dialogues": [
                {
                    "id": "760090301",
                    "speaker": "卡夏",
                    "text": "#虽然我已经不是小孩子了，但还是够不到那么高的地方呢…{NICKNAME}{M#哥哥}{F#姐姐}，能帮我试一下吗？"
                }
            ]
        },
        {
            "id": "7600907",
            "objective": "与卡夏对话",
            "dialogues": [
                {
                    "id": "760090501",
                    "speaker": "派蒙",
                    "text": "我们回来啦！卡夏，你看这个能算漂亮的石头吗？"
                },
                {
                    "id": "760090502",
                    "speaker": "卡夏",
                    "text": "#哇，好快！{NICKNAME}{M#哥哥}{F#姐姐}不愧是专业冒险家，好厉害！"
                },
                {
                    "id": "760090503",
                    "speaker": "派蒙",
                    "text": "嘿嘿，这种小事轻而易举啦。又不是让我们在几百米深的迷宫里钻洞，或者去相隔几千米的地方分别留影之类的…"
                },
                {
                    "id": "760090504",
                    "speaker": "卡夏",
                    "text": "嗯…嗯？"
                },
                {
                    "id": "760090505",
                    "speaker": "派蒙",
                    "text": "咦，怎么了吗？"
                },
                {
                    "id": "760090506",
                    "speaker": "卡夏",
                    "text": "嗯…虽然确实是很漂亮的石头，但总觉得它好像在被这块大石头吸引呢…"
                },
                {
                    "id": "760090507",
                    "speaker": "派蒙",
                    "text": "欸？我怎么完全没有感觉到？"
                },
                {
                    "id": "760090508",
                    "speaker": "卡夏",
                    "text": "我也不是很清楚啦…只是一种模糊的预感而已。"
                },
                {
                    "id": "760090509",
                    "speaker": "卡夏",
                    "text": "就好像…小梅也说过，雷德·米勒也正是感受到了月神大人的指引，才遇到了妖精公主。我的预感一定也是同样的东西吧？"
                },
                {
                    "id": "760090510",
                    "speaker": "派蒙",
                    "text": "哦哦！这就是传说中的预知未来…不对，月神大人应该也没有那么闲吧？"
                },
                {
                    "id": "760090511",
                    "speaker": "派蒙",
                    "text": "所以…你的预感是要你做什么啊？"
                },
                {
                    "id": "760090512",
                    "speaker": "卡夏",
                    "text": "嗯…比如说，将这块石头，放回那里？"
                },
                {
                    "id": "760090513",
                    "speaker": "卡夏",
                    "text": "#虽然我已经不是小孩子了，但还是够不到那么高的地方呢…{NICKNAME}{M#哥哥}{F#姐姐}，能帮我试一下吗？"
                }
            ]
        },
        {
            "id": "7600904",
            "objective": "将碎片安放到石头上",
            "dialogues": []
        },
        {
            "id": "7600905",
            "objective": "与卡夏对话",
            "dialogues": []
        },
        {
            "id": "7600906",
            "objective": "与卡夏对话",
            "dialogues": [
                {
                    "id": "760090601",
                    "speaker": "卡夏",
                    "text": "哇啊，我的预感果然是对的！只要把两块石头放在一起，就会发生好厉害好厉害的事！"
                },
                {
                    "id": "760090602",
                    "speaker": "派蒙",
                    "text": "呃，但是这样一来，刚才找到的石头也就没了…"
                },
                {
                    "id": "760090603",
                    "speaker": "卡夏",
                    "text": "欸？没关系啦。派蒙姐姐是不是忘了，我一开始要找碎片，只是为了收买小梅…"
                },
                {
                    "id": "760090604",
                    "speaker": "卡夏",
                    "text": "既然已经有了石头突然飞走的「故事」，那石头本身就不重要啦。毕竟，小梅那么会讲故事，一定也喜欢新的故事吧！"
                },
                {
                    "id": "760090605",
                    "speaker": "卡夏",
                    "text": "#那就谢谢你们啦，{NICKNAME}{M#哥哥}{F#姐姐}，还有派蒙姐姐！虽然过程和我想得不太一样，但还是谢谢你们帮忙！"
                },
                {
                    "id": "760090606",
                    "speaker": "卡夏",
                    "text": "#对了，这是我刚才找到的石头！因为也很好看，所以就送给{NICKNAME}{M#哥哥}{F#姐姐}作为谢礼吧！"
                }
            ]
        },
        {
            "id": "7600901",
            "objective": "(test)废弃$HIDDEN",
            "dialogues": [
                {
                    "id": "760090101",
                    "speaker": "卡夏",
                    "text": "#谢谢你们，好心的{M#哥哥姐姐}{F#姐姐们}！要是附近能找到<color=#00E1FFFF>漂亮的石头</color>就好啦…"
                }
            ]
        }
    ]
}