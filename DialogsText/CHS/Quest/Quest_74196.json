    "talks": [
        {
            "id": "7419601",
            "objective": "释放灵露连通水道",
            "dialogues": []
        },
        {
            "id": "7419602",
            "objective": "(test)连通水道cs$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7419621",
            "objective": "与斯库拉对话",
            "dialogues": [
                {
                    "id": "741962101",
                    "speaker": "斯库拉",
                    "text": "何等耀眼的灵露啊，就像是数千年前一样…那么，时机已至…"
                },
                {
                    "id": "741962102",
                    "speaker": "斯库拉",
                    "text": "就如当初那家伙的旋律从这里流淌到全地之时，当金色的水道奏响之时，黄金宫殿的大门便会打开。"
                },
                {
                    "id": "741962103",
                    "speaker": "斯库拉",
                    "text": "啊，我已经听到了，那美妙的旋律。"
                },
                {
                    "id": "741962104",
                    "speaker": "斯库拉",
                    "text": "#{NICKNAME}，派蒙，我们一起共奏吧！然后你们便能进入黄金宫殿了。"
                }
            ]
        },
        {
            "id": "7419622",
            "objective": "与斯库拉共奏",
            "dialogues": [
                {
                    "id": "741962201",
                    "speaker": "派蒙",
                    "text": "是雷穆斯留给我们的乐章，终于结束了吗…"
                },
                {
                    "id": "741962202",
                    "speaker": "派蒙",
                    "text": "我们完成了「安魂曲」，被禁锢在海底的灵魂看起来也全都离开了。"
                },
                {
                    "id": "741962203",
                    "speaker": "派蒙",
                    "text": "镇上的大家应该也已经恢复正常了吧。"
                },
                {
                    "id": "741962204",
                    "speaker": "斯库拉",
                    "text": "谢谢你们，完成了这最后的乐章，这延续数千年的愿望。"
                },
                {
                    "id": "741962205",
                    "speaker": "斯库拉",
                    "text": "不论是老夫的，还是雷穆斯的，又或是所有守护现世安定之人的。"
                },
                {
                    "id": "741962206",
                    "speaker": "派蒙",
                    "text": "说到这个就想起来呜斯先生…"
                },
                {
                    "id": "741962207",
                    "speaker": "小呜斯",
                    "text": "喵呜！"
                },
                {
                    "id": "741962208",
                    "speaker": "派蒙",
                    "text": "你也很喜欢这个名字吗？不过现在不是在说你哦。"
                },
                {
                    "id": "741962209",
                    "speaker": "斯库拉",
                    "text": "他的灵魂已经回归高海…终于得享宁静了，对他来说这也是一种解脱吧。"
                },
                {
                    "id": "741962210",
                    "speaker": "派蒙",
                    "text": "那么接下来大家伙要怎么办呢？"
                },
                {
                    "id": "741962211",
                    "speaker": "斯库拉",
                    "text": "这个嘛，好不容易重获自由，老夫可得在水里好好畅游一番呢！"
                },
                {
                    "id": "741962212",
                    "speaker": "斯库拉",
                    "text": "而且现在除了小东西们，也再没人能打扰老夫了吧！"
                },
                {
                    "id": "741962213",
                    "speaker": "派蒙",
                    "text": "喂，什么叫打扰啦！"
                },
                {
                    "id": "741962214",
                    "speaker": "斯库拉",
                    "text": "哈哈，开玩笑的。不过你们也该回到属于你们的地方去了吧，我们也要就此别过了。"
                },
                {
                    "id": "741962215",
                    "speaker": "斯库拉",
                    "text": "虽然是这样说，但是你们可要多多回来看看老夫啊。毕竟大家都走了，老夫说不定会很寂寞呢！"
                },
                {
                    "id": "741962216",
                    "speaker": "派蒙",
                    "text": "嘿嘿，说到底大家伙还是很挂念我们的嘛！",
                    "choices": [
                        {
                            "id": "741962217",
                            "text": "再见了，大家伙。",
                            "response": [
                                {
                                    "id": "741962219",
                                    "speaker": "斯库拉",
                                    "text": "哼，看到你们的样子，老夫也有些期待那些地上生灵的未来了！"
                                },
                                {
                                    "id": "741962220",
                                    "speaker": "斯库拉",
                                    "text": "那么，就有缘再见了。"
                                },
                                {
                                    "id": "741962221",
                                    "speaker": "Black Screen",
                                    "text": "伴随着海浪的翻腾，斯库拉离开了…"
                                },
                                {
                                    "id": "741962222",
                                    "speaker": "派蒙",
                                    "text": "那么，接下来我们要去哪呢？"
                                },
                                {
                                    "id": "741962223",
                                    "speaker": "派蒙",
                                    "text": "哦对了，我们还没去找埃斯特先生告诉他事情已经解决了吧，明明说好去去就来的！"
                                },
                                {
                                    "id": "741962224",
                                    "speaker": "派蒙",
                                    "text": "还有「小呜斯」…唔，现在要怎么称呼它才好呢，好复杂…"
                                },
                                {
                                    "id": "741962225",
                                    "speaker": "派蒙",
                                    "text": "总之，我们还是先回镇上吧。"
                                }
                            ]
                        },
                        {
                            "id": "741962218",
                            "text": "我们还会见面的。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7419603",
            "objective": "与斯库拉共奏$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7419604",
            "objective": "进入「黄金宫殿」",
            "dialogues": [
                {
                    "id": "741960401",
                    "speaker": "派蒙",
                    "text": "呼，终于进来了，真不容易啊！"
                },
                {
                    "id": "741960402",
                    "speaker": "派蒙",
                    "text": "说是黄金的宫殿，不过看起来倒不像是宫殿，更像是某个巨大机器的内部呢！"
                },
                {
                    "id": "741960403",
                    "speaker": "Player",
                    "text": "这个地方…很熟悉。"
                },
                {
                    "id": "741960404",
                    "speaker": "派蒙",
                    "text": "嗯，是你之前在雷穆斯的记忆里见到的地方吗？"
                },
                {
                    "id": "741960405",
                    "speaker": "派蒙",
                    "text": "所以那个没礼貌的坏蛋才想在这里…要是让他得逞的话可就糟糕了！"
                },
                {
                    "id": "741960406",
                    "speaker": "派蒙",
                    "text": "而且也不知道呜斯先生现在怎么样了…"
                },
                {
                    "id": "741960407",
                    "speaker": "派蒙",
                    "text": "无论如何，我们也只能继续前进了。"
                }
            ]
        },
        {
            "id": "7419605",
            "objective": "继续前进",
            "dialogues": [
                {
                    "id": "741960501",
                    "speaker": "波爱修斯",
                    "text": "真是纠缠不休的杂碎…"
                },
                {
                    "id": "741960502",
                    "speaker": "波爱修斯",
                    "text": "修好破碎的水道，是想以此庆贺我作为旧日之神的诞生吗？"
                },
                {
                    "id": "741960503",
                    "speaker": "波爱修斯",
                    "text": "不过在我的新世界，是不需要水道，也不需要航船的…"
                },
                {
                    "id": "741960504",
                    "speaker": "波爱修斯",
                    "text": "因为所有人都会在我的「乐章」中得到永恒的幸福。"
                },
                {
                    "id": "741960505",
                    "speaker": "Player",
                    "text": "我们是来为你的乐章画上休止符的。"
                },
                {
                    "id": "741960506",
                    "speaker": "派蒙",
                    "text": "没错，你最好老实认输，释放镇上大家的灵魂…还有，快把呜斯先生交出来！"
                },
                {
                    "id": "741960507",
                    "speaker": "波爱修斯",
                    "text": "哼，卡西奥多他已经同意参与这伟大的仪式，重归雷穆利亚的怀抱了。"
                },
                {
                    "id": "741960508",
                    "speaker": "波爱修斯",
                    "text": "属于雷穆利亚的全部意志都将融为一体，所谓友谊难道不是你们的自以为是吗？"
                },
                {
                    "id": "741960509",
                    "speaker": "小呜斯",
                    "text": "……"
                },
                {
                    "id": "741960510",
                    "speaker": "派蒙",
                    "text": "呜斯先生！"
                },
                {
                    "id": "741960511",
                    "speaker": "小呜斯",
                    "text": "（相信我…）"
                }
            ]
        },
        {
            "id": "7419606",
            "objective": "打倒「波爱修斯」",
            "dialogues": []
        },
        {
            "id": "7419607",
            "objective": "(test)波爱修斯对话$HIDDEN",
            "dialogues": [
                {
                    "id": "741960701",
                    "speaker": "波爱修斯",
                    "text": "什么？！怎么会…"
                },
                {
                    "id": "741960702",
                    "speaker": "波爱修斯",
                    "text": "为什么我会无法控制这具身体…卡西奥多，是你吗！"
                },
                {
                    "id": "741960703",
                    "speaker": "卡西奥多",
                    "text": "终于抓住你了，波爱修斯！你所有的意志，「福波斯」都在这里，这次你跑不掉了。"
                },
                {
                    "id": "741960704",
                    "speaker": "波爱修斯",
                    "text": "为什么？！我是调律师，「乐章」的指挥者是我，你怎么可能…"
                },
                {
                    "id": "741960705",
                    "speaker": "卡西奥多",
                    "text": "你忘了，在至尊将我从大乐章中分离之前，我也曾是调律师！现在我回到了「乐章」之中，你不再是唯一的演奏者了。"
                },
                {
                    "id": "741960706",
                    "speaker": "波爱修斯",
                    "text": "哈，原来你答应加入我的计划，只是为了使我放下戒备。最后，你再次背叛了我，背叛了雷穆利亚！"
                },
                {
                    "id": "741960707",
                    "speaker": "波爱修斯",
                    "text": "想想那些被囚禁在深水之下的可悲的同族，想想他们遭受的数千年的折磨…"
                },
                {
                    "id": "741960708",
                    "speaker": "波爱修斯",
                    "text": "你却要为了那些低贱的地上之人，毁了我们的事业，浇灭我们唯一的希望。"
                },
                {
                    "id": "741960709",
                    "speaker": "卡西奥多",
                    "text": "背叛了雷穆利亚的是你，囚禁他们的也是你。正是你的背叛，才使我们的国家遭致灭亡的命运。"
                },
                {
                    "id": "741960710",
                    "speaker": "卡西奥多",
                    "text": "至尊…王上所赐予我们的正义，那个金色的理想，乃是希望我们能够遵从内心的旋律，掌握命运的自由。"
                },
                {
                    "id": "741960711",
                    "speaker": "卡西奥多",
                    "text": "我们不愿接受「法图纳」的审判，更不应成为你的奴仆。"
                },
                {
                    "id": "741960712",
                    "speaker": "卡西奥多",
                    "text": "「福波斯」破碎后，人们原本应当获得自由的机会。如果不是因为你当初的欺骗，他们的噩梦早就该结束了。"
                },
                {
                    "id": "741960713",
                    "speaker": "波爱修斯",
                    "text": "雷穆利亚没有灭亡！在「福波斯」的指引下，它还会再度崛起…"
                },
                {
                    "id": "741960714",
                    "speaker": "卡西奥多",
                    "text": "「无论这顽石与金属的重击如何轰鸣，没有了水和土，人类就没办法生存。」"
                },
                {
                    "id": "741960715",
                    "speaker": "卡西奥多",
                    "text": "不管拥有多么强大的力量，但倘若因此便肆意践踏生命的价值，那这种力量也就毫无意义可言。"
                },
                {
                    "id": "741960716",
                    "speaker": "卡西奥多",
                    "text": "波爱修斯，你不也是人类吗？所有的雷穆利亚人曾经都是普通的枫丹人啊。"
                },
                {
                    "id": "741960717",
                    "speaker": "卡西奥多",
                    "text": "即便我们抛弃了苦弱的肉身，拥有了不朽的躯体，但我们仍然有着凡人的灵魂，也有着凡人的感情与弱点。"
                },
                {
                    "id": "741960718",
                    "speaker": "卡西奥多",
                    "text": "而我们却忘记了这一点，忘记了自己的出身，自以为高踞于其他人之上，雷穆利亚就是因此才会灭亡的。"
                },
                {
                    "id": "741960719",
                    "speaker": "卡西奥多",
                    "text": "#{NICKNAME}，还记得我说过的话吗，就是现在了！"
                }
            ]
        },
        {
            "id": "7419608",
            "objective": "打倒「波爱修斯」",
            "dialogues": []
        },
        {
            "id": "7419609",
            "objective": "(test)卡西奥多波爱修斯对话$HIDDEN",
            "dialogues": [
                {
                    "id": "741960901",
                    "speaker": "派蒙",
                    "text": "呜啊，感觉晕乎乎的…"
                },
                {
                    "id": "741960902",
                    "speaker": "Player",
                    "text": "卡西奥多…"
                },
                {
                    "id": "741960903",
                    "speaker": "卡西奥多",
                    "text": "#{NICKNAME}，还有派蒙，没想到我们还能像这个样子见面。"
                },
                {
                    "id": "741960904",
                    "speaker": "派蒙",
                    "text": "你是…是呜斯先生！"
                },
                {
                    "id": "741960905",
                    "speaker": "派蒙",
                    "text": "哇，还有波爱修斯也在…这家伙该不会又想耍什么花招吧！"
                },
                {
                    "id": "741960906",
                    "speaker": "派蒙",
                    "text": "等等，不对！是我眼花了吗，飘在那里的是什么东西啦！"
                },
                {
                    "id": "741960907",
                    "speaker": "卡西奥多",
                    "text": "你们也看到了吗？隐藏在「波爱修斯」的幻象之后的家伙。"
                },
                {
                    "id": "741960908",
                    "speaker": "？？？",
                    "text": "哎呀，你发现我了！"
                },
                {
                    "id": "741960909",
                    "speaker": "？？？",
                    "text": "可那并不是幻象，你们所见到的确实就是「波爱修斯」，因为，我就是「波爱修斯」啊！"
                },
                {
                    "id": "741960910",
                    "speaker": "？？？",
                    "text": "当然，我并不只是「波爱修斯」，我也是「你」…"
                },
                {
                    "id": "741960911",
                    "speaker": "？？？",
                    "text": "我是一切旋律，一切乐章，一切思绪…我是一切灵魂的总和！"
                },
                {
                    "id": "741960912",
                    "speaker": "「福波斯」",
                    "text": "我就是「福波斯」。"
                },
                {
                    "id": "741960913",
                    "speaker": "「福波斯」",
                    "text": "不过不包括你们这些外面来的孩子呢，你们可不属于「我们」。"
                },
                {
                    "id": "741960914",
                    "speaker": "卡西奥多",
                    "text": "「福波斯」…统辖一切的大乐章，竟然拥有人格？"
                },
                {
                    "id": "741960915",
                    "speaker": "「福波斯」",
                    "text": "「福波斯」，或者说原来的那个「西比尔」，原本是上一次洪水吞没大地后的幸存者。"
                },
                {
                    "id": "741960916",
                    "speaker": "「福波斯」",
                    "text": "「西比尔」的愿望是为世界上所有被称为人类的存在送去幸福，但她没有人格，也没有足够的力量。"
                },
                {
                    "id": "741960917",
                    "speaker": "「福波斯」",
                    "text": "为此，她将自己的智慧交给了雷穆斯，加上雷穆斯所拥有的力量，便创造出了「乐{RUBY#[D]福波斯}章」，也就是我。"
                },
                {
                    "id": "741960918",
                    "speaker": "卡西奥多",
                    "text": "怎么会…"
                },
                {
                    "id": "741960919",
                    "speaker": "卡西奥多",
                    "text": "我们一直以来所演奏的乐章，所接受的命运，都是来自于你…"
                },
                {
                    "id": "741960920",
                    "speaker": "「福波斯」",
                    "text": "是「我」，但也是「你们」呀！因为「我」就是「你们」，是你们所有人的愿望的集合啊。"
                },
                {
                    "id": "741960921",
                    "speaker": "卡西奥多",
                    "text": "排除异己，肆意地消灭其他生命，毁灭城镇与乡村，这些难道也是我们的愿望吗？"
                },
                {
                    "id": "741960922",
                    "speaker": "「福波斯」",
                    "text": "是呀！因为「你们」这样希望，「我」才会如此回应。掠夺、仇恨、杀戮…这些也是「你们」愿望的一部分。"
                },
                {
                    "id": "741960923",
                    "speaker": "「福波斯」",
                    "text": "要为「所有人」送去幸福，难道不应该实现这些愿望吗？"
                },
                {
                    "id": "741960924",
                    "speaker": "Player",
                    "text": "不可理喻…"
                },
                {
                    "id": "741960925",
                    "speaker": "派蒙",
                    "text": "这根本就是强词夺理吧！"
                },
                {
                    "id": "741960926",
                    "speaker": "卡西奥多",
                    "text": "…不，那并不是我们真正的愿望！我们之中滋生的傲慢与仇恨扭曲了你，把你变成了可怕的怪物…"
                },
                {
                    "id": "741960927",
                    "speaker": "卡西奥多",
                    "text": "没有人会因此获得幸福，不管是我们，还是我们之外的其他生灵。"
                },
                {
                    "id": "741960928",
                    "speaker": "卡西奥多",
                    "text": "怪不得你会把我们引向毁灭的结局。就是因为察觉到了这一点，王上才会…"
                },
                {
                    "id": "741960929",
                    "speaker": "「福波斯」",
                    "text": "雷穆斯…他的确曾试图消灭我。可是为什么呢？如果没有了我，「你们」一定会再度陷入迷茫与痛苦之中…"
                },
                {
                    "id": "741960930",
                    "speaker": "「福波斯」",
                    "text": "啊啊…为了大家的幸福，我只好将他…"
                },
                {
                    "id": "741960931",
                    "speaker": "卡西奥多",
                    "text": "什么？！难道说那个时候，波爱修斯就已经…"
                },
                {
                    "id": "741960932",
                    "speaker": "卡西奥多",
                    "text": "没错，一定是这样…我们是不可能违抗至尊的命令的，除非背叛他的是「乐章」本身…波爱修斯怎么了，你到底对他做了什么？"
                },
                {
                    "id": "741960933",
                    "speaker": "「福波斯」",
                    "text": "唔，他当然已经变成「我们」了啊，用你们能理解的说法：他被我吃掉了！"
                },
                {
                    "id": "741960934",
                    "speaker": "派蒙",
                    "text": "吃掉…好可怕…"
                },
                {
                    "id": "741960935",
                    "speaker": "「福波斯」",
                    "text": "嗯？但是这也是他的愿望哦，而只有我才能实现他的愿望…他一定也因此获得幸福了吧！"
                },
                {
                    "id": "741960936",
                    "speaker": "卡西奥多",
                    "text": "所以从那之后，波爱修斯就变成你的傀儡了…所以他才会想尽办法，要让你重新降临于世。"
                },
                {
                    "id": "741960937",
                    "speaker": "「福波斯」",
                    "text": "这都是为了「你们」的…为了「所有人」的幸福啊。"
                },
                {
                    "id": "741960938",
                    "speaker": "卡西奥多",
                    "text": "哈哈…不！不！是时候该结束这一切了…"
                },
                {
                    "id": "741960939",
                    "speaker": "卡西奥多",
                    "text": "你已经被我困在了这副躯体里无法逃脱，而我会将你彻底消灭。"
                },
                {
                    "id": "741960940",
                    "speaker": "「福波斯」",
                    "text": "「你」的愿望是和「我」一同消失吗？这就是「你」的幸福吗？但是…我不能实现你的愿望。"
                },
                {
                    "id": "741960941",
                    "speaker": "卡西奥多",
                    "text": "我既已不是雷穆利亚人，也做不了枫丹人。早在我答应要帮至尊实现他的愿望之时，便已经选择了自己的命运。"
                },
                {
                    "id": "741960942",
                    "speaker": "卡西奥多",
                    "text": "所以，这就是我的愿望了，我之所以在世上徘徊了数千年，就是为了这一刻…"
                },
                {
                    "id": "741960943",
                    "speaker": "卡西奥多",
                    "text": "为了终结这千年的噩梦！"
                },
                {
                    "id": "741960944",
                    "speaker": "卡西奥多",
                    "text": "#{NICKNAME}，就是现在，把我和「福波斯」一同消灭掉吧！"
                },
                {
                    "id": "741960945",
                    "speaker": "Player",
                    "text": "但是…"
                },
                {
                    "id": "741960946",
                    "speaker": "卡西奥多",
                    "text": "#{NICKNAME}，我很开心啊！至尊曾经的计划与愿望，就在刚才我也已经知道了…"
                },
                {
                    "id": "741960947",
                    "speaker": "卡西奥多",
                    "text": "王上想要通过自己的牺牲，将所有人从乐章中，也从仇恨与隔阂中解放出来。"
                },
                {
                    "id": "741960948",
                    "speaker": "卡西奥多",
                    "text": "他直到最后一刻都想要拯救他的臣民…如今我将完成他未竟的心愿。这是我们最后的机会了，而这只有你才能做到。"
                },
                {
                    "id": "741960949",
                    "speaker": "卡西奥多",
                    "text": "也就是因此，我的朋友，王上…命运才会让你来到这里的！"
                }
            ]
        },
        {
            "id": "7419610",
            "objective": "打倒「波爱修斯」或是「卡西奥多」",
            "dialogues": []
        },
        {
            "id": "7419611",
            "objective": "(test)人马处决cs$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7419612",
            "objective": "(test)与卡西奥多道别$HIDDEN",
            "dialogues": [
                {
                    "id": "741961201",
                    "speaker": "派蒙",
                    "text": "呜斯先生…是你吗…"
                },
                {
                    "id": "741961202",
                    "speaker": "卡西奥多",
                    "text": "终于…结束了…"
                },
                {
                    "id": "741961203",
                    "speaker": "卡西奥多",
                    "text": "看来，我也很快就要消失了…",
                    "choices": [
                        {
                            "id": "741961204",
                            "text": "呜斯先生…",
                            "response": [
                                {
                                    "id": "741961206",
                                    "speaker": "卡西奥多",
                                    "text": "没关系，当行的道路我已经走完了，当尽的职责我也已尽了。从此世上再也没有卡西奥多，也再没有黄金猎人。"
                                },
                                {
                                    "id": "741961207",
                                    "speaker": "卡西奥多",
                                    "text": "现世之人，也会继续平凡且幸福地度过每一天吧…"
                                },
                                {
                                    "id": "741961208",
                                    "speaker": "派蒙",
                                    "text": "但是…但是…"
                                },
                                {
                                    "id": "741961209",
                                    "speaker": "卡西奥多",
                                    "text": "#{NICKNAME}，还有派蒙，谢谢你们陪我走到这里…"
                                },
                                {
                                    "id": "741961210",
                                    "speaker": "卡西奥多",
                                    "text": "我的旅途已经到达了终点…"
                                },
                                {
                                    "id": "741961211",
                                    "speaker": "卡西奥多",
                                    "text": "但是，你们的旅途还没有结束。"
                                },
                                {
                                    "id": "741961212",
                                    "speaker": "卡西奥多",
                                    "text": "为了我，为了王上的愿望，请演奏最后的「安魂曲」吧。让我们所有人的灵魂，重新回归现世，回归大海…"
                                },
                                {
                                    "id": "741961213",
                                    "speaker": "卡西奥多",
                                    "text": "「水若是失了透彻，又如何让它再成水呢？树若是离了土地，又要去到哪里生根呢？」"
                                },
                                {
                                    "id": "741961214",
                                    "speaker": "卡西奥多",
                                    "text": "「无论这顽石与金属的重击如何轰鸣，没有了水和土，人类就没办法生存。」"
                                },
                                {
                                    "id": "741961215",
                                    "speaker": "卡西奥多",
                                    "text": "或许在未来的某天，我们还会在水土丰饶的地方再次相遇的…"
                                }
                            ]
                        },
                        {
                            "id": "741961205",
                            "text": "卡西奥多…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7419623",
            "objective": "前往「黄金宫殿」上层",
            "dialogues": []
        },
        {
            "id": "7419613",
            "objective": "前往「黄金宫殿」上层",
            "dialogues": []
        },
        {
            "id": "7419614",
            "objective": "前往「演说台」",
            "dialogues": []
        },
        {
            "id": "7419615",
            "objective": "前往「演说台」",
            "dialogues": [
                {
                    "id": "741961501",
                    "speaker": "小呜斯",
                    "text": "呜喵？！喵！"
                },
                {
                    "id": "741961502",
                    "speaker": "派蒙",
                    "text": "哇！大家伙！你吓到小呜斯了！"
                },
                {
                    "id": "741961503",
                    "speaker": "斯库拉",
                    "text": "卡西奥多？不…熟悉的气息消失了，卡西奥多去哪儿了？难道是又回到哪具石头躯体当中了吗…",
                    "choices": [
                        {
                            "id": "741961504",
                            "text": "卡西奥多他…",
                            "response": [
                                {
                                    "id": "741961506",
                                    "speaker": "派蒙",
                                    "text": "卡西奥多…呜斯先生他，已经和波爱修斯，和「福波斯」一起消失了…"
                                },
                                {
                                    "id": "741961507",
                                    "speaker": "Black Screen",
                                    "text": "向斯库拉说明了事情的原委后，花了一段时间安抚小呜斯…"
                                },
                                {
                                    "id": "741961508",
                                    "speaker": "派蒙",
                                    "text": "就是这样，现在只有「小呜斯」…它还和我们一起…"
                                },
                                {
                                    "id": "741961509",
                                    "speaker": "小呜斯",
                                    "text": "喵喵？"
                                },
                                {
                                    "id": "741961510",
                                    "speaker": "派蒙",
                                    "text": "太好了，看来刚才只是被突然出现的大家伙吓了一跳，小呜斯说不定原本就是很胆大的猫咪呢！"
                                },
                                {
                                    "id": "741961511",
                                    "speaker": "斯库拉",
                                    "text": "不管怎么说，你们打败了那个妖鬼，而卡西奥多…至少他实现了自己的愿望。"
                                },
                                {
                                    "id": "741961512",
                                    "speaker": "斯库拉",
                                    "text": "想必他的灵魂，也已经回到了深水之中，和他的同胞们在一起了吧！"
                                },
                                {
                                    "id": "741961513",
                                    "speaker": "斯库拉",
                                    "text": "只要我们完成雷穆斯留下的最后的乐章，便能将他们的灵魂带去现世，带回高海之上…"
                                },
                                {
                                    "id": "741961514",
                                    "speaker": "斯库拉",
                                    "text": "生命如水流般循环不息，他们也会化为激流，并且迟早有一天，再度作为凡人诞生吧。"
                                },
                                {
                                    "id": "741961515",
                                    "speaker": "斯库拉",
                                    "text": "那么，我们开始吧。"
                                },
                                {
                                    "id": "741961516",
                                    "speaker": "斯库拉",
                                    "text": "奏响这最后的乐章，最后的「安魂曲」。"
                                }
                            ]
                        },
                        {
                            "id": "741961505",
                            "text": "他已经不在这里了。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7419616",
            "objective": "使用竖琴开始演奏",
            "dialogues": []
        },
        {
            "id": "7419619",
            "objective": "回到佩特莉可镇",
            "dialogues": []
        },
        {
            "id": "7419620",
            "objective": "与斯库拉对话",
            "dialogues": [
                {
                    "id": "741962091",
                    "speaker": "Black Screen",
                    "text": "一切结束之后，你们回到了最初的起点，佩特莉可镇…"
                },
                {
                    "id": "741962001",
                    "speaker": "派蒙",
                    "text": "是雷穆斯留给我们的乐章，终于结束了吗…"
                },
                {
                    "id": "741962002",
                    "speaker": "派蒙",
                    "text": "我们完成了「安魂曲」，被禁锢在海底的灵魂看起来也全都离开了。"
                },
                {
                    "id": "741962003",
                    "speaker": "派蒙",
                    "text": "镇上的大家应该也已经恢复正常了吧。"
                },
                {
                    "id": "741962004",
                    "speaker": "斯库拉",
                    "text": "谢谢你们，完成了这最后的乐章，这延续数千年的愿望。"
                },
                {
                    "id": "741962005",
                    "speaker": "斯库拉",
                    "text": "不论是老夫的，还是雷穆斯的，又或是所有守护现世安定之人的。"
                },
                {
                    "id": "741962006",
                    "speaker": "派蒙",
                    "text": "说到这个就想起来呜斯先生…"
                },
                {
                    "id": "741962007",
                    "speaker": "小呜斯",
                    "text": "喵呜！"
                },
                {
                    "id": "741962008",
                    "speaker": "派蒙",
                    "text": "你也很喜欢这个名字吗？不过现在不是在说你哦。"
                },
                {
                    "id": "741962009",
                    "speaker": "斯库拉",
                    "text": "他的灵魂已经回归高海…终于得享宁静了，对他来说这也是一种解脱吧。"
                },
                {
                    "id": "741962010",
                    "speaker": "斯库拉",
                    "text": "而老夫的族裔们，看起来也已经有了新的、真正的龙诞生了。"
                },
                {
                    "id": "741962011",
                    "speaker": "斯库拉",
                    "text": "虽然作为曾经水龙蜥的亲王，老夫也应该前去觐见…不过现在的老夫，究竟还能不能算作龙裔也很难说了。"
                },
                {
                    "id": "741962012",
                    "speaker": "斯库拉",
                    "text": "时间已经过去太久了，久到这个世界也已经与老夫无关了。"
                },
                {
                    "id": "741962013",
                    "speaker": "派蒙",
                    "text": "那么接下来大家伙要怎么办呢？"
                },
                {
                    "id": "741962014",
                    "speaker": "斯库拉",
                    "text": "这个嘛，好不容易重获自由，老夫可得在水里好好畅游一番呢！"
                },
                {
                    "id": "741962015",
                    "speaker": "斯库拉",
                    "text": "而且现在除了小东西们，也再没人能打扰老夫了吧！"
                },
                {
                    "id": "741962016",
                    "speaker": "派蒙",
                    "text": "喂，什么叫打扰啦！"
                },
                {
                    "id": "741962017",
                    "speaker": "斯库拉",
                    "text": "哈哈，开玩笑的。不过你们也该回到属于你们的地方去了吧，我们也要就此别过了。"
                },
                {
                    "id": "741962018",
                    "speaker": "斯库拉",
                    "text": "虽然是这样说，但是你们可要多多回来看看老夫啊。毕竟大家都走了，老夫说不定会很寂寞呢！"
                },
                {
                    "id": "741962019",
                    "speaker": "派蒙",
                    "text": "嘿嘿，说到底大家伙还是很挂念我们的嘛！",
                    "choices": [
                        {
                            "id": "741962020",
                            "text": "再见了，大家伙。",
                            "response": [
                                {
                                    "id": "741962022",
                                    "speaker": "斯库拉",
                                    "text": "哼，看到你们的样子，老夫也有些期待那些地上生灵的未来了！"
                                },
                                {
                                    "id": "741962023",
                                    "speaker": "斯库拉",
                                    "text": "那么，就有缘再见了。"
                                },
                                {
                                    "id": "741962024",
                                    "speaker": "Black Screen",
                                    "text": "伴随着海浪的翻腾，斯库拉离开了…"
                                },
                                {
                                    "id": "741962025",
                                    "speaker": "派蒙",
                                    "text": "那么，接下来我们要去哪呢？"
                                },
                                {
                                    "id": "741962026",
                                    "speaker": "派蒙",
                                    "text": "哦对了，我们还没去找埃斯特先生告诉他事情已经解决了吧，明明说好去去就来的！"
                                },
                                {
                                    "id": "741962027",
                                    "speaker": "派蒙",
                                    "text": "还有「小呜斯」…唔，现在要怎么称呼它才好呢，好复杂…"
                                },
                                {
                                    "id": "741962028",
                                    "speaker": "派蒙",
                                    "text": "总之，我们还是先回镇上吧。"
                                }
                            ]
                        },
                        {
                            "id": "741962021",
                            "text": "我们还会见面的。"
                        }
                    ]
                }
            ]
        },
