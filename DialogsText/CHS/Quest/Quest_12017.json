    "talks": [
        {
            "id": "1201701",
            "objective": "前往风景优美的留影地",
            "dialogues": []
        },
        {
            "id": "1201702",
            "objective": "推荐合适的留影姿势",
            "dialogues": [
                {
                    "id": "120170201",
                    "speaker": "影",
                    "text": "所以，现在我们要干什么？"
                },
                {
                    "id": "120170202",
                    "speaker": "派蒙",
                    "text": "为你留下画片，具体操作交给我们，你只需要在那边站好，摆好姿势就行。"
                },
                {
                    "id": "120170203",
                    "speaker": "派蒙",
                    "text": "简单来说，画片可以把此时此刻的你记录下来，很适合作为纪念。"
                },
                {
                    "id": "120170204",
                    "speaker": "影",
                    "text": "那摆姿势又是怎么一回事？"
                },
                {
                    "id": "120170205",
                    "speaker": "Player",
                    "text": "要记录的是画面。"
                },
                {
                    "id": "120170206",
                    "speaker": "影",
                    "text": "原来如此，也就是说，要对着你们摆出一个好看的动作，对吧？"
                },
                {
                    "id": "120170207",
                    "speaker": "影",
                    "text": "仔细想想，有点难为情啊。"
                },
                {
                    "id": "120170208",
                    "speaker": "影",
                    "text": "要怎么做才好呢？帮我出出主意吧，好看一点，但不要太夸张，我觉得我会放不开。",
                    "choices": [
                        {
                            "id": "120170209",
                            "text": "摆一个端庄的姿势吧。",
                            "response": [
                                {
                                    "id": "120170210",
                                    "speaker": "影",
                                    "text": "那…就这样吧。",
                                    "choices": [
                                        {
                                            "id": "120170215",
                                            "text": "就这样吧。",
                                            "response": [
                                                {
                                                    "id": "120170218",
                                                    "speaker": "影",
                                                    "text": "好，那就开始吧。"
                                                },
                                                {
                                                    "id": "120170219",
                                                    "speaker": "派蒙",
                                                    "text": "我们挑一个好的角度，为她记录吧。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "120170216",
                                            "text": "或许可以再试试其他的。",
                                            "response": [
                                                {
                                                    "id": "120170217",
                                                    "speaker": "影",
                                                    "text": "好吧，这里就交给你来决定。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "120170211",
                            "text": "摆一个严肃的姿势吧。",
                            "response": [
                                {
                                    "id": "120170212",
                                    "speaker": "影",
                                    "text": "不太习惯，这样可以吗？",
                                    "choices": [
                                        {
                                            "id": "120170215",
                                            "text": "就这样吧。"
                                        },
                                        {
                                            "id": "120170216",
                                            "text": "或许可以再试试其他的。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "120170213",
                            "text": "摆一个随意的姿势吧。",
                            "response": [
                                {
                                    "id": "120170214",
                                    "speaker": "影",
                                    "text": "随意的话，这样吧，挺自在的。",
                                    "choices": [
                                        {
                                            "id": "120170215",
                                            "text": "就这样吧。"
                                        },
                                        {
                                            "id": "120170216",
                                            "text": "或许可以再试试其他的。"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "1201704",
            "objective": "选择合适的位置留影",
            "dialogues": [
                {
                    "id": "120170401",
                    "speaker": "影",
                    "text": "现在在做的事就是「留影」…"
                },
                {
                    "id": "120170402",
                    "speaker": "影",
                    "text": "嗯，不错，又学到新东西了。快开始吧。"
                }
            ]
        },
        {
            "id": "1201705",
            "objective": "将画片展示给影看",
            "dialogues": [
                {
                    "id": "120170501",
                    "speaker": "派蒙",
                    "text": "拍好啦，你看，这就是刚刚为你拍出来的画片。"
                },
                {
                    "id": "120170502",
                    "speaker": "影",
                    "text": "这…好神奇。是某种法术吗？这里面的…是又复制出了一个我？"
                },
                {
                    "id": "120170503",
                    "speaker": "影",
                    "text": "可她又似乎不会动，不会说话…",
                    "choices": [
                        {
                            "id": "120170504",
                            "text": "这只是一种记录。",
                            "response": [
                                {
                                    "id": "120170506",
                                    "speaker": "影",
                                    "text": "刚刚还觉得拍得不好看，身体有点僵硬，可是现在看上去，比我想象中自然多了。"
                                },
                                {
                                    "id": "120170507",
                                    "speaker": "影",
                                    "text": "动作一模一样，后面的风景也一模一样…这是怎么做到的呢。"
                                },
                                {
                                    "id": "120170508",
                                    "speaker": "派蒙",
                                    "text": "这就是它厉害的地方啦。"
                                },
                                {
                                    "id": "120170509",
                                    "speaker": "影",
                                    "text": "等等，我还是不太能理解其中原理，多解释一下…"
                                },
                                {
                                    "id": "120170510",
                                    "speaker": "影",
                                    "text": "就是说，这个里面的，不是我？"
                                },
                                {
                                    "id": "120170511",
                                    "speaker": "影",
                                    "text": "如果不是我，那么为什么可以和我一模一样。如果是我，那么现在的我是什么？"
                                },
                                {
                                    "id": "120170512",
                                    "speaker": "派蒙",
                                    "text": "#这…超出我的解答能力了，交给你，{NICKNAME}！"
                                },
                                {
                                    "id": "120170513",
                                    "speaker": "Player",
                                    "text": "可能就像将军与你的区别吧。"
                                },
                                {
                                    "id": "120170514",
                                    "speaker": "派蒙",
                                    "text": "对哦，你觉得将军算不算是你呢？"
                                },
                                {
                                    "id": "120170515",
                                    "speaker": "影",
                                    "text": "那当然算，我从来都没有把稻妻交给别人管理的意愿。"
                                },
                                {
                                    "id": "120170516",
                                    "speaker": "派蒙",
                                    "text": "那现在的你是什么呢？"
                                },
                                {
                                    "id": "120170517",
                                    "speaker": "影",
                                    "text": "这么说的话，我也是我，这是无需置疑的。"
                                },
                                {
                                    "id": "120170518",
                                    "speaker": "Player",
                                    "text": "「你」的存在不一定是单一的。"
                                },
                                {
                                    "id": "120170519",
                                    "speaker": "影",
                                    "text": "「我」的存在…"
                                },
                                {
                                    "id": "120170520",
                                    "speaker": "影",
                                    "text": "我好像明白了。"
                                },
                                {
                                    "id": "120170521",
                                    "speaker": "影",
                                    "text": "我就是我，仅有一个，但可能有无数种存在的形式。我以什么形式存在，其实并不重要。"
                                },
                                {
                                    "id": "120170522",
                                    "speaker": "影",
                                    "text": "比如将军，就是我的某一种存在形式，她究竟是不是我，这个问题绝不会被她身上的某个零件决定。"
                                },
                                {
                                    "id": "120170523",
                                    "speaker": "派蒙",
                                    "text": "这么说的话，这个画片也是你的一种存在形式啦。"
                                },
                                {
                                    "id": "120170524",
                                    "speaker": "影",
                                    "text": "嗯，就连追求「永恒」的我，存在形式都在不断变化…"
                                },
                                {
                                    "id": "120170525",
                                    "speaker": "影",
                                    "text": "那我怎么能要求稻妻，还有生活在稻妻的每个人，都保持不变呢？",
                                    "choices": [
                                        {
                                            "id": "120170526",
                                            "text": "稻妻的本质没那么容易改变。",
                                            "response": [
                                                {
                                                    "id": "120170528",
                                                    "speaker": "影",
                                                    "text": "和你们这一路走下来，见识到的全是我认知之外的内容。"
                                                },
                                                {
                                                    "id": "120170529",
                                                    "speaker": "影",
                                                    "text": "唉，让你们见识到我笨拙的一面了。你们可能感受不到，这些东西的确冲击了我的认知。"
                                                },
                                                {
                                                    "id": "120170530",
                                                    "speaker": "影",
                                                    "text": "如果用这些东西来定义，那如今的稻妻已经与我的印象大相径庭了。"
                                                },
                                                {
                                                    "id": "120170531",
                                                    "speaker": "影",
                                                    "text": "但是，绝不能因此就说，现在的稻妻已经不是稻妻了吧。"
                                                },
                                                {
                                                    "id": "120170532",
                                                    "speaker": "Player",
                                                    "text": "没错。"
                                                },
                                                {
                                                    "id": "120170533",
                                                    "speaker": "影",
                                                    "text": "眼狩令，千手百眼神像，这些都是为了催生「永恒」，但如果我离「永恒」真的越来越近的话，一切的故事都不会发生。"
                                                },
                                                {
                                                    "id": "120170534",
                                                    "speaker": "影",
                                                    "text": "哈啊…"
                                                },
                                                {
                                                    "id": "120170535",
                                                    "speaker": "影",
                                                    "text": "我是否…将一切都抓得太紧了呢。"
                                                },
                                                {
                                                    "id": "120170536",
                                                    "speaker": "派蒙",
                                                    "text": "看来影是想通了呢！"
                                                },
                                                {
                                                    "id": "120170537",
                                                    "speaker": "派蒙",
                                                    "text": "那我觉得，我们这一段导游做得非常有价值！"
                                                },
                                                {
                                                    "id": "120170538",
                                                    "speaker": "一平",
                                                    "text": "二少爷，二少爷！"
                                                },
                                                {
                                                    "id": "120170539",
                                                    "speaker": "派蒙",
                                                    "text": "咦，为什么下面那么吵？"
                                                },
                                                {
                                                    "id": "120170540",
                                                    "speaker": "派蒙",
                                                    "text": "好像是一平，他怎么了？"
                                                },
                                                {
                                                    "id": "120170541",
                                                    "speaker": "影",
                                                    "text": "那是天领奉行的人吗？"
                                                },
                                                {
                                                    "id": "120170542",
                                                    "speaker": "派蒙",
                                                    "text": "对，我们去问问看发生了什么吧。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "120170527",
                                            "text": "人类的本质没那么容易改变。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "120170505",
                            "text": "这并不是真正的你。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1201706",
            "objective": "顺着声音去一探究竟",
            "dialogues": []
        },
        {
            "id": "1201707",
            "objective": "与急匆匆的一平交谈",
            "dialogues": [
                {
                    "id": "120170701",
                    "speaker": "派蒙",
                    "text": "一平，发生什么事了吗？"
                },
                {
                    "id": "120170702",
                    "speaker": "一平",
                    "text": "啊，是你们，我…"
                },
                {
                    "id": "120170703",
                    "speaker": "一平",
                    "text": "欸？将、将军大人？！"
                },
                {
                    "id": "120170704",
                    "speaker": "一平",
                    "text": "您是要见九条镰治少爷吗？抱歉，他现在还没有回来。如果方便的话，可以由小人代为传达吗？"
                },
                {
                    "id": "120170705",
                    "speaker": "影",
                    "text": "不必多礼，并不是专程来访，只是听到了你呼喊的声音。"
                },
                {
                    "id": "120170706",
                    "speaker": "Player",
                    "text": "你在找你家的二少爷吗？"
                },
                {
                    "id": "120170707",
                    "speaker": "一平",
                    "text": "是的，不瞒你说，二少爷他去谈判迟迟没有回来，我很担心。"
                },
                {
                    "id": "120170708",
                    "speaker": "一平",
                    "text": "他平时有在外面闲逛不回来的习惯，可能只是在什么地方入迷了。"
                },
                {
                    "id": "120170709",
                    "speaker": "一平",
                    "text": "但不知道为什么，今天我特别不安。"
                },
                {
                    "id": "120170710",
                    "speaker": "影",
                    "text": "九条镰治，听起来像是九条家的后人。"
                },
                {
                    "id": "120170711",
                    "speaker": "一平",
                    "text": "是的，实在抱歉。由于家主身体抱恙，大少爷常年在外，现在九条家是由九条镰治少爷作为九条家的名代。"
                },
                {
                    "id": "120170712",
                    "speaker": "影",
                    "text": "天领奉行陷入混乱，这我也略有耳闻。这件事和九条镰治有关吗？"
                },
                {
                    "id": "120170713",
                    "speaker": "一平",
                    "text": "抱歉，将军大人，这也是九条家的失职。"
                },
                {
                    "id": "120170714",
                    "speaker": "一平",
                    "text": "由于九条家名誉大损、势力衰微，将军您…呃，天领奉行后续的安排，将军您又并未给出决策…"
                },
                {
                    "id": "120170715",
                    "speaker": "一平",
                    "text": "所以二少爷才前去商量，是否能请到「鹰司家」主持大局…"
                },
                {
                    "id": "120170716",
                    "speaker": "派蒙",
                    "text": "那应该是在奉行所谈吧，为什么要到这里来找呢？"
                },
                {
                    "id": "120170717",
                    "speaker": "一平",
                    "text": "啊，不是的，这次会面的地点比较特殊。其实我也有点疑惑，但大人物的事，我也不敢多问。"
                },
                {
                    "id": "120170718",
                    "speaker": "一平",
                    "text": "地点在鸣神大社附近的山上，那里好像有「鹰司家」的特殊营地。"
                },
                {
                    "id": "120170719",
                    "speaker": "影",
                    "text": "「鹰司」…也是熟悉的名字，这么多年，他们应该都在忠心辅佐九条吧。"
                },
                {
                    "id": "120170720",
                    "speaker": "一平",
                    "text": "是的是的，就是因为这样，二少爷才会去谈判。可无论有多少事需要谈，这花费的时间也太多了。"
                },
                {
                    "id": "120170721",
                    "speaker": "一平",
                    "text": "城里我都找了个遍，如果他还没回来的话…",
                    "choices": [
                        {
                            "id": "120170722",
                            "text": "还没有结束吧。",
                            "response": [
                                {
                                    "id": "120170724",
                                    "speaker": "一平",
                                    "text": "是啊，我也想到了这种可能…但以我的身份，可不能冒冒失失地独闯「鹰司家」。"
                                },
                                {
                                    "id": "120170725",
                                    "speaker": "Player",
                                    "text": "我们去帮你看看吧。"
                                },
                                {
                                    "id": "120170726",
                                    "speaker": "一平",
                                    "text": "不用不用，应该只是我多心了。要是打扰了谈判，我反而没法交代。"
                                },
                                {
                                    "id": "120170727",
                                    "speaker": "一平",
                                    "text": "虽然我只是二少爷的小跟班，但其实我从小就跟他一起长大，我只是…很怕他出事而已。"
                                },
                                {
                                    "id": "120170728",
                                    "speaker": "一平",
                                    "text": "我不如二少爷聪明伶俐，也没办法帮二少爷分担太多压力，但我不想因为我的失职而让二少爷遭遇危险。"
                                },
                                {
                                    "id": "120170729",
                                    "speaker": "派蒙",
                                    "text": "唔，将军大人怎么看？"
                                },
                                {
                                    "id": "120170730",
                                    "speaker": "影",
                                    "text": "我们亲自走一趟吧。"
                                },
                                {
                                    "id": "120170731",
                                    "speaker": "影",
                                    "text": "以我的身份，就算妨碍了谈判，应该也不会影响到你。"
                                },
                                {
                                    "id": "120170732",
                                    "speaker": "影",
                                    "text": "而且，本就是我未能及时决策的缘故，应该由我来出面解决。",
                                    "choices": [
                                        {
                                            "id": "120170733",
                                            "text": "很有担当。",
                                            "response": [
                                                {
                                                    "id": "120170735",
                                                    "speaker": "一平",
                                                    "text": "感激不尽，感谢将军大人能出手相助！我也会再去其他地方找找看！"
                                                },
                                                {
                                                    "id": "120170736",
                                                    "speaker": "一平",
                                                    "text": "那我现在就把那个营地的位置为你们标记出来，希望一路顺利！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "120170734",
                                            "text": "很帅气。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "120170723",
                            "text": "可能遇到突发情况了。"
                        }
                    ]
                }
            ]
        }
    ]
}