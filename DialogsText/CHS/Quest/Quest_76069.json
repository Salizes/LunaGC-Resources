    "talks": [
        {
            "id": "7606901",
            "objective": "接受挑战$HIDDEN",
            "dialogues": [
                {
                    "id": "760690101",
                    "speaker": "罗兰",
                    "text": "…不可惊扰…他们的安眠…",
                    "choices": [
                        {
                            "id": "760690104",
                            "text": "直面强敌",
                            "response": [
                                {
                                    "id": "760690102",
                                    "speaker": "法尔伽",
                                    "text": "这是北风王狼的力量？好像还混了些「西风」的气味…"
                                },
                                {
                                    "id": "760690103",
                                    "speaker": "法尔伽",
                                    "text": "这可不能视而不见啊，不管是什么来路…都让我来领教一下吧！"
                                }
                            ]
                        },
                        {
                            "id": "760690105",
                            "text": "暂时离开"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7606902",
            "objective": "接受挑战",
            "dialogues": []
        },
        {
            "id": "7606903",
            "objective": "击败玻瑞亚斯之影",
            "dialogues": []
        },
        {
            "id": "7606905",
            "objective": "接受挑战",
            "dialogues": []
        },
        {
            "id": "7606904",
            "objective": "探寻骑士们的追忆",
            "dialogues": [
                {
                    "id": "760690401",
                    "speaker": "法尔伽",
                    "text": "这种感觉…看来是我没发现的「狼灵」碎片，显化成的化身啊。"
                },
                {
                    "id": "760690402",
                    "speaker": "法尔伽",
                    "text": "那是谁把你留在了这里？又是为了守护什么？现在…就告诉我答案吧。"
                },
                {
                    "id": "760690403",
                    "speaker": "法尔伽",
                    "text": "……"
                },
                {
                    "id": "760690404",
                    "speaker": "罗兰",
                    "text": "…我重复过许多次了，染血的道路，有我一人足矣，不需要他人的追随。"
                },
                {
                    "id": "760690405",
                    "speaker": "无名的骑士们",
                    "text": "哈，那就当我们只是刚好同路吧？刚好从蒙德同路到挪德卡莱。"
                },
                {
                    "id": "760690406",
                    "speaker": "无名的骑士们",
                    "text": "又刚好被某位骑士救过无数次、刚好对那位骑士心怀憧憬…所以忍不住，也踏上了相近的道路。"
                },
                {
                    "id": "760690407",
                    "speaker": "无名的骑士们",
                    "text": "就算不能理解，至少也想在近旁见证…哪怕这一路下来，就只剩下我们几个了。"
                },
                {
                    "id": "760690408",
                    "speaker": "狼",
                    "text": "嗷呜——"
                },
                {
                    "id": "760690409",
                    "speaker": "罗兰",
                    "text": "如果这就是你们认定的骑士道…我无权否认。"
                },
                {
                    "id": "760690410",
                    "speaker": "Black Screen",
                    "text": "……"
                },
                {
                    "id": "760690411",
                    "speaker": "无名的骑士们",
                    "text": "那些该死的魔物…都被消灭了吗？附近的居民…都没事了吧？"
                },
                {
                    "id": "760690412",
                    "speaker": "无名的骑士们",
                    "text": "咳…太好了…只可惜，我们没那个力气见证您走到最后…真不甘心啊！"
                },
                {
                    "id": "760690413",
                    "speaker": "无名的骑士们",
                    "text": "从今往后，就只有您一个人了…"
                },
                {
                    "id": "760690414",
                    "speaker": "罗兰",
                    "text": "…到最后，我的剑还是没能守护一切。"
                },
                {
                    "id": "760690415",
                    "speaker": "罗兰",
                    "text": "…到最后，这条路上终究只剩下一人…或许从一开始，就本该如此。"
                },
                {
                    "id": "760690416",
                    "speaker": "罗兰",
                    "text": "至少让这些剑，与此地的狼灵为你们守墓吧——为了不让漆黑的孽物，惊扰你们的安眠。"
                },
                {
                    "id": "760690417",
                    "speaker": "法尔伽",
                    "text": "……"
                },
                {
                    "id": "760690418",
                    "speaker": "法尔伽",
                    "text": "原来是这样…骑士团里有过记载，「染血骑士」出走时，曾有骑士自发追随，却没有了后文。"
                },
                {
                    "id": "760690419",
                    "speaker": "法尔伽",
                    "text": "没想到最后的结局，是为征讨魔物而埋骨在这里…不愧是西风骑士团的骑士。"
                },
                {
                    "id": "760690420",
                    "speaker": "法尔伽",
                    "text": "但你们的「愿望」，真的止步于此了吗？"
                },
                {
                    "id": "760690421",
                    "speaker": "法尔伽",
                    "text": "至今未熄的战火、寄宿于剑的思念…请告诉我，「骑士」们的决意。"
                },
                {
                    "id": "760690422",
                    "speaker": "罗兰",
                    "text": "我将用玻瑞亚斯遗落于此的力量封锁这片战场…那头小狼也会在外为你们守灵。"
                },
                {
                    "id": "760690423",
                    "speaker": "罗兰",
                    "text": "你们理应得到这样的「守护」——永远不被惊扰，永远得享安宁，永远…不必再见这世间的不公。"
                },
                {
                    "id": "760690424",
                    "speaker": "罗兰",
                    "text": "永别了——我最后的「战友」。"
                },
                {
                    "id": "760690425",
                    "speaker": "无名的骑士们",
                    "text": "…不…"
                },
                {
                    "id": "760690426",
                    "speaker": "无名的骑士们",
                    "text": "…不要…"
                },
                {
                    "id": "760690427",
                    "speaker": "无名的骑士们",
                    "text": "…让我们…"
                },
                {
                    "id": "760690428",
                    "speaker": "无名的骑士们",
                    "text": "…再一次…"
                },
                {
                    "id": "760690429",
                    "speaker": "法尔伽",
                    "text": "果然——你们的「愿望」…不是在这种不见天日的地方默默朽去吧？"
                },
                {
                    "id": "760690430",
                    "speaker": "法尔伽",
                    "text": "那就来吧！跟我一起，再一次——"
                },
                {
                    "id": "760690431",
                    "speaker": "法尔伽",
                    "text": "——奔赴战场！"
                }
            ]
        }
    ]
}