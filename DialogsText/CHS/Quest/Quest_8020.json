    "talks": [
        {
            "id": "802008",
            "objective": "回到维摩庄",
            "dialogues": [
                {
                    "id": "80200101",
                    "speaker": "派蒙",
                    "text": "等等，那个身影是…戴因斯雷布！"
                },
                {
                    "id": "80200102",
                    "speaker": "戴因斯雷布",
                    "text": "哦？是你们…"
                },
                {
                    "id": "80200103",
                    "speaker": "阿托莎",
                    "text": "是你们的朋友吗？"
                },
                {
                    "id": "80200104",
                    "speaker": "阿托莎",
                    "text": "那我先到村子里面确认一下村长爷爷他们的情况，回头见吧。"
                },
                {
                    "id": "80200105",
                    "speaker": "派蒙",
                    "text": "回头见，阿托莎。"
                },
                {
                    "id": "80200106",
                    "speaker": "派蒙",
                    "text": "你这神出鬼没的家伙，每次都要像这样突然出现吓我们一跳才行嘛？"
                },
                {
                    "id": "80200107",
                    "speaker": "戴因斯雷布",
                    "text": "只要你们也在追迹「深渊」，那我们的路线总会交汇，与我个人的意志无关。"
                },
                {
                    "id": "80200108",
                    "speaker": "派蒙",
                    "text": "那这么说，你是追着深渊教团来到这里的吗？而且看你刚刚还解决掉了一批深渊魔物…"
                },
                {
                    "id": "80200109",
                    "speaker": "戴因斯雷布",
                    "text": "当然。嗯？莫非你们不是？",
                    "choices": [
                        {
                            "id": "80200110",
                            "text": "我也是察觉到了深渊教团的动向…",
                            "response": [
                                {
                                    "id": "80200112",
                                    "speaker": "戴因斯雷布",
                                    "text": "不管怎样，就算再怎么迟钝，现在你也应该发现这个地方有蹊跷了吧。"
                                },
                                {
                                    "id": "80200113",
                                    "speaker": "戴因斯雷布",
                                    "text": "深渊教团一定是在这附近筹备着些什么，或者更进一步…正在进行着什么计划。"
                                },
                                {
                                    "id": "80200114",
                                    "speaker": "派蒙",
                                    "text": "所以你觉得，附近丘丘人的躁动是深渊教团干的吗？"
                                },
                                {
                                    "id": "80200115",
                                    "speaker": "戴因斯雷布",
                                    "text": "事到如今，引发丘丘人骚动这种小事想必肯定不是他们的目的，最多应该是某些计划的「副产物」罢了。"
                                },
                                {
                                    "id": "80200116",
                                    "speaker": "派蒙",
                                    "text": "不过，这件事对维摩庄的影响还是存在的，我们最好先留下来保护这里一阵子比较好吧？"
                                },
                                {
                                    "id": "80200117",
                                    "speaker": "戴因斯雷布",
                                    "text": "保护之余，更重要的是弄清楚深渊教团准备在这里搞什么名堂，这才是防止进一步悲剧的关键。",
                                    "choices": [
                                        {
                                            "id": "80200118",
                                            "text": "针对这些情况，再问问村民们吧。",
                                            "response": [
                                                {
                                                    "id": "80200120",
                                                    "speaker": "戴因斯雷布",
                                                    "text": "我本来也没有回避问题的意思。"
                                                },
                                                {
                                                    "id": "80200121",
                                                    "speaker": "戴因斯雷布",
                                                    "text": "放心…这次我们时间还充裕，可以好好聊聊。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "80200119",
                                            "text": "除此之外…你也欠我很多「答案」。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "80200111",
                            "text": "我摊牌了，是刚才碰巧撞上的。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "802009",
            "objective": "与戴因斯雷布对话",
            "dialogues": [
                {
                    "id": "80200122",
                    "speaker": "Black Screen",
                    "text": "你们针对现状，再次向维摩庄的村民们收集了线索，直到天色暗了下来…"
                },
                {
                    "id": "80200123",
                    "speaker": "戴因斯雷布",
                    "text": "原来你们是接到了那样的委托，才来到这里的么…"
                },
                {
                    "id": "80200124",
                    "speaker": "戴因斯雷布",
                    "text": "「似乎只存在于记忆中的人」…的确令人在意，我也并不认为这会是一起普通的失踪案，但还不能确定与深渊教团的联系。"
                },
                {
                    "id": "80200125",
                    "speaker": "戴因斯雷布",
                    "text": "除此之外，就只有丘丘人的躁动这种浮于表面的线索了，还是没什么收获。",
                    "choices": [
                        {
                            "id": "80200126",
                            "text": "好了，那么现在…",
                            "response": [
                                {
                                    "id": "80200128",
                                    "speaker": "派蒙",
                                    "text": "#就是{NICKNAME}血亲的记忆里，那个神秘的声音，好像是什么…「罪人」，他到底是谁？"
                                },
                                {
                                    "id": "80200129",
                                    "speaker": "戴因斯雷布",
                                    "text": "……"
                                },
                                {
                                    "id": "80200130",
                                    "speaker": "戴因斯雷布",
                                    "text": "#{NICKNAME}，你会认为…你的血亲「背叛」了你么？",
                                    "choices": [
                                        {
                                            "id": "80200131",
                                            "text": "#我想要相信{M#她}{F#他}。",
                                            "response": [
                                                {
                                                    "id": "80200133",
                                                    "speaker": "戴因斯雷布",
                                                    "text": "是么…在彻底弄清真相之前，我看出了你的犹豫。"
                                                },
                                                {
                                                    "id": "80200134",
                                                    "speaker": "戴因斯雷布",
                                                    "text": "在任何不可挽回的事情出现之前，你们的关系完全还有回旋的余地。"
                                                },
                                                {
                                                    "id": "80200135",
                                                    "speaker": "戴因斯雷布",
                                                    "text": "不像你们想要了解的那个「罪人」，他和其他「罪人」一起，早已背叛了国家，也背叛了我…"
                                                },
                                                {
                                                    "id": "80200136",
                                                    "speaker": "戴因斯雷布",
                                                    "text": "他的名字…是「预言家」维瑟弗尼尔。"
                                                },
                                                {
                                                    "id": "80200137",
                                                    "speaker": "戴因斯雷布",
                                                    "text": "虽不愿提起，但他确实也是我的血亲，我的「哥哥」。"
                                                },
                                                {
                                                    "id": "80200138",
                                                    "speaker": "派蒙",
                                                    "text": "那个人是…戴因的哥哥？",
                                                    "choices": [
                                                        {
                                                            "id": "80200139",
                                                            "text": "你们之间究竟发生了什么？",
                                                            "response": [
                                                                {
                                                                    "id": "80200141",
                                                                    "speaker": "戴因斯雷布",
                                                                    "text": "「罪人」共有五人…也即是坎瑞亚的「五大罪人」。"
                                                                },
                                                                {
                                                                    "id": "80200142",
                                                                    "speaker": "戴因斯雷布",
                                                                    "text": "「贤者」海洛塔帝，「预言家」维瑟弗尼尔，「黄金」莱茵多特，「极恶骑」苏尔特洛奇，以及「猎月人」雷利尔。"
                                                                },
                                                                {
                                                                    "id": "80200143",
                                                                    "speaker": "戴因斯雷布",
                                                                    "text": "无论我的记忆如何磨损，这些名字都不会忘却，终有一天…我会向他们所有人复仇。"
                                                                },
                                                                {
                                                                    "id": "80200144",
                                                                    "speaker": "派蒙",
                                                                    "text": "这些名字！很多都很熟悉…创造阿贝多的莱茵多特，丝柯克的师父苏尔特洛奇…"
                                                                },
                                                                {
                                                                    "id": "80200145",
                                                                    "speaker": "派蒙",
                                                                    "text": "还有我们刚刚知道的，引导克洛达尔创立深渊教团的，戴因的哥哥…「预言家」维瑟弗尼尔…"
                                                                },
                                                                {
                                                                    "id": "80200146",
                                                                    "speaker": "Player",
                                                                    "text": "一切在冥冥之中连接在了一起…"
                                                                },
                                                                {
                                                                    "id": "80200147",
                                                                    "speaker": "Player",
                                                                    "text": "（这么说的话，在枫丹遗迹内发现的预言石板，大概率也是出自维瑟弗尼尔之手吧？）"
                                                                },
                                                                {
                                                                    "id": "80200148",
                                                                    "speaker": "戴因斯雷布",
                                                                    "text": "他们都曾是在坎瑞亚被寄予厚望的人，是各个领域同辈中的翘楚…"
                                                                },
                                                                {
                                                                    "id": "80200149",
                                                                    "speaker": "戴因斯雷布",
                                                                    "text": "计划本应是由包含我在内的六人一同前往阻止灾厄的发生，阻拦黑王继续动摇世界的根基。"
                                                                },
                                                                {
                                                                    "id": "80200150",
                                                                    "speaker": "戴因斯雷布",
                                                                    "text": "然而心底埋藏着各自欲望的那五人，没能禁得住「深渊」的诱惑，瓜分了那些足以毁灭世界的力量。"
                                                                },
                                                                {
                                                                    "id": "80200151",
                                                                    "speaker": "戴因斯雷布",
                                                                    "text": "他们成为了「罪人」，也成为了超然的存在，每个人所掌持的力量都能与世界相匹敌。"
                                                                },
                                                                {
                                                                    "id": "80200152",
                                                                    "speaker": "戴因斯雷布",
                                                                    "text": "而后坎瑞亚灾变发生，他们却没有任何一个人站出来阻止这场悲剧…我无法原谅。",
                                                                    "choices": [
                                                                        {
                                                                            "id": "80200153",
                                                                            "text": "然后就是…",
                                                                            "response": [
                                                                                {
                                                                                    "id": "80200155",
                                                                                    "speaker": "戴因斯雷布",
                                                                                    "text": "…没错。如果继续放任，我相信他们终有一天，也会将整个世界「背叛」。",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "80200156",
                                                                                            "text": "提起这些想必很不好受吧。",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "80200158",
                                                                                                    "speaker": "戴因斯雷布",
                                                                                                    "text": "没什么，我说过的，我不准备回避你的问题。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "80200159",
                                                                                                    "speaker": "派蒙",
                                                                                                    "text": "那么戴因，之前那段时间，你有调查到什么吗？"
                                                                                                },
                                                                                                {
                                                                                                    "id": "80200160",
                                                                                                    "speaker": "戴因斯雷布",
                                                                                                    "text": "我继续在追查关于「命运的织机」的问题，自那份「命运的织机原动计划」启动，已经过去很多时日了。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "80200161",
                                                                                                    "speaker": "戴因斯雷布",
                                                                                                    "text": "尽管我们曾经通过夺取「世界上第一颗耕地机的眼睛」，阻止了他们计划的某个阶段…"
                                                                                                },
                                                                                                {
                                                                                                    "id": "80200162",
                                                                                                    "speaker": "派蒙",
                                                                                                    "text": "我记得，是说要改造魔神奥赛尔什么的？"
                                                                                                },
                                                                                                {
                                                                                                    "id": "80200163",
                                                                                                    "speaker": "戴因斯雷布",
                                                                                                    "text": "嗯，不过…很明显，那应该也只是某种技术性试验…"
                                                                                                },
                                                                                                {
                                                                                                    "id": "80200164",
                                                                                                    "speaker": "戴因斯雷布",
                                                                                                    "text": "即便他们还尚未得到那颗不可或缺的「耕地机的眼睛」，但他们选择跳过了试验阶段，依然在以某种方式推进着计划的执行。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "80200165",
                                                                                                    "speaker": "戴因斯雷布",
                                                                                                    "text": "有很多迹象都能表明这一点…"
                                                                                                },
                                                                                                {
                                                                                                    "id": "80200166",
                                                                                                    "speaker": "派蒙",
                                                                                                    "text": "那怎么办？还来得及吗？"
                                                                                                },
                                                                                                {
                                                                                                    "id": "80200167",
                                                                                                    "speaker": "戴因斯雷布",
                                                                                                    "text": "当务之急…是要弄清楚命运的织机究竟是用来做什么的，以便由此反推深渊教团的目的。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "80200168",
                                                                                                    "speaker": "戴因斯雷布",
                                                                                                    "text": "根据我目前所掌握的线索，我猜测命运的织机…应该和「地脉」有关。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "80200169",
                                                                                                    "speaker": "派蒙",
                                                                                                    "text": "地脉？"
                                                                                                },
                                                                                                {
                                                                                                    "id": "80200170",
                                                                                                    "speaker": "戴因斯雷布",
                                                                                                    "text": "#上次{NICKNAME}能够看到血亲的记忆，其原因便是那一带的地脉不稳定。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "80200171",
                                                                                                    "speaker": "戴因斯雷布",
                                                                                                    "text": "而最近，我在追查深渊教团的期间发现，只要是他们活跃的地带，都会伴随着一系列的地脉问题。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "80200172",
                                                                                                    "speaker": "Player",
                                                                                                    "text": "提瓦特的地脉中流淌着「记忆」…"
                                                                                                },
                                                                                                {
                                                                                                    "id": "80200173",
                                                                                                    "speaker": "派蒙",
                                                                                                    "text": "欸，那按照戴因的说法，这次我们来维摩庄要找的那个「似乎只存在于记忆中的人」，或许也可以关联上了？"
                                                                                                },
                                                                                                {
                                                                                                    "id": "80200174",
                                                                                                    "speaker": "Player",
                                                                                                    "text": "（记忆…地脉…命运的织机…只存在于记忆中的人…）"
                                                                                                },
                                                                                                {
                                                                                                    "id": "80200175",
                                                                                                    "speaker": "Player",
                                                                                                    "text": "（连接这一切的究竟会是什么…？）"
                                                                                                },
                                                                                                {
                                                                                                    "id": "80200176",
                                                                                                    "speaker": "戴因斯雷布",
                                                                                                    "text": "你们说的这些不无可能。明天我也会加入你们的调查，这次的事件的确可能会成为某种契机。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "80200177",
                                                                                                    "speaker": "派蒙",
                                                                                                    "text": "又要和戴因一起行动了吗，那我们赶快养精蓄锐，明天去稍远一点的地方再看看吧。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "80200401",
                                                                                                    "speaker": "派蒙",
                                                                                                    "text": "哈欠——昨天有点用脑过度，现在还是困困的…都怪戴因说了那么多难懂的话…",
                                                                                                    "choices": [
                                                                                                        {
                                                                                                            "id": "80200402",
                                                                                                            "text": "我也有点失眠了…",
                                                                                                            "response": [
                                                                                                                {
                                                                                                                    "id": "80200404",
                                                                                                                    "speaker": "派蒙",
                                                                                                                    "text": "我们去找戴因吧，今天还有很多事情要做呢。"
                                                                                                                }
                                                                                                            ]
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "80200403",
                                                                                                            "text": "脑子里感觉乱乱的。"
                                                                                                        }
                                                                                                    ]
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "80200157",
                                                                                            "text": "谢谢你能把这些都告诉我。"
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "80200154",
                                                                            "text": "我的血亲，接触了你的哥哥。"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "80200140",
                                                            "text": "当时的坎瑞亚究竟发生了什么？"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "80200132",
                                            "text": "大概已经算是一种背叛了吧。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "80200127",
                            "text": "当初答应我的情报呢？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "802002",
            "objective": "与戴因斯雷布对话",
            "dialogues": [
                {
                    "id": "80200201",
                    "speaker": "派蒙",
                    "text": "欸，戴因？喂…戴因！你在这里发什么呆呀？"
                },
                {
                    "id": "80200202",
                    "speaker": "戴因斯雷布",
                    "text": "……"
                },
                {
                    "id": "80200203",
                    "speaker": "派蒙",
                    "text": "是遇到什么事了吗？"
                },
                {
                    "id": "80200204",
                    "speaker": "Player",
                    "text": "怎么了，戴因？"
                },
                {
                    "id": "80200205",
                    "speaker": "戴因斯雷布",
                    "text": "#{NICKNAME}，你们说的那个失踪者…是个什么样的人？"
                },
                {
                    "id": "80200206",
                    "speaker": "派蒙",
                    "text": "嗯？"
                },
                {
                    "id": "80200207",
                    "speaker": "派蒙",
                    "text": "大概二十岁出头的男青年吧，到底怎么了呀，戴因…"
                },
                {
                    "id": "80200208",
                    "speaker": "戴因斯雷布",
                    "text": "现在我的脑海里似乎凭空多了一些东西…"
                },
                {
                    "id": "80200209",
                    "speaker": "戴因斯雷布",
                    "text": "…是一段有关他的「记忆」。"
                },
                {
                    "id": "80200210",
                    "speaker": "派蒙",
                    "text": "什么…？会不会…会不会是我们昨天聊了太多有关他的事，所以你昨晚做了一个这样的梦？"
                },
                {
                    "id": "80200211",
                    "speaker": "戴因斯雷布",
                    "text": "不，那不是梦，是今早我醒来以后忽然出现在脑海中的一段记忆…"
                },
                {
                    "id": "80200212",
                    "speaker": "戴因斯雷布",
                    "text": "而且我很确定，我从未见过这个人。"
                },
                {
                    "id": "80200213",
                    "speaker": "Player",
                    "text": "那「记忆」的内容是什么呢？"
                },
                {
                    "id": "80200214",
                    "speaker": "戴因斯雷布",
                    "text": "我记得，在那段回忆里…"
                },
                {
                    "id": "80200215",
                    "speaker": "戴因斯雷布",
                    "text": "…我把「世界上第一颗耕地机的眼睛」送给了他。"
                },
                {
                    "id": "80200216",
                    "speaker": "Player",
                    "text": "！？"
                },
                {
                    "id": "80200217",
                    "speaker": "派蒙",
                    "text": "啊！？"
                },
                {
                    "id": "80200218",
                    "speaker": "派蒙",
                    "text": "…所以现在可以确定，那个失踪者与深渊教团有关联了吧？"
                },
                {
                    "id": "80200219",
                    "speaker": "戴因斯雷布",
                    "text": "嗯，而且那个家伙，应该拥有往人们的脑海中「投放」记忆的能力。"
                },
                {
                    "id": "80200220",
                    "speaker": "Player",
                    "text": "究竟是如何做到的…"
                },
                {
                    "id": "80200221",
                    "speaker": "派蒙",
                    "text": "那要是这么说的话，维摩庄的大家会不会也只是被投放了虚假的记忆？原本大家应该不认识他…"
                },
                {
                    "id": "80200222",
                    "speaker": "派蒙",
                    "text": "可这样做的目的又是什么呢…"
                },
                {
                    "id": "80200223",
                    "speaker": "戴因斯雷布",
                    "text": "今早的这件事，对深渊教团来说，其实也暴露了一个事实。"
                },
                {
                    "id": "80200224",
                    "speaker": "派蒙",
                    "text": "暴露了什么？"
                },
                {
                    "id": "80200225",
                    "speaker": "戴因斯雷布",
                    "text": "他们的目标…依旧是「世界上第一颗耕地机的眼睛」，并没有把寻找它的事情抛在脑后。"
                },
                {
                    "id": "80200226",
                    "speaker": "戴因斯雷布",
                    "text": "给我投放这样的一段记忆，想必是为了扰乱唯一知道「眼睛」下落的我的思维…",
                    "choices": [
                        {
                            "id": "80200227",
                            "text": "那「眼睛」现在还安全吗？",
                            "response": [
                                {
                                    "id": "80200229",
                                    "speaker": "戴因斯雷布",
                                    "text": "你的担忧并不是没有道理，尽管我认为深渊教团应该还没有能力让那段记忆变成现实…"
                                },
                                {
                                    "id": "80200230",
                                    "speaker": "戴因斯雷布",
                                    "text": "但考虑到他们对「眼睛」的执着程度，我们也应该拿出对等程度的谨慎才稳妥。"
                                },
                                {
                                    "id": "80200231",
                                    "speaker": "戴因斯雷布",
                                    "text": "和我一起去确认一下吧，「眼睛」是否还在我们手中。"
                                },
                                {
                                    "id": "80200232",
                                    "speaker": "派蒙",
                                    "text": "是要到你藏「眼睛」的地方去吗？"
                                },
                                {
                                    "id": "80200233",
                                    "speaker": "Player",
                                    "text": "（…可是，如果我们就这样过去的话，万一被跟踪，岂不是反而暴露了隐藏位置？）"
                                },
                                {
                                    "id": "80200234",
                                    "speaker": "Player",
                                    "text": "（也或许，这原本就是深渊教团投放那段记忆给戴因的目的？引起他的疑心，让他产生再次确认的想法…）"
                                },
                                {
                                    "id": "80200235",
                                    "speaker": "戴因斯雷布",
                                    "text": "……"
                                },
                                {
                                    "id": "80200236",
                                    "speaker": "Player",
                                    "text": "（根据我对戴因的了解，他不可能没意识到这一点…看他的样子，应该是有别的想法…）",
                                    "choices": [
                                        {
                                            "id": "80200237",
                                            "text": "那我们走吧。",
                                            "response": [
                                                {
                                                    "id": "80200239",
                                                    "speaker": "戴因斯雷布",
                                                    "text": "…嗯。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "80200238",
                                            "text": "你带路，戴因。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "80200228",
                            "text": "有没有可能，「记忆」是真的？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "802003",
            "objective": "前往藏匿「耕地机的眼睛」的地方",
            "dialogues": [
                {
                    "id": "80200301",
                    "speaker": "派蒙",
                    "text": "原来是在这里吗？荒郊野岭，的确不是容易被发现的地方。"
                },
                {
                    "id": "80200302",
                    "speaker": "派蒙",
                    "text": "那我们赶快去确认一下吧！"
                },
                {
                    "id": "80200303",
                    "speaker": "戴因斯雷布",
                    "text": "#等等，{NICKNAME}…"
                },
                {
                    "id": "80200304",
                    "speaker": "Player",
                    "text": "嗯？"
                },
                {
                    "id": "80200305",
                    "speaker": "戴因斯雷布",
                    "text": "……"
                },
                {
                    "id": "80200306",
                    "speaker": "戴因斯雷布",
                    "text": "…事不宜迟，我们赶快进去。"
                },
                {
                    "id": "80200307",
                    "speaker": "Player",
                    "text": "（刚刚戴因想要和我说什么…？）"
                },
                {
                    "id": "80200308",
                    "speaker": "派蒙",
                    "text": "喂，等等我！"
                }
            ]
        },
        {
            "id": "802004",
