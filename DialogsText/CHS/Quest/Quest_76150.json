    "talks": [
        {
            "id": "7615001",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "761500101",
                    "speaker": "彩特琳德",
                    "text": "咳咳咳。"
                },
                {
                    "id": "761500102",
                    "speaker": "Player",
                    "text": "你没事吧？"
                },
                {
                    "id": "761500103",
                    "speaker": "彩特琳德",
                    "text": "我…没事。我做了一个很长很长的噩梦。"
                },
                {
                    "id": "761500104",
                    "speaker": "彩特琳德",
                    "text": "算了。上一句话当我没说。"
                },
                {
                    "id": "761500105",
                    "speaker": "彩特琳德",
                    "text": "我忍不了了。为什么我要遇到这种事情。"
                },
                {
                    "id": "761500106",
                    "speaker": "彩特琳德",
                    "text": "为什么我总要遇到这些事情。爸爸妈妈，然后是姐姐…"
                },
                {
                    "id": "761500107",
                    "speaker": "Player",
                    "text": "没事的，我在。"
                },
                {
                    "id": "761500108",
                    "speaker": "彩特琳德",
                    "text": "嗯。我没有生你们的气。"
                },
                {
                    "id": "761500109",
                    "speaker": "小右",
                    "text": "♪~"
                },
                {
                    "id": "761500110",
                    "speaker": "彩特琳德",
                    "text": "小右捡了个什么东西？"
                },
                {
                    "id": "761500111",
                    "speaker": "伊斯托利亚",
                    "text": "我把这个叫做「念亡碎片」，或许是向死而生的出路。"
                },
                {
                    "id": "761500112",
                    "speaker": "Player",
                    "text": "一起走吧。"
                },
                {
                    "id": "761500113",
                    "speaker": "彩特琳德",
                    "text": "嗯。"
                },
                {
                    "id": "761500114",
                    "speaker": "伊斯托利亚",
                    "text": "既然找到琳德了。我们就去找找出去的办法吧。"
                },
                {
                    "id": "761500115",
                    "speaker": "阿罗逻",
                    "text": "这里真的可以靠实力出去吗？"
                },
                {
                    "id": "761500116",
                    "speaker": "伊斯托利亚",
                    "text": "既然梅兰塔和尼西里塔可以自由往来，通常都还会带人出入。那小右应该也可以。"
                },
                {
                    "id": "761500117",
                    "speaker": "小右",
                    "text": "♪~"
                },
                {
                    "id": "761500118",
                    "speaker": "伊斯托利亚",
                    "text": "现在收集到了三枚「念亡碎片」。"
                },
                {
                    "id": "761500119",
                    "speaker": "伊斯托利亚",
                    "text": "哦，这个是暂定名。因为我也不知道小右收集这个要做什么。"
                },
                {
                    "id": "761500120",
                    "speaker": "伊斯托利亚",
                    "text": "小右，接下来怎么办？"
                },
                {
                    "id": "761500121",
                    "speaker": "小右",
                    "text": "！"
                },
                {
                    "id": "761500122",
                    "speaker": "伊斯托利亚",
                    "text": "跟着它指示的方向走吧。"
                }
            ]
        },
        {
