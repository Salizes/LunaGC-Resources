    "talks": [
        {
            "id": "7502301",
            "objective": "",
            "dialogues": [
                {
                    "id": "750230201",
                    "speaker": "派蒙",
                    "text": "#{NICKNAME}，快看快看！这里又有留影机又有布景，会不会是映影的拍摄场地？"
                },
                {
                    "id": "750230202",
                    "speaker": "派蒙",
                    "text": "#不过这里的布景…这些房子都好小喔！显得{NICKNAME}都像是巨人了。"
                },
                {
                    "id": "750230203",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "唔…呀呀！",
                    "choices": [
                        {
                            "id": "750230204",
                            "text": "渺小的人类…",
                            "response": [
                                {
                                    "id": "750230205",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "呀呀…"
                                },
                                {
                                    "id": "750230206",
                                    "speaker": "派蒙",
                                    "text": "哼哼，这下我们就是名副其实的「大人物」了呢。"
                                },
                                {
                                    "id": "750230239",
                                    "speaker": "Black Screen",
                                    "text": "一个纳塔人十分自然地加入了对话…"
                                },
                                {
                                    "id": "750230209",
                                    "speaker": "阿卡坦加",
                                    "text": "哦！几位也对映影感兴趣吗？那请务必助我阿卡坦加一臂之力，让全新的流行席卷纳塔的土地吧！"
                                },
                                {
                                    "id": "750230210",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "呀！呀呀！"
                                },
                                {
                                    "id": "750230211",
                                    "speaker": "派蒙",
                                    "text": "#{REALNAME[ID(2)|SHOWHOST(true)]}怎么这么高兴，你附和他做什么呀？你也喜欢映影吗？"
                                },
                                {
                                    "id": "750230212",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "呀呀呀！"
                                },
                                {
                                    "id": "750230213",
                                    "speaker": "阿卡坦加",
                                    "text": "小家伙，眼光真不错！实话说，这里的一切都是为了让一只小嵴锋龙成为明日之星而准备的。"
                                },
                                {
                                    "id": "750230214",
                                    "speaker": "阿卡坦加",
                                    "text": "可惜那只小嵴锋龙被我朋友带走了。我们因为创作理念不和大吵一架，之后她就带着我最重要的演员一去不回，唉…"
                                },
                                {
                                    "id": "750230215",
                                    "speaker": "阿卡坦加",
                                    "text": "真不该和朋友合作。项目失败了，朋友也没了。我输两次。"
                                },
                                {
                                    "id": "750230216",
                                    "speaker": "阿卡坦加",
                                    "text": "但是没关系，现在又有一只小嵴锋龙来到我的面前，看这跃跃欲试的样子，一准能成功、爆红！"
                                },
                                {
                                    "id": "750230217",
                                    "speaker": "阿卡坦加",
                                    "text": "怎么样？几位要是能协助我完成这部跨时代的作品，我一定重重酬谢！",
                                    "choices": [
                                        {
                                            "id": "750230218",
                                            "text": "#既然{REALNAME[ID(2)|SHOWHOST(true)]}喜欢…",
                                            "response": [
                                                {
                                                    "id": "750230221",
                                                    "speaker": "派蒙",
                                                    "text": "帮忙是可以啦，不过我们还不知道你要拍的映影是什么内容呢。"
                                                },
                                                {
                                                    "id": "750230222",
                                                    "speaker": "阿卡坦加",
                                                    "text": "我设想的内容是这样的…"
                                                },
                                                {
                                                    "id": "750230223",
                                                    "speaker": "Black Screen",
                                                    "text": "嗡——嘭、嘭嘭、嘭。炫目的白光消失，圆润但有刺的来客抵达了部族。滋滋、滋滋，它在草地上停留了片刻，就能闻到焦枯的气味。「噫！希泊巴的使者！」部族的人们露出恐怖的表情，嘭、嘭嘭、嘭，「它过来了！连牙也没有的邪恶生物！要把部族啃噬殆尽！」"
                                                },
                                                {
                                                    "id": "750230224",
                                                    "speaker": "Black Screen",
                                                    "text": "#正当邪恶的暴徒将要跃入部族防卫阵地的时候！哐——哐——尾巴上系着红丝巾的救星突然现身。「怎么会在这里？」比黑曜石更坚固的双爪，无论怎样的土石都能轻易击碎，「但对手的柔韧程度更甚无赖的脸皮，{REALNAME[ID(2)|SHOWHOST(true)]}的胜算…」"
                                                },
                                                {
                                                    "id": "750230225",
                                                    "speaker": "Black Screen",
                                                    "text": "「呀——！」与其说是怒吼，更像是尖啸，没牙的邪恶生物也噗噜噜地震动。冲天的火光之后是隆隆的巨响，和比浸泡在液态燃素里更热的热浪！连牙也没有的邪恶生物四散而去，「好烫！好烫！」余波席卷了幸免于难的部族。"
                                                },
                                                {
                                                    "id": "750230226",
                                                    "speaker": "Black Screen",
                                                    "text": "而尾巴上系着红丝巾的救星不知何时已经无声息地离开，就像没有人知道它怎样到来…"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "750230219",
                                            "text": "百分之百成功听起来像什么骗术。",
                                            "response": [
                                                {
                                                    "id": "750230220",
                                                    "speaker": "阿卡坦加",
                                                    "text": "就算不能一炮而红，协助拍摄的酬劳总归是会支付的，你们也不会亏。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "750230207",
                            "text": "给派蒙住应该不错。",
                            "response": [
                                {
                                    "id": "750230208",
                                    "speaker": "派蒙",
                                    "text": "什么嘛，我才不要住那么小的房子，手脚都伸展不开。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7502303",
            "objective": "在合适的位置放置木桶",
            "dialogues": [
                {
                    "id": "750230301",
                    "speaker": "阿卡坦加",
                    "text": "怎么了，需要我重复一遍步骤吗？",
                    "choices": [
                        {
                            "id": "750230302",
                            "text": "再讲一遍让我听听。",
                            "response": [
                                {
                                    "id": "750230303",
                                    "speaker": "阿卡坦加",
                                    "text": "先是放置演出道具，木桶放在<color=#00E1FFFF>画面中心但不遮挡主角和布景的位置</color>，元素诱饵放在<color=#00E1FFFF>敌方角色入场的方向</color>。"
                                },
                                {
                                    "id": "750230304",
                                    "speaker": "阿卡坦加",
                                    "text": "之后，等到需要的时候，<color=#00E1FFFF>引导敌对角色到木桶附近</color>，再退到安全位置<color=#00E1FFFF>击碎木桶</color>。"
                                }
                            ]
                        },
                        {
                            "id": "750230305",
                            "text": "不用了。",
                            "response": [
                                {
                                    "id": "750230306",
                                    "speaker": "阿卡坦加",
                                    "text": "那就万事拜托了。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7502304",
            "objective": "在合适的位置放置元素诱饵",
            "dialogues": []
        },
        {
            "id": "7502305",
            "objective": "与阿卡坦加对话",
            "dialogues": [
                {
                    "id": "750230501",
                    "speaker": "阿卡坦加",
                    "text": "等演员就位，接下来按计划<color=#00E1FFFF>将敌对角色引导到木桶附近</color>，之后迅速离开，在安全位置<color=#00E1FFFF>击碎木桶</color>。"
                }
            ]
        },
        {
            "id": "7502310",
            "objective": "等龙伙伴就位",
            "dialogues": []
        },
        {
            "id": "7502311",
            "objective": "到指定位置就位",
            "dialogues": []
        },
        {
            "id": "7502312",
            "objective": "到指定位置就位",
            "dialogues": [
                {
                    "id": "750231201",
                    "speaker": "派蒙",
                    "text": "你这个敌对角色怎么是没事前商量过的临时演员啊！"
                },
                {
                    "id": "750231202",
                    "speaker": "阿卡坦加",
                    "text": "嘘！别吵，我们要开始拍摄了！"
                },
                {
                    "id": "750231203",
                    "speaker": "画外音",
                    "text": "「不可原谅…安息吧，我的朋友们，哦哦…哦哦…看到倒下的部族{RUBY#[D]好兄弟们}民，真想流下泪水！」"
                },
                {
                    "id": "750231204",
                    "speaker": "画外音",
                    "text": "「但是此时不是流泪的时刻，枯焦的{RUBY#[D]修洛特尔}使者近在眼前，今日我必将报仇血恨叽呀——」"
                },
                {
                    "id": "750231205",
                    "speaker": "雷史莱姆",
                    "text": "？"
                },
                {
                    "id": "750231206",
                    "speaker": "画外音",
                    "text": "无牙也无齿的猛兽，脸色就像遥远国度的名产堇瓜一般冷静沉着！"
                },
                {
                    "id": "750231207",
                    "speaker": "画外音",
                    "text": "那是一张怎样的脸，是一张即使吞下「火山级辣度塔塔可」也不会有丝毫变化的残忍面孔，真是可怕至极——"
                },
                {
                    "id": "750231208",
                    "speaker": "画外音",
                    "text": "「这一次，这一次，一定要让你后悔到死呀！」说着，尾巴上系着红丝巾的巨兽使用了锻炼千百遍的「大炖肉火焰」——"
                },
                {
                    "id": "750231209",
                    "speaker": "阿卡坦加",
                    "text": "好了，就是这个时候！把雷史莱姆引到木桶边，击碎那个木桶吧！"
                },
                {
                    "id": "750231210",
                    "speaker": "派蒙",
                    "text": "在这个时候击碎木桶？木桶就是什么「大炖肉火焰」？"
                },
                {
                    "id": "750231211",
                    "speaker": "派蒙",
                    "text": "总觉得有点奇怪，但是…好吧，我们试试。"
                }
            ]
        },
        {
            "id": "7502306",
            "objective": "将敌对角色引导至木桶附近并击碎木桶",
            "dialogues": []
        },
        {
            "id": "7502307",
            "objective": "与阿卡坦加对话",
            "dialogues": [
                {
                    "id": "750230701",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "呀！呀呀呀！"
                },
                {
                    "id": "750230702",
                    "speaker": "派蒙",
                    "text": "好啦好啦，别这么着急嘛。"
                },
                {
                    "id": "750230703",
                    "speaker": "阿卡坦加",
                    "text": "说实话刚才我也替小家伙捏了一把汗呢，为了追求真实感，炸药的量也准备得比较充分…",
                    "choices": [
                        {
                            "id": "750230704",
                            "text": "区区爆炸…",
                            "response": [
                                {
                                    "id": "750230705",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "唔呀呀呀…"
                                },
                                {
                                    "id": "750230708",
                                    "speaker": "阿卡坦加",
                                    "text": "总之，有了这次的经验，之后就知道如何改善了。谢谢几位的协助，我们这就来看看成片的效果吧？"
                                },
                                {
                                    "id": "750230709",
                                    "speaker": "Black Screen",
                                    "text": "出人意料的是，画面中既没有尾巴系着红丝巾的救星，也没有发出滋滋声的邪恶敌人，更没有惊心动魄的爆炸场景，有的只是阿卡坦加不断变换的表情…"
                                },
                                {
                                    "id": "750230710",
                                    "speaker": "阿卡坦加",
                                    "text": "我成主角了？",
                                    "choices": [
                                        {
                                            "id": "750230711",
                                            "text": "恭喜啊。",
                                            "response": [
                                                {
                                                    "id": "750230712",
                                                    "speaker": "派蒙",
                                                    "text": "这不对吧！难道是留影机…"
                                                },
                                                {
                                                    "id": "750230714",
                                                    "speaker": "阿卡坦加",
                                                    "text": "说起来这的确是我第一次正式使用留影机…难不成是给弄反了？"
                                                },
                                                {
                                                    "id": "750230715",
                                                    "speaker": "派蒙",
                                                    "text": "你说得倒是轻松，那我们刚才的辛苦不是都白费了吗！"
                                                },
                                                {
                                                    "id": "750230716",
                                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                                    "text": "呜…呜呜…呀…"
                                                },
                                                {
                                                    "id": "750230717",
                                                    "speaker": "派蒙",
                                                    "text": "#明明{REALNAME[ID(2)|SHOWHOST(true)]}也很期待的…"
                                                },
                                                {
                                                    "id": "750230718",
                                                    "speaker": "阿卡坦加",
                                                    "text": "抱歉抱歉，全都是我的错！这样，刚才就当是彩排，这次才是正式的，我一定拿出十二万分的干劲，拍出最精彩的映影！"
                                                },
                                                {
                                                    "id": "750230719",
                                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                                    "text": "呜…呀呀！"
                                                },
                                                {
                                                    "id": "750230720",
                                                    "speaker": "派蒙",
                                                    "text": "兴致很高的样子呢，那就当你是愿意的好啦。但愿这次别再出什么岔子了。"
                                                },
                                                {
                                                    "id": "750230721",
                                                    "speaker": "Black Screen",
                                                    "text": "于是按之前的流程又走了一遍，总算是得到了想要的结果…"
                                                },
                                                {
                                                    "id": "750230722",
                                                    "speaker": "阿卡坦加",
                                                    "text": "了不起！完美！只能说是超出预期了。",
                                                    "choices": [
                                                        {
                                                            "id": "750230723",
                                                            "text": "这点小事轻车熟路。",
                                                            "response": [
                                                                {
                                                                    "id": "750230725",
                                                                    "speaker": "阿卡坦加",
                                                                    "text": "除了原本约定的报酬，这张画片送给你们留作纪念吧，唉，怎么说也算得上是我的得意之作呢，当然，也多亏了几位的协助。"
                                                                },
                                                                {
                                                                    "id": "750230726",
                                                                    "speaker": "派蒙",
                                                                    "text": "#哇，{REALNAME[ID(2)|SHOWHOST(true)]}威风凛凛的样子，确实很不错呢。"
                                                                },
                                                                {
                                                                    "id": "750230727",
                                                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                                                    "text": "呀！呀呀呀！"
                                                                },
                                                                {
                                                                    "id": "750230728",
                                                                    "speaker": "派蒙",
                                                                    "text": "#嘿嘿，{REALNAME[ID(2)|SHOWHOST(true)]}也很满意，那就结果好一切都好咯。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "750230724",
                                                            "text": "导演，我们的奖金呢？"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "750230713",
                                            "text": "留影机的操作…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "750230706",
                            "text": "就算是我也觉得太危险了。",
                            "response": [
                                {
                                    "id": "750230707",
                                    "speaker": "派蒙",
                                    "text": "是呀！万一伤到谁，或者引发火灾之类的就不好了！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7502308",
            "objective": "与阿卡坦加对话",
            "dialogues": [
                {
                    "id": "750230801",
                    "speaker": "阿卡坦加",
                    "text": "这样是不行的呀，没有达到预期的效果，我们重新开始吧。"
                }
            ]
        },
        {
            "id": "7502320",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "750232001",
                    "speaker": "阿卡坦加",
                    "text": "说不定我那分道扬镳的朋友看过这部作品后也会回心转意呢，哈哈。"
                }
            ]
        }
    ]
}