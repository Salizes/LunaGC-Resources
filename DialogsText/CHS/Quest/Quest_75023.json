            "title": "龙选者的旅迹"
        },
        "total_dialogue_lines": 75,
        "total_speaker_counts": {
            "#{REALNAME[ID(2)|SHOWHOST(true)]}": 9,
            "Black Screen": 7,
            "Player": 12,
