    },
    "talks": [
        {
            "id": "2300601",
            "objective": "与戈尔珊对话",
            "dialogues": [
                {
                    "id": "230060101",
                    "speaker": "戈尔珊",
                    "text": "唉，现在怎么可能找得到人…"
                },
                {
                    "id": "230060102",
                    "speaker": "Player",
                    "text": "怎么了？"
                },
                {
                    "id": "230060103",
                    "speaker": "戈尔珊",
                    "text": "啊！您，您好，旅行者，请问您是需要治疗吗？",
                    "choices": [
                        {
                            "id": "230060104",
                            "text": "只是路过…",
                            "response": [
                                {
                                    "id": "230060106",
                                    "speaker": "戈尔珊",
                                    "text": "哈哈…看起来有那么明显吗？不过，我确实也很发愁啦。"
                                },
                                {
                                    "id": "230060107",
                                    "speaker": "戈尔珊",
                                    "text": "不知道为什么，最近来我们「健康之家」请求治疗的人越来越多，我们的全部人手几乎都投入在照顾病患里了。"
                                },
                                {
                                    "id": "230060108",
                                    "speaker": "戈尔珊",
                                    "text": "但扎卡里亚医生还是坚持让我想办法去打扫周围…"
                                },
                                {
                                    "id": "230060109",
                                    "speaker": "戈尔珊",
                                    "text": "他说，为了让大家更容易接受草神大人的福佑，必须时刻保持病人身心和医院内外的洁净。"
                                },
                                {
                                    "id": "230060110",
                                    "speaker": "戈尔珊",
                                    "text": "唉，但现在压根找不到人，我总不能拜托那些症状轻微的病人起来帮忙吧…",
                                    "choices": [
                                        {
                                            "id": "230060111",
                                            "text": "不如就交给我吧。",
                                            "response": [
                                                {
                                                    "id": "230060112",
                                                    "speaker": "戈尔珊",
                                                    "text": "你愿意帮忙吗？那真是太感谢了！我会准备好报酬的，虽然，虽然不会太多…"
                                                },
                                                {
                                                    "id": "230060123",
                                                    "speaker": "戈尔珊",
                                                    "text": "唉，愿草神大人保佑大家远离病恙…"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "230060113",
                                            "text": "不能雇人来帮忙吗？",
                                            "response": [
                                                {
                                                    "id": "230060114",
                                                    "speaker": "戈尔珊",
                                                    "text": "我们这里毕竟都是病患，没多少人会愿意来义务帮忙，我们的资金也有限，没办法雇很多人。"
                                                },
                                                {
                                                    "id": "230060115",
                                                    "speaker": "戈尔珊",
                                                    "text": "平时我们都是轮换值班，但现在这么忙，已经没人有空了。"
                                                },
                                                {
                                                    "id": "230060116",
                                                    "speaker": "戈尔珊",
                                                    "text": "旅行者，如果…如果你愿意的话，能不能来帮帮忙呢？"
                                                },
                                                {
                                                    "id": "230060117",
                                                    "speaker": "戈尔珊",
                                                    "text": "我们会付报酬的！虽然，虽然不会太多…"
                                                },
                                                {
                                                    "id": "230060118",
                                                    "speaker": "Player",
                                                    "text": "这里的病症…"
                                                },
                                                {
                                                    "id": "230060119",
                                                    "speaker": "戈尔珊",
                                                    "text": "这里病人的病情其实都是一些头疼之类的轻微病症。"
                                                },
                                                {
                                                    "id": "230060120",
                                                    "speaker": "戈尔珊",
                                                    "text": "扎卡里亚医生也对外宣传了很多次，这些病症并不危险，但没人听得进去。"
                                                },
                                                {
                                                    "id": "230060121",
                                                    "speaker": "戈尔珊",
                                                    "text": "我想，也许大家害怕的不是病症本身，而是得病这件事吧…"
                                                },
                                                {
                                                    "id": "230060122",
                                                    "speaker": "戈尔珊",
                                                    "text": "那清扫工作就拜托你了，旅行者。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "230060105",
                            "text": "只是看你很发愁的样子…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "2300602",
            "objective": "清扫「健康之家」附近的污渍",
            "dialogues": []
        },
        {
            "id": "2300603",
            "objective": "与戈尔珊对话",
            "dialogues": [
                {
                    "id": "230060401",
                    "speaker": "戈尔珊",
                    "text": "请问您把周围都清理完了吗？"
                },
                {
                    "id": "230060402",
                    "speaker": "Player",
                    "text": "都清理完了。"
                },
                {
                    "id": "230060403",
                    "speaker": "戈尔珊",
                    "text": "真是太感谢您了，旅行者，这些酬劳请务必收下。"
                },
                {
                    "id": "230060404",
                    "speaker": "戈尔珊",
                    "text": "话说回来，古尔根先生最近又在勉强自己干活了，我是不是要多花些时间劝劝他呢…"
                },
                {
                    "id": "230060405",
                    "speaker": "戈尔珊",
                    "text": "近期还有不少要花精力的事，下次清理可能还要麻烦您了。"
                }
            ]
        },
        {
            "id": "2300603",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "230060301",
                    "speaker": "戈尔珊",
                    "text": "旅行者，你有什么想问我的吗？",
                    "choices": [
                        {
                            "id": "230060302",
                            "text": "关于扎卡里亚…",
                            "response": [
                                {
                                    "id": "230060303",
                                    "speaker": "戈尔珊",
                                    "text": "扎卡里亚医生是一位很厉害的医生，也是一位很虔诚的草神信徒呢。"
                                },
                                {
                                    "id": "230060304",
                                    "speaker": "戈尔珊",
                                    "text": "他经常不眠不休地治疗病人，就连吃饭都顾不上。"
                                },
                                {
                                    "id": "230060305",
                                    "speaker": "戈尔珊",
                                    "text": "扎卡里亚医生还说，让草神大人的福佑能恩泽到更多人，是他义不容辞的使命。"
                                }
                            ]
                        },
                        {
                            "id": "230060306",
                            "text": "你们的治疗真是靠草神的福佑？",
                            "response": [
                                {
                                    "id": "230060307",
                                    "speaker": "戈尔珊",
                                    "text": "准确地来说，「治疗病症」这件事，就是草神的恩泽喔。"
                                },
                                {
                                    "id": "230060308",
                                    "speaker": "戈尔珊",
                                    "text": "草神护佑着我们，让我们能找到治疗病患的方法，培育治疗病症的药草…"
                                },
                                {
                                    "id": "230060309",
                                    "speaker": "戈尔珊",
                                    "text": "感谢草神大人的恩泽，愿大家都能够远离病恙…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
