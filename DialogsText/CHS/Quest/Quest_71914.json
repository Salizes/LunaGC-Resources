            "dialogues": [
                {
                    "id": "719140101",
                    "speaker": "Player",
                    "text": "还有其他的吗？"
                },
                {
                    "id": "719140102",
                    "speaker": "琳琅",
                    "text": "就比如这块石头，看似普通，其实这是一块星星的碎片。"
                },
                {
                    "id": "719140103",
                    "speaker": "琳琅",
                    "text": "在很久以前，星星曾坠落到了大地上，因为巨大的冲击力所以表面的颜色也变成了如今这般…"
                },
                {
                    "id": "719140104",
                    "speaker": "琳琅",
                    "text": "什么？你说为什么看着像普通的矿石？"
                },
                {
                    "id": "719140105",
                    "speaker": "琳琅",
                    "text": "…哦，不好意思，拿错了，这就是一块普通的矿石。"
                },
                {
                    "id": "719140106",
                    "speaker": "琳琅",
                    "text": "大概是供货商送货时掺进去的吧，真是尴尬…"
                },
                {
                    "id": "719140107",
                    "speaker": "琳琅",
                    "text": "你把它拿去吧，我不想再在店里见到它了。"
                }
            ]
