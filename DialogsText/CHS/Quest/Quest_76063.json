    "talks": [
        {
            "id": "7606301",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7606302",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "760630301",
                    "speaker": "举行仪式的幽影",
                    "text": "很疲惫吧？狂猎带来的恐惧和痛苦，在一次又一次的作战中不断累积。"
                },
                {
                    "id": "760630302",
                    "speaker": "举行仪式的幽影",
                    "text": "绝望、悲伤…所有留在你心中的阴影都是狂猎播下的恶意之种。"
                },
                {
                    "id": "760630303",
                    "speaker": "举行仪式的幽影",
                    "text": "让月光和海浪带走这些黑暗吧，被海水洗净后，你将焕然一新。"
                },
                {
                    "id": "760630304",
                    "speaker": "Player",
                    "text": "所有人都必须参加吗？"
                },
                {
                    "id": "760630305",
                    "speaker": "举行仪式的幽影",
                    "text": "你是新人吧，这个海浴仪式并不是强制的。"
                },
                {
                    "id": "760630306",
                    "speaker": "举行仪式的幽影",
                    "text": "与狂猎作战给人带来的折磨是长期的，有人在睡梦中也依然觉得痛苦，有人变得畏惧战斗。"
                },
                {
                    "id": "760630307",
                    "speaker": "举行仪式的幽影",
                    "text": "你会觉得自己被狂猎的阴影缠住了，它们黏在你身上怎么也甩不开。"
                },
                {
                    "id": "760630308",
                    "speaker": "举行仪式的幽影",
                    "text": "我也经历过这样的时刻，那个时候来帮助我的，是我的一位前辈。"
                },
                {
                    "id": "760630309",
                    "speaker": "举行仪式的幽影",
                    "text": "他教我在海水和月光中洗净自己的杂念，我就不害怕了。"
                },
                {
                    "id": "760630310",
                    "speaker": "举行仪式的幽影",
                    "text": "像过去的我这样受尽苦痛的同僚还有很多，我们会定期在这里集会，举行海浴仪式。"
                },
                {
                    "id": "760630311",
                    "speaker": "举行仪式的幽影",
                    "text": "被海水浸泡之后，很多同僚的精神好了许多。"
                },
                {
                    "id": "760630312",
                    "speaker": "举行仪式的幽影",
                    "text": "能以这种方式帮助他们，我很高兴。"
                },
                {
                    "id": "760630313",
                    "speaker": "举行仪式的幽影",
                    "text": "希望海浪和月光能卷走我们身边的黑暗，只留下光明和希望。"
                }
            ]
        }
    ]
}