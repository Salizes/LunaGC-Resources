    "talks": [
        {
            "id": "7512104",
            "objective": "",
            "dialogues": [
                {
                    "id": "751210401",
                    "speaker": "查看留言",
                    "text": "（茜特菈莉，你要的藏书我们找到了哦。来的时候你又在宿醉，我们就不吵醒你了。）"
                },
                {
                    "id": "751210402",
                    "speaker": "查看留言",
                    "text": "（下次还是少喝点吧。）"
                }
            ]
        },
        {
            "id": "7512105",
            "objective": "",
            "dialogues": [
                {
                    "id": "751210501",
                    "speaker": "茜特菈莉的卧室",
                    "text": "（门内隐约传来茜特菈莉的鼾声。）"
                },
                {
                    "id": "751210502",
                    "speaker": "派蒙",
                    "text": "不是又宿醉了吧…还是先放在桌子上好了，茜特菈莉肯定不想被吵醒。"
                }
            ]
        },
        {
            "id": "7512101",
            "objective": "(test)八重堂对话挂接$HIDDEN",
            "dialogues": [
                {
                    "id": "751210101",
                    "speaker": "Player",
                    "text": "有人托我来找两本书…"
                },
                {
                    "id": "751210102",
                    "speaker": "Black Screen",
                    "text": "你向黑田描述了茜特菈莉想要的绝版书。"
                },
                {
                    "id": "751210103",
                    "speaker": "黑田",
                    "text": "《转生成为雷电将军，然后天下无敌》的第一版和《拜托了我的狐仙宫司》的限量精装版…"
                },
                {
                    "id": "751210104",
                    "speaker": "黑田",
                    "text": "不得不说，你的这位朋友真的很专业，谈到收藏价值，目前八重堂发行的书籍都比不上这两本。"
                },
                {
                    "id": "751210105",
                    "speaker": "黑田",
                    "text": "这样的读者我竟然不认识，真是遗憾…"
                },
                {
                    "id": "751210106",
                    "speaker": "Player",
                    "text": "现在还能找到吗？"
                },
                {
                    "id": "751210107",
                    "speaker": "黑田",
                    "text": "无论哪一本，都不可能再从市面上找到了，库存更不用说，早就被抢购光了。"
                },
                {
                    "id": "751210108",
                    "speaker": "黑田",
                    "text": "不过，我这里刚好各有一本…"
                },
                {
                    "id": "751210109",
                    "speaker": "Player",
                    "text": "我可以花钱买。"
                },
                {
                    "id": "751210110",
                    "speaker": "黑田",
                    "text": "不不，这两本藏书还是在你那位朋友手里更能体现它们的价值。"
                },
                {
                    "id": "751210111",
                    "speaker": "黑田",
                    "text": "就让我把它们作为礼物送给你吧。"
                }
            ]
        },
        {
            "id": "7512102",
            "objective": "(test)茜特菈莉家的交付$HIDDEN",
            "dialogues": [
                {
                    "id": "751210201",
                    "speaker": "Player",
                    "text": "（放在这里就可以了吧？）"
                }
            ]
        },
        {
            "id": "7512103",
            "objective": "(test)交付后对话$HIDDEN",
            "dialogues": [
                {
                    "id": "751210301",
                    "speaker": "派蒙",
                    "text": "再写段留言吧，这里乱糟糟的，茜特菈莉还真有可能注意不到呢。"
                },
                {
                    "id": "751210302",
                    "speaker": "Black Screen",
                    "text": "派蒙找来一张纸条，思忖片刻后写下留言。"
                }
            ]
        },
        {
            "id": "7512106",
            "objective": "(test)等待自然日一天-切到书桌上$HIDDEN",
            "dialogues": [
