    "talks": [
        {
            "id": "4133301",
            "objective": "与铁块儿对话",
            "dialogues": [
                {
                    "id": "413330101",
                    "speaker": "铁块儿",
                    "text": "「九天玄罗仙人漫天飞座」…真美啊…"
                },
                {
                    "id": "413330102",
                    "speaker": "Player",
                    "text": "你是在看星星吗？"
                },
                {
                    "id": "413330103",
                    "speaker": "铁块儿",
                    "text": "是…也不是，这不是海灯节吗？看点这种文雅的东西，应景嘛…"
                },
                {
                    "id": "413330104",
                    "speaker": "铁块儿",
                    "text": "我还学着写了点诗咧，听其他兄弟说，现在的女孩子都喜欢这种调调。"
                },
                {
                    "id": "413330105",
                    "speaker": "铁块儿",
                    "text": "嗨，紫微也一定…",
                    "choices": [
                        {
                            "id": "413330106",
                            "text": "写诗？",
                            "response": [
                                {
                                    "id": "413330108",
                                    "speaker": "铁块儿",
                                    "text": "咳咳…我可是从紫微那听说了不少星座的名字，哎呀…那些名字可好听了…"
                                },
                                {
                                    "id": "413330109",
                                    "speaker": "铁块儿",
                                    "text": "你看，我总得感谢一下吧！"
                                },
                                {
                                    "id": "413330110",
                                    "speaker": "铁块儿",
                                    "text": "我就想，我自己作首诗写在霄灯上，和紫微一起找个好地方放了…吃着零食唱着歌…"
                                },
                                {
                                    "id": "413330111",
                                    "speaker": "铁块儿",
                                    "text": "——这好事不就成了吗！"
                                },
                                {
                                    "id": "413330112",
                                    "speaker": "Player",
                                    "text": "成了…？"
                                },
                                {
                                    "id": "413330113",
                                    "speaker": "铁块儿",
                                    "text": "咳！我是说…这个节日的氛围，不就成了吗？"
                                },
                                {
                                    "id": "413330114",
                                    "speaker": "铁块儿",
                                    "text": "总之，我想找个气氛好点，路人少一点，景色漂亮点的地方。"
                                },
                                {
                                    "id": "413330115",
                                    "speaker": "铁块儿",
                                    "text": "我还特意找人问过了，找到了两个好地方…你看看，就这俩地方。"
                                },
                                {
                                    "id": "413330116",
                                    "speaker": "铁块儿",
                                    "text": "我听其他兄弟说，他们以前都是在这俩地方放霄灯…"
                                },
                                {
                                    "id": "413330117",
                                    "speaker": "铁块儿",
                                    "text": "不过我还得作诗呢…随便乱跑连灵感都要跑丢了。"
                                },
                                {
                                    "id": "413330118",
                                    "speaker": "铁块儿",
                                    "text": "你看能不能帮我跑一趟考察考察？"
                                },
                                {
                                    "id": "413330119",
                                    "speaker": "Player",
                                    "text": "没问题。"
                                },
                                {
                                    "id": "413330120",
                                    "speaker": "铁块儿",
                                    "text": "多谢你愿意帮忙，那就拜托你了！"
                                }
                            ]
                        },
                        {
                            "id": "413330107",
                            "text": "紫微？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "4133302",
            "objective": "寻找第一处合适的景观点并<color=#00E1FFFF>拍照</color>",
            "dialogues": [
                {
                    "id": "413330201",
                    "speaker": "铁块儿",
                    "text": "「铁块紫微一相逢」…不行不行，这也太直接了…"
                },
                {
                    "id": "413330202",
                    "speaker": "铁块儿",
                    "text": "嗯？你们什么时候来的，地点都找过了吗？"
                },
                {
                    "id": "413330203",
                    "speaker": "Player",
                    "text": "都找过了。"
                },
                {
                    "id": "413330204",
                    "speaker": "铁块儿",
                    "text": "这么快？我来看看…"
                },
                {
                    "id": "413330205",
                    "speaker": "铁块儿",
                    "text": "嗯…让我看看…一个重重叠叠别具一格，一个鳞次栉比错落有致…真是「横看成岭侧成峰」…下一句是什么来着？"
                },
                {
                    "id": "413330206",
                    "speaker": "铁块儿",
                    "text": "…算了不管了，还是从正面看过去亮亮堂堂的比较气派。"
                },
                {
                    "id": "413330207",
                    "speaker": "铁块儿",
                    "text": "嗯，好！我知道选哪里了…旅行者，我还想请你再帮我一个小忙。"
                },
                {
                    "id": "413330208",
                    "speaker": "铁块儿",
                    "text": "我兄弟说，和人家说话的时候，最好还得备点吃食，你觉得，我和紫微说话的时候，准备什么好？",
                    "choices": [
                        {
                            "id": "413330209",
                            "text": "烤吃虎鱼。",
                            "response": [
                                {
                                    "id": "413330210",
                                    "speaker": "铁块儿",
                                    "text": "烤吃虎鱼…哎呀，会不会太油了点，有点不太讲究，不然还是杏仁豆腐…"
                                },
                                {
                                    "id": "413330212",
                                    "speaker": "铁块儿",
                                    "text": "对，杏仁豆腐，这个合适！"
                                },
                                {
                                    "id": "413330213",
                                    "speaker": "铁块儿",
                                    "text": "旅行者，拜托你帮我去准备一份杏仁豆腐吧，我接着琢磨一下，这诗该咋整…"
                                },
                                {
                                    "id": "413330214",
                                    "speaker": "铁块儿",
                                    "text": "「撞出火花无数」…这句不错！"
                                }
                            ]
                        },
                        {
                            "id": "413330211",
                            "text": "杏仁豆腐。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "4133303",
            "objective": "寻找第二处合适的景观点并<color=#00E1FFFF>拍照</color>",
            "dialogues": [
                {
                    "id": "413330301",
                    "speaker": "铁块儿",
                    "text": "嗯？你们什么时候来的，杏仁豆腐准备的怎么样？",
                    "choices": [
                        {
                            "id": "413330302",
                            "text": "准备好了"
                        },
                        {
                            "id": "413330303",
                            "text": "还需要一点时间…",
                            "response": [
                                {
                                    "id": "413330304",
                                    "speaker": "铁块儿",
                                    "text": "哎呀没事，我也得再想想这诗该咋写…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "4133304",
            "objective": "向铁块儿回报",
            "dialogues": []
        },
        {
            "id": "4133305",
            "objective": "将杏仁豆腐带给铁块儿",
            "dialogues": [
                {
                    "id": "413330501",
                    "speaker": "铁块儿",
                    "text": "这个看起来…倒也还行，我们这就去找紫微吧！"
                }
            ]
        },
        {
            "id": "4133306",
            "objective": "(隐藏)检测是不是带回了奇怪的杏仁豆腐$HIDDEN",
            "dialogues": [
                {
                    "id": "413330401",
                    "speaker": "铁块儿",
                    "text": "嗯…怎么感觉…闻起来就怪怪的…"
                },
                {
                    "id": "413330402",
                    "speaker": "铁块儿",
                    "text": "这怎么能端给紫微，你再帮我换份好的吧。"
                }
            ]
        },
        {
            "id": "4133307",
            "objective": "(隐藏)检测是不是带回了杏仁豆腐$HIDDEN",
            "dialogues": []
        },
        {
            "id": "4133308",
            "objective": "(隐藏)检测是不是带回了美味的杏仁豆腐$HIDDEN",
            "dialogues": [
                {
                    "id": "413330601",
                    "speaker": "铁块儿",
                    "text": "这个看着可真不错！这可真是万事俱备…只…只欠去找紫微了！"
                }
            ]
        },
        {
            "id": "4133309",
            "objective": "与铁块儿一起去找紫微",
            "dialogues": [
                {
                    "id": "413330701",
                    "speaker": "紫微",
                    "text": "这个角度…这个星座…好像一条狗啊…起什么名字好呢…"
                },
                {
                    "id": "413330702",
                    "speaker": "紫微",
                    "text": "哦，是铁块儿啊？你们找我有什么事么？"
                },
                {
                    "id": "413330703",
                    "speaker": "铁块儿",
                    "text": "呃…那个…就是…我在璃月港外面随便走了走，偶然发现了一个好地方…"
                },
                {
                    "id": "413330704",
                    "speaker": "紫微",
                    "text": "好地方？是观星的好地方吗？"
                },
                {
                    "id": "413330705",
                    "speaker": "铁块儿",
                    "text": "是，是观星的好地方，也是放霄灯的好地方。我霄灯都准备好了。"
                },
                {
                    "id": "413330706",
                    "speaker": "铁块儿",
                    "text": "你看，我在上面还写了…写了一首诗…"
                },
                {
                    "id": "413330707",
                    "speaker": "紫微",
                    "text": "「铁锹陨星一相逢，便撞出火花无数」…"
                },
                {
                    "id": "413330708",
                    "speaker": "紫微",
                    "text": "嗯…虽然我不知道你要许什么愿，但这诗是很有趣。"
                },
                {
                    "id": "413330709",
                    "speaker": "紫微",
                    "text": "不过霄灯上的愿望可不能提前让人家看到，不然会不灵的。"
                },
                {
                    "id": "413330710",
                    "speaker": "紫微",
                    "text": "然后，你今天来找我有什么事吗？"
                },
                {
                    "id": "413330711",
                    "speaker": "铁块儿",
                    "text": "我…",
                    "choices": [
                        {
                            "id": "413330712",
                            "text": "他找了个很合适放霄灯的地方。",
                            "response": [
                                {
                                    "id": "413330714",
                                    "speaker": "紫微",
                                    "text": "放霄灯？哦…抱歉，其实我正想找个霄灯少点的地方呢。"
                                },
                                {
                                    "id": "413330715",
                                    "speaker": "紫微",
                                    "text": "因为霄灯的光照有点影响观星，我打算再走远点…"
                                },
                                {
                                    "id": "413330716",
                                    "speaker": "紫微",
                                    "text": "谢谢你们的好意，我要再往那边走一走了，希望你们海灯节玩得开心。"
                                },
                                {
                                    "id": "413330717",
                                    "speaker": "铁块儿",
                                    "text": "啊…啊？",
                                    "choices": [
                                        {
                                            "id": "413330718",
                                            "text": "走掉了。",
                                            "response": [
                                                {
                                                    "id": "413330720",
                                                    "speaker": "铁块儿",
                                                    "text": "我…我没事，一定是我写得太隐晦了，紫微没有看懂。"
                                                },
                                                {
                                                    "id": "413330721",
                                                    "speaker": "铁块儿",
                                                    "text": "放心，我不会气馁的，总有一天…她会明白我的心意。"
                                                },
                                                {
                                                    "id": "413330722",
                                                    "speaker": "铁块儿",
                                                    "text": "旅行者，谢谢你帮我的忙，这些东西请你收下吧。"
                                                },
                                                {
                                                    "id": "413330723",
                                                    "speaker": "铁块儿",
                                                    "text": "唉，我至少要把这盏霄灯给放了…"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "413330719",
                                            "text": "不要气馁。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "413330713",
                            "text": "你要放霄灯的话，不如和他一起。"
                        }
                    ]
                }
            ]
        },
