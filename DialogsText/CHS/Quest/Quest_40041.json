    "talks": [
        {
            "id": "4004102",
            "objective": "",
            "dialogues": [
                {
                    "id": "400410201",
                    "speaker": "申鹤",
                    "text": "（test）申鹤来听说书瞭望风景，很不错，很喜欢。"
                },
                {
                    "id": "400410202",
                    "speaker": "Player",
                    "text": "（test）你最近过得怎么样？"
                },
                {
                    "id": "400410203",
                    "speaker": "申鹤",
                    "text": "（test）回忆了最近遇到的人。"
                },
                {
                    "id": "400410204",
                    "speaker": "申鹤",
                    "text": "（test）重云和行秋路过，寒暄几句离开。"
                },
                {
                    "id": "400410205",
                    "speaker": "申鹤",
                    "text": "（test）昨晚占了一卦，璃月港还有麻烦没有解决。这不，港口那边传来了骚乱，这就来了。"
                }
            ]
        },
        {
            "id": "4004103",
            "objective": "",
            "dialogues": [
                {
                    "id": "400410301",
                    "speaker": "大坤",
                    "text": "（test）近日来受孤云阁旋涡的影响，引起了港口海面的洋流变化，有不少民众反应过。"
                },
                {
                    "id": "400410302",
                    "speaker": "申鹤",
                    "text": "（test）我去看看。孤云阁海面不好过去，我带你们过去吧，准备好了来找我。"
                }
            ]
        },
        {
            "id": "4004104",
            "objective": "",
            "dialogues": [
                {
                    "id": "400410401",
                    "speaker": "申鹤",
                    "text": "（test）准备好了，那现在就过去吧。"
                }
            ]
        },
        {
            "id": "4004106",
            "objective": "",
            "dialogues": [
                {
                    "id": "400410601",
                    "speaker": "申鹤",
                    "text": "（test）以后还想来挑战，可以来找我。"
                }
            ]
        }
    ]
}