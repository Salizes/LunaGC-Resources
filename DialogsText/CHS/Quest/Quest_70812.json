            "dialogues": [
                {
                    "id": "708120601",
                    "speaker": "派蒙",
                    "text": "连告示牌都被吹到那么高的地方去了啊…"
                }
            ]
        },
        {
            "id": "7081207",
            "objective": "(test)进度回滚隔离$HIDDEN",
            "dialogues": [
                {
                    "id": "708120701",
                    "speaker": "派蒙",
                    "text": "这是冒险家协会的海报吧，我们拿上吧。"
                }
            ]
        },
        {
            "id": "7081208",
            "objective": "与阿拉米对话",
            "dialogues": [
                {
                    "id": "708120501",
                    "speaker": "阿拉米",
                    "text": "您都收拾好了吗？"
                },
                {
                    "id": "708120502",
                    "speaker": "Player",
                    "text": "都收拾好了。"
                },
                {
                    "id": "708120503",
                    "speaker": "阿拉米",
                    "text": "好的，太谢谢您了，这些海报我就收下了，稍后就还给对应的商家。"
                },
                {
                    "id": "708120504",
                    "speaker": "阿拉米",
                    "text": "那个告示牌…是天使的馈赠酒馆的吧，我已经通知了查尔斯，他会让人来拿回去的。"
                },
                {
                    "id": "708120505",
                    "speaker": "阿拉米",
                    "text": "谢谢您帮忙，这是一些酬劳，请您收下吧，我要继续处理其他事情了。"
                },
                {
                    "id": "708120506",
                    "speaker": "阿拉米",
                    "text": "风暴虽然停止了，但它对蒙德城造成的影响，一时半会可处理不完啊…"
                }
            ]
        },
        {
            "id": "7081204",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "708120401",
                    "speaker": "阿拉米",
                    "text": "大概有三张海报…和一个告示牌被风暴吹到了屋顶和城墙上。"
                },
                {
                    "id": "708120402",
                    "speaker": "阿拉米",
                    "text": "请您去把那三张海报赶紧拿下来给我吧。告示牌放在地上就行，我会让其他同僚把它还给商家的。"
                }
            ]
        }
    ]
