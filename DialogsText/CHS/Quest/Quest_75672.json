    "talks": [
        {
            "id": "7567201",
            "objective": "前往悠悠度假村",
            "dialogues": [
                {
                    "id": "756720101",
                    "speaker": "派蒙",
                    "text": "这里怎么有个蹦蹦跳跳的阿夏，还有…欸？班尼特？"
                },
                {
                    "id": "756720102",
                    "speaker": "班尼特",
                    "text": "#啊，是{NICKNAME}和派蒙！又见面了！"
                },
                {
                    "id": "756720103",
                    "speaker": "活跃的「阿夏」",
                    "text": "！"
                },
                {
                    "id": "756720104",
                    "speaker": "派蒙",
                    "text": "班尼特这是又回悠悠度假村来玩了吗？"
                },
                {
                    "id": "756720105",
                    "speaker": "班尼特",
                    "text": "#对呀，如果{NICKNAME}有印象的话，我之前写信告诉过你们——"
                },
                {
                    "id": "756720106",
                    "speaker": "班尼特",
                    "text": "前几个月，我准备了好久，拿下了不少报酬丰厚的委托，攒够了钱…"
                },
                {
                    "id": "756720107",
                    "speaker": "班尼特",
                    "text": "总算成功邀请老爹们和朋友们，来「悠悠度假村」尽情游玩了一番。"
                },
                {
                    "id": "756720108",
                    "speaker": "班尼特",
                    "text": "老爹们亲眼看见，我在纳塔几乎和倒霉绝缘，一个个都非常感动！"
                },
                {
                    "id": "756720109",
                    "speaker": "派蒙",
                    "text": "对哦，对班尼特来说这么好的事，确实要让大家都知道！",
                    "choices": [
                        {
                            "id": "756720110",
                            "text": "真是大好的消息！",
                            "response": [
                                {
                                    "id": "756720112",
                                    "speaker": "班尼特",
                                    "text": "要是再早一周遇见你们，说不定，大家还能聚个餐呢…"
                                },
                                {
                                    "id": "756720113",
                                    "speaker": "班尼特",
                                    "text": "嗯，那就等到你们之后回蒙德了，找个万无一失的地方，好好再吃一顿「安全冒险山洞晚饭」。"
                                },
                                {
                                    "id": "756720114",
                                    "speaker": "派蒙",
                                    "text": "等等？听班尼特的意思是，现在老爹们和朋友们都回去了，你独自留在度假村了？"
                                },
                                {
                                    "id": "756720115",
                                    "speaker": "班尼特",
                                    "text": "说来也有点巧，老爹们刚刚玩到尽兴，就得知了一个消息，猫尾酒馆的迪奥娜小姐之后会出差一段时间…"
                                },
                                {
                                    "id": "756720116",
                                    "speaker": "班尼特",
                                    "text": "为了多喝几杯特调，他们就没有延长假期，选择按计划准点回了蒙德。"
                                },
                                {
                                    "id": "756720117",
                                    "speaker": "班尼特",
                                    "text": "不过别担心，我留下的理由，也和意外延误，船票被偷什么的无关，而是碰见了需要帮助的朋友。"
                                },
                                {
                                    "id": "756720118",
                                    "speaker": "班尼特",
                                    "text": "我们在海边钓鱼的时候，发现了几位被叫做「调色家」的阿夏，它们正在犯难。"
                                },
                                {
                                    "id": "756720119",
                                    "speaker": "班尼特",
                                    "text": "凭借以前的经验，我大概能理解，它们想要寻找不同凡响的宝物…"
                                },
                                {
                                    "id": "756720120",
                                    "speaker": "派蒙",
                                    "text": "唔，既然被冠上了「调色家」的头衔，那对它们而言的宝物应该是…",
                                    "choices": [
                                        {
                                            "id": "756720121",
                                            "text": "超棒的颜料？",
                                            "response": [
                                                {
                                                    "id": "756720123",
                                                    "speaker": "班尼特",
                                                    "text": "是的！阿夏们除了到处涂鸦，还喜欢自己寻找颜料，用心收藏。"
                                                },
                                                {
                                                    "id": "756720124",
                                                    "speaker": "班尼特",
                                                    "text": "「调色家阿夏」们就在某座秘境里发现了非常特殊的品类…是一种游离的染色成分。"
                                                },
                                                {
                                                    "id": "756720125",
                                                    "speaker": "班尼特",
                                                    "text": "那些游离的色彩像晶蝶，会到处乱逃，「调色家」们一时不知该怎么处理…"
                                                },
                                                {
                                                    "id": "756720126",
                                                    "speaker": "派蒙",
                                                    "text": "这个好说，我们也来帮忙吧。去秘境里一看就能明白情况了。"
                                                },
                                                {
                                                    "id": "756720127",
                                                    "speaker": "派蒙",
                                                    "text": "说不定，我们以前搞定过类似的麻烦呢？",
                                                    "choices": [
                                                        {
                                                            "id": "756720128",
                                                            "text": "阿夏需要帮助，我义不容辞。",
                                                            "response": [
                                                                {
                                                                    "id": "756720130",
                                                                    "speaker": "「调色家阿夏」",
                                                                    "text": "！！"
                                                                },
                                                                {
                                                                    "id": "756720131",
                                                                    "speaker": "班尼特",
                                                                    "text": "那可太好了！我们一起来帮「调色家」，你们怎么做，我就跟着照做。"
                                                                },
                                                                {
                                                                    "id": "756720132",
                                                                    "speaker": "班尼特",
                                                                    "text": "希望这些阿夏能收集到最棒的颜料，调出特别漂亮的色彩，继续传递不一样的快乐！"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "756720129",
                                                            "text": "收集特别的东西，我们在行。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "756720122",
                                            "text": "贵重的颜料？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "756720111",
                            "text": "我每次听都很高兴！"
                        }
                    ]
                }
            ]
        }
    ]
}