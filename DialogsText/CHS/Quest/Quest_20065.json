    "talks": [
        {
            "id": "2006501",
            "objective": "与艾琳对话",
            "dialogues": [
                {
                    "id": "200650101",
                    "speaker": "艾琳",
                    "text": "伤脑筋…这里要怎么解决啊…"
                },
                {
                    "id": "200650102",
                    "speaker": "Player",
                    "text": "你在做什么呢？"
                },
                {
                    "id": "200650103",
                    "speaker": "艾琳",
                    "text": "为了下一次的骑士选拔，我正在训练呢。"
                },
                {
                    "id": "200650104",
                    "speaker": "艾琳",
                    "text": "唔…不过，我可没有琴大人那样的力量。"
                },
                {
                    "id": "200650105",
                    "speaker": "艾琳",
                    "text": "比起锻炼「力量」，我觉得学习「技巧」更适合我。"
                },
                {
                    "id": "200650106",
                    "speaker": "艾琳",
                    "text": "比如，一口气把这些木桩全部破坏掉的方法…"
                },
                {
                    "id": "200650107",
                    "speaker": "艾琳",
                    "text": "这些木桩可是很结实的，可不能掉以轻心…真是辛苦老爸了，也不知道他是从哪找到的。"
                }
            ]
        },
        {
            "id": "2006502",
            "objective": "在2秒内摧毁所有木桩",
            "dialogues": [
                {
                    "id": "200650201",
                    "speaker": "艾琳",
                    "text": "怎么样？想到好方法了吗？"
                },
                {
                    "id": "200650202",
                    "speaker": "Player",
                    "text": "还没有想好…"
                },
                {
                    "id": "200650203",
                    "speaker": "艾琳",
                    "text": "嗯…我之前遇见的冒险家，有些也偶尔会这样呢。"
                },
                {
                    "id": "200650204",
                    "speaker": "艾琳",
                    "text": "面对怪物时能利落地战斗，打木桩的时候却手忙脚乱。"
                },
                {
                    "id": "200650205",
                    "speaker": "艾琳",
                    "text": "而且还用各种手段加固木桩，就像生怕自己能轻松击碎一样…"
                },
                {
                    "id": "200650206",
                    "speaker": "艾琳",
                    "text": "这么想寻求挑战的话，直接去野外找强大的魔物不就好了吗？"
                }
            ]
        },
        {
            "id": "2006503",
            "objective": "与艾琳对话",
            "dialogues": [
                {
                    "id": "200650301",
                    "speaker": "艾琳",
                    "text": "做到了！"
                },
                {
                    "id": "200650302",
                    "speaker": "艾琳",
                    "text": "原来还能这么解决…这种方法我想都没想过。"
                },
                {
                    "id": "200650303",
                    "speaker": "艾琳",
                    "text": "谢谢你，我自己去再试试看！"
                }
            ]
        }
    ]
}