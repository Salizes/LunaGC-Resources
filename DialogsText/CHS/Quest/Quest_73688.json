    "talks": [
        {
            "id": "7368801",
            "objective": "听取比赛的最终结果",
            "dialogues": [
                {
                    "id": "736880101",
                    "speaker": "晓月左卫门十藏",
                    "text": "阁下武艺精湛，这场较量在下输得心服口服。"
                },
                {
                    "id": "736880102",
                    "speaker": "Player",
                    "text": "承让了。"
                },
                {
                    "id": "736880103",
                    "speaker": "玲菜",
                    "text": "#各位观众，经过刚才令人热血沸腾的一战，本届「演武传心剑道大赛」的冠军已经产生，那就是——{NICKNAME}！"
                },
                {
                    "id": "736880104",
                    "speaker": "玲菜",
                    "text": "#明天，我们将迎来最后的表演赛环节：由{NICKNAME}与神里小姐一起，迎战将军大人的特使，人形机关剑士「魔偶剑豪」。"
                },
                {
                    "id": "736880105",
                    "speaker": "玲菜",
                    "text": "各位，我们届时不见不散！"
                },
                {
                    "id": "736880106",
                    "speaker": "神里绫华",
                    "text": "旅行者，真是一场精彩的比赛。"
                },
                {
                    "id": "736880107",
                    "speaker": "柊千里",
                    "text": "恭喜你旅行者，这个冠军颁给你的确是实至名归。"
                },
                {
                    "id": "736880108",
                    "speaker": "派蒙",
                    "text": "只是没想到明天的对手竟然是「魔偶剑豪」，这个名字听起来和我们在八酝岛野外遇到的那个家伙很像，总感觉不太好对付呢。"
                },
                {
                    "id": "736880109",
                    "speaker": "神里绫华",
                    "text": "派蒙不用担心，虽然特使的实力强劲，但明天的比赛并不限制使用神之眼，我们还是拿回了一些主动权。"
                },
                {
                    "id": "736880110",
                    "speaker": "神里绫华",
                    "text": "而且，只要我们见招拆招，总能找到还击的机会。"
                },
                {
                    "id": "736880111",
                    "speaker": "派蒙",
                    "text": "绫华这么说我就放心多了！"
                },
                {
                    "id": "736880112",
                    "speaker": "神里绫华",
                    "text": "最终能不能取胜，我其实也并无把握。但只有尽全力战斗，才能为观众们呈现出最精彩的表演。",
                    "choices": [
                        {
                            "id": "736880113",
                            "text": "我们一定能获胜的，绫华。",
                            "response": [
                                {
                                    "id": "736880115",
                                    "speaker": "柊千里",
                                    "text": "你们两个可真有干劲呢，那今天晚上可要好好休息，养精蓄锐。"
                                },
                                {
                                    "id": "736880116",
                                    "speaker": "派蒙",
                                    "text": "嗯，明天一觉醒来就能看到绫华的新衣服了。穿着枫丹服饰的绫华…哎呀，好期待。"
                                },
                                {
                                    "id": "736880117",
                                    "speaker": "神里绫华",
                                    "text": "唔，这个…",
                                    "choices": [
                                        {
                                            "id": "736880118",
                                            "text": "我也是。",
                                            "response": [
                                                {
                                                    "id": "736880119",
                                                    "speaker": "神里绫华",
                                                    "text": "怎么旅行者你也…"
                                                },
                                                {
                                                    "id": "736880121",
                                                    "speaker": "柊千里",
                                                    "text": "#好啦绫华小姐，你就满足{M#他们}{F#她们}的期待吧，如果不是因为明天我有事在身，我都想一起来看呢。"
                                                },
                                                {
                                                    "id": "736880122",
                                                    "speaker": "神里绫华",
                                                    "text": "嗯，那就这样说好了。明天早上，我在神里屋敷等你们。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "736880120",
                                            "text": "需要我来接你吗？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "736880114",
                            "text": "我们一定能奉献一场精彩的比赛。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7368802",
            "objective": "等待至第二天上午（5点~12点）",
            "dialogues": [
                {
                    "id": "736880201",
                    "speaker": "宏达",
                    "text": "二位，你们来了。"
                },
                {
                    "id": "736880202",
                    "speaker": "派蒙",
                    "text": "呃啊，竟然是宏达！"
                },
                {
                    "id": "736880203",
                    "speaker": "派蒙",
                    "text": "#前几天的比赛{NICKNAME}已经赢了你，而且还拿了冠军，你现在还有什么话说！"
                },
                {
                    "id": "736880204",
                    "speaker": "宏达",
                    "text": "请放心，我并非是来挑剔二位的，而是来道歉的。旅行者，几天前与你的一战，我输得心服口服。"
                },
                {
                    "id": "736880205",
                    "speaker": "宏达",
                    "text": "阁下剑术精湛，出招犀利却不咄咄逼人，足见品性。之前我错判了阁下的为人，言行对你多有冒犯，还请你见谅。",
                    "choices": [
                        {
                            "id": "736880206",
                            "text": "没关系，我并不在意。",
                            "response": [
                                {
                                    "id": "736880208",
                                    "speaker": "宏达",
                                    "text": "二位今天是来接神里小姐的吧？小姐现在正在室内整理着装，应该很快就会出来。"
                                },
                                {
                                    "id": "736880209",
                                    "speaker": "宏达",
                                    "text": "旅行者，趁小姐来之前，我有个不情之请，希望您能答应。"
                                },
                                {
                                    "id": "736880210",
                                    "speaker": "Player",
                                    "text": "好的，请讲。"
                                },
                                {
                                    "id": "736880211",
                                    "speaker": "宏达",
                                    "text": "小姐她虽然从没有对我们这些家臣提过今天的表演赛，但最近小姐每天无论多忙，晚上一定会抽出几个时辰练习剑术。"
                                },
                                {
                                    "id": "736880212",
                                    "speaker": "宏达",
                                    "text": "小姐向来勤勉认真，虽说今天是表演赛，不取胜也无妨，但按照小姐的心性，一定会全力以赴，忘我奋战。"
                                },
                                {
                                    "id": "736880213",
                                    "speaker": "宏达",
                                    "text": "身为家臣，我当然相信小姐的实力，只不过…还是希望你能在赛场上支援小姐，保护小姐的安全。"
                                },
                                {
                                    "id": "736880214",
                                    "speaker": "Player",
                                    "text": "请放心吧，我一定会的。"
                                },
                                {
                                    "id": "736880215",
                                    "speaker": "宏达",
                                    "text": "旅行者，那小姐就拜托你了。"
                                },
                                {
                                    "id": "736880217",
                                    "speaker": "派蒙",
                                    "text": "喔，应该是绫华出来了吧！"
                                },
                                {
                                    "id": "736880218",
                                    "speaker": "派蒙",
                                    "text": "哇…"
                                },
                                {
                                    "id": "736880219",
                                    "speaker": "神里绫华",
                                    "text": "咦，怎么了，你们两个都这样一言不发…是这身装扮有哪里不妥吗？"
                                },
                                {
                                    "id": "736880220",
                                    "speaker": "派蒙",
                                    "text": "不是的！绫华，你这样真好看…有种眼前一亮的感觉！",
                                    "choices": [
                                        {
                                            "id": "736880221",
                                            "text": "这个造型很适合你。",
                                            "response": [
                                                {
                                                    "id": "736880222",
                                                    "speaker": "派蒙",
                                                    "text": "对呀对呀，看起来就像是枫丹的大小姐，气质也活泼了不少！"
                                                },
                                                {
                                                    "id": "736880223",
                                                    "speaker": "神里绫华",
                                                    "text": "真的吗？我还担心会不会有点过于俏皮…我不一定能驾驭住这种风格。"
                                                },
                                                {
                                                    "id": "736880224",
                                                    "speaker": "神里绫华",
                                                    "text": "不过既然你们都觉得还不错，我就放心了。"
                                                },
                                                {
                                                    "id": "736880229",
                                                    "speaker": "派蒙",
                                                    "text": "嘻嘻，待会儿大家看到绫华的时候，一定也会觉得很惊喜。"
                                                },
                                                {
                                                    "id": "736880230",
                                                    "speaker": "神里绫华",
                                                    "text": "谢谢你的夸奖，派蒙。旅行者，既然已经准备妥当，我们就出发去赛场吧。"
                                                },
                                                {
                                                    "id": "736880231",
                                                    "speaker": "宏达",
                                                    "text": "小姐，旅行者，请慢走。祝你们表演赛一切顺利。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "736880225",
                                            "text": "很漂亮的服装，非常合身。",
                                            "response": [
                                                {
                                                    "id": "736880226",
                                                    "speaker": "派蒙",
                                                    "text": "对呀对呀，仔细看的话，在裙摆上还绣上了你们神里家的椿纹呢！"
                                                },
                                                {
                                                    "id": "736880227",
                                                    "speaker": "神里绫华",
                                                    "text": "嗯，这是小野寺先生他们在这几天里找人赶制出来的，听说是根据观众们写在投票上的建议加上的。"
                                                },
                                                {
                                                    "id": "736880228",
                                                    "speaker": "神里绫华",
                                                    "text": "这套衣服裁剪得非常合身，活动起来也比想象中要自由。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "736880207",
                            "text": "和你那场战斗我也很尽兴。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7368803",
            "objective": "前往神里屋敷",
            "dialogues": []
        },
        {
            "id": "7368804",
            "objective": "前往赛场",
            "dialogues": [
                {
                    "id": "736880401",
                    "speaker": "派蒙",
                    "text": "#{NICKNAME}，绫华，我们在这里呢！"
                },
                {
                    "id": "736880402",
                    "speaker": "柊千里",
                    "text": "真是一场精彩的比赛，即使我不怎么懂剑术，也完全被赛场上紧张的气氛感染了，都过了这么久，心脏还在扑通扑通直跳呢。"
                },
                {
                    "id": "736880403",
                    "speaker": "派蒙",
                    "text": "是呀，好几次敌人的出招都吓了我一大跳，但你们两个却像是早有防备似的，一下子就轻松化解了。"
                },
                {
                    "id": "736880404",
                    "speaker": "九条裟罗",
                    "text": "旅行者，神里小姐，祝贺你们获得了表演赛的胜利。"
                },
                {
                    "id": "736880405",
                    "speaker": "派蒙",
                    "text": "哇，是裟罗，原来你也来看比赛了。"
                },
                {
                    "id": "736880406",
                    "speaker": "九条裟罗",
                    "text": "我奉将军大人之命，前来见证这场赛事。二位剑术精湛，配合默契，不仅向观众们展现了剑道之美，也让我受教良多。"
                },
                {
                    "id": "736880407",
                    "speaker": "神里绫华",
                    "text": "您过奖了。"
                },
                {
                    "id": "736880408",
                    "speaker": "九条裟罗",
                    "text": "几位从赛事筹备之初就在不停奔忙，今天又为演武传心划上了完美的句号，这些付出将军大人都看在眼里。"
                },
                {
                    "id": "736880409",
                    "speaker": "九条裟罗",
                    "text": "接下来，我会回天守阁，向将军大人如实禀报这次表演赛的情况。诸位，我就先告辞了。"
                },
                {
                    "id": "736880411",
                    "speaker": "柊千里",
                    "text": "对了，大家接下来有什么打算，不如到乌有亭去开庆功宴怎么样？"
                },
                {
                    "id": "736880412",
                    "speaker": "派蒙",
                    "text": "太好啦！这些天每天都在想比赛的事，好久没有好好吃顿饭了！我们快走吧。"
                },
                {
                    "id": "736880413",
                    "speaker": "神里绫华",
                    "text": "呼…"
                },
                {
                    "id": "736880414",
                    "speaker": "Player",
                    "text": "怎么了，绫华？"
                },
                {
                    "id": "736880415",
                    "speaker": "神里绫华",
                    "text": "没什么，只是现在我才渐渐有了一些赢得比赛的实感。九条裟罗小姐刚才说，这场比赛让她受教良多，其实我也是一样。"
                },
                {
                    "id": "736880416",
                    "speaker": "神里绫华",
                    "text": "虽然旁人在台下可能没有察觉，但我知道，刚才很多次我能够化险为夷，都是因为有你在旁边，适时引开了对手的攻击。"
                },
                {
                    "id": "736880417",
                    "speaker": "神里绫华",
                    "text": "如果没有你在身边，仅凭我一个人，肯定是无法取得胜利的。果然在剑术的造诣上，我还远远比不上你。",
                    "choices": [
                        {
                            "id": "736880418",
                            "text": "绫华也帮了我很多次。",
                            "response": [
                                {
                                    "id": "736880420",
                                    "speaker": "神里绫华",
                                    "text": "真的吗？听你这么说，现在突然很想和你比一场了呢。"
                                },
                                {
                                    "id": "736880421",
                                    "speaker": "神里绫华",
                                    "text": "不瞒你说，自从我认识你以来，就一直希望能有机会和你好好切磋武艺。今天在表演赛上，这个愿望大概算是实现了一半。"
                                },
                                {
                                    "id": "736880422",
                                    "speaker": "Player",
                                    "text": "下次找个时间，让我们一决胜负。"
                                },
                                {
                                    "id": "736880423",
                                    "speaker": "神里绫华",
                                    "text": "好。但…在此之前，你要好好保管好自己的佩剑哦？如果哪天被我偷走了，你的性命，也就交到我的手上啦。"
                                },
                                {
                                    "id": "736880424",
                                    "speaker": "神里绫华",
                                    "text": "嘿嘿…我一直很想说说看这种句子，应该不会很奇怪吧？",
                                    "choices": [
                                        {
                                            "id": "736880425",
                                            "text": "很像奥西兹小姐。",
                                            "response": [
                                                {
                                                    "id": "736880427",
                                                    "speaker": "派蒙",
                                                    "text": "喂，你们两个人走得那么慢，又凑在一起说什么呢？"
                                                },
                                                {
                                                    "id": "736880428",
                                                    "speaker": "神里绫华",
                                                    "text": "我们刚才说，要找个时间来比赛一场，看看我们谁的剑术更胜一筹。"
                                                },
                                                {
                                                    "id": "736880429",
                                                    "speaker": "派蒙",
                                                    "text": "#哇，绫华对剑术的事好认真啊。不过你和{NICKNAME}不是朋友吗，竟然还要比啊？"
                                                },
                                                {
                                                    "id": "736880430",
                                                    "speaker": "神里绫华",
                                                    "text": "正因为是朋友，才应经常切磋，互相勉励才是。"
                                                },
                                                {
                                                    "id": "736880431",
                                                    "speaker": "派蒙",
                                                    "text": "喔，这么一说还挺有道理的。"
                                                },
                                                {
                                                    "id": "736880432",
                                                    "speaker": "神里绫华",
                                                    "text": "旅行者，刚刚的话，替我保密哦。"
                                                },
                                                {
                                                    "id": "736880433",
                                                    "speaker": "派蒙",
                                                    "text": "嗯？绫华你刚刚说了什么吗？"
                                                },
                                                {
                                                    "id": "736880434",
                                                    "speaker": "神里绫华",
                                                    "text": "没什么，我们赶快走吧。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "736880426",
                                            "text": "很可爱。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "736880419",
                            "text": "绫华过分谦虚了。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7368808",
            "objective": "进入赛场",
            "dialogues": [
                {
                    "id": "736880801",
                    "speaker": "玲菜",
                    "text": "大家都很期待这场表演赛，加油啊，旅行者！"
                }
            ]
        },
        {
            "id": "7368807",
            "objective": "准备开始表演赛",
            "dialogues": [
                {
                    "id": "736881101",
                    "speaker": "神里绫华",
                    "text": "(test)战斗前演出对话"
                }
            ]
        },
        {
            "id": "7368805",
            "objective": "战胜魔偶剑豪",
            "dialogues": [
                {
                    "id": "736880501",
                    "speaker": "由宇",
                    "text": "往届的「代神使」穿的都是传统服饰，今天还真是不一样。"
                }
            ]
        },
        {
            "id": "7368809",
            "objective": "战胜魔偶剑豪",
            "dialogues": [
                {
                    "id": "736880901",
                    "speaker": "神里绫华",
                    "text": "旅行者，你准备好了吗？",
                    "choices": [
                        {
                            "id": "736880902",
                            "text": "没问题，我们走吧。",
                            "response": [
                                {
                                    "id": "736880903",
                                    "speaker": "神里绫华",
                                    "text": "好，接下来的战斗，就请你多关照了。"
                                }
                            ]
                        },
                        {
                            "id": "736880904",
                            "text": "我还需要再准备一下。",
                            "response": [
                                {
                                    "id": "736880905",
                                    "speaker": "神里绫华",
                                    "text": "别着急，现在还有些时间，等你一切处理妥当，我们再一起进入赛场。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7368806",
            "objective": "与神里绫华对话",
            "dialogues": []
        },
        {
            "id": "7368803",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "736880301",
                    "speaker": "由宇",
                    "text": "你们看，是神里小姐和旅行者来了！"
                },
                {
                    "id": "736880302",
                    "speaker": "纱江",
                    "text": "虽然之前在小说的插图里见过这套服装，但穿在神里小姐身上，却有种很独特的风采。"
                },
                {
                    "id": "736880303",
                    "speaker": "松前",
                    "text": "不枉我一大早就来排队，抢到了表演赛第一排的位置，今天的比赛一定会很精彩！"
                },
                {
                    "id": "736880304",
                    "speaker": "派蒙",
                    "text": "哇，果然绫华一出现，就成为大家的注目焦点了。"
                },
                {
                    "id": "736880305",
                    "speaker": "玲菜",
                    "text": "各位观众，请大家安静，「演武传心」表演赛马上就要开始了，请各位有序进入赛场入座。"
                },
                {
                    "id": "736880306",
                    "speaker": "玲菜",
                    "text": "神里小姐，旅行者，你们二位也请跟我一起进去吧。"
                },
                {
                    "id": "736880307",
                    "speaker": "神里绫华",
                    "text": "旅行者，你准备好了吗？",
                    "choices": [
                        {
                            "id": "736880308",
                            "text": "没问题，我们走吧。",
                            "response": [
                                {
                                    "id": "736880309",
                                    "speaker": "神里绫华",
                                    "text": "好，接下来的战斗，就请你多关照了。"
                                }
                            ]
                        },
                        {
                            "id": "736880310",
                            "text": "我还需要再准备一下。",
                            "response": [
                                {
                                    "id": "736880311",
                                    "speaker": "神里绫华",
                                    "text": "别着急，现在还有些时间，等你一切处理妥当，我们再一起进入赛场。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7368806",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "736880601",
                    "speaker": "纱江",
                    "text": "「神里流」对阵「魔偶剑豪」，而且还有大赛冠军一起战斗，这张票买得太值了！"
                }
            ]
        },
        {
            "id": "7368807",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "736880701",
                    "speaker": "松前",
                    "text": "穿着枫丹服饰的绫华会有怎么样的风采呢…"
                }
            ]
        },
        {
            "id": "7368810",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "736881001",
                    "speaker": "宏达",
                    "text": "小姐这身衣服很好看，能看出她自己也十分喜欢。"
                },
                {
                    "id": "736881002",
                    "speaker": "宏达",
                    "text": "比赛在即，看到你和小姐两人都神色自若，我就放心了。"
                }
            ]
        },
        {
            "id": "7368899",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "736889901",
                    "speaker": "派蒙",
                    "text": "时间差不多啦，我们快去神里屋敷接绫华吧！等了这么久，总算能看到绫华穿上表演服的样子了！"
                },
                {
                    "id": "736889902",
                    "speaker": "神里绫华",
                    "text": "这种压迫感…不愧是将军大人指定的特使。"
                },
                {
                    "id": "736889903",
                    "speaker": "神里绫华",
                    "text": "但有我与旅行者二人联手，这场比赛我们一定会胜利，来吧。"
                }
            ]
        }
    ]
}