    "talks": [
        {
            "id": "7500501",
            "objective": "",
            "dialogues": [
                {
                    "id": "750050101",
                    "speaker": "派蒙",
                    "text": "#{NICKNAME}，你看，这里有一道被封印的大门！"
                },
                {
                    "id": "750050102",
                    "speaker": "派蒙",
                    "text": "哼哼，我有种直觉，刚才我们在附近拿到的几个奇怪东西，一定和开启大门有关。"
                },
                {
                    "id": "750050103",
                    "speaker": "派蒙",
                    "text": "真奇怪，这道门的背后会是什么地方呢？"
                },
                {
                    "id": "750050104",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "呀！",
                    "choices": [
                        {
                            "id": "750050105",
                            "text": "也许是怪物的巢穴…",
                            "response": [
                                {
                                    "id": "750050106",
                                    "speaker": "派蒙",
                                    "text": "哇…有怪物的地方，一定会有宝藏的吧？"
                                },
                                {
                                    "id": "750050107",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "呀！"
                                },
                                {
                                    "id": "750050108",
                                    "speaker": "Player",
                                    "text": "那可不一定哦。"
                                },
                                {
                                    "id": "750050109",
                                    "speaker": "派蒙",
                                    "text": "哼，少说丧气话啦，我们进去看看不就知道了！"
                                },
                                {
                                    "id": "750050115",
                                    "speaker": "？？？",
                                    "text": "喂，两位异邦人！唔…还有一只系着丝巾的小嵴锋龙。"
                                },
                                {
                                    "id": "750050116",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "唔？"
                                },
                                {
                                    "id": "750050117",
                                    "speaker": "？？？",
                                    "text": "哎呀，精神的小家伙，你没告诉他们：封印之所以是封印，就因为这里是「禁地」吗？"
                                },
                                {
                                    "id": "750050118",
                                    "speaker": "？？？",
                                    "text": "哦，除了深远的诅咒，你们在里面找不到任何东西的。"
                                },
                                {
                                    "id": "750050119",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "唔…"
                                },
                                {
                                    "id": "750050120",
                                    "speaker": "派蒙",
                                    "text": "也就是说…没有宝藏？"
                                },
                                {
                                    "id": "750050121",
                                    "speaker": "？？？",
                                    "text": "宝藏嘛…大概也是有的。"
                                },
                                {
                                    "id": "750050122",
                                    "speaker": "Player",
                                    "text": "大概？"
                                },
                                {
                                    "id": "750050123",
                                    "speaker": "？？？",
                                    "text": "不过那就不是异邦人该染指的东西了，那扇被封印的门后既是「禁地」也是「圣地」。"
                                },
                                {
                                    "id": "750050124",
                                    "speaker": "？？？",
                                    "text": "平时只有来经受考验的讯使在完成试炼，拿到资格之后才得以进入，据说里面存放着远古的先民与夜晚的世界沟通的媒介…"
                                },
                                {
                                    "id": "750050125",
                                    "speaker": "？？？",
                                    "text": "这么说来，我只是稍微有事离开了一小会儿，你们就取得了证明试炼完成的三枚钥石？这还真是不得了啊…"
                                },
                                {
                                    "id": "750050126",
                                    "speaker": "派蒙",
                                    "text": "嘿嘿，爬高下低，找东西啊，这种活我们可擅长了！"
                                },
                                {
                                    "id": "750050127",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "呀！"
                                },
                                {
                                    "id": "750050128",
                                    "speaker": "？？？",
                                    "text": "即使是部族的讯使看来也没有你们这般矫健的身手。这样，虽然部族的禁地肯定是没法让你们进去，不过，我的营地就在附近。"
                                },
                                {
                                    "id": "750050129",
                                    "speaker": "？？？",
                                    "text": "就让我招待你们垫补下肚子，再休息一会儿，怎么样？"
                                },
                                {
                                    "id": "750050130",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "唔…",
                                    "choices": [
                                        {
                                            "id": "750050131",
                                            "text": "我们还不饿。",
                                            "response": [
                                                {
                                                    "id": "750050132",
                                                    "speaker": "派蒙",
                                                    "text": "我也…！唔，我是有点饿啦…要不然，我们就去休息一下吧？"
                                                },
                                                {
                                                    "id": "750050133",
                                                    "speaker": "Player",
                                                    "text": "真拿你没办法。"
                                                },
                                                {
                                                    "id": "750050134",
                                                    "speaker": "派蒙",
                                                    "text": "嘿嘿…我还在长身体嘛！"
                                                },
                                                {
                                                    "id": "750050139",
                                                    "speaker": "？？？",
                                                    "text": "噗嗤…你们关系还真好呢。走吧，去我的营地那儿歇息一会儿。"
                                                },
                                                {
                                                    "id": "750050140",
                                                    "speaker": "？？？",
                                                    "text": "我会准备些热乎的食物，远方的来客，说不定我们有很多话题可以聊聊。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "750050135",
                                            "text": "既然来都来了…",
                                            "response": [
                                                {
                                                    "id": "750050136",
                                                    "speaker": "派蒙",
                                                    "text": "没关系，你休息，我放哨！"
                                                },
                                                {
                                                    "id": "750050137",
                                                    "speaker": "Player",
                                                    "text": "你只会睡得比我还熟吧…"
                                                },
                                                {
                                                    "id": "750050138",
                                                    "speaker": "派蒙",
                                                    "text": "喂——！别太小看我啦！"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "750050110",
                            "text": "也许是藏宝的洞窟…",
                            "response": [
                                {
                                    "id": "750050111",
                                    "speaker": "派蒙",
                                    "text": "哇！我的直觉也是这样，里面一定是藏宝的洞窟没错啦！"
                                },
                                {
                                    "id": "750050112",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "呀！"
                                },
                                {
                                    "id": "750050113",
                                    "speaker": "Player",
                                    "text": "不要太兴奋啦。"
                                },
                                {
                                    "id": "750050114",
                                    "speaker": "派蒙",
                                    "text": "里面有什么，进去看看就知道了！我们先把这道大门打开吧！嘿嘿，宝藏，宝藏，我们来咯！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7500502",
            "objective": "",
            "dialogues": [
                {
                    "id": "750050201",
                    "speaker": "？？？",
                    "text": "不必客气，你们随意吧。要不要尝尝我的手艺？"
                },
                {
                    "id": "750050202",
                    "speaker": "？？？",
                    "text": "如果想自己做的话，那边的箱子里有食谱。还有些我用不上的东西，你可以翻一翻。"
                },
                {
                    "id": "750050203",
                    "speaker": "派蒙",
                    "text": "欸？你还随身准备着食谱吗？"
                },
                {
                    "id": "750050204",
                    "speaker": "？？？",
                    "text": "我自己画的，画了好几份。说不定谁能用得上。如果遇到需要解救的人，也能拿来救命呢。你说是吧？"
                },
                {
                    "id": "750050205",
                    "speaker": "派蒙",
                    "text": "哇，你想得还真周到…"
                },
                {
                    "id": "750050206",
                    "speaker": "？？？",
                    "text": "毕竟在部族外面，你只能自己靠自己了。"
                },
                {
                    "id": "750050207",
                    "speaker": "Player",
                    "text": "对了，我们还没问过你的名字？"
                },
                {
                    "id": "750050208",
                    "speaker": "雷格巴",
                    "text": "我的名字？哈！雷格巴吧，叫我雷格巴就好。那么你们呢，朋友？"
                },
                {
                    "id": "750050209",
                    "speaker": "Black Screen",
                    "text": "向雷格巴作了自我介绍。"
                },
                {
                    "id": "750050210",
                    "speaker": "雷格巴",
                    "text": "#派蒙，{NICKNAME}，还有小嵴锋龙{REALNAME[ID(2)|SHOWHOST(true)]}…你们在纳塔相遇，真是奇妙的缘分。"
                },
                {
                    "id": "750050211",
                    "speaker": "雷格巴",
                    "text": "#话说回来，{NICKNAME}。你们在部族的禁地附近做什么？嗯？寻宝？打探秘密？",
                    "choices": [
                        {
                            "id": "750050212",
                            "text": "当然是寻宝啦。",
                            "response": [
                                {
                                    "id": "750050213",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "呀！"
                                },
                                {
                                    "id": "750050214",
                                    "speaker": "派蒙",
                                    "text": "嗯嗯！这种被保护得很好的地方，总有可能藏着宝贝吧！"
                                },
                                {
                                    "id": "750050220",
                                    "speaker": "雷格巴",
                                    "text": "总之，不要对那里动歪心思了，外来人。我是不会让你们进去的。"
                                },
                                {
                                    "id": "750050221",
                                    "speaker": "雷格巴",
                                    "text": "那里是古老的先人与夜晚重新建立起联系的地方，自那以后，越来越多的部族人才能步入「夜神之国」的门扉。"
                                },
                                {
                                    "id": "750050222",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "嗯?"
                                },
                                {
                                    "id": "750050223",
                                    "speaker": "派蒙",
                                    "text": "「夜神之国」到底是个什么样的地方啊？"
                                },
                                {
                                    "id": "750050224",
                                    "speaker": "雷格巴",
                                    "text": "哈哈，据说那是所有纳塔人在离开这个世界才会前往的地方…只有少数人有从那里返回的经历。"
                                },
                                {
                                    "id": "750050225",
                                    "speaker": "雷格巴",
                                    "text": "据说那是个流水犹如荧光，伫立着巨大黑曜石碑之处。比起部族的禁地，「夜神之国」才是你们最好不要好奇的地方…"
                                },
                                {
                                    "id": "750050226",
                                    "speaker": "派蒙",
                                    "text": "所以，你之前说的，下面的那个…和夜晚世界沟通的…"
                                },
                                {
                                    "id": "750050227",
                                    "speaker": "雷格巴",
                                    "text": "媒介，对，就是以前的人和「大灵」…也是来自「夜神之国」的使者接触的古老道具…"
                                },
                                {
                                    "id": "750050228",
                                    "speaker": "派蒙",
                                    "text": "哇，古老的道具…"
                                },
                                {
                                    "id": "750050229",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "呀！"
                                },
                                {
                                    "id": "750050230",
                                    "speaker": "雷格巴",
                                    "text": "…或许我说的有点多了。总之，在部族人与「夜神之国」建立稳定联系的现在，早已不用媒介，而且在我看来手段实在简陋。"
                                },
                                {
                                    "id": "750050231",
                                    "speaker": "雷格巴",
                                    "text": "但那好歹也是人类部族的圣物。"
                                },
                                {
                                    "id": "750050232",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "唔…嗯！"
                                },
                                {
                                    "id": "750050233",
                                    "speaker": "派蒙",
                                    "text": "好吧、好吧…我知道了！"
                                },
                                {
                                    "id": "750050234",
                                    "speaker": "雷格巴",
                                    "text": "对，不要去禁地，那样才是真正正确的做法。"
                                },
                                {
                                    "id": "750050235",
                                    "speaker": "雷格巴",
                                    "text": "哈！哈！你们的伙伴很聪明，是个非常聪明的孩子。"
                                },
                                {
                                    "id": "750050236",
                                    "speaker": "雷格巴",
                                    "text": "我曾经也有许多伙伴…许多很聪明的孩子。但现在，我孑然一身，离群索居已久了…"
                                },
                                {
                                    "id": "750050237",
                                    "speaker": "雷格巴",
                                    "text": "咳咳…啊，没想到天色已经如此之深了。"
                                },
                                {
                                    "id": "750050238",
                                    "speaker": "派蒙",
                                    "text": "哈啊…听了好多半懂不懂的东西，我也发困了呢…"
                                },
                                {
                                    "id": "750050239",
                                    "speaker": "雷格巴",
                                    "text": "哎，都怪我，偶尔遇见能说话的人，就变得喋喋不休了…这样，如果你们不嫌弃的话，就在这里休息一晚吧。"
                                },
                                {
                                    "id": "750050240",
                                    "speaker": "雷格巴",
                                    "text": "我来为你们准备床铺。反正夜里我也得在附近巡逻，不必担心安全的问题。"
                                },
                                {
                                    "id": "750050241",
                                    "speaker": "派蒙",
                                    "text": "哇，好贴心！那就谢谢你啦！"
                                },
                                {
                                    "id": "750050242",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "唔…"
                                },
                                {
                                    "id": "750050243",
                                    "speaker": "Black Screen",
                                    "text": "在温暖的草榻上躺下，伴着闪烁的营火，你很快便陷入了梦乡…\\n不过你总觉得耳边有细碎而嘈杂的声响，令你无法沉入深眠。"
                                },
                                {
                                    "id": "750050244",
                                    "speaker": "Black Screen",
                                    "text": "直到——\\n直到脸颊旁冰凉湿润的触感突然袭来，将你带离了粘稠黑暗的夜梦…"
                                },
                                {
                                    "id": "750050245",
                                    "speaker": "Black Screen",
                                    "text": "#你睁开双眼，{REALNAME[ID(2)|SHOWHOST(true)]}熟悉而友好的面孔占据了你的视野。\\n或许刚才是它在舔舐你，试图将你唤醒。\\n又过了片刻，你才注意到，它似乎正试图给你展示什么东西——一座奇特的黑曜石像…"
                                },
                                {
                                    "id": "750050246",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "呀！",
                                    "choices": [
                                        {
                                            "id": "750050247",
                                            "text": "这是你找到的吗？",
                                            "response": [
                                                {
                                                    "id": "750050248",
                                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                                    "text": "呀…呀！"
                                                },
                                                {
                                                    "id": "750050252",
                                                    "speaker": "派蒙",
                                                    "text": "唔…这个东西看起来好瘆人，太不吉利啦…",
                                                    "choices": [
                                                        {
                                                            "id": "750050253",
                                                            "text": "派蒙还讲究吉利吗？",
                                                            "response": [
                                                                {
                                                                    "id": "750050254",
                                                                    "speaker": "派蒙",
                                                                    "text": "我只是照实说我的感觉啦…看着就不像什么好东西。"
                                                                },
                                                                {
                                                                    "id": "750050257",
                                                                    "speaker": "派蒙",
                                                                    "text": "#不过，话说回来！{REALNAME[ID(2)|SHOWHOST(true)]}一定是趁我们睡觉的时候出去乱跑了！我说的对不对呀？"
                                                                },
                                                                {
                                                                    "id": "750050258",
                                                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                                                    "text": "呜呜…"
                                                                },
                                                                {
                                                                    "id": "750050259",
                                                                    "speaker": "派蒙",
                                                                    "text": "真难办，这个东西是从哪里捡来的…会不会是很危险、很脏的地方呀！"
                                                                },
                                                                {
                                                                    "id": "750050260",
                                                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                                                    "text": "唔…"
                                                                },
                                                                {
                                                                    "id": "750050261",
                                                                    "speaker": "雷格巴",
                                                                    "text": "#{REALNAME[ID(2)|SHOWHOST(true)]}？{NICKNAME}！小派蒙！"
                                                                },
                                                                {
                                                                    "id": "750050262",
                                                                    "speaker": "派蒙",
                                                                    "text": "我们还在这里呢，怎么啦！"
                                                                },
                                                                {
                                                                    "id": "750050263",
                                                                    "speaker": "雷格巴",
                                                                    "text": "#我听到{REALNAME[ID(2)|SHOWHOST(true)]}的叫声就赶过来了。发生什么事了？"
                                                                },
                                                                {
                                                                    "id": "750050264",
                                                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                                                    "text": "呀！"
                                                                },
                                                                {
                                                                    "id": "750050265",
                                                                    "speaker": "雷格巴",
                                                                    "text": "这个…这是…"
                                                                },
                                                                {
                                                                    "id": "750050266",
                                                                    "speaker": "雷格巴",
                                                                    "text": "天哪，这座黑曜石像，就是藏在那个被封印的大门后面，部族禁地深处，以前先民用来与「夜神之国」沟通的媒介…"
                                                                },
                                                                {
                                                                    "id": "750050267",
                                                                    "speaker": "雷格巴",
                                                                    "text": "这是你们让小嵴锋龙挖出来的？你们、你…异邦人，觊觎部族的圣物，亏我还为你们准备营地和休息的地方…",
                                                                    "choices": [
                                                                        {
                                                                            "id": "750050268",
                                                                            "text": "等等，我们可以解释…",
                                                                            "response": [
                                                                                {
                                                                                    "id": "750050269",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "这不是我们故意做的！"
                                                                                },
                                                                                {
                                                                                    "id": "750050274",
                                                                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                                                                    "text": "唔…"
                                                                                },
                                                                                {
                                                                                    "id": "750050275",
                                                                                    "speaker": "Black Screen",
                                                                                    "text": "和雷格巴交代了前因后果…"
                                                                                },
                                                                                {
                                                                                    "id": "750050276",
                                                                                    "speaker": "雷格巴",
                                                                                    "text": "居然是这样，唉，我居然忘了这个小家伙可以四处挖洞…倒是我有点疏忽了。"
                                                                                },
                                                                                {
                                                                                    "id": "750050277",
                                                                                    "speaker": "雷格巴",
                                                                                    "text": "唉，这下可麻烦了，让我想想…虽然已经长久时间没有用过，但是这个媒介也是圣物，要是「大灵」生气就麻烦了。"
                                                                                },
                                                                                {
                                                                                    "id": "750050278",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "啊，那怎么办？"
                                                                                },
                                                                                {
                                                                                    "id": "750050279",
                                                                                    "speaker": "雷格巴",
                                                                                    "text": "总之，就要麻烦你们，把这东西归还回它应该去的地方啦。"
                                                                                },
                                                                                {
                                                                                    "id": "750050280",
                                                                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                                                                    "text": "唔…"
                                                                                },
                                                                                {
                                                                                    "id": "750050281",
                                                                                    "speaker": "雷格巴",
                                                                                    "text": "说的就是你，嘿嘿，小惹祸精！好了，我们出发吧！"
                                                                                },
                                                                                {
                                                                                    "id": "750050282",
                                                                                    "speaker": "雷格巴",
                                                                                    "text": "事先警告你们一句…遗迹里道路曲折，机关众多。一定要小心危险哦。"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "750050270",
                                                                            "text": "被发现了，快跑！",
                                                                            "response": [
                                                                                {
                                                                                    "id": "750050271",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "跑什么啦，这又不是故意挖出来的！"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "750050272",
                                                                            "text": "既然都被你看到了…",
                                                                            "response": [
                                                                                {
                                                                                    "id": "750050273",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "还没到要动手的程度吧，喂，好好解释一下呀！"
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "750050255",
                                                            "text": "看上去很值钱欸…",
                                                            "response": [
                                                                {
                                                                    "id": "750050256",
                                                                    "speaker": "派蒙",
                                                                    "text": "哼…这么丑的东西，想也不会值太多钱吧…"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "750050249",
                                            "text": "你…你吐的？",
                                            "response": [
                                                {
                                                    "id": "750050250",
                                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                                    "text": "唔…"
                                                },
                                                {
                                                    "id": "750050251",
                                                    "speaker": "派蒙",
                                                    "text": "怎么看都不是它吐出来的吧！"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "750050215",
                            "text": "只是好奇而已。",
                            "response": [
                                {
                                    "id": "750050216",
                                    "speaker": "派蒙",
                                    "text": "对呀，看到一扇被封印着的大门，有谁不会好奇呢？"
                                },
                                {
                                    "id": "750050217",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "呀！"
                                },
                                {
                                    "id": "750050218",
                                    "speaker": "雷格巴",
                                    "text": "正派人吧。"
                                },
                                {
                                    "id": "750050219",
                                    "speaker": "派蒙",
                                    "text": "喂！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7500503",
            "objective": "与奇怪的家伙对话",
            "dialogues": []
        },
        {
            "id": "7500504",
            "objective": "前往营地",
            "dialogues": [
                {
                    "id": "750050401",
                    "speaker": "派蒙",
                    "text": "咦，刚才我们不是还在那个峡谷的遗迹里…这里是…？"
                },
                {
                    "id": "750050402",
                    "speaker": "「黑曜石碑的影像」",
                    "text": "过来，来这里。"
                },
                {
                    "id": "750050403",
                    "speaker": "「黑曜石碑的影像」",
                    "text": "「偶像」…「媒介」…归还…"
                },
                {
                    "id": "750050404",
                    "speaker": "「黑曜石碑的影像」",
                    "text": "（轻柔而缥缈的声音仿佛来自极远之处，又仿佛随风间歇递至耳边的噫语…）"
                },
                {
                    "id": "750050405",
                    "speaker": "「黑曜石碑的影像」",
                    "text": "（冰凉的意识似乎在不断地召唤你，通过…你手中的黑曜石像…）"
                },
                {
                    "id": "750050406",
                    "speaker": "「黑曜石碑的影像」",
                    "text": "归还…归还…"
                },
                {
                    "id": "750050407",
                    "speaker": "派蒙",
                    "text": "#{NICKNAME}？"
                },
                {
                    "id": "750050408",
                    "speaker": "「黑曜石碑的影像」",
                    "text": "……"
                },
                {
                    "id": "750050409",
                    "speaker": "「黑曜石碑的影像」",
                    "text": "许久未有远方的来者，这里…太大了，太空了。"
                },
                {
                    "id": "750050410",
                    "speaker": "「黑曜石碑的影像」",
                    "text": "污秽的黑暗是不速之客…污染了哪怕最晦暗的梦境…"
                },
                {
                    "id": "750050411",
                    "speaker": "「黑曜石碑的影像」",
                    "text": "我们的国度再次遭到入侵…亡者若被不安的黑潮吞噬，生者的烈火，旦夕之际，亦将熄灭…"
                },
                {
                    "id": "750050412",
                    "speaker": "「黑曜石碑的影像」",
                    "text": "莫轻信所谓「圣山」的愿景，要拒绝…他的承诺…"
                }
            ]
        },
        {
            "id": "7500505",
            "objective": "与雷格巴对话",
            "dialogues": []
        },
        {
            "id": "7500516",
            "objective": "打开大门",
            "dialogues": []
        },
        {
            "id": "7500507",
            "objective": "探索遗迹",
            "dialogues": [
                {
                    "id": "750050701",
                    "speaker": "雷格巴",
                    "text": "居然真的能够战胜「大灵」意志的显化…你们比我想象中还要强。"
                },
                {
                    "id": "750050702",
                    "speaker": "雷格巴",
                    "text": "一般部族人看到它们，都会带着敬意远离…因为没有人知道「大灵」的意志究竟是因何显化。"
                },
                {
                    "id": "750050703",
                    "speaker": "雷格巴",
                    "text": "运气好的时候它们会回应你，但是大部分时候都是为了「解决」某些东西才会出现。"
                },
                {
                    "id": "750050704",
                    "speaker": "派蒙",
                    "text": "所以你们也不知道「大灵」要干什么？"
                },
                {
                    "id": "750050705",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "嗯？"
                },
                {
                    "id": "750050706",
                    "speaker": "雷格巴",
                    "text": "之前也说了，「大灵」集合了已逝守护者的意志…相比之下是伟大却混沌不清的，就如它们的居所，「夜神之国」也是一样。"
                },
                {
                    "id": "750050707",
                    "speaker": "雷格巴",
                    "text": "传说，在拥有炽光羽翼的巨龙从火山中苏醒之后，可怜的人们只能在巨牙，利爪和如幡旗的巨翼之间艰难求生。"
                },
                {
                    "id": "750050708",
                    "speaker": "雷格巴",
                    "text": "与此同时，深渊的影响也在不断加重…"
                },
                {
                    "id": "750050709",
                    "speaker": "雷格巴",
                    "text": "听说就是在情况最危急的那会儿，有部族的人在一阵恍惚之中看到了最深沉的夜里仍然残留的曜石枝叶…"
                },
                {
                    "id": "750050710",
                    "speaker": "雷格巴",
                    "text": "自那以后，越来越多的人才一起在冥冥之中感受到了「夜神之国」…呵呵，他们用图腾、地脉与元素的力量抵抗深渊。"
                },
                {
                    "id": "750050711",
                    "speaker": "雷格巴",
                    "text": "这里就是古代时候的祭坛，部族的先人用黑曜石沟通夜晚的国度。"
                },
                {
                    "id": "750050712",
                    "speaker": "雷格巴",
                    "text": "而「大灵」也在那个时代，作为各个部族生者与逝者集结一同的图腾与意识逐渐成型…"
                },
                {
                    "id": "750050713",
                    "speaker": "派蒙",
                    "text": "原来是这样，所以刚才那个其实不是真的「大灵」，只是「大灵」的一部分？"
                },
                {
                    "id": "750050714",
                    "speaker": "雷格巴",
                    "text": "是的，刚才你们看到的是「大灵」一缕意识的化身，据说「大灵」并不具备真正的实体和形象，这有点难解释，总之，呃…"
                },
                {
                    "id": "750050715",
                    "speaker": "雷格巴",
                    "text": "要是你惹恼了「大灵」，刚才的那个家伙就会再出现！"
                },
                {
                    "id": "750050716",
                    "speaker": "派蒙",
                    "text": "呜哇，那我们还是快点把那个黑曜石像放回祭坛上吧！"
                }
            ]
        },
        {
            "id": "7500508",
            "objective": "设法前往遗迹更深处",
            "dialogues": [
                {
                    "id": "750050801",
                    "speaker": "雷格巴",
                    "text": "好了，现在就是将东西物归原主的时刻了。"
                }
            ]
        },
        {
            "id": "7500509",
            "objective": "击败「大灵」的意志",
            "dialogues": []
        },
        {
            "id": "7500510",
            "objective": "与雷格巴对话",
            "dialogues": []
        },
        {
            "id": "7500511",
            "objective": "将黑曜石像放回祭坛",
            "dialogues": [
                {
                    "id": "750050601",
                    "speaker": "献上供物",
                    "text": "(test)……"
                }
            ]
        },
        {
            "id": "7500514",
            "objective": "聆听遥远的低语",
            "dialogues": []
        },
        {
            "id": "7500515",
            "objective": "与雷格巴对话",
            "dialogues": [
                {
                    "id": "750050501",
                    "speaker": "雷格巴",
                    "text": "你们终于回来了！呼…刚刚你们靠近祭坛就「呼」地一下消失了！我还以为你们被「大灵」拘走了呢…可吓到我了。"
                },
                {
                    "id": "750050502",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "唔…"
                },
                {
                    "id": "750050503",
                    "speaker": "派蒙",
                    "text": "我们去了一个好可怕的地方！有一个大石碑在和我们说话呢！"
                },
                {
                    "id": "750050504",
                    "speaker": "派蒙",
                    "text": "#{REALNAME[ID(2)|SHOWHOST(true)]}怎么了，是在担心我们吗？"
                },
                {
                    "id": "750050505",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "唔…唔嗯…"
                },
                {
                    "id": "750050506",
                    "speaker": "雷格巴",
                    "text": "你看，我说你的朋友们会平安归来的。"
                },
                {
                    "id": "750050507",
                    "speaker": "雷格巴",
                    "text": "不过，大石碑？"
                },
                {
                    "id": "750050508",
                    "speaker": "Player",
                    "text": "（向雷格巴述说所看到的…）"
                },
                {
                    "id": "750050509",
                    "speaker": "雷格巴",
                    "text": "唉，能够战胜「大灵」意志的显化，听你的描述，又很像是进入了「夜神之国」…"
                },
                {
                    "id": "750050510",
                    "speaker": "雷格巴",
                    "text": "看来你们也不是什么普通的异邦人啊，居然能够看见从夜神之国返还的人，我这辈子也算是值了，哈哈。"
                },
                {
                    "id": "750050511",
                    "speaker": "雷格巴",
                    "text": "好啦，终于解决了这个「小风波」，我们快些上去吧，我还得想办法让封印恢复原状…"
                },
                {
                    "id": "750050512",
                    "speaker": "派蒙",
                    "text": "呜哇…还说什么「小风波」！明明部族的「大灵」意志的显化都被我们…"
                },
                {
                    "id": "750050513",
                    "speaker": "雷格巴",
                    "text": "没关系，它们会随时间从地脉重聚力量的。不用管它。"
                },
                {
                    "id": "750050514",
                    "speaker": "派蒙",
                    "text": "哇…明明是部族人，对待自己的崇拜对象这么随意的吗…"
                },
                {
                    "id": "750050515",
                    "speaker": "雷格巴",
                    "text": "那是你们的幸运，若是遇到个严格一点的部族人，你们可就要吃处罚咯！"
                },
                {
                    "id": "750050516",
                    "speaker": "派蒙",
                    "text": "哇啊，我才不要！"
                },
                {
                    "id": "750050517",
                    "speaker": "雷格巴",
                    "text": "还有你，小家伙，下次可不许再把这里的东西挖出来了！"
                },
                {
                    "id": "750050518",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "唔…"
                },
                {
                    "id": "750050519",
                    "speaker": "雷格巴",
                    "text": "嘿嘿，我们还是快点离开这里吧，趁还没有别的什么祖先被我们激怒！"
                }
            ]
        },
        {
            "id": "7500503",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "750050301",
                    "speaker": "雷格巴",
                    "text": "嗯…按照从前部族里流传的说法，要进入祭坛的话，就得…<color=#00E1FFFF>「让此处的灯相平齐」</color>…"
                },
                {
                    "id": "750050302",
                    "speaker": "雷格巴",
                    "text": "虽然不是特别清楚，但是，大概是要让机关控制的灯，高度变得一致？"
                }
            ]
        }
    ]
}