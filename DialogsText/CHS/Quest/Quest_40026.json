        {
            "id": "4002608",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "400260801",
                    "speaker": "班尼特",
                    "text": "对不起，都怪我，又要劳烦你们帮忙了…",
                    "choices": [
                        {
                            "id": "400260802",
                            "text": "班尼特，你没受伤吧？",
                            "response": [
                                {
                                    "id": "400260803",
                                    "speaker": "班尼特",
                                    "text": "嗯，我没受伤，谢谢你！现在最大的问题还是得从这里出去…呜呜，我好冷呀…阿嚏！"
                                }
                            ]
                        },
                        {
                            "id": "400260804",
                            "text": "我们这就去找钥匙。",
                            "response": [
                                {
                                    "id": "400260805",
                                    "speaker": "班尼特",
                                    "text": "嗯！我等你！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "4002699",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "400269901",
                    "speaker": "阿贝多",
                    "text": "脚印从门口往那边去了。"
                },
                {
                    "id": "400269902",
                    "speaker": "派蒙",
                    "text": "可恶的小偷！"
                },
                {
                    "id": "400269903",
                    "speaker": "阿贝多",
                    "text": "这些痕迹向上延伸了。"
                },
                {
                    "id": "400269904",
                    "speaker": "派蒙",
                    "text": "爬上断崖了吗？那我们也上去！"
                },
                {
                    "id": "400269905",
                    "speaker": "派蒙",
                    "text": "雪地上的脚印好难找，一不小心就会看漏呢…"
                },
                {
                    "id": "400269906",
                    "speaker": "阿贝多",
                    "text": "所以才要抓紧时间。"
                },
                {
                    "id": "400269907",
                    "speaker": "派蒙",
                    "text": "咦？脚印到这里断了？"
                },
                {
                    "id": "400269908",
                    "speaker": "阿贝多",
                    "text": "看来是跳下断崖了。准备好风之翼，我们也下去。"
                },
                {
                    "id": "400269909",
                    "speaker": "派蒙",
                    "text": "嗯嗯，这块还不错！"
                },
                {
                    "id": "400269910",
                    "speaker": "派蒙",
                    "text": "这里的星银矿看起来比较黯淡…是杂质太多了吗？"
                },
                {
                    "id": "400269911",
                    "speaker": "阿贝多",
                    "text": "最近潜心研究，没怎么清扫灰尘…也该整理了。"
                },
                {
                    "id": "400269912",
                    "speaker": "派蒙",
                    "text": "哇…好多乱七八糟的杂物…里面应该没有钥匙吧？"
                },
                {
                    "id": "400269913",
                    "speaker": "派蒙",
                    "text": "小心，有人来了！"
                }
            ]
        }
    ]
}