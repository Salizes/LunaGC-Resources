        {
            "id": "4002624",
            "objective": "(test)隐藏检测获取物品$HIDDEN",
            "dialogues": []
        },
        {
            "id": "4002607",
            "objective": "回到洞口",
            "dialogues": [
                {
                    "id": "400260429",
                    "speaker": "派蒙",
                    "text": "好，这些就够了，不过…同为星银矿，光泽度区别可真大啊。"
                }
            ]
        },
        {
            "id": "4002608",
            "objective": "追查声音的源头",
            "dialogues": [
                {
                    "id": "400260701",
                    "speaker": "派蒙",
                    "text": "声音就是从这一带传来的！"
                },
                {
                    "id": "400260702",
                    "speaker": "？？？",
                    "text": "有人吗——！帮帮我！"
                },
                {
                    "id": "400260703",
                    "speaker": "Player",
                    "text": "这个声音是…"
                },
                {
                    "id": "400260704",
                    "speaker": "派蒙",
                    "text": "不会吧，难道是…"
                },
                {
                    "id": "400260705",
                    "speaker": "？？？",
                    "text": "嗯？是旅行者和派蒙吗？！是我呀，班尼特！"
                },
                {
                    "id": "400260706",
                    "speaker": "派蒙",
                    "text": "呜哇，真的是他…"
                },
                {
                    "id": "400260707",
                    "speaker": "派蒙",
                    "text": "我们快把他救出来吧！"
                },
                {
                    "id": "400260708",
                    "speaker": "班尼特",
                    "text": "真抱歉，又要劳烦你们了…笼子的钥匙应该就在附近，还请帮我找一找！"
                }
            ]
        },
        {
            "id": "4002609",
            "objective": "寻找笼子的钥匙",
            "dialogues": [
                {
                    "id": "400260901",
                    "speaker": "仔细观察山洞入口…",
                    "text": "山洞入口有些狭窄，勉强可供一人通行。阿贝多已经追着犯人进入其中，姑且按照他的吩咐在外面耐心等候吧。"
                }
            ]
        },
        {
            "id": "4002622",
            "objective": "(test)完成任一调查点$HIDDEN",
            "dialogues": []
        },
        {
            "id": "4002621",
            "objective": "击败愚人众",
            "dialogues": []
        },
        {
            "id": "4002610",
            "objective": "打开笼子",
            "dialogues": []
        },
        {
            "id": "4002611",
            "objective": "与班尼特对话",
            "dialogues": [
                {
                    "id": "400260501",
                    "speaker": "班尼特",
                    "text": "总算出来了，太谢谢你们啦！"
                },
                {
                    "id": "400260502",
                    "speaker": "班尼特",
                    "text": "要不是被树上掉下来那些包着石头的雪块砸得晕乎乎的，我也不会误入愚人众的陷阱还被困着走不了…"
                },
                {
                    "id": "400260503",
                    "speaker": "派蒙",
                    "text": "一听就有故事啊。"
                },
                {
                    "id": "400260504",
                    "speaker": "班尼特",
                    "text": "哈哈，不值得一提啦，是我运气太差。"
                },
                {
                    "id": "400260505",
                    "speaker": "Player",
                    "text": "我们赶走附近的愚人众了。"
                },
                {
                    "id": "400260506",
                    "speaker": "Player",
                    "text": "帮你报仇了哦。"
                },
                {
                    "id": "400260507",
                    "speaker": "派蒙",
                    "text": "对，刚才随手解决了，不用太感谢我们哦！"
                },
                {
                    "id": "400260508",
                    "speaker": "班尼特",
                    "text": "这都行？哈哈哈哈，你们真好！"
                },
                {
                    "id": "400260509",
                    "speaker": "班尼特",
                    "text": "虽然我感觉那些人也只是奉命行事…但不管怎么说，谢谢你帮我出气！"
                },
                {
                    "id": "400260510",
                    "speaker": "派蒙",
                    "text": "说起来，你来雪山干什么？雷泽没跟你一起吗？"
                },
                {
                    "id": "400260511",
                    "speaker": "班尼特",
                    "text": "你们没听说吗？冒险家协会在这里举办冬令营，我身为资深冒险家，当然是来带新人的啦。"
                },
                {
                    "id": "400260512",
                    "speaker": "班尼特",
                    "text": "雷泽不是冒险家，我身为班尼冒险团团长兼唯一成员，只好一个人过来了。"
                },
                {
                    "id": "400260513",
                    "speaker": "班尼特",
                    "text": "不过我被困这么久，应该已经错过约定的时间了吧…希望塞琉斯先生不要生我的气…"
                },
                {
                    "id": "400260514",
                    "speaker": "Player",
                    "text": "原来你也要带新人啊…"
                },
                {
                    "id": "400260515",
                    "speaker": "派蒙",
                    "text": "欸？难道那个落单的冒险家杰拉德原本是要跟你一组的？"
                },
                {
                    "id": "400260516",
                    "speaker": "派蒙",
                    "text": "如果是这样…班尼特，你确实来晚了，那位新人已经找其他教官组队了哦。"
                },
                {
                    "id": "400260517",
                    "speaker": "班尼特",
                    "text": "什么？！"
                },
                {
                    "id": "400260518",
                    "speaker": "班尼特",
                    "text": "不是说教官人手不足吗，怎么还溢出了啊？"
                },
                {
                    "id": "400260519",
                    "speaker": "派蒙",
                    "text": "这个活动目前得到了西风骑士团部分骑士的鼎力相助，所以教官人数就多于学员了。"
                },
                {
                    "id": "400260520",
                    "speaker": "班尼特",
                    "text": "原来是西风骑士啊…那肯定比倒霉的我可靠多了…",
                    "choices": [
                        {
                            "id": "400260521",
                            "text": "不会的，你也很棒。",
                            "response": [
                                {
                                    "id": "400260523",
                                    "speaker": "派蒙",
                                    "text": "对对，而且我们说的只是先前的情况，说不定还有其他地区的新人冒险家正在赶来参加活动呢！"
                                },
                                {
                                    "id": "400260524",
                                    "speaker": "派蒙",
                                    "text": "再说，你都费那么大力气赶来当教官了，塞琉斯肯定不会让你闲着。"
                                },
                                {
                                    "id": "400260525",
                                    "speaker": "班尼特",
                                    "text": "…真的？"
                                },
                                {
                                    "id": "400260526",
                                    "speaker": "派蒙",
                                    "text": "真的真的！"
                                },
                                {
                                    "id": "400260527",
                                    "speaker": "派蒙",
                                    "text": "哎！等等…阿贝多人呢？"
                                },
                                {
                                    "id": "400260528",
                                    "speaker": "Player",
                                    "text": "他没跟过来吗？"
                                },
                                {
                                    "id": "400260529",
                                    "speaker": "班尼特",
                                    "text": "阿贝多？是西风骑士团那位炼金术士阿贝多吗？他也来当教官？"
                                },
                                {
                                    "id": "400260530",
                                    "speaker": "派蒙",
                                    "text": "那倒没有，他只是刚巧也在雪山而已。直到刚才我们都在一起，可不知什么时候，他人就不见了…"
                                },
                                {
                                    "id": "400260531",
                                    "speaker": "派蒙",
                                    "text": "难道是回去找线索了？"
                                },
                                {
                                    "id": "400260532",
                                    "speaker": "派蒙",
                                    "text": "我们去山洞那边找他汇合吧！"
                                }
                            ]
                        },
                        {
                            "id": "400260522",
                            "text": "骑士和冒险家还是有些区别的。"
                        }
                    ]
                }
            ]
        },
