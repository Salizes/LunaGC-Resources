        "total_dialogue_lines": 95,
        "total_speaker_counts": {
            "Black Screen": 4,
            "Player": 14,
            "伯恩哈德": 9,
            "奥兹": 6,
            "派蒙": 26,
            "莫娜": 23,
            "菲谢尔": 13
        }
    },
    "talks": [
        {
            "id": "7051902",
            "objective": "返回店铺",
            "dialogues": [
                {
                    "id": "705190201",
                    "speaker": "派蒙",
                    "text": "伯恩哈德，我们筹集到足够的资金啦！"
                },
                {
                    "id": "705190202",
                    "speaker": "伯恩哈德",
                    "text": "居然这么快？你们的效率也太惊人了！"
                },
                {
                    "id": "705190203",
                    "speaker": "Player",
                    "text": "万事俱备，只差开店了。"
                },
                {
                    "id": "705190204",
                    "speaker": "伯恩哈德",
                    "text": "好，我这边也和供货商们谈好了，请稍等。"
                },
                {
                    "id": "705190205",
                    "speaker": "Black Screen",
                    "text": "伯恩哈德向供货商交付了「佳酿晶冻」，不久后就将店铺搭建完毕。"
                },
                {
                    "id": "705190206",
                    "speaker": "伯恩哈德",
                    "text": "怎么样，看起来还不错吧！如果你们有什么灵感，随时可以调整店铺的装潢哦。"
                },
                {
                    "id": "705190207",
                    "speaker": "派蒙",
                    "text": "有模有样，很有感觉！"
                },
                {
                    "id": "705190208",
                    "speaker": "派蒙",
                    "text": "我来给店铺起一个名字吧…就叫「西风呼呼义卖铺」好了！",
                    "choices": [
                        {
                            "id": "705190209",
                            "text": "很有派蒙的风格。",
                            "response": [
                                {
                                    "id": "705190210",
                                    "speaker": "派蒙",
                                    "text": "就当你是在表扬我好了！那，伯恩哈德，还需要我们做点什么？"
                                },
                                {
                                    "id": "705190213",
                                    "speaker": "伯恩哈德",
                                    "text": "筹集资金是门苦差事，已经让你们受累了。繁琐的工作不劳你们，全都交给我吧。"
                                },
                                {
                                    "id": "705190214",
                                    "speaker": "伯恩哈德",
                                    "text": "你们见多识广，还请你们确定本店的经营方向，比如销售方针、服务特点和品控原则…"
                                },
                                {
                                    "id": "705190215",
                                    "speaker": "伯恩哈德",
                                    "text": "这些词是我从其他店主那里听来的，我不太理解，但知道它们很重要，还是由你们来决定为妙。"
                                },
                                {
                                    "id": "705190216",
                                    "speaker": "派蒙",
                                    "text": "也就是说，我们两个来当店主，负责店铺的整体策略，而你来当店员，负责具体的工作？"
                                },
                                {
                                    "id": "705190217",
                                    "speaker": "伯恩哈德",
                                    "text": "是的，我就擅长执行，请把我当成「工具人」吧！"
                                },
                                {
                                    "id": "705190218",
                                    "speaker": "Player",
                                    "text": "好强的觉悟…"
                                },
                                {
                                    "id": "705190219",
                                    "speaker": "派蒙",
                                    "text": "呃，倒也不用这么夸张啦，我们也不是黑心店长嘛！"
                                },
                                {
                                    "id": "705190220",
                                    "speaker": "派蒙",
                                    "text": "#你先去休息一下吧，伯恩哈德，我和{NICKNAME}要好好商量一下策略。"
                                },
                                {
                                    "id": "705190221",
                                    "speaker": "Black Screen",
                                    "text": "根据以往的见闻，和派蒙研究了店里的商品，讨论了经营店铺的要点…"
                                },
                                {
                                    "id": "705190222",
                                    "speaker": "派蒙",
                                    "text": "好，要点很清楚，目标是做成「集市上最棒的小吃店」！"
                                },
                                {
                                    "id": "705190223",
                                    "speaker": "派蒙",
                                    "text": "接下来就拿出最好的状态，迎接第一批顾客吧…"
                                },
                                {
                                    "id": "705190224",
                                    "speaker": "Player",
                                    "text": "开店开店！"
                                },
                                {
                                    "id": "705190225",
                                    "speaker": "莫娜",
                                    "text": "#{NICKNAME}和派蒙？没想到能在这里碰见你们！"
                                },
                                {
                                    "id": "705190226",
                                    "speaker": "派蒙",
                                    "text": "莫娜和菲谢尔！你们也来集市玩啦！"
                                },
                                {
                                    "id": "705190227",
                                    "speaker": "菲谢尔",
                                    "text": "呵！不枉本皇女采信那冥冥之中的预感，让梅姬斯图斯卿陪同我前来巡视这凡俗的节庆…"
                                },
                                {
                                    "id": "705190228",
                                    "speaker": "菲谢尔",
                                    "text": "即便是平平无奇的秋日，也隐伏着常理之外的转机…妙哉！"
                                },
                                {
                                    "id": "705190229",
                                    "speaker": "奥兹",
                                    "text": "小姐正按捺着喜悦的嗓音，能见到你们，她的心情好得出奇…"
                                },
                                {
                                    "id": "705190230",
                                    "speaker": "菲谢尔",
                                    "text": "奥…奥兹！添油加醋！"
                                },
                                {
                                    "id": "705190231",
                                    "speaker": "莫娜",
                                    "text": "哼哼，还是由我来说明吧。"
                                },
                                {
                                    "id": "705190232",
                                    "speaker": "莫娜",
                                    "text": "不久前皇女殿下做了个不错的梦，感觉最近会有好事发生，想来找我咨询星象。"
                                },
                                {
                                    "id": "705190233",
                                    "speaker": "莫娜",
                                    "text": "另外，她发现佳酿节办得挺热闹的，就问我要不要一起去逛逛。"
                                },
                                {
                                    "id": "705190234",
                                    "speaker": "莫娜",
                                    "text": "我当然答应喽。正好可以趁着节日促销采购一大批物资，为赶稿做准备。"
                                },
                                {
                                    "id": "705190235",
                                    "speaker": "莫娜",
                                    "text": "其实，也多亏皇女殿下的提醒，我才知道佳酿节已经到了…"
                                },
                                {
                                    "id": "705190236",
                                    "speaker": "菲谢尔",
                                    "text": "梅姬斯图斯卿，本皇女必须强调，那个梦是九天前的事了。"
                                },
                                {
                                    "id": "705190237",
                                    "speaker": "菲谢尔",
                                    "text": "在此期间，梅姬斯图斯卿一直没有回信，本皇女才莅临你的住所。"
                                },
                                {
                                    "id": "705190238",
                                    "speaker": "莫娜",
                                    "text": "等等…已经过去九天了？九天？！怎么这么快！"
                                },
                                {
                                    "id": "705190239",
                                    "speaker": "菲谢尔",
                                    "text": "念在这次的文稿对于梅姬斯图斯卿至关重要，本皇女就不计较了。"
                                },
                                {
                                    "id": "705190240",
                                    "speaker": "奥兹",
                                    "text": "不过还请梅姬斯图斯卿留意，门口的信箱塞得满满当当，可能有不少人以为您失联了。"
                                },
                                {
                                    "id": "705190241",
                                    "speaker": "派蒙",
                                    "text": "莫娜还真是沉浸在学术研究里啊，忘记了时间，忘记给别人回信，也没注意到这么盛大的庆典。",
                                    "choices": [
                                        {
                                            "id": "705190242",
                                            "text": "不被外界干扰有时很重要。",
                                            "response": [
                                                {
                                                    "id": "705190244",
                                                    "speaker": "莫娜",
                                                    "text": "总…总之！时间紧迫，我要快点采购完所有物资！"
                                                },
                                                {
                                                    "id": "705190245",
                                                    "speaker": "莫娜",
                                                    "text": "#话说回来，真想不到{NICKNAME}和派蒙会亲自开店啊，还是我最关注的小吃店！"
                                                },
                                                {
                                                    "id": "705190246",
                                                    "speaker": "派蒙",
                                                    "text": "我们也是受人所托啦，嘿嘿，请多多关照小店生意。"
                                                },
                                                {
                                                    "id": "705190247",
                                                    "speaker": "Player",
                                                    "text": "莫娜有什么想买的吗？"
                                                },
                                                {
                                                    "id": "705190248",
                                                    "speaker": "莫娜",
                                                    "text": "让我想想…你们有没有推荐的…嗯…下酒菜？"
                                                },
                                                {
                                                    "id": "705190249",
                                                    "speaker": "派蒙",
                                                    "text": "当然有了，要多少有多少！让我看看菜单啊…"
                                                },
                                                {
                                                    "id": "705190250",
                                                    "speaker": "派蒙",
                                                    "text": "等等…欸？下酒菜？"
                                                },
                                                {
                                                    "id": "705190251",
                                                    "speaker": "派蒙",
                                                    "text": "难道说，莫娜你因为稿子进展不顺利，开始酗酒了？"
                                                },
                                                {
                                                    "id": "705190252",
                                                    "speaker": "奥兹",
                                                    "text": "这样说来，小姐近来常去拜访，可能确实耽误了不少时间。",
                                                    "choices": [
                                                        {
                                                            "id": "705190253",
                                                            "text": "要振作啊，莫娜！",
                                                            "response": [
                                                                {
                                                                    "id": "705190254",
                                                                    "speaker": "菲谢尔",
                                                                    "text": "……"
                                                                },
                                                                {
                                                                    "id": "705190257",
                                                                    "speaker": "莫娜",
                                                                    "text": "不是啦，跟喝酒和拜访都无关啦！你们别紧张…"
                                                                },
                                                                {
                                                                    "id": "705190258",
                                                                    "speaker": "莫娜",
                                                                    "text": "之前皇女殿下请我品尝过她拿手的冷肉拼盘…不好意思，是「祝圣交响乐」！"
                                                                },
                                                                {
                                                                    "id": "705190259",
                                                                    "speaker": "莫娜",
                                                                    "text": "滋味独特，每一口都能带来实实在在的肉的满足感，我还没回过神来就全吃完了…"
                                                                },
                                                                {
                                                                    "id": "705190260",
                                                                    "speaker": "派蒙",
                                                                    "text": "呃…客人享受食物，对厨师来说也算是一种认可。"
                                                                },
                                                                {
                                                                    "id": "705190261",
                                                                    "speaker": "莫娜",
                                                                    "text": "冷肉拼盘确实很棒。能补充能量，还可以长期保存。通常是被用来当作下酒菜的吧？"
                                                                },
                                                                {
                                                                    "id": "705190262",
                                                                    "speaker": "莫娜",
                                                                    "text": "除了价格因素，其他方面确实远胜过「满足沙拉」…"
                                                                },
                                                                {
                                                                    "id": "705190263",
                                                                    "speaker": "莫娜",
                                                                    "text": "但反过来思考，佳酿节的主题是美酒，下酒菜会跟着打折出售。"
                                                                },
                                                                {
                                                                    "id": "705190264",
                                                                    "speaker": "莫娜",
                                                                    "text": "天赐良机，必须要牢牢把握。"
                                                                },
                                                                {
                                                                    "id": "705190265",
                                                                    "speaker": "菲谢尔",
                                                                    "text": "欢愉吧，梅姬斯图斯卿！那是本皇女出游期间一时兴起的作品，你还有机会享受到至为臻美的佳肴…"
                                                                },
                                                                {
                                                                    "id": "705190266",
                                                                    "speaker": "奥兹",
                                                                    "text": "小姐的意思是，她还没有施展全部本领。"
                                                                },
                                                                {
                                                                    "id": "705190267",
                                                                    "speaker": "莫娜",
                                                                    "text": "我知道的！皇女殿下的厨艺远远不止那盘菜的水平…"
                                                                },
                                                                {
                                                                    "id": "705190268",
                                                                    "speaker": "莫娜",
                                                                    "text": "但我作为臣子，怎么能让皇女殿下亲自下厨呢…不对，我是说，我怎么能让来家里的客人做饭呢…"
                                                                },
                                                                {
                                                                    "id": "705190269",
                                                                    "speaker": "莫娜",
                                                                    "text": "至少，我也得多备点和沙拉不一样的…说不定能找出你中意的口味呢…"
                                                                },
                                                                {
                                                                    "id": "705190270",
                                                                    "speaker": "菲谢尔",
                                                                    "text": "欸？原来莫娜是这样想的吗？"
                                                                },
                                                                {
                                                                    "id": "705190271",
                                                                    "speaker": "奥兹",
                                                                    "text": "小姐，这种时候表现得「早有所料」和「眼观大局」更符合你的作风。"
                                                                },
                                                                {
                                                                    "id": "705190272",
                                                                    "speaker": "菲谢尔",
                                                                    "text": "咳咳！没错！梅姬斯图斯卿！"
                                                                },
                                                                {
                                                                    "id": "705190273",
                                                                    "speaker": "菲谢尔",
                                                                    "text": "作为本皇女认可之人，你应当尽览星天的奥秘…无需另做取悦本皇女之事。"
                                                                },
                                                                {
                                                                    "id": "705190274",
                                                                    "speaker": "莫娜",
                                                                    "text": "别在意，我也不是每天都这么忙的…等有空之后拓展一下其他领域，也不是什么难事。"
                                                                },
                                                                {
                                                                    "id": "705190275",
                                                                    "speaker": "Player",
                                                                    "text": "那么——"
                                                                },
                                                                {
                                                                    "id": "705190276",
                                                                    "speaker": "派蒙",
                                                                    "text": "那么，就由我们「西风呼呼义卖铺」来解决这个难题吧！"
                                                                },
                                                                {
                                                                    "id": "705190277",
                                                                    "speaker": "派蒙",
                                                                    "text": "店里不仅有即食的下酒菜，还有各类半成品，莫娜可以各买几种！"
                                                                },
                                                                {
                                                                    "id": "705190278",
                                                                    "speaker": "派蒙",
                                                                    "text": "加工半成品花不了多少时间，也不容易出错，能让莫娜快速熟悉烹饪的技巧。"
                                                                },
                                                                {
                                                                    "id": "705190279",
                                                                    "speaker": "派蒙",
                                                                    "text": "等到你不那么忙了，再去挑战难度更高的菜肴吧！"
                                                                },
                                                                {
                                                                    "id": "705190280",
                                                                    "speaker": "派蒙",
                                                                    "text": "#当然，我们也可以上门教学！{NICKNAME}做菜可是很有一套的。"
                                                                },
                                                                {
                                                                    "id": "705190281",
                                                                    "speaker": "Player",
                                                                    "text": "小菜一碟。"
                                                                },
                                                                {
                                                                    "id": "705190282",
                                                                    "speaker": "莫娜",
                                                                    "text": "哈哈，真是个好主意！我都想提高预算了…"
                                                                },
                                                                {
                                                                    "id": "705190283",
                                                                    "speaker": "菲谢尔",
                                                                    "text": "梅姬斯图斯卿，本皇女期待着你的杰作。"
                                                                },
                                                                {
                                                                    "id": "705190284",
                                                                    "speaker": "奥兹",
                                                                    "text": "但也请务必牢记派蒙卿的建议，合理分配时间。"
                                                                },
                                                                {
                                                                    "id": "705190285",
                                                                    "speaker": "莫娜",
                                                                    "text": "哼哼，好好等着看吧。下次你们再来我家的时候，就能享受到不一样的美味了！"
                                                                },
                                                                {
                                                                    "id": "705190286",
                                                                    "speaker": "Black Screen",
                                                                    "text": "莫娜买到了理想的物资，郑重道谢后，与菲谢尔和奥兹心满意足地离去了…"
                                                                },
                                                                {
                                                                    "id": "705190287",
                                                                    "speaker": "派蒙",
                                                                    "text": "嘿嘿，「西风呼呼义卖铺」获得了第一笔收入！",
                                                                    "choices": [
                                                                        {
                                                                            "id": "705190288",
                                                                            "text": "虽然营收不算多…",
                                                                            "response": [
                                                                                {
                                                                                    "id": "705190290",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "没错呢！看见客人买到了喜欢的商品，我也跟着高兴起来了。"
                                                                                },
                                                                                {
                                                                                    "id": "705190291",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "原来出售别人需要的商品是这种感觉啊，当店主也很有意思嘛。"
                                                                                },
                                                                                {
                                                                                    "id": "705190292",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "#好了，{NICKNAME}，我们就一鼓作气，打响这间店铺的名号吧！"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "705190289",
                                                                            "text": "但意义相当重大…"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "705190255",
                                                            "text": "收敛点啊，皇女殿下！",
                                                            "response": [
                                                                {
                                                                    "id": "705190256",
                                                                    "speaker": "菲谢尔",
                                                                    "text": "欸，欸？！"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "705190243",
                                            "text": "专注力让人羡慕。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "705190211",
                            "text": "还需要我们做些什么？",
                            "response": [
                                {
                                    "id": "705190212",
                                    "speaker": "派蒙",
                                    "text": "喂，不要无视我起的名字呀？至少也点一下头吧！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7051903",
            "objective": "",
            "dialogues": [
                {
                    "id": "705190301",
                    "speaker": "伯恩哈德",
                    "text": "大名鼎鼎的荣誉骑士，还有「提瓦特最好的向导」派蒙，请你们帮我主持义卖活动吧！"
                },
                {
                    "id": "705190302",
                    "speaker": "Black Screen",
                    "text": "帮助伯恩哈德准备了义卖的店铺"
                },
                {
                    "id": "705190303",
                    "speaker": "伯恩哈德",
                    "text": "辛苦你们了，现在就开始营业吧！"
                }
            ]
        }
    ]
}