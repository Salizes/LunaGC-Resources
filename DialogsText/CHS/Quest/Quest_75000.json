    "talks": [
        {
            "id": "7500012",
            "objective": "(test)进入纳塔接取任务$HIDDEN",
            "dialogues": [
                {
                    "id": "750001201",
                    "speaker": "小家伙？",
                    "text": "呀！"
                },
                {
                    "id": "750001202",
                    "speaker": "派蒙",
                    "text": "#嗯，「{TMPVALUE(TMP_VALUE_KEY_TYPE_LITTLE_DRILL_TMP_NAME)}」确实也挺顺口的，而且，这也能算是我取的名字嘛，嘿嘿！"
                }
            ]
        },
        {
            "id": "7500001",
            "objective": "(test)test进入纳塔任务传送-回滚点$HIDDEN",
            "dialogues": [
                {
                    "id": "750000101",
                    "speaker": "派蒙",
                    "text": "喂，喂…大家伙，你还好吗，还站得起来吗？"
                },
                {
                    "id": "750000102",
                    "speaker": "派蒙",
                    "text": "看上去好虚弱，真是的，到底发生了什么啊…那些飘浮幽灵狗真让人讨厌，果然飘浮着的家伙都不是什么好东西！"
                },
                {
                    "id": "750000103",
                    "speaker": "Player",
                    "text": "你自己不也飘着吗？"
                },
                {
                    "id": "750000104",
                    "speaker": "派蒙",
                    "text": "我和那些家伙怎么能一样啦！"
                },
                {
                    "id": "750000105",
                    "speaker": "派蒙",
                    "text": "#不说那些了，快，{NICKNAME}，我们看看还有什么吃的，给这个大家伙吃点，然后…然后让它好好休息。"
                },
                {
                    "id": "750000106",
                    "speaker": "派蒙",
                    "text": "这样，它一定能恢复一点精神的！",
                    "choices": [
                        {
                            "id": "750000107",
                            "text": "已经太迟了…",
                            "response": [
                                {
                                    "id": "750000109",
                                    "speaker": "派蒙",
                                    "text": "怎么会这样。"
                                },
                                {
                                    "id": "750000110",
                                    "speaker": "大家伙？",
                                    "text": "…呼。"
                                },
                                {
                                    "id": "750000111",
                                    "speaker": "派蒙",
                                    "text": "#呜，它现在肯定很难受，{NICKNAME}。",
                                    "choices": [
                                        {
                                            "id": "750000112",
                                            "text": "你的敌人已经被我清理掉了。",
                                            "response": [
                                                {
                                                    "id": "750000114",
                                                    "speaker": "大家伙？",
                                                    "text": "…呼呼。"
                                                },
                                                {
                                                    "id": "750000115",
                                                    "speaker": "Player",
                                                    "text": "是…还有什么放心不下的东西吗？"
                                                },
                                                {
                                                    "id": "750000116",
                                                    "speaker": "Player",
                                                    "text": "你想要…告诉我什么？"
                                                },
                                                {
                                                    "id": "750000117",
                                                    "speaker": "Black Screen",
                                                    "text": "伸出…伸出手来，受龙…所选者…伸出手来…"
                                                },
                                                {
                                                    "id": "750000118",
                                                    "speaker": "Black Screen",
                                                    "text": "联结…力量，然后，去见证一切，以此，解放一切…"
                                                },
                                                {
                                                    "id": "750000119",
                                                    "speaker": "派蒙",
                                                    "text": "#{NICKNAME}，你怎么啦！快，快做些什么呀，不是发呆的时候啦。"
                                                },
                                                {
                                                    "id": "750000120",
                                                    "speaker": "Player",
                                                    "text": "没有，刚才可能只是眼花了一下…"
                                                },
                                                {
                                                    "id": "750000121",
                                                    "speaker": "大家伙？",
                                                    "text": "……"
                                                },
                                                {
                                                    "id": "750000122",
                                                    "speaker": "大家伙？",
                                                    "text": "……呜…呜…"
                                                },
                                                {
                                                    "id": "750000123",
                                                    "speaker": "Player",
                                                    "text": "这是你的愿望，还是…？"
                                                },
                                                {
                                                    "id": "750000124",
                                                    "speaker": "Player",
                                                    "text": "（向着濒死的兽伸出手…）"
                                                },
                                                {
                                                    "id": "750000125",
                                                    "speaker": "派蒙",
                                                    "text": "你这是在做什么啦…咦…"
                                                },
                                                {
                                                    "id": "750000126",
                                                    "speaker": "派蒙",
                                                    "text": "#{NICKNAME}，你…！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "750000113",
                                            "text": "休息一下吧，了不起的大家伙。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "750000108",
                            "text": "它已经坚持了太久…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7500002",
            "objective": "击败兽境猎犬",
            "dialogues": [
                {
                    "id": "750000201",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "呀！嗯…呀！"
                }
            ]
        },
        {
            "id": "7500004",
            "objective": "与巨兽对话",
            "dialogues": []
        },
        {
            "id": "7500003",
            "objective": "破坏岩石，救出幼兽",
            "dialogues": [
                {
                    "id": "750000301",
                    "speaker": "派蒙",
                    "text": "#嗯，那么小家伙的名字就叫{TMPVALUE(TMP_VALUE_KEY_TYPE_LITTLE_DRILL_TMP_NAME)}咯？"
                }
            ]
        },
        {
            "id": "7500005",
            "objective": "(test)test解救小恐龙timeline$HIDDEN",
            "dialogues": [
                {
                    "id": "750000501",
                    "speaker": "Player",
                    "text": "我再想想…"
                },
                {
                    "id": "750000502",
                    "speaker": "派蒙",
                    "text": "好哦，毕竟名字是很重要的，还是再仔细考虑一下吧！"
                }
            ]
        },
        {
            "id": "7500006",
            "objective": "与幼兽对话",
            "dialogues": [
                {
                    "id": "750000601",
                    "speaker": "派蒙",
                    "text": "啊…小家伙，你没事吧。"
                },
                {
                    "id": "750000602",
                    "speaker": "小家伙？",
                    "text": "呜…"
                },
                {
                    "id": "750000603",
                    "speaker": "派蒙",
                    "text": "怎、怎么了，看上去有点不太舒服的样子，咦，是尾巴吗，刚才从那个罩子掉下来的时候摔到了尾巴？"
                },
                {
                    "id": "750000604",
                    "speaker": "小家伙？",
                    "text": "呜…"
                },
                {
                    "id": "750000605",
                    "speaker": "Player",
                    "text": "如果能包扎一下…"
                },
                {
                    "id": "750000606",
                    "speaker": "派蒙",
                    "text": "嘿嘿，这就轮到我出场的时候啦…你的背包里满满当当的，关键时刻找个东西也得找半天。"
                },
                {
                    "id": "750000607",
                    "speaker": "派蒙",
                    "text": "就用「派蒙应急小背包」里的这条丝巾稍微包扎一下吧！"
                },
                {
                    "id": "750000608",
                    "speaker": "Player",
                    "text": "你的背包到底在哪…"
                },
                {
                    "id": "750000609",
                    "speaker": "派蒙",
                    "text": "哼，当然是藏在了不能随便被发现的地方…"
                },
                {
                    "id": "750000610",
                    "speaker": "派蒙",
                    "text": "欸呀，这丝巾你到底要不要用啦！"
                },
                {
                    "id": "750000611",
                    "speaker": "Player",
                    "text": "要用的，谢谢派蒙。"
                },
                {
                    "id": "750000612",
                    "speaker": "小家伙？",
                    "text": "嗯？"
                },
                {
                    "id": "750000613",
                    "speaker": "派蒙",
                    "text": "小家伙，不要动哦…"
                },
                {
                    "id": "750000614",
                    "speaker": "派蒙",
                    "text": "#嘿嘿，{NICKNAME}，没想到它还挺乖的呢。"
                },
                {
                    "id": "750000615",
                    "speaker": "小家伙？",
                    "text": "呀！"
                },
                {
                    "id": "750000616",
                    "speaker": "Player",
                    "text": "这样就行了吧。"
                },
                {
                    "id": "750000617",
                    "speaker": "派蒙",
                    "text": "怎么样，小家伙，觉得好一些了吧。"
                },
                {
                    "id": "750000618",
                    "speaker": "小家伙？",
                    "text": "呀…"
                },
                {
                    "id": "750000619",
                    "speaker": "派蒙",
                    "text": "好了，小家伙看上去也很精神…真是松了口气，不过，你到底为什么被关进了那样一个罩子里呀？还有，还有那些兽境猎犬…"
                },
                {
                    "id": "750000620",
                    "speaker": "小家伙？",
                    "text": "嗯？"
                },
                {
                    "id": "750000621",
                    "speaker": "派蒙",
                    "text": "你也不知道呀，就算你知道，你「呀啊呀啊」的我们也听不懂倒是了…不过，小家伙，我们把你救出来了，你可以回家啦。"
                },
                {
                    "id": "750000622",
                    "speaker": "小家伙？",
                    "text": "嗯？"
                },
                {
                    "id": "750000623",
                    "speaker": "派蒙",
                    "text": "咦，难道不知道自己家在哪吗？"
                },
                {
                    "id": "750000624",
                    "speaker": "派蒙",
                    "text": "那你的亲人，啊，难道，刚才的大家伙…"
                },
                {
                    "id": "750000625",
                    "speaker": "派蒙",
                    "text": "#那怎么办，{NICKNAME}…总不能把它一个人、呃一个家伙丢在这里吧？"
                },
                {
                    "id": "750000626",
                    "speaker": "小家伙？",
                    "text": "呜…"
                },
                {
                    "id": "750000627",
                    "speaker": "Player",
                    "text": "倒是可以先跟着我们…"
                },
                {
                    "id": "750000628",
                    "speaker": "派蒙",
                    "text": "也是啦，说不定到了纳塔，就能找到小家伙的家人了…不过我们之前还没看到过跟小家伙一样的…"
                },
                {
                    "id": "750000629",
                    "speaker": "Player",
                    "text": "啊，「受龙…所选者…」，难道…"
                },
                {
                    "id": "750000630",
                    "speaker": "派蒙",
                    "text": "嗯…你说似乎看到了这样的话？"
                },
                {
                    "id": "750000631",
                    "speaker": "派蒙",
                    "text": "这么说来，纳塔是龙的国度吧，咦，难道，小家伙也是…龙？"
                },
                {
                    "id": "750000632",
                    "speaker": "小家伙？",
                    "text": "唔…"
                },
                {
                    "id": "750000633",
                    "speaker": "派蒙",
                    "text": "这么说来看上去确实和龙蜥挺像的，都有…两条腿和一条尾巴。"
                },
                {
                    "id": "750000634",
                    "speaker": "小家伙？",
                    "text": "嗯？"
                },
                {
                    "id": "750000635",
                    "speaker": "Player",
                    "text": "让它跟着我们是没问题啦…"
                },
                {
                    "id": "750000636",
                    "speaker": "Player",
                    "text": "不过得问问它同不同意。"
                },
                {
                    "id": "750000637",
                    "speaker": "派蒙",
                    "text": "说的也是呢，小家伙，你愿意跟我们一起旅行吗？"
                },
                {
                    "id": "750000638",
                    "speaker": "小家伙？",
                    "text": "……"
                },
                {
                    "id": "750000639",
                    "speaker": "小家伙？",
                    "text": "呀！"
                },
                {
                    "id": "750000640",
                    "speaker": "派蒙",
                    "text": "#嘿嘿，小家伙同意啦。对了，我是派蒙！{M#他}{F#她}是{NICKNAME}！"
                },
                {
                    "id": "750000641",
                    "speaker": "小家伙？",
                    "text": "啵嗯？呀…"
                },
                {
                    "id": "750000642",
                    "speaker": "派蒙",
                    "text": "对了，小家伙也得有个名字…让我想想，看你颜色黄黄黑黑的，不如就叫你「土豆饼」吧！"
                },
                {
                    "id": "750000643",
                    "speaker": "土豆饼？",
                    "text": "呜…呜…",
                    "choices": [
                        {
                            "id": "750000644",
                            "text": "大概只能在猎鹿人受欢迎…",
                            "response": [
                                {
                                    "id": "750000645",
                                    "speaker": "派蒙",
                                    "text": "「在其他地方就不受欢迎」的意思是吧。"
                                },
                                {
                                    "id": "750000647",
                                    "speaker": "小家伙？",
                                    "text": "呜…"
                                },
                                {
                                    "id": "750000648",
                                    "speaker": "派蒙",
                                    "text": "#你想让{NICKNAME}给你取名字？这家伙的取名品味…我可不好说哦。",
                                    "choices": [
                                        {
                                            "id": "750000649",
                                            "text": "明明我取的名字一向很正常。"
                                        },
                                        {
                                            "id": "750000650",
                                            "text": "可怜的孩子…命中该有此劫。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "750000646",
                            "text": "好像它不是很喜欢…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7500007",
            "objective": "为小家伙取一个超棒的名字！",
            "dialogues": [
                {
                    "id": "750000701",
                    "speaker": "派蒙",
                    "text": "那，要给小家伙取一个什么样的名字呢？"
                }
            ]
        },
        {
            "id": "7500009",
            "objective": "与龙伙伴对话",
            "dialogues": [
                {
                    "id": "750000901",
                    "speaker": "派蒙",
                    "text": "#{REALNAME[ID(2)|SHOWHOST(true)]}啊，你以后的名字就叫作{REALNAME[ID(2)|SHOWHOST(true)]}了哦，小家伙！"
                },
                {
                    "id": "750000902",
                    "speaker": "Player",
                    "text": "#{REALNAME[ID(2)|SHOWHOST(true)]}…"
                },
                {
                    "id": "750000903",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "…呀！"
                },
                {
                    "id": "750000904",
                    "speaker": "派蒙",
                    "text": "#看来它很喜欢这个名字呢…嘿嘿，希望在纳塔能够解开你身上的谜团…对了，还有{NICKNAME}突然就能够钻到龙身体里的事…"
                },
                {
                    "id": "750000905",
                    "speaker": "派蒙",
                    "text": "#刚才都忘了问了，{NICKNAME}你突然就变成了龙，没出什么事吧，有没有觉得难受？",
                    "choices": [
                        {
                            "id": "750000906",
                            "text": "有点晕龙。",
                            "response": [
                                {
                                    "id": "750000907",
                                    "speaker": "派蒙",
                                    "text": "晕龙是什么啦！还有空开玩笑，下次不理你了！"
                                },
                                {
                                    "id": "750000910",
                                    "speaker": "派蒙",
                                    "text": "#不过，{NICKNAME}，我之前可没听说纳塔有人能够变成龙…感觉有点怪。"
                                },
                                {
                                    "id": "750000911",
                                    "speaker": "派蒙",
                                    "text": "真是的，才刚到纳塔，感觉就发生了这么多事…好了，接下来的问题就是，我们要怎么出去呢？"
                                },
                                {
                                    "id": "750000912",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "呀！"
                                },
                                {
                                    "id": "750000913",
                                    "speaker": "派蒙",
                                    "text": "嗯？你知道出去的地方吗？"
                                }
                            ]
                        },
                        {
                            "id": "750000908",
                            "text": "我是龙，也不错。",
                            "response": [
                                {
                                    "id": "750000909",
                                    "speaker": "派蒙",
                                    "text": "最好是这样啦，要是哪天变成了龙的样子回不来，到时候可就麻烦了…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7500011",
            "objective": "跟随你的龙伙伴",
            "dialogues": [
                {
                    "id": "750001101",
                    "speaker": "小家伙？",
                    "text": "呀！"
                },
                {
                    "id": "750001102",
                    "speaker": "派蒙",
                    "text": "哦，感觉是充满了力量感的好名字呢！"
                }
            ]
        },
        {
            "id": "7500010",
            "objective": "(test)任务完成前离开营地回滚$HIDDEN",
            "dialogues": [
                {
                    "id": "750001001",
                    "speaker": "小家伙？",
                    "text": "呜…"
                },
                {
                    "id": "750001002",
                    "speaker": "派蒙",
                    "text": "#咦，从名字里感受到了很大的压力吗…{NICKNAME}，还是别用这些名字啦！"
                }
            ]
        },
        {
            "id": "7500008",
            "objective": "离开奇怪的空间",
            "dialogues": [
                {
                    "id": "750000801",
                    "speaker": "派蒙",
                    "text": "那，要给小家伙取一个什么样的名字呢？"
                }
            ]
        },
        {
            "id": "7500004",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "750000401",
                    "speaker": "Player",
                    "text": "就叫这个吧！"
                },
                {
                    "id": "750000402",
                    "speaker": "派蒙",
                    "text": "好，嘿嘿！"
                }
            ]
        },
        {
            "id": "7500013",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "750001301",
                    "speaker": "小家伙？",
                    "text": "呀！"
                },
                {
                    "id": "750001302",
                    "speaker": "派蒙",
                    "text": "#咦，我说「土豆饼」的时候你一脸不喜欢，{NICKNAME}说「{TMPVALUE(TMP_VALUE_KEY_TYPE_LITTLE_DRILL_TMP_NAME)}」就一脸高兴…你这家伙，算了算了，不跟你生气。"
                }
            ]
        },
        {
            "id": "7500014",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "750001401",
                    "speaker": "派蒙",
                    "text": "不行，这个名字怎么想都不行吧！"
                }
            ]
        },
        {
            "id": "7500015",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "750001501",
                    "speaker": "派蒙",
                    "text": "#咦，这样吗，{NICKNAME}，你要用和自己一样的名字？"
                }
            ]
        },
        {
            "id": "7500099",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "750009901",
