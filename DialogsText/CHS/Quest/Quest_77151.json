        {
            "id": "7715101",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "771510101",
                    "speaker": "格里克",
                    "text": "嗯…还有许多地方要重新建设…",
                    "choices": [
                        {
                            "id": "771510102",
                            "text": "伐木场最近怎么样？",
                            "response": [
                                {
                                    "id": "771510103",
                                    "speaker": "格里克",
                                    "text": "最近情况还不错，之前因为「伊兹梅洛」逃走的伐木工人也回来了。"
                                },
                                {
                                    "id": "771510104",
                                    "speaker": "格里克",
                                    "text": "而且，听说是「伊兹梅洛」的人造成的破坏，有位叫兹梅伊的先生也在一天夜里找到我…说是愿意帮助我一同恢复伐木场。"
                                },
                                {
                                    "id": "771510105",
                                    "speaker": "格里克",
                                    "text": "虽然离原本的伐木场还有点距离…不过有了这些人的帮助，还有那笔「大盗宝藏」，完全恢复指日可待啊…"
                                }
                            ]
                        },
                        {
                            "id": "771510106",
                            "text": "多尼娅呢？",
                            "response": [
                                {
                                    "id": "771510107",
                                    "speaker": "格里克",
                                    "text": "呃…多尼娅小姐…"
                                },
                                {
                                    "id": "771510108",
                                    "speaker": "格里克",
                                    "text": "她在这里也帮了很多忙，但是没过多久，几位契科塔…也就是运输局总部的警探来了解情况。"
                                },
                                {
                                    "id": "771510109",
                                    "speaker": "格里克",
                                    "text": "其中一位似乎是多尼娅小姐的前辈，听闻多尼娅小姐的行为后气极反笑，一把提溜起多尼娅小姐，回新基捷城那去了…"
                                },
                                {
                                    "id": "771510110",
                                    "speaker": "格里克",
                                    "text": "希望、希望她没事吧…"
                                }
                            ]
                        },
                        {
                            "id": "771510111",
                            "text": "不打扰您了…",
                            "response": [
                                {
                                    "id": "771510112",
                                    "speaker": "格里克",
                                    "text": "哦哦，没事…"
                                }
                            ]
                        }
                    ]
                }
