        {
            "id": "1200805",
            "objective": "(test)【废弃】CS后最终对话",
            "dialogues": [
                {
                    "id": "120080401",
                    "speaker": "神里绫华",
                    "text": "怎么样？我的舞蹈…还可以吗？"
                },
                {
                    "id": "120080402",
                    "speaker": "派蒙",
                    "text": "非常漂亮哦！"
                },
                {
                    "id": "120080403",
                    "speaker": "派蒙",
                    "text": "又美又高雅，我…我说不好，但这一定就是艺术了！"
                },
                {
                    "id": "120080404",
                    "speaker": "Player",
                    "text": "很美哦。"
                },
                {
                    "id": "120080405",
                    "speaker": "神里绫华",
                    "text": "那就好。我…我不擅长这种舞蹈，没有丢脸真是太好了。"
                },
                {
                    "id": "120080406",
                    "speaker": "神里绫华",
                    "text": "也就是心血来潮，想要任性一次…"
                },
                {
                    "id": "120080407",
                    "speaker": "神里绫华",
                    "text": "哈哈哈，这么说来，今天可真是任性的一天呀。",
                    "choices": [
                        {
                            "id": "120080408",
                            "text": "我不介意。",
                            "response": [
                                {
                                    "id": "120080410",
                                    "speaker": "神里绫华",
                                    "text": "……"
                                },
                                {
                                    "id": "120080411",
                                    "speaker": "神里绫华",
                                    "text": "我也这么想哦。"
                                },
                                {
                                    "id": "120080412",
                                    "speaker": "神里绫华",
                                    "text": "跟你在一起的时间…过得很快，又很慢。"
                                },
                                {
                                    "id": "120080413",
                                    "speaker": "神里绫华",
                                    "text": "那么，今天就到这里吧。"
                                },
                                {
                                    "id": "120080414",
                                    "speaker": "神里绫华",
                                    "text": "前面的路，我自己上去就好。"
                                },
                                {
                                    "id": "120080415",
                                    "speaker": "Player",
                                    "text": "晚安，绫华。"
                                },
                                {
                                    "id": "120080416",
                                    "speaker": "神里绫华",
                                    "text": "晚安，旅行者。"
                                },
                                {
                                    "id": "120080417",
                                    "speaker": "Player",
                                    "text": "……"
                                },
                                {
                                    "id": "120080418",
                                    "speaker": "Player",
                                    "text": "♪"
                                }
                            ]
                        },
                        {
                            "id": "120080409",
                            "text": "和你相处让人很愉快。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1200806",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "120080601",
                    "speaker": "神里绫华",
                    "text": "旅行者你看，有抽签的摊位。"
                },
                {
                    "id": "120080602",
                    "speaker": "清水",
                    "text": "哦！神里大小姐今天是带朋友来玩？欢迎欢迎，稀客啊！要不要来抽个签？"
                },
                {
                    "id": "120080603",
                    "speaker": "神里绫华",
                    "text": "好啊，请问多少钱抽一次？"
                },
                {
                    "id": "120080604",
                    "speaker": "清水",
                    "text": "嘿嘿，您可能不知道，我伯父先前受过社奉行关照，仔细想来，还是您父亲在时的事，由他亲自处理的。"
                },
                {
                    "id": "120080605",
                    "speaker": "清水",
                    "text": "所以您看，我怎么能收您的钱呢？"
                },
                {
                    "id": "120080606",
                    "speaker": "神里绫华",
                    "text": "哎？这、这样真的可以吗？"
                },
                {
                    "id": "120080607",
                    "speaker": "清水",
                    "text": "当然当然！您要是看得上，就在我们摊上消遣一会儿，还有那边两位客人，也请随意。"
                },
                {
                    "id": "120080608",
                    "speaker": "神里绫华",
                    "text": "旅行者，派蒙…你们觉得呢？"
                },
                {
                    "id": "120080609",
                    "speaker": "派蒙",
                    "text": "绫华人缘可真好，既然这样，我就不客气了！",
                    "choices": [
                        {
                            "id": "120080610",
                            "text": "我也不客气了！",
                            "response": [
                                {
                                    "id": "120080612",
                                    "speaker": "神里绫华",
                                    "text": "既然旅行者都这么说…那我也不客气了，老板，我们要抽签。"
                                },
                                {
                                    "id": "120080613",
                                    "speaker": "清水",
                                    "text": "来喽，几位请抽签！"
                                },
                                {
                                    "id": "120080614",
                                    "speaker": "清水",
                                    "text": "请选择您要的签吧！"
                                }
                            ]
                        },
                        {
                            "id": "120080611",
                            "text": "今天沾定你的光了！"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1200808",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "120080801",
                    "speaker": "三田",
                    "text": "祝你们玩得开心！"
                }
            ]
        },
        {
            "id": "1200816",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "120081601",
                    "speaker": "清水",
                    "text": "打开看看您的运势吧！"
                },
                {
                    "id": "120081602",
                    "speaker": "神里绫华",
                    "text": "呀！"
                },
                {
                    "id": "120081603",
                    "speaker": "派蒙",
                    "text": "你们抽到什么？我的是中吉，还不错哦。"
                },
                {
                    "id": "120081604",
                    "speaker": "神里绫华",
                    "text": "我的也是中吉呢！"
                },
                {
                    "id": "120081605",
                    "speaker": "神里绫华",
                    "text": "旅行者，你呢？"
                }
            ]
        },
        {
            "id": "1200899",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "120089901",
                    "speaker": "派蒙",
                    "text": "明明已经接近尾声，却还是很有意思，我喜欢祭典！"
                },
                {
                    "id": "120089902",
                    "speaker": "神里绫华",
                    "text": "嗯，我也这么想。"
                },
                {
                    "id": "120089903",
                    "speaker": "神里绫华",
                    "text": "能在今天跟你们一起参加祭典，真是太好了。"
                }
            ]
        }
    ]
