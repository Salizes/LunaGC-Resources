    "talks": [
        {
            "id": "1200801",
            "objective": "前往甘金岛",
            "dialogues": [
                {
                    "id": "120080101",
                    "speaker": "派蒙",
                    "text": "到啦！但看起来好像并没有想象中那么热闹…怎么回事？"
                },
                {
                    "id": "120080102",
                    "speaker": "神里绫华",
                    "text": "今天是祭典最后一天，许多游客都已经回家了吧。"
                },
                {
                    "id": "120080103",
                    "speaker": "神里绫华",
                    "text": "听说最后一天客流量相对比较少，摊贩们有时也会提前收摊。"
                },
                {
                    "id": "120080104",
                    "speaker": "Player",
                    "text": "我们赶上了吗？"
                },
                {
                    "id": "120080105",
                    "speaker": "神里绫华",
                    "text": "我…我去问问看，不管怎么说一定要进去一次，嗯！"
                },
                {
                    "id": "120080106",
                    "speaker": "派蒙",
                    "text": "没错，就是要拿出这种气势来，我们陪你！"
                }
            ]
        },
        {
            "id": "1200802",
            "objective": "与神里绫华对话",
            "dialogues": []
        },
        {
            "id": "1200809",
            "objective": "与神里绫华一起进入祭典",
            "dialogues": [
                {
                    "id": "120080901",
                    "speaker": "清水",
                    "text": "大家都要顺利啊！"
                }
            ]
        },
        {
            "id": "1200806",
            "objective": "与神里绫华对话",
            "dialogues": [
                {
                    "id": "120080501",
                    "speaker": "神里绫华",
                    "text": "祭典还没有关闭，只是人不多了…我们得抓紧游玩。"
                },
                {
                    "id": "120080502",
                    "speaker": "派蒙",
                    "text": "喂，你们看，那边摊子上有好多面具呀！"
                },
                {
                    "id": "120080503",
                    "speaker": "派蒙",
                    "text": "听说参加祭典要戴面具，现在还有这种规矩吗？"
                },
                {
                    "id": "120080504",
                    "speaker": "神里绫华",
                    "text": "以前会有这样的风俗哦，流传至今，就变成了一种流行的祭典装扮。不过，也不是绝对的。"
                },
                {
                    "id": "120080505",
                    "speaker": "三田",
                    "text": "哟！这不是神里家的大小姐吗？"
                },
                {
                    "id": "120080506",
                    "speaker": "神里绫华",
                    "text": "啊！我…咳咳，您好呀。"
                },
                {
                    "id": "120080507",
                    "speaker": "派蒙",
                    "text": "#{NICKNAME}，一路上真的好多人都认识绫华，果然是稻妻的名人呀…"
                },
                {
                    "id": "120080508",
                    "speaker": "三田",
                    "text": "哈哈哈，当然啦！社奉行神里家是咱们稻妻非常有名望的家族哦。"
                },
                {
                    "id": "120080509",
                    "speaker": "三田",
                    "text": "尤其是神里兄妹刚接手家业的时候，经常在外露面。"
                },
                {
                    "id": "120080510",
                    "speaker": "三田",
                    "text": "有些年轻人出生得晚，无缘得见神里大小姐，像我这种活得比较久的大叔，还是在许多地方见过她的呢。"
                },
                {
                    "id": "120080511",
                    "speaker": "神里绫华",
                    "text": "您过奖了，我和兄长大人也只是完成应尽的义务而已。"
                },
                {
                    "id": "120080512",
                    "speaker": "三田",
                    "text": "哈哈哈哈，我还是头一回看到你家的人来祭典呢，是来执行公务吗？"
                },
                {
                    "id": "120080513",
                    "speaker": "神里绫华",
                    "text": "……"
                },
                {
                    "id": "120080514",
                    "speaker": "神里绫华",
                    "text": "不是哦，我是带我身边这位旅行者前来游览的。"
                },
                {
                    "id": "120080515",
                    "speaker": "三田",
                    "text": "哦？旅行者！这么一看…确实是张陌生面孔哪！"
                },
                {
                    "id": "120080516",
                    "speaker": "三田",
                    "text": "年轻人，第一次来稻妻吧？希望你们能玩得开心。"
                },
                {
                    "id": "120080517",
                    "speaker": "三田",
                    "text": "哎，对了！"
                },
                {
                    "id": "120080518",
                    "speaker": "三田",
                    "text": "喂伙计们——！神里大小姐来祭典玩啦，都别急着收摊啊！"
                },
                {
                    "id": "120080519",
                    "speaker": "神里绫华",
                    "text": "不、不是！"
                },
                {
                    "id": "120080520",
                    "speaker": "神里绫华",
                    "text": "请您、请您不要这样声张，我们只是…"
                },
                {
                    "id": "120080521",
                    "speaker": "Player",
                    "text": "谢谢老板。"
                },
                {
                    "id": "120080522",
                    "speaker": "派蒙",
                    "text": "谢谢老板啦！你要是不打招呼，里头的人就该收摊了吧？"
                },
                {
                    "id": "120080523",
                    "speaker": "派蒙",
                    "text": "毕竟，看起来也已经到下班时间了呢。"
                },
                {
                    "id": "120080524",
                    "speaker": "三田",
                    "text": "哈哈哈！说是这么说，但我们可是第一次碰见神里大小姐光临祭典，就冲着这个，也该再支一会儿摊子！"
                },
                {
                    "id": "120080525",
                    "speaker": "三田",
                    "text": "啊对，这两个面具送你们吧。"
                },
                {
                    "id": "120080526",
                    "speaker": "神里绫华",
                    "text": "不不不，已经受您很多照顾了，我们不能…"
                },
                {
                    "id": "120080527",
                    "speaker": "三田",
                    "text": "行了，拿着吧！"
                },
                {
                    "id": "120080528",
                    "speaker": "三田",
                    "text": "咱们这些平民百姓平时没少受社奉行关照，总得有个表示吧？你要是不拿，就是不给大叔面子哦。"
                },
                {
                    "id": "120080529",
                    "speaker": "神里绫华",
                    "text": "可是…"
                },
                {
                    "id": "120080530",
                    "speaker": "神里绫华",
                    "text": "…我…我知道了。"
                },
                {
                    "id": "120080531",
                    "speaker": "Player",
                    "text": "大叔，你人真好。"
                },
                {
                    "id": "120080532",
                    "speaker": "三田",
                    "text": "哈哈哈哈哈，别客气，要开心！"
                },
                {
                    "id": "120080533",
                    "speaker": "派蒙",
                    "text": "大叔大叔，我有份吗？"
                },
                {
                    "id": "120080534",
                    "speaker": "三田",
                    "text": "哎呀，这位小朋友…这…这个尺寸的迷你面具，还真没有，不好意思。"
                },
                {
                    "id": "120080535",
                    "speaker": "派蒙",
                    "text": "不会只有我一个人孤零零地不戴面具参加祭典吧？"
                },
                {
                    "id": "120080536",
                    "speaker": "神里绫华",
                    "text": "派蒙，其实，面具也不是必须的哦…"
                },
                {
                    "id": "120080537",
                    "speaker": "派蒙",
                    "text": "但是…但是这样会有种被排挤的感觉嘛！"
                },
                {
                    "id": "120080538",
                    "speaker": "三田",
                    "text": "或者，戴树叶怎么样？挡你的脸应该够了吧。"
                },
                {
                    "id": "120080539",
                    "speaker": "派蒙",
                    "text": "啊——！不要啦！"
                },
                {
                    "id": "120080540",
                    "speaker": "三田",
                    "text": "哎呀哈哈哈哈哈，那没办法啦，不过你放心，大叔回去就安排做一批迷你面具。"
                },
                {
                    "id": "120080541",
                    "speaker": "神里绫华",
                    "text": "真的非常感谢您。"
                },
                {
                    "id": "120080542",
                    "speaker": "三田",
                    "text": "小意思小意思！大小姐，趁着灯火还亮，请你抓紧享受夜色下的祭典吧。"
                },
                {
                    "id": "120080543",
                    "speaker": "神里绫华",
                    "text": "嗯！那旅行者，我们走吧？"
                },
                {
                    "id": "120080544",
                    "speaker": "神里绫华",
                    "text": "啊等等…请等一下。"
                },
                {
                    "id": "120080545",
                    "speaker": "神里绫华",
                    "text": "有件事我想解释，刚才我有点紧张，就、就找了个借口…不是只为了给你当导游！请相信我！"
                },
                {
                    "id": "120080546",
                    "speaker": "神里绫华",
                    "text": "我…嗯…我…是真心要和你一起来的。",
                    "choices": [
                        {
                            "id": "120080547",
                            "text": "我知道你的脾气。",
                            "response": [
                                {
                                    "id": "120080549",
                                    "speaker": "神里绫华",
                                    "text": "…嗯！"
                                }
                            ]
                        },
                        {
                            "id": "120080548",
                            "text": "绫华不用担心我误会。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1200810",
            "objective": "跟随神里绫华",
            "dialogues": [
                {
                    "id": "120081001",
                    "speaker": "村上",
                    "text": "美食是生活的支柱，你们也要多享受美食！"
                }
            ]
        },
        {
            "id": "1200807",
            "objective": "与神里绫华对话",
            "dialogues": [
                {
                    "id": "120081501",
                    "speaker": "派蒙",
                    "text": "真是个好兆头呢。"
                },
                {
                    "id": "120081502",
                    "speaker": "神里绫华",
                    "text": "恭喜你。"
                },
                {
                    "id": "120081503",
                    "speaker": "清水",
                    "text": "几位客人的运势太厉害了，有这样的好运，不论想做什么，肯定都能如愿以偿。"
                },
                {
                    "id": "120081504",
                    "speaker": "派蒙",
                    "text": "对对，希望接下来的日子里我们还能好运连连！"
                }
            ]
        },
        {
            "id": "1200811",
            "objective": "跟随神里绫华",
            "dialogues": [
                {
                    "id": "120081101",
                    "speaker": "吉川",
                    "text": "我们摊位的绘马很灵验哦，各位的心愿一定会实现。"
                }
            ]
        },
        {
            "id": "1200808",
            "objective": "与神里绫华对话",
            "dialogues": [
                {
                    "id": "120080701",
                    "speaker": "神里绫华",
                    "text": "这边是小吃摊位，有很多稻妻特色美食。你们想吃什么，我去买！"
                },
                {
                    "id": "120080702",
                    "speaker": "派蒙",
                    "text": "这里每一种食物看起来都好好吃，哇…我可以都要吗？"
                },
                {
                    "id": "120080703",
                    "speaker": "神里绫华",
                    "text": "哈哈哈，当然可以啦。"
                },
                {
                    "id": "120080704",
                    "speaker": "派蒙",
                    "text": "不过买太多也会浪费吧，我们一个一个试过来！"
                },
                {
                    "id": "120080705",
                    "speaker": "派蒙",
                    "text": "绫华，我想要那边的团子！"
                },
                {
                    "id": "120080706",
                    "speaker": "神里绫华",
                    "text": "好的好的。"
                },
                {
                    "id": "120080707",
                    "speaker": "Player",
                    "text": "我要那个粉色的饼。"
                },
                {
                    "id": "120080708",
                    "speaker": "派蒙",
                    "text": "那个看起来也很好吃！还有那边那个叫「鸟蛋烧」的东西，我也想吃吃看。"
                },
                {
                    "id": "120080709",
                    "speaker": "神里绫华",
                    "text": "那么，我也要这款「绯樱饼」吧。"
                },
                {
                    "id": "120080710",
                    "speaker": "村上",
                    "text": "没问题，马上就来！"
                },
                {
                    "id": "120080711",
                    "speaker": "神里绫华",
                    "text": "唔！绯樱饼好好吃…！"
                },
                {
                    "id": "120080712",
                    "speaker": "村上",
                    "text": "对吧？这是我们摊子的特色，人气可高了。"
                },
                {
                    "id": "120080713",
                    "speaker": "派蒙",
                    "text": "老板我还想再来一份！"
                },
                {
                    "id": "120080714",
                    "speaker": "神里绫华",
                    "text": "可能有些冒昧，但我想请问一下，这种点心是怎么做的呢？"
                },
                {
                    "id": "120080715",
                    "speaker": "村上",
                    "text": "你想学吗？哈哈哈，可以可以，稍等啊，我抄一份菜谱给你。"
                },
                {
                    "id": "120080716",
                    "speaker": "派蒙",
                    "text": "是新菜谱！"
                },
                {
                    "id": "120080717",
                    "speaker": "神里绫华",
                    "text": "哎？直接把菜谱分享给我真的没关系吗？不、不是会涉及到商业机密…什么的…"
                },
                {
                    "id": "120080718",
                    "speaker": "村上",
                    "text": "你们给「木南料亭」的店主送了份异国菜谱，对吧？"
                },
                {
                    "id": "120080719",
                    "speaker": "村上",
                    "text": "哈哈哈，我跟她是老朋友了，平时常在一起切磋厨艺。"
                },
                {
                    "id": "120080720",
                    "speaker": "村上",
                    "text": "这份菜谱就当是我替朋友谢谢你们，拿着吧。"
                },
                {
                    "id": "120080721",
                    "speaker": "神里绫华",
                    "text": "…谢谢您，回去以后我一定会认真学习制作这种美味点心的方法。"
                },
                {
                    "id": "120080722",
                    "speaker": "村上",
                    "text": "那边那位客人也拿一份吧？可好吃了！"
                },
                {
                    "id": "120080723",
                    "speaker": "Player",
                    "text": "谢谢老板！"
                },
                {
                    "id": "120080724",
                    "speaker": "村上",
                    "text": "亲手做出美味食物的感觉，别提有多好了，你们一定要试试。"
                },
                {
                    "id": "120080725",
                    "speaker": "神里绫华",
                    "text": "嗯！"
                },
                {
                    "id": "120080726",
                    "speaker": "神里绫华",
                    "text": "等我学会做这道点心…可以请旅行者和派蒙来试吃吗？"
                },
                {
                    "id": "120080727",
                    "speaker": "派蒙",
                    "text": "好啊好啊，那就说好了！"
                },
                {
                    "id": "120080728",
                    "speaker": "Player",
                    "text": "等你的好消息。"
                },
                {
                    "id": "120080729",
                    "speaker": "神里绫华",
                    "text": "好的，我会加油！"
                }
            ]
        },
        {
            "id": "1200812",
            "objective": "继续跟随神里绫华",
            "dialogues": [
                {
                    "id": "120081201",
                    "speaker": "Player",
                    "text": "我的是「大吉·天」。"
                },
                {
                    "id": "120081202",
                    "speaker": "神里绫华",
                    "text": "哇…你运气真好啊。"
                },
                {
                    "id": "120081203",
                    "speaker": "清水",
                    "text": "客人恭喜啦，「大吉·天」，意为：云天有神威，风调雨顺，万事兴盛。您一定会继续交好运的哦！"
                }
            ]
        },
        {
            "id": "1200803",
            "objective": "与神里绫华对话",
            "dialogues": [
                {
                    "id": "120080201",
                    "speaker": "神里绫华",
                    "text": "这里是买「绘马」的摊位。稻妻的人们会在名为「绘马」的五边形木板上画下或写下心愿，并祈求它能被实现。"
                },
                {
                    "id": "120080202",
                    "speaker": "派蒙",
                    "text": "听起来跟璃月的海灯有点像，都是用来祈愿的道具。"
                },
                {
                    "id": "120080203",
                    "speaker": "吉川",
                    "text": "几位，需要「绘马」吗？趁着祭典最后的时光，许下你珍贵的心愿吧！"
                },
                {
                    "id": "120080204",
                    "speaker": "派蒙",
                    "text": "试试吧？感觉很有意思！"
                },
                {
                    "id": "120080205",
                    "speaker": "派蒙",
                    "text": "不过，还要写和画，我就不用了吧…刚才吃得太饱，现在头晕脑胀的，不想做太需要智慧的事…"
                },
                {
                    "id": "120080206",
                    "speaker": "神里绫华",
                    "text": "老板，我们要两个绘马。"
                },
                {
                    "id": "120080207",
                    "speaker": "吉川",
                    "text": "好嘞，两个绘马，给您拿来喽！"
                },
                {
                    "id": "120080208",
                    "speaker": "神里绫华",
                    "text": "旅行者想好许什么愿望了吗？"
                },
                {
                    "id": "120080209",
                    "speaker": "Player",
                    "text": "我想好了，你呢？"
                },
                {
                    "id": "120080210",
                    "speaker": "神里绫华",
                    "text": "我也想好了。"
                },
                {
                    "id": "120080211",
                    "speaker": "吉川",
                    "text": "请二位把愿望以文字或绘画的方式呈现在绘马上，完成后，就可以挂到旁边的「绘马架」上了。"
                },
                {
                    "id": "120080212",
                    "speaker": "派蒙",
                    "text": "原来还要展示出来！"
                },
                {
                    "id": "120080213",
                    "speaker": "派蒙",
                    "text": "#好，{NICKNAME}，给大家露一手吧！"
                },
                {
                    "id": "120080214",
                    "speaker": "神里绫华",
                    "text": "这样就可以了。"
                },
                {
                    "id": "120080215",
                    "speaker": "神里绫华",
                    "text": "可以看看你的绘马吗？"
                },
                {
                    "id": "120080216",
                    "speaker": "Player",
                    "text": "没问题。"
                },
                {
                    "id": "120080217",
                    "speaker": "神里绫华",
                    "text": "#这是你和你的{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTER]}对吧？"
                },
                {
                    "id": "120080218",
                    "speaker": "神里绫华",
                    "text": "真可爱呢。"
                },
                {
                    "id": "120080219",
                    "speaker": "Player",
                    "text": "#嗯。我想找回{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}。"
                },
                {
                    "id": "120080220",
                    "speaker": "派蒙",
                    "text": "会找到的，一定要有信心！"
                },
                {
                    "id": "120080221",
                    "speaker": "神里绫华",
                    "text": "嗯，派蒙说得对，你许下的心愿一定会实现。"
                },
                {
                    "id": "120080222",
                    "speaker": "神里绫华",
                    "text": "我也会一直为你祈祷。"
                },
                {
                    "id": "120080223",
                    "speaker": "派蒙",
                    "text": "绫华这边画的…是天守阁吗？"
                },
                {
                    "id": "120080224",
                    "speaker": "神里绫华",
                    "text": "是的，我的愿望是稻妻的大家平安幸福，家人朋友都能身体健康。"
                },
                {
                    "id": "120080225",
                    "speaker": "神里绫华",
                    "text": "希望这个愿望能够实现…"
                },
                {
                    "id": "120080226",
                    "speaker": "Player",
                    "text": "会实现的。"
                },
                {
                    "id": "120080227",
                    "speaker": "神里绫华",
                    "text": "嗯，承你吉言。"
                },
                {
                    "id": "120080228",
                    "speaker": "神里绫华",
                    "text": "呀，时间差不多了哦。"
                },
                {
                    "id": "120080229",
                    "speaker": "派蒙",
                    "text": "啊…已经要走了吗？"
                },
                {
                    "id": "120080230",
                    "speaker": "神里绫华",
                    "text": "是啊，祭典差不多要结束了。"
                },
                {
                    "id": "120080231",
                    "speaker": "神里绫华",
                    "text": "越快乐，时光便流逝得越快…就像流水与落樱。"
                },
                {
                    "id": "120080232",
                    "speaker": "神里绫华",
                    "text": "……"
                },
                {
                    "id": "120080233",
                    "speaker": "神里绫华",
                    "text": "我们回去吧。"
                }
            ]
        },
        {
            "id": "1200816",
            "objective": "(test)【隐藏】控制回滚创建圈$HIDDEN",
            "dialogues": []
        },
        {
            "id": "1200804",
            "objective": "与神里绫华对话",
            "dialogues": [
                {
                    "id": "120080301",
                    "speaker": "神里绫华",
                    "text": "旅行者，其实…今天是我第一次像这样来祭典玩。"
                },
                {
                    "id": "120080302",
                    "speaker": "神里绫华",
                    "text": "认识至今，我的性格，你应该已经了解了吧？"
                },
                {
                    "id": "120080303",
                    "speaker": "神里绫华",
                    "text": "像我这种脾气…如果没有你的话，今天我不会过得这么开心。"
                },
                {
                    "id": "120080304",
                    "speaker": "神里绫华",
                    "text": "谢谢你，今天对我来说是个意义重大的日子，我会永远铭记在心。"
                },
                {
                    "id": "120080305",
                    "speaker": "神里绫华",
                    "text": "祭典真好啊！没有那么多规矩，每个人脸上都洋溢着发自内心的笑容，自在又快乐…"
                },
                {
                    "id": "120080306",
                    "speaker": "神里绫华",
                    "text": "要是有机会…嘿嘿，我还想再去一次。"
                },
                {
                    "id": "120080307",
                    "speaker": "Player",
                    "text": "我也想再去玩。"
                },
                {
                    "id": "120080308",
                    "speaker": "神里绫华",
                    "text": "你也是吗？太好了！"
                },
                {
                    "id": "120080309",
                    "speaker": "神里绫华",
                    "text": "说起来，我和旅行者有点像呢，都有兄长。"
                },
                {
                    "id": "120080310",
                    "speaker": "神里绫华",
                    "text": "#有时我会觉得自己非常能理解你急于找回{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTER]}的心情。",
                    "choices": [
                        {
                            "id": "120080311",
                            "text": "#嗯，{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}对我非常重要。",
                            "response": [
                                {
                                    "id": "120080313",
                                    "speaker": "神里绫华",
                                    "text": "……"
                                },
                                {
                                    "id": "120080314",
                                    "speaker": "神里绫华",
                                    "text": "嗯，我明白哦。"
                                },
                                {
                                    "id": "120080315",
                                    "speaker": "神里绫华",
                                    "text": "家人和亲缘，是我们谁都无法杜绝的羁绊…是我们在这个世界上最重要的「根」。"
                                },
                                {
                                    "id": "120080316",
                                    "speaker": "神里绫华",
                                    "text": "#你一定能找到{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}的，千万不要放弃。"
                                },
                                {
                                    "id": "120080317",
                                    "speaker": "神里绫华",
                                    "text": "作为…咳！作为朋友，我会一直守望、支持你。",
                                    "choices": [
                                        {
                                            "id": "120080318",
                                            "text": "谢谢你，绫华。",
                                            "response": [
                                                {
                                                    "id": "120080321",
                                                    "speaker": "神里绫华",
                                                    "text": "……！"
                                                },
                                                {
                                                    "id": "120080322",
                                                    "speaker": "神里绫华",
                                                    "text": "嗯，那我就放心了！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "120080319",
                                            "text": "今天我也很开心哦。"
                                        },
                                        {
                                            "id": "120080320",
                                            "text": "感谢你今天的招待。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "120080312",
                            "text": "#寻找{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}，正是我旅行的意义。"
                        }
                    ]
                }
            ]
        },
        {
