            "dialogues": [
                {
                    "id": "120081301",
                    "speaker": "Player",
                    "text": "我的是「大吉·地」。"
                },
                {
                    "id": "120081302",
                    "speaker": "神里绫华",
                    "text": "哇…你运气真好啊。"
                },
                {
                    "id": "120081303",
                    "speaker": "清水",
                    "text": "客人恭喜啦，「大吉·地」，意为：宝财临门楣，地生万运，事事如意。您一定会继续交好运的哦！"
                }
            ]
        },
