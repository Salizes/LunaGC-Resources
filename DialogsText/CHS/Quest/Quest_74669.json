    "talks": [
        {
            "id": "7466901",
            "objective": "向水边的人搭话",
            "dialogues": [
                {
                    "id": "746690101",
                    "speaker": "布列松",
                    "text": "布列松，你要相信自己…相信自己，所有的器材都准备好了…"
                },
                {
                    "id": "746690102",
                    "speaker": "布列松",
                    "text": "只要…呼…只要你下水…下水证明一下这些器材的可靠性，一切就大功告成…"
                },
                {
                    "id": "746690103",
                    "speaker": "Player",
                    "text": "你在做什么呢？"
                },
                {
                    "id": "746690104",
                    "speaker": "布列松",
                    "text": "哎哟！您是从哪冒出来的，怎么连一点声响都没有？！"
                },
                {
                    "id": "746690105",
                    "speaker": "布列松",
                    "text": "我吓得差点栽进水里…要是我刚才没稳住，枫丹留影技术就没有未来了！",
                    "choices": [
                        {
                            "id": "746690106",
                            "text": "抱歉啦。",
                            "response": [
                                {
                                    "id": "746690108",
                                    "speaker": "派蒙",
                                    "text": "不过，你不会游泳吗？"
                                },
                                {
                                    "id": "746690109",
                                    "speaker": "Player",
                                    "text": "看起来你也是个枫丹人啊。"
                                },
                                {
                                    "id": "746690110",
                                    "speaker": "布列松",
                                    "text": "谁…谁说枫丹人一定要会游泳了？也不是每一个璃月人都会做菜，每一个蒙德人都会作诗吧？"
                                },
                                {
                                    "id": "746690111",
                                    "speaker": "布列松",
                                    "text": "我不和您说了，好不容易才借来这一套潜水设备，今天我必须去水下留影一趟…"
                                },
                                {
                                    "id": "746690112",
                                    "speaker": "派蒙",
                                    "text": "原来是这样啊…"
                                },
                                {
                                    "id": "746690113",
                                    "speaker": "Player",
                                    "text": "这留影机有什么特别之处？"
                                },
                                {
                                    "id": "746690114",
                                    "speaker": "布列松",
                                    "text": "特别之处？这台留影机是由我布列松·卡蒂亲自改造过的，这就是它的「特别之处」。"
                                },
                                {
                                    "id": "746690115",
                                    "speaker": "布列松",
                                    "text": "我的改造方法既严谨，又巧妙，采用的材料也都是最好的。"
                                },
                                {
                                    "id": "746690131",
                                    "speaker": "布列松",
                                    "text": "镜头更是比其他留影机好上无数倍，在水下留影时，画片的质量没有丝毫折损！"
                                },
                                {
                                    "id": "746690116",
                                    "speaker": "布列松",
                                    "text": "但协会里的那群家伙…对我的新技术根本不在意，还说什么留影主要靠留影者的技术，留影器材不重要…"
                                },
                                {
                                    "id": "746690117",
                                    "speaker": "布列松",
                                    "text": "等我拍出几张漂亮的画片，准能让这群压根不懂留影器材重要性的家伙闭嘴！"
                                },
                                {
                                    "id": "746690118",
                                    "speaker": "布列松",
                                    "text": "呼…布列松，你要相信自己…相信自己…水温很合适，水里也没有会吃人的鱼…"
                                },
                                {
                                    "id": "746690119",
                                    "speaker": "布列松",
                                    "text": "我…我…哎哟！这潜水服真能管用吗？说不定它会在水底突然爆裂啊！"
                                },
                                {
                                    "id": "746690120",
                                    "speaker": "布列松",
                                    "text": "然后我就会被暗流卷到水底，谁也发现不了我，天哪，哎哟…",
                                    "choices": [
                                        {
                                            "id": "746690121",
                                            "text": "实在不行，我可以帮忙啦…",
                                            "response": [
                                                {
                                                    "id": "746690123",
                                                    "speaker": "布列松",
                                                    "text": "#真的吗？！您愿意帮我？慷慨的好{M#先生}{F#女士}，您真是我的大救星！",
                                                    "choices": [
                                                        {
                                                            "id": "746690124",
                                                            "text": "你还是得付我报酬。",
                                                            "response": [
                                                                {
                                                                    "id": "746690126",
                                                                    "speaker": "布列松",
                                                                    "text": "我当然不可能让您白帮我跑这一趟，您一定能拿到一大笔报酬。"
                                                                },
                                                                {
                                                                    "id": "746690127",
                                                                    "speaker": "布列松",
                                                                    "text": "对了，我还得把几处水底的好风景标在您的地图上…"
                                                                },
                                                                {
                                                                    "id": "746690128",
                                                                    "speaker": "布列松",
                                                                    "text": "还有一些地上的，呃…应该是在这附近…这是全新的器材，得多找几个地方测试一下。"
                                                                },
                                                                {
                                                                    "id": "746690129",
                                                                    "speaker": "布列松",
                                                                    "text": "这样就行了，枫丹留影技术的未来，还有我的留影机器材事业，就全部拜托给您了。"
                                                                },
                                                                {
                                                                    "id": "746690130",
                                                                    "speaker": "布列松",
                                                                    "text": "我就…呃…在岸上等着您。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "746690125",
                                                            "text": "但报酬要按照协会的规矩。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "746690122",
                                            "text": "不然…我帮你去水下留影吧？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "746690107",
                            "text": "也没想到你反应这么大…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7466902",
            "objective": "向水边的人搭话",
            "dialogues": []
        }
    ]
}