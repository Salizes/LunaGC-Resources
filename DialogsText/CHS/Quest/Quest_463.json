    "talks": [
        {
            "id": "46300",
            "objective": "与派蒙商量下一步行动",
            "dialogues": [
                {
                    "id": "4630001",
                    "speaker": "派蒙",
                    "text": "这下谜团都解开啦，真是花了很多功夫呢。"
                },
                {
                    "id": "4630014",
                    "speaker": "派蒙",
                    "text": "不过话说回来，这张藏宝图画的还真是潦草呢…确实像是出自海盗之手。"
                },
                {
                    "id": "4630002",
                    "speaker": "派蒙",
                    "text": "那么现在…",
                    "choices": [
                        {
                            "id": "4630003",
                            "text": "先去向凯亚汇报一下。",
                            "response": [
                                {
                                    "id": "4630004",
                                    "speaker": "派蒙",
                                    "text": "嗯…？派蒙觉得，不，需，要，哦。"
                                },
                                {
                                    "id": "4630006",
                                    "speaker": "派蒙",
                                    "text": "不愧是派蒙的伙伴！和派蒙想的…完，全，一，样！"
                                },
                                {
                                    "id": "4630007",
                                    "speaker": "派蒙",
                                    "text": "不直接过去的话，万一被别人抢先可就麻烦啦。"
                                },
                                {
                                    "id": "4630008",
                                    "speaker": "派蒙",
                                    "text": "比如凯亚…嗯，凯亚说过的「盗宝团」之类的家伙。"
                                },
                                {
                                    "id": "4630009",
                                    "speaker": "派蒙",
                                    "text": "总之，我最多只是想借来那把剑…"
                                },
                                {
                                    "id": "4630010",
                                    "speaker": "派蒙",
                                    "text": "不、不，只是想去看一眼而已！"
                                },
                                {
                                    "id": "4630011",
                                    "speaker": "派蒙",
                                    "text": "绝不是想着什么天下无敌、高枕无忧吃喝玩乐…之类的事！"
                                },
                                {
                                    "id": "4630012",
                                    "speaker": "派蒙",
                                    "text": "好了，闲话就等到找到宝藏以后再说吧。"
                                },
                                {
                                    "id": "4630013",
                                    "speaker": "派蒙",
                                    "text": "阿卡狄亚寻宝之旅——正式启程！"
                                }
                            ]
                        },
                        {
                            "id": "4630005",
                            "text": "直奔藏宝地点吧！"
                        }
                    ]
                }
            ]
        },
        {
            "id": "46301",
            "objective": "根据地图找到宝藏埋藏地",
            "dialogues": [
                {
                    "id": "4630101",
                    "speaker": "派蒙",
                    "text": "「阿卡狄亚遗迹」就是这里了吧。"
                },
                {
                    "id": "4630102",
                    "speaker": "派蒙",
                    "text": "怎么说…感觉稍微有些普通？"
                },
                {
                    "id": "4630103",
                    "speaker": "派蒙",
                    "text": "我明白了，正所谓越是普通的地方，越容易被人忽视。"
                },
                {
                    "id": "4630104",
                    "speaker": "派蒙",
                    "text": "真是深刻，凯亚的爷爷果然厉害。"
                },
                {
                    "id": "4630105",
                    "speaker": "???",
                    "text": "——沙沙，咯噔。"
                },
                {
                    "id": "4630106",
                    "speaker": "Player",
                    "text": "嗯？派蒙，你听…"
                },
                {
                    "id": "4630107",
                    "speaker": "派蒙",
                    "text": "是老鼠。"
                },
                {
                    "id": "4630108",
                    "speaker": "Player",
                    "text": "回答得太轻易了吧。"
                },
                {
                    "id": "4630109",
                    "speaker": "派蒙",
                    "text": "唔…别疑神疑鬼了，不会有什么问题的。"
                },
                {
                    "id": "4630110",
                    "speaker": "派蒙",
                    "text": "动作要快！宝藏已经在里面等我们很久啦！"
                }
            ]
        },
        {
            "id": "46307",
            "objective": "(test)无$HIDDEN",
            "dialogues": []
        },
        {
            "id": "46302",
            "objective": "进入遗迹深处",
            "dialogues": []
        },
        {
            "id": "46303",
            "objective": "(test)与派蒙对话$HIDDEN",
            "dialogues": [
                {
                    "id": "4630301",
                    "speaker": "派蒙",
                    "text": "呼…这里就是尽头了？"
                },
                {
                    "id": "4630302",
                    "speaker": "派蒙",
                    "text": "宝藏~宝藏~藏在哪里呀~"
                },
                {
                    "id": "4630303",
                    "speaker": "派蒙",
                    "text": "#{NICKNAME}，一起在附近找找吧。"
                },
                {
                    "id": "4630304",
                    "speaker": "???",
                    "text": "哈哈哈…这就不用麻烦你们了。"
                },
                {
                    "id": "4630305",
                    "speaker": "???",
                    "text": "剩下的，由我来接手就好。",
                    "choices": [
                        {
                            "id": "4630306",
                            "text": "盗宝团的人？",
                            "response": [
                                {
                                    "id": "4630307",
                                    "speaker": "???",
                                    "text": "真是机灵，不过现在才发现是不是有点太晚了？"
                                },
                                {
                                    "id": "4630311",
                                    "speaker": "伊扎德",
                                    "text": "你们好，我是伊扎德。"
                                },
                                {
                                    "id": "4630312",
                                    "speaker": "伊扎德",
                                    "text": "替盗宝团说声谢谢吧，感谢两位好心人为我带路。"
                                },
                                {
                                    "id": "4630313",
                                    "speaker": "派蒙",
                                    "text": "唔啊…"
                                },
                                {
                                    "id": "4630314",
                                    "speaker": "派蒙",
                                    "text": "真是奇怪，我们明明一直都在暗中行动，宝藏的秘密是怎么泄露的？"
                                },
                                {
                                    "id": "4630315",
                                    "speaker": "Player",
                                    "text": "我倒是完全不觉得奇怪。"
                                },
                                {
                                    "id": "4630316",
                                    "speaker": "派蒙",
                                    "text": "哼！我可不会甘心的。喂，盗宝贼！你以为我们不会反抗吗！"
                                },
                                {
                                    "id": "4630317",
                                    "speaker": "伊扎德",
                                    "text": "你要是这么瞧不起我们的实力，一会就别太吃惊了。"
                                },
                                {
                                    "id": "4630318",
                                    "speaker": "伊扎德",
                                    "text": "只要我一声令下，外面埋伏的兄弟们就会来和你们打招呼了。"
                                },
                                {
                                    "id": "4630319",
                                    "speaker": "伊扎德",
                                    "text": "可惜啊，他们不会像我这么好说话的，哈哈哈哈……"
                                },
                                {
                                    "id": "4630320",
                                    "speaker": "凯亚",
                                    "text": "（凯亚和西风骑士登场）"
                                },
                                {
                                    "id": "4630321",
                                    "speaker": "凯亚",
                                    "text": "在阁下这么开心的时候来打搅，真是不好意思。"
                                },
                                {
                                    "id": "4630322",
                                    "speaker": "凯亚",
                                    "text": "至于你的那些兄弟嘛，他们已经没法回应你了。"
                                },
                                {
                                    "id": "4630323",
                                    "speaker": "凯亚",
                                    "text": "恐怕你…只能去蒙德的监狱里探访他们了。"
                                },
                                {
                                    "id": "4630324",
                                    "speaker": "凯亚",
                                    "text": "或者，与他们做个狱友，也不错吧？"
                                },
                                {
                                    "id": "4630325",
                                    "speaker": "伊扎德",
                                    "text": "骑士团的人…？！"
                                },
                                {
                                    "id": "4630326",
                                    "speaker": "派蒙",
                                    "text": "哇，是凯亚！"
                                },
                                {
                                    "id": "4630327",
                                    "speaker": "派蒙",
                                    "text": "——凯亚，他在打你的宝藏的主意！快点把他抓起来！"
                                },
                                {
                                    "id": "4630328",
                                    "speaker": "伊扎德",
                                    "text": "嘁，糟心啊，明明就快到手了…"
                                },
                                {
                                    "id": "4630329",
                                    "speaker": "凯亚",
                                    "text": "哦呵，宝藏？"
                                },
                                {
                                    "id": "4630330",
                                    "speaker": "凯亚",
                                    "text": "不好意思了，这里根本没有什么宝藏。"
                                },
                                {
                                    "id": "4630331",
                                    "speaker": "凯亚",
                                    "text": "辛苦你们白跑一趟。那么现在，束手就擒吧。"
                                },
                                {
                                    "id": "4630332",
                                    "speaker": "派蒙",
                                    "text": "咦？"
                                },
                                {
                                    "id": "4630333",
                                    "speaker": "派蒙",
                                    "text": "没有…宝藏？"
                                },
                                {
                                    "id": "4630334",
                                    "speaker": "派蒙",
                                    "text": "凯亚刚才是不是说…没有…宝藏？"
                                },
                                {
                                    "id": "4630335",
                                    "speaker": "伊扎德",
                                    "text": "哈哈。被算计了…没想到骑士也会用这种下作手段…"
                                },
                                {
                                    "id": "4630336",
                                    "speaker": "凯亚",
                                    "text": "身为盗贼就不要随便评论骑士的智慧…喂，等等，你想干什么？"
                                },
                                {
                                    "id": "4630337",
                                    "speaker": "伊扎德",
                                    "text": "谁要被你们抓住啊！"
                                },
                                {
                                    "id": "4630338",
                                    "speaker": "伊扎德",
                                    "text": "这…这是什么？我不是故意的！"
                                }
                            ]
                        },
                        {
                            "id": "4630308",
                            "text": "…是情报交易所的人吗？",
                            "response": [
                                {
                                    "id": "4630309",
                                    "speaker": "???",
                                    "text": "哈哈哈，情报交易所。我倒是和他们打过交道。"
                                },
                                {
                                    "id": "4630310",
                                    "speaker": "???",
                                    "text": "都是些守规矩的商人，发不了大财的家伙们…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "46304",
            "objective": "击败遗迹守卫",
            "dialogues": []
        },
        {
            "id": "46305",
            "objective": "(test)听凯亚解释「宝藏」的真相$HIDDEN",
            "dialogues": [
                {
                    "id": "4630501",
                    "speaker": "伊扎德",
                    "text": "呼…没想到居然混到了被骑士团救命的地步，真是丢脸。"
                },
                {
                    "id": "4630502",
                    "speaker": "凯亚",
                    "text": "别忘了你承诺过什么，否则刚才的东西绝对不会是你见过最可怕的东西…"
                },
                {
                    "id": "4630503",
                    "speaker": "伊扎德",
                    "text": "这…喂！你们骑士团都是这样对待嫌犯的吗…"
                },
                {
                    "id": "4630504",
                    "speaker": "凯亚",
                    "text": "开玩笑的。好了，把他带回蒙德城吧。"
                },
                {
                    "id": "4630505",
                    "speaker": "西风骑士",
                    "text": "是！凯亚队长。"
                },
                {
                    "id": "4630506",
                    "speaker": "西风骑士",
                    "text": "队长，这两个人也要一并带走吗？"
                },
                {
                    "id": "4630507",
                    "speaker": "派蒙",
                    "text": "什么？！"
                },
                {
                    "id": "4630508",
                    "speaker": "凯亚",
                    "text": "哈哈，不用了。这两位可是本次行动的功臣。"
                },
                {
                    "id": "4630509",
                    "speaker": "凯亚",
                    "text": "没有他们散布<color=#00E1FFFF>假情报</color>，我们也没那么容易搞定盗宝团。",
                    "choices": [
                        {
                            "id": "4630510",
                            "text": "果然是假情报。",
                            "response": [
                                {
                                    "id": "4630513",
                                    "speaker": "派蒙",
                                    "text": "呜呜呜…骗子！喜欢说谎的坏人！骑士团的败类！"
                                },
                                {
                                    "id": "4630514",
                                    "speaker": "凯亚",
                                    "text": "停，停——好啦，好啦。"
                                },
                                {
                                    "id": "4630515",
                                    "speaker": "凯亚",
                                    "text": "尽管宝藏是假的，但至少有那么一瞬间你是想要独吞的吧？"
                                },
                                {
                                    "id": "4630516",
                                    "speaker": "凯亚",
                                    "text": "不然，你们为什么不通知我，而是自己过来了？"
                                },
                                {
                                    "id": "4630517",
                                    "speaker": "派蒙",
                                    "text": "啊！…唔嗯嗯嗯嗯…哼！"
                                },
                                {
                                    "id": "4630518",
                                    "speaker": "派蒙",
                                    "text": "#{NICKNAME}，我们走！谁有空和这家伙理论啊！"
                                },
                                {
                                    "id": "4630519",
                                    "speaker": "凯亚",
                                    "text": "哈哈，稍等一下。"
                                },
                                {
                                    "id": "4630520",
                                    "speaker": "凯亚",
                                    "text": "二位帮了我这么大的忙，谢礼总是少不了的。"
                                },
                                {
                                    "id": "4630521",
                                    "speaker": "凯亚",
                                    "text": "这柄剑名为「斩开黎明指向胜利的拂晓神剑」，如它的名字一样，是象征光明与胜利之剑。"
                                },
                                {
                                    "id": "4630533",
                                    "speaker": "凯亚",
                                    "text": "不嫌弃的话，这柄我珍藏已久的「黎明神剑」就作为给两位的谢礼吧。"
                                },
                                {
                                    "id": "4630522",
                                    "speaker": "派蒙",
                                    "text": "「黎明神剑」？"
                                },
                                {
                                    "id": "4630523",
                                    "speaker": "凯亚",
                                    "text": "没错。与通情达理的派蒙阁下很相称吧？"
                                },
                                {
                                    "id": "4630524",
                                    "speaker": "派蒙",
                                    "text": "嗯…如果谢礼是这柄「黎明神剑」的话…"
                                },
                                {
                                    "id": "4630525",
                                    "speaker": "凯亚",
                                    "text": "你们会理解我的，对吗？"
                                },
                                {
                                    "id": "4630526",
                                    "speaker": "凯亚",
                                    "text": "有你们这样温柔又懂得体谅他人的朋友，是我凯亚的荣幸。"
                                },
                                {
                                    "id": "4630527",
                                    "speaker": "派蒙",
                                    "text": "嗯…嗯…"
                                },
                                {
                                    "id": "4630528",
                                    "speaker": "凯亚",
                                    "text": "这次的事实在抱歉，但请派蒙阁下放心，同样的伎俩我是不会用两次的。",
                                    "choices": [
                                        {
                                            "id": "4630529",
                                            "text": "…派蒙已经完全被掌控了呢。",
                                            "response": [
                                                {
                                                    "id": "4630531",
                                                    "speaker": "凯亚",
                                                    "text": "真是愉快的一天。那么，我还要回去审讯嫌犯…"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "4630530",
                                            "text": "…不同的伎俩就可以继续用吗。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "4630511",
                            "text": "果然根本没有什么宝藏。"
                        },
                        {
                            "id": "4630512",
                            "text": "原来我被骗了！震惊！"
                        }
                    ]
                }
            ]
        },
        {
            "id": "46306",
            "objective": "(test)无$HIDDEN",
            "dialogues": [
                {
                    "id": "4630601",
                    "speaker": "凯亚",
                    "text": "今天就先告辞了。以后也欢迎来骑士团找我，我们下次再见吧。"
                }
            ]
        },
        {
            "id": "46308",
            "objective": "(test)无$HIDDEN",
            "dialogues": []
        }
    ]
}