    "talks": [
        {
            "id": "7517801",
            "objective": "",
            "dialogues": [
                {
                    "id": "751780101",
                    "speaker": "派蒙",
                    "text": "你好啊！请问…"
                },
                {
                    "id": "751780102",
                    "speaker": "卢施",
                    "text": "#如此强大的「烈度」！不愧是传说的{NICKNAME}和派蒙！你们远道而来，莫不是来竞争这「沃陆之邦最强」名号的？"
                },
                {
                    "id": "751780103",
                    "speaker": "派蒙",
                    "text": "「沃陆之邦最强」？这里不就是普通的「勇士挑战」吗？那边明明有那么多人在排队呢！"
                },
                {
                    "id": "751780104",
                    "speaker": "卢施",
                    "text": "哈哈哈，他们可没办法跟你们相提并论。要知道，想要获得「最强」之名，只有战胜「最强」一途，寻常人可没这个资格。"
                },
                {
                    "id": "751780105",
                    "speaker": "卢施",
                    "text": "你们来得好啊！不过可惜啊，甚是可惜，你们来得不是时候。大师他现在无暇顾及这世上的俗务，恐怕暂时没有直面他的机会。",
                    "choices": [
                        {
                            "id": "751780106",
                            "text": "「最强」，身在何处？",
                            "response": [
                                {
                                    "id": "751780108",
                                    "speaker": "卢施",
                                    "text": "哦——？你是准备上门一战吗？好胆色，那我把大师的行踪告诉你也无妨。"
                                },
                                {
                                    "id": "751780110",
                                    "speaker": "卢施",
                                    "text": "沿着那条崎岖的修行之路寻找，你们会发现一片充满「烈度之水」的山地。在那里，你们或许能找到「最强」的身影…"
                                }
                            ]
                        },
                        {
                            "id": "751780107",
                            "text": "好吧，那我们等他回来。",
                            "response": [
                                {
                                    "id": "751780109",
                                    "speaker": "卢施",
                                    "text": "甚是，甚是，「烈度」与「烈度」终会相互吸引，「最强」与「最强」定会相遇，等待也不失为一种选择。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7517812",
            "objective": "工作人员常驻对话$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7517802",
            "objective": "(test)没问位置$HIDDEN",
            "dialogues": [
                {
                    "id": "751780201",
                    "speaker": "尤鲁赫",
                    "text": "有、有没有人帮忙搭把手！有人晕过去了！"
                },
                {
                    "id": "751780202",
                    "speaker": "派蒙",
                    "text": "#完、完蛋了！大师好像晕过去了！我们也快去帮忙吧，{NICKNAME}！"
                },
                {
                    "id": "751780203",
                    "speaker": "Black Screen",
                    "text": "大师似乎只是热晕了过去，身体并没有大碍。在你们的帮助下，晕倒的大师被尤鲁赫接走了…\\n看起来，大师本人的「烈度」，或许还有待进一步的提升…"
                }
            ]
        },
        {
            "id": "7517811",
            "objective": "(test)问了位置$HIDDEN",
            "dialogues": [
                {
                    "id": "751781101",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "呀？"
                },
                {
                    "id": "751781102",
                    "speaker": "派蒙",
                    "text": "#等等！{REALNAME[ID(2)|SHOWHOST(true)]}，不要乱跑啦！"
                }
            ]
        },
        {
            "id": "7517803",
            "objective": "",
            "dialogues": [
                {
                    "id": "751780701",
                    "speaker": "马范",
                    "text": "何等「冰冷」！这是何等的「冰冷」啊！"
                },
                {
                    "id": "751780702",
                    "speaker": "派蒙",
                    "text": "欸、欸？！冷？哪里冷了？你不是在温泉里吗？"
                },
                {
                    "id": "751780703",
                    "speaker": "马范",
                    "text": "不够！还不够！如此冰冷，如何堪称「最强」！要成为「沃陆之邦」，不对「纳塔最强」，这「烈度」还远远不够！"
                },
                {
                    "id": "751780704",
                    "speaker": "派蒙",
                    "text": "欸？为什么又坐下了？为什么啊？",
                    "choices": [
                        {
                            "id": "751780705",
                            "text": "看来「烈度」还是不够！",
                            "response": [
                                {
                                    "id": "751780706",
                                    "speaker": "派蒙",
                                    "text": "「烈度」到底是什么啊？怎么你说的话我也听不懂了啊！"
                                },
                                {
                                    "id": "751780709",
                                    "speaker": "尤鲁赫",
                                    "text": "#太棒了，想必两位就是著名的冒险家{NICKNAME}和派蒙了，这下有救了。"
                                },
                                {
                                    "id": "751780710",
                                    "speaker": "派蒙",
                                    "text": "什、什么？发生了什么？"
                                },
                                {
                                    "id": "751780711",
                                    "speaker": "尤鲁赫",
                                    "text": "实不相瞒两位，按照大师本人的话来说，他正在向着「最强」之路前进，沉浸在温泉修行之中。"
                                },
                                {
                                    "id": "751780712",
                                    "speaker": "派蒙",
                                    "text": "修、修行？在温泉里吗？"
                                },
                                {
                                    "id": "751780713",
                                    "speaker": "尤鲁赫",
                                    "text": "对、对啊…虽、虽然我也不是很敢相信。但这方法，是大师从一本名为《烈泉道》的武道书上看来的。"
                                },
                                {
                                    "id": "751780714",
                                    "speaker": "尤鲁赫",
                                    "text": "书上说，如果按照烈泉之道修炼，有朝一日可以只凭自己的「烈度」，让<color=#00E1FFFF>冷水沸腾</color>！"
                                },
                                {
                                    "id": "751780715",
                                    "speaker": "尤鲁赫",
                                    "text": "不仅如此，这书上还记录了好多强者，有的人可以一夜徒手打穿山体，还有的人可以空手将石头捏成宝石！"
                                },
                                {
                                    "id": "751780716",
                                    "speaker": "派蒙",
                                    "text": "#没想到世界上还有这么神奇的武道！要是{NICKNAME}也能学会的话…",
                                    "choices": [
                                        {
                                            "id": "751780717",
                                            "text": "哇，是小说才会有的设定。",
                                            "response": [
                                                {
                                                    "id": "751780719",
                                                    "speaker": "尤鲁赫",
                                                    "text": "也许你们会觉得这书荒唐，但这毕竟是大师从「烟谜主」的书堆里淘回的珍本，而且最重要的是，大师本人对它深信不疑。"
                                                },
                                                {
                                                    "id": "751780720",
                                                    "speaker": "尤鲁赫",
                                                    "text": "为了实践烈泉道，大师特意挑了这个特殊的温泉，不，是「冷泉」。要将极致的「冷泉」靠纯粹的「烈度」，化作极致的「温泉」！"
                                                },
                                                {
                                                    "id": "751780721",
                                                    "speaker": "派蒙",
                                                    "text": "真、真的欸，温泉里的水真的一点都不热！不过…一直泡在这样的水里，就算再怎么厉害的人也会生病的吧…"
                                                },
                                                {
                                                    "id": "751780722",
                                                    "speaker": "尤鲁赫",
                                                    "text": "唉，就算不会生病也不行啊！「勇士挑战」那边已经停了好几天了，都等着大师他回去呢。"
                                                },
                                                {
                                                    "id": "751780723",
                                                    "speaker": "尤鲁赫",
                                                    "text": "但大师说，半途而废是没有「烈度」的行为。因此，除非泉水沸腾，不然他绝不离开。"
                                                },
                                                {
                                                    "id": "751780724",
                                                    "speaker": "尤鲁赫",
                                                    "text": "旁边的管理员也没找到温泉变冷的原因。唉，这个时候要是有熟练的冒险家在就好了…我连报酬都准备好了，你看有这么多呢。",
                                                    "choices": [
                                                        {
                                                            "id": "751780725",
                                                            "text": "这事你应该找「流泉之众」…",
                                                            "response": [
                                                                {
                                                                    "id": "751780727",
                                                                    "speaker": "派蒙",
                                                                    "text": "（不要着急拒绝啦，我们先看看他的报酬有多少嘛。）"
                                                                },
                                                                {
                                                                    "id": "751780728",
                                                                    "speaker": "派蒙",
                                                                    "text": "咳咳，你放心我们肯定会让温泉变热的。再说啦，我们也不能看着他因为冷掉的温泉生病吧，毕竟好冒险家总是助人为乐的嘛。"
                                                                },
                                                                {
                                                                    "id": "751780729",
                                                                    "speaker": "尤鲁赫",
                                                                    "text": "太好了，那就拜托你们了。"
                                                                },
                                                                {
                                                                    "id": "751780730",
                                                                    "speaker": "派蒙",
                                                                    "text": "你就在这里等我们的好消息吧！"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "751780726",
                                                            "text": "你是打算用报酬来收买我么？"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "751780718",
                                            "text": "你不会真信了吧…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "751780707",
                            "text": "因为站起来会更冷吧…",
                            "response": [
                                {
                                    "id": "751780708",
                                    "speaker": "派蒙",
                                    "text": "原来是这样，怪不得他全身正在发抖呢！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7517804",
            "objective": "",
            "dialogues": [
                {
                    "id": "751780401",
                    "speaker": "尤鲁赫",
                    "text": "该不会，《烈泉道》里说的都是真的吧…"
                }
            ]
        },
        {
            "id": "7517814",
            "objective": "",
            "dialogues": [
                {
                    "id": "751781401",
                    "speaker": "派蒙",
                    "text": "咦，小鳍游龙？怎么会在这里？"
                },
                {
                    "id": "751781402",
                    "speaker": "？？？",
                    "text": "——奇欧奇欧！你果然在这里…如、如果你们再不出来的话，我、我…"
                },
                {
                    "id": "751781403",
                    "speaker": "？？？",
                    "text": "万一受伤了怎么办？下次可不许乱跑了，呜呜…"
                },
                {
                    "id": "751781404",
                    "speaker": "派蒙",
                    "text": "别、别哭了，你看，小龙不是好好的吗？很有精神的！"
                },
                {
                    "id": "751781405",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "呀！呀！"
                },
                {
                    "id": "751781406",
                    "speaker": "？？？",
                    "text": "嗯，没、没问题的。我、我叫莉娜夏，是「流泉之众」那边的…平时都是我负责照看小鳍游龙的…"
                },
                {
                    "id": "751781407",
                    "speaker": "派蒙",
                    "text": "负责照看小鳍游龙？真了不起！"
                },
                {
                    "id": "751781408",
                    "speaker": "？？？",
                    "text": "没、没有啦…我要是能像派蒙姐姐一样的话，它们肯定就不会跑丢了。"
                },
                {
                    "id": "751781409",
                    "speaker": "？？？",
                    "text": "刚刚我就在想，是不是大家都跑去喷口玩了，所以才找不到。现在来看，果然是这样的…"
                },
                {
                    "id": "751781410",
                    "speaker": "派蒙",
                    "text": "原来温泉变冷，是因为小鳍游龙们把燃素喷口堵住了啊。怪不得管理员都没发现呢！"
                },
                {
                    "id": "751781411",
                    "speaker": "？？？",
                    "text": "派、派蒙姐姐！其实…我还有两只龙伙伴没找到，估计它们也是躲在燃素喷口里玩了…"
                },
                {
                    "id": "751781412",
                    "speaker": "派蒙",
                    "text": "没问题，你放心吧！我们在调节水温的时候，会顺便把小鳍游龙们帮你找回来的！"
                },
                {
                    "id": "751781413",
                    "speaker": "？？？",
                    "text": "嗯，有派蒙姐姐在，我就放心啦！"
                },
                {
                    "id": "751781414",
                    "speaker": "派蒙",
                    "text": "啊哈哈，那当然，我可是传说中的冒险家，这等小事肯定是手到擒来！"
                },
                {
                    "id": "751781415",
                    "speaker": "？？？",
                    "text": "哇！派蒙姐姐好厉害！我也要成为跟派蒙姐姐一样的人！",
                    "choices": [
                        {
                            "id": "751781416",
                            "text": "确实，派蒙姐姐好厉害呢。",
                            "response": [
                                {
                                    "id": "751781418",
                                    "speaker": "派蒙",
                                    "text": "（在外人面前，你给我一点面子嘛。要不，今天晚上我把最好吃的菜让给你，好不好？）"
                                },
                                {
                                    "id": "751781419",
                                    "speaker": "派蒙",
                                    "text": "咳咳，总而言之，我们出发吧！"
                                }
                            ]
                        },
                        {
                            "id": "751781417",
                            "text": "那下次战斗就拜托你了…"
                        }
                    ]
                }
            ]
        },
        {
