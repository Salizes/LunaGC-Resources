        {
            "id": "7517806",
            "objective": "与莉娜夏对话",
            "dialogues": [
                {
                    "id": "751781501",
                    "speaker": "？？？",
                    "text": "太好了！你们都回来啦！我差一点以为今天要闯大祸了！"
                },
                {
                    "id": "751781502",
                    "speaker": "马范",
                    "text": "嗯？这是…好热！「烈度」正在聚集！噫！我成了！我真的成了！"
                },
                {
                    "id": "751781503",
                    "speaker": "马范",
                    "text": "哈哈！何等的「烈度」！这是何等的「烈度」啊！"
                },
                {
                    "id": "751781504",
                    "speaker": "马范",
                    "text": "——呃啊！"
                }
            ]
        },
        {
