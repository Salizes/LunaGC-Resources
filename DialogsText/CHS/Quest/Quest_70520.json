{
    "quest": {
        "id": "70520",
        "title": "西风哗哗义卖联盟！",
        "description": "西风呼呼义卖铺似乎受到了不少关注，一些好心的店主也想加入义卖活动…",
        "rewards": [
            {
                "itemId": 104002,
