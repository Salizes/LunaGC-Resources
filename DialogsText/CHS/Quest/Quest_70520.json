            {
                "itemId": 104001,
                "count": 4
            }
        ],
        "rewards_formatted": "冒险家的经验 x2, 流浪者的经验 x4",
        "chapter": {
            "icon": "",
            "id": "",
            "num": "",
            "title": ""
        },
        "total_dialogue_lines": 68,
        "total_speaker_counts": {
            "Black Screen": 3,
            "Player": 12,
            "伯恩哈德": 4,
            "保琳": 2,
            "派蒙": 19,
            "阿贝多": 26,
            "马茨": 2
        }
    },
    "talks": [
        {
            "id": "7052001",
            "objective": "返回店铺，了解义卖的进展",
            "dialogues": [
                {
                    "id": "705200101",
                    "speaker": "伯恩哈德",
                    "text": "荣誉骑士，派蒙！有个好消息要告诉你们！我们有新的帮手了！"
                },
                {
                    "id": "705200102",
                    "speaker": "伯恩哈德",
                    "text": "这两位店主听说了义卖的事后，想要加入我们，将收益捐献出来。"
                },
                {
                    "id": "705200103",
                    "speaker": "派蒙",
                    "text": "欸？捐献？真的没关系吗？"
                },
                {
                    "id": "705200104",
                    "speaker": "马茨",
                    "text": "没事没事！"
                },
                {
                    "id": "705200105",
                    "speaker": "马茨",
                    "text": "多一份资金，就多一位受益人，我和保琳小姐都觉得比我们埋头赚钱更重要。"
                },
                {
                    "id": "705200106",
                    "speaker": "保琳",
                    "text": "这次佳酿节的客人比往年更多，我们提前完成了经营计划，早就心满意足了。"
                },
                {
                    "id": "705200107",
                    "speaker": "保琳",
                    "text": "不能只让你们为老人和孩子们忙前忙后，我们也想尽可能帮上忙，请不要有心理负担。"
                },
                {
                    "id": "705200108",
                    "speaker": "Player",
                    "text": "由衷感谢你们。"
                },
                {
                    "id": "705200109",
                    "speaker": "派蒙",
                    "text": "嗯，感觉心里暖暖的…"
                },
                {
                    "id": "705200110",
                    "speaker": "派蒙",
                    "text": "不过这下就得换个名字了吧！那就改叫…「西风哗哗义卖联盟」了。",
                    "choices": [
                        {
                            "id": "705200111",
                            "text": "这风还变大了。",
                            "response": [
                                {
                                    "id": "705200113",
                                    "speaker": "派蒙",
                                    "text": "让我们一起拿出全力，办好这次义卖活动吧！"
                                },
                                {
                                    "id": "705200114",
                                    "speaker": "Black Screen",
                                    "text": "两位店主加入了队伍，义卖活动的规模扩大了…"
                                },
                                {
                                    "id": "705200115",
                                    "speaker": "派蒙",
                                    "text": "来这边瞧瞧吧，「西风哗哗义卖联盟」的特色小吃、日用百货和鲜花哦…"
                                },
                                {
                                    "id": "705200116",
                                    "speaker": "派蒙",
                                    "text": "欸？快看快看，阿贝多来了！"
                                },
                                {
                                    "id": "705200117",
                                    "speaker": "阿贝多",
                                    "text": "#{NICKNAME}和派蒙，你们好啊。",
                                    "choices": [
                                        {
                                            "id": "705200118",
                                            "text": "欢迎光临。",
                                            "response": [
                                                {
                                                    "id": "705200120",
                                                    "speaker": "派蒙",
                                                    "text": "阿贝多是要采购什么东西吗？"
                                                },
                                                {
                                                    "id": "705200121",
                                                    "speaker": "阿贝多",
                                                    "text": "我没有什么特别需要的。只是听说，骑士团的店铺由你们管理。"
                                                },
                                                {
                                                    "id": "705200122",
                                                    "speaker": "阿贝多",
                                                    "text": "正好我和蒂玛乌斯的研究有了进展，就给你们带了一批成品过来，算是对这次义卖活动的赞助吧。"
                                                },
                                                {
                                                    "id": "705200123",
                                                    "speaker": "派蒙",
                                                    "text": "居然是专程来赞助我们的吗！好感动！"
                                                },
                                                {
                                                    "id": "705200124",
                                                    "speaker": "派蒙",
                                                    "text": "让我看看…瓶子里装着什么好东西？"
                                                },
                                                {
                                                    "id": "705200125",
                                                    "speaker": "阿贝多",
                                                    "text": "是特效醒酒汤剂。能让喝醉的人恢复清醒，有效缓解头疼。"
                                                },
                                                {
                                                    "id": "705200126",
                                                    "speaker": "阿贝多",
                                                    "text": "请将它们免费提供给有需要的人吧。这些赠品应该也会为你们吸引更多的顾客。"
                                                },
                                                {
                                                    "id": "705200127",
                                                    "speaker": "派蒙",
                                                    "text": "这么有用的东西，是费了不少工夫才做出来的吧？"
                                                },
                                                {
                                                    "id": "705200128",
                                                    "speaker": "阿贝多",
                                                    "text": "哦？是我太久没露一手了吗？"
                                                },
                                                {
                                                    "id": "705200129",
                                                    "speaker": "阿贝多",
                                                    "text": "过去的我，可能不会太在意这类研究吧。"
                                                },
                                                {
                                                    "id": "705200130",
                                                    "speaker": "阿贝多",
                                                    "text": "但能以炼金术的产物为人们的生活带来便捷，的确是一件好事。"
                                                },
                                                {
                                                    "id": "705200131",
                                                    "speaker": "派蒙",
                                                    "text": "嗯！虽然我是没有醉酒的经历啦，但我也能想象得出来。"
                                                },
                                                {
                                                    "id": "705200132",
                                                    "speaker": "派蒙",
                                                    "text": "要是刚刚享受完了美酒，就一个脚滑掉进湖里去，或者是被石头绊倒，好心情也会溜走的吧。"
                                                },
                                                {
                                                    "id": "705200133",
                                                    "speaker": "Player",
                                                    "text": "我们也不能白收好处。"
                                                },
                                                {
                                                    "id": "705200134",
                                                    "speaker": "派蒙",
                                                    "text": "嗯，阿贝多就带一些吃的回去吧，还能和小可莉一起分享，算我们请你的！"
                                                },
                                                {
                                                    "id": "705200135",
                                                    "speaker": "阿贝多",
                                                    "text": "好，那我也就不推辞了。"
                                                },
                                                {
                                                    "id": "705200136",
                                                    "speaker": "阿贝多",
                                                    "text": "想不到，你们有那么出色的商业头脑。"
                                                },
                                                {
                                                    "id": "705200137",
                                                    "speaker": "阿贝多",
                                                    "text": "小吃店的定位很精妙，不仅契合节日的气氛，分工上也很适合你们两位。"
                                                },
                                                {
                                                    "id": "705200138",
                                                    "speaker": "阿贝多",
                                                    "text": "如果是由其他骑士团成员负责的话，一般都只会售卖杂货吧。"
                                                },
                                                {
                                                    "id": "705200139",
                                                    "speaker": "派蒙",
                                                    "text": "哇，被阿贝多夸了夸，我简直就像喝了醒酒汤一样神清气爽。"
                                                },
                                                {
                                                    "id": "705200140",
                                                    "speaker": "派蒙",
                                                    "text": "欸，不过这样一说，阿贝多对义卖了解得很清楚呀！"
                                                },
                                                {
                                                    "id": "705200141",
                                                    "speaker": "阿贝多",
                                                    "text": "嗯，以往骑士团向大家征集杂物用于义卖的时候，我提供过十来张风景画。"
                                                },
                                                {
                                                    "id": "705200142",
                                                    "speaker": "派蒙",
                                                    "text": "阿贝多的画，应该很值钱！"
                                                },
                                                {
                                                    "id": "705200143",
                                                    "speaker": "阿贝多",
                                                    "text": "派蒙的想法倒是和那些商人一致。"
                                                },
                                                {
                                                    "id": "705200144",
                                                    "speaker": "阿贝多",
                                                    "text": "确实有人觉得我的画法少见，有投资价值，就花大价钱买下了它们。"
                                                },
                                                {
                                                    "id": "705200145",
                                                    "speaker": "阿贝多",
                                                    "text": "再加上之前一些写生画的拍卖收益不错…艾莉丝女士似乎察觉了什么。"
                                                },
                                                {
                                                    "id": "705200146",
                                                    "speaker": "阿贝多",
                                                    "text": "她用她独特的渠道为我的作品申请了认证…记得是叫「专利」。"
                                                },
                                                {
                                                    "id": "705200147",
                                                    "speaker": "阿贝多",
                                                    "text": "后来，有不少画家模仿我的风景画，它们也成了蒙德城里相当常见的挂饰。",
                                                    "choices": [
                                                        {
                                                            "id": "705200148",
                                                            "text": "有点印象…",
                                                            "response": [
                                                                {
                                                                    "id": "705200150",
                                                                    "speaker": "阿贝多",
                                                                    "text": "根据艾莉丝女士的「专利」规则，画家们每次出售这种风景画，都需要向我支付一定比例的费用。"
                                                                },
                                                                {
                                                                    "id": "705200151",
                                                                    "speaker": "阿贝多",
                                                                    "text": "财富向来不是我的目标，我不关心它的去处，就全权委托给骑士团管理了。"
                                                                },
                                                                {
                                                                    "id": "705200152",
                                                                    "speaker": "阿贝多",
                                                                    "text": "要我来出主意的话…嗯，拿去修缮艾莉丝女士造成的破坏也挺合适的。"
                                                                },
                                                                {
                                                                    "id": "705200153",
                                                                    "speaker": "阿贝多",
                                                                    "text": "但听说，他们最终还是把它用在了慈善事业上。",
                                                                    "choices": [
                                                                        {
                                                                            "id": "705200154",
                                                                            "text": "明明没有参加过义卖…",
                                                                            "response": [
                                                                                {
                                                                                    "id": "705200156",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "该说不愧是你吗，阿贝多…"
                                                                                },
                                                                                {
                                                                                    "id": "705200157",
                                                                                    "speaker": "阿贝多",
                                                                                    "text": "虽然我的本意并非如此，但既然有意外的收获，我也慢慢学会接受它了。",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "705200158",
                                                                                            "text": "为你高兴。",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "705200159",
                                                                                                    "speaker": "阿贝多",
                                                                                                    "text": "#谢谢你，{NICKNAME}。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "705200162",
                                                                                                    "speaker": "阿贝多",
                                                                                                    "text": "那今天我先回工坊了，预祝你们经营顺利。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "705200163",
                                                                                                    "speaker": "派蒙",
                                                                                                    "text": "也谢谢你的赞助，阿贝多，研究也要顺利呀！"
                                                                                                },
                                                                                                {
                                                                                                    "id": "705200164",
                                                                                                    "speaker": "Black Screen",
                                                                                                    "text": "花时间亲手制作了小吃，给阿贝多带上了…"
                                                                                                },
                                                                                                {
                                                                                                    "id": "705200165",
                                                                                                    "speaker": "派蒙",
                                                                                                    "text": "有空再来玩哦！"
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "705200160",
                                                                                            "text": "想学画画。",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "705200161",
                                                                                                    "speaker": "阿贝多",
                                                                                                    "text": "当然，我乐于分享经验。不过…唔，还是要多练习。"
                                                                                                }
                                                                                            ]
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "705200155",
                                                                            "text": "却达成了相同的目标…"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "705200149",
                                                            "text": "原来是你的手笔…"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "705200119",
                                            "text": "好久不见。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "705200112",
                            "text": "哗哗——"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7052002",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "705200201",
                    "speaker": "伯恩哈德",
                    "text": "荣誉骑士，派蒙，有两位店主也想加入活动，义卖的规模扩大了。"
                },
                {
                    "id": "705200202",
                    "speaker": "Black Screen",
                    "text": "结识了两位加盟的店主…"
                },
                {
                    "id": "705200203",
                    "speaker": "伯恩哈德",
                    "text": "好的，接下来就要麻烦你们指导三家店铺，进行义卖活动了！"
                }
            ]
        }
    ]
}