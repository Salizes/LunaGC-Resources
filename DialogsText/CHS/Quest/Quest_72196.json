    "talks": [
        {
            "id": "7219614",
            "objective": "用来创建npc任务$HIDDEN",
            "dialogues": [
                {
                    "id": "721961401",
                    "speaker": "稻叶久藏",
                    "text": "怎么又是你？"
                },
                {
                    "id": "721961402",
                    "speaker": "稻叶久藏",
                    "text": "我不是跟你说过——唉，算了。随你高兴吧。"
                },
                {
                    "id": "721961403",
                    "speaker": "稻叶久藏",
                    "text": "别弄乱了我的东西，船上补给还够分你一点。满意了就快点离开。"
                },
                {
                    "id": "721961404",
                    "speaker": "Player",
                    "text": "需要帮忙吗？"
                },
                {
                    "id": "721961405",
                    "speaker": "稻叶久藏",
                    "text": "不需要。你没看到我过得很好吗？"
                },
                {
                    "id": "721961406",
                    "speaker": "Player",
                    "text": "但你的伤口…"
                },
                {
                    "id": "721961407",
                    "speaker": "稻叶久藏",
                    "text": "那是我的伤口，不是你的。"
                },
                {
                    "id": "721961408",
                    "speaker": "派蒙",
                    "text": "喂，我们是出于好心才问的！"
                },
                {
                    "id": "721961409",
                    "speaker": "稻叶久藏",
                    "text": "那我也出于好心回答你们：别烦我了。"
                },
                {
                    "id": "721961410",
                    "speaker": "Player",
                    "text": "我可以帮你。"
                },
                {
                    "id": "721961411",
                    "speaker": "稻叶久藏",
                    "text": "怎么帮我，把我交给幕府军吗？"
                },
                {
                    "id": "721961412",
                    "speaker": "稻叶久藏",
                    "text": "哈哈，我劝你别犯傻了…我会被当成逃兵的。九条大人对逃兵从不留情面。"
                },
                {
                    "id": "721961413",
                    "speaker": "稻叶久藏",
                    "text": "你要是真想帮我，就让我一个人好好静静吧。"
                },
                {
                    "id": "721961414",
                    "speaker": "派蒙",
                    "text": "哇，这个油盐不进的家伙！"
                }
            ]
        },
        {
            "id": "7219606",
            "objective": "清除怪物营地1$HIDDEN",
            "dialogues": [
                {
                    "id": "721960601",
                    "speaker": "稻叶久藏",
                    "text": "外国人，最近如何？"
                },
                {
                    "id": "721960602",
                    "speaker": "稻叶久藏",
                    "text": "抱歉，这里不是待客的好地方。"
                },
                {
                    "id": "721960603",
                    "speaker": "稻叶久藏",
                    "text": "不过…我很高兴你能来。"
                },
                {
                    "id": "721960604",
                    "speaker": "Player",
                    "text": "你看起来好多了。"
                },
                {
                    "id": "721960605",
                    "speaker": "稻叶久藏",
                    "text": "嗯，又欠你一个人情。"
                },
                {
                    "id": "721960606",
                    "speaker": "稻叶久藏",
                    "text": "哈哈，真可惜我又撑下来了。"
                },
                {
                    "id": "721960607",
                    "speaker": "派蒙",
                    "text": "这不是好事吗。有什么可惜的啦！"
                }
            ]
        },
        {
            "id": "7219612",
            "objective": "清除怪物营地2$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7219607",
            "objective": "清除怪物营地3$HIDDEN",
            "dialogues": [
                {
                    "id": "721960701",
                    "speaker": "稻叶久藏",
                    "text": "…附近的鼠辈又开始蠢蠢欲动了。"
                },
                {
                    "id": "721960702",
                    "speaker": "稻叶久藏",
                    "text": "喂，外国人。在附近游荡的话，请小心海贼。"
                },
                {
                    "id": "721960703",
                    "speaker": "Player",
                    "text": "谢谢。"
                },
                {
                    "id": "721960704",
                    "speaker": "稻叶久藏",
                    "text": "应该的。"
                },
                {
                    "id": "721960705",
                    "speaker": "Player",
                    "text": "他们不是我的对手。"
                },
                {
                    "id": "721960706",
                    "speaker": "稻叶久藏",
                    "text": "哈哈，净说大话…"
                },
                {
                    "id": "721960707",
                    "speaker": "稻叶久藏",
                    "text": "等你把他们都驱逐干净，再跟我说这种话吧！"
                },
                {
                    "id": "721960708",
                    "speaker": "Player",
                    "text": "一言为定。"
                },
                {
                    "id": "721960709",
                    "speaker": "稻叶久藏",
                    "text": "嗯，一言为定。"
                }
            ]
        },
        {
            "id": "7219608",
            "objective": "清除怪物营地4$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7219613",
            "objective": "向稻叶久藏回报情况。",
            "dialogues": [
                {
                    "id": "721961301",
                    "speaker": "稻叶久藏",
                    "text": "是外国人？有趣…"
                },
                {
                    "id": "721961302",
                    "speaker": "稻叶久藏",
                    "text": "如果是游客的话，那你可来错地方了。"
                },
                {
                    "id": "721961303",
                    "speaker": "Player",
                    "text": "你在做什么？"
                },
                {
                    "id": "721961304",
                    "speaker": "稻叶久藏",
                    "text": "怎么，你是幕府的人？"
                },
                {
                    "id": "721961305",
                    "speaker": "Player",
                    "text": "不是。"
                },
                {
                    "id": "721961306",
                    "speaker": "稻叶久藏",
                    "text": "那就管好自己的事。"
                },
                {
                    "id": "721961307",
                    "speaker": "派蒙",
                    "text": "这个家伙，怎么这么讨人厌！"
                },
                {
                    "id": "721961308",
                    "speaker": "Player",
                    "text": "我是幕府派来的。"
                },
                {
                    "id": "721961309",
                    "speaker": "稻叶久藏",
                    "text": "嗯，你们这些外国人…"
                },
                {
                    "id": "721961310",
                    "speaker": "稻叶久藏",
                    "text": "在奉行大人面前摇尾乞怜，讨得点残渣剩饭，又在稻妻武士面前趾高气扬…"
                },
                {
                    "id": "721961311",
                    "speaker": "稻叶久藏",
                    "text": "打探来打探去、到处搅混水不说…现在还专程跑来这条破船上，也不知有何贵干。"
                },
                {
                    "id": "721961312",
                    "speaker": "稻叶久藏",
                    "text": "可惜呀，我不过一介伤兵，没什么能招待你的。"
                },
                {
                    "id": "721961313",
                    "speaker": "稻叶久藏",
                    "text": "所以还要烦请大人自己用腿走出去。"
                },
                {
                    "id": "721961314",
                    "speaker": "派蒙",
                    "text": "这家伙完全不会好好说话吗！"
                },
                {
                    "id": "721961315",
                    "speaker": "稻叶久藏",
                    "text": "好了，你们太吵了。"
                },
                {
                    "id": "721961316",
                    "speaker": "稻叶久藏",
                    "text": "临走前给你们一句忠告吧：别在八酝岛待太久，这座岛已经被诅咒了。"
                },
                {
                    "id": "721961317",
                    "speaker": "Player",
                    "text": "诅咒…？"
                },
                {
                    "id": "721961318",
                    "speaker": "稻叶久藏",
                    "text": "听不懂吗？这座岛被诅咒了。"
                },
                {
                    "id": "721961319",
                    "speaker": "稻叶久藏",
                    "text": "停滞的战争、大人们的欲望、小人物的绝望、无辜受难者的憎恨，老人临终时弥漫满屋的药剂气味…"
                },
                {
                    "id": "721961320",
                    "speaker": "稻叶久藏",
                    "text": "总而言之，就是诅咒。"
                },
                {
                    "id": "721961321",
                    "speaker": "稻叶久藏",
                    "text": "趁你还没被压垮，赶紧离开吧。"
                },
                {
                    "id": "721961322",
                    "speaker": "派蒙",
                    "text": "唔…完全听不懂，真是个怪人。"
                }
            ]
        },
        {
            "id": "7219611",
            "objective": "见证稻叶久藏的宿命。",
            "dialogues": []
        }
    ]
}