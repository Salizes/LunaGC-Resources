{
    "quest": {
        "id": "72664",
        "title": "逐月节的诸多事宜",
        "description": "璃月冒险家协会的冒险家琳阳似乎有什么话想说…",
        "rewards": [],
        "rewards_formatted": "",
        "chapter": {
            "icon": "",
            "id": "",
            "num": "",
            "title": ""
        },
        "total_dialogue_lines": 27,
        "total_speaker_counts": {
            "Player": 9,
            "琳阳": 18
        }
    },
    "talks": [
        {
            "id": "7266401",
            "objective": "与琳阳对话",
            "dialogues": [
                {
                    "id": "726640101",
                    "speaker": "琳阳",
                    "text": "唔…还得再去布置一批宝箱才行…"
                },
                {
                    "id": "726640102",
                    "speaker": "Player",
                    "text": "什么宝箱？"
                },
                {
                    "id": "726640103",
                    "speaker": "琳阳",
                    "text": "欸？！你是…旅行者吗？你也是来参加「逐月节」的？"
                },
                {
                    "id": "726640104",
                    "speaker": "Player",
                    "text": "算是吧。"
                },
                {
                    "id": "726640105",
                    "speaker": "琳阳",
                    "text": "那你来得刚好。为了庆祝逐月节，我们冒险家协会正在举办活动呢。"
                },
                {
                    "id": "726640106",
                    "speaker": "琳阳",
                    "text": "怎么样，你想要了解一下吗？",
                    "choices": [
                        {
                            "id": "726640107",
                            "text": "具体是什么活动？",
                            "response": [
                                {
                                    "id": "726640110",
                                    "speaker": "琳阳",
                                    "text": "逐月节期间，我们冒险家协会在各地布置了一种叫做「逐月符」的东西。"
                                },
                                {
                                    "id": "726640111",
                                    "speaker": "琳阳",
                                    "text": "找到这些逐月符的人，可以将它们带回协会，兑换各种奖励。"
                                },
                                {
                                    "id": "726640112",
                                    "speaker": "琳阳",
                                    "text": "另外，协会还派遣了一批冒险家，在野外布置了一大批特别宝箱。"
                                },
                                {
                                    "id": "726640113",
                                    "speaker": "琳阳",
                                    "text": "这些特别宝箱里面，都装着协会专门准备好的各种宝物哦。"
                                },
                                {
                                    "id": "726640114",
                                    "speaker": "琳阳",
                                    "text": "除了这两项活动之外，协会还为那些想要挑战自我的精英冒险家们，设置了一连串的高难度挑战！"
                                },
                                {
                                    "id": "726640115",
                                    "speaker": "琳阳",
                                    "text": "具体来说…就是一连串的魔物营地啦…",
                                    "choices": [
                                        {
                                            "id": "726640116",
                                            "text": "这和逐月节有关系吗？",
                                            "response": [
                                                {
                                                    "id": "726640118",
                                                    "speaker": "琳阳",
                                                    "text": "啊…哈哈哈，这个…这…你别这么说嘛！"
                                                },
                                                {
                                                    "id": "726640119",
                                                    "speaker": "琳阳",
                                                    "text": "只要讨伐了那些魔物，协会也会给予相应报酬的！"
                                                },
                                                {
                                                    "id": "726640120",
                                                    "speaker": "Player",
                                                    "text": "这和平时的委托有什么区别？"
                                                },
                                                {
                                                    "id": "726640121",
                                                    "speaker": "琳阳",
                                                    "text": "拜托，拜托你啦！逐月节期间，大部分冒险家都去过节了，好多委托都没人接。"
                                                },
                                                {
                                                    "id": "726640122",
                                                    "speaker": "琳阳",
                                                    "text": "怎么样？凭你的身手，对付那些魔物肯定不在话下啦！",
                                                    "choices": [
                                                        {
                                                            "id": "726640123",
                                                            "text": "好吧…",
                                                            "response": [
                                                                {
                                                                    "id": "726640125",
                                                                    "speaker": "琳阳",
                                                                    "text": "报、报酬方面一定不会让你失望的，放心吧旅行者！"
                                                                },
                                                                {
                                                                    "id": "726640126",
                                                                    "speaker": "琳阳",
                                                                    "text": "逐月节期间，我会一直待在这里，有什么问题，你直接过来问我就好了。"
                                                                },
                                                                {
                                                                    "id": "726640127",
                                                                    "speaker": "琳阳",
                                                                    "text": "那就拜托你了，旅行者。那个…好好享受逐月节吧！"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "726640124",
                                                            "text": "准备好报酬。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "726640117",
                                            "text": "这和逐月节一点关系都没有！"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "726640108",
                            "text": "不会又是各种日常杂务吧…",
                            "response": [
                                {
                                    "id": "726640109",
                                    "speaker": "琳阳",
                                    "text": "不会啦！这次的活动可都是很有冒险感的！"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}