    "talks": [
        {
            "id": "7335501",
            "objective": "前往拜达港",
            "dialogues": [
                {
                    "id": "733550101",
                    "speaker": "派蒙",
                    "text": "咦，那边有只蕈兽飘过去了欸，没问题吗？"
                },
                {
                    "id": "733550102",
                    "speaker": "派蒙",
                    "text": "一般来说，蕈兽在城区活动，还是有点危险的吧！除非是特别听话，受过训练的特例…"
                },
                {
                    "id": "733550103",
                    "speaker": "派蒙",
                    "text": "不对呀，怎么好像有点熟悉，以前我们是不是经历过类似的情景。",
                    "choices": [
                        {
                            "id": "733550104",
                            "text": "等等，是「咚咚小圆帽」吗？",
                            "response": [
                                {
                                    "id": "733550105",
                                    "speaker": "派蒙",
                                    "text": "对！「咚咚小圆帽」！我们在须弥结识的蕈兽伙伴！"
                                },
                                {
                                    "id": "733550106",
                                    "speaker": "派蒙",
                                    "text": "呜啊啊啊啊啊，上次见面都好久好久了！我们快过去看看吧！"
                                }
                            ]
                        },
                        {
                            "id": "733550107",
                            "text": "是什么特例来着？",
                            "response": [
                                {
                                    "id": "733550108",
                                    "speaker": "派蒙",
                                    "text": "好像是…「咚咚小圆帽」？我们在须弥结识的蕈兽伙伴！"
                                },
                                {
                                    "id": "733550109",
                                    "speaker": "派蒙",
                                    "text": "呜啊啊啊啊啊，上次见面都好久好久了！我们快过去看看吧！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7335502",
            "objective": "与海妮耶对话",
            "dialogues": [
                {
                    "id": "733550201",
                    "speaker": "海妮耶",
                    "text": "嗯？看来不需要在冒险家协会留言，奇妙的缘分就会指引着我们重逢…"
                },
                {
                    "id": "733550202",
                    "speaker": "海妮耶",
                    "text": "终于又见面了，「黄金流星」和「白银伴星」。"
                },
                {
                    "id": "733550203",
                    "speaker": "海妮耶",
                    "text": "你们容光焕发的模样，让我有种时间停滞的美好感觉。",
                    "choices": [
                        {
                            "id": "733550204",
                            "text": "久违了，海妮耶！",
                            "response": [
                                {
                                    "id": "733550205",
                                    "speaker": "派蒙",
                                    "text": "真的是你们啊，海妮耶和「咚咚小圆帽」！"
                                },
                                {
                                    "id": "733550206",
                                    "speaker": "派蒙",
                                    "text": "难怪看过留言，我就有种奇妙的熟悉感…说明我和「咚咚小圆帽」的默契还在！"
                                },
                                {
                                    "id": "733550207",
                                    "speaker": "咚咚小圆帽",
                                    "text": "♪~"
                                },
                                {
                                    "id": "733550212",
                                    "speaker": "海妮耶",
                                    "text": "我设想过许多重逢的情景，比如举办丰盛的宴会，或是富有创意的欢迎仪式，给你个巨大的惊喜。"
                                },
                                {
                                    "id": "733550213",
                                    "speaker": "海妮耶",
                                    "text": "但感觉都有些见外，考虑到你们一直很忙，说不定占用太长时间，反而会让你们觉得麻烦。"
                                },
                                {
                                    "id": "733550214",
                                    "speaker": "海妮耶",
                                    "text": "而且，现在的蕈兽伙伴们也喜欢宁静的环境，所以，就让我们以松弛自然的方式重逢吧。"
                                },
                                {
                                    "id": "733550215",
                                    "speaker": "左右加",
                                    "text": "没错没错，海妮耶读的散文派上用场啦，平静的心态对生活有益！"
                                },
                                {
                                    "id": "733550216",
                                    "speaker": "左右加",
                                    "text": "还是像这样，轻轻松松聊天最开心。"
                                },
                                {
                                    "id": "733550217",
                                    "speaker": "欢腾之火",
                                    "text": "♫~"
                                },
                                {
                                    "id": "733550218",
                                    "speaker": "派蒙",
                                    "text": "左右加小姐也在，还有「欢腾之火」和…这位是？"
                                },
                                {
                                    "id": "733550219",
                                    "speaker": "左右加",
                                    "text": "是我自己的蕈兽伙伴「信风舞姬」哦，当时在三十二强赛上，被你们和「咚咚小圆帽」一下就打败了！"
                                },
                                {
                                    "id": "733550220",
                                    "speaker": "派蒙",
                                    "text": "哎呀，还是你记得清楚！",
                                    "choices": [
                                        {
                                            "id": "733550221",
                                            "text": "熟悉的感觉逐渐回来了…",
                                            "response": [
                                                {
                                                    "id": "733550223",
                                                    "speaker": "左右加",
                                                    "text": "总之，两位大老板，就像你看到的这样，我们再也不用约定什么下次见面的时间和地点啦——"
                                                },
                                                {
                                                    "id": "733550224",
                                                    "speaker": "左右加",
                                                    "text": "海妮耶和我已经买下了这片商区，将它改造成一直开设的「小小灵蕈乐园」！"
                                                },
                                                {
                                                    "id": "733550225",
                                                    "speaker": "派蒙",
                                                    "text": "等等，你的意思是，现在这里的设施，不是为了新的桌上游戏租用的，而是…"
                                                },
                                                {
                                                    "id": "733550226",
                                                    "speaker": "海妮耶",
                                                    "text": "没错，以后我们就会一直生活在拜达港，向人们推广蕈兽的桌上游戏，以及和动物们交流的理论。"
                                                },
                                                {
                                                    "id": "733550227",
                                                    "speaker": "海妮耶",
                                                    "text": "只要你们有空，随时可以来这里找蕈兽伙伴们玩。"
                                                },
                                                {
                                                    "id": "733550228",
                                                    "speaker": "咚咚小圆帽",
                                                    "text": "♪~",
                                                    "choices": [
                                                        {
                                                            "id": "733550229",
                                                            "text": "好耶！蕈兽伙伴！",
                                                            "response": [
                                                                {
                                                                    "id": "733550231",
                                                                    "speaker": "派蒙",
                                                                    "text": "这这这，这是我今天听过最好的消息之一！"
                                                                },
                                                                {
                                                                    "id": "733550232",
                                                                    "speaker": "派蒙",
                                                                    "text": "第一次蕈兽大赛后，我就想过好多好多…和「咚咚小圆帽」一起玩的点子，这下可以慢慢做到啦！"
                                                                },
                                                                {
                                                                    "id": "733550233",
                                                                    "speaker": "派蒙",
                                                                    "text": "可惜今天，没有准备给蕈兽伙伴们吃的甜点…要是能抱着蕈兽伙伴，一起享用桌上满满的美食，得有多好啊！"
                                                                },
                                                                {
                                                                    "id": "733550234",
                                                                    "speaker": "海妮耶",
                                                                    "text": "这方面不用担心，我在完善的《蕈兽族群综论》中，就有从底层研究蕈兽爱吃的食物。"
                                                                },
                                                                {
                                                                    "id": "733550235",
                                                                    "speaker": "海妮耶",
                                                                    "text": "目标是找出蕈兽和人类共通的食材，让伙伴们不用一年到头都吃各种口味的「妙妙琼脂」。"
                                                                },
                                                                {
                                                                    "id": "733550236",
                                                                    "speaker": "海妮耶",
                                                                    "text": "迟早有一天，我会找出兼顾人类和蕈兽味觉的食材，设计出双方共通的美味料理！"
                                                                },
                                                                {
                                                                    "id": "733550237",
                                                                    "speaker": "左右加",
                                                                    "text": "等到实践下厨，就由我来负责！以防海妮耶烧坏我们的第十一口锅。"
                                                                },
                                                                {
                                                                    "id": "733550238",
                                                                    "speaker": "派蒙",
                                                                    "text": "这么听来，以后和蕈兽伙伴们坐成一圈聚餐的那天，不远了？",
                                                                    "choices": [
                                                                        {
                                                                            "id": "733550239",
                                                                            "text": "就等海妮耶的好消息！",
                                                                            "response": [
                                                                                {
                                                                                    "id": "733550241",
                                                                                    "speaker": "海妮耶",
                                                                                    "text": "那还请常回「小小灵蕈乐园」来看看，我们和各位蕈兽伙伴随时等着你们。"
                                                                                },
                                                                                {
                                                                                    "id": "733550242",
                                                                                    "speaker": "左右加",
                                                                                    "text": "说不定，惊喜会比你们预想的来得更早呢！"
                                                                                },
                                                                                {
                                                                                    "id": "733550243",
                                                                                    "speaker": "咚咚小圆帽",
                                                                                    "text": "♪！"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "733550240",
                                                                            "text": "就等左右加的大餐了！"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "733550230",
                                                            "text": "以后可以经常见面啦！"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "733550222",
                                            "text": "亲切的氛围让我放松下来了…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "733550208",
                            "text": "虽然不太记得了，但你们好。",
                            "response": [
                                {
                                    "id": "733550209",
                                    "speaker": "派蒙",
                                    "text": "确实是海妮耶和「咚咚小圆帽」！我们好久之前在「月莲杯驯兽师大赛」认识的朋友！"
                                },
                                {
                                    "id": "733550210",
                                    "speaker": "派蒙",
                                    "text": "印象里，之后我们还在奥摩斯港附近，还有枫丹廷见过面！不知不觉，已经过去这么长时间了…"
                                },
                                {
                                    "id": "733550211",
                                    "speaker": "咚咚小圆帽",
                                    "text": "♪~"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}