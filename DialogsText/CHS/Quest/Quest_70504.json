    "talks": [
        {
            "id": "7050401",
            "objective": "与卢卡对话，进入酒馆",
            "dialogues": [
                {
                    "id": "705040101",
                    "speaker": "凯亚",
                    "text": "哟，今天的酒保居然是你，真是罕见。"
                },
                {
                    "id": "705040102",
                    "speaker": "凯亚",
                    "text": "那我就要一杯午后之…"
                },
                {
                    "id": "705040103",
                    "speaker": "罗莎莉亚",
                    "text": "一开口就为难别人，真有你的。"
                },
                {
                    "id": "705040104",
                    "speaker": "凯亚",
                    "text": "#哎呀，只是想看{M#他}{F#她}如何应对嘛。倒是没想到罗莎莉亚小姐今天也来喝酒了。"
                },
                {
                    "id": "705040105",
                    "speaker": "凯亚",
                    "text": "酒馆里刁钻的客人那么多，旅行者不早点积累起经验可不行啊。"
                },
                {
                    "id": "705040106",
                    "speaker": "派蒙",
                    "text": "凯亚还是那么油嘴滑舌！"
                },
                {
                    "id": "705040107",
                    "speaker": "凯亚",
                    "text": "冤枉啊，我是一片好意！你不是应该感谢我吗？比如说，给我来一杯简简单单的月夜暗巷什么的。"
                },
                {
                    "id": "705040108",
                    "speaker": "凯亚",
                    "text": "啊对，要大杯！"
                },
                {
                    "id": "705040109",
                    "speaker": "罗莎莉亚",
                    "text": "给我随便来一杯。有茶香的饮品都行，量不用太大。"
                },
                {
                    "id": "705040110",
                    "speaker": "Player",
                    "text": "明白了，请稍等片刻。"
                },
                {
                    "id": "705040111",
                    "speaker": "凯亚",
                    "text": "慢慢来。等待美味出品的时间，也是很令人兴奋的。"
                }
            ]
        },
        {
            "id": "7050406",
            "objective": "前往吧台并完成营业准备",
            "dialogues": []
        },
        {
            "id": "7050405",
            "objective": "与凯亚和罗莎莉亚对话",
            "dialogues": []
        },
        {
            "id": "7050403",
            "objective": "为凯亚调制指定饮品",
            "dialogues": []
        },
        {
            "id": "7050402",
            "objective": "为罗莎莉亚调制指定饮品",
            "dialogues": [
                {
                    "id": "705040201",
                    "speaker": "罗莎莉亚",
                    "text": "嗯…"
                },
                {
                    "id": "705040202",
                    "speaker": "派蒙",
                    "text": "怎么了，不合罗莎莉亚的口味吗？"
                },
                {
                    "id": "705040203",
                    "speaker": "Player",
                    "text": "我可以重做一杯…"
                },
                {
                    "id": "705040204",
                    "speaker": "罗莎莉亚",
                    "text": "不，不是针对你。我只是很少喝茶，这种味道会让我想起一些事。"
                },
                {
                    "id": "705040205",
                    "speaker": "凯亚",
                    "text": "跟教会有关的？"
                },
                {
                    "id": "705040206",
                    "speaker": "罗莎莉亚",
                    "text": "嗯。有一次教会办活动，我没去，没想到芭芭拉给我留了一份茶和点心…"
                },
                {
                    "id": "705040207",
                    "speaker": "罗莎莉亚",
                    "text": "点心放得太久口感很差，她偷偷收走了。但那杯茶，差不多就是这个味道。"
                },
                {
                    "id": "705040208",
                    "speaker": "派蒙",
                    "text": "罗莎莉亚现在的神态，可真是少见呢。"
                },
                {
                    "id": "705040209",
                    "speaker": "凯亚",
                    "text": "看来蒙德要多一个红茶爱好者了。"
                },
                {
                    "id": "705040210",
                    "speaker": "罗莎莉亚",
                    "text": "那还是酒好。"
                },
                {
                    "id": "705040211",
                    "speaker": "Player",
                    "text": "凯亚呢，对饮品满意吗？"
                },
                {
                    "id": "705040212",
                    "speaker": "凯亚",
                    "text": "如果我挑几个瑕疵出来，你是不是会帮我重做一杯？"
                },
                {
                    "id": "705040213",
                    "speaker": "凯亚",
                    "text": "哈哈哈，开玩笑的，我怎么会做这种招你讨厌的事呢。"
                },
                {
                    "id": "705040214",
                    "speaker": "派蒙",
                    "text": "唉，凯亚的思维总是这么跳跃！真亏罗莎莉亚能跟他一起喝酒…"
                },
                {
                    "id": "705040215",
                    "speaker": "罗莎莉亚",
                    "text": "是吗？我根本不关心他的思维。喝酒，就只聊酒。"
                },
                {
                    "id": "705040216",
                    "speaker": "罗莎莉亚",
                    "text": "何况，你也好，这里的老板也好…凯亚只会试探自己感兴趣的人或事。"
                },
                {
                    "id": "705040217",
                    "speaker": "凯亚",
                    "text": "喂！咱们好歹也是酒友吧，你怎么出卖我？"
                },
                {
                    "id": "705040218",
                    "speaker": "罗莎莉亚",
                    "text": "这就算出卖了？根本无所谓吧。"
                },
                {
                    "id": "705040219",
                    "speaker": "罗莎莉亚",
                    "text": "平时生活中「正经人」可太多了。还是酒馆里人人松散的气氛更适合我。"
                },
                {
                    "id": "705040220",
                    "speaker": "凯亚",
                    "text": "哦？到批评正经人的时段了吗？"
                },
                {
                    "id": "705040221",
                    "speaker": "凯亚",
                    "text": "说起这个，我认识的某个人，应该能排进「蒙德正经人榜」前三吧。"
                },
                {
                    "id": "705040222",
                    "speaker": "凯亚",
                    "text": "要说程度…哦，应该这么形容。他已经正经到被当面这样评价表情也完全不会变化的地步了。"
                },
                {
                    "id": "705040223",
                    "speaker": "派蒙",
                    "text": "居然还有这种排名？"
                },
                {
                    "id": "705040224",
                    "speaker": "凯亚",
                    "text": "当然啦。我想想…还有连续喝酒天数排行、最长工作时间排行、厨房杀手排行、禁忌知识储备量排行…"
                },
                {
                    "id": "705040225",
                    "speaker": "派蒙",
                    "text": "蒙德人也太闲了啦！"
                },
                {
                    "id": "705040226",
                    "speaker": "罗莎莉亚",
                    "text": "不用上班的人，有那么多吗？",
                    "choices": [
                        {
                            "id": "705040227",
                            "text": "不…",
                            "response": [
                                {
                                    "id": "705040229",
                                    "speaker": "派蒙",
                                    "text": "#呜，就没有什么能让我和{M#他}{F#她}一起上榜的排行吗？"
                                },
                                {
                                    "id": "705040230",
                                    "speaker": "凯亚",
                                    "text": "有啊，比如「最佳酒保」。"
                                },
                                {
                                    "id": "705040231",
                                    "speaker": "派蒙",
                                    "text": "真，真的吗！"
                                },
                                {
                                    "id": "705040232",
                                    "speaker": "派蒙",
                                    "text": "#太好了，{NICKNAME}，我们也在这里一起留下我们的名字了！"
                                },
                                {
                                    "id": "705040233",
                                    "speaker": "罗莎莉亚",
                                    "text": "……"
                                },
                                {
                                    "id": "705040234",
                                    "speaker": "罗莎莉亚",
                                    "text": "哼，这种氛围倒是不错嘛。"
                                },
                                {
                                    "id": "705040235",
                                    "speaker": "凯亚",
                                    "text": "#可不是嘛，光看着{M#他}{F#她}们就觉得开心。"
                                },
                                {
                                    "id": "705040236",
                                    "speaker": "凯亚",
                                    "text": "极富感染力的氛围，嗯，会成为酒馆一大卖点的呢。看来「最佳酒保」称号给对人了。"
                                },
                                {
                                    "id": "705040237",
                                    "speaker": "派蒙",
                                    "text": "嗯？"
                                },
                                {
                                    "id": "705040238",
                                    "speaker": "凯亚",
                                    "text": "没什么，这次多谢两位款待。"
                                },
                                {
                                    "id": "705040239",
                                    "speaker": "罗莎莉亚",
                                    "text": "嗯，我差不多也该回去了。"
                                },
                                {
                                    "id": "705040240",
                                    "speaker": "罗莎莉亚",
                                    "text": "另外，红茶味道很好，之后我会试着自己泡泡看…如果早上起得来的话。"
                                },
                                {
                                    "id": "705040241",
                                    "speaker": "凯亚",
                                    "text": "那就再见喽？"
                                },
                                {
                                    "id": "705040242",
                                    "speaker": "Player",
                                    "text": "下次见。"
                                }
                            ]
                        },
                        {
                            "id": "705040228",
                            "text": "我大概知道都在指谁…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7050404",
            "objective": "将饮品交给凯亚和罗莎莉亚",
            "dialogues": []
        },
        {
