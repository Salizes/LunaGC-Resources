{
    "quest": {
        "id": "71538",
        "title": "如意祝柬·之六",
        "description": "似乎有人对制作祝柬产生了兴趣…",
        "rewards": [],
        "rewards_formatted": "",
        "chapter": {
            "icon": "",
            "id": "",
            "num": "",
            "title": ""
        },
        "total_dialogue_lines": 25,
