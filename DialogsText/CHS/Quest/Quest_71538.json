    },
    "talks": [
        {
            "id": "7153801",
            "objective": "等待至次日的8时至18时",
            "dialogues": [
                {
                    "id": "715380101",
                    "speaker": "夏沃蕾",
                    "text": "#{NICKNAME}，你好。海灯节快乐。",
                    "choices": [
                        {
                            "id": "715380102",
                            "text": "你…是来办案的？",
                            "response": [
                                {
                                    "id": "715380104",
                                    "speaker": "夏沃蕾",
                                    "text": "我正在被强制休假。"
                                },
                                {
                                    "id": "715380105",
                                    "speaker": "Player",
                                    "text": "强制…休假？"
                                },
                                {
                                    "id": "715380106",
                                    "speaker": "夏沃蕾",
                                    "text": "按照执律庭的规定，到每年年底，每一个人的公假都必须休完。"
                                },
                                {
                                    "id": "715380107",
                                    "speaker": "夏沃蕾",
                                    "text": "但是，今年的年终核算结束之后，队里发现我没有休过一天公假。所以…",
                                    "choices": [
                                        {
                                            "id": "715380108",
                                            "text": "特巡队真辛苦啊…",
                                            "response": [
                                                {
                                                    "id": "715380110",
                                                    "speaker": "夏沃蕾",
                                                    "text": "不是，特巡队里本来有轮班休假制，但我身为特巡队队长，必须常驻值守。"
                                                },
                                                {
                                                    "id": "715380111",
                                                    "speaker": "夏沃蕾",
                                                    "text": "再加上，时不时有些突发情况必须要我去处理，久而久之…我就忘记休假了。"
                                                },
                                                {
                                                    "id": "715380112",
                                                    "speaker": "夏沃蕾",
                                                    "text": "虽然这些公假对我来说没什么所谓，但我一说不如就不休假了，队里的人一下子都激动了起来…"
                                                },
                                                {
                                                    "id": "715380113",
                                                    "speaker": "夏沃蕾",
                                                    "text": "这群家伙嚷着什么「这可是白纸黑字的规定啊队长，我们特巡队怎么能违规」，一定要我出去休假。"
                                                },
                                                {
                                                    "id": "715380114",
                                                    "speaker": "夏沃蕾",
                                                    "text": "还有一个总是来我们队办事的复律官在旁边帮腔，甚至他还突然掏出了一张船票，说璃月正好在举办海灯节，还向我保证，这里绝对是休假的最佳地点…"
                                                },
                                                {
                                                    "id": "715380115",
                                                    "speaker": "夏沃蕾",
                                                    "text": "但不得不说，璃月确实不错。我刚从翘英庄回来，那边用茶叶做的点心味道都非常好。"
                                                },
                                                {
                                                    "id": "715380116",
                                                    "speaker": "夏沃蕾",
                                                    "text": "我买了不少点心，准备带回去给队里的人尝尝，还想按照璃月的习俗，做几封「祝柬」附在里面。"
                                                },
                                                {
                                                    "id": "715380117",
                                                    "speaker": "夏沃蕾",
                                                    "text": "只是…我并不是很会做这种东西，怎么做都感觉怪怪的。"
                                                },
                                                {
                                                    "id": "715380118",
                                                    "speaker": "夏沃蕾",
                                                    "text": "#{NICKNAME}，你明白这种东西的做法么？"
                                                },
                                                {
                                                    "id": "715380119",
                                                    "speaker": "Player",
                                                    "text": "我倒是有些建议…"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "715380109",
                                            "text": "特巡队每个人都这样？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "715380103",
                            "text": "你…看着不像是来工作的…？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7153802",
            "objective": "与夏沃蕾对话",
            "dialogues": []
        },
        {
            "id": "7153803",
            "objective": "和夏沃蕾一同完成祝柬",
            "dialogues": [
                {
                    "id": "715380301",
                    "speaker": "夏沃蕾",
                    "text": "唔，果然好看。但…也不能让你白送我这封「祝柬」。"
                },
                {
                    "id": "715380302",
                    "speaker": "夏沃蕾",
                    "text": "对了，这些点心拿着，多谢你了。有了你的这份礼物，我也算是不虚此行了。"
                },
                {
                    "id": "715380303",
                    "speaker": "夏沃蕾",
                    "text": "…不过，我离开枫丹这么久，队里的人也不知道有没有按时训练。"
                },
                {
                    "id": "715380304",
                    "speaker": "夏沃蕾",
                    "text": "总之，还是先做个体能测试计划吧。"
                }
            ]
        },
        {
            "id": "7153804",
            "objective": "与夏沃蕾对话",
