    "talks": [
        {
            "id": "7328207",
            "objective": "(test)隐藏：过了一些时候$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7328201",
            "objective": "(test)隐藏：与马塞拉对话领取任务$HIDDEN",
            "dialogues": [
                {
                    "id": "732820101",
                    "speaker": "马塞拉",
                    "text": "啊，您来了！请您留步，这恐怕是我最后一次拜托您了。",
                    "choices": [
                        {
                            "id": "732820102",
                            "text": "请说吧，有什么需要帮忙的？",
                            "response": [
                                {
                                    "id": "732820103",
                                    "speaker": "马塞拉",
                                    "text": "是塔德菈，她想要找您谈谈。"
                                },
                                {
                                    "id": "732820106",
                                    "speaker": "派蒙",
                                    "text": "欸…什么事呀，这么正式的。"
                                },
                                {
                                    "id": "732820107",
                                    "speaker": "马塞拉",
                                    "text": "北方的遗迹，你们最初遇见的地方附近…",
                                    "choices": [
                                        {
                                            "id": "732820108",
                                            "text": "你说什么…？",
                                            "response": [
                                                {
                                                    "id": "732820109",
                                                    "speaker": "马塞拉",
                                                    "text": "北方的遗迹，你们最初遇见的地方附近…别忘了。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "732820110",
                                            "text": "我明白了。",
                                            "response": [
                                                {
                                                    "id": "732820111",
                                                    "speaker": "马塞拉",
                                                    "text": "嗯，请您好好待她。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "732820104",
                            "text": "我还有别的事情要忙…",
                            "response": [
                                {
                                    "id": "732820105",
                                    "speaker": "马塞拉",
                                    "text": "请您务必听我说…塔德菈想要找您谈谈。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7328202",
            "objective": "前往塔德菈等候的地点",
            "dialogues": [
                {
                    "id": "732820201",
                    "speaker": "马塞拉",
                    "text": "北方的遗迹，你们最初遇见的地方附近…"
                },
                {
                    "id": "732820202",
                    "speaker": "马塞拉",
                    "text": "这是她的选择…希望您能够加以尊重。"
                }
            ]
        },
        {
            "id": "7328204",
            "objective": "与塔德菈对话",
            "dialogues": [
                {
                    "id": "732820401",
                    "speaker": "塔德菈",
                    "text": "你果然会来，我很开心。",
                    "choices": [
                        {
                            "id": "732820402",
                            "text": "我听说你在找我。",
                            "response": [
                                {
                                    "id": "732820404",
                                    "speaker": "塔德菈",
                                    "text": "我一直觉得这个时刻的沙漠，很好看。我很喜欢。"
                                },
                                {
                                    "id": "732820405",
                                    "speaker": "塔德菈",
                                    "text": "但是可惜…一直没有机会和朋友一起，在这里，就这样看太阳慢慢落下。"
                                },
                                {
                                    "id": "732820406",
                                    "speaker": "派蒙",
                                    "text": "是啊，整个沙漠都被染成红色了…很漂亮，好安静…"
                                },
                                {
                                    "id": "732820407",
                                    "speaker": "派蒙",
                                    "text": "不过，塔德菈，你专门叫我们来就是为了这个吗？"
                                },
                                {
                                    "id": "732820408",
                                    "speaker": "塔德菈",
                                    "text": "……"
                                },
                                {
                                    "id": "732820409",
                                    "speaker": "塔德菈",
                                    "text": "对于塔尼特，你是客人，对「猎鹰」来说，也是潜在的「猎物」…但我希望，活下来的是你。"
                                },
                                {
                                    "id": "732820410",
                                    "speaker": "Player",
                                    "text": "……"
                                },
                                {
                                    "id": "732820411",
                                    "speaker": "塔德菈",
                                    "text": "所以，对不起…"
                                }
                            ]
                        },
                        {
                            "id": "732820403",
                            "text": "最近过得如何？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7328205",
            "objective": "击败塔德菈",
            "dialogues": []
        },
        {
            "id": "7328206",
            "objective": "与马塞拉对质",
            "dialogues": [
                {
                    "id": "732820601",
                    "speaker": "派蒙",
                    "text": "可恶…马塞拉那家伙不见了！"
                },
                {
                    "id": "732820602",
                    "speaker": "利露帕尔",
                    "text": "他留下了这张字条…哼，老狐狸。"
                },
                {
                    "id": "732820603",
                    "speaker": "整洁的字条",
                    "text": "若您看到这张字条，那么我已经深入峡谷之中的避难所了。\\n若您的首级还在两肩中间，请不要为塔德菈的选择悲伤。\\n\\n这场狩猎并非结束，而是风暴的开始。\\n塔尼特长老，猎人马塞拉，特为您发出警告。"
                },
                {
                    "id": "732820604",
                    "speaker": "派蒙",
                    "text": "他说的这些…看不明白是什么意思呢…"
                },
                {
                    "id": "732820605",
                    "speaker": "利露帕尔",
                    "text": "看来出于某种压力，这家伙离开了部落…并且给您留下了警告。哼，塔尼特…暗潮汹涌呢。"
                }
            ]
        },
        {
            "id": "7328228",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "732822801",
                    "speaker": "塔德菈",
                    "text": "（她局促地别开目光。然后紧张地低下了头。）",
                    "choices": [
                        {
                            "id": "732822802",
                            "text": "你还好吗？",
                            "response": [
                                {
                                    "id": "732822803",
                                    "speaker": "塔德菈",
                                    "text": "抱歉，狩猎已经结束了。我是父亲的「猎鹰」。"
                                },
                                {
                                    "id": "732822804",
                                    "speaker": "塔德菈",
                                    "text": "不过…我很好，请您不要担心。",
                                    "choices": [
                                        {
                                            "id": "732822808",
                                            "text": "这么极端吗…？",
                                            "response": [
                                                {
                                                    "id": "732822809",
                                                    "speaker": "塔德菈",
                                                    "text": "极端…？我不知道，我从懂事起就是这样活着的。"
                                                },
                                                {
                                                    "id": "732822814",
                                                    "speaker": "塔德菈",
                                                    "text": "啊…不过…你和派蒙的故事，你们的旅行…"
                                                },
                                                {
                                                    "id": "732822815",
                                                    "speaker": "塔德菈",
                                                    "text": "有机会的话，我想多听你讲讲。"
                                                },
                                                {
                                                    "id": "732822816",
                                                    "speaker": "派蒙",
                                                    "text": "好呀，我们有好多好多故事呢！",
                                                    "choices": [
                                                        {
                                                            "id": "732822817",
                                                            "text": "嗯，我会的。",
                                                            "response": [
                                                                {
                                                                    "id": "732822819",
                                                                    "speaker": "塔德菈",
                                                                    "text": "噗…"
                                                                },
                                                                {
                                                                    "id": "732822820",
                                                                    "speaker": "塔德菈",
                                                                    "text": "咳咳，没什么，我只是很高兴…谢谢你…呃，您。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "732822818",
                                                            "text": "你想听的话，我随时可以给你讲。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "732822810",
                                            "text": "你没想过为自己而活吗？",
                                            "response": [
                                                {
                                                    "id": "732822811",
                                                    "speaker": "塔德菈",
                                                    "text": "……"
                                                },
                                                {
                                                    "id": "732822812",
                                                    "speaker": "塔德菈",
                                                    "text": "…不，没有。没想过，没期待过。"
                                                },
                                                {
                                                    "id": "732822813",
                                                    "speaker": "塔德菈",
                                                    "text": "沙漠很冷酷，没有闲暇考虑自己。没有我，还有很多人能活，但没有部族…我没办法一个人活下去。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "732822805",
                            "text": "关于你和马塞拉的关系…",
                            "response": [
                                {
                                    "id": "732822806",
                                    "speaker": "塔德菈",
                                    "text": "我说过，他是我的父亲，我是他的「猎鹰」。我跟随他的指令，为他而猎，为他而死…因为他代表了塔尼特的意志。"
                                },
                                {
                                    "id": "732822807",
                                    "speaker": "塔德菈",
                                    "text": "假如我什么时候无法贯彻父亲的指令了，那么作为「猎鹰」的生命就这样结束了。",
                                    "choices": [
                                        {
                                            "id": "732822808",
                                            "text": "这么极端吗…？"
                                        },
                                        {
                                            "id": "732822810",
                                            "text": "你没想过为自己而活吗？"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7328229",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "732822901",
                    "speaker": "马塞拉",
                    "text": "啊，您来了，尊贵的「镇灵主人」。请问您有何要事？",
                    "choices": [
                        {
                            "id": "732822902",
                            "text": "关于塔德菈…",
                            "response": [
                                {
                                    "id": "732822903",
                                    "speaker": "马塞拉",
                                    "text": "她很中意你，我看得出来。"
                                },
                                {
                                    "id": "732822904",
                                    "speaker": "马塞拉",
                                    "text": "放心，我不会在意的，年轻人嘛…"
                                },
                                {
                                    "id": "732822905",
                                    "speaker": "马塞拉",
                                    "text": "我会鼓励她表达心意的，作为长辈，作为父亲，我会的…所以，请您不要太为她担心。"
                                }
                            ]
                        },
                        {
                            "id": "732822906",
                            "text": "关于「成年礼」…",
                            "response": [
                                {
                                    "id": "732822907",
                                    "speaker": "马塞拉",
                                    "text": "感谢您帮助她完成了成年礼，信任您果然是正确的。"
                                },
                                {
                                    "id": "732822908",
                                    "speaker": "马塞拉",
                                    "text": "接下来，她就要作为成熟的「猎鹰」，领取第一个狩猎任务了。"
                                },
                                {
                                    "id": "732822909",
                                    "speaker": "马塞拉",
                                    "text": "到时候…呵呵，还要请您亲自见证她的成长呀。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7328299",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "732829901",
                    "speaker": "派蒙",
                    "text": "塔德菈？塔德菈！欸…她…"
                },
                {
                    "id": "732829902",
                    "speaker": "利露帕尔",
                    "text": "这是她出于自己的意志所做的选择…不再作为「猎鹰」，而是作为「朋友」而活。"
                }
            ]
        }
    ]
}