    "talks": [
        {
            "id": "7211001",
            "objective": "",
            "dialogues": [
                {
                    "id": "721100101",
                    "speaker": "岩藏光造",
                    "text": "我究竟是为什么而离开道馆，成为九条大人的指南的呢…"
                },
                {
                    "id": "721100102",
                    "speaker": "岩藏光造",
                    "text": "柳叶和冈崎，还有三船…又为什么会离开我呢…"
                }
            ]
        },
        {
            "id": "7211002",
            "objective": "",
            "dialogues": [
                {
                    "id": "721100201",
                    "speaker": "冈崎寅卫门",
                    "text": "…现在，只差岩藏光胤的刀了。"
                },
                {
                    "id": "721100202",
                    "speaker": "柳叶岚士",
                    "text": "岩藏家祖传的「薄缘满光天目」吗。当初你和久仁彦刚被收养的时候，趁前代的永胤大人不注意…"
                },
                {
                    "id": "721100203",
                    "speaker": "冈崎寅卫门",
                    "text": "我们已经「破门」了。不用叫大人了。"
                },
                {
                    "id": "721100204",
                    "speaker": "柳叶岚士",
                    "text": "但是，冈崎…"
                },
                {
                    "id": "721100205",
                    "speaker": "柳叶岚士",
                    "text": "「将『情』与『义』置于天平两端，真正的剑士只有『义』之道可走。」"
                },
                {
                    "id": "721100206",
                    "speaker": "柳叶岚士",
                    "text": "既然师父这么说，那就说明他不情愿将我们逐出师门，但又没有其他的选择。"
                },
                {
                    "id": "721100207",
                    "speaker": "冈崎寅卫门",
                    "text": "当然不愿意了。但既然他已经决定成为将军的刀，贯彻眼狩令，那我们也只能…"
                },
                {
                    "id": "721100208",
                    "speaker": "柳叶岚士",
                    "text": "我们只能选择我们自己的道义了。毕竟，「真正的剑士只有『义』之途可走。」"
                },
                {
                    "id": "721100209",
                    "speaker": "柳叶岚士",
                    "text": "但是，师父的道义，终究也被挫败了。"
                },
                {
                    "id": "721100210",
                    "speaker": "冈崎寅卫门",
                    "text": "没错。不止是久仁彦的仇，其他人，还有岩藏光胤的仇，我们都要报。"
                },
                {
                    "id": "721100211",
                    "speaker": "冈崎寅卫门",
                    "text": "这就是我们这些破门弟子的道义。"
                },
                {
                    "id": "721100212",
                    "speaker": "柳叶岚士",
                    "text": "这也是师父的保佑吧。第一个仇家，就这样送上门来了。"
                },
                {
                    "id": "721100213",
                    "speaker": "冈崎寅卫门",
                    "text": "#也对。{NICKNAME}就是你吧。你的事迹，我已经听说了。"
                },
                {
                    "id": "721100214",
                    "speaker": "冈崎寅卫门",
                    "text": "在剑士的世界里，只有用血才可以洗净「血」。面对岩藏流「免许皆传」的准备，你已经准备好了吧！"
                }
            ]
        },
        {
            "id": "7211003",
            "objective": "",
            "dialogues": [
                {
                    "id": "721100301",
                    "speaker": "岩藏光造",
                    "text": "我究竟是为什么而离开道馆，成为九条大人的指南的呢…"
                },
                {
                    "id": "721100302",
                    "speaker": "岩藏光造",
                    "text": "柳叶和冈崎，还有三船…又为什么会离开我呢…"
                },
                {
                    "id": "721100303",
                    "speaker": "player",
                    "text": "岩藏流的门生，我已经拜会过了。"
                },
                {
                    "id": "721100304",
                    "speaker": "岩藏光造",
                    "text": "是吗。"
                },
                {
                    "id": "721100305",
                    "speaker": "岩藏光造",
                    "text": "现在还有人，会以岩藏流的名号自居吗。明明宗主是这么不成器的人。"
                },
                {
                    "id": "721100306",
                    "speaker": "岩藏光造",
                    "text": "我是岩藏光造，姑且在这里担任剑道指南。阁下是？"
                },
                {
                    "id": "721100307",
                    "speaker": "player",
                    "text": "#我是{NICKNAME}。"
                },
                {
                    "id": "721100308",
                    "speaker": "岩藏光造",
                    "text": "三船、丹波…你见到他们了吗？还有冈崎兄弟。"
                },
                {
                    "id": "721100309",
                    "speaker": "岩藏光造",
                    "text": "还有片山。他喜欢在一决胜负之前，给这场比试取名。"
                },
                {
                    "id": "721100310",
                    "speaker": "岩藏光造",
                    "text": "因为，「如果将来我成为了真正的剑豪，那这些比试都是可以写成故事的」。哈哈哈，真是瞎胡闹…"
                },
                {
                    "id": "721100311",
                    "speaker": "岩藏光造",
                    "text": "对了，还有从「永胤」的时代到「光胤」的时代，都无法突破「初传」的岛田。"
                },
                {
                    "id": "721100312",
                    "speaker": "岩藏光造",
                    "text": "他们因为无法领会将军大人「眼狩令」的气量，似乎是落草为寇了。"
                },
                {
                    "id": "721100313",
                    "speaker": "岩藏光造",
                    "text": "过去指导他们握刀挥剑的岁月，真是令人怀念。我究竟为什么关闭了道馆，来到了军中呢？"
                },
                {
                    "id": "721100314",
                    "speaker": "岩藏光造",
                    "text": "#{NICKNAME}阁下，他们的本领如何？",
                    "choices": [
                        {
                            "id": "721100315",
                            "text": "很遗憾…",
                            "response": [
                                {
                                    "id": "721100317",
                                    "speaker": "岩藏光造",
                                    "text": "是吗…"
                                },
                                {
                                    "id": "721100318",
                                    "speaker": "岩藏光造",
                                    "text": "#那么，{NICKNAME}阁下，你师承自谁？土门？还是说，是涉川的流派？难道是鸣神亲传？"
                                },
                                {
                                    "id": "721100319",
                                    "speaker": "player",
                                    "text": "应该算是「我流」吧。"
                                },
                                {
                                    "id": "721100320",
                                    "speaker": "岩藏光造",
                                    "text": "原来如此。"
                                },
                                {
                                    "id": "721100321",
                                    "speaker": "岩藏光造",
                                    "text": "看来岩藏流，终究还是在我手上没落了。亲自教出来的弟子，在真剑比试中竟然无法胜过没有师承的野小子。"
                                },
                                {
                                    "id": "721100322",
                                    "speaker": "player",
                                    "text": "…"
                                },
                                {
                                    "id": "721100323",
                                    "speaker": "岩藏光造",
                                    "text": "这样啊，我明白了。"
                                },
                                {
                                    "id": "721100324",
                                    "speaker": "岩藏光造",
                                    "text": "无论你的流派是什么，都无所谓了。"
                                },
                                {
                                    "id": "721100325",
                                    "speaker": "岩藏光造",
                                    "text": "看来岩藏流，终究还是在我手上没落了。亲自教出来的弟子，在真剑比试中竟然无法胜过不愿自报家门的人。"
                                },
                                {
                                    "id": "721100326",
                                    "speaker": "岩藏光造",
                                    "text": "我姑且是岩藏流不成器的宗主。作为剑客，名号是「岩藏光胤」。"
                                },
                                {
                                    "id": "721100327",
                                    "speaker": "岩藏光造",
                                    "text": "虽然秘剑的心得我已经不记得了，「神之眼」也交给了将军大人…"
                                },
                                {
                                    "id": "721100328",
                                    "speaker": "岩藏光造",
                                    "text": "…不过，若是要为那些不甘于我的堕落，而走上忤逆的恶鬼之道，"
                                },
                                {
                                    "id": "721100329",
                                    "speaker": "岩藏光造",
                                    "text": "却又不那么成器、败在了你手下的门生报仇的情义，还是有的。"
                                },
                                {
                                    "id": "721100330",
                                    "speaker": "岩藏光造",
                                    "text": "这里不够开阔，恐怕你的剑技也难以施展吧。跟我下去。"
                                }
                            ]
                        },
                        {
                            "id": "721100316",
                            "text": "多有受教。"
                        }
                    ]
                }
            ]
        }
    ]
}