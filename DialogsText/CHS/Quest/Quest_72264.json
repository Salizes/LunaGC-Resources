    "talks": [
        {
            "id": "7226411",
            "objective": "前往龙脊雪山$HIDDEN",
            "dialogues": [
                {
                    "id": "722641101",
                    "speaker": "五百藏",
                    "text": "吉法师这孩子就交给你们了。他很有智慧。等他长大了，吾辈打算将妖狸大王的称号与保生司正的责任交给他。"
                },
                {
                    "id": "722641102",
                    "speaker": "五百藏",
                    "text": "所以，小辈你一定要照顾好他！不要让吉法师着凉了！"
                }
            ]
        },
        {
            "id": "7226401",
            "objective": "前往龙脊雪山",
            "dialogues": [
                {
                    "id": "722640101",
                    "speaker": "派蒙",
                    "text": "呜呜…虽然之前把山顶那个「大柱子」升起来了…"
                },
                {
                    "id": "722640102",
                    "speaker": "派蒙",
                    "text": "不过，不管来多少次，龙脊雪山都这么冷…好难受…"
                },
                {
                    "id": "722640103",
                    "speaker": "「吉法师」",
                    "text": "呶哈哈，白毛弱。"
                },
                {
                    "id": "722640104",
                    "speaker": "派蒙",
                    "text": "欸！"
                },
                {
                    "id": "722640105",
                    "speaker": "Player",
                    "text": "吉法师不怕冷？"
                },
                {
                    "id": "722640106",
                    "speaker": "「吉法师」",
                    "text": "呶呜呜，好冷好冷。"
                },
                {
                    "id": "722640107",
                    "speaker": "派蒙",
                    "text": "什么嘛！气死我了！"
                },
                {
                    "id": "722640108",
                    "speaker": "「吉法师」",
                    "text": "不过，好好玩。白色的到处都是。"
                },
                {
                    "id": "722640109",
                    "speaker": "派蒙",
                    "text": "白色的…啊，那些是「雪」喔！"
                },
                {
                    "id": "722640110",
                    "speaker": "「吉法师」",
                    "text": "「雪」…「樱吹雪」的雪？神樱树？"
                },
                {
                    "id": "722640111",
                    "speaker": "派蒙",
                    "text": "不是啦，雪就是龙脊雪山这些很冷很冷的白色东西。"
                },
                {
                    "id": "722640112",
                    "speaker": "派蒙",
                    "text": "不过，吉法师竟然知道樱吹雪这样的词，应该说不愧是稻妻的妖狸吗…"
                },
                {
                    "id": "722640113",
                    "speaker": "「吉法师」",
                    "text": "呶！是雪！好冷好冷！"
                },
                {
                    "id": "722640114",
                    "speaker": "Player",
                    "text": "吉法师看起来好高兴。"
                },
                {
                    "id": "722640115",
                    "speaker": "「吉法师」",
                    "text": "山有雪所以冷，还是山很冷所以雪？"
                },
                {
                    "id": "722640116",
                    "speaker": "派蒙",
                    "text": "……"
                },
                {
                    "id": "722640117",
                    "speaker": "派蒙",
                    "text": "#欸，这个问题问得好。{NICKNAME}，你觉得雪是什么？",
                    "choices": [
                        {
                            "id": "722640118",
                            "text": "是水元素吧。",
                            "response": [
                                {
                                    "id": "722640119",
                                    "speaker": "派蒙",
                                    "text": "唔…如果是这样的话，那就是因为这里很冷，所以水元素结冰了，变成了雪…"
                                },
                                {
                                    "id": "722640120",
                                    "speaker": "「吉法师」",
                                    "text": "好冷好冷。好多雪。"
                                },
                                {
                                    "id": "722640128",
                                    "speaker": "派蒙",
                                    "text": "不管怎么说，这种事情，以后有机会问问丽莎这样知识渊博的人吧。"
                                },
                                {
                                    "id": "722640129",
                                    "speaker": "派蒙",
                                    "text": "龙脊雪山真的好冷。之前，向山顶前进的时候，感觉有几次都冷得意识模糊了…"
                                },
                                {
                                    "id": "722640130",
                                    "speaker": "派蒙",
                                    "text": "不过，风景也很不错！既然从影向山上能看到这里，那从山顶上也能看到影向山吧！"
                                },
                                {
                                    "id": "722640131",
                                    "speaker": "派蒙",
                                    "text": "而且星荧洞窟很深，里面可能还有什么没发现的宝藏…"
                                },
                                {
                                    "id": "722640132",
                                    "speaker": "「吉法师」",
                                    "text": "宝藏！宝藏好东西。"
                                },
                                {
                                    "id": "722640133",
                                    "speaker": "Player",
                                    "text": "吉法师和派蒙说不定很合得来。"
                                },
                                {
                                    "id": "722640134",
                                    "speaker": "派蒙",
                                    "text": "哼哼，没有宝藏，怎么过好日子、吃好东西。吉法师挺懂的嘛。"
                                },
                                {
                                    "id": "722640135",
                                    "speaker": "「吉法师」",
                                    "text": "吉法师想在雪里玩。"
                                },
                                {
                                    "id": "722640136",
                                    "speaker": "派蒙",
                                    "text": "嗯，别着凉哦！"
                                },
                                {
                                    "id": "722640137",
                                    "speaker": "Player",
                                    "text": "如果遇到危险的话…"
                                },
                                {
                                    "id": "722640138",
                                    "speaker": "Player",
                                    "text": "大喊「有宝藏」就好。"
                                },
                                {
                                    "id": "722640139",
                                    "speaker": "派蒙",
                                    "text": "喂！"
                                }
                            ]
                        },
                        {
                            "id": "722640121",
                            "text": "是冰元素吧。",
                            "response": [
                                {
                                    "id": "722640122",
                                    "speaker": "派蒙",
                                    "text": "欸？是这样吗？这样的话，就是因为雪是冰元素，所以让这里变得很冷…"
                                },
                                {
                                    "id": "722640123",
                                    "speaker": "「吉法师」",
                                    "text": "好冷好冷。好多雪。"
                                }
                            ]
                        },
                        {
                            "id": "722640124",
                            "text": "是凯亚干的吧。",
                            "response": [
                                {
                                    "id": "722640125",
                                    "speaker": "派蒙",
                                    "text": "「小心着凉！」"
                                },
                                {
                                    "id": "722640126",
                                    "speaker": "派蒙",
                                    "text": "不对！再怎么说，凯亚也没这么厉害吧！"
                                },
                                {
                                    "id": "722640127",
                                    "speaker": "「吉法师」",
                                    "text": "？"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
