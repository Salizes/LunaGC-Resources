        {
            "id": "7226403",
            "objective": "与吉法师对话",
            "dialogues": [
                {
                    "id": "722640901",
                    "speaker": "「吉法师」",
                    "text": "好烫好烫。不过，好好玩。"
                },
                {
                    "id": "722640902",
                    "speaker": "派蒙",
                    "text": "不过，之前是「刑部小判」还是「证城」也变成过火把…你们妖狸，是很喜欢变成火把吗？"
                },
                {
                    "id": "722640903",
                    "speaker": "「吉法师」",
                    "text": "变成人类的东西。可以和人类玩。"
                },
                {
                    "id": "722640904",
                    "speaker": "「吉法师」",
                    "text": "不然，人一般不和吉法师玩。"
                },
                {
                    "id": "722640905",
                    "speaker": "派蒙",
                    "text": "#没关系，我和{NICKNAME}陪吉法师一起玩！"
                },
                {
                    "id": "722640906",
                    "speaker": "「吉法师」",
                    "text": "耶！一起玩！"
                },
                {
                    "id": "722640907",
                    "speaker": "派蒙",
                    "text": "唔…不过这前面是断崖，要我们带你过去吗？"
                },
                {
                    "id": "722640908",
                    "speaker": "「吉法师」",
                    "text": "吉法师，飞飞。砰砰！"
                },
                {
                    "id": "722640909",
                    "speaker": "派蒙",
                    "text": "欸？"
                },
                {
                    "id": "722640910",
                    "speaker": "Black Screen",
                    "text": "吉法师身上变出了像是气囊的东西，\\n竟借着它的浮力与雪山有些刺骨的风，顺利地飘到了山崖对面。"
                },
                {
                    "id": "722640911",
                    "speaker": "派蒙",
                    "text": "…那是什么东西啦！到底是怎么回事啦！"
                }
            ]
        },
        {
            "id": "7226412",
            "objective": "跟上吉法师",
            "dialogues": []
        },
        {
            "id": "7226404",
            "objective": "与吉法师对话",
            "dialogues": [
                {
                    "id": "722640301",
                    "speaker": "「吉法师」",
                    "text": "呶哈哈，好慢好慢。好弱。"
                },
                {
                    "id": "722640302",
                    "speaker": "派蒙",
                    "text": "可恶，这家伙一点也不可爱！"
                },
                {
                    "id": "722640303",
                    "speaker": "Player",
                    "text": "吉法师，不能嘲笑别人。"
                },
                {
                    "id": "722640304",
                    "speaker": "「吉法师」",
                    "text": "但是，笑不好吗？"
                },
                {
                    "id": "722640305",
                    "speaker": "派蒙",
                    "text": "嗯…该怎么说呢？笑是好事，但笑别人就不好。"
                },
                {
                    "id": "722640306",
                    "speaker": "Player",
                    "text": "要大家都一起笑，才是好的。"
                },
                {
                    "id": "722640307",
                    "speaker": "「吉法师」",
                    "text": "#知道了。对不起。黄毛{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_UNCLE|INFO_FEMALE_PRONOUN_AUNT]}。"
                },
                {
                    "id": "722640308",
                    "speaker": "Player",
                    "text": "#不是{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_UNCLE|INFO_FEMALE_PRONOUN_AUNT]}，是{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}。"
                },
                {
                    "id": "722640309",
                    "speaker": "派蒙",
                    "text": "#我叫派蒙，黄毛{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}叫{NICKNAME}。吉法师，要好好记住喔！"
                },
                {
                    "id": "722640310",
                    "speaker": "「吉法师」",
                    "text": "好难记。好麻烦。白毛黄毛。"
                },
                {
                    "id": "722640311",
                    "speaker": "派蒙",
                    "text": "……"
                },
                {
                    "id": "722640312",
                    "speaker": "Player",
                    "text": "也不用勉强啦。"
                },
                {
                    "id": "722640313",
                    "speaker": "派蒙",
                    "text": "不过，刚刚吉法师用的那招是什么？「咻」的一下变出来气球，然后「嗖」的一下就飘过来了的那个，看起来好厉害呀？"
                },
                {
                    "id": "722640314",
                    "speaker": "「吉法师」",
                    "text": "八叠砰砰。"
                },
                {
                    "id": "722640315",
                    "speaker": "派蒙",
                    "text": "那到底是什么啦…感觉又听不懂吉法师说的话了。",
                    "choices": [
                        {
                            "id": "722640316",
                            "text": "起码比「咔嚓咔嚓菫瓜」好懂…",
                            "response": [
                                {
                                    "id": "722640320",
                                    "speaker": "「吉法师」",
                                    "text": "那个，白毛黄毛没有？"
                                },
                                {
                                    "id": "722640321",
                                    "speaker": "「吉法师」",
                                    "text": "白毛能飞飞。黄毛也能飞飞。所以白毛黄毛有。"
                                },
                                {
                                    "id": "722640322",
                                    "speaker": "派蒙",
                                    "text": "这、这么说也没错…"
                                },
                                {
                                    "id": "722640323",
                                    "speaker": "Player",
                                    "text": "可能是什么妖狸才有的力量吧。"
                                },
                                {
                                    "id": "722640324",
                                    "speaker": "「吉法师」",
                                    "text": "嗯。雪山好玩。前进前进。"
                                }
                            ]
                        },
                        {
                            "id": "722640317",
                            "text": "比「菫瓜砰砰」还难懂…",
                            "response": [
                                {
                                    "id": "722640318",
                                    "speaker": "「吉法师」",
                                    "text": "噗噗，菫瓜砰砰。"
                                },
                                {
                                    "id": "722640319",
                                    "speaker": "派蒙",
                                    "text": "到底是什么意思啦！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7226405",
            "objective": "与吉法师玩耍",
            "dialogues": [
                {
                    "id": "722640501",
                    "speaker": "「吉法师」",
                    "text": "黄毛厉害。好强好强。",
                    "choices": [
                        {
                            "id": "722640502",
                            "text": "我打过比这个更大的。",
                            "response": [
                                {
                                    "id": "722640505",
                                    "speaker": "派蒙",
                                    "text": "对了！相片应该没问题吧…"
                                },
                                {
                                    "id": "722640506",
                                    "speaker": "Black Screen",
                                    "text": "向吉法师与派蒙展示刚刚拍的相片。"
                                },
                                {
                                    "id": "722640507",
                                    "speaker": "「吉法师」",
                                    "text": "噗噗，好像吉法师喔这个。"
                                },
                                {
                                    "id": "722640508",
                                    "speaker": "派蒙",
                                    "text": "这就是吉法师喔。"
                                },
                                {
                                    "id": "722640509",
                                    "speaker": "「吉法师」",
                                    "text": "呶？但是，吉法师是我。只有一个。"
                                },
                                {
                                    "id": "722640510",
                                    "speaker": "派蒙",
                                    "text": "嗯，这个不是吉法师啦。"
                                },
                                {
                                    "id": "722640511",
                                    "speaker": "「吉法师」",
                                    "text": "雪山有妖狸？但是，没闻到。"
                                },
                                {
                                    "id": "722640512",
                                    "speaker": "派蒙",
                                    "text": "啊，不是的，龙脊雪山没有妖狸。这个就是吉法师啦。"
                                },
                                {
                                    "id": "722640513",
                                    "speaker": "「吉法师」",
                                    "text": "？"
                                },
                                {
                                    "id": "722640514",
                                    "speaker": "派蒙",
                                    "text": "？"
                                },
                                {
                                    "id": "722640515",
                                    "speaker": "Player",
                                    "text": "（向吉法师解释相片的事情…）"
                                },
                                {
                                    "id": "722640516",
                                    "speaker": "「吉法师」",
                                    "text": "原来是画。白毛真笨。呶哈哈。"
                                },
                                {
                                    "id": "722640517",
                                    "speaker": "派蒙",
                                    "text": "呜呜，虽然好生气，但不知道怎么反驳…"
                                },
                                {
                                    "id": "722640518",
                                    "speaker": "「吉法师」",
                                    "text": "不笑了。一起笑才是好的。"
                                },
                                {
                                    "id": "722640519",
                                    "speaker": "派蒙",
                                    "text": "可恶…"
                                },
                                {
                                    "id": "722640520",
                                    "speaker": "Player",
                                    "text": "吉法师真乖，表扬。"
                                },
                                {
                                    "id": "722640521",
                                    "speaker": "「吉法师」",
                                    "text": "表扬！耶！"
                                },
                                {
                                    "id": "722640522",
                                    "speaker": "派蒙",
                                    "text": "嗯…那今天就到这里吧。吉法师也累了吧？"
                                },
                                {
                                    "id": "722640523",
                                    "speaker": "「吉法师」",
                                    "text": "嗯。"
                                },
                                {
                                    "id": "722640524",
                                    "speaker": "派蒙",
                                    "text": "那我们回去向五百藏报告吧。毕竟，五百藏感觉还挺担心的。"
                                }
                            ]
                        },
                        {
                            "id": "722640503",
                            "text": "为了养活派蒙，锻炼出的本领。",
                            "response": [
                                {
                                    "id": "722640504",
                                    "speaker": "派蒙",
                                    "text": "喂！真没礼貌。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7226410",
            "objective": "与吉法师对话",
            "dialogues": [
                {
                    "id": "722640401",
                    "speaker": "「吉法师」",
                    "text": "这些生类…"
                },
                {
                    "id": "722640402",
                    "speaker": "派蒙",
                    "text": "生类…是指这些雪猪吗？"
                },
                {
                    "id": "722640403",
                    "speaker": "「吉法师」",
                    "text": "被封印了？"
                },
                {
                    "id": "722640404",
                    "speaker": "派蒙",
                    "text": "唔…倒不是被封印了，应该只是被冰封了吧？毕竟龙脊雪山很冷呢。"
                },
                {
                    "id": "722640405",
                    "speaker": "「吉法师」",
                    "text": "哦。好怪哦。"
                },
                {
                    "id": "722640406",
                    "speaker": "派蒙",
                    "text": "#嗯…这么说来，{NICKNAME}，我们要不要给吉法师「留影」纪念？"
                },
                {
                    "id": "722640407",
                    "speaker": "Player",
                    "text": "好主意。"
                },
                {
                    "id": "722640408",
                    "speaker": "「吉法师」",
                    "text": "？"
                },
                {
                    "id": "722640409",
                    "speaker": "派蒙",
                    "text": "嘿嘿。毕竟吉法师也难得来一趟，有相片纪念应该很不错。而且，也可以跟五百藏交差。"
                },
                {
                    "id": "722640410",
                    "speaker": "派蒙",
                    "text": "就这么决定了。吉法师，乖乖站好！"
                },
                {
                    "id": "722640411",
                    "speaker": "「吉法师」",
                    "text": "白毛好奇怪。知道了。"
                }
            ]
        },
        {
            "id": "7226406",
            "objective": "为吉法师拍照",
            "dialogues": [
                {
                    "id": "722640601",
                    "speaker": "五百藏",
                    "text": "呶！你们回来了！有没有受伤？有没有着凉？肚子饿不饿？"
                },
                {
                    "id": "722640602",
                    "speaker": "派蒙",
                    "text": "嘿嘿，如果有吃的话…"
                },
                {
                    "id": "722640603",
                    "speaker": "Player",
                    "text": "一切顺利，不用担心。"
                },
                {
                    "id": "722640604",
                    "speaker": "「吉法师」",
                    "text": "呶！雪好冷。但是，很好玩。"
                },
                {
                    "id": "722640605",
                    "speaker": "派蒙",
                    "text": "啊，对了！还有纪念品！"
                },
                {
                    "id": "722640606",
                    "speaker": "Black Screen",
                    "text": "向五百藏展示吉法师在雪山的相片。"
                },
                {
                    "id": "722640607",
                    "speaker": "五百藏",
                    "text": "咿——吉法师！吉法师怎么被封印在纸里面了？！"
                },
                {
                    "id": "722640608",
                    "speaker": "五百藏",
                    "text": "这是、这是「地狱绘」？怎么会在你的手里？为什么？",
                    "choices": [
                        {
                            "id": "722640609",
                            "text": "人类的法术很厉害吧。",
                            "response": [
                                {
                                    "id": "722640610",
                                    "speaker": "五百藏",
                                    "text": "呜呶呶，怎么会这样…"
                                },
                                {
                                    "id": "722640611",
                                    "speaker": "派蒙",
                                    "text": "好啦好啦，别欺负五百藏啦。那是「相片」，是一种画。你看，吉法师不是好好的嘛。"
                                },
                                {
                                    "id": "722640614",
                                    "speaker": "「吉法师」",
                                    "text": "耶！"
                                },
                                {
                                    "id": "722640615",
                                    "speaker": "五百藏",
                                    "text": "咦？两个吉法师…？欸？欸？这是什么法术？"
                                },
                                {
                                    "id": "722640616",
                                    "speaker": "五百藏",
                                    "text": "…哦，原来如此，是法术嘛！哈哈哈，吉法师，进步很快嘛。"
                                },
                                {
                                    "id": "722640617",
                                    "speaker": "「吉法师」",
                                    "text": "呶哈哈。笨蛋。"
                                },
                                {
                                    "id": "722640618",
                                    "speaker": "派蒙",
                                    "text": "真是的，好好听人说话啦！"
                                },
                                {
                                    "id": "722640619",
                                    "speaker": "Black Screen",
                                    "text": "多花费了一番口舌，向五百藏解释。"
                                },
                                {
                                    "id": "722640620",
                                    "speaker": "五百藏",
                                    "text": "…呶，吾辈可是大名鼎鼎的妖狸大王！怎么会不知道「楼影鸡」是什么。吾辈只是考考吉法师。"
                                },
                                {
                                    "id": "722640621",
                                    "speaker": "派蒙",
                                    "text": "好不知所谓喔。"
                                },
                                {
                                    "id": "722640622",
                                    "speaker": "「吉法师」",
                                    "text": "强词夺理。呶。"
                                },
                                {
                                    "id": "722640623",
                                    "speaker": "五百藏",
                                    "text": "咳咳。不管怎么说，看来吉法师的修行很顺利。",
                                    "choices": [
                                        {
                                            "id": "722640624",
                                            "text": "和吉法师旅行很有趣。",
                                            "response": [
                                                {
                                                    "id": "722640627",
                                                    "speaker": "五百藏",
                                                    "text": "呶，很好。那接下来也交给你们了。"
                                                },
                                                {
                                                    "id": "722640628",
                                                    "speaker": "五百藏",
                                                    "text": "当年吾辈还是幼狸的时候，曾经游历了十八所圣迹，不偏不倚地走在狸道上，才变成了伟大的妖狸大王。"
                                                },
                                                {
                                                    "id": "722640629",
                                                    "speaker": "五百藏",
                                                    "text": "吉法师现在只有吾辈当初一半伟大。所以，修行就去八个地方就行了。"
                                                },
                                                {
                                                    "id": "722640630",
                                                    "speaker": "派蒙",
                                                    "text": "虽然很想说「按照一半算，应该是九个地方」，不过不管了…接下来，我们要带吉法师去什么地方呢？"
                                                },
                                                {
                                                    "id": "722640631",
                                                    "speaker": "五百藏",
                                                    "text": "你们和别的人类不同，对吾等妖狸一族很好，是好人。而且，作为人类也很有能耐。只要跟着你们一起，对吉法师肯定是好的。"
                                                },
                                                {
                                                    "id": "722640632",
                                                    "speaker": "五百藏",
                                                    "text": "所以，就由你们决定吧。"
                                                },
                                                {
                                                    "id": "722640633",
                                                    "speaker": "派蒙",
                                                    "text": "喔，说得很好嘛！放心交给我们吧！我想想…"
                                                },
                                                {
                                                    "id": "722640634",
                                                    "speaker": "「吉法师」",
                                                    "text": "加油！加油！"
                                                },
                                                {
                                                    "id": "722640635",
                                                    "speaker": "派蒙",
                                                    "text": "唔…有什么好地方…有什么好去处呢…",
                                                    "choices": [
                                                        {
                                                            "id": "722640636",
                                                            "text": "慢慢想吧。",
                                                            "response": [
                                                                {
                                                                    "id": "722640638",
                                                                    "speaker": "派蒙",
                                                                    "text": "…嗯，等想到了再说吧！现在肚子好饿，脑子转不动。"
                                                                },
                                                                {
                                                                    "id": "722640639",
                                                                    "speaker": "派蒙",
                                                                    "text": "吉法师就放心交给我们吧！"
                                                                },
                                                                {
                                                                    "id": "722640640",
                                                                    "speaker": "五百藏",
                                                                    "text": "就交给你们了呶。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "722640637",
                                                            "text": "可别想破头了。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "722640625",
                                            "text": "还挺累的。",
                                            "response": [
                                                {
                                                    "id": "722640626",
                                                    "speaker": "派蒙",
                                                    "text": "不过，还挺有趣的！正好也可以一起看看以前曾经去过的地方。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "722640612",
                            "text": "这是相片，是一种「画像」。",
                            "response": [
                                {
                                    "id": "722640613",
                                    "speaker": "派蒙",
                                    "text": "嗯，别担心！你看，吉法师不是好好的嘛。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7226407",
            "objective": "击败「大雪猪王」",
            "dialogues": [
                {
                    "id": "722640701",
                    "speaker": "「吉法师」",
                    "text": "呶！修行开心。",
                    "choices": [
                        {
                            "id": "722640702",
                            "text": "开心就好。",
                            "response": [
                                {
                                    "id": "722640703",
                                    "speaker": "「吉法师」",
                                    "text": "黄毛好强。砰砰，好大好圆就没了。"
                                },
                                {
                                    "id": "722640704",
                                    "speaker": "Player",
                                    "text": "因为平时有在锻炼。"
                                },
                                {
                                    "id": "722640705",
                                    "speaker": "「吉法师」",
                                    "text": "呶！想和黄毛一样强。"
                                },
                                {
                                    "id": "722640706",
                                    "speaker": "「吉法师」",
                                    "text": "所以修行。修行修行，变强变强。"
                                },
                                {
                                    "id": "722640707",
                                    "speaker": "Player",
                                    "text": "吉法师变强了以后，想干什么？"
                                },
                                {
                                    "id": "722640708",
                                    "speaker": "「吉法师」",
                                    "text": "报复刑部小判，呶哈哈。"
                                },
                                {
                                    "id": "722640709",
                                    "speaker": "「吉法师」",
                                    "text": "把五百藏变成不是石头。"
                                },
                                {
                                    "id": "722640710",
                                    "speaker": "Player",
                                    "text": "加油。修行的路线就交给我们吧。"
                                },
                                {
                                    "id": "722640711",
                                    "speaker": "「吉法师」",
                                    "text": "呶！"
                                }
                            ]
                        },
                        {
                            "id": "722640712",
                            "text": "开心就好。回头见。",
                            "response": [
                                {
                                    "id": "722640713",
                                    "speaker": "「吉法师」",
                                    "text": "耶！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7226408",
            "objective": "与吉法师对话",
            "dialogues": []
        },
        {
            "id": "7226409",
            "objective": "前往镇守之森，向五百藏回报",
            "dialogues": []
        }
    ]
}