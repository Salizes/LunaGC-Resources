    "talks": [
        {
            "id": "7468301",
            "objective": "与泽维尔对话",
            "dialogues": [
                {
                    "id": "746830101",
                    "speaker": "泽维尔",
                    "text": "嗨，又见面了！亲爱的大冒险家！",
                    "choices": [
                        {
                            "id": "746830102",
                            "text": "你好，大映影家。",
                            "response": [
                                {
                                    "id": "746830104",
                                    "speaker": "泽维尔",
                                    "text": "最近过得怎么样？"
                                },
                                {
                                    "id": "746830105",
                                    "speaker": "Player",
                                    "text": "最近过得怎么样？"
                                },
                                {
                                    "id": "746830106",
                                    "speaker": "泽维尔",
                                    "text": "哦！几乎异口同声呢，这就是老朋友的默契吧？不过既然是我快了半拍，不如就请你先说说？",
                                    "choices": [
                                        {
                                            "id": "746830107",
                                            "text": "老样子，在给冒险家协会打工。",
                                            "response": [
                                                {
                                                    "id": "746830109",
                                                    "speaker": "泽维尔",
                                                    "text": "#哈哈，还是这么镇定。如果是别人讲这种话，我赌{M#他}{F#她}肯定在吹牛，但如果是你的话，肯定都是真事。"
                                                },
                                                {
                                                    "id": "746830110",
                                                    "speaker": "泽维尔",
                                                    "text": "至于我嘛，也还是老样子：拍完一部映影，就开始为下一部做积累做准备…"
                                                },
                                                {
                                                    "id": "746830111",
                                                    "speaker": "泽维尔",
                                                    "text": "最近我有一个冒险故事的点子：一群本来不相识的人，阴差阳错之后不得不结伴历险，克服一些惊心动魄的障碍…"
                                                },
                                                {
                                                    "id": "746830112",
                                                    "speaker": "泽维尔",
                                                    "text": "嗯，具体让他们经历什么困难我还没想好，但结果不错，他们会成为英雄。至于结局嘛…"
                                                },
                                                {
                                                    "id": "746830113",
                                                    "speaker": "泽维尔",
                                                    "text": "…暂时也还没想好！可能会设计成分道扬镳，也可能结束在下一场冒险的路上。"
                                                },
                                                {
                                                    "id": "746830114",
                                                    "speaker": "泽维尔",
                                                    "text": "除了这个计划之外，我还有几个别的点子。说实话，我感觉自己的点子无穷多，每天晚上睡觉之前，它们就开始在我脑子里乱飞。"
                                                },
                                                {
                                                    "id": "746830115",
                                                    "speaker": "泽维尔",
                                                    "text": "坏处是这会影响睡眠，好处是有这么多点子，我这辈子不愁灵感枯竭。"
                                                },
                                                {
                                                    "id": "746830116",
                                                    "speaker": "Player",
                                                    "text": "听起来准备得挺顺利。"
                                                },
                                                {
                                                    "id": "746830117",
                                                    "speaker": "泽维尔",
                                                    "text": "也不是处处都顺利，比如资金跟赞助…"
                                                },
                                                {
                                                    "id": "746830118",
                                                    "speaker": "泽维尔",
                                                    "text": "有时候我能碰上品味好出手也阔绰的赞助人，有的时候会有千灵映影节这样的好时机，但这种机遇总不常有，那就得靠自己想办法了。"
                                                },
                                                {
                                                    "id": "746830119",
                                                    "speaker": "Player",
                                                    "text": "需要帮忙吗？"
                                                },
                                                {
                                                    "id": "746830120",
                                                    "speaker": "泽维尔",
                                                    "text": "哦？多谢你的关心——不过答案是不，不需要你特意付出什么。"
                                                },
                                                {
                                                    "id": "746830121",
                                                    "speaker": "泽维尔",
                                                    "text": "我还不想利用朋友的好心完成自己的愿望。作为朋友，我只需要你的问候，和时不时的联络。"
                                                },
                                                {
                                                    "id": "746830122",
                                                    "speaker": "泽维尔",
                                                    "text": "我会自己想办法解决资金问题。比方说，我现在就在帮一些赞助商拍摄广告片。报酬不算多，但好在收入稳定。"
                                                },
                                                {
                                                    "id": "746830123",
                                                    "speaker": "Player",
                                                    "text": "广告片？"
                                                },
                                                {
                                                    "id": "746830124",
                                                    "speaker": "泽维尔",
                                                    "text": "嗯，自从映影开始流行之后，就有不少商家和组织也看上了这种新颖的宣传手段。他们会根据自己的需要，找人拟定方案，再拍摄成片。"
                                                },
                                                {
                                                    "id": "746830125",
                                                    "speaker": "泽维尔",
                                                    "text": "比起注重叙事性的映影，广告片更需要在短时间内抓住观众的眼球，所以往往节奏更紧、创意更花。"
                                                },
                                                {
                                                    "id": "746830126",
                                                    "speaker": "泽维尔",
                                                    "text": "哦…还有赞助商的意见也会更多。有时他们的修改意见还会自相矛盾，有的根本没有道理，让人理解不了…"
                                                },
                                                {
                                                    "id": "746830127",
                                                    "speaker": "泽维尔",
                                                    "text": "哈，这话可不能让他们听见。"
                                                },
                                                {
                                                    "id": "746830128",
                                                    "speaker": "Player",
                                                    "text": "听起来很辛苦。"
                                                },
                                                {
                                                    "id": "746830129",
                                                    "speaker": "泽维尔",
                                                    "text": "没关系，为了做到真正想做成的事，总得付出点代价。就像吃海鲜一样，要取到贝里的肉，还得撬开壳呢，这不算什么。"
                                                },
                                                {
                                                    "id": "746830130",
                                                    "speaker": "泽维尔",
                                                    "text": "何况我还遇到过更不讲道理的赞助商，非要我在一部悬疑映影的开头，让硬汉形象的主角喝着他们家的儿童牛奶登场…"
                                                },
                                                {
                                                    "id": "746830131",
                                                    "speaker": "泽维尔",
                                                    "text": "在戏外多拍一些广告，在戏里就能少植入一点…这么一想，拍广告片的活就让人愉悦多啦。"
                                                },
                                                {
                                                    "id": "746830132",
                                                    "speaker": "泽维尔",
                                                    "text": "哦对了，说起来，我还真的有点事情，想问问你感不感兴趣？"
                                                },
                                                {
                                                    "id": "746830133",
                                                    "speaker": "Player",
                                                    "text": "是什么？"
                                                },
                                                {
                                                    "id": "746830134",
                                                    "speaker": "泽维尔",
                                                    "text": "我们有一阵子没一起做点什么了吧？之前我们一起拍了不少东西，效果不错，我记得你也不讨厌拍映影这件事。"
                                                },
                                                {
                                                    "id": "746830135",
                                                    "speaker": "泽维尔",
                                                    "text": "这次要不要一起试试制作广告片？广告和映影不太一样，不过也有它自己的趣味。"
                                                },
                                                {
                                                    "id": "746830136",
                                                    "speaker": "泽维尔",
                                                    "text": "要用到的素材也都已经拍好了，不用再辛苦你跑片场，只需要加入一点点创意性的剪辑…",
                                                    "choices": [
                                                        {
                                                            "id": "746830137",
                                                            "text": "所以这回是后期和剪辑？",
                                                            "response": [
                                                                {
                                                                    "id": "746830139",
                                                                    "speaker": "泽维尔",
                                                                    "text": "嗯，那你有空就来找我吧，不用在意最终成片效果如何，只是很久不见的老拍档一起做点有意思的东西，赞助商那边有我兜底。"
                                                                },
                                                                {
                                                                    "id": "746830140",
                                                                    "speaker": "泽维尔",
                                                                    "text": "何况广告嘛，有趣最要紧，顺着兴头剪一剪，说不定还会意外合适呢！"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "746830138",
                                                            "text": "要问创意你可问对人了！"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "746830108",
                                            "text": "顺便时不时拯救一下世界。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "746830103",
                            "text": "好久不见！泽维尔。"
                        }
                    ]
                }
            ]
        }
    ]
}