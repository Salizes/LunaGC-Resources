    "talks": [
        {
            "id": "7065501",
            "objective": "(test)前置任务判定$HIDDEN",
            "dialogues": [
                {
                    "id": "706550101",
                    "speaker": "利文斯通博士",
                    "text": "又见面了，旅行者。"
                },
                {
                    "id": "706550102",
                    "speaker": "派蒙",
                    "text": "利文斯通小姐的情绪还挺高涨的，最近是发生了什么好事吗？"
                },
                {
                    "id": "706550103",
                    "speaker": "利文斯通博士",
                    "text": "是一件乍看很麻烦，其实很有意思的事情。"
                },
                {
                    "id": "706550104",
                    "speaker": "利文斯通博士",
                    "text": "像你这样充满进取心和智慧，又不乏力量的冒险家，一定也会感兴趣的。",
                    "choices": [
                        {
                            "id": "706550105",
                            "text": "是什么事情呢？",
                            "response": [
                                {
                                    "id": "706550107",
                                    "speaker": "利文斯通博士",
                                    "text": "你还记得之前的<color=#00E1FFFF>好肉族擂台</color>吧？最近好像达达乌帕在围绕着好肉族擂台举行什么无限制战斗的大赛哦。"
                                },
                                {
                                    "id": "706550108",
                                    "speaker": "利文斯通博士",
                                    "text": "之前我不是说过，还要留下来继续研究来着嘛。这个活动弄得整个山谷异常热闹，只要一天还在举办，我的研究就一天没办法有进展。"
                                },
                                {
                                    "id": "706550109",
                                    "speaker": "利文斯通博士",
                                    "text": "不过无限制的强者战斗欸，这不是超级有意思的吗？"
                                },
                                {
                                    "id": "706550110",
                                    "speaker": "派蒙",
                                    "text": "有、有意思？"
                                },
                                {
                                    "id": "706550111",
                                    "speaker": "利文斯通博士",
                                    "text": "诞生在这个大陆上，任谁都曾做过「提瓦特最强」的梦吧？丘丘人它们居然也不例外。"
                                },
                                {
                                    "id": "706550112",
                                    "speaker": "利文斯通博士",
                                    "text": "达达乌帕谷作为丘丘人的圣山之一，全大陆的强者都在前往这里的路上。"
                                },
                                {
                                    "id": "706550113",
                                    "speaker": "Player",
                                    "text": "不至于不至于…"
                                },
                                {
                                    "id": "706550114",
                                    "speaker": "利文斯通博士",
                                    "text": "总之，我觉得你作为征服过<color=#00E1FFFF>好肉族擂台</color>的人，不如再去试试吧？"
                                },
                                {
                                    "id": "706550115",
                                    "speaker": "利文斯通博士",
                                    "text": "如果你能迅速席卷比赛，我的研究就能尽快恢复常态。这不是两全其美吗？"
                                },
                                {
                                    "id": "706550116",
                                    "speaker": "Player",
                                    "text": "我考虑考虑。"
                                },
                                {
                                    "id": "706550117",
                                    "speaker": "利文斯通博士",
                                    "text": "我也会尽我可能为你提供帮助的。向着星辰与深渊。"
                                }
                            ]
                        },
                        {
                            "id": "706550106",
                            "text": "听听也无妨。"
                        }
                    ]
                }
            ]
        },
