    "talks": [
        {
            "id": "1110313",
            "objective": "到达天衡山南部的庙宇",
            "dialogues": []
        },
        {
            "id": "1110314",
            "objective": "与守庙人谈话",
            "dialogues": [
                {
                    "id": "111030101",
                    "speaker": "铜雀",
                    "text": "青山碧水魂飘飘，浮生得闲把扇摇…"
                },
                {
                    "id": "111030102",
                    "speaker": "派蒙",
                    "text": "不好意思，打扰你的雅兴了…"
                },
                {
                    "id": "111030103",
                    "speaker": "Player",
                    "text": "我们想借一下这里的香炉和灯。"
                },
                {
                    "id": "111030104",
                    "speaker": "铜雀",
                    "text": "…这还真是天底下最稀罕的事了。"
                },
                {
                    "id": "111030105",
                    "speaker": "铜雀",
                    "text": "来到庙里不求仙，不拜神，反倒要把香炉都搬走，哈哈哈…"
                },
                {
                    "id": "111030106",
                    "speaker": "派蒙",
                    "text": "我们也知道是很无礼的要求，但真的只借一会儿…"
                },
                {
                    "id": "111030107",
                    "speaker": "铜雀",
                    "text": "是「梦游诸境法」的仪式所用吧？"
                },
                {
                    "id": "111030108",
                    "speaker": "派蒙",
                    "text": "啊…你怎么会知道！"
                },
                {
                    "id": "111030109",
                    "speaker": "铜雀",
                    "text": "我在此庙的时间，绝对远比你们想象得长。"
                },
                {
                    "id": "111030110",
                    "speaker": "铜雀",
                    "text": "可能是心诚所致吧？「仙法」也有幸悟得一二。"
                },
                {
                    "id": "111030111",
                    "speaker": "派蒙",
                    "text": "还有这种事…"
                },
                {
                    "id": "111030112",
                    "speaker": "铜雀",
                    "text": "罢了罢了，你们拿去吧。今天能有机会成人之美，也算一件幸事。"
                },
                {
                    "id": "111030113",
                    "speaker": "铜雀",
                    "text": "…再留在此地，本身也没什么意义了。",
                    "choices": [
                        {
                            "id": "111030114",
                            "text": "你好像有什么心事？",
                            "response": [
                                {
                                    "id": "111030115",
                                    "speaker": "铜雀",
                                    "text": "不必在意我，想要什么就快去取吧。"
                                }
                            ]
                        },
                        {
                            "id": "111030116",
                            "text": "那总之…多谢了！",
                            "response": [
                                {
                                    "id": "111030117",
                                    "speaker": "铜雀",
                                    "text": "没关系，想要什么就快去取吧。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "1110301",
            "objective": "收集仪式所用道具——香炉",
            "dialogues": []
        },
        {
            "id": "1110317",
            "objective": "(test)切香炉$HIDDEN",
            "dialogues": [
                {
                    "id": "111030201",
                    "speaker": "派蒙",
                    "text": "这个香炉…应该没问题吧？"
                },
                {
                    "id": "111030202",
                    "speaker": "派蒙",
                    "text": "至少不像这座庙一样破破烂烂。"
                },
                {
                    "id": "111030203",
                    "speaker": "派蒙",
                    "text": "香炉之后…还要收集附近的「七星灯」，赶快行动吧？"
                }
            ]
        },
        {
            "id": "1110302",
            "objective": "收集仪式所用道具——七星灯",
            "dialogues": []
        },
        {
            "id": "1110303",
            "objective": "回去找铜雀先生",
            "dialogues": [
                {
                    "id": "111030301",
                    "speaker": "派蒙",
                    "text": "咦？怎么没人了，之前明明就在这里的…"
                },
                {
                    "id": "111030302",
                    "speaker": "雕像",
                    "text": "想不到你们还会在意我的去向…本以为你们拿了东西便会走了。"
                },
                {
                    "id": "111030330",
                    "speaker": "派蒙",
                    "text": "啊！…是刚才那位先生的声音！你、你在哪里！？"
                },
                {
                    "id": "111030303",
                    "speaker": "雕像",
                    "text": "我的形体，千年之前就不在了。你们方才见到的，是「浮世留形法」所造的幻影。"
                },
                {
                    "id": "111030304",
                    "speaker": "雕像",
                    "text": "如今你们将「浮世留形法」所用的香炉与七星灯拿去，自然就见不到我了。",
                    "choices": [
                        {
                            "id": "111030305",
                            "text": "你是…",
                            "response": [
                                {
                                    "id": "111030308",
                                    "speaker": "雕像",
                                    "text": "我本是夜叉中的小仙，岩王帝君赐我仙名「铜雀」，数千年前实力不济，战死沙场。"
                                },
                                {
                                    "id": "111030309",
                                    "speaker": "雕像",
                                    "text": "今天是我的忌日，看看今日的璃月是我的遗愿，因而冒昧在此施术。"
                                },
                                {
                                    "id": "111030310",
                                    "speaker": "雕像",
                                    "text": "话说…你们是从「降魔大圣」那里来的吧？"
                                },
                                {
                                    "id": "111030311",
                                    "speaker": "派蒙",
                                    "text": "原来你们之间认识吗？"
                                },
                                {
                                    "id": "111030312",
                                    "speaker": "雕像",
                                    "text": "我能从你们身上感受到他的气息…还有，愈发浓郁的「业障」的气息…"
                                },
                                {
                                    "id": "111030313",
                                    "speaker": "雕像",
                                    "text": "唉…数千年来，他还一直在忍受着那样的痛苦吗…"
                                },
                                {
                                    "id": "111030314",
                                    "speaker": "雕像",
                                    "text": "…真是令我无地自容。"
                                },
                                {
                                    "id": "111030315",
                                    "speaker": "派蒙",
                                    "text": "别这么说，「铜雀」先生不是为了璃月献出了生命吗？"
                                },
                                {
                                    "id": "111030316",
                                    "speaker": "雕像",
                                    "text": "性命虽然珍贵…但比起「降魔大圣」所承受的，死亡不过是一种苟且偷安而已。"
                                },
                                {
                                    "id": "111030317",
                                    "speaker": "派蒙",
                                    "text": "「铜雀」先生…"
                                },
                                {
                                    "id": "111030318",
                                    "speaker": "雕像",
                                    "text": "哈哈，真是不好意思。生日要快乐地度过，但忌日就难免感伤吧。"
                                },
                                {
                                    "id": "111030319",
                                    "speaker": "雕像",
                                    "text": "「浮世留形法」的效力也快散尽了，请二位珍重，替我问候「降魔大圣」…",
                                    "choices": [
                                        {
                                            "id": "111030320",
                                            "text": "一定会的！",
                                            "response": [
                                                {
                                                    "id": "111030322",
                                                    "speaker": "雕像",
                                                    "text": "唉，好想再吃一次正宗的「烤螭虎鱼」呀…"
                                                },
                                                {
                                                    "id": "111030323",
                                                    "speaker": "雕像",
                                                    "text": "「惊涛入海觅螭虎，风雪归山斩妖邪…」"
                                                },
                                                {
                                                    "id": "111030324",
                                                    "speaker": "雕像",
                                                    "text": "……"
                                                },
                                                {
                                                    "id": "111030325",
                                                    "speaker": "派蒙",
                                                    "text": "…已经完全消失了吗，真希望能有人记住这位名叫「铜雀」的夜叉呀。"
                                                },
                                                {
                                                    "id": "111030326",
                                                    "speaker": "派蒙",
                                                    "text": "我们也走吧？等以后有空了，再来上柱香吧。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "111030321",
                                            "text": "「铜雀」先生也请保重…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "111030306",
                            "text": "见、见鬼了？",
                            "response": [
                                {
                                    "id": "111030307",
                                    "speaker": "雕像",
                                    "text": "哈哈哈…这么说也没错。「仙」与「鬼」原本就是一线之隔。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "1110304",
            "objective": "收集仪式所用道具——冰雾花",
            "dialogues": []
        },
        {
            "id": "1110312",
            "objective": "在夜晚前往「夜叉像」处",
            "dialogues": []
        },
        {
            "id": "1110305",
            "objective": "与魈对话",
            "dialogues": [
                {
                    "id": "111030501",
                    "speaker": "魈",
                    "text": "仪式道具已经备齐了么？"
                },
                {
                    "id": "111030502",
                    "speaker": "魈",
                    "text": "这香炉和七星灯的式样很完美，简直像是为仙法特制的…你们从哪里弄来的？"
                },
                {
                    "id": "111030503",
                    "speaker": "Player",
                    "text": "从名叫「铜雀」的夜叉那里…"
                },
                {
                    "id": "111030504",
                    "speaker": "派蒙",
                    "text": "而且「铜雀」先生托我们向你问好！"
                },
                {
                    "id": "111030505",
                    "speaker": "魈",
                    "text": "「铜雀」…"
                },
                {
                    "id": "111030506",
                    "speaker": "魈",
                    "text": "…原来是他啊，确实有他的风格。"
                },
                {
                    "id": "111030507",
                    "speaker": "魈",
                    "text": "果然「铜雀」也放不下璃月吧…但愿璃月今日的光景可以让他放心安息。"
                },
                {
                    "id": "111030508",
                    "speaker": "魈",
                    "text": "那么现在开始仪式的准备吧。"
                },
                {
                    "id": "111030509",
                    "speaker": "魈",
                    "text": "香炉置正中尊位，七星灯散落周围，极寒之物于其间点缀，安排好之后我们再继续。"
                },
                {
                    "id": "111030510",
                    "speaker": "魈",
                    "text": "嗯，如此便可。接下来是「梦游诸境法」的关键…"
                },
                {
                    "id": "111030511",
                    "speaker": "魈",
                    "text": "施术的过程共有四个环节：献香，冥思，施咒，放矢。"
                },
                {
                    "id": "111030512",
                    "speaker": "派蒙",
                    "text": "啊…还要这么麻烦呀？"
                },
                {
                    "id": "111030513",
                    "speaker": "魈",
                    "text": "仙法乃是绝云仙人千年所悟，其中玄奥颇深，切不可轻慢。"
                },
                {
                    "id": "111030514",
                    "speaker": "魈",
                    "text": "否则可能反噬自身，魂魄离体难以复归…"
                },
                {
                    "id": "111030515",
                    "speaker": "派蒙",
                    "text": "对不起，我又说错话了！"
                },
                {
                    "id": "111030516",
                    "speaker": "魈",
                    "text": "「献香」，就是在香炉上香一柱，心怀对岩王帝君的敬畏。"
                },
                {
                    "id": "111030517",
                    "speaker": "魈",
                    "text": "「冥思」，断绝一切杂念，将施术对象的形象在脑中定格。"
                },
                {
                    "id": "111030518",
                    "speaker": "魈",
                    "text": "「施咒」，厉声将咒文念出——「帝婆夜叉，三尸押来」。"
                },
                {
                    "id": "111030519",
                    "speaker": "魈",
                    "text": "「放矢」，对两尊夜叉雕像各射出一箭，作为使役的契约。"
                },
                {
                    "id": "111030520",
                    "speaker": "魈",
                    "text": "没有意外的话，片刻后那人的魂魄便会出现于此。",
                    "choices": [
                        {
                            "id": "111030521",
                            "text": "我知道了。",
                            "response": [
                                {
                                    "id": "111030523",
                                    "speaker": "魈",
                                    "text": "没有疑问的话，就赶快开始吧。"
                                },
                                {
                                    "id": "111030524",
                                    "speaker": "派蒙",
                                    "text": "那总之…先上柱香吧？要心怀对岩王帝君的敬意什么的…"
                                }
                            ]
                        },
                        {
                            "id": "111030522",
                            "text": "（吞口水）"
                        }
                    ]
                }
            ]
        },
        {
