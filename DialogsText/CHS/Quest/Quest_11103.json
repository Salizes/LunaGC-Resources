        {
            "id": "1110315",
            "objective": "依据仪式流程，射击两座夜叉雕像的发光处",
            "dialogues": []
        },
        {
            "id": "1110307",
            "objective": "(test)进行仪式3$HIDDEN",
            "dialogues": [
                {
                    "id": "111030701",
                    "speaker": "派蒙",
                    "text": "已经按照魈说的把仪式完成啦。"
                },
                {
                    "id": "111030702",
                    "speaker": "魈",
                    "text": "……马马虎虎吧。"
                },
                {
                    "id": "111030703",
                    "speaker": "魈",
                    "text": "剩下的交给我，你们做好准备「迎接」他。"
                },
                {
                    "id": "111030704",
                    "speaker": "掇星攫辰天君",
                    "text": "这里是…嗯？你们似乎有些眼熟。"
                },
                {
                    "id": "111030705",
                    "speaker": "掇星攫辰天君",
                    "text": "身体是怎么回事，轻飘飘的感觉不到重量…",
                    "choices": [
                        {
                            "id": "111030706",
                            "text": "是仙法招来了你的魂魄。",
                            "response": [
                                {
                                    "id": "111030707",
                                    "speaker": "掇星攫辰天君",
                                    "text": "…仙法？哈哈哈哈哈，在本仙面前装成仙人，不知天高地厚。"
                                },
                                {
                                    "id": "111030708",
                                    "speaker": "掇星攫辰天君",
                                    "text": "话说此地是何处，本仙明明刚在望舒客栈安安稳稳地睡下…"
                                },
                                {
                                    "id": "111030712",
                                    "speaker": "掇星攫辰天君",
                                    "text": "对了，嗯，原来如此，不愧是本仙哈哈哈…"
                                },
                                {
                                    "id": "111030713",
                                    "speaker": "掇星攫辰天君",
                                    "text": "本仙一定是在做梦！"
                                },
                                {
                                    "id": "111030714",
                                    "speaker": "派蒙",
                                    "text": "嗯…对这个无可救药的人，似乎没法达到预期的效果…",
                                    "choices": [
                                        {
                                            "id": "111030715",
                                            "text": "这不是做梦。",
                                            "response": [
                                                {
                                                    "id": "111030717",
                                                    "speaker": "掇星攫辰天君",
                                                    "text": "哦？你们想怎么样，在本仙的梦里岂能容忍你等歹人放肆？"
                                                },
                                                {
                                                    "id": "111030718",
                                                    "speaker": "派蒙",
                                                    "text": "嗯…动手吧。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "111030716",
                                            "text": "理由是…你会痛！"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "111030709",
                            "text": "因为你已经死了。",
                            "response": [
                                {
                                    "id": "111030710",
                                    "speaker": "掇星攫辰天君",
                                    "text": "死、死死死死了！？"
                                },
                                {
                                    "id": "111030711",
                                    "speaker": "掇星攫辰天君",
                                    "text": "怎么可能，本仙明明刚在望舒客栈安安稳稳地睡下…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "1110308",
            "objective": "惩罚「假仙人」的魂魄",
            "dialogues": []
        },
        {
            "id": "1110309",
            "objective": "(test)战斗后对话$HIDDEN",
            "dialogues": [
                {
                    "id": "111030901",
                    "speaker": "掇星攫辰天君",
                    "text": "快停下…我、我认输！哎哟…",
                    "choices": [
                        {
                            "id": "111030902",
                            "text": "这回你相信了吗？",
                            "response": [
                                {
                                    "id": "111030903",
                                    "speaker": "掇星攫辰天君",
                                    "text": "相信，相信！都要被你们打得魂飞魄散了…"
                                },
                                {
                                    "id": "111030906",
                                    "speaker": "掇星攫辰天君",
                                    "text": "我这是何等的晦气，居然撞上你们这块铁板。"
                                },
                                {
                                    "id": "111030907",
                                    "speaker": "掇星攫辰天君",
                                    "text": "还请两位大仙饶过我，一定不会有下次了…"
                                },
                                {
                                    "id": "111030908",
                                    "speaker": "派蒙",
                                    "text": "我们不是仙人，虽然魂魄是我们招来的，但真正的仙人是这一位。"
                                },
                                {
                                    "id": "111030909",
                                    "speaker": "魈",
                                    "text": "你终日招摇撞骗，冒顶仙名，驱邪而不除，置众生安危于不顾。"
                                },
                                {
                                    "id": "111030910",
                                    "speaker": "魈",
                                    "text": "久之必自食恶果，为妖邪所诱而堕万劫不复。"
                                },
                                {
                                    "id": "111030911",
                                    "speaker": "掇星攫辰天君",
                                    "text": "啊…我…您是…"
                                },
                                {
                                    "id": "111030912",
                                    "speaker": "派蒙",
                                    "text": "他好像被魈的气场吓得不会说话了欸。"
                                },
                                {
                                    "id": "111030913",
                                    "speaker": "掇星攫辰天君",
                                    "text": "敢问…敢问仙名是？",
                                    "choices": [
                                        {
                                            "id": "111030914",
                                            "text": "「降魔大圣」。",
                                            "response": [
                                                {
                                                    "id": "111030916",
                                                    "speaker": "掇星攫辰天君",
                                                    "text": "真的是您！没想到真的是您！居然有生之年可以见到「降魔大圣、护法夜叉」本尊！"
                                                },
                                                {
                                                    "id": "111030917",
                                                    "speaker": "派蒙",
                                                    "text": "你也知道魈的事吗？"
                                                },
                                                {
                                                    "id": "111030918",
                                                    "speaker": "掇星攫辰天君",
                                                    "text": "当然，不如说倒背如流！我爷爷是民俗学者，我从小就是听「降魔大圣」的故事长大的…"
                                                },
                                                {
                                                    "id": "111030919",
                                                    "speaker": "掇星攫辰天君",
                                                    "text": "至今也常常在收集有关夜叉的各类书籍。"
                                                },
                                                {
                                                    "id": "111030920",
                                                    "speaker": "掇星攫辰天君",
                                                    "text": "可是自打从爷爷的遗物里，找到了「百无禁忌箓」…"
                                                },
                                                {
                                                    "id": "111030921",
                                                    "speaker": "掇星攫辰天君",
                                                    "text": "一开始我只是喜欢模仿仙人，装装样子，可后来就在邪路上越走越远了。"
                                                },
                                                {
                                                    "id": "111030922",
                                                    "speaker": "派蒙",
                                                    "text": "还有这种往事…那这么说你是魈的粉丝咯。"
                                                },
                                                {
                                                    "id": "111030923",
                                                    "speaker": "掇星攫辰天君",
                                                    "text": "是，是。感谢二位让我有机会见到「降魔大圣」的真身，简直像真的在做梦一样。"
                                                },
                                                {
                                                    "id": "111030924",
                                                    "speaker": "派蒙",
                                                    "text": "其实我们也没想到这一步啦…"
                                                },
                                                {
                                                    "id": "111030925",
                                                    "speaker": "掇星攫辰天君",
                                                    "text": "今天我就借此机缘，在「降魔大圣」面前立誓…"
                                                },
                                                {
                                                    "id": "111030926",
                                                    "speaker": "掇星攫辰天君",
                                                    "text": "从此一定弃恶扬善、安稳度日，不再败坏仙人的声誉！"
                                                },
                                                {
                                                    "id": "111030927",
                                                    "speaker": "魈",
                                                    "text": "我会记得你的誓言…去吧。"
                                                },
                                                {
                                                    "id": "111030928",
                                                    "speaker": "掇星攫辰天君",
                                                    "text": "谢谢…谢谢您的原谅，还有您为璃月做过的一切…"
                                                },
                                                {
                                                    "id": "111030929",
                                                    "speaker": "派蒙",
                                                    "text": "他最后的誓言，很诚恳呢。应该真的不会再招摇撞骗了吧。"
                                                },
                                                {
                                                    "id": "111030930",
                                                    "speaker": "派蒙",
                                                    "text": "对了，「百无禁忌箓」还没回收，就交给我们吧，明天一早我们就去望舒客栈，找他本人！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "111030915",
                                            "text": "「护法夜叉」。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "111030904",
                            "text": "终于不再自称「本仙」了？",
                            "response": [
                                {
                                    "id": "111030905",
                                    "speaker": "掇星攫辰天君",
                                    "text": "不敢了，不敢了，都要被你们打得魂飞魄散了…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "1110310",
            "objective": "前往望舒客栈，向菲尔戈黛特询问「假仙人」的情况",
            "dialogues": [
                {
                    "id": "111031001",
                    "speaker": "派蒙",
                    "text": "老板，请问「掇星攫辰天君」是住在这里吧？"
                },
                {
                    "id": "111031002",
                    "speaker": "菲尔戈黛特",
                    "text": "「掇星攫辰天君」…你是说那个戴着面具的假仙人吧。"
                },
                {
                    "id": "111031003",
                    "speaker": "菲尔戈黛特",
                    "text": "他在我这里登记的名字是「王平安」哦。",
                    "choices": [
                        {
                            "id": "111031004",
                            "text": "真是普通的名字…",
                            "response": [
                                {
                                    "id": "111031006",
                                    "speaker": "菲尔戈黛特",
                                    "text": "他已经把客房退了，说是要去独自游历山川…"
                                },
                                {
                                    "id": "111031007",
                                    "speaker": "菲尔戈黛特",
                                    "text": "#哦对了，那人还说如果有位带着「会说话的小仙灵」的旅行者来找他，就把这封信给{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}。"
                                },
                                {
                                    "id": "111031008",
                                    "speaker": "派蒙",
                                    "text": "会说话的小仙灵？谁啊？"
                                },
                                {
                                    "id": "111031009",
                                    "speaker": "菲尔戈黛特",
                                    "text": "嗯…他说的旅行者就是你吧。喏，信在这里。"
                                },
                                {
                                    "id": "111031010",
                                    "speaker": "派蒙",
                                    "text": "居然有信留给我们，该不会是什么新的骗术吧？"
                                },
                                {
                                    "id": "111031011",
                                    "speaker": "派蒙",
                                    "text": "赶快先拆开看看吧！我很好奇！"
                                },
                                {
                                    "id": "111031019",
                                    "speaker": "派蒙",
                                    "text": "……"
                                },
                                {
                                    "id": "111031012",
                                    "speaker": "派蒙",
                                    "text": "啊，他好像确实随信附送了一些东西给我们…"
                                },
                                {
                                    "id": "111031013",
                                    "speaker": "派蒙",
                                    "text": "里面还有「百无禁忌箓」！"
                                },
                                {
                                    "id": "111031014",
                                    "speaker": "派蒙",
                                    "text": "真是好久没见过这么识相的坏蛋了…",
                                    "choices": [
                                        {
                                            "id": "111031015",
                                            "text": "令人感动…",
                                            "response": [
                                                {
                                                    "id": "111031017",
                                                    "speaker": "派蒙",
                                                    "text": "是呀…哦，对了，我们快把「百无禁忌箓」给魈送去吧？"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "111031016",
                                            "text": "是魈的功劳。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "111031005",
                            "text": "听起来确实只是个普通人…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1110311",
            "objective": "与魈对话，交还「百无禁忌箓」",
            "dialogues": [
                {
                    "id": "111031101",
                    "speaker": "派蒙",
                    "text": "果然在这里！"
                },
                {
                    "id": "111031102",
                    "speaker": "派蒙",
                    "text": "我们把「百无禁忌箓」回收了，你拿去收好吧？"
                },
                {
                    "id": "111031103",
                    "speaker": "魈",
                    "text": "有劳二位。"
                },
                {
                    "id": "111031104",
                    "speaker": "秀华",
                    "text": "需要点菜吗，这位先生？"
                },
                {
                    "id": "111031105",
                    "speaker": "魈",
                    "text": "一份「烤螭虎鱼」。"
                },
                {
                    "id": "111031106",
                    "speaker": "秀华",
                    "text": "好的，马上给您下厨！"
                },
                {
                    "id": "111031107",
                    "speaker": "派蒙",
                    "text": "嗯？这次居然不是杏仁豆腐，对魈来说太少见了。"
                },
                {
                    "id": "111031108",
                    "speaker": "魈",
                    "text": "这是「铜雀」生前喜欢吃的…"
                },
                {
                    "id": "111031109",
                    "speaker": "魈",
                    "text": "我只是想，尝尝是什么味道。"
                },
                {
                    "id": "111031110",
                    "speaker": "派蒙",
                    "text": "这样啊…"
                },
                {
                    "id": "111031111",
                    "speaker": "魈",
                    "text": "「惊涛入海觅螭虎，风雪归山斩妖邪」…"
                },
                {
                    "id": "111031112",
                    "speaker": "魈",
                    "text": "……"
                },
                {
                    "id": "111031113",
                    "speaker": "魈",
                    "text": "两位还有事么？我比较习惯一个人吃饭。",
                    "choices": [
                        {
                            "id": "111031114",
                            "text": "那就不打扰了…",
                            "response": [
                                {
                                    "id": "111031116",
                                    "speaker": "派蒙",
                                    "text": "嗯，派蒙和旅行者，就这样帅气地，静静离开吧…"
                                }
                            ]
                        },
                        {
                            "id": "111031115",
                            "text": "那么，派蒙…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1110320",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "111032001",
                    "speaker": "铜雀",
                    "text": "不必在意我，想要什么就快去取吧。"
                }
            ]
        }
    ]
}