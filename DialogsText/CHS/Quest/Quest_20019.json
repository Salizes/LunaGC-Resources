    "talks": [
        {
            "id": "2001901",
            "objective": "前往询问怀尔德",
            "dialogues": [
                {
                    "id": "200190101",
                    "speaker": "怀尔德",
                    "text": "旅行者，你，你来的正好。"
                },
                {
                    "id": "200190102",
                    "speaker": "怀尔德",
                    "text": "我本来是要把这车货送去蒙德城。昨天晚上走到这里的时候，看见了几团亮亮的东西。"
                },
                {
                    "id": "200190103",
                    "speaker": "怀尔德",
                    "text": "因为喝的太多，我…我突然很想去看看那是什么，过去了之后，却发现是一大堆史莱姆，我还被狠狠撞了几下。"
                },
                {
                    "id": "200190104",
                    "speaker": "怀尔德",
                    "text": "我很害怕，但是又找不到方向，跑了半天才回到了车旁边。今天早上，我发现我的<color=#00E1FFFF>钥匙</color>不见了…"
                },
                {
                    "id": "200190105",
                    "speaker": "怀尔德",
                    "text": "你能帮我找找吗？肯定就在这周围，我觉得…肯定就在旁边。",
                    "choices": [
                        {
                            "id": "200190106",
                            "text": "好的。",
                            "response": [
                                {
                                    "id": "200190107",
                                    "speaker": "怀尔德",
                                    "text": "太好了，这么大片地方，我都不知道从何下手了。"
                                }
                            ]
                        },
                        {
                            "id": "200190108",
                            "text": "还有别的急事",
                            "response": [
                                {
                                    "id": "200190109",
                                    "speaker": "怀尔德",
                                    "text": "这么大片地方，我可从哪下手啊，这件事只有你能办到，拜托了！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2001903",
            "objective": "用元素视野寻找钥匙",
            "dialogues": []
        },
        {
            "id": "2001904",
            "objective": "把钥匙交给怀尔德",
            "dialogues": [
                {
                    "id": "200190401",
                    "speaker": "怀尔德",
                    "text": "钥匙找到了吗？"
                },
                {
                    "id": "200190402",
                    "speaker": "Player",
                    "text": "这是你丢的钥匙吗？"
                },
                {
                    "id": "200190403",
                    "speaker": "怀尔德",
                    "text": "没错！就是这把，我以后可不能…嗯，以后要喝少点了。"
                },
                {
                    "id": "200190404",
                    "speaker": "怀尔德",
                    "text": "哦，还有，请收下这些吧，谢谢你们帮忙。"
                }
            ]
        },
        {
            "id": "2001902",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "200190201",
                    "speaker": "怀尔德",
                    "text": "你找到钥匙了吗？"
                },
                {
                    "id": "200190202",
                    "speaker": "Player",
                    "text": "抱歉，还没有。"
                },
                {
                    "id": "200190203",
                    "speaker": "怀尔德",
                    "text": "这地方果然还是太大了啊…拜托你了！"
                }
            ]
        }
    ]
