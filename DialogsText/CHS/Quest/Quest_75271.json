    "talks": [
        {
            "id": "7527107",
            "objective": "隐藏保护回滚$HIDDEN",
            "dialogues": [
                {
                    "id": "752710701",
                    "speaker": "Player",
                    "text": "不知道哦，再见。"
                },
                {
                    "id": "752710702",
                    "speaker": "斯奇",
                    "text": "这下麻烦了…"
                }
            ]
        },
        {
            "id": "7527101",
            "objective": "与斯奇交谈$HIDDEN",
            "dialogues": [
                {
                    "id": "752710401",
                    "speaker": "Player",
                    "text": "我来帮你把它们涂成红色吧。"
                },
                {
                    "id": "752710402",
                    "speaker": "斯奇",
                    "text": "真的吗？太感谢你了！好心的朋友！"
                }
            ]
        },
        {
            "id": "7527102",
            "objective": "将气球涂成红色$HIDDEN",
            "dialogues": [
                {
                    "id": "752710201",
                    "speaker": "斯奇",
                    "text": "好心的朋友，遇见你我真是太走运了。请帮我把气球涂成浪漫的红色吧。"
                }
            ]
        },
        {
            "id": "7527103",
            "objective": "与斯奇交谈$HIDDEN",
            "dialogues": [
                {
                    "id": "752710301",
                    "speaker": "斯奇",
                    "text": "浪漫的红气球！真漂亮…我心爱的尤普依一定会喜欢的…"
                },
                {
                    "id": "752710302",
                    "speaker": "斯奇",
                    "text": "你说是吧？朋友。",
                    "choices": [
                        {
                            "id": "752710303",
                            "text": "呃…我不好说。",
                            "response": [
                                {
                                    "id": "752710305",
                                    "speaker": "斯奇",
                                    "text": "不论如何，非常感谢你，朋友，请别离开，我想让尤普依也认识你一下。"
                                },
                                {
                                    "id": "752710306",
                                    "speaker": "斯奇",
                                    "text": "算算时间，她马上就会过来了，我们约好的。"
                                }
                            ]
                        },
                        {
                            "id": "752710304",
                            "text": "当然，她一定会被你打动。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7527105",
            "objective": "见证斯奇的告白仪式$HIDDEN",
            "dialogues": [
                {
                    "id": "752710601",
                    "speaker": "斯奇",
                    "text": "尤普依！你来啦！"
                },
                {
                    "id": "752710602",
                    "speaker": "尤普依",
                    "text": "斯奇…？是你？你怎么穿成这个样子…"
                },
                {
                    "id": "752710603",
                    "speaker": "斯奇",
                    "text": "这是你最喜欢的娜娜丝梨人…我去租来的，帅吗？还有这些气球，也是我专门准备的。"
                },
                {
                    "id": "752710604",
                    "speaker": "斯奇",
                    "text": "其实我有一句话，很早就想跟你说了…和我交往吧！"
                },
                {
                    "id": "752710605",
                    "speaker": "尤普依",
                    "text": "你…你有病吧？"
                },
                {
                    "id": "752710606",
                    "speaker": "斯奇",
                    "text": "不！我心爱的姑娘，尤普依，请和我交往吧！"
                },
                {
                    "id": "752710607",
                    "speaker": "尤普依",
                    "text": "你真的不是脑子坏了吗？今天是我们结婚三周年啊！"
                },
                {
                    "id": "752710608",
                    "speaker": "斯奇",
                    "text": "我当然记得！但…你一直说我不懂浪漫，结婚前连一次正经的告白都没有…所以…这就是我迟到的告白！"
                },
                {
                    "id": "752710609",
                    "speaker": "尤普依",
                    "text": "哈…明白了，我同意了哦。"
                },
                {
                    "id": "752710610",
                    "speaker": "斯奇",
                    "text": "欸？真的吗？"
                },
                {
                    "id": "752710611",
                    "speaker": "尤普依",
                    "text": "我说我同意啦，我浪漫的小男子汉。"
                },
                {
                    "id": "752710612",
                    "speaker": "Black Screen",
                    "text": "悠悠的风儿吹过，将两人拥抱在了一起。"
                }
            ]
        },
        {
            "id": "7527104",
            "objective": "(test)废弃",
            "dialogues": []
        },
        {
            "id": "7527106",
            "objective": "(test)废弃$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7527101",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "752710101",
                    "speaker": "斯奇",
                    "text": "请不要弄坏了这些气球。如果你想玩气球，我可以送你一些别的。"
                },
                {
                    "id": "752710102",
                    "speaker": "Player",
                    "text": "这些气球还挺特别的。"
                },
                {
                    "id": "752710103",
                    "speaker": "斯奇",
                    "text": "说起来还有点不好意思，这是重要的道具。"
                },
                {
                    "id": "752710104",
                    "speaker": "斯奇",
                    "text": "看它的样子，你应该也猜到是用来干什么的吧？",
                    "choices": [
                        {
                            "id": "752710105",
                            "text": "求婚？",
                            "response": [
                                {
                                    "id": "752710106",
                                    "speaker": "斯奇",
                                    "text": "是告白啦。"
                                },
                                {
                                    "id": "752710109",
                                    "speaker": "斯奇",
                                    "text": "我会在浪漫的气球中间向我心爱的尤普依表露心意，你觉得怎么样？"
                                },
                                {
                                    "id": "752710110",
                                    "speaker": "Player",
                                    "text": "应该用红色的气球。"
                                },
                                {
                                    "id": "752710111",
                                    "speaker": "斯奇",
                                    "text": "欸？你说得有道理…我果然还是缺乏了一点浪漫精神吗？"
                                },
                                {
                                    "id": "752710112",
                                    "speaker": "斯奇",
                                    "text": "可尤普依马上就要来了，这时候去哪里找红气球啊？"
                                }
                            ]
                        },
                        {
                            "id": "752710107",
                            "text": "告白？",
                            "response": [
                                {
                                    "id": "752710108",
                                    "speaker": "斯奇",
                                    "text": "没…没错！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7527105",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "752710501",
                    "speaker": "斯奇",
                    "text": "谢谢你，好心的朋友。"
                },
                {
                    "id": "752710502",
                    "speaker": "尤普依",
                    "text": "斯奇给你添麻烦了吧，他的思路跟正常人不太一样，不过这也是我喜欢他的地方。"
                }
            ]
        }
    ]
}