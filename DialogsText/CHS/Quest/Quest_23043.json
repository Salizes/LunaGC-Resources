        {
            "id": "2304309",
            "objective": "向布特罗斯询问情况",
            "dialogues": [
                {
                    "id": "230430901",
                    "speaker": "朱特",
                    "text": "你好，是要选购香料吗？"
                },
                {
                    "id": "230430902",
                    "speaker": "Player",
                    "text": "关于阿扎莱的订单…"
                },
                {
                    "id": "230430903",
                    "speaker": "朱特",
                    "text": "这个数额的货金…我能卖给他的香料数量可能不会太多…不过，这些香料可都是值钱货。"
                },
                {
                    "id": "230430904",
                    "speaker": "朱特",
                    "text": "唔…既然是他的生意，我就多说两句。从朋友的角度来说，我并不太建议他从我这里进货。"
                },
                {
                    "id": "230430905",
                    "speaker": "朱特",
                    "text": "我了解过阿如村的生意市场…我的判断是，在那里卖东西，最好的方式就是「薄利多销」。"
                },
                {
                    "id": "230430906",
                    "speaker": "朱特",
                    "text": "简单来说，就是售卖质量过关，但价格相对低廉的货物，迅速卖出大批量的货物，以此快速回本。"
                },
                {
                    "id": "230430907",
                    "speaker": "朱特",
                    "text": "但是，如果他试图在阿如村售卖质量上好，价格也偏高的货物…可能回本的速度就会很慢了。"
                },
                {
                    "id": "230430908",
                    "speaker": "朱特",
                    "text": "不过，这也就是我的建议而已，具体他要进什么货，还是得看他的判断。",
                    "choices": [
                        {
                            "id": "230430909",
                            "text": "就在你这里进货吧。",
                            "response": [
                                {
                                    "id": "230430910",
                                    "speaker": "朱特",
                                    "text": "好的。我这就去准备货物。"
                                }
                            ]
                        },
                        {
                            "id": "230430911",
                            "text": "我再去别处看看。",
                            "response": [
                                {
                                    "id": "230430912",
                                    "speaker": "朱特",
                                    "text": "没问题，如果你还是想在我这里订货的话，欢迎随时回来。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
