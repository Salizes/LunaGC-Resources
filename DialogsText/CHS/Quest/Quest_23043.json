        {
            "id": "2304306",
            "objective": "",
            "dialogues": [
                {
                    "id": "230430601",
                    "speaker": "拉玛",
                    "text": "怎么样，要在我这里订货吗？",
                    "choices": [
                        {
                            "id": "230430602",
                            "text": "就在你这里订货了。",
                            "response": [
                                {
                                    "id": "230430603",
                                    "speaker": "拉玛",
                                    "text": "谢谢惠顾，等我准备好之后，就雇人把货物运过去。"
                                }
                            ]
                        },
                        {
                            "id": "230430604",
                            "text": "我再去别处看看。",
                            "response": [
                                {
                                    "id": "230430605",
                                    "speaker": "拉玛",
                                    "text": "好吧…你可得看快点啊，可别等到我香料都卖光了还没做好决定。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2304301",
            "objective": "与阿扎莱对话",
            "dialogues": [
                {
                    "id": "230430101",
                    "speaker": "阿扎莱",
                    "text": "还是得拜托里夫帮忙找个人啊…"
                },
                {
                    "id": "230430102",
                    "speaker": "Player",
                    "text": "你怎么愁眉苦脸的…"
                },
                {
                    "id": "230430103",
                    "speaker": "阿扎莱",
                    "text": "旅行者，你是想买什么吗？抱歉，现在店里可能有些缺货…"
                },
                {
                    "id": "230430104",
                    "speaker": "Player",
                    "text": "你就是为这个发愁吗？"
                },
                {
                    "id": "230430105",
                    "speaker": "阿扎莱",
                    "text": "是啊…我们这村子在沙漠里，运送货物本来就很不方便。"
                },
                {
                    "id": "230430106",
                    "speaker": "阿扎莱",
                    "text": "我如果想进货，还得先拜托外出的人帮我去订货，然后再和里夫他们一起把货接进村里。"
                },
                {
                    "id": "230430107",
                    "speaker": "阿扎莱",
                    "text": "这么一来二去的，我做生意的成本蹭蹭地往上涨，为了维持生计，我也只能把这些货物稍微卖贵一些。"
                },
                {
                    "id": "230430108",
                    "speaker": "阿扎莱",
                    "text": "还好村里的人都理解我，也愿意光顾我的生意，不然…我这小店铺，估计早就倒闭了。"
                },
                {
                    "id": "230430109",
                    "speaker": "阿扎莱",
                    "text": "但是…唉，我也不是随时都能找到准备出村的人，里夫他们也不是随时都有空…"
                },
                {
                    "id": "230430110",
                    "speaker": "阿扎莱",
                    "text": "如果运气不好，某些存量少的货物就会断货…",
                    "choices": [
                        {
                            "id": "230430111",
                            "text": "那些货物是…",
                            "response": [
                                {
                                    "id": "230430112",
                                    "speaker": "阿扎莱",
                                    "text": "都是一些和日常用度有关的货物，这些东西我进得虽然不慢，但卖得更快啊。"
                                },
                                {
                                    "id": "230430113",
                                    "speaker": "阿扎莱",
                                    "text": "我这里本来就是小本生意，也不可能经常大批量进货…"
                                },
                                {
                                    "id": "230430117",
                                    "speaker": "阿扎莱",
                                    "text": "咳，先不说这些。旅行者，你是准备出村子去吧？"
                                },
                                {
                                    "id": "230430118",
                                    "speaker": "阿扎莱",
                                    "text": "我最近想要进一批香料，需要有人帮我去下订单…你能帮我这个忙吗？",
                                    "choices": [
                                        {
                                            "id": "230430119",
                                            "text": "交给我吧。",
                                            "response": [
                                                {
                                                    "id": "230430122",
                                                    "speaker": "阿扎莱",
                                                    "text": "我想想…<color=#00E1FFFF>拉玛</color>卖的香料价钱很公道，质量也…还算过得去。"
                                                },
                                                {
                                                    "id": "230430123",
                                                    "speaker": "阿扎莱",
                                                    "text": "<color=#00E1FFFF>朱特</color>好像进了一批新型香料，质量很不错。我想要进一些回来试着卖卖看，但就是不知道价格怎么样…"
                                                },
                                                {
                                                    "id": "230430124",
                                                    "speaker": "阿扎莱",
                                                    "text": "但我这次用来进货的钱就只有这么一些，也不知道到底从哪家进货最合适…"
                                                },
                                                {
                                                    "id": "230430125",
                                                    "speaker": "阿扎莱",
                                                    "text": "旅行者，请你帮我去看看这两家售卖香料的情况，再帮我找一家订货吧。"
                                                },
                                                {
                                                    "id": "230430126",
                                                    "speaker": "阿扎莱",
                                                    "text": "哦对了，之前托人订货的时候，我会拜托他们帮我订一些价格相对便宜的货。"
                                                },
                                                {
                                                    "id": "230430127",
                                                    "speaker": "阿扎莱",
                                                    "text": "你帮我订货的时候，记得也帮我找一家货物相对便宜的店下订单啊。"
                                                },
                                                {
                                                    "id": "230430128",
                                                    "speaker": "阿扎莱",
                                                    "text": "在阿如村做生意嘛，还是保持着「薄利多销」的原则比较好啊。",
                                                    "choices": [
                                                        {
                                                            "id": "230430129",
                                                            "text": "我先去<color=#00E1FFFF>拉玛</color>那边看看…",
                                                            "response": [
                                                                {
                                                                    "id": "230430131",
                                                                    "speaker": "阿扎莱",
                                                                    "text": "谢谢你愿意帮忙，我把她的所在位置给你标在地图上。"
                                                                },
                                                                {
                                                                    "id": "230430133",
                                                                    "speaker": "阿扎莱",
                                                                    "text": "那就拜托了，如果你有什么问题的话，随时都可以回来问我。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "230430130",
                                                            "text": "我先去<color=#00E1FFFF>朱特</color>那边看看…",
                                                            "response": [
                                                                {
                                                                    "id": "230430132",
                                                                    "speaker": "阿扎莱",
                                                                    "text": "谢谢你愿意帮忙，我把他的所在位置给你标在地图上。"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "230430120",
                                            "text": "店里的香料断货了？",
                                            "response": [
                                                {
                                                    "id": "230430121",
                                                    "speaker": "阿扎莱",
                                                    "text": "断货倒是谈不上…但这种销量大的货物，多备点总是好的。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "230430114",
                            "text": "如果能找个长期伙伴…",
                            "response": [
                                {
                                    "id": "230430115",
                                    "speaker": "阿扎莱",
                                    "text": "哈哈哈…我也想过，但你看看周围。"
                                },
                                {
                                    "id": "230430116",
                                    "speaker": "阿扎莱",
                                    "text": "往这个村子里运货做生意，可不是一件容易的事啊。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
