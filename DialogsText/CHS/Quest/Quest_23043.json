        {
            "id": "2304305",
            "objective": "向阿扎莱回报",
            "dialogues": [
                {
                    "id": "230430501",
                    "speaker": "拉玛",
                    "text": "欢迎光临！要买些常用的香料吗？价格很实惠哦！"
                },
                {
                    "id": "230430502",
                    "speaker": "Player",
                    "text": "关于阿扎莱的订单…"
                },
                {
                    "id": "230430503",
                    "speaker": "拉玛",
                    "text": "欸？阿扎莱拜托你来订货吗？倒是没问题…"
                },
                {
                    "id": "230430504",
                    "speaker": "拉玛",
                    "text": "不过之前他都是拜托镀金旅团的人把货款带来，这次怎么拜托了一个冒险家…"
                },
                {
                    "id": "230430505",
                    "speaker": "拉玛",
                    "text": "咳！这次他有多少货金？我看看…嚯，不少啊。"
                },
                {
                    "id": "230430506",
                    "speaker": "拉玛",
                    "text": "唔，如果在我这里进香料的话，我给他提供的货，应该能足够他卖很长时间了。"
                },
                {
                    "id": "230430507",
                    "speaker": "拉玛",
                    "text": "至于售价嘛…我还是建议和之前一样定的稍微低一些。这样才容易卖出去嘛。",
                    "choices": [
                        {
                            "id": "230430508",
                            "text": "就在你这里订货了。",
                            "response": [
                                {
                                    "id": "230430509",
                                    "speaker": "拉玛",
                                    "text": "喔！谢谢惠顾，等我准备好之后，就雇人把货物运过去。"
