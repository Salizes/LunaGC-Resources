        {
            "id": "2304316",
            "objective": "向阿扎莱回报",
            "dialogues": [
                {
                    "id": "230431303",
                    "speaker": "Black Screen",
                    "text": "向阿扎莱讲述了订货的经过…"
                },
                {
                    "id": "230431304",
                    "speaker": "阿扎莱",
                    "text": "唔…在拉玛的店订的啊，应该没什么问题。"
                },
                {
                    "id": "230431305",
                    "speaker": "阿扎莱",
                    "text": "她的香料既便宜又好用，很受村里人的欢迎。货来了之后肯定不愁销路。"
                },
                {
                    "id": "230431306",
                    "speaker": "阿扎莱",
                    "text": "多谢你帮忙了，旅行者，这些报酬是给你的…还有这些摩拉，也请一起收下吧。"
                },
                {
                    "id": "230431307",
                    "speaker": "阿扎莱",
                    "text": "不过拉玛这家伙，我都订了这么多次了，她也没有给我打打折…"
                }
            ]
        },
        {
            "id": "2304307",
            "objective": "与阿扎莱对话",
            "dialogues": [
                {
                    "id": "230430701",
                    "speaker": "布特罗斯",
                    "text": "欢迎！你是想买鱼吗？那你可来对地方了，我的鱼可是最新鲜的，不信你问问旁边的猫…"
                },
                {
                    "id": "230430702",
                    "speaker": "Player",
                    "text": "关于阿扎莱的订单…"
