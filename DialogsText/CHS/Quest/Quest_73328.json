    "talks": [
        {
            "id": "7332801",
            "objective": "",
            "dialogues": [
                {
                    "id": "733280101",
                    "speaker": "派蒙",
                    "text": "是你，婕德——！"
                },
                {
                    "id": "733280102",
                    "speaker": "婕德",
                    "text": "#{NICKNAME}？！还有小派蒙！！"
                },
                {
                    "id": "733280103",
                    "speaker": "奔奔",
                    "text": "哔哔——！"
                },
                {
                    "id": "733280104",
                    "speaker": "婕德",
                    "text": "哈哈，我说什么来着！我们又见面了！"
                },
                {
                    "id": "733280105",
                    "speaker": "Player",
                    "text": "你在这里做什么呢？"
                },
                {
                    "id": "733280106",
                    "speaker": "婕德",
                    "text": "嗯…成熟女人的小秘密？"
                },
                {
                    "id": "733280107",
                    "speaker": "派蒙",
                    "text": "？"
                },
                {
                    "id": "733280108",
                    "speaker": "婕德",
                    "text": "#{M#意思就是不要打听啦！我也是有隐私的…}{F#去找一家居酒屋，想办法让我开心，我说不定会告诉你…还要我教你吗？}"
                },
                {
                    "id": "733280109",
                    "speaker": "婕德",
                    "text": "#{M#噗…是镖局的规定，我也不能说，抱歉啦。}{F#开、开玩笑啦，别当真呀！是镖局的规定…这一趟货要严格保密，抱歉啦。}"
                },
                {
                    "id": "733280110",
                    "speaker": "派蒙",
                    "text": "哼，神神秘秘的！"
                },
                {
                    "id": "733280111",
                    "speaker": "婕德",
                    "text": "所以…最近过得怎么样？",
                    "choices": [
                        {
                            "id": "733280112",
                            "text": "还不错。",
                            "response": [
                                {
                                    "id": "733280114",
                                    "speaker": "婕德",
                                    "text": "嗯…我也是。"
                                },
                                {
                                    "id": "733280115",
                                    "speaker": "婕德",
                                    "text": "好啦，我不多留你了。唉…还有自己的事情要做。"
                                },
                                {
                                    "id": "733280116",
                                    "speaker": "派蒙",
                                    "text": "欸，婕德这么忙的吗…以前也不是这样子呀？"
                                },
                                {
                                    "id": "733280117",
                                    "speaker": "婕德",
                                    "text": "噗…这不是找到了「稳定」的工作了嘛，虽然工作内容和以前差不太多。"
                                },
                                {
                                    "id": "733280118",
                                    "speaker": "婕德",
                                    "text": "在镖局找到了工作没多久，就又开始怀念以前无拘无束的日子了…"
                                },
                                {
                                    "id": "733280119",
                                    "speaker": "婕德",
                                    "text": "虽然不知道你那边情况如何，但我一直在期待着你的故事，我也有很多故事要和你讲呢…"
                                },
                                {
                                    "id": "733280120",
                                    "speaker": "婕德",
                                    "text": "不过现在不着急啦，现在不着急…好的故事要多多积存，多多发酵嘛，曾经在沙漠里，旅人是要靠它来活命的！嘿嘿。"
                                },
                                {
                                    "id": "733280121",
                                    "speaker": "婕德",
                                    "text": "嗯…总之，请你保重。"
                                },
                                {
                                    "id": "733280122",
                                    "speaker": "Player",
                                    "text": "你也保重。"
                                },
                                {
                                    "id": "733280123",
                                    "speaker": "婕德",
                                    "text": "嗯，一千个拥抱，我会一直为你祈祷的。"
                                },
                                {
                                    "id": "733280124",
                                    "speaker": "奔奔",
                                    "text": "哔哔！"
                                },
                                {
                                    "id": "733280125",
                                    "speaker": "婕德",
                                    "text": "哈哈，奔奔也一样！"
                                }
                            ]
                        },
                        {
                            "id": "733280113",
                            "text": "一般般…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7332802",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "733280201",
                    "speaker": "婕德",
                    "text": "给你一千个拥抱！期待下次再见！",
                    "choices": [
                        {
                            "id": "733280202",
                            "text": "下次我会在哪里见到你呢？",
                            "response": [
                                {
                                    "id": "733280203",
                                    "speaker": "婕德",
                                    "text": "谁知道呢？天空岛？"
                                },
                                {
                                    "id": "733280204",
                                    "speaker": "婕德",
                                    "text": "哈哈哈哈哈，开玩笑的！不过如果你想要在那里看到我，我也一定会在那里的。"
                                },
                                {
                                    "id": "733280205",
                                    "speaker": "婕德",
                                    "text": "不要问为什么，我就是知道。"
                                },
                                {
                                    "id": "733280208",
                                    "speaker": "婕德",
                                    "text": "总之，期待下一次的相见吧！"
                                }
                            ]
                        },
                        {
                            "id": "733280206",
                            "text": "也给你一千个拥抱。",
                            "response": [
                                {
                                    "id": "733280207",
                                    "speaker": "婕德",
                                    "text": "哈哈，谢啦！"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
