    "talks": [
        {
            "id": "2303601",
            "objective": "与荷贝特和凯万对话",
            "dialogues": [
                {
                    "id": "230360201",
                    "speaker": "Player",
                    "text": "这次需要什么材料？"
                },
                {
                    "id": "230360202",
                    "speaker": "凯万",
                    "text": "我想想，这次的鱼饵就用帕蒂沙兰吧。"
                },
                {
                    "id": "230360203",
                    "speaker": "凯万",
                    "text": "普通的帕蒂沙兰就足够了。"
                }
            ]
        },
        {
            "id": "2303602",
            "objective": "将鱼饵的材料交给凯万",
            "dialogues": []
        },
        {
            "id": "2303603",
            "objective": "与荷贝特和凯万对话",
            "dialogues": [
                {
                    "id": "230360601",
                    "speaker": "凯万",
                    "text": "很不错，接下来我就要下竿了，这次一定能钓上大鱼！"
                },
                {
                    "id": "230360602",
                    "speaker": "Black Screen",
                    "text": "凯万制作了鱼饵，开始垂钓…"
                },
                {
                    "id": "230360603",
                    "speaker": "Black Screen",
                    "text": "不久后，凯万钓到了一个湿漉漉的盒子…"
                },
                {
                    "id": "230360604",
                    "speaker": "荷贝特",
                    "text": "这个…我来看看…"
                },
                {
                    "id": "230360605",
                    "speaker": "荷贝特",
                    "text": "咦？里面的东西…好像又是失物之类的东西呢…",
                    "choices": [
                        {
                            "id": "230360606",
                            "text": "不愧是你。",
                            "response": [
                                {
                                    "id": "230360608",
                                    "speaker": "荷贝特",
                                    "text": "唔…自从上次陪着凯万先生去找那位学者改进鱼饵后，我们一直在外垂钓…"
                                },
                                {
                                    "id": "230360609",
                                    "speaker": "荷贝特",
                                    "text": "但每次垂钓…凯万先生还是一直钓起奇奇怪怪的东西。"
                                },
                                {
                                    "id": "230360610",
                                    "speaker": "荷贝特",
                                    "text": "其中包括人的失物，河底的矿石，掉下船的包裹…"
                                },
                                {
                                    "id": "230360611",
                                    "speaker": "荷贝特",
                                    "text": "甚至还有一个不慎落水的冒险家抓着凯万先生的钓线爬上了岸…"
                                },
                                {
                                    "id": "230360612",
                                    "speaker": "荷贝特",
                                    "text": "但是，我们就是没法钓起任何一条鱼…"
                                },
                                {
                                    "id": "230360613",
                                    "speaker": "凯万",
                                    "text": "我的钓鱼生涯，已经彻底走到尽头了…"
                                },
                                {
                                    "id": "230360614",
                                    "speaker": "荷贝特",
                                    "text": "凯，凯万先生！不要这么沮丧呀，你…你看，这东西的失主肯定很着急。"
                                },
                                {
                                    "id": "230360615",
                                    "speaker": "荷贝特",
                                    "text": "你能把这失物钓上来，他一定会很高兴的。"
                                },
                                {
                                    "id": "230360616",
                                    "speaker": "荷贝特",
                                    "text": "我们把这些失物拿回去给冒险家协会，说不定还能拿到点报酬呢！"
                                },
                                {
                                    "id": "230360617",
                                    "speaker": "凯万",
                                    "text": "但是！我真的！只是想要——"
                                },
                                {
                                    "id": "230360618",
                                    "speaker": "凯万",
                                    "text": "钓上一条鱼啊！"
                                }
                            ]
                        },
                        {
                            "id": "230360607",
                            "text": "「又」？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "2303604",
            "objective": "采集3份新鲜的香辛果",
            "dialogues": [
                {
                    "id": "230360401",
                    "speaker": "Player",
                    "text": "这次需要什么材料？"
                },
                {
                    "id": "230360402",
                    "speaker": "凯万",
                    "text": "我想想，这次的鱼饵需要用到…呃…特别的甜甜花。"
                },
                {
                    "id": "230360403",
                    "speaker": "凯万",
                    "text": "有个地方的甜甜花很不错，我给你们把地点标上…"
                }
            ]
        },
        {
            "id": "2303605",
            "objective": "将鱼饵的材料交给凯万",
            "dialogues": [
                {
                    "id": "230360501",
                    "speaker": "凯万",
                    "text": "这次我所制作的鱼饵需要日落果，小麦和帕蒂沙兰，你找到这些材料了吗？"
                }
            ]
        },
        {
            "id": "2303606",
            "objective": "与荷贝特和凯万对话",
            "dialogues": []
        },
        {
            "id": "2303607",
            "objective": "寻找鱼饵材料",
            "dialogues": [
                {
                    "id": "230360701",
                    "speaker": "凯万",
                    "text": "这次我所制作的鱼饵需要日落果，小麦和新鲜的香辛果，你找到这些材料了吗？"
                }
            ]
        },
        {
            "id": "2303608",
            "objective": "将鱼饵的材料交给凯万",
            "dialogues": []
        },
        {
            "id": "2303609",
            "objective": "与荷贝特和凯万对话",
            "dialogues": []
        },
        {
            "id": "2303601",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "230360101",
                    "speaker": "荷贝特",
                    "text": "凯万先生，你就再用新型的鱼饵试试吧。"
                },
                {
                    "id": "230360102",
                    "speaker": "凯万",
                    "text": "我都试了多少次了，完全和之前一样嘛！"
                },
                {
                    "id": "230360103",
                    "speaker": "派蒙",
                    "text": "咦？你们两个怎么又在一起钓鱼了？"
                },
                {
                    "id": "230360104",
                    "speaker": "凯万",
                    "text": "旅行者，又见面了。"
                },
                {
                    "id": "230360105",
                    "speaker": "荷贝特",
                    "text": "两位，你们好啊。",
                    "choices": [
                        {
                            "id": "230360106",
                            "text": "你找到钓不上鱼的原因了吗？",
                            "response": [
                                {
                                    "id": "230360108",
                                    "speaker": "凯万",
                                    "text": "哈哈，完全没有。我和那位学者先生尝试了改进鱼竿，改进鱼饵，改进手法各种方式。"
                                },
                                {
                                    "id": "230360109",
                                    "speaker": "凯万",
                                    "text": "还换了不知道多少个水域，多少个角度…甚至还让我在一个全都是鱼的鱼池里下竿。"
                                },
                                {
                                    "id": "230360110",
                                    "speaker": "凯万",
                                    "text": "但我无论如何，都只能钓起来那些不是鱼的东西。"
                                },
                                {
                                    "id": "230360111",
                                    "speaker": "荷贝特",
                                    "text": "放心啦，凯万先生，那位学者不也承诺会继续研究下去吗？他一定会帮你找到原因的。"
                                },
                                {
                                    "id": "230360112",
                                    "speaker": "荷贝特",
                                    "text": "你看，他都给你设计了新型鱼饵，还让我一直陪在你身边，记录你钓鱼的各种细节…"
                                },
                                {
                                    "id": "230360113",
                                    "speaker": "凯万",
                                    "text": "希望他真的能找到吧…但在那之前，我还是按照自己的方法来钓鱼好了。"
                                },
                                {
                                    "id": "230360114",
                                    "speaker": "凯万",
                                    "text": "旅行者，如果你有空的话，就再帮我去找点鱼饵材料吧。"
                                }
                            ]
                        },
                        {
                            "id": "230360107",
                            "text": "去向学者请教后有收获了吗？"
                        }
                    ]
                }
            ]
        },
