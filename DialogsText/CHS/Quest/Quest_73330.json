        },
        {
            "id": "7333007",
            "objective": "与愚人众长官对话",
            "dialogues": [
                {
                    "id": "733300701",
                    "speaker": "斯露莎",
                    "text": "喂，心怀不轨的人类，劝你们尽快离开此地。吾辈花灵的传承与隐秘可不是尔等可以轻易触达的东西。"
                },
                {
                    "id": "733300702",
                    "speaker": "马尔科佐夫",
                    "text": "花灵？花灵！多么新奇的体验啊！"
                },
                {
                    "id": "733300703",
                    "speaker": "马尔科佐夫",
                    "text": "#哦！还有{M#精干的少年}{F#小小的女士}和{M#他的}{F#她的}…宠物？"
                },
                {
                    "id": "733300704",
                    "speaker": "派蒙",
                    "text": "#哇！你这家伙也太失礼了！我可是{M#他}{F#她}最好的伙伴！"
                },
                {
                    "id": "733300705",
                    "speaker": "马尔科佐夫",
                    "text": "伙伴…当然，当然！最好的伙伴，多么动听的词汇！我从孩提时代起就盼望着能有这样一个「最好的伙伴」…"
                },
                {
                    "id": "733300706",
                    "speaker": "马尔科佐夫",
                    "text": "#{M#精干的少年}{F#小小的女士}，您应该不需要两个「最好的伙伴」吧？",
                    "choices": [
                        {
                            "id": "733300707",
                            "text": "什么意思…",
                            "response": [
                                {
                                    "id": "733300710",
                                    "speaker": "马尔科佐夫",
                                    "text": "我的意思是…太奢侈了！即便是对您来说。"
                                },
                                {
                                    "id": "733300711",
                                    "speaker": "马尔科佐夫",
                                    "text": "我无法原谅这样的不公…所以恳请您，将花灵交给我。关于花灵的待遇，您大可放心，我一定会物尽其用。"
                                },
                                {
                                    "id": "733300712",
                                    "speaker": "斯露莎",
                                    "text": "无礼的家伙…"
                                },
                                {
                                    "id": "733300713",
                                    "speaker": "派蒙",
                                    "text": "这也太不讲道理了，根本没办法沟通嘛！"
                                },
                                {
                                    "id": "733300714",
                                    "speaker": "斯露莎",
                                    "text": "这世上有比语言更通行的道理…吾之「谒颂主」，聪慧如你，应该明白我的意思吧？"
                                },
                                {
                                    "id": "733300715",
                                    "speaker": "派蒙",
                                    "text": "我猜斯露莎是说，给他点颜色瞧瞧！"
                                },
                                {
                                    "id": "733300716",
                                    "speaker": "斯露莎",
                                    "text": "哼，不用白飘飘多话！"
                                }
                            ]
                        },
                        {
                            "id": "733300708",
                            "text": "倒是不介意有更多伙伴。",
                            "response": [
                                {
                                    "id": "733300709",
                                    "speaker": "派蒙",
                                    "text": "那怎么行！不行不行，「最好的」伙伴只能是派蒙！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
