    "talks": [
        {
            "id": "7269901",
            "objective": "与安彦太郎对话",
            "dialogues": [
                {
                    "id": "726990101",
                    "speaker": "安彦太郎",
                    "text": "不知阁下的剑技到底水平如何，这一战我非常期待。"
                },
                {
                    "id": "726990102",
                    "speaker": "Player",
                    "text": "你怎么也…"
                },
                {
                    "id": "726990103",
                    "speaker": "安彦太郎",
                    "text": "其实，我之前说有四位武者，是把自己也算在其中了。"
                },
                {
                    "id": "726990104",
                    "speaker": "安彦太郎",
                    "text": "虽说我是这场决斗的主办人，但无奈参与者实在太少…"
                },
                {
                    "id": "726990105",
                    "speaker": "安彦太郎",
                    "text": "更何况，此身为战斗而生，既然遇到了强大的对手，就没有不与对方一战的道理！"
                },
                {
                    "id": "726990106",
                    "speaker": "安彦太郎",
                    "text": "哈哈，我想说这句台词很久了！"
                },
                {
                    "id": "726990107",
                    "speaker": "派蒙",
                    "text": "喂，这人到底行不行啊！"
                },
                {
                    "id": "726990108",
                    "speaker": "Player",
                    "text": "不能轻敌。"
                },
                {
                    "id": "726990109",
                    "speaker": "安彦太郎",
                    "text": "说得好！阁下这种对所有对手一视同仁的态度，让我肃然起敬。"
                },
                {
                    "id": "726990110",
                    "speaker": "安彦太郎",
                    "text": "之前，如果不是因为我以貌取人，看轻了第四位武者，那场战斗也不会输得那么惨。"
                },
                {
                    "id": "726990111",
                    "speaker": "安彦太郎",
                    "text": "#不过现在，我已经不是当时的我了！那么，{NICKNAME}，开始比试吧！",
                    "choices": [
                        {
                            "id": "726990114",
                            "text": "来吧。",
                            "response": [
                                {
                                    "id": "726990115",
                                    "speaker": "安彦太郎",
                                    "text": "来吧。"
                                }
                            ]
                        },
                        {
                            "id": "726990112",
                            "text": "等等，让我准备一下。",
                            "response": [
                                {
                                    "id": "726990113",
                                    "speaker": "安彦太郎",
                                    "text": "我明白了，阁下先准备就是。"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}