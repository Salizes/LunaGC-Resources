    "talks": [
        {
            "id": "7720205",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "772020101",
                    "speaker": "派蒙",
                    "text": "唔，帐篷里没有人，不过也没有太多的积雪…"
                },
                {
                    "id": "772020102",
                    "speaker": "派蒙",
                    "text": "什么人会到这里来呢…真是奇怪。"
                },
                {
                    "id": "772020103",
                    "speaker": "派蒙",
                    "text": "这个是什么，冒险手记吗…"
                },
                {
                    "id": "772020104",
                    "speaker": "派蒙",
                    "text": "「风雪就像面具一样扣在了脸上，眼睛都睁不开，根本找不到路，别说是去赫斯珀利德斯之馆，回家的路也…」"
                },
                {
                    "id": "772020105",
                    "speaker": "派蒙",
                    "text": "「还好，找到了能够躲避风雪的山洞，可食物已经见底…也许一开始就不该…不行，这一定是对我的考验。」"
                },
                {
                    "id": "772020106",
                    "speaker": "派蒙",
                    "text": "「我一定要到公馆，去见见那位大人…去见识见识真正的臻冰技艺。」"
                },
                {
                    "id": "772020107",
                    "speaker": "派蒙",
                    "text": "「可是该怎么出去呢…也许，可以顺着这个山洞往前再探探…」"
                },
                {
                    "id": "772020108",
                    "speaker": "派蒙",
                    "text": "「唔，好像已经适应这份温度，周围都开始变得暖和一点了。」"
                },
                {
                    "id": "772020109",
                    "speaker": "派蒙",
                    "text": "哇，这个人没事吧，感觉都已经快冻出幻觉了。",
                    "choices": [
                        {
                            "id": "772020110",
                            "text": "他这不是暖和起来了嘛。",
                            "response": [
                                {
                                    "id": "772020111",
                                    "speaker": "派蒙",
                                    "text": "在冰天雪地里觉得暖和才是最可怕的！"
                                },
                                {
                                    "id": "772020114",
                                    "speaker": "派蒙",
                                    "text": "他留下的手记里说，他顺着山洞往前…我们也往前看看吧，不知道他还有没有救…"
                                }
                            ]
                        },
                        {
                            "id": "772020112",
                            "text": "看上去确实有点严重…",
                            "response": [
                                {
                                    "id": "772020113",
                                    "speaker": "派蒙",
                                    "text": "是啊…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7720206",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7720201",
            "objective": "在洞穴探索",
            "dialogues": []
        },
        {
            "id": "7720202",
            "objective": "救助冰窟中的人",
            "dialogues": [
                {
                    "id": "772020201",
                    "speaker": "派蒙",
                    "text": "还好，没有直接落进水里…"
                },
                {
                    "id": "772020202",
                    "speaker": "？？？",
                    "text": "小、小心….这块冰开始动起来了…"
                },
                {
                    "id": "772020203",
                    "speaker": "派蒙",
                    "text": "不用担心，我们会把你带出去的。"
                }
            ]
        },
        {
            "id": "7720203",
            "objective": "在冰河上漂流直至靠岸",
            "dialogues": [
                {
