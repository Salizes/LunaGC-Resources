        {
            "id": "7720207",
            "objective": "(test)废弃",
            "dialogues": []
        },
        {
            "id": "7720204",
            "objective": "和马尔托斯对话",
            "dialogues": [
                {
                    "id": "772020401",
                    "speaker": "？？？",
                    "text": "呼、呼…吓死了…要是掉进水里，那真的要…小命不保。"
                },
                {
                    "id": "772020402",
                    "speaker": "？？？",
                    "text": "感谢两位，我…我叫马尔托斯…抱歉…"
                },
                {
                    "id": "772020403",
                    "speaker": "派蒙",
                    "text": "为什么要抱歉？"
                },
                {
                    "id": "772020404",
                    "speaker": "马尔托斯",
                    "text": "…我本来想提醒二位那块冰不太坚固，可是，在那上面，不知道为什么，说不出话来。"
                },
                {
                    "id": "772020405",
                    "speaker": "派蒙",
                    "text": "一定是因为那时候你身子太过虚弱…不过，现在好些了吗？"
                },
                {
                    "id": "772020406",
                    "speaker": "马尔托斯",
                    "text": "现在好些了，多谢二位…呼…还不知道，两位恩人的名字是…"
                },
                {
                    "id": "772020407",
                    "speaker": "Black Screen",
                    "text": "向马尔托斯作了自我介绍。"
                },
                {
                    "id": "772020408",
                    "speaker": "马尔托斯",
                    "text": "#{NICKNAME}和派蒙，原来如此。"
                },
                {
                    "id": "772020409",
                    "speaker": "派蒙",
                    "text": "…不过马尔托斯，你到这里来，是为了什么呀。冰天雪地的…"
                },
                {
                    "id": "772020410",
                    "speaker": "马尔托斯",
                    "text": "臻冰雕塑，我是来学习臻冰雕塑的…"
                },
                {
                    "id": "772020411",
                    "speaker": "派蒙",
                    "text": "臻冰雕塑？"
                },
                {
                    "id": "772020412",
                    "speaker": "马尔托斯",
                    "text": "对！咳咳…我本来是想去赫斯珀利德斯之馆，馆的主人是精通臻冰技艺的雪精的王公…"
                },
                {
                    "id": "772020413",
                    "speaker": "马尔托斯",
                    "text": "许多佳作都出自她手，就连至冬宫广场中心的雪花，新基捷王公府前仿晶矿的雕塑，都是她的作品…"
                },
                {
                    "id": "772020414",
                    "speaker": "马尔托斯",
                    "text": "人类虽然无法如妖精那般驱使臻冰…但是亦可用锤与凿雕琢出同样的美。"
                },
                {
                    "id": "772020415",
                    "speaker": "马尔托斯",
                    "text": "感谢二位的帮忙，我离公馆又更近一步啦！"
                },
                {
                    "id": "772020416",
                    "speaker": "派蒙",
                    "text": "啊，你还要去山上的公馆啊！"
                },
                {
                    "id": "772020417",
                    "speaker": "马尔托斯",
                    "text": "都到了这步，回头反而会不太甘心呐…"
                },
                {
                    "id": "772020418",
                    "speaker": "派蒙",
                    "text": "可是…",
                    "choices": [
                        {
                            "id": "772020419",
                            "text": "前进可以，等风雪小一些吧。",
                            "response": [
                                {
                                    "id": "772020421",
                                    "speaker": "马尔托斯",
                                    "text": "会的。"
                                },
                                {
                                    "id": "772020422",
                                    "speaker": "Black Screen",
                                    "text": "你在这里为他生起了火，并分给了他一些食物与水。"
                                },
                                {
                                    "id": "772020423",
                                    "speaker": "派蒙",
                                    "text": "吃饱喝足，身体暖和了，这样才好继续前进！"
                                },
                                {
                                    "id": "772020424",
                                    "speaker": "马尔托斯",
                                    "text": "…真、真是太感谢了。"
                                },
                                {
                                    "id": "772020425",
                                    "speaker": "马尔托斯",
                                    "text": "两位，如果我能学成，我一定，一定为两位做一尊了不起的雕像！",
                                    "choices": [
                                        {
                                            "id": "772020426",
                                            "text": "记得把我做高大一些…",
                                            "response": [
                                                {
                                                    "id": "772020427",
                                                    "speaker": "派蒙",
                                                    "text": "那、那我也要…"
                                                },
                                                {
                                                    "id": "772020430",
                                                    "speaker": "马尔托斯",
                                                    "text": "哈哈，到时候，一定会让二位满意的！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "772020428",
                                            "text": "记得把派蒙做可爱一些…",
                                            "response": [
                                                {
                                                    "id": "772020429",
                                                    "speaker": "派蒙",
                                                    "text": "什么叫可爱一些啦，我现在不可爱吗！"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "772020420",
                            "text": "得休息好了再走哦？"
                        }
                    ]
                }
            ]
        },
