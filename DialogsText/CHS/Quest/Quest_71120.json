    "talks": [
        {
            "id": "7112001",
            "objective": "(test)打怪给电源$HIDDEN",
            "dialogues": [
                {
                    "id": "711200101",
                    "speaker": "坐地虎",
                    "text": "喂，离远点！这是老爷的地盘！"
                },
                {
                    "id": "711200102",
                    "speaker": "派蒙",
                    "text": "哇啊，好凶！",
                    "choices": [
                        {
                            "id": "711200103",
                            "text": "你们是什么人？",
                            "response": [
                                {
                                    "id": "711200104",
                                    "speaker": "盘枝蛇",
                                    "text": "看你咯。你若客客气气的，我们便是朋友！你若打探太多，便别怪我们不客气啦。"
                                },
                                {
                                    "id": "711200105",
                                    "speaker": "坐地虎",
                                    "text": "劝你有点眼力见儿，哪里来的回哪里去！"
                                },
                                {
                                    "id": "711200109",
                                    "speaker": "派蒙",
                                    "text": "你们也太可疑了！"
                                },
                                {
                                    "id": "711200110",
                                    "speaker": "盘枝蛇",
                                    "text": "可疑？唉哟…我们就是看门的而已，你们这幅探头探脑的样子才更可疑吧！"
                                },
                                {
                                    "id": "711200111",
                                    "speaker": "坐地虎",
                                    "text": "行了，有什么好说！别打扰我们了！"
                                }
                            ]
                        },
                        {
                            "id": "711200106",
                            "text": "这是哪位「老爷」的地盘？",
                            "response": [
                                {
                                    "id": "711200107",
                                    "speaker": "坐地虎",
                                    "text": "哪位「老爷」？哼…说出来吓死你！"
                                },
                                {
                                    "id": "711200108",
                                    "speaker": "盘枝蛇",
                                    "text": "为你自己好，朋友！不该知道的东西就别乱打听了。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7112003",
            "objective": "(test)电源插入机器人$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7112002",
