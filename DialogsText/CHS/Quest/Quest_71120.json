            "dialogues": []
        },
        {
            "id": "7112051",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "711205199",
                    "speaker": "Black Screen",
                    "text": "你将充能核心插入了遗迹守卫锈迹斑斑的插槽中，笨重的古代机械缓缓移动起来。"
                }
            ]
        },
        {
            "id": "7112091",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "711209101",
                    "speaker": "坐地虎",
                    "text": "怎么又是你们！"
                },
                {
                    "id": "711209102",
                    "speaker": "盘枝蛇",
                    "text": "收收好奇心，朋友。你们就当没看见我们，我们也当没看见你们。",
                    "choices": [
                        {
                            "id": "711209103",
                            "text": "你们在看守什么？",
                            "response": [
                                {
                                    "id": "711209104",
                                    "speaker": "盘枝蛇",
                                    "text": "朋友，你猜我们领工钱为了什么？"
                                },
                                {
                                    "id": "711209105",
                                    "speaker": "派蒙",
                                    "text": "为什么呀！"
                                },
                                {
                                    "id": "711209106",
                                    "speaker": "盘枝蛇",
                                    "text": "咳咳…！"
                                },
                                {
                                    "id": "711209107",
                                    "speaker": "盘枝蛇",
                                    "text": "（我只告诉你两个，别让别人知道哦…来来，我告诉你…）"
                                },
                                {
                                    "id": "711209108",
                                    "speaker": "派蒙",
                                    "text": "（嗯嗯！我听着呢！）"
                                },
                                {
                                    "id": "711209109",
                                    "speaker": "盘枝蛇",
                                    "text": "为了让你们这种闲人滚蛋！！"
                                },
                                {
                                    "id": "711209110",
                                    "speaker": "派蒙",
                                    "text": "哇啊！！"
                                }
                            ]
                        },
                        {
                            "id": "711209111",
                            "text": "山洞里有奇怪的声音…",
                            "response": [
                                {
                                    "id": "711209112",
                                    "speaker": "坐地虎",
                                    "text": "我放屁了！"
                                },
                                {
                                    "id": "711209113",
                                    "speaker": "盘枝蛇",
                                    "text": "呃…对，他放屁了。"
                                },
                                {
                                    "id": "711209114",
                                    "speaker": "派蒙",
                                    "text": "那、那没事了…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7112092",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "711209201",
                    "speaker": "坐地虎",
                    "text": "我警告过你了！"
                },
                {
                    "id": "711209202",
                    "speaker": "盘枝蛇",
                    "text": "别太不知好歹了！"
                }
            ]
        }
