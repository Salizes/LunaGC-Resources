    "talks": [
        {
            "id": "4111301",
            "objective": "和莫娜聊聊有关陨石和占卜的事",
            "dialogues": [
                {
                    "id": "411130101",
                    "speaker": "派蒙",
                    "text": "莫娜！托你的福，我们清了好些陨石呢！"
                },
                {
                    "id": "411130102",
                    "speaker": "莫娜",
                    "text": "啊，正好！有件事需要你们去办一下。"
                },
                {
                    "id": "411130103",
                    "speaker": "莫娜",
                    "text": "记得吗？我说过这片陨石是某个人的命之座。"
                },
                {
                    "id": "411130104",
                    "speaker": "莫娜",
                    "text": "距离遥远的星星突然坠落在地，按理说这不可能。但事实就是如此矛盾。"
                },
                {
                    "id": "411130105",
                    "speaker": "莫娜",
                    "text": "想破解谜题，最好的办法就是查清命之座的主人。"
                },
                {
                    "id": "411130106",
                    "speaker": "莫娜",
                    "text": "你说过被陨石影响的人会陷入梦境，而且似乎都梦见了一座雪山。"
                },
                {
                    "id": "411130107",
                    "speaker": "莫娜",
                    "text": "未知的高山、覆雪之地…却又不是龙脊雪山，否则一定会有人认出山势的。"
                },
                {
                    "id": "411130108",
                    "speaker": "莫娜",
                    "text": "是不是所有人都有着共通的梦境？梦中他们身处什么地方？这些都很重要。"
                },
                {
                    "id": "411130109",
                    "speaker": "莫娜",
                    "text": "我需要你搜集更多关于梦境的信息。线索越多，越容易查到真相。"
                },
                {
                    "id": "411130110",
                    "speaker": "派蒙",
                    "text": "看来，得找个人多的地方调查一下。"
                },
                {
                    "id": "411130111",
                    "speaker": "派蒙",
                    "text": "再去找些患者问问话吧！"
                },
                {
                    "id": "411130112",
                    "speaker": "莫娜",
                    "text": "我必须留在不受干扰的环境里，调查就拜托你们了。"
                },
                {
                    "id": "411130113",
                    "speaker": "派蒙",
                    "text": "还有我们没去过的地方吗？"
                },
                {
                    "id": "411130114",
                    "speaker": "奥兹",
                    "text": "在璃月，有一座<color=#00E1FFFF>轻策庄</color>…虽然那里并不是什么「人多的地方」。"
                },
                {
                    "id": "411130115",
                    "speaker": "奥兹",
                    "text": "但我想，那里也许会像望舒客栈一样被千岩军临时征用，成为救治患者的场所吧。"
                }
            ]
        },
        {
            "id": "4111318",
            "objective": "前往轻策庄",
            "dialogues": [
                {
                    "id": "411131801",
                    "speaker": "高老六",
                    "text": "这次多亏了你们几位，否则，我怕是要睡到饿死喽！"
                }
            ]
        },
        {
            "id": "4111302",
            "objective": "与千岩军对话",
            "dialogues": [
                {
                    "id": "411130201",
                    "speaker": "派蒙",
                    "text": "你好，我们来自冒险家协会。请问轻策庄一带受陨石影响大吗？"
                },
                {
                    "id": "411130202",
                    "speaker": "经纶",
                    "text": "是冒险家啊！太好了，正愁没人呢！"
                },
                {
                    "id": "411130203",
                    "speaker": "经纶",
                    "text": "这几天，陨石动不动就从天上掉下来，别提有多麻烦了。"
                },
                {
                    "id": "411130204",
                    "speaker": "经纶",
                    "text": "落在<color=#00E1FFFF>田里</color>，谁都不敢去收粮食，落在<color=#00E1FFFF>大门口</color>，进出又成了问题。"
                },
                {
                    "id": "411130205",
                    "speaker": "经纶",
                    "text": "你们有办法清理这些陨石吗？实在是太碍事了！"
                },
                {
                    "id": "411130206",
                    "speaker": "Player",
                    "text": "看来轻策庄也遇到了麻烦。"
                },
                {
                    "id": "411130207",
                    "speaker": "派蒙",
                    "text": "没办法，该我们出手了。"
                }
            ]
        },
        {
            "id": "4111303",
            "objective": "清理田地里的陨石",
            "dialogues": [
                {
                    "id": "411130301",
                    "speaker": "经纶",
                    "text": "清理陨石的事还请你多多帮忙了。"
                }
            ]
        },
        {
            "id": "4111304",
            "objective": "清理田地里的陨石",
            "dialogues": []
        },
        {
            "id": "4111305",
            "objective": "清理田地里的陨石$HIDDEN",
            "dialogues": []
        },
        {
            "id": "4111306",
            "objective": "(test)保护我的保护$HIDDEN",
            "dialogues": []
        },
        {
            "id": "4111310",
            "objective": "向经纶汇报",
            "dialogues": [
                {
                    "id": "411131001",
                    "speaker": "派蒙",
                    "text": "陨石都清理完了！"
                },
                {
                    "id": "411131002",
                    "speaker": "经纶",
                    "text": "几位真是帮大忙了！"
                },
                {
                    "id": "411131003",
                    "speaker": "奥兹",
                    "text": "迄今为止有患者醒来吗？"
                },
                {
                    "id": "411131004",
                    "speaker": "经纶",
                    "text": "哎呀，我也不清楚…您直接过去看看好了。"
                }
            ]
        },
        {
            "id": "4111312",
            "objective": "调查附近的病患（0/3）",
            "dialogues": [
                {
                    "id": "411131201",
                    "speaker": "菲谢尔",
                    "text": "凡民！你也沉沦在苦难的境界之中？"
                },
                {
                    "id": "411131202",
                    "speaker": "派蒙",
                    "text": "和其他两地的患者症状一样呢。"
                },
                {
                    "id": "411131203",
                    "speaker": "派蒙",
                    "text": "你好，请问他有醒来过吗？"
                },
                {
                    "id": "411131204",
                    "speaker": "华清",
                    "text": "没有，只是偶尔说些梦话。"
                },
                {
                    "id": "411131205",
                    "speaker": "派蒙",
                    "text": "什么样的梦话？"
                },
                {
                    "id": "411131206",
                    "speaker": "华清",
                    "text": "好冷…走不动了…之类的。"
                },
                {
                    "id": "411131207",
                    "speaker": "Player",
                    "text": "冷？之前也有人提过。"
                },
                {
                    "id": "411131208",
                    "speaker": "奥兹",
                    "text": "寒冷的地带，山脉…会是哪里？"
                }
            ]
        },
        {
            "id": "4111313",
            "objective": "调查附近的病患（1/3）",
            "dialogues": [
                {
                    "id": "411131301",
                    "speaker": "派蒙",
                    "text": "请问这个患者醒来了吗？"
                },
                {
                    "id": "411131302",
                    "speaker": "阿阳",
                    "text": "还没有。"
                },
                {
                    "id": "411131303",
                    "speaker": "派蒙",
                    "text": "那他说梦话了吗？"
                },
                {
                    "id": "411131304",
                    "speaker": "阿阳",
                    "text": "这么一说…昨天他似乎喊了一句「好高啊」，也不知道是什么意思。"
                },
                {
                    "id": "411131305",
                    "speaker": "派蒙",
                    "text": "好高？是说雪山的高度很高吗？"
                },
                {
                    "id": "411131306",
                    "speaker": "菲谢尔",
                    "text": "高耸的冷冽魔山，带来奔流的黑暗之力…"
                },
                {
                    "id": "411131307",
                    "speaker": "派蒙",
                    "text": "再问问那边那个人吧。"
                }
            ]
        },
        {
            "id": "4111314",
            "objective": "调查附近的病患（2/3）",
            "dialogues": [
                {
                    "id": "411131401",
                    "speaker": "派蒙",
                    "text": "你好，请问这里有醒来的病人吗？"
                },
                {
                    "id": "411131402",
                    "speaker": "大黄",
                    "text": "巧了，<color=#00E1FFFF>高老六</color>刚刚醒来！"
                },
                {
                    "id": "411131403",
                    "speaker": "派蒙",
                    "text": "我们就找他！"
                },
                {
                    "id": "411131404",
                    "speaker": "大黄",
                    "text": "不过他昏睡至今，身体十分虚弱。你们若要问话，还请温柔一些。"
                },
                {
                    "id": "411131405",
                    "speaker": "菲谢尔",
                    "text": "不幸的人，你将获得皇女的问候。"
                },
                {
                    "id": "411131406",
                    "speaker": "高老六",
                    "text": "哎…好饿啊…"
                },
                {
                    "id": "411131407",
                    "speaker": "派蒙",
                    "text": "你没事吧？是不是肚子饿得厉害？"
                },
                {
                    "id": "411131408",
                    "speaker": "高老六",
                    "text": "哎…哎…",
                    "choices": [
                        {
                            "id": "411131409",
                            "text": "想吃什么？报个菜名。",
                            "response": [
                                {
                                    "id": "411131411",
                                    "speaker": "高老六",
                                    "text": "想吃…家…家乡…菜…"
                                },
                                {
                                    "id": "411131412",
                                    "speaker": "派蒙",
                                    "text": "轻策庄的家乡菜，一定就是<color=#00E1FFFF>轻策农家菜</color>啦！"
                                }
                            ]
                        },
                        {
                            "id": "411131410",
                            "text": "我可以为你做一顿饭。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "4111320",
            "objective": "做一份轻策农家菜",
            "dialogues": [
                {
                    "id": "411132001",
                    "speaker": "小白",
                    "text": "试试轻策农家菜吧，美味又实惠哦！"
                }
            ]
        },
        {
            "id": "4111311",
            "objective": "为高老六送上轻策农家菜",
            "dialogues": [
                {
                    "id": "411131101",
                    "speaker": "高老六",
                    "text": "呜啊…活过来了！"
                },
                {
                    "id": "411131102",
                    "speaker": "派蒙",
                    "text": "请问，你昏睡期间做梦了吗？"
                },
                {
                    "id": "411131103",
                    "speaker": "高老六",
                    "text": "做了做了！可把我累得！"
                },
                {
                    "id": "411131104",
                    "speaker": "派蒙",
                    "text": "什么梦能把人累成这样？",
                    "choices": [
                        {
                            "id": "411131105",
                            "text": "你梦见自己在山上吗？",
                            "response": [
                                {
                                    "id": "411131106",
                                    "speaker": "高老六",
                                    "text": "你怎么知道？那是座很高、很冷的雪山…我从没见过那么高的山峰。"
                                },
                                {
                                    "id": "411131109",
                                    "speaker": "派蒙",
                                    "text": "你去雪山干什么？"
                                },
                                {
                                    "id": "411131110",
                                    "speaker": "高老六",
                                    "text": "我也不清楚，就跟中邪一样，梦里只想着要爬山，要到最高峰去。"
                                },
                                {
                                    "id": "411131111",
                                    "speaker": "派蒙",
                                    "text": "山峰上有什么好东西吗？"
                                },
                                {
                                    "id": "411131112",
                                    "speaker": "高老六",
                                    "text": "谁知道呢？我一睡着就跟变了个人一样，你问原因，我也说不上来…"
                                },
                                {
                                    "id": "411131113",
                                    "speaker": "Player",
                                    "text": "不是你自己想爬吗？"
                                },
                                {
                                    "id": "411131114",
                                    "speaker": "高老六",
                                    "text": "怎么说呢…像是有人控制了我，让我产生这种爬山的念头，别提有多奇怪了。"
                                },
                                {
                                    "id": "411131115",
                                    "speaker": "菲谢尔",
                                    "text": "难道说，是黑暗心流？？？"
                                },
                                {
                                    "id": "411131116",
                                    "speaker": "奥兹",
                                    "text": "不是自发，而是下意识产生这种愿望。的确很像精神控制呢。",
                                    "choices": [
                                        {
                                            "id": "411131117",
                                            "text": "虽然已经习惯了但还是想说…",
                                            "response": [
                                                {
                                                    "id": "411131119",
                                                    "speaker": "派蒙",
                                                    "text": "这么说，之前那些一个劲说冷的、爬不动了的…也都在雪山上吗？"
                                                },
                                                {
                                                    "id": "411131120",
                                                    "speaker": "Player",
                                                    "text": "所有人都做同一个梦吗？"
                                                },
                                                {
                                                    "id": "411131121",
                                                    "speaker": "派蒙",
                                                    "text": "太不可思议了…得快点告诉<color=#00E1FFFF>莫娜</color>才行！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "411131118",
                                            "text": "你们俩说的根本不是同一个词..."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "411131107",
                            "text": "你梦见自己在雪原上吗？",
                            "response": [
                                {
                                    "id": "411131108",
                                    "speaker": "高老六",
                                    "text": "不是雪原，是雪山。非常高，而且很冷…我一睡着，就梦见自己站在山脚下。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "4111315",
            "objective": "(test)交付完成后的对话$HIDDEN",
            "dialogues": []
        },
        {
            "id": "4111307",
            "objective": "将陨石的信息告诉莫娜",
            "dialogues": [
                {
                    "id": "411130701",
                    "speaker": "派蒙",
                    "text": "莫娜，我们问到了！"
                },
                {
                    "id": "411130702",
                    "speaker": "菲谢尔",
                    "text": "高耸入云的雪山，想必那就是黑暗滋生的蘖芽。"
                },
                {
                    "id": "411130703",
                    "speaker": "莫娜",
                    "text": "雪山？就这一条吗？"
                },
                {
                    "id": "411130704",
                    "speaker": "Player",
                    "text": "所有人都梦见同一座雪山。"
                },
                {
                    "id": "411130705",
                    "speaker": "派蒙",
                    "text": "高耸入云、见所未见的雪山，温度极低，而且，梦中所有人不受控制地想要登上山顶。"
                },
                {
                    "id": "411130706",
                    "speaker": "莫娜",
                    "text": "登上山顶…登上山顶？"
                },
                {
                    "id": "411130707",
                    "speaker": "莫娜",
                    "text": "什么人会想登上山顶？而且如此渴望，甚至能影响到他人？"
                },
                {
                    "id": "411130708",
                    "speaker": "菲谢尔",
                    "text": "雪山上埋着被迫害致死的人吗？"
                },
                {
                    "id": "411130709",
                    "speaker": "奥兹",
                    "text": "或者是…对雪山充满渴望的挑战者。"
                },
                {
                    "id": "411130710",
                    "speaker": "莫娜",
                    "text": "我再算一次！"
                },
                {
                    "id": "411130711",
                    "speaker": "莫娜",
                    "text": "有了！隐约能看到一点新线索，他的名字是…<color=#00E1FFFF>莱纳德</color>！"
                },
                {
                    "id": "411130712",
                    "speaker": "派蒙",
                    "text": "哎？！这么快？！"
                },
                {
                    "id": "411130713",
                    "speaker": "莫娜",
                    "text": "早就告诉过你了，我是天才呀！"
                },
                {
                    "id": "411130714",
                    "speaker": "派蒙",
                    "text": "莱纳德…没听过的名字呢。"
                }
            ]
        },
        {
            "id": "4111316",
            "objective": "(test)保护我的传送$HIDDEN",
            "dialogues": [
                {
                    "id": "411131601",
                    "speaker": "「散兵」",
                    "text": "嗨。"
                }
            ]
        },
        {
            "id": "4111308",
            "objective": "(test)散兵cs后的对话$HIDDEN",
            "dialogues": [
                {
                    "id": "411130715",
                    "speaker": "莫娜",
                    "text": "即使用最简易的占卜，也能察知那个人…是「愚人众执行官」！太危险了，你们怎么会和他有来往？"
                },
                {
                    "id": "411130716",
                    "speaker": "奥兹",
                    "text": "什么，那位少年是愚人众执行官？何等邪恶的人物…！"
                },
                {
                    "id": "411130717",
                    "speaker": "Player",
                    "text": "居然是执行官？"
                },
                {
                    "id": "411130718",
                    "speaker": "莫娜",
                    "text": "他接近你一定是有所图谋。"
                },
                {
                    "id": "411130719",
                    "speaker": "莫娜",
                    "text": "而且他非常强！看上一眼就能感觉到，他的实力超乎想象。"
                },
                {
                    "id": "411130720",
                    "speaker": "莫娜",
                    "text": "虽然不想承认，但…"
                },
                {
                    "id": "411130721",
                    "speaker": "奥兹",
                    "text": "难道他比身为罕见占星天才的莫娜女士更强大？"
                },
                {
                    "id": "411130722",
                    "speaker": "莫娜",
                    "text": "谁、谁说的！他不过是实力险胜一筹而已，单论占星术可比我差远了！"
                },
                {
                    "id": "411130723",
                    "speaker": "派蒙",
                    "text": "对了对了，我们在望舒客栈附近也遇到过愚人众的人！"
                },
                {
                    "id": "411130724",
                    "speaker": "派蒙",
                    "text": "愚人众为什么对陨石如此关心？"
                },
                {
                    "id": "411130725",
                    "speaker": "莫娜",
                    "text": "果然是有什么阴谋吧。"
                },
                {
                    "id": "411130726",
                    "speaker": "莫娜",
                    "text": "唔，难道说…"
                },
                {
                    "id": "411130727",
                    "speaker": "派蒙",
                    "text": "啊！该不会，这批陨石就是愚人众搞出来的吧？"
                },
                {
                    "id": "411130728",
                    "speaker": "莫娜",
                    "text": "派蒙！你竟敢抢我台词！"
                },
                {
                    "id": "411130729",
                    "speaker": "派蒙",
                    "text": "哎嘿嘿…不好意思，还是我的嘴比较快。"
                },
                {
                    "id": "411130730",
                    "speaker": "Player",
                    "text": "可是，世上有召唤陨石的法术吗？"
                },
                {
                    "id": "411130731",
                    "speaker": "派蒙",
                    "text": "从天上拉下一颗星星，太夸张了！"
                },
                {
                    "id": "411130732",
                    "speaker": "菲谢尔",
                    "text": "奥兹华尔多·赫芙那梵茵斯，你怎么看？"
                },
                {
                    "id": "411130733",
                    "speaker": "奥兹",
                    "text": "小姐，我认为一切均有可能。"
                },
                {
                    "id": "411130734",
                    "speaker": "菲谢尔",
                    "text": "只要投以同等的代价，不祥之种就会在任何地方扎根…愚人众，本皇女记住你们了。"
                },
                {
                    "id": "411130735",
                    "speaker": "奥兹",
                    "text": "哈，奇迹也是可能发生的。"
                },
                {
                    "id": "411130736",
                    "speaker": "菲谢尔",
                    "text": "群星的使者，不愧是我优秀的扈从！我会指派部下保护你，使你免遭黑暗的侵袭。"
                },
                {
                    "id": "411130737",
                    "speaker": "奥兹",
                    "text": "比方说，我。"
                },
                {
                    "id": "411130738",
                    "speaker": "派蒙",
                    "text": "不不不，我们的战斗力安排很合理，保持现在这样就好！"
                },
                {
                    "id": "411130739",
                    "speaker": "莫娜",
                    "text": "菲谢尔，你在小看我吗？我可是很强的哦！"
                },
                {
                    "id": "411130740",
                    "speaker": "奥兹",
                    "text": "没有比你更值得信赖的人了，女士。只不过，皇女也会担心你的安危。"
                },
                {
                    "id": "411130741",
                    "speaker": "莫娜",
                    "text": "没那个必要。再说，你们所处的环境比我更危险，可能的话，我还想保护你们呢。",
                    "choices": [
                        {
                            "id": "411130742",
                            "text": "莫娜，你人真好。",
                            "response": [
                                {
                                    "id": "411130743",
                                    "speaker": "莫娜",
                                    "text": "干、干嘛突然说这种话…"
                                },
                                {
                                    "id": "411130746",
                                    "speaker": "莫娜",
                                    "text": "先解决新的麻烦吧，星盘显示，有一颗<color=#00E1FFFF>巨大的陨石</color>落地了。"
                                }
                            ]
                        },
                        {
                            "id": "411130744",
                            "text": "菲谢尔，你人真好。",
                            "response": [
                                {
                                    "id": "411130745",
                                    "speaker": "菲谢尔",
                                    "text": "那、那是当然的啦！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "4111319",
            "objective": "(test)播放开车台词用$HIDDEN",
            "dialogues": []
        },
        {
            "id": "4111317",
            "objective": "前往巨大陨石坠落之地",
            "dialogues": [
                {
                    "id": "411131701",
                    "speaker": "莫娜",
                    "text": "真是个大家伙。"
                }
            ]
        },
        {
            "id": "4111309",
            "objective": "(test)与菲谢尔对话（隐藏）$HIDDEN",
            "dialogues": [
                {
                    "id": "411130901",
                    "speaker": "莫娜",
                    "text": "就是它了。"
                },
                {
                    "id": "411130902",
                    "speaker": "奥兹",
                    "text": "我能从中感受到空前强大的元素力。"
                },
                {
                    "id": "411130903",
                    "speaker": "菲谢尔",
                    "text": "漆黑寂灭之根源…降临了。"
                },
                {
                    "id": "411130904",
                    "speaker": "派蒙",
                    "text": "那些愚人众，难道是冲着元素力来的？"
                },
                {
                    "id": "411130905",
                    "speaker": "莫娜",
                    "text": "不无可能。如果是这样，其他生物也会想要这股力量才对。"
                },
                {
                    "id": "411130906",
                    "speaker": "Player",
                    "text": "我们靠近看看吧。"
                }
            ]
        },
        {
            "id": "4111311",
