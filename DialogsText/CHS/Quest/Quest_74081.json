                }
            ]
        },
        {
            "id": "7408133",
            "objective": "击败发条机关",
            "dialogues": []
        },
        {
            "id": "7408115",
            "objective": "继续向前探索",
            "dialogues": []
        },
        {
            "id": "7408131",
            "objective": "调查神秘房间",
            "dialogues": [
                {
                    "id": "740813101",
                    "speaker": "派蒙",
                    "text": "你好！关于瑟维妮小姐…"
                },
                {
                    "id": "740813102",
                    "speaker": "Black Screen",
                    "text": "向希塞蕾说明了情况，并交付了回收的三份打孔纸带…"
                },
                {
                    "id": "740813103",
                    "speaker": "希塞蕾",
                    "text": "我正担心她，在考虑要不要去看看她的情况呢，原来发生了这样的事。谢谢你们带回了她的消息…还有打孔纸带。"
                },
                {
                    "id": "740813104",
                    "speaker": "希塞蕾",
                    "text": "没想到梅雅德的试验机居然还能运作，瑟维妮居然在这样危险的环境中继续工作，我得去找事务员商量回收事宜了。"
                },
                {
                    "id": "740813105",
                    "speaker": "希塞蕾",
                    "text": "正好也可以打听一下报销的问题…还是瑟维妮脑子灵光。不过是否合规还得看事务员的判断，所以费用暂且由我垫付吧。"
                },
                {
                    "id": "740813106",
                    "speaker": "希塞蕾",
                    "text": "不管怎么说，感谢你们的协助，完成委托的报酬还请两位收好。"
                }
            ]
        },
        {
            "id": "7408116",
            "objective": "击败发条机关",
            "dialogues": []
        },
        {
            "id": "7408129",
            "objective": "与研究员对话",
            "dialogues": [
                {
                    "id": "740812901",
                    "speaker": "？？？",
                    "text": "又是震动又是打斗声，还以为是伊斯丁豪斯先生回来了呢，原来是有人误启动了外面的装置…"
                },
                {
                    "id": "740812902",
                    "speaker": "？？？",
                    "text": "哎呀哎呀，梅雅德前辈的试验机…怎么会搞成这副模样。"
                }
            ]
        },
        {
            "id": "7408117",
            "objective": "与研究员对话",
            "dialogues": [
                {
                    "id": "740811701",
                    "speaker": "派蒙",
                    "text": "呃…我们、我们该不会闯大祸了吧？"
                },
                {
                    "id": "740811702",
                    "speaker": "？？？",
                    "text": "真奇怪，刚才感到一阵晃动…",
                    "choices": [
                        {
                            "id": "740811703",
                            "text": "我也感觉到了。",
                            "response": [
                                {
                                    "id": "740811705",
                                    "speaker": "派蒙",
                                    "text": "唔，可能是因为我们刚才动了上层的装置…"
                                },
                                {
                                    "id": "740811706",
                                    "speaker": "？？？",
                                    "text": "这里的门原本是锁上的吧？还特意放了一些发条机关在门口看守…",
                                    "choices": [
                                        {
                                            "id": "740811707",
                                            "text": "我请它们休息之后把门打开了。",
                                            "response": [
                                                {
                                                    "id": "740811709",
                                                    "speaker": "派蒙",
                                                    "text": "这、这也没办法嘛，是它们先攻击我们的，我们这算是正当防卫？"
                                                },
                                                {
                                                    "id": "740811710",
                                                    "speaker": "？？？",
                                                    "text": "梅雅德前辈的试验机…原本应该是停机状态吧。毕竟前辈自从在伊黎耶岛觅得了一块好场地，就几乎不回来了。"
                                                },
                                                {
                                                    "id": "740811711",
                                                    "speaker": "？？？",
                                                    "text": "想想也是，如果能在花园舞池那样风景优美的地方向众人展示研究成果，又有谁会愿意回到这种阴湿破败的研究室来呢。"
                                                },
                                                {
                                                    "id": "740811712",
                                                    "speaker": "？？？",
                                                    "text": "博絮埃先生卸任之后，大家就像这里的资材一样四散去了枫丹科学院的各处，就连沙发也没留下一个。"
                                                },
                                                {
                                                    "id": "740811713",
                                                    "speaker": "？？？",
                                                    "text": "只有试验机还留在这里，等那些不会回来的人。原本只是站在这里待机，对它们来说应该也不算什么吧，不过现在可好了。"
                                                },
                                                {
                                                    "id": "740811714",
                                                    "speaker": "？？？",
                                                    "text": "瞧瞧，给打得七零八落，发条都快掉出来啦。要是梅雅德前辈知道了…",
                                                    "choices": [
                                                        {
                                                            "id": "740811715",
                                                            "text": "是我干的，对不起。",
                                                            "response": [
                                                                {
                                                                    "id": "740811718",
                                                                    "speaker": "派蒙",
                                                                    "text": "对不起…这、这个试验机很贵吗？如果要赔偿的话…"
                                                                },
                                                                {
                                                                    "id": "740811719",
                                                                    "speaker": "？？？",
                                                                    "text": "不用紧张。我是想说，梅雅德前辈要是知道了，一定会笑出声的。"
                                                                },
                                                                {
                                                                    "id": "740811720",
                                                                    "speaker": "？？？",
                                                                    "text": "毕竟他自己以前就常主动打断试验机的舞蹈，被打倒后又坐在原地哈哈大笑。"
                                                                },
                                                                {
                                                                    "id": "740811721",
                                                                    "speaker": "瑟维妮",
                                                                    "text": "对了，说了这么久，还没自我介绍呢。我是枫丹科学院的研究员，你们可以叫我瑟维妮。两位是？"
                                                                },
                                                                {
                                                                    "id": "740811722",
                                                                    "speaker": "派蒙",
                                                                    "text": "#我是派蒙，{M#他}{F#她}是{NICKNAME}，我们是…呃…",
                                                                    "choices": [
                                                                        {
                                                                            "id": "740811723",
                                                                            "text": "只是路过而已，绝对没有别的意思。",
                                                                            "response": [
                                                                                {
                                                                                    "id": "740811724",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "对！我们只是路过而已，绝对不是以为这里有什么宝藏所以才…"
                                                                                },
                                                                                {
                                                                                    "id": "740811726",
                                                                                    "speaker": "瑟维妮",
                                                                                    "text": "哦，你们是说会安排一些寻宝环节的废墟旅游？那你们可找错地方了，这里虽然看起来像废墟…不，实际上也是废墟吧。"
                                                                                },
                                                                                {
                                                                                    "id": "740811727",
                                                                                    "speaker": "瑟维妮",
                                                                                    "text": "但是这里还没有被纳入废墟旅游的推荐地点哦。"
                                                                                },
                                                                                {
                                                                                    "id": "740811728",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "好吧，那我们现在就走…"
                                                                                },
                                                                                {
                                                                                    "id": "740811729",
                                                                                    "speaker": "瑟维妮",
                                                                                    "text": "…等等，你们知道新枫丹科学院吧？要走的话正好帮我一个忙，去新枫丹科学院找到希塞蕾前辈…",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "740811730",
                                                                                            "text": "可是我们不去新枫丹科学院。",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "740811732",
                                                                                                    "speaker": "瑟维妮",
                                                                                                    "text": "这可怎么办呢，我还有工作没处理完，梅雅德前辈的试验机又被打坏了，需要尽快找人回收…"
                                                                                                },
                                                                                                {
                                                                                                    "id": "740811733",
                                                                                                    "speaker": "派蒙",
                                                                                                    "text": "#唔唔…{NICKNAME}，不然我们还是帮她这个忙吧…"
                                                                                                },
                                                                                                {
                                                                                                    "id": "740811734",
                                                                                                    "speaker": "瑟维妮",
                                                                                                    "text": "太好了！既然你们同意帮忙捎话，那回收打孔纸带的工作也拜托你们好了。",
                                                                                                    "choices": [
                                                                                                        {
                                                                                                            "id": "740811735",
                                                                                                            "text": "早知道不乱动外边的装置了…",
                                                                                                            "response": [
                                                                                                                {
                                                                                                                    "id": "740811746",
                                                                                                                    "speaker": "瑟维妮",
                                                                                                                    "text": "别这么说嘛，反正不是什么难事。"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "740811737",
                                                                                                                    "speaker": "瑟维妮",
                                                                                                                    "text": "有了帮忙回收研究资料的名头，委托的报酬就可以报销了。"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "740811738",
                                                                                                                    "speaker": "派蒙",
                                                                                                                    "text": "欸？这么做真的没问题吗？"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "740811739",
                                                                                                                    "speaker": "瑟维妮",
                                                                                                                    "text": "毕竟确实协助了研究工作，名正言顺，当然没问题啦。"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "740811740",
                                                                                                                    "speaker": "瑟维妮",
                                                                                                                    "text": "而且如果真的不合规的话，会被事务员驳回的。那时就只好我自行承担委托的费用了。"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "740811741",
                                                                                                                    "speaker": "Player",
                                                                                                                    "text": "你们经常做这种事吗？"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "740811742",
                                                                                                                    "speaker": "瑟维妮",
                                                                                                                    "text": "我本人是没有啦。其他人的话我就不知道了，以前确实听过一些传闻，不过…哎呀，这也不是值得和外人讲的消息。"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "740811743",
                                                                                                                    "speaker": "瑟维妮",
                                                                                                                    "text": "要回收的打孔纸带有三份。应该说，书架上只有三份打孔纸带了。应该很容易就能找到的，就麻烦两位了。"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "740811744",
                                                                                                                    "speaker": "瑟维妮",
                                                                                                                    "text": "在此期间，我得再检查一下试验机，毕竟很久都没人维护过它们了…如果失控了就不好了。"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "740811745",
                                                                                                                    "speaker": "派蒙",
                                                                                                                    "text": "好吧，那我们回收完打孔纸带再来找你确认。"
                                                                                                                }
                                                                                                            ]
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "740811736",
                                                                                                            "text": "没问题，交给我吧。"
                                                                                                        }
                                                                                                    ]
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "740811731",
                                                                                            "text": "我们还有别的宝藏要找。"
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "740811725",
                                                                            "text": "请问这里有宝藏吗？"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "740811716",
                                                            "text": "有考虑对试验机的强度进行升级吗？",
                                                            "response": [
                                                                {
                                                                    "id": "740811717",
                                                                    "speaker": "？？？",
                                                                    "text": "梅雅德前辈的确这样做了。或许最终的成品能够符合你对强度的预期。"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "740811708",
                                            "text": "是啊，真奇怪，门怎么打开了。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "740811704",
                            "text": "是你的错觉吧？"
                        }
                    ]
                }
            ]
        },
