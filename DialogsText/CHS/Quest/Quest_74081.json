            "dialogues": []
        },
        {
            "id": "7408103",
            "objective": "(test)（对话表现）进入后山洞天$HIDDEN",
            "dialogues": [
                {
                    "id": "740810301",
                    "speaker": "派蒙",
                    "text": "哇…没想到水下居然有这么大的空间，还有奇怪的装置！"
                },
                {
                    "id": "740810302",
                    "speaker": "派蒙",
                    "text": "不知道那个怪怪装置是做什么用的，但是这里看起来已经荒废很久了，也不像有人的样子…"
                },
                {
                    "id": "740810303",
                    "speaker": "派蒙",
                    "text": "#{NICKNAME}，我们要小心一点！"
                }
            ]
        },
        {
            "id": "7408104",
            "objective": "在遗迹内探索",
            "dialogues": []
        },
        {
