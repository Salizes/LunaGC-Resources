    "talks": [
        {
            "id": "7106401",
            "objective": "test隐藏-预先接取的任务$HIDDEN",
            "dialogues": [
                {
                    "id": "710640101",
                    "speaker": "阿望",
                    "text": "千岩保佑，最近层岩巨渊可千万别再出什么问题。"
                },
                {
                    "id": "710640102",
                    "speaker": "阿望",
                    "text": "希望这次下矿也能平安无事，希望那些不再回来采矿的兄弟们也能各有好前程，千岩保佑，千岩保佑…"
                },
                {
                    "id": "710640103",
                    "speaker": "阿望",
                    "text": "嗯？怎么了，有什么事吗？",
                    "choices": [
                        {
                            "id": "710640104",
                            "text": "你在拜这个东西？",
                            "response": [
                                {
                                    "id": "710640106",
                                    "speaker": "阿望",
                                    "text": "哦，我是在拜这座纪念千岩军的纪念石，哈哈，看上去只是一堆不起眼的石块吧，但是从五百年前开始就竖立在这了。"
                                },
                                {
                                    "id": "710640107",
                                    "speaker": "阿望",
                                    "text": "整个层岩啊，都受千岩军保护，所以每次我们有人下矿，都会来这里拜一拜，祈求千岩军的先烈英魂保佑。"
                                },
                                {
                                    "id": "710640108",
                                    "speaker": "阿望",
                                    "text": "他们都化为元素，和我们的矿坑融为一体了…所以向他们的英魂祈求保佑，也是在向层岩巨渊致敬嘛。"
                                },
                                {
                                    "id": "710640109",
                                    "speaker": "阿望",
                                    "text": "古话说，大地有神，元素有灵。那些为我们而牺牲的亡者，应该也会寄托我们的念想吧…"
                                },
                                {
                                    "id": "710640110",
                                    "speaker": "派蒙",
                                    "text": "五百年前？"
                                },
                                {
                                    "id": "710640111",
                                    "speaker": "阿望",
                                    "text": "对啊，五百年前。那时候漆黑的灾变吞没了层岩巨渊，岩王帝君号令千岩军守住层岩矿脉。"
                                },
                                {
                                    "id": "710640112",
                                    "speaker": "阿望",
                                    "text": "那一战十分惨烈，在一名夜叉的带领下，千岩军前赴后继地阻拦敌人…"
                                },
                                {
                                    "id": "710640113",
                                    "speaker": "阿望",
                                    "text": "最后，有一队千岩军将敌人引向层岩巨渊深处，才止息了混乱。"
                                },
                                {
                                    "id": "710640114",
                                    "speaker": "阿望",
                                    "text": "据说这纪念石也是为此而立。"
                                },
                                {
                                    "id": "710640115",
                                    "speaker": "派蒙",
                                    "text": "哦…没想到这个丑丑的石头堆，还有这样的来头呢！"
                                },
                                {
                                    "id": "710640116",
                                    "speaker": "阿望",
                                    "text": "嘿嘿，小东西，可别对亡者不敬哟。",
                                    "choices": [
                                        {
                                            "id": "710640118",
                                            "text": "请别在意，小东西不会咬人的。",
                                            "response": [
                                                {
                                                    "id": "710640117",
                                                    "speaker": "派蒙",
                                                    "text": "谁是小东西啦！"
                                                },
                                                {
                                                    "id": "710640120",
                                                    "speaker": "阿望",
                                                    "text": "呵呵，总之，这对于我们这些在层岩巨渊边上长大的孩子来说都是很熟悉的传说故事了…流传了许久，版本也有很多个…"
                                                },
                                                {
                                                    "id": "710640121",
                                                    "speaker": "阿望",
                                                    "text": "跟别人谈起的话，他们也会讲出不同的故事呢。或许这就是历史的魅力吧？嘿嘿，我没什么文化…就随便一说。"
                                                },
                                                {
                                                    "id": "710640122",
                                                    "speaker": "阿望",
                                                    "text": "说起来，还一直有传闻呢，说是这些石上还藏着一个秘密，根据其提示可以找到千岩军留下的宝藏。"
                                                },
                                                {
                                                    "id": "710640123",
                                                    "speaker": "派蒙",
                                                    "text": "千岩军留下的宝藏？"
                                                },
                                                {
                                                    "id": "710640124",
                                                    "speaker": "派蒙",
                                                    "text": "这个部分能不能说得再详细一点呀…我突然就感兴趣了！"
                                                },
                                                {
                                                    "id": "710640125",
                                                    "speaker": "阿望",
                                                    "text": "哈哈，传言而已，传言而已…这跟竖立这些纪念石的千岩军也有关。",
                                                    "choices": [
                                                        {
                                                            "id": "710640126",
                                                            "text": "这不是矿工竖立的吗？",
                                                            "response": [
                                                                {
                                                                    "id": "710640127",
                                                                    "speaker": "阿望",
                                                                    "text": "不是，当时矿工们竖立的纪念石在另外一边，也没这座这么大。"
                                                                },
                                                                {
                                                                    "id": "710640130",
                                                                    "speaker": "阿望",
                                                                    "text": "层岩巨渊一战虽然结束，但是还是有许多千岩军将士同无名的夜叉一起，永远留在了巨渊之底…"
                                                                },
                                                                {
                                                                    "id": "710640131",
                                                                    "speaker": "阿望",
                                                                    "text": "其中有一名千岩军，在帮助矿工撤退、与敌人作战时，从高处跌落伤了脊背，手脚都无法自如行动…"
                                                                },
                                                                {
                                                                    "id": "710640132",
                                                                    "speaker": "阿望",
                                                                    "text": "但后来呀…听说他并不气馁于困状，而是自学成才，终成一位名医，一直帮助着其他同样身处困境的人们。"
                                                                },
                                                                {
                                                                    "id": "710640133",
                                                                    "speaker": "阿望",
                                                                    "text": "据说这座纪念石，就是他在获得「神之眼」后，为感怀故友而建立的。"
                                                                },
                                                                {
                                                                    "id": "710640134",
                                                                    "speaker": "阿望",
                                                                    "text": "后来呀，他的故事渐渐淡去，被诸如「千岩军的宝藏」、「夜叉的遗产」之类的故事取代了。"
                                                                },
                                                                {
                                                                    "id": "710640135",
                                                                    "speaker": "阿望",
                                                                    "text": "都是些荒诞不经的传说罢了…我们矿工大多相信踏踏实实做事的价值，对这种宝藏传说不太相信，不过嘛…"
                                                                },
                                                                {
                                                                    "id": "710640136",
                                                                    "speaker": "派蒙",
                                                                    "text": "不过什么呀？"
                                                                },
                                                                {
                                                                    "id": "710640137",
                                                                    "speaker": "阿望",
                                                                    "text": "没事，我的意思是，如果你认真去找，我也不会笑话你的。"
                                                                },
                                                                {
                                                                    "id": "710640138",
                                                                    "speaker": "阿望",
                                                                    "text": "我也想过，说不定宝藏的传说是假的。一代代的人们呀…只不过是想用这样的方法，让纪念石的故事流传下来，不被后来人忘记。"
                                                                },
                                                                {
                                                                    "id": "710640139",
                                                                    "speaker": "阿望",
                                                                    "text": "总之…传说是这样的，若是在此石前供奉散落于层岩巨渊的六样供物，即可获得千岩军之馈赠。"
                                                                },
                                                                {
                                                                    "id": "710640140",
                                                                    "speaker": "阿望",
                                                                    "text": "此六样供物，分别是…"
                                                                },
                                                                {
                                                                    "id": "710640141",
                                                                    "speaker": "阿望",
                                                                    "text": "能够保护众人不受落石所伤的「庇佑之冠」…"
                                                                },
                                                                {
                                                                    "id": "710640142",
                                                                    "speaker": "阿望",
                                                                    "text": "纪念同僚友谊的「共饮之杯」…"
                                                                },
                                                                {
                                                                    "id": "710640143",
                                                                    "speaker": "阿望",
                                                                    "text": "象征高远心志的「高翔之翎」…"
                                                                },
                                                                {
                                                                    "id": "710640144",
                                                                    "speaker": "阿望",
                                                                    "text": "抗击外敌所用的「同泽之枪」…"
                                                                },
                                                                {
                                                                    "id": "710640145",
                                                                    "speaker": "阿望",
                                                                    "text": "生于层岩巨渊之巅的「远眺之花」…"
                                                                },
                                                                {
                                                                    "id": "710640146",
                                                                    "speaker": "阿望",
                                                                    "text": "以及…钦怀过往的「岁时之晷」…"
                                                                },
                                                                {
                                                                    "id": "710640147",
                                                                    "speaker": "派蒙",
                                                                    "text": "听上去让人觉得一头雾水。"
                                                                },
                                                                {
                                                                    "id": "710640148",
                                                                    "speaker": "派蒙",
                                                                    "text": "真的不是后人编的吗？",
                                                                    "choices": [
                                                                        {
                                                                            "id": "710640149",
                                                                            "text": "这些供物全在层岩巨渊？",
                                                                            "response": [
                                                                                {
                                                                                    "id": "710640151",
                                                                                    "speaker": "阿望",
                                                                                    "text": "谁知道呢，说不定传说都是编的，所以这么多年了才没有人真的找到过传说中的宝物。"
                                                                                },
                                                                                {
                                                                                    "id": "710640152",
                                                                                    "speaker": "阿望",
                                                                                    "text": "啊对了，说起来，不是还有另一处纪念石吗，唉…层岩巨渊关闭后大家各奔东西，那边也没什么人前去祭扫了。"
                                                                                },
                                                                                {
                                                                                    "id": "710640153",
                                                                                    "speaker": "阿望",
                                                                                    "text": "能帮忙去那边祭扫一番吗，随意做些打扫就好…"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "710640150",
                                                                            "text": "听起来好假…"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "710640128",
                                                            "text": "这尊纪念石是千岩军竖立的？",
                                                            "response": [
                                                                {
                                                                    "id": "710640129",
                                                                    "speaker": "阿望",
                                                                    "text": "对，当时千岩军和层岩巨渊的矿工们都竖立了纪念石。"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "710640154",
                                            "text": "确实，不许对亡者不敬。",
                                            "response": [
                                                {
                                                    "id": "710640155",
                                                    "speaker": "派蒙",
                                                    "text": "好、好吧…对不起…"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "710640105",
                            "text": "这是什么？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7106412",
            "objective": "test隐藏-收集齐所有的供物$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7106402",
            "objective": "寻找供奉在纪念石前的供物",
            "dialogues": [
                {
                    "id": "710640201",
                    "speaker": "石碑",
                    "text": "（一块小石碑，其上刻文如下…）"
                },
                {
                    "id": "710640202",
                    "speaker": "石碑",
                    "text": "…「层岩巨渊一战，我四肢皆痪，只得口述，托人记录并镌刻于此。」…"
                },
                {
                    "id": "710640203",
                    "speaker": "石碑",
                    "text": "…「鏖战之中，虽讨得一命，每念及殉难同袍，便夙夜难眠。何况留此残躯，真恨不能随诸位同去。」…"
                },
                {
                    "id": "710640204",
                    "speaker": "石碑",
                    "text": "…「自绝无果，帝君得闻，痛加斥詈，如是幡然醒悟。」"
                },
                {
                    "id": "710640205",
                    "speaker": "石碑",
                    "text": "…「可叹帝君仁慈，赐还千岩军兜鍪甲胄，私念无能报效，留之亦为蒙尘，如是放置于此，待有缘人相取。」…"
                },
                {
                    "id": "710640206",
                    "speaker": "石碑",
                    "text": "…「诸位，此生已无机会，便来世再做同袍，届时再共饮一杯盟誓之酒，共抵璃月之敌寇。」…"
                }
            ]
        },
        {
            "id": "7106403",
            "objective": "寻找供奉在纪念石前的供物",
            "dialogues": [
                {
                    "id": "710640301",
                    "speaker": "阿望",
                    "text": "没想到真的让你给找到了…这就是「千岩军的宝藏」吗…？"
                },
                {
                    "id": "710640302",
                    "speaker": "阿望",
                    "text": "虽然不知道里面有什么，不过…那份宝藏能够被你找到，当年留下那份宝藏的千岩军恐怕也很欣慰吧。"
                },
                {
                    "id": "710640303",
                    "speaker": "阿望",
                    "text": "离那场灾厄已经五百年了，一想到五百年前，这里是水深火热的战场，而无数先烈在此牺牲，就让人不禁疑问…"
                },
                {
                    "id": "710640304",
                    "speaker": "阿望",
                    "text": "在那个年代，随岩王爷征战的无数凡民，他们中的某一位，也会认为自己在参与一项被后人铭记千百年的事业吗？"
                },
                {
                    "id": "710640305",
                    "speaker": "阿望",
                    "text": "他们不会对自己的职责产生片刻的怀疑吗…？那些没能获得「神之眼」的凡人，如何忠诚于一个未曾注视他们的神，至死方休呢？",
                    "choices": [
                        {
                            "id": "710640306",
                            "text": "因为神从未远离他们身边。",
                            "response": [
                                {
                                    "id": "710640308",
                                    "speaker": "阿望",
                                    "text": "……"
                                },
                                {
                                    "id": "710640309",
                                    "speaker": "阿望",
                                    "text": "嗯，你说的没错。有「神之眼」也好，没有也好…人总还是要为了无穷可能的未来而努力的。这就是动力嘛。"
                                },
                                {
                                    "id": "710640310",
                                    "speaker": "阿望",
                                    "text": "我们也是一样，不是为了过去的好日子，也不是为了当今的自我实现…而是为了彼此扶持，一同在时代中留下自己的痕迹与声音。"
                                },
                                {
                                    "id": "710640311",
                                    "speaker": "阿望",
                                    "text": "或许很久以后，层岩巨渊也会成为我们的纪念碑吧。"
                                },
                                {
                                    "id": "710640314",
                                    "speaker": "阿望",
                                    "text": "这满坑满谷刀削斧凿的痕迹，一代代矿工挥洒的汗水…同样见证着我们选择的艰辛之路。"
                                },
                                {
                                    "id": "710640312",
                                    "speaker": "阿望",
                                    "text": "就像这块纪念石一样，将来百年，不，将来千年都会竖立在此，证明将士们的牺牲没有被记忆辜负。"
                                },
                                {
                                    "id": "710640313",
                                    "speaker": "阿望",
                                    "text": "嘿嘿，虽然我肯定看不到了…但到那时候，希望也会有人来此为我们这些穷矿工酌上苦酒一杯，我也就心满意足了。"
                                }
                            ]
                        },
                        {
                            "id": "710640307",
                            "text": "他们也是忠于自己的选择。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7106404",
            "objective": "寻找供奉在纪念石前的供物",
            "dialogues": [
                {
                    "id": "710640401",
                    "speaker": "阿望",
                    "text": "需要找到的供物分别是「冠」、「羽」、「杯」、「晷」、「花」和「枪」。"
                },
                {
                    "id": "710640402",
                    "speaker": "阿望",
                    "text": "不过时至今日也没人全都找到过…"
                }
            ]
        },
        {
            "id": "7106405",
            "objective": "寻找供奉在纪念石前的供物",
            "dialogues": [
                {
                    "id": "710640501",
                    "speaker": "阿望",
                    "text": "听说「远眺之花」只会与那些看似疯狂的高远愿望作伴，所以才会为凡人所远…哼…会是什么样的花朵呢…？"
                }
            ]
        },
        {
            "id": "7106406",
            "objective": "寻找供奉在纪念石前的供物",
            "dialogues": [
                {
                    "id": "710640601",
                    "speaker": "阿望",
                    "text": "听说「高翔之翎」只会在某处山巅的飞鹰身上取得…但长这么大，我还没见过能从鹰隼身上拔取羽毛的侠客呢…"
                }
            ]
        },
        {
            "id": "7106407",
            "objective": "寻找供奉在纪念石前的供物",
            "dialogues": [
                {
                    "id": "710640701",
                    "speaker": "阿望",
                    "text": "听说「岁时之晷」将会为普罗之众铭记，即便暂时经历寂寞，也不会失却光泽…或许它从来没有被人遗失呢？"
                }
            ]
        },
        {
            "id": "7106413",
            "objective": "test隐藏-回滚隔离$HIDDEN",
            "dialogues": [
                {
                    "id": "710641301",
                    "speaker": "阿望",
                    "text": "需要找到的供物分别是「冠」、「羽」、「杯」、「晷」、「花」和「枪」。"
                },
                {
                    "id": "710641302",
                    "speaker": "阿望",
                    "text": "不过时至今日也没人全都找到过…"
                }
            ]
        },
        {
            "id": "7106408",
            "objective": "在纪念石前献上供物",
            "dialogues": [
                {
                    "id": "710640801",
                    "speaker": "阿望",
