            "objective": "与奥妮对话",
            "dialogues": []
        },
        {
            "id": "7602407",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "760240701",
                    "speaker": "奥妮",
                    "text": "大家都还在，也没有变成没有影子的鼹鼠，太好了。"
                }
            ]
        },
        {
            "id": "7602408",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "760240801",
                    "speaker": "奥妮",
                    "text": "对了，还得举办葬礼，要不要邀请海螺帮的其他人呢…",
                    "choices": [
                        {
                            "id": "760240802",
                            "text": "关于海螺帮…",
                            "response": [
                                {
                                    "id": "760240803",
                                    "speaker": "奥妮",
                                    "text": "你也想要加入吗？那就去找尤尔瓦哥哥吧，他在「斯佩兰扎」。唔，如果要投票的话，赫卡不在呢。"
                                },
                                {
                                    "id": "760240804",
                                    "speaker": "奥妮",
                                    "text": "不过没关系，尤尔瓦哥哥肯定有别的办法。"
                                }
                            ]
                        },
                        {
                            "id": "760240805",
                            "text": "关于嗅嗅鼹鼠…",
                            "response": [
                                {
                                    "id": "760240806",
                                    "speaker": "奥妮",
                                    "text": "我猜是因为它们一直和人生活在一起，所以有些行为也像人一样了。盗宝鼬也是这样，听说纳塔的龙也是这样。"
                                },
                                {
                                    "id": "760240807",
                                    "speaker": "奥妮",
                                    "text": "不过，这到底是好事还是坏事呢…"
                                }
                            ]
                        },
                        {
                            "id": "760240808",
                            "text": "再见。",
                            "response": [
                                {
                                    "id": "760240809",
                                    "speaker": "奥妮",
                                    "text": "路上要小心哦。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
