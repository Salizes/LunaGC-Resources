    "talks": [
        {
            "id": "7602406",
            "objective": "炮台显示，完成后隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "760240601",
                    "speaker": "奥妮",
                    "text": "我猜，盗宝鼬大哥是想学那些大个子，想把莫雷一家都变成他们三个的手下。"
                },
                {
                    "id": "760240602",
                    "speaker": "奥妮",
                    "text": "不过就像大个子都失败了一样，盗宝鼬大哥他们大概也失败了吧。就算莫雷谷被盗宝鼬弄得稀巴烂，他们也只是躲在洞里而已。",
                    "choices": [
                        {
                            "id": "760240603",
                            "text": "也不能对鼹鼠要求太高了。",
                            "response": [
                                {
                                    "id": "760240604",
                                    "speaker": "派蒙",
                                    "text": "毕竟只是嗅嗅鼹鼠…而且盗宝鼬还有危险的武器呢！虽然不管怎么想，盗宝鼬会操作那么危险的机器也太离谱了。"
                                },
                                {
                                    "id": "760240607",
                                    "speaker": "奥妮",
                                    "text": "现在莫雷谷又属于莫雷爷爷一家了，之前说好的摩拉给你们，谢谢你们帮忙。"
                                },
                                {
                                    "id": "760240608",
                                    "speaker": "奥妮",
                                    "text": "对了，这个也给你们好了。赫卡说虚构作品不要放进她的小册子里，不然就分不清谁是真的谁是假的了。"
                                },
                                {
                                    "id": "760240609",
                                    "speaker": "奥妮",
                                    "text": "我觉得明明就没有关系…就算是假的，里面也有真的，不是吗。"
                                },
                                {
                                    "id": "760240610",
                                    "speaker": "奥妮",
                                    "text": "#{NICKNAME}{M#哥哥}{F#姐姐}还有派蒙妹妹，那就再见啦。如果下次盗宝鼬大哥又做了什么，我还会找你们帮忙的。"
                                },
                                {
                                    "id": "760240611",
                                    "speaker": "派蒙",
                                    "text": "#{NICKNAME}，看来我们有了不错的口碑呢，嘿嘿。不过它们最好是不要再闹出什么事了！奥妮一个人也要小心一点哦。"
                                },
                                {
                                    "id": "760240612",
                                    "speaker": "奥妮",
                                    "text": "#嗯，{NICKNAME}{M#哥哥}{F#姐姐}和派蒙妹妹也一路顺风。"
                                }
                            ]
                        },
                        {
                            "id": "760240605",
                            "text": "这次也在依靠人类呢。",
                            "response": [
                                {
                                    "id": "760240606",
                                    "speaker": "派蒙",
                                    "text": "毕竟只是嗅嗅鼹鼠嘛…而且如果换个思路想想，盗宝鼬会操作危险的机器原本也是因为人类…人类解决人类的问题，这很合理！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7602414",
            "objective": "与小女孩对话",
            "dialogues": [
                {
                    "id": "760240501",
                    "speaker": "Black Screen",
                    "text": "虽然不明所以，但总之先来到了小女孩身边…"
                },
                {
                    "id": "760240502",
                    "speaker": "？？？",
                    "text": "要小心那些盗宝鼬，它们占据莫雷谷已经有些日子了，如果被打到的话，你们也会变成没有影子的人的。"
                },
                {
                    "id": "760240503",
                    "speaker": "派蒙",
                    "text": "盗宝鼬？哪里有盗宝鼬？还有没有影子的人又是说的什…"
                },
                {
                    "id": "760240504",
                    "speaker": "派蒙",
                    "text": "呜哇！那个机器是怎么回事？是盗宝鼬在操作机器攻击我们吗？"
                },
                {
                    "id": "760240505",
                    "speaker": "？？？",
                    "text": "它们是人养的，说不定比人还聪明呢。因为比人聪明，所以才把那些大个子都赶走了吧。"
                },
                {
                    "id": "760240506",
                    "speaker": "？？？",
                    "text": "大个子他们也试过，不过都失败了。说是只要<color=#00E1FFFF>把蓄能核心取走</color>就行了，但是总是败在最后一步。看来也没有说的那么容易嘛。"
                },
                {
                    "id": "760240507",
                    "speaker": "派蒙",
                    "text": "#唔，所以说，只要把蓄能核心取走就可以制止盗宝鼬了对吧？{NICKNAME}，要不我们试试看？"
                },
                {
                    "id": "760240508",
                    "speaker": "派蒙",
                    "text": "不然放着不管的话，也太危险啦，还有这么小的小孩子在这里呢。"
                },
                {
                    "id": "760240509",
                    "speaker": "Player",
                    "text": "既然是派蒙的请求，当然没问题。"
                },
                {
                    "id": "760240510",
                    "speaker": "派蒙",
                    "text": "那小妹妹就先在这里躲一下…对了，你叫什么名字呀？"
                },
                {
                    "id": "760240511",
                    "speaker": "奥妮",
                    "text": "可是…不是说最小的那个才是妹妹吗？搞不懂…我叫奥妮，我觉得你应该叫我奥妮姐姐，不然就不对了。"
                },
                {
                    "id": "760240512",
                    "speaker": "派蒙",
                    "text": "#呃…称呼的问题先放一边！{NICKNAME}，我们先去制止盗宝鼬吧！"
                }
            ]
        },
        {
            "id": "7602401",
            "objective": "取走「蓄能核心」",
            "dialogues": [
                {
                    "id": "760240101",
                    "speaker": "派蒙",
                    "text": "哼，这下总该束手就擒了吧！"
                },
                {
                    "id": "760240102",
                    "speaker": "奥妮",
                    "text": "我还是第一次这么近看盗宝鼬大哥…派蒙妹妹也得叫他大哥呢。"
                },
                {
                    "id": "760240115",
                    "speaker": "派蒙",
                    "text": "什…我才不要叫坏蛋盗宝鼬大哥啦！"
                },
                {
                    "id": "760240118",
                    "speaker": "奥妮",
                    "text": "说的也是，坏孩子是不可以当哥哥的。也不会有人参加他的葬礼…应该也不会办葬礼吧。"
                },
                {
                    "id": "760240132",
                    "speaker": "奥妮",
                    "text": "对了，以前听赫卡说过，好像有些怪人喜欢吃奇怪的肉，其中就有盗宝鼬，还有喜欢收藏标本的人…"
                },
                {
                    "id": "760240133",
                    "speaker": "奥妮",
                    "text": "这么一想，不管是做成标本还是吃掉，都不需要葬礼了呢。"
                },
                {
                    "id": "760240134",
                    "speaker": "派蒙",
                    "text": "呜哇…奥妮好像若无其事地在说一些很可怕的事…"
                },
                {
                    "id": "760240135",
                    "speaker": "「盗宝鼬大哥」",
                    "text": "（十分害怕的样子…）"
                },
                {
                    "id": "760240136",
                    "speaker": "派蒙",
                    "text": "等一下，别想跑！"
                },
                {
                    "id": "760240137",
                    "speaker": "派蒙",
                    "text": "欸？好像不是逃跑，是在那边等我们吗？那我们过去看看好了。"
                }
            ]
        },
        {
            "id": "7602402",
            "objective": "与奥妮对话",
            "dialogues": [
                {
                    "id": "760240201",
                    "speaker": "奥妮",
                    "text": "#{NICKNAME}{M#哥哥}{F#姐姐}比那些大个子更厉害啊，原来不是个头越大越厉害喔。"
                },
                {
                    "id": "760240202",
                    "speaker": "派蒙",
                    "text": "#哼哼，是吧？{NICKNAME}虽然个子不高，但是就算对付大过自己几倍的魔物也不在话下呢。",
                    "choices": [
                        {
                            "id": "760240203",
                            "text": "哪里哪里，比起派蒙还是略逊一筹。",
                            "response": [
                                {
                                    "id": "760240204",
                                    "speaker": "派蒙",
                                    "text": "欸？就、就算你这么夸我…好吧，下次有什么好吃的，分给你的那一半一定多分一点！"
                                },
                                {
                                    "id": "760240206",
                                    "speaker": "奥妮",
                                    "text": "#那{NICKNAME}{M#哥哥}{F#姐姐}肯定可以把盗宝鼬大哥也赶出莫雷谷吧？这里又不是他们的家，却被他们搞得一团乱。"
                                },
                                {
                                    "id": "760240207",
                                    "speaker": "奥妮",
                                    "text": "原本要办的葬礼也办不了，莫雷爷爷说不定也被他们害死啦，不过就算要举办新的葬礼，也得先找到他们一家才行。"
                                },
                                {
                                    "id": "760240208",
                                    "speaker": "派蒙",
                                    "text": "欸？！盗宝鼬居然…不过你说的葬礼，之前没来得及问，不、不会真的有人要在这里举办葬礼吧？为什么会选在这里…"
                                },
                                {
                                    "id": "760240209",
                                    "speaker": "奥妮",
                                    "text": "当然要的，我都准备好了，葬礼时要唱的歌也想好了。喏，给你们看看，不过要小声一点，让他安静地休息。"
                                },
                                {
                                    "id": "760240210",
                                    "speaker": "Black Screen",
                                    "text": "奥妮从口袋里掏出一个小小的火柴盒，打开之后，在一块小小的花色衬布上躺着一只颜色漂亮的小小甲虫，周围还妆点了若干白色的花瓣…"
                                },
                                {
                                    "id": "760240211",
                                    "speaker": "奥妮",
                                    "text": "因为他已经永远地休息了，所以要给他举办葬礼。不过我选好的地方都被盗宝鼬占掉了，就是那些有机器的小丘。"
                                },
                                {
                                    "id": "760240212",
                                    "speaker": "奥妮",
                                    "text": "莫雷爷爷一家如果不是逃掉了，就是死掉了吧。他们的家就这样被盗宝鼬糟蹋啦。"
                                },
                                {
                                    "id": "760240213",
                                    "speaker": "派蒙",
                                    "text": "#（{NICKNAME}，你说奥妮说的莫雷爷爷，该不会是…）",
                                    "choices": [
                                        {
                                            "id": "760240214",
                                            "text": "（应该是什么小动物吧。）",
                                            "response": [
                                                {
                                                    "id": "760240215",
                                                    "speaker": "派蒙",
                                                    "text": "（嗯，我觉得也是，可能是她的动物朋友呢。）"
                                                },
                                                {
                                                    "id": "760240218",
                                                    "speaker": "派蒙",
                                                    "text": "嗯，既然是这样，要不我们来帮奥妮逮住做坏事的盗宝鼬吧！至于莫雷爷爷一家…等逮住盗宝鼬之后我们再一起找找看好了。"
                                                },
                                                {
                                                    "id": "760240219",
                                                    "speaker": "奥妮",
                                                    "text": "#哇，{NICKNAME}{M#哥哥}{F#姐姐}，派蒙妹妹，你们真好，我会邀请你们来参加葬礼的。"
                                                },
                                                {
                                                    "id": "760240220",
                                                    "speaker": "派蒙",
                                                    "text": "那、那倒也不用…"
                                                },
                                                {
                                                    "id": "760240221",
                                                    "speaker": "奥妮",
                                                    "text": "好吧。那就，之前买的糖雕…咦，原来已经没有了。"
                                                },
                                                {
                                                    "id": "760240222",
                                                    "speaker": "奥妮",
                                                    "text": "不过尤尔瓦哥哥给的零花钱还有。唔，那就给你们零花钱，你们自己去买糖雕吃吧。"
                                                },
                                                {
                                                    "id": "760240223",
                                                    "speaker": "奥妮",
                                                    "text": "拜托别人帮忙，要付报酬，还要说谢谢，这样才是对的。嗯。",
                                                    "choices": [
                                                        {
                                                            "id": "760240224",
                                                            "text": "派蒙居然要从小孩手里抢糖…",
                                                            "response": [
                                                                {
                                                                    "id": "760240225",
                                                                    "speaker": "派蒙",
                                                                    "text": "怎么说得我好像是什么大坏蛋一样！不过奥妮年纪这么小，却很有礼貌呢。"
                                                                },
                                                                {
                                                                    "id": "760240227",
                                                                    "speaker": "奥妮",
                                                                    "text": "谢谢你夸我，但是一人一个糖雕的摩拉，夸我也没有更多了。"
                                                                },
                                                                {
                                                                    "id": "760240228",
                                                                    "speaker": "派蒙",
                                                                    "text": "这种地方倒是很现实…对了，听你刚才的说法，干坏事的盗宝鼬应该不止一只吧？"
                                                                },
                                                                {
                                                                    "id": "760240229",
                                                                    "speaker": "奥妮",
                                                                    "text": "嗯。刚才逃跑的那只不是我之前见过的盗宝鼬大哥，他有多少小弟，我也不知道。"
                                                                },
                                                                {
                                                                    "id": "760240230",
                                                                    "speaker": "奥妮",
                                                                    "text": "但是那边也有和这边一样的会发射子弹的机器爪子，说不定能在那边找到盗宝鼬小弟。"
                                                                },
                                                                {
                                                                    "id": "760240231",
                                                                    "speaker": "派蒙",
                                                                    "text": "#好哦，这次可不能再让盗宝鼬逃跑了！{NICKNAME}，我们去教训一下那些坏盗宝鼬吧！"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "760240226",
                                                            "text": "奥妮好懂礼貌哦。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "760240216",
                                            "text": "（可能是原来住在这里的人吧。）",
                                            "response": [
                                                {
                                                    "id": "760240217",
                                                    "speaker": "派蒙",
                                                    "text": "（欸？这里看起来不像有人长期居住的样子…我觉得说不定是奥妮的动物朋友！你看，她还会给甲虫举办葬礼呢。）"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "760240205",
                            "text": "对付小只的魔物也不会手软！"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7602403",
            "objective": "取走「蓄能核心」",
            "dialogues": [
                {
                    "id": "760240301",
                    "speaker": "奥妮",
                    "text": "埋在海边好呢，还是小丘的顶上…"
                }
            ]
        },
        {
            "id": "7602404",
            "objective": "与奥妮对话",
            "dialogues": [
                {
                    "id": "760240401",
                    "speaker": "派蒙",
                    "text": "话说回来，刚刚才注意到盗宝鼬逃跑的方向好像都是那边的小丘…"
                },
                {
                    "id": "760240402",
                    "speaker": "奥妮",
                    "text": "是呢，那也是训练盗宝鼬大哥他们的大个子带来的东西，之前盗宝鼬大哥用它打大个子他们，打得他们又是爬又是滚的。",
                    "choices": [
                        {
                            "id": "760240403",
                            "text": "好难想象的画面。",
                            "response": [
                                {
                                    "id": "760240406",
                                    "speaker": "派蒙",
                                    "text": "#唔，那我们就去小丘那儿调查看看吧，不过说不定盗宝鼬会在那里埋伏，{NICKNAME}也要小心一点不要又滚又爬哦！"
                                }
                            ]
                        },
                        {
                            "id": "760240404",
                            "text": "可恶，要是我在现场的话…",
                            "response": [
                                {
                                    "id": "760240405",
                                    "speaker": "派蒙",
                                    "text": "你要去帮他们吗？…不对，你该不会只是想看热闹吧！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7602405",
            "objective": "让危险装置的首脑停止攻击",
            "dialogues": []
        },
        {
            "id": "7602411",
            "objective": "抓住盗宝鼬",
            "dialogues": [
                {
                    "id": "760241001",
                    "speaker": "派蒙",
                    "text": "好啦，你们束手…"
                },
                {
                    "id": "760241003",
                    "speaker": "派蒙",
                    "text": "欸？！怎么全跑了！还是往不同的方向！"
                },
                {
                    "id": "760241002",
                    "speaker": "派蒙",
                    "text": "#{NICKNAME}、奥妮，我们一人一只，这次一定要逮到它们！"
                }
            ]
        },
        {
            "id": "7602423",
            "objective": "抓住盗宝鼬",
            "dialogues": []
        },
        {
            "id": "7602419",
            "objective": "与奥妮对话",
            "dialogues": []
        },
        {
            "id": "7602412",
            "objective": "跟上盗宝鼬",
            "dialogues": []
        },
        {
            "id": "7602413",
            "objective": "深入洞穴",
            "dialogues": []
        },
        {
            "id": "7602415",
            "objective": "继续深入洞穴",
            "dialogues": [
                {
                    "id": "760241501",
                    "speaker": "奥妮",
                    "text": "哇，是莫雷一家，爷爷、爸爸妈妈、小莫雷还有小小莫雷…还有其他莫雷都在，一个都没少呢。"
                },
                {
                    "id": "760241502",
                    "speaker": "派蒙",
                    "text": "原来是嗅嗅鼹鼠呀！不过奥妮是怎么分辨它们的？它们看起来全都一个样…"
                },
                {
                    "id": "760241503",
                    "speaker": "奥妮",
                    "text": "他们每个性格都不一样，相处得久了就知道了。"
                },
                {
                    "id": "760241504",
                    "speaker": "奥妮",
                    "text": "不过他们都有的坏习惯就是向人乞讨，唉，真是可怜的动物，要是人类灭绝了，他们该怎么办呢。"
                },
                {
                    "id": "760241505",
                    "speaker": "派蒙",
                    "text": "…人类灭绝？而且在那之后嗅嗅鼹鼠还在吗？应、应该不会吧？"
                },
                {
                    "id": "760241506",
                    "speaker": "奥妮",
                    "text": "莉奈娅姐姐说过，动物是会灭绝的，因为各种各样的原因。那人类当然也有可能会灭绝的，派蒙妹妹为什么觉得不会呢？",
                    "choices": [
                        {
                            "id": "760241507",
                            "text": "我应该会比鼹鼠活得长久一点…",
                            "response": [
                                {
                                    "id": "760241508",
                                    "speaker": "派蒙",
                                    "text": "不过这样也回答不了奥妮的问题吧。唔，这么一想，人类的处境还真是危险呢，有那么多会威胁到人类生存的东西…"
                                },
                                {
                                    "id": "760241512",
                                    "speaker": "派蒙",
                                    "text": "不过话说回来，既然鼹鼠一家都找到了，那这三只盗宝鼬该怎么处理呢？"
                                },
                                {
                                    "id": "760241513",
                                    "speaker": "奥妮",
                                    "text": "不知道该怎么办的话，就交给「旗舰」的人好了…"
                                },
                                {
                                    "id": "760241514",
                                    "speaker": "派蒙",
                                    "text": "宝箱！呃，还是说这种情况应该说是贿赂？不管了，既然是给我们的，那我们就收下啦。"
                                },
                                {
                                    "id": "760241515",
                                    "speaker": "派蒙",
                                    "text": "#看它们的样子，应该是知道错了。{NICKNAME}，这次我们就放过它们吧。当、当然不是完全看在宝箱的份上啦！"
                                }
                            ]
                        },
                        {
                            "id": "760241509",
                            "text": "据说有昆虫在人类诞生之前就存在…",
                            "response": [
                                {
                                    "id": "760241510",
                                    "speaker": "Player",
                                    "text": "人类灭绝之后它们大概还会在的。"
                                },
                                {
                                    "id": "760241511",
                                    "speaker": "派蒙",
                                    "text": "居然还要输给昆虫吗…有种好不甘心的感觉！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
