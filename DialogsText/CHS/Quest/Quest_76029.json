    },
    "talks": [
        {
            "id": "7602901",
            "objective": "同「少女」见面",
            "dialogues": [
                {
                    "id": "760290101",
                    "speaker": "「少女」",
                    "text": "你们好。"
                },
                {
                    "id": "760290102",
                    "speaker": "派蒙",
                    "text": "咦？哥伦比娅你要出门吗？"
                },
                {
                    "id": "760290103",
                    "speaker": "「少女」",
                    "text": "嗯，出去修琴。"
                },
                {
                    "id": "760290104",
                    "speaker": "派蒙",
                    "text": "…什么？"
                },
                {
                    "id": "760290105",
                    "speaker": "「少女」",
                    "text": "有只月灵的琴坏了，它很珍惜这琴，我想帮它修好。"
                },
                {
                    "id": "760290106",
                    "speaker": "派蒙",
                    "text": "月灵们还真是多才多艺…"
                },
                {
                    "id": "760290107",
                    "speaker": "「少女」",
                    "text": "嗯，它经常在这里弹琴，我偶尔也会和着琴声唱歌。"
                },
                {
                    "id": "760290108",
                    "speaker": "派蒙",
                    "text": "我之前就这么觉得了，你还真是宠月灵呢。"
                },
                {
                    "id": "760290109",
                    "speaker": "「少女」",
                    "text": "它们一直陪着我，还经常给我带好玩的东西回来。"
                },
                {
                    "id": "760290110",
                    "speaker": "Player",
                    "text": "（菈乌玛说过，这是因为月灵想让月神开心的天性使然吧。）"
                },
                {
                    "id": "760290111",
                    "speaker": "派蒙",
                    "text": "不过我问一句，你打算怎么修好这琴呀？你不是说自己不能被别人看到吗？"
                },
                {
                    "id": "760290112",
                    "speaker": "「少女」",
                    "text": "唔…以前我会拜托小动物或者月灵，让它们把要修的东西放到工匠家门口。"
                },
                {
                    "id": "760290113",
                    "speaker": "「少女」",
                    "text": "工匠发现后，一般都会顺手把东西修好。不过有时也会发现不了，要等几天。"
                },
                {
                    "id": "760290114",
                    "speaker": "派蒙",
                    "text": "听起来有些周折呢…"
                },
                {
                    "id": "760290115",
                    "speaker": "Player",
                    "text": "不如交给我们吧。"
                },
                {
                    "id": "760290116",
                    "speaker": "「少女」",
                    "text": "……"
                },
                {
                    "id": "760290117",
                    "speaker": "派蒙",
                    "text": "放心吧，我们去的话说不定今天就能修好呢。"
                },
                {
                    "id": "760290118",
                    "speaker": "「少女」",
                    "text": "…好吧。谢谢。"
                },
                {
                    "id": "760290119",
                    "speaker": "派蒙",
                    "text": "别客气。顺带一提，你一般放在哪个工匠的家门口呀？"
                },
                {
                    "id": "760290120",
                    "speaker": "「少女」",
                    "text": "我不知道她名字。她家门口有个大大的机械手，住在一个圆圆的，像海螺一样的家里。"
                },
                {
                    "id": "760290121",
                    "speaker": "Player",
                    "text": "（难道说是…）"
                },
                {
                    "id": "760290122",
                    "speaker": "「少女」",
                    "text": "里面还经常传来蛋卷的香味。"
                },
                {
                    "id": "760290123",
                    "speaker": "派蒙",
                    "text": "我好像知道是谁了…"
                }
            ]
        },
        {
            "id": "7602902",
            "objective": "前往叮铃哐啷蛋卷工坊",
            "dialogues": [
                {
                    "id": "760290201",
                    "speaker": "派蒙",
                    "text": "爱诺！你在家吗？"
                },
                {
                    "id": "760290202",
                    "speaker": "爱诺",
                    "text": "哇！是派蒙的声音！"
                },
                {
                    "id": "760290203",
                    "speaker": "爱诺",
                    "text": "你们好呀！是带着零食来看望爱诺的吗？"
                },
                {
                    "id": "760290204",
                    "speaker": "派蒙",
                    "text": "就知道你会这么说，喏，来的路上就为你准备好了。"
                },
                {
                    "id": "760290205",
                    "speaker": "爱诺",
                    "text": "快给我快给我，等下伊涅芙就要回来了。"
                },
                {
                    "id": "760290206",
                    "speaker": "爱诺",
                    "text": "那么今天要和爱诺一起玩什么呢？"
                },
                {
                    "id": "760290207",
                    "speaker": "派蒙",
                    "text": "嘿嘿…实际上，有件事情想拜托爱诺…"
                },
                {
                    "id": "760290208",
                    "speaker": "爱诺",
                    "text": "呜哇！拿…拿走拿走！快把那怪东西拿走！"
                },
                {
                    "id": "760290209",
                    "speaker": "派蒙",
                    "text": "怪东西？是说这琴吗？"
                },
                {
                    "id": "760290210",
                    "speaker": "爱诺",
                    "text": "说了我讨厌用科学和机械原理解释不通的东西…"
                },
                {
                    "id": "760290211",
                    "speaker": "爱诺",
                    "text": "那个琴隔三差五就会出现在我家门口，但我每次把它修好后，它又会莫名其妙地不见了！"
                },
                {
                    "id": "760290212",
                    "speaker": "爱诺",
                    "text": "我…我才不信有这种神神鬼鬼的东西呢！"
                },
                {
                    "id": "760290213",
                    "speaker": "派蒙",
                    "text": "啊…看来这其中有些误会呢…"
                },
                {
                    "id": "760290214",
                    "speaker": "爱诺",
                    "text": "误会？",
                    "choices": [
                        {
                            "id": "760290215",
                            "text": "这是一位朋友的琴…",
                            "response": [
                                {
                                    "id": "760290217",
                                    "speaker": "派蒙",
                                    "text": "嗯，她其实没有恶意啦，每次悄悄拿走，也有些缘由在…"
                                },
                                {
                                    "id": "760290218",
                                    "speaker": "爱诺",
                                    "text": "真的吗？你们没在骗我哦。"
                                },
                                {
                                    "id": "760290219",
                                    "speaker": "爱诺",
                                    "text": "那…那我就信你们，再修一次…这次就修得彻底一点…"
                                },
                                {
                                    "id": "760290220",
                                    "speaker": "爱诺",
                                    "text": "你们在这里等一下哦。"
                                },
                                {
                                    "id": "760290221",
                                    "speaker": "派蒙",
                                    "text": "爱诺还是挺可靠的呀，就是被悄悄放东西的行为吓到有些可怜…"
                                },
                                {
                                    "id": "760290222",
                                    "speaker": "「少女」",
                                    "text": "的确该回报她一下。"
                                },
                                {
                                    "id": "760290223",
                                    "speaker": "派蒙",
                                    "text": "嗯嗯…呃啊！你怎么突然出现在这里啦！这次是吓到我们啦！"
                                },
                                {
                                    "id": "760290224",
                                    "speaker": "「少女」",
                                    "text": "给你们点东西就回去。"
                                },
                                {
                                    "id": "760290225",
                                    "speaker": "派蒙",
                                    "text": "嗯？这是什么？"
                                },
                                {
                                    "id": "760290226",
                                    "speaker": "「少女」",
                                    "text": "是月灵收集的一些「宝物」，它想要谢谢这位工匠，觉得她会喜欢。"
                                },
                                {
                                    "id": "760290227",
                                    "speaker": "派蒙",
                                    "text": "哦~好多稀奇古怪的零件呢。好吧，我们收到了，待会儿就转交给爱诺。"
                                },
                                {
                                    "id": "760290228",
                                    "speaker": "派蒙",
                                    "text": "你回去的路上也要小心哦，别被人看见了。"
                                },
                                {
                                    "id": "760290229",
                                    "speaker": "Player",
                                    "text": "……"
                                },
                                {
                                    "id": "760290230",
                                    "speaker": "Player",
                                    "text": "派蒙…"
                                },
                                {
                                    "id": "760290231",
                                    "speaker": "派蒙",
                                    "text": "嗯？怎么了？"
                                },
                                {
                                    "id": "760290232",
                                    "speaker": "Player",
                                    "text": "那边…"
                                },
                                {
                                    "id": "760290233",
                                    "speaker": "派蒙",
                                    "text": "……！"
                                },
                                {
                                    "id": "760290234",
                                    "speaker": "伊涅芙",
                                    "text": "……"
                                },
                                {
                                    "id": "760290235",
                                    "speaker": "「少女」",
                                    "text": "……"
                                },
                                {
                                    "id": "760290236",
                                    "speaker": "伊涅芙",
                                    "text": "…相似度比对中…"
                                },
                                {
                                    "id": "760290237",
                                    "speaker": "派蒙",
                                    "text": "在和什么比对啦！"
                                },
                                {
                                    "id": "760290238",
                                    "speaker": "伊涅芙",
                                    "text": "与挪德卡莱月神像的人物相似度…百分之九十五…",
                                    "choices": [
                                        {
                                            "id": "760290239",
                                            "text": "是…是演员！",
                                            "response": [
                                                {
                                                    "id": "760290240",
                                                    "speaker": "伊涅芙",
                                                    "text": "#检测到{NICKNAME}的心率上升…"
                                                },
                                                {
                                                    "id": "760290243",
                                                    "speaker": "爱诺",
                                                    "text": "修好啦！这次应该再也不会坏了，顺带一提刚才的零…伊…伊涅芙！"
                                                },
                                                {
                                                    "id": "760290244",
                                                    "speaker": "伊涅芙",
                                                    "text": "刚才的零…"
                                                },
                                                {
                                                    "id": "760290245",
                                                    "speaker": "爱诺",
                                                    "text": "刚才的零件也很管用！"
                                                },
                                                {
                                                    "id": "760290246",
                                                    "speaker": "伊涅芙",
                                                    "text": "……？"
                                                },
                                                {
                                                    "id": "760290247",
                                                    "speaker": "爱诺",
                                                    "text": "嗯？你们身后这位是？"
                                                },
                                                {
                                                    "id": "760290248",
                                                    "speaker": "「少女」",
                                                    "text": "……",
                                                    "choices": [
                                                        {
                                                            "id": "760290249",
                                                            "text": "是琴的委托人！",
                                                            "response": [
                                                                {
                                                                    "id": "760290251",
                                                                    "speaker": "爱诺",
                                                                    "text": "（总觉得有些眼熟…我在哪里见过这位姐姐吗？不管了，这不重要。派蒙给我的零食应该藏好了吧…）"
                                                                },
                                                                {
                                                                    "id": "760290252",
                                                                    "speaker": "派蒙",
                                                                    "text": "对…对！这些零件也是她送过来的，说是想感谢爱诺你帮忙修琴。"
                                                                },
                                                                {
                                                                    "id": "760290253",
                                                                    "speaker": "爱诺",
                                                                    "text": "嗯？我看看…哇！都是些古老的稀有零件欸！真的可以收下吗！"
                                                                },
                                                                {
                                                                    "id": "760290254",
                                                                    "speaker": "「少女」",
                                                                    "text": "…嗯。"
                                                                },
                                                                {
                                                                    "id": "760290255",
                                                                    "speaker": "爱诺",
                                                                    "text": "谢谢你！以后有什么要修的东西也可以来找我哦！"
                                                                },
                                                                {
                                                                    "id": "760290256",
                                                                    "speaker": "伊涅芙",
                                                                    "text": "……"
                                                                },
                                                                {
                                                                    "id": "760290257",
                                                                    "speaker": "派蒙",
                                                                    "text": "呃…那，那我们差不多回去了。爱诺，伊涅芙，我们改天再找你们玩哦！"
                                                                },
                                                                {
                                                                    "id": "760290258",
                                                                    "speaker": "派蒙",
                                                                    "text": "（得赶快带「少女」离开，不然伊涅芙要认出来了！）"
                                                                },
                                                                {
                                                                    "id": "760290259",
                                                                    "speaker": "爱诺",
                                                                    "text": "好…好呀！那就改天见！"
                                                                },
                                                                {
                                                                    "id": "760290260",
                                                                    "speaker": "爱诺",
                                                                    "text": "（得赶快回去收拾一下，不然伊涅芙要发现零食屑了！）"
                                                                },
                                                                {
                                                                    "id": "760290261",
                                                                    "speaker": "伊涅芙",
                                                                    "text": "好，二位再见。"
                                                                },
                                                                {
                                                                    "id": "760290262",
                                                                    "speaker": "伊涅芙",
                                                                    "text": "…爱诺。"
                                                                },
                                                                {
                                                                    "id": "760290263",
                                                                    "speaker": "爱诺",
                                                                    "text": "怎…怎么了？"
                                                                },
                                                                {
                                                                    "id": "760290264",
                                                                    "speaker": "伊涅芙",
                                                                    "text": "这些零件需要供起来吗？"
                                                                },
                                                                {
                                                                    "id": "760290265",
                                                                    "speaker": "爱诺",
                                                                    "text": "啊？为什么？"
                                                                },
                                                                {
                                                                    "id": "760290266",
                                                                    "speaker": "伊涅芙",
                                                                    "text": "它们好像是「月神的赠物」。"
                                                                },
                                                                {
                                                                    "id": "760290267",
                                                                    "speaker": "爱诺",
                                                                    "text": "呃，伊涅芙你在说什么…我等下帮你检查检查线路吧…"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "760290250",
                                                            "text": "是怕生的客户！"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "760290241",
                                            "text": "有…有误差！",
                                            "response": [
                                                {
                                                    "id": "760290242",
                                                    "speaker": "伊涅芙",
                                                    "text": "误差范围较小，推断结论可靠…"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "760290216",
                            "text": "那个朋友有些怕生…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7602903",
