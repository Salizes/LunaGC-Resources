        },
        {
            "id": "7602904",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "760290401",
                    "speaker": "Player",
                    "text": "(咦？琴声？看来哥伦比娅在给月灵们弹琴。）"
                },
                {
                    "id": "760290402",
                    "speaker": "Player",
                    "text": "（上次来的时候琴还没修好。那已经是哥伦比娅还不认识大家的时候发生的事了…）"
                },
                {
                    "id": "760290403",
                    "speaker": "Black Screen",
                    "text": "不久之前..."
                }
            ]
        }
    ]
