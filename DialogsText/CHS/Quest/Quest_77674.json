    "talks": [
        {
            "id": "7767401",
            "objective": "与塔拉利欣对话",
            "dialogues": [
                {
                    "id": "776740101",
                    "speaker": "塔拉利欣",
                    "text": "失败了？"
                },
                {
                    "id": "776740102",
                    "speaker": "列斯诺娃",
                    "text": "又失败了…"
                },
                {
                    "id": "776740103",
                    "speaker": "列斯诺娃",
                    "text": "你的数据绝对设计得有问题，就算把特殊任务营的那群战斗专家找过来，也没人能打通！"
                },
                {
                    "id": "776740104",
                    "speaker": "塔拉利欣",
                    "text": "那就加强练习，仔细反思。模拟训练又不止射击，建造防御工事也很重要。"
                },
                {
                    "id": "776740105",
                    "speaker": "列斯诺娃",
                    "text": "可你自己演示的时候，不也失误一次就全场崩盘了？"
                },
                {
                    "id": "776740106",
                    "speaker": "塔拉利欣",
                    "text": "对啊，这才是「影域」该有的危险程度。"
                },
                {
                    "id": "776740107",
                    "speaker": "塔拉利欣",
                    "text": "只要稍微简单一点，普通射手都会产生幻觉——「我有机会在影域里生存下来」。"
                },
                {
                    "id": "776740108",
                    "speaker": "塔拉利欣",
                    "text": "不用最严苛的标准去训练，怎么能在严酷的环境中做到万无一失呢？"
                },
                {
                    "id": "776740109",
                    "speaker": "列斯诺娃",
                    "text": "行…说得也有道理。"
                },
                {
                    "id": "776740110",
                    "speaker": "列斯诺娃",
                    "text": "我再回去琢磨琢磨，我就不信了，一局都打不过？"
                },
                {
                    "id": "776740111",
                    "speaker": "派蒙",
                    "text": "垂头丧气地走掉了啊…"
                },
                {
                    "id": "776740112",
                    "speaker": "派蒙",
                    "text": "听起来，她好像被你设计的这种桌上游戏打得晕头转向？",
                    "choices": [
                        {
                            "id": "776740113",
                            "text": "难度太夸张确实会让人焦虑。",
                            "response": [
                                {
                                    "id": "776740115",
                                    "speaker": "塔拉利欣",
                                    "text": "游戏？对你们来说可能确实是轻松愉快的消遣。但「影域战况想定」的主题，就足以让知情人感到紧张了。"
                                },
                                {
                                    "id": "776740116",
                                    "speaker": "塔拉利欣",
                                    "text": "我制作它的本意，是从思维策略的层面进行模拟训练。"
                                },
                                {
                                    "id": "776740117",
                                    "speaker": "塔拉利欣",
                                    "text": "对于至冬的冒险家、猎人和战士而言，「影域」始终是隐藏在风雪深处的伤人利剑。"
                                },
                                {
                                    "id": "776740118",
                                    "speaker": "塔拉利欣",
                                    "text": "谁也不知道里面具体的情况，只能将零零碎碎的情报拼凑起来，去揣测内部有多凶险。"
                                },
                                {
                                    "id": "776740119",
                                    "speaker": "塔拉利欣",
                                    "text": "然后设想出一个战斗草案，以此磨练自己的本领。万一哪天不走运，真的掉进那种鬼地方了，至少有点存活的希望。"
                                },
                                {
                                    "id": "776740120",
                                    "speaker": "塔拉利欣",
                                    "text": "只不过，现在就连我都只能勉强在最佳状态下撑过几个回合，更别说他们了…"
                                },
                                {
                                    "id": "776740121",
                                    "speaker": "派蒙",
                                    "text": "呜…听起来比想象中严肃很多。"
                                },
                                {
                                    "id": "776740122",
                                    "speaker": "派蒙",
                                    "text": "#这方面，{NICKNAME}倒是经验丰富，应该能在至冬排得上前列？"
                                },
                                {
                                    "id": "776740123",
                                    "speaker": "塔拉利欣",
                                    "text": "…确实…但…",
                                    "choices": [
                                        {
                                            "id": "776740124",
                                            "text": "如果报酬还算可观…",
                                            "response": [
                                                {
                                                    "id": "776740126",
                                                    "speaker": "塔拉利欣",
                                                    "text": "#现在的问题是：什么样的价格才配得上{NICKNAME}的独家演示？"
                                                },
                                                {
                                                    "id": "776740127",
                                                    "speaker": "塔拉利欣",
                                                    "text": "我心里也没底，就先用我的存款垫付三个S级委托的酬劳，然后以事实成果要求协会拨款。"
                                                },
                                                {
                                                    "id": "776740128",
                                                    "speaker": "塔拉利欣",
                                                    "text": "如果还不够，就只能去找北国银行贷款了。",
                                                    "choices": [
                                                        {
                                                            "id": "776740129",
                                                            "text": "倒也不至于借钱。",
                                                            "response": [
                                                                {
                                                                    "id": "776740131",
                                                                    "speaker": "派蒙",
                                                                    "text": "对啊，如果是让所有人受益的事，我们也不会狮子大开口…"
                                                                },
                                                                {
                                                                    "id": "776740132",
                                                                    "speaker": "派蒙",
                                                                    "text": "#应该说，从来没有乱开价！帮到许多人这件事本身，就让我和{NICKNAME}心满意足了。"
                                                                },
                                                                {
                                                                    "id": "776740133",
                                                                    "speaker": "塔拉利欣",
                                                                    "text": "那真是感激不尽！"
                                                                },
                                                                {
                                                                    "id": "776740134",
                                                                    "speaker": "塔拉利欣",
                                                                    "text": "#我得用冰水洗洗眼睛，做好准备，认真观看{NICKNAME}的演示。"
                                                                },
                                                                {
                                                                    "id": "776740135",
                                                                    "speaker": "塔拉利欣",
                                                                    "text": "请听我简单介绍一下模拟的规则…"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "776740130",
                                                            "text": "诚意到位就行。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "776740125",
                                            "text": "我可以帮忙打个样。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "776740114",
                            "text": "别要求太极限的手法比较好。"
                        }
                    ]
                }
            ]
        }
    ]
}