    "talks": [
        {
            "id": "7280801",
            "objective": "与「稻妻的凯瑟琳」对话",
            "dialogues": [
                {
                    "id": "728080101",
                    "speaker": "凯瑟琳",
                    "text": "向着星辰与深渊！欢迎来到冒险家协会。"
                },
                {
                    "id": "728080102",
                    "speaker": "凯瑟琳",
                    "text": "你终于来了，我已经等候多时了，冒险家。"
                },
                {
                    "id": "728080103",
                    "speaker": "Player",
                    "text": "又、又一个凯瑟琳小姐…"
                },
                {
                    "id": "728080104",
                    "speaker": "凯瑟琳",
                    "text": "又一个？呵呵，你什么时候同时见过很多凯瑟琳吗？"
                },
                {
                    "id": "728080105",
                    "speaker": "凯瑟琳",
                    "text": "没有的话，你见到的应该都是同一个我。"
                },
                {
                    "id": "728080106",
                    "speaker": "凯瑟琳",
                    "text": "作为冒险家协会里唯一一个全年无休的接待员，我会使用一种特殊的工具在全世界各处瞬间移动，处理各项重要的事务…"
                },
                {
                    "id": "728080107",
                    "speaker": "凯瑟琳",
                    "text": "等为你办好了这边的事务，我还要继续瞬移前往枫丹呢，那边的冒险家可是出了名的锱铢必较，必须要好好接待才行。",
                    "choices": [
                        {
                            "id": "728080108",
                            "text": "真、真的吗？",
                            "response": [
                                {
                                    "id": "728080110",
                                    "speaker": "凯瑟琳",
                                    "text": "哎呀…你相信了？抱歉，瞬移的事是开玩笑，还请不要放在心上。"
                                },
                                {
                                    "id": "728080111",
                                    "speaker": "凯瑟琳",
                                    "text": "再说了，说到瞬移，你不是也会使用「传送锚点」吗？"
                                },
                                {
                                    "id": "728080112",
                                    "speaker": "凯瑟琳",
                                    "text": "好了，先不说这些耽误你的冒险行动了，来吧，我为你办理稻妻冒险家协会的事务。"
                                },
                                {
                                    "id": "728080113",
                                    "speaker": "凯瑟琳",
                                    "text": "等办理好了之后，你就可以在稻妻冒险家协会这里继续接取委托，和享受其他服务了。"
                                },
                                {
                                    "id": "728080114",
                                    "speaker": "凯瑟琳",
                                    "text": "向着星辰与深渊，冒险家。"
                                }
                            ]
                        },
                        {
                            "id": "728080109",
                            "text": "我也想瞬移！"
                        }
                    ]
                }
            ]
        }
    ]
}