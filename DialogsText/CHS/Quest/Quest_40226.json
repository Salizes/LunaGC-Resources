    "talks": [
        {
            "id": "4022601",
            "objective": "前往「旗舰」",
            "dialogues": [
                {
                    "id": "402260101",
                    "speaker": "派蒙",
                    "text": "旗舰…这个参展方的人应该是在办理住宿吧。"
                },
                {
                    "id": "402260102",
                    "speaker": "娜维娅",
                    "text": "搭档！还有派蒙！"
                },
                {
                    "id": "402260103",
                    "speaker": "派蒙",
                    "text": "是娜维娅，好久不见！",
                    "choices": [
                        {
                            "id": "402260104",
                            "text": "如果我没猜错…",
                            "response": [
                                {
                                    "id": "402260106",
                                    "speaker": "娜维娅",
                                    "text": "对啊，刺玫会也是参展方之一。"
                                },
                                {
                                    "id": "402260107",
                                    "speaker": "派蒙",
                                    "text": "哦…那位主宰地下世界的黑道大佬！"
                                },
                                {
                                    "id": "402260108",
                                    "speaker": "派蒙",
                                    "text": "哦…那位主宰地下世界的黑道大佬！"
                                },
                                {
                                    "id": "402260109",
                                    "speaker": "娜维娅",
                                    "text": "哈哈，这是对我的新称呼吗？听上去蛮酷的。"
                                },
                                {
                                    "id": "402260110",
                                    "speaker": "派蒙",
                                    "text": "我们接受了一项委托，具体就是帮忙登记参展人员还有核实参展货物之类的…"
                                },
                                {
                                    "id": "402260111",
                                    "speaker": "娜维娅",
                                    "text": "是这样啊，坐下聊吧，我正好点了一桌好吃的，克洛琳德和夏沃蕾放完东西也会出来会合。噢！刚说到她们就来了。"
                                },
                                {
                                    "id": "402260112",
                                    "speaker": "克洛琳德",
                                    "text": "在介绍我们吗？"
                                },
                                {
                                    "id": "402260113",
                                    "speaker": "派蒙",
                                    "text": "克洛琳德和夏沃蕾也来了？"
                                },
                                {
                                    "id": "402260114",
                                    "speaker": "克洛琳德",
                                    "text": "挪德卡莱秩序混乱，十分危险，考虑到刺玫会对于枫丹的意义，我可不希望它的现任会长在这里出事。"
                                },
                                {
                                    "id": "402260115",
                                    "speaker": "娜维娅",
                                    "text": "凭我的身手，我可想象不到自己能出什么事，不过和朋友们一起出来旅行还是很有趣的。"
                                },
                                {
                                    "id": "402260116",
                                    "speaker": "克洛琳德",
                                    "text": "我就说你的心态太松弛了…"
                                },
                                {
                                    "id": "402260117",
                                    "speaker": "娜维娅",
                                    "text": "好吧，重新向各位介绍，我现在的保镖是全枫丹最厉害的决斗代理人！"
                                },
                                {
                                    "id": "402260118",
                                    "speaker": "派蒙",
                                    "text": "黑道大佬和她的保镖…登记好了，夏沃蕾呢？"
                                },
                                {
                                    "id": "402260119",
                                    "speaker": "夏沃蕾",
                                    "text": "就不用登记我了，我是来处理公务的，最近的很多大案都与挪德卡莱有关。"
                                },
                                {
                                    "id": "402260120",
                                    "speaker": "派蒙",
                                    "text": "噢噢，那我就不多问了。"
                                },
                                {
                                    "id": "402260121",
                                    "speaker": "派蒙",
                                    "text": "对了，刺玫会用来参展的货物也需要登记一下。"
                                },
                                {
                                    "id": "402260122",
                                    "speaker": "娜维娅",
                                    "text": "就是这个——枫丹科学院新研究出来的一种荒芒中继系统，通过控制它，就可以使用荒芒能量进行战斗。"
                                },
                                {
                                    "id": "402260123",
                                    "speaker": "派蒙",
                                    "text": "这么说…是一种武器？"
                                },
                                {
                                    "id": "402260124",
                                    "speaker": "娜维娅",
                                    "text": "在一个没有法律限制的市场里，武器自然是最抢手的货物之一。"
                                },
                                {
                                    "id": "402260125",
                                    "speaker": "派蒙",
                                    "text": "确实是这个道理，不过这种话当着夏沃蕾的面说，总感觉怪怪的…"
                                },
                                {
                                    "id": "402260126",
                                    "speaker": "夏沃蕾",
                                    "text": "无妨，我在犯罪小说里读到过很多有关「法外之地」的描写。"
                                },
                                {
                                    "id": "402260127",
                                    "speaker": "夏沃蕾",
                                    "text": "作为一名警探，如果想在这种地方办事，最重要的一点就是暂时放下成规。"
                                },
                                {
                                    "id": "402260128",
                                    "speaker": "夏沃蕾",
                                    "text": "那么，我就先告辞了，队员们还在等我。"
                                },
                                {
                                    "id": "402260129",
                                    "speaker": "派蒙",
                                    "text": "如果接下来方便的话，我们可以带你们去会场。"
                                },
                                {
                                    "id": "402260130",
                                    "speaker": "娜维娅",
                                    "text": "好呀，那现在就去吧，我也想看看有没有自己想买的东西。"
                                }
                            ]
                        },
                        {
                            "id": "402260105",
                            "text": "…你们也是来参展的？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "4022602",
            "objective": "带领娜维娅和克洛琳德前往会场",
            "dialogues": [
                {
                    "id": "402260201",
                    "speaker": "Black Screen",
                    "text": "娜维娅和克洛琳德在你们的带领下来到展会现场。"
                },
                {
                    "id": "402260202",
                    "speaker": "娜维娅",
                    "text": "比我想象的大多了，不过人还不多，不够热闹啊。"
                },
                {
                    "id": "402260203",
                    "speaker": "派蒙",
                    "text": "应该是因为展会还没有正式开始吧，看来雅珂达那边要帮忙的事还不少。"
                },
                {
                    "id": "402260204",
                    "speaker": "娜维娅",
                    "text": "那这边就交给我和克洛琳德吧，等你们空闲了，也欢迎来体验我们的展品哦。"
                }
            ]
        }
    ]
}