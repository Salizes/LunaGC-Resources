        {
            "id": "7226913",
            "objective": "在「常夜」时调查池水",
            "dialogues": []
        },
        {
            "id": "7226901",
            "objective": "和封印前的残魂对话",
            "dialogues": [
                {
                    "id": "722690101",
                    "speaker": "江木",
                    "text": "我乃末代地走官·江木。珊瑚宫之勇者，我认可你挑战的荣誉。"
                },
                {
                    "id": "722690102",
                    "speaker": "江木",
                    "text": "我将主持「明察」之试炼。请你动身去解开所有的谜题，让「高门之火」归位。"
                },
                {
                    "id": "722690103",
                    "speaker": "江木",
                    "text": "战场瞬息万变。唯有耳观八方、眼观六路才能把握情况，把握一切变数。"
                }
            ]
        },
        {
            "id": "7226902",
            "objective": "解放所有「高门之火」",
            "dialogues": [
                {
                    "id": "722690201",
                    "speaker": "江木",
                    "text": "珊瑚宫之勇者，已经完成了挑战吗？"
                },
                {
                    "id": "722690202",
                    "speaker": "江木",
                    "text": "发挥你的洞察力，找到所有的「高门之火」吧！"
                }
            ]
        },
        {
            "id": "7226903",
            "objective": "解放所有「高门之火」",
            "dialogues": [
                {
                    "id": "722690301",
                    "speaker": "江木",
                    "text": "利落地完成了试炼。我，末代地走官·江木，于此认可你的勇武。"
                },
                {
                    "id": "722690302",
                    "speaker": "江木",
                    "text": "你的明察，可称得上「微察冬鳗」了。"
                },
                {
                    "id": "722690303",
                    "speaker": "派蒙",
                    "text": "这又是什么意思？"
                },
                {
                    "id": "722690304",
                    "speaker": "江木",
                    "text": "繁殖时节的小陆鳗鳗鱼苗真的非常非常小哦。要集中注意力眯起眼睛才能看到。"
                }
            ]
        },
        {
            "id": "7226904",
            "objective": "解放所有「高门之火」",
            "dialogues": [
                {
                    "id": "722690401",
                    "speaker": "江木",
                    "text": "我乃末代地走官·江木。闲杂人等速速退散。"
                }
            ]
        },
        {
