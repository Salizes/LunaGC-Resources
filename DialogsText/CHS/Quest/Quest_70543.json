    "talks": [
        {
            "id": "7054301",
            "objective": "(test)彩蛋对话3$HIDDEN",
            "dialogues": [
                {
                    "id": "705430101",
                    "speaker": "雷泽",
                    "text": "……"
                },
                {
                    "id": "705430102",
                    "speaker": "「团团灰」",
                    "text": "…喵。"
                },
                {
                    "id": "705430103",
                    "speaker": "雷泽",
                    "text": "…是你们。我在，聊天。"
                },
                {
                    "id": "705430104",
                    "speaker": "派蒙",
                    "text": "聊天…雷泽是在和「团团灰」聊天吗？"
                },
                {
                    "id": "705430105",
                    "speaker": "「团团灰」",
                    "text": "喵，喵喵。"
                },
                {
                    "id": "705430106",
                    "speaker": "派蒙",
                    "text": "「团团灰」的意思好像是…「没错」？"
                },
                {
                    "id": "705430107",
                    "speaker": "雷泽",
                    "text": "闻到熟悉的味道，找朋友。"
                },
                {
                    "id": "705430108",
                    "speaker": "雷泽",
                    "text": "它很好，高兴。"
                },
                {
                    "id": "705430109",
                    "speaker": "「团团灰」",
                    "text": "喵，喵。"
                },
                {
                    "id": "705430110",
                    "speaker": "雷泽",
                    "text": "气味吸引朋友，你也来了，高兴。你身上，风和雨的味道，很熟悉…猫的气味，也熟悉。"
                },
                {
                    "id": "705430111",
                    "speaker": "雷泽",
                    "text": "派蒙，甜甜的味道，好闻。"
                },
                {
                    "id": "705430112",
                    "speaker": "派蒙",
                    "text": "欸？！甜甜的…难道是瓦乐瑞娜给我们的松饼的味道？我、我有吃那么多吗？",
                    "choices": [
                        {
                            "id": "705430113",
                            "text": "我的都分给你一半了啦。",
                            "response": [
                                {
                                    "id": "705430115",
                                    "speaker": "派蒙",
                                    "text": "完全没注意…哎呀，都怪松饼太好吃了嘛。"
                                },
                                {
                                    "id": "705430116",
                                    "speaker": "派蒙",
                                    "text": "嘿嘿，我还想吃甜甜花酿鸡、烤肉排和土豆饼…还有苹果酿！"
                                },
                                {
                                    "id": "705430117",
                                    "speaker": "派蒙",
                                    "text": "#那菜单就这么定啦，{NICKNAME}，我们快去找瓦乐瑞娜下单吧，雷泽也一起来嘛！"
                                },
                                {
                                    "id": "705430118",
                                    "speaker": "雷泽",
                                    "text": "谢…谢谢…"
                                },
                                {
                                    "id": "705430119",
                                    "speaker": "雷泽",
                                    "text": "「团团灰」给我带来了很多…坚果…"
                                },
                                {
                                    "id": "705430120",
                                    "speaker": "雷泽",
                                    "text": "还有，盒子的肉…我， 吃得很饱了。"
                                },
                                {
                                    "id": "705430121",
                                    "speaker": "派蒙",
                                    "text": "听起来好像是瓦乐瑞娜小姐点的外送订单？难道「团团灰」把外送餐品拿给了雷泽吃？"
                                },
                                {
                                    "id": "705430122",
                                    "speaker": "「团团灰」",
                                    "text": "喵喵。喵！"
                                },
                                {
                                    "id": "705430123",
                                    "speaker": "派蒙",
                                    "text": "没想到，「猫茸茸城堡」里还会有猫猫反过来招待客人的事呢！"
                                },
                                {
                                    "id": "705430124",
                                    "speaker": "派蒙",
                                    "text": "看来雷泽真的「猫缘」很棒！"
                                }
                            ]
                        },
                        {
                            "id": "705430114",
                            "text": "没事，你还能再吃三倍。"
                        }
                    ]
                }
            ]
        }
    ]
}