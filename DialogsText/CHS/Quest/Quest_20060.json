    },
    "talks": [
        {
            "id": "2006001",
            "objective": "与特纳对话",
            "dialogues": [
                {
                    "id": "200600101",
                    "speaker": "特纳",
                    "text": "你好，客人，你知道我儿子盖伊吗？咳…咳咳…"
                },
                {
                    "id": "200600102",
                    "speaker": "Player",
                    "text": "你怎么了？"
                },
                {
                    "id": "200600103",
                    "speaker": "特纳",
                    "text": "没事没事，老毛病了，没什么大问题，但就是一直好不了。"
                },
                {
                    "id": "200600104",
                    "speaker": "特纳",
                    "text": "之前去<color=#00E1FFFF>教会</color>里也看过了，修女们也不能一口气治好，只能开药缓解。"
                },
                {
                    "id": "200600105",
                    "speaker": "特纳",
                    "text": "唉，我年纪大了，也走不了太长的路，之前都是请摩可和海莉帮我去配药。"
                },
                {
                    "id": "200600106",
                    "speaker": "特纳",
                    "text": "她们今天刚好有事…咳咳…我已经和<color=#00E1FFFF>吉丽安娜小姐</color>说好了。"
                },
                {
                    "id": "200600107",
                    "speaker": "特纳",
                    "text": "只要带着材料过去，她就会把药配好。只要<color=#00E1FFFF>三份甜甜花</color>就好。"
                },
                {
                    "id": "200600108",
                    "speaker": "特纳",
                    "text": "好的。"
                },
                {
                    "id": "200600109",
                    "speaker": "特纳",
                    "text": "咳咳，咳…那就拜托你了。"
                },
                {
                    "id": "200600112",
                    "speaker": "特纳",
                    "text": "就三份甜甜花，然后去教会找吉丽安娜修女配药，<color=#00E1FFFF>千万别让盖伊知道。</color>"
                },
                {
                    "id": "200600113",
                    "speaker": "特纳",
                    "text": "我听说，教会和西风骑士团也有关系吧，那小子是西风骑士，可要时刻注意自己的言行…"
                },
                {
                    "id": "200600114",
                    "speaker": "特纳",
                    "text": "要是为了我这个老头子犯了什么错，那就糟糕了。"
                },
                {
                    "id": "200600115",
                    "speaker": "特纳",
                    "text": "抱歉，让你听我唠叨了半天，快点去吧，路上小心。"
                }
            ]
        },
        {
            "id": "2006002",
            "objective": "收集甜甜花",
            "dialogues": [
                {
                    "id": "200600201",
                    "speaker": "派蒙",
                    "text": "唔…那我们快点去找<color=#00E1FFFF>甜甜花</color>吧。"
                }
            ]
        },
        {
            "id": "2006004",
            "objective": "(test)$HIDDEN",
            "dialogues": [
                {
                    "id": "200600401",
                    "speaker": "派蒙",
                    "text": "等等…我看看，我们带着的甜甜花好像已经够数了。"
                },
                {
                    "id": "200600402",
                    "speaker": "派蒙",
                    "text": "要直接拿去给<color=#00E1FFFF>吉丽安娜修女</color>吗？还是去再找一些？"
                }
            ]
        },
        {
            "id": "2006005",
            "objective": "(test)$HIDDEN",
            "dialogues": [
                {
                    "id": "200600501",
                    "speaker": "盖伊",
                    "text": "呃，你好！你手上拿的是甜甜花吧。虽然很唐突，你能不能卖给我一份？"
                },
                {
                    "id": "200600502",
                    "speaker": "盖伊",
                    "text": "我老爹一直在咳嗽，我问吉丽安娜小姐要了份止咳的药方，但是她那边材料已经用光了…",
                    "choices": [
                        {
                            "id": "200600503",
                            "text": "我也是去配药的。",
                            "response": [
                                {
                                    "id": "200600504",
                                    "speaker": "盖伊",
                                    "text": "是，是这样吗？那还是算了…"
                                },
                                {
                                    "id": "200600505",
                                    "speaker": "盖伊",
                                    "text": "抱歉，耽误了你的时间，赶紧去教堂吧，吉丽安娜小姐还在呢。"
                                }
                            ]
                        },
                        {
                            "id": "200600506",
                            "text": "甜甜花应该很好找。",
                            "response": [
                                {
                                    "id": "200600507",
                                    "speaker": "盖伊",
                                    "text": "啊？哦…我知道，但是我还要守门呢，实在是抽不开身。"
                                },
                                {
                                    "id": "200600508",
                                    "speaker": "盖伊",
                                    "text": "就是去问吉丽安娜小姐，我也只能趁着午休的时候赶紧问了问。"
                                },
                                {
                                    "id": "200600509",
                                    "speaker": "盖伊",
                                    "text": "算了，看你的样子，应该也是去配药的吧…不耽误你了，快点去教堂吧，吉丽安娜小姐应该还在呢。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2006006",
            "objective": "(test)$HIDDEN",
            "dialogues": []
        },
        {
            "id": "2006008",
            "objective": "找吉丽安娜配药",
            "dialogues": [
                {
                    "id": "200600801",
                    "speaker": "吉丽安娜",
                    "text": "药已经配好了， 但是这种药治标不治本，想要彻底根除的话，要一直服药静养才行。"
                },
                {
                    "id": "200600802",
                    "speaker": "吉丽安娜",
                    "text": "我和他说过很多次，他似乎都没听进去，一直说这样就可以了，无论是谁都劝不动。"
                },
                {
                    "id": "200600803",
                    "speaker": "吉丽安娜",
                    "text": "好了，请你们快点把药带给特纳先生吧。"
                },
                {
                    "id": "200600804",
                    "speaker": "吉丽安娜",
                    "text": "谢谢你。"
                },
                {
                    "id": "200600805",
                    "speaker": "吉丽安娜",
                    "text": "不客气，我只是做了分内的事而已。"
                }
            ]
        },
        {
            "id": "2006009",
            "objective": "(test)$HIDDEN",
            "dialogues": []
        },
        {
            "id": "2006010",
            "objective": "向特纳回报",
            "dialogues": [
                {
                    "id": "200600901",
                    "speaker": "特纳",
                    "text": "这个老毛病啊，到底什么时候能好呢…",
                    "choices": [
                        {
                            "id": "200600902",
                            "text": "这是药。",
                            "response": [
                                {
                                    "id": "200600903",
                                    "speaker": "特纳",
                                    "text": "好，谢谢你。"
                                },
                                {
                                    "id": "200600907",
                                    "speaker": "特纳",
                                    "text": "惭愧啊，孩子在奋斗，我却什么忙都帮不上。"
                                },
                                {
                                    "id": "200600908",
                                    "speaker": "特纳",
                                    "text": "唯一能做到的事，就是不给孩子添麻烦了吧…"
                                },
                                {
                                    "id": "200600909",
                                    "speaker": "特纳",
                                    "text": "哦，对了，这些给您，请您收下吧，这是老头子我的一点谢礼。"
                                }
                            ]
                        },
                        {
                            "id": "200600904",
                            "text": "吉丽安娜建议静养…",
                            "response": [
                                {
                                    "id": "200600905",
                                    "speaker": "特纳",
                                    "text": "静养的话，就必须让盖伊那臭小子回来了吧。"
                                },
                                {
                                    "id": "200600906",
                                    "speaker": "特纳",
                                    "text": "没事，我这把老骨头还不会散架。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2006003",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "200600301",
                    "speaker": "派蒙",
                    "text": "这些就应该足够了，我们去找<color=#00E1FFFF>吉丽安娜修女</color>吧。"
                }
            ]
        },
        {
            "id": "2006006",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "200600601",
                    "speaker": "吉丽安娜",
                    "text": "虽然只是个小毛病，但是这么拖下去，还是会出大问题呢…"
                }
            ]
        },
        {
            "id": "2006007",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "200600701",
                    "speaker": "吉丽安娜",
                    "text": "特纳先生可真是…"
                },
                {
                    "id": "200600702",
                    "speaker": "Player",
                    "text": "我是来配药的。"
                },
                {
                    "id": "200600703",
                    "speaker": "吉丽安娜",
                    "text": "咦？不是摩可和海莉来吗，怎么今天是你？"
                },
                {
                    "id": "200600704",
                    "speaker": "吉丽安娜",
                    "text": "材料已经搜集到了吧，我来看看…"
                }
            ]
        },
        {
            "id": "2006010",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "200601001",
                    "speaker": "特纳",
                    "text": "虽然是修女，但是吉丽安娜小姐做事真利索。也不大费周章折腾，我这老毛病，她看一眼就知道是怎么回事，开的药也便宜好用。"
                },
                {
                    "id": "200601002",
                    "speaker": "特纳",
                    "text": "哈哈哈，就我老头子看来，她的作风不像个修女，反倒像个常年在野外摸爬滚打的猎人了…"
                },
                {
                    "id": "200601003",
                    "speaker": "特纳",
                    "text": "哎呀，你看我这张嘴，净胡说八道…快去找她配药吧，可千万别和她说啊。"
                }
            ]
        }
    ]
}