        },
        "total_dialogue_lines": 72,
        "total_speaker_counts": {
            "Black Screen": 1,
            "Player": 18,
            "派蒙": 11,
            "范兵卫": 42
        }
    },
    "talks": [
        {
            "id": "2300201",
            "objective": "与范兵卫对话",
            "dialogues": [
                {
                    "id": "230020101",
                    "speaker": "范兵卫",
                    "text": "这家店的蘑菇质量看来还可以，先放在采购名单上好了…"
                },
                {
                    "id": "230020102",
                    "speaker": "派蒙",
                    "text": "范兵卫？这个名字好熟悉啊，好像在哪听人提起过…",
                    "choices": [
                        {
                            "id": "230020103",
                            "text": "难、难道是之前踏鞴砂那个…",
                            "response": [
                                {
                                    "id": "230020105",
                                    "speaker": "派蒙",
                                    "text": "呜哇！他是那个拖拖拉拉，把「御影炉心」弄得一团糟的家伙！",
                                    "choices": [
                                        {
                                            "id": "230020106",
                                            "text": "他应该是来做「远国御用」的…",
                                            "response": [
                                                {
                                                    "id": "230020108",
                                                    "speaker": "派蒙",
                                                    "text": "原来他真的来须弥了啊，我还以为那个「远国御用」是开玩笑的呢…"
                                                },
                                                {
                                                    "id": "230020109",
                                                    "speaker": "范兵卫",
                                                    "text": "咦？金发…旁边飘着一个小东西…"
                                                },
                                                {
                                                    "id": "230020110",
                                                    "speaker": "范兵卫",
                                                    "text": "您难道就是那位「旅行者」吗？",
                                                    "choices": [
                                                        {
                                                            "id": "230020111",
                                                            "text": "没错，就是我。",
                                                            "response": [
                                                                {
                                                                    "id": "230020114",
                                                                    "speaker": "范兵卫",
                                                                    "text": "哈哈，果然是您，阳介写信过来的时候提到过您。他说是您和泽维尔先生一起处理了「御影炉心」。"
                                                                },
                                                                {
                                                                    "id": "230020115",
                                                                    "speaker": "范兵卫",
                                                                    "text": "唉，我真是惭愧啊，在您和泽维尔先生修理「御影炉心」的时候，我居然被文书工作给绊住了手脚…"
                                                                },
                                                                {
                                                                    "id": "230020116",
                                                                    "speaker": "Player",
                                                                    "text": "文书工作比「御影炉心」还重要吗…"
                                                                },
                                                                {
                                                                    "id": "230020117",
                                                                    "speaker": "派蒙",
                                                                    "text": "你工作的重点完全就错了吧！"
                                                                },
                                                                {
                                                                    "id": "230020118",
                                                                    "speaker": "范兵卫",
                                                                    "text": "您看您说的，如果不做好文书工作，怎么有序推进「御影炉心」的维修工作呢？"
                                                                },
                                                                {
                                                                    "id": "230020119",
                                                                    "speaker": "范兵卫",
                                                                    "text": "您瞧，疏散周边人员、准备修理物资、调动修理人员，还要协调各方的生产需求…"
                                                                },
                                                                {
                                                                    "id": "230020120",
                                                                    "speaker": "范兵卫",
                                                                    "text": "如果没有文书支持，这些事都会乱成一锅粥了。"
                                                                },
                                                                {
                                                                    "id": "230020121",
                                                                    "speaker": "Player",
                                                                    "text": "果然和虎之助说的一样…"
                                                                },
                                                                {
                                                                    "id": "230020122",
                                                                    "speaker": "派蒙",
                                                                    "text": "真是名不虚传啊…"
                                                                },
                                                                {
                                                                    "id": "230020123",
                                                                    "speaker": "范兵卫",
                                                                    "text": "虎之助…那位先生就是那种根本不在意文书工作的人，和他一起工作，总是会有很多额外的工作量。"
                                                                },
                                                                {
                                                                    "id": "230020124",
                                                                    "speaker": "范兵卫",
                                                                    "text": "不过，现在我已经不再分管「御影炉心」了，现在我正在须弥做「远国御用」，主管蘑菇贸易啦。"
                                                                },
                                                                {
                                                                    "id": "230020125",
                                                                    "speaker": "范兵卫",
                                                                    "text": "嗯…旅行者，您的事迹我已经听阳介说过了，我觉得…您是一个非常可靠的人。"
                                                                },
                                                                {
                                                                    "id": "230020126",
                                                                    "speaker": "范兵卫",
                                                                    "text": "如果您愿意的话，能帮我一个忙吗？"
                                                                },
                                                                {
                                                                    "id": "230020127",
                                                                    "speaker": "范兵卫",
                                                                    "text": "我目前正在寻找一个稳定可靠的蘑菇供应商，也在这里找了很多商家。"
                                                                },
                                                                {
                                                                    "id": "230020128",
                                                                    "speaker": "范兵卫",
                                                                    "text": "他们给我拿来的蘑菇样本都是一些特意挑选出来的好货…"
                                                                },
                                                                {
                                                                    "id": "230020129",
                                                                    "speaker": "范兵卫",
                                                                    "text": "我觉得，必须要去他们的蘑菇产地直接看看蘑菇质量，以此来衡量他们供货时的货物质量。"
                                                                },
                                                                {
                                                                    "id": "230020130",
                                                                    "speaker": "范兵卫",
                                                                    "text": "但如您所见，我实在是没有野外勘察的经验，独自进林的话，只怕凶多吉少。"
                                                                },
                                                                {
                                                                    "id": "230020131",
                                                                    "speaker": "范兵卫",
                                                                    "text": "所以，我想请您帮我去林子里采集一下蘑菇，然后拿回来给我。您看…",
                                                                    "choices": [
                                                                        {
                                                                            "id": "230020132",
                                                                            "text": "倒也不是不行…",
                                                                            "response": [
                                                                                {
                                                                                    "id": "230020134",
                                                                                    "speaker": "范兵卫",
                                                                                    "text": "您答应我了？太好了！报酬的事您放心，我已经准备好了文书。"
                                                                                },
                                                                                {
                                                                                    "id": "230020135",
                                                                                    "speaker": "范兵卫",
                                                                                    "text": "您看这里，对，先看这份文书，这是雇佣文书，还有酬劳计算，这份是义务告知和保密协议，噢对了，还有那片蘑菇产地的地图…"
                                                                                },
                                                                                {
                                                                                    "id": "230020136",
                                                                                    "speaker": "Black Screen",
                                                                                    "text": "和范兵卫一起细致地查看了所有文书，深感疲惫…"
                                                                                },
                                                                                {
                                                                                    "id": "230020137",
                                                                                    "speaker": "范兵卫",
                                                                                    "text": "很好，这样所有文书您都已经知悉了，我会先送报幕府，得到回执之后，再和您达成正式雇佣关系。"
                                                                                },
                                                                                {
                                                                                    "id": "230020138",
                                                                                    "speaker": "范兵卫",
                                                                                    "text": "但在那之前，我会先自掏腰包支付您的酬劳。毕竟采购蘑菇这件事不能耽搁。"
                                                                                },
                                                                                {
                                                                                    "id": "230020139",
                                                                                    "speaker": "范兵卫",
                                                                                    "text": "当然啦，这件事我也会总结成文书向幕府备案，毕竟您的酬劳也需要报税。"
                                                                                },
                                                                                {
                                                                                    "id": "230020140",
                                                                                    "speaker": "Player",
                                                                                    "text": "我、我先去采蘑菇了！"
                                                                                },
                                                                                {
                                                                                    "id": "230020141",
                                                                                    "speaker": "范兵卫",
                                                                                    "text": "咦？噢…那就拜托您了…"
                                                                                },
                                                                                {
                                                                                    "id": "230020142",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "我们不会再次被卷入麻烦里吧，真担心啊…",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "230020143",
                                                                                            "text": "我就是来盯着他的。",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "230020144",
                                                                                                    "speaker": "派蒙",
                                                                                                    "text": "是这样吗？好吧，你说得也有点道理…"
                                                                                                },
                                                                                                {
                                                                                                    "id": "230020147",
                                                                                                    "speaker": "范兵卫",
                                                                                                    "text": "咦？您怎么这么一副不相信我的表情…放心吧，我准备工作都做得很完善了，绝不会让您面对什么流程问题的。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "230020148",
                                                                                                    "speaker": "派蒙",
                                                                                                    "text": "我们不是在说这种问题啦…唉，总之我们先去林子里帮他采蘑菇吧。"
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "230020145",
                                                                                            "text": "想看这家伙能整出什么新乱子。",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "230020146",
                                                                                                    "speaker": "派蒙",
                                                                                                    "text": "喂！要是真有什么新乱子，我们在这里可找不到人来帮忙了啊！"
                                                                                                }
                                                                                            ]
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "230020133",
                                                                            "text": "报酬先谈好。"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "230020112",
                                                            "text": "这位是派蒙…",
                                                            "response": [
                                                                {
                                                                    "id": "230020113",
                                                                    "speaker": "派蒙",
                                                                    "text": "是派蒙，不是什么「飘着的小东西」！"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "230020107",
                                            "text": "他应该是来管蘑菇贸易的…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "230020104",
                            "text": "虎之助和阳介都提过的那个…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "2300202",
            "objective": "前往采摘蘑菇",
            "dialogues": [
                {
                    "id": "230020201",
                    "speaker": "范兵卫",
                    "text": "怎么样，您采到蘑菇了吗？"
                }
            ]
        },
        {
            "id": "2300203",
            "objective": "采摘蘑菇",
            "dialogues": [
                {
                    "id": "230020301",
                    "speaker": "范兵卫",
                    "text": "太好了，这些就足够了。这些蘑菇看起来就不错…"
                },
                {
                    "id": "230020302",
                    "speaker": "范兵卫",
                    "text": "这些酬劳请您收好，多谢您帮忙了。"
                },
                {
                    "id": "230020303",
                    "speaker": "Player",
                    "text": "这是税前还是税后？"
                },
                {
                    "id": "230020304",
                    "speaker": "范兵卫",
                    "text": "当然是税后了，您放心吧，我不会让您专门回稻妻去补税的。"
                },
                {
                    "id": "230020305",
                    "speaker": "范兵卫",
                    "text": "不过，也不知道幕府那边的税务政策有没有修改…"
                },
                {
                    "id": "230020306",
                    "speaker": "范兵卫",
                    "text": "唔，还是找个时间再给阳介写封信吧…"
                }
            ]
        },
        {
            "id": "2300204",
            "objective": "将蘑菇带给范兵卫",
            "dialogues": [
                {
                    "id": "230020401",
                    "speaker": "范兵卫",
                    "text": "太好了，这些就足够了。这些蘑菇看起来就不错…"
                },
                {
                    "id": "230020402",
                    "speaker": "Player",
                    "text": "我还多采了一些蘑菇。"
                },
                {
                    "id": "230020403",
                    "speaker": "范兵卫",
                    "text": "哈哈哈，那更好了，请您把这些蘑菇也给我吧，我会多给您算一些报酬的。"
                },
                {
                    "id": "230020404",
                    "speaker": "范兵卫",
                    "text": "这些酬劳请您收好，多谢您帮忙了。"
                },
                {
                    "id": "230020405",
                    "speaker": "Player",
                    "text": "这是税前还是税后？"
                },
                {
                    "id": "230020406",
                    "speaker": "范兵卫",
                    "text": "这些都是税后了，您放心吧，我不会让您专门回稻妻去补税的。"
                },
                {
                    "id": "230020407",
                    "speaker": "范兵卫",
                    "text": "不过，也不知道幕府那边的税务政策有没有修改…"
                },
                {
                    "id": "230020408",
                    "speaker": "范兵卫",
                    "text": "唔，还是找个时间再给阳介写封信吧…"
                }
            ]
        },
        {
            "id": "2300206",
            "objective": "与范兵卫对话",
            "dialogues": []
        },
        {
            "id": "2300205",
            "objective": "与范兵卫对话",
            "dialogues": []
        },
        {
            "id": "2300205",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "230020501",
                    "speaker": "范兵卫",
                    "text": "这家的蘑菇看起来也不太靠谱啊…"
                },
                {
                    "id": "230020502",
                    "speaker": "派蒙",
                    "text": "他怎么一副犯愁的样子…不会又惹上什么麻烦了吧…"
                },
                {
                    "id": "230020503",
                    "speaker": "范兵卫",
                    "text": "旅行者，您来了。上次您拿来的蘑菇质量真是不错。"
                },
                {
                    "id": "230020504",
                    "speaker": "范兵卫",
                    "text": "这次能请您再去采一些来吗？我想拿来和其他供货商的蘑菇做对比。",
                    "choices": [
                        {
                            "id": "230020505",
                            "text": "交给我吧。",
                            "response": [
                                {
                                    "id": "230020506",
                                    "speaker": "范兵卫",
                                    "text": "那就拜托您了。"
                                }
                            ]
                        },
                        {
                            "id": "230020507",
                            "text": "你找了几家了？",
                            "response": [
                                {
                                    "id": "230020508",
                                    "speaker": "范兵卫",
                                    "text": "唔，五六家吧，但这些供货商的蘑菇质量都不太稳定，我实在是有些不安。"
                                },
                                {
                                    "id": "230020509",
                                    "speaker": "范兵卫",
                                    "text": "我还会继续找其他供货商，采蘑菇的事情就拜托您了。"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}