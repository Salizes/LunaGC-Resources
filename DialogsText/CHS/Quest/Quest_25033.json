    "talks": [
        {
            "id": "2503301",
            "objective": "与特拉忒对话",
            "dialogues": [
                {
                    "id": "250330101",
                    "speaker": "特拉忒",
                    "text": "乖乖喔，今天吃饱了吗？有没有力气训练呀？"
                },
                {
                    "id": "250330102",
                    "speaker": "奇卡",
                    "text": "呜，呜呜，呜！"
                },
                {
                    "id": "250330103",
                    "speaker": "特拉忒",
                    "text": "呜哇，这么有活力？好！那今天可要加把劲了！"
                },
                {
                    "id": "250330104",
                    "speaker": "Player",
                    "text": "一起加把劲吧！"
                },
                {
                    "id": "250330106",
                    "speaker": "特拉忒",
                    "text": "#欸？您好呀，{M#大哥哥}{F#大姐姐}！我们正在进行爬山训练呢。"
                },
                {
                    "id": "250330107",
                    "speaker": "奇卡",
                    "text": "呜呜！呜呜！"
                },
                {
                    "id": "250330108",
                    "speaker": "奇卡",
                    "text": "呜呜，呜…",
                    "choices": [
                        {
                            "id": "250330109",
                            "text": "训练得怎么样？",
                            "response": [
                                {
                                    "id": "250330110",
                                    "speaker": "特拉忒",
                                    "text": "那个…至少能说「有进步」吧。这次奇卡爬的比上次高多了。"
                                },
                                {
                                    "id": "250330111",
                                    "speaker": "特拉忒",
                                    "text": "就是在爬山的时候，奇卡的攀爬动作有些不熟练…"
                                },
                                {
                                    "id": "250330116",
                                    "speaker": "特拉忒",
                                    "text": "#{M#大哥哥}{F#大姐姐}，你能再为我们示范一遍吗？",
                                    "choices": [
                                        {
                                            "id": "250330117",
                                            "text": "没问题。",
                                            "response": [
                                                {
                                                    "id": "250330118",
                                                    "speaker": "特拉忒",
                                                    "text": "#谢谢你！这次我一定能看清{M#大哥哥}{F#大姐姐}的动作。"
                                                },
                                                {
                                                    "id": "250330119",
                                                    "speaker": "特拉忒",
                                                    "text": "奇卡，你也要睁大眼睛喔。"
                                                },
                                                {
                                                    "id": "250330120",
                                                    "speaker": "奇卡",
                                                    "text": "呜！"
                                                },
                                                {
                                                    "id": "250330123",
                                                    "speaker": "特拉忒",
                                                    "text": "#那就拜托你啦，{M#大哥哥}{F#大姐姐}。"
                                                },
                                                {
                                                    "id": "250330124",
                                                    "speaker": "特拉忒",
                                                    "text": "#我们会在地上看着{M#大哥哥}{F#大姐姐}，算好时间的。"
                                                },
                                                {
                                                    "id": "250330125",
                                                    "speaker": "奇卡",
                                                    "text": "呜，呜呜…"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "250330121",
                                            "text": "这次可要看清我的动作。",
                                            "response": [
                                                {
                                                    "id": "250330122",
                                                    "speaker": "特拉忒",
                                                    "text": "当然啦。我和奇卡都会睁大眼睛仔细看的，这次一定能看清！"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "250330112",
                            "text": "看起来它恢复得不错。",
                            "response": [
                                {
                                    "id": "250330113",
                                    "speaker": "特拉忒",
                                    "text": "当然啦。妈妈都说，我可擅长照料奇卡了。"
                                },
                                {
                                    "id": "250330114",
                                    "speaker": "特拉忒",
                                    "text": "奇卡的进步可大了，爬的高度也比上次高很多。"
                                },
                                {
                                    "id": "250330115",
                                    "speaker": "特拉忒",
                                    "text": "就是在爬山的时候，奇卡的动作有些不熟练…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2503302",
            "objective": "爬上山顶",
            "dialogues": [
                {
                    "id": "250330201",
                    "speaker": "特拉忒",
                    "text": "#{M#大哥哥}{F#大姐姐}好厉害！爬得和马伊塔一样快！",
                    "choices": [
                        {
                            "id": "250330202",
                            "text": "有些失误…",
                            "response": [
                                {
                                    "id": "250330204",
                                    "speaker": "特拉忒",
                                    "text": "这种爬山的速度已经很厉害啦。我和奇卡都比不了你。"
                                },
                                {
                                    "id": "250330205",
                                    "speaker": "特拉忒",
                                    "text": "#唉，想要赶上{M#大哥哥}{F#大姐姐}，应该还要训练很久吧…"
                                },
                                {
                                    "id": "250330206",
                                    "speaker": "奇卡",
                                    "text": "呜，呜呜…",
                                    "choices": [
                                        {
                                            "id": "250330207",
                                            "text": "加油，奇卡！",
                                            "response": [
                                                {
                                                    "id": "250330209",
                                                    "speaker": "奇卡",
                                                    "text": "呜？！呜呜，呜…"
                                                },
                                                {
                                                    "id": "250330210",
                                                    "speaker": "特拉忒",
                                                    "text": "乖乖喔，奇卡。亚瓦尔叔叔说了，只要我们努力，一定能变得更厉害的！"
                                                },
                                                {
                                                    "id": "250330211",
                                                    "speaker": "奇卡",
                                                    "text": "呜呜…"
                                                },
                                                {
                                                    "id": "250330212",
                                                    "speaker": "特拉忒",
                                                    "text": "#{M#大哥哥}{F#大姐姐}，谢谢你帮忙，这枚果子给你。"
                                                },
                                                {
                                                    "id": "250330213",
                                                    "speaker": "特拉忒",
                                                    "text": "这是奇卡刚刚摘到的，它的动作比之前快了好多呢！"
                                                },
                                                {
                                                    "id": "250330214",
                                                    "speaker": "特拉忒",
                                                    "text": "#嘿嘿，都是因为有{M#大哥哥}{F#大姐姐}给奇卡做榜样。奇卡才能变得这么厉害。"
                                                },
                                                {
                                                    "id": "250330215",
                                                    "speaker": "奇卡",
                                                    "text": "呜呜，呜！"
                                                },
                                                {
                                                    "id": "250330216",
                                                    "speaker": "特拉忒",
                                                    "text": "好啦，那我们就先回部族去找马伊塔了。唔…他现在应该在部族里吧…"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "250330208",
                                            "text": "你们可以做到的。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "250330203",
                            "text": "不是最佳成绩。"
                        }
                    ]
                }
            ]
        },
