    "talks": [
        {
            "id": "7565301",
            "objective": "",
            "dialogues": [
                {
                    "id": "756530201",
                    "speaker": "香菱",
                    "text": "#是{NICKNAME}！好久不见，昨天我还和锅巴提到你呢，今天就在路上遇到了。"
                },
                {
                    "id": "756530202",
                    "speaker": "香菱",
                    "text": "哎呀，这就是冥冥之中的缘分吧。"
                },
                {
                    "id": "756530203",
                    "speaker": "香菱",
                    "text": "哦对了，你这是要去哪儿呀？",
                    "choices": [
                        {
                            "id": "756530204",
                            "text": "正打算给这座桥留影。",
                            "response": [
                                {
                                    "id": "756530206",
                                    "speaker": "香菱",
                                    "text": "留影吗？好巧好巧，我最近也在研究留影。"
                                },
                                {
                                    "id": "756530207",
                                    "speaker": "香菱",
                                    "text": "万民堂门口的海报用了这么久，也该换张新的了。"
                                },
                                {
                                    "id": "756530208",
                                    "speaker": "香菱",
                                    "text": "如果能给菜品拍出漂亮的画片，路过的食客们说不定也会多看上两眼。"
                                },
                                {
                                    "id": "756530209",
                                    "speaker": "香菱",
                                    "text": "老话说：十分佳肴，菜色三分，香气三分，味道三分，还剩一分就靠广告。"
                                },
                                {
                                    "id": "756530210",
                                    "speaker": "香菱",
                                    "text": "当然，最后半句是我自己加上的啦。"
                                },
                                {
                                    "id": "756530211",
                                    "speaker": "香菱",
                                    "text": "前面那些我父亲常挂在嘴边，对所有厨师来说都是金玉良言。",
                                    "choices": [
                                        {
                                            "id": "756530212",
                                            "text": "香菱真努力啊。",
                                            "response": [
                                                {
                                                    "id": "756530213",
                                                    "speaker": "香菱",
                                                    "text": "谢谢你的夸奖。"
                                                },
                                                {
                                                    "id": "756530216",
                                                    "speaker": "香菱",
                                                    "text": "要搜寻珍奇食材，要创作新菜肴，还要学习怎么打广告，我的厨艺修行之路还长着呢。"
                                                },
                                                {
                                                    "id": "756530217",
                                                    "speaker": "香菱",
                                                    "text": "哈哈，说起来，从我们第一次见面到现在，过去了好久。"
                                                },
                                                {
                                                    "id": "756530218",
                                                    "speaker": "香菱",
                                                    "text": "但很多事情都没有变，你还在旅行，我也还在创作新菜。"
                                                },
                                                {
                                                    "id": "756530219",
                                                    "speaker": "香菱",
                                                    "text": "我想把万民堂一直开下去，开得越来越好。"
                                                },
                                                {
                                                    "id": "756530220",
                                                    "speaker": "香菱",
                                                    "text": "就算我变成了老奶奶，只要胳膊还有力气，我就还要掌勺，把红火美味的菜肴一道道从锅里带到盘里。"
                                                },
                                                {
                                                    "id": "756530221",
                                                    "speaker": "香菱",
                                                    "text": "你要记得经常过来吃饭哦。",
                                                    "choices": [
                                                        {
                                                            "id": "756530222",
                                                            "text": "我会的。",
                                                            "response": [
                                                                {
                                                                    "id": "756530223",
                                                                    "speaker": "香菱",
                                                                    "text": "那就约好啦。"
                                                                },
                                                                {
                                                                    "id": "756530227",
                                                                    "speaker": "香菱",
                                                                    "text": "扯远了，我记得你刚说要拍画片，需要我帮忙吗？"
                                                                },
                                                                {
                                                                    "id": "756530228",
                                                                    "speaker": "Player",
                                                                    "text": "想请你一起入镜！"
                                                                },
                                                                {
                                                                    "id": "756530229",
                                                                    "speaker": "香菱",
                                                                    "text": "啊，好呀，小事一桩，你觉得什么姿势好？",
                                                                    "choices": [
                                                                        {
                                                                            "id": "756530230",
                                                                            "text": "端正的姿势。",
                                                                            "response": [
                                                                                {
                                                                                    "id": "756530233",
                                                                                    "speaker": "香菱",
                                                                                    "text": "这样吗？",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "756530234",
                                                                                            "text": "很棒！我们开始留影吧！",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "756530235",
                                                                                                    "speaker": "香菱",
                                                                                                    "text": "我准备好了。"
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "756530236",
                                                                                            "text": "还是有趣的姿势合适。",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "756530237",
                                                                                                    "speaker": "香菱",
                                                                                                    "text": "好，那就这样。"
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "756530238",
                                                                                            "text": "还是开心的姿势合适。",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "756530239",
                                                                                                    "speaker": "香菱",
                                                                                                    "text": "好，那就这样。"
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "756530240",
                                                                                            "text": "还是端正的姿势合适。",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "756530241",
                                                                                                    "speaker": "香菱",
                                                                                                    "text": "好，那就这样。"
                                                                                                }
                                                                                            ]
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "756530231",
                                                                            "text": "有趣的姿势。"
                                                                        },
                                                                        {
                                                                            "id": "756530232",
                                                                            "text": "开心的姿势。"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "756530224",
                                                            "text": "看情况。",
                                                            "response": [
                                                                {
                                                                    "id": "756530225",
                                                                    "speaker": "香菱",
                                                                    "text": "你是担心到时候你会走不动路，过不来吗？"
                                                                },
                                                                {
                                                                    "id": "756530226",
                                                                    "speaker": "香菱",
                                                                    "text": "如果那样的话，写信给我好了，我可以给你寄些容易保存的食物。"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "756530214",
                                            "text": "香菱不累吗？",
                                            "response": [
                                                {
                                                    "id": "756530215",
                                                    "speaker": "香菱",
                                                    "text": "怎么会，自己喜欢的事情可是越做越有劲。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "756530205",
                            "text": "正打算找人留影。"
                        }
                    ]
                }
            ]
        }
    ]
