    "talks": [
        {
            "id": "7067201",
            "objective": "前往猫尾酒馆",
            "dialogues": [
                {
                    "id": "706720101",
                    "speaker": "派蒙",
                    "text": "咦，这不是阿圆吗，怎么到猫尾酒馆里来了！"
                },
                {
                    "id": "706720102",
                    "speaker": "派蒙",
                    "text": "阿圆——"
                },
                {
                    "id": "706720103",
                    "speaker": "Player",
                    "text": "你好呀，阿圆！"
                },
                {
                    "id": "706720104",
                    "speaker": "阿圆",
                    "text": "原来是二位啊。"
                },
                {
                    "id": "706720105",
                    "speaker": "派蒙",
                    "text": "阿圆，你怎么会到这儿…不对！原来你也可以从尘歌壶里跑出来的吗！"
                },
                {
                    "id": "706720106",
                    "speaker": "阿圆",
                    "text": "那是当然…嗯，这么说来，在壶天之外与两位相见倒还是第一次。"
                },
                {
                    "id": "706720107",
                    "speaker": "阿圆",
                    "text": "虽说是仙人创造「壶灵」以处理洞天之中的诸多琐碎杂事，不过壶灵活动倒也并不受限于洞天所在。"
                },
                {
                    "id": "706720108",
                    "speaker": "阿圆",
                    "text": "就如阿嘟…哦不，「寻瑰纳琦真君」，平日亦会在四方游走，蒐集那些蒙尘的奇珍之物。"
                },
                {
                    "id": "706720109",
                    "speaker": "阿圆",
                    "text": "哎呀，相较之下，我确实很少从壶中出来就是了。"
                },
                {
                    "id": "706720110",
                    "speaker": "派蒙",
                    "text": "原来是这样。"
                },
                {
                    "id": "706720111",
                    "speaker": "派蒙",
                    "text": "啊，那这次阿圆为什么从壶中出来…",
                    "choices": [
                        {
                            "id": "706720112",
                            "text": "难道是来买喝的？",
                            "response": [
                                {
                                    "id": "706720113",
                                    "speaker": "阿圆",
                                    "text": "虽说也想尝尝此处的饮品与璃月有何不同，但今日毕竟是受人所托。"
                                },
                                {
                                    "id": "706720114",
                                    "speaker": "派蒙",
                                    "text": "受人所托？"
                                },
                                {
                                    "id": "706720117",
                                    "speaker": "阿圆",
                                    "text": "#嗯…而且说到底，这件事还和{NICKNAME}有些牵连呢。"
                                },
                                {
                                    "id": "706720118",
                                    "speaker": "Player",
                                    "text": "我？"
                                },
                                {
                                    "id": "706720119",
                                    "speaker": "阿圆",
                                    "text": "#哎呀，自从「七圣召唤」流行，想必{NICKNAME}也发现了，发函邀请朋友前来酒馆对局颇有乐趣。"
                                },
                                {
                                    "id": "706720120",
                                    "speaker": "阿圆",
                                    "text": "只不过在收到邀请函后须千里迢迢赶来，实在是苦事一件，于是有人便托我来此处利用术法，做出一个类似壶天的小房间。"
                                },
                                {
                                    "id": "706720121",
                                    "speaker": "阿圆",
                                    "text": "收到邀请函欲来此处之人，只是一瞬灵犀，便可出现在那房间之中。"
                                },
                                {
                                    "id": "706720122",
                                    "speaker": "阿圆",
                                    "text": "#这样，{NICKNAME}可以自由使用这房间邀人对局，同时也免去了那些受邀者的一些麻烦。"
                                },
                                {
                                    "id": "706720123",
                                    "speaker": "派蒙",
                                    "text": "哇，那还真的挺方便的！"
                                },
                                {
                                    "id": "706720124",
                                    "speaker": "派蒙",
                                    "text": "不过，这里毕竟是玛格丽特小姐的酒馆，你用仙术这样改造，她知道了不会生气吧！"
                                },
                                {
                                    "id": "706720125",
                                    "speaker": "阿圆",
                                    "text": "嗯…这倒是无碍，毕竟房间本身不在猫尾酒馆内，而且，在这之前当然也已经过酒馆主人的同意。"
                                },
                                {
                                    "id": "706720126",
                                    "speaker": "阿圆",
                                    "text": "「欸呀，璃月的法术还挺好用的嘛，能把酒馆面积扩大一倍吗？」酒馆主人这样说…可惜我的术法做不到这点。"
                                },
                                {
                                    "id": "706720127",
                                    "speaker": "派蒙",
                                    "text": "还、还挺像是玛格丽特小姐会说的话…"
                                },
                                {
                                    "id": "706720128",
                                    "speaker": "阿圆",
                                    "text": "二位在此倒是正好，我本来还正想着什么时候你们回到壶中洞天再说明此事呢。"
                                },
                                {
                                    "id": "706720129",
                                    "speaker": "阿圆",
                                    "text": "那现在就开始吧。"
                                },
                                {
                                    "id": "706720130",
                                    "speaker": "阿圆",
                                    "text": "好，这样就可以了。"
                                },
                                {
                                    "id": "706720131",
                                    "speaker": "阿圆",
                                    "text": "#那么，现在就请{NICKNAME}尽情使用这个房间，邀请各处的朋友前来对局吧。"
                                },
                                {
                                    "id": "706720132",
                                    "speaker": "阿圆",
                                    "text": "啊…差点忘记了，是酒馆里的小家伙拜托我要向你说的——"
                                },
                                {
                                    "id": "706720133",
                                    "speaker": "阿圆",
                                    "text": "#{NICKNAME}，希望你能感受到「七圣召唤」的乐趣！"
                                }
                            ]
                        },
                        {
                            "id": "706720115",
                            "text": "不会是来打牌的吧。",
                            "response": [
                                {
                                    "id": "706720116",
                                    "speaker": "阿圆",
                                    "text": "虽不中却也不远了。我并不是为了牌戏而来，但受托之事确实和牌有关…"
                                },
                                {
                                    "id": "706720134",
                                    "speaker": "Black Screen",
                                    "text": "阿圆驱使仙术，对酒馆进行了一番改建，并更换了对局邀请板。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
