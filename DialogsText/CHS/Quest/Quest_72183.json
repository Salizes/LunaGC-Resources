    "talks": [
        {
            "id": "7218301",
            "objective": "与斑目百兵卫对话",
            "dialogues": [
                {
                    "id": "721830101",
                    "speaker": "派蒙",
                    "text": "这个是…种子？"
                },
                {
                    "id": "721830102",
                    "speaker": "斑目百兵卫",
                    "text": "这是「鸣草」的种子。"
                },
                {
                    "id": "721830103",
                    "speaker": "Player",
                    "text": "你知道这种植物？"
                },
                {
                    "id": "721830104",
                    "speaker": "斑目百兵卫",
                    "text": "唔，算是了解一些吧。我之前见过这种植物，也听人讲过它的奇异之处。"
                },
                {
                    "id": "721830105",
                    "speaker": "斑目百兵卫",
                    "text": "我记得…即使是在无风的情况下，这种植物也会随着雷鸣之声微微振动来着…"
                },
                {
                    "id": "721830106",
                    "speaker": "Player",
                    "text": "种出来好看吗？"
                },
                {
                    "id": "721830107",
                    "speaker": "斑目百兵卫",
                    "text": "如果光论外表的话…应该还是挺好看的吧。"
                },
                {
                    "id": "721830108",
                    "speaker": "斑目百兵卫",
                    "text": "阁下是想试种一下「鸣草」吗？但这附近可没有什么合适的土地…"
                },
                {
                    "id": "721830109",
                    "speaker": "Player",
                    "text": "我有自己的土地。"
                },
                {
                    "id": "721830110",
                    "speaker": "斑目百兵卫",
                    "text": "是、是这样吗？不愧是阁下…连封地都已经拿到了吗？"
                },
                {
                    "id": "721830111",
                    "speaker": "斑目百兵卫",
                    "text": "那敢问阁下，您的封地是在…",
                    "choices": [
                        {
                            "id": "721830112",
                            "text": "不在稻妻内。",
                            "response": [
                                {
                                    "id": "721830113",
                                    "speaker": "斑目百兵卫",
                                    "text": "喔！我也听闻过阁下在蒙德和璃月的壮举。"
                                },
                                {
                                    "id": "721830114",
                                    "speaker": "斑目百兵卫",
                                    "text": "那样的壮举，获赐封地也是正常，真不愧是阁下！"
                                },
                                {
                                    "id": "721830120",
                                    "speaker": "派蒙",
                                    "text": "喂，你说的「土地」，不会是之前婆婆给我们的「尘歌壶」吧？"
                                },
                                {
                                    "id": "721830121",
                                    "speaker": "派蒙",
                                    "text": "那里面，真的能种东西吗？婆婆之前也没有说过…",
                                    "choices": [
                                        {
                                            "id": "721830122",
                                            "text": "回去问问吧。",
                                            "response": [
                                                {
                                                    "id": "721830123",
                                                    "speaker": "派蒙",
                                                    "text": "那好吧，我们回去问问婆婆好了。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "721830124",
                                            "text": "仙人，是很强的。",
                                            "response": [
                                                {
                                                    "id": "721830125",
                                                    "speaker": "派蒙",
                                                    "text": "是、是这样吗？不过婆婆确实很强就是了…"
                                                },
                                                {
                                                    "id": "721830126",
                                                    "speaker": "派蒙",
                                                    "text": "那好吧，我们回去问问婆婆好了。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "721830115",
                            "text": "在一盏壶里。",
                            "response": [
                                {
                                    "id": "721830116",
                                    "speaker": "斑目百兵卫",
                                    "text": "一盏…壶里？阁下，您就别和我开玩笑了。"
                                },
                                {
                                    "id": "721830117",
                                    "speaker": "斑目百兵卫",
                                    "text": "我也听闻过阁下在蒙德和璃月的壮举。"
                                },
                                {
                                    "id": "721830118",
                                    "speaker": "斑目百兵卫",
                                    "text": "想必您的封地不是在璃月，就是在蒙德吧。"
                                },
                                {
                                    "id": "721830119",
                                    "speaker": "斑目百兵卫",
                                    "text": "唉，真不愧是阁下…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7218302",
            "objective": "与萍姥姥对话",
            "dialogues": [
                {
                    "id": "721830201",
                    "speaker": "萍姥姥",
                    "text": "咦？孩子们，你们是来找我的吗？"
                },
                {
                    "id": "721830202",
                    "speaker": "Player",
                    "text": "关于「鸣草」的种子…"
                },
                {
                    "id": "721830203",
                    "speaker": "萍姥姥",
                    "text": "种子…喔，你是想要把这种子，种在「尘歌壶」里吗？"
                },
                {
                    "id": "721830204",
                    "speaker": "萍姥姥",
                    "text": "这倒也不是不行，毕竟那大小也是一片天地。"
                },
                {
                    "id": "721830205",
                    "speaker": "萍姥姥",
                    "text": "只不过，你们今天只拿了这一包种子来，难道，你们就只打算种这一包种子吗？"
                },
                {
                    "id": "721830206",
                    "speaker": "派蒙",
                    "text": "对、对喔！我们都不知道怎么搜集种子…"
                },
                {
                    "id": "721830207",
                    "speaker": "派蒙",
                    "text": "这一包种子种完了之后，我们去哪里找其他的种子呢…"
                },
                {
                    "id": "721830208",
                    "speaker": "萍姥姥",
                    "text": "好了，好了，别着急。我这里正好有一个我很多年前用过的小匣子。"
                },
                {
                    "id": "721830209",
                    "speaker": "萍姥姥",
                    "text": "我之前移栽花卉的时候，都是用这个小匣子装的，装在匣子里的花，能够保存很久。"
                },
                {
                    "id": "721830210",
                    "speaker": "萍姥姥",
                    "text": "而且，把花装在匣子里之后，这匣子还能化出几枚花种…这样，想要种植也很方便。"
                },
                {
                    "id": "721830211",
                    "speaker": "萍姥姥",
                    "text": "虽然这匣子现在有些不太好用了…但至少还留着一些「化种」之能。"
                },
                {
                    "id": "721830212",
                    "speaker": "萍姥姥",
                    "text": "唔…反正我老婆子现在也没怎么用过这匣子了…就把它送给你们吧。"
                },
                {
                    "id": "721830213",
                    "speaker": "萍姥姥",
                    "text": "你们无论是想种些花花草草，还是想种点作物，这匣子应该都能派上些用场。"
                },
                {
                    "id": "721830214",
                    "speaker": "Player",
                    "text": "谢谢婆婆！"
                },
                {
                    "id": "721830215",
                    "speaker": "派蒙",
                    "text": "谢谢婆婆！"
                },
                {
                    "id": "721830216",
                    "speaker": "萍姥姥",
                    "text": "呵呵，不用这么客气，快点去试试看吧，但侍弄花草可不是件简单的事，你们可要做好心理准备啊。"
                },
                {
                    "id": "721830217",
                    "speaker": "派蒙",
                    "text": "婆婆果然很强啊…但是在试那个匣子之前，我们还是先回去壶里，试试种一下那个种子吧。"
                },
                {
                    "id": "721830218",
                    "speaker": "派蒙",
                    "text": "唔，真希望这种子能快点长大…"
                }
            ]
        }
    ]
}