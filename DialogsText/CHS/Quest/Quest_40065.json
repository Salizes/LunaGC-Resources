    "talks": [
        {
            "id": "4006502",
            "objective": "休息到第二天(6点-24点）",
            "dialogues": [
                {
                    "id": "400650201",
                    "speaker": "枫原万叶",
                    "text": "……"
                },
                {
                    "id": "400650202",
                    "speaker": "枫原万叶",
                    "text": "真是想不到，居然能在这里见到你。"
                },
                {
                    "id": "400650203",
                    "speaker": "辛焱",
                    "text": "这是盆景吧？瓷盆非常古朴，就是里面似乎没怎么打理过。"
                }
            ]
        },
        {
            "id": "4006503",
            "objective": "与派蒙对话",
            "dialogues": [
                {
                    "id": "400651001",
                    "speaker": "枫原万叶",
                    "text": "幻觉？不对…如果是幻觉，未免太逼真了。"
                },
                {
                    "id": "400651002",
                    "speaker": "莫娜",
                    "text": "那些一闪而过的东西，就跟我刚才看到的奇怪景象一模一样啊！"
                },
                {
                    "id": "400651003",
                    "speaker": "菲谢尔",
                    "text": "难道…世上真的有幽夜净土…"
                },
                {
                    "id": "400651004",
                    "speaker": "辛焱",
                    "text": "欸？是吗？"
                },
                {
                    "id": "400651005",
                    "speaker": "菲谢尔",
                    "text": "啊咳咳咳！！"
                },
                {
                    "id": "400651006",
                    "speaker": "菲谢尔",
                    "text": "哦呵呵，荒谬，幽夜净土果真如本皇女预测的那般降临了。诸位，这是新的默示录！"
                },
                {
                    "id": "400651007",
                    "speaker": "奥兹",
                    "text": "正是。诸位凭借自己的双眼见证奇迹，是时候了，为创世的瞬间献上礼赞！庆贺！"
                },
                {
                    "id": "400651008",
                    "speaker": "菲谢尔",
                    "text": "哦呵呵呵呵，欢迎来到幽夜净土。"
                },
                {
                    "id": "400651009",
                    "speaker": "派蒙",
                    "text": "她真的好高兴，我都不忍心打断她…"
                },
                {
                    "id": "400651010",
                    "speaker": "莫娜",
                    "text": "她都不觉得惊讶，到底是冒险家，见多识广呢…"
                },
                {
                    "id": "400651011",
                    "speaker": "枫原万叶",
                    "text": "如果这不是幻觉，我们应该过去调查。"
                },
                {
                    "id": "400651012",
                    "speaker": "辛焱",
                    "text": "我有个办法。只要来点刺激不就知道了，疼的话应该会醒过来吧？"
                },
                {
                    "id": "400651013",
                    "speaker": "枫原万叶",
                    "text": "嗯？不是一般的有道理。"
                },
                {
                    "id": "400651014",
                    "speaker": "辛焱",
                    "text": "对吧？来万叶，打我一拳。"
                },
                {
                    "id": "400651015",
                    "speaker": "枫原万叶",
                    "text": "呃，这还是有些不妥。辛焱，不如…你打我一拳。"
                },
                {
                    "id": "400651016",
                    "speaker": "辛焱",
                    "text": "可是我打你你会很痛的吧。"
                },
                {
                    "id": "400651017",
                    "speaker": "派蒙",
                    "text": "哎呀不要这样！"
                },
                {
                    "id": "400651018",
                    "speaker": "派蒙",
                    "text": "#还是交给我们吧！喂{NICKNAME}，让我打一下好不好？",
                    "choices": [
                        {
                            "id": "400651019",
                            "text": "？",
                            "response": [
                                {
                                    "id": "400651021",
                                    "speaker": "奇妙的船",
                                    "text": "哈哈哈哈，你们好幽默。幻觉？原来对人类而言，能听见我们说话是一种幻觉啊。"
                                },
                                {
                                    "id": "400651022",
                                    "speaker": "松鼠",
                                    "text": "老兄，你应该知道的嘛，据说人长大以后就会忘记很多事，失去许多能力。"
                                },
                                {
                                    "id": "400651023",
                                    "speaker": "奇妙的船",
                                    "text": "也是啊，多可惜。遥想当年我还在船队工作的时候，哪想过今天会为这种事情发出笑声呢？"
                                },
                                {
                                    "id": "400651024",
                                    "speaker": "奇妙的船",
                                    "text": "喂各位女士先生，不想去那些让你们在意的地方看看吗？"
                                },
                                {
                                    "id": "400651025",
                                    "speaker": "派蒙",
                                    "text": "当然想啊！可是，要怎么过去呢？"
                                },
                                {
                                    "id": "400651026",
                                    "speaker": "奇妙的船",
                                    "text": "看！看！"
                                },
                                {
                                    "id": "400651027",
                                    "speaker": "莫娜",
                                    "text": "看什么？"
                                },
                                {
                                    "id": "400651028",
                                    "speaker": "奇妙的船",
                                    "text": "哎呀当然是看我啦！哦对，忘了自我介绍。我是这一带最聪明最有灵性的船，称呼的话…随你们喜欢。"
                                },
                                {
                                    "id": "400651029",
                                    "speaker": "派蒙",
                                    "text": "没有名字吗？"
                                },
                                {
                                    "id": "400651030",
                                    "speaker": "奇妙的船",
                                    "text": "名字什么的，我记不起来了，只记得自己从稻妻来。"
                                },
                                {
                                    "id": "400651031",
                                    "speaker": "派蒙",
                                    "text": "既然这样，就叫你…「大肉丸」怎么样！稻妻的名字都是什么什么丸，这个刚刚好。"
                                },
                                {
                                    "id": "400651032",
                                    "speaker": "奇妙的船",
                                    "text": "大肉丸？哈哈，也好。"
                                },
                                {
                                    "id": "400651033",
                                    "speaker": "大肉丸",
                                    "text": "遇到我可是你们的福气，无论是怎样的风浪我都能轻易穿过，无论是怎样的海水都不配当我的对手，所以…"
                                },
                                {
                                    "id": "400651034",
                                    "speaker": "大肉丸",
                                    "text": "上船来，我送你们去想去的地方！"
                                },
                                {
                                    "id": "400651035",
                                    "speaker": "松鼠",
                                    "text": "噢老兄，你真好，跟那个把我们扔到这里的风神完全不一样！"
                                },
                                {
                                    "id": "400651036",
                                    "speaker": "Player",
                                    "text": "风神？"
                                },
                                {
                                    "id": "400651037",
                                    "speaker": "松鼠",
                                    "text": "就是蒙德的风神。"
                                },
                                {
                                    "id": "400651038",
                                    "speaker": "松鼠",
                                    "text": "你们不知道吗？这些海岛里有几座以前是蒙德的山头，当年风神为了修整地形，把山顶削下来整个扔到海中。"
                                },
                                {
                                    "id": "400651039",
                                    "speaker": "松鼠",
                                    "text": "我的曾曾曾曾曾曾曾不知道多少辈祖父，就是跟着山头一起飞到这里来的。可恶的风神！"
                                },
                                {
                                    "id": "400651040",
                                    "speaker": "派蒙",
                                    "text": "怎么会有这种事！"
                                },
                                {
                                    "id": "400651041",
                                    "speaker": "松鼠",
                                    "text": "哈哈，从那以后我们家族就世代生活在此喽。幸好还有其他几窝松鼠也被扔了过来，我们就在这里建立王国。"
                                },
                                {
                                    "id": "400651042",
                                    "speaker": "松鼠",
                                    "text": "好处是没有天敌，整个山头的松果都是我们的。坏处是…哪儿也去不了。"
                                },
                                {
                                    "id": "400651043",
                                    "speaker": "派蒙",
                                    "text": "没想到，幽夜净土居然是松鼠帝国。"
                                },
                                {
                                    "id": "400651044",
                                    "speaker": "菲谢尔",
                                    "text": "大胆！大胆！"
                                },
                                {
                                    "id": "400651045",
                                    "speaker": "奥兹",
                                    "text": "派蒙，不可胡言乱语。幽夜净土，当然是夜鸦的国度了。"
                                },
                                {
                                    "id": "400651046",
                                    "speaker": "大肉丸",
                                    "text": "喂那边的稻妻小兄弟，咱们是老乡呀。稻妻的男子汉，得有出海冒险的勇气才行。你来不来？"
                                },
                                {
                                    "id": "400651047",
                                    "speaker": "枫原万叶",
                                    "text": "……"
                                },
                                {
                                    "id": "400651048",
                                    "speaker": "枫原万叶",
                                    "text": "出海…不就是离开故乡去往远方吗。"
                                },
                                {
                                    "id": "400651049",
                                    "speaker": "大肉丸",
                                    "text": "是啊，需要很多很多的勇气，和一点点绝情。走了未必再能回来，但不出发，就永远困于自己心中。"
                                },
                                {
                                    "id": "400651050",
                                    "speaker": "枫原万叶",
                                    "text": "…哈。大肉丸兄，你所言甚是，我若是听了这话还不跟你走一趟，就称不上男子汉了。"
                                },
                                {
                                    "id": "400651051",
                                    "speaker": "枫原万叶",
                                    "text": "各位，要一起去吗？我想到刚才有异象的岛上去看看。"
                                },
                                {
                                    "id": "400651052",
                                    "speaker": "枫原万叶",
                                    "text": "此外，我闻到了船的气味。古老木材，防水清漆…确实是稻妻的气味。我愿意相信这位船兄弟。"
                                },
                                {
                                    "id": "400651053",
                                    "speaker": "莫娜",
                                    "text": "唔哦，大家觉得呢？"
                                },
                                {
                                    "id": "400651054",
                                    "speaker": "菲谢尔",
                                    "text": "奥兹，为我搭好梯板，本皇女要驰骋海上！"
                                },
                                {
                                    "id": "400651055",
                                    "speaker": "辛焱",
                                    "text": "都去都去，一起长长见识。"
                                },
                                {
                                    "id": "400651056",
                                    "speaker": "大肉丸",
                                    "text": "哈哈哈，痛快，那就出发！"
                                },
                                {
                                    "id": "400651057",
                                    "speaker": "松鼠",
                                    "text": "哎哎，路上小心哪！"
                                }
                            ]
                        },
                        {
                            "id": "400651020",
                            "text": "你是不是傻？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "4006504",
            "objective": "登上「大肉丸」",
            "dialogues": [
                {
                    "id": "400650401",
                    "speaker": "派蒙",
                    "text": "这封信，看起来是万叶爸爸写的呢。"
                },
                {
                    "id": "400650402",
                    "speaker": "派蒙",
                    "text": "原来他们家几代人都有养盆景的习惯啊。"
                },
                {
                    "id": "400650403",
                    "speaker": "派蒙",
                    "text": "唔…不过，我们居然能看到他父亲的笔记，真稀奇。"
                }
            ]
        },
        {
            "id": "4006505",
            "objective": "前往有异象的岛屿",
            "dialogues": [
                {
                    "id": "400651501",
                    "speaker": "辛焱",
                    "text": "所以，它是祖辈留下的古物对吧？就这么空着，有点可惜了。"
                },
                {
                    "id": "400651502",
                    "speaker": "辛焱",
                    "text": "唔…万叶，我在想，你要不要试着找点东西把它装满？"
                },
                {
                    "id": "400651503",
                    "speaker": "枫原万叶",
                    "text": "嗯。"
                },
                {
                    "id": "400651504",
                    "speaker": "枫原万叶",
                    "text": "虽然我还不明白它为什么会在出现在这里，但可以一试。"
                },
                {
                    "id": "400651505",
                    "speaker": "派蒙",
                    "text": "呜哇？！"
                }
            ]
        },
        {
            "id": "4006517",
            "objective": "触碰盆景",
            "dialogues": []
        },
        {
            "id": "4006506",
            "objective": "与众人对话",
            "dialogues": [
                {
                    "id": "400650301",
                    "speaker": "派蒙",
                    "text": "哈哈，我就知道事情没那么简单。"
                },
                {
                    "id": "400650302",
                    "speaker": "Player",
                    "text": "万叶呢？"
                },
                {
                    "id": "400650303",
                    "speaker": "派蒙",
                    "text": "欸？这么一说，大家都在，只有万叶不见了？"
                },
                {
                    "id": "400650304",
                    "speaker": "辛焱",
                    "text": "喂——！万叶！你在哪儿？没事吧？"
                },
                {
                    "id": "400650305",
                    "speaker": "派蒙",
                    "text": "好像没有回应呢。要不，我们边走边找他吧。"
                },
                {
                    "id": "400650306",
                    "speaker": "莫娜",
                    "text": "这里的布置，让我有一种进入了豪宅的感觉…我想，或许这里不是危险的迷宫，而是某个人的家。"
                },
                {
                    "id": "400650307",
                    "speaker": "菲谢尔",
                    "text": "有趣。这里的秘密，就等着本皇女一探究竟了。"
                }
            ]
        },
        {
            "id": "4006507",
            "objective": "调查四周",
            "dialogues": []
        },
        {
            "id": "4006524",
            "objective": "(test)(hide)删除指引点$HIDDEN",
            "dialogues": []
        },
        {
            "id": "4006509",
            "objective": "操作装置，深入探查",
            "dialogues": [
                {
                    "id": "400650901",
                    "speaker": "枫原景春",
                    "text": "父亲，您在刻什么？"
                },
                {
                    "id": "400650902",
                    "speaker": "枫原久通",
                    "text": "哈哈，这是一座记录我异国见闻的假山。稍后，我要将它放入我的盆景。"
                },
                {
                    "id": "400650903",
                    "speaker": "枫原久通",
                    "text": "这几年为事业忙碌太多，都顾不上陪孙子喽。但愿他别学我，长大了，要花更多时间去看这世界。"
                }
            ]
        },
        {
            "id": "4006510",
            "objective": "进入走廊，深入探查",
            "dialogues": []
        },
        {
            "id": "4006516",
            "objective": "(test)(hide)隐藏检测信件$HIDDEN",
            "dialogues": []
        },
        {
            "id": "4006511",
            "objective": "调查四周",
            "dialogues": [
                {
                    "id": "400651101",
                    "speaker": "枫原万叶",
                    "text": "这是…我家祖传的盆景。传承了许多代，只可惜，到我这一辈时，它去了天领奉行的库房。"
                },
                {
                    "id": "400651102",
                    "speaker": "枫原万叶",
                    "text": "哈哈，几位还不知道，我以前当过稻妻的通缉犯，逃亡了好一阵。这盆盆景，应该就是我走后被官府抄走的。"
                },
                {
                    "id": "400651103",
                    "speaker": "菲谢尔",
                    "text": "通缉…"
                },
                {
                    "id": "400651104",
                    "speaker": "莫娜",
                    "text": "…唉。人们活着，又有谁是真正无忧无虑的呢？"
                }
            ]
        },
        {
            "id": "4006512",
            "objective": "调查周围找到开门的方法",
            "dialogues": [
                {
                    "id": "400651201",
                    "speaker": "枫原万叶",
                    "text": "这是…我家祖传的盆景。之前我在天领奉行的库房见过它，不过跟现在稍有区别。"
                },
                {
                    "id": "400651202",
                    "speaker": "枫原万叶",
                    "text": "那时，盆中有棵枯死多年的植物。"
                },
                {
                    "id": "400651203",
                    "speaker": "莫娜",
                    "text": "树木都枯死了，为什么还留在盆里？"
                },
                {
                    "id": "400651204",
                    "speaker": "枫原万叶",
                    "text": "是个信号，暗示「盆中藏有秘密」。"
                },
                {
                    "id": "400651205",
                    "speaker": "枫原万叶",
                    "text": "盆底有封信，藏着有关我家族的古老秘密。看完信我并没有将盆景带走，它应该还在仓库里才对。"
                },
                {
                    "id": "400651206",
                    "speaker": "枫原万叶",
                    "text": "不知是谁将它清空，又为何将它摆在这里…"
                }
            ]
        },
        {
            "id": "4006513",
            "objective": "操作装置，深入探查",
            "dialogues": [
                {
                    "id": "400651301",
                    "speaker": "派蒙",
                    "text": "是为了留下那封藏有秘密的信吧？"
                },
                {
                    "id": "400651302",
                    "speaker": "枫原万叶",
                    "text": "嗯。此外，也算是个纪念吧。"
                },
                {
                    "id": "400651303",
                    "speaker": "枫原万叶",
                    "text": "祖父赶回家中，可曾祖父已经病逝，父子俩没能见上最后一面。自那之后，祖父就经常站在盆景前发呆。"
                },
                {
                    "id": "400651304",
                    "speaker": "枫原万叶",
                    "text": "再后来，祖父也开始制作盆景，不过区别于曾祖父，他不爱绿植，而是喜欢往盆中摆放山石。"
                },
                {
                    "id": "400651305",
                    "speaker": "枫原万叶",
                    "text": "或许是耳濡目染的关系，我父亲也继承了这一喜好。那些年，家里的院子里全是各色盆景。"
                }
            ]
        },
        {
            "id": "4006501",
            "objective": "(test)(hide)第一段对话$HIDDEN",
            "dialogues": [
                {
                    "id": "400650701",
                    "speaker": "枫原久通",
                    "text": "身在人间，心向山水。我们枫原家世代传承皆如此。"
                },
                {
                    "id": "400650702",
                    "speaker": "枫原久通",
                    "text": "这个家早晚要交到你手上，万叶。"
                },
                {
                    "id": "400650703",
                    "speaker": "枫原久通",
                    "text": "到那时，你可莫忘了本心。"
                }
            ]
        },
        {
            "id": "4006508",
            "objective": "放置供物",
            "dialogues": [
                {
                    "id": "400650801",
                    "speaker": "枫原久通",
                    "text": "万叶，你听着。枫原家这些刀剑，绝不是为伤人而造。"
                }
            ]
        },
        {
            "id": "4006518",
            "objective": "(test)(hide)第二段对话$HIDDEN",
            "dialogues": []
        },
        {
            "id": "4006520",
            "objective": "放置供物",
            "dialogues": []
        },
        {
            "id": "4006519",
            "objective": "(test)(hide)第三段对话$HIDDEN",
            "dialogues": []
        },
        {
            "id": "4006521",
            "objective": "放置供物",
            "dialogues": []
        },
        {
            "id": "4006522",
            "objective": "(test)(hide)回滚隔离环$HIDDEN",
            "dialogues": []
        },
        {
            "id": "4006514",
            "objective": "寻找万叶",
            "dialogues": [
                {
                    "id": "400650501",
                    "speaker": "辛焱",
                    "text": "你在这儿啊！"
                },
                {
                    "id": "400650502",
                    "speaker": "枫原万叶",
                    "text": "嗯？各位刚才去哪儿了？"
                },
                {
                    "id": "400650503",
                    "speaker": "派蒙",
                    "text": "这里是座迷宫哦！我们都被关在迷宫里头了，只有你不在。"
                },
                {
                    "id": "400650504",
                    "speaker": "枫原万叶",
                    "text": "我一直在这间房间里，怎么都出不去。不过这里的模样，倒是跟我童年所住的卧室十分相似。"
                },
                {
                    "id": "400650505",
                    "speaker": "派蒙",
                    "text": "那这不就是你家吗？为什么会困住你？难道，迷宫不想你进去？"
                },
                {
                    "id": "400650506",
                    "speaker": "Black Screen",
                    "text": "向万叶描述了刚才经历的种种…"
                },
                {
                    "id": "400650507",
                    "speaker": "枫原万叶",
                    "text": "……"
                },
                {
                    "id": "400650508",
                    "speaker": "枫原万叶",
                    "text": "看来这整座迷宫都是以我家为原型。迷宫里那些声音，全是父亲和祖父对我说过的话。"
                },
                {
                    "id": "400650509",
                    "speaker": "枫原万叶",
                    "text": "说它不让我进去…嗯，确实只有我不能参与探索。"
                },
                {
                    "id": "400650510",
                    "speaker": "莫娜",
                    "text": "我倒觉得这些不可思议的建筑应该是某种幻境。听万叶刚才说的，这是以他的经历为原型制造出来的东西。"
                },
                {
                    "id": "400650511",
                    "speaker": "菲谢尔",
                    "text": "为何只有万叶卿遭到排斥？"
                },
                {
                    "id": "400650512",
                    "speaker": "枫原万叶",
                    "text": "…或许，这些情况正是我自己造成的。"
                },
                {
                    "id": "400650513",
                    "speaker": "枫原万叶",
                    "text": "对我而言，从前的事都已过去。天地万物，自有其规律。人…是不能走过去的路的。"
                },
                {
                    "id": "400650514",
                    "speaker": "枫原万叶",
                    "text": "大概是因为我有这种想法，幻境才不让我进入。"
                },
                {
                    "id": "400650515",
                    "speaker": "辛焱",
                    "text": "好像能理解，是非常豁达的想法呢。"
                },
                {
                    "id": "400650516",
                    "speaker": "枫原万叶",
                    "text": "所想所思，必有结果。我不觉得奇怪，大家也不必担心。"
                },
                {
                    "id": "400650517",
                    "speaker": "枫原万叶",
                    "text": "唔…刚才我们是接触到盆景才进来的，对吧？那再碰一次的话…"
                }
            ]
        },
        {
            "id": "4006523",
            "objective": "(test)(hide)隐藏更换假山$HIDDEN",
            "dialogues": [
                {
                    "id": "400652301",
                    "speaker": "枫原万叶",
                    "text": "这只瓷盆，也作为传家宝一直流传到了我这辈。"
                },
                {
                    "id": "400652302",
                    "speaker": "枫原万叶",
                    "text": "它能出现在这里，甚至成为幻境的入口，一定不是偶然。简直像是…在给我机会弥补遗憾。"
                },
                {
                    "id": "400652303",
                    "speaker": "Player",
                    "text": "遗憾？"
                },
                {
                    "id": "400652304",
                    "speaker": "枫原万叶",
                    "text": "我来自稻妻，我的家族「枫原」，在过去能算是名门望族。"
                },
                {
                    "id": "400652305",
                    "speaker": "枫原万叶",
                    "text": "…雷电五传一事令枫原家一落千丈。到我这辈，已算是家道中落。"
                },
                {
                    "id": "400652306",
                    "speaker": "枫原万叶",
                    "text": "我不想被通缉，就逃离了稻妻。枫原家人去楼空，这盆盆景，便和家中各色器皿一道被官府收了去。"
                },
                {
                    "id": "400652307",
                    "speaker": "枫原万叶",
                    "text": "…如果有机会，我也想像祖辈那样，亲手雕刻自己游历过的名山胜景，摆到传家盆景里。"
                },
                {
                    "id": "400652308",
                    "speaker": "莫娜",
                    "text": "…唉。"
                },
                {
                    "id": "400652309",
                    "speaker": "枫原万叶",
                    "text": "既然这盆中的内容能对幻境造成影响，我也想试着做些手工。"
                },
                {
                    "id": "400652310",
                    "speaker": "枫原万叶",
                    "text": "风格上…唔，是选曾祖父喜欢的植物系盆景，还是选祖父和父亲喜欢的山石系盆景呢…"
                },
                {
                    "id": "400652311",
                    "speaker": "枫原万叶",
                    "text": "…好像还是山石更适合我。"
                },
                {
                    "id": "400652312",
                    "speaker": "派蒙",
                    "text": "做这种盆景需要什么东西吗？"
                },
                {
                    "id": "400652313",
                    "speaker": "枫原万叶",
                    "text": "我想，应该准备一套工具，和一些加工后能成为装饰品的石头。"
                },
                {
                    "id": "400652314",
                    "speaker": "派蒙",
                    "text": "明白了，我们一起找！"
                },
                {
                    "id": "400652315",
                    "speaker": "辛焱",
                    "text": "碰碰运气吧。既然盆景在这里，与它有关的东西不会离得太远。"
                },
                {
                    "id": "400652316",
                    "speaker": "菲谢尔",
                    "text": "诚然！万叶卿，尽情寻觅吧，本皇女也会率众随同，助你找回失落的秘宝。"
                },
                {
                    "id": "400652317",
                    "speaker": "枫原万叶",
                    "text": "好，多谢各位。"
                }
            ]
        },
        {
            "id": "4006515",
            "objective": "与众人进行讨论",
            "dialogues": []
        },
        {
            "id": "4006501",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "400650101",
                    "speaker": "Black Screen",
                    "text": "恍惚中，似乎听到了人的交谈声，以及派蒙大惊小怪又故作冷静的招呼声…"
                },
                {
                    "id": "400650102",
                    "speaker": "派蒙",
                    "text": "……啦！别睡啦！"
                },
                {
                    "id": "400650103",
                    "speaker": "派蒙",
                    "text": "#快起来呀，喂{NICKNAME}！",
                    "choices": [
                        {
                            "id": "400650104",
                            "text": "（还不想起床…）",
                            "response": [
                                {
                                    "id": "400650106",
                                    "speaker": "派蒙",
                                    "text": "太好了，你总算醒啦！现在有一个好消息跟一个坏消息，唔，你想先听哪个？"
                                },
                                {
                                    "id": "400650107",
                                    "speaker": "Player",
                                    "text": "……"
                                },
                                {
                                    "id": "400650108",
                                    "speaker": "派蒙",
                                    "text": "啊啊啊！我错了我错了，行了吧？别睡了出事啦！"
                                },
                                {
                                    "id": "400650109",
                                    "speaker": "Player",
                                    "text": "你说吧，我做好准备了。"
                                },
                                {
                                    "id": "400650110",
                                    "speaker": "派蒙",
                                    "text": "那我先说坏消息。坏消息就是，岛上真的出事了。"
                                },
                                {
                                    "id": "400650111",
                                    "speaker": "派蒙",
                                    "text": "然后说好消息，好消息是…似乎跟我们昨天的担心没什么关系，现在面临的是别的问题。"
                                },
                                {
                                    "id": "400650112",
                                    "speaker": "Player",
                                    "text": "什么问题？"
                                },
                                {
                                    "id": "400650113",
                                    "speaker": "？？？",
                                    "text": "#噢！那家伙醒了！快看看{M#他}{F#她}！"
                                },
                                {
                                    "id": "400650114",
                                    "speaker": "？？？",
                                    "text": "#可别吓到{M#他}{F#她}，我猜{M#他}{F#她}跟其他家伙没什么区别。人类嘛，多少都有些脆弱。"
                                },
                                {
                                    "id": "400650115",
                                    "speaker": "？？？",
                                    "text": "朋友你好吗？感觉怎么样，有没有哪里不舒服？"
                                },
                                {
                                    "id": "400650116",
                                    "speaker": "派蒙",
                                    "text": "如你所见，船说话了。"
                                },
                                {
                                    "id": "400650117",
                                    "speaker": "Player",
                                    "text": "我再睡会儿吧…"
                                },
                                {
                                    "id": "400650118",
                                    "speaker": "派蒙",
                                    "text": "不要逃避了啦！"
                                },
                                {
                                    "id": "400650119",
                                    "speaker": "松鼠",
                                    "text": "真是可怜的家伙，听见我们说话吓成这样…"
                                },
                                {
                                    "id": "400650120",
                                    "speaker": "奇妙的船",
                                    "text": "#哈哈哈，不怪{M#他}{F#她}。人类嘛，一般情况下听不到像我们这样的个体开口说话。"
                                },
                                {
                                    "id": "400650121",
                                    "speaker": "派蒙",
                                    "text": "等等，你们难道一直会说话？"
                                },
                                {
                                    "id": "400650122",
                                    "speaker": "松鼠",
                                    "text": "噢当然当然，不然我们怎么跟同类交流？"
                                },
                                {
                                    "id": "400650123",
                                    "speaker": "派蒙",
                                    "text": "也就是说我们突然能听懂了？好奇怪…"
                                },
                                {
                                    "id": "400650124",
                                    "speaker": "松鼠",
                                    "text": "也可能是你们突然变聪明了吧，恭喜啊。"
                                },
                                {
                                    "id": "400650125",
                                    "speaker": "莫娜",
                                    "text": "#哟，{NICKNAME}起床了？太阳都晒屁股了哦。"
                                },
                                {
                                    "id": "400650126",
                                    "speaker": "派蒙",
                                    "text": "你们回来啦！"
                                },
                                {
                                    "id": "400650127",
                                    "speaker": "枫原万叶",
                                    "text": "嗯。四处走了走，风景真美，天气也好。这次旅行的确让我身心舒畅。"
                                },
                                {
                                    "id": "400650128",
                                    "speaker": "奥兹",
                                    "text": "一切都好，除了岛上某些地方稍显怪异…"
                                },
                                {
                                    "id": "400650129",
                                    "speaker": "菲谢尔",
                                    "text": "呵呵呵…黑暗的眷属已然降临，此皆为我幽夜净土重返人世的预兆。欢愉吧诸位！"
                                },
                                {
                                    "id": "400650130",
                                    "speaker": "奥兹",
                                    "text": "小姐的意思是，她从没见过这种事，也没想到会有这种展开。"
                                },
                                {
                                    "id": "400650131",
                                    "speaker": "派蒙",
                                    "text": "她不是那个意思吧！"
                                },
                                {
                                    "id": "400650132",
                                    "speaker": "奥兹",
                                    "text": "噢僭越了。那就请各位把刚才那句话当成我的感想。"
                                },
                                {
                                    "id": "400650133",
                                    "speaker": "Player",
                                    "text": "发生什么事了？"
                                },
                                {
                                    "id": "400650134",
                                    "speaker": "枫原万叶",
                                    "text": "昨晚过后，岛上似乎多了一些…平日很难见到的奇观。"
                                },
                                {
                                    "id": "400650135",
                                    "speaker": "莫娜",
                                    "text": "对。鸟在水里游，松鼠在天上飞，天上同时有太阳月亮…之类的。有些景色一闪而过，但怎么想都不对劲。"
                                },
                                {
                                    "id": "400650136",
                                    "speaker": "辛焱",
                                    "text": "我在小岛上听到了奇怪的振翅声，但完全没看到周围有正在飞翔的生物。"
                                },
                                {
                                    "id": "400650137",
                                    "speaker": "枫原万叶",
                                    "text": "嗯，还有水流声和花草的香味。这片海岛有很多植物，但那种香味，跟它们都不一样。"
                                },
                                {
                                    "id": "400650138",
                                    "speaker": "辛焱",
                                    "text": "总觉得，是一些肉眼看不见的东西…"
                                },
                                {
                                    "id": "400650139",
                                    "speaker": "莫娜",
                                    "text": "我试图占卜，可水占盘非常混乱，没法解读。"
                                },
                                {
                                    "id": "400650140",
                                    "speaker": "派蒙",
                                    "text": "有种不好的预感，我们…不会是被卷入什么麻烦了吧…"
                                },
                                {
                                    "id": "400650141",
                                    "speaker": "菲谢尔",
                                    "text": "唔…虽然本皇女决意在此召唤幽夜净土，但如此怪异的景象…是罪罚之徒在阻挠我吗？"
                                },
                                {
                                    "id": "400650142",
                                    "speaker": "派蒙",
                                    "text": "#喂{NICKNAME}，你说会不会是改造这座岛的人干的好事？",
                                    "choices": [
                                        {
                                            "id": "400650143",
                                            "text": "……",
                                            "response": [
                                                {
                                                    "id": "400650145",
                                                    "speaker": "派蒙",
                                                    "text": "可如果是她的话，没必要做这些事吧…"
                                                },
                                                {
                                                    "id": "400650146",
                                                    "speaker": "松鼠",
                                                    "text": "哈哈老兄，瞧他们的样子，好像被吓得不轻呢！"
                                                },
                                                {
                                                    "id": "400650147",
                                                    "speaker": "奇妙的船",
                                                    "text": "可不是嘛，谁遇到怪事都会大吃一惊。"
                                                },
                                                {
                                                    "id": "400650148",
                                                    "speaker": "奇妙的船",
                                                    "text": "要知道我可是见过许多水域的老船，试过对许多水手说话，就算如此，也没有任何人回应。"
                                                },
                                                {
                                                    "id": "400650149",
                                                    "speaker": "松鼠",
                                                    "text": "对对，要不是在这种环境里，谁能想到人类会跟我们搭话呢？"
                                                },
                                                {
                                                    "id": "400650150",
                                                    "speaker": "派蒙",
                                                    "text": "这种环境？这种环境是什么环境？"
                                                },
                                                {
                                                    "id": "400650151",
                                                    "speaker": "莫娜",
                                                    "text": "环境…难道说，是环境变化影响了我的占卜结果？",
                                                    "choices": [
                                                        {
                                                            "id": "400650152",
                                                            "text": "我觉得自己…",
                                                            "response": [
                                                                {
                                                                    "id": "400650154",
                                                                    "speaker": "派蒙",
                                                                    "text": "呃…就算你这么说…"
                                                                },
                                                                {
                                                                    "id": "400650155",
                                                                    "speaker": "派蒙",
                                                                    "text": "但梦本身应该不化为现实吧？更不可能让你突然听懂船和松鼠说…啊！"
                                                                },
                                                                {
                                                                    "id": "400650156",
                                                                    "speaker": "辛焱",
                                                                    "text": "怎么了？"
                                                                },
                                                                {
                                                                    "id": "400650157",
                                                                    "speaker": "派蒙",
                                                                    "text": "那个，那个！"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "400650153",
                                                            "text": "简直像在做梦。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "400650144",
                                            "text": "不无可能。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "400650105",
                            "text": "（但不能放着派蒙不管。）"
                        }
                    ]
                }
            ]
        },
        {
            "id": "4006506",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "400650601",
                    "speaker": "派蒙",
                    "text": "出来啦！"
                },
                {
                    "id": "400650602",
                    "speaker": "辛焱",
                    "text": "你们快看，那边整座山都变了。"
                },
                {
                    "id": "400650603",
                    "speaker": "枫原万叶",
                    "text": "…等等。"
                },
                {
                    "id": "400650604",
                    "speaker": "枫原万叶",
                    "text": "……"
                },
                {
                    "id": "400650605",
                    "speaker": "枫原万叶",
                    "text": "各位，我有个猜想。这片幻境的变化，似乎跟盆景有关。"
                },
                {
                    "id": "400650606",
                    "speaker": "枫原万叶",
                    "text": "我听父亲提过，这只瓷盆最初是曾祖父的收藏品。他老人家喜欢盆栽盆景，常在院中亲手打理。"
                },
                {
                    "id": "400650607",
                    "speaker": "枫原万叶",
                    "text": "后来家中出事，祖父赶往他乡寻找扶持家族的办法，而曾祖父，恰在此时染上重病。"
                },
                {
                    "id": "400650608",
                    "speaker": "枫原万叶",
                    "text": "他知道祖父没有照看盆景的兴趣，临终前将大部分精心制作的盆景都赠与他人，只留了这一盆。"
                }
            ]
        },
        {
            "id": "4006514",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "400651401",
                    "speaker": "松鼠",
                    "text": "嗨朋友，你的眼神告诉我，你还是很惊讶。"
                },
                {
                    "id": "400651402",
                    "speaker": "松鼠",
                    "text": "噢别这样，我都没有惊讶你的到来不是吗？让我们友好相处吧。"
                },
                {
                    "id": "400651403",
                    "speaker": "松鼠",
                    "text": "想知道哪里有好吃松果的话，随时来找我。"
                },
                {
                    "id": "400651404",
                    "speaker": "松鼠",
                    "text": "啊…蒙德，会是什么样的地方呢…"
                }
            ]
        },
        {
            "id": "4006599",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "400659901",
                    "speaker": "大肉丸",
                    "text": "女士先生们，好胆魄。我大肉丸欣赏有勇气的年轻人。"
                },
                {
                    "id": "400659902",
                    "speaker": "大肉丸",
                    "text": "来这里多久了？哎呀，不是第一次来？哦哈哈哈，真是有意思。"
                },
                {
                    "id": "400659903",
                    "speaker": "大肉丸",
                    "text": "快到喽，各位收拾好行李，下船注意脚底不要打滑。"
                },
                {
                    "id": "400659904",
                    "speaker": "派蒙",
                    "text": "你们看，那边有个东西。"
                },
                {
                    "id": "400659905",
                    "speaker": "枫原万叶",
                    "text": "那是…"
                },
                {
                    "id": "400659906",
                    "speaker": "枫原万叶",
                    "text": "各位，靠近看看。"
                },
                {
                    "id": "400659907",
                    "speaker": "辛焱",
                    "text": "一个老人说：「我们枫原家…」"
                },
                {
                    "id": "400659908",
                    "speaker": "莫娜",
                    "text": "听口气，可能是万叶的爷爷。"
                },
                {
                    "id": "400659909",
                    "speaker": "奥兹",
                    "text": "另一个声音应该是万叶卿的父亲吧？"
                },
                {
                    "id": "400659910",
                    "speaker": "菲谢尔",
                    "text": "噢？原来如此…一切都是万叶卿的回忆。"
                },
                {
                    "id": "400659911",
                    "speaker": "辛焱",
                    "text": "似乎是万叶在旅行途中写的信。"
                },
                {
                    "id": "400659912",
                    "speaker": "莫娜",
                    "text": "信的内容，让人很难过…"
                },
                {
                    "id": "400659913",
                    "speaker": "菲谢尔",
                    "text": "…万叶卿…"
                }
            ]
        }
    ]
}