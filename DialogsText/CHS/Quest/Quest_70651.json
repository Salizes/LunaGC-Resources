    "talks": [
        {
            "id": "7065101",
            "objective": "与瓦格纳对话",
            "dialogues": [
                {
                    "id": "706510201",
                    "speaker": "瓦格纳",
                    "text": "不过魔晶块很难加工，如果想要用它做锻造材料的话，还要用不少其他材料来辅助。"
                },
                {
                    "id": "706510202",
                    "speaker": "瓦格纳",
                    "text": "不过，我刚从野外回来，好像矿物都被采集过了，现在你想采矿的话，估计采不到什么了…"
                },
                {
                    "id": "706510203",
                    "speaker": "瓦格纳",
                    "text": "唔…这样好了，你过段时间再来找我吧，到时候我再把我知道的矿物位置帮你标在地图上。"
                }
            ]
        },
        {
            "id": "7065101",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "706510101",
                    "speaker": "瓦格纳",
                    "text": "唔，矿石好像有点不够用了…"
                },
                {
                    "id": "706510102",
                    "speaker": "Player",
                    "text": "关于采集矿石…"
                },
                {
                    "id": "706510103",
                    "speaker": "瓦格纳",
                    "text": "矿石？你是要锻造什么东西吗？是武器，还是铠甲？"
                },
                {
                    "id": "706510104",
                    "speaker": "瓦格纳",
                    "text": "你如果想要采集矿石的话，我倒是知道哪里采比较方便。"
                },
                {
                    "id": "706510105",
                    "speaker": "瓦格纳",
                    "text": "但矿石也分很多种，有最常用的铁块，用起来还算顺手的白铁块，品质还不错的水晶块…"
                },
                {
                    "id": "706510106",
                    "speaker": "瓦格纳",
                    "text": "还有一种叫做魔晶块的矿物，品质很不错，能够锻造出很优质的东西。"
                }
            ]
        },
        {
            "id": "7065103",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "706510301",
                    "speaker": "瓦格纳",
                    "text": "唔…这样，我把我知道的矿物位置给你标在地图上。"
                },
                {
                    "id": "706510302",
                    "speaker": "瓦格纳",
                    "text": "如果你有需要的话，自己去采就是了。如果你忘记了位置，可以再来问我。"
                },
                {
                    "id": "706510303",
                    "speaker": "瓦格纳",
                    "text": "不过，多采几次，你应该就能记住位置了。"
                }
            ]
        },
        {
            "id": "7065104",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "706510401",
                    "speaker": "瓦格纳",
                    "text": "但魔晶块很难采到…唔，这样，我把我知道的矿物位置给你标在地图吧。"
                },
                {
                    "id": "706510402",
                    "speaker": "瓦格纳",
                    "text": "采不到魔晶块的话，去采点水晶块也不错。"
                },
                {
                    "id": "706510403",
                    "speaker": "瓦格纳",
                    "text": "好了，位置已经标好了…如果你有需要的话，自己去采就是了。如果你忘记了位置，可以再来问我。"
                },
                {
                    "id": "706510404",
                    "speaker": "瓦格纳",
                    "text": "不过，多采几次，你应该就能记住位置了。"
                }
            ]
        }
    ]
}