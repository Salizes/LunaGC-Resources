            "dialogues": [
                {
                    "id": "746560101",
                    "speaker": "Player",
                    "text": "关于泡泡桔…"
                },
                {
                    "id": "746560102",
                    "speaker": "伊斯梅诺",
                    "text": "那么年轻的朋友，你带了泡泡桔来吧？请分我一些，我们边吃边聊。"
                },
                {
                    "id": "746560103",
                    "speaker": "伊斯梅诺",
                    "text": "雕塑是无言的诗，不要在饿着肚子的时候欣赏它们。这是一位决斗者在他人生最后一次决斗中告诉我的。",
                    "choices": [
                        {
                            "id": "746560106",
                            "text": "准备好了。"
                        },
                        {
                            "id": "746560104",
                            "text": "还没准备好。",
                            "response": [
                                {
                                    "id": "746560105",
                                    "speaker": "伊斯梅诺",
                                    "text": "我按照从别人那里听说的，准备了答谢你的泡泡桔的钱。这样的话，我好像该等到你准备好了再给…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
