            "dialogues": [
                {
                    "id": "310010101",
                    "speaker": "Player",
                    "text": "关于猫……"
                },
                {
                    "id": "310010102",
                    "speaker": "永安",
                    "text": "说起来早上我巡逻时，发现居然有个女孩要给它们喂牛奶…阿嚏！"
                },
                {
                    "id": "310010103",
                    "speaker": "永安",
                    "text": "幸亏我赶紧拦住了她…虽说是出于好心吧，可猫喝牛奶是会闹肚子的！"
                },
                {
                    "id": "310010104",
                    "speaker": "永安",
                    "text": "…可能是跟猫待久了，我也变得不爱喝牛奶了，这些牛奶就送给你好…阿嚏！"
                }
            ]
        },
        {
            "id": "7651102",
