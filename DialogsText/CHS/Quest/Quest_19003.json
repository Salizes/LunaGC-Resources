    "talks": [
        {
            "id": "1900301",
            "objective": "与芭芭拉一同离开奔狼领",
            "dialogues": []
        },
        {
            "id": "1900302",
            "objective": "（隐藏任务）回到蒙德城，寻找维多利亚修女$HIDDEN",
            "dialogues": []
        },
        {
            "id": "1900303",
            "objective": "向维多利亚修女回报",
            "dialogues": [
                {
                    "id": "190030301",
                    "speaker": "维多利亚",
                    "text": "你怎么又回来了，如果你还是来找芭芭拉小姐的话，她还没回来。",
                    "choices": [
                        {
                            "id": "190030302",
                            "text": "已经在奔狼领找到芭芭拉了。",
                            "response": [
                                {
                                    "id": "190030304",
                                    "speaker": "维多利亚",
                                    "text": "是这样吗…她没什么事就好。"
                                },
                                {
                                    "id": "190030305",
                                    "speaker": "维多利亚",
                                    "text": "但一时半会她应该也回不来了吧，看来我得把教会的事情拜托给其他人做了…"
                                },
                                {
                                    "id": "190030306",
                                    "speaker": "Player",
                                    "text": "我来帮忙吧。"
                                },
                                {
                                    "id": "190030307",
                                    "speaker": "维多利亚",
                                    "text": "你愿意帮忙的话那就最好了，真是不好意思，还要麻烦你…"
                                },
                                {
                                    "id": "190030308",
                                    "speaker": "维多利亚",
                                    "text": "我想想…那请你帮我去教会周围打扫一下吧。"
                                },
                                {
                                    "id": "190030309",
                                    "speaker": "维多利亚",
                                    "text": "教会周围人来人往，地面总是很脏。"
                                },
                                {
                                    "id": "190030310",
                                    "speaker": "维多利亚",
                                    "text": "这些事之前一直是芭芭拉小姐一个人负责，她一不在，周围就…"
                                },
                                {
                                    "id": "190030311",
                                    "speaker": "Player",
                                    "text": "这么大的地方，都是芭芭拉小姐一个人打扫吗？"
                                },
                                {
                                    "id": "190030312",
                                    "speaker": "维多利亚",
                                    "text": "是的，芭芭拉小姐一直说自己没问题，也不让其他人帮忙。"
                                },
                                {
                                    "id": "190030313",
                                    "speaker": "维多利亚",
                                    "text": "但每次打扫结束后，她的样子都很疲惫。"
                                },
                                {
                                    "id": "190030314",
                                    "speaker": "维多利亚",
                                    "text": "说实话，你愿意帮忙，或者说…芭芭拉小姐愿意让你来帮忙，还让我挺意外的。"
                                },
                                {
                                    "id": "190030315",
                                    "speaker": "维多利亚",
                                    "text": "不过，这样她的负担也许会小一些吧…"
                                },
                                {
                                    "id": "190030316",
                                    "speaker": "维多利亚",
                                    "text": "总之，那清扫的事就拜托你了，「荣誉骑士」。"
                                }
                            ]
                        },
                        {
                            "id": "190030303",
                            "text": "芭芭拉去晨曦酒庄给特纳看病了。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1900304",
            "objective": "打扫教堂的周围",
            "dialogues": [
                {
                    "id": "190030401",
                    "speaker": "维多利亚",
                    "text": "多谢你愿意帮忙，「荣誉骑士」。"
                }
            ]
        },
        {
            "id": "1900305",
            "objective": "向维多利亚修女回报",
            "dialogues": []
        },
        {
            "id": "1900306",
            "objective": "与维多利亚修女对话",
            "dialogues": [
                {
                    "id": "190030601",
                    "speaker": "维多利亚",
                    "text": "咦？你好，还有什么事吗？"
                },
                {
                    "id": "190030602",
                    "speaker": "Player",
                    "text": "关于芭芭拉的假期…"
                },
                {
                    "id": "190030603",
                    "speaker": "维多利亚",
                    "text": "你说这个啊，没错，芭芭拉小姐刚才是向我请了半天假，说是要陪陪一位朋友。"
                },
                {
                    "id": "190030604",
                    "speaker": "维多利亚",
                    "text": "不过，这还真是罕见…芭芭拉小姐居然会专门为了一位朋友请假…"
                },
                {
                    "id": "190030605",
                    "speaker": "维多利亚",
                    "text": "好了，还是先说正事吧，你找我有什么事吗？"
                },
                {
                    "id": "190030606",
                    "speaker": "Player",
                    "text": "关于「了不起的梦幻忧郁珊瑚气泡茶」…"
                },
                {
                    "id": "190030607",
                    "speaker": "维多利亚",
                    "text": "欸？芭芭拉小姐要陪你去买这个…特别饮品？"
                },
                {
                    "id": "190030608",
                    "speaker": "维多利亚",
                    "text": "难道芭芭拉小姐之前说的朋友就是你吗？"
                },
                {
                    "id": "190030609",
                    "speaker": "维多利亚",
                    "text": "啊…如果是你这位「荣誉骑士」的话，倒也说得过去…"
                },
                {
                    "id": "190030610",
                    "speaker": "维多利亚",
                    "text": "好吧，情况我了解了。那芭芭拉小姐就麻烦你多多照顾了，「荣誉骑士」。"
                },
                {
                    "id": "190030611",
                    "speaker": "Player",
                    "text": "为什么芭芭拉的假期要报备行程？"
                },
                {
                    "id": "190030612",
                    "speaker": "维多利亚",
                    "text": "这个啊…你也知道，因为各种原因，芭芭拉小姐在蒙德城里很受欢迎。"
                },
                {
                    "id": "190030613",
                    "speaker": "维多利亚",
                    "text": "虽然居民们都是出于好意，但好意太多了，芭芭拉小姐有时候也实在忙不过来。"
                },
                {
                    "id": "190030614",
                    "speaker": "维多利亚",
                    "text": "如果是在工作中，教会里的人可以及时出来为她解围。"
                },
                {
                    "id": "190030615",
                    "speaker": "维多利亚",
                    "text": "但要是在假期中…那就只能靠芭芭拉小姐自己了。"
                },
                {
                    "id": "190030616",
                    "speaker": "维多利亚",
                    "text": "但她又太…温柔，对居民们的请求向来都会尽量满足，甚至会把自己弄得比工作日还疲惫。"
                },
                {
                    "id": "190030617",
                    "speaker": "维多利亚",
                    "text": "我们就想，让芭芭拉小姐把自己的假期行程报备一下，要真的需要我们出面解围，那我们也好及时赶过去。"
                },
                {
                    "id": "190030618",
                    "speaker": "维多利亚",
                    "text": "真希望芭芭拉小姐不要再勉强自己了…"
                }
            ]
        },
        {
            "id": "1900307",
            "objective": "与维多利亚修女对话",
            "dialogues": [
                {
                    "id": "190030701",
                    "speaker": "维多利亚",
                    "text": "咦？你好，还有什么事吗？"
                },
                {
                    "id": "190030702",
