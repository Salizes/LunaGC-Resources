    "talks": [
        {
            "id": "7714801",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "771480901",
                    "speaker": "达什科夫",
                    "text": "了不起的「契科塔」警探么，我当然知道。不过就像我反复重申的——"
                },
                {
                    "id": "771480902",
                    "speaker": "达什科夫",
                    "text": "我们这儿没有违法的勾当，全都是合规合法、你情我愿的…喂，伊基塔！你说说看，我的话可有半分虚假？"
                },
                {
                    "id": "771480903",
                    "speaker": "达什科夫",
                    "text": "对了，这厮是个老赌鬼，赌到除了家人和自己，再没有可以抵押的东西。"
                },
                {
                    "id": "771480904",
                    "speaker": "达什科夫",
                    "text": "是我们「伊兹梅洛」给了他机会，让他可以用劳动来抵偿债务。只要还清了债，就可以和家人团聚了。"
                },
                {
                    "id": "771480905",
                    "speaker": "达什科夫",
                    "text": "这要是换了别的帮派，难保不会上演骨肉分离的戏码呀，你说是不是啊，伊基塔？"
                },
                {
                    "id": "771480906",
                    "speaker": "伊基塔",
                    "text": "是…我欠了「伊兹梅洛」的钱，我是自愿在这里劳作还债的…"
                },
                {
                    "id": "771480907",
                    "speaker": "达什科夫",
                    "text": "警探，你可是亲耳听到了，咱们这儿没有问题。"
                },
                {
                    "id": "771480908",
                    "speaker": "？？？",
                    "text": "我不信…他们各个脸上一丝活气都没有，这哪可能是正常的劳动环境？"
                },
                {
                    "id": "771480909",
                    "speaker": "？？？",
                    "text": "我要单独询问这里的工人，你们「伊兹梅洛」的人不能在场。"
                },
                {
                    "id": "771480910",
                    "speaker": "达什科夫",
                    "text": "唉，软的不行只能来硬的了么…警探，你的朋友一定抱怨过你是个不识相的家伙吧。"
                },
                {
                    "id": "771480911",
                    "speaker": "？？？",
                    "text": "什么？从、从来没有人这么说过我！"
                },
                {
                    "id": "771480912",
                    "speaker": "达什科夫",
                    "text": "哦，那就是连称得上是朋友的人也没有了，这倒不奇怪。"
                },
                {
                    "id": "771480913",
                    "speaker": "达什科夫",
                    "text": "告诉你一个坏消息，在这儿的全都是我的「朋友」，而且他们有一个共享的优点——嘴都牢靠得很。"
                },
                {
                    "id": "771480914",
                    "speaker": "？？？",
                    "text": "你在说什么…"
                },
                {
                    "id": "771480915",
                    "speaker": "达什科夫",
                    "text": "意思就是，不管你在这儿遭遇了什么，都不会传出去！"
                }
            ]
        },
        {
            "id": "7714802",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "771480201",
                    "speaker": "萨尔沃夫",
                    "text": "得、得救了！「契科塔」总算来解救我们了…"
                },
                {
                    "id": "771480202",
                    "speaker": "基耶塔",
                    "text": "警探，他们人多势众，我们好不容易才找准时机突出重围，你们可要多加小心啊！"
                },
                {
                    "id": "771480203",
                    "speaker": "基耶塔",
                    "text": "一支小队可能都够呛…警探，你的队伍呢？"
                },
                {
                    "id": "771480204",
                    "speaker": "多尼娅",
                    "text": "执行任务的人都在这里了。"
                },
                {
                    "id": "771480205",
                    "speaker": "萨尔沃夫",
                    "text": "才三个人？不对…两个半？"
                },
                {
                    "id": "771480206",
                    "speaker": "派蒙",
                    "text": "的确，多尼娅怎么看都不像是能独当一面的警探所以只能算半个——"
                },
                {
                    "id": "771480207",
                    "speaker": "派蒙",
                    "text": "才怪啦，你是把我看扁了对不对，真是没礼貌的家伙。"
                },
                {
                    "id": "771480208",
                    "speaker": "萨尔沃夫",
                    "text": "抱歉抱歉…我只是担心光靠几位的话，实在不是「伊兹梅洛」 头领的对手呀。"
                },
                {
                    "id": "771480209",
                    "speaker": "萨尔沃夫",
                    "text": "那个叫古萨罗夫的，就在据点把守…光是想到他，唉，就像一脚踩进了冻原上的冰窟窿，心脏都要停跳了。"
                },
                {
                    "id": "771480210",
                    "speaker": "Player",
                    "text": "那你们是怎么逃出来的？"
                },
                {
                    "id": "771480211",
                    "speaker": "派蒙",
                    "text": "是哦！既然据点有那么多那么强的家伙看守，你们几个是怎么逃出来的？除非…除非你们是被故意放出来的…我知道了！"
                },
                {
                    "id": "771480212",
                    "speaker": "派蒙",
                    "text": "一定是「伊兹梅洛」 的阴谋！"
                },
                {
                    "id": "771480213",
                    "speaker": "多尼娅",
                    "text": "停一停！我是警探，推理的部分应该交给我。"
                },
                {
                    "id": "771480214",
                    "speaker": "多尼娅",
                    "text": "咳，你们根本不是普通的工人，而是「伊兹梅洛」 放出的鱼饵…"
                },
                {
                    "id": "771480215",
                    "speaker": "多尼娅",
                    "text": "为的是将我们——越多越好——引入设好的口袋，再一网打尽！"
                },
                {
                    "id": "771480216",
                    "speaker": "多尼娅",
                    "text": "老实交代，这就是你们的伎俩对吧！我可是经过训练的警探，耍花招对我可没用！"
                },
                {
                    "id": "771480217",
                    "speaker": "基耶塔",
                    "text": "呃，不是的，警探，是我贿赂了看守。不过刚逃出来就被发现了，所以才会有追兵…"
                },
                {
                    "id": "771480218",
                    "speaker": "萨尔沃夫",
                    "text": "我们是真的担心你们，毕竟要是你们折了，我们就得过比以前更苦的日子了…"
                },
                {
                    "id": "771480219",
                    "speaker": "多尼娅",
                    "text": "呜哇，太丢人了…原本以为能像前辈们那样帅气地说出事情的真相，没想到是我误会了…"
                },
                {
                    "id": "771480220",
                    "speaker": "派蒙",
                    "text": "等一下，你不是警探吗，这么轻信真的没问题吗！",
                    "choices": [
                        {
                            "id": "771480221",
                            "text": "不过他们说的也有道理。",
                            "response": [
                                {
                                    "id": "771480223",
                                    "speaker": "派蒙",
                                    "text": "好吧，那就还是按原计划…先到据点再说吧！"
                                }
                            ]
                        },
                        {
                            "id": "771480222",
                            "text": "管他的，先打过去再说。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7714805",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "771480301",
                    "speaker": "多尼娅",
                    "text": "刚才多谢了。我是「契科{RUBY#[S]至冬皇家轨道运输局}塔」的警探，你们可以叫我多尼娅。敢问两位尊姓大名？"
                },
                {
                    "id": "771480302",
                    "speaker": "派蒙",
                    "text": "#{M#他}{F#她}是{NICKNAME}，我是派蒙，我们是…路见不平拔刀相助的冒险家！"
                },
                {
                    "id": "771480303",
                    "speaker": "多尼娅",
                    "text": "原来如此，不过真是让两位见笑了，我真的很不擅长交涉，明明在来这里之前下定决心不要冲动行事，结果最后还是…"
                },
                {
                    "id": "771480304",
                    "speaker": "多尼娅",
                    "text": "真是愧对各位前辈的教导，不过我也记得前辈曾说：「决定一个警探合格与否的关键便是于『关键时刻』挺身而出的勇气！"
                },
                {
                    "id": "771480305",
                    "speaker": "多尼娅",
                    "text": "我想至少在这一点上，我是「合格」的！对了，就当刚才是前辈们所说的「关键时刻」吧！"
                },
                {
                    "id": "771480306",
                    "speaker": "Player",
                    "text": "只要出手就是「关键时刻」吗…"
                },
                {
                    "id": "771480307",
                    "speaker": "派蒙",
                    "text": "嘿嘿，就应该这样嘛！如果连挺身而出的勇气都没有，那还做什么警探…不过，嗯…你们的任务是来解救这里的伐木场工人吗？"
                },
                {
                    "id": "771480308",
                    "speaker": "多尼娅",
                    "text": "说来惭愧…其实我的任务是前期的探查——就是在最终收网之前，暗中调查「伊兹梅洛」帮在这片区域的人员安排…"
                },
                {
                    "id": "771480309",
                    "speaker": "派蒙",
                    "text": "暗中调查？可我们刚才已经把人揍了一顿欸！"
                },
                {
                    "id": "771480310",
                    "speaker": "多尼娅",
                    "text": "是啊，已经打草惊蛇…不对，可以说是全面开战了吧。不过好在我已经摸清了据点的所在…"
                },
                {
                    "id": "771480311",
                    "speaker": "多尼娅",
                    "text": "事到如今，只能由我来执行收网任务了！"
                },
                {
                    "id": "771480312",
                    "speaker": "Player",
                    "text": "你要一个人包围他们所有人吗？"
                },
                {
                    "id": "771480313",
                    "speaker": "多尼娅",
                    "text": "是的，看来在上一个「关键时刻」过后，马上又迎来了下一个「关键时刻」。"
                },
                {
                    "id": "771480314",
                    "speaker": "派蒙",
                    "text": "#呃，时不时刻的先放一边，我和{NICKNAME}也来帮忙吧。"
                },
                {
                    "id": "771480315",
                    "speaker": "多尼娅",
                    "text": "多么热心的冒险家！要是其他冒险家也像你们这样热心就好了。"
                },
                {
                    "id": "771480316",
                    "speaker": "派蒙",
                    "text": "总不能眼睁睁看你包围不成反被包围嘛。"
                }
            ]
        },
        {
            "id": "7714809",
            "objective": "跟随多尼娅前往帮派的据点",
            "dialogues": []
        },
        {
            "id": "7714817",
            "objective": "击败帮派成员",
            "dialogues": [
                {
                    "id": "771481701",
                    "speaker": "<UNKNOWN>",
                    "text": "(test)玩家询问工头对藏宝图上的位置有没有头绪"
                },
                {
                    "id": "771481702",
                    "speaker": "<UNKNOWN>",
                    "text": "(test)工头一眼认出位置，带人过去试试"
                }
            ]
        },
        {
            "id": "7714818",
            "objective": "与伐木工对话",
            "dialogues": []
        },
        {
            "id": "7714810",
            "objective": "前往帮派据点",
            "dialogues": [
                {
                    "id": "771481001",
                    "speaker": "古萨罗夫",
                    "text": "列科塔诺夫，近来常听闻工人不服管教，频频出逃，你可有什么借口。"
                },
                {
                    "id": "771481002",
                    "speaker": "列科塔诺夫",
                    "text": "是小的办事不力。不过啊，老大，他们也是听信了那些风言风语，才越加张狂起来…"
                },
                {
                    "id": "771481003",
                    "speaker": "古萨罗夫",
                    "text": "风言风语…是关于「小阁下」失势的传闻？"
                },
                {
                    "id": "771481004",
                    "speaker": "列科塔诺夫",
                    "text": "是。而且听下面的弟兄们说，这几天还有「契科塔」的狗在附近嗅探，怕是很快就会有所行动。"
                },
                {
                    "id": "771481005",
                    "speaker": "列科塔诺夫",
                    "text": "「小阁下」那边的援兵若是没有指望，光靠咱们，在这地界，怕是孤木难支呀。"
                },
                {
                    "id": "771481006",
                    "speaker": "列科塔诺夫",
                    "text": "老大，要我说，既然没了靠山，不如咱们趁现在将那<color=#00E1FFFF>「大盗宝藏」</color>取了，不说潇洒快活，起码也好心里有底…"
                },
                {
                    "id": "771481007",
                    "speaker": "古萨罗夫",
                    "text": "唔，就算没了「小阁下」，能源协会总归还在，日后定有用得到「伊兹梅洛」的时候。个中利弊，得谨慎权衡。"
                },
                {
                    "id": "771481008",
                    "speaker": "列科塔诺夫",
                    "text": "老大说的是，但要是错过了这个时机…"
                },
                {
                    "id": "771481009",
                    "speaker": "「伊兹梅洛」打手",
                    "text": "老、老大！「契科塔」打过来了！"
                },
                {
                    "id": "771481010",
                    "speaker": "古萨罗夫",
                    "text": "什么？！这么快？他们来了多少人？",
                    "choices": [
                        {
                            "id": "771481011",
                            "text": "你好，就三个人。",
                            "response": [
                                {
                                    "id": "771481013",
                                    "speaker": "派蒙",
                                    "text": "束手就擒吧！现在放弃抵抗的话还有酌情处理的余地！"
                                },
                                {
                                    "id": "771481014",
                                    "speaker": "多尼娅",
                                    "text": "派、派蒙！「契科塔」的警探不能和犯罪分子谈条件！"
                                },
                                {
                                    "id": "771481015",
                                    "speaker": "多尼娅",
                                    "text": "而且这明明是我的「关键时刻」，风头全被两位抢了，呜…"
                                },
                                {
                                    "id": "771481016",
                                    "speaker": "古萨罗夫",
                                    "text": "搞什么…就凭你们？我们「伊兹梅洛」还没落魄到这份上！"
                                },
                                {
                                    "id": "771481017",
                                    "speaker": "古萨罗夫",
                                    "text": "#弟兄们，抄家伙，给{M#他们}{F#她们}点颜色瞧瞧！"
                                }
                            ]
                        },
                        {
                            "id": "771481012",
                            "text": "「契科塔」的警探来包围你们了！"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7714812",
            "objective": "与古萨罗夫对话",
            "dialogues": []
        },
        {
            "id": "7714811",
            "objective": "解决盘踞此处的帮派成员",
            "dialogues": [
                {
                    "id": "771481101",
                    "speaker": "Black Screen",
                    "text": "费了一番功夫，将击败的「伊兹梅洛」成员塞进了一旁的小屋…"
                },
                {
                    "id": "771481102",
                    "speaker": "多尼娅",
                    "text": "锁上了。之后通知同事来接管就好了。"
                },
                {
                    "id": "771481103",
                    "speaker": "多尼娅",
                    "text": "#也辛苦两位了。这还是我第一次独自执行任务呢，要是没有{NICKNAME}相助，不知会是什么下场…"
                },
                {
                    "id": "771481104",
                    "speaker": "派蒙",
                    "text": "你是说，你第一次独自执行任务，就单枪匹马闹到和犯罪团伙全面开战的地步？"
                },
                {
                    "id": "771481105",
                    "speaker": "多尼娅",
                    "text": "在「关键时刻」挺身而出，剿灭了黑恶势力，也算是立下了大功吧！嘿嘿。"
                },
                {
                    "id": "771481106",
                    "speaker": "派蒙",
                    "text": "算、算吗？",
                    "choices": [
                        {
                            "id": "771481107",
                            "text": "结果好就一切都好。",
                            "response": [
                                {
                                    "id": "771481108",
                                    "speaker": "派蒙",
                                    "text": "话是这么说啦。但也不是所有事只要结果没问题，过程就可以不择手段的！"
                                },
                                {
                                    "id": "771481111",
                                    "speaker": "派蒙",
                                    "text": "话说回来，现在那些工人该怎么办呢？"
                                },
                                {
                                    "id": "771481112",
                                    "speaker": "多尼娅",
                                    "text": "担心的话就去看看？我知道他们会在哪里，跟我来吧。"
                                }
                            ]
                        },
                        {
                            "id": "771481109",
                            "text": "组织不需要不服从命令的人！",
                            "response": [
                                {
                                    "id": "771481110",
                                    "speaker": "派蒙",
                                    "text": "到底是哪种组织啦！不过的确，不管什么组织，规则都是很重要的吧。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7714819",
            "objective": "解决盘踞此处的帮派成员",
            "dialogues": [
                {
                    "id": "771481401",
                    "speaker": "古萨罗夫",
                    "text": "唔…真有两下子。犯不着在这儿折了…我们改日再战！"
                },
                {
                    "id": "771481402",
                    "speaker": "多尼娅",
                    "text": "#啊！我的「关键时刻」要逃跑了！{NICKNAME}，我们快追！"
                }
            ]
        },
        {
            "id": "7714803",
            "objective": "追上逃走的帮派成员",
            "dialogues": []
        },
        {
            "id": "7714804",
            "objective": "解决盘踞此处的帮派成员",
            "dialogues": [
                {
                    "id": "771480401",
