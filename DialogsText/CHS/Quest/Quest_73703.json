{
    "quest": {
        "id": "73703",
        "title": "镜子镜子告诉我",
        "description": "听说在野外有到处招揽人进行与镜子有关的奇怪活动的学者，去看看究竟怎么回事吧…",
        "rewards": [
            {
                "itemId": 202,
                "count": 10000
            },
            {
                "itemId": 104002,
                "count": 4
