            "objective": "与凯瑟琳对话",
            "dialogues": [
                {
                    "id": "756500101",
                    "speaker": "凯瑟琳",
                    "text": "向着星辰与深渊！欢迎来到冒险家协会。也欢迎来到纳塔。"
                },
                {
                    "id": "756500102",
                    "speaker": "Player",
                    "text": "关于委托…"
                },
                {
                    "id": "756500103",
                    "speaker": "凯瑟琳",
                    "text": "请您稍等，登记完成之后，您就可以自由地在这里接取委托了。"
                },
                {
                    "id": "756500104",
                    "speaker": "凯瑟琳",
                    "text": "纳塔是一个充满挑战和机遇的国度，这里遍布着强大的敌人，和未被探究的遗迹。"
                },
                {
                    "id": "756500105",
                    "speaker": "凯瑟琳",
                    "text": "只要您怀抱勇气和信心，一定能抓住机会，成就伟大的事迹。"
                },
                {
                    "id": "756500106",
                    "speaker": "凯瑟琳",
                    "text": "向前吧！冒险家！向着星辰与深渊！"
                }
            ]
        }
    ]
