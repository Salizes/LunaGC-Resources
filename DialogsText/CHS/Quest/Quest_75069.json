        },
        {
            "id": "7506911",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "750691101",
                    "speaker": "夸恩因",
                    "text": "瀑布，呵呵…因为瀑布的声音充斥了耳朵，所以，就听不见别的东西了…"
                },
                {
                    "id": "750691102",
                    "speaker": "夸恩因",
                    "text": "啊，是你啊，有什么事吗？"
                },
                {
                    "id": "750691103",
                    "speaker": "Player",
                    "text": "没有什么事。"
                },
                {
                    "id": "750691104",
                    "speaker": "夸恩因",
                    "text": "是嘛…啊呀，听我一句劝吧，勇士，还是快些离去吧。"
                }
            ]
        },
        {
            "id": "7506912",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "750691201",
                    "speaker": "夸恩因",
                    "text": "瀑布，呵呵…因为瀑布的声音充斥了耳朵，所以，就听不见别的东西了…"
                },
                {
                    "id": "750691202",
                    "speaker": "夸恩因",
                    "text": "啊，是你啊，有什么事吗？",
                    "choices": [
                        {
                            "id": "750691203",
                            "text": "你为什么在这？",
                            "response": [
                                {
                                    "id": "750691204",
                                    "speaker": "夸恩因",
                                    "text": "我是…冒险团的战士，不过，我的勇武比不上领队的泰卡大人，不过，也有用得上我的地方。"
                                },
                                {
                                    "id": "750691205",
                                    "speaker": "夸恩因",
                                    "text": "我负责保护冒险团的营地…有的时候在夜里也，无法睡去，所以干脆起来巡逻，保护营地。"
                                },
                                {
                                    "id": "750691206",
                                    "speaker": "夸恩因",
                                    "text": "不知道什么时候，营地里的人越来越少了…啊，咦，奇怪，为什么我现在在这里？"
                                }
                            ]
                        },
                        {
                            "id": "750691207",
                            "text": "没有什么事。",
                            "response": [
