    "talks": [
        {
            "id": "7506902",
            "objective": "",
            "dialogues": [
                {
                    "id": "750690201",
                    "speaker": "夸恩因",
                    "text": "啊呀，这里，很少有人来呢…因为毕竟是，危险的地方。"
                },
                {
                    "id": "750690202",
                    "speaker": "夸恩因",
                    "text": "难道你也是冒险团的人吗…哼，听说黑色巨蛇的影子自天蛇船降临…你也要小心啊。"
                },
                {
                    "id": "750690203",
                    "speaker": "夸恩因",
                    "text": "或者，不如早点离开吧，冒险团里，哈，也藏着非人之物啊…那些声音，咒骂，好吵闹…"
                },
                {
                    "id": "750690204",
                    "speaker": "夸恩因",
                    "text": "在这里反而能平静一点，因为瀑布，呵呵…因为瀑布的声音充斥了耳朵，所以，就听不见别的东西了。"
                }
            ]
        },
        {
            "id": "7506903",
            "objective": "",
            "dialogues": [
                {
                    "id": "750690501",
                    "speaker": "夸恩因的日记",
                    "text": "（破碎的纸张，一开始，写着整齐的文字…）"
                },
                {
                    "id": "750690502",
                    "speaker": "夸恩因的日记",
                    "text": "「…深渊的魔物变得越来越多，这都是可预见的…冒险团最终还是失败了，撤退的计划正在进行。」"
                },
                {
                    "id": "750690503",
                    "speaker": "夸恩因的日记",
                    "text": "「必须得，让剩下的人安全撤离，得小心防备那些突然在夜晚消失的，或是那些自无光之处重新归来的人。」"
                },
                {
                    "id": "750690504",
                    "speaker": "夸恩因的日记",
                    "text": "「…那些深渊的魔物出现得越来越多，据点或许也会被发现，但是得在那之前…」"
                },
                {
                    "id": "750690505",
                    "speaker": "夸恩因的日记",
                    "text": "（下面的字开始变得歪歪扭扭起来…）"
                },
                {
                    "id": "750690506",
                    "speaker": "夸恩因的日记",
                    "text": "「啊，好冷…好冷，在那里，在那里，血也流空了…」"
                },
                {
                    "id": "750690507",
                    "speaker": "夸恩因的日记",
                    "text": "「瀑布声音，好大，对，这样就好。只要这样…只要在瀑布底下，在那里就会安静了，白色的脸，张开的嘴巴，流光的血…」"
                },
                {
                    "id": "750690508",
                    "speaker": "夸恩因的日记",
                    "text": "「就在那里，在…那里，有什么东西…有什么在…」"
                },
                {
                    "id": "750690509",
                    "speaker": "夸恩因的日记",
                    "text": "「在瀑布底下在瀑布底下在瀑布底下在瀑布底下在瀑布底下在瀑布底下在瀑布底下在瀑布底下在瀑布底下…」"
                }
            ]
        },
        {
