    "talks": [
        {
            "id": "7182023",
            "objective": "(test)海灯节领取任务$HIDDEN",
            "dialogues": [
                {
                    "id": "718202301",
                    "speaker": "菲尔戈黛特",
                    "text": "唉，一到过节就忙得不可开交…"
                }
            ]
        },
        {
            "id": "7182001",
            "objective": "前往望舒客栈转转",
            "dialogues": []
        },
        {
            "id": "7182002",
            "objective": "与老板对话",
            "dialogues": [
                {
                    "id": "718200201",
                    "speaker": "菲尔戈黛特",
                    "text": "果然每年过节的时候都格外忙啊…"
                },
                {
                    "id": "718200202",
                    "speaker": "Player",
                    "text": "怎么了？"
                },
                {
                    "id": "718200203",
                    "speaker": "菲尔戈黛特",
                    "text": "还是客栈里的事，很多人都回去过海灯节了，客栈里的人手实在不足…"
                },
                {
                    "id": "718200204",
                    "speaker": "菲尔戈黛特",
                    "text": "又要招呼客人，又要打扮客栈，还得准备点东西过节…"
                },
                {
                    "id": "718200205",
                    "speaker": "菲尔戈黛特",
                    "text": "还有平常的一些事也不能搁置了…言笑都要忙不过来了…"
                },
                {
                    "id": "718200206",
                    "speaker": "菲尔戈黛特",
                    "text": "旅行者，如果你愿意的话，能去帮他一下吗？"
                },
                {
                    "id": "718200207",
                    "speaker": "Player",
                    "text": "交给我吧。"
                },
                {
                    "id": "718200208",
                    "speaker": "菲尔戈黛特",
                    "text": "那就拜托你了，言笑就在厨房里，你直接去找他就好。"
                },
                {
                    "id": "718200209",
                    "speaker": "菲尔戈黛特",
                    "text": "我还得在这处理一点事…"
                }
            ]
        },
        {
            "id": "7182003",
            "objective": "前往探望言笑",
            "dialogues": [
                {
                    "id": "718200301",
                    "speaker": "言笑",
                    "text": "谁啊！不要随便…哦，是你啊…"
                },
                {
                    "id": "718200302",
                    "speaker": "言笑",
                    "text": "有什么事吗？要点菜的话估计得等会了，我这正忙着呢。",
                    "choices": [
                        {
                            "id": "718200303",
                            "text": "我是来帮忙的。",
                            "response": [
                                {
                                    "id": "718200305",
                                    "speaker": "言笑",
                                    "text": "你是来帮忙的？哦…那敢情好，我正好有一堆事要做…"
                                },
                                {
                                    "id": "718200306",
                                    "speaker": "言笑",
                                    "text": "你先去客栈下面，帮我把刚送过来的那些烹饪用材料拿上来，我急着要用。"
                                },
                                {
                                    "id": "718200307",
                                    "speaker": "言笑",
                                    "text": "然后，再顺便把这些霄灯挂到客栈门口的那两棵树上去…掌柜的念叨这事好久了…"
                                }
                            ]
                        },
                        {
                            "id": "718200304",
                            "text": "有什么需要我帮的吗？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7182004",
            "objective": "(test)搬运备料1$HIDDEN",
            "dialogues": []
        },
        {
