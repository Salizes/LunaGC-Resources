    "talks": [
        {
            "id": "7609001",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "760900101",
                    "speaker": "? ? ?",
                    "text": "灯亮了，咦，师父…师父是你吗？"
                },
                {
                    "id": "760900102",
                    "speaker": "派蒙",
                    "text": "啊，原来那个房子里有人啊…"
                },
                {
                    "id": "760900103",
                    "speaker": "Black Screen",
                    "text": "稍等了片刻，一个年轻的执灯士从房中走了出来。"
                },
                {
                    "id": "760900104",
                    "speaker": "? ? ?",
                    "text": "唉，我、我还以为是师父回来了，原来是两位路过的…"
                },
                {
                    "id": "760900105",
                    "speaker": "? ? ?",
                    "text": "不对，这里很危险，周围全是狂猎和魔物，虽然不知道你们是怎么进入这片沼泽的，但是…咦，周围的狂猎…"
                },
                {
                    "id": "760900106",
                    "speaker": "派蒙",
                    "text": "已经全都被我们解决啦！"
                },
                {
                    "id": "760900107",
                    "speaker": "? ? ?",
                    "text": "什、什么！"
                },
                {
                    "id": "760900108",
                    "speaker": "? ? ?",
                    "text": "…呜，要是早知道会有这么强的冒险者路过，就不该让师父一个人离开。"
                },
                {
                    "id": "760900109",
                    "speaker": "? ? ?",
                    "text": "那个笨蛋师父说着：「哈哈，实力强大的执灯士就该面对更多的敌人！等我解决掉它们再回来接应你！」"
                },
                {
                    "id": "760900110",
                    "speaker": "? ? ?",
                    "text": "…把大部分的狂猎和魔物全都引走了…还、还把灯留在了这里…"
                },
                {
                    "id": "760900111",
                    "speaker": "奥什卡里",
                    "text": "不管怎么说，感谢你们帮忙处理掉了这里的狂猎，我叫奥什卡里，是一个执灯士。"
                },
                {
                    "id": "760900112",
                    "speaker": "奥什卡里",
                    "text": "我和师父本来只是例行到这片沼泽来巡查的。没想到，我们刚到这里，封印石柱就出了大问题，我看到了…"
                },
                {
                    "id": "760900113",
                    "speaker": "奥什卡里",
                    "text": "我看到了…迷雾中有一只巨大漆黑的影子，它的身后…成群的魔物扭曲着爬了出来…"
                },
                {
                    "id": "760900114",
                    "speaker": "奥什卡里",
                    "text": "那一定是「众噩之蝰」…没想到这里封印着「众噩之蝰」的传言居然是真的…"
                },
                {
                    "id": "760900115",
                    "speaker": "Player",
                    "text": "冷静点。"
                },
                {
                    "id": "760900116",
                    "speaker": "奥什卡里",
                    "text": "哈…哈…抱歉，身为执灯士，本来不该…但回想起来，还是觉得有些心绪不安…"
                },
                {
                    "id": "760900117",
                    "speaker": "奥什卡里",
                    "text": "不行，奥什卡里，你…要成为独当一面的执灯士…"
                },
                {
                    "id": "760900118",
                    "speaker": "奥什卡里",
                    "text": "两位…两位…虽然封印动摇，这里十分危险，但是…"
                },
                {
                    "id": "760900119",
                    "speaker": "派蒙",
                    "text": "嗯，没关系，我们会帮忙的！"
                },
                {
                    "id": "760900120",
                    "speaker": "派蒙",
                    "text": "不过那个「众噩之蝰」是什么，逃出来的魔物吗？"
                },
                {
                    "id": "760900121",
                    "speaker": "奥什卡里",
                    "text": "…那个「众噩之蝰」，传说中曾经是白沙皇统治时期的某位高官，也是那位霍德望的心腹…"
                },
                {
                    "id": "760900122",
                    "speaker": "奥什卡里",
                    "text": "听说他不仅心狠手辣，不惜一切代价铲除霍德望的政敌，最后也随着霍德望一同堕落，变成了漆黑的魔物…"
                },
                {
                    "id": "760900123",
                    "speaker": "派蒙",
                    "text": "一听就知道，是那种像滑溜溜的蛇一样的大坏蛋！就该抓起来，打成一个结！"
                },
                {
                    "id": "760900124",
                    "speaker": "奥什卡里",
                    "text": "你说得没错！不过，他是那种就算咬断自己的身体也要苟且偷生的家伙。这种人要是真的成了魔物，不敢想象…"
                },
                {
                    "id": "760900125",
                    "speaker": "派蒙",
                    "text": "唔，我听明白了。一定要找到重新封印它的办法，让它再也没有办法挣脱出来。"
                },
                {
                    "id": "760900126",
                    "speaker": "奥什卡里",
                    "text": "是的…只不过，我也不知道具体的方法，要是师父在就好了…"
                },
                {
                    "id": "760900127",
                    "speaker": "奥什卡里",
                    "text": "师父虽然平时爱开玩笑和逞强，但是也…偶尔还有一些可靠之处。"
                },
                {
                    "id": "760900128",
                    "speaker": "派蒙",
                    "text": "「偶尔」有「一些」可靠…那不就是根本不可靠嘛！"
                },
                {
                    "id": "760900129",
                    "speaker": "奥什卡里",
                    "text": "倒也不是，每到关键时刻他其实都还挺可靠的…所以这一次…或许…可能也…？"
                },
                {
                    "id": "760900130",
                    "speaker": "奥什卡里",
                    "text": "算、算了，还是我们一起去找找封印「众噩之蝰」的办法吧…"
                },
                {
                    "id": "760900131",
                    "speaker": "派蒙",
                    "text": "没事，封印的事就交给我们吧！毕竟，你师父给你的命令是守在这里嘛！"
                },
                {
                    "id": "760900132",
                    "speaker": "奥什卡里",
                    "text": "如果你们愿意出手的话…但、但这样真的好吗？不…都是我太没用了，封印…封印的事，就拜托你们了！"
                }
            ]
        },
        {
            "id": "7609011",
            "objective": "",
            "dialogues": [
                {
                    "id": "760900601",
                    "speaker": "? ? ?",
                    "text": "呼呼，「肉冻」，又在舔我的脸吗？你的舌头真软啊…没错，你就是世界上最乖的小猫咪。"
                },
                {
                    "id": "760900602",
                    "speaker": "派蒙",
                    "text": "怎、怎么好像已经神志不清了…喂！你振作一点！「肉冻」不在这里！"
                },
                {
                    "id": "760900603",
                    "speaker": "? ? ?",
                    "text": "咦？「肉冻」怎么不见了…是因为有人来了就躲起来了吗？"
                },
                {
                    "id": "760900604",
                    "speaker": "派蒙",
                    "text": "清醒一点，从一开始这里就没有小猫咪！"
                },
                {
                    "id": "760900605",
                    "speaker": "? ? ?",
                    "text": "啊…真可惜…看来我还要在没有「肉冻」的世界里再坚持一段时间…"
                },
                {
                    "id": "760900606",
                    "speaker": "? ? ?",
                    "text": "我的口袋里有伤药…如果可以的话…拜托你们…"
                },
                {
                    "id": "760900607",
                    "speaker": "派蒙",
                    "text": "嗯，交给我们！你先休息一下，保存体力！"
                },
                {
                    "id": "760900608",
                    "speaker": "Black Screen",
                    "text": "从无法自如行动的执灯士口袋中取出伤药，紧急处理了一下伤口后，他看起来好转了一些。"
                },
                {
                    "id": "760900609",
                    "speaker": "? ? ?",
                    "text": "两位处理伤势的手法真是太熟练了。我还以为这次真的要去和「肉冻」团聚了，不过那好像也…不错？"
                },
                {
                    "id": "760900610",
                    "speaker": "派蒙",
                    "text": "比起那个，现在还是你的性命更重要啦！"
                },
                {
                    "id": "760900611",
                    "speaker": "? ? ?",
                    "text": "你说得对…我当然很感激两位的帮助。只是「肉冻」离开我已经十多年了，我实在是太想念它的小肚皮了…"
                },
                {
                    "id": "760900612",
                    "speaker": "雅努什",
                    "text": "我的名字叫雅努什，刚才真是多亏了你们，请问两位救命恩人的姓名是…"
                },
                {
                    "id": "760900613",
                    "speaker": "派蒙",
                    "text": "#我叫派蒙，{M#他}{F#她}是{NICKNAME}…雅努什，现在能走了吗？我们护送你撤离这里吧！"
                },
                {
                    "id": "760900614",
                    "speaker": "雅努什",
                    "text": "…真是诱人的提案，不过请恕我拒绝。两位，虽然救命之恩已难以回报，但我还是想拜托两位去皮拉米达城请求支援…"
                },
                {
                    "id": "760900615",
                    "speaker": "雅努什",
                    "text": "我…还得继续在这里调查。"
                },
                {
                    "id": "760900616",
                    "speaker": "Player",
                    "text": "即使伤得这么重？"
                },
                {
                    "id": "760900617",
                    "speaker": "雅努什",
                    "text": "其实我觉得还好啦，不用担心我。"
                },
                {
                    "id": "760900618",
                    "speaker": "雅努什",
                    "text": "沼泽的封印已经松动，必须时刻有人监视这里。更何况…我那个笨徒弟应该还在等我，抛下同泽也不是执灯人的作风。"
                },
                {
                    "id": "760900619",
                    "speaker": "派蒙",
                    "text": "唔…「沼泽的封印」？那是什么？"
                },
                {
                    "id": "760900620",
                    "speaker": "雅努什",
                    "text": "这片沼泽，据说封印着一个和恶魔做交易，最终变成怪物的混蛋…"
                },
                {
                    "id": "760900621",
                    "speaker": "雅努什",
                    "text": "应该干了很多神憎鬼厌的事吧，才在五百年前被霜月之子的咏月使和铸灯者镇压于此…"
                },
                {
                    "id": "760900622",
                    "speaker": "雅努什",
                    "text": "好啦，能被外人知道的就这么多…带口信的事，就拜托你们了。这里还是很危险的，尽快出发吧！"
                },
                {
                    "id": "760900623",
                    "speaker": "雅努什",
                    "text": "我也…再让我休息一会儿，我也要去做该做的事了。"
                },
                {
                    "id": "760900624",
                    "speaker": "派蒙",
                    "text": "可是雅努什…你现在的身体…",
                    "choices": [
                        {
                            "id": "760900625",
                            "text": "封印的事，说不定我们可以帮忙。",
                            "response": [
                                {
                                    "id": "760900626",
                                    "speaker": "派蒙",
                                    "text": "对哦，不管是打开封印还是盖上封印，我们都做了很多类似的事了！"
                                },
                                {
                                    "id": "760900630",
                                    "speaker": "雅努什",
                                    "text": "真的吗…虽然感觉你们所说也并非虚言…"
                                },
                                {
                                    "id": "760900631",
                                    "speaker": "雅努什",
                                    "text": "唔，这里的情况，可能比想象中还要危险，即使如此…"
                                },
                                {
                                    "id": "760900632",
                                    "speaker": "Player",
                                    "text": "即使如此。"
                                },
                                {
                                    "id": "760900633",
                                    "speaker": "派蒙",
                                    "text": "…不过，这个封印我们能行吗，不是说之前是咏月使和铸灯者联手封印的吗？"
                                },
                                {
                                    "id": "760900634",
                                    "speaker": "雅努什",
                                    "text": "封印倒并不需要特殊的力量，他们早已将力量留存在了封印的三座石柱之内…"
                                },
                                {
                                    "id": "760900635",
                                    "speaker": "雅努什",
                                    "text": "这片区域一共有<color=#00E1FFFF>三座石柱，只要将月矩力引导向那些石柱所在的位置</color>，古老的封印就会再次起效。"
                                },
                                {
                                    "id": "760900636",
                                    "speaker": "雅努什",
                                    "text": "那里生长的<color=#00E1FFFF>锋萼花，则是能重创它的利器</color>…嗯，手册上是这么说的。"
                                },
                                {
                                    "id": "760900637",
                                    "speaker": "雅努什",
                                    "text": "如果真的将那魔物重新封印，啊…我都不知道该怎么报答二位，啊，不如下辈子我和「肉冻」一起做二位家的猫吧？"
                                },
                                {
                                    "id": "760900638",
                                    "speaker": "雅努什",
                                    "text": "我们会把身上最柔顺的毛留给两位的，想摸哪只都没有关系！"
                                },
                                {
                                    "id": "760900639",
                                    "speaker": "派蒙",
                                    "text": "真是的，都到这种时候了，还在开玩笑…"
                                },
                                {
                                    "id": "760900640",
                                    "speaker": "雅努什",
                                    "text": "哈哈，不管到了什么时候，都要有幽默感嘛…咳咳，那我们现在就出发吧…"
                                },
                                {
                                    "id": "760900641",
                                    "speaker": "派蒙",
                                    "text": "不行，你的身体显然撑不住，还是不要勉强了。封印就交给我们！"
                                },
                                {
                                    "id": "760900642",
                                    "speaker": "雅努什",
                                    "text": "…唉。确实，现在一起行动也只会碍手碍脚。虽然有些不甘心，但是…封印就拜托你们了。"
                                },
                                {
                                    "id": "760900643",
                                    "speaker": "雅努什",
                                    "text": "刚才你们帮我处理过伤势，已经好多了，就算不能作战，我也得做些力所能及的事…再说，我那个笨蛋徒弟还不知道怎么样了…"
                                },
                                {
                                    "id": "760900644",
                                    "speaker": "雅努什",
                                    "text": "我先去跟我徒弟会合，如果一切顺利，再想办法增援你们。那么，我们就分头行动，你们一定要注意安全！"
                                },
                                {
                                    "id": "760900645",
                                    "speaker": "派蒙",
                                    "text": "嗯，就等我们的好消息吧！"
                                },
                                {
                                    "id": "760900646",
                                    "speaker": "Black Screen",
                                    "text": "雅努什又叮嘱了几句「千万要小心！」之后就出发了，他的身影不一会儿便消失在了迷雾中…"
                                }
                            ]
                        },
                        {
                            "id": "760900627",
                            "text": "不能就这样丢下你们。",
                            "response": [
                                {
                                    "id": "760900628",
                                    "speaker": "派蒙",
                                    "text": "没错，如果现在赶去皮拉米达城，再等执灯人派出救援，那要很长时间。那样的话…雅努什你们或许会…"
                                },
                                {
                                    "id": "760900629",
                                    "speaker": "派蒙",
                                    "text": "唔！总之不能抛下你们不管…更何况，封印魔物这种事，我们也做过很多啦！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7609003",
            "objective": "调查封印石柱",
            "dialogues": [
                {
                    "id": "760900301",
                    "speaker": "Black Screen",
                    "text": "随风散尽的阴影之中，最后一声低语犹如涟漪一般消散了——\\n「为什么…霍德望…」"
                },
                {
                    "id": "760900302",
                    "speaker": "? ? ?",
                    "text": "奥什卡里你别再拦在我前面啦！我还能战斗呢！这样磨磨唧唧的会赶不上增援的。"
                },
                {
                    "id": "760900303",
                    "speaker": "? ? ?",
                    "text": "已、已经结束了…那个家伙，真的已经…"
                },
                {
                    "id": "760900304",
                    "speaker": "? ? ?",
                    "text": "终于…不必再恐惧迷雾中的黑影了…五百年来笼罩在这里的阴霾，终于褪去了…"
                },
                {
                    "id": "760900305",
                    "speaker": "派蒙",
                    "text": "雅努什，你们来啦！魔物已经被我们解决啦！"
                },
                {
                    "id": "760900306",
                    "speaker": "? ? ?",
                    "text": "唉，还是晚了一步…听到动静之后，我已经用最快的速度往这里赶了。不过，一切能顺利解决才是最重要的。"
                },
                {
                    "id": "760900307",
                    "speaker": "? ? ?",
                    "text": "呜…真…真是太好了！"
                },
                {
                    "id": "760900308",
                    "speaker": "派蒙",
                    "text": "对了，雅努什的伤已经不要紧了吗？"
                },
                {
                    "id": "760900309",
                    "speaker": "? ? ?",
                    "text": "我跟奥什卡里会合之后又稍稍休息了一下，已经缓过来了，你们不用担心。"
                },
                {
                    "id": "760900310",
                    "speaker": "? ? ?",
                    "text": "但…师父你的伤，还是应该尽早回去，彻底清洗、包扎才行！"
                },
                {
                    "id": "760900311",
                    "speaker": "? ? ?",
                    "text": "急什么，我之前不是说过了么？急躁是新手才有的毛病！"
                },
                {
                    "id": "760900312",
                    "speaker": "? ? ?",
                    "text": "但…师父你也说过，「逞强是笨蛋才有的毛病！」"
                },
                {
                    "id": "760900313",
                    "speaker": "? ? ?",
                    "text": "……",
                    "choices": [
                        {
                            "id": "760900314",
                            "text": "听上去是笨蛋的毛病更严重一些…",
                            "response": [
                                {
                                    "id": "760900316",
                                    "speaker": "? ? ?",
                                    "text": "#喂喂，怎么连{NICKNAME}都在帮着他说话…真是的，要做的还有很多！"
                                },
                                {
                                    "id": "760900317",
                                    "speaker": "? ? ?",
                                    "text": "确认封印的状态，调查周围有没有其他异状，暂时还不能离开。再说！你们也太小看我雅努——嘶，疼疼疼…"
                                },
                                {
                                    "id": "760900318",
                                    "speaker": "? ? ?",
                                    "text": "师父…"
                                },
                                {
                                    "id": "760900319",
                                    "speaker": "? ? ?",
                                    "text": "知道啦知道啦，那么我们赶快把收尾的工作完成。哦！差点忘了，多亏了你们帮忙，才顺利解决了沼泽里的怪物！"
                                },
                                {
                                    "id": "760900320",
                                    "speaker": "? ? ?",
                                    "text": "我也要感谢你们，谢谢你们救了师父！"
                                },
                                {
                                    "id": "760900321",
                                    "speaker": "派蒙",
                                    "text": "嘿嘿，大坏蛋少了一个，还收获了真诚的夸赞两份。真是再好不过了！"
                                }
                            ]
                        },
                        {
                            "id": "760900315",
                            "text": "果然能打败师父的，还得是师父。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7609004",
            "objective": "",
            "dialogues": [
                {
                    "id": "760900401",
                    "speaker": "? ? ?",
                    "text": "我会继续守在这里，等师父来和我会合。如果你们有什么想知道的，我会尽我所能为你们解答的！",
                    "choices": [
                        {
                            "id": "760900402",
                            "text": "关于「众噩之蝰」的过去…",
                            "response": [
                                {
                                    "id": "760900403",
                                    "speaker": "? ? ?",
                                    "text": "啊，你说那个魔物还是「人类」时候的事吗…那应该是五百多年前的事了…"
                                },
                                {
                                    "id": "760900404",
                                    "speaker": "? ? ?",
                                    "text": "据说在白沙皇治下，至冬的政局很大程度上仍控制在贵族妖精的手中，他是那个时候政坛罕见的人类新秀。"
                                },
                                {
                                    "id": "760900405",
                                    "speaker": "? ? ?",
                                    "text": "他走上歧途的起点，就是拜了那位「教授」霍德望为师。"
                                },
                                {
                                    "id": "760900406",
                                    "speaker": "? ? ?",
                                    "text": "在霍德望的诱导之下，他通过胁迫、栽赃和谋杀，替霍德望铲除了一个又一个的政敌。"
                                },
                                {
                                    "id": "760900407",
                                    "speaker": "? ? ?",
                                    "text": "霍德望当年之所以能获得如此大的权势，他可以说是功不可没。如今变成了这副模样，或许正是当年那些罪行的报应吧！"
                                }
                            ]
                        },
                        {
                            "id": "760900408",
                            "text": "关于沼泽里的怪物…",
                            "response": [
                                {
                                    "id": "760900409",
                                    "speaker": "? ? ?",
                                    "text": "五百年前的人是如何变成现在这样的怪物？又如何会盘踞在这片沼泽的？我调查了很久也没有准确的答案。"
                                },
                                {
                                    "id": "760900410",
                                    "speaker": "? ? ?",
                                    "text": "我的推测是在霍德望倒台以后，它才来到了这里…不过究竟怎么被封印，书卷上也没有这样的细节…"
                                }
                            ]
                        },
                        {
                            "id": "760900411",
                            "text": "关于霜月之子的封印…",
                            "response": [
                                {
                                    "id": "760900412",
                                    "speaker": "? ? ?",
                                    "text": "这五百年来，封印一直都很稳定。不过以防万一，我们执灯人还是会定期来巡查。"
                                },
                                {
                                    "id": "760900413",
                                    "speaker": "? ? ?",
                                    "text": "没想到这次居然出事了…师父…"
                                },
                                {
                                    "id": "760900414",
                                    "speaker": "? ? ?",
                                    "text": "唉…希望师父平安无事…"
                                }
                            ]
                        },
                        {
                            "id": "760900415",
                            "text": "多谢，你也要注意安全！",
                            "response": [
                                {
                                    "id": "760900416",
                                    "speaker": "? ? ?",
                                    "text": "你们才是！沼泽深处比这里危险很多，希望你们能一切顺利…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7609009",
            "objective": "调查封印石柱",
            "dialogues": []
        },
        {
            "id": "7609002",
            "objective": "",
            "dialogues": [
                {
                    "id": "760900201",
                    "speaker": "? ? ?",
                    "text": "唉…感觉自己这次什么忙都没帮上…"
                },
                {
                    "id": "760900202",
                    "speaker": "? ? ?",
                    "text": "嗯？谁说的？你遵守我的指令原地驻守，而不是莽撞行事造成麻烦，明明做得很好嘛！"
                },
                {
                    "id": "760900203",
                    "speaker": "? ? ?",
                    "text": "要是像这样不客观的话，我可就不放心把这次的事件报告交给你写了。"
                },
                {
                    "id": "760900204",
                    "speaker": "? ? ?",
                    "text": "师父您教训得是…欸，等等，您、您是说这次的报告…要交给我？！"
                },
                {
                    "id": "760900205",
                    "speaker": "? ? ?",
                    "text": "真、真的吗？！好的！我一定不会让您失望的！"
                },
                {
                    "id": "760900206",
                    "speaker": "? ? ?",
                    "text": "嗯，简单明了，能把起因、经过、结果说清楚就好。"
                },
                {
                    "id": "760900207",
                    "speaker": "? ? ?",
                    "text": "唔…关于封印松动的起因，我可能稍微有点头绪了！刚才我们路过一个愚人众的营地，我觉得很有可能和他们有关！"
                },
                {
                    "id": "760900208",
                    "speaker": "? ? ?",
                    "text": "很敏锐嘛！待会我们再回去调查一下，把证据收集好。到时候向愚人众提出正式抗议。"
                }
            ]
        },
        {
            "id": "7609013",
            "objective": "调查封印石柱",
            "dialogues": []
        },
        {
            "id": "7609005",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "760900501",
                    "speaker": "? ? ?",
                    "text": "呼呼，「肉冻」，又在舔我的脸吗？你的舌头真软啊…没错，你就是世界上最乖的小猫咪。"
                },
                {
                    "id": "760900502",
                    "speaker": "派蒙",
                    "text": "怎、怎么好像已经神志不清了…喂！你振作一点！「肉冻」不在这里！"
                },
                {
                    "id": "760900503",
                    "speaker": "? ? ?",
                    "text": "咦？「肉冻」怎么不见了…是因为有人来了就躲起来了吗？"
                },
                {
                    "id": "760900504",
                    "speaker": "派蒙",
                    "text": "清醒一点，从一开始这里就没有小猫咪！"
                },
                {
                    "id": "760900505",
                    "speaker": "? ? ?",
                    "text": "啊…真可惜…看来我还要在没有「肉冻」的世界里再坚持一段时间…"
                },
                {
                    "id": "760900506",
                    "speaker": "? ? ?",
                    "text": "我的口袋里有伤药…如果可以的话…拜托你们…"
                },
                {
                    "id": "760900507",
                    "speaker": "派蒙",
                    "text": "嗯，交给我们！你先休息一下，保存体力！"
                },
                {
                    "id": "760900508",
                    "speaker": "Black Screen",
                    "text": "从无法自如行动的执灯士口袋中取出伤药，紧急处理了一下伤口后，他看起来好转了一些。"
                },
                {
                    "id": "760900509",
                    "speaker": "? ? ?",
                    "text": "两位处理伤势的手法真是太熟练了。我还以为这次真的要去和「肉冻」团聚了，不过那好像也…不错？"
                },
                {
                    "id": "760900510",
                    "speaker": "派蒙",
                    "text": "比起那个，现在还是你的性命更重要啦！"
                },
                {
                    "id": "760900511",
                    "speaker": "? ? ?",
                    "text": "你说得对…我当然很感激两位的帮助。只是「肉冻」离开我已经十多年了，我实在是太想念它的小肚皮了…"
                },
                {
                    "id": "760900512",
                    "speaker": "雅努什",
                    "text": "我的名字叫雅努什，刚才真是多亏了你们，请问两位救命恩人的姓名是…"
                },
                {
                    "id": "760900513",
                    "speaker": "派蒙",
                    "text": "#我叫派蒙，{M#他}{F#她}是{NICKNAME}…雅努什，现在能走了吗？我们护送你撤离这里吧！"
                },
                {
                    "id": "760900514",
                    "speaker": "雅努什",
                    "text": "…真是诱人的提案，不过请恕我拒绝。两位，虽然救命之恩已难以回报，但我还是想拜托两位去皮拉米达城请求支援…"
                },
                {
                    "id": "760900515",
                    "speaker": "雅努什",
                    "text": "我…还得继续在这里调查。"
                },
                {
                    "id": "760900516",
                    "speaker": "Player",
                    "text": "即使伤得这么重？"
                },
                {
                    "id": "760900517",
                    "speaker": "雅努什",
                    "text": "其实我觉得还好啦，不用担心我。"
                },
                {
                    "id": "760900518",
                    "speaker": "雅努什",
                    "text": "沼泽的封印已经松动，必须时刻有人监视这里。更何况…我那个笨徒弟应该还在等我，抛下同泽也不是执灯人的作风。"
                },
                {
                    "id": "760900519",
                    "speaker": "派蒙",
                    "text": "唔…「沼泽的封印」？那是什么？"
                },
                {
                    "id": "760900520",
                    "speaker": "雅努什",
                    "text": "这片沼泽，据说封印着一个和恶魔做交易，最终变成怪物的混蛋…"
                },
                {
                    "id": "760900521",
                    "speaker": "雅努什",
                    "text": "应该干了很多神憎鬼厌的事吧，才在五百年前被霜月之子的咏月使和铸灯者镇压于此…"
                },
                {
                    "id": "760900522",
                    "speaker": "雅努什",
                    "text": "好啦，能被外人知道的就这么多…带口信的事，就拜托你们了。这里还是很危险的，尽快出发吧！"
                },
                {
                    "id": "760900523",
                    "speaker": "派蒙",
                    "text": "#我和{NICKNAME}不能算是外人啦！我们已经加入了叶洛亚的小队。"
                },
                {
                    "id": "760900524",
                    "speaker": "雅努什",
                    "text": "竟然获得了叶洛亚队长的认可，你们果然不简单。不过…关于那只怪物，知道得太多未必是一件好事。"
                },
                {
                    "id": "760900525",
                    "speaker": "雅努什",
                    "text": "既然你们两位不是外人，那求援的事，就可以安心交给你们了。"
                },
                {
                    "id": "760900526",
                    "speaker": "雅努什",
                    "text": "我也…再让我休息一会儿，我也要去做该做的事了。"
                },
                {
                    "id": "760900527",
                    "speaker": "派蒙",
                    "text": "可是雅努什…你现在的身体…",
                    "choices": [
                        {
                            "id": "760900528",
                            "text": "封印的事，说不定我们可以帮忙。",
                            "response": [
                                {
                                    "id": "760900529",
                                    "speaker": "派蒙",
                                    "text": "对哦，不管是打开封印还是盖上封印，我们都做了很多类似的事了！"
                                },
                                {
                                    "id": "760900533",
                                    "speaker": "雅努什",
                                    "text": "可是…这里的情况，可能比想象中还要危险，即使如此…"
                                },
                                {
                                    "id": "760900534",
                                    "speaker": "Player",
                                    "text": "即使如此。"
                                },
                                {
                                    "id": "760900535",
                                    "speaker": "派蒙",
                                    "text": "…不过，这个封印我们能行吗，不是说之前是咏月使和铸灯者联手封印的吗？"
                                },
                                {
                                    "id": "760900536",
                                    "speaker": "雅努什",
                                    "text": "封印倒并不需要特殊的力量，他们早已将力量留存在了封印的三座石柱之内…"
                                },
                                {
                                    "id": "760900537",
                                    "speaker": "雅努什",
                                    "text": "这片区域一共有<color=#00E1FFFF>三座石柱，只要将月矩力引导向那些石柱所在的位置</color>，古老的封印就会再次起效。"
                                },
                                {
                                    "id": "760900538",
                                    "speaker": "雅努什",
                                    "text": "那里生长的<color=#00E1FFFF>锋萼花，则是能重创它的利器</color>…嗯，手册上是这么说的。"
                                },
                                {
                                    "id": "760900539",
                                    "speaker": "雅努什",
                                    "text": "如果真的将那魔物重新封印，啊…我都不知道该怎么报答二位，啊，不如下辈子我和「肉冻」一起做二位家的猫吧？"
                                },
                                {
                                    "id": "760900540",
                                    "speaker": "雅努什",
                                    "text": "我们会把身上最柔顺的毛留给二位的，想摸哪只都没有关系！"
                                },
                                {
                                    "id": "760900541",
                                    "speaker": "派蒙",
                                    "text": "真是的，都到这种时候了，还在开玩笑…"
                                },
                                {
                                    "id": "760900542",
                                    "speaker": "雅努什",
                                    "text": "哈哈，不管到了什么时候，都要有幽默感嘛…咳咳，那我们现在就出发吧…"
                                },
                                {
                                    "id": "760900543",
                                    "speaker": "派蒙",
                                    "text": "不行，你的身体显然撑不住，还是不要勉强了。封印就交给我们！"
                                },
                                {
                                    "id": "760900544",
                                    "speaker": "雅努什",
                                    "text": "…唉。确实，现在一起行动也只会碍手碍脚。虽然有些不甘心，但是…封印就拜托你们了。"
                                },
                                {
                                    "id": "760900545",
                                    "speaker": "雅努什",
                                    "text": "刚才你们帮我处理过伤势，已经好多了，就算不能作战，我也得做些力所能及的事…再说，我那个笨蛋徒弟还不知道怎么样了…"
                                },
                                {
                                    "id": "760900546",
                                    "speaker": "雅努什",
                                    "text": "我先去跟我徒弟会合，如果一切顺利，再想办法增援你们。那么，我们就分头行动，你们一定要注意安全！"
                                },
                                {
                                    "id": "760900547",
                                    "speaker": "派蒙",
                                    "text": "嗯，就等我们的好消息吧！"
                                },
                                {
                                    "id": "760900548",
                                    "speaker": "Black Screen",
                                    "text": "雅努什又叮嘱了几句「千万要小心！」之后就出发了，他的身影不一会儿便消失在了迷雾中…"
                                }
                            ]
                        },
                        {
                            "id": "760900530",
                            "text": "不能就这样丢下你们。",
                            "response": [
                                {
                                    "id": "760900531",
                                    "speaker": "派蒙",
                                    "text": "没错，如果现在赶去皮拉米达城，等他们派出救援，要很长时间。那样的话…雅努什你们或许会…"
                                },
                                {
                                    "id": "760900532",
                                    "speaker": "派蒙",
                                    "text": "而且你刚才也说过，执灯人是不会抛下同伴的！更何况，封印魔物这种事，我们也做过很多啦！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7609007",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7609010",
            "objective": "前往噩影泽地深处$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7609008",
            "objective": "前往噩影泽地深处",
            "dialogues": []
        },
        {
            "id": "7609006",
            "objective": "击败「众噩之蝰」",
            "dialogues": []
        },
        {
            "id": "7609012",
            "objective": "与执灯人对话",
            "dialogues": []
        },
        {
            "id": "7609007",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "760900701",
                    "speaker": "? ? ?",
                    "text": "灯亮了，咦，师父…师父是你吗？"
                },
                {
                    "id": "760900702",
                    "speaker": "派蒙",
                    "text": "啊，原来那个房子里有人啊…"
                },
                {
                    "id": "760900703",
                    "speaker": "Black Screen",
                    "text": "稍等了片刻，一个年轻的执灯士从房中走了出来。"
                },
                {
                    "id": "760900704",
                    "speaker": "? ? ?",
                    "text": "唉，我、我还以为是师父回来了，原来是两位路过的…"
                },
                {
                    "id": "760900705",
                    "speaker": "? ? ?",
                    "text": "不对，这里很危险，周围全是狂猎和魔物，虽然不知道你们是怎么进入这片沼泽的，但是…咦，周围的狂猎…"
                },
                {
                    "id": "760900706",
                    "speaker": "派蒙",
                    "text": "已经全都被我们解决啦！"
                },
                {
                    "id": "760900707",
                    "speaker": "? ? ?",
                    "text": "什、什么！"
                },
                {
                    "id": "760900708",
                    "speaker": "? ? ?",
                    "text": "…呜，要是早知道会有这么强的冒险者路过，就不该让师父一个人离开。"
                },
                {
                    "id": "760900709",
                    "speaker": "? ? ?",
                    "text": "那个笨蛋师父说着：「哈哈，实力强大的执灯士就该面对更多的敌人！等我解决掉它们再回来接应你！」"
                },
                {
                    "id": "760900710",
                    "speaker": "? ? ?",
                    "text": "然后把大部分的狂猎和魔物全都引走了…还、还把灯留在了这里…"
                },
                {
                    "id": "760900711",
                    "speaker": "派蒙",
                    "text": "你的师父，难道是雅努什？"
                },
                {
                    "id": "760900712",
                    "speaker": "? ? ?",
                    "text": "是的！你们已经见过我师父了？！他还好吗？他没事吧？我在这里等了他很久了！"
                },
                {
                    "id": "760900713",
                    "speaker": "派蒙",
                    "text": "之前我们在另一个方向遇到雅努什了。他受了伤，不过我们已经帮他紧急处理过了，他应该很快就能过来跟你会合。"
                },
                {
                    "id": "760900714",
                    "speaker": "? ? ?",
                    "text": "谢天谢地，师父他没事…我还以为每年忌日除了给「肉冻」做猫饭之外，还得给师父再准备一份零食呢…"
                },
                {
                    "id": "760900715",
                    "speaker": "派蒙",
                    "text": "对师父的尊重不是体现在这种事上的啦！"
                },
                {
                    "id": "760900716",
                    "speaker": "奥什卡里",
                    "text": "不管怎么说，感谢你们帮忙处理掉了这里的狂猎，我叫奥什卡里，是一个执灯士。"
                },
                {
                    "id": "760900717",
                    "speaker": "奥什卡里",
                    "text": "我和师父本来只是例行到这片沼泽来巡查的。没想到，我们刚到这里，封印石柱就出了大问题，我看到了…"
                },
                {
                    "id": "760900718",
                    "speaker": "奥什卡里",
                    "text": "我看到了…迷雾中有一只巨大漆黑的影子，它的身后…成群的魔物扭曲着爬了出来…"
                },
                {
                    "id": "760900719",
                    "speaker": "奥什卡里",
                    "text": "那一定是「众噩之蝰」…没想到这里封印着「众噩之蝰」的传言居然是真的…"
                },
                {
                    "id": "760900720",
                    "speaker": "Player",
                    "text": "冷静点。"
                },
                {
                    "id": "760900721",
                    "speaker": "奥什卡里",
                    "text": "哈…哈…抱歉，身为执灯士，本来不该…但回想起来，还是觉得有些心绪不安…"
                },
                {
                    "id": "760900722",
                    "speaker": "奥什卡里",
                    "text": "不行，奥什卡里，你…要成为独当一面的执灯士…"
                },
                {
                    "id": "760900723",
                    "speaker": "奥什卡里",
                    "text": "两位…两位…虽然封印动摇，这里十分危险，但是…"
                },
                {
                    "id": "760900724",
                    "speaker": "派蒙",
                    "text": "嗯，没关系，我们会帮忙的！"
                },
                {
                    "id": "760900725",
                    "speaker": "派蒙",
                    "text": "不过那个「众噩之蝰」是什么，逃出来的魔物吗？"
                },
                {
                    "id": "760900726",
                    "speaker": "奥什卡里",
                    "text": "…那个「众噩之蝰」，传说中曾经是白沙皇统治时期的某位高官，也是那位霍德望的心腹…"
                },
                {
                    "id": "760900727",
                    "speaker": "奥什卡里",
                    "text": "听说他不仅心狠手辣，不惜一切代价铲除霍德望的政敌，最后也随着霍德望一同堕落，变成了漆黑的魔物…"
                },
                {
                    "id": "760900728",
                    "speaker": "派蒙",
                    "text": "一听就知道，是那种像滑溜溜的蛇一样的大坏蛋！就该抓起来，打成一个结！"
                },
                {
                    "id": "760900729",
                    "speaker": "奥什卡里",
                    "text": "你说得没错！不过，他是那种就算咬断自己的身体也要苟且偷生的家伙。这种人要是真的成了魔物，不敢想象…"
                },
                {
                    "id": "760900730",
                    "speaker": "派蒙",
                    "text": "唔，我听明白了。一定要找到重新封印它的办法，让它再也没有办法挣脱出来。"
                },
                {
                    "id": "760900731",
                    "speaker": "奥什卡里",
                    "text": "是的…只不过，我也不知道具体的方法，要是师父在就好了…"
                },
                {
                    "id": "760900732",
                    "speaker": "派蒙",
                    "text": "刚才雅努什已经把需要做的事情都告诉我们了，放心吧！"
                },
                {
                    "id": "760900733",
                    "speaker": "奥什卡里",
                    "text": "真是太好了！师父虽然平时爱开玩笑和逞强，但是也…偶尔还有一些可靠之处。"
                },
                {
                    "id": "760900734",
                    "speaker": "派蒙",
                    "text": "「偶尔」有「一些」可靠…那不就是根本不可靠吗！"
                },
                {
                    "id": "760900735",
                    "speaker": "奥什卡里",
                    "text": "倒也不是，每到关键时刻他其实都还挺可靠的…所以这一次…或许…可能也…？"
                },
                {
                    "id": "760900736",
                    "speaker": "奥什卡里",
                    "text": "算、算了，要不我还是和你们一起去？唉，但是师父之前又跟我说让我守在这里…"
                },
                {
                    "id": "760900737",
                    "speaker": "派蒙",
                    "text": "没事，封印的事就交给我们吧！毕竟，你师父刚才也和我们说要来找你会合的！"
                },
                {
                    "id": "760900738",
                    "speaker": "奥什卡里",
                    "text": "如果你们愿意出手的话…但、但这样真的好吗？不…都是我太没用了，封印…封印的事，就拜托你们了！"
                }
            ]
        }
    ]
}