    "talks": [
        {
            "id": "7667601",
            "objective": "和努斯妲对话",
            "dialogues": [
                {
                    "id": "766760101",
                    "speaker": "努斯妲",
                    "text": "鼓掌鼓掌！活动进行到现在，可以说，已经到了完美境界！"
                },
                {
                    "id": "766760102",
                    "speaker": "努斯妲",
                    "text": "好几位须弥朋友们学会了纳塔风格的舞蹈，我看到了我们的舞蹈走向全提瓦特的潜力！"
                },
                {
                    "id": "766760103",
                    "speaker": "努斯妲",
                    "text": "期待之后，我们两边的「舞术交流」常态化，每隔一段时间，都稳定互访！"
                },
                {
                    "id": "766760104",
                    "speaker": "派蒙",
                    "text": "那，纳塔的龙龙们也能像「镀金旅团」一样大耍刀舞了嘛？",
                    "choices": [
                        {
                            "id": "766760105",
                            "text": "还有传说中的战舞…",
                            "response": [
                                {
                                    "id": "766760107",
                                    "speaker": "塔拉内",
                                    "text": "啊？说的难道是…努斯妲她们最初见到弯刀叔叔时，弯刀叔叔他们用来吓退那些圣骸赤鹫的示威动作？"
                                },
                                {
                                    "id": "766760108",
                                    "speaker": "塔拉内",
                                    "text": "弯刀叔叔没和你们说明吗？那些动作的来源？"
                                },
                                {
                                    "id": "766760109",
                                    "speaker": "努斯妲",
                                    "text": "有说啊，那支舞不是叫…「炽鬃之狮与苍鹭之守的二重奏」来着吗？是个优美与力量感并重的名字！"
                                },
                                {
                                    "id": "766760110",
                                    "speaker": "派蒙",
                                    "text": "好，好熟悉两个称号！",
                                    "choices": [
                                        {
                                            "id": "766760111",
                                            "text": "似乎想起了两位朋友…",
                                            "response": [
                                                {
                                                    "id": "766760113",
                                                    "speaker": "塔拉内",
                                                    "text": "#{NICKNAME}和派蒙应该已经料到了。"
                                                },
                                                {
                                                    "id": "766760114",
                                                    "speaker": "塔拉内",
                                                    "text": "你们遭遇圣骸赤鹫的那片区域，正好在「炽光猎兽」驮兽车队常走的一条路附近。"
                                                },
                                                {
                                                    "id": "766760115",
                                                    "speaker": "塔拉内",
                                                    "text": "有些日子之前，车队载着迪希雅大姐和坎蒂丝大姐一起回阿如村时，就遭遇了那群赤鹫。"
                                                },
                                                {
                                                    "id": "766760116",
                                                    "speaker": "塔拉内",
                                                    "text": "结果，两位大姐正觉得之前出门没好好活动筋骨，就把劲头全甩在了那群赤鹫身上。"
                                                },
                                                {
                                                    "id": "766760117",
                                                    "speaker": "塔拉内",
                                                    "text": "从那以后，只要「炽光猎兽」的成员们开始模仿她们两位出招的动作，那群赤鹫就会识相地逃开。"
                                                },
                                                {
                                                    "id": "766760118",
                                                    "speaker": "派蒙",
                                                    "text": "果然…"
                                                },
                                                {
                                                    "id": "766760119",
                                                    "speaker": "派蒙",
                                                    "text": "该说那群圣骸赤鹫也是倒霉吗？居然被迪希雅和坎蒂丝来了个混合双打…",
                                                    "choices": [
                                                        {
                                                            "id": "766760120",
                                                            "text": "它们是自讨苦吃。",
                                                            "response": [
                                                                {
                                                                    "id": "766760122",
                                                                    "speaker": "努斯妲",
                                                                    "text": "好家伙！上次居然错过了和这两位高手交流的机会…"
                                                                },
                                                                {
                                                                    "id": "766760123",
                                                                    "speaker": "努斯妲",
                                                                    "text": "等我们再去须弥的时候，请务必将我引见给她们！"
                                                                },
                                                                {
                                                                    "id": "766760124",
                                                                    "speaker": "努斯妲",
                                                                    "text": "我很想向她们请教拳法，尤其是高速狂猛出拳时，从脚底至大腿，从大腿到腰背，再倾注力量到手臂与拳的节拍！"
                                                                },
                                                                {
                                                                    "id": "766760125",
                                                                    "speaker": "塔拉内",
                                                                    "text": "啊哈，到时候，你们应该还会喝个痛快…"
                                                                },
                                                                {
                                                                    "id": "766760126",
                                                                    "speaker": "塔拉内",
                                                                    "text": "我得提前给你们准备好醒酒汤！"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "766760121",
                                                            "text": "迪希雅和坎蒂丝干得漂亮！"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "766760112",
                                            "text": "好像能猜到来龙去脉…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "766760106",
                            "text": "能吓退赤鹫的那种…"
                        }
                    ]
                }
            ]
        }
    ]
}