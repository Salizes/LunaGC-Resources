    "talks": [
        {
            "id": "7000010",
            "objective": "（test）萨义德拍照隐藏任务$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7000001",
            "objective": "与萨义德对话",
            "dialogues": [
                {
                    "id": "700000101",
                    "speaker": "萨义德",
                    "text": "多么浪漫的风俗，这才是真正值得研究的。"
                },
                {
                    "id": "700000102",
                    "speaker": "Player",
                    "text": "在做什么？"
                },
                {
                    "id": "700000103",
                    "speaker": "萨义德",
                    "text": "哦，是旅行者啊，你也是对蒙德浪漫的歌谣产生了兴趣，才来到图书馆的吗？"
                },
                {
                    "id": "700000104",
                    "speaker": "萨义德",
                    "text": "不过，一切文字记录我们随时都能阅读，发生在身边的历史稍不留神就会错过啊。"
                },
                {
                    "id": "700000105",
                    "speaker": "萨义德",
                    "text": "在风花节这样浪漫惬意的节日里，蒙德人有许多特别的风俗。"
                },
                {
                    "id": "700000106",
                    "speaker": "萨义德",
                    "text": "这些风俗的形式是怎样的、它们背后的历史如何？诸如此类，都是绝佳的研究方向。"
                },
                {
                    "id": "700000107",
                    "speaker": "萨义德",
                    "text": "我正在就此撰写研究报告，只有文字描述当然不行，能请你帮忙给风花节的景观留个影吗？",
                    "choices": [
                        {
                            "id": "700000108",
                            "text": "没问题。",
                            "response": [
                                {
                                    "id": "700000109",
                                    "speaker": "萨义德",
                                    "text": "感谢你协助我的学术研究，旅行者，我会在报告中署上你的名字。"
                                },
                                {
                                    "id": "700000113",
                                    "speaker": "萨义德",
                                    "text": "<color=#00E1FFFF>喷泉广场上空的花饰</color>、<color=#00E1FFFF>教堂前用花朵装扮的神像</color>还有<color=#00E1FFFF>忙着售卖花朵的花店店主</color>，这些都值得记录。"
                                },
                                {
                                    "id": "700000115",
                                    "speaker": "萨义德",
                                    "text": "那就麻烦你帮我记录这些景观吧，回头把拍好的画片带给我就好。"
                                }
                            ]
                        },
                        {
                            "id": "700000110",
                            "text": "你自己去比较好。",
                            "response": [
                                {
                                    "id": "700000111",
                                    "speaker": "萨义德",
                                    "text": "不不不，现在我不能走开。我刚刚拟好报告的大纲，如果现在走开，思绪就乱了。"
                                },
                                {
                                    "id": "700000112",
                                    "speaker": "萨义德",
                                    "text": "还是得拜托你，旅行者，虽然不多，但是我会为你准备报酬的。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7000002",
            "objective": "给喷泉广场上空的花饰留影",
            "dialogues": []
        },
        {
            "id": "7000004",
            "objective": "给芙萝拉留影",
            "dialogues": [
                {
                    "id": "700000401",
                    "speaker": "芙萝拉",
                    "text": "欢迎光临「花语」，呼呼，有什么需要了解的吗？"
                },
                {
                    "id": "700000402",
                    "speaker": "Player",
                    "text": "关于萨义德的画片…"
                },
                {
                    "id": "700000403",
                    "speaker": "芙萝拉",
                    "text": "确实，风花节是蒙德特有的节日呢，须弥人的话，应该不会过风花节吧。"
                },
                {
                    "id": "700000404",
                    "speaker": "芙萝拉",
                    "text": "要给我和我的花留影？没问题呀，萨义德先生的想法可真特别，学者就是这样吧，呼呼。"
                }
            ]
        },
        {
            "id": "7000005",
            "objective": "（test）与芙洛拉对话$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7000003",
            "objective": "给教堂前的神像留影",
            "dialogues": [
                {
                    "id": "700000301",
                    "speaker": "萨义德",
                    "text": "名字就叫《风花节研究报告》的话…不行，不够响亮。"
                }
            ]
        },
        {
            "id": "7000006",
            "objective": "将画片交给萨义德",
            "dialogues": [
                {
                    "id": "700000601",
                    "speaker": "萨义德",
                    "text": "你们已经拍好画片了吗？"
                },
                {
                    "id": "700000602",
                    "speaker": "Player",
                    "text": "全都拍好了。"
                },
                {
                    "id": "700000603",
                    "speaker": "萨义德",
                    "text": "嗯，你拍得很不错，我的研究肯定能用得上这些画片。"
                },
                {
                    "id": "700000604",
                    "speaker": "萨义德",
                    "text": "看到这么美的景色…我想起了家乡须弥的节日…"
                },
                {
                    "id": "700000605",
                    "speaker": "Player",
                    "text": "须弥有什么节日？"
                },
                {
                    "id": "700000606",
                    "speaker": "萨义德",
                    "text": "噢，你应该不知道吧，我们每年都会举办「花神诞日」，用来纪念「小吉祥草王」的诞生。"
                },
                {
                    "id": "700000607",
                    "speaker": "萨义德",
                    "text": "但如果就气氛而言的话，还是和蒙德城的风花节略有差别的…"
                },
                {
                    "id": "700000608",
                    "speaker": "萨义德",
                    "text": "说起来…今年的花神诞日我也没能参加。唉，这么长时间了，也不知道教令院现在是什么情况…"
                },
                {
                    "id": "700000609",
                    "speaker": "萨义德",
                    "text": "话说远了，总之感谢你的帮忙，这些报酬请你收下吧。"
                }
            ]
        },
        {
            "id": "7000005",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "700000501",
                    "speaker": "芙萝拉",
                    "text": "欢迎光临「花语」，每年风花节的时候店里生意都很忙呢，呼呼。"
                }
            ]
        },
        {
            "id": "7000099",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "700009901",
                    "speaker": "派蒙",
                    "text": "这样应该就算留下了记录吧，对了，别忘记给芙萝拉小姐留影呀。"
                },
                {
                    "id": "700009904",
                    "speaker": "派蒙",
                    "text": "唔…还有哪里要留影的，啊对了，还有教堂前用花朵装扮的神像。"
                },
                {
                    "id": "700009905",
                    "speaker": "派蒙",
                    "text": "这样就记录好了，我们快回去把画片交给萨义德先生吧。"
                }
            ]
        }
    ]
}