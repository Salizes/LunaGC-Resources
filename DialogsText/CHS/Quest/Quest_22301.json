    "talks": [
        {
            "id": "2230101",
            "objective": "与刘苏对话",
            "dialogues": [
                {
                    "id": "223010101",
                    "speaker": "茶博士刘苏",
                    "text": "完了，我讲到哪了来着…"
                },
                {
                    "id": "223010102",
                    "speaker": "Player",
                    "text": "讲什么？"
                },
                {
                    "id": "223010103",
                    "speaker": "茶博士刘苏",
                    "text": "您好，您这是来听书的？还是来…"
                },
                {
                    "id": "223010104",
                    "speaker": "茶博士刘苏",
                    "text": "我？我在这说书，赚点喝茶的小钱。"
                },
                {
                    "id": "223010105",
                    "speaker": "茶博士刘苏",
                    "text": "只是我说的书太多，太杂，说着说着就容易记混…"
                },
                {
                    "id": "223010106",
                    "speaker": "茶博士刘苏",
                    "text": "这不，前几天一帮客人闹着要听讲南十字船队的《海山履云记》，另一帮闹着要听讲古华派的《裁雨声》。"
                },
                {
                    "id": "223010107",
                    "speaker": "茶博士刘苏",
                    "text": "我也是为了赚钱，就每本书挑了段记得的讲了点。"
                },
                {
                    "id": "223010108",
                    "speaker": "茶博士刘苏",
                    "text": "没想到客人听上了心，闹着非要听后续，不给听就闹，你说这…"
                },
                {
                    "id": "223010109",
                    "speaker": "茶博士刘苏",
                    "text": "这两本书都是我几年前讲过的，我这回去淘了半天，才淘出来重新看了看，准备开书。"
                },
                {
                    "id": "223010110",
                    "speaker": "茶博士刘苏",
                    "text": "但是，我忘了我上次这两本书分别讲到哪了…"
                },
                {
                    "id": "223010111",
                    "speaker": "茶博士刘苏",
                    "text": "您能帮我去问问外面的人我上次讲到哪了吗？",
                    "choices": [
                        {
                            "id": "223010112",
                            "text": "我知道了。",
                            "response": [
                                {
                                    "id": "223010113",
                                    "speaker": "茶博士刘苏",
                                    "text": "那您受累。我去问的话，那就是砸我自个的招牌…"
                                },
                                {
                                    "id": "223010118",
                                    "speaker": "茶博士刘苏",
                                    "text": "我寻思了一下，您能问的人有三位。"
                                },
                                {
                                    "id": "223010119",
                                    "speaker": "茶博士刘苏",
                                    "text": "一位是<color=#00E1FFFF>茂才公</color>，这位爷是一场书都没落过。一位是<color=#00E1FFFF>范二爷</color>，也就是这茶楼的老板。"
                                },
                                {
                                    "id": "223010120",
                                    "speaker": "茶博士刘苏",
                                    "text": "还有一位是<color=#00E1FFFF>江舟</color>小姐，我上次说书的时候，看见她停下来听了一会，但是没多久又走了…"
                                }
                            ]
                        },
                        {
                            "id": "223010114",
                            "text": "你干脆从头讲…",
                            "response": [
                                {
                                    "id": "223010115",
                                    "speaker": "茶博士刘苏",
                                    "text": "我也想啊，那不也能赚双份钱…"
                                },
                                {
                                    "id": "223010116",
                                    "speaker": "茶博士刘苏",
                                    "text": "但是这范二爷，不得把我赶出去嘛…"
                                },
                                {
                                    "id": "223010117",
                                    "speaker": "茶博士刘苏",
                                    "text": "您受累，帮我去问一嘴吧，问到了回来告诉我，我掂量着开书…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2230102",
            "objective": "",
            "dialogues": [
                {
                    "id": "223010201",
                    "speaker": "茶博士刘苏",
                    "text": "您回来了啊，您受累，您辛苦。"
                },
                {
                    "id": "223010202",
                    "speaker": "茶博士刘苏",
                    "text": "我这书越说越多，也越忘越多，也是没办法的事…"
                },
                {
                    "id": "223010203",
                    "speaker": "茶博士刘苏",
                    "text": "那，您问到了吗？"
                }
            ]
        },
        {
            "id": "2230111",
            "objective": "",
            "dialogues": [
                {
                    "id": "223011101",
                    "speaker": "范二爷",
                    "text": "这个老刘头，真是没治了…"
                },
                {
                    "id": "223011102",
                    "speaker": "Player",
                    "text": "请问，您听过刘苏说书吗？"
                },
                {
                    "id": "223011103",
                    "speaker": "范二爷",
                    "text": "你说老刘头？他这个书说的可真有意思…"
                },
                {
                    "id": "223011104",
                    "speaker": "范二爷",
                    "text": "我上次得了空去听他说了一次<color=#00E1FFFF>《海山履云记》</color>。"
                },
                {
                    "id": "223011105",
                    "speaker": "范二爷",
                    "text": "刚开了头，说海上风波狂涌，天上惊雷劈落，南十字船队依然是一路往前。"
                },
                {
                    "id": "223011106",
                    "speaker": "范二爷",
                    "text": "打头的旗舰上，船头有一位拄剑挺立，正是南十字船队船长。"
                },
                {
                    "id": "223011107",
                    "speaker": "范二爷",
                    "text": "只看前方恶浪滔天，庞庞然如山黑影从海底长啸而出…"
                },
                {
                    "id": "223011108",
                    "speaker": "范二爷",
                    "text": "然后，老刘头就不讲了，且听下回分解，哈哈哈，这分解了多少天了，什么也没分解出来…"
                }
            ]
        },
        {
            "id": "2230121",
            "objective": "",
            "dialogues": [
                {
                    "id": "223011401",
                    "speaker": "茂才公",
                    "text": "这刘博士，真是气人！"
                },
                {
                    "id": "223011402",
                    "speaker": "Player",
                    "text": "请问，您听过刘苏说书吗？"
                },
                {
                    "id": "223011403",
                    "speaker": "茂才公",
                    "text": "那当然了，只不过这个刘博士真是气人，上次我去和裕茶馆听他讲<color=#00E1FFFF>《裁雨声》</color>。"
                },
                {
                    "id": "223011404",
                    "speaker": "茂才公",
                    "text": "刚刚讲到古华派山门凋敝，上门挑战者络绎不绝，山门的弟子却不断出走。"
                },
                {
                    "id": "223011405",
                    "speaker": "茂才公",
                    "text": "留下的弟子有心护山，无力回天，古华派的招牌都被人砸了。"
                },
                {
                    "id": "223011406",
                    "speaker": "茂才公",
                    "text": "就在古华派掌门心灰意冷，准备散去门人就此归隐的时候，一个年轻人进了山门，一手剑术举世无双…"
                },
                {
                    "id": "223011407",
                    "speaker": "茂才公",
                    "text": "然后他就不讲了！哎哟，说什么且听下回分解，分解了多少天了，连个水花都没起…"
                },
                {
                    "id": "223011408",
                    "speaker": "茂才公",
                    "text": "我下次要见到他，非要他讲出个所以然来不可！"
                }
            ]
        },
        {
            "id": "2230122",
            "objective": "",
            "dialogues": [
                {
                    "id": "223011701",
                    "speaker": "江舟",
                    "text": "唉，什么时候能闲点…"
                },
                {
                    "id": "223011702",
                    "speaker": "Player",
                    "text": "请问您听过刘苏说书吗？"
                },
                {
                    "id": "223011703",
                    "speaker": "江舟",
                    "text": "刘苏…说书？"
                },
                {
                    "id": "223011704",
                    "speaker": "江舟",
                    "text": "哦，我记起来了，我上次路过的时候，确实稍微停了一会听了听。"
                },
                {
                    "id": "223011705",
                    "speaker": "江舟",
                    "text": "不过我也没记清楚，我想想…书名好像是<color=#00E1FFFF>《裁雨声》</color>。"
                },
                {
                    "id": "223011706",
                    "speaker": "江舟",
                    "text": "好像是因为各种原因，古华派的情况很不好，然后有一个很厉害的人去挑战。"
                },
                {
                    "id": "223011707",
                    "speaker": "江舟",
                    "text": "不过我去得太晚，到的时候前面已经讲完了，后面好像讲到了…"
                },
                {
                    "id": "223011708",
                    "speaker": "江舟",
                    "text": "好像是主角本来是要赢了，但是突然被人偷袭，一下子就陷入了劣势。"
                },
                {
                    "id": "223011709",
                    "speaker": "江舟",
                    "text": "但是，我那时候又被人叫去工作了，真想知道后面是怎么发展啊…"
                }
            ]
        },
        {
            "id": "2230161",
            "objective": "向观众们询问刘苏说书的内容",
            "dialogues": []
        },
        {
            "id": "2230162",
            "objective": "向观众们询问刘苏说书的内容",
            "dialogues": []
        },
        {
            "id": "2230163",
            "objective": "向观众们询问刘苏说书的内容",
            "dialogues": []
        },
        {
            "id": "2230109",
            "objective": "",
            "dialogues": [
                {
                    "id": "223010901",
                    "speaker": "茶博士刘苏",
                    "text": "说书啊，真是件好玩的事…"
                }
            ]
        },
        {
            "id": "2230103",
            "objective": "向刘苏回报",
            "dialogues": []
        },
        {
            "id": "2230104",
            "objective": "听刘苏开新书",
            "dialogues": [
                {
                    "id": "223010701",
                    "speaker": "茶博士刘苏",
                    "text": "各位，欲知后事如何…"
                },
                {
                    "id": "223010702",
                    "speaker": "茶博士刘苏",
                    "text": "且听，下回分解！"
                }
            ]
        },
        {
            "id": "2230105",
            "objective": "",
            "dialogues": [
                {
                    "id": "223010501",
                    "speaker": "茶博士刘苏",
                    "text": "您还在这呢，哈哈哈，我这书…您觉着怎么样？",
                    "choices": [
                        {
                            "id": "223010502",
                            "text": "还有呢？",
                            "response": [
                                {
                                    "id": "223010503",
                                    "speaker": "茶博士刘苏",
                                    "text": "您看您，《裁雨声》和《海山履云记》，那可都是大部头。"
                                },
                                {
                                    "id": "223010504",
                                    "speaker": "茶博士刘苏",
                                    "text": "简简单单三言两语可讲不完，您想听，之后您掐着时间来就成。"
                                },
                                {
                                    "id": "223010507",
                                    "speaker": "茶博士刘苏",
                                    "text": "这书还是多谢您帮忙，这些您拿好了，以后还请您来多多捧场。"
                                }
                            ]
                        },
                        {
                            "id": "223010505",
                            "text": "只记得且听下回分解了…",
                            "response": [
                                {
                                    "id": "223010506",
                                    "speaker": "茶博士刘苏",
                                    "text": "哈哈，您想听下回分解，那您得常来。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2230106",
            "objective": "",
            "dialogues": [
                {
                    "id": "223010601",
                    "speaker": "茶博士刘苏",
                    "text": "您还在这呢，哈哈哈，我这书…您觉着怎么样？",
                    "choices": [
                        {
                            "id": "223010602",
                            "text": "还有呢？",
                            "response": [
                                {
                                    "id": "223010603",
                                    "speaker": "茶博士刘苏",
                                    "text": "您看您，《裁雨声》和《海山履云记》，那可都是大部头。"
                                },
