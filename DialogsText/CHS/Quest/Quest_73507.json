    "talks": [
        {
            "id": "7350701",
            "objective": "与摊位旁的两人对话",
            "dialogues": [
                {
                    "id": "735070101",
                    "speaker": "海妮耶",
                    "text": "#「黄金流星」{NICKNAME}和「白银伴星」派蒙，好久不见了。"
                },
                {
                    "id": "735070102",
                    "speaker": "海妮耶",
                    "text": "你们还是这么有精神呢！",
                    "choices": [
                        {
                            "id": "735070103",
                            "text": "别来无恙！",
                            "response": [
                                {
                                    "id": "735070104",
                                    "speaker": "派蒙",
                                    "text": "海海海，海妮耶！还有那个超负责的…贝尔福先生？"
                                },
                                {
                                    "id": "735070105",
                                    "speaker": "派蒙",
                                    "text": "真没想到，居然又在奥摩斯港遇见你们了！"
                                },
                                {
                                    "id": "735070114",
                                    "speaker": "派蒙",
                                    "text": "话说回来，海妮耶和贝尔福在这里干什么呢？我记得这里以前是「花花琼脂」的摊位…"
                                },
                                {
                                    "id": "735070115",
                                    "speaker": "贝尔福",
                                    "text": "两位大英雄，听着你们的声音，我的心里也更有底气了。"
                                },
                                {
                                    "id": "735070116",
                                    "speaker": "贝尔福",
                                    "text": "接下来，就是我向两位汇报工作成果的时候了。"
                                },
                                {
                                    "id": "735070117",
                                    "speaker": "贝尔福",
                                    "text": "之前两位作为「月莲杯驯兽师大赛」的冠军，决定让大赛暂时休赛，先让教令院改进「意智宝珠」。"
                                },
                                {
                                    "id": "735070118",
                                    "speaker": "贝尔福",
                                    "text": "两位应该还在等待通知？"
                                },
                                {
                                    "id": "735070119",
                                    "speaker": "派蒙",
                                    "text": "对哦！等到有进展了，莱依拉、赛诺或者负责的学者应该会想办法告诉我们的！",
                                    "choices": [
                                        {
                                            "id": "735070120",
                                            "text": "派蒙不博学，听不懂技术。",
                                            "response": [
                                                {
                                                    "id": "735070122",
                                                    "speaker": "派蒙",
                                                    "text": "道理确实是这样啦，我们主动去问也帮不上什么忙，说不定反而会干扰他们…"
                                                },
                                                {
                                                    "id": "735070123",
                                                    "speaker": "贝尔福",
                                                    "text": "你们还真是沉得住气，作风谨慎！我就经常回想起上次大赛的盛况，根本按捺不住…"
                                                },
                                                {
                                                    "id": "735070124",
                                                    "speaker": "贝尔福",
                                                    "text": "所以前段时间，我设法询问了教令院的相关人士，得到了详细的答复——"
                                                },
                                                {
                                                    "id": "735070125",
                                                    "speaker": "贝尔福",
                                                    "text": "目前，「意智宝珠」的改进还处于理论攻关阶段，距离投入生产，还需要不少时间。"
                                                },
                                                {
                                                    "id": "735070126",
                                                    "speaker": "贝尔福",
                                                    "text": "但第一届大赛的讨论度正在降低，甚至慢慢被人们遗忘。不能就这样浪费了大赛的影响力。"
                                                },
                                                {
                                                    "id": "735070127",
                                                    "speaker": "贝尔福",
                                                    "text": "因此，我找到了海妮耶小姐，一起筹备了新的「话题活动」。"
                                                },
                                                {
                                                    "id": "735070128",
                                                    "speaker": "Player",
                                                    "text": "「话题活动」？"
                                                },
                                                {
                                                    "id": "735070129",
                                                    "speaker": "派蒙",
                                                    "text": "难道说的是，桌上摆着的这些…蕈兽模样的棋子？"
                                                },
                                                {
                                                    "id": "735070130",
                                                    "speaker": "海妮耶",
                                                    "text": "没错。"
                                                },
                                                {
                                                    "id": "735070131",
                                                    "speaker": "海妮耶",
                                                    "text": "贝尔福先生一直在为下次大赛准备新内容的方案，到处筹措资金，还前往璃月学习了新的商业门路。"
                                                },
                                                {
                                                    "id": "735070132",
                                                    "speaker": "海妮耶",
                                                    "text": "他在璃月学习商业经营时，接触到了一种游戏，名为「机关棋谭」。"
                                                },
                                                {
                                                    "id": "735070133",
                                                    "speaker": "海妮耶",
                                                    "text": "贝尔福先生买下了「机关棋谭」在须弥的代理权，请我来当顾问，一起规划了全新的游戏。"
                                                },
                                                {
                                                    "id": "735070134",
                                                    "speaker": "海妮耶",
                                                    "text": "它的名字是「灵蕈棋阵」。"
                                                },
                                                {
                                                    "id": "735070135",
                                                    "speaker": "派蒙",
                                                    "text": "「灵蕈棋阵」？"
                                                },
                                                {
                                                    "id": "735070136",
                                                    "speaker": "派蒙",
                                                    "text": "让我来猜猜…难道这次是要我们指挥蕈兽，去和各种机关较量吗？"
                                                },
                                                {
                                                    "id": "735070137",
                                                    "speaker": "贝尔福",
                                                    "text": "不愧是「白银伴星」，一下子就猜到了！"
                                                },
                                                {
                                                    "id": "735070138",
                                                    "speaker": "贝尔福",
                                                    "text": "我觉得，这种游戏易于理解，便于推广，有很大的潜力可供发掘。"
                                                },
                                                {
                                                    "id": "735070139",
                                                    "speaker": "贝尔福",
                                                    "text": "要是让它以「驯兽师大赛」衍生游戏的名义流行起来，就能让人们长期记住大赛，心怀期待。"
                                                },
                                                {
                                                    "id": "735070140",
                                                    "speaker": "贝尔福",
                                                    "text": "如此一来，下一届大赛举办时，就会有更多选手参赛，更多观众前来捧场。"
                                                },
                                                {
                                                    "id": "735070141",
                                                    "speaker": "贝尔福",
                                                    "text": "当然，这一切还要你们两位点头许可。毕竟，现在大赛的一切都由你们说了算。",
                                                    "choices": [
                                                        {
                                                            "id": "735070142",
                                                            "text": "我觉得值得一试！",
                                                            "response": [
                                                                {
                                                                    "id": "735070144",
                                                                    "speaker": "派蒙",
                                                                    "text": "#对哦，我和{NICKNAME}不懂商业上的门道，听贝尔福先生这么一说，我觉得很有道理！"
                                                                },
                                                                {
                                                                    "id": "735070145",
                                                                    "speaker": "派蒙",
                                                                    "text": "这是海妮耶和贝尔福先生共同努力的结果，我相信你们的才能，请尽管去干吧！"
                                                                },
                                                                {
                                                                    "id": "735070146",
                                                                    "speaker": "派蒙",
                                                                    "text": "虽然还没开始玩，但我能肯定，一定会有许多人喜欢的！"
                                                                },
                                                                {
                                                                    "id": "735070147",
                                                                    "speaker": "贝尔福",
                                                                    "text": "太好了，能得到你们两位的允许，我就可以放手推广「灵蕈棋阵」了。"
                                                                },
                                                                {
                                                                    "id": "735070148",
                                                                    "speaker": "贝尔福",
                                                                    "text": "目前「灵蕈棋阵」还处于测试阶段，需要请人试玩、收集反馈，多次进行改良。"
                                                                },
                                                                {
                                                                    "id": "735070149",
                                                                    "speaker": "贝尔福",
                                                                    "text": "精通数十种提瓦特流行游戏的「黄金流星」玩过以后，肯定能给出最精准的建议！"
                                                                },
                                                                {
                                                                    "id": "735070150",
                                                                    "speaker": "派蒙",
                                                                    "text": "#那就上吧，{NICKNAME}！这可是你最擅长的领域之一！",
                                                                    "choices": [
                                                                        {
                                                                            "id": "735070151",
                                                                            "text": "怎么有种被你指挥的感觉…",
                                                                            "response": [
                                                                                {
                                                                                    "id": "735070153",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "不过，我还有一件事想问问海妮耶…"
                                                                                },
                                                                                {
                                                                                    "id": "735070154",
                                                                                    "speaker": "海妮耶",
                                                                                    "text": "是「咚咚小圆帽」它们吗？"
                                                                                },
                                                                                {
                                                                                    "id": "735070155",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "对对对！我好想念蕈兽伙伴们，它们现在怎么样了呢？"
                                                                                },
                                                                                {
                                                                                    "id": "735070156",
                                                                                    "speaker": "海妮耶",
                                                                                    "text": "放心吧，它们都健健康康，每天生活得无忧无虑！"
                                                                                },
                                                                                {
                                                                                    "id": "735070157",
                                                                                    "speaker": "海妮耶",
                                                                                    "text": "「转转悠悠兽」和「百雷遮罗」待在我在<color=#00E1FFFF>奥摩斯港北边的临时住处</color>，由上次的一位参赛选手暂时照看。"
                                                                                },
                                                                                {
                                                                                    "id": "735070158",
                                                                                    "speaker": "海妮耶",
                                                                                    "text": "「咚咚小圆帽」和「欢腾之火」就在附近。你可以去和它们一起玩哦，「白银伴星」。"
                                                                                },
                                                                                {
                                                                                    "id": "735070159",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "#就在附近！那{NICKNAME}，待会儿你试玩新游戏的时候，我要去找「咚咚小圆帽」啦！",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "735070160",
                                                                                            "text": "去吧去吧！",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "735070162",
                                                                                                    "speaker": "贝尔福",
                                                                                                    "text": "事不宜迟，就请「黄金流星」来体验一下早期测试版的「灵蕈棋阵」吧！"
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "735070161",
                                                                                            "text": "我稍后就来！"
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "735070152",
                                                                            "text": "好吧，「黄金流星」出击！"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "735070143",
                                                            "text": "真是让你费心了！"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "735070121",
                                            "text": "我不懂技术，不乱提建议。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "735070106",
                            "text": "你们是？",
                            "response": [
                                {
                                    "id": "735070107",
                                    "speaker": "派蒙",
                                    "text": "#{NICKNAME}，你在说什么呀？"
                                },
                                {
                                    "id": "735070108",
                                    "speaker": "派蒙",
                                    "text": "之前我们参加了「月莲杯驯兽师大赛」，和蕈兽伙伴们玩得很开心啊！"
                                },
                                {
                                    "id": "735070109",
                                    "speaker": "派蒙",
                                    "text": "海妮耶就是我们在那时候认识的好朋友，贝尔福先生则是大赛最负责的工作人员。"
                                },
                                {
                                    "id": "735070110",
                                    "speaker": "派蒙",
                                    "text": "难道，就连「咚咚小圆帽」、「转转悠悠兽」，这些蕈兽伙伴，你都不记得了吗？",
                                    "choices": [
                                        {
                                            "id": "735070111",
                                            "text": "哦哦！我想起来了！",
                                            "response": [
                                                {
                                                    "id": "735070113",
                                                    "speaker": "派蒙",
                                                    "text": "真是的，你不要吓我啦，不然我就要替你去找医生了哦。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "735070112",
                                            "text": "嘿嘿，我开玩笑的！"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7350706",
            "objective": "",
            "dialogues": [
                {
                    "id": "735070501",
                    "speaker": "派蒙",
                    "text": "「咚咚小圆帽」，我们来击掌吧。"
                },
                {
                    "id": "735070502",
                    "speaker": "派蒙",
                    "text": "「欢腾之火」，我们一起和「咚咚小圆帽」来跳舞！"
                },
                {
                    "id": "735070503",
                    "speaker": "派蒙",
                    "text": "啊呀，虽然和「欢腾之火」也很熟悉了，但好像还是没法做到和「咚咚小圆帽」那样顺畅沟通呢…",
                    "choices": [
                        {
                            "id": "735070504",
                            "text": "派蒙好开心！",
                            "response": [
                                {
                                    "id": "735070506",
                                    "speaker": "派蒙",
                                    "text": "#你来了，{NICKNAME}！"
                                },
                                {
                                    "id": "735070507",
                                    "speaker": "派蒙",
                                    "text": "「灵蕈棋阵」的情况还好吗？",
                                    "choices": [
                                        {
                                            "id": "735070508",
                                            "text": "之后还有好几天的测试。",
                                            "response": [
                                                {
                                                    "id": "735070510",
                                                    "speaker": "派蒙",
                                                    "text": "海妮耶和蕈兽伙伴们会在这里待上一段时间吗，太好了！"
                                                },
                                                {
                                                    "id": "735070511",
                                                    "speaker": "派蒙",
                                                    "text": "要不然，我还想让你在奥摩斯港住一天，我们一起好好陪着蕈兽伙伴玩个尽兴呢。"
                                                },
                                                {
                                                    "id": "735070512",
                                                    "speaker": "派蒙",
                                                    "text": "现在看来，帮助海妮耶和贝尔福先生测试「灵蕈棋阵」，陪蕈兽伙伴好好玩耍，完全能做到一举两得两不误！"
                                                },
                                                {
                                                    "id": "735070513",
                                                    "speaker": "Black Screen",
                                                    "text": "和派蒙、「咚咚小圆帽」、「欢腾之火」无忧无虑地玩耍了一段时间，并将海妮耶制作的「妙妙琼脂」喂给了蕈兽伙伴们。\\n派蒙和蕈兽伙伴们都非常开心。"
                                                },
                                                {
                                                    "id": "735070514",
                                                    "speaker": "派蒙",
                                                    "text": "呼呼，心里暖暖的，好像所有烦恼都飞走了…"
                                                },
                                                {
                                                    "id": "735070515",
                                                    "speaker": "派蒙",
                                                    "text": "那就明天再见啦，「咚咚小圆帽」和「欢腾之火」！"
                                                },
                                                {
                                                    "id": "735070516",
                                                    "speaker": "咚咚小圆帽",
                                                    "text": "♪~"
                                                },
                                                {
                                                    "id": "735070517",
                                                    "speaker": "火一",
                                                    "text": "？"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "735070509",
                                            "text": "每天都可以和伙伴们玩。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "735070505",
                            "text": "我也超开心！"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7350702",
            "objective": "找贝尔福试玩「灵蕈棋阵」",
            "dialogues": []
        },
        {
            "id": "7350704",
            "objective": "试玩「灵蕈棋阵」",
            "dialogues": [
                {
                    "id": "735070401",
                    "speaker": "贝尔福",
                    "text": "事不宜迟，就请「黄金流星」来体验一下内部测试版的「灵蕈棋阵」吧！"
                }
            ]
        },
        {
            "id": "7350703",
            "objective": "与海妮耶和贝尔福对话",
            "dialogues": [
                {
                    "id": "735070301",
                    "speaker": "贝尔福",
                    "text": "怎么样，「黄金流星」？初次尝试「灵蕈棋阵」的感觉如何？"
                },
                {
                    "id": "735070302",
                    "speaker": "海妮耶",
                    "text": "看你的神情，似乎还没法得出结论？",
                    "choices": [
                        {
                            "id": "735070303",
                            "text": "目前只测试了一关。",
                            "response": [
                                {
                                    "id": "735070305",
                                    "speaker": "贝尔福",
                                    "text": "嗯，测试的内容太少，确实很难考察出「灵蕈棋阵」的优缺点。"
                                },
                                {
                                    "id": "735070306",
                                    "speaker": "贝尔福",
                                    "text": "请别担心，接下来一段时间里，我和海妮耶小姐会一直待在这里，每天都准备一个新的「灵蕈棋阵」关卡，共计七个。"
                                },
                                {
                                    "id": "735070307",
                                    "speaker": "贝尔福",
                                    "text": "等你有空的时候，就能来进行测试！"
                                },
                                {
                                    "id": "735070308",
                                    "speaker": "贝尔福",
                                    "text": "虽然你是主办方的最终决定人，但这个游戏毕竟是我拉着海妮耶小姐擅自筹备的，不在你的计划之内，会占用你的时间。"
                                },
                                {
                                    "id": "735070309",
                                    "speaker": "贝尔福",
                                    "text": "为此，我也会给你一笔辛苦费的！",
                                    "choices": [
                                        {
                                            "id": "735070310",
                                            "text": "哈哈，我就不和你客气啦！",
                                            "response": [
                                                {
                                                    "id": "735070312",
                                                    "speaker": "贝尔福",
                                                    "text": "真爽快！你的豪情令人钦佩！"
                                                },
                                                {
                                                    "id": "735070313",
                                                    "speaker": "海妮耶",
                                                    "text": "我给两位蕈兽伙伴申请了足够的驻留时间，「灵蕈棋阵」的测试期间，它们可以一直待在奥摩斯港。"
                                                },
                                                {
                                                    "id": "735070314",
