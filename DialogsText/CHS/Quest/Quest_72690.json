    "talks": [
        {
            "id": "7269001",
            "objective": "等待至翌日上午（次日早8点-12点），与柴染对话",
            "dialogues": [
                {
                    "id": "726900101",
                    "speaker": "柴染",
                    "text": "两位，这一天终于来了。"
                },
                {
                    "id": "726900102",
                    "speaker": "柴染",
                    "text": "对于「花影瑶庭」的构图之道，你们已经领会到了精髓。"
                },
                {
                    "id": "726900103",
                    "speaker": "柴染",
                    "text": "是时候来一场花艺的真剑试炼了。"
                },
                {
                    "id": "726900104",
                    "speaker": "派蒙",
                    "text": "等等？原来我们已经领会到精髓了吗？"
                },
                {
                    "id": "726900105",
                    "speaker": "派蒙",
                    "text": "真剑试炼的意思是最难的题目吧！我突然有点害怕了…"
                },
                {
                    "id": "726900106",
                    "speaker": "Player",
                    "text": "明明接触插花的时间还不长。"
                },
                {
                    "id": "726900107",
                    "speaker": "柴染",
                    "text": "制作花材的手法的确需要长期的磨练，而规划「花庭」的图景与结构，更侧重意会和灵感。"
                },
                {
                    "id": "726900108",
                    "speaker": "柴染",
                    "text": "只论后者，两位的确表现出了惊人的天赋，不再需要「花题」的锤炼了。"
                },
                {
                    "id": "726900109",
                    "speaker": "柴染",
                    "text": "或许是因为，两位经历过迷人的旅程，见证过我无法想象的景致，才有了不同于平凡之人的心境吧。"
                },
                {
                    "id": "726900110",
                    "speaker": "派蒙",
                    "text": "是，是这样吗…"
                },
                {
                    "id": "726900111",
                    "speaker": "派蒙",
                    "text": "#说起来，{NICKNAME}，我们的确去过不少地方了呢，原来一起旅行的过程中，我们也会获得更多灵感啊…"
                },
                {
                    "id": "726900112",
                    "speaker": "派蒙",
                    "text": "那这段时间，我们一直在学习花艺，又消耗掉了多少灵感呢？",
                    "choices": [
                        {
                            "id": "726900113",
                            "text": "旅程还会继续下去。",
                            "response": [
                                {
                                    "id": "726900115",
                                    "speaker": "派蒙",
                                    "text": "嗯，有道理！"
                                },
                                {
                                    "id": "726900116",
                                    "speaker": "派蒙",
                                    "text": "谢谢你，柴染小姐！要不是有你点拨，我们还没发现我们居然有这方面的才能呢！"
                                },
                                {
                                    "id": "726900117",
                                    "speaker": "柴染",
                                    "text": "不必客气。请用至美的「花庭」为这次的花艺体验之旅划上句点吧。",
                                    "choices": [
                                        {
                                            "id": "726900118",
                                            "text": "请出题吧。",
                                            "response": [
                                                {
                                                    "id": "726900119",
                                                    "speaker": "柴染",
                                                    "text": "那么，今天的花题是——"
                                                },
                                                {
                                                    "id": "726900120",
                                                    "speaker": "柴染",
                                                    "text": "「斜枝宛虹，绘染斑彩」。"
                                                },
                                                {
                                                    "id": "726900121",
                                                    "speaker": "柴染",
                                                    "text": "期待着你们技艺大成的「花影瑶庭」。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "726900122",
                                            "text": "还有别的事…",
                                            "response": [
                                                {
                                                    "id": "726900123",
                                                    "speaker": "柴染",
                                                    "text": "没关系。「插花」需要安神定气。"
                                                },
                                                {
                                                    "id": "726900124",
                                                    "speaker": "柴染",
                                                    "text": "等到二位忙完手头的事，摆脱了喧扰，必定能将题中的「花庭」构筑得更加完满。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "726900114",
                            "text": "灵感会越来越多的。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7269002",
            "objective": "与柴染对话",
            "dialogues": []
        },
        {
            "id": "7269003",
            "objective": "完成花题",
            "dialogues": []
        },
        {
            "id": "7269004",
            "objective": "与柴染对话",
            "dialogues": []
        },
        {
            "id": "7268702",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "726870201",
                    "speaker": "柴染",
                    "text": "接下来的几天，我会一直守候在这里，引导容彩祭的客人们，让他们感受「花影瑶庭」的精妙之处。"
                },
                {
                    "id": "726870202",
                    "speaker": "柴染",
                    "text": "两位也别忘了每天揭晓一道的「花题」哦，一共有四道「花题」等着你们作答呢。"
                },
                {
                    "id": "726870203",
                    "speaker": "柴染",
                    "text": "当然，要是两位还有其他问题，我也会尽力为你们解答的。",
                    "choices": [
                        {
                            "id": "726870204",
                            "text": "关于这里的花卉…",
                            "response": [
                                {
                                    "id": "726870205",
                                    "speaker": "柴染",
                                    "text": "我所使用的花材，都是由「咲耶花屋」提供的。「咲耶花屋」栽培的花卉有着难以挑剔的品质和亲民的价格。"
                                },
                                {
                                    "id": "726870206",
                                    "speaker": "柴染",
                                    "text": "也许你们已经见过咲耶了，我们曾在同一位老师门下学习「插花」的技巧。"
                                },
                                {
                                    "id": "726870207",
                                    "speaker": "柴染",
                                    "text": "咲耶对于花艺的理解也可圈可点，但是听说容彩祭的客人络绎不绝时，她似乎有些怯场，认为在这种环境里难以静下心来插花。"
                                },
                                {
                                    "id": "726870208",
                                    "speaker": "柴染",
                                    "text": "所以，我也会向其他客人宣传她的「咲耶花屋」。"
                                },
                                {
                                    "id": "726870209",
                                    "speaker": "派蒙",
                                    "text": "有机会的话，我们也可以帮忙哦！"
                                },
                                {
                                    "id": "726870219",
                                    "speaker": "柴染",
                                    "text": "那么，还有什么问题吗，两位？"
                                },
                                {
                                    "id": "726870220",
                                    "speaker": "Player",
                                    "text": "谢谢你，柴染小姐。"
                                },
                                {
                                    "id": "726870221",
                                    "speaker": "柴染",
                                    "text": "不用客气。如果你们有空，随时都可以来找我哦。"
                                }
                            ]
                        },
                        {
                            "id": "726870210",
                            "text": "关于社奉行…",
                            "response": [
                                {
                                    "id": "726870211",
                                    "speaker": "柴染",
                                    "text": "社奉行一直支持着稻妻的花艺事业。准确来说，为这次活动出资的贵人，是那位白鹭公主。"
                                },
                                {
                                    "id": "726870212",
                                    "speaker": "柴染",
                                    "text": "白鹭公主自小就表现出惊人的花艺天赋。我曾看过她的「插花」表演，有幸与她交流过心得。"
                                },
                                {
                                    "id": "726870213",
                                    "speaker": "柴染",
                                    "text": "虽说我比她年长，但论插花的技巧和对花艺的理解，完全没法与她相提并论呢。"
                                },
                                {
                                    "id": "726870214",
                                    "speaker": "柴染",
                                    "text": "在条件允许的情况下，白鹭公主每年都会提供资金，推广「插花」这门艺术。听说有时她还会用掉自己的积蓄…"
                                },
                                {
                                    "id": "726870215",
                                    "speaker": "柴染",
                                    "text": "白鹭公主曾坦率表达过自己的愿望——她想让更多人了解「插花」，对花艺产生兴趣，进而沉下心来修习这门学问。"
                                },
                                {
                                    "id": "726870216",
                                    "speaker": "派蒙",
                                    "text": "原来绫华为稻妻的花艺付出过这么多啊…"
                                },
                                {
                                    "id": "726870217",
                                    "speaker": "Player",
                                    "text": "希望她的愿望能实现。"
                                },
                                {
                                    "id": "726870218",
                                    "speaker": "柴染",
                                    "text": "感谢两位，你们真是善解人意。"
                                }
                            ]
                        },
                        {
                            "id": "726870222",
                            "text": "暂时没有问题了。",
                            "response": [
                                {
                                    "id": "726870223",
                                    "speaker": "柴染",
                                    "text": "如果你们有空，随时都可以来找我哦。"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}