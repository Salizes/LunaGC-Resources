    "talks": [
        {
            "id": "7453201",
            "objective": "与小露米埃尔对话",
            "dialogues": [
                {
                    "id": "745320101",
                    "speaker": "小露米埃尔",
                    "text": "我有一则不好的消息，根据我委托《蒸汽鸟报》进行的街头调查报告显示，人们对「速览映影」这一艺术形式似乎缺乏兴致。"
                },
                {
                    "id": "745320102",
                    "speaker": "小露米埃尔",
                    "text": "很奇怪，明明大家都觉得我们的「速览映影」成片很有趣，但当被问及是否有兴趣参与制作时，反应就相对比较负面了…"
                },
                {
                    "id": "745320103",
                    "speaker": "派蒙",
                    "text": "欸？可明明「速览映影」制作起来很有趣啊？"
                },
                {
                    "id": "745320104",
                    "speaker": "小露米埃尔",
                    "text": "数据显示，在一般人眼中，第二大的阻碍来自于设备，毕竟不是每个人都能熟练掌握映影机以及后期技术…"
                },
                {
                    "id": "745320105",
                    "speaker": "小露米埃尔",
                    "text": "而最大的担忧，则是觉得这件事很难有收益，尤其成片之后很难跟周围的朋友们分享成果。"
                },
                {
                    "id": "745320106",
                    "speaker": "梅里爱",
                    "text": "分享啊…我明白了！我们需要一场属于「速览映影」的映影节！这样所有人就都能感受到自己的成果如星光般闪耀了！"
                },
                {
                    "id": "745320107",
                    "speaker": "梅里爱",
                    "text": "嗯，决定了！是时候下血本了！"
                },
                {
                    "id": "745320108",
                    "speaker": "派蒙",
                    "text": "不要动不动就下血本啊！",
                    "choices": [
                        {
                            "id": "745320109",
                            "text": "一般人很难参加映影节的。",
                            "response": [
                                {
                                    "id": "745320111",
                                    "speaker": "小露米埃尔",
                                    "text": "我认同派蒙女士的看法，展会不论对于我们，还是对于我们想要争取的人群而言，门槛都不算太低…"
                                },
                                {
                                    "id": "745320112",
                                    "speaker": "小露米埃尔",
                                    "text": "而且，其氛围和周期，似乎也与普通人的距离太过遥远了。我们需要寻找一些更适合普罗大众的案例。"
                                },
                                {
                                    "id": "745320113",
                                    "speaker": "小露米埃尔",
                                    "text": "可以面向普罗大众的模式吗…说起枫丹最大众化的娱乐，非蒸汽鸟报莫属了吧。只不过这个载体似乎…"
                                },
                                {
                                    "id": "745320114",
                                    "speaker": "派蒙",
                                    "text": "说不定我们可以帮大家把作品剪辑成一个映影片！这样的话就可以跟一大群朋友一起观看了！"
                                },
                                {
                                    "id": "745320115",
                                    "speaker": "梅里爱",
                                    "text": "对啊，说不定也可以像广告片一样，放在其他映影的片头！总之，可以选择的平台载体很多很多！"
                                },
                                {
                                    "id": "745320116",
                                    "speaker": "小露米埃尔",
                                    "text": "看来，「速览映影」这一艺术形式，还有很多可以挖掘的空间啊，这真是意外之喜啊…"
                                },
                                {
                                    "id": "745320117",
                                    "speaker": "梅里爱",
                                    "text": "#{NICKNAME}，派蒙，多谢你们！这下我又找到新的目标了！"
                                },
                                {
                                    "id": "745320118",
                                    "speaker": "派蒙",
                                    "text": "嘿嘿，我们只是随便说了个点子而已啦。",
                                    "choices": [
                                        {
                                            "id": "745320119",
                                            "text": "不愧是我们。",
                                            "response": [
                                                {
                                                    "id": "745320121",
                                                    "speaker": "梅里爱",
                                                    "text": "请你们放心，如果有后续的话，我们一定会邀请你们合作的！而且保证会把你们的名字，放在嘉宾的第一位！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "745320120",
                                            "text": "记得多给我们点报酬哦。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "745320110",
                            "text": "映影节也不能天天开吧。"
                        }
                    ]
                }
            ]
        }
    ]
}