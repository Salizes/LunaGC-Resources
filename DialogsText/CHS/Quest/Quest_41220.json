        }
    },
    "talks": [
        {
            "id": "4122001",
            "objective": "",
            "dialogues": [
                {
                    "id": "412200101",
                    "speaker": "立本",
                    "text": "这位小友，重逢是缘啊！我——"
                },
                {
                    "id": "412200102",
                    "speaker": "Player",
                    "text": "你不是破产了吗？"
                },
                {
                    "id": "412200103",
                    "speaker": "立本",
                    "text": "小友这句话割得我心肝都疼了。这个过去就揭了吧，教训已经够了。"
                },
                {
                    "id": "412200104",
                    "speaker": "立本",
                    "text": "上次亏空了家产之后，我在码头努力工作，巧合中又觅到了商机。"
                },
                {
                    "id": "412200105",
                    "speaker": "Player",
                    "text": "您的商业嗅觉上次体会过…"
                },
                {
                    "id": "412200106",
                    "speaker": "立本",
                    "text": "别这么说嘛。至少这次我是赚了一点小钱，现在已经无债一身轻了。"
                },
                {
                    "id": "412200107",
                    "speaker": "立本",
                    "text": "除了路途远至须弥，周期有些长之外，这条商路可说是稳赚不赔。"
                },
                {
                    "id": "412200108",
                    "speaker": "立本",
                    "text": "众所周知，须弥不是雨林就是沙漠，除了蘑菇，他们什么都喜欢。所以我这么说，小友你懂了吧？"
                },
                {
                    "id": "412200109",
                    "speaker": "立本",
                    "text": "还是老规矩，收一些其他地方的寻常货，转手卖到须弥。你是老合作伙伴了，买价就给个熟人价吧！"
                },
                {
                    "id": "412200110",
                    "speaker": "Player",
                    "text": "那、那再试试吧…"
                },
                {
                    "id": "412200111",
                    "speaker": "立本",
                    "text": "哈哈哈，是这样的——"
                }
            ]
        },
        {
            "id": "4122001",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "412200159",
                    "speaker": "立本",
                    "text": "小友，好久不见了。"
                },
                {
                    "id": "412200160",
                    "speaker": "Player",
                    "text": "立本，近来如何？"
                },
                {
                    "id": "412200161",
                    "speaker": "立本",
                    "text": "可以说是柳暗花明吧。上回从须弥出来之后，我去稻妻进了一批货。"
                },
                {
                    "id": "412200162",
                    "speaker": "立本",
                    "text": "须弥局势不明朗，我打算碰碰运气，就往枫丹去了。"
                },
                {
                    "id": "412200163",
                    "speaker": "立本",
                    "text": "原本想着考察当地市场，能回本就不亏。"
                },
                {
                    "id": "412200164",
                    "speaker": "立本",
                    "text": "没想到，枫丹人很喜欢稻妻的商品。"
                },
                {
                    "id": "412200165",
                    "speaker": "立本",
                    "text": "在其他国家滞销的存货，比如希娜小姐的周边，竟然都卖出去了。",
                    "choices": [
                        {
                            "id": "412200166",
                            "text": "太好了。",
                            "response": [
                                {
                                    "id": "412200168",
                                    "speaker": "立本",
                                    "text": "枫丹人喜欢折腾机械，反而很少有人在这种小物件上花费心思。"
                                },
                                {
                                    "id": "412200169",
                                    "speaker": "立本",
                                    "text": "这就是所谓的物以稀为贵吧。"
                                },
                                {
                                    "id": "412200170",
                                    "speaker": "立本",
                                    "text": "要不是那边的情况有些不妙，真想多跑几趟啊。"
                                },
                                {
                                    "id": "412200171",
                                    "speaker": "Player",
                                    "text": "发生什么了？"
                                },
                                {
                                    "id": "412200172",
                                    "speaker": "立本",
                                    "text": "就是压抑又危险，暴雨将至的气氛。"
                                },
                                {
                                    "id": "412200173",
                                    "speaker": "立本",
                                    "text": "当地人都紧张兮兮的，说着什么审判要来了。"
                                },
                                {
                                    "id": "412200174",
                                    "speaker": "立本",
                                    "text": "我建议你近期不要去那里。一旦惹上什么麻烦，就不好脱身啦。",
                                    "choices": [
                                        {
                                            "id": "412200175",
                                            "text": "我会注意的。",
                                            "response": [
                                                {
                                                    "id": "412200177",
                                                    "speaker": "立本",
                                                    "text": "那么，还是跟以前一样。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "412200176",
                                            "text": "你也多加小心。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "412200167",
                            "text": "希娜小姐的魅力得到了认可。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "4122005",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "412200520",
                    "speaker": "Player",
                    "text": "再介绍一下你自己？"
                },
                {
                    "id": "412200521",
                    "speaker": "立本",
                    "text": "我叫立本，曾经是一个奇货商人。"
                },
                {
                    "id": "412200522",
                    "speaker": "立本",
                    "text": "最近在做一些好买卖。"
                },
                {
                    "id": "412200523",
                    "speaker": "Player",
                    "text": "你说的生意是…"
                },
                {
                    "id": "412200524",
                    "speaker": "立本",
                    "text": "我会用装了各种宝贝的奇货匣子来兑换食材原料、日用百货。"
                },
                {
                    "id": "412200525",
                    "speaker": "立本",
                    "text": "匣子里的东西都是我奇货商时期的家底，绝对童叟无欺。"
                },
                {
                    "id": "412200526",
                    "speaker": "立本",
                    "text": "至于你问为什么弄成随机红包？"
                },
                {
                    "id": "412200527",
                    "speaker": "立本",
                    "text": "好像很多人喜欢这口，弄成这样大家好像就更有干劲了。"
                },
                {
                    "id": "412200517",
                    "speaker": "Player",
                    "text": "那你怎么赚钱呢？"
                },
                {
                    "id": "412200518",
                    "speaker": "立本",
                    "text": "这种事情，到时候再想吧。"
                },
                {
                    "id": "412200519",
                    "speaker": "立本",
                    "text": "实在不行，下次去纳塔蹚一蹚。"
                },
                {
                    "id": "412200528",
                    "speaker": "Player",
                    "text": "再介绍一下你自己？"
                },
                {
                    "id": "412200529",
                    "speaker": "立本",
                    "text": "我叫立本，曾经是一个奇货商人。"
                },
                {
                    "id": "412200530",
                    "speaker": "立本",
                    "text": "最近在做一些好买卖。"
                },
                {
                    "id": "412200531",
                    "speaker": "立本",
                    "text": "前段时间我刚跑了去挪德卡莱的商路，盘算着能发一笔小财。"
                },
                {
                    "id": "412200532",
                    "speaker": "立本",
                    "text": "结果…看到我还在这里，你就知道发财失败啦！"
                },
                {
                    "id": "412200533",
                    "speaker": "Player",
                    "text": "你说的生意是…"
                },
                {
                    "id": "412200534",
                    "speaker": "立本",
                    "text": "我会用这些装了各种宝贝的奇货匣子来兑换一些食材原料、日用百货。"
                },
                {
                    "id": "412200535",
                    "speaker": "立本",
                    "text": "这些匣子里的东西都是我奇货商时期的家底，绝对童叟无欺。"
                },
                {
                    "id": "412200536",
                    "speaker": "立本",
                    "text": "至于你问为什么弄成随机红包？"
                },
                {
                    "id": "412200537",
                    "speaker": "立本",
                    "text": "好像很多人喜欢这口，弄成这样大家好像就更有干劲了。"
                },
                {
                    "id": "412200538",
                    "speaker": "Player",
                    "text": "那你怎么赚钱呢？"
                },
                {
                    "id": "412200539",
                    "speaker": "立本",
                    "text": "不然我下次还是去探探纳塔的生意吧。"
                },
                {
                    "id": "412200540",
                    "speaker": "立本",
                    "text": "或者雇佣几个保护的人，再跑一趟挪德卡莱也不是不行。"
                },
                {
                    "id": "412200541",
                    "speaker": "立本",
                    "text": "说实话，我也有点累了…"
                },
                {
                    "id": "412200542",
                    "speaker": "立本",
                    "text": "歇一阵子再做打算吧！"
                }
            ]
        },
        {
            "id": "4122007",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "412200701",
                    "speaker": "立本",
                    "text": "小友，又是好久不见了啊。"
                },
                {
                    "id": "412200702",
                    "speaker": "Player",
                    "text": "立本，别来无恙啊？"
                },
                {
                    "id": "412200703",
                    "speaker": "立本",
                    "text": "生活大起大落太多，已经习以为常了。小病不算病，小亏不算亏。"
                },
                {
                    "id": "412200704",
                    "speaker": "立本",
                    "text": "所以我觉得可以算是一种别来无恙吧，哈哈。"
                },
                {
                    "id": "412200705",
                    "speaker": "立本",
                    "text": "小友你呢？",
                    "choices": [
                        {
                            "id": "412200706",
                            "text": "还不错。",
                            "response": [
                                {
                                    "id": "412200707",
                                    "speaker": "立本",
                                    "text": "那可太好了。"
                                },
                                {
                                    "id": "412200710",
                                    "speaker": "立本",
                                    "text": "我今日可是十分开心，因为又和小友见面了。"
                                },
                                {
                                    "id": "412200711",
                                    "speaker": "Player",
                                    "text": "最近又有什么有趣见闻吗？"
                                },
                                {
                                    "id": "412200712",
                                    "speaker": "立本",
                                    "text": "你是不是觉得我该去纳塔寻觅新商机了，趁机打听打听？"
                                },
                                {
                                    "id": "412200713",
                                    "speaker": "立本",
                                    "text": "哈哈哈，这次倒是没想去纳塔。"
                                },
                                {
                                    "id": "412200714",
                                    "speaker": "立本",
                                    "text": "前些日子不小心掉进了一个大窟窿里，看了一晚上的星空。"
                                },
                                {
                                    "id": "412200715",
                                    "speaker": "Player",
                                    "text": "这可不叫「无恙」啊…"
                                },
                                {
                                    "id": "412200716",
                                    "speaker": "立本",
                                    "text": "总归是被路过的冒险家阿姐救出来了，也没饿着。这不就算无事发生吗？"
                                },
                                {
                                    "id": "412200717",
                                    "speaker": "立本",
                                    "text": "我晚上看着星星就在想，这天地之外还有什么东西呢？"
                                },
                                {
                                    "id": "412200718",
                                    "speaker": "Player",
                                    "text": "呃，无尽的远方和无限的世界吧。"
                                },
                                {
                                    "id": "412200719",
                                    "speaker": "立本",
                                    "text": "小友也是这么想的吗？"
                                },
                                {
                                    "id": "412200720",
                                    "speaker": "立本",
                                    "text": "我是觉得，万一每一个星星都是太阳，然后每一个太阳附近都有一个可以去的世界呢？"
                                },
                                {
                                    "id": "412200721",
                                    "speaker": "立本",
                                    "text": "或者干脆，每个星星都能去呢？毕竟只是发光而已，说不定并不热呢？",
                                    "choices": [
                                        {
                                            "id": "412200722",
                                            "text": "那里晚上发光，睡不了觉啊。",
                                            "response": [
                                                {
                                                    "id": "412200723",
                                                    "speaker": "立本",
                                                    "text": "那确实，观光去一下就行。这状态估计没有活人，怕是做不成生意了。"
                                                },
                                                {
                                                    "id": "412200726",
                                                    "speaker": "立本",
                                                    "text": "话说回来吧，咱们还是老样子？"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "412200724",
                                            "text": "是想拓展新商路吗？",
                                            "response": [
                                                {
                                                    "id": "412200725",
                                                    "speaker": "立本",
                                                    "text": "天上的国度也会用摩拉吗？不过那种地方全天都亮着，怕是没有活人会生活在那里吧？"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "412200708",
                            "text": "不太好。",
                            "response": [
                                {
                                    "id": "412200709",
                                    "speaker": "立本",
                                    "text": "是吗？"
                                },
                                {
                                    "id": "412200727",
                                    "speaker": "立本",
                                    "text": "好久不见啊，小友！"
                                },
                                {
                                    "id": "412200728",
                                    "speaker": "Player",
                                    "text": "立本！真是好久不见了！"
                                },
                                {
                                    "id": "412200729",
                                    "speaker": "立本",
                                    "text": "嘿嘿，还是小友热情…我没有变得更沧桑吧？",
                                    "choices": [
                                        {
                                            "id": "412200730",
                                            "text": "还是老样子。",
                                            "response": [
                                                {
                                                    "id": "412200732",
                                                    "speaker": "立本",
                                                    "text": "那就好，这回差点回不来了。"
                                                },
                                                {
                                                    "id": "412200733",
                                                    "speaker": "Player",
                                                    "text": "你去纳塔蹚过了吗？"
                                                },
                                                {
                                                    "id": "412200734",
                                                    "speaker": "立本",
                                                    "text": "没有啊，听说纳塔的局势很紧张，我特意避开，换了个地方，去了挪德卡莱。"
                                                },
                                                {
                                                    "id": "412200735",
                                                    "speaker": "立本",
                                                    "text": "小友你去过挪德卡莱吗？",
                                                    "choices": [
                                                        {
                                                            "id": "412200736",
                                                            "text": "还没去过。",
                                                            "response": [
                                                                {
                                                                    "id": "412200738",
                                                                    "speaker": "立本",
                                                                    "text": "哦？那我可以和你讲讲了。"
                                                                },
                                                                {
                                                                    "id": "412200739",
                                                                    "speaker": "立本",
                                                                    "text": "挪德卡莱在至冬的南端，那儿聚集了天南海北的人，不知道的还以为遍地都是发财的机会。"
                                                                },
                                                                {
                                                                    "id": "412200740",
                                                                    "speaker": "立本",
                                                                    "text": "但是去了才知道，那地方野得很，有一套自己的秩序。"
                                                                },
                                                                {
                                                                    "id": "412200741",
                                                                    "speaker": "Player",
                                                                    "text": "自己的秩序？"
                                                                },
                                                                {
                                                                    "id": "412200742",
                                                                    "speaker": "立本",
                                                                    "text": "这么说吧，我还没进城门，在路上就被一伙流民打劫了，欺负我人生地不熟啊。"
                                                                },
                                                                {
                                                                    "id": "412200743",
                                                                    "speaker": "立本",
                                                                    "text": "那儿也没有骑士团、审判庭之类的，有人让我去「伏尼契商会」看看。"
                                                                },
                                                                {
                                                                    "id": "412200744",
                                                                    "speaker": "立本",
                                                                    "text": "说是他们当地最大的势力，说不定能给我主持公道。"
                                                                },
                                                                {
                                                                    "id": "412200745",
                                                                    "speaker": "立本",
                                                                    "text": "我本来半信半疑着，没想到，商会的人麻溜地帮我把货找回来了，还全部收购了，真了不得啊。"
                                                                },
                                                                {
                                                                    "id": "412200746",
                                                                    "speaker": "立本",
                                                                    "text": "见到这么多摩拉，可把我高兴坏了，数了好几遍。"
                                                                },
                                                                {
                                                                    "id": "412200747",
                                                                    "speaker": "立本",
                                                                    "text": "生意做成了啊！太好了！"
                                                                },
                                                                {
                                                                    "id": "412200749",
                                                                    "speaker": "立本",
                                                                    "text": "别提啦，再次出了城门，我又遇到了一伙流民，把我兜里的摩拉全抢光了，一个子儿也没剩下。"
                                                                },
                                                                {
                                                                    "id": "412200750",
                                                                    "speaker": "Player",
                                                                    "text": "可能他们在城里就盯上你了…"
                                                                },
                                                                {
                                                                    "id": "412200751",
                                                                    "speaker": "立本",
                                                                    "text": "唉！大起大落是我立本的人生常态了，反正短时间内，我可不会再去啦。"
                                                                },
                                                                {
                                                                    "id": "412200752",
                                                                    "speaker": "立本",
                                                                    "text": "小友要是打算去挪德卡莱，千万要小心。兜里的摩拉要看好，别随便让人知道你揣着一大笔钱啊。",
                                                                    "choices": [
                                                                        {
                                                                            "id": "412200753",
                                                                            "text": "我会注意的。",
                                                                            "response": [
                                                                                {
                                                                                    "id": "412200755",
                                                                                    "speaker": "立本",
                                                                                    "text": "那这次，咱们还是老样子？"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "412200754",
                                                                            "text": "你也多小心啊。"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "412200737",
                                                            "text": "那是什么地方？"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "412200731",
                                            "text": "变得更亲切了。"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}