            "dialogues": [
                {
                    "id": "190950701",
                    "speaker": "琴",
                    "text": "虽然事情多到永远做不完，但有大家分忧，我一直都很安心。"
                }
            ]
        },
        {
            "id": "1909508",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "190950801",
                    "speaker": "丽莎",
                    "text": "凯亚还是一如既往地考虑周到啊。"
                }
            ]
        }
    ]
