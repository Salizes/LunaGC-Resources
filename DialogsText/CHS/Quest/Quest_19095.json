            "dialogues": [
                {
                    "id": "190950396",
                    "speaker": "Player",
                    "text": "后天去吧。"
                },
                {
                    "id": "190950397",
                    "speaker": "Player",
                    "text": "明天去吧。"
                }
            ]
        },
        {
            "id": "1909506",
