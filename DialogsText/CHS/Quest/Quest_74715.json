{
    "quest": {
        "id": "74715",
        "title": "水域打捞有原则？",
        "description": "菲米尼似乎有事找我们…",
        "rewards": [],
        "rewards_formatted": "",
        "chapter": {
            "icon": "",
            "id": "",
            "num": "",
            "title": ""
        },
        "total_dialogue_lines": 24,
        "total_speaker_counts": {
            "Player": 2,
            "派蒙": 7,
            "菲米尼": 15
        }
    },
    "talks": [
        {
            "id": "7471501",
            "objective": "与菲米尼对话",
            "dialogues": [
                {
                    "id": "747150101",
                    "speaker": "派蒙",
                    "text": "菲米尼，你怎么看起来那么疲惫？是这阵子打捞得太累了吗？"
                },
                {
                    "id": "747150102",
                    "speaker": "菲米尼",
                    "text": "唔…"
                },
                {
                    "id": "747150103",
                    "speaker": "派蒙",
                    "text": "也不要躲进潜水头盔里啦！我们都是好朋友，比起憋进心里，说出来会更好哦。"
                },
                {
                    "id": "747150104",
                    "speaker": "菲米尼",
                    "text": "…嗯，我知道了。"
                },
                {
                    "id": "747150105",
                    "speaker": "菲米尼",
                    "text": "刚才下水打捞的时候，我见到了一个有些讨厌的人。"
                },
                {
                    "id": "747150106",
                    "speaker": "派蒙",
                    "text": "讨厌的人？"
                },
                {
                    "id": "747150107",
                    "speaker": "菲米尼",
                    "text": "呃…要从哪里讲起呢。按照枫丹法规，对于沉入水下的货物，如果原主获得了保险赔款，它们就会变成自由财产。"
                },
                {
                    "id": "747150108",
                    "speaker": "菲米尼",
                    "text": "基于这种规则，有些人将潜水视为发财的手段。通过打捞别人遗失的东西，在上岸后卖出摩拉…"
                },
                {
                    "id": "747150109",
                    "speaker": "菲米尼",
                    "text": "这么做并没有太高门槛，导致潜水员中混入了不少…一心只想获得财富的人。"
                },
                {
                    "id": "747150110",
                    "speaker": "菲米尼",
                    "text": "有时候，他们会粗暴地赶走鱼群和膨膨兽，只因它们碍了自己的生意…我不接某些委托，也与这样的人有一点关系。"
                },
                {
                    "id": "747150111",
                    "speaker": "派蒙",
                    "text": "原来是这样…可以理解菲米尼的心情。"
                },
                {
                    "id": "747150112",
                    "speaker": "菲米尼",
                    "text": "刚才在水下，我又遇到了这样的情况。我鼓起勇气，制止了对方的行为。尽管最后还是…被骂了。"
                },
                {
                    "id": "747150113",
                    "speaker": "派蒙",
                    "text": "怎么这样…",
                    "choices": [
                        {
                            "id": "747150114",
                            "text": "你做得没错！",
                            "response": [
                                {
                                    "id": "747150116",
                                    "speaker": "菲米尼",
                                    "text": "#谢谢{NICKNAME}和派蒙的好意，不过…虽然对我来说很难也很累，但我还是想靠自己的努力，去改变些什么。"
                                },
                                {
                                    "id": "747150117",
                                    "speaker": "菲米尼",
                                    "text": "我喜欢在水下遨游的感觉，观察苍晶螺的纹路，感受海露花的呼吸…"
                                },
                                {
                                    "id": "747150118",
                                    "speaker": "菲米尼",
                                    "text": "当水下的世界认可你时，它会给你善意的回应。"
                                },
                                {
                                    "id": "747150119",
                                    "speaker": "菲米尼",
                                    "text": "我认为这才是我们应该选择的，与世界相处的方式，而不是一味自私地夺取。"
                                },
                                {
                                    "id": "747150120",
                                    "speaker": "派蒙",
                                    "text": "我觉得菲米尼说的这些也很好噢！你看，当你真的有什么想做的、想说的时候，表达出来其实更畅快吧！"
                                },
                                {
                                    "id": "747150121",
                                    "speaker": "菲米尼",
                                    "text": "唔…"
                                },
                                {
                                    "id": "747150122",
                                    "speaker": "派蒙",
                                    "text": "菲米尼？"
                                },
                                {
                                    "id": "747150123",
                                    "speaker": "菲米尼",
                                    "text": "抱歉…我有点害羞。总之…我、我会继续努力的。"
                                },
                                {
                                    "id": "747150124",
                                    "speaker": "菲米尼",
                                    "text": "差点忘了…这些是最新的水底勘测情报，请收下，它们应该能对你们派上用场。"
                                }
                            ]
                        },
                        {
                            "id": "747150115",
                            "text": "下次我们也可以替你出面！"
                        }
                    ]
                }
            ]
        }
    ]
}