    "talks": [
        {
            "id": "2201501",
            "objective": "与珊瑚对话",
            "dialogues": [
                {
                    "id": "220150801",
                    "speaker": "珊瑚",
                    "text": "看你的样子，是不是对侦探社还挺感兴趣的？",
                    "choices": [
                        {
                            "id": "220150802",
                            "text": "我也能做侦探吗？",
                            "response": [
                                {
                                    "id": "220150803",
                                    "speaker": "珊瑚",
                                    "text": "你想要做侦探？这可是件苦差事喔，不要被那些小说骗了啦。"
                                },
                                {
                                    "id": "220150804",
                                    "speaker": "珊瑚",
                                    "text": "侦探探案的时候，没有惊险刺激的追逐战，也没有生死一线的终极决断…"
                                },
                                {
                                    "id": "220150805",
                                    "speaker": "珊瑚",
                                    "text": "塞满整个屋子的卷宗，泥泞的山路和怎么都不露出马脚的嫌疑人…这才是侦探工作时的真实场景啦。"
                                },
                                {
                                    "id": "220150806",
                                    "speaker": "珊瑚",
                                    "text": "但这么说你应该也弄不清楚…我这里刚好有个小事件，不如你先亲身感受一下侦探的工作吧。"
                                },
                                {
                                    "id": "220150815",
                                    "speaker": "珊瑚",
                                    "text": "我那位叫做龙二的助手，不久前刚去外面搜集线索，到现在还没回来。"
                                },
                                {
                                    "id": "220150816",
                                    "speaker": "珊瑚",
                                    "text": "已经都这个时候了，他应该搜集到了足够的线索。"
                                },
                                {
                                    "id": "220150817",
                                    "speaker": "珊瑚",
                                    "text": "我想要请你走一趟，去把龙二给接回来。",
                                    "choices": [
                                        {
                                            "id": "220150818",
                                            "text": "不会是遇见什么危险了吧…",
                                            "response": [
                                                {
                                                    "id": "220150819",
                                                    "speaker": "珊瑚",
                                                    "text": "我已经把所有事都向他交代好了，就算是遇见了什么突发情况，以那家伙的身手应该也可以解决。"
                                                },
                                                {
                                                    "id": "220150820",
                                                    "speaker": "珊瑚",
                                                    "text": "我更在意的是，他能不能顺利找到我想要的东西。"
                                                },
                                                {
                                                    "id": "220150826",
                                                    "speaker": "珊瑚",
                                                    "text": "那么，这件事就拜托你咯，我会准备好报酬的，顺便…你也能亲身体验一下侦探的工作。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "220150821",
                                            "text": "不会是遇见什么意外了吧…",
                                            "response": [
                                                {
                                                    "id": "220150822",
                                                    "speaker": "珊瑚",
                                                    "text": "不会发生什么意外的，我已经把所有事都向他交代好了。"
                                                },
                                                {
                                                    "id": "220150823",
                                                    "speaker": "珊瑚",
                                                    "text": "就算是遇见了什么突发情况…"
                                                },
                                                {
                                                    "id": "220150824",
                                                    "speaker": "珊瑚",
                                                    "text": "以他的身手，应该也可以解决。"
                                                },
                                                {
                                                    "id": "220150825",
                                                    "speaker": "珊瑚",
                                                    "text": "我更在意的是，他能不能顺利找到我想要的东西。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "220150807",
                            "text": "感觉挺麻烦的…",
                            "response": [
                                {
                                    "id": "220150808",
                                    "speaker": "珊瑚",
                                    "text": "那当然啦。但侦探这个职业，就是专业的「麻烦处理人」。"
                                },
                                {
                                    "id": "220150809",
                                    "speaker": "珊瑚",
                                    "text": "什么惊险刺激的追逐战，生死一线的终极决断…都是小说里写来骗人的。"
                                },
                                {
                                    "id": "220150810",
                                    "speaker": "珊瑚",
                                    "text": "塞满整个屋子的卷宗，泥泞的山路和怎么都不露出马脚的嫌疑人…这才是侦探工作时的真实场景啦。"
                                },
                                {
                                    "id": "220150811",
                                    "speaker": "珊瑚",
                                    "text": "但那些小说里还是写对了一件事，那就是侦探总是有着各种各样的帮手。"
                                },
                                {
                                    "id": "220150812",
                                    "speaker": "Player",
                                    "text": "所以你也有帮手？"
                                },
                                {
                                    "id": "220150813",
                                    "speaker": "珊瑚",
                                    "text": "那是当然。我的那位帮手现在正在外面忙呢。而现在呢…我还需要另外一位帮手。"
                                },
                                {
                                    "id": "220150814",
                                    "speaker": "珊瑚",
                                    "text": "如果你愿意的话，能帮我这个忙吗？"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2201502",
            "objective": "与龙二会合",
            "dialogues": []
        },
        {
            "id": "2201503",
            "objective": "打倒所有盗宝团",
            "dialogues": [
                {
                    "id": "220150301",
                    "speaker": "天野",
                    "text": "珊瑚小姐，你刚才说的都是真的吗？"
                },
                {
                    "id": "220150302",
                    "speaker": "安藤",
                    "text": "城里的连环盗窃案，真的是那些混账盗宝团干的吗？"
                },
                {
                    "id": "220150303",
                    "speaker": "珊瑚",
                    "text": "那是当然。刚才我也给你看过那些证据了，凭二位的「职业直觉」…心里应该也已经有了判断吧。"
                },
                {
                    "id": "220150304",
                    "speaker": "安藤",
                    "text": "这群盗宝团…真是胆大包天！这是不把我们放在眼里吗！"
                },
                {
                    "id": "220150305",
                    "speaker": "安藤",
                    "text": "天野！我们快回去，把这件事往上报告吧。"
                },
                {
                    "id": "220150306",
                    "speaker": "安藤",
                    "text": "一定要再加强巡逻，不能给这群混账一点可乘之机！"
                },
                {
                    "id": "220150307",
                    "speaker": "天野",
                    "text": "珊瑚小姐，这些证据可以先借给我们一下吗？我们要用来说服大人们采取措施。"
                },
                {
                    "id": "220150308",
                    "speaker": "珊瑚",
                    "text": "没问题，尽管拿走吧。毕竟盗宝团作乱这种大事，可不是我们侦探社能够处理的，只能拜托奉行所的大人们了。"
                },
                {
                    "id": "220150309",
                    "speaker": "安藤",
                    "text": "放心吧！这群盗宝团…我们绝对一个都不放过！"
                },
                {
                    "id": "220150310",
                    "speaker": "珊瑚",
                    "text": "辛苦你们了。现在…应该已经准备得差不多了。",
                    "choices": [
                        {
                            "id": "220150311",
                            "text": "准备？",
                            "response": [
                                {
                                    "id": "220150312",
                                    "speaker": "珊瑚",
                                    "text": "是，这两位奉行所的同心大人，可是结掉我手里这个案子的重要「帮助」。"
                                },
                                {
                                    "id": "220150316",
                                    "speaker": "珊瑚",
                                    "text": "在这两位同心大人加强巡逻后，城里的盗宝团一定也会提起警惕。"
                                },
                                {
                                    "id": "220150317",
                                    "speaker": "珊瑚",
                                    "text": "龙二，在我让你去的那个地方，你应该和那些盗宝团交过手了，对吧？"
                                },
                                {
                                    "id": "220150318",
                                    "speaker": "龙二",
                                    "text": "是的，社长，那些盗宝团都被我和这位旅行者击退了。"
                                },
                                {
                                    "id": "220150319",
                                    "speaker": "珊瑚",
                                    "text": "嗯…这样就好，你们折腾出的动静应该已经够大了。"
                                },
                                {
                                    "id": "220150320",
                                    "speaker": "珊瑚",
                                    "text": "接下来我们要做的，就是再等一个机会了。"
                                },
                                {
                                    "id": "220150321",
                                    "speaker": "珊瑚",
                                    "text": "辛苦你了旅行者，这些是报酬，请收下吧。"
                                },
                                {
                                    "id": "220150322",
                                    "speaker": "Player",
                                    "text": "我好像也没帮什么忙…"
                                },
                                {
                                    "id": "220150323",
                                    "speaker": "珊瑚",
                                    "text": "可不能这么说。以外国人的身份吸引住安藤，让他带着天野追着你和龙二汇合…"
                                },
                                {
                                    "id": "220150324",
                                    "speaker": "珊瑚",
                                    "text": "然后，让他们亲眼发现盗宝团的威胁，然后顺理成章地在城里加强巡逻…"
                                },
                                {
                                    "id": "220150325",
                                    "speaker": "珊瑚",
                                    "text": "这些，可都是只有你才能做到的事。"
                                },
                                {
                                    "id": "220150326",
                                    "speaker": "珊瑚",
                                    "text": "毕竟，比起我去告诉他们，让这两位同心「亲自发现」盗宝团的事，效果才更好嘛。"
                                },
                                {
                                    "id": "220150327",
                                    "speaker": "珊瑚",
                                    "text": "总之，收下这些东西吧，说不定…我之后还会再找你帮忙的。"
                                }
                            ]
                        },
                        {
                            "id": "220150313",
                            "text": "你要做什么？",
                            "response": [
                                {
                                    "id": "220150314",
                                    "speaker": "珊瑚",
                                    "text": "我是侦探，要做的事，当然是要断案了。"
                                },
                                {
                                    "id": "220150315",
                                    "speaker": "珊瑚",
                                    "text": "这两位奉行所的同心大人，可是结掉我手里这个案子的重要「帮助」。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2201504",
            "objective": "与龙二对话",
            "dialogues": [
                {
                    "id": "220150205",
                    "speaker": "龙二",
                    "text": "原来如此，你就是社长说的「帮手」吗？"
                },
                {
                    "id": "220150206",
                    "speaker": "Player",
                    "text": "你知道我要来？"
                },
                {
                    "id": "220150207",
                    "speaker": "龙二",
                    "text": "唔…倒也不是。只是社长说，会有人来帮忙，"
                },
                {
                    "id": "220150208",
                    "speaker": "安藤",
                    "text": "喂，你们在做什么呢？"
                },
                {
                    "id": "220150209",
                    "speaker": "天野",
                    "text": "那些是盗宝团吗？为什么会离城里这么近…"
                },
                {
                    "id": "220150210",
                    "speaker": "安藤",
                    "text": "龙二，你怎么也在这，还有这个可疑的外国人…",
                    "choices": [
                        {
                            "id": "220150211",
                            "text": "你说我吗？",
                            "response": [
                                {
                                    "id": "220150212",
                                    "speaker": "安藤",
                                    "text": "对啊，这里的外国人也就你一个啊。"
                                },
                                {
                                    "id": "220150215",
                                    "speaker": "天野",
                                    "text": "好了，你也别太敏感了。龙二，你在这里做什么？"
                                },
                                {
                                    "id": "220150216",
                                    "speaker": "龙二",
                                    "text": "我只是根据社长的指示，跟踪可疑的人来到这里，但是却遇见了盗宝团。"
                                },
                                {
                                    "id": "220150217",
                                    "speaker": "龙二",
                                    "text": "这位旅行者确实是社长请来的帮手，刚才和我一起击退了那些盗宝团。"
                                },
                                {
                                    "id": "220150218",
                                    "speaker": "天野",
                                    "text": "这样吗…但是，这附近为什么会出现盗宝团？"
                                },
                                {
                                    "id": "220150219",
                                    "speaker": "安藤",
                                    "text": "龙二，你刚才还说什么，跟踪可疑的人…喂！难不成，你是从城里跟踪盗宝团过来的？"
                                },
                                {
                                    "id": "220150220",
                                    "speaker": "龙二",
                                    "text": "正是如此。社长之前正在处理一桩连续盗窃案，根据社长的推理，我在城里四处搜索。"
                                },
                                {
                                    "id": "220150221",
                                    "speaker": "龙二",
                                    "text": "随后，我在花见坂附近发现了可疑的人。但只是略微盘问了几句，他就慌张地离开了。"
                                },
                                {
                                    "id": "220150222",
                                    "speaker": "龙二",
                                    "text": "我追着他出了城，之后的事，你们都了解了。"
                                },
                                {
                                    "id": "220150223",
                                    "speaker": "安藤",
                                    "text": "喔…龙二，你小子怎么突然这么会说话了，之前你不是都不怎么说话的吗？"
                                },
                                {
                                    "id": "220150224",
                                    "speaker": "天野",
                                    "text": "跟着珊瑚做事，把口才也锻炼得不错了嘛。",
                                    "choices": [
                                        {
                                            "id": "220150225",
                                            "text": "你们是来做什么的？",
                                            "response": [
                                                {
                                                    "id": "220150226",
                                                    "speaker": "天野",
                                                    "text": "是安藤这家伙，说有个可疑的金发外国人在城里乱转，想要跟过来看看。"
                                                },
                                                {
                                                    "id": "220150227",
                                                    "speaker": "天野",
                                                    "text": "所以我俩才跟着你到了这里，没想到你居然是珊瑚的助手，误会了你，抱歉啦。"
                                                },
                                                {
                                                    "id": "220150232",
                                                    "speaker": "天野",
                                                    "text": "啊…不过龙二，你刚才说，你是在城内发现的那个可疑人士？"
                                                },
                                                {
                                                    "id": "220150233",
                                                    "speaker": "龙二",
                                                    "text": "正是如此。"
                                                },
                                                {
                                                    "id": "220150234",
                                                    "speaker": "安藤",
                                                    "text": "这群家伙居然还真的敢把手伸进城里来…"
                                                },
                                                {
                                                    "id": "220150235",
                                                    "speaker": "龙二",
                                                    "text": "正是如此。只凭我们…只凭我们…",
                                                    "choices": [
                                                        {
                                                            "id": "220150236",
                                                            "text": "（他怎么突然说话卡壳了…）",
                                                            "response": [
                                                                {
                                                                    "id": "220150238",
                                                                    "speaker": "龙二",
                                                                    "text": "喔…只凭我们，也只能赶走一两个盗宝团。想要彻底赶走盗宝团，还是得拜托你们。"
                                                                },
                                                                {
                                                                    "id": "220150239",
                                                                    "speaker": "龙二",
                                                                    "text": "二位…如果还想看看证据的话，可以去城里找社长，她会再详细地和二位解释。"
                                                                },
                                                                {
                                                                    "id": "220150240",
                                                                    "speaker": "安藤",
                                                                    "text": "是吗…天野，那我们就去找珊瑚吧，要是城里真的有盗宝团作乱，那可不能放着不管。"
                                                                },
                                                                {
                                                                    "id": "220150241",
                                                                    "speaker": "天野",
                                                                    "text": "喔…喔！那我们去找珊瑚了，龙二，你们也快点回去吧。"
                                                                },
                                                                {
                                                                    "id": "220150242",
                                                                    "speaker": "龙二",
                                                                    "text": "…呼。"
                                                                },
                                                                {
                                                                    "id": "220150243",
                                                                    "speaker": "龙二",
                                                                    "text": "我们回去吧。"
                                                                },
                                                                {
                                                                    "id": "220150244",
                                                                    "speaker": "Player",
                                                                    "text": "你刚才说的那些话…"
                                                                },
                                                                {
                                                                    "id": "220150245",
                                                                    "speaker": "龙二",
                                                                    "text": "是社长的交代。"
                                                                },
                                                                {
                                                                    "id": "220150246",
                                                                    "speaker": "龙二",
                                                                    "text": "事情已经办好了，我们回去吧。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "220150237",
                                                            "text": "（他怎么像是忘词了一样…）"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "220150228",
                                            "text": "你们也是追着可疑人士来的？",
                                            "response": [
                                                {
                                                    "id": "220150229",
                                                    "speaker": "天野",
                                                    "text": "这么说也没错，但我俩追着的可疑人士其实是你，咳…"
                                                },
                                                {
                                                    "id": "220150230",
                                                    "speaker": "天野",
                                                    "text": "是安藤这家伙，说有个可疑的金发外国人在城里乱转，想要跟过来看看。"
                                                },
                                                {
                                                    "id": "220150231",
                                                    "speaker": "天野",
                                                    "text": "所以我俩才跟着你到了这里，没想到你居然是珊瑚的助手，误会了你，抱歉啦。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "220150213",
                            "text": "我是珊瑚的帮手。",
                            "response": [
                                {
                                    "id": "220150214",
                                    "speaker": "安藤",
                                    "text": "珊瑚的帮手？听起来反倒更可疑了…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2201505",
            "objective": "与珊瑚对话",
            "dialogues": []
        },
        {
            "id": "2201501",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "220150101",
                    "speaker": "珊瑚",
                    "text": "差不多要到时候了…"
                },
                {
                    "id": "220150102",
                    "speaker": "珊瑚",
                    "text": "哦呀，欢迎光临，阁下是遇见什么难题了吗？"
                },
                {
                    "id": "220150103",
                    "speaker": "珊瑚",
                    "text": "唔，原来如此，你…没遇见什么难题，只是想要「随便逛逛」而已…"
                },
                {
                    "id": "220150104",
                    "speaker": "珊瑚",
                    "text": "这里是「万端珊瑚侦探社」，是一个很寻常的地方，而我嘛…是一个侦探。",
                    "choices": [
                        {
                            "id": "220150105",
                            "text": "你是？",
                            "response": [
                                {
                                    "id": "220150106",
                                    "speaker": "珊瑚",
                                    "text": "我叫珊瑚，是这家侦探社的社长。"
                                },
                                {
                                    "id": "220150107",
                                    "speaker": "珊瑚",
                                    "text": "不过，虽然说是社长，但这家侦探社也只有两个员工罢了。"
                                },
                                {
                                    "id": "220150113",
                                    "speaker": "珊瑚",
                                    "text": "怎么，你是第一次看见这种侦探社吗？"
                                }
                            ]
                        },
                        {
                            "id": "220150108",
                            "text": "侦探是什么？",
                            "response": [
                                {
                                    "id": "220150109",
                                    "speaker": "珊瑚",
                                    "text": "喔，这是个好问题。从一般人的视角来看，侦探这种职业也许特殊又神秘。"
                                },
                                {
                                    "id": "220150110",
                                    "speaker": "珊瑚",
                                    "text": "但要我来说，侦探也只是一种「拿钱办事」的普通职业罢了。"
                                },
                                {
                                    "id": "220150111",
                                    "speaker": "珊瑚",
                                    "text": "虽然办的事有时候会不太寻常，委托人偶尔也有些特别…"
                                },
                                {
                                    "id": "220150112",
                                    "speaker": "珊瑚",
                                    "text": "但无论如何，都脱不开「拿钱办事」这个行事主旨就是了。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2201505",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "220150501",
                    "speaker": "Player",
                    "text": "没有在蒙德看见过。"
                },
                {
                    "id": "220150502",
                    "speaker": "珊瑚",
                    "text": "蒙德…哦，你是说蒙德城吧，我倒是对那座城市有所耳闻。"
                },
                {
                    "id": "220150503",
                    "speaker": "珊瑚",
                    "text": "蒙德最著名的两种特产，一种是酒，另一种是「自由」，对吧？"
                },
                {
                    "id": "220150504",
                    "speaker": "珊瑚",
                    "text": "哈哈哈，这两种特产还真是相辅相成…是蒙德城里有侦探的话，肯定天天都会生意兴隆的。"
                }
            ]
        },
        {
            "id": "2201506",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "220150601",
                    "speaker": "Player",
                    "text": "没有在璃月看见过。"
                },
                {
                    "id": "220150602",
                    "speaker": "珊瑚",
                    "text": "璃月也不太需要侦探啦。那边对「契约」的重视程度我也听说过一些。"
                },
                {
                    "id": "220150603",
                    "speaker": "珊瑚",
                    "text": "而且，他们还有无论大事小情都会迅速到场解决的「千岩军」…"
                },
                {
                    "id": "220150604",
                    "speaker": "珊瑚",
                    "text": "就算那边有侦探社，估计也会因为生意太少而迅速倒闭啦。"
                }
            ]
        },
        {
            "id": "2201507",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "220150701",
                    "speaker": "Player",
                    "text": "我只遇见过一位「律法咨询师」…"
                },
                {
                    "id": "220150702",
                    "speaker": "珊瑚",
                    "text": "「律法咨询师」？啊…我听说过，这种人…最难缠了。"
                },
                {
                    "id": "220150703",
                    "speaker": "珊瑚",
                    "text": "我想，这种人最擅长的事应该就是把简单的问题复杂化，把复杂的问题公式化，再把公式化的问题契约化。"
                },
                {
                    "id": "220150704",
                    "speaker": "珊瑚",
                    "text": "如果可以的话，我希望我永远不要遇见这种人。"
                }
            ]
        },
        {
            "id": "2201509",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "220150901",
                    "speaker": "珊瑚",
                    "text": "那么，这件事就拜托你咯，我会准备好报酬的，顺便…你也能亲身体验一下侦探的工作。",
                    "choices": [
                        {
                            "id": "220150902",
                            "text": "你不担心你的助手吗？",
                            "response": [
                                {
                                    "id": "220150903",
                                    "speaker": "珊瑚",
                                    "text": "那家伙身手很好，不用担心。"
                                },
                                {
                                    "id": "220150904",
                                    "speaker": "珊瑚",
                                    "text": "怎么说，他也是曾经在奉行所里做过同心的人。"
                                }
                            ]
                        },
                        {
                            "id": "220150905",
                            "text": "你怎么不和你助手一起去？",
                            "response": [
                                {
                                    "id": "220150906",
                                    "speaker": "珊瑚",
                                    "text": "唔，怎么说呢…我们俩各有分工。"
                                },
                                {
                                    "id": "220150907",
                                    "speaker": "珊瑚",
                                    "text": "他负责搜集证据和线索，而我则负责分析归纳，找出真相。"
                                },
                                {
                                    "id": "220150908",
                                    "speaker": "珊瑚",
                                    "text": "一个合理的工作模式，是一家侦探社良好运转的基础嘛。"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}