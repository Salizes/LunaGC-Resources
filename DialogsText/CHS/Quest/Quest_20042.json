        }
    },
    "talks": [
        {
            "id": "2004201",
            "objective": "与维多利亚对话",
            "dialogues": [
                {
                    "id": "200420201",
                    "speaker": "Player",
                    "text": "我知道了。"
                },
                {
                    "id": "200420202",
                    "speaker": "维多利亚",
                    "text": "风神保佑您。"
                }
            ]
        },
        {
            "id": "2004202",
            "objective": "在教堂附近找到艾伯特",
            "dialogues": [
                {
                    "id": "200421101",
                    "speaker": "Player",
                    "text": "好吧…"
                },
                {
                    "id": "200421102",
                    "speaker": "艾伯特",
                    "text": "那就拜托你了，冲吧！"
                }
            ]
        },
        {
            "id": "2004203",
            "objective": "清扫落叶堆",
            "dialogues": [
                {
                    "id": "200420301",
                    "speaker": "Player",
                    "text": "要直接找西风骑士团吗？"
                },
                {
                    "id": "200420302",
                    "speaker": "维多利亚",
                    "text": "我也想过这样做。"
                },
                {
                    "id": "200420303",
                    "speaker": "维多利亚",
                    "text": "但我没有他什么直接的把柄，西风骑士团也介入不了…"
                },
                {
                    "id": "200420304",
                    "speaker": "维多利亚",
                    "text": "风神在上，请你快点去把他赶走吧。"
                }
            ]
        },
        {
            "id": "2004204",
            "objective": "与艾伯特对话",
            "dialogues": [
                {
                    "id": "200420601",
                    "speaker": "艾伯特",
                    "text": "落叶都扫除掉了吗？"
                },
                {
                    "id": "200420602",
                    "speaker": "Player",
                    "text": "全部扫除了。"
                },
                {
                    "id": "200420603",
                    "speaker": "艾伯特",
                    "text": "辛苦了，教堂一下子就干净了很多，这样子芭芭拉小姐也会轻松不少吧…"
                },
                {
                    "id": "200420604",
                    "speaker": "艾伯特",
                    "text": "对了，你可别告诉芭芭拉小姐啊。"
                },
                {
                    "id": "200420605",
                    "speaker": "艾伯特",
                    "text": "本来我是想帮她分忧的，可别反而让她困扰了。"
                },
                {
                    "id": "200420606",
                    "speaker": "艾伯特",
                    "text": "放心啦，按照我们说好的，我现在就离开。"
                },
                {
                    "id": "200420607",
                    "speaker": "艾伯特",
                    "text": "再见了…不对，我们下次再见。"
                }
            ]
        },
        {
            "id": "2004205",
            "objective": "到教堂内向维多利亚报告",
            "dialogues": [
                {
                    "id": "200420701",
                    "speaker": "维多利亚",
                    "text": "关于艾伯特先生…"
                },
                {
                    "id": "200420702",
                    "speaker": "维多利亚",
                    "text": "艾伯特离开了吗？"
                },
                {
                    "id": "200420703",
                    "speaker": "Player",
                    "text": "已经走了。"
                },
                {
                    "id": "200420704",
                    "speaker": "维多利亚",
                    "text": "总算解决了…你刚才为什么去清除落叶了？"
                },
                {
                    "id": "200420705",
                    "speaker": "维多利亚",
                    "text": "算了，这样也好，免得那个艾伯特又找到了借口，借着清除落叶来接近教堂。"
                },
                {
                    "id": "200420706",
                    "speaker": "维多利亚",
                    "text": "这些是给你的谢礼，收下吧，愿风神保佑你。"
                },
                {
                    "id": "200420707",
                    "speaker": "维多利亚",
                    "text": "没什么事的话，我要继续工作了，你也去忙自己的吧。"
                }
            ]
        },
        {
            "id": "2004201",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "200420101",
                    "speaker": "维多利亚",
                    "text": "…真是麻烦，到底躲哪去了？"
                },
                {
                    "id": "200420102",
                    "speaker": "Player",
                    "text": "你在找什么？"
                },
                {
                    "id": "200420103",
                    "speaker": "维多利亚",
                    "text": "找？哦…我正在找一个可疑的家伙。"
                },
                {
                    "id": "200420104",
                    "speaker": "维多利亚",
                    "text": "那个叫艾伯特的男人，白天一直鬼鬼祟祟地在教堂边上打转。"
                },
                {
                    "id": "200420105",
                    "speaker": "维多利亚",
                    "text": "看着就不怀好意，我担心他在预谋什么可怕的事。"
                },
                {
                    "id": "200420106",
                    "speaker": "维多利亚",
                    "text": "你能去把艾伯特赶走吗？"
                }
            ]
        },
        {
            "id": "2004204",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "200420401",
                    "speaker": "艾伯特",
                    "text": "芭芭拉冲呀！"
                },
                {
                    "id": "200420402",
                    "speaker": "艾伯特",
                    "text": "咳，你找我有事情吗？"
                }
            ]
        },
        {
            "id": "2004205",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "200420501",
                    "speaker": "艾伯特",
                    "text": "为了蒙德城，和芭芭拉小姐，要认真打扫落叶！"
                }
            ]
        },
        {
            "id": "2004208",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "200420801",
                    "speaker": "Player",
                    "text": "修女请你马上离开这里。"
                },
                {
                    "id": "200420802",
                    "speaker": "艾伯特",
                    "text": "离开…我做了什么吗？"
                }
            ]
        },
        {
            "id": "2004209",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "200420901",
                    "speaker": "Player",
                    "text": "你做的事情，我已经通知西风骑士团了。"
                },
                {
                    "id": "200420902",
                    "speaker": "艾伯特",
                    "text": "喂，我做了什么事啊！？"
                }
            ]
        },
        {
            "id": "2004210",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "200421001",
                    "speaker": "艾伯特",
                    "text": "什么？鬼鬼祟祟、不怀好意、不良预谋…你们完全误会我了…"
                },
                {
                    "id": "200421002",
                    "speaker": "艾伯特",
                    "text": "呼…你知道芭芭拉小姐吗？就是那位蒙德城的天使。"
                },
                {
                    "id": "200421003",
                    "speaker": "艾伯特",
                    "text": "很多蒙德人都尊敬着她，我也是其中的一员。"
                },
                {
                    "id": "200421004",
                    "speaker": "艾伯特",
                    "text": "蒙德城的芭芭拉粉丝团，我就是团长。"
                },
                {
                    "id": "200421005",
                    "speaker": "Player",
                    "text": "西风骑士马上就到。"
                },
                {
                    "id": "200421006",
                    "speaker": "艾伯特",
                    "text": "你听我把话说完啊！因为很尊敬芭芭拉小姐，我也想和芭芭拉小姐一样，为这座蒙德城做点贡献。"
                },
                {
                    "id": "200421007",
                    "speaker": "艾伯特",
                    "text": "我是个普通人，只能做一些力所能及的事。比如为教堂做清洁…"
                },
                {
                    "id": "200421008",
                    "speaker": "艾伯特",
                    "text": "但每次维多利亚修女都不听我解释，直接把我赶走了…"
                },
                {
                    "id": "200421009",
                    "speaker": "艾伯特",
                    "text": "我最近发现，教堂周围的枯叶很久没扫了，但维多利亚修女肯定不会让我解决。"
                },
                {
                    "id": "200421010",
                    "speaker": "艾伯特",
                    "text": "为了蒙德城和芭芭拉小姐，你们愿意帮我扫走那些落叶吗？"
                }
            ]
        },
        {
            "id": "2004212",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "200421201",
                    "speaker": "Player",
                    "text": "为了让你赶紧离开…"
                },
                {
                    "id": "200421202",
                    "speaker": "艾伯特",
                    "text": "喂，都说了我做的不是坏事啊！"
                },
                {
                    "id": "200421203",
                    "speaker": "艾伯特",
                    "text": "好了，等落叶打扫完之后，我就会离开了。"
                }
            ]
        },
        {
            "id": "2004213",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "200421301",
                    "speaker": "Player",
                    "text": "西风骑士团会来打扫一切的。"
                },
                {
                    "id": "200421302",
                    "speaker": "艾伯特",
                    "text": "这是在做好事！别动不动通知骑士团啊！"
                },
                {
                    "id": "200421303",
                    "speaker": "艾伯特",
                    "text": "怕了你了，好啦好啦我知道了，打扫完落叶之后我就会走了…"
                }
            ]
        }
    ]
}