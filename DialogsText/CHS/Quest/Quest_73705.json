    },
    "talks": [
        {
            "id": "7370501",
            "objective": "与柯莱对话",
            "dialogues": [
                {
                    "id": "737050101",
                    "speaker": "柯莱",
                    "text": "#{NICKNAME}和派蒙！这边这边！"
                },
                {
                    "id": "737050102",
                    "speaker": "柯莱",
                    "text": "欢迎来到「稳健知行」机构的主场！"
                },
                {
                    "id": "737050103",
                    "speaker": "柯莱",
                    "text": "请看，几个核心项目的设施已经搭建好了，大家随时都可以投入工作——"
                },
                {
                    "id": "737050104",
                    "speaker": "派蒙",
                    "text": "喔！这种氛围，好像轻小说里提过的…「年轻冒险家们的第一个据点」？"
                },
                {
                    "id": "737050105",
                    "speaker": "派蒙",
                    "text": "唔…又有点学园庆典的感觉，大家聚在一起，仔细研究课题后，组队出发历练自己…让人跃跃欲试！",
                    "choices": [
                        {
                            "id": "737050106",
                            "text": "没错没错，充满干劲！",
                            "response": [
                                {
                                    "id": "737050108",
                                    "speaker": "柯莱",
                                    "text": "虽然这个场地不像学园庆典那样豪华，但按提纳里师父的说法，教令院会给我们调配「最有效能」的资源。"
                                },
                                {
                                    "id": "737050109",
                                    "speaker": "柯莱",
                                    "text": "学生和学者们前往危险地带之前，会来我们这里仔细咨询，甚至接受一番紧急训练…"
                                },
                                {
                                    "id": "737050110",
                                    "speaker": "柯莱",
                                    "text": "如果有必要的话，我们会派遣专人加入他们的队伍，充当可靠的向导和安全员。"
                                },
                                {
                                    "id": "737050111",
                                    "speaker": "安柏",
                                    "text": "按照时下流行的叫法，这里是一半训练，一半实战的「前进基地」哦。"
                                },
                                {
                                    "id": "737050112",
                                    "speaker": "安柏",
                                    "text": "让新兵们意识到自己即将面对的挑战，好好锻炼一下拳脚，再踏入未知的领域，才不会手忙脚乱！"
                                },
                                {
                                    "id": "737050113",
                                    "speaker": "派蒙",
                                    "text": "安柏？居然是你！",
                                    "choices": [
                                        {
                                            "id": "737050114",
                                            "text": "侦察骑士的工作范围拓展了？",
                                            "response": [
                                                {
                                                    "id": "737050116",
                                                    "speaker": "安柏",
                                                    "text": "嘿嘿，惊喜吧？我也觉得意外！"
                                                },
                                                {
                                                    "id": "737050117",
                                                    "speaker": "安柏",
                                                    "text": "本来啊，我只是趁着轮岗的空闲期，来须弥看望柯莱…"
                                                },
                                                {
                                                    "id": "737050118",
                                                    "speaker": "安柏",
                                                    "text": "没想到柯莱倒是忙了起来，那我可不能坐在一边呆呆看着，就来扮演柯莱的副手好了！"
                                                },
                                                {
                                                    "id": "737050119",
                                                    "speaker": "柯莱",
                                                    "text": "不好意思，安柏，没能让你好好休假…"
                                                },
                                                {
                                                    "id": "737050120",
                                                    "speaker": "安柏",
                                                    "text": "没这回事啦，充实和松弛对半分的假期也非常不错嘛！这份临时工让我开了不少眼界哦。"
                                                },
                                                {
                                                    "id": "737050121",
                                                    "speaker": "安柏",
                                                    "text": "#而且，正是因为来帮你的忙，我才能在意想不到的地方遇上{NICKNAME}和派蒙，更值得庆祝了！"
                                                },
                                                {
                                                    "id": "737050122",
                                                    "speaker": "安柏",
                                                    "text": "等到这边的工作差不多稳定下来，我们一起去吃顿大餐，好好庆祝下吧？"
                                                },
                                                {
                                                    "id": "737050123",
                                                    "speaker": "派蒙",
                                                    "text": "好哦！在须弥和我们冒险最初认识的伙伴碰头，一起聚餐，肯定会像…"
                                                },
                                                {
                                                    "id": "737050124",
                                                    "speaker": "派蒙",
                                                    "text": "大份的蜜酱胡萝卜煎肉一样开心！",
                                                    "choices": [
                                                        {
                                                            "id": "737050125",
                                                            "text": "那我们早些开工，早点收工！",
                                                            "response": [
                                                                {
                                                                    "id": "737050127",
                                                                    "speaker": "安柏",
                                                                    "text": "好呀！我们言归正传——"
                                                                },
                                                                {
                                                                    "id": "737050128",
                                                                    "speaker": "安柏",
                                                                    "text": "柯莱和我负责的项目是「高速侦察伙伴」，旨在运用机关技术，快速通过危险地带，勘测地形与魔物的详情。"
                                                                },
                                                                {
                                                                    "id": "737050129",
                                                                    "speaker": "柯莱",
                                                                    "text": "根据生论派的研究，在危险的环境中，可爱乖巧的伙伴能让冒险者的心神安定，避免过度紧张…"
                                                                },
                                                                {
                                                                    "id": "737050130",
                                                                    "speaker": "安柏",
                                                                    "text": "所以我们参考柯里安巴和兔兔伯爵的形象，制作了侦察机关「翠星柯里安巴」和「赤红飞兔伯爵」，反馈还不错！"
                                                                },
                                                                {
                                                                    "id": "737050131",
                                                                    "speaker": "柯莱",
                                                                    "text": "收集了充足的信息后，教令院还会对侦察伙伴进行修改，推出各种不同外形的款式。"
                                                                },
                                                                {
                                                                    "id": "737050132",
                                                                    "speaker": "派蒙",
                                                                    "text": "柯里安巴和兔兔伯爵快速冲刺…会是什么样的画面呢？",
                                                                    "choices": [
                                                                        {
                                                                            "id": "737050133",
                                                                            "text": "很对！两位是让人安心的伙伴！",
                                                                            "response": [
                                                                                {
                                                                                    "id": "737050135",
                                                                                    "speaker": "柯莱",
                                                                                    "text": "#由{NICKNAME}来指引两位侦察伙伴行动，肯定能获得非常独特的数据。"
                                                                                },
                                                                                {
                                                                                    "id": "737050136",
                                                                                    "speaker": "柯莱",
                                                                                    "text": "等你们了解整个「稳健知行」机构后，就可以来尝试一番。"
                                                                                },
                                                                                {
                                                                                    "id": "737050137",
                                                                                    "speaker": "柯莱",
                                                                                    "text": "接下来，请跟着我去和其他几位顾问见个面。"
                                                                                },
                                                                                {
                                                                                    "id": "737050138",
                                                                                    "speaker": "安柏",
                                                                                    "text": "那位青色头发的姐姐也有一名很可爱的伙伴机关哦！"
                                                                                },
                                                                                {
                                                                                    "id": "737050139",
                                                                                    "speaker": "安柏",
                                                                                    "text": "不过，用途和我们的「柯里安巴兔兔伯爵组合」不同呢。"
                                                                                },
                                                                                {
                                                                                    "id": "737050140",
                                                                                    "speaker": "安柏",
                                                                                    "text": "我很期待她们的表现！"
                                                                                },
                                                                                {
                                                                                    "id": "737050141",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "第二个项目…也是熟悉的面孔，太好了！"
                                                                                },
                                                                                {
                                                                                    "id": "737050142",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "我们这就去和老朋友打个招呼吧？"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "737050134",
                                                                            "text": "一时间还无法想象那种情景…"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "737050126",
                                                            "text": "为了开心地聚餐，先认真干活！"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "737050115",
                                            "text": "柯莱招兵买马的范围这么广？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "737050107",
                            "text": "容我先看看派蒙喜欢的轻小说…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7370502",
            "objective": "与珐露珊对话",
            "dialogues": [
                {
                    "id": "737050201",
                    "speaker": "珐露珊",
                    "text": "…人气真的有那么高吗？"
                },
                {
                    "id": "737050202",
                    "speaker": "珐露珊",
                    "text": "内藏行走机构的方法还算巧妙，地形识别、远程控制和重量感应的模块也处理得不错。"
                },
                {
                    "id": "737050203",
                    "speaker": "珐露珊",
                    "text": "但外观上，怎么看都只是普通的布偶，要不然，还是改改吧…"
                },
                {
                    "id": "737050204",
                    "speaker": "柯莱",
                    "text": "珐露珊前辈，我来告诉您一条好消息——"
                },
                {
                    "id": "737050205",
                    "speaker": "柯莱",
                    "text": "#{NICKNAME}和派蒙加入了我们，「稳健知行」机构的队伍变得更厉害了！"
                },
                {
                    "id": "737050206",
                    "speaker": "派蒙",
                    "text": "嘿嘿，珐露珊前辈好！我们来帮忙啦！"
                },
                {
                    "id": "737050207",
                    "speaker": "珐露珊",
                    "text": "啊呀呀，这可不得了啊…"
                },
                {
                    "id": "737050208",
                    "speaker": "珐露珊",
                    "text": "真不错，柯莱！居然请来了两位业内公认的顶尖专家，那不管我给出什么评测，协会都要乖乖点头咯！"
                },
                {
                    "id": "737050209",
                    "speaker": "珐露珊",
                    "text": "正好，你们看看这个「解谜伙伴」，感觉怎么样？"
                },
                {
                    "id": "737050210",
                    "speaker": "派蒙",
                    "text": "喔…居然直接用了珐露珊的形象？",
                    "choices": [
                        {
                            "id": "737050211",
                            "text": "感觉舒适又惬意。",
                            "response": [
                                {
                                    "id": "737050213",
                                    "speaker": "珐露珊",
                                    "text": "这就要问学院的后辈们，还有解谜协会和遗迹机关研讨会的成员了。"
                                },
                                {
                                    "id": "737050214",
                                    "speaker": "珐露珊",
                                    "text": "他们通力合作的产物，明明有着相当高的技术含量，却要用孩子气的外表来包装。"
                                },
                                {
                                    "id": "737050215",
                                    "speaker": "珐露珊",
                                    "text": "尤其是后辈里的阿尼斯，一个劲地解说采用这个外观的优势，比她给课题答辩时还拼命…"
                                },
                                {
                                    "id": "737050245",
                                    "speaker": "珐露珊",
                                    "text": "当下的年轻人啊，是不是太过沉迷于可爱的东西了？"
                                },
                                {
                                    "id": "737050216",
                                    "speaker": "派蒙",
                                    "text": "我可以说嘛？感觉这样还挺不错的！"
                                },
                                {
                                    "id": "737050217",
                                    "speaker": "派蒙",
                                    "text": "柯莱和安柏刚刚还解释过，可爱的伙伴能让冒险家避免过度紧张，安安心心。"
                                },
                                {
                                    "id": "737050218",
                                    "speaker": "派蒙",
                                    "text": "如果和珐露珊前辈的布偶一起冒险，哪怕是走进了到处黑咕隆咚的遗迹，应该也不会紧张吧…"
                                },
                                {
                                    "id": "737050219",
                                    "speaker": "珐露珊",
                                    "text": "这种考虑确实有道理，后辈们选定这个外形，也算是对我的某种尊重吧…咳。"
                                },
                                {
                                    "id": "737050220",
                                    "speaker": "珐露珊",
                                    "text": "不过，也有相当多的冒险者，更重视机关的可靠性和技术水平。"
                                },
                                {
                                    "id": "737050221",
                                    "speaker": "珐露珊",
                                    "text": "他们大概会认为，「机关就应该表现得坚硬，要能承受落石轰击，要表现出尖端的科技水平」。"
                                },
                                {
                                    "id": "737050222",
                                    "speaker": "珐露珊",
                                    "text": "这个「解谜伙伴」的外形太蓬松柔软，反而不会给人…厉害和可靠的印象，说不定还有可能让人分心。"
                                },
                                {
                                    "id": "737050223",
                                    "speaker": "珐露珊",
                                    "text": "如果换成磨砂金属的厚重外壳，方方正正，并且适当展现复杂的机件，视觉上的鼓舞作用会更强。"
                                },
                                {
                                    "id": "737050224",
                                    "speaker": "珐露珊",
                                    "text": "哪怕是我，也有过因为外貌年轻而被人质疑的时候。假如我一头白发，他们大概就不会说闲话了。"
                                },
                                {
                                    "id": "737050225",
                                    "speaker": "派蒙",
                                    "text": "真，真的吗，那我岂不是能让那些人信服？"
                                },
                                {
                                    "id": "737050226",
                                    "speaker": "珐露珊",
                                    "text": "啊？这…呃…这可不能混为一谈！"
                                },
                                {
                                    "id": "737050227",
                                    "speaker": "柯莱",
                                    "text": "没想到珐露珊前辈…在这方面意外地严格呢！",
                                    "choices": [
                                        {
                                            "id": "737050228",
                                            "text": "我觉得现在的外形还不错喔。",
                                            "response": [
                                                {
                                                    "id": "737050230",
                                                    "speaker": "珐露珊",
                                                    "text": "#欸？连{NICKNAME}也支持？"
                                                },
                                                {
                                                    "id": "737050231",
                                                    "speaker": "珐露珊",
                                                    "text": "呃咳咳…唔…"
                                                },
                                                {
                                                    "id": "737050232",
                                                    "speaker": "珐露珊",
                                                    "text": "#好吧！既然{NICKNAME}都这么说了…"
                                                },
                                                {
                                                    "id": "737050233",
                                                    "speaker": "珐露珊",
                                                    "text": "#我提议，之后就由{NICKNAME}来操纵「解谜伙伴」，尝试破开几个谜题典例。"
                                                },
                                                {
                                                    "id": "737050234",
                                                    "speaker": "珐露珊",
                                                    "text": "#我会好好评估{NICKNAME}运用这种机关的效率，然后根据你的表现，制作它的使用规范手册…"
                                                },
                                                {
                                                    "id": "737050235",
                                                    "speaker": "珐露珊",
                                                    "text": "至于外形的改进，还需要长期观察，我就暂时搁置迭代的建议好了。",
                                                    "choices": [
                                                        {
                                                            "id": "737050236",
                                                            "text": "好耶！待会儿我一定好好表现！",
                                                            "response": [
                                                                {
                                                                    "id": "737050238",
                                                                    "speaker": "珐露珊",
                                                                    "text": "等到你们准备停当，就来找我吧。我已经选中了最适合的几个秘境，随时可以开始解谜。"
                                                                },
                                                                {
                                                                    "id": "737050239",
                                                                    "speaker": "柯莱",
                                                                    "text": "#辛苦珐露珊前辈了，还请您稍等，接下来，我带{NICKNAME}和派蒙去看看最后一个项目…"
                                                                },
                                                                {
                                                                    "id": "737050240",
                                                                    "speaker": "珐露珊",
                                                                    "text": "哪里哪里，柯莱才是费神费力了，注意别累着自己哦。"
                                                                },
                                                                {
                                                                    "id": "737050241",
                                                                    "speaker": "珐露珊",
                                                                    "text": "#闲下来了，就叫上{NICKNAME}和派蒙来前辈这里坐一坐，歇一歇，吃些古法点心，慢慢聊聊天。"
                                                                },
                                                                {
                                                                    "id": "737050242",
                                                                    "speaker": "派蒙",
                                                                    "text": "古法点心！我我我，我一定会来的！"
                                                                },
                                                                {
                                                                    "id": "737050243",
                                                                    "speaker": "柯莱",
                                                                    "text": "谢谢前辈，我也要带几盒上好的花茶来给您！"
                                                                },
                                                                {
                                                                    "id": "737050244",
                                                                    "speaker": "珐露珊",
                                                                    "text": "去吧去吧，好好表现！"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "737050237",
                                                            "text": "我会让解谜机关发挥最佳性能！"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "737050229",
                                            "text": "方方正正的外形下次再说吧？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "737050212",
                            "text": "完全看不出是探险装备。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7370503",
            "objective": "前往下个项目",
            "dialogues": [
                {
                    "id": "737050301",
                    "speaker": "柯莱",
                    "text": "接下来就是最后的项目了——为了长久发展而建立的「安全分队」。"
                },
                {
                    "id": "737050302",
                    "speaker": "柯莱",
                    "text": "多亏大风纪官赛诺先生从中沟通，「稳健知行」机构请到了迪希雅和坎蒂丝小姐，分别担任教官与协调员。"
                },
                {
                    "id": "737050303",
                    "speaker": "柯莱",
                    "text": "她们两位正在筹备战斗考核的事宜，应该也快回来了…"
                },
                {
                    "id": "737050304",
                    "speaker": "迪希雅",
                    "text": "哟，在找我们？看来我们出现得正是时候？"
                },
                {
                    "id": "737050305",
                    "speaker": "迪希雅",
                    "text": "#{NICKNAME}和派蒙也要入伙吗？那事情就变得轻松愉快了！"
                },
                {
                    "id": "737050306",
                    "speaker": "坎蒂丝",
                    "text": "久等了，几位，我们带回了合适的情报。"
                },
                {
                    "id": "737050307",
                    "speaker": "派蒙",
                    "text": "收集情报？这么正经？",
                    "choices": [
                        {
                            "id": "737050308",
                            "text": "听起来像是大战前的准备…",
                            "response": [
                                {
                                    "id": "737050310",
                                    "speaker": "迪希雅",
                                    "text": "那可不，毕竟是关乎普通学生安全的大事，不把沙漠里的危险分子犁个干净，说不过去吧？"
                                },
                                {
                                    "id": "737050311",
                                    "speaker": "坎蒂丝",
                                    "text": "玩笑先放一边吧，迪希雅。"
                                },
                                {
                                    "id": "737050312",
                                    "speaker": "坎蒂丝",
                                    "text": "#说不定{NICKNAME}听了你的话，会认真地拔剑出击，从这里打到沙漠尽头…"
                                },
                                {
                                    "id": "737050313",
                                    "speaker": "派蒙",
                                    "text": "#把所有危险分子都干掉…以{NICKNAME}的效率，得在沙漠里住上好几年，每天从日出工作到日落才行吧？"
                                },
                                {
                                    "id": "737050314",
                                    "speaker": "派蒙",
                                    "text": "旅行也得停下来，完全不敢想…"
                                },
                                {
                                    "id": "737050315",
                                    "speaker": "柯莱",
                                    "text": "时间是最简单的问题，很多危险都没法直接用肉眼确认，比如隐藏在地下的毒蝎，睡在树上的恐怖大怪鸟。"
                                },
                                {
                                    "id": "737050316",
                                    "speaker": "柯莱",
                                    "text": "只有到了它们跳出来拦住去路的时候，才有可能和它们正面过招。"
                                },
                                {
                                    "id": "737050317",
                                    "speaker": "柯莱",
                                    "text": "这种时候，应该按照珐露珊前辈的叮嘱，结合安柏的侦察思路，好好算一算接敌概率，和行动时间的综合期望…"
                                },
                                {
                                    "id": "737050318",
                                    "speaker": "迪希雅",
                                    "text": "喂喂，你们两个还真开始盘算了啊！"
                                },
                                {
                                    "id": "737050319",
                                    "speaker": "坎蒂丝",
                                    "text": "其实远没有那么夸张，「安全分队」的职责，是确保外出考察的学生队伍中，有着可靠的随行护卫。"
                                },
                                {
                                    "id": "737050320",
                                    "speaker": "坎蒂丝",
                                    "text": "这份差事一部分包给了「炽光猎兽」与合作佣兵，一部分由考察队伍中经过战斗考核的强者自行承接。"
                                },
                                {
                                    "id": "737050321",
                                    "speaker": "坎蒂丝",
                                    "text": "考察队伍准备前往危险地带前，必须在队伍中编入至少两名通过了战斗考核的专业人员。"
                                },
                                {
                                    "id": "737050322",
                                    "speaker": "坎蒂丝",
                                    "text": "而我和迪希雅刚刚收集好的情报，就关乎战斗考核的场地。"
                                },
                                {
                                    "id": "737050323",
                                    "speaker": "迪希雅",
                                    "text": "嘿，找到了一座魔物和贼匪盘踞的秘境，各种水平的坏家伙管够，正好借他们脑袋一用，验证护卫们的本领。"
                                },
                                {
                                    "id": "737050324",
                                    "speaker": "派蒙",
                                    "text": "这么听起来，只要监督考核的过程就可以了？其实是考官！"
                                },
                                {
                                    "id": "737050325",
                                    "speaker": "坎蒂丝",
                                    "text": "请放心，我和迪希雅会安排可靠人士轮岗，保证参加者的人身安全。"
                                },
                                {
                                    "id": "737050326",
                                    "speaker": "迪希雅",
                                    "text": "目前还有个没解决的问题——考核的标准。毕竟，战斗不是做题，没有唯一的解法。"
                                },
                                {
                                    "id": "737050327",
                                    "speaker": "迪希雅",
                                    "text": "我们每个佣兵都有自己习惯的战斗风格，实战完全不成问题，可要当教官的话，路子略微有点一成不变…"
                                },
                                {
                                    "id": "737050328",
                                    "speaker": "迪希雅",
                                    "text": "所以需要一位见多识广、战斗思维灵活的专家，来给出一份可供参考的理想答卷。",
                                    "choices": [
                                        {
                                            "id": "737050329",
                                            "text": "这是我的专长，我来搞定。",
                                            "response": [
                                                {
                                                    "id": "737050331",
                                                    "speaker": "派蒙",
                                                    "text": "#对哦对哦，要说眼界宽和灵活变通，我不知道有什么人能比过{NICKNAME}了！"
                                                },
                                                {
                                                    "id": "737050332",
                                                    "speaker": "迪希雅",
                                                    "text": "#爽快！和{NICKNAME}合作就是这么顺畅、愉悦，像抹足了油和香料的烤肉排！"
                                                },
                                                {
                                                    "id": "737050333",
                                                    "speaker": "坎蒂丝",
                                                    "text": "#记得准备好答谢{NICKNAME}和派蒙的报酬，迪希雅。你听了合作要求后就答应了，还没仔细算过账。"
                                                },
                                                {
                                                    "id": "737050334",
                                                    "speaker": "迪希雅",
                                                    "text": "#没事没事！柯莱帮我们和教令院谈下的报酬，二八分成，我一，你一，{NICKNAME}和派蒙拿八成。"
                                                },
                                                {
                                                    "id": "737050335",
                                                    "speaker": "派蒙",
                                                    "text": "咦！我们居然拿八成吗？",
                                                    "choices": [
                                                        {
                                                            "id": "737050336",
                                                            "text": "是不是有点多…",
                                                            "response": [
                                                                {
                                                                    "id": "737050338",
                                                                    "speaker": "迪希雅",
                                                                    "text": "哈哈哈，我们就别见外了！"
                                                                },
                                                                {
                                                                    "id": "737050339",
                                                                    "speaker": "迪希雅",
                                                                    "text": "总之，安全分队的工作，由你们来定标准，我们负责执行和长期经营，你们苦劳最大。"
                                                                },
                                                                {
                                                                    "id": "737050340",
                                                                    "speaker": "迪希雅",
                                                                    "text": "我们以前就谈好过合作的计划了，这次正好开个漂亮的头。"
                                                                },
                                                                {
                                                                    "id": "737050341",
                                                                    "speaker": "柯莱",
                                                                    "text": "那，那我会好好算账的，仔细列出酬金的明细，让你们一眼就能看个明白。"
                                                                },
                                                                {
                                                                    "id": "737050342",
                                                                    "speaker": "迪希雅",
                                                                    "text": "麻烦你啦，柯莱！"
                                                                },
                                                                {
                                                                    "id": "737050343",
                                                                    "speaker": "柯莱",
                                                                    "text": "还有坎蒂丝小姐，也请放心。"
                                                                },
                                                                {
                                                                    "id": "737050344",
                                                                    "speaker": "柯莱",
                                                                    "text": "关于阿如村粮仓这片土地的临时租金，我也成功让教令院点头，在之前的基础上提了三成。"
                                                                },
                                                                {
                                                                    "id": "737050345",
                                                                    "speaker": "坎蒂丝",
                                                                    "text": "感谢理解，这笔钱会被用来修缮村内的设施。考察队伍在阿如村落脚时，也能得到更舒适的体验。"
                                                                },
                                                                {
                                                                    "id": "737050346",
                                                                    "speaker": "坎蒂丝",
                                                                    "text": "#那我们就在「安全分队」的小站稍作整理，以便{NICKNAME}开展行动。"
                                                                },
                                                                {
                                                                    "id": "737050347",
                                                                    "speaker": "迪希雅",
                                                                    "text": "待会儿见哦！"
                                                                },
                                                                {
                                                                    "id": "737050348",
                                                                    "speaker": "派蒙",
                                                                    "text": "嘿嘿，柯莱这次可是毋庸置疑的核心人物呢，把大家团结在一起。"
                                                                },
                                                                {
                                                                    "id": "737050349",
                                                                    "speaker": "柯莱",
                                                                    "text": "没有啦没有啦，我只是尽了自己最大的努力而已。"
                                                                },
                                                                {
                                                                    "id": "737050350",
                                                                    "speaker": "柯莱",
                                                                    "text": "还有很多事情要学，很多工作要协调…"
                                                                },
                                                                {
                                                                    "id": "737050351",
                                                                    "speaker": "柯莱",
                                                                    "text": "#总之，{NICKNAME}和派蒙，我们一起加油吧！"
                                                                },
                                                                {
                                                                    "id": "737050352",
                                                                    "speaker": "派蒙",
                                                                    "text": "好哦好哦！目标是——把「稳健知行」机构办得无可挑剔！"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "737050337",
                                                            "text": "感谢迪希雅关照！"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "737050330",
                                            "text": "我来这里就是为了帮忙。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "737050309",
                            "text": "难道在筹划什么进攻行动…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7370507",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "737050701",
                    "speaker": "珐露珊",
                    "text": "要不然，还是不改了？"
                }
            ]
        },
