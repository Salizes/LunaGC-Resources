    "talks": [
        {
            "id": "7329501",
            "objective": "(test)通用时间改变$HIDDEN",
            "dialogues": [
                {
                    "id": "732950101",
                    "speaker": "派蒙",
                    "text": "要给它留点什么好吃的吗？"
                },
                {
                    "id": "732950102",
                    "speaker": "狗",
                    "text": "（期待地看着你们。）"
                }
            ]
        },
        {
            "id": "7329502",
            "objective": "前往水边营地",
            "dialogues": []
        },
        {
            "id": "7329510",
            "objective": "寻找于连",
            "dialogues": []
        },
        {
            "id": "7329503",
            "objective": "解救于连",
            "dialogues": []
        },
        {
            "id": "7329504",
            "objective": "与于连对话",
            "dialogues": [
                {
                    "id": "732950401",
                    "speaker": "派蒙",
                    "text": "你还好吧？"
                },
                {
                    "id": "732950402",
                    "speaker": "于连",
                    "text": "我…我…唉…多谢两位搭救。"
                },
                {
                    "id": "732950403",
                    "speaker": "于连",
                    "text": "昨晚做了个好梦，梦里卡特皮拉站在朝圣之路的终点冲我招手，记得梦里我想，真怪呀，朝圣之路怎么会是洞窟接着洞窟…"
                },
                {
                    "id": "732950404",
                    "speaker": "于连",
                    "text": "可是卡特皮拉分明就站在长长狭路的尽头，于是我赶忙朝他的方向跑去，结果不等我抵达，就被狗叫给吵醒了…"
                },
                {
                    "id": "732950405",
                    "speaker": "于连",
                    "text": "且不论狗叫的部分…我想这肯定是好兆头啊，今天一定能有所收获，于是带着写生的道具出发了。"
                },
                {
                    "id": "732950406",
                    "speaker": "于连",
                    "text": "结果…结果在迷宫里好像无头飞萤，还被丘丘人给缠上…最后不仅没逃脱，装着画稿的背包也在逃跑时掉落了…"
                },
                {
                    "id": "732950407",
                    "speaker": "Player",
                    "text": "今天也是丢三落四的一天呢。"
                },
                {
                    "id": "732950408",
                    "speaker": "于连",
                    "text": "这能怪我吗？这一带简直比枫丹的下水道还难绕…对了，我听说须弥人都是住树上的，难道这里真的是…？"
                },
                {
                    "id": "732950409",
                    "speaker": "于连",
                    "text": "妈呀！须弥人到底都排泄了些什么东西啊…"
                },
                {
                    "id": "732950410",
                    "speaker": "派蒙",
                    "text": "应该不是你想的那样啦！"
                },
                {
                    "id": "732950411",
                    "speaker": "于连",
                    "text": "唉…我的人生就是失败的连续，一步错步步错。"
                },
                {
                    "id": "732950412",
                    "speaker": "于连",
                    "text": "今早为什么要离开安全的地方呢？虽说梦见了好兆头，可那毕竟只是一个梦，我怎么就当真了。"
                },
                {
                    "id": "732950413",
                    "speaker": "于连",
                    "text": "昨天为什么不诚实一点告诉你们我的难处呢？要是早让你们带路，又怎么会落得今天的下场。"
                },
                {
                    "id": "732950414",
                    "speaker": "于连",
                    "text": "当初为什么要离开枫丹呢？就算不离开枫丹，日子也没到完全过不下去的地步…反而离开之后一件好事也没发生…"
                },
                {
                    "id": "732950415",
                    "speaker": "派蒙",
                    "text": "你、你先不要泄气嘛，适合采风的地方，我们可以带你去的！不过现在应该先把丢失的东西找回来吧？"
                },
                {
                    "id": "732950416",
                    "speaker": "派蒙",
                    "text": "唔…虽然不知道能不能全都完整地找回来…"
                },
                {
                    "id": "732950417",
                    "speaker": "于连",
                    "text": "哈哈，可能已经被丘丘人捡走当厕纸了吧，反正…反正也不是什么值钱的东西，呜呜…"
                },
                {
                    "id": "732950418",
                    "speaker": "Player",
                    "text": "诚实一点吧。"
                },
                {
                    "id": "732950419",
                    "speaker": "派蒙",
                    "text": "对啊，就算不是能卖出很多价钱的东西，对于连本人来说也是很珍贵的吧？我们会尽量帮你找找的！"
                },
                {
                    "id": "732950420",
                    "speaker": "派蒙",
                    "text": "…话说回来，「胡椒」呢？它没和你在一起吗？"
                },
                {
                    "id": "732950421",
                    "speaker": "于连",
                    "text": "哼，没良心的东西…它老早就跑掉了，现在应该躲在什么安全的地方悠闲自得吧。"
                },
                {
                    "id": "732950422",
                    "speaker": "派蒙",
                    "text": "真不敢相信…"
                },
                {
                    "id": "732950423",
                    "speaker": "派蒙",
                    "text": "唔…要不你先回营地休息一下，处理一下伤口吧！我们找到丢失的东西之后回营地找你。"
                },
                {
                    "id": "732950424",
                    "speaker": "于连",
                    "text": "谢谢两位…好朋友，人生在世就得靠朋友啊。"
                }
            ]
        },
        {
            "id": "7329505",
            "objective": "沿路寻找丢失的画稿",
            "dialogues": []
        },
        {
            "id": "7329506",
            "objective": "与「胡椒」对话",
            "dialogues": [
                {
                    "id": "732950601",
                    "speaker": "派蒙",
                    "text": "欸？这不是「胡椒」嘛！它好像看守着什么呢…等等，这情景有点熟悉…"
                },
                {
                    "id": "732950602",
                    "speaker": "狗",
                    "text": "（似乎认出了你们，摇起了尾巴。）"
                },
                {
                    "id": "732950603",
                    "speaker": "派蒙",
                    "text": "唔…难道它是在看守于连的画稿吗？"
                },
                {
                    "id": "732950604",
                    "speaker": "Black Screen",
                    "text": "「胡椒」短吠了两声，很快离开了…"
                },
                {
                    "id": "732950605",
                    "speaker": "派蒙",
                    "text": "它又走掉了呢，上次也是这样…话说回来，丘丘人把画稿捡回来干什么？",
                    "choices": [
                        {
                            "id": "732950606",
                            "text": "可能也有装饰的需求吧。",
                            "response": [
                                {
                                    "id": "732950607",
                                    "speaker": "派蒙",
                                    "text": "唔…真的是这样吗…"
                                }
                            ]
                        },
                        {
                            "id": "732950608",
                            "text": "难道真的是当厕纸…",
                            "response": [
                                {
                                    "id": "732950609",
                                    "speaker": "派蒙",
                                    "text": "#噫——{NICKNAME}怎么会有这么脏的想象！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7329507",
            "objective": "回收画稿",
            "dialogues": []
        },
        {
            "id": "7329508",
            "objective": "前往营地，与于连对话",
            "dialogues": [
                {
                    "id": "732950801",
                    "speaker": "派蒙",
                    "text": "它果然已经回来了呢！"
                },
                {
                    "id": "732950802",
                    "speaker": "派蒙",
                    "text": "喂，于连！我们找到画稿带回来啦。"
                },
                {
                    "id": "732950803",
                    "speaker": "于连",
                    "text": "哦哦！感谢两位好朋友…为了这种不值钱的东西…"
                },
                {
                    "id": "732950804",
                    "speaker": "派蒙",
                    "text": "别这么说，你不是枫丹知名画家嘛，知名画家的手稿肯定也是很值钱的吧？"
                },
                {
                    "id": "732950805",
                    "speaker": "于连",
                    "text": "呃，是…或许是吧，我其实不太关注这方面，毕竟真正的艺术应该是无价的。"
                },
                {
                    "id": "732950806",
                    "speaker": "派蒙",
                    "text": "不愧是知名画家，每句话都感觉很有艺术感很有哲理呢！说起来，我们找到画稿的时候，「胡椒」也在旁边守着呢。"
                },
                {
                    "id": "732950807",
                    "speaker": "Player",
                    "text": "和之前一样。"
                },
                {
                    "id": "732950808",
                    "speaker": "派蒙",
                    "text": "嗯！我觉得，它肯定还是很关心你的。"
                },
                {
                    "id": "732950809",
                    "speaker": "于连",
                    "text": "你们是说，不顾我喂养它这么久却带我走进歧途，还留我独自面对丘丘人的家伙吗？"
                },
                {
                    "id": "732950810",
                    "speaker": "派蒙",
                    "text": "唔…它、它可能也有它的考虑吧！"
                },
                {
                    "id": "732950811",
                    "speaker": "派蒙",
                    "text": "对了，于连虽然嘴上这么说，其实心里还是很喜欢它的吧？不然也不会用特别的留影机给它拍画片了。"
                },
                {
                    "id": "732950812",
                    "speaker": "于连",
                    "text": "画片？什么画片？"
                },
                {
                    "id": "732950813",
                    "speaker": "派蒙",
                    "text": "就是夹在画稿里的那一张狗的画片呀，和它一模一样！色彩看起来很独特呢，应该是用枫丹的什么特别的留影机拍摄的吧？"
                },
                {
                    "id": "732950814",
                    "speaker": "于连",
                    "text": "啊…那个其实是我画的。"
                },
                {
                    "id": "732950815",
                    "speaker": "派蒙",
                    "text": "欸？知、知名画家果然很厉害呢！不仅画得像，配色也…也很艺术！"
                },
                {
                    "id": "732950816",
                    "speaker": "于连",
                    "text": "……"
                },
                {
                    "id": "732950817",
                    "speaker": "派蒙",
                    "text": "（难道是我夸得不对吗？）",
                    "choices": [
                        {
                            "id": "732950818",
                            "text": "（别问我，我也不懂。）",
                            "response": [
                                {
                                    "id": "732950820",
                                    "speaker": "于连",
                                    "text": "我也不想画这样的东西…我只是…我只是想当个一流的画家，你们说，这件事真的这样难办吗？"
                                },
                                {
                                    "id": "732950821",
                                    "speaker": "于连",
                                    "text": "唉…对不起，我不该对两位好朋友说谎。一旦说出第一个谎言，之后就需要更多谎言…我已经…"
                                },
                                {
                                    "id": "732950822",
                                    "speaker": "于连",
                                    "text": "其实我只是个半吊子，无法像其他人一样「正确地」分辨颜色，但是又不想放弃成为画家的愿望。"
                                },
                                {
                                    "id": "732950823",
                                    "speaker": "于连",
                                    "text": "所以借助了一个…朋友的力量，得到了画什么像什么的能力，但还是没办法辨别色彩。"
                                },
                                {
                                    "id": "732950824",
                                    "speaker": "派蒙",
                                    "text": "等等，你说「得到了画什么像什么的能力」…这是不经过训练就能获得的能力吗？"
                                },
                                {
                                    "id": "732950825",
                                    "speaker": "于连",
                                    "text": "是啊，我这个朋友他比较神通广大。"
                                },
                                {
                                    "id": "732950826",
                                    "speaker": "Player",
                                    "text": "真的吗？我不信。"
                                },
                                {
                                    "id": "732950827",
                                    "speaker": "于连",
                                    "text": "应该说，现在的我已经没办法画得不像了，这或许就是能力的代价吧。说起来的确有些离谱，不过…"
                                },
                                {
                                    "id": "732950828",
                                    "speaker": "Black Screen",
                                    "text": "于连当即摹写了一份冒险家的经验交给你。\\n你将摹写的副本与原本两相比较，并未发现任何不同。"
                                },
                                {
                                    "id": "732950848",
                                    "speaker": "Black Screen",
                                    "text": "唯一的区别或许是，副本读完之后有种脑袋空空的奇妙感觉…\\n就像是读了，但完全没读。只有时间白白被浪费，却没能获得任何经验…"
                                },
                                {
                                    "id": "732950849",
                                    "speaker": "派蒙",
                                    "text": "唔…看着和原版没什么区别…"
                                },
                                {
                                    "id": "732950829",
                                    "speaker": "于连",
                                    "text": "哈哈，那当然，虽然没当上知名画家，制作赝品我可是一把好手。"
                                },
                                {
                                    "id": "732950830",
                                    "speaker": "派蒙",
                                    "text": "可那不是违法的吗？"
                                },
                                {
                                    "id": "732950831",
                                    "speaker": "于连",
                                    "text": "…是啊，所以我在服过刑之后决定做点正经营生，这次一定要当一个堂堂正正的画家。"
                                },
                                {
                                    "id": "732950832",
                                    "speaker": "于连",
                                    "text": "可是这画什么像什么的能力…如果不是卡特皮拉赋予我的，我一定会把它称作诅咒吧。"
                                },
                                {
                                    "id": "732950833",
                                    "speaker": "于连",
                                    "text": "现在的我就像是坏掉的留影机，只能产出颜色错乱的「画片」…"
                                },
                                {
                                    "id": "732950834",
                                    "speaker": "于连",
                                    "text": "原本以为循着纯水精灵的朝圣之路就能找到解药…让我也能像常人一样分辨色彩，让我像无垢的孩童一样充满创造力…",
                                    "choices": [
                                        {
                                            "id": "732950835",
                                            "text": "卡特皮拉到底是谁？",
                                            "response": [
                                                {
                                                    "id": "732950836",
                                                    "speaker": "于连",
                                                    "text": "是朋友…可靠的朋友，是他告诉我循着纯水精灵的朝圣之路就能在须弥找到治愈一切伤痛，让人重获新生的灵药…"
                                                },
                                                {
                                                    "id": "732950839",
                                                    "speaker": "派蒙",
                                                    "text": "…听起来好可疑的感觉！你这个朋友是个什么朋友呀…你该不会是被骗了吧？"
                                                },
                                                {
                                                    "id": "732950840",
                                                    "speaker": "于连",
                                                    "text": "他见多识广怎么会骗我。一定是我自己的问题吧，就像之前说的，我的人生就是失败的连续…"
                                                },
                                                {
                                                    "id": "732950841",
                                                    "speaker": "于连",
                                                    "text": "我想灵药恐怕是被安放在重重保护之下，像我这样的俗人终究是无法企及的，我已经…认清了。"
                                                },
                                                {
                                                    "id": "732950842",
                                                    "speaker": "于连",
                                                    "text": "其实狗也一定不想陪我来须弥吧，不然也不会一路给我使绊子找气受。要是当初让它留在枫丹就好了。"
                                                },
                                                {
                                                    "id": "732950843",
                                                    "speaker": "派蒙",
                                                    "text": "唔…我是觉得它肯定还是想和你在一起的，而且它肯定很喜欢你的画…所以不要这么快就放弃嘛。"
                                                },
                                                {
                                                    "id": "732950844",
                                                    "speaker": "于连",
                                                    "text": "非常暖心的安慰…但我已经不抱希望了。两位好朋友，难得你们帮了我几次，我却提供不了什么像样的报酬…"
                                                },
                                                {
                                                    "id": "732950845",
                                                    "speaker": "于连",
                                                    "text": "等我休息一阵恢复得差不多了就准备返回枫丹了。虽然是很厚脸皮的请求…到时可以麻烦两位将我带到主路上吗？"
                                                },
                                                {
                                                    "id": "732950846",
                                                    "speaker": "于连",
                                                    "text": "唉…要是能更早放弃…或者没有死要面子…说不定现在已经走在正确的路上了。"
                                                },
                                                {
                                                    "id": "732950847",
                                                    "speaker": "派蒙",
                                                    "text": "只是带路的话当然没问题，既然你已经决定了…那就先好好休息吧！"
                                                },
                                                {
                                                    "id": "732950850",
                                                    "speaker": "于连",
                                                    "text": "嗯，谢谢你们，好朋友。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "732950837",
                                            "text": "朝圣之路是什么？",
                                            "response": [
                                                {
                                                    "id": "732950838",
                                                    "speaker": "于连",
                                                    "text": "卡特皮拉告诉我这是纯水精灵们历经的道路，在朝圣之路的尽头也就是须弥，能找到治愈一切伤痛，让人重获新生的灵药…"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "732950819",
                            "text": "（是超越派蒙理解的艺术呢。）"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7329509",
            "objective": "(test)击败奇怪的丘丘人",
            "dialogues": [
                {
                    "id": "732950901",
                    "speaker": "于连",
                    "text": "朝圣之路…怎么会跟丢了痕迹呢…"
                },
                {
                    "id": "732950902",
                    "speaker": "派蒙",
                    "text": "…朝圣之路？"
                },
                {
                    "id": "732950903",
                    "speaker": "于连",
                    "text": "啊，没什么，呃，只是一种…一种比喻的说法。"
                }
            ]
        },
        {
            "id": "7329512",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "732951201",
                    "speaker": "于连",
                    "text": "啊，两位好朋友，丢失的画稿…"
                },
                {
                    "id": "732951202",
                    "speaker": "Player",
                    "text": "还没呢。"
                },
                {
                    "id": "732951203",
                    "speaker": "于连",
                    "text": "没关系，反正…反正不是什么值钱的东西…"
                }
            ]
        },
