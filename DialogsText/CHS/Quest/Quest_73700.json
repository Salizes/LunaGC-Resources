    "talks": [
        {
            "id": "7370001",
            "objective": "与祖尔宛对话",
            "dialogues": [
                {
                    "id": "737000101",
                    "speaker": "祖尔宛",
                    "text": "不知不觉训练也进行到后半了。进展还顺利吗？",
                    "choices": [
                        {
                            "id": "737000102",
                            "text": "可以说是渐入佳境。",
                            "response": [
                                {
                                    "id": "737000104",
                                    "speaker": "派蒙",
                                    "text": "不过斯露莎在给我们讲故事的时候，的确有反思的意思？"
                                },
                                {
                                    "id": "737000105",
                                    "speaker": "祖尔宛",
                                    "text": "对话对于斯露莎来说是很好的学习方法。特别是当对话的对象不是矫论团那帮无趣的家伙的时候。"
                                },
                                {
                                    "id": "737000106",
                                    "speaker": "斯露莎",
                                    "text": "#前辈这话未免有些太武断了…{NICKNAME}作为「谒颂主」是很出众，但矫论团的人也并不全是…"
                                },
                                {
                                    "id": "737000107",
                                    "speaker": "祖尔宛",
                                    "text": "或许在吹捧与欺瞒之外也有零星被遗漏的美德吧。"
                                },
                                {
                                    "id": "737000108",
                                    "speaker": "斯露莎",
                                    "text": "唔…"
                                },
                                {
                                    "id": "737000109",
                                    "speaker": "祖尔宛",
                                    "text": "#看你不服气的样子，稍后正好让{NICKNAME}和派蒙两位见证者来评价一下。当然，在你的讲述之后。"
                                }
                            ]
                        },
                        {
                            "id": "737000103",
                            "text": "还有进步的空间。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7370002",
            "objective": "前往指定地点并完成试炼",
            "dialogues": []
        },
        {
            "id": "7370003",
            "objective": "完成训练任务",
            "dialogues": []
        },
        {
            "id": "7370004",
            "objective": "前往指定地点并完成试炼",
            "dialogues": []
        },
        {
            "id": "7370005",
            "objective": "见证斯露莎回顾过往",
            "dialogues": []
        },
        {
            "id": "7370006",
            "objective": "与斯露莎对话",
            "dialogues": [
                {
                    "id": "737000601",
                    "speaker": "派蒙",
                    "text": "好安静啊，谁也不在。"
                },
                {
                    "id": "737000602",
                    "speaker": "斯露莎",
                    "text": "就算拉沙鲁在这里，应该也会很安静吧…"
                },
                {
                    "id": "737000603",
                    "speaker": "派蒙",
                    "text": "嗯，不过如果她在的话，咱们说话可就得小声点了。她总是一副困困的样子，之前被我们用俱利鼓吵醒的时候也有些不高兴呢。"
                },
                {
                    "id": "737000604",
                    "speaker": "派蒙",
                    "text": "听说越是沉默寡言的家伙，真的发起火来越是可怕。不知道拉沙鲁大发雷霆会是什么样子…"
                },
                {
                    "id": "737000605",
                    "speaker": "斯露莎",
                    "text": "这么说来，吾之「谒颂主」才是最让人害怕的吧？"
                },
                {
                    "id": "737000606",
                    "speaker": "派蒙",
                    "text": "#欸？我最了解{M#他}{F#她}了，这家伙虽然话很少，但是其实很温柔的。对吧？",
                    "choices": [
                        {
                            "id": "737000607",
                            "text": "我要认真生气了，嗷呜嗷呜。",
                            "response": [
                                {
                                    "id": "737000608",
                                    "speaker": "派蒙",
                                    "text": "你看，一点也不可怕嘛。"
                                },
                                {
                                    "id": "737000611",
                                    "speaker": "斯露莎",
                                    "text": "好了，还是说回正事吧。"
                                },
                                {
                                    "id": "737000612",
                                    "speaker": "斯露莎",
                                    "text": "如你们所见，这棵树被称为「跋尔松」，花灵拉沙鲁是「跋尔松」之眷属，不过她现在不在此处。"
                                },
                                {
                                    "id": "737000613",
                                    "speaker": "派蒙",
                                    "text": "然后呢然后呢？"
                                },
                                {
                                    "id": "737000614",
                                    "speaker": "斯露莎",
                                    "text": "然后？没有然后了，关于拉沙鲁和「跋尔松」，已经没什么可补足的了。"
                                },
                                {
                                    "id": "737000615",
                                    "speaker": "派蒙",
                                    "text": "总觉得斯露莎在遮掩些什么…对了，关于俱利鼓…"
                                },
                                {
                                    "id": "737000616",
                                    "speaker": "斯露莎",
                                    "text": "遮、遮掩？没有这回事。至于俱利鼓…你们不是已经见识过了么？"
                                },
                                {
                                    "id": "737000617",
                                    "speaker": "派蒙",
                                    "text": "对了，记得当时拉沙鲁说俱利鼓是被她扔在了不同的地方，那先朱那还大吃一惊呢。"
                                },
                                {
                                    "id": "737000618",
                                    "speaker": "派蒙",
                                    "text": "没记错的话，斯露莎当时慌慌张张的，也没有回应那先朱那的质疑。"
                                },
                                {
                                    "id": "737000619",
                                    "speaker": "派蒙",
                                    "text": "这样看来，矫论团的文献典籍真的错得离谱呢。"
                                },
                                {
                                    "id": "737000620",
                                    "speaker": "Player",
                                    "text": "虽然按鼓谱演奏确实唤醒了拉沙鲁。"
                                },
                                {
                                    "id": "737000621",
                                    "speaker": "派蒙",
                                    "text": "好像知道为什么祖尔宛信不过现在的矫论团了，仔细想想，他们真的帮上忙了吗？从矫论团得知的线索几乎都是半真半假的…"
                                },
                                {
                                    "id": "737000622",
                                    "speaker": "斯露莎",
                                    "text": "唔…"
                                },
                                {
                                    "id": "737000623",
                                    "speaker": "斯露莎",
                                    "text": "现在的矫论团是有一些不怎么可靠的成员，但是就像大树，无论多繁茂，总会有些枯枝败叶。"
                                },
                                {
                                    "id": "737000624",
                                    "speaker": "斯露莎",
                                    "text": "只要这些枯枝败叶都散去了，剩下的…剩下的就一定是坚定可靠的…唔…"
                                },
                                {
                                    "id": "737000625",
                                    "speaker": "斯露莎",
                                    "text": "…矫论团怎么会变成现在这个样子？"
                                },
                                {
                                    "id": "737000626",
                                    "speaker": "Player",
                                    "text": "我也想知道这个问题的答案。"
                                },
                                {
                                    "id": "737000627",
                                    "speaker": "斯露莎",
                                    "text": "正因为一直和矫论团的人类在一起，对于他们的种种变化反而难以察觉…"
                                },
                                {
                                    "id": "737000628",
                                    "speaker": "斯露莎",
                                    "text": "只有在和你们这样的外来者对话时才发现，原来矫论团早已不是过去的样子了。"
                                },
                                {
                                    "id": "737000629",
                                    "speaker": "派蒙",
                                    "text": "毕竟都过去几百年了嘛，除了「矫论团」这个名字还和以前一样，其中的成员一定都历经了好几代人了。"
                                },
                                {
                                    "id": "737000630",
                                    "speaker": "斯露莎",
                                    "text": "我所希求的声名，由人类「谒颂主」所传颂的声名难道最后也会像这样…一切都改变了，只有空虚的名号本身仍存。"
                                },
                                {
                                    "id": "737000631",
                                    "speaker": "斯露莎",
                                    "text": "前辈就是想让我知道这件事吗？不应该是这样的…可是…"
                                },
                                {
                                    "id": "737000632",
                                    "speaker": "派蒙",
                                    "text": "…斯露莎也不要这么沮丧嘛！说不定…说不定祖尔宛不是这个意思…"
                                },
                                {
                                    "id": "737000633",
                                    "speaker": "派蒙",
                                    "text": "看到斯露莎没精打采的样子，总觉得自己做了什么坏事一样…之后还是让祖尔宛来劝劝她好了。"
                                }
                            ]
                        },
                        {
                            "id": "737000609",
                            "text": "……",
                            "response": [
                                {
                                    "id": "737000610",
                                    "speaker": "派蒙",
                                    "text": "#…{NICKNAME}你还是说点什么吧！一言不发的样子真的有点吓人…"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}