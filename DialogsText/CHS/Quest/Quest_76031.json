    },
    "talks": [
        {
            "id": "7603101",
            "objective": "同「少女」见面",
            "dialogues": [
                {
                    "id": "760310401",
                    "speaker": "派蒙",
                    "text": "#咦？{NICKNAME}，你看那是什么？"
                },
                {
                    "id": "760310402",
                    "speaker": "Player",
                    "text": "一只…帔髦獾？"
                },
                {
                    "id": "760310403",
                    "speaker": "派蒙",
                    "text": "它怎么一个人躲在这里呀，是来找「少女」的吗？"
                },
                {
                    "id": "760310404",
                    "speaker": "派蒙",
                    "text": "看它的样子好像被什么东西吓到了，我们先带它进去吧。"
                }
            ]
        },
        {
            "id": "7603106",
            "objective": "进入「银月之庭」",
            "dialogues": [
                {
                    "id": "760310101",
                    "speaker": "派蒙",
                    "text": "哥伦比娅？"
                },
                {
                    "id": "760310102",
                    "speaker": "「少女」",
                    "text": "呼…呼…"
                },
                {
                    "id": "760310103",
                    "speaker": "派蒙",
                    "text": "#啊！她在睡午觉呢，{NICKNAME}，要不我们待会儿再来。"
                },
                {
                    "id": "760310104",
                    "speaker": "帔髦獾",
                    "text": "……！"
                },
                {
                    "id": "760310105",
                    "speaker": "派蒙",
                    "text": "欸！你别去呀！"
                },
                {
                    "id": "760310106",
                    "speaker": "「少女」",
                    "text": "…唔！"
                },
                {
                    "id": "760310107",
                    "speaker": "「少女」",
                    "text": "疼…"
                },
                {
                    "id": "760310108",
                    "speaker": "帔髦獾",
                    "text": "……"
                },
                {
                    "id": "760310109",
                    "speaker": "「少女」",
                    "text": "脚滑了一下？唔，没关系，我没事。嗯？你们也来了？"
                },
                {
                    "id": "760310110",
                    "speaker": "派蒙",
                    "text": "原来「月神」还会被动物撞疼的吗…"
                },
                {
                    "id": "760310111",
                    "speaker": "「少女」",
                    "text": "动物们散发的月矩力中没有「恶意」，我就没在意。"
                },
                {
                    "id": "760310112",
                    "speaker": "「少女」",
                    "text": "你怎么了？为什么这么害怕？"
                },
                {
                    "id": "760310113",
                    "speaker": "帔髦獾",
                    "text": "……"
                },
                {
                    "id": "760310114",
                    "speaker": "「少女」",
                    "text": "嗯，嗯嗯。"
                },
                {
                    "id": "760310115",
                    "speaker": "派蒙",
                    "text": "原来你也能听懂它们说了什么？"
                },
                {
                    "id": "760310116",
                    "speaker": "「少女」",
                    "text": "挪德卡莱是月亮升起的地方，只要是在月矩力下长大的动物，都可以算「月神的眷属」。"
                },
                {
                    "id": "760310117",
                    "speaker": "派蒙",
                    "text": "那它说了什么呀？"
                },
                {
                    "id": "760310118",
                    "speaker": "「少女」",
                    "text": "它生活的地方出现了魔物，本来想找菈乌玛…但一路被魔物追到了这附近…"
                },
                {
                    "id": "760310119",
                    "speaker": "派蒙",
                    "text": "哦，怪不得会那么害怕…"
                },
                {
                    "id": "760310120",
                    "speaker": "Player",
                    "text": "要送它回去吗？"
                },
                {
                    "id": "760310121",
                    "speaker": "「少女」",
                    "text": "嗯，送去菈乌玛那里好了。她会处理的。"
                },
                {
                    "id": "760310122",
                    "speaker": "派蒙",
                    "text": "好呀，看来又要出一趟门了呢。不过这次去的是「霜月之子」那边，你可真的要藏好啊！"
                }
            ]
        },
        {
            "id": "7603102",
            "objective": "同菈乌玛见面",
            "dialogues": [
                {
                    "id": "760310201",
                    "speaker": "菈乌玛",
                    "text": "…没错，之后再让库涅贡妲拿些水果过去，这两天她需要静养。"
                },
                {
                    "id": "760310202",
                    "speaker": "派蒙",
                    "text": "哦，菈乌玛好像在忙欸。我们稍等一下。"
                },
                {
                    "id": "760310203",
                    "speaker": "「少女」",
                    "text": "很久以前我就知道，「咏月使」是「霜月之子」中非常重要的存在。"
                },
                {
                    "id": "760310204",
                    "speaker": "「少女」",
                    "text": "我有时会觉得，她们说不定比真正的「神明」还辛苦。"
                },
                {
                    "id": "760310205",
                    "speaker": "派蒙",
                    "text": "哦！她闲下来了！快趁现在…"
                },
                {
                    "id": "760310206",
                    "speaker": "瓦娜莫",
                    "text": "菈乌玛大人，这边有些工事需要您安排一下。"
                },
                {
                    "id": "760310207",
                    "speaker": "菈乌玛",
                    "text": "好，我这就来。"
                },
                {
                    "id": "760310208",
                    "speaker": "派蒙",
                    "text": "又被叫走了吗！真的一点空隙都不给欸！"
                },
                {
                    "id": "760310209",
                    "speaker": "派蒙",
                    "text": "我们小心地跟上去吧！"
                }
            ]
        },
        {
            "id": "7603103",
            "objective": "跟上菈乌玛",
            "dialogues": [
                {
                    "id": "760310301",
                    "speaker": "菈乌玛",
                    "text": "…这样就好。辛苦你们了。"
                },
                {
                    "id": "760310302",
                    "speaker": "菈乌玛",
                    "text": "月光联系着你我，不论日夜。"
                },
                {
                    "id": "760310303",
                    "speaker": "「少女」",
                    "text": "…嗯？这和我以前听到的不一样了。"
                },
                {
                    "id": "760310304",
                    "speaker": "派蒙",
                    "text": "啊！那人走了！我们上吧！"
                },
                {
                    "id": "760310305",
                    "speaker": "马西捷",
                    "text": "菈乌玛大人！"
                },
                {
                    "id": "760310306",
                    "speaker": "派蒙",
                    "text": "怎么没完了！"
                },
                {
                    "id": "760310307",
                    "speaker": "菈乌玛",
                    "text": "……"
                },
                {
                    "id": "760310308",
                    "speaker": "菈乌玛",
                    "text": "…辛苦了。我稍微出去一会儿，马上回来。"
                },
                {
                    "id": "760310309",
                    "speaker": "菈乌玛",
                    "text": "……"
                },
                {
                    "id": "760310310",
                    "speaker": "菈乌玛",
                    "text": "几位，周围没人了，可以出来了。"
                },
                {
                    "id": "760310311",
                    "speaker": "派蒙",
                    "text": "原来你早就发现我们了！"
                },
                {
                    "id": "760310312",
                    "speaker": "菈乌玛",
                    "text": "我怎么可能遗漏「库塔{RUBY#[S]月之少女}尔」散发出的月矩力呢。"
                },
                {
                    "id": "760310313",
                    "speaker": "菈乌玛",
                    "text": "你们…怎么一直跟着我？简直像在…视察我的工作一样。"
                },
                {
                    "id": "760310314",
                    "speaker": "派蒙",
                    "text": "呃…抱…抱歉，只是有件事需要找你，但一直找不到时机…没给你不必要的压力就好…"
                },
                {
                    "id": "760310315",
                    "speaker": "菈乌玛",
                    "text": "这样吗…明白了，我会处理的。"
                },
                {
                    "id": "760310316",
                    "speaker": "派蒙",
                    "text": "老实说，看完你一天的工作，我都有些不好意思再给你添麻烦了。"
                },
                {
                    "id": "760310317",
                    "speaker": "菈乌玛",
                    "text": "这没什么，都是身为「咏月使」应该做的。"
                },
                {
                    "id": "760310318",
                    "speaker": "菈乌玛",
                    "text": "……"
                },
                {
                    "id": "760310319",
                    "speaker": "「少女」",
                    "text": "…嗯？"
                },
                {
                    "id": "760310320",
                    "speaker": "菈乌玛",
                    "text": "…看过这些之后，「库塔{RUBY#[S]月之少女}尔」对如今的「霜月之子」怎么看？"
                },
                {
                    "id": "760310321",
                    "speaker": "「少女」",
                    "text": "……"
                },
                {
                    "id": "760310322",
                    "speaker": "「少女」",
                    "text": "和几百年前完全不一样的氛围。好的方面。"
                },
                {
                    "id": "760310323",
                    "speaker": "菈乌玛",
                    "text": "是吗…谢谢你这么说。"
                },
                {
                    "id": "760310324",
                    "speaker": "「少女」",
                    "text": "把手给我。"
                },
                {
                    "id": "760310325",
                    "speaker": "「少女」",
                    "text": "#你也是，{NICKNAME}。"
                },
                {
                    "id": "760310326",
                    "speaker": "菈乌玛",
                    "text": "…欸？这是…为什么？"
                },
                {
                    "id": "760310327",
                    "speaker": "「少女」",
                    "text": "我喜欢你现在的祷词。"
                },
                {
                    "id": "760310328",
                    "speaker": "「少女」",
                    "text": "…月光联系着你我，不论日夜。"
                }
            ]
        },
        {
