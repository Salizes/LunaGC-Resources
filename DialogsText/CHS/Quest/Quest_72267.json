    "talks": [
        {
            "id": "7226702",
            "objective": "",
            "dialogues": [
                {
                    "id": "722670201",
                    "speaker": "碑文",
                    "text": "（石碑上用能看懂的语言写着提示…）"
                },
                {
                    "id": "722670202",
                    "speaker": "碑文",
                    "text": "我的父亲告诉我，任何行为都应有背后的道义和人前的优雅。"
                },
                {
                    "id": "722670203",
                    "speaker": "碑文",
                    "text": "所以他说，要我用这样的语言记录我给出的迷宫提示。"
                },
                {
                    "id": "722670204",
                    "speaker": "碑文",
                    "text": "只有在常夜里，迷宫的墙壁和打开通路的机关，才会出现。因为他们沐浴着看不见的月光。"
                },
                {
                    "id": "722670205",
                    "speaker": "碑文",
                    "text": "而那被叫做谜底的机关，正藏在迷宫的四角。"
                },
                {
                    "id": "722670206",
                    "speaker": "碑文",
                    "text": "因为我写到最后并不押韵也没有修辞…"
                },
                {
                    "id": "722670207",
                    "speaker": "碑文",
                    "text": "我的父亲，欧律达特，用拐杖打我的屁股。"
                }
            ]
        },
        {
            "id": "7226799",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "722679901",
                    "speaker": "派蒙",
                    "text": "哦哦，迷宫只要在上顶上往下看，不就什么难度都没有了吗？嗯嗯，就这么办吧。"
                }
            ]
        }
    ]
}