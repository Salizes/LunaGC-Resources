    "talks": [
        {
            "id": "7226101",
            "objective": "(test)在活动界面接取第4天任务$HIDDEN",
            "dialogues": [
                {
                    "id": "722610101",
                    "speaker": "派蒙",
                    "text": "喂——理水叠山真君——"
                },
                {
                    "id": "722610102",
                    "speaker": "「吉法师」",
                    "text": "喂——理理真——"
                },
                {
                    "id": "722610103",
                    "speaker": "派蒙",
                    "text": "……"
                },
                {
                    "id": "722610104",
                    "speaker": "派蒙",
                    "text": "伤脑筋，仙人好像不在哪…"
                },
                {
                    "id": "722610105",
                    "speaker": "Player",
                    "text": "对仙人不能无礼。"
                },
                {
                    "id": "722610106",
                    "speaker": "「吉法师」",
                    "text": "派蒙，仙人是什么？"
                },
                {
                    "id": "722610107",
                    "speaker": "派蒙",
                    "text": "嗯…应该说是很特别的人，或者是动物吧？"
                },
                {
                    "id": "722610108",
                    "speaker": "「吉法师」",
                    "text": "就像吉法师？"
                },
                {
                    "id": "722610109",
                    "speaker": "派蒙",
                    "text": "不对不对！应该说，有神奇的力量…"
                },
                {
                    "id": "722610110",
                    "speaker": "「吉法师」",
                    "text": "也会砰砰？那，吉法师也是仙人。"
                },
                {
                    "id": "722610111",
                    "speaker": "派蒙",
                    "text": "唔…仙人，是更加古老、更有威严的…"
                },
                {
                    "id": "722610112",
                    "speaker": "「吉法师」",
                    "text": "知道了，吉法师不是仙人。五百藏是仙人！"
                },
                {
                    "id": "722610113",
                    "speaker": "派蒙",
                    "text": "呜哇，要怎么解释…"
                },
                {
                    "id": "722610114",
                    "speaker": "Player",
                    "text": "仙人是守护璃月的古老存在…"
                },
                {
                    "id": "722610115",
                    "speaker": "「吉法师」",
                    "text": "吉法师知道了。五百藏守护的是镇守之森，所以不是仙人。"
                },
                {
                    "id": "722610116",
                    "speaker": "派蒙",
                    "text": "虽然道理不是这么一回事，不过能撇清误会就好…"
                },
                {
                    "id": "722610117",
                    "speaker": "派蒙",
                    "text": "不过难得眼前有仙府，就在这里给吉法师拍照吧！"
                },
                {
                    "id": "722610118",
                    "speaker": "「吉法师」",
                    "text": "呶！吉法师乖乖站好拍照。"
                },
                {
                    "id": "722610119",
                    "speaker": "派蒙",
                    "text": "吉法师乖！"
                }
            ]
        },
        {
            "id": "7226102",
            "objective": "前往琥牢山的仙家洞府",
            "dialogues": []
        },
        {
            "id": "7226103",
            "objective": "为吉法师拍照",
            "dialogues": []
        },
        {
            "id": "7226104",
            "objective": "与吉法师对话",
            "dialogues": [
                {
                    "id": "722610201",
                    "speaker": "派蒙",
                    "text": "拍得真好！"
                },
                {
                    "id": "722610202",
                    "speaker": "「吉法师」",
                    "text": "呶哈哈，吉法师帅。"
                },
                {
                    "id": "722610203",
                    "speaker": "派蒙",
                    "text": "这孩子，一点也不谦虚…"
                },
                {
                    "id": "722610204",
                    "speaker": "「吉法师」",
                    "text": "对了，派蒙。仙人有什么法术？"
                },
                {
                    "id": "722610205",
                    "speaker": "派蒙",
                    "text": "仙人的力量很强的！不过要具体举例的话…"
                },
                {
                    "id": "722610206",
                    "speaker": "Player",
                    "text": "这周边的琥珀吧。"
                },
                {
                    "id": "722610207",
                    "speaker": "「吉法师」",
                    "text": "琥珀，那是什么？"
                },
                {
                    "id": "722610208",
                    "speaker": "派蒙",
                    "text": "嗯！我记得是说，理水叠山真君有能生出琥珀的花，把入侵的坏东西都困在里面。"
                },
                {
                    "id": "722610209",
                    "speaker": "「吉法师」",
                    "text": "理理真好厉害。守护璃月，所以把坏东西困住。"
                },
                {
                    "id": "722610210",
                    "speaker": "「吉法师」",
                    "text": "好久好久以前，有很坏很坏的绪方四鬼，闯到森林里到处打打。欺负狸子。五百藏变成公家大人的样子，给他们吃妖狸饭。"
                },
                {
                    "id": "722610211",
                    "speaker": "「吉法师」",
                    "text": "后来，和御伽大王一起，把他们丢到画纸里，封印了。"
                },
                {
                    "id": "722610212",
                    "speaker": "派蒙",
                    "text": "还有这样的故事啊。难怪五百藏看到吉法师相片的时候，吓得不轻。"
                },
                {
                    "id": "722610213",
                    "speaker": "「吉法师」",
                    "text": "五百藏不是仙人，不保护璃月。但五百藏保护森林，保护狸子。"
                },
                {
                    "id": "722610214",
                    "speaker": "Player",
                    "text": "不同的人，要保护不同的东西。"
                },
                {
                    "id": "722610215",
                    "speaker": "「吉法师」",
                    "text": "呶？"
                },
                {
                    "id": "722610216",
                    "speaker": "Player",
                    "text": "吉法师长大以后就知道了。"
                },
                {
                    "id": "722610217",
                    "speaker": "派蒙",
                    "text": "所以，吉法师要努力修行，变成了不起的大妖狸！"
                },
                {
                    "id": "722610218",
                    "speaker": "「吉法师」",
                    "text": "呶！当然了。名震天下的妖狸吉法师！"
                },
                {
                    "id": "722610219",
                    "speaker": "派蒙",
                    "text": "很好奇五百藏没被封印的时候的样子呢！感觉应该很好玩。"
                },
                {
                    "id": "722610220",
                    "speaker": "派蒙",
                    "text": "啊，突然想起，之前也有盗宝团的人被琥珀定身…"
                },
                {
                    "id": "722610221",
                    "speaker": "Player",
                    "text": "我们还被当成了「仙使」。"
                },
                {
                    "id": "722610222",
                    "speaker": "派蒙",
                    "text": "感觉是好久以前发生的事情了呢…但好像，也没有过多久？"
                },
                {
                    "id": "722610223",
                    "speaker": "「吉法师」",
                    "text": "呶？"
                },
                {
                    "id": "722610224",
                    "speaker": "派蒙",
                    "text": "咳咳。我们来到璃月之后…"
                },
                {
                    "id": "722610225",
                    "speaker": "派蒙",
                    "text": "#「是一年一度的请仙典仪耶。哇哈哈，我{NICKNAME}应该可以吃好多好多好吃的。派蒙，我们走！」"
                },
                {
                    "id": "722610226",
                    "speaker": "Player",
                    "text": "「还有贡品！我派蒙马上飞过去！」"
                },
                {
                    "id": "722610227",
                    "speaker": "「吉法师」",
                    "text": "？？"
                },
                {
                    "id": "722610228",
                    "speaker": "Player",
                    "text": "别乱说…"
                },
                {
                    "id": "722610229",
                    "speaker": "派蒙",
                    "text": "好啦…"
                },
                {
                    "id": "722610230",
                    "speaker": "Black Screen",
                    "text": "以比较简单的语言讲述了一些在璃月的冒险经历，\\n一直讲到在珉林绝云地方寻访众仙为止。"
                },
                {
                    "id": "722610231",
                    "speaker": "派蒙",
                    "text": "#…接下来的事情，就是我和{NICKNAME}，一起去之前那个「琉璃亭」吃饭啦。"
                },
                {
                    "id": "722610232",
                    "speaker": "「吉法师」",
                    "text": "理理真好厉害，留留真也好厉害！还能做出会动的房子！"
                },
                {
                    "id": "722610233",
                    "speaker": "派蒙",
                    "text": "留留真…呸，留云借风真君好像也很喜欢美食呢！当时，做了好多菜才见到她。"
                },
                {
                    "id": "722610234",
                    "speaker": "「吉法师」",
                    "text": "好贪吃哦，像派蒙。",
                    "choices": [
                        {
                            "id": "722610235",
                            "text": "这点确实像派蒙。",
                            "response": [
                                {
                                    "id": "722610237",
                                    "speaker": "派蒙",
                                    "text": "喂！"
                                },
                                {
                                    "id": "722610238",
                                    "speaker": "「吉法师」",
                                    "text": "派蒙是仙人？派蒙好厉害。"
                                },
                                {
                                    "id": "722610239",
                                    "speaker": "派蒙",
                                    "text": "呜哇，心情好复杂。虽然被吉法师夸了，但感觉又很不是滋味…"
                                },
                                {
                                    "id": "722610240",
                                    "speaker": "派蒙",
                                    "text": "不过，派蒙不是仙人啦！"
                                },
                                {
                                    "id": "722610241",
                                    "speaker": "「吉法师」",
                                    "text": "想和仙人玩！"
                                },
                                {
                                    "id": "722610242",
                                    "speaker": "派蒙",
                                    "text": "仙人一般不会随意现身…不过，四处看看也挺好的。"
                                },
                                {
                                    "id": "722610243",
                                    "speaker": "「吉法师」",
                                    "text": "吉法师出发！"
                                }
                            ]
                        },
                        {
                            "id": "722610236",
                            "text": "而且也会飞。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7226105",
            "objective": "跟随吉法师",
            "dialogues": []
        },
        {
            "id": "7226106",
            "objective": "寻找吉法师",
            "dialogues": []
        },
        {
            "id": "7226107",
            "objective": "与吉法师对话",
            "dialogues": [
                {
                    "id": "722610401",
                    "speaker": "派蒙",
                    "text": "幸好找到了…吉法师，你没受伤吧？"
                },
                {
                    "id": "722610402",
                    "speaker": "「吉法师」",
                    "text": "呜呜…"
                },
                {
                    "id": "722610403",
                    "speaker": "派蒙",
                    "text": "没事就好，没事就好。不过，以后别乱跑啦。",
                    "choices": [
                        {
                            "id": "722610404",
                            "text": "派蒙好像姐姐。",
                            "response": [
                                {
                                    "id": "722610405",
                                    "speaker": "派蒙",
                                    "text": "派蒙本来就比吉法师大，当然是姐姐啦。"
                                },
                                {
                                    "id": "722610406",
                                    "speaker": "Player",
                                    "text": "倒不太看得出来…"
                                },
                                {
                                    "id": "722610407",
                                    "speaker": "派蒙",
                                    "text": "喂！"
                                },
                                {
                                    "id": "722610412",
                                    "speaker": "「吉法师」",
                                    "text": "#呜呶呶。谢谢{NICKNAME}，谢谢派蒙。"
                                },
                                {
                                    "id": "722610413",
                                    "speaker": "「吉法师」",
                                    "text": "还以为，吉法师又被封印了哩，很害怕。但是，能听见派蒙在叫吉法师，所以又没那么害怕。"
                                },
                                {
                                    "id": "722610414",
                                    "speaker": "派蒙",
                                    "text": "啊，五百藏说过，有的小狸子也曾经被封印过…"
                                },
                                {
                                    "id": "722610415",
                                    "speaker": "「吉法师」",
                                    "text": "琥珀里好可怕。都是黑色的，什么都看不见，没办法说话，也不能动、不能砰砰。就像变成石头一样。"
                                },
                                {
                                    "id": "722610416",
                                    "speaker": "「吉法师」",
                                    "text": "五百藏就算变成石头，也很厉害，所以可以说话、可以看见。但还是不能动。",
                                    "choices": [
                                        {
                                            "id": "722610417",
                                            "text": "吉法师想帮助五百藏？",
                                            "response": [
                                                {
                                                    "id": "722610418",
                                                    "speaker": "「吉法师」",
                                                    "text": "嗯。然后，还帮助其他还在石头里的妖狸。"
                                                },
                                                {
                                                    "id": "722610419",
                                                    "speaker": "派蒙",
                                                    "text": "不过，现在我们在吉法师身边，我们不会让你被封印的！"
                                                },
                                                {
                                                    "id": "722610422",
                                                    "speaker": "「吉法师」",
                                                    "text": "耶！"
                                                },
                                                {
                                                    "id": "722610423",
                                                    "speaker": "派蒙",
                                                    "text": "不过，吉法师要听话，不要太调皮才行。"
                                                },
                                                {
                                                    "id": "722610424",
                                                    "speaker": "「吉法师」",
                                                    "text": "嗯。知道了。"
                                                },
                                                {
                                                    "id": "722610425",
                                                    "speaker": "派蒙",
                                                    "text": "好乖好乖。那今天就先到此为止吧？吉法师也累了吧，该休息了。"
                                                },
                                                {
                                                    "id": "722610426",
                                                    "speaker": "「吉法师」",
                                                    "text": "吉法师不累！"
                                                },
                                                {
                                                    "id": "722610427",
                                                    "speaker": "派蒙",
                                                    "text": "哎呀，真伤脑筋。要是吉法师不听话，派蒙就不知道之后去哪修行了呢…"
                                                },
                                                {
                                                    "id": "722610428",
                                                    "speaker": "「吉法师」",
                                                    "text": "呶…"
                                                },
                                                {
                                                    "id": "722610429",
                                                    "speaker": "Black Screen",
                                                    "text": "虽然不太情愿，但吉法师似乎也玩累了…"
                                                },
                                                {
                                                    "id": "722610430",
                                                    "speaker": "派蒙",
                                                    "text": "哎呀，吉法师真是和小孩子一样。"
                                                },
                                                {
                                                    "id": "722610431",
                                                    "speaker": "Player",
                                                    "text": "派蒙对付小孩子越来越熟练了。"
                                                },
                                                {
                                                    "id": "722610432",
                                                    "speaker": "派蒙",
                                                    "text": "是吗？毕竟和你一起旅行这么久了，嘿嘿。",
                                                    "choices": [
                                                        {
                                                            "id": "722610433",
                                                            "text": "当我是小孩子喔？",
                                                            "response": [
                                                                {
                                                                    "id": "722610434",
                                                                    "speaker": "派蒙",
                                                                    "text": "不是啦！我们不是一起陪很多小孩子玩过吗？像是小冥、畅畅…"
                                                                },
                                                                {
                                                                    "id": "722610437",
                                                                    "speaker": "派蒙",
                                                                    "text": "跟你一起旅行，确实能学到很多事情呢。"
                                                                },
                                                                {
                                                                    "id": "722610438",
                                                                    "speaker": "派蒙",
                                                                    "text": "嗯~这次学到的是…妖狸和仙人，不一定合得来。"
                                                                },
                                                                {
                                                                    "id": "722610439",
                                                                    "speaker": "派蒙",
                                                                    "text": "接下来，要好好想想下一个目的地…"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "722610435",
                                                            "text": "确实一起照顾过很多小孩子。",
                                                            "response": [
                                                                {
                                                                    "id": "722610436",
                                                                    "speaker": "派蒙",
                                                                    "text": "嗯，我们一起陪很多小孩子玩过！像是小冥、畅畅…"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "722610420",
                                            "text": "我们会保护吉法师的。",
                                            "response": [
                                                {
                                                    "id": "722610421",
                                                    "speaker": "派蒙",
                                                    "text": "嗯！有我们在，不会让吉法师被封印的！"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "722610408",
                            "text": "派蒙好像妈妈。",
                            "response": [
                                {
                                    "id": "722610409",
                                    "speaker": "派蒙",
                                    "text": "喂！"
                                }
                            ]
                        },
                        {
                            "id": "722610410",
                            "text": "派蒙好像老奶奶。",
                            "response": [
                                {
                                    "id": "722610411",
                                    "speaker": "派蒙",
                                    "text": "#「{NICKNAME}，再多吃点。还在长身体呢，不多吃点，怎么长高。」"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}