    "talks": [
        {
            "id": "7566001",
            "objective": "(test)隐藏环对话$HIDDEN",
            "dialogues": [
                {
                    "id": "756600101",
                    "speaker": "希诺宁",
                    "text": "呼…天气还不错，这次散心来得挺值。"
                },
                {
                    "id": "756600102",
                    "speaker": "希诺宁",
                    "text": "嗯？这不是我们的骄傲「杜{RUBY#[D]希望}麦尼」吗？",
                    "choices": [
                        {
                            "id": "756600103",
                            "text": "好巧啊。",
                            "response": [
                                {
                                    "id": "756600105",
                                    "speaker": "Black Screen",
                                    "text": "向希诺宁说明了伊拉德和考核关卡的事…"
                                },
                                {
                                    "id": "756600106",
                                    "speaker": "希诺宁",
                                    "text": "原来是这样…差点忘了，之前我确实帮了她一把，「回声之子」的考核关卡刚好也在这附近。"
                                },
                                {
                                    "id": "756600107",
                                    "speaker": "希诺宁",
                                    "text": "一开始，伊拉德只请到了「赭石之灾」恩孔加和「塞提阿德的砂刃」阿姆鲁给参考。"
                                },
                                {
                                    "id": "756600108",
                                    "speaker": "希诺宁",
                                    "text": "不过那两位对「灵活机动」没什么兴趣，只顾着强调正面对决，提出的设计建议都有些偏了。"
                                },
                                {
                                    "id": "756600109",
                                    "speaker": "希诺宁",
                                    "text": "帕加尔听说了这事，就来请我出主意。",
                                    "choices": [
                                        {
                                            "id": "756600110",
                                            "text": "那么，现在的关卡是你的作品？",
                                            "response": [
                                                {
                                                    "id": "756600111",
                                                    "speaker": "希诺宁",
                                                    "text": "差不多吧，我和帕加尔和伊拉德讨论了之后，还是决定略微修改一下我们部族的关卡构造。"
                                                },
                                                {
                                                    "id": "756600112",
                                                    "speaker": "希诺宁",
                                                    "text": "现在，这些关卡更考验战士赶往有利位置，以及不断在战线支点转移的意识。",
                                                    "choices": [
                                                        {
                                                            "id": "756600116",
                                                            "text": "那就让我来接受你的考验吧！",
                                                            "response": [
                                                                {
                                                                    "id": "756600118",
                                                                    "speaker": "希诺宁",
                                                                    "text": "你的实力整个纳塔都有目共睹，无论是什么样的关卡，应该都难不住你。"
                                                                },
                                                                {
                                                                    "id": "756600119",
                                                                    "speaker": "希诺宁",
                                                                    "text": "喏，关卡就在那边，有兴趣的话就去试试看吧。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "756600117",
                                                            "text": "希望希诺宁的关卡不要太难…"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "756600113",
                                            "text": "你这位名匠还真是什么都造…",
                                            "response": [
                                                {
                                                    "id": "756600114",
                                                    "speaker": "希诺宁",
                                                    "text": "只是一些简单的装置，造起来也没什么困难。"
                                                },
                                                {
                                                    "id": "756600115",
                                                    "speaker": "希诺宁",
                                                    "text": "要是忙活这么一次，「回声之子」就能不断涌现出新的强者，我也能清闲点，把手头堆积的单子慢慢搞定…",
                                                    "choices": [
                                                        {
                                                            "id": "756600116",
                                                            "text": "那就让我来接受你的考验吧！"
                                                        },
                                                        {
                                                            "id": "756600117",
                                                            "text": "希望希诺宁的关卡不要太难…"
                                                        }
                                                    ]
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "756600104",
                            "text": "我接了伊拉德小姐的委托。"
                        }
                    ]
                }
            ]
        }
    ]
}