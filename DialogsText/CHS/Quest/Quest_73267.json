            "title": ""
        },
        "total_dialogue_lines": 146,
        "total_speaker_counts": {
            "Player": 24,
            "卡里玛": 12,
            "派蒙": 2,
            "福迪尔": 14,
            "艾登": 17,
            "萨尼娅": 6,
            "阿提亚": 71
        }
    },
    "talks": [
        {
            "id": "7326701",
            "objective": "与阿提亚对话$HIDDEN",
            "dialogues": [
                {
                    "id": "732670101",
                    "speaker": "阿提亚",
                    "text": "加入镀金旅团！拥抱美好生活！这位朋友，有没有兴趣了解一下我们镀金旅团啊？"
                },
                {
                    "id": "732670102",
                    "speaker": "Player",
                    "text": "呃…"
                },
                {
                    "id": "732670103",
                    "speaker": "阿提亚",
                    "text": "咳，你听我说啊。镀金旅团可是个好地方，自由！团结！友好！"
                },
                {
                    "id": "732670104",
                    "speaker": "阿提亚",
                    "text": "而且还能从住在树上的那些家伙的腰包里掏钱出来。教令院的学者们都可有钱了，绝对不会拖欠…",
                    "choices": [
                        {
                            "id": "732670105",
                            "text": "我已经加入冒险家协会了。",
                            "response": [
                                {
                                    "id": "732670107",
                                    "speaker": "阿提亚",
                                    "text": "呃…冒险家协会…那…那也不耽误嘛！这年头谁没个兼职，而且冒险家和佣兵感觉上也，也差不多…"
                                },
                                {
                                    "id": "732670108",
                                    "speaker": "Player",
                                    "text": "还是差挺多的啦。"
                                },
                                {
                                    "id": "732670109",
                                    "speaker": "阿提亚",
                                    "text": "唉，不过我们的伙食也很好啊，隔三差五就有鱼有肉的。"
                                },
                                {
                                    "id": "732670110",
                                    "speaker": "阿提亚",
                                    "text": "而且如果你运气好的话，甚至能和那位「炽鬃之狮」迪希雅说上话呢！我…咳咳…咳咳…",
                                    "choices": [
                                        {
                                            "id": "732670111",
                                            "text": "你喝点水…",
                                            "response": [
                                                {
                                                    "id": "732670113",
                                                    "speaker": "阿提亚",
                                                    "text": "呼…呃…抱歉抱歉，刚才说太急了。"
                                                },
                                                {
                                                    "id": "732670114",
                                                    "speaker": "阿提亚",
                                                    "text": "好不容易有个人愿意听我宣传，我太激动了一点…"
                                                },
                                                {
                                                    "id": "732670115",
                                                    "speaker": "阿提亚",
                                                    "text": "不过，你真的不考虑加入镀金旅团吗？",
                                                    "choices": [
                                                        {
                                                            "id": "732670116",
                                                            "text": "暂时没这打算。",
                                                            "response": [
                                                                {
                                                                    "id": "732670118",
                                                                    "speaker": "阿提亚",
                                                                    "text": "好吧，既然你都这么说了…"
                                                                },
                                                                {
                                                                    "id": "732670119",
                                                                    "speaker": "Player",
                                                                    "text": "你一直在这里招人吗？"
                                                                },
                                                                {
                                                                    "id": "732670120",
                                                                    "speaker": "阿提亚",
                                                                    "text": "是啊，这是我的工作嘛。这年头哪里都缺人，我们佣兵这行更是格外缺人。"
                                                                },
                                                                {
                                                                    "id": "732670121",
                                                                    "speaker": "阿提亚",
                                                                    "text": "唉…和你说应该没什么关系。你看着我们镀金旅团人多，但佣兵这行太危险了啊，护送商队这类的活还好，顶多是累点…"
                                                                },
                                                                {
                                                                    "id": "732670122",
                                                                    "speaker": "阿提亚",
                                                                    "text": "但要是出一趟和学者们有关的活，那真是全程都把脑袋别裤腰带上，跑一趟活回来，只要不缺胳膊少腿就谢天谢地了…"
                                                                },
                                                                {
                                                                    "id": "732670123",
                                                                    "speaker": "阿提亚",
                                                                    "text": "一般的兄弟跑完这种活回来，少说也要歇个十天半月，那他的这个空就要有人补上。"
                                                                },
                                                                {
                                                                    "id": "732670124",
                                                                    "speaker": "阿提亚",
                                                                    "text": "须弥这么大，学者这么多，每天都不断地有新活进来，我们几乎都在连轴转了…"
                                                                },
                                                                {
                                                                    "id": "732670125",
                                                                    "speaker": "阿提亚",
                                                                    "text": "再不招点人，我们可真是要撑不住了。"
                                                                },
                                                                {
                                                                    "id": "732670126",
                                                                    "speaker": "Player",
                                                                    "text": "那你招到人了吗？"
                                                                },
                                                                {
                                                                    "id": "732670127",
                                                                    "speaker": "阿提亚",
                                                                    "text": "你说这个村子吗？哈哈…一个人都没招到。"
                                                                },
                                                                {
                                                                    "id": "732670128",
                                                                    "speaker": "阿提亚",
                                                                    "text": "呃…也不能说是没招到吧，只能说，想招的人不想来，想来的人招不得…"
                                                                },
                                                                {
                                                                    "id": "732670129",
                                                                    "speaker": "阿提亚",
                                                                    "text": "你要是不信，就跟着我走一圈吧…说不定走完这一趟，你就愿意加入我们了。"
                                                                },
                                                                {
                                                                    "id": "732670130",
                                                                    "speaker": "阿提亚",
                                                                    "text": "…哎呀，开个玩笑嘛，你都说了不想加入了，我也不会勉强你。我就是想找个人陪我到处走走而已。"
                                                                },
                                                                {
                                                                    "id": "732670132",
                                                                    "speaker": "Player",
                                                                    "text": "陪你走走倒是没问题。"
                                                                },
                                                                {
                                                                    "id": "732670131",
                                                                    "speaker": "阿提亚",
                                                                    "text": "嘿嘿，谢谢你啦。我看看啊，这个…我们先去找萨尼娅好了，她白天应该有空，晚上嘛…她还要忙着和杰巴里讨论生活大事呢。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "732670117",
                                                            "text": "冒险家协会的事就够多了。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "732670112",
                                            "text": "你这套说得挺熟练啊…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "732670106",
                            "text": "我已经有很多委托要做了。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7326702",
            "objective": "等到白天（6点至19点）",
            "dialogues": []
        },
        {
            "id": "7326703",
            "objective": "与萨尼娅对话",
            "dialogues": [
                {
                    "id": "732670301",
                    "speaker": "萨尼娅",
                    "text": "真让人发愁…"
                },
                {
                    "id": "732670302",
                    "speaker": "阿提亚",
                    "text": "萨尼娅！上午好啊，你在选什么呢？"
                },
                {
                    "id": "732670303",
                    "speaker": "萨尼娅",
                    "text": "阿提亚…我都说过了，杰巴里对镀金旅团没什么兴趣，我也不想他去做什么佣兵，你就别想让我帮着你说话了。"
                },
                {
                    "id": "732670304",
                    "speaker": "阿提亚",
                    "text": "哎呀，杰巴里的厨艺那么好，去镀金旅团里准能混个好职位，你们家的收入也会好很多啊。"
                },
                {
                    "id": "732670305",
                    "speaker": "阿提亚",
                    "text": "而且他不也说过，想要外出找点活干吗？如果他真想外出工作，有我这个熟人介绍当然是最好的啊。"
                },
                {
                    "id": "732670306",
                    "speaker": "萨尼娅",
                    "text": "你就听他说吧，他隔一段时间就会说一次这种话，过几天就再反悔。"
                },
                {
                    "id": "732670307",
                    "speaker": "萨尼娅",
                    "text": "说到最后，他就是舍不得我一个人待在村里…我也舍不得他一个人出去打拼。"
                },
                {
                    "id": "732670308",
                    "speaker": "萨尼娅",
                    "text": "更何况，是每天都去玩命的佣兵！所以你就别想了，就算杰巴里想去，我也会拦着他的。"
                },
                {
                    "id": "732670309",
                    "speaker": "萨尼娅",
                    "text": "好了，话就说到这里，我还要买东西呢，你去找别人吧。"
                },
                {
                    "id": "732670310",
                    "speaker": "阿提亚",
                    "text": "呼…好吧。旅行者， 你看见了吧，这就是我每天工作的状况。"
                },
                {
                    "id": "732670311",
                    "speaker": "阿提亚",
                    "text": "我们接下来去找福迪尔吧，他…曾经是我们的人，但后来退出了。"
                },
                {
                    "id": "732670312",
                    "speaker": "阿提亚",
                    "text": "要是我能把他劝回来，那就再好不过了…"
                }
            ]
        },
        {
            "id": "7326705",
            "objective": "和福迪尔对话",
            "dialogues": [
                {
                    "id": "732670501",
                    "speaker": "福迪尔",
                    "text": "阿提亚，你怎么又来了。"
                },
                {
                    "id": "732670502",
                    "speaker": "阿提亚",
                    "text": "嘿嘿，百折不挠是咱们镀金旅团的优良品质嘛。"
                },
                {
                    "id": "732670503",
                    "speaker": "福迪尔",
                    "text": "那你也应该知道，坚持原则更是我的处事方法。"
                },
                {
                    "id": "732670504",
                    "speaker": "阿提亚",
                    "text": "福迪尔大哥…"
                },
                {
                    "id": "732670505",
                    "speaker": "福迪尔",
                    "text": "我已经退出镀金旅团了，你不用这么称呼我。"
                },
                {
                    "id": "732670506",
                    "speaker": "阿提亚",
                    "text": "唉，福迪尔先生。你真的不考虑回去看看吗？"
                },
                {
                    "id": "732670507",
                    "speaker": "阿提亚",
                    "text": "虽然有些兄弟的作风是有点…呃…冒进，但还是有很多兄弟遵纪守法啊。"
                },
                {
                    "id": "732670508",
                    "speaker": "福迪尔",
                    "text": "阿提亚，我说过了，我不会再回去。"
                },
                {
                    "id": "732670509",
                    "speaker": "福迪尔",
                    "text": "你说的那些事情，我都已经用我自己的眼睛确认过了。"
                },
                {
                    "id": "732670510",
                    "speaker": "福迪尔",
                    "text": "也许镀金旅团里不全是目无法纪之人，也不是每个镀金旅团成员都喜欢做那些趁火打劫的事…"
                },
                {
                    "id": "732670511",
                    "speaker": "福迪尔",
                    "text": "但阿提亚…恶行会传播。只要有一个人违法乱纪，那他周围的人就会受到影响…"
                },
                {
                    "id": "732670522",
                    "speaker": "福迪尔",
                    "text": "一个人影响一群人，那一群人再不断地开展行动，对更多人造成影响…"
                },
                {
                    "id": "732670523",
                    "speaker": "福迪尔",
                    "text": "阿提亚，这些情况你应该比我更清楚吧。"
                },
                {
                    "id": "732670512",
                    "speaker": "福迪尔",
                    "text": "在这种氛围里…恶行易施啊，阿提亚。"
                },
                {
                    "id": "732670513",
                    "speaker": "阿提亚",
                    "text": "……"
                },
                {
                    "id": "732670514",
                    "speaker": "福迪尔",
                    "text": "你想劝我回去，我也想劝你离开。"
                },
                {
                    "id": "732670515",
                    "speaker": "福迪尔",
                    "text": "也许在你眼里，镀金旅团这个团体虽然称不上有道德，但也不能算是恶劣…但人不能永远生活在灰色地带里。"
                },
                {
                    "id": "732670516",
                    "speaker": "福迪尔",
                    "text": "…这只是我对你的忠告。具体如何，还得你自己做出决断。"
                },
                {
                    "id": "732670517",
                    "speaker": "阿提亚",
                    "text": "我知道的，福迪尔大哥。"
                },
                {
                    "id": "732670518",
                    "speaker": "福迪尔",
                    "text": "嗯。如果你真的退出了…同时也想谋个生计，我会帮你。"
                },
                {
                    "id": "732670519",
                    "speaker": "Player",
                    "text": "你没事吧？"
                },
                {
                    "id": "732670520",
                    "speaker": "阿提亚",
                    "text": "哈哈哈，我就是辩不过福迪尔大哥…"
                },
                {
                    "id": "732670521",
                    "speaker": "阿提亚",
                    "text": "接下来…哈哈，咱们先回去休息一下吧，说了这么多话，我喉咙都痛了。"
                }
            ]
        },
        {
            "id": "7326706",
            "objective": "回去稍微休息片刻",
            "dialogues": [
                {
                    "id": "732670601",
                    "speaker": "艾登",
                    "text": "阿提亚叔叔！你还在招募人加入镀金旅团吗？"
                },
                {
                    "id": "732670602",
                    "speaker": "阿提亚",
                    "text": "艾登，你怎么又跑出来了，和你妈妈说过了吗？"
                },
                {
                    "id": "732670603",
                    "speaker": "艾登",
                    "text": "说过啦！妈妈在工作，我就自己来找卡里玛玩了。"
                },
                {
                    "id": "732670604",
                    "speaker": "卡里玛",
                    "text": "你好呀，阿提亚叔叔。"
                },
                {
                    "id": "732670605",
                    "speaker": "艾登",
                    "text": "阿提亚叔叔，我上次和你说的事，你觉得怎么样？"
                },
                {
                    "id": "732670606",
                    "speaker": "艾登",
                    "text": "我一直都在锻炼，还和卡里玛一起训练了很久…她都已经快要跑不过我啦。"
                },
                {
                    "id": "732670607",
                    "speaker": "卡里玛",
                    "text": "谁跑不过你了，我只不过是那天中饭没有吃饱而已。"
                },
                {
                    "id": "732670608",
                    "speaker": "艾登",
                    "text": "总之，我可是按照你给我制订的计划训练了好久…"
                },
                {
                    "id": "732670609",
                    "speaker": "艾登",
                    "text": "阿提亚叔叔，你今天再给我测试一下吧！看看我够不够格加入镀金旅团！",
                    "choices": [
                        {
                            "id": "732670610",
                            "text": "这就是你说的…",
                            "response": [
                                {
                                    "id": "732670612",
                                    "speaker": "阿提亚",
                                    "text": "咳…好！艾登，今天我就以镀金旅团成员的身份，再次对你进行测验！"
                                },
                                {
                                    "id": "732670613",
                                    "speaker": "艾登",
                                    "text": "好耶！卡里玛，你也来测测看吧，我们一起加油！"
                                },
                                {
                                    "id": "732670614",
                                    "speaker": "卡里玛",
                                    "text": "我可不想加入镀金旅团，我只想留在村里，好好保护大家…"
                                },
                                {
                                    "id": "732670615",
                                    "speaker": "卡里玛",
                                    "text": "不过…让阿提亚叔叔帮我测验一下也不错，我可是向坎蒂丝姐姐请教过锻炼方法的！"
                                },
                                {
                                    "id": "732670616",
                                    "speaker": "艾登",
                                    "text": "欸？！你什么时候…"
                                },
                                {
                                    "id": "732670617",
                                    "speaker": "阿提亚",
                                    "text": "哈哈哈，你们俩这么有活力，很不错！"
                                },
                                {
                                    "id": "732670618",
                                    "speaker": "阿提亚",
                                    "text": "艾登，你也不要瘪着嘴了，有机会的话，我也带着你去向迪希雅请教锻炼方法，怎么样？"
                                },
                                {
                                    "id": "732670619",
                                    "speaker": "艾登",
                                    "text": "真的？！"
                                },
                                {
                                    "id": "732670620",
                                    "speaker": "阿提亚",
                                    "text": "镀金旅团成员说的话，绝对不作假。"
                                },
                                {
                                    "id": "732670621",
                                    "speaker": "阿提亚",
                                    "text": "不过，今天咱们在开始测验之前，就先让这位旅行者来示范一下标准动作吧。",
                                    "choices": [
                                        {
                                            "id": "732670622",
                                            "text": "还有我的事？",
                                            "response": [
                                                {
                                                    "id": "732670623",
                                                    "speaker": "阿提亚",
                                                    "text": "…之前我可没机会做示范啊。我总不可能自己跑去示范，然后把这俩孩子单独留在这里吧，那样也太危险了…这次就拜托你了，旅行者。"
                                                },
                                                {
                                                    "id": "732670626",
                                                    "speaker": "阿提亚",
                                                    "text": "咳，这位旅行者是一位实力强劲的冒险家，我可是好不容易才请过来为你们做示范的。"
                                                },
                                                {
                                                    "id": "732670627",
                                                    "speaker": "阿提亚",
                                                    "text": "艾登，卡里玛，你们两个可要看好了喔。"
                                                },
                                                {
                                                    "id": "732670628",
                                                    "speaker": "艾登",
                                                    "text": "嗯！"
                                                },
                                                {
                                                    "id": "732670629",
                                                    "speaker": "卡里玛",
                                                    "text": "冒险家…是冒险家协会里的那种人吗…"
                                                },
                                                {
                                                    "id": "732670630",
                                                    "speaker": "阿提亚",
                                                    "text": "无论是佣兵还是守卫，在执行任务的时候，都会遇见某些必须先行撤退的情况。"
                                                },
                                                {
                                                    "id": "732670631",
                                                    "speaker": "阿提亚",
                                                    "text": "这个时候，我们往往就需要…跑得越快越好。"
                                                },
                                                {
                                                    "id": "732670632",
                                                    "speaker": "阿提亚",
                                                    "text": "旅行者，就拜托你了，咱们先来演练一下…嗯…迅速撤退的方法吧！"
                                                },
                                                {
                                                    "id": "732670633",
                                                    "speaker": "阿提亚",
                                                    "text": "起点就在那里，就拜托你进行示范了。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "732670624",
                                            "text": "你之前没示范过吗？",
                                            "response": [
                                                {
                                                    "id": "732670625",
                                                    "speaker": "阿提亚",
                                                    "text": "…我之前还得分神照顾这俩孩子，怎么可能去示范什么标准动作。"
                                                },
                                                {
                                                    "id": "732670634",
                                                    "speaker": "阿提亚",
                                                    "text": "…总之，这次就拜托你了，旅行者。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "732670611",
                            "text": "想来的人？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7326707",
            "objective": "为艾登和卡里玛做示范",
            "dialogues": []
        },
        {
            "id": "7326708",
            "objective": "与艾登和卡里玛对话",
            "dialogues": [
                {
                    "id": "732670801",
                    "speaker": "艾登",
                    "text": "喔——"
                },
                {
                    "id": "732670802",
                    "speaker": "卡里玛",
                    "text": "居，居然跑得这么快…"
                },
                {
                    "id": "732670803",
                    "speaker": "阿提亚",
                    "text": "很好！速度很不错，跑得也很稳。"
                },
                {
                    "id": "732670804",
                    "speaker": "阿提亚",
                    "text": "艾登，卡里玛，你们可要记好了。"
                },
                {
                    "id": "732670805",
                    "speaker": "阿提亚",
                    "text": "遇见危险的情况可不要逞强，需要撤退的时候，一定要果断撤退才行。"
                },
                {
                    "id": "732670806",
                    "speaker": "阿提亚",
                    "text": "特别是你，艾登。"
                },
                {
                    "id": "732670807",
                    "speaker": "艾登",
                    "text": "我知道啦——"
                },
                {
                    "id": "732670808",
                    "speaker": "阿提亚",
                    "text": "不错，那我们下一步…就去村外，让你们亲眼见识一下「战斗」的场面吧。"
                },
                {
                    "id": "732670809",
                    "speaker": "艾登",
                    "text": "好耶！爸爸刚给我削了一根木剑，我就带在身上。卡里玛，你呢？"
                },
                {
                    "id": "732670810",
                    "speaker": "卡里玛",
                    "text": "我倒是有一副小弓箭，虽然…妈妈只给我没有箭头的箭。"
                },
                {
                    "id": "732670811",
                    "speaker": "阿提亚",
                    "text": "哈哈哈！没问题，你们又有剑又有弓，而且还有满腔勇气，这些就足够你们踏上冒险之路了。"
                },
                {
                    "id": "732670812",
                    "speaker": "阿提亚",
                    "text": "但是，去了村外之后记得不要乱跑，要时刻待在我和旅行者身边。",
                    "choices": [
                        {
                            "id": "732670813",
                            "text": "你真要带她们出去？",
                            "response": [
                                {
                                    "id": "732670815",
                                    "speaker": "阿提亚",
                                    "text": "…放心吧，那个地方我已经事先踩过点了，只有几只病恹恹的蝎子，几乎没有攻击性，不会有问题的。"
                                },
                                {
                                    "id": "732670816",
                                    "speaker": "阿提亚",
                                    "text": "再说了，不是还有咱们俩在嘛。",
                                    "choices": [
                                        {
                                            "id": "732670817",
                                            "text": "你就把我给算进来了？",
                                            "response": [
                                                {
                                                    "id": "732670819",
                                                    "speaker": "阿提亚",
                                                    "text": "…都到这里了，好人做到底啦旅行者。我也会按照冒险家的规矩，给你准备好报酬的。"
                                                },
                                                {
                                                    "id": "732670820",
                                                    "speaker": "阿提亚",
                                                    "text": "那你们俩准备好，我们这就出发了！"
                                                },
                                                {
                                                    "id": "732670821",
                                                    "speaker": "艾登",
                                                    "text": "喔！"
                                                },
                                                {
                                                    "id": "732670822",
                                                    "speaker": "卡里玛",
                                                    "text": "唔…有点紧张…"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "732670818",
                                            "text": "我答应你什么了吗…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "732670814",
                            "text": "带着两个孩子…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7326709",
            "objective": "打倒所有魔物",
            "dialogues": []
        },
        {
            "id": "7326710",
            "objective": "与艾登和卡里玛对话",
            "dialogues": [
                {
                    "id": "732671001",
                    "speaker": "艾登",
                    "text": "呜…那些蝎子好…好大…根本不敢靠近…"
                },
                {
                    "id": "732671002",
                    "speaker": "卡里玛",
                    "text": "我明明用箭射中它们了，为什么一点反应都没有…"
                },
                {
                    "id": "732671003",
                    "speaker": "卡里玛",
                    "text": "但是…你怎么这么轻松就打倒了它们…",
                    "choices": [
                        {
                            "id": "732671004",
                            "text": "久经锻炼的结果。",
                            "response": [
                                {
                                    "id": "732671006",
                                    "speaker": "卡里玛",
                                    "text": "呜…明明坎蒂丝姐姐说，我已经很有进步了…"
                                },
                                {
                                    "id": "732671007",
                                    "speaker": "阿提亚",
                                    "text": "卡里玛，别这么沮丧嘛，只要每天都进步一点，总有一天你也会拥有强大的实力。"
                                },
                                {
                                    "id": "732671008",
                                    "speaker": "阿提亚",
                                    "text": "艾登也是，只要这么持续锻炼下去，加入镀金旅团也只是时间问题。"
                                },
                                {
                                    "id": "732671009",
                                    "speaker": "艾登",
                                    "text": "唔唔，要是能向迪希雅姐姐当面请教武艺的话…"
                                },
                                {
                                    "id": "732671010",
                                    "speaker": "卡里玛",
                                    "text": "下次见到坎蒂丝姐姐的时候，一定要拜托她再指导我训练！"
                                },
                                {
                                    "id": "732671011",
                                    "speaker": "阿提亚",
                                    "text": "这两个孩子…都很有干劲嘛，哈哈哈哈！",
                                    "choices": [
                                        {
                                            "id": "732671012",
                                            "text": "结果你还是没招到人。",
                                            "response": [
                                                {
                                                    "id": "732671014",
                                                    "speaker": "阿提亚",
                                                    "text": "咳咳…咳…你不要哪壶不开提哪壶啊！"
                                                },
                                                {
                                                    "id": "732671015",
                                                    "speaker": "阿提亚",
                                                    "text": "工作的事就再说吧…而且，我的宣讲又不是没有成效。"
                                                },
                                                {
                                                    "id": "732671016",
                                                    "speaker": "阿提亚",
                                                    "text": "在听了我的宣传后，村里的许多年轻人都想去村外看看呢，虽然…他们都不太想加入镀金旅团。"
                                                },
                                                {
                                                    "id": "732671017",
                                                    "speaker": "阿提亚",
                                                    "text": "先不说这些了，我得带着这两个孩子回村里了，出来这么久，她们家的大人该着急了。"
                                                },
                                                {
                                                    "id": "732671018",
                                                    "speaker": "阿提亚",
                                                    "text": "这些报酬是给你的，谢谢你陪我跑这么一趟，旅行者。"
                                                },
                                                {
                                                    "id": "732671019",
                                                    "speaker": "阿提亚",
                                                    "text": "唉，过段时间我还要回去团里述职，这该怎么交代…"
                                                },
                                                {
                                                    "id": "732671020",
                                                    "speaker": "艾登",
                                                    "text": "对了，阿提亚叔叔，你还没给我们测验呢。"
                                                },
                                                {
                                                    "id": "732671021",
                                                    "speaker": "阿提亚",
                                                    "text": "啊？是…是啊，我们先回去吧，回村之后我再给你们测验一下。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "732671013",
                                            "text": "你的工作怎么办？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "732671005",
                            "text": "你们还小啦。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7326799",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "732679901",
                    "speaker": "派蒙",
                    "text": "简单来说，就是…尽快到达那里就可以了，对吧？"
                },
                {
                    "id": "732679902",
                    "speaker": "派蒙",
                    "text": "意外地很简单啊…都让我有点不习惯了…"
                }
            ]
        }
    ]
}