            "objective": "Additional",
            "dialogues": [
                {
                    "id": "731014001",
                    "speaker": "兰沙诃",
                    "text": "没有兰迦拉梨的「大方方铁块」，最厉害…很难打倒…"
                },
                {
                    "id": "731014002",
                    "speaker": "兰沙诃",
