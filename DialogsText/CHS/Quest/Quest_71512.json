        }
    },
    "talks": [
        {
            "id": "7151201",
            "objective": "与诏勤对话",
            "dialogues": [
                {
                    "id": "715120101",
                    "speaker": "诏勤",
                    "text": "真是…这个地区清理过了吗？呃…应该清理过了…"
                },
                {
                    "id": "715120102",
                    "speaker": "诏勤",
                    "text": "哎哟，真是头疼…"
                },
                {
                    "id": "715120103",
                    "speaker": "诏勤",
                    "text": "呃…你是…旅行者！抱歉抱歉，我忙昏头了，没看见你来了。"
                },
                {
                    "id": "715120104",
                    "speaker": "Player",
                    "text": "你这是在忙什么呢？"
                },
                {
                    "id": "715120105",
                    "speaker": "诏勤",
                    "text": "咳，是这样，今年海灯节，我们璃月港冒险家协会将在总务司的调度下，做一些协助工作。"
                },
                {
                    "id": "715120106",
                    "speaker": "诏勤",
                    "text": "千岩军主要负责城内和一些重点区域的巡逻，而咱们嘛，就负责去野外清扫一些流窜的魔物…还有驱赶那些没事找事的贼匪。"
                },
                {
                    "id": "715120107",
                    "speaker": "诏勤",
                    "text": "对了…说起来，你也是在协会里注册过的冒险家啊，我可是听说过不少你的冒险事迹啊。"
                },
                {
                    "id": "715120108",
                    "speaker": "诏勤",
                    "text": "如果愿意的话，你也来帮我们一把，怎么样？",
                    "choices": [
                        {
                            "id": "715120109",
                            "text": "大过节的…",
                            "response": [
                                {
                                    "id": "715120111",
                                    "speaker": "诏勤",
                                    "text": "咳，这个…因为是在节日期间协助总务司勤务，所以总务司也拨给了我们一批特别款项。"
                                },
                                {
                                    "id": "715120112",
                                    "speaker": "诏勤",
                                    "text": "愿意接受此类委托的冒险家，在完成委托后可以拿到更多的报酬…",
                                    "choices": [
                                        {
                                            "id": "715120113",
                                            "text": "具体…有多少？",
                                            "response": [
                                                {
                                                    "id": "715120114",
                                                    "speaker": "诏勤",
                                                    "text": "相信我，绝对亏待不了你！"
                                                },
                                                {
                                                    "id": "715120123",
                                                    "speaker": "Player",
                                                    "text": "那…我得先看看有多少活要干…"
                                                },
                                                {
                                                    "id": "715120116",
                                                    "speaker": "诏勤",
                                                    "text": "哈哈哈！好！我就知道你不会袖手旁观的，我先把协会确定下来的地点给你标记下来，还有这个小型烟花筒你拿好。"
                                                },
                                                {
                                                    "id": "715120117",
                                                    "speaker": "诏勤",
                                                    "text": "如果你真的愿意接受委托的话…清扫完一片区域后，记得用这个烟花筒发射一枚烟花。"
                                                },
                                                {
                                                    "id": "715120118",
                                                    "speaker": "诏勤",
                                                    "text": "你发射烟花之后，我们派出去的记录员就会把那块区域标注为「已扫除」。"
                                                },
                                                {
                                                    "id": "715120119",
                                                    "speaker": "诏勤",
                                                    "text": "然后，我们会根据整个地块内各个区域的扫除情况来实时调整计划。"
                                                },
                                                {
                                                    "id": "715120120",
                                                    "speaker": "Player",
                                                    "text": "还挺有计划的…"
                                                },
                                                {
                                                    "id": "715120121",
                                                    "speaker": "诏勤",
                                                    "text": "唉…这可是海灯节，可千万不能出问题啊。咱们啊…人人都绷紧着弦呢。"
                                                },
                                                {
                                                    "id": "715120122",
                                                    "speaker": "诏勤",
                                                    "text": "先不说这些了，我得再去看看情况。等会还要去给岚姐报告呢…"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "715120115",
                                            "text": "你…你先给我看看有多少活要干…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "715120110",
                            "text": "海灯节呢…"
                        }
                    ]
                }
            ]
        }
    ]
}