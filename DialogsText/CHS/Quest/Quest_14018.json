    "talks": [
        {
            "id": "1401809",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "140180901",
                    "speaker": "娜维娅",
                    "text": "看来是我多虑了，我也要赶紧振作起来，变得更加可靠。"
                },
                {
                    "id": "140180902",
                    "speaker": "娜维娅",
                    "text": "回想起来，今天这副样子真是有点丢脸，哈哈。",
                    "choices": [
                        {
                            "id": "140180903",
                            "text": "关于众人的礼物…",
                            "response": [
                                {
                                    "id": "140180904",
                                    "speaker": "娜维娅",
                                    "text": "每个人应该都有对别人来说稀松平常，但自己无论如何都得不到的东西吧。"
                                },
                                {
                                    "id": "140180905",
                                    "speaker": "娜维娅",
                                    "text": "对我来说，全家福就是这样的东西，从小我就很羡慕别人…"
                                },
                                {
                                    "id": "140180906",
                                    "speaker": "娜维娅",
                                    "text": "没想到会以这样的形式收到，看来有时候我也挺幸运的嘛。"
                                }
                            ]
                        },
                        {
                            "id": "140180907",
                            "text": "关于克莱门汀…",
                            "response": [
                                {
                                    "id": "140180908",
                                    "speaker": "娜维娅",
                                    "text": "我以前就在想，我母亲希望我能开心地活下去，这其实也是个很高的期望…甚至不亚于我老爹施加给我的那些。"
                                },
                                {
                                    "id": "140180909",
                                    "speaker": "娜维娅",
                                    "text": "这两个人虽然表现出来的性格全然不同，但心底始终都彼此认可。"
                                },
                                {
                                    "id": "140180910",
                                    "speaker": "娜维娅",
                                    "text": "巡轨船是造福整个枫丹的大工程，以「家族」的眼光去衡量与评价未免有点狭隘。"
                                },
                                {
                                    "id": "140180911",
                                    "speaker": "娜维娅",
                                    "text": "所以她才没有阻止我的老爹吧。"
                                }
                            ]
                        },
                        {
                            "id": "140180912",
                            "text": "关于「我真的是你的搭档吗？」…",
                            "response": [
                                {
                                    "id": "140180913",
                                    "speaker": "娜维娅",
                                    "text": "呜哇，你学我干什么！不要这样，不要再说下去了！很难为情的！"
                                },
                                {
                                    "id": "140180914",
                                    "speaker": "娜维娅",
                                    "text": "赶紧忘掉，赶紧忘掉！啊，不对，忘掉也不行…"
                                },
                                {
                                    "id": "140180915",
                                    "speaker": "娜维娅",
                                    "text": "总之，藏在心里，不要再翻出来了！"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}