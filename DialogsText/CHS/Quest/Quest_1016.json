        {
            "id": "101603",
            "objective": "(test)在三碗不过港对话II$HIDDEN",
            "dialogues": [
                {
                    "id": "10160301",
                    "speaker": "钟离",
                    "text": "凝光…甘雨…"
                },
                {
                    "id": "10160302",
                    "speaker": "钟离",
                    "text": "暗流涌动的这些天里，她们所处的位置，究竟是在第几层呢？"
                }
            ]
        },
        {
            "id": "101610",
            "objective": "(test)结束对话$HIDDEN",
            "dialogues": [
                {
                    "id": "10161001",
                    "speaker": "派蒙",
                    "text": "那个自称甘雨的使者，丢下这几句话，就消失了呢…"
                },
                {
                    "id": "10161002",
                    "speaker": "派蒙",
                    "text": "不过，我们居然收到了「璃月七星」的邀请函，真是不可思议。"
                },
                {
                    "id": "10161003",
                    "speaker": "派蒙",
                    "text": "#{NICKNAME}！跟有钱人见面，一定要注意礼仪！",
                    "choices": [
                        {
                            "id": "10161004",
                            "text": "我本来就很讲礼貌。",
                            "response": [
                                {
                                    "id": "10161006",
                                    "speaker": "钟离",
                                    "text": "呵呵…有幸受邀前往「群玉阁」作客的人，确实很少。"
                                },
                                {
                                    "id": "10161007",
                                    "speaker": "钟离",
                                    "text": "你们去吧，不过别忘了「送仙典仪」的事。你们从群玉阁回来以后，我们下一步汇合的地点，是荻花洲。"
                                },
                                {
                                    "id": "10161008",
                                    "speaker": "派蒙",
                                    "text": "嗯，我们不会忘的。约好时间，荻花洲，不见不散！"
                                }
                            ]
                        },
                        {
                            "id": "10161005",
                            "text": "派蒙又在盘算什么主意…"
                        }
                    ]
                }
            ]
        }
    ]
