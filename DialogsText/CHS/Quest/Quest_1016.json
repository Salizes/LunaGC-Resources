    "talks": [
        {
            "id": "101604",
            "objective": "等待约定时间（18点到23点）",
            "dialogues": []
        },
        {
            "id": "101605",
            "objective": "(test)钟离创建隐藏环节$HIDDEN",
            "dialogues": []
        },
        {
            "id": "101601",
            "objective": "前往三碗不过港",
            "dialogues": [
                {
                    "id": "10160101",
                    "speaker": "钟离",
                    "text": "嗯，你们来了。不必点单，我都已经点好了。"
                },
                {
                    "id": "10160102",
                    "speaker": "钟离",
                    "text": "这家「三碗不过港」，可不像蒙德的那些酒馆。在这里，酒肆主人是会拒绝果汁这种「不上道」的东西的。"
                },
                {
                    "id": "10160103",
                    "speaker": "Player",
                    "text": "所以这次，终于能被请一杯酒了？！"
                },
                {
                    "id": "10160104",
                    "speaker": "钟离",
                    "text": "所以这次，我给你点了一碗酒酿圆子。"
                },
                {
                    "id": "10160105",
                    "speaker": "Player",
                    "text": "哈。我也不是猜不到这种结局…"
                },
                {
                    "id": "10160106",
                    "speaker": "田铁嘴",
                    "text": "…各位客官要是愿意听，我就继续讲讲凝光大人的「群玉阁」。"
                },
                {
                    "id": "10160107",
                    "speaker": "派蒙",
                    "text": "哇，这里还有说书人！氛围真好。"
                },
                {
                    "id": "10160108",
                    "speaker": "钟离",
                    "text": "所谓市井盛赞，除了酒好，当然环境也要好。"
                },
                {
                    "id": "10160109",
                    "speaker": "钟离",
                    "text": "但这里所说的「环境」，与「提瓦特游览指南」里评判大酒楼的「环境」，就是两种意思了。"
                },
                {
                    "id": "10160110",
                    "speaker": "田铁嘴",
                    "text": "列位都知道，在咱们这港口上边呀，有那云上仙府、烟霞行宫。"
                },
                {
                    "id": "10160111",
                    "speaker": "田铁嘴",
                    "text": "什么叫手眼通天？您瞧瞧，这就叫手眼通天，这就是凝光大人置办下的通天产业。"
                },
                {
                    "id": "10160112",
                    "speaker": "田铁嘴",
                    "text": "在那天朗气清之时，您从那宫门外的甲板上往下一望——"
                },
                {
                    "id": "10160113",
                    "speaker": "田铁嘴",
                    "text": "好厉害！那就是大半个璃月港的天地风光…"
                },
                {
                    "id": "10160201",
                    "speaker": "田铁嘴",
                    "text": "您且想想，这玩意虽是纸屑，但凝光大人用来决策的「思路」，那得多珍贵呢？"
                },
                {
                    "id": "10160202",
                    "speaker": "田铁嘴",
                    "text": "您要能多抢一两张，这凝光大人指缝里漏出的好处，就能比同行多得一两分喽…"
                },
                {
                    "id": "10160203",
                    "speaker": "派蒙",
                    "text": "「天权」凝光…最近一直听到这个名字。"
                },
                {
                    "id": "10160204",
                    "speaker": "派蒙",
                    "text": "璃月人在谈她，「愚人众」讨厌她，藏「仙祖法蜕」的好像也是她，「请仙典仪」上我们还见过她一面…"
                },
                {
                    "id": "10160205",
                    "speaker": "派蒙",
                    "text": "不知道她究竟是个怎样的人呢？"
                },
                {
                    "id": "10160207",
                    "speaker": "？？？",
                    "text": "终于找到你了，「绝云间归来之人」。"
                },
                {
                    "id": "10160208",
                    "speaker": "派蒙",
                    "text": "谁？！"
                },
                {
                    "id": "10160209",
                    "speaker": "Player",
                    "text": "派蒙，我们走…！"
                },
                {
                    "id": "10160210",
                    "speaker": "？？？",
                    "text": "请等一下。我不是千岩军，也不是前来缉拿你们的捕快。"
                },
                {
                    "id": "10160211",
                    "speaker": "甘雨",
                    "text": "但我的确是「璃月七星」的使者——我是甘雨，月海亭的秘书，为见你们而来。",
                    "choices": [
                        {
                            "id": "10160212",
                            "text": "使者？",
                            "response": [
                                {
                                    "id": "10160214",
                                    "speaker": "甘雨",
                                    "text": "确切地说，本职工作是对「七星」全体负责的秘书，而这次的临时身份，是凝光小姐的特别使者。"
                                },
                                {
                                    "id": "10160215",
                                    "speaker": "派蒙",
                                    "text": "哇，说凝光，凝光…的使者到。"
                                },
                                {
                                    "id": "10160216",
                                    "speaker": "甘雨",
                                    "text": "绝云间归来之人…恕我身处坊间，礼数不周。"
                                },
                                {
                                    "id": "10160217",
                                    "speaker": "甘雨",
                                    "text": "但我带来的这封信，是凝光小姐以「天权」身份，正式拟定的邀请函。"
                                },
                                {
                                    "id": "10160218",
                                    "speaker": "甘雨",
                                    "text": "邀请您前往那座「天上的宫殿」。"
                                },
                                {
                                    "id": "10160219",
                                    "speaker": "派蒙",
                                    "text": "你说…邀请函？"
                                },
                                {
                                    "id": "10160220",
                                    "speaker": "甘雨",
                                    "text": "是的。凝光小姐是这样说的："
                                },
                                {
                                    "id": "10160221",
                                    "speaker": "甘雨",
                                    "text": "#「请{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}来。」"
                                },
                                {
                                    "id": "10160222",
                                    "speaker": "甘雨",
                                    "text": "#「我要见{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}。」"
                                },
                                {
                                    "id": "10160223",
                                    "speaker": "甘雨",
                                    "text": "#「在群玉阁，我会陪{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}一根一根地…剪断繁杂的暗流之线。」"
                                }
                            ]
                        },
                        {
                            "id": "10160213",
                            "text": "秘书？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "101608",
