    "talks": [
        {
            "id": "1505101",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "150450401",
                    "speaker": "玛拉妮",
                    "text": "#{NICKNAME}，派蒙！我带着豚豚球来跟你们问早哦！"
                },
                {
                    "id": "150450402",
                    "speaker": "派蒙",
                    "text": "早啊，玛拉妮，你怎么那么有精神？昨晚玩得最疯的不就是你吗？"
                },
                {
                    "id": "150450403",
                    "speaker": "玛拉妮",
                    "text": "那已经是昨晚的事啦！睡一觉，疲劳就统统扫清！"
                },
                {
                    "id": "150450404",
                    "speaker": "玛拉妮",
                    "text": "喏，收下这个。是纪念册的奖励，我帮你一起领回来了，免得你多跑一趟。"
                },
                {
                    "id": "150450405",
                    "speaker": "派蒙",
                    "text": "噢噢！真贴心啊玛拉妮！"
                },
                {
                    "id": "150450406",
                    "speaker": "玛拉妮",
                    "text": "急人所急，想人所想，才算是个好向导，对吧？"
                },
                {
                    "id": "150450407",
                    "speaker": "玛拉妮",
                    "text": "说到工作，算算时间，假期差不多要结束了。再不回家，我怕我家小狗都要认不出我了。"
                },
                {
                    "id": "150450408",
                    "speaker": "玛拉妮",
                    "text": "我问了问其他人，大家也有各自的牵挂。"
                },
                {
                    "id": "150450409",
                    "speaker": "玛拉妮",
                    "text": "想念家人的，想念蒲公英酒味道的…"
                },
                {
                    "id": "150450410",
                    "speaker": "玛拉妮",
                    "text": "就连恰斯卡嘴上没说什么，一到傍晚，她就翘着腿坐在树梢上，往「花羽会」的方向望了又望。"
                },
                {
                    "id": "150450411",
                    "speaker": "Player",
                    "text": "能够理解…"
                },
                {
                    "id": "150450412",
                    "speaker": "玛拉妮",
                    "text": "所以呀，在这个美妙的夏天结束之前，让我们再做一些有纪念意义的事情吧！"
                },
                {
                    "id": "150450413",
                    "speaker": "玛拉妮",
                    "text": "比如…再拍一张合照！"
                },
                {
                    "id": "150450414",
                    "speaker": "派蒙",
                    "text": "要在这里拍吗？住了那么久，还挺有感情的。"
                },
                {
                    "id": "150450415",
                    "speaker": "玛拉妮",
                    "text": "采纳！再把墙面装饰一番吧，我喊大家过来集合…广场见！"
                }
            ]
        }
    ]
}