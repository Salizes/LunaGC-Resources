    "talks": [
        {
            "id": "7620701",
            "objective": "(test)废弃$HIDDEN",
            "dialogues": [
                {
                    "id": "762070101",
                    "speaker": "纸片人",
                    "text": "(test)终于有人经过了……"
                },
                {
                    "id": "762070102",
                    "speaker": "派蒙",
                    "text": "(test)你还好吗，我们这就救你出来！"
                },
                {
                    "id": "762070103",
                    "speaker": "纸片人",
                    "text": "(test)我被夹在了很多本生物图鉴的里面，打开这些书很危险。"
                },
                {
                    "id": "762070104",
                    "speaker": "Player",
                    "text": "(test)无妨，我们这就救你出来。"
                }
            ]
        },
        {
            "id": "7620702",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "762070201",
                    "speaker": "托萨利斯",
                    "text": "啊…我曾是语言，如今却沦为了错觉破碎的主体，再度回归这不完美的「象征」。"
                },
                {
                    "id": "762070202",
                    "speaker": "派蒙",
                    "text": "呜哇！奇怪的家伙说着奇怪的话从奇怪的书里出现了！"
                },
                {
                    "id": "762070203",
                    "speaker": "托萨利斯",
                    "text": "「奇怪」是一种不严谨的表达。它意味着无法被描述、无法被书写、无法被表征的特殊性主体，而我显然不符合这个定义。"
                },
                {
                    "id": "762070204",
                    "speaker": "托萨利斯",
                    "text": "我不过是试图在书页中寻找通往「实在」的入口，却不慎滑入了无限延宕的隐喻中…"
                },
                {
                    "id": "762070205",
                    "speaker": "托萨利斯",
                    "text": "我成为了无法被象征化的剩余，多亏你的介入，我才得以从语言的暴政中被剥离，可以重新开始误认我自己了。"
                },
                {
                    "id": "762070206",
                    "speaker": "Player",
                    "text": "说人话。"
                },
                {
                    "id": "762070207",
                    "speaker": "托萨利斯",
                    "text": "…我不小心掉进书页里出不来了，谢谢你把我拉出来。"
                }
            ]
        },
        {
            "id": "7620703",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": []
        }
    ]
}