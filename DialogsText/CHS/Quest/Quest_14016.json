    "talks": [
        {
            "id": "1401601",
            "objective": "前往枫丹廷取货",
            "dialogues": [
                {
                    "id": "140160101",
                    "speaker": "娜维娅",
                    "text": "路德温，我来了，这两天生意怎么样？"
                },
                {
                    "id": "140160102",
                    "speaker": "路德温",
                    "text": "等不到刺玫会大小姐的光顾，我这小店马上就要关门倒闭啦。"
                },
                {
                    "id": "140160103",
                    "speaker": "科尔特",
                    "text": "呵呵，都知道你路子广办法多，你开这种玩笑没人信的。不过现在她已经是老板了哦。"
                },
                {
                    "id": "140160104",
                    "speaker": "路德温",
                    "text": "失敬失敬，哎呀，顺口了嘛。"
                },
                {
                    "id": "140160105",
                    "speaker": "路德温",
                    "text": "你们是来取衣服的吗？"
                },
                {
                    "id": "140160106",
                    "speaker": "娜维娅",
                    "text": "对，之前在枫丹廷办事的时候忘记了。"
                },
                {
                    "id": "140160107",
                    "speaker": "路德温",
                    "text": "这点小事，请手下来办也没问题啊，大小姐竟然亲自跑一趟。"
                },
                {
                    "id": "140160108",
                    "speaker": "派蒙",
                    "text": "小题大做一直是娜维娅的风格。"
                },
                {
                    "id": "140160109",
                    "speaker": "娜维娅",
                    "text": "可不是小题大做，散心也是行程中很重要的目的。"
                },
                {
                    "id": "140160110",
                    "speaker": "娜维娅",
                    "text": "没有什么比踏上一段新的旅程更能治愈身心的了。"
                },
                {
                    "id": "140160111",
                    "speaker": "科尔特",
                    "text": "呵呵，老板说的是，至少比一个人闷着要好。"
                },
                {
                    "id": "140160112",
                    "speaker": "路德温",
                    "text": "那你们稍等，我这就去取。"
                },
                {
                    "id": "140160113",
                    "speaker": "派蒙",
                    "text": "对了，为什么阿黛尔想要加入刺玫会呢？"
                },
                {
                    "id": "140160114",
                    "speaker": "娜维娅",
                    "text": "嘿嘿，她还说不清具体的理由，只是说因为很喜欢我。"
                },
                {
                    "id": "140160115",
                    "speaker": "娜维娅",
                    "text": "在那件事之后，她变得开朗了不少，估计是因为她终于知道，她的父亲并不是个让她失望的人。"
                },
                {
                    "id": "140160116",
                    "speaker": "娜维娅",
                    "text": "她说她很害怕我的老爹，所以觉得刺玫会里都是可怕的人。"
                },
                {
                    "id": "140160117",
                    "speaker": "娜维娅",
                    "text": "但现在刺玫会的氛围不一样了，她有勇气和我说话，也觉得我能理解她。"
                },
                {
                    "id": "140160118",
                    "speaker": "Player",
                    "text": "你们有相似的遭遇。"
                },
                {
                    "id": "140160119",
                    "speaker": "娜维娅",
                    "text": "嗯，或许是吧，我在寻找真相的同时也帮助了她。"
                },
                {
                    "id": "140160120",
                    "speaker": "娜维娅",
                    "text": "她说也想要像我一样，去帮助别人，而不是继续等在原地，期待别人朝她伸出援手。"
                },
                {
                    "id": "140160121",
                    "speaker": "科尔特",
                    "text": "听上去，她会成为一个优秀的刺玫会成员。"
                },
                {
                    "id": "140160122",
                    "speaker": "娜维娅",
                    "text": "我也这么认为，但首先，还是要创造一个能让她健康成长的环境吧。等她长大，再把选择权交给她。"
                },
                {
                    "id": "140160123",
                    "speaker": "Player",
                    "text": "（果然不是错觉…）"
                },
                {
                    "id": "140160124",
                    "speaker": "派蒙",
                    "text": "嗯，你怎么了？",
                    "choices": [
                        {
                            "id": "140160125",
                            "text": "跟我来。",
                            "response": [
                                {
                                    "id": "140160127",
                                    "speaker": "派蒙",
                                    "text": "欸？跟、跟踪？！我来了！"
                                },
                                {
                                    "id": "140160128",
                                    "speaker": "娜维娅",
                                    "text": "我也去看看！科尔特，衣服你帮我拿一下！"
                                },
                                {
                                    "id": "140160129",
                                    "speaker": "科尔特",
                                    "text": "哦，好、好的！"
                                }
                            ]
                        },
                        {
                            "id": "140160126",
                            "text": "有人跟踪。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1401602",
            "objective": "追上跟踪者",
            "dialogues": [
                {
                    "id": "140160201",
                    "speaker": "马蒂纳",
                    "text": "嘁，果然麻烦。"
                },
                {
                    "id": "140160202",
                    "speaker": "娜维娅",
                    "text": "看来不给点教训，他们是不打算好好说话了。"
                },
                {
                    "id": "140160203",
                    "speaker": "马蒂纳",
                    "text": "#兄弟们，不绕弯子了，干掉{M#他们}{F#她们}！"
                }
            ]
        },
        {
            "id": "1401603",
            "objective": "击退跟踪者",
            "dialogues": []
        },
        {
            "id": "1401604",
            "objective": "与马蒂纳等人交谈",
            "dialogues": [
                {
                    "id": "140160401",
                    "speaker": "娜维娅",
                    "text": "老实交代，你们是什么人，为什么要跟踪我们！"
                },
                {
                    "id": "140160402",
                    "speaker": "马蒂纳",
                    "text": "……"
                },
                {
                    "id": "140160403",
                    "speaker": "派蒙",
                    "text": "别以为不说话就能蒙混过关！",
                    "choices": [
                        {
                            "id": "140160404",
                            "text": "现状如此，就不要心怀侥幸。",
                            "response": [
                                {
                                    "id": "140160406",
                                    "speaker": "马蒂纳",
                                    "text": "……！"
                                },
                                {
                                    "id": "140160407",
                                    "speaker": "科尔特",
                                    "text": "老板，怎么样，你们没受伤吧？"
                                },
                                {
                                    "id": "140160408",
                                    "speaker": "娜维娅",
                                    "text": "这种程度的敌人，怎么能奈何得了我们呢？"
                                },
                                {
                                    "id": "140160409",
                                    "speaker": "娜维娅",
                                    "text": "好了，不要拖拖拉拉的，赶紧交代。要是执律庭介入，这件事可就没有商量的余地了。"
                                },
                                {
                                    "id": "140160410",
                                    "speaker": "马蒂纳",
                                    "text": "我们…是来找刺玫会寻仇的。"
                                },
                                {
                                    "id": "140160411",
                                    "speaker": "马蒂纳",
                                    "text": "被发现了，又打不过你们，我们认栽。"
                                },
                                {
                                    "id": "140160412",
                                    "speaker": "娜维娅",
                                    "text": "寻仇？难道…你们是那个什么，罗默夫的人吗？"
                                },
                                {
                                    "id": "140160413",
                                    "speaker": "马蒂纳",
                                    "text": "你居然知道这个名字…"
                                },
                                {
                                    "id": "140160414",
                                    "speaker": "马蒂纳",
                                    "text": "那你就应该知道我们的恨来自何处！"
                                },
                                {
                                    "id": "140160415",
                                    "speaker": "Player",
                                    "text": "劝你冷静。"
                                },
                                {
                                    "id": "140160416",
                                    "speaker": "科尔特",
                                    "text": "是的，你们现在毫无胜算。"
                                },
                                {
                                    "id": "140160417",
                                    "speaker": "马蒂纳",
                                    "text": "嘁…"
                                },
                                {
                                    "id": "140160418",
                                    "speaker": "马蒂纳",
                                    "text": "我们喝了点酒，在街上看到了娜维娅，气不打一处来，就想找机会找你们的麻烦。"
                                },
                                {
                                    "id": "140160419",
                                    "speaker": "马蒂纳",
                                    "text": "结果，反倒是被你们先拎出来了。"
                                },
                                {
                                    "id": "140160420",
                                    "speaker": "Player",
                                    "text": "你在撒谎。"
                                },
                                {
                                    "id": "140160421",
                                    "speaker": "马蒂纳",
                                    "text": "啊…？",
                                    "choices": [
                                        {
                                            "id": "140160422",
                                            "text": "你们一路跟踪到城里。",
                                            "response": [
                                                {
                                                    "id": "140160424",
                                                    "speaker": "马蒂纳",
                                                    "text": "很敏锐嘛，但那又怎么样？我们什么都没做，也没对你们做什么的本事。"
                                                },
                                                {
                                                    "id": "140160425",
                                                    "speaker": "马蒂纳",
                                                    "text": "我们只是气血上头，看你们很不爽。"
                                                },
                                                {
                                                    "id": "140160426",
                                                    "speaker": "娜维娅",
                                                    "text": "听着，卡雷斯已经死了，无论刺玫会曾经做过什么，我都希望能有一个新的开始。"
                                                },
                                                {
                                                    "id": "140160427",
                                                    "speaker": "娜维娅",
                                                    "text": "我是刺玫会的现任会长，如果你们的老大有什么意见，我愿意和他直接对话。"
                                                },
                                                {
                                                    "id": "140160428",
                                                    "speaker": "娜维娅",
                                                    "text": "我不会追究你们的责任，这也是我态度的表示。"
                                                },
                                                {
                                                    "id": "140160429",
                                                    "speaker": "马蒂纳",
                                                    "text": "…嗯，谢谢你。你的想法，我会传达给老大。"
                                                },
                                                {
                                                    "id": "140160430",
                                                    "speaker": "娜维娅",
                                                    "text": "但如果你们再敢做类似的事，哪怕是再有类似的想法，我决不轻饶，知道了吗？"
                                                },
                                                {
                                                    "id": "140160431",
                                                    "speaker": "马蒂纳",
                                                    "text": "知道了知道了，喂，我们走。"
                                                },
                                                {
                                                    "id": "140160432",
                                                    "speaker": "派蒙",
                                                    "text": "放走他们真的没问题吗，娜维娅？"
                                                },
                                                {
                                                    "id": "140160433",
                                                    "speaker": "娜维娅",
                                                    "text": "我不想继承我老爹留下的矛盾，而且巡轨船的事，我也不认为他的做法就完全正确。"
                                                },
                                                {
                                                    "id": "140160434",
                                                    "speaker": "娜维娅",
                                                    "text": "如果对方愿意谈，我也是愿意上桌的，很多事情都应该翻开新的一页了。"
                                                },
                                                {
                                                    "id": "140160435",
                                                    "speaker": "科尔特",
                                                    "text": "我也支持老板的做法，以暴制暴是很原始的做法，在刺玫会的哲学中也毫无美感可言。"
                                                },
                                                {
                                                    "id": "140160436",
                                                    "speaker": "娜维娅",
                                                    "text": "嗯，而且科尔特也说过，最近他们内部情况不好，掀不起什么风浪，或许也会是他们最愿意坐下来谈的时候。"
                                                },
                                                {
                                                    "id": "140160437",
                                                    "speaker": "娜维娅",
                                                    "text": "不过我认为还是要提防罗默夫的行动，如果他对我们这边的警告视而不见…"
                                                },
                                                {
                                                    "id": "140160438",
                                                    "speaker": "娜维娅",
                                                    "text": "恐怕到最后还是会演变成一场战斗。"
                                                },
                                                {
                                                    "id": "140160439",
                                                    "speaker": "派蒙",
                                                    "text": "至少他那边的人，看起来挺讨厌刺玫会的。"
                                                },
                                                {
                                                    "id": "140160440",
                                                    "speaker": "科尔特",
                                                    "text": "不要发展到那一步最好，毕竟…就算恩断义绝，两边也曾是一家人。"
                                                },
                                                {
                                                    "id": "140160441",
                                                    "speaker": "娜维娅",
                                                    "text": "嗯，确实是这个道理。好啦，总之算是解决了吧，不用在乎这些讨厌鬼了。"
                                                },
                                                {
                                                    "id": "140160442",
                                                    "speaker": "娜维娅",
                                                    "text": "今天有点晚了，我们去「灰河」休息一晚，明天再回白淞镇好了。"
                                                },
                                                {
                                                    "id": "140160443",
                                                    "speaker": "娜维娅",
                                                    "text": "我会托人给弗洛朗写封信，告诉他今天的遭遇，让他注意白淞镇周边的安全，提防可疑人士。"
                                                },
                                                {
                                                    "id": "140160444",
                                                    "speaker": "派蒙",
                                                    "text": "又要住在「灰河」吗？那里的枕头都有一股水草的味道…"
                                                },
                                                {
                                                    "id": "140160445",
                                                    "speaker": "娜维娅",
                                                    "text": "没办法啦，很靠近水边，又没什么阳光，不过白淞镇也差不多，我早就习惯啦。"
                                                },
                                                {
                                                    "id": "140160446",
                                                    "speaker": "娜维娅",
                                                    "text": "晚上我们还可以去店里吃烤鱼喝饮料，听人唱船歌，不也挺好吗？"
                                                },
                                                {
                                                    "id": "140160447",
                                                    "speaker": "派蒙",
                                                    "text": "有道理，你说服我了！我们走吧，我也要唱！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "140160423",
                                            "text": "一定有所预谋。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "140160405",
                            "text": "我们上面和下面都有人。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1401605",
            "objective": "前往灰河",
            "dialogues": [
                {
                    "id": "140160501",
                    "speaker": "派蒙",
                    "text": "再次来到这个地方，总觉得有点亲切感了呢。"
                },
                {
                    "id": "140160502",
                    "speaker": "派蒙",
                    "text": "如果刺玫会在枫丹廷的据点是像沫芒宫那样富丽堂皇的地方，反而会觉得很不搭调。"
                },
                {
                    "id": "140160503",
                    "speaker": "娜维娅",
                    "text": "哈哈哈，的确如此，我也这么觉得。"
                },
                {
                    "id": "140160504",
                    "speaker": "娜维娅",
                    "text": "只不过在我老爹的畅想中，等刺玫会越来越好，白淞镇也会成为不输给枫丹廷的大城市。"
                },
                {
                    "id": "140160505",
                    "speaker": "娜维娅",
                    "text": "他是个野心很旺盛的人，很少低头去看，所以他才会有很多异于常人的特质。"
                },
                {
                    "id": "140160506",
                    "speaker": "科尔特",
                    "text": "也就是这一点，人们对卡雷斯先生总是又爱又恨。"
                },
                {
                    "id": "140160507",
                    "speaker": "娜维娅",
                    "text": "好啦，你们去店里等我，我去里面做些准备，顺便也叫人把你们的住处整理一下。"
                },
                {
                    "id": "140160508",
                    "speaker": "娜维娅",
                    "text": "房间还和上次一样，没忘记是哪一间吧？"
                },
                {
                    "id": "140160509",
                    "speaker": "派蒙",
                    "text": "嗯，反正又没几间房！"
                },
                {
                    "id": "140160510",
                    "speaker": "娜维娅",
                    "text": "你这家伙，想说这地方寒酸对吧！我现在就去把你的枕头塞满水草！"
                },
                {
                    "id": "140160511",
                    "speaker": "派蒙",
                    "text": "对不起，对不起，那真要睡不着了！"
                },
                {
                    "id": "140160512",
                    "speaker": "娜维娅",
                    "text": "哈哈哈，开玩笑的，你们先过去吧。"
                }
            ]
        },
        {
            "id": "1401609",
            "objective": "在屋内坐下，等待宴会",
            "dialogues": []
        },
        {
            "id": "1401606",
            "objective": "参加宴会",
            "dialogues": [
                {
                    "id": "140160601",
                    "speaker": "Black Screen",
                    "text": "享用晚餐，观看表演，热闹的夜晚渐渐过去。"
                },
                {
                    "id": "140160602",
                    "speaker": "Black Screen",
                    "text": "一切转为安宁，你和派蒙回到房中，却听见敲门声…"
                },
                {
                    "id": "140160603",
                    "speaker": "娜维娅",
                    "text": "睡了吗？还没有吧？",
                    "choices": [
                        {
                            "id": "140160604",
                            "text": "娜维娅？",
                            "response": [
                                {
                                    "id": "140160606",
                                    "speaker": "娜维娅",
                                    "text": "没什么，只是觉得难得有这样的夜晚，不应该就这么结束，对吧？"
                                },
                                {
                                    "id": "140160607",
                                    "speaker": "娜维娅",
                                    "text": "想去钓鱼吗？我已经准备好装备了。"
                                },
                                {
                                    "id": "140160608",
                                    "speaker": "派蒙",
                                    "text": "这就是你晚餐之前说的「准备」吧！那我们马上来！"
                                },
                                {
                                    "id": "140160609",
                                    "speaker": "娜维娅",
                                    "text": "嘿嘿，没打扰到你们的休息吧。",
                                    "choices": [
                                        {
                                            "id": "140160610",
                                            "text": "还好。",
                                            "response": [
                                                {
                                                    "id": "140160611",
                                                    "speaker": "娜维娅",
                                                    "text": "放心，我考虑到你可能没精神，已经做好准备了。"
                                                },
                                                {
                                                    "id": "140160612",
                                                    "speaker": "娜维娅",
                                                    "text": "就当陪我聊聊天，行吗？"
                                                },
                                                {
                                                    "id": "140160615",
                                                    "speaker": "娜维娅",
                                                    "text": "走吧走吧，钓鱼去。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "140160613",
                                            "text": "既然是你的邀请…",
                                            "response": [
                                                {
                                                    "id": "140160614",
                                                    "speaker": "娜维娅",
                                                    "text": "嘿嘿，不愧是我的好搭档。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "140160605",
                            "text": "怎么了吗？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1401607",
            "objective": "与娜维娅钓鱼",
            "dialogues": [
                {
                    "id": "140160701",
                    "speaker": "派蒙",
                    "text": "用自动鱼竿钓鱼，还算钓鱼吗？！"
                },
                {
                    "id": "140160702",
                    "speaker": "娜维娅",
                    "text": "嗯，怎么了？这种鱼竿在白淞镇很常见啊。"
                },
                {
                    "id": "140160703",
                    "speaker": "派蒙",
                    "text": "钓鱼，不应该是…呃，非常投入地看着浮漂，等鱼咬钩，体会鱼出水那一瞬间的惊喜吗？"
                },
                {
                    "id": "140160704",
                    "speaker": "娜维娅",
                    "text": "#那也是一种方式啦。{NICKNAME}，你怎么看呢？",
                    "choices": [
                        {
                            "id": "140160705",
                            "text": "手动比较有意思。",
                            "response": [
                                {
                                    "id": "140160706",
                                    "speaker": "娜维娅",
                                    "text": "那下次我们就用普通的鱼竿钓鱼吧，比一比谁钓得更多。"
                                },
                                {
                                    "id": "140160709",
                                    "speaker": "派蒙",
                                    "text": "比起这个，我更想问为什么娜维娅你这么有精神，这种时候我都…哈啊…想睡觉了。"
                                },
                                {
                                    "id": "140160710",
                                    "speaker": "娜维娅",
                                    "text": "天生的吧。"
                                },
                                {
                                    "id": "140160711",
                                    "speaker": "派蒙",
                                    "text": "就这样？"
                                },
                                {
                                    "id": "140160712",
                                    "speaker": "娜维娅",
                                    "text": "展开来讲的话你会更想睡觉的。我想，应该是多亏了刺玫会，还有我的母亲吧。"
                                },
                                {
                                    "id": "140160713",
                                    "speaker": "Player",
                                    "text": "母亲？"
                                },
                                {
                                    "id": "140160714",
                                    "speaker": "娜维娅",
                                    "text": "我老爹从小就对我有很多不切实际的期待，他越是想要我和他一样，我就越不想听他的话。"
                                },
                                {
                                    "id": "140160715",
                                    "speaker": "娜维娅",
                                    "text": "我母亲就不一样了，我听说她对我只有一个期望，就是能开开心心地长大。"
                                },
                                {
                                    "id": "140160716",
                                    "speaker": "娜维娅",
                                    "text": "刺玫会的成员都很尊重她的想法，无论我去哪里胡闹，他们都愿意惯着我。"
                                },
                                {
                                    "id": "140160717",
                                    "speaker": "娜维娅",
                                    "text": "你们能想象吗？我因为闯祸挨骂的时候，所有人站成两排，迈勒斯和西尔弗也在，只有我老爹一个人大发雷霆。"
                                },
                                {
                                    "id": "140160718",
                                    "speaker": "娜维娅",
                                    "text": "大家都默不作声，渐渐地，就显得为了小事而对我发脾气的老爹很小气，他也就只好闭嘴了。"
                                },
                                {
                                    "id": "140160719",
                                    "speaker": "派蒙",
                                    "text": "还有这种事啊？"
                                },
                                {
                                    "id": "140160720",
                                    "speaker": "娜维娅",
                                    "text": "是啊，现在想想，他们真的都是一群很温柔的人。"
                                },
                                {
                                    "id": "140160721",
                                    "speaker": "娜维娅",
                                    "text": "小时候的我一直认为，我可以想做什么就做什么，因为总会有人帮我善后。"
                                },
                                {
                                    "id": "140160722",
                                    "speaker": "娜维娅",
                                    "text": "但是有一次迈勒斯他受伤了，他不告诉我原因，但我能感觉到，是因为我的缘故。"
                                },
                                {
                                    "id": "140160723",
                                    "speaker": "娜维娅",
                                    "text": "——总会有人为错误承担责任，越是珍视周围的人，就越不要去做错事。"
                                },
                                {
                                    "id": "140160724",
                                    "speaker": "娜维娅",
                                    "text": "因为当错误的惩罚降临时，那些人真的会不顾一切地为你挺身而出，为你付出代价…",
                                    "choices": [
                                        {
                                            "id": "140160725",
                                            "text": "娜维娅…",
                                            "response": [
                                                {
                                                    "id": "140160727",
                                                    "speaker": "娜维娅",
                                                    "text": "对不起，对不起，不该提这个，今晚不想聊难过的事。"
                                                },
                                                {
                                                    "id": "140160728",
                                                    "speaker": "娜维娅",
                                                    "text": "总之就是，刺玫会有今天这样的氛围，一定不是因为我老爹，而是我的母亲。"
                                                },
                                                {
                                                    "id": "140160729",
                                                    "speaker": "娜维娅",
                                                    "text": "这或许是我感受来自她的爱的唯一方式，我也想要把她的温柔传递下去。"
                                                },
                                                {
                                                    "id": "140160730",
                                                    "speaker": "派蒙",
                                                    "text": "所以你才会放走今天的那些人？"
                                                },
                                                {
                                                    "id": "140160731",
                                                    "speaker": "娜维娅",
                                                    "text": "嗯，或许也是过往的教训吧，至少我不希望太过武断。"
                                                },
                                                {
                                                    "id": "140160732",
                                                    "speaker": "娜维娅",
                                                    "text": "#欸，你看，{NICKNAME}，你那边有水花！"
                                                },
                                                {
                                                    "id": "140160733",
                                                    "speaker": "派蒙",
                                                    "text": "但是为什么鱼竿不收线啊？"
                                                },
                                                {
                                                    "id": "140160734",
                                                    "speaker": "娜维娅",
                                                    "text": "应该是发条装置没装好，我也是第一次组装这种鱼竿！"
                                                },
                                                {
                                                    "id": "140160735",
                                                    "speaker": "娜维娅",
                                                    "text": "别让它跑了，我们抓住它！快！"
                                                },
                                                {
                                                    "id": "140160736",
                                                    "speaker": "派蒙",
                                                    "text": "我、我也要来吗？！"
                                                },
                                                {
                                                    "id": "140160737",
                                                    "speaker": "Black Screen",
                                                    "text": "你们齐心协力，总算把这条大鱼拽了上来。"
                                                },
                                                {
                                                    "id": "140160738",
                                                    "speaker": "Black Screen",
                                                    "text": "而后你的鱼竿又接连上钩，娜维娅的鱼竿则不知为何一无所获。"
                                                },
                                                {
                                                    "id": "140160739",
                                                    "speaker": "Black Screen",
                                                    "text": "娜维娅对自己的运气耿耿于怀，而回去的路上，派蒙终于发现了奥秘所在。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "140160726",
                                            "text": "你果然还是很难受吧。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "140160707",
                            "text": "自动省事。",
                            "response": [
                                {
                                    "id": "140160708",
                                    "speaker": "娜维娅",
                                    "text": "哈哈，你也这么觉得吧，不管怎么样，能钓到鱼就开心。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "1401608",
            "objective": "返回灰河休息",
            "dialogues": [
                {
                    "id": "140160801",
                    "speaker": "马蒂纳",
                    "text": "别再浪费时间了，老大耐心有限。"
                },
                {
                    "id": "140160802",
                    "speaker": "马蒂纳",
                    "text": "明天就行动，你自求多福吧。"
                },
                {
                    "id": "140160803",
                    "speaker": "娜维娅",
                    "text": "发条装置不会动也是因为少装了一个零件，这么想的话，好像我们也算公平？"
                },
                {
                    "id": "140160804",
                    "speaker": "派蒙",
                    "text": "只讨论数量倒是没错啦…哈啊，不行了，我实在是熬不住了。"
                },
                {
                    "id": "140160805",
                    "speaker": "娜维娅",
                    "text": "哈哈哈，快去休息吧，今天我玩得很开心！"
                },
                {
                    "id": "140160806",
                    "speaker": "Player",
                    "text": "明天见，娜维娅。"
                },
                {
                    "id": "140160807",
                    "speaker": "娜维娅",
                    "text": "嗯，明天见！"
                },
                {
                    "id": "140160808",
                    "speaker": "娜维娅",
                    "text": "怎么样，昨天睡了好觉吗？"
                },
                {
                    "id": "140160809",
                    "speaker": "派蒙",
                    "text": "我梦见在和海星跳舞…应该算「还行」吧。"
                },
                {
                    "id": "140160810",
                    "speaker": "娜维娅",
                    "text": "……"
                },
                {
                    "id": "140160811",
                    "speaker": "Player",
                    "text": "…你从哪里学来的？"
                },
                {
                    "id": "140160812",
                    "speaker": "科尔特",
                    "text": "哈哈，没想到你还挺幽默。"
                },
                {
                    "id": "140160813",
                    "speaker": "派蒙",
                    "text": "你看，还是有人能欣赏的嘛！"
                },
                {
                    "id": "140160814",
                    "speaker": "娜维娅",
                    "text": "那我们走吧，回白淞镇就坐船好了，我来安排。阿黛尔应该也想和你们见一面。"
                },
                {
                    "id": "140160815",
                    "speaker": "派蒙",
                    "text": "希望她喜欢你给她准备的礼物。"
                },
                {
                    "id": "140160816",
                    "speaker": "娜维娅",
                    "text": "那就最好了，嘿嘿。"
                }
            ]
        },
        {
            "id": "1401699",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "140169901",
                    "speaker": "娜维娅",
                    "text": "收拾好了，我们继续出发吧。"
                },
                {
                    "id": "140169902",
                    "speaker": "娜维娅",
                    "text": "阿黛尔未来的制服，我拜托了城里的老熟人订做，我们直接去取吧。"
                },
                {
                    "id": "140169903",
                    "speaker": "派蒙",
                    "text": "确实有人，他们往上面去了！"
                },
                {
                    "id": "140169904",
                    "speaker": "娜维娅",
                    "text": "别跑，给我站住！"
                }
            ]
        }
    ]
}