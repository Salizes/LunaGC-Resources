    "talks": [
        {
            "id": "101801",
            "objective": "回璃月寻找「公子」",
            "dialogues": [
                {
                    "id": "10031801",
                    "speaker": "「公子」",
                    "text": "你们终于回来了，绝云间之行成果如何？"
                },
                {
                    "id": "10031802",
                    "speaker": "「公子」",
                    "text": "…原来如此。"
                }
            ]
        },
        {
            "id": "100318",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "10031803",
                    "speaker": "「公子」",
                    "text": "削月筑阳真君、理水叠山真君、留云借风真君、降魔大圣…"
                },
                {
                    "id": "10031804",
                    "speaker": "「公子」",
                    "text": "嗯，这其中有些名号，在「愚人众」掌握的情报里都没出现过呢。"
                },
                {
                    "id": "10031805",
                    "speaker": "「公子」",
                    "text": "作为回礼，我也有情报提供给你。"
                },
                {
                    "id": "10031809",
                    "speaker": "「公子」",
                    "text": "对于神祇之死，璃月七星的反应，十分耐人寻味…"
                },
                {
                    "id": "10031810",
                    "speaker": "「公子」",
                    "text": "他们对外宣称，由于尚未寻获真凶，不允许任何人瞻仰「仙祖法蜕」。"
                },
                {
                    "id": "10031811",
                    "speaker": "「公子」",
                    "text": "甚至还试图封锁消息…但毕竟请仙典仪人来人往，即使七星也难以禁绝流言。"
                },
                {
                    "id": "10031812",
                    "speaker": "派蒙",
                    "text": "仙祖法蜕？"
                },
                {
                    "id": "10031813",
                    "speaker": "「公子」",
                    "text": "以璃月的常识而言，岩王帝君也是一位仙人嘛。"
                },
                {
                    "id": "10031814",
                    "speaker": "「公子」",
                    "text": "岩神是契约之神，同时也被称作众仙之祖。"
                },
                {
                    "id": "10031815",
                    "speaker": "「公子」",
                    "text": "如今的所有「三眼五显仙人」，当年都曾立下守望璃月的契约。"
                },
                {
                    "id": "10031816",
                    "speaker": "派蒙",
                    "text": "这样啊…难怪他们对璃月的事这么上心。"
                },
                {
                    "id": "10031817",
                    "speaker": "「公子」",
                    "text": "没错，他们既有责任，也有资格。"
                },
                {
                    "id": "10031818",
                    "speaker": "「公子」",
                    "text": "——如果掌管璃月的七星出了问题，他们就有兴师问罪的资格。"
                },
                {
                    "id": "10031819",
                    "speaker": "「公子」",
                    "text": "岩神灵魂升入高天，留下的躯壳，为何会被七星藏匿？实在可疑…",
                    "choices": [
                        {
                            "id": "10031820",
                            "text": "这对我也是很大的麻烦。",
                            "response": [
                                {
                                    "id": "10031822",
                                    "speaker": "派蒙",
                                    "text": "啊！没错，我们本来就是来找那位神灵的！"
                                },
                                {
                                    "id": "10031823",
                                    "speaker": "派蒙",
                                    "text": "如果璃月七星把「仙祖法蜕」藏起来、不让人接近的话…"
                                },
                                {
                                    "id": "10031824",
                                    "speaker": "派蒙",
                                    "text": "#{NICKNAME}想要寻访全部七神的目标，就会完全落空了！"
                                },
                                {
                                    "id": "10031825",
                                    "speaker": "「公子」",
                                    "text": "喔？你们正在寻访七神？是为了什么呢？",
                                    "choices": [
                                        {
                                            "id": "10031826",
                                            "text": "与你无关。",
                                            "response": [
                                                {
                                                    "id": "10031828",
                                                    "speaker": "「公子」",
                                                    "text": "嘿…不错的回答。"
                                                },
                                                {
                                                    "id": "10031829",
                                                    "speaker": "「公子」",
                                                    "text": "轻易被「愚人众」套话的骑士，可不是一位好骑士，对吧？"
                                                },
                                                {
                                                    "id": "10031830",
                                                    "speaker": "「公子」",
                                                    "text": "不过…这一次，我还是可以帮助你。"
                                                },
                                                {
                                                    "id": "10031831",
                                                    "speaker": "派蒙",
                                                    "text": "咦？真的吗？"
                                                },
                                                {
                                                    "id": "10031832",
                                                    "speaker": "「公子」",
                                                    "text": "给我一点时间。"
                                                },
                                                {
                                                    "id": "10031833",
                                                    "speaker": "「公子」",
                                                    "text": "一点时间…用来找人。"
                                                },
                                                {
                                                    "id": "10031834",
                                                    "speaker": "「公子」",
                                                    "text": "我会为你找到，能够突破这僵局的人。"
                                                },
                                                {
                                                    "id": "10031835",
                                                    "speaker": "「公子」",
                                                    "text": "啊…真有意思。布局阶段压抑得越平静，最终爆发出的混乱就越激烈…"
                                                },
                                                {
                                                    "id": "10031836",
                                                    "speaker": "「公子」",
                                                    "text": "为了亲眼目睹暗流的决堤，一定要坚持到活着与我再相见哦。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "10031827",
                                            "text": "无可奉告。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "10031821",
                            "text": "我也不能接受这种做法。"
                        }
                    ]
                },
                {
                    "id": "10031806",
                    "speaker": "「公子」",
                    "text": "并没有见到所有仙人…按他们的话说就是「无缘得见」，对吧？"
                },
                {
                    "id": "10031807",
                    "speaker": "「公子」",
                    "text": "没关系！最近如果有空的话，再去碰碰运气也无妨。"
                },
                {
                    "id": "10031808",
                    "speaker": "「公子」",
                    "text": "而且，降魔大圣的情报已经很珍贵了。作为回礼，我也有情报提供给你。"
                }
            ]
        }
    ]
}