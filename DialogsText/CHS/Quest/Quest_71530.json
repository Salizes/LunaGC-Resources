        }
    },
    "talks": [
        {
            "id": "7153001",
            "objective": "与遐庆对话",
            "dialogues": [
                {
                    "id": "715300101",
                    "speaker": "遐庆",
                    "text": "#海灯节快乐哟，{M#大哥}{F#大姐}和小妹…"
                },
                {
                    "id": "715300102",
                    "speaker": "遐庆",
                    "text": "哎，你们不是之前来找嘉明的那两位大名人嘛？"
                },
                {
                    "id": "715300103",
                    "speaker": "派蒙",
                    "text": "我们之前见过你，你和嘉明在一起玩来着！"
                },
                {
                    "id": "715300104",
                    "speaker": "遐庆",
                    "text": "确实，你们还记得我，我走大运了！"
                },
                {
                    "id": "715300105",
                    "speaker": "遐庆",
                    "text": "听说你们是高手，做什么都很在行！我每天走几步路去吃虎岩买菜，路上都能听到好几个人夸你们。",
                    "choices": [
                        {
                            "id": "715300106",
                            "text": "没错，我就是全能高手！",
                            "response": [
                                {
                                    "id": "715300108",
                                    "speaker": "派蒙",
                                    "text": "我我我，我也有吃饭之外的本领啦！"
                                },
                                {
                                    "id": "715300109",
                                    "speaker": "派蒙",
                                    "text": "等等，我想想，我还会什么来着…"
                                },
                                {
                                    "id": "715300110",
                                    "speaker": "遐庆",
                                    "text": "我懂！一般人哪里能飘起来，你又白又轻又蓬松，就像鸽子小仙！"
                                },
                                {
                                    "id": "715300111",
                                    "speaker": "遐庆",
                                    "text": "会飞就很厉害了，拿东西好方便，干活轻轻松松，你要多帮帮你的朋友。",
                                    "choices": [
                                        {
                                            "id": "715300112",
                                            "text": "派蒙居然是鸽子仙人！",
                                            "response": [
                                                {
                                                    "id": "715300114",
                                                    "speaker": "派蒙",
                                                    "text": "#先不说鸽子成仙这种事存不存在啦，我一直有帮{NICKNAME}干活嘛。"
                                                },
                                                {
                                                    "id": "715300115",
                                                    "speaker": "派蒙",
                                                    "text": "#比如，从很高的地方掉下去的时候，我也会拉着{NICKNAME}，别让{M#他}{F#她}摔得太疼…"
                                                },
                                                {
                                                    "id": "715300116",
                                                    "speaker": "派蒙",
                                                    "text": "#虽然我力气不太够，拉不太动啦…如果我真的是鸽子仙人，我就在{NICKNAME}用风之翼的时候拉着{M#他}{F#她}，飞得更远！"
                                                },
                                                {
                                                    "id": "715300117",
                                                    "speaker": "遐庆",
                                                    "text": "你们要多练练嘛，就像我和嘉明练舞兽。一起练的时间长了，有了默契，配合还不简单！"
                                                },
                                                {
                                                    "id": "715300118",
                                                    "speaker": "遐庆",
                                                    "text": "正好，我做了个新鲜好玩的游戏，叫「碰碰舞兽戏」，要来试试不？"
                                                },
                                                {
                                                    "id": "715300119",
                                                    "speaker": "遐庆",
                                                    "text": "既能锻炼配合，又能好好了解舞兽戏！"
                                                },
                                                {
                                                    "id": "715300120",
                                                    "speaker": "派蒙",
                                                    "text": "「碰碰舞兽戏」？难道就是你旁边的这个大玩偶…"
                                                },
                                                {
                                                    "id": "715300121",
                                                    "speaker": "遐庆",
                                                    "text": "对的！"
                                                },
                                                {
                                                    "id": "715300122",
                                                    "speaker": "遐庆",
                                                    "text": "正宗的舞兽戏很难学，就算有专门的人带着练，不喜欢，没毅力也坚持不下去。"
                                                },
                                                {
                                                    "id": "715300123",
                                                    "speaker": "遐庆",
                                                    "text": "所以我拿舞兽戏的一种舞法改了改规则，换了道具，就有了这个游戏。"
                                                },
                                                {
                                                    "id": "715300124",
                                                    "speaker": "遐庆",
                                                    "text": "现在也是海灯节嘛，让大家开心开心，饭前活动，饭后消食！"
                                                },
                                                {
                                                    "id": "715300125",
                                                    "speaker": "遐庆",
                                                    "text": "只需要穿上戏服，比比谁拿到的茶饼更多。游戏里还可以碰来碰去，很乐的！"
                                                },
                                                {
                                                    "id": "715300126",
                                                    "speaker": "派蒙",
                                                    "text": "听起来很有意思，不过要穿着这么大的戏服和别人玩游戏，我的力气好像确实不太够，"
                                                },
                                                {
                                                    "id": "715300127",
                                                    "speaker": "派蒙",
                                                    "text": "#{NICKNAME}对这种游戏很在行！我就在一边看着大家玩，先学一学。",
                                                    "choices": [
                                                        {
                                                            "id": "715300128",
                                                            "text": "好！那我就舞一舞！",
                                                            "response": [
                                                                {
                                                                    "id": "715300130",
                                                                    "speaker": "遐庆",
                                                                    "text": "咦？鸽子小仙不亲自上吗？有点可惜…"
                                                                },
                                                                {
                                                                    "id": "715300131",
                                                                    "speaker": "派蒙",
                                                                    "text": "#没问题的！我和{NICKNAME}一起旅行了好久好久，以后也会一直旅行下去，还有很多机会锻炼默契！"
                                                                },
                                                                {
                                                                    "id": "715300132",
                                                                    "speaker": "派蒙",
                                                                    "text": "#而且，说不定我只是看看，就能学到不少和{NICKNAME}配合的要领呢！"
                                                                },
                                                                {
                                                                    "id": "715300133",
                                                                    "speaker": "遐庆",
                                                                    "text": "哈哈！你们的关系太好了，我都有点羡慕！"
                                                                },
                                                                {
                                                                    "id": "715300134",
                                                                    "speaker": "遐庆",
                                                                    "text": "#那就请大名人{M#大哥}{F#大姐}来体验体验「碰碰舞兽戏」，鸽子小仙开开心心看戏咯！"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "715300129",
                                                            "text": "好！那我就碰一碰！"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "715300113",
                                            "text": "奇怪的外号增加了耶！"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "715300107",
                            "text": "哈哈，派蒙是吃饭高手！"
                        }
                    ]
                }
            ]
        }
    ]
}