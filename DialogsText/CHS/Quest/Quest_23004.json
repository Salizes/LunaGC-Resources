    "talks": [
        {
            "id": "2300401",
            "objective": "与古拉布吉尔对话",
            "dialogues": [
                {
                    "id": "230040101",
                    "speaker": "古拉布吉尔",
                    "text": "怎么又不见了…哎…旅行者！能不能请你帮个忙？"
                },
                {
                    "id": "230040102",
                    "speaker": "古拉布吉尔",
                    "text": "我的口粮不见了！"
                },
                {
                    "id": "230040103",
                    "speaker": "古拉布吉尔",
                    "text": "不对，不对！是我的宠物蛇口粮，全部不见了！"
                }
            ]
        },
        {
            "id": "2300402",
            "objective": "前往营地",
            "dialogues": [
                {
                    "id": "230040201",
                    "speaker": "古拉布吉尔",
                    "text": "怎么样，你找到口粮了吗？"
                }
            ]
        },
        {
            "id": "2300403",
            "objective": "打倒所有蕈兽",
            "dialogues": []
        },
        {
            "id": "2300404",
            "objective": "寻找古拉布吉尔的蛇口粮",
            "dialogues": [
                {
                    "id": "230040401",
                    "speaker": "古拉布吉尔",
                    "text": "你们回来了！好快啊，找到口粮了吗？"
                },
                {
                    "id": "230040402",
                    "speaker": "Player",
                    "text": "是这个吗？"
                }
            ]
        },
        {
            "id": "2300414",
            "objective": "前往营地",
            "dialogues": []
        },
        {
            "id": "2300406",
            "objective": "寻找古拉布吉尔的蛇口粮",
            "dialogues": [
                {
                    "id": "230040601",
                    "speaker": "古拉布吉尔",
                    "text": "没错！就是这些！太谢谢你们了。"
                },
                {
                    "id": "230040602",
                    "speaker": "派蒙",
                    "text": "这些东西怎么不在营地里，在旁边的大树上啊？"
                },
                {
                    "id": "230040603",
                    "speaker": "古拉布吉尔",
                    "text": "唔…也许是被小鸟叼上去做储备粮了吧…"
                },
                {
                    "id": "230040604",
                    "speaker": "古拉布吉尔",
                    "text": "这种口粮真这么受小动物喜欢吗？我要不要拿出去卖…"
                },
                {
                    "id": "230040605",
                    "speaker": "古拉布吉尔",
                    "text": "咳！先不说这些了，这些报酬还请收下吧，多谢你们帮忙了。"
                }
            ]
        },
        {
            "id": "2300407",
            "objective": "前往营地",
            "dialogues": [
                {
                    "id": "230040701",
                    "speaker": "古拉布吉尔",
                    "text": "没错！就是这些！果然丢在了营地里啊。"
                },
                {
                    "id": "230040702",
                    "speaker": "派蒙",
                    "text": "是被石头压住了啦，营地在的位置好像塌方了，东西滚了好远，我们找了好一会呢。"
                },
                {
                    "id": "230040703",
                    "speaker": "古拉布吉尔",
                    "text": "是这样吗？那个地方怎么会突然塌方呢？之前一直挺安全的…"
                },
                {
                    "id": "230040704",
                    "speaker": "古拉布吉尔",
                    "text": "对了！我之前在那边露营的时候，夜里总能听见一些奇怪的叫声，帐篷也总是会被什么东西磨蹭…"
                },
                {
                    "id": "230040705",
                    "speaker": "古拉布吉尔",
                    "text": "小蛇们很警惕，每次都会把我弄醒。但我每次出去查看的时候，却什么也看不见…"
                },
                {
                    "id": "230040706",
                    "speaker": "古拉布吉尔",
                    "text": "算了，不说这些闲话了，总之这次多谢你们了，这些报酬还请收下吧。"
                }
            ]
        },
        {
            "id": "2300408",
            "objective": "寻找古拉布吉尔的蛇口粮",
            "dialogues": [
                {
                    "id": "230040801",
                    "speaker": "古拉布吉尔",
                    "text": "没错！就是这些！果然丢在了营地里啊。"
                },
                {
                    "id": "230040802",
                    "speaker": "Player",
                    "text": "关于营地的情况…"
                },
                {
                    "id": "230040803",
                    "speaker": "古拉布吉尔",
                    "text": "是这样吗？难道是有野兽闯进去了吗…"
                },
                {
                    "id": "230040804",
                    "speaker": "古拉布吉尔",
                    "text": "这么一说…之前我做的口粮吸引过蕈兽，吸引过小鸟…现在吸引一些野兽过来倒也正常…"
                },
                {
                    "id": "230040805",
                    "speaker": "古拉布吉尔",
                    "text": "唔…看来我真要考虑一下把这种口粮拿去出售的计划了。"
                },
                {
                    "id": "230040806",
                    "speaker": "古拉布吉尔",
                    "text": "如果这生意真能成的话，应该能比我现在的表演赚钱多了吧…"
                },
                {
                    "id": "230040807",
                    "speaker": "古拉布吉尔",
                    "text": "啊，我扯远了，哈哈，这次多谢你们了，这些报酬还请收下吧。"
                }
            ]
        },
        {
            "id": "2300409",
            "objective": "前往营地",
            "dialogues": [
                {
                    "id": "230040901",
                    "speaker": "古拉布吉尔",
                    "text": "没错！就是这些！果然丢在了营地里啊。"
                },
                {
                    "id": "230040902",
                    "speaker": "派蒙",
                    "text": "那个营地为什么会在一堆藤蔓中间啊！你睡觉的时候不怕被刺伤吗？"
                },
                {
                    "id": "230040903",
                    "speaker": "古拉布吉尔",
                    "text": "不会的，我之前野外宿营的功夫还不错。"
                },
                {
                    "id": "230040904",
                    "speaker": "古拉布吉尔",
                    "text": "而且我之前搭建那个营地的时候，周围还没有那么多藤蔓呢。"
                },
                {
                    "id": "230040905",
                    "speaker": "Player",
                    "text": "你离开林子很久了吗？"
                },
                {
                    "id": "230040906",
                    "speaker": "古拉布吉尔",
                    "text": "算是有段时间了吧，具体有多久…我也记不清了。"
                },
                {
                    "id": "230040907",
                    "speaker": "古拉布吉尔",
                    "text": "哈哈哈，现在我搭营地的手艺都已经很生疏了。"
                },
                {
                    "id": "230040908",
                    "speaker": "古拉布吉尔",
                    "text": "之前我布置好的那些营地，现在大部分也都荒废了。"
                },
                {
                    "id": "230040909",
                    "speaker": "古拉布吉尔",
                    "text": "如果我现在还待在雨林里，又会过着什么样的生活呢…"
                },
                {
                    "id": "230040910",
                    "speaker": "古拉布吉尔",
                    "text": "…抱歉，我说太多了，这些报酬给你，请收下吧。"
                }
            ]
        },
        {
            "id": "2300410",
            "objective": "寻找古拉布吉尔的蛇口粮",
            "dialogues": [
                {
                    "id": "230041001",
                    "speaker": "古拉布吉尔",
                    "text": "你们回来了！好快啊，找到口粮了吗？"
                },
                {
                    "id": "230041002",
                    "speaker": "Player",
                    "text": "是这个吗？"
                }
            ]
        },
        {
            "id": "2300411",
            "objective": "前往营地",
            "dialogues": [
                {
                    "id": "230041101",
                    "speaker": "派蒙",
                    "text": "宠物蛇也有专用口粮吗？它们一般不是会吃老鼠之类的…"
                },
                {
                    "id": "230041102",
                    "speaker": "古拉布吉尔",
                    "text": "最开始它们也是会自己觅食的。"
                },
                {
                    "id": "230041103",
                    "speaker": "古拉布吉尔",
                    "text": "但自从它们进食的时候吓到了几个孩子之后，我就不敢让它们自己出去了，都是自己调制口粮给它们吃。"
                },
                {
                    "id": "230041104",
                    "speaker": "古拉布吉尔",
                    "text": "唉…不过，自从我开始给它们调制口粮之后，它们就开始懒得动弹，也基本上不吃其他食物了。"
                },
                {
                    "id": "230041105",
                    "speaker": "派蒙",
                    "text": "欸…不劳而获的食物啊…",
                    "choices": [
                        {
                            "id": "230041106",
                            "text": "好吃！",
                            "response": [
                                {
                                    "id": "230041108",
                                    "speaker": "派蒙",
                                    "text": "我还没问味道呢，别这么一脸向往的表情，你不会有这种机会的啦！"
                                },
                                {
                                    "id": "230041109",
                                    "speaker": "派蒙",
                                    "text": "那种机会是派蒙的！"
                                },
                                {
                                    "id": "230041110",
                                    "speaker": "Player",
                                    "text": "说得真是理直气壮…"
                                },
                                {
                                    "id": "230041111",
                                    "speaker": "古拉布吉尔",
                                    "text": "我肯定是之前出去采草药的时候，把口粮落在哪处营地里了。"
                                },
                                {
                                    "id": "230041112",
                                    "speaker": "古拉布吉尔",
                                    "text": "可是我也不方便自己去找，得留在这里看着这群小家伙，防止它们饿极了溜出去吓到别人…"
                                },
                                {
                                    "id": "230041113",
                                    "speaker": "古拉布吉尔",
                                    "text": "旅行者，你能帮我跑一趟，从营地里把口粮带回来吗？",
                                    "choices": [
                                        {
                                            "id": "230041114",
                                            "text": "那就交给我吧。",
                                            "response": [
                                                {
                                                    "id": "230041115",
                                                    "speaker": "古拉布吉尔",
                                                    "text": "太谢谢你了，要是我自己带着这群小家伙回去找，还不知道会发生什么意外呢。"
                                                },
                                                {
                                                    "id": "230041116",
                                                    "speaker": "古拉布吉尔",
                                                    "text": "要是它们兴致来了，往林子里一钻玩个几天，那我就惨了…"
                                                },
                                                {
                                                    "id": "230041122",
                                                    "speaker": "古拉布吉尔",
                                                    "text": "总之，这件事就拜托你了，旅行者。"
                                                },
                                                {
                                                    "id": "230041123",
                                                    "speaker": "古拉布吉尔",
                                                    "text": "我把这次待过的营地标注在你的地图上，请你去那边看看吧。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "230041117",
                                            "text": "那边不会有其他蛇吧…",
                                            "response": [
                                                {
                                                    "id": "230041118",
                                                    "speaker": "古拉布吉尔",
                                                    "text": "不会的，不会的，我选的那几处营地都特意避开了蛇的聚集地，免得惹上什么麻烦…"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "230041119",
                                            "text": "有很多处营地吗？",
                                            "response": [
                                                {
                                                    "id": "230041120",
                                                    "speaker": "古拉布吉尔",
                                                    "text": "我之前在雨林里生活的时候，亲手布置了不少营地。"
                                                },
                                                {
                                                    "id": "230041121",
                                                    "speaker": "古拉布吉尔",
                                                    "text": "虽然现在我已经不在雨林里讨生活了…但进林子采草药的时候，我还是会在营地里休息一下。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "230041107",
                            "text": "非常好吃！"
                        }
                    ]
                }
            ]
        },
