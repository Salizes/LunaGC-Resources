        {
            "id": "2300419",
            "objective": "回报古拉布吉尔",
            "dialogues": [
                {
                    "id": "230041901",
                    "speaker": "古拉布吉尔",
                    "text": "怎么了？还有什么事吗？"
                },
                {
                    "id": "230041902",
                    "speaker": "Player",
                    "text": "我还找到了点别的。"
                }
            ]
        },
        {
            "id": "2300420",
            "objective": "回报古拉布吉尔",
            "dialogues": [
                {
                    "id": "230042001",
                    "speaker": "古拉布吉尔",
                    "text": "咦？这颗珠子…怎么回事…你们是在哪里找到的？"
                },
                {
                    "id": "230042002",
                    "speaker": "派蒙",
                    "text": "在营地的罐子找到的哦，是你落下的吗？"
                },
                {
                    "id": "230042003",
                    "speaker": "古拉布吉尔",
                    "text": "这是我之前用来表演的道具啦，我吹笛子的时候，小家伙们会把这颗珠子顶在头上，然后抬起上半身舞蹈。"
                },
                {
                    "id": "230042004",
                    "speaker": "古拉布吉尔",
                    "text": "不过，这种把戏很早之前就赚不到多少钱，我也很久没有表演过了。根本没注意这珠子不见了…"
                },
                {
                    "id": "230042005",
                    "speaker": "古拉布吉尔",
                    "text": "无论如何，还是谢谢你们帮我把这珠子拿回来，这些报酬是给你们的，请收下吧。"
                }
            ]
        },
        {
            "id": "2300421",
            "objective": "彩蛋2 爬架开车提示$HIDDEN",
            "dialogues": [
                {
                    "id": "230042101",
                    "speaker": "古拉布吉尔",
                    "text": "怎么了？还有什么事吗？"
                },
                {
                    "id": "230042102",
                    "speaker": "Player",
                    "text": "我还找到了点别的。"
                }
            ]
        },
        {
            "id": "2300422",
            "objective": "获得彩蛋2道具$HIDDEN",
            "dialogues": [
                {
                    "id": "230042201",
                    "speaker": "古拉布吉尔",
                    "text": "咦？这些帽子…哈哈哈，是我之前给小蛇们做的帽子啊。我怎么把它们也落下了。"
                },
                {
                    "id": "230042202",
                    "speaker": "古拉布吉尔",
                    "text": "之前为了让一些孩子们来看，我就给它们每条蛇都做了一顶睡帽。"
                },
                {
                    "id": "230042203",
                    "speaker": "古拉布吉尔",
                    "text": "阿耶的是红色的，阿梦的是绿色的，小加的是黄色的，阿德的是蓝色的…"
                },
                {
                    "id": "230042204",
                    "speaker": "派蒙",
                    "text": "听上去就很可爱，演出效果一定不错！"
                },
                {
                    "id": "230042205",
                    "speaker": "古拉布吉尔",
                    "text": "最开始是不错，但只要小蛇们张开嘴，孩子们肯定会哇哇大哭…"
                },
                {
                    "id": "230042206",
                    "speaker": "古拉布吉尔",
                    "text": "唉，不说这些了，请收下这些报酬吧，也算是我的一点心意。"
                }
            ]
        },
        {
