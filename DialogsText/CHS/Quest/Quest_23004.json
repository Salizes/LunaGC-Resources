        {
            "id": "2300428",
            "objective": "回报古拉布吉尔",
            "dialogues": [
                {
                    "id": "230042401",
                    "speaker": "古拉布吉尔",
                    "text": "啊！这不是我之前做的蛇爬架吗？真怀念啊，哈哈哈！"
                },
                {
                    "id": "230042402",
                    "speaker": "派蒙",
                    "text": "蛇爬架是什么啦？"
                },
                {
                    "id": "230042403",
                    "speaker": "古拉布吉尔",
                    "text": "就是给小蛇们爬来爬去解闷的玩具呀，总不能让它们时时刻刻都挂在我身上吧。"
                },
                {
                    "id": "230042404",
                    "speaker": "古拉布吉尔",
                    "text": "谢谢你们帮我把它带回来，这些报酬请收下吧。"
                },
                {
                    "id": "230042405",
                    "speaker": "古拉布吉尔",
                    "text": "我之前是这么设计的吗？真怀念啊…"
                }
            ]
        },
