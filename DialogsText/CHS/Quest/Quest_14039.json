    "talks": [
        {
            "id": "1403907",
            "objective": "追踪基里亚",
            "dialogues": [
                {
                    "id": "140390701",
                    "speaker": "基里亚",
                    "text": "嗬…嗬…咳！咳咳…"
                },
                {
                    "id": "140390702",
                    "speaker": "艾梅莉埃",
                    "text": "花香…浓烈…终点应该…"
                },
                {
                    "id": "140390703",
                    "speaker": "基里亚",
                    "text": "…这么快就追上来了吗？"
                },
                {
                    "id": "140390704",
                    "speaker": "基里亚",
                    "text": "不…是我已经没力气了啊…"
                },
                {
                    "id": "140390705",
                    "speaker": "基里亚",
                    "text": "…不过到这里…就已经够了。"
                },
                {
                    "id": "140390706",
                    "speaker": "基里亚",
                    "text": "哼…"
                },
                {
                    "id": "140390707",
                    "speaker": "基里亚",
                    "text": "哈——"
                },
                {
                    "id": "140390708",
                    "speaker": "基里亚",
                    "text": "…这里是…「奥古斯都」的花圃？"
                },
                {
                    "id": "140390709",
                    "speaker": "基里亚",
                    "text": "…不是我的花圃…是那天在枫丹被烧毁的…"
                },
                {
                    "id": "140390710",
                    "speaker": "基里亚",
                    "text": "…姐姐？"
                },
                {
                    "id": "140390711",
                    "speaker": "基里亚",
                    "text": "——姐姐！"
                },
                {
                    "id": "140390712",
                    "speaker": "基里亚",
                    "text": "我…其实一直都明白的！"
                },
                {
                    "id": "140390713",
                    "speaker": "基里亚",
                    "text": "都是因为我，你才会继续用邪眼！都是因为我，你才会烧掉花圃！"
                },
                {
                    "id": "140390714",
                    "speaker": "基里亚",
                    "text": "…那一天，我就不该听你说的，带钱离开枫丹廷…"
                },
                {
                    "id": "140390715",
                    "speaker": "基里亚",
                    "text": "等我发现不对的时候…花圃也好…你也好…什么都没了…"
                },
                {
                    "id": "140390716",
                    "speaker": "基里亚",
                    "text": "…我早该过来找你的…十多年前我就应该来找你的！"
                },
                {
                    "id": "140390717",
                    "speaker": "基里亚",
                    "text": "我早该跟你…一起死在这一天的…"
                },
                {
                    "id": "140390718",
                    "speaker": "叶莲娜",
                    "text": "……"
                },
                {
                    "id": "140390719",
                    "speaker": "基里亚",
                    "text": "…姐姐？"
                },
                {
                    "id": "140390720",
                    "speaker": "基里亚",
                    "text": "——！"
                },
                {
                    "id": "140390721",
                    "speaker": "基里亚",
                    "text": "——姐姐！？"
                },
                {
                    "id": "140390722",
                    "speaker": "叶莲娜",
                    "text": "……"
                },
                {
                    "id": "140390723",
                    "speaker": "基里亚",
                    "text": "不要——不要留下我…"
                },
                {
                    "id": "140390724",
                    "speaker": "基里亚",
                    "text": "叶莲娜——！！"
                },
                {
                    "id": "140390725",
                    "speaker": "基里亚",
                    "text": "呃…唔…"
                },
                {
                    "id": "140390726",
                    "speaker": "基里亚",
                    "text": "…艾梅莉埃？"
                },
                {
                    "id": "140390727",
                    "speaker": "基里亚",
                    "text": "我…还没死？怎么可能？我明明…都见到她了…"
                },
                {
                    "id": "140390728",
                    "speaker": "艾梅莉埃",
                    "text": "…只是你体内残留的毒素，和奥古斯都花粉引致的幻觉而已，并不致命。"
                },
                {
                    "id": "140390729",
                    "speaker": "基里亚",
                    "text": "不可能…我服下的「奥古斯都」…剂量明明是够的…",
                    "choices": [
                        {
                            "id": "140390730",
                            "text": "…很遗憾。",
                            "response": [
                                {
                                    "id": "140390732",
                                    "speaker": "基里亚",
                                    "text": "…仿制？这怎么可能…"
                                },
                                {
                                    "id": "140390733",
                                    "speaker": "艾梅莉埃",
                                    "text": "…从昨晚开始，我们就在着手准备了。"
                                },
                                {
                                    "id": "140390734",
                                    "speaker": "艾梅莉埃",
                                    "text": "——「奥古斯都」的谐{RUBY#[D]Accord}香。"
                                },
                                {
                                    "id": "140390735",
                                    "speaker": "基里亚",
                                    "text": "…那个时候，你就调换了「奥古斯都」吗？借着向我报告席尔万死讯的机会…"
                                },
                                {
                                    "id": "140390736",
                                    "speaker": "艾梅莉埃",
                                    "text": "那时候您以为复仇已经完成…是最容易放松戒备的时刻。"
                                },
                                {
                                    "id": "140390737",
                                    "speaker": "基里亚",
                                    "text": "不可能…就算有机会调换，又怎么调得出「奥古斯都」的谐香？"
                                },
                                {
                                    "id": "140390738",
                                    "speaker": "基里亚",
                                    "text": "如果它有那么容易仿制，姐姐就不会…"
                                },
                                {
                                    "id": "140390739",
                                    "speaker": "艾梅莉埃",
                                    "text": "我用了虹彩蔷薇、琉璃百合…还有塞西莉亚花…这在十多年前是个会互相冲突的配方。"
                                },
                                {
                                    "id": "140390740",
                                    "speaker": "艾梅莉埃",
                                    "text": "但现在，已经有办法互相协调了。"
                                },
                                {
                                    "id": "140390741",
                                    "speaker": "基里亚",
                                    "text": "…虹彩蔷薇…琉璃百合…塞西莉亚花…？"
                                },
                                {
                                    "id": "140390742",
                                    "speaker": "艾梅莉埃",
                                    "text": "…「奥古斯都」已经是十多年前的香水了，在这些年里，对它的分析和模仿从未停止。"
                                },
                                {
                                    "id": "140390743",
                                    "speaker": "艾梅莉埃",
                                    "text": "调香的技术也已经日新月异，除了古老的精油萃取、油脂离析…我们还发现了更多调和香味的手段。"
                                },
                                {
                                    "id": "140390744",
                                    "speaker": "艾梅莉埃",
                                    "text": "十多年前牢不可破的神话…现在也是时候成为过去了。"
                                },
                                {
                                    "id": "140390745",
                                    "speaker": "基里亚",
                                    "text": "「过去」…"
                                },
                                {
                                    "id": "140390746",
                                    "speaker": "艾梅莉埃",
                                    "text": "您这些年作为调香师并没有固步自封，理论上有没有可能，您其实很清楚。"
                                },
                                {
                                    "id": "140390747",
                                    "speaker": "艾梅莉埃",
                                    "text": "只是您太执着于自己给「奥古斯都」赋予的意义…就像陷入「香水狂热」时的人们一样。"
                                },
                                {
                                    "id": "140390748",
                                    "speaker": "艾梅莉埃",
                                    "text": "相信着它的「神圣」，相信着它的「高贵」，相信着它的「独一无二」…",
                                    "choices": [
                                        {
                                            "id": "140390749",
                                            "text": "却偏偏忘了…",
                                            "response": [
                                                {
                                                    "id": "140390751",
                                                    "speaker": "艾梅莉埃",
                                                    "text": "也是因为你对「奥古斯都」的执着，我们才能预见你想要的「结局」…提前做好准备。"
                                                },
                                                {
                                                    "id": "140390752",
                                                    "speaker": "派蒙",
                                                    "text": "就是没想到这么快…"
                                                },
                                                {
                                                    "id": "140390753",
                                                    "speaker": "Player",
                                                    "text": "甚至还动用了邪眼。"
                                                },
                                                {
                                                    "id": "140390754",
                                                    "speaker": "基里亚",
                                                    "text": "哈…哈哈…"
                                                },
                                                {
                                                    "id": "140390755",
                                                    "speaker": "基里亚",
                                                    "text": "还真是…全被你们说中了。"
                                                },
                                                {
                                                    "id": "140390756",
                                                    "speaker": "基里亚",
                                                    "text": "所以…席尔万他也没死，对吗？"
                                                },
                                                {
                                                    "id": "140390757",
                                                    "speaker": "基里亚",
                                                    "text": "既然你们从昨晚开始就在准备「奥古斯都」的谐香…那肯定早就发现了我的手法吧？"
                                                },
                                                {
                                                    "id": "140390758",
                                                    "speaker": "基里亚",
                                                    "text": "今天一早的死讯、围观的群众，都是夏姆配合你们，演给我看的一出戏？"
                                                },
                                                {
                                                    "id": "140390759",
                                                    "speaker": "艾梅莉埃",
                                                    "text": "…是的。如果不这么做，您可能会用邪眼做最后一搏，也可能用「灵酚香」跟「奥古斯都」制造混乱…"
                                                },
                                                {
                                                    "id": "140390760",
                                                    "speaker": "基里亚",
                                                    "text": "谁知道呢…说不定会直接给自己一个痛快吧。"
                                                },
                                                {
                                                    "id": "140390761",
                                                    "speaker": "艾梅莉埃",
                                                    "text": "那「艾德加」的死、这处花圃的位置…就都成为永远的谜了…我不想再看见任何死亡。"
                                                },
                                                {
                                                    "id": "140390762",
                                                    "speaker": "艾梅莉埃",
                                                    "text": "席尔万昨晚只是轻度中毒，现在已经在被收押的路上。"
                                                },
                                                {
                                                    "id": "140390763",
                                                    "speaker": "艾梅莉埃",
                                                    "text": "他在十多年前隐瞒的罪行，都会受到公开的审判，所有的秘密都会被昭示…而老师，您也一样。"
                                                },
                                                {
                                                    "id": "140390764",
                                                    "speaker": "基里亚",
                                                    "text": "我也一样吗…看来我剩下的时间，是要在监狱里度过了。"
                                                },
                                                {
                                                    "id": "140390765",
                                                    "speaker": "派蒙",
                                                    "text": "唔…他接受得好像有点快…"
                                                },
                                                {
                                                    "id": "140390766",
                                                    "speaker": "基里亚",
                                                    "text": "…我不会为自己的行为辩解，也没有忏悔的打算。"
                                                },
                                                {
                                                    "id": "140390767",
                                                    "speaker": "基里亚",
                                                    "text": "该做的事我都已经做完了，就算最后输给你们，一切也都是我自己的选择，就算从头再来…"
                                                },
                                                {
                                                    "id": "140390768",
                                                    "speaker": "基里亚",
                                                    "text": "呵…又怎么可能从头再来呢？"
                                                },
                                                {
                                                    "id": "140390769",
                                                    "speaker": "柯莱",
                                                    "text": "…大家小心…我在前面开路…"
                                                },
                                                {
                                                    "id": "140390770",
                                                    "speaker": "夏姆",
                                                    "text": "…都跟紧一点…别让艾德加死了…"
                                                },
                                                {
                                                    "id": "140390771",
                                                    "speaker": "基里亚",
                                                    "text": "看来已经没有时间了…我还有最后一个问题想问你，艾梅莉埃。"
                                                },
                                                {
                                                    "id": "140390772",
                                                    "speaker": "艾梅莉埃",
                                                    "text": "…请问吧，老师。"
                                                },
                                                {
                                                    "id": "140390773",
                                                    "speaker": "基里亚",
                                                    "text": "「奥古斯都」谐香里用到的那几种香型…你是怎么判断出来的？"
                                                },
                                                {
                                                    "id": "140390774",
                                                    "speaker": "艾梅莉埃",
                                                    "text": "…「奥古斯都」的香气层次复杂且纷繁，主料却只用到了奥古斯都花一种。"
                                                },
                                                {
                                                    "id": "140390775",
                                                    "speaker": "艾梅莉埃",
                                                    "text": "所以前天研究残液的时候我就在想…会不会是在花卉的培育阶段，就已经完成了这些香型的混合？"
                                                },
                                                {
                                                    "id": "140390776",
                                                    "speaker": "基里亚",
                                                    "text": "你是说…她当初就是比照着这几种花的香韵，来培育的「奥古斯都」？"
                                                },
                                                {
                                                    "id": "140390777",
                                                    "speaker": "艾梅莉埃",
                                                    "text": "虹彩蔷薇、琉璃百合、塞西莉亚花…直接混合它们的精油，会互相冲突排斥，在多年前是无解的难题。"
                                                },
                                                {
                                                    "id": "140390778",
                                                    "speaker": "艾梅莉埃",
                                                    "text": "但如果能培育出一种兼具它们特色的新花种，就规避了这个问题…不得不说，这在过去是个非常天才的想法。"
                                                },
                                                {
                                                    "id": "140390779",
                                                    "speaker": "基里亚",
                                                    "text": "虹彩蔷薇、琉璃百合、塞西莉亚花…呵，真像是你会选的花啊…"
                                                },
                                                {
                                                    "id": "140390780",
                                                    "speaker": "基里亚",
                                                    "text": "…叶莲娜。"
                                                },
                                                {
                                                    "id": "140390781",
                                                    "speaker": "Black Screen",
                                                    "text": "在这之后，镀金旅团匆匆赶到…"
                                                },
                                                {
                                                    "id": "140390782",
                                                    "speaker": "Black Screen",
                                                    "text": "基里亚未发一言，默然接受了命运。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "140390750",
                                            "text": "它本身只是一瓶香水而已。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "140390731",
                            "text": "那是仿制的。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1403908",
            "objective": "询问目击者",
            "dialogues": [
                {
                    "id": "140390201",
                    "speaker": "巴巴尔",
                    "text": "鬼…是鬼啊！"
                },
                {
                    "id": "140390202",
                    "speaker": "艾梅莉埃",
                    "text": "请放松一些，做个深呼吸…能告诉我们你都看到什么了吗？"
                },
                {
                    "id": "140390203",
                    "speaker": "巴巴尔",
                    "text": "哈…哈…我看到一个黑影…从这边过去了…"
                },
                {
                    "id": "140390204",
                    "speaker": "巴巴尔",
                    "text": "大白天的…怎么会撞见这么邪门的东西…"
                }
            ]
        },
        {
            "id": "1403909",
            "objective": "询问目击者",
            "dialogues": [
                {
                    "id": "140390101",
                    "speaker": "巴巴克",
                    "text": "…散发着不妙气息的黑影？"
                },
                {
                    "id": "140390102",
                    "speaker": "巴巴克",
                    "text": "抱歉，我刚刚在专心清点货物，没有看见…"
                }
            ]
        },
        {
            "id": "1403910",
            "objective": "追踪基里亚",
            "dialogues": [
                {
                    "id": "140390301",
                    "speaker": "派蒙",
                    "text": "呼…再往外跑，可就出奥摩斯港了！看到的人会更少吧…"
                },
                {
                    "id": "140390302",
                    "speaker": "艾梅莉埃",
                    "text": "没关系，我已经能隐约闻到气味了，他应该刚经过这里不久。"
                },
                {
                    "id": "140390303",
                    "speaker": "艾梅莉埃",
                    "text": "…是在这个方向，请往这边。"
                }
            ]
        },
        {
            "id": "1403911",
            "objective": "追踪基里亚",
            "dialogues": [
                {
                    "id": "140391101",
                    "speaker": "公告板",
                    "text": "即日起至「花卉展」结束，旅店及周边建筑已由策展方临时租用，暂不接待外客，敬请见谅。"
                }
            ]
        },
        {
            "id": "1403912",
            "objective": "进入秘密花圃",
            "dialogues": []
        },
        {
            "id": "1403913",
            "objective": "与奥乌兹对话",
            "dialogues": [
                {
                    "id": "140390501",
                    "speaker": "伊娜姆",
                    "text": "啊——奥乌兹！"
                },
                {
                    "id": "140390502",
                    "speaker": "伊娜姆",
                    "text": "你没事吧！是…是被谁袭击了吗？"
                },
                {
                    "id": "140390503",
                    "speaker": "奥乌兹",
                    "text": "唔…没、没有…我只是一路追着那个黑影跑进来，然后突然就感觉很难受…"
                },
                {
                    "id": "140390504",
                    "speaker": "艾梅莉埃",
                    "text": "让我来检查一下吧。"
                },
                {
                    "id": "140390505",
                    "speaker": "派蒙",
                    "text": "这里的空气确实有种很压抑的感觉呢…虽然很香，却让人喘不过气…"
                },
                {
                    "id": "140390506",
                    "speaker": "柯莱",
                    "text": "这种感觉…我好像在哪里遇到过…"
                },
                {
                    "id": "140390507",
                    "speaker": "艾梅莉埃",
                    "text": "看起来没有什么大碍。应该只是追得太急，加上环境影响导致的身体不适，出去休息一下应该就会好。"
                },
                {
                    "id": "140390508",
                    "speaker": "奥乌兹",
                    "text": "不行！艾德加先生肯定还在里面…他还教过我妹妹调香…"
                },
                {
                    "id": "140390509",
                    "speaker": "奥乌兹",
                    "text": "——这样的好人，怎么能死在基里亚手上？"
                },
                {
                    "id": "140390510",
                    "speaker": "夏姆",
                    "text": "奥乌兹…你冷静点听我说，艾德加…就是我们要追的基里亚。"
                },
                {
                    "id": "140390511",
                    "speaker": "奥乌兹",
                    "text": "这…这怎么可能！不是说基里亚…是个三十多岁的青年吗？"
                },
                {
                    "id": "140390512",
                    "speaker": "奥乌兹",
                    "text": "艾德加先生现在都七十来岁了…就算是易容，也装不出那副老态吧！"
                },
                {
                    "id": "140390513",
                    "speaker": "艾梅莉埃",
                    "text": "嗯…所以基里亚动用了非常的手段，使自己的身体老化。"
                },
                {
                    "id": "140390514",
                    "speaker": "Player",
                    "text": "…是邪眼。"
                },
                {
                    "id": "140390515",
                    "speaker": "艾梅莉埃",
                    "text": "基里亚用邪眼培育了奥古斯都花，同时也损耗了自己的寿命…就跟他的姐姐一样。"
                },
                {
                    "id": "140390516",
                    "speaker": "奥乌兹",
                    "text": "不…不会的，艾德加先生在奥摩斯港住了那么久！要是有人想伪装成他，我们一定能看出破绽！"
                },
                {
                    "id": "140390517",
                    "speaker": "艾梅莉埃",
                    "text": "但如果这个伪装，从十几年前就开始了呢？"
                },
                {
                    "id": "140390518",
                    "speaker": "奥乌兹",
                    "text": "这…"
                },
                {
                    "id": "140390519",
                    "speaker": "艾梅莉埃",
                    "text": "…虽然还只是推测，但我怀疑真正的调香师艾德加…在枫丹出狱后不久，就已经被基里亚谋害了。"
                },
                {
                    "id": "140390520",
                    "speaker": "艾梅莉埃",
                    "text": "艾德加尚在狱中的那几年里，基里亚就已经做好了顶替的准备：老化的身体、调香的知识…和后续的计划。"
                },
                {
                    "id": "140390521",
                    "speaker": "艾梅莉埃",
                    "text": "当年的「艾德加」借口要忘却旧事，远赴须弥，甚至暂停调香，转而授课…都是为了避免被故人识破。"
                },
                {
                    "id": "140390522",
                    "speaker": "艾梅莉埃",
                    "text": "在无人熟识的须弥，只要简单地易容，蓄起胡须，戴上眼镜…就能让人相信，他就是艾德加…"
                },
                {
                    "id": "140390523",
                    "speaker": "艾梅莉埃",
                    "text": "十多年的漫长岁月里，再一点点地卸去易容，不断地精进自己的技术…周围不会有任何人发现异常。"
                },
                {
                    "id": "140390524",
                    "speaker": "派蒙",
                    "text": "所以席尔万刚见到他的时候，才说他老得都认不出来了…"
                },
                {
                    "id": "140390525",
                    "speaker": "派蒙",
                    "text": "为了复仇，把自己从一个青年，变成一个垂垂老矣的老人…这真的值得吗？"
                },
                {
                    "id": "140390526",
                    "speaker": "奥乌兹",
                    "text": "我…我得去见艾德加先生…他不可能是这种人…咳…咳！"
                },
                {
                    "id": "140390527",
                    "speaker": "夏姆",
                    "text": "喂，你还是赶紧出去休息吧！"
                },
                {
                    "id": "140390528",
                    "speaker": "奥乌兹",
                    "text": "可是我还撑得住…！"
                },
                {
                    "id": "140390529",
                    "speaker": "柯莱",
                    "text": "等等…这里的环境，大概也受到了邪眼的影响。就算现在只是轻微的不适，也不能掉以轻心。"
                },
                {
                    "id": "140390530",
                    "speaker": "柯莱",
                    "text": "奥乌兹先生，我知道怎么缓解这类症状…请先跟我一起出去休息吧。"
                },
                {
                    "id": "140390531",
                    "speaker": "柯莱",
                    "text": "我觉得基里亚…不，是艾德加先生…一定也不希望再牵连到无辜的人了。"
                },
                {
                    "id": "140390532",
                    "speaker": "艾梅莉埃",
                    "text": "#柯莱说得对，后面的探索交给我跟{NICKNAME}就好。从我们少量接触「奥古斯都」而无碍的反应来看…"
                },
                {
                    "id": "140390533",
                    "speaker": "艾梅莉埃",
                    "text": "受神之眼庇佑、或是本身就善用元素力的人，对异常元素力的耐受性也会强些，在这里会相对安全一点。"
                },
                {
                    "id": "140390534",
                    "speaker": "艾梅莉埃",
                    "text": "夏姆先生，奥乌兹先生，这处据点说不定还会有其他出入口。万一目标从那里逃离，就很难再抓住了…"
                },
                {
                    "id": "140390535",
                    "speaker": "艾梅莉埃",
                    "text": "…所以，能请你们在外面搜寻一下吗？"
                },
                {
                    "id": "140390536",
                    "speaker": "奥乌兹",
                    "text": "我…"
                },
                {
                    "id": "140390537",
                    "speaker": "夏姆",
                    "text": "呵…谢了。"
                },
                {
                    "id": "140390538",
                    "speaker": "夏姆",
                    "text": "——喂，没听见吗？快跟我出去，我们还有的是事情要做！回奥摩斯港再多叫点人！"
                },
                {
                    "id": "140390539",
                    "speaker": "奥乌兹",
                    "text": "我明白了…"
                },
                {
                    "id": "140390540",
                    "speaker": "柯莱",
                    "text": "#{NICKNAME}、艾梅莉埃，还有派蒙，你们千万要小心。"
                },
                {
                    "id": "140390541",
                    "speaker": "柯莱",
                    "text": "只为复仇而活的人…在这条路的最后，会做出什么事情…我不敢想象。"
                },
                {
                    "id": "140390542",
                    "speaker": "艾梅莉埃",
                    "text": "放心吧，不管是我们，还是基里亚，都不应该在这里结束。"
                },
                {
                    "id": "140390543",
                    "speaker": "艾梅莉埃",
                    "text": "…「奥古斯都」带来的死亡，是时候跟它的神话一起终结了。"
                }
            ]
        },
        {
            "id": "1403914",
            "objective": "继续深入",
            "dialogues": []
        },
        {
            "id": "1403915",
            "objective": "继续深入",
            "dialogues": [
                {
                    "id": "140390601",
                    "speaker": "派蒙",
                    "text": "哇…这些就是…奥古斯都花？"
                },
                {
                    "id": "140390602",
                    "speaker": "派蒙",
                    "text": "居然有那么多…这得花多少时间啊？还都是一个人干的…"
                },
                {
                    "id": "140390603",
                    "speaker": "艾梅莉埃",
                    "text": "比起开辟园圃的时间，使用邪眼需要付出的寿命，只怕还要更多…"
                },
                {
                    "id": "140390604",
                    "speaker": "派蒙",
                    "text": "不过基里亚，真的需要这么多奥古斯都花吗？"
                },
                {
                    "id": "140390605",
                    "speaker": "派蒙",
                    "text": "想完成他的计划，只要能制作出几瓶「奥古斯都」就够了吧？"
                },
                {
                    "id": "140390606",
                    "speaker": "艾梅莉埃",
                    "text": "…也许除了仇恨以外，他还寄托了别的情感在「奥古斯都」上。"
                },
                {
                    "id": "140390607",
                    "speaker": "Player",
                    "text": "…别的情感？"
                },
                {
                    "id": "140390608",
                    "speaker": "艾梅莉埃",
                    "text": "不久前他跟我说过，不希望旅馆里的花，就这样凋零在异国的土地上。"
                },
                {
                    "id": "140390609",
                    "speaker": "艾梅莉埃",
                    "text": "但对叛离了至冬，告别了枫丹，终生戴着假面生活在须弥的基里亚来说…到底哪里才算他的故乡呢？"
                },
                {
                    "id": "140390610",
                    "speaker": "艾梅莉埃",
                    "text": "大概在他心里，跟姐姐一样，死在开满奥古斯都花的园圃里…才是最好的归宿吧。"
                }
            ]
        },
        {
            "id": "1403916",
            "objective": "继续深入",
            "dialogues": []
        },
        {
            "id": "1403917",
            "objective": "继续深入",
            "dialogues": []
        },
        {
            "id": "1403920",
            "objective": "离开秘密花圃",
            "dialogues": []
        },
        {
            "id": "1403922",
            "objective": "前往秘密花圃入口",
            "dialogues": []
        },
        {
            "id": "1403923",
            "objective": "前往德波大饭店二楼赴约",
            "dialogues": [
                {
                    "id": "140390801",
                    "speaker": "议论纷纷的群众",
                    "text": "…你知道吗？艾梅莉埃小姐要推出新的香水了！"
                },
                {
                    "id": "140390802",
                    "speaker": "议论纷纷的群众",
                    "text": "啊，我也听说了，名字好像是叫…「叶莲娜」…"
                },
                {
                    "id": "140390803",
                    "speaker": "派蒙",
                    "text": "…感觉最近枫丹上下，都在讨论你还没出的新香水呢。"
                },
                {
                    "id": "140390804",
                    "speaker": "艾梅莉埃",
                    "text": "我本来只想低调上架，没想到消息传得这么快。"
                },
                {
                    "id": "140390805",
                    "speaker": "艾梅莉埃",
                    "text": "希望不要又成了另一个「神话」…不然就没有给「奥古斯都」祛魅的意义了。",
                    "choices": [
                        {
                            "id": "140390806",
                            "text": "这香水…",
                            "response": [
                                {
                                    "id": "140390808",
                                    "speaker": "艾梅莉埃",
                                    "text": "嗯，我后来又调整了一下配方，让它的香味能更持久宜人…今天正好带了一些样品过来，希望你们能喜欢。"
                                },
                                {
                                    "id": "140390809",
                                    "speaker": "艾梅莉埃",
                                    "text": "另外…我也想请你们在正式发售前试试香，再说说自己的感想。"
                                },
                                {
                                    "id": "140390810",
                                    "speaker": "派蒙",
                                    "text": "好嘞！我听说味觉灵敏的人，嗅觉也不会差，就交给我吧！"
                                },
                                {
                                    "id": "140390811",
                                    "speaker": "派蒙",
                                    "text": "…嗯…很香！非常好闻！"
                                },
                                {
                                    "id": "140390812",
                                    "speaker": "Player",
                                    "text": "这可不是什么有用的感想…"
                                },
                                {
                                    "id": "140390813",
                                    "speaker": "艾梅莉埃",
                                    "text": "呵呵，没关系，这也是一种值得纳入考量的用户反馈。"
                                },
                                {
                                    "id": "140390814",
                                    "speaker": "艾梅莉埃",
                                    "text": "而且对一款香水来说…「很香」就已经是最直达本质的评价了，不需要有多少深意。"
                                },
                                {
                                    "id": "140390815",
                                    "speaker": "Player",
                                    "text": "说起深意…基里亚最后的问题…"
                                },
                                {
                                    "id": "140390816",
                                    "speaker": "派蒙",
                                    "text": "对哦…那几种花…有什么特别的含义吗？好像他在听到这几个花名的时候，态度就有点变化了…"
                                },
                                {
                                    "id": "140390817",
                                    "speaker": "艾梅莉埃",
                                    "text": "大概…是因为「花语」吧。"
                                },
                                {
                                    "id": "140390818",
                                    "speaker": "派蒙",
                                    "text": "花语？啊，从前好像有听过，塞西莉亚花的「花语」是「浪子的真情」…之类的。"
                                },
                                {
                                    "id": "140390819",
                                    "speaker": "艾梅莉埃",
                                    "text": "每种花在不同的时期、不同人的口中，都会被赋予不同的花语…构成奥古斯都花香气的数种花卉也是这样。"
                                },
                                {
                                    "id": "140390820",
                                    "speaker": "艾梅莉埃",
                                    "text": "我回枫丹后去查了一下…然后发现，将它们的花语拆解组合之后，可以拼出一句话…"
                                },
                                {
                                    "id": "140390821",
                                    "speaker": "艾梅莉埃",
                                    "text": "「…忘记过往，坚强地活下去。」"
                                },
                                {
                                    "id": "140390822",
                                    "speaker": "艾梅莉埃",
                                    "text": "奥古斯都的花语，在世人的眼里是高贵、神圣，但在培育它的叶莲娜眼里…或许是这个意思吧。"
                                },
                                {
                                    "id": "140390823",
                                    "speaker": "Player",
                                    "text": "又或许…这才是她对弟弟的期许…"
                                },
                                {
                                    "id": "140390824",
                                    "speaker": "派蒙",
                                    "text": "对哦！那基里亚…他知道这件事了吗？"
                                },
                                {
                                    "id": "140390825",
                                    "speaker": "艾梅莉埃",
                                    "text": "我在开庭前去探视过一次，也说过这个猜想…但他看起来不是很在意。"
                                },
                                {
                                    "id": "140390826",
                                    "speaker": "艾梅莉埃",
                                    "text": "「谁知道呢？说不定她那时候，什么都没想呢？」——他是这么说的。"
                                },
                                {
                                    "id": "140390827",
                                    "speaker": "艾梅莉埃",
                                    "text": "「…姐姐已经不在了，她真正的想法已经无人能知。后人做的一切注解，都只是附会与猜测。」"
                                },
                                {
                                    "id": "140390828",
                                    "speaker": "艾梅莉埃",
                                    "text": "「就算她真是这么想的，我也没办法忘掉她活着。」"
                                },
                                {
                                    "id": "140390829",
                                    "speaker": "艾梅莉埃",
                                    "text": "「…为她复仇，就是我给自己的人生，赋予的意义。」"
                                },
                                {
                                    "id": "140390830",
                                    "speaker": "艾梅莉埃",
                                    "text": "…他已如自己所愿地绽放过，哪怕没有结出自己希望的果实。"
                                },
                                {
                                    "id": "140390831",
                                    "speaker": "Player",
                                    "text": "…基里亚。"
                                },
                                {
                                    "id": "140390832",
                                    "speaker": "艾梅莉埃",
                                    "text": "不过，老师还是托我给你们带了一句「谢谢」。"
                                },
                                {
                                    "id": "140390833",
                                    "speaker": "艾梅莉埃",
                                    "text": "「…谢谢你们，在那时让我活了下来。让我活着知道了…奥古斯都的『花语』，还有这种可能。」"
                                },
                                {
                                    "id": "140390834",
                                    "speaker": "Player",
                                    "text": "……"
                                },
                                {
                                    "id": "140390835",
                                    "speaker": "艾梅莉埃",
                                    "text": "无论是爱还是恨，都是生者的特权。"
                                },
                                {
                                    "id": "140390836",
                                    "speaker": "艾梅莉埃",
                                    "text": "逝者的思绪早已随生命而去，奥古斯都真正的花语，已经是永远的谜了。"
                                },
                                {
                                    "id": "140390837",
                                    "speaker": "艾梅莉埃",
                                    "text": "但…就算是附会猜测，我也还是愿意相信自己的解读。"
                                },
                                {
                                    "id": "140390838",
                                    "speaker": "艾梅莉埃",
                                    "text": "花语的寓意、香水的象征…尽管会在世事跌宕中不停地被曲解与利用…"
                                },
                                {
                                    "id": "140390839",
                                    "speaker": "艾梅莉埃",
                                    "text": "但最初的最初，它们的诞生，都源自人们最简单、最美好的愿望。"
                                }
                            ]
                        },
                        {
                            "id": "140390807",
                            "text": "是用那时的谐香改良的吗？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1403909",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "140390901",
                    "speaker": "Player",
                    "text": "（时间紧迫，先不要到处乱转了。）"
                }
            ]
        },
        {
            "id": "1403910",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "140391001",
                    "speaker": "巴巴尔",
                    "text": "大白天的…怎么会撞见这么邪门的东西…"
                }
            ]
        },
        {
            "id": "1403999",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "140399901",
                    "speaker": "伊娜姆",
                    "text": "那道黑影当时往升降梯的方向跑了，我的同伴心里着急，立刻就追了过去…"
                },
                {
                    "id": "140399902",
                    "speaker": "艾梅莉埃",
                    "text": "…希望还没发生正面冲突，我们快跟上去吧。"
                },
                {
                    "id": "140399903",
                    "speaker": "派蒙",
                    "text": "他到底是往哪边跑了…唔，问一问附近的商户吧！"
                },
                {
                    "id": "140399904",
                    "speaker": "艾梅莉埃",
                    "text": "气息越来越浓烈了，就是这里。"
                },
                {
                    "id": "140399905",
                    "speaker": "Black Screen",
                    "text": "「奥古斯都」引起的风波就此告一段落…\\n几周后，你接到了艾梅莉埃的书信，邀你在枫丹一叙…"
                },
                {
                    "id": "140399906",
                    "speaker": "议论纷纷的群众",
                    "text": "好可怕…"
                },
                {
                    "id": "140399907",
                    "speaker": "议论纷纷的群众",
                    "text": "别…别过来！"
                }
            ]
        }
    ]
}