    "talks": [
        {
            "id": "7215901",
            "objective": "",
            "dialogues": [
                {
                    "id": "721590101",
                    "speaker": "「公义」",
                    "text": "你来了。"
                },
                {
                    "id": "721590102",
                    "speaker": "「公义」",
                    "text": "是来比试的吗？"
                }
            ]
        },
        {
            "id": "7215902",
            "objective": "",
            "dialogues": [
                {
                    "id": "721590201",
                    "speaker": "Player",
                    "text": "准备接招吧。"
                },
                {
                    "id": "721590202",
                    "speaker": "「公义」",
                    "text": "很好，来吧。"
                }
            ]
        },
        {
            "id": "7215903",
            "objective": "",
            "dialogues": [
                {
                    "id": "721590301",
                    "speaker": "Player",
                    "text": "想和你说说话。"
                },
                {
                    "id": "721590302",
                    "speaker": "「公义」",
                    "text": "我放弃了自己的过去，今后也不想再对这个世界诉说些什么了。"
                },
                {
                    "id": "721590303",
                    "speaker": "「公义」",
                    "text": "只想找人聊天的话，你不该找我。"
                },
                {
                    "id": "721590304",
                    "speaker": "「公义」",
                    "text": "你走吧。"
                }
            ]
        },
        {
            "id": "7215904",
            "objective": "",
            "dialogues": [
                {
                    "id": "721590501",
                    "speaker": "「公义」",
                    "text": "看来你近日来疏于练习。"
                },
                {
                    "id": "721590502",
                    "speaker": "「公义」",
                    "text": "武者稍有一日怠惰便浪费了十日的勤勉，这个道理，你应该知道。"
                },
                {
                    "id": "721590503",
                    "speaker": "「公义」",
                    "text": "回去磨炼自己吧，你不该只有这点本事。"
                }
            ]
        },
        {
            "id": "7215905",
            "objective": "",
            "dialogues": [
                {
                    "id": "721590401",
                    "speaker": "「公义」",
                    "text": "呵呵，竟然还是赢不过你。"
                },
                {
                    "id": "721590402",
                    "speaker": "「公义」",
                    "text": "也罢，你的武技仍在精进，我却因为心性所限再也悟不出更高深的奥义了。"
                },
                {
                    "id": "721590403",
                    "speaker": "「公义」",
                    "text": "不过，若你习得了新的技艺，我依然乐于见识。"
                },
                {
                    "id": "721590404",
                    "speaker": "「公义」",
                    "text": "那么，下次再会吧。"
                }
            ]
        }
    ]
}