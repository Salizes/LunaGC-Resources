    },
    "talks": [
        {
            "id": "7567001",
            "objective": "与科米娜和克维库对话",
            "dialogues": [
                {
                    "id": "756700101",
                    "speaker": "科米娜",
                    "text": "除去高空特训的部分，其他均已完备，总教官。"
                },
                {
                    "id": "756700102",
                    "speaker": "「耶耶副教官」",
                    "text": "耶！"
                },
                {
                    "id": "756700103",
                    "speaker": "克维库",
                    "text": "好，两位都很有精神！"
                },
                {
                    "id": "756700104",
                    "speaker": "克维库",
                    "text": "「回声之子」将是我们伟大计划的第一据点，然后，我们将逐步渗透「流泉之众」、「悬木人」等多个部族…"
                },
                {
                    "id": "756700105",
                    "speaker": "派蒙",
                    "text": "呜哇哇！克维库，你在说些什么可怕的东西！"
                },
                {
                    "id": "756700106",
                    "speaker": "Player",
                    "text": "听起来像神秘间谍组织。"
                },
                {
                    "id": "756700107",
                    "speaker": "克维库",
                    "text": "#欸？是大英雄{NICKNAME}和{M#他}{F#她}的好伙伴派蒙来了呀！"
                },
                {
                    "id": "756700108",
                    "speaker": "克维库",
                    "text": "什么间谍组织？啊哈哈哈哈，你们误会了，我们只是来传授一些能让你和龙伙伴愉快互动的技巧罢了。"
                },
                {
                    "id": "756700109",
                    "speaker": "克维库",
                    "text": "科米娜是我们的随行医生，她会保障每一位参与者的安全。"
                },
                {
                    "id": "756700110",
                    "speaker": "克维库",
                    "text": "「耶耶副教官」是我们特地找来的帮手，在设置关卡目标的时候，它帮了我不少忙呢！"
                },
                {
                    "id": "756700111",
                    "speaker": "克维库",
                    "text": "至于我嘛，是总教官，简而言之，就是组织人，刚刚只是在给他们做动员大会…",
                    "choices": [
                        {
                            "id": "756700112",
                            "text": "还好是误会…",
                            "response": [
                                {
                                    "id": "756700114",
                                    "speaker": "科米娜",
                                    "text": "不好意思！当时我听说克维库先生要做这么有意义的事情，还提议在用词上要更「正规」一些，没想到有些用力过猛了…"
                                },
                                {
                                    "id": "756700115",
                                    "speaker": "克维库",
                                    "text": "哈，不用道歉科米娜小姐，我和「耶耶副教官」都很喜欢你取的称呼呢——对吧？「耶耶副教官」。"
                                },
                                {
                                    "id": "756700116",
                                    "speaker": "「耶耶副教官」",
                                    "text": "呜哇——耶！"
                                },
                                {
                                    "id": "756700117",
                                    "speaker": "克维库",
                                    "text": "#果然满意啊...对了，{NICKNAME}想来试试这些关卡吗？虽然这对你来说是小菜一碟，但也有些不一样的趣味。"
                                },
                                {
                                    "id": "756700118",
                                    "speaker": "Player",
                                    "text": "具体内容是…"
                                },
                                {
                                    "id": "756700119",
                                    "speaker": "克维库",
                                    "text": "很简单，只要和各种各样的龙配合来完成我设定的目标就行了…最关键的点就是你与龙伙伴之间的信任与默契。"
                                },
                                {
                                    "id": "756700120",
                                    "speaker": "克维库",
                                    "text": "只想着一个人把所有目标完成的话，是完全——完全完成不了任何事情的，你必须时时关注你身边的伙伴。"
                                },
                                {
                                    "id": "756700121",
                                    "speaker": "克维库",
                                    "text": "哦，还有，这次暂时没有办法和绒翼龙同行，因为我们还没有准备好高空上的安全措施——再怎么样，安全第一嘛！"
                                },
                                {
                                    "id": "756700122",
                                    "speaker": "派蒙",
                                    "text": "#呜哇哇，来试试吧！{NICKNAME}可最擅长合作了！",
                                    "choices": [
                                        {
                                            "id": "756700123",
                                            "text": "我愿意来试试。",
                                            "response": [
                                                {
                                                    "id": "756700125",
                                                    "speaker": "科米娜",
                                                    "text": "#太好了…如果大家知道了{NICKNAME}都来尝试了，一定会积极参与的！"
                                                },
                                                {
                                                    "id": "756700126",
                                                    "speaker": "派蒙",
                                                    "text": "欸？那么科米娜是不是也应该帮我们取一个「正规」的称呼？最好更威风一些，嘿嘿…"
                                                },
                                                {
                                                    "id": "756700127",
                                                    "speaker": "科米娜",
                                                    "text": "那要等我好好地、慎重地想一想…"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "756700124",
                                            "text": "看在派蒙的面子上…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "756700113",
                            "text": "差点要去揭发你了…"
                        }
                    ]
                }
            ]
        }
    ]
}