    "talks": [
        {
            "id": "1303201",
            "objective": "和兰浮婆一起前往无郁稠林",
            "dialogues": [
                {
                    "id": "130320101",
                    "speaker": "派蒙",
                    "text": "我刚刚就想问了，准备是什么？"
                },
                {
                    "id": "130320102",
                    "speaker": "兰浮婆",
                    "text": "那菈艾文还没有完全想起来，回忆与梦想，都不可或缺。"
                },
                {
                    "id": "130320103",
                    "speaker": "艾文",
                    "text": "梦想…"
                },
                {
                    "id": "130320104",
                    "speaker": "艾文",
                    "text": "可是我，再也站不起来了。就算是恢复，也不知道能不能好，需要多久。"
                },
                {
                    "id": "130320105",
                    "speaker": "兰浮婆",
                    "text": "不需要有这样的担心。那菈艾文要记住，梦想关联的是你的心，而不是身体。"
                },
                {
                    "id": "130320106",
                    "speaker": "艾文",
                    "text": "心…？"
                },
                {
                    "id": "130320107",
                    "speaker": "兰浮婆",
                    "text": "老身就送到这里了。宝贵的东西，就靠那菈艾文自己去找回来吧。"
                },
                {
                    "id": "130320108",
                    "speaker": "宵宫",
                    "text": "欸？他就这样不见了？"
                },
                {
                    "id": "130320109",
                    "speaker": "宵宫",
                    "text": "周围的天色，好像也有点改变了的样子。"
                },
                {
                    "id": "130320110",
                    "speaker": "艾文",
                    "text": "心…"
                },
                {
                    "id": "130320111",
                    "speaker": "艾文",
                    "text": "……！"
                },
                {
                    "id": "130320112",
                    "speaker": "派蒙",
                    "text": "欸——？！"
                },
                {
                    "id": "130320113",
                    "speaker": "艾文",
                    "text": "我…站起来了。"
                },
                {
                    "id": "130320114",
                    "speaker": "艾文",
                    "text": "毫不费力，也没有奇怪的感觉，一切都和生病之前一样。"
                },
                {
                    "id": "130320115",
                    "speaker": "派蒙",
                    "text": "喂，难道说我们…"
                },
                {
                    "id": "130320116",
                    "speaker": "Player",
                    "text": "进入梦里了。"
                },
                {
                    "id": "130320117",
                    "speaker": "派蒙",
                    "text": "嗯，之前也有过这种事，怪不得他说不需要担心，在梦里艾文就是可以自由活动的。"
                },
                {
                    "id": "130320118",
                    "speaker": "艾文",
                    "text": "你们看，我站起来了！嘿嘿，我站起来了。"
                },
                {
                    "id": "130320119",
                    "speaker": "宵宫",
                    "text": "那不是太好了嘛，这样我们就能一起去找兰莎妮了。"
                },
                {
                    "id": "130320120",
                    "speaker": "宵宫",
                    "text": "我们来赛跑吧，正好也让我看看你究竟有多么厉害。"
                },
                {
                    "id": "130320121",
                    "speaker": "艾文",
                    "text": "我可能还没恢复好…"
                },
                {
                    "id": "130320122",
                    "speaker": "艾文",
                    "text": "算了，不管了，来跑吧！就算是大人我也完全不害怕！"
                },
                {
                    "id": "130320123",
                    "speaker": "派蒙",
                    "text": "啊，跑出去了！"
                },
                {
                    "id": "130320124",
                    "speaker": "派蒙",
                    "text": "没想到这么顺利，还以为她需要再适应适应呢。",
                    "choices": [
                        {
                            "id": "130320125",
                            "text": "这就是天赋吧。",
                            "response": [
                                {
                                    "id": "130320127",
                                    "speaker": "派蒙",
                                    "text": "嘿嘿，是啊，我们也追上去吧。"
                                }
                            ]
                        },
                        {
                            "id": "130320126",
                            "text": "这就是愿望吧。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1303202",
            "objective": "追上跑开的艾文",
            "dialogues": [
                {
                    "id": "130320201",
                    "speaker": "艾文",
                    "text": "哈啊，哈啊，还是姐姐比较厉害…"
                },
                {
                    "id": "130320202",
                    "speaker": "宵宫",
                    "text": "嘿嘿，距离长一点还真不好说，我还以为我会被追上呢。"
                },
                {
                    "id": "130320203",
                    "speaker": "派蒙",
                    "text": "艾文好像完全不落下风。"
                },
                {
                    "id": "130320204",
                    "speaker": "艾文",
                    "text": "我以前也跑赢过很多大人，腿长可不一定跑得就快，锻炼也很重要。"
                },
                {
                    "id": "130320205",
                    "speaker": "宵宫",
                    "text": "再过几年，我就不是对手啦，哈哈哈。"
                },
                {
                    "id": "130320206",
                    "speaker": "宵宫",
                    "text": "唔，我看看，接下来应该往哪个方向走呢…"
                },
                {
                    "id": "130320207",
                    "speaker": "派蒙",
                    "text": "欸，快看，前面好像有个东西飘起来了！"
                },
                {
                    "id": "130320208",
                    "speaker": "Player",
                    "text": "像是…星星？"
                },
                {
                    "id": "130320209",
                    "speaker": "艾文",
                    "text": "难道是让我们跟上去吗？"
                },
                {
                    "id": "130320210",
                    "speaker": "宵宫",
                    "text": "嗯，有可能，跟上去看看。"
                }
            ]
        },
        {
            "id": "1303203",
            "objective": "追上飘起的星星",
            "dialogues": []
        },
        {
            "id": "1303204",
            "objective": "继续追赶星星",
            "dialogues": []
        },
        {
            "id": "1303205",
            "objective": "与艾文交谈",
            "dialogues": [
                {
                    "id": "130320501",
                    "speaker": "派蒙",
                    "text": "这里，就是终点了吧，可是没看见兰那罗，只有这块很大的石头。"
                },
                {
                    "id": "130320502",
                    "speaker": "艾文",
                    "text": "太开心了，这种感觉我几乎都已经忘掉了…"
                },
                {
                    "id": "130320503",
                    "speaker": "艾文",
                    "text": "你们知道吗？如果不跑起来，我觉得我的世界只有那么一点。"
                },
                {
                    "id": "130320504",
                    "speaker": "艾文",
                    "text": "但只要不断往前跑，眼前就会不断出现新的景色，世界会无限地在我眼前展开。"
                },
                {
                    "id": "130320505",
                    "speaker": "艾文",
                    "text": "#虽然我不知道我是怎么做到的，但一定是{M#哥哥姐姐们}{F#姐姐们}的功劳吧。"
                },
                {
                    "id": "130320506",
                    "speaker": "宵宫",
                    "text": "哎呀，这个不重要。关键是你想起了很多事啊。"
                },
                {
                    "id": "130320507",
                    "speaker": "宵宫",
                    "text": "记忆不止象征过去，同样拥有照亮未来的力量。"
                },
                {
                    "id": "130320508",
                    "speaker": "宵宫",
                    "text": "只要养好了病，这些快乐就都会回到你的身边。"
                },
                {
                    "id": "130320509",
                    "speaker": "艾文",
                    "text": "嗯，谢谢姐姐，也谢谢你们！"
                },
                {
                    "id": "130320510",
                    "speaker": "艾文",
                    "text": "那我们继续去找兰莎妮吧，他好像不在这里。"
                },
                {
                    "id": "130320511",
                    "speaker": "派蒙",
                    "text": "是啊，但为什么会把我们引到这里来呢…"
                },
                {
                    "id": "130320512",
                    "speaker": "Player",
                    "text": "我也觉得这个石头很显眼。"
                },
                {
                    "id": "130320513",
                    "speaker": "艾文",
                    "text": "我也说不好，不知道它是什么，但总有一种很熟悉的感觉…"
                },
                {
                    "id": "130320514",
                    "speaker": "艾文",
                    "text": "就好像「它」本来就是我的一部分。"
                },
                {
                    "id": "130320515",
                    "speaker": "宵宫",
                    "text": "我知道了！"
                },
                {
                    "id": "130320516",
                    "speaker": "宵宫",
                    "text": "这个石头，是不是就是属于她的「苍松石」啊？"
                },
                {
                    "id": "130320517",
                    "speaker": "艾文",
                    "text": "苍、苍松石？",
                    "choices": [
                        {
                            "id": "130320518",
                            "text": "（宵宫真是会编。）",
                            "response": [
                                {
                                    "id": "130320520",
                                    "speaker": "宵宫",
                                    "text": "那是一种很稀有的矿石，象征的正是一个人的初心与梦想。"
                                },
                                {
                                    "id": "130320521",
                                    "speaker": "宵宫",
                                    "text": "你能见到它，就说明你已经把你失去的东西找回来了啊。"
                                },
                                {
                                    "id": "130320522",
                                    "speaker": "艾文",
                                    "text": "原来是这样…"
                                },
                                {
                                    "id": "130320523",
                                    "speaker": "艾文",
                                    "text": "怎么和童话故事一样，本来我都不相信童话了。"
                                },
                                {
                                    "id": "130320524",
                                    "speaker": "艾文",
                                    "text": "但是，真好啊，我找回来了…"
                                },
                                {
                                    "id": "130320525",
                                    "speaker": "派蒙",
                                    "text": "欸，穿、穿过去了！"
                                },
                                {
                                    "id": "130320526",
                                    "speaker": "宵宫",
                                    "text": "我们也过去！"
                                },
                                {
                                    "id": "130320527",
                                    "speaker": "派蒙",
                                    "text": "#喂，喂，宵宫！唉，没办法了，{NICKNAME}！"
                                },
                                {
                                    "id": "130320528",
                                    "speaker": "派蒙",
                                    "text": "穿过来了，但周围好像没什么变化…"
                                },
                                {
                                    "id": "130320529",
                                    "speaker": "兰莎妮",
                                    "text": "好久不见，那菈艾文。好久不见了，对吗？"
                                },
                                {
                                    "id": "130320530",
                                    "speaker": "艾文",
                                    "text": "兰莎妮…"
                                },
                                {
                                    "id": "130320531",
                                    "speaker": "兰莎妮",
                                    "text": "为什么要露出悲伤的样子，哦，兰莎妮明白了，这是开心的样子。"
                                },
                                {
                                    "id": "130320532",
                                    "speaker": "艾文",
                                    "text": "兰莎妮！呜哇哇啊啊啊——"
                                },
                                {
                                    "id": "130320533",
                                    "speaker": "宵宫",
                                    "text": "哈哈哈，兰那罗为我们准备的旅程，真是浪漫啊。"
                                },
                                {
                                    "id": "130320534",
                                    "speaker": "宵宫",
                                    "text": "不仅是让她找回了最重要的朋友，也让我们知道了「苍松石」究竟是什么。"
                                },
                                {
                                    "id": "130320535",
                                    "speaker": "宵宫",
                                    "text": "等会儿我们也要去找属于我们的「苍松石」哦，我一定要做出最纯净的透镜。"
                                },
                                {
                                    "id": "130320536",
                                    "speaker": "派蒙",
                                    "text": "嗯！不知道为什么，我也有一种能做到的感觉！",
                                    "choices": [
                                        {
                                            "id": "130320537",
                                            "text": "这就是冒险吧。",
                                            "response": [
                                                {
                                                    "id": "130320539",
                                                    "speaker": "宵宫",
                                                    "text": "不过首先还是得先把她送回须弥城，不要让她的母亲太担心了。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "130320538",
                                            "text": "我也乐在其中。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "130320519",
                            "text": "（我都快把这事忘了。）"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1303206",
            "objective": "与宵宫交谈",
            "dialogues": [
                {
                    "id": "130320601",
                    "speaker": "艾文",
                    "text": "这、这是…结束了啊。"
                },
                {
                    "id": "130320602",
                    "speaker": "宵宫",
                    "text": "做了个非常非常好的梦啊。"
                },
                {
                    "id": "130320603",
                    "speaker": "宵宫",
                    "text": "不用露出寂寞的表情哦，他就在你的旁边。"
                },
                {
                    "id": "130320604",
                    "speaker": "艾文",
                    "text": "兰莎妮！太好了，你还在…"
                },
                {
                    "id": "130320605",
                    "speaker": "兰莎妮",
                    "text": "兰莎妮想道歉，不是兰莎妮不想去找那菈，只是兰莎妮记不清时间。"
                },
                {
                    "id": "130320606",
                    "speaker": "兰莎妮",
                    "text": "兰莎妮不敢去城里，没见到那菈，兰莎妮以为那菈艾文交到了新的朋友。"
                },
                {
                    "id": "130320607",
                    "speaker": "兰浮婆",
                    "text": "这是常有的事，也是没办法的事，并不是遗憾的事。"
                },
                {
                    "id": "130320608",
                    "speaker": "艾文",
                    "text": "没关系，我明白，都是因为我没能振作起来。"
                },
                {
                    "id": "130320609",
                    "speaker": "艾文",
                    "text": "但是现在我已经想明白了，姐姐说得很对，坏运气谁都会遇到，重要的是互相搀扶。"
                },
                {
                    "id": "130320610",
                    "speaker": "艾文",
                    "text": "谢谢大家的帮助，我不会辜负大家帮我找回的记忆和梦想。"
                },
                {
                    "id": "130320611",
                    "speaker": "宵宫",
                    "text": "嘿嘿，你也帮了姐姐很多哦，不用客气。本来我们对「苍松石」还一头雾水呢。"
                },
                {
                    "id": "130320612",
                    "speaker": "宵宫",
                    "text": "按现在这样的思路，我觉得我们也很快就能找到。"
                },
                {
                    "id": "130320613",
                    "speaker": "艾文",
                    "text": "姐姐是想看一场流星雨对吧，是因为这个需要「苍松石」吗？"
                },
                {
                    "id": "130320614",
                    "speaker": "宵宫",
                    "text": "嗯，对了，到时候我们找到了，你也来一起看吧！"
                },
                {
                    "id": "130320615",
                    "speaker": "艾文",
                    "text": "如果是这样的话…"
                },
                {
                    "id": "130320616",
                    "speaker": "艾文",
                    "text": "我愿意把「苍松石」借给你。"
                },
                {
                    "id": "130320617",
                    "speaker": "派蒙",
                    "text": "欸？！"
                },
                {
                    "id": "130320618",
                    "speaker": "派蒙",
                    "text": "这、这是怎么回事啊？从胸口里拿出了一个…眼镜？"
                },
                {
                    "id": "130320619",
                    "speaker": "Player",
                    "text": "我也不知道。"
                },
                {
                    "id": "130320620",
                    "speaker": "兰浮婆",
                    "text": "……"
                },
                {
                    "id": "130320621",
                    "speaker": "宵宫",
                    "text": "哈哈哈，你怎么知道我需要这个？"
                },
                {
                    "id": "130320622",
                    "speaker": "艾文",
                    "text": "我也不知道，我只是觉得你帮我找回来了最好的朋友，我也要用最珍贵的东西帮你…"
                },
                {
                    "id": "130320623",
                    "speaker": "艾文",
                    "text": "然后光就变成了这个样子，这是你需要的吗？"
                },
                {
                    "id": "130320624",
                    "speaker": "宵宫",
                    "text": "谢谢你，没想到这样就解决了，那我现在就试试看。"
                },
                {
                    "id": "130320625",
                    "speaker": "宵宫",
                    "text": "虽然不太清楚用法，姑且就凭直觉…"
                },
                {
                    "id": "130320626",
                    "speaker": "宵宫",
                    "text": "在哪里呢，在哪里呢？"
                },
                {
                    "id": "130320627",
                    "speaker": "宵宫",
                    "text": "哦！我好像看到了，还挺明显的嘛。"
                },
                {
                    "id": "130320628",
                    "speaker": "宵宫",
                    "text": "走吧，我来带路。我们看完流星雨之后再送你回家。"
                },
                {
                    "id": "130320629",
                    "speaker": "宵宫",
                    "text": "也谢谢你愿意帮我们，客套的话就不多说了，我有一句由衷的夸奖——"
                },
                {
                    "id": "130320630",
                    "speaker": "宵宫",
                    "text": "你们真的很会讲故事！"
                },
                {
                    "id": "130320631",
                    "speaker": "兰浮婆",
                    "text": "哎呀，真是巧合。老身对你也有相同的评价，红色的那菈。"
                }
            ]
        },
        {
            "id": "1303208",
            "objective": "前去观赏流星雨",
            "dialogues": []
        },
        {
            "id": "1303209",
            "objective": "与宵宫交谈",
            "dialogues": [
                {
                    "id": "130320901",
                    "speaker": "派蒙",
                    "text": "唔…唔…"
                },
                {
                    "id": "130320902",
                    "speaker": "派蒙",
                    "text": "怎么就醒过来了，我还没看够呢。"
                },
                {
                    "id": "130320903",
                    "speaker": "宵宫",
                    "text": "我们用愿望召唤出的流星，居然是从地上飞出来的…"
                },
                {
                    "id": "130320904",
                    "speaker": "宵宫",
                    "text": "这不是和烟花一模一样嘛！"
                },
                {
                    "id": "130320905",
                    "speaker": "宵宫",
                    "text": "——意犹未尽，意犹未尽啊，这真是我做过的最真实，最豪华，最浪漫的一场梦！"
                },
                {
                    "id": "130320906",
                    "speaker": "派蒙",
                    "text": "我也是，不过我真没想到，你会直接带着我们跳上去。"
                },
                {
                    "id": "130320907",
                    "speaker": "宵宫",
                    "text": "嘿嘿，其实我也没想太多，只是觉得不趁机胡闹一次，那就太可惜了。",
                    "choices": [
                        {
                            "id": "130320908",
                            "text": "宵宫，你其实…",
                            "response": [
                                {
                                    "id": "130320910",
                                    "speaker": "宵宫",
                                    "text": "你知道我的，是不是梦之类的问题，我完全不在乎。"
                                },
                                {
                                    "id": "130320911",
                                    "speaker": "宵宫",
                                    "text": "但我还是要感谢你们，这一切都是你们知道了流星雨没那么容易看到，所以才准备的替代方案吧。"
                                },
                                {
                                    "id": "130320912",
                                    "speaker": "宵宫",
                                    "text": "我很喜欢哦，非常非常喜欢，就算在我收到过的所有礼物里排名，都是最好的。"
                                },
                                {
                                    "id": "130320913",
                                    "speaker": "派蒙",
                                    "text": "那就好，那就好，我还担心和你解释了真相，你会生气呢。"
                                },
                                {
                                    "id": "130320914",
                                    "speaker": "宵宫",
                                    "text": "怎么会呢？我梦见了乐于助人，性格友善，可可爱爱的兰那罗…"
                                },
                                {
                                    "id": "130320915",
                                    "speaker": "宵宫",
                                    "text": "还梦见了我们在一堆大蘑菇里到处跑到处飞，用意料之外的方式找到了「苍松石」…"
                                },
                                {
                                    "id": "130320916",
                                    "speaker": "宵宫",
                                    "text": "原本以为醒过来了，接下来的事情却更加了不起。"
                                },
                                {
                                    "id": "130320917",
                                    "speaker": "宵宫",
                                    "text": "艾文从心口取出了「苍松石」变成的眼镜，我们一起找到了从地上飞起来的流星，成为了流星的一部分…",
                                    "choices": [
                                        {
                                            "id": "130320918",
                                            "text": "我们一直都在梦中。",
                                            "response": [
                                                {
                                                    "id": "130320920",
                                                    "speaker": "宵宫",
                                                    "text": "是啊，虽然梦是虚幻的，但同样是不可复制，不可重温的一次「经历」。"
                                                },
                                                {
                                                    "id": "130320921",
                                                    "speaker": "宵宫",
                                                    "text": "如果拘泥于真假，那岂不是就错过了很多美好与感动嘛。"
                                                },
                                                {
                                                    "id": "130320922",
                                                    "speaker": "派蒙",
                                                    "text": "嘿嘿，宵宫真会夸。我要把你在「派蒙的好朋友」排行榜上再提高一位！"
                                                },
                                                {
                                                    "id": "130320923",
                                                    "speaker": "Player",
                                                    "text": "还有这种排行榜…"
                                                },
                                                {
                                                    "id": "130320924",
                                                    "speaker": "派蒙",
                                                    "text": "对了，说到兰那罗，他们不愿意被…"
                                                },
                                                {
                                                    "id": "130320925",
                                                    "speaker": "宵宫",
                                                    "text": "对啊对啊，兰那罗也好可爱，这还要多亏了那些制作精美的木刻。"
                                                },
                                                {
                                                    "id": "130320926",
                                                    "speaker": "派蒙",
                                                    "text": "欸，木刻？"
                                                },
                                                {
                                                    "id": "130320927",
                                                    "speaker": "宵宫",
                                                    "text": "对啊，如果我们没见过木刻，怎么会梦见那种样子的兰那罗嘛。"
                                                },
                                                {
                                                    "id": "130320928",
                                                    "speaker": "派蒙",
                                                    "text": "……？",
                                                    "choices": [
                                                        {
                                                            "id": "130320929",
                                                            "text": "宵宫明白我们的意思了。",
                                                            "response": [
                                                                {
                                                                    "id": "130320931",
                                                                    "speaker": "宵宫",
                                                                    "text": "嘻嘻，放心啦，我懂的。我觉得他们的形象很可爱，我很乐意保护他们。"
                                                                },
                                                                {
                                                                    "id": "130320932",
                                                                    "speaker": "宵宫",
                                                                    "text": "好了，时间也差不多了，该送她回家了。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "130320930",
                                                            "text": "我也觉得比木刻更可爱。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "130320919",
                                            "text": "我们从未醒来。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "130320909",
                            "text": "早就意识到是梦了吧。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1303211",
            "objective": "去奥摩斯港送宵宫回家",
            "dialogues": [
                {
                    "id": "130321105",
                    "speaker": "宵宫",
                    "text": "须弥真是个好地方，下次我还要来玩。"
                },
                {
                    "id": "130321106",
                    "speaker": "妮欧莎",
                    "text": "随时欢迎你过来，艾文也会很开心的。"
                },
                {
                    "id": "130321107",
                    "speaker": "艾文",
                    "text": "一言为定哦，我会一直等你过来。"
                },
                {
                    "id": "130321108",
                    "speaker": "宵宫",
                    "text": "哈哈哈，没问题。"
                },
                {
                    "id": "130321109",
                    "speaker": "艾文",
                    "text": "姐姐，在你回去之前，我还想告诉你——我有了一个新的梦想。"
                },
                {
                    "id": "130321110",
                    "speaker": "艾文",
                    "text": "我要靠自己去稻妻，见识一下稻妻的烟花。"
                },
                {
                    "id": "130321111",
                    "speaker": "宵宫",
                    "text": "哦，很了不起嘛！呵呵，我也没想到出来玩还能给家里的烟花店拉到客人。"
                },
                {
                    "id": "130321112",
                    "speaker": "宵宫",
                    "text": "放心吧，我会专门为你设计一个烟花，让你过目不忘。"
                },
                {
                    "id": "130321113",
                    "speaker": "宵宫",
                    "text": "你们也是，不管冒险再忙，也要常来稻妻看看，无论什么时候，大家都很欢迎你们。"
                },
                {
                    "id": "130321114",
                    "speaker": "宵宫",
                    "text": "这次旅行的成果，说什么也要在你们的见证之下，让它升上天空！"
                },
                {
                    "id": "130321115",
                    "speaker": "派蒙",
                    "text": "好的，一言为定！",
                    "choices": [
                        {
                            "id": "130321116",
                            "text": "路上保重。",
                            "response": [
                                {
                                    "id": "130321117",
                                    "speaker": "宵宫",
                                    "text": "会的会的，你还是这么稳重，嘿嘿。"
                                },
                                {
                                    "id": "130321122",
                                    "speaker": "宵宫",
                                    "text": "对了对了，你看这是什么？"
                                },
                                {
                                    "id": "130321123",
                                    "speaker": "Player",
                                    "text": "兰那罗木刻…"
                                },
                                {
                                    "id": "130321124",
                                    "speaker": "宵宫",
                                    "text": "对哦，是你帮我挑的那个款式，你和派蒙都说觉得有点像我。刚刚我也去买了一个，送给你。"
                                },
                                {
                                    "id": "130321125",
                                    "speaker": "宵宫",
                                    "text": "不开心的时候就看看这个，说不定就能让你打起精神，觉得至少还有我在支持你。"
                                },
                                {
                                    "id": "130321126",
                                    "speaker": "宵宫",
                                    "text": "当然，最好还是来见我本人啦，嘿嘿。",
                                    "choices": [
                                        {
                                            "id": "130321127",
                                            "text": "谢谢你。",
                                            "response": [
                                                {
                                                    "id": "130321129",
                                                    "speaker": "宵宫",
                                                    "text": "嗯，那我回去啦，我相信我们很快又能再见的。"
                                                },
                                                {
                                                    "id": "130321130",
                                                    "speaker": "宵宫",
                                                    "text": "我很喜欢你们为我准备的旅行，嗯，不如说，是很钦佩！"
                                                },
                                                {
                                                    "id": "130321131",
                                                    "speaker": "宵宫",
                                                    "text": "这份友善与温柔，无论你们走到哪里，都会成为支撑你们后背的强大力量。"
                                                },
                                                {
                                                    "id": "130321132",
                                                    "speaker": "宵宫",
                                                    "text": "就像这样，走到旅途的终点，世界的尽头吧！"
                                                },
                                                {
                                                    "id": "130321133",
                                                    "speaker": "宵宫",
                                                    "text": "再见咯！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "130321128",
                                            "text": "我会珍惜的。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "130321118",
                            "text": "天天开心。",
                            "response": [
                                {
                                    "id": "130321119",
                                    "speaker": "宵宫",
                                    "text": "天天开心，永远开心！"
                                }
                            ]
                        },
                        {
                            "id": "130321120",
                            "text": "烟花易逝，人情长存！",
                            "response": [
                                {
                                    "id": "130321121",
                                    "speaker": "宵宫",
                                    "text": "你、你突然喊出来干什么啦，怪不好意思的…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "1303210",
            "objective": "(test)调整时间",
            "dialogues": []
        },
        {
            "id": "1303299",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "130329901",
                    "speaker": "艾文",
                    "text": "（姐姐好厉害…但以前的我是不会输的。）"
                },
                {
                    "id": "130329902",
                    "speaker": "宵宫",
                    "text": "（居然差点就被追上了，她真是不简单。）"
                },
                {
                    "id": "130329908",
                    "speaker": "Black Screen",
                    "text": "在梦境中迷失，恍惚间回到了原点"
                }
            ]
        }
    ]
}