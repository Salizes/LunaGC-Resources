{
    "quest": {
        "id": "23016",
        "title": "加尔恰的赞歌·举手之劳",
        "description": "加尔恰似乎正在铁匠铺里挥汗如雨…",
        "rewards": [],
        "rewards_formatted": "",
        "chapter": {
            "icon": "",
            "id": "",
            "num": "",
            "title": ""
        },
        "total_dialogue_lines": 83,
        "total_speaker_counts": {
            "Black Screen": 3,
