            "加尔恰": 27,
            "路通": 15,
            "阿汉格尔": 22
        }
    },
    "talks": [
        {
            "id": "2301601",
            "objective": "与加尔恰对话",
            "dialogues": [
                {
                    "id": "230160101",
                    "speaker": "加尔恰",
                    "text": "我的手…呃！全麻了…"
                },
                {
                    "id": "230160102",
                    "speaker": "路通",
                    "text": "先生，您过段时间还要给迦雅小姐计算账目，可不要过分劳累。"
                },
                {
                    "id": "230160103",
                    "speaker": "加尔恰",
                    "text": "我，我知道！别提这个，路通！"
                },
                {
                    "id": "230160104",
                    "speaker": "路通",
                    "text": "当然，如果您不能去的话，我也可以为您代劳。"
                },
                {
                    "id": "230160105",
                    "speaker": "加尔恰",
                    "text": "不！我自己会去，我只要再…再砸出几个齿轮来…"
                },
                {
                    "id": "230160106",
                    "speaker": "加尔恰",
                    "text": "……"
                },
                {
                    "id": "230160107",
                    "speaker": "加尔恰",
                    "text": "好吧，我砸不动了，我真的砸不动了…"
                },
                {
                    "id": "230160108",
                    "speaker": "Player",
                    "text": "你又在干啥…"
                },
                {
                    "id": "230160109",
                    "speaker": "加尔恰",
                    "text": "是你啊，旅行者…哎哟…我的手…"
                },
                {
                    "id": "230160110",
                    "speaker": "加尔恰",
                    "text": "是这样，因为阿汉格尔先生还有其他的工作，不能一直帮我制作我要的零件…"
                },
                {
                    "id": "230160111",
                    "speaker": "加尔恰",
                    "text": "而且他所制作的零件，总是和我想要的有一些细微的差别。"
                },
                {
                    "id": "230160112",
                    "speaker": "加尔恰",
                    "text": "所以，为了保证这些零件的可靠性，我就直接向阿汉格尔先生请教了一下铸造的手法，决定自己来亲手铸造。"
                },
                {
                    "id": "230160113",
                    "speaker": "加尔恰",
                    "text": "还好在枫丹的时候我有过类似的工作经验…但阿汉格尔先生和我说的那些手法，有些我是真记不住，哎哟…"
                },
                {
                    "id": "230160114",
                    "speaker": "加尔恰",
                    "text": "旅行者，请您代我向阿汉格尔先生再请教一下手法，我是真的需要休息一下…",
                    "choices": [
                        {
                            "id": "230160115",
                            "text": "你在这好好休息。",
                            "response": [
                                {
                                    "id": "230160121",
                                    "speaker": "加尔恰",
                                    "text": "谢谢您愿意帮忙，哎哟…我的手…"
                                }
                            ]
                        },
                        {
                            "id": "230160116",
                            "text": "迦雅是谁？",
                            "response": [
                                {
                                    "id": "230160117",
                                    "speaker": "加尔恰",
                                    "text": "生意伙伴！一个…呃…才华横溢，财富也横溢的…生意伙伴！"
                                },
                                {
                                    "id": "230160118",
                                    "speaker": "加尔恰",
                                    "text": "我们之间签了长期的账目管理合同！所以我才会一直去找她，对吧路通？"
                                },
                                {
                                    "id": "230160119",
                                    "speaker": "路通",
                                    "text": "您说得很有道理，先生。"
                                },
                                {
                                    "id": "230160120",
                                    "speaker": "加尔恰",
                                    "text": "总，总之就是这样…旅行者，请您快些去找阿汉格尔先生请教一下吧，我就在这等您。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2301602",
            "objective": "询问阿汉格尔",
            "dialogues": [
                {
                    "id": "230160201",
                    "speaker": "阿汉格尔",
                    "text": "都说了等一会…嗯？怎么是你？",
                    "choices": [
                        {
                            "id": "230160202",
                            "text": "我是代他来请教的。",
                            "response": [
                                {
                                    "id": "230160204",
                                    "speaker": "阿汉格尔",
                                    "text": "他还真去自己做了啊…真是个怪人。"
                                },
                                {
                                    "id": "230160205",
                                    "speaker": "阿汉格尔",
                                    "text": "我打了这么多年铁，从来没见过要求这么细致的人。"
                                },
                                {
                                    "id": "230160206",
                                    "speaker": "阿汉格尔",
                                    "text": "他居然还会拿着尺量铁管之间的接缝粗细，还有螺纹的间距。"
                                },
                                {
                                    "id": "230160207",
                                    "speaker": "阿汉格尔",
                                    "text": "我实在是不耐烦了，就说他有本事自己去做…结果他第二天还真的过来请教铸造的手法。"
                                },
                                {
                                    "id": "230160208",
                                    "speaker": "阿汉格尔",
                                    "text": "我真是服了他了，就随他去了，只要他自己出材料钱，工具什么的都让他用。"
                                },
                                {
                                    "id": "230160209",
                                    "speaker": "阿汉格尔",
                                    "text": "唉，真不知道这家伙想做什么东西…",
                                    "choices": [
                                        {
                                            "id": "230160210",
                                            "text": "他在做一个伟大的机器。",
                                            "response": [
                                                {
                                                    "id": "230160212",
                                                    "speaker": "阿汉格尔",
                                                    "text": "行吧…反正都是怪东西。你们是来问铸造手法的对吧？做齿轮这件事我也没什么好教的…"
                                                },
                                                {
                                                    "id": "230160213",
                                                    "speaker": "阿汉格尔",
                                                    "text": "不过，我注意到这家伙要的齿轮边缘都很锐利，中间却要凹下去…"
                                                },
                                                {
                                                    "id": "230160214",
                                                    "speaker": "阿汉格尔",
                                                    "text": "这种异型齿轮单靠模具很难直接做出来，他必须要再把齿轮二次加工。"
                                                },
                                                {
                                                    "id": "230160215",
                                                    "speaker": "阿汉格尔",
                                                    "text": "具体操作我之前都教过他了，你就回去告诉他…"
                                                },
                                                {
                                                    "id": "230160216",
                                                    "speaker": "阿汉格尔",
                                                    "text": "首先，二次入炉的时候，<color=#00E1FFFF>燃料记得加多点</color>。"
                                                },
                                                {
                                                    "id": "230160217",
                                                    "speaker": "阿汉格尔",
                                                    "text": "然后，拿出来加工的时候，<color=#00E1FFFF>从内向外敲打</color>。"
                                                },
                                                {
                                                    "id": "230160218",
                                                    "speaker": "阿汉格尔",
                                                    "text": "怎么样，记住了吗？记住了就回去告诉他吧。"
                                                },
                                                {
                                                    "id": "230160219",
                                                    "speaker": "阿汉格尔",
                                                    "text": "真是个怪人…"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "230160211",
                                            "text": "他在做一个奇怪的机器。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "230160203",
                            "text": "他手敲麻了，休息一下。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "2301603",
            "objective": "向加尔恰回报",
            "dialogues": [
                {
                    "id": "230163901",
                    "speaker": "Black Screen",
                    "text": "加尔恰开始了操作…"
                },
                {
                    "id": "230163902",
                    "speaker": "加尔恰",
                    "text": "啊哈！成功了，这个齿轮不错！"
                },
                {
                    "id": "230163903",
                    "speaker": "加尔恰",
                    "text": "齿间距…厚度…大小…我得拿个尺子来看看…"
                },
                {
                    "id": "230163904",
                    "speaker": "路通",
                    "text": "就让加尔恰先生去测量数据吧，旅行者，这些报酬给你，请你收下吧。"
                },
                {
                    "id": "230163905",
                    "speaker": "Player",
                    "text": "你还抱着谨慎悲观的态度吗？"
                },
                {
                    "id": "230163906",
                    "speaker": "路通",
                    "text": "是的，我一直是这样的态度。"
                },
                {
                    "id": "230163907",
                    "speaker": "路通",
                    "text": "我和加尔恰先生正在一座大山前徘徊，现在我们只是在山脚下搬开了一小块石头。"
                },
                {
                    "id": "230163908",
                    "speaker": "路通",
                    "text": "但事实上，我们根本就没找到能进入山里的路。"
                },
                {
                    "id": "230163909",
                    "speaker": "路通",
                    "text": "希望加尔恰先生的才能，能引导着我们走上正确的道路…"
                },
                {
                    "id": "230163910",
                    "speaker": "路通",
                    "text": "不然我就只能默念那句「车到山前必有路」了。"
                }
            ]
        },
        {
            "id": "2301603",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "230160301",
                    "speaker": "加尔恰",
                    "text": "路通！这个齿轮可以脱模了，快来帮帮忙！"
                },
                {
                    "id": "230160302",
                    "speaker": "加尔恰",
                    "text": "旅行者，你也回来了，你应该已经向阿汉格尔先生请教到手法了吧。"
                },
                {
                    "id": "230160303",
                    "speaker": "加尔恰",
                    "text": "快，快，我该怎么处理这齿轮？"
                }
            ]
        },
        {
            "id": "2301631",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "230163101",
                    "speaker": "Player",
                    "text": "二次入炉的时候，燃料记得加多点。"
                }
            ]
        },
        {
            "id": "2301632",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "230163201",
                    "speaker": "Player",
                    "text": "二次入炉的时候，别加额外燃料。"
                }
            ]
        },
        {
            "id": "2301633",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "230163301",
                    "speaker": "Player",
                    "text": "二次入炉的时候，燃料记得加少点。"
                }
            ]
        },
        {
            "id": "2301634",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "230163401",
                    "speaker": "Black Screen",
                    "text": "加尔恰开始了操作…"
                },
                {
                    "id": "230163402",
                    "speaker": "加尔恰",
                    "text": "好吧，这齿轮出炉了…然后呢？"
                }
            ]
        },
        {
            "id": "2301635",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "230163501",
                    "speaker": "Player",
                    "text": "从内向外敲打。"
                }
            ]
        },
        {
            "id": "2301636",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "230163601",
                    "speaker": "Player",
                    "text": "从外向内敲打。"
                }
            ]
        },
        {
            "id": "2301637",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "230163701",
                    "speaker": "Player",
                    "text": "猛烈敲打中间。"
                }
            ]
        },
        {
            "id": "2301638",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "230163801",
                    "speaker": "Black Screen",
                    "text": "加尔恰开始了操作…"
                },
                {
                    "id": "230163802",
                    "speaker": "加尔恰",
                    "text": "呃…这齿轮看着好像…不太对啊。"
                },
                {
                    "id": "230163803",
                    "speaker": "加尔恰",
                    "text": "没关系，我们再来一次…旅行者，我要注意什么？"
                }
            ]
        },
        {
            "id": "2301650",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "230165001",
                    "speaker": "路通",
                    "text": "先生，依我来看，我们也许应该…换一个思路。"
                },
                {
                    "id": "230165002",
                    "speaker": "加尔恰",
                    "text": "换一个思路？"
                },
                {
                    "id": "230165003",
                    "speaker": "路通",
                    "text": "比如，尝试制作一些不那么复杂，但足够巧妙的机械。"
                },
                {
                    "id": "230165004",
                    "speaker": "路通",
                    "text": "我相信以您的才能，制作出这类机械一定…"
                },
                {
                    "id": "230165005",
                    "speaker": "加尔恰",
                    "text": "亲爱的路通，我们之前就讨论过这个问题了，你知道我的回答…而我也会始终尊重你的选择"
                },
                {
                    "id": "230165006",
                    "speaker": "路通",
                    "text": "我们还是来讨论一下您下次和迦雅小姐共进晚餐的地点吧，先生。"
                },
                {
                    "id": "230165007",
                    "speaker": "加尔恰",
                    "text": "谢谢你，路通。"
                },
                {
                    "id": "230165008",
                    "speaker": "路通",
                    "text": "不客气，先生，我们俩签的合同还没结束呢。"
                }
            ]
        },
        {
            "id": "2301651",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "230165101",
                    "speaker": "阿汉格尔",
                    "text": "还有什么事吗？",
                    "choices": [
                        {
                            "id": "230165102",
                            "text": "加尔恰在这里很久了吗？",
                            "response": [
                                {
                                    "id": "230165103",
                                    "speaker": "阿汉格尔",
                                    "text": "有一段时间了吧，这家伙学习的热情比一些学徒都高。"
                                },
                                {
                                    "id": "230165104",
                                    "speaker": "阿汉格尔",
                                    "text": "但他这个样子，实在不像是想拿打铁这门手艺吃饭的人啊…"
                                }
                            ]
                        },
                        {
                            "id": "230165105",
                            "text": "除我之外，有人来找过他们吗？",
                            "response": [
                                {
                                    "id": "230165106",
                                    "speaker": "阿汉格尔",
                                    "text": "嗯…倒是有一个女人时不时地过来找他，还带着不少东西。"
                                },
                                {
                                    "id": "230165107",
                                    "speaker": "阿汉格尔",
                                    "text": "我听他说，这个女人叫迦雅…还是什么的。"
                                },
                                {
                                    "id": "230165108",
                                    "speaker": "阿汉格尔",
                                    "text": "这群看起来就和打铁不沾边的人，为什么会一直聚在我这铁匠铺里呢…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2301652",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "230165201",
                    "speaker": "阿汉格尔",
                    "text": "这家伙到底想要做什么东西…"
                }
            ]
        },
        {
            "id": "2301699",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "230169901",
                    "speaker": "加尔恰",
                    "text": "（齿轮的尺寸是…上次迦雅帮我记过…呃！我到底怎么了？！天啊…）"
                },
                {
                    "id": "230169902",
                    "speaker": "路通",
                    "text": "（也许我该去找迦雅小姐谈谈了…）"
                }
            ]
        }
    ]
}