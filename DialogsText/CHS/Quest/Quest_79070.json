    "talks": [
        {
            "id": "7907001",
            "objective": "(test)日后谈1$HIDDEN",
            "dialogues": [
                {
                    "id": "790700101",
                    "speaker": "西梅",
                    "text": "阁下。我代表铃风王国欢迎您。"
                },
                {
                    "id": "790700102",
                    "speaker": "Player",
                    "text": "接下来你们准备怎么做？"
                },
                {
                    "id": "790700103",
                    "speaker": "西梅",
                    "text": "唔…首先，我会向整个王国公告，圣物已经做出了判断。"
                },
                {
                    "id": "790700104",
                    "speaker": "西梅",
                    "text": "守护者嘛…则是那位远道而来的福罗贝尔先生。"
                },
                {
                    "id": "790700105",
                    "speaker": "派蒙",
                    "text": "欸？！为什么要这么做？"
                },
                {
                    "id": "790700106",
                    "speaker": "西梅",
                    "text": "想要向大家解释我们所经历的那件事，实在是太过复杂了。"
                },
                {
                    "id": "790700107",
                    "speaker": "西梅",
                    "text": "而且，大家一时半会应该也没法理解，为什么我既是公主，又是守护者。"
                },
                {
                    "id": "790700108",
                    "speaker": "西梅",
                    "text": "等到时机合适的时候，我会将所有的事详细地记录下来，以书面的形式告诉所有国民。"
                },
                {
                    "id": "790700109",
                    "speaker": "西梅",
                    "text": "在那之前，我还是会以公主的身份主持王国的各项事宜。"
                },
                {
                    "id": "790700110",
                    "speaker": "西梅",
                    "text": "等到将那些「试炼场所」正式改造成了「锻炼场所」后，我就会启程了。",
                    "choices": [
                        {
                            "id": "790700111",
                            "text": "启程？",
                            "response": [
                                {
                                    "id": "790700113",
                                    "speaker": "福罗贝尔",
                                    "text": "公主殿下，你还记得…在洞窟的时候，那个圣物究竟是为谁亮起的吗？"
                                },
                                {
                                    "id": "790700114",
                                    "speaker": "西梅",
                                    "text": "欸？为谁…亮起？"
                                },
                                {
                                    "id": "790700115",
                                    "speaker": "福罗贝尔",
                                    "text": "对啊，当时我们都在圣物旁边。公主殿下当然值得被认可，但是我、我…"
                                },
                                {
                                    "id": "790700116",
                                    "speaker": "Player",
                                    "text": "你可是被冠军认可的冠军。"
                                },
                                {
                                    "id": "790700117",
                                    "speaker": "派蒙",
                                    "text": "对呀。那个冠军可都是专门来拜托你了，这还有什么不值得认可的说法呀？"
                                },
                                {
                                    "id": "790700118",
                                    "speaker": "福罗贝尔",
                                    "text": "也许是因为公主殿下的光芒太耀眼，大家都搞错了啊！"
                                },
                                {
                                    "id": "790700119",
                                    "speaker": "西梅",
                                    "text": "噗…那么冠军先生，你愿意再接受一次试炼吗？"
                                },
                                {
                                    "id": "790700120",
                                    "speaker": "西梅",
                                    "text": "由我，铃风王国的西梅公主，亲自用圣物为你见证。"
                                },
                                {
                                    "id": "790700121",
                                    "speaker": "福罗贝尔",
                                    "text": "当然！我愿意！",
                                    "choices": [
                                        {
                                            "id": "790700122",
                                            "text": "你别激动。",
                                            "response": [
                                                {
                                                    "id": "790700124",
                                                    "speaker": "派蒙",
                                                    "text": "一说起公主殿下就这么激动。嘿嘿，福罗贝尔…"
                                                },
                                                {
                                                    "id": "790700125",
                                                    "speaker": "福罗贝尔",
                                                    "text": "你们别误会啊！我是、我是为了雨歌塘的使命！我经历了那么多训练，就是为了拯救…那个，保护公主殿下。"
                                                },
                                                {
                                                    "id": "790700126",
                                                    "speaker": "福罗贝尔",
                                                    "text": "这么重要的任务，我当然要确保万无一失了…"
                                                },
                                                {
                                                    "id": "790700127",
                                                    "speaker": "Player",
                                                    "text": "你愿意和公主殿下同行吗？"
                                                },
                                                {
                                                    "id": "790700128",
                                                    "speaker": "福罗贝尔",
                                                    "text": "愿、愿意…"
                                                },
                                                {
                                                    "id": "790700129",
                                                    "speaker": "西梅",
                                                    "text": "呵呵，那样最好。那么福罗贝尔，冠军先生，准备好接受我的试炼了吗？"
                                                },
                                                {
                                                    "id": "790700130",
                                                    "speaker": "福罗贝尔",
                                                    "text": "是的，公主殿下！随时都行！"
                                                },
                                                {
                                                    "id": "790700131",
                                                    "speaker": "派蒙",
                                                    "text": "呜哇！圣物又亮起来了！亮、亮过头了啦！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "790700123",
                                            "text": "耳朵，耳朵好痛。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "790700112",
                            "text": "你要去做什么？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7907002",
            "objective": "(test)日后谈2$HIDDEN",
            "dialogues": [
                {
                    "id": "790700201",
                    "speaker": "福罗贝尔",
                    "text": "埃斯唐普！你之前都去哪了！？"
                },
                {
                    "id": "790700202",
                    "speaker": "埃斯唐普",
                    "text": "呃，我去周围逛了逛，尝试了一下那个试炼，还挺有趣的，就是得用点别的方法通过。"
                },
                {
                    "id": "790700203",
                    "speaker": "埃斯唐普",
                    "text": "你们的事我都听奥雷卢先生说了，不错啊，「守护者先生」。你这不是挺有本事的吗？"
                },
                {
                    "id": "790700204",
                    "speaker": "福罗贝尔",
                    "text": "你、你、你…你要是在我旁边！我准把你推出去！有十次，我就推十次！"
                },
                {
                    "id": "790700205",
                    "speaker": "埃斯唐普",
                    "text": "所以我才去试炼了。福罗贝尔，好朋友，我相信你搞得定。瞧，你果然搞定了。"
                },
                {
                    "id": "790700206",
                    "speaker": "奥雷卢",
                    "text": "哈哈哈哈哈，你们这两位好先生啊，今天可是咱们雨歌塘的吉利日子。"
                },
                {
                    "id": "790700207",
                    "speaker": "奥雷卢",
                    "text": "咱们终于拥有了一位真正的冠军，虽然福罗贝尔先生还没有机会拯救公主，但我相信他会有显示身手的地方。"
                },
                {
                    "id": "790700208",
                    "speaker": "福罗贝尔",
                    "text": "唉！我什么也没做，奥雷卢先生，我光是待在旁边看着，全是公主殿下在忙前忙后。"
                },
                {
                    "id": "790700209",
                    "speaker": "奥雷卢",
                    "text": "那不更好？难不成您想公主殿下遇见危险？"
                },
                {
                    "id": "790700210",
                    "speaker": "福罗贝尔",
                    "text": "我…这…"
                },
                {
                    "id": "790700211",
                    "speaker": "奥雷卢",
                    "text": "哎哟，好了。福罗贝尔先生，您可是接过了那位西布雷吕的使命啊。"
                },
                {
                    "id": "790700212",
                    "speaker": "福罗贝尔",
                    "text": "胡说！我都不知道他究竟是不是西布雷吕！我只听说过他，没听过他说话！"
                },
                {
                    "id": "790700213",
                    "speaker": "埃斯唐普",
                    "text": "而且，你还接受了那位公主的试炼。真不愧是冠军啊。"
                },
                {
                    "id": "790700214",
                    "speaker": "福罗贝尔",
                    "text": "咱们能先别谈这件事吗？拜托…"
                },
                {
                    "id": "790700215",
                    "speaker": "奥雷卢",
                    "text": "总之，咱们雨歌塘的未来，可都交给你啦。"
                },
                {
                    "id": "790700216",
                    "speaker": "奥雷卢",
                    "text": "这下，我们总算可以没有任何压力的跳跃了，我回去就向组委会建议，在跳远比赛里加入更多趣味性的内容！"
                },
                {
                    "id": "790700217",
                    "speaker": "埃斯唐普",
                    "text": "这是个好主意，我愿意主持，咱们这就回去。"
                },
                {
                    "id": "790700218",
                    "speaker": "福罗贝尔",
                    "text": "你们别把我甩在这里啊！"
                }
            ]
        },
        {
            "id": "7907003",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "790700301",
                    "speaker": "萨博兰",
                    "text": "您和那位纸蛙，全都被认可为了守护者？！"
                },
                {
                    "id": "790700302",
                    "speaker": "苏法什",
                    "text": "不可思议，从未听说！这之前也没有过记录啊！"
                },
                {
                    "id": "790700303",
                    "speaker": "萨博兰",
                    "text": "而且您还要改造试炼…不行！不行啊！公主殿下！"
                },
                {
                    "id": "790700304",
                    "speaker": "苏法什",
                    "text": "您不能把这么古老的传承随便改造啊！公主殿下！"
                },
                {
                    "id": "790700305",
                    "speaker": "西梅",
                    "text": "好了好了，你们小点声，我的耳朵都被震痛了。"
                },
                {
                    "id": "790700306",
                    "speaker": "西梅",
                    "text": "事情已经这么定下来了。我现在可既是公主，又是被圣物认可的守护者，你们更拦不住我了。"
                },
                {
                    "id": "790700307",
                    "speaker": "萨博兰",
                    "text": "但是，公主殿下…"
                },
                {
                    "id": "790700308",
                    "speaker": "西梅",
                    "text": "你们就放心吧。我会主持锻炼仪式，训练出许多可靠的飞鼠来保护王国的。"
                },
                {
                    "id": "790700309",
                    "speaker": "西梅",
                    "text": "在那之后，我才会离开王国。"
                },
                {
                    "id": "790700310",
                    "speaker": "苏法什",
                    "text": "殿下，我们…唉，您…"
                },
                {
                    "id": "790700311",
                    "speaker": "西梅",
                    "text": "放心吧，两位叔叔。我会照顾好自己的。"
                },
                {
                    "id": "790700312",
                    "speaker": "西梅",
                    "text": "我这位公主，终究要自己迎接外面的狂风。"
                },
                {
                    "id": "790700313",
                    "speaker": "萨博兰",
                    "text": "…遵命，公主殿下。"
                }
            ]
        }
    ]
}