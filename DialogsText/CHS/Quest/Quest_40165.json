    "talks": [
        {
            "id": "4016501",
            "objective": "等待至两天后",
            "dialogues": [
                {
                    "id": "401650101",
                    "speaker": "柑橘",
                    "text": "二位的魔水来啦——！"
                },
                {
                    "id": "401650102",
                    "speaker": "凯亚",
                    "text": "感谢你，美丽的女士。琴，不坐下来喝一杯吗？我帮你也点了一份。"
                },
                {
                    "id": "401650103",
                    "speaker": "琴",
                    "text": "哎，是不是有些太松懈了呢。"
                },
                {
                    "id": "401650104",
                    "speaker": "凯亚",
                    "text": "在担心小可莉吗？没关系，不是还有阿贝多陪着吗？"
                },
                {
                    "id": "401650105",
                    "speaker": "派蒙",
                    "text": "琴团长和凯亚！你们怎么在这里？！"
                },
                {
                    "id": "401650106",
                    "speaker": "凯亚",
                    "text": "#瞧瞧谁来了？这不是{NICKNAME}和派蒙吗？原来艾莉丝女士说的「惊喜」就是这个！"
                },
                {
                    "id": "401650107",
                    "speaker": "琴",
                    "text": "二位好，没想到能在这里相遇。"
                },
                {
                    "id": "401650108",
                    "speaker": "凯亚",
                    "text": "难道这里的人们交口称赞，拯救了世界的勇者就是你们二位？"
                },
                {
                    "id": "401650109",
                    "speaker": "派蒙",
                    "text": "也不全是我们的功劳啦，要说的话，我们只是勇者小队的一员。"
                },
                {
                    "id": "401650110",
                    "speaker": "凯亚",
                    "text": "那也很了不起嘛！果然真正优秀的骑士到哪里都不失「荣誉」之名。"
                },
                {
                    "id": "401650111",
                    "speaker": "Player",
                    "text": "刚才说到艾莉丝女士和可莉…"
                },
                {
                    "id": "401650112",
                    "speaker": "琴",
                    "text": "嗯，我们收到一封艾莉丝女士寄来的邀请函，她建议我们在空闲的时候，带可莉来童话世界度个假。"
                },
                {
                    "id": "401650113",
                    "speaker": "凯亚",
                    "text": "原本还不知道她指的「童话世界」是什么意思呢，但现在看来，还真是个恰如其分的比喻。"
                },
                {
                    "id": "401650114",
                    "speaker": "琴",
                    "text": "可莉刚进来就激动得到处跑，我有些担心，但阿贝多说他会照顾好可莉，让我们自由活动。"
                },
                {
                    "id": "401650115",
                    "speaker": "凯亚",
                    "text": "此等美意，我们怎么好意思拒绝呢？于是我就拉上琴，到这个世界的酒馆来坐坐啦。"
                },
                {
                    "id": "401650116",
                    "speaker": "派蒙",
                    "text": "我看你就是想趁机喝酒而已吧。"
                },
                {
                    "id": "401650117",
                    "speaker": "凯亚",
                    "text": "哈哈，都出来休假了，就该好好享受一下嘛。"
                },
                {
                    "id": "401650118",
                    "speaker": "琴",
                    "text": "…你说得对，我也该松松自己的弦。不然就辜负了艾莉丝女士的一番美意。"
                },
                {
                    "id": "401650119",
                    "speaker": "派蒙",
                    "text": "哎！等等…你和酒保是怎么说的？"
                },
                {
                    "id": "401650120",
                    "speaker": "凯亚",
                    "text": "当然是来一杯这个酒馆最纯正的饮品喽，这才能感受到不同世界的风土人情嘛。"
                },
                {
                    "id": "401650121",
                    "speaker": "派蒙",
                    "text": "噗嗤…"
                },
                {
                    "id": "401650122",
                    "speaker": "凯亚",
                    "text": "欸？派蒙你这是什么表情？"
                },
                {
                    "id": "401650123",
                    "speaker": "派蒙",
                    "text": "没…没什么，我很欣赏你的生活方式，你喝，你快喝。"
                },
                {
                    "id": "401650124",
                    "speaker": "凯亚",
                    "text": "嗯？那我是不是应该小心一下呢？这酒看起来色泽倒挺不错，味道…噗咳…咳咳…"
                },
                {
                    "id": "401650125",
                    "speaker": "派蒙",
                    "text": "嘻嘻嘻嘻…"
                },
                {
                    "id": "401650126",
                    "speaker": "琴",
                    "text": "…我那杯就不喝了吧。但不喝会不会有些浪费…"
                },
                {
                    "id": "401650127",
                    "speaker": "凯亚",
                    "text": "好啊，派蒙，原来是这么回事。"
                },
                {
                    "id": "401650128",
                    "speaker": "派蒙",
                    "text": "我…我也是上过一次当的！不是在针对你！"
                },
                {
                    "id": "401650129",
                    "speaker": "凯亚",
                    "text": "对了，接到邀请的也不止我们，刚才我还见到了柯莱呢。她往那棵大树的方向去了，我没来得及叫她。"
                },
                {
                    "id": "401650130",
                    "speaker": "派蒙",
                    "text": "是铃风王国那边吧？嘿嘿，这么多老朋友都来了，感觉就像聚会一样呢。我们去和她打个招呼吧？"
                },
                {
                    "id": "401650131",
                    "speaker": "凯亚",
                    "text": "嗯，也代我向她问个好。",
                    "choices": [
                        {
                            "id": "401650132",
                            "text": "没问题。",
                            "response": [
                                {
                                    "id": "401650134",
                                    "speaker": "琴",
                                    "text": "也祝你旅途愉快。"
                                }
                            ]
                        },
                        {
                            "id": "401650133",
                            "text": "祝二位休假愉快。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "4016502",
            "objective": "返回赐福森林，寻找小杜林",
            "dialogues": []
        },
        {
            "id": "4016503",
            "objective": "前往铃风王国，寻找柯莱",
            "dialogues": [
                {
                    "id": "401650301",
                    "speaker": "柯莱",
                    "text": "这里的树屋构造…真奇妙。得赶紧记下来，回去告诉提纳里师父…"
                },
                {
                    "id": "401650302",
                    "speaker": "派蒙",
                    "text": "柯莱！你好呀！"
                },
                {
                    "id": "401650303",
                    "speaker": "柯莱",
                    "text": "#呃啊！吓我一跳…{NICKNAME}和派蒙？你们也是被邀请进来的吗？"
                },
                {
                    "id": "401650304",
                    "speaker": "派蒙",
                    "text": "…我们倒希望下次能有邀请这一步。柯莱你在看什么呀？"
                },
                {
                    "id": "401650305",
                    "speaker": "柯莱",
                    "text": "哦，我在观察总结这里的林木构造，还有居住在此的动物…或者说居民吧。他们竟然都是纸折出来的欸。"
                },
                {
                    "id": "401650306",
                    "speaker": "派蒙",
                    "text": "不愧是巡林员呢。不过这里是魔法的世界，也不知道有没有参考价值…"
                },
                {
                    "id": "401650307",
                    "speaker": "派蒙",
                    "text": "咦…？那个大脚印的旁边，原本有这些房屋吗？"
                },
                {
                    "id": "401650308",
                    "speaker": "柯莱",
                    "text": "哦，我听生活在这里的飞鼠们说，这是一只小龙和一位戴帽子的人建的。"
                },
                {
                    "id": "401650309",
                    "speaker": "派蒙",
                    "text": "是小杜林和阿帽！你知道他们去哪里了吗？"
                },
                {
                    "id": "401650310",
                    "speaker": "柯莱",
                    "text": "听人说，他们造完房子之后，就往…星轨王城那边去了，我应该没念错名字吧？"
                },
                {
                    "id": "401650311",
                    "speaker": "派蒙",
                    "text": "没念错，就是这个。还有，柯莱，从居民的语气中…呃，就是对那只小龙，他们是怎么评价的？"
                },
                {
                    "id": "401650312",
                    "speaker": "柯莱",
                    "text": "唔…你这么一说的话，氛围好像的确有点不一般…"
                },
                {
                    "id": "401650313",
                    "speaker": "派蒙",
                    "text": "啊…"
                },
                {
                    "id": "401650314",
                    "speaker": "柯莱",
                    "text": "他们说了些关于「曾经的误会」和「接纳新成员」之类的话…"
                },
                {
                    "id": "401650315",
                    "speaker": "柯莱",
                    "text": "我刚来没多久，还不知道这个世界发生过什么。但大家似乎挺感谢他们建的新房子，还说要办一场迎新会什么的。"
                },
                {
                    "id": "401650316",
                    "speaker": "派蒙",
                    "text": "吓死我了。那听起来也算是在慢慢融入森林了呢，至少是迈出了不错的一步。"
                },
                {
                    "id": "401650317",
                    "speaker": "柯莱",
                    "text": "你们有事要找那只小龙吗？"
                },
                {
                    "id": "401650318",
                    "speaker": "派蒙",
                    "text": "嗯，他是我们在这个世界新交的朋友。"
                },
                {
                    "id": "401650319",
                    "speaker": "柯莱",
                    "text": "欸？真的吗？越来越在意你们的故事了…"
                },
                {
                    "id": "401650320",
                    "speaker": "柯莱",
                    "text": "唔…不行不行，果然还是留到下次吧，我先抓紧时间在这个奇妙的世界多逛逛！"
                },
                {
                    "id": "401650321",
                    "speaker": "派蒙",
                    "text": "嘿嘿，不用着急啦，像凯亚那样慢慢享受也不错。哦对了，凯亚让我们代他向你问好。"
                },
                {
                    "id": "401650322",
                    "speaker": "柯莱",
                    "text": "凯亚先生也在？嗯…那我也得去和他打个招呼。"
                },
                {
                    "id": "401650323",
                    "speaker": "派蒙",
                    "text": "他恐怕在喝醉之前会一直待在酒馆的啦，而且他是那种怎么喝都喝不醉的人吧，所以什么时候去都行啦。"
                },
                {
                    "id": "401650324",
                    "speaker": "柯莱",
                    "text": "哈哈…你说得对。那就把见他的事往后放一放吧。"
                },
                {
                    "id": "401650325",
                    "speaker": "派蒙",
                    "text": "那我们差不多去王城一趟吧？希望小杜林他们还在。"
                },
                {
                    "id": "401650326",
                    "speaker": "柯莱",
                    "text": "哦对了，最近须弥好像发生了有趣的事。提纳里师父也在忙着些什么，你们有时间的话可以去看看。"
                },
                {
                    "id": "401650327",
                    "speaker": "派蒙",
                    "text": "好！那我们找机会回须弥一趟。",
                    "choices": [
                        {
                            "id": "401650328",
                            "text": "柯莱放轻松玩…",
                            "response": [
                                {
                                    "id": "401650330",
                                    "speaker": "柯莱",
                                    "text": "好，回头见！"
                                }
                            ]
                        },
                        {
                            "id": "401650329",
                            "text": "就当旅行考察…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "4016504",
            "objective": "前往星轨王城顶端的星间庭园",
            "dialogues": [
                {
                    "id": "401650501",
                    "speaker": "莫娜",
                    "text": "啊？我看错了吧？"
                },
                {
                    "id": "401650502",
                    "speaker": "莫娜",
                    "text": "怎么可能…真是难以置信…"
                },
                {
                    "id": "401650503",
                    "speaker": "派蒙",
                    "text": "莫娜，你好呀！好远就听到你一个人嘀嘀咕咕的声音。"
                },
                {
                    "id": "401650504",
                    "speaker": "派蒙",
                    "text": "你的水占盘又出问题了吗？"
                },
                {
                    "id": "401650505",
                    "speaker": "莫娜",
                    "text": "是你们啊，拯救了世界的英雄。我的水占盘好得很，出问题的可能是我的眼睛。"
                },
                {
                    "id": "401650506",
                    "speaker": "莫娜",
                    "text": "你们看，看这个女神像。"
                },
                {
                    "id": "401650507",
                    "speaker": "派蒙",
                    "text": "怎么了吗？没见到哪里缺了个角呀？不就是「预言女神」，你的师父嘛。"
                },
                {
                    "id": "401650508",
                    "speaker": "莫娜",
                    "text": "我才不信呢！那个老太婆哪长这个样子。"
                },
                {
                    "id": "401650509",
                    "speaker": "Player",
                    "text": "说不定是年轻的时候？"
                },
                {
                    "id": "401650510",
                    "speaker": "莫娜",
                    "text": "年轻的时候…呃…这么说来，倒的确挺像她那本少女日记里写的爱赶时髦的样子…"
                },
                {
                    "id": "401650511",
                    "speaker": "莫娜",
                    "text": "这话不会被老太婆听见吧？总觉得背后阴嗖嗖的。"
                },
                {
                    "id": "401650512",
                    "speaker": "派蒙",
                    "text": "这么在人家雕像底下议论好像是不太好。"
                },
                {
                    "id": "401650513",
                    "speaker": "派蒙",
                    "text": "不过，既然莫娜都没见过你师父年轻时的样子，你先前是怎么知道这雕像是她的？"
                },
                {
                    "id": "401650514",
                    "speaker": "莫娜",
                    "text": "我进来时用水占盘算了算，结果星空的「倒影」却令我大为惊讶，像是将提瓦特作为了这个「希穆兰卡」世界命运的基底。"
                },
                {
                    "id": "401650515",
                    "speaker": "莫娜",
                    "text": "现实命运的「映射」，真实世界的「虚像」…"
                },
                {
                    "id": "401650516",
                    "speaker": "莫娜",
                    "text": "嗯…通俗点说，你就理解成「创造者」是在一面镜子，或者一汪湖水的倒影中创造了这个世界。"
                },
                {
                    "id": "401650517",
                    "speaker": "派蒙",
                    "text": "听着还是很了不起的嘛。"
                },
                {
                    "id": "401650518",
                    "speaker": "莫娜",
                    "text": "继续观测下去，那些占式就越来越熟悉，一看就是老太婆的手笔…但它们远比想象的复杂，现在的我光是解读就已经很费力了。"
                },
                {
                    "id": "401650519",
                    "speaker": "莫娜",
                    "text": "后来我就去找人打听了一下。「司掌星辰与轨迹」，她还真是演都不演，彻底陶醉在她的创作里了…"
                },
                {
                    "id": "401650520",
                    "speaker": "莫娜",
                    "text": "跟那本日记的风格倒也对得上…咳咳，不对！我们还是换个话题吧。"
                },
                {
                    "id": "401650521",
                    "speaker": "派蒙",
                    "text": "啊，莫娜！你见到过一只小龙吗？差不多和我一样大，扇着小小的翅膀。"
                },
                {
                    "id": "401650522",
                    "speaker": "莫娜",
                    "text": "曾经闯祸的那位是吧？我没亲眼见到，但听说他不久前来王城向人们道歉，还带了很多积木矿和植物油作为赔礼。"
                },
                {
                    "id": "401650523",
                    "speaker": "莫娜",
                    "text": "大多数人接受了他的赔罪，但也有些人说，要看他未来的行为再做判断。"
                },
                {
                    "id": "401650524",
                    "speaker": "派蒙",
                    "text": "这样啊。那你知道要去哪儿找他吗？"
                },
                {
                    "id": "401650525",
                    "speaker": "莫娜",
                    "text": "稍等…"
                },
                {
                    "id": "401650526",
                    "speaker": "莫娜",
                    "text": "哦，他现在在破碎之海那边，身边还有不少人在呢。"
                },
                {
                    "id": "401650527",
                    "speaker": "派蒙",
                    "text": "那莫娜要一起来吗？"
                },
                {
                    "id": "401650528",
                    "speaker": "莫娜",
                    "text": "我就不凑热闹了吧，难得可以跟年轻的老太婆待一会儿，琢磨琢磨她布下的星轨。你们好好玩。",
                    "choices": [
                        {
                            "id": "401650529",
                            "text": "那莫娜多加小心…",
                            "response": [
                                {
                                    "id": "401650530",
                                    "speaker": "莫娜",
                                    "text": "为什么是小心啦？这么说才会让人紧张吧！"
                                },
                                {
                                    "id": "401650533",
                                    "speaker": "派蒙",
                                    "text": "我们走啦！拜拜哦莫娜！"
                                }
                            ]
                        },
                        {
                            "id": "401650531",
                            "text": "谢谢莫娜的占星术…",
                            "response": [
                                {
                                    "id": "401650532",
                                    "speaker": "莫娜",
                                    "text": "哪里的话。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "4016505",
            "objective": "前往破碎之海，寻找小杜林",
            "dialogues": [
                {
                    "id": "401650701",
                    "speaker": "菲谢尔",
                    "text": "奥兹华尔多·赫芙那梵茵斯…告诉我，此刻映照于我览遍三千世界断罪之眼中的景象绝非虚妄！"
                },
                {
                    "id": "401650702",
                    "speaker": "奥兹",
                    "text": "小姐，你没看错。"
                },
                {
                    "id": "401650703",
                    "speaker": "菲谢尔",
                    "text": "那我将以幽夜净土的王室之礼向二位行以问候。千星之国的至高夜龙，以及他身侧冠帽的扈从。"
                },
                {
                    "id": "401650704",
                    "speaker": "Wanderer",
                    "text": "你说谁是扈从？"
                },
                {
                    "id": "401650705",
                    "speaker": "奥兹",
                    "text": "小姐的意思是，二位好，很高兴认识你们。"
                },
                {
                    "id": "401650706",
                    "speaker": "小杜林",
                    "text": "你们好！我也很高兴认识你们，但阿帽是我的朋友，不是扈从。"
                },
                {
                    "id": "401650707",
                    "speaker": "Wanderer",
                    "text": "…啧，没必要解释。"
                },
                {
                    "id": "401650708",
                    "speaker": "派蒙",
                    "text": "阿帽！小杜林！终于找到你们了！哇，还有菲谢尔你们也在？"
                },
                {
                    "id": "401650709",
                    "speaker": "菲谢尔",
                    "text": "哦呵呵！受幽夜净土祝圣的异世旅人！汝于此星空下与本皇女相遇一定也是命运的选择！",
                    "choices": [
                        {
                            "id": "401650710",
                            "text": "诚如皇女所言。",
                            "response": [
                                {
                                    "id": "401650712",
                                    "speaker": "可莉",
                                    "text": "#荣誉骑士{M#哥哥}{F#姐姐}和小派蒙！"
                                },
                                {
                                    "id": "401650713",
                                    "speaker": "阿贝多",
                                    "text": "二位别来无恙。"
                                },
                                {
                                    "id": "401650714",
                                    "speaker": "派蒙",
                                    "text": "嘿嘿，小可莉在这里玩得还开心吗？"
                                },
                                {
                                    "id": "401650715",
                                    "speaker": "可莉",
                                    "text": "开心！有好多好多可爱的小动物！好长好长的魔法小火车！还有好高好高的国王大城堡！"
                                },
                                {
                                    "id": "401650716",
                                    "speaker": "阿贝多",
                                    "text": "我带可莉走过一圈，沿路收获不少，不愧是艾莉丝女士的魔法。"
                                },
                                {
                                    "id": "401650717",
                                    "speaker": "可莉",
                                    "text": "妈妈好厉害！可莉也想造大大的房子！"
                                },
                                {
                                    "id": "401650718",
                                    "speaker": "小杜林",
                                    "text": "可莉的妈妈，是我妈妈的朋友？"
                                },
                                {
                                    "id": "401650719",
                                    "speaker": "可莉",
                                    "text": "嗯！妈妈以前经常念故事给我听，小杜林哥哥的妈妈写故事真好看！"
                                },
                                {
                                    "id": "401650720",
                                    "speaker": "小杜林",
                                    "text": "小杜林…哥哥？"
                                },
                                {
                                    "id": "401650721",
                                    "speaker": "Player",
                                    "text": "当哥哥了呢。"
                                },
                                {
                                    "id": "401650722",
                                    "speaker": "小杜林",
                                    "text": "哇…谢谢可莉！阿帽，我能和可莉一起去玩吗？"
                                },
                                {
                                    "id": "401650723",
                                    "speaker": "Wanderer",
                                    "text": "随你便。"
                                },
                                {
                                    "id": "401650724",
                                    "speaker": "可莉",
                                    "text": "阿贝多哥哥，阿贝多哥哥…"
                                },
                                {
                                    "id": "401650725",
                                    "speaker": "阿贝多",
                                    "text": "去吧，别跑太远，我会来接你的。"
                                },
                                {
                                    "id": "401650726",
                                    "speaker": "可莉",
                                    "text": "嗯！我们走吧，小杜林！菲谢尔姐姐也来吗？"
                                },
                                {
                                    "id": "401650727",
                                    "speaker": "菲谢尔",
                                    "text": "哼哼！本皇女接受你们的邀请。庆贺吧！即使你们藏身于迷雾之中，也将有幸一睹此断罪之眼的威姿！"
                                },
                                {
                                    "id": "401650728",
                                    "speaker": "奥兹",
                                    "text": "小姐说，大家可以一起玩捉迷藏，她来当鬼。"
                                },
                                {
                                    "id": "401650729",
                                    "speaker": "可莉",
                                    "text": "好耶！捉迷藏！"
                                },
                                {
                                    "id": "401650730",
                                    "speaker": "小杜林",
                                    "text": "捉迷藏！"
                                },
                                {
                                    "id": "401650731",
                                    "speaker": "阿贝多",
                                    "text": "说回刚才的话题，阿帽先生，你所说的预言一事…"
                                },
                                {
                                    "id": "401650732",
                                    "speaker": "Wanderer",
                                    "text": "我当时听到「B」对「M」这么说——"
                                },
                                {
                                    "id": "401650733",
                                    "speaker": "「B」",
                                    "text": "看在你这么执着的份上，我就告诉你一个秘密吧…"
                                },
                                {
                                    "id": "401650734",
                                    "speaker": "「B」",
                                    "text": "「R」的孩子，有朝一日会复活哟。"
                                },
                                {
                                    "id": "401650735",
                                    "speaker": "派蒙",
                                    "text": "欸？那位观星的魔女说…龙脊雪山的杜林…会复活？"
                                },
                                {
                                    "id": "401650736",
                                    "speaker": "Player",
                                    "text": "我也很惊讶…"
                                },
                                {
                                    "id": "401650737",
                                    "speaker": "Wanderer",
                                    "text": "都是记忆中的景象，错了也别赖到我头上。"
                                },
                                {
                                    "id": "401650738",
                                    "speaker": "阿贝多",
                                    "text": "我明白了。我最近在龙脊雪山的观察结果也佐证了这个预言。"
                                },
                                {
                                    "id": "401650739",
                                    "speaker": "阿贝多",
                                    "text": "相较以往，杜林的心脏正在慢慢活跃起来。虽然过程十分缓慢，但已显出趋势…"
                                },
                                {
                                    "id": "401650740",
                                    "speaker": "派蒙",
                                    "text": "唔…那我们该怎么做？"
                                },
                                {
                                    "id": "401650741",
                                    "speaker": "阿贝多",
                                    "text": "先制定应对各种情况的策略，当然也包括最坏的情况…"
                                },
                                {
                                    "id": "401650742",
                                    "speaker": "Wanderer",
                                    "text": "……"
                                },
                                {
                                    "id": "401650743",
                                    "speaker": "阿贝多",
                                    "text": "我了解杜林的过去，并不希望事态发展到那一步。但凡事都需做好充足的准备。"
                                },
                                {
                                    "id": "401650744",
                                    "speaker": "阿贝多",
                                    "text": "如果正如预言所说，杜林的心脏终将跳动如常，我会希望复活的并非「邪龙」…"
                                },
                                {
                                    "id": "401650745",
                                    "speaker": "阿贝多",
                                    "text": "你们能明白我的意思吗？"
                                },
                                {
                                    "id": "401650746",
                                    "speaker": "派蒙",
                                    "text": "隐隐约约…马马虎虎？"
                                },
                                {
                                    "id": "401650747",
                                    "speaker": "阿贝多",
                                    "text": "为此…阿帽先生，届时能请你和希穆兰卡的杜林也助我们一臂之力吗？"
                                },
                                {
                                    "id": "401650748",
                                    "speaker": "Wanderer",
                                    "text": "啊？还有我的事？"
                                },
                                {
                                    "id": "401650749",
                                    "speaker": "阿贝多",
                                    "text": "你在希穆兰卡的世界拯救了杜林，我认为这不是偶然。"
                                },
                                {
                                    "id": "401650750",
                                    "speaker": "阿贝多",
                                    "text": "如果三位女神的此中作为存在意义，除去浪漫的解读之外，我可以做出大胆猜测…"
                                },
                                {
                                    "id": "401650751",
                                    "speaker": "阿贝多",
                                    "text": "此片映射之天的命运，或许也能对彼处产生影响。"
                                },
                                {
                                    "id": "401650752",
                                    "speaker": "阿贝多",
                                    "text": "如果龙脊雪山的杜林将要复活，我们会需要小杜林…以及与其命运交错的你的帮助。"
                                },
                                {
                                    "id": "401650753",
                                    "speaker": "Wanderer",
                                    "text": "啧…麻烦。"
                                },
                                {
                                    "id": "401650754",
                                    "speaker": "阿贝多",
                                    "text": "的确不会容易。"
                                },
                                {
                                    "id": "401650755",
                                    "speaker": "可莉",
                                    "text": "阿贝多哥哥！那边有一个小纸船欸！能飘在空中的那种！要和可莉一起去看吗！"
                                },
                                {
                                    "id": "401650756",
                                    "speaker": "阿贝多",
                                    "text": "好，我这就来。"
                                },
                                {
                                    "id": "401650757",
                                    "speaker": "阿贝多",
                                    "text": "请再考虑一下我的建议，阿帽先生。"
                                },
                                {
                                    "id": "401650758",
                                    "speaker": "Wanderer",
                                    "text": "……"
                                },
                                {
                                    "id": "401650759",
                                    "speaker": "小杜林",
                                    "text": "阿帽，我回来了。嗯？你们刚才聊什么了吗？"
                                },
                                {
                                    "id": "401650760",
                                    "speaker": "Wanderer",
                                    "text": "没什么。"
                                },
                                {
                                    "id": "401650761",
                                    "speaker": "派蒙",
                                    "text": "……"
                                },
                                {
                                    "id": "401650762",
                                    "speaker": "小杜林",
                                    "text": "嗯？那我们也一起过去吧，大家都在我们新做的小船那里呢！"
                                },
                                {
                                    "id": "401650763",
                                    "speaker": "Wanderer",
                                    "text": "…好，我这就来。",
                                    "choices": [
                                        {
                                            "id": "401650764",
                                            "text": "#{REALNAME[ID(1)]}…",
                                            "response": [
                                                {
                                                    "id": "401650766",
                                                    "speaker": "Wanderer",
                                                    "text": "干嘛？我像是那种会在乎别人破事的人吗？"
                                                },
                                                {
                                                    "id": "401650767",
                                                    "speaker": "Player",
                                                    "text": "（拯救了希穆兰卡的杜林之后，他会不会同情起现实中的杜林呢…）"
                                                },
                                                {
                                                    "id": "401650768",
                                                    "speaker": "Wanderer",
                                                    "text": "别在这乱猜我的想法，走了。"
                                                },
                                                {
                                                    "id": "401650769",
                                                    "speaker": "Player",
                                                    "text": "（就像阿贝多说的，留给以后再考虑吧…）"
                                                },
                                                {
                                                    "id": "401650770",
                                                    "speaker": "可莉",
                                                    "text": "哇！好可爱的小船！"
                                                },
                                                {
                                                    "id": "401650771",
                                                    "speaker": "小杜林",
                                                    "text": "是我们和森林仙子一起做的哟。"
                                                },
                                                {
                                                    "id": "401650772",
                                                    "speaker": "派蒙",
                                                    "text": "说起来，破碎之海的人似乎少了很多，看来大家都顺利回到王城了呢。"
                                                },
                                                {
                                                    "id": "401650773",
                                                    "speaker": "可莉",
                                                    "text": "这艘船有名字吗？可莉在哪里都没有找到！"
                                                },
                                                {
                                                    "id": "401650774",
                                                    "speaker": "小杜林",
                                                    "text": "欸？名字…？"
                                                },
                                                {
                                                    "id": "401650775",
                                                    "speaker": "可莉",
                                                    "text": "嗯！可莉见到过的船都有自己的名字。"
                                                },
                                                {
                                                    "id": "401650776",
                                                    "speaker": "阿贝多",
                                                    "text": "为了寄托美好的寓意。"
                                                },
                                                {
                                                    "id": "401650777",
                                                    "speaker": "小杜林",
                                                    "text": "……"
                                                },
                                                {
                                                    "id": "401650778",
                                                    "speaker": "Wanderer",
                                                    "text": "……"
                                                },
                                                {
                                                    "id": "401650779",
                                                    "speaker": "Wanderer",
                                                    "text": "就叫「杜林号」吧。"
                                                },
                                                {
                                                    "id": "401650780",
                                                    "speaker": "小杜林",
                                                    "text": "欸？我的名字？"
                                                },
                                                {
                                                    "id": "401650781",
                                                    "speaker": "派蒙",
                                                    "text": "哦！是寓意小杜林的故事，能够驶向这个世界之外的新篇章吗？"
                                                },
                                                {
                                                    "id": "401650782",
                                                    "speaker": "菲谢尔",
                                                    "text": "嗯，以无上之夜龙尊贵的名字来命名，本皇女欣赏你的品味。"
                                                },
                                                {
                                                    "id": "401650783",
                                                    "speaker": "小杜林",
                                                    "text": "「杜林号」…嘿嘿，那就叫这个吧！谢谢你，阿帽！"
                                                },
                                                {
                                                    "id": "401650784",
                                                    "speaker": "小杜林",
                                                    "text": "那个…阿帽，能求你一件事吗？"
                                                },
                                                {
                                                    "id": "401650785",
                                                    "speaker": "Wanderer",
                                                    "text": "…说。"
                                                },
                                                {
                                                    "id": "401650786",
                                                    "speaker": "小杜林",
                                                    "text": "之前妈妈的朋友不是说我能出去吗？我…我想去阿帽你生活的世界看看，看一下就回来！"
                                                },
                                                {
                                                    "id": "401650787",
                                                    "speaker": "Wanderer",
                                                    "text": "…哈？"
                                                },
                                                {
                                                    "id": "401650788",
                                                    "speaker": "小杜林",
                                                    "text": "不…不行吗？"
                                                },
                                                {
                                                    "id": "401650789",
                                                    "speaker": "派蒙",
                                                    "text": "这不是挺好吗？希穆兰卡的人本来就可以出去，带小杜林出去转转也没什么吧？"
                                                },
                                                {
                                                    "id": "401650790",
                                                    "speaker": "Wanderer",
                                                    "text": "…我还得在外面保护你的安全？"
                                                },
                                                {
                                                    "id": "401650791",
                                                    "speaker": "小杜林",
                                                    "text": "我…我会保护好自己的，也会听你话，绝不乱飞！可以吗…？"
                                                },
                                                {
                                                    "id": "401650792",
                                                    "speaker": "Wanderer",
                                                    "text": "……"
                                                },
                                                {
                                                    "id": "401650793",
                                                    "speaker": "Wanderer",
                                                    "text": "…在外面我可不管你，自己跟紧了。"
                                                },
                                                {
                                                    "id": "401650794",
                                                    "speaker": "小杜林",
                                                    "text": "好！我知道了！"
                                                },
                                                {
                                                    "id": "401650795",
                                                    "speaker": "阿贝多",
                                                    "text": "不如就乘「杜林号」出去吧，以命名后的初次航行开启新的旅程。"
                                                },
                                                {
                                                    "id": "401650796",
                                                    "speaker": "可莉",
                                                    "text": "小杜林哥哥现在就要走了吗？那…记得要来蒙德找可莉玩！可莉把来家里的路画给你。"
                                                },
                                                {
                                                    "id": "401650797",
                                                    "speaker": "菲谢尔",
                                                    "text": "相处之刻虽如长夜虹光一般短暂，但幽夜净土将为重逢之刻高奏乐歌，我等定将于星辰的注视之下再会。"
                                                },
                                                {
                                                    "id": "401650798",
                                                    "speaker": "奥兹",
                                                    "text": "小姐说，她也随时欢迎你们到家里坐坐。"
                                                },
                                                {
                                                    "id": "401650799",
                                                    "speaker": "小杜林",
                                                    "text": "嗯！认识了这么多新朋友，我很开心！"
                                                },
                                                {
                                                    "id": "401650800",
                                                    "speaker": "Wanderer",
                                                    "text": "啧…还有完没完？要走的话就赶紧上来。"
                                                },
                                                {
                                                    "id": "401650801",
                                                    "speaker": "Player",
                                                    "text": "一路顺风。"
                                                },
                                                {
                                                    "id": "401650802",
                                                    "speaker": "小杜林",
                                                    "text": "谢谢大家，谢谢你们所有人！你们给予我的祝福，比任何东西都要宝贵，比任何童话都要美丽！"
                                                },
                                                {
                                                    "id": "401650803",
                                                    "speaker": "小杜林",
                                                    "text": "下次，就换我来实现你们的愿望吧！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "401650765",
                                            "text": "你在担心杜林吗？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "401650711",
                            "text": "我也很高兴见到你们。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "4016502",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "401650201",
                    "speaker": "凯亚",
                    "text": "原来魔水就是墨水…真是神奇。"
                },
                {
                    "id": "401650202",
                    "speaker": "凯亚",
                    "text": "柑橘女士，请问有没有不加魔水的饮品？"
                },
                {
                    "id": "401650203",
                    "speaker": "柑橘",
                    "text": "当然有，要什么口味？"
                },
                {
                    "id": "401650204",
                    "speaker": "凯亚",
                    "text": "日落果？琴，你感兴趣吗？"
                },
                {
                    "id": "401650205",
                    "speaker": "琴",
                    "text": "…好，那我也要一杯。"
                },
                {
                    "id": "401650206",
                    "speaker": "柑橘",
                    "text": "好嘞，两杯日落果口味！马上就来！"
                }
            ]
        },
        {
            "id": "4016504",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "401650401",
                    "speaker": "柯莱",
                    "text": "折纸飞鼠们凭借轻盈的身体，能够利用风场在树木间移动…由此形成了独特的生态…"
                },
                {
                    "id": "401650402",
                    "speaker": "柯莱",
                    "text": "啊，糟糕…笔记本要用完了…"
                }
            ]
        },
        {
            "id": "4016506",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "401650601",
                    "speaker": "莫娜",
                    "text": "（构筑一个世界的星空绝不是件容易的工作…）"
                },
                {
                    "id": "401650602",
                    "speaker": "莫娜",
                    "text": "（老太婆…你还真是个「三倍伟大的星学者」啊。）"
                }
            ]
        },
        {
            "id": "4016599",
            "objective": "Additional",
            "dialogues": [
                {
