    "talks": [
        {
            "id": "7221201",
            "objective": "test 与寝子对话 隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "722120101",
                    "speaker": "「寝子」",
                    "text": "汝等来得正好，来帮奴家做件事吧。"
                },
                {
                    "id": "722120102",
                    "speaker": "Player",
                    "text": "什么事？"
                },
                {
                    "id": "722120103",
                    "speaker": "「寝子」",
                    "text": "奴家想要…"
                },
                {
                    "id": "722120104",
                    "speaker": "「寝子」",
                    "text": "在神社旁边，放一块很高很高，很大很大，和奴家一个样子的石头。"
                },
                {
                    "id": "722120105",
                    "speaker": "派蒙",
                    "text": "上、上哪找这样的石头…"
                },
                {
                    "id": "722120106",
                    "speaker": "Player",
                    "text": "是说雕像对吧。"
                },
                {
                    "id": "722120107",
                    "speaker": "「寝子」",
                    "text": "总之，奴家要的东西，和好远好远的那个岛上的狐狸石头一样。"
                },
                {
                    "id": "722120108",
                    "speaker": "「寝子」",
                    "text": "阿响说过，在那个岛上，有好多狐狸石头，还说，要不要给奴家也弄一个。"
                },
                {
                    "id": "722120109",
                    "speaker": "「寝子」",
                    "text": "奴家觉得，阿响想要的，一定是好的。所以，汝等帮忙弄个石头吧。",
                    "choices": [
                        {
                            "id": "722120110",
                            "text": "我没有雕刻的手艺…",
                            "response": [
                                {
                                    "id": "722120111",
                                    "speaker": "派蒙",
                                    "text": "唔，要怎么办呢…"
                                },
                                {
                                    "id": "722120112",
                                    "speaker": "派蒙",
                                    "text": "对了，去找大祐吧！他这么喜欢猫，说不定能为了寝子学会雕刻。"
                                }
                            ]
                        },
                        {
                            "id": "722120113",
                            "text": "去找大祐帮忙好了…",
                            "response": [
                                {
                                    "id": "722120114",
                                    "speaker": "派蒙",
                                    "text": "有道理！他这么喜欢猫，说不定能帮得上忙。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7221202",
            "objective": "询问大祐和悦子",
            "dialogues": [
                {
                    "id": "722120201",
                    "speaker": "大祐",
                    "text": "喔！你好，今天又在忙什么呢？"
                },
                {
                    "id": "722120202",
                    "speaker": "Player",
                    "text": "帮寝子做雕像。"
                },
                {
                    "id": "722120203",
                    "speaker": "大祐",
                    "text": "哈…哈？做雕像，在这里？真的吗？"
                },
                {
                    "id": "722120204",
                    "speaker": "大祐",
                    "text": "我、我这就去学雕刻技术！"
                },
                {
                    "id": "722120205",
                    "speaker": "Player",
                    "text": "来、来不及吧…"
                },
                {
                    "id": "722120206",
                    "speaker": "悦子",
                    "text": "又是那位寝子拜托你的吗？"
                },
                {
                    "id": "722120207",
                    "speaker": "悦子",
                    "text": "说起来，因为踏鞴砂那边的问题，很多工匠都在找工作。"
                },
                {
                    "id": "722120208",
                    "speaker": "悦子",
                    "text": "协会之前接到过不少相关的委托，据我所知，有人似乎还留在踏鞴砂附近，一直在找工作。"
                },
                {
                    "id": "722120209",
                    "speaker": "悦子",
                    "text": "我之前去执行协会委托的时候，也见到了一个类似的营地。"
                },
                {
                    "id": "722120210",
                    "speaker": "悦子",
                    "text": "如果你们愿意的话，倒是可以去那边碰碰运气。",
                    "choices": [
                        {
                            "id": "722120211",
                            "text": "谢谢你。",
                            "response": [
                                {
                                    "id": "722120214",
                                    "speaker": "悦子",
                                    "text": "呵呵…不用在意，只不过是举手之劳而已。"
                                },
                                {
                                    "id": "722120215",
                                    "speaker": "悦子",
                                    "text": "我也很想看看，这座神社如果真能热闹起来的话…会发生什么。"
                                },
                                {
                                    "id": "722120216",
                                    "speaker": "悦子",
                                    "text": "特别是那位「阿响」…到底是一位怎么样的人，能让那位寝子这么在意呢？"
                                },
                                {
                                    "id": "722120217",
                                    "speaker": "悦子",
                                    "text": "好了，你也别在这听我自言自语了，快去找工匠吧。"
                                },
                                {
                                    "id": "722120218",
                                    "speaker": "悦子",
                                    "text": "至于你们找到的工匠会不会雕石雕…呵呵，那就全凭你们的运气了。"
                                },
                                {
                                    "id": "722120219",
                                    "speaker": "大祐",
                                    "text": "悦子小姐，其实你也是想帮帮寝子大人对吧？哈哈哈，你可真是…"
                                },
                                {
                                    "id": "722120220",
                                    "speaker": "悦子",
                                    "text": "大祐，调查计划写好了没有？"
                                },
                                {
                                    "id": "722120221",
                                    "speaker": "大祐",
                                    "text": "呃！马、马上就好，实在对不起…"
                                }
                            ]
                        },
                        {
                            "id": "722120212",
                            "text": "悦子小姐感觉和平时不太一样…",
                            "response": [
                                {
                                    "id": "722120213",
                                    "speaker": "悦子",
                                    "text": "怎么？我这么主动地给你们信息，你有些不习惯吗？"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7221203",
            "objective": "前往踏鞴砂，寻找工匠",
            "dialogues": [
                {
                    "id": "722120301",
                    "speaker": "？？？",
                    "text": "唉，到底什么时候才能找到工作…"
                },
                {
                    "id": "722120302",
                    "speaker": "？？？",
                    "text": "你们…是来找我的吗？有什么事？",
                    "choices": [
                        {
                            "id": "722120303",
                            "text": "你会做石雕吗？",
                            "response": [
                                {
                                    "id": "722120305",
                                    "speaker": "？？？",
                                    "text": "咦？那…那太好了！"
                                },
                                {
                                    "id": "722120306",
                                    "speaker": "？？？",
                                    "text": "我都忘了自我介绍了…我叫大岛纯平，之前是在踏鞴砂干活的。"
                                },
                                {
                                    "id": "722120307",
                                    "speaker": "大岛纯平",
                                    "text": "出了意外之后，我和其他人也都被疏散了出去。"
                                },
                                {
                                    "id": "722120308",
                                    "speaker": "大岛纯平",
                                    "text": "但是…到现在我也没有接到复工的消息，就这么一直闲在这里。"
                                },
                                {
                                    "id": "722120309",
                                    "speaker": "大岛纯平",
                                    "text": "你们是在找做石雕的人对吧？我会一点石雕的手艺，虽然不是特别专业…"
                                },
                                {
                                    "id": "722120310",
                                    "speaker": "大岛纯平",
                                    "text": "你们要做怎么样的石雕？能告诉我吗？"
                                },
                                {
                                    "id": "722120311",
                                    "speaker": "Player",
                                    "text": "是这样的…"
                                },
                                {
                                    "id": "722120312",
                                    "speaker": "大岛纯平",
                                    "text": "呃，会说话的猫，要你们找一个工匠，帮它雕一座石雕？"
                                },
                                {
                                    "id": "722120313",
                                    "speaker": "大岛纯平",
                                    "text": "不、不是我不相信，是这件事实在有点…有点离谱…"
                                },
                                {
                                    "id": "722120314",
                                    "speaker": "大岛纯平",
                                    "text": "其他的不论，就算我答应了你们，那…那位「代宫司」大人，怎么支付报酬呢？我可不能做白工啊。"
                                },
                                {
                                    "id": "722120315",
                                    "speaker": "Player",
                                    "text": "放心吧。"
                                },
                                {
                                    "id": "722120316",
                                    "speaker": "派蒙",
                                    "text": "（真、真的可以放心吗…）"
                                },
                                {
                                    "id": "722120317",
                                    "speaker": "大岛纯平",
                                    "text": "这样啊，这…我总觉得你们在骗我…"
                                },
                                {
                                    "id": "722120318",
                                    "speaker": "大岛纯平",
                                    "text": "但是…算了，闲着也是闲着，我就和你们走一趟吧。"
                                },
                                {
                                    "id": "722120319",
                                    "speaker": "大岛纯平",
                                    "text": "希望对方真的能支付报酬…"
                                }
                            ]
                        },
                        {
                            "id": "722120304",
                            "text": "我们正在找会做石雕的工匠。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7221204",
            "objective": "与工匠对话",
            "dialogues": []
        },
        {
            "id": "7221205",
            "objective": "和大岛纯平一起向寝子回报",
            "dialogues": [
                {
                    "id": "722120601",
                    "speaker": "「寝子」",
                    "text": "不过，奴家还是很好奇。石头那么硬的东西，怎么会变成奴家的样子呢？"
                },
                {
                    "id": "722120602",
                    "speaker": "「寝子」",
                    "text": "那个石头人类，是不是很厉害？是不是会什么妖术？",
                    "choices": [
                        {
                            "id": "722120603",
                            "text": "很厉害的。",
                            "response": [
                                {
                                    "id": "722120604",
                                    "speaker": "「寝子」",
                                    "text": "原来如此，奴家很是期待哪。"
                                }
                            ]
                        },
                        {
                            "id": "722120605",
                            "text": "和做饭一样…",
                            "response": [
                                {
                                    "id": "722120606",
                                    "speaker": "「寝子」",
                                    "text": "原来如此，奴家明白了。汝做的饭和阿响做的饭，都是好东西。所以，石头人类做的石头，也是好东西。"
                                },
                                {
                                    "id": "722120607",
                                    "speaker": "「寝子」",
                                    "text": "人类有时候真厉害哪。这次，也谢谢汝了。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7221204",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "722120401",
                    "speaker": "「寝子」",
                    "text": "汝等回来了。这个人类想必便是石头人类，对吧。",
                    "choices": [
                        {
                            "id": "722120402",
                            "text": "是我们请来的工匠。",
                            "response": [
                                {
                                    "id": "722120404",
                                    "speaker": "大岛纯平",
                                    "text": "欸？欸！猫…猫说话了！"
                                },
                                {
                                    "id": "722120405",
                                    "speaker": "「寝子」",
                                    "text": "喵喵喵，汝可真是大惊小怪啊…奴家会说话很奇怪吗？",
                                    "choices": [
                                        {
                                            "id": "722120406",
                                            "text": "不要大惊小怪。",
                                            "response": [
                                                {
                                                    "id": "722120408",
                                                    "speaker": "大岛纯平",
                                                    "text": "喂！难道对你来说，这事情是一件很平常的事吗？！"
                                                },
                                                {
                                                    "id": "722120409",
                                                    "speaker": "Player",
                                                    "text": "确实很平常啦。"
                                                },
                                                {
                                                    "id": "722120410",
                                                    "speaker": "大岛纯平",
                                                    "text": "你到底都经历了什么啊…"
                                                },
                                                {
                                                    "id": "722120411",
                                                    "speaker": "「寝子」",
                                                    "text": "好啦，好啦，你们不要光顾着说话了。"
                                                },
                                                {
                                                    "id": "722120412",
                                                    "speaker": "「寝子」",
                                                    "text": "总之，石头人类，你能把石头，弄得和奴家一模一样吗？"
                                                },
                                                {
                                                    "id": "722120413",
                                                    "speaker": "大岛纯平",
                                                    "text": "咦？石头人类？我吗？"
                                                },
                                                {
                                                    "id": "722120414",
                                                    "speaker": "大岛纯平",
                                                    "text": "敲石头…呃，你是说做石雕啊，我倒是可以试试看…"
                                                },
                                                {
                                                    "id": "722120415",
                                                    "speaker": "「寝子」",
                                                    "text": "是吗？那太好了，喵喵喵。"
                                                },
                                                {
                                                    "id": "722120416",
                                                    "speaker": "大岛纯平",
                                                    "text": "这、这样啊…无论如何，有份工作都是件好事。虽然我也从来没为一只猫工作过…报酬的事…之后再聊吧…"
                                                },
                                                {
                                                    "id": "722120417",
                                                    "speaker": "大岛纯平",
                                                    "text": "呃，我得先去做点准备工作，这岛上倒是有不少石头，我得去好好挑一下…"
                                                },
                                                {
                                                    "id": "722120418",
                                                    "speaker": "大岛纯平",
                                                    "text": "那个，我该怎么称呼你？"
                                                },
                                                {
                                                    "id": "722120419",
                                                    "speaker": "「寝子」",
                                                    "text": "喔，奴家是这座「浅濑神社」的代宫司，寝子。"
                                                },
                                                {
                                                    "id": "722120420",
                                                    "speaker": "「寝子」",
                                                    "text": "至于称呼，随汝喜欢就好，高高的，会敲石头的人类。"
                                                },
                                                {
                                                    "id": "722120421",
                                                    "speaker": "大岛纯平",
                                                    "text": "是吗？那我…就叫你代宫司大人吧，毕竟是发工钱的人嘛。"
                                                },
                                                {
                                                    "id": "722120422",
                                                    "speaker": "「寝子」",
                                                    "text": "「宫前」？"
                                                },
                                                {
                                                    "id": "722120423",
                                                    "speaker": "大岛纯平",
                                                    "text": "……"
                                                },
                                                {
                                                    "id": "722120424",
                                                    "speaker": "大岛纯平",
                                                    "text": "那、那我就先去周围看看，挑挑石头去了，你们先聊着。"
                                                },
                                                {
                                                    "id": "722120425",
                                                    "speaker": "大岛纯平",
                                                    "text": "给一只猫工作，还真是新奇…"
                                                },
                                                {
                                                    "id": "722120426",
                                                    "speaker": "派蒙",
                                                    "text": "大岛先生，好像已经不想思考报酬的事情了呢…"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "722120407",
                                            "text": "只不过是猫会说话而已。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "722120403",
                            "text": "对，石头人类。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7221205",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "722120501",
                    "speaker": "「寝子」",
                    "text": "石头的事情，就交给汝等了。"
                }
            ]
        },
        {
            "id": "7221299",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "722129901",
                    "speaker": "派蒙",
                    "text": "看前面，那就是悦子小姐给我们标注的营地了，里面还真有人！"
                },
                {
                    "id": "722129902",
                    "speaker": "派蒙",
                    "text": "我们快上去问问吧，希望他会雕石雕…"
                }
            ]
        }
    ]
}