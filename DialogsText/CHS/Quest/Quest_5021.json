            "dialogues": []
        },
        {
            "id": "502105",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "50210501",
                    "speaker": "玛亚薇",
                    "text": "谢谢你们，哎，突然冒出来这么多…"
                },
                {
                    "id": "50210502",
                    "speaker": "瓦曼",
                    "text": "是啊，就差一点点。也要感谢医生到这么危险的地方来找我们。"
                },
                {
                    "id": "50210503",
                    "speaker": "玛亚薇",
                    "text": "这是我应该做的。"
                }
            ]
        },
        {
            "id": "502110",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "50211001",
                    "speaker": "奇马利",
                    "text": "对了，这附近还有一个地方比较可疑，我怀疑有深渊魔物。"
                },
                {
                    "id": "50211002",
                    "speaker": "奇马利",
                    "text": "你们如果有空的话，愿意和我一起来吗？",
                    "choices": [
                        {
                            "id": "50211003",
                            "text": "走吧。",
                            "response": [
                                {
                                    "id": "50211004",
                                    "speaker": "奇马利",
                                    "text": "好的，那我们这就行动。"
                                }
                            ]
                        },
                        {
                            "id": "50211005",
                            "text": "还有别的事要做。",
                            "response": [
                                {
                                    "id": "50211006",
                                    "speaker": "奇马利",
                                    "text": "没问题，那待会儿我叫几个伙伴一起去。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "502115",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "50211501",
                    "speaker": "玛亚薇",
                    "text": "欸，没想到会在这里又遇到你们。"
                },
                {
                    "id": "50211502",
                    "speaker": "玛亚薇",
                    "text": "儿子给我回信了，告诉我那边的情况暂时不用担心。"
                },
                {
                    "id": "50211503",
                    "speaker": "玛亚薇",
                    "text": "听说竞技场很缺医生，我就跟着一支队伍过来了。"
                },
                {
                    "id": "50211504",
                    "speaker": "玛亚薇",
                    "text": "我也上年纪了，没办法再冲到最前面去拼杀，但后方交给我们吧，一切都会好起来的。"
                }
            ]
        },
        {
            "id": "502144",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "50214401",
                    "speaker": "玛亚薇",
                    "text": "战士小队怎么还不来，再不出发的话…"
                }
            ]
        },
        {
            "id": "502150",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "50215001",
                    "speaker": "特波兹",
                    "text": "等下我就和他们继续行动了，唉，希望母亲没事。"
                }
            ]
        },
        {
            "id": "502151",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "50215101",
                    "speaker": "乌图伦库",
                    "text": "唉…没办法了啊。"
                }
            ]
        },
        {
            "id": "502152",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "50215201",
                    "speaker": "乌图伦库",
                    "text": "谢谢你们能鼓励我，接纳了内心的恐惧之后，我好像反而没那么害怕了。"
                }
            ]
        },
        {
            "id": "502153",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "50215301",
                    "speaker": "瓦曼",
                    "text": "太谢谢她了，她真是个厉害的人，我不会忘记她的救命之恩。"
                }
            ]
        },
        {
            "id": "502154",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "50215401",
                    "speaker": "奇马利",
                    "text": "感谢你们协助，我会继续守住这里。"
                }
            ]
        },
        {
            "id": "502155",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "50215501",
                    "speaker": "奥希娜",
                    "text": "那、那路上的安全就交给你们了？"
                },
                {
                    "id": "50215502",
                    "speaker": "斯塔杜欣",
                    "text": "别太指望别人，你们也注意自保。"
                }
            ]
        },
        {
            "id": "502156",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "50215601",
                    "speaker": "奥希娜",
                    "text": "流泉之众有别的商队在支援，我还是量力而行吧…"
                }
            ]
        },
        {
            "id": "502157",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "50215701",
                    "speaker": "玛亚薇",
                    "text": "对了，你还能联系到后续的药剂供应吗？"
                },
                {
                    "id": "50215702",
                    "speaker": "奥希娜",
                    "text": "不一定，现在通信很困难，储备也不见得够，但我会尽力试试看。"
                }
            ]
        },
        {
            "id": "502158",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "50215801",
                    "speaker": "乌图伦库",
                    "text": "能被人记住，就算成为英雄了吧。"
                }
            ]
        },
        {
            "id": "502159",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "50215901",
                    "speaker": "乌图伦库",
                    "text": "你说得对，死亡并不是目的，我要参加战斗，我还要活下去。"
                }
            ]
        }
    ]
}