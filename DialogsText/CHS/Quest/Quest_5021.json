    "talks": [
        {
            "id": "502101",
            "objective": "(test)和胆怯的士兵对话$HIDDEN",
            "dialogues": [
                {
                    "id": "50210101",
                    "speaker": "乌图伦库",
                    "text": "你们…会害怕吗？"
                }
            ]
        },
        {
            "id": "502102",
            "objective": "(test)和找妈妈的孩子对话$HIDDEN",
            "dialogues": [
                {
                    "id": "50210201",
                    "speaker": "特波兹",
                    "text": "你好，旅行者，可以帮我个忙吗？"
                },
                {
                    "id": "50210202",
                    "speaker": "特波兹",
                    "text": "我的母亲她是个医生，当时听说野外有人受到袭击，她就赶去了，现在都没有消息。"
                },
                {
                    "id": "50210203",
                    "speaker": "特波兹",
                    "text": "她不擅长战斗，我很担心她，可惜现在我也没办法离开，能不能麻烦你们看到她的话，让她不要到处乱跑了，快去避难。"
                },
                {
                    "id": "50210204",
                    "speaker": "派蒙",
                    "text": "好，我们会留意的！"
                },
                {
                    "id": "50210205",
                    "speaker": "特波兹",
                    "text": "谢谢，这样我在战斗的时候也不会分心了。"
                }
            ]
        },
        {
            "id": "502103",
            "objective": "(test)第一个事件的存档隔离$HIDDEN",
            "dialogues": [
                {
                    "id": "50210301",
                    "speaker": "Player",
                    "text": "害怕也是人之常情。"
                },
                {
                    "id": "50210302",
                    "speaker": "乌图伦库",
                    "text": "人之常情，你是说，害怕并不可耻？"
                },
                {
                    "id": "50210303",
                    "speaker": "派蒙",
                    "text": "没错啊，就算害怕，你还是站在了这里，拿起了武器，是很了不起的！"
                },
                {
                    "id": "50210304",
                    "speaker": "乌图伦库",
                    "text": "这、这样啊，我懂了，嗯，谢谢你们能鼓励我！"
                }
            ]
        },
        {
            "id": "502104",
            "objective": "(test)遇见医生$HIDDEN",
            "dialogues": [
                {
                    "id": "50210401",
                    "speaker": "Player",
                    "text": "不会。"
                },
                {
                    "id": "50210402",
                    "speaker": "乌图伦库",
                    "text": "知、知道了，一看你就很强…"
                },
                {
                    "id": "50210403",
                    "speaker": "乌图伦库",
                    "text": "唉…"
                }
            ]
        },
        {
            "id": "502105",
            "objective": "(test)战斗后和医生对话$HIDDEN",
            "dialogues": [
                {
                    "id": "50210601",
                    "speaker": "派蒙",
                    "text": "医生…等等，请问你认识特波兹吗？"
                },
                {
                    "id": "50210602",
                    "speaker": "玛亚薇",
                    "text": "啊，你们怎么知道他，他是我的儿子，怎么了，他没事吧？"
                },
                {
                    "id": "50210603",
                    "speaker": "派蒙",
                    "text": "哦，没事没事，他只是很担心你，希望你去避难。"
                },
                {
                    "id": "50210604",
                    "speaker": "玛亚薇",
                    "text": "嗯，我知道，现在外面变得很危险，我不应该乱跑，但我也不能什么事都不做…"
                },
                {
                    "id": "50210605",
                    "speaker": "玛亚薇",
                    "text": "这样吧，我写封信给他，然后等有战士小队路过的时候，我跟他们一起走，这样我也能安全一些。"
                },
                {
                    "id": "50210606",
                    "speaker": "派蒙",
                    "text": "嗯，这样也好，总之他需要知道你还平安！"
                },
                {
                    "id": "50210607",
                    "speaker": "玛亚薇",
                    "text": "好的，谢谢你们能把消息带来。"
                }
            ]
        },
        {
            "id": "502122",
            "objective": "（test)悬木人部分回滚隔离$HIDDEN",
            "dialogues": [
                {
                    "id": "50212201",
                    "speaker": "Player",
                    "text": "一定会的。"
                },
                {
                    "id": "50212202",
                    "speaker": "乌图伦库",
                    "text": "我也希望，可是…好吧，我知道了。"
                }
            ]
        },
        {
            "id": "502106",
            "objective": "(test)寻找湿地的信差$HIDDEN",
            "dialogues": [
                {
                    "id": "50210801",
                    "speaker": "拉曼",
                    "text": "呃…呃…"
                },
                {
                    "id": "50210802",
                    "speaker": "派蒙",
                    "text": "果然有受伤的人！喂，你还好吗？还能走吗？"
                },
                {
                    "id": "50210803",
                    "speaker": "拉曼",
                    "text": "战报…战报掉了，那个东西很重要…"
                },
                {
                    "id": "50210804",
                    "speaker": "Player",
                    "text": "我们已经找到了。"
                },
                {
                    "id": "50210805",
                    "speaker": "派蒙",
                    "text": "别着急，来，给你。"
                },
                {
                    "id": "50210806",
                    "speaker": "拉曼",
                    "text": "谢谢，唉，希望我没有耽误太多时间…"
                },
                {
                    "id": "50210807",
                    "speaker": "拉曼",
                    "text": "时效性，在这种时候，就等于生命。"
                },
                {
                    "id": "50210808",
                    "speaker": "派蒙",
                    "text": "放心，接下来的事我们会处理的！现在就不要勉强自己了吧，最好直接回竞技场去养伤。"
                },
                {
                    "id": "50210809",
                    "speaker": "Player",
                    "text": "相信你的部族同伴吧。"
                },
                {
                    "id": "50210810",
                    "speaker": "拉曼",
                    "text": "嗯，也是，我现在也没有这个能力了。"
                },
                {
                    "id": "50210811",
                    "speaker": "派蒙",
                    "text": "但现在要怎么办，其他地方的情况也很紧急，可他似乎没办法一个人回去…"
                },
                {
                    "id": "50210812",
                    "speaker": "勇敢的匿叶龙",
                    "text": "呜——呜呜——"
                },
                {
                    "id": "50210813",
                    "speaker": "拉曼",
                    "text": "欸、欸？"
                },
                {
                    "id": "50210814",
                    "speaker": "Player",
                    "text": "它想送你回去？"
                },
                {
                    "id": "50210815",
                    "speaker": "派蒙",
                    "text": "呜哇，你们几个没问题吗？我可担心你们了。"
                },
                {
                    "id": "50210816",
                    "speaker": "勇敢的匿叶龙",
                    "text": "呜呜——"
                },
                {
                    "id": "50210817",
                    "speaker": "拉曼",
                    "text": "好吧，真是谢谢你们，太好了。"
                },
                {
                    "id": "50210818",
                    "speaker": "Player",
                    "text": "那你们路上小心。"
                },
                {
                    "id": "50210819",
                    "speaker": "派蒙",
                    "text": "有这些龙能帮忙，真是不幸中的万幸…",
                    "choices": [
                        {
                            "id": "50210820",
                            "text": "不然讯使的安全很难说。",
                            "response": [
                                {
                                    "id": "50210821",
                                    "speaker": "派蒙",
                                    "text": "怪不得说龙是纳塔人的好伙伴呢。"
                                }
                            ]
                        },
                        {
                            "id": "50210822",
                            "text": "看来它们还是能听懂你的话。",
                            "response": [
                                {
                                    "id": "50210823",
                                    "speaker": "派蒙",
                                    "text": "你在意的是这个吗！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
