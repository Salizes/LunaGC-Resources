{
    "quest": {
        "id": "21000",
        "title": "哎呀！海盗想长大！",
        "description": "璃月港的小蒙，最近有些烦恼…",
        "rewards": [],
        "rewards_formatted": "",
        "chapter": {
            "icon": "",
            "id": "",
