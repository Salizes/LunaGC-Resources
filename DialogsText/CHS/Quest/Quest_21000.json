        }
    },
    "talks": [
        {
            "id": "2100001",
            "objective": "与小蒙对话",
            "dialogues": [
                {
                    "id": "210000101",
                    "speaker": "小蒙",
                    "text": "唉，我真的能做到吗…"
                },
                {
                    "id": "210000102",
                    "speaker": "Player",
                    "text": "小蒙，你怎么了？"
                },
                {
                    "id": "210000103",
                    "speaker": "小蒙",
                    "text": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，是你啊…你好。"
                },
                {
                    "id": "210000104",
                    "speaker": "派蒙",
                    "text": "小蒙，你怎么看着有些不开心呀？"
                },
                {
                    "id": "210000105",
                    "speaker": "派蒙",
                    "text": "怎么了？是他们不和你玩那个…海盗游戏了吗？"
                },
                {
                    "id": "210000106",
                    "speaker": "小蒙",
                    "text": "欸？不是，璐璐和阿飞他们是回家去了。"
                },
                {
                    "id": "210000107",
                    "speaker": "小蒙",
                    "text": "我…是想要自己出去逛逛，所以才暂时没回家。"
                },
                {
                    "id": "210000108",
                    "speaker": "派蒙",
                    "text": "这样你父母不会担心吗？"
                },
                {
                    "id": "210000109",
                    "speaker": "小蒙",
                    "text": "现在这个时间，我爸妈应该还在工作没回家呢。"
                },
                {
                    "id": "210000110",
                    "speaker": "小蒙",
                    "text": "#不说这个，{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，我能问你个问题吗？",
                    "choices": [
                        {
                            "id": "210000111",
                            "text": "什么问题？",
                            "response": [
                                {
                                    "id": "210000114",
                                    "speaker": "小蒙",
                                    "text": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，我听很多人说起过你的事情。"
                                },
                                {
                                    "id": "210000115",
                                    "speaker": "小蒙",
                                    "text": "我觉得，你去过很多地方，也经历过很多事…说不定能告诉我这个问题的答案…"
                                },
                                {
                                    "id": "210000116",
                                    "speaker": "派蒙",
                                    "text": "呜哇…小蒙突然这么严肃了，到底是什么问题呀？"
                                },
                                {
                                    "id": "210000117",
                                    "speaker": "小蒙",
                                    "text": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，我想问你…"
                                },
                                {
                                    "id": "210000118",
                                    "speaker": "小蒙",
                                    "text": "一个人到底怎么样，才能变得「成熟」呢？",
                                    "choices": [
                                        {
                                            "id": "210000119",
                                            "text": "需要用时间来成长。",
                                            "response": [
                                                {
                                                    "id": "210000120",
                                                    "speaker": "小蒙",
                                                    "text": "你是说，只要长大了，人就会自然而然地变成熟吗？"
                                                },
                                                {
                                                    "id": "210000121",
                                                    "speaker": "小蒙",
                                                    "text": "可是，长大了之后再成熟，会不会有点太晚了呢…"
                                                },
                                                {
                                                    "id": "210000124",
                                                    "speaker": "派蒙",
                                                    "text": "唔…如果你是想要出城看看的话，我们可以陪你出去逛逛呀。"
                                                },
                                                {
                                                    "id": "210000125",
                                                    "speaker": "小蒙",
                                                    "text": "那也太麻烦你们了，而且…只是出城的话，我应该也不会有什么特别的收获吧…"
                                                },
                                                {
                                                    "id": "210000126",
                                                    "speaker": "小蒙",
                                                    "text": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，我想请你们帮我另一个忙…"
                                                },
                                                {
                                                    "id": "210000127",
                                                    "speaker": "小蒙",
                                                    "text": "我听人家说，如果有解决不了的烦恼，可以把烦恼写下来放进漂流瓶里，让烦恼随着河水飘出去…"
                                                },
                                                {
                                                    "id": "210000128",
                                                    "speaker": "小蒙",
                                                    "text": "这样子，说不定烦恼就会得到解决。"
                                                },
                                                {
                                                    "id": "210000129",
                                                    "speaker": "小蒙",
                                                    "text": "但我听说，外面有很多魔物，我一个人去有些不太安全。"
                                                },
                                                {
                                                    "id": "210000130",
                                                    "speaker": "小蒙",
                                                    "text": "#所以，我想要拜托{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}保护一下我…",
                                                    "choices": [
                                                        {
                                                            "id": "210000131",
                                                            "text": "没问题。",
                                                            "response": [
                                                                {
                                                                    "id": "210000133",
                                                                    "speaker": "小蒙",
                                                                    "text": "#谢谢{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}。我会付你报酬的，都是我自己攒的钱。"
                                                                },
                                                                {
                                                                    "id": "210000134",
                                                                    "speaker": "小蒙",
                                                                    "text": "那我们出发吧，先去碧水河边看看。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "210000132",
                                                            "text": "交给我吧。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "210000122",
                                            "text": "需要经历特别的事。",
                                            "response": [
                                                {
                                                    "id": "210000123",
                                                    "speaker": "小蒙",
                                                    "text": "要经历特别的事…可我到现在，连璃月港都没踏出去过…"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "210000112",
                            "text": "我暂时没空陪你玩…",
                            "response": [
                                {
                                    "id": "210000113",
                                    "speaker": "小蒙",
                                    "text": "哈哈哈，那个游戏我也是陪着璐璐和阿飞玩啦，他们不在，我也不会特意去玩的。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2100002",
            "objective": "前往碧水河附近",
            "dialogues": [
                {
                    "id": "210000201",
                    "speaker": "小蒙",
                    "text": "已经快到碧水河了吗？唔…我们挑个好地方把漂流瓶放出去吧。"
                },
                {
                    "id": "210000202",
                    "speaker": "小蒙",
                    "text": "如果想让漂流瓶漂远一些的话，应该要挑一个上游的位置…"
                }
            ]
        },
        {
            "id": "2100003",
            "objective": "与小蒙对话",
            "dialogues": []
        },
        {
            "id": "2100004",
            "objective": "寻找放出漂流瓶的地方",
            "dialogues": [
                {
                    "id": "210000401",
                    "speaker": "小蒙",
                    "text": "（test)呜哇哇哇！我的烦恼瓶不见了！"
                },
                {
                    "id": "210000402",
                    "speaker": "派蒙",
                    "text": "（test)那不是正好吗，就在这附近扔了吧。"
                },
                {
                    "id": "210000403",
                    "speaker": "小蒙",
                    "text": "（test)不要！这附近都是烦恼瓶，都搁浅在了这里，我的烦恼瓶肯定也扔不出去！"
                },
                {
                    "id": "210000404",
                    "speaker": "派蒙",
                    "text": "（test)哇啊，真的有好多瓶子！我们想找也找不到呀！"
                },
                {
                    "id": "210000405",
                    "speaker": "小蒙",
                    "text": "（test)我的信是我最喜欢的天蓝色的，所以应该很好找。"
                },
                {
                    "id": "210000406",
                    "speaker": "派蒙",
                    "text": "（test)真没办法，在这附近找找吧。"
                }
            ]
        },
        {
            "id": "2100005",
            "objective": "查看甜甜花",
            "dialogues": [
                {
                    "id": "210000501",
                    "speaker": "小蒙",
                    "text": "太好了…我昨天晚上可是写了一晚上，弄丢的话，我就要重写了…"
                },
                {
                    "id": "210000502",
                    "speaker": "派蒙",
                    "text": "呜哇…你有那么多烦恼吗？怎么会写一整个晚上呀？"
                },
                {
                    "id": "210000503",
                    "speaker": "小蒙",
                    "text": "也…也不是有很多烦恼啦。我就只是想知道，怎么样才能变成熟啦。"
                },
                {
                    "id": "210000504",
                    "speaker": "小蒙",
                    "text": "我查了很多资料，也看了很多书，但越是看书，我想不明白的事反而越多了…"
                },
                {
                    "id": "210000505",
                    "speaker": "小蒙",
                    "text": "嘿嘿，所以我就把所有不明白的问题都写进去了，希望能得到答案。"
                },
                {
                    "id": "210000506",
                    "speaker": "小蒙",
                    "text": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，我们快点去把漂流瓶放出去吧。"
                }
            ]
        },
        {
            "id": "2100006",
            "objective": "打倒骗骗花",
            "dialogues": [
                {
                    "id": "210000601",
                    "speaker": "小蒙",
                    "text": "#这里看起来很合适，{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，我们就在这里放出漂流瓶吧。"
                },
                {
                    "id": "210000602",
                    "speaker": "小蒙",
                    "text": "希望…我的问题能够得到解答…"
                },
                {
                    "id": "210000603",
                    "speaker": "Player",
                    "text": "应该会的。"
                },
                {
                    "id": "210000604",
                    "speaker": "小蒙",
                    "text": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，我们先回城里去吧。"
                },
                {
                    "id": "210000605",
                    "speaker": "派蒙",
                    "text": "不过，就是放了个漂流瓶，小蒙的问题真的能得到解答吗…"
                },
                {
                    "id": "210000606",
                    "speaker": "Player",
                    "text": "也许只是找个心理安慰吧。"
                },
                {
                    "id": "210000607",
                    "speaker": "派蒙",
                    "text": "欸…是这样吗？总感觉小蒙还有很多心事没告诉我们呢…"
                },
                {
                    "id": "210000608",
                    "speaker": "派蒙",
                    "text": "「如何变成熟」这个问题，还真是让人为难啊。"
                }
            ]
        },
        {
            "id": "2100018",
            "objective": "与小蒙对话",
            "dialogues": []
        },
        {
            "id": "2100007",
            "objective": "与小蒙对话",
            "dialogues": [
                {
                    "id": "210000301",
                    "speaker": "小蒙",
                    "text": "居然…居然有这种东西…吓死我了…"
                },
                {
                    "id": "210000302",
                    "speaker": "小蒙",
                    "text": "#谢谢你，{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，我们继续…"
                },
                {
                    "id": "210000303",
                    "speaker": "小蒙",
                    "text": "欸？我…我的漂流瓶呢？刚刚还在我身上的，不见了！"
                },
                {
                    "id": "210000304",
                    "speaker": "小蒙",
                    "text": "难道是刚才被那个…那个骗骗花袭击的时候，掉在哪里了？"
                },
                {
                    "id": "210000305",
                    "speaker": "小蒙",
                    "text": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，拜托你帮我找找吧。"
                }
            ]
        },
        {
            "id": "2100010",
            "objective": "寻找漂流瓶",
            "dialogues": [
                {
                    "id": "210001001",
                    "speaker": "查看",
                    "text": "(test)里面装着小蒙最爱的蓝色的信纸，小蒙到底有什么烦恼呢？"
                }
            ]
        },
        {
            "id": "2100017",
            "objective": "将漂流瓶带给小蒙",
            "dialogues": []
        },
        {
            "id": "2100011",
            "objective": "将漂流瓶带给小蒙",
            "dialogues": []
        },
        {
            "id": "2100012",
            "objective": "跟随小蒙放出漂流瓶",
            "dialogues": [
                {
                    "id": "210001201",
                    "speaker": "小蒙",
                    "text": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，你找到漂流瓶了吗？"
                }
            ]
        },
        {
            "id": "2100013",
            "objective": "与小蒙对话",
            "dialogues": []
        },
        {
            "id": "2100014",
            "objective": "送小蒙回璃月港",
            "dialogues": []
        },
        {
            "id": "2100015",
            "objective": "与小蒙对话",
            "dialogues": [
                {
                    "id": "210000701",
                    "speaker": "小蒙",
                    "text": "#好了，今天谢谢你了，{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}。"
                },
                {
                    "id": "210000702",
                    "speaker": "小蒙",
                    "text": "这些东西是给你的，请你收下吧。"
                },
                {
                    "id": "210000703",
                    "speaker": "小蒙",
                    "text": "对了，今天的事情还请你向璐璐和阿飞保密。"
                },
                {
                    "id": "210000704",
                    "speaker": "小蒙",
                    "text": "这是我一个人的烦恼，可别让他们也跟着不开心了。"
                },
                {
                    "id": "210000705",
                    "speaker": "小蒙",
                    "text": "#好了，我要回家去了，再见了，{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}。"
                }
            ]
        },
        {
            "id": "2100008",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "210000801",
                    "speaker": "查看",
                    "text": "小蒙的漂流瓶，不知道是不是因为里面装着的烦恼太多，所以还没有漂太远…"
                }
            ]
        },
        {
            "id": "2100011",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "210001101",
                    "speaker": "小蒙",
                    "text": "漂流瓶掉在哪了…"
                }
            ]
        }
    ]
}