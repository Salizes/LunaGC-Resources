    "talks": [
        {
            "id": "1402201",
            "objective": "等待至两天后",
            "dialogues": []
        },
        {
            "id": "1402202",
            "objective": "前往厄舍的工厂",
            "dialogues": [
                {
                    "id": "140220201",
                    "speaker": "千织",
                    "text": "你们来啦。"
                },
                {
                    "id": "140220202",
                    "speaker": "派蒙",
                    "text": "千织！衣服的制作还顺利吗？你看起来有些累。"
                },
                {
                    "id": "140220203",
                    "speaker": "千织",
                    "text": "还剩最后几道工序，已经交给爱洛芙了。应该能赶上晚上的时装秀。"
                },
                {
                    "id": "140220204",
                    "speaker": "派蒙",
                    "text": "这时间掐得好危险…你不去没事吗？"
                },
                {
                    "id": "140220205",
                    "speaker": "千织",
                    "text": "放心，我哪边都没打算输。况且今晚时装秀，厄舍工厂停业，要找证据的话这是我们唯一的机会。"
                },
                {
                    "id": "140220206",
                    "speaker": "派蒙",
                    "text": "虽然是他有错在先，但我们这么闯进去，是不是也算犯罪呀？"
                },
                {
                    "id": "140220207",
                    "speaker": "千织",
                    "text": "他的工厂平时也开放参观。今天说的是停业，没说停止参观。"
                },
                {
                    "id": "140220208",
                    "speaker": "千织",
                    "text": "我们只是好奇的顾客而已，有什么问题吗？"
                },
                {
                    "id": "140220209",
                    "speaker": "派蒙",
                    "text": "你要是这么说的话…"
                },
                {
                    "id": "140220210",
                    "speaker": "千织",
                    "text": "好了，厄舍的工厂就是那间。抓紧时间，该行动了。"
                },
                {
                    "id": "140220211",
                    "speaker": "派蒙",
                    "text": "呃…怎么会开在那种地方…"
                },
                {
                    "id": "140220212",
                    "speaker": "千织",
                    "text": "营销策略不同，「千织屋」主打高级定制，他主打便宜多销。可能这里租金便宜吧。"
                },
                {
                    "id": "140220213",
                    "speaker": "派蒙",
                    "text": "好吧，只是看起来阴森森的，我绝对不会去那里买衣服。"
                },
                {
                    "id": "140220214",
                    "speaker": "千织",
                    "text": "你说得对，待会儿也多加小心。"
                }
            ]
        },
        {
            "id": "1402210",
            "objective": "进入厄舍的工厂",
            "dialogues": [
                {
                    "id": "140221001",
                    "speaker": "本子上的备忘录",
                    "text": "「…宣传支出十万摩拉、雇佣支出二十万摩拉、原料支出…」"
                }
            ]
        },
        {
            "id": "1402215",
            "objective": "调查厄舍的工厂",
            "dialogues": [
                {
                    "id": "140221501",
                    "speaker": "桌上散落的笔记",
                    "text": "寄给夏沃蕾的信——"
                },
                {
                    "id": "140221502",
                    "speaker": "桌上散落的笔记",
                    "text": "执律庭…的职员，于店内提及上司与…的交易，语气确凿…"
                },
                {
                    "id": "140221503",
                    "speaker": "桌上散落的笔记",
                    "text": "有人于…目击到通缉犯…出没，恐怕是谣言…"
                }
            ]
        },
        {
            "id": "1402203",
            "objective": "在周围调查",
            "dialogues": [
                {
                    "id": "140220601",
                    "speaker": "书柜上的纸张",
                    "text": "（看起来像是以前的设计手稿，没有什么特别的地方。）"
                }
            ]
        },
        {
            "id": "1402212",
            "objective": "在周围调查",
            "dialogues": []
        },
        {
            "id": "1402213",
            "objective": "在周围调查",
            "dialogues": [
                {
                    "id": "140221101",
                    "speaker": "桌上的笔记",
                    "text": "「…快递员…将于…上午进城，途经…」"
                }
            ]
        },
        {
            "id": "1402214",
            "objective": "",
            "dialogues": [
                {
                    "id": "140221401",
                    "speaker": "派蒙",
                    "text": "看起来是类似仓库的地方呢，呜…这里也臭烘烘的。"
                },
                {
                    "id": "140221402",
                    "speaker": "派蒙",
                    "text": "呃！怎么回事？进来的路被堵住了！"
                },
                {
                    "id": "140221403",
                    "speaker": "Player",
                    "text": "是想把我们困在工厂里…"
                },
                {
                    "id": "140221404",
                    "speaker": "千织",
                    "text": "……"
                },
                {
                    "id": "140221405",
                    "speaker": "千织",
                    "text": "看来他知道我们会来。"
                },
                {
                    "id": "140221406",
                    "speaker": "派蒙",
                    "text": "我记得千织你之前好像说，厄舍那家伙很了解你？"
                },
                {
                    "id": "140221407",
                    "speaker": "千织",
                    "text": "嗯，其实…厄舍是我最初的合作伙伴。"
                },
                {
                    "id": "140221408",
                    "speaker": "派蒙",
                    "text": "欸？完全看不出来！你们俩关系明明这么差！"
                },
                {
                    "id": "140221409",
                    "speaker": "千织",
                    "text": "刚到枫丹的时候，我和他都是向往步入「时尚」舞台的设计师。为了共同的目标，我们合作过一段时间。"
                },
                {
                    "id": "140221410",
                    "speaker": "千织",
                    "text": "原本我们都想做出与众不同、突破传统、让所有人都惊叹的服装…"
                },
                {
                    "id": "140221411",
                    "speaker": "千织",
                    "text": "但随着别人的一声声否定、投资人的一次次摇头…厄舍渐渐失去了信心。"
                },
                {
                    "id": "140221412",
                    "speaker": "千织",
                    "text": "终于，在时装周前夕，他断定我们做不出理想中的衣服了，和我分道扬镳。"
                },
                {
                    "id": "140221413",
                    "speaker": "千织",
                    "text": "我本着孤注一掷的心情，倾尽所有…在最后一天做出了满意的服装，怀着忐忑的心情参加了时装秀。"
                },
                {
                    "id": "140221414",
                    "speaker": "派蒙",
                    "text": "结果就是千织你一举成名，但厄舍却放弃了自己的梦想，转而做起这种亏心的衣服吗？"
                },
                {
                    "id": "140221415",
                    "speaker": "千织",
                    "text": "具体怎样我不知道，但我开了「千织屋」后，他每年都会给我使绊子这事是真的。"
                },
                {
                    "id": "140221416",
                    "speaker": "派蒙",
                    "text": "哼！我看他就是嫉妒你的成就，我可一点都不同情他！"
                },
                {
                    "id": "140221417",
                    "speaker": "千织",
                    "text": "不管怎么说，还是先想想怎么逃出去吧。"
                },
                {
                    "id": "140221418",
                    "speaker": "千织",
                    "text": "要是赶不上时装秀，那就真让他得逞了。"
                },
                {
                    "id": "140221419",
                    "speaker": "派蒙",
                    "text": "啊，那边有几个操作台！去看看有没有什么能动的按钮吧！"
                }
            ]
        },
        {
            "id": "1402216",
            "objective": "调查试衣间",
            "dialogues": [
                {
                    "id": "140221601",
                    "speaker": "桌上散落的笔记",
                    "text": "艾梅莉埃寄来的信——"
                },
                {
                    "id": "140221602",
                    "speaker": "桌上散落的笔记",
                    "text": "…非常感谢千织小姐对于香氛的宝贵意见，信中附上新款样品，是我最近尝试的海露香调…"
                },
                {
                    "id": "140221603",
                    "speaker": "桌上散落的笔记",
                    "text": "另外，关于下一次试香的安排…"
                }
            ]
        },
        {
            "id": "1402204",
            "objective": "深入工厂",
            "dialogues": [
                {
                    "id": "140221201",
                    "speaker": "派蒙",
                    "text": "这里看起来好脏啊，上面的衣服真的是在这里做出来的吗？"
                },
                {
                    "id": "140221202",
                    "speaker": "千织",
                    "text": "…你们看那边。"
                },
                {
                    "id": "140221203",
                    "speaker": "派蒙",
                    "text": "呜…好脏的水。我在这里都闻见臭味了。"
                },
                {
                    "id": "140221204",
                    "speaker": "千织",
                    "text": "厄舍这家伙，还敢说我的用料有问题。"
                },
                {
                    "id": "140221205",
                    "speaker": "派蒙",
                    "text": "搞半天，是他自己开了个黑心工厂…"
                },
                {
                    "id": "140221206",
                    "speaker": "千织",
                    "text": "我说他做的衣服怎么摸起来怪怪的…"
                },
                {
                    "id": "140221207",
                    "speaker": "千织",
                    "text": "原来是为了削减成本，偷偷在工厂里搞这些小动作…"
                },
                {
                    "id": "140221208",
                    "speaker": "派蒙",
                    "text": "这样做出来的衣服能穿吗？"
                },
                {
                    "id": "140221209",
                    "speaker": "千织",
                    "text": "褪色和缩水都是小事了，这不正规的用料…穿多了皮肤都要出问题。"
                },
                {
                    "id": "140221210",
                    "speaker": "派蒙",
                    "text": "好可怕…我们快把这些证据拍下来吧！"
                },
                {
                    "id": "140221211",
                    "speaker": "派蒙",
                    "text": "这样他在审判庭上就无话可说了！我们继续前进吧。"
                }
            ]
        },
        {
            "id": "1402205",
            "objective": "调查仓库",
            "dialogues": []
        },
        {
            "id": "1402206",
            "objective": "离开厄舍的工厂",
            "dialogues": []
        },
        {
            "id": "1402207",
            "objective": "离开厄舍的工厂",
            "dialogues": [
                {
                    "id": "140220701",
                    "speaker": "派蒙",
                    "text": "…总算回到出口了。"
                },
                {
                    "id": "140220702",
                    "speaker": "厄舍",
                    "text": "…哦？真是意外。连下面的房间都困不住你们。"
                },
                {
                    "id": "140220703",
                    "speaker": "派蒙",
                    "text": "厄舍！你逃不掉了！我们已经掌握了你工厂的犯罪证据！"
                },
                {
                    "id": "140220704",
                    "speaker": "厄舍",
                    "text": "你又凭什么觉得，我会让证据离开这个工厂呢？"
                },
                {
                    "id": "140220705",
                    "speaker": "千织",
                    "text": "又是机械警卫…你有完没完？拿这些钱去干点正事不好吗？"
                },
                {
                    "id": "140220706",
                    "speaker": "厄舍",
                    "text": "这就是我的正事。"
                },
                {
                    "id": "140220707",
                    "speaker": "千织",
                    "text": "搞垮「千织屋」？还是做你的臭衣服？"
                },
                {
                    "id": "140220708",
                    "speaker": "厄舍",
                    "text": "是去证明「时尚」仅仅为一场可笑的闹剧，一场无知的狂欢！"
                },
                {
                    "id": "140220709",
                    "speaker": "千织",
                    "text": "…你被「时尚」这个概念套住了，厄舍。别去迎合它，做自己的东西，去改变它。"
                },
                {
                    "id": "140220710",
                    "speaker": "厄舍",
                    "text": "别在这对我说教！你早晚也会有一天对「时尚」低头，它说到底就只是一种舆论而已！"
                },
                {
                    "id": "140220711",
                    "speaker": "千织",
                    "text": "它是人们对一种理念的向往。而「千织屋」的理念，就是绝不低头…"
                },
                {
                    "id": "140220712",
                    "speaker": "厄舍",
                    "text": "哼，当人们看到时尚界推崇的「千织屋」一落千丈的时候，他们就会知道这理念有多可笑。"
                },
                {
                    "id": "140220713",
                    "speaker": "千织",
                    "text": "你就为了证明自己这个无聊的念头，才对我的品牌下手？"
                },
                {
                    "id": "140220715",
                    "speaker": "千织",
                    "text": "…以前的你可不是这样的，那个想做出震撼人心作品的厄舍去哪儿了？"
                },
                {
                    "id": "140220716",
                    "speaker": "厄舍",
                    "text": "我只是意识到那种不切实际的梦想有多么荒唐！"
                },
                {
                    "id": "140220717",
                    "speaker": "千织",
                    "text": "…你放弃了自己的梦想，现在又转过头来贬低它。"
                },
                {
                    "id": "140220718",
                    "speaker": "千织",
                    "text": "你自以为看清了一切，但…你不过是想证明自己放弃的那条路是错的，才能心安理得地过下去罢了。"
                },
                {
                    "id": "140220719",
                    "speaker": "千织",
                    "text": "我就直说了吧，你这样子很可悲。"
                },
                {
                    "id": "140220720",
                    "speaker": "厄舍",
                    "text": "可悲的是你。像个傻子一样做着什么「风靡提瓦特」的白日梦，我看你连枫丹都要待不下去了！"
                },
                {
                    "id": "140220721",
                    "speaker": "千织",
                    "text": "……"
                },
                {
                    "id": "140220722",
                    "speaker": "千织",
                    "text": "…你说得对，或许所有追逐梦想的人都是傻子。"
                },
                {
                    "id": "140220723",
                    "speaker": "千织",
                    "text": "但更可悲的，是那些连傻子都不敢做的懦夫…"
                },
                {
                    "id": "140220724",
                    "speaker": "厄舍",
                    "text": "你…！",
                    "choices": [
                        {
                            "id": "140220725",
                            "text": "…千织，你先走。",
                            "response": [
                                {
                                    "id": "140220727",
                                    "speaker": "派蒙",
                                    "text": "没错，这里交给我们！"
                                },
                                {
                                    "id": "140220728",
                                    "speaker": "千织",
                                    "text": "不，应该是你们先走才对。"
                                },
                                {
                                    "id": "140220729",
                                    "speaker": "派蒙",
                                    "text": "欸？可是…他还有枪…"
                                },
                                {
                                    "id": "140220730",
                                    "speaker": "千织",
                                    "text": "没事的。你们去会场，告诉大家计划照常进行。"
                                },
                                {
                                    "id": "140220731",
                                    "speaker": "千织",
                                    "text": "这里，必须由我「亲自」给他一个教训。",
                                    "choices": [
                                        {
                                            "id": "140220732",
                                            "text": "…我明白了。",
                                            "response": [
                                                {
                                                    "id": "140220734",
                                                    "speaker": "派蒙",
                                                    "text": "…千织你一定要赶上啊！"
                                                },
                                                {
                                                    "id": "140220735",
                                                    "speaker": "厄舍",
                                                    "text": "想走？"
                                                },
                                                {
                                                    "id": "140220736",
                                                    "speaker": "Black Screen",
                                                    "text": ""
                                                },
                                                {
                                                    "id": "140220737",
                                                    "speaker": "千织",
                                                    "text": "看在与你合作过的份上，我一直对你手下留情，厄舍…"
                                                },
                                                {
                                                    "id": "140220738",
                                                    "speaker": "厄舍",
                                                    "text": "……"
                                                },
                                                {
                                                    "id": "140220739",
                                                    "speaker": "千织",
                                                    "text": "但「参观」完你的工厂之后，我就不那么想了。"
                                                },
                                                {
                                                    "id": "140220740",
                                                    "speaker": "厄舍",
                                                    "text": "哼…还在嘴硬。"
                                                },
                                                {
                                                    "id": "140220741",
                                                    "speaker": "千织",
                                                    "text": "不管你经历了什么，不管你为什么会变成这个样子…"
                                                },
                                                {
                                                    "id": "140220742",
                                                    "speaker": "千织",
                                                    "text": "用我朋友的话说——我一点都不同情你。"
                                                },
                                                {
                                                    "id": "140220743",
                                                    "speaker": "厄舍",
                                                    "text": "……"
                                                },
                                                {
                                                    "id": "140220744",
                                                    "speaker": "千织",
                                                    "text": "就让我来告诉你，「千织」这个品牌代表了什么吧…"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "140220733",
                                            "text": "…千万小心。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "140220726",
                            "text": "…时装秀要紧。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1402208",
            "objective": "返回「千织屋」",
            "dialogues": [
                {
                    "id": "140220801",
                    "speaker": "娜维娅",
                    "text": "…现在怎么样了？"
                },
                {
                    "id": "140220802",
                    "speaker": "千织",
                    "text": "再往左靠一点。"
                },
                {
                    "id": "140220803",
                    "speaker": "绮良良",
                    "text": "…这样？"
                },
                {
                    "id": "140220804",
                    "speaker": "千织",
                    "text": "嗯，完美。"
                },
                {
                    "id": "140220805",
                    "speaker": "绮良良",
                    "text": "嘿咻…！"
                },
                {
                    "id": "140220806",
                    "speaker": "夏洛蒂",
                    "text": "哦！很合适呢！千织小姐，我能拍一张吗？"
                },
                {
                    "id": "140220807",
                    "speaker": "千织",
                    "text": "当然。"
                },
                {
                    "id": "140220808",
                    "speaker": "绮良良",
                    "text": "我都不知道千织姐你还做了新招牌呢。"
                },
                {
                    "id": "140220809",
                    "speaker": "千织",
                    "text": "时装周前就做好了。想着等时装秀成功之后再挂上去。"
                },
                {
                    "id": "140220810",
                    "speaker": "娜维娅",
                    "text": "想要风靡提瓦特，没有一个自己的招牌怎么行？在这一点上，「刺玫会」可比你领先哦！"
                },
                {
                    "id": "140220811",
                    "speaker": "林尼",
                    "text": "这么一想的话，我们魔术团队是不是也该考虑设计一个？"
                },
                {
                    "id": "140220812",
                    "speaker": "琳妮特",
                    "text": "哥哥和我的招牌图案，分别是「怪笑帽帽猫」和「惊奇猫猫盒」。还得把佩伊加进来。"
                },
                {
                    "id": "140220813",
                    "speaker": "林尼",
                    "text": "那佩伊就是…「不笑饿饿鹅」？"
                },
                {
                    "id": "140220814",
                    "speaker": "娜维娅",
                    "text": "噗哈哈哈哈…"
                },
                {
                    "id": "140220815",
                    "speaker": "千织",
                    "text": "听起来是需要在帽子里塞两只猫和一只企鹅？"
                },
                {
                    "id": "140220816",
                    "speaker": "绮良良",
                    "text": "哇，好像很暖和！"
                },
                {
                    "id": "140220817",
                    "speaker": "琳妮特",
                    "text": "画面好挤…"
                },
                {
                    "id": "140220818",
                    "speaker": "夏洛蒂",
                    "text": "#千织小姐！我拍好了，连带着{NICKNAME}给我的那些证据，文章明天就能登上《蒸汽鸟报》。"
                },
                {
                    "id": "140220819",
                    "speaker": "千织",
                    "text": "谢谢你，夏洛蒂。"
                },
                {
                    "id": "140220820",
                    "speaker": "夏洛蒂",
                    "text": "没事没事，将真相带给观众，是一位记者应该做的。"
                },
                {
                    "id": "140220821",
                    "speaker": "千织",
                    "text": "以后「温亨廷先生」的装饰，我全都免费帮你定制。"
                },
                {
                    "id": "140220822",
                    "speaker": "夏洛蒂",
                    "text": "欸欸欸！真…真的可以吗？"
                },
                {
                    "id": "140220823",
                    "speaker": "千织",
                    "text": "当然。林尼和琳妮特也别客气，以后有什么想要的演出服，随时和我说一声就好。"
                },
                {
                    "id": "140220824",
                    "speaker": "琳妮特",
                    "text": "不是演出服也行吗？"
                },
                {
                    "id": "140220825",
                    "speaker": "林尼",
                    "text": "那就多谢千织小姐了。"
                },
                {
                    "id": "140220826",
                    "speaker": "娜维娅",
                    "text": "我就不要什么好处了！你平时多来串串门就行。"
                },
                {
                    "id": "140220827",
                    "speaker": "绮良良",
                    "text": "我也不需要什么，只要千织姐以后的跨国快递继续指名我就行。"
                },
                {
                    "id": "140220828",
                    "speaker": "娜维娅",
                    "text": "哦，说到这个，绮良良你什么时候回去？"
                },
                {
                    "id": "140220829",
                    "speaker": "绮良良",
                    "text": "欸！这个…我…"
                },
                {
                    "id": "140220830",
                    "speaker": "娜维娅",
                    "text": "「刺玫会」专门为你准备了一辆车，可以让你坐在里面，我们推着你出枫丹哟！"
                },
                {
                    "id": "140220831",
                    "speaker": "绮良良",
                    "text": "那也太丢人了吧！"
                },
                {
                    "id": "140220832",
                    "speaker": "派蒙",
                    "text": "嘿嘿，那我们有没有什么好处呢？"
                },
                {
                    "id": "140220833",
                    "speaker": "千织",
                    "text": "当然有，待会儿…"
                },
                {
                    "id": "140220834",
                    "speaker": "夏沃蕾",
                    "text": "扰乱会场秩序、私自挪用会场灯光、公众场合使用武器、危险演出不报备…"
                },
                {
                    "id": "140220835",
                    "speaker": "派蒙",
                    "text": "呃，夏沃蕾，你听我们说…"
                },
                {
                    "id": "140220836",
                    "speaker": "夏沃蕾",
                    "text": "…要是你们看见了我所描述的那些罪人，记得来向我这个特巡队队长汇报。"
                },
                {
                    "id": "140220837",
                    "speaker": "千织",
                    "text": "报罪名开心吗？吓我一跳呢。"
                },
                {
                    "id": "140220838",
                    "speaker": "夏沃蕾",
                    "text": "吓一跳的是我。会场上那出下次能提前告诉我一声吗？"
                },
                {
                    "id": "140220839",
                    "speaker": "千织",
                    "text": "告诉你你就会答应了？"
                },
                {
                    "id": "140220840",
                    "speaker": "夏沃蕾",
                    "text": "不会，但至少能让我不被吓到。"
                },
                {
                    "id": "140220841",
                    "speaker": "千织",
                    "text": "我这不是已经补偿你了吗？灰河那处生产有害商品的黑心工坊，我人都帮你捆好放在那里。还不够贴心吗？"
                },
                {
                    "id": "140220842",
                    "speaker": "夏沃蕾",
                    "text": "好吧，不和你争了。今晚我认输。"
                },
                {
                    "id": "140220843",
                    "speaker": "娜维娅",
                    "text": "什么嘛，既然在这里的大家都是朋友，不如就待会儿一起去吃一顿吧！记在「刺玫会」的账上！"
                },
                {
                    "id": "140220844",
                    "speaker": "夏沃蕾",
                    "text": "我就免了。还有一堆手续要办，你们玩得开心。"
                },
                {
                    "id": "140220845",
                    "speaker": "夏沃蕾",
                    "text": "对了，千织，我路上遇到维格尔，让我给你带个话。"
                },
                {
                    "id": "140220846",
                    "speaker": "千织",
                    "text": "行了行了，肯定就是些道歉什么的，不用劳烦你。我改天上门去嘲笑他。"
                },
                {
                    "id": "140220847",
                    "speaker": "夏沃蕾",
                    "text": "你还挺了解他。"
                },
                {
                    "id": "140220848",
                    "speaker": "千织",
                    "text": "这次也谢谢你了，夏沃蕾。"
                },
                {
                    "id": "140220849",
                    "speaker": "夏沃蕾",
                    "text": "应该的。另外我再说一句——"
                },
                {
                    "id": "140220850",
                    "speaker": "夏沃蕾",
                    "text": "刚才的时装秀真是漂亮极了。"
                },
                {
                    "id": "140220851",
                    "speaker": "千织",
                    "text": "还用你说？"
                },
                {
                    "id": "140220852",
                    "speaker": "娜维娅",
                    "text": "好了好了，要参加庆功宴的朝这儿看，跟我来吧！"
                },
                {
                    "id": "140220853",
                    "speaker": "千织",
                    "text": "#{NICKNAME}，派蒙，能先到风景好的地方等我一下吗？我去和娜维娅说我们晚点到。有东西送你们。"
                },
                {
                    "id": "140220854",
                    "speaker": "派蒙",
                    "text": "风景好的地方？哦！是那里对吧，没问题！"
                },
                {
                    "id": "140220855",
                    "speaker": "千织",
                    "text": "嗯，我很快就来。"
                }
            ]
        },
        {
            "id": "1402209",
            "objective": "前往约定的地点",
            "dialogues": [
                {
                    "id": "140220901",
                    "speaker": "千织",
                    "text": "久等了。"
                },
                {
                    "id": "140220902",
                    "speaker": "派蒙",
                    "text": "不久不久，有什么要到这里才能送呀？"
                },
                {
                    "id": "140220903",
                    "speaker": "千织",
                    "text": "…来，给你这个。"
                },
                {
                    "id": "140220904",
                    "speaker": "派蒙",
                    "text": "这是…一枚胸针？还是「千织屋」的样式。咦？我也有份！"
                },
                {
                    "id": "140220905",
                    "speaker": "千织",
                    "text": "暂时只做了这两枚，想来想去，还是决定先送给你们。",
                    "choices": [
                        {
                            "id": "140220906",
                            "text": "谢谢…",
                            "response": [
                                {
                                    "id": "140220908",
                                    "speaker": "千织",
                                    "text": "这次你们帮了我很大的忙，而且几乎一直陪着我。"
                                },
                                {
                                    "id": "140220909",
                                    "speaker": "千织",
                                    "text": "我有时候觉得，就算是为了不辜负你们的相信，我也不能认输。"
                                },
                                {
                                    "id": "140220910",
                                    "speaker": "派蒙",
                                    "text": "这次更多还是千织自己的功劳啦。"
                                },
                                {
                                    "id": "140220911",
                                    "speaker": "千织",
                                    "text": "这我敢肯定地告诉你，绝对不是。"
                                },
                                {
                                    "id": "140220912",
                                    "speaker": "千织",
                                    "text": "在「梦想」的道路上走了这么久，我已经感受到了…"
                                },
                                {
                                    "id": "140220913",
                                    "speaker": "千织",
                                    "text": "除了自己的信念与坚持之外，最不可或缺的，就是支持你的朋友。"
                                },
                                {
                                    "id": "140220914",
                                    "speaker": "千织",
                                    "text": "一个人能做到的事情非常有限，这次如果不是你们相助，我可能真的会一败涂地。"
                                },
                                {
                                    "id": "140220915",
                                    "speaker": "派蒙",
                                    "text": "也没有那么夸张吧…倒是我很担心千织你在时装秀上说的那些，你就不怕之后没人来买你的衣服吗？"
                                },
                                {
                                    "id": "140220916",
                                    "speaker": "千织",
                                    "text": "或许我的说辞的确有些高傲，但那都是我最真诚的想法。我不会被这个世界牵着走，更别说被任何人牵着走。"
                                },
                                {
                                    "id": "140220917",
                                    "speaker": "千织",
                                    "text": "我有自信，「千织屋」的衣服，一定是最好的那一个。好的东西，人们自然会追随。"
                                },
                                {
                                    "id": "140220918",
                                    "speaker": "派蒙",
                                    "text": "嘿嘿，那我就放心了！"
                                },
                                {
                                    "id": "140220919",
                                    "speaker": "派蒙",
                                    "text": "接下来，我们是不是该去参加庆功宴了呀？"
                                },
                                {
                                    "id": "140220920",
                                    "speaker": "千织",
                                    "text": "嗯，当然。不过在那之前，再让我欣赏一下今晚的夜色吧。"
                                },
                                {
                                    "id": "140220921",
                                    "speaker": "千织",
                                    "text": "我敢肯定，这会是我来枫丹之后，所见过最美的一晚。"
                                }
                            ]
                        },
                        {
                            "id": "140220907",
                            "text": "我会好好保管…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1402218",
            "objective": "",
            "dialogues": [
                {
                    "id": "140221801",
                    "speaker": "Player",
                    "text": "（千织说过要抓紧时间做时装秀的衣服，还是先不去打扰她了吧…）"
                }
            ]
        },
        {
            "id": "1402012",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "140201201",
                    "speaker": "时装周宣传画报",
                    "text": "万众瞩目的「枫丹时装周」隆重开幕！"
                },
                {
                    "id": "140201202",
                    "speaker": "时装周宣传画报",
                    "text": "本届时装周汇聚了众多知名设计师。他们精心雕琢的品牌新作，也将于最后的时装秀上与大家见面。"
                },
                {
                    "id": "140201203",
                    "speaker": "时装周宣传画报",
                    "text": "就让这时尚之光，点亮这座艺术之都吧！"
                }
            ]
        },
        {
            "id": "1402205",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "140220501",
                    "speaker": "Player",
                    "text": "（test）离开"
                }
            ]
        },
        {
            "id": "1402213",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "140221301",
                    "speaker": "桌上散落的笔记",
                    "text": "旅行计划——"
                },
                {
                    "id": "140221302",
                    "speaker": "桌上散落的笔记",
                    "text": "听说纳塔的人们穿着新潮，有时间去看看…"
                },
                {
                    "id": "140221303",
                    "speaker": "桌上散落的笔记",
                    "text": "至冬的设计能作为冬装参考…顺路的话…"
                }
            ]
        },
        {
            "id": "1402299",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "140229901",
                    "speaker": "Black Screen",
                    "text": "时装秀结束后，众人回到了「千织屋」…"
                }
            ]
        }
    ]
}