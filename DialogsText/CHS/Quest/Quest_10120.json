    "talks": [
        {
            "id": "1012001",
            "objective": "与骑士团的琴交谈",
            "dialogues": [
                {
                    "id": "101200101",
                    "speaker": "琴",
                    "text": "荣誉骑士，感谢你在百忙中抽空过来。"
                },
                {
                    "id": "101200102",
                    "speaker": "琴",
                    "text": "长话短说吧，骑士团现在有一件比较特殊的事想要拜托你。",
                    "choices": [
                        {
                            "id": "101200103",
                            "text": "骑士团还是这么繁忙啊。",
                            "response": [
                                {
                                    "id": "101200104",
                                    "speaker": "琴",
                                    "text": "嗯，近日风波不断，无论是我，还是所有留驻蒙德的骑士团成员，都不敢有片刻懈怠。"
                                },
                                {
                                    "id": "101200107",
                                    "speaker": "琴",
                                    "text": "最近我收到了很多骑士团成员的汇报，说劳伦斯家族的人，和愚人众往来密切。"
                                },
                                {
                                    "id": "101200108",
                                    "speaker": "派蒙",
                                    "text": "愚人众，又是他们！"
                                },
                                {
                                    "id": "101200109",
                                    "speaker": "派蒙",
                                    "text": "不过这个劳伦斯家族，又是什么人？"
                                },
                                {
                                    "id": "101200110",
                                    "speaker": "琴",
                                    "text": "过去的蒙德，曾有一段被旧贵族统治的昏暗时期。从高塔孤王那里夺回的自由又被套上枷锁，奴隶制大行其道。"
                                },
                                {
                                    "id": "101200111",
                                    "speaker": "琴",
                                    "text": "初代「蒲公英骑士」温妮莎引领了革命，推翻了旧贵族的统治，建立了西风骑士团，蒙德这才拥有了现在这番景象。"
                                },
                                {
                                    "id": "101200112",
                                    "speaker": "琴",
                                    "text": "而当年为蒙德带来苦难的旧贵族，就是劳伦斯家族了。"
                                },
                                {
                                    "id": "101200113",
                                    "speaker": "派蒙",
                                    "text": "啊，我好像听明白了。那现在这帮坏人的后代，又想和愚人众一起做坏事了？"
                                },
                                {
                                    "id": "101200114",
                                    "speaker": "琴",
                                    "text": "目前只是怀疑，还没有什么确切的证据。我请你们来，就是为了调查这件事。",
                                    "choices": [
                                        {
                                            "id": "101200115",
                                            "text": "为什么是我？",
                                            "response": [
                                                {
                                                    "id": "101200117",
                                                    "speaker": "琴",
                                                    "text": "唉，因为在过去，旧贵族和骑士团，一直相互敌对。"
                                                },
                                                {
                                                    "id": "101200118",
                                                    "speaker": "琴",
                                                    "text": "骑士团花了很长时间，想方设法化解双方的矛盾。但贵族的那些后代，依然很敌视骑士团…"
                                                },
                                                {
                                                    "id": "101200119",
                                                    "speaker": "琴",
                                                    "text": "不管我们以什么样的态度和他们接触，都不会有好结果，还经常会引起他们的过度反应。"
                                                },
                                                {
                                                    "id": "101200120",
                                                    "speaker": "琴",
                                                    "text": "虽然可以直接用「调查」的名义上门，但最后如果是冤枉了他们，一定会大大增加他们的不信任感。"
                                                },
                                                {
                                                    "id": "101200121",
                                                    "speaker": "琴",
                                                    "text": "以前的很多努力，就功亏一篑了。"
                                                },
                                                {
                                                    "id": "101200122",
                                                    "speaker": "Player",
                                                    "text": "但我也是「荣誉骑士」…"
                                                },
                                                {
                                                    "id": "101200123",
                                                    "speaker": "琴",
                                                    "text": "你已经是骑士团最适合出面的人选了。"
                                                },
                                                {
                                                    "id": "101200124",
                                                    "speaker": "琴",
                                                    "text": "你大可不必强调这层身份。你从远方旅行到此，并不是这座城的「大多数」，可以从这个角度与那位贵族找到共同的话题。"
                                                },
                                                {
                                                    "id": "101200125",
                                                    "speaker": "琴",
                                                    "text": "和他建立起友善的关系之后，应该就能了解到一些关于愚人众的事了。"
                                                },
                                                {
                                                    "id": "101200126",
                                                    "speaker": "派蒙",
                                                    "text": "不愧是琴团长！考虑得可真周到。"
                                                },
                                                {
                                                    "id": "101200127",
                                                    "speaker": "琴",
                                                    "text": "过奖了，这只是在处理外交问题的时候，积攒下来的一些经验而已。"
                                                },
                                                {
                                                    "id": "101200128",
                                                    "speaker": "琴",
                                                    "text": "那位劳伦斯家族的成员名叫舒伯特，最近他一直在蒙德北边的城墙附近闲逛。"
                                                },
                                                {
                                                    "id": "101200129",
                                                    "speaker": "琴",
                                                    "text": "据说这个人的性格不太好相处，但是如果平心静气和他交流，应该不会有什么问题。",
                                                    "choices": [
                                                        {
                                                            "id": "101200130",
                                                            "text": "交给我吧。",
                                                            "response": [
                                                                {
                                                                    "id": "101200132",
                                                                    "speaker": "琴",
                                                                    "text": "谢谢你们的协助。如果遇到什么困难，我也会尽力提供帮助。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "101200131",
                                                            "text": "但愿一切顺利。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "101200116",
                                            "text": "这是骑士团的分内工作吧。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "101200105",
                            "text": "真有琴团长的风格。",
                            "response": [
                                {
                                    "id": "101200106",
                                    "speaker": "琴",
                                    "text": "如果状况允许，我也想和你多寒暄两句。但蒙德城的安全，还是要放在首位。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "1012002",
            "objective": "在城内寻找旧贵族",
            "dialogues": [
                {
                    "id": "101200201",
                    "speaker": "？？？",
                    "text": "嗯？谁啊？"
                },
                {
                    "id": "101200202",
                    "speaker": "派蒙",
                    "text": "你好，我们是来…"
                },
                {
                    "id": "101200203",
                    "speaker": "？？？",
                    "text": "你好？",
                    "choices": [
                        {
                            "id": "101200204",
                            "text": "你、你好…",
                            "response": [
                                {
                                    "id": "101200205",
                                    "speaker": "？？？",
                                    "text": "你好？我没听错吧？"
                                },
                                {
                                    "id": "101200208",
                                    "speaker": "？？？",
                                    "text": "哼，粗鲁又轻浮，竟然随随便便就走上来打招呼。"
                                },
                                {
                                    "id": "101200209",
                                    "speaker": "舒伯特",
                                    "text": "果然是无知的外来者，连我都不认识。我可是舒伯特·劳伦斯，货真价实的贵族后裔。"
                                },
                                {
                                    "id": "101200210",
                                    "speaker": "舒伯特",
                                    "text": "想跟我打招呼，要好好注意你的遣词造句，这样随意又懒散的言语简直不堪入耳。"
                                },
                                {
                                    "id": "101200211",
                                    "speaker": "舒伯特",
                                    "text": "若是听懂了我的话，你现在就该单膝跪地，谦卑地呈上自我介绍与歉意，这才是符合标准的礼仪！"
                                },
                                {
                                    "id": "101200212",
                                    "speaker": "派蒙",
                                    "text": "欸？这么复杂的礼仪，完全没有听说过？！"
                                },
                                {
                                    "id": "101200213",
                                    "speaker": "舒伯特",
                                    "text": "哼，在那个大家都尊礼重道的时代，这种基础礼仪，可是面见贵族的常识！"
                                },
                                {
                                    "id": "101200214",
                                    "speaker": "舒伯特",
                                    "text": "若在礼仪上怠慢了贵族，至少都是一顿鞭刑。"
                                },
                                {
                                    "id": "101200215",
                                    "speaker": "舒伯特",
                                    "text": "再看看如今的世道，规矩废了，礼仪也忘了，腐坏到不堪入目。",
                                    "choices": [
                                        {
                                            "id": "101200216",
                                            "text": "太麻烦了。",
                                            "response": [
                                                {
                                                    "id": "101200218",
                                                    "speaker": "舒伯特",
                                                    "text": "你说什么？你这是在质疑旧贵族的尊严？"
                                                },
                                                {
                                                    "id": "101200219",
                                                    "speaker": "舒伯特",
                                                    "text": "我告诉你，虽然劳伦斯家族现在落没了，但我等后裔，一直都在寻找重获荣光的机会。"
                                                },
                                                {
                                                    "id": "101200220",
                                                    "speaker": "舒伯特",
                                                    "text": "周围的人越是散漫，我就越要坚持贵族的优雅与礼貌。毕竟，我们从生下来开始就是全然不同的。"
                                                },
                                                {
                                                    "id": "101200221",
                                                    "speaker": "Player",
                                                    "text": "我还什么都没说呢…"
                                                },
                                                {
                                                    "id": "101200222",
                                                    "speaker": "舒伯特",
                                                    "text": "别说了，你的言行举止让我厌烦，我与你这样的平民子弟无话可讲。"
                                                },
                                                {
                                                    "id": "101200223",
                                                    "speaker": "舒伯特",
                                                    "text": "而且，我也没有义务指点你应该怎么讲礼貌。"
                                                },
                                                {
                                                    "id": "101200224",
                                                    "speaker": "舒伯特",
                                                    "text": "我还有很重要的事，先走了。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "101200217",
                                            "text": "怪不得旧贵族落没了。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "101200206",
                            "text": "怎么了吗？",
                            "response": [
                                {
                                    "id": "101200207",
                                    "speaker": "？？？",
                                    "text": "怎么了吗？我没听错吧？"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "1012003",
            "objective": "与城墙边的人交谈",
            "dialogues": []
        },
        {
            "id": "1012004",
            "objective": "回骑士团商讨对策",
            "dialogues": [
                {
                    "id": "101200401",
                    "speaker": "？？？",
                    "text": "你们下手可真快，他们都是我追踪了很长时间的目标。"
                },
                {
                    "id": "101200402",
                    "speaker": "？？？",
                    "text": "这下子功劳都归你们了，这就是「先下手为强」吗？…可恶，这个仇，我记下了！"
                },
                {
                    "id": "101200403",
                    "speaker": "派蒙",
                    "text": "…嗯？"
                },
                {
                    "id": "101200404",
                    "speaker": "Player",
                    "text": "等等，记仇？"
                },
                {
                    "id": "101200405",
                    "speaker": "？？？",
                    "text": "是啊，我听到这边有很大的动静，连忙赶过来，发现你正在和愚人众战斗，还占据了上风。"
                },
                {
                    "id": "101200406",
                    "speaker": "？？？",
                    "text": "如果我还不出手，别说是功劳，就连光都沾不上了。"
                },
                {
                    "id": "101200407",
                    "speaker": "？？？",
                    "text": "不过，幸好你没有受伤，和这么多愚人众交战，可是很危险的。",
                    "choices": [
                        {
                            "id": "101200408",
                            "text": "我习惯和愚人众战斗了。",
                            "response": [
                                {
                                    "id": "101200410",
                                    "speaker": "派蒙",
                                    "text": "虽然没怎么听懂，但你是在关心我们的安危吧，谢谢你。"
                                },
                                {
                                    "id": "101200411",
                                    "speaker": "？？？",
                                    "text": "啊？为什么我要关心仇人的安危？"
                                },
                                {
                                    "id": "101200412",
                                    "speaker": "派蒙",
                                    "text": "可是你刚刚说，「幸好你没有受伤」…"
                                },
                                {
                                    "id": "101200413",
                                    "speaker": "？？？",
                                    "text": "哦，我的意思是，如果你们有人受伤了，我不光是被抢了功劳，还要负责把你们带回蒙德城——"
                                },
                                {
                                    "id": "101200414",
                                    "speaker": "？？？",
                                    "text": "那你们就又给我添了一笔麻烦！这个仇就更是结下了！"
                                },
                                {
                                    "id": "101200415",
                                    "speaker": "派蒙",
                                    "text": "居然是这种解读方式吗？！"
                                },
                                {
                                    "id": "101200416",
                                    "speaker": "Player",
                                    "text": "你该不会就是优菈吧？"
                                },
                                {
                                    "id": "101200417",
                                    "speaker": "优菈",
                                    "text": "对啊，没错。"
                                },
                                {
                                    "id": "101200418",
                                    "speaker": "派蒙",
                                    "text": "果然，我就觉得她怪怪的！虽然，也没有怪到无法交流的程度…"
                                },
                                {
                                    "id": "101200419",
                                    "speaker": "优菈",
                                    "text": "上来就点评陌生人「怪怪的」，不说贵族礼仪，在普通人之间也是很不礼貌的吧？"
                                },
                                {
                                    "id": "101200420",
                                    "speaker": "优菈",
                                    "text": "说起来，为什么你们知道我的名字？"
                                },
                                {
                                    "id": "101200421",
                                    "speaker": "派蒙",
                                    "text": "#就是你说的礼仪问题啦。{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}是西风骑士团的荣誉骑士，我们正想调查一位名叫舒伯特·劳伦斯的贵族。"
                                },
                                {
                                    "id": "101200422",
                                    "speaker": "派蒙",
                                    "text": "可是他非常讲究礼仪，完全不愿意和我们说话。"
                                },
                                {
                                    "id": "101200423",
                                    "speaker": "优菈",
                                    "text": "哈哈哈，我明白了，他是我的叔父，就是这样的人。"
                                },
                                {
                                    "id": "101200424",
                                    "speaker": "优菈",
                                    "text": "不过，为什么要调查他呢？"
                                },
                                {
                                    "id": "101200425",
                                    "speaker": "Player",
                                    "text": "他好像和愚人众有些密谋。"
                                },
                                {
                                    "id": "101200426",
                                    "speaker": "优菈",
                                    "text": "原来如此，哈哈，真是好胆量，当着我的面，说我家里人的坏话。这个仇，又值得记一笔了。"
                                },
                                {
                                    "id": "101200427",
                                    "speaker": "派蒙",
                                    "text": "不是啦，这个是琴团长的委托！而且只是怀疑而已！",
                                    "choices": [
                                        {
                                            "id": "101200428",
                                            "text": "你不好奇吗？",
                                            "response": [
                                                {
                                                    "id": "101200430",
                                                    "speaker": "优菈",
                                                    "text": "在蒙德城的市民眼里，劳伦斯家族都是坏人嘛，所以因为流言蜚语招致怀疑什么的，一点都不奇怪。"
                                                },
                                                {
                                                    "id": "101200431",
                                                    "speaker": "派蒙",
                                                    "text": "嗯，有道理，毕竟以前是残暴的统治者，名声很不好嘛。"
                                                },
                                                {
                                                    "id": "101200432",
                                                    "speaker": "优菈",
                                                    "text": "原来你也是这么想的…那我们这个仇，是彻底结下了。"
                                                },
                                                {
                                                    "id": "101200433",
                                                    "speaker": "派蒙",
                                                    "text": "明明是你自己先说的？！"
                                                },
                                                {
                                                    "id": "101200434",
                                                    "speaker": "优菈",
                                                    "text": "哈哈哈，有意思，有意思，第一次见面就能让我记三次仇，我好久都没有遇到这么有意思的人了。",
                                                    "choices": [
                                                        {
                                                            "id": "101200435",
                                                            "text": "原来这是「有意思」的事吗？",
                                                            "response": [
                                                                {
                                                                    "id": "101200437",
                                                                    "speaker": "优菈",
                                                                    "text": "你们来找我，是为了学习劳伦斯家的礼仪，这样才能和我的叔父搭话对吧？"
                                                                },
                                                                {
                                                                    "id": "101200438",
                                                                    "speaker": "派蒙",
                                                                    "text": "嗯，是安柏介绍我们来找你的。"
                                                                },
                                                                {
                                                                    "id": "101200439",
                                                                    "speaker": "优菈",
                                                                    "text": "没问题，现在我就可以教你们。总之先回蒙德城吧，有人的地方比较方便训练。",
                                                                    "choices": [
                                                                        {
                                                                            "id": "101200440",
                                                                            "text": "但你不是很记仇吗？",
                                                                            "response": [
                                                                                {
                                                                                    "id": "101200442",
                                                                                    "speaker": "优菈",
                                                                                    "text": "两码事，两码事。既是代理团长的委托，又是安柏的推荐，我不能不给面子啊。"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "101200441",
                                                                            "text": "你不会是想趁机复仇吧？"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "101200436",
                                                            "text": "为什么你看起来很开心…"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "101200429",
                                            "text": "你不担心吗？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "101200409",
                            "text": "我可是很能打的。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1012005",
            "objective": "与安柏交谈",
            "dialogues": [
                {
                    "id": "101200301",
                    "speaker": "安柏",
                    "text": "这不是「荣誉骑士」嘛！我刚刚打算去侦察，没想到会在这里碰到你！"
                },
                {
                    "id": "101200302",
                    "speaker": "安柏",
                    "text": "欸？看你的表情，遇上什么不开心的事了吗？"
                },
                {
                    "id": "101200303",
                    "speaker": "派蒙",
                    "text": "琴团长委托我们去办事，结果…好像有点搞砸了。",
                    "choices": [
                        {
                            "id": "101200304",
                            "text": "说来话长。",
                            "response": [
                                {
                                    "id": "101200306",
                                    "speaker": "安柏",
                                    "text": "不要灰心啦，失败是常有的事。我也不能保证每次都找到有用的情报。"
                                },
                                {
                                    "id": "101200307",
                                    "speaker": "安柏",
                                    "text": "所以，打起精神来嘛！",
                                    "choices": [
                                        {
                                            "id": "101200308",
                                            "text": "谢谢你。",
                                            "response": [
                                                {
                                                    "id": "101200310",
                                                    "speaker": "安柏",
                                                    "text": "嘿嘿。对了，这样吧，我来帮你想想办法，你们到底遇到什么事了？"
                                                },
                                                {
                                                    "id": "101200311",
                                                    "speaker": "派蒙",
                                                    "text": "琴团长让我们去和一个人搞好关系，他名叫舒伯特·劳伦斯。"
                                                },
                                                {
                                                    "id": "101200312",
                                                    "speaker": "派蒙",
                                                    "text": "但我们见到他才发现，他的性格很古怪，根本不好好听人说话…"
                                                },
                                                {
                                                    "id": "101200313",
                                                    "speaker": "安柏",
                                                    "text": "哦哦，我知道这个人！他一定说你们不懂礼貌吧。",
                                                    "choices": [
                                                        {
                                                            "id": "101200314",
                                                            "text": "看来你也有所耳闻。",
                                                            "response": [
                                                                {
                                                                    "id": "101200316",
                                                                    "speaker": "安柏",
                                                                    "text": "哈哈，我也被指点过好几次，劳伦斯家里的人都有些奇奇怪怪的讲究。"
                                                                },
                                                                {
                                                                    "id": "101200317",
                                                                    "speaker": "派蒙",
                                                                    "text": "欸？所有人都是这样吗？"
                                                                },
                                                                {
                                                                    "id": "101200318",
                                                                    "speaker": "安柏",
                                                                    "text": "他们觉得贵族就要有贵族的矜持嘛，在我看来…唔，能够理解，但总觉得他们不像是这个时代的人。"
                                                                },
                                                                {
                                                                    "id": "101200319",
                                                                    "speaker": "安柏",
                                                                    "text": "不过，在他们家里有个很特殊的例子，就是我的好伙伴，优菈！"
                                                                },
                                                                {
                                                                    "id": "101200320",
                                                                    "speaker": "派蒙",
                                                                    "text": "伙、伙伴？"
                                                                },
                                                                {
                                                                    "id": "101200321",
                                                                    "speaker": "安柏",
                                                                    "text": "是的，她是劳伦斯家族的人，但同时也是骑士团第四小队的队长。",
                                                                    "choices": [
                                                                        {
                                                                            "id": "101200322",
                                                                            "text": "琴团长说，劳伦斯把骑士团当敌人。",
                                                                            "response": [
                                                                                {
                                                                                    "id": "101200324",
                                                                                    "speaker": "安柏",
                                                                                    "text": "因为优菈是个特别的人嘛，她和家族的其他人都不同，有自己的想法和行动方式。"
                                                                                },
                                                                                {
                                                                                    "id": "101200325",
                                                                                    "speaker": "安柏",
                                                                                    "text": "换句话说，就是她没怎么把家里的条条框框放在心上。"
                                                                                },
                                                                                {
                                                                                    "id": "101200326",
                                                                                    "speaker": "安柏",
                                                                                    "text": "啊，不过如何跟劳伦斯家的人打交道，她还是很清楚的。你们只要见她一面，就明白我的意思啦。"
                                                                                },
                                                                                {
                                                                                    "id": "101200327",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "我有点好奇，既然优菈是劳伦斯家的人，为什么琴团长会找我们，而不是直接找这个优菈？"
                                                                                },
                                                                                {
                                                                                    "id": "101200328",
                                                                                    "speaker": "安柏",
                                                                                    "text": "这个嘛，就有点一言难尽了。简单来说，因为优菈加入了骑士团，所以她家里的其他人都不太喜欢她…"
                                                                                },
                                                                                {
                                                                                    "id": "101200329",
                                                                                    "speaker": "安柏",
                                                                                    "text": "在他们的眼里，优菈就像是投敌的叛徒。",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "101200330",
                                                                                            "text": "确实挺有个性的。",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "101200332",
                                                                                                    "speaker": "安柏",
                                                                                                    "text": "嘿嘿，但她其实很容易相处，你们只要能把困扰告诉她，她肯定能教会你们怎么和舒伯特打交道的。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "101200333",
                                                                                                    "speaker": "安柏",
                                                                                                    "text": "她早上好像去野外巡逻了，你们应该能在望风山地附近找到她。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "101200334",
                                                                                                    "speaker": "派蒙",
                                                                                                    "text": "嗯嗯，谢谢你，安柏，那我们就去找她了！"
                                                                                                },
                                                                                                {
                                                                                                    "id": "101200335",
                                                                                                    "speaker": "安柏",
                                                                                                    "text": "祝你们一切顺利！我也要出发去侦察了！"
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "101200331",
                                                                                            "text": "也不是不能理解…"
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "101200323",
                                                                            "text": "劳伦斯家的人可以加入骑士团？"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "101200315",
                                                            "text": "看来你也深受其害。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "101200309",
                                            "text": "很有安柏的作风。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "101200305",
                            "text": "不是我们的错。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1012006",
            "objective": "前往望风山地寻找优菈",
            "dialogues": [
                {
                    "id": "101200601",
                    "speaker": "琴",
                    "text": "舒伯特这个人有些情绪化，不太容易相处。"
                },
                {
                    "id": "101200602",
                    "speaker": "琴",
                    "text": "不过只要能平心静气，应该可以建立起友善的关系。"
                }
            ]
        },
        {
            "id": "1012007",
            "objective": "击败附近的愚人众",
            "dialogues": [
                {
                    "id": "101200701",
                    "speaker": "Player",
                    "text": "关于舒伯特…"
                },
                {
                    "id": "101200702",
                    "speaker": "赫塔",
                    "text": "你说的是那位古怪的旧贵族吧，不好意思，我没有见到他。"
                },
                {
                    "id": "101200703",
                    "speaker": "赫塔",
                    "text": "劳伦斯家族的人，很多都不愿意主动出现在西风骑士的面前。"
                },
                {
                    "id": "101200704",
                    "speaker": "赫塔",
                    "text": "这样也好，影响了军需品的调配，反倒是麻烦事。"
                },
                {
                    "id": "101200705",
                    "speaker": "赫塔",
                    "text": "你们去上面看看吧，说不定能找到他。"
                }
            ]
        },
        {
            "id": "1012008",
            "objective": "目睹少女击败最后的愚人众",
            "dialogues": [
                {
                    "id": "101200801",
                    "speaker": "派蒙",
                    "text": "你好，你在附近见过一位叫舒伯特的贵族吗？"
                },
                {
                    "id": "101200802",
                    "speaker": "米歇尔",
                    "text": "嗯…这个名字我没什么印象，不过最近这里总是有个古怪的人逛来逛去。"
                },
                {
                    "id": "101200803",
                    "speaker": "米歇尔",
                    "text": "到处看看，有时候还在写写画画，不知道想干什么…"
                },
                {
                    "id": "101200804",
                    "speaker": "米歇尔",
                    "text": "如果他就是你们要找的人的话，你们往城墙那边走就能遇到他了。"
                }
            ]
        },
        {
            "id": "1012009",
            "objective": "与优菈交谈",
            "dialogues": []
        },
        {
            "id": "1012011",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "101201101",
                    "speaker": "安柏",
                    "text": "你们去望风山地，应该就能找到优菈了！"
                },
                {
                    "id": "101201102",
                    "speaker": "安柏",
                    "text": "她是我的好伙伴，一定会帮助你们的。"
                }
            ]
        },
        {
            "id": "1012099",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "101209901",
                    "speaker": "派蒙",
                    "text": "这样的人，在琴团长看来，只是「不太好相处」吗？"
                },
                {
                    "id": "101209902",
                    "speaker": "派蒙",
                    "text": "唉，我们还是回去找她再商量一下吧。"
                },
                {
                    "id": "101209903",
                    "speaker": "派蒙",
                    "text": "没想到骑士团还有这样一个人…"
                },
                {
                    "id": "101209904",
                    "speaker": "派蒙",
                    "text": "要学习劳伦斯家的礼仪，找劳伦斯家的人来学，肯定是最快的吧！"
                },
                {
                    "id": "101209905",
                    "speaker": "派蒙",
                    "text": "啊，这里居然有愚人众？难道优菈是为了他们才来的？"
                },
                {
                    "id": "101209906",
                    "speaker": "派蒙",
                    "text": "#不管怎么样，先迎战吧，{NICKNAME}！"
                }
            ]
        }
    ]
}