    "talks": [
        {
            "id": "7280101",
            "objective": "与小绿对话",
            "dialogues": [
                {
                    "id": "728010101",
                    "speaker": "小绿",
                    "text": "唔…都没什么新故事可以给宏一讲了…"
                },
                {
                    "id": "728010102",
                    "speaker": "Player",
                    "text": "什么新故事？"
                },
                {
                    "id": "728010103",
                    "speaker": "小绿",
                    "text": "是一位叫拉姆齐的叔叔，给我说的新故事啦。"
                },
                {
                    "id": "728010104",
                    "speaker": "小绿",
                    "text": "那个叔叔说，他去过很多国家，见识过很多新奇的东西，为了记录这些东西，他还专门写了一种叫做「游记」的东西…"
                },
                {
                    "id": "728010105",
                    "speaker": "小绿",
                    "text": "他还给我看过不少「游记」呢！"
                },
                {
                    "id": "728010106",
                    "speaker": "小绿",
                    "text": "比如，枫丹有一种飞在天上，沿着看不见的道路前进的铁马车，从村子一头到另一头，一瞬间就到了。"
                },
                {
                    "id": "728010107",
                    "speaker": "小绿",
                    "text": "须弥还有一种可以种在任何地方的草，无论是土里，水里还是沙子里，只要种下了，这种草都能发芽长大。"
                },
                {
                    "id": "728010108",
                    "speaker": "小绿",
                    "text": "还有…还有…枫丹那边还有一种能够在海底呆很久很久的…呃…船！"
                },
                {
                    "id": "728010109",
                    "speaker": "小绿",
                    "text": "搭着那种船，可以去很深的海底做各种事，看各种鱼！",
                    "choices": [
                        {
                            "id": "728010110",
                            "text": "真的假的…",
                            "response": [
                                {
                                    "id": "728010111",
                                    "speaker": "小绿",
                                    "text": "反、反正拉姆齐叔叔是这么讲给我听的…"
                                },
                                {
                                    "id": "728010114",
                                    "speaker": "小绿",
                                    "text": "唔，这不是重点啦！"
                                },
                                {
                                    "id": "728010115",
                                    "speaker": "小绿",
                                    "text": "最近拉姆齐叔叔不知道怎么了，已经很久没有把他的「游记」寄给我看了，我也没有故事可以讲给宏一听了。"
                                },
                                {
                                    "id": "728010116",
                                    "speaker": "小绿",
                                    "text": "我知道拉姆齐叔叔一直待在木漏茶室里，就想直接去找他。但看门的梢姐姐不许我这种小孩子进去…"
                                },
                                {
                                    "id": "728010117",
                                    "speaker": "小绿",
                                    "text": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，你、你看着就很成熟，能帮我去里面问问拉姆齐叔叔，那些「游记」怎么样了吗？"
                                },
                                {
                                    "id": "728010118",
                                    "speaker": "Player",
                                    "text": "咳，一般成熟…"
                                },
                                {
                                    "id": "728010119",
                                    "speaker": "小绿",
                                    "text": "#总之！{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}看着就很可靠啦，这件事就拜托你了！"
                                },
                                {
                                    "id": "728010120",
                                    "speaker": "Player",
                                    "text": "我会先看看的。"
                                },
                                {
                                    "id": "728010121",
                                    "speaker": "小绿",
                                    "text": "咦？你也想看那些「游记」吗？没问题啦，你看了之后记得带给我就好。"
                                },
                                {
                                    "id": "728010122",
                                    "speaker": "小绿",
                                    "text": "我…我和你一起过去吧，虽然进不去…但我可以在茶室附近等你…"
                                },
                                {
                                    "id": "728010123",
                                    "speaker": "小绿",
                                    "text": "唉，真想快点看到拉姆齐叔叔写的新「游记」…"
                                }
                            ]
                        },
                        {
                            "id": "728010112",
                            "text": "他没和你说过至冬国？",
                            "response": [
                                {
                                    "id": "728010113",
                                    "speaker": "小绿",
                                    "text": "至冬？嗯…那他倒是没怎么说过。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7280102",
            "objective": "与梢对话",
            "dialogues": [
                {
                    "id": "728010201",
                    "speaker": "梢",
                    "text": "这位客人，今日光临「木漏茶室」有何贵干？"
                },
                {
                    "id": "728010202",
                    "speaker": "Player",
                    "text": "关于拉姆齐…"
                },
                {
                    "id": "728010203",
                    "speaker": "梢",
                    "text": "那位商人啊…他确实在茶室里，不过，最近他似乎看上去有些紧张，不知道遇见了什么事…"
                },
                {
                    "id": "728010204",
                    "speaker": "梢",
                    "text": "你要是想找他的话，往里面走一走就能看见他了。"
                }
            ]
        },
        {
            "id": "7280103",
            "objective": "与茶室内的拉姆齐对话",
            "dialogues": [
                {
                    "id": "728010301",
                    "speaker": "拉姆齐",
                    "text": "你是…旅行者？找我有什么事吗？"
                },
                {
                    "id": "728010302",
                    "speaker": "Player",
                    "text": "关于「游记」…"
                },
                {
                    "id": "728010303",
                    "speaker": "拉姆齐",
                    "text": "噢，你是说我写给小绿那孩子的「游记」吧。"
                },
                {
                    "id": "728010304",
                    "speaker": "拉姆齐",
                    "text": "这真是…我最近实在没空写了，估计那孩子肯定等急了…"
                },
                {
                    "id": "728010305",
                    "speaker": "Player",
                    "text": "那些「游记」是真的吗？"
                },
                {
                    "id": "728010306",
                    "speaker": "拉姆齐",
                    "text": "哈哈哈，你觉得呢？",
                    "choices": [
                        {
                            "id": "728010307",
                            "text": "不太像真的…",
                            "response": [
                                {
                                    "id": "728010308",
                                    "speaker": "拉姆齐",
                                    "text": "哈哈哈，不愧是四处旅行过的人，一看就明白了。"
                                },
                                {
                                    "id": "728010311",
                                    "speaker": "拉姆齐",
                                    "text": "没错，严肃地来说，这些「游记」都不是真的。"
                                },
                                {
                                    "id": "728010312",
                                    "speaker": "拉姆齐",
                                    "text": "虽然有些地点和人物确实是取材于现实…但大部分的内容，都是出自于我个人的想象。"
                                },
                                {
                                    "id": "728010313",
                                    "speaker": "拉姆齐",
                                    "text": "当然啦，有些内容也不完全是想象。比如我正在写的一篇「游记」里，一个人制作了一个超级气球。"
                                },
                                {
                                    "id": "728010314",
                                    "speaker": "拉姆齐",
                                    "text": "然后他召集了几位同伴，想要用这个气球在八十天内环游提瓦特大陆一圈。"
                                },
                                {
                                    "id": "728010315",
                                    "speaker": "拉姆齐",
                                    "text": "而且，操作这个气球完全不需要「神之眼」，只需要有技术常识就行。"
                                },
                                {
                                    "id": "728010316",
                                    "speaker": "拉姆齐",
                                    "text": "这群人搭着气球环游着世界，一路上遇见了无数奇怪的事物和现象…"
                                },
                                {
                                    "id": "728010317",
                                    "speaker": "拉姆齐",
                                    "text": "这篇本来就是我准备写给小绿的，但因为…某些原因，我到现在连一小段都没机会写完。"
                                },
                                {
                                    "id": "728010318",
                                    "speaker": "Player",
                                    "text": "什么原因？"
                                },
                                {
                                    "id": "728010319",
                                    "speaker": "拉姆齐",
                                    "text": "你看见走廊上那个家伙了吗？他叫平八，不知道从什么时候起，那家伙就一直盯着我。"
                                },
                                {
                                    "id": "728010320",
                                    "speaker": "拉姆齐",
                                    "text": "我本来想出去采风，给那篇「游记」取取材，但那家伙每次都跟着我，不知道想做什么。"
                                },
                                {
                                    "id": "728010321",
                                    "speaker": "拉姆齐",
                                    "text": "因为担心这家伙对我图谋不轨，我也就不敢出去采风了，这篇「游记」也就搁置了下来…"
                                },
                                {
                                    "id": "728010322",
                                    "speaker": "拉姆齐",
                                    "text": "但还好现在你来了，旅行者，你能陪我出去采采风吗？有你陪着，谅那家伙也不敢对我做什么。",
                                    "choices": [
                                        {
                                            "id": "728010323",
                                            "text": "交给我吧。",
                                            "response": [
                                                {
                                                    "id": "728010324",
                                                    "speaker": "拉姆齐",
                                                    "text": "那就拜托你了。"
                                                },
                                                {
                                                    "id": "728010327",
                                                    "speaker": "拉姆齐",
                                                    "text": "而且俗话讲「防人之心不可无」，有这么一位在后面盯着我，无论他打着什么主意，我多少也得防着点。"
                                                },
                                                {
                                                    "id": "728010328",
                                                    "speaker": "拉姆齐",
                                                    "text": "所以，在我采风的时候，护卫我的事就拜托你了，旅行者。"
                                                },
                                                {
                                                    "id": "728010329",
                                                    "speaker": "拉姆齐",
                                                    "text": "我之前其实已经定好了几处采风的地点，我们直接过去就好。"
                                                },
                                                {
                                                    "id": "728010330",
                                                    "speaker": "拉姆齐",
                                                    "text": "第一个地点是附近的海滩，我们现在就出发吧。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "728010325",
                                            "text": "他为什么要这么做？",
                                            "response": [
                                                {
                                                    "id": "728010326",
                                                    "speaker": "拉姆齐",
                                                    "text": "我不知道。但是…对某个人产生恶意，可不需要什么太充分的理由。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "728010309",
                            "text": "我希望是真的。",
                            "response": [
                                {
                                    "id": "728010310",
                                    "speaker": "拉姆齐",
                                    "text": "哈哈哈，我也希望我写的这些东西能够成真。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7280105",
            "objective": "前往附近的海滩",
            "dialogues": [
                {
                    "id": "728010501",
                    "speaker": "拉姆齐",
                    "text": "这片海滩的水质格外清澈，细砂的颜色也很白净，与狂躁的外海截然不同。"
                },
                {
                    "id": "728010502",
                    "speaker": "拉姆齐",
                    "text": "从这里出海…起飞的话，应该还挺有氛围的…"
                },
                {
                    "id": "728010503",
                    "speaker": "拉姆齐",
                    "text": "咳，这里的景致很不错，我得记录一下。"
                },
                {
                    "id": "728010504",
                    "speaker": "拉姆齐",
                    "text": "旅行者，请稍等片刻，我需要思考一下游记的写法，你们可以在附近走走，欣赏海滩的风光。"
                },
                {
                    "id": "728010505",
                    "speaker": "拉姆齐",
                    "text": "…但是，请别离我太远，那个叫平八的家伙已经跟出来了，就在旁边。"
                }
            ]
        },
        {
            "id": "7280106",
            "objective": "在海滩上四处走走",
            "dialogues": [
                {
                    "id": "728010601",
                    "speaker": "拉姆齐",
                    "text": "这片海滩的水质格外清澈，细砂的颜色也很白净，与狂躁的外海截然不同。"
                },
                {
                    "id": "728010602",
                    "speaker": "拉姆齐",
                    "text": "从这里出海的话，应该会十分顺利…"
                }
            ]
        },
        {
            "id": "7280107",
            "objective": "在海滩上四处走走",
            "dialogues": []
        },
        {
            "id": "7280108",
            "objective": "在海滩上四处走走",
            "dialogues": [
                {
                    "id": "728010801",
                    "speaker": "平八",
                    "text": "杵在我面前干什么？找茬啊？"
                },
                {
                    "id": "728010802",
                    "speaker": "Player",
                    "text": "你跟着做什么？"
                },
                {
                    "id": "728010803",
                    "speaker": "平八",
                    "text": "跟着？什么跟着，我在这遛弯！怎么，这片沙滩你家开的？你谁啊，管天管地…"
                }
            ]
        },
        {
            "id": "7280109",
            "objective": "与拉姆齐对话",
            "dialogues": [
                {
                    "id": "728010901",
                    "speaker": "拉姆齐",
                    "text": "不错！这里的景致果然不错…"
                },
                {
                    "id": "728010902",
                    "speaker": "拉姆齐",
                    "text": "然后是…我看看啊，城北的郊外有一个河湾，那里的小瀑布很有特色，我们就去那里好了。"
                }
            ]
        },
        {
            "id": "7280110",
            "objective": "前往城北的瀑布",
            "dialogues": [
                {
                    "id": "728011001",
                    "speaker": "拉姆齐",
                    "text": "这里怎么会有这么多丘丘人"
                },
                {
                    "id": "728011002",
                    "speaker": "派蒙",
                    "text": "远处还有新的敌人"
                },
                {
                    "id": "728011003",
                    "speaker": "拉姆齐",
                    "text": "我们快点离开吧"
                },
                {
                    "id": "728011004",
                    "speaker": "拉姆齐",
                    "text": "这次我想去高一点的地方看看"
                },
                {
                    "id": "728011005",
                    "speaker": "拉姆齐",
                    "text": "嗯……就那边的小山上吧"
                },
                {
                    "id": "728011006",
                    "speaker": "拉姆齐",
                    "text": "这次我想去高一点的地方看看"
                }
            ]
        },
        {
            "id": "7280116",
            "objective": "击败魔物",
            "dialogues": [
                {
                    "id": "728011601",
                    "speaker": "拉姆齐",
                    "text": "请你们先把这几段「游记」带给小绿吧，等我全部写好了之后，我会托人把完整的「游记」带给她的。"
                },
                {
                    "id": "728011602",
                    "speaker": "平八",
                    "text": "哼，这家伙准是有什么目的…只不过，现在还没露出马脚而已。"
                }
            ]
        },
        {
            "id": "7280111",
            "objective": "与拉姆齐对话",
            "dialogues": [
                {
                    "id": "728011103",
                    "speaker": "拉姆齐",
                    "text": "没想到这里居然有魔物活动…虽然这地方景致也还算可以，但实在有些危险…"
                },
                {
                    "id": "728011104",
                    "speaker": "拉姆齐",
                    "text": "但这段遭遇也可以写进「游记」里去，作为一点小小的桥段…"
                },
                {
                    "id": "728011105",
                    "speaker": "拉姆齐",
                    "text": "不过，我们还是先离开这里，去找个安全的地方再说吧。"
                },
                {
                    "id": "728011106",
                    "speaker": "拉姆齐",
                    "text": "那家伙居然还跟着，真是…哼…锲而不舍…"
                }
            ]
        },
        {
            "id": "7280112",
            "objective": "前往安全的地点",
            "dialogues": []
        },
        {
            "id": "7280113",
            "objective": "前往附近的山顶",
            "dialogues": [
                {
                    "id": "728011301",
                    "speaker": "拉姆齐",
                    "text": "果然，站在山顶，就能俯瞰大半个鸣神岛了。"
                },
                {
                    "id": "728011302",
                    "speaker": "拉姆齐",
                    "text": "山顶的风力相当强，高度适合起飞，还没有障碍物干扰。"
                },
                {
                    "id": "728011303",
                    "speaker": "拉姆齐",
                    "text": "而且距离稻妻城比较远，不会被同心…被闲人打扰。"
                },
                {
                    "id": "728011304",
                    "speaker": "Player",
                    "text": "的确是个很棒的地方。"
                },
                {
                    "id": "728011305",
                    "speaker": "拉姆齐",
                    "text": "总之，在这里起飞应该很不错…写进「游记」里肯定也非常不错。"
                },
                {
                    "id": "728011306",
                    "speaker": "拉姆齐",
                    "text": "这家伙…果然还在跟着，真是没完没了"
                },
                {
                    "id": "728011307",
                    "speaker": "Player",
                    "text": "我去把他赶走吧。"
                },
                {
                    "id": "728011308",
                    "speaker": "拉姆齐",
                    "text": "算了，不必和他计较，有你在，他不敢轻举妄动。"
                },
                {
                    "id": "728011309",
                    "speaker": "拉姆齐",
                    "text": "而且对付这种人…假如你真的主动搭理他，他反而会更加纠缠不休。"
                },
                {
                    "id": "728011310",
                    "speaker": "拉姆齐",
                    "text": "总之，这次采风之行就到此为止吧，我们先回木漏茶室去。"
                }
            ]
        },
        {
            "id": "7280114",
            "objective": "返回木漏茶室",
            "dialogues": [
                {
                    "id": "728011401",
                    "speaker": "拉姆齐",
                    "text": "游记的主要内容，我已经有思路了，不过写成完整的篇章，还需要一两天时间。"
                },
                {
                    "id": "728011402",
                    "speaker": "拉姆齐",
                    "text": "我之前写好了几小段，请你们先把这几段带给小绿吧，"
                },
                {
                    "id": "728011403",
                    "speaker": "拉姆齐",
                    "text": "等我全部写好了之后，我会托人把完整的「游记」带给她的。"
                },
                {
                    "id": "728011404",
                    "speaker": "平八",
                    "text": "「游记」…哼，嘴上这么说，指不定有什么目的…"
                },
                {
                    "id": "728011405",
                    "speaker": "Player",
                    "text": "你在说什么？"
                },
                {
                    "id": "728011406",
                    "speaker": "平八",
                    "text": "我说，这个家伙写这些「游记」，是另有目的。"
                },
                {
                    "id": "728011407",
                    "speaker": "平八",
                    "text": "谁没事会想那些乱七八糟的东西，还用热气球环游提瓦特，而且还不用「神之眼」…"
                },
                {
                    "id": "728011408",
                    "speaker": "平八",
                    "text": "哼，这家伙准是有什么目的…只不过，现在还没露出马脚而已。"
                }
            ]
        },
        {
            "id": "7280115",
            "objective": "与小绿对话",
            "dialogues": [
                {
                    "id": "728011501",
                    "speaker": "小绿",
                    "text": "#旅行者{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}，你们拿到「游记」了吗？"
                },
                {
                    "id": "728011502",
                    "speaker": "Player",
                    "text": "这是拉姆齐先生给你的…"
                },
                {
                    "id": "728011503",
                    "speaker": "小绿",
                    "text": "《八十天环游提瓦特》…哇啊！谢谢你！我看看…"
                },
                {
                    "id": "728011504",
                    "speaker": "小绿",
                    "text": "咦，怎么这么薄，之前的几本「游记」都很厚很厚的…"
                },
                {
                    "id": "728011505",
                    "speaker": "Player",
                    "text": "他还没有写完。"
                },
                {
                    "id": "728011506",
                    "speaker": "小绿",
                    "text": "是这样吗…我会等着拉姆齐叔叔写完的，等他写完，我再看完…我就又有故事给宏一讲了。"
                },
                {
                    "id": "728011507",
                    "speaker": "小绿",
                    "text": "#谢谢你，{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，这些东西给你，请你收下吧。"
                }
            ]
        },
        {
            "id": "7280104",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "728010401",
                    "speaker": "平八",
                    "text": "瞅我干啥？"
                },
                {
                    "id": "728010402",
                    "speaker": "平八",
                    "text": "一边去，别来耽误我的事！"
                }
            ]
        },
        {
            "id": "7280112",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "728011203",
                    "speaker": "平八",
                    "text": "这是什么鬼地方，还有魔物，真是…"
                },
                {
                    "id": "728011204",
                    "speaker": "Player",
                    "text": "你跟着做什么？"
                },
                {
                    "id": "728011205",
                    "speaker": "平八",
                    "text": "我…跟着？我来这里摘果子散步，不可以吗？疑神疑鬼的…"
                }
            ]
        },
        {
            "id": "7280199",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "728019903",
                    "speaker": "拉姆齐",
                    "text": "最后一个采风地点是那边的山顶。"
                },
                {
                    "id": "728019904",
                    "speaker": "拉姆齐",
                    "text": "那里的视野很好，应该能将周围的风景尽收眼底。"
                }
            ]
        }
    ]
}