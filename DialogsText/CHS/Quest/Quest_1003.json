    "talks": [
        {
            "id": "100301",
            "objective": "前往望舒客栈",
            "dialogues": [
                {
                    "id": "10030101",
                    "speaker": "派蒙",
                    "text": "啊，这里就是望舒客栈了。"
                }
            ]
        },
        {
            "id": "100320",
            "objective": "（test）靠近望舒客栈开车$HIDDEN",
            "dialogues": []
        },
        {
            "id": "100302",
            "objective": "（test）魈CS$HIDDEN",
            "dialogues": []
        },
        {
            "id": "100303",
            "objective": "与魈对话",
            "dialogues": [
                {
                    "id": "10030301",
                    "speaker": "魈",
                    "text": "…是你们。"
                },
                {
                    "id": "10030302",
                    "speaker": "派蒙",
                    "text": "又见面了！你好呀。"
                },
                {
                    "id": "10030303",
                    "speaker": "魈",
                    "text": "为何还要继续接近仙与魔的世界？你们的逾矩太频繁了。"
                },
                {
                    "id": "10030308",
                    "speaker": "魈",
                    "text": "人的灵魂不如仙人强韧，血液中也难以承载如此浓度的仙家气运。"
                },
                {
                    "id": "10030309",
                    "speaker": "魈",
                    "text": "算是为你们好，抓紧离开吧。"
                },
                {
                    "id": "10030310",
                    "speaker": "派蒙",
                    "text": "等一下，我们是来…"
                },
                {
                    "id": "10030311",
                    "speaker": "派蒙",
                    "text": "啊，好生气。这个人怎么自说自话的。"
                },
                {
                    "id": "10030312",
                    "speaker": "派蒙",
                    "text": "好想给他起个难听的绰号…但要是得罪了仙人，以后发现宝箱的时候，会不会只能开出卷心菜…？"
                },
                {
                    "id": "10030313",
                    "speaker": "派蒙",
                    "text": "唉…我们还是去请教一下客栈的老板娘，问问她怎么和仙人正常交流吧。"
                }
            ]
        },
        {
            "id": "100319",
            "objective": "（test）判断是否完成海灯节$HIDDEN",
            "dialogues": []
        },
        {
            "id": "100304",
            "objective": "向客栈老板娘请教",
            "dialogues": [
                {
                    "id": "10030401",
                    "speaker": "Player",
                    "text": "关于那位仙人…"
                },
                {
                    "id": "10030402",
                    "speaker": "菲尔戈黛特",
                    "text": "哦？你们已经见过魈了？"
                },
                {
                    "id": "10030403",
                    "speaker": "菲尔戈黛特",
                    "text": "不错嘛，难得他心情好，居然愿意出来见人…"
                },
                {
                    "id": "10030404",
                    "speaker": "派蒙",
                    "text": "原来这样的态度就已经是「心情好」了。"
                },
                {
                    "id": "10030405",
                    "speaker": "菲尔戈黛特",
                    "text": "是啊，仙缘难得，许多人一心访仙，却终生未见仙人一面呢。"
                },
                {
                    "id": "10030406",
                    "speaker": "菲尔戈黛特",
                    "text": "岩神建立璃月时，借助了仙人的力量。"
                },
                {
                    "id": "10030407",
                    "speaker": "菲尔戈黛特",
                    "text": "但因为仙人中的大多数，都只懂得以战斗来守护璃月…"
                },
                {
                    "id": "10030408",
                    "speaker": "菲尔戈黛特",
                    "text": "所以数千年来，终究还是人类掌握了贸易之都的运作，而仙人隐居在外。"
                },
                {
                    "id": "10030409",
                    "speaker": "派蒙",
                    "text": "老板娘懂得真多啊。"
                },
                {
                    "id": "10030410",
                    "speaker": "菲尔戈黛特",
                    "text": "不是「老板娘」，是「老板」——"
                },
                {
                    "id": "10030411",
                    "speaker": "菲尔戈黛特",
                    "text": "总之，既然你们这么有仙缘，那事情就好办多了。"
                },
                {
                    "id": "10030412",
                    "speaker": "菲尔戈黛特",
                    "text": "要问我的建议嘛…嗯，其实只要试着去哄魈开心就好啦。"
                },
                {
                    "id": "10030413",
                    "speaker": "派蒙",
                    "text": "开心…？那位「护法夜叉」大人，很难想象他开心起来是什么样子的…"
                },
                {
                    "id": "10030414",
                    "speaker": "菲尔戈黛特",
                    "text": "哼哼，很期待吧？"
                },
                {
                    "id": "10030415",
                    "speaker": "菲尔戈黛特",
                    "text": "（其实我也从没见他笑过…）"
                },
                {
                    "id": "10030416",
                    "speaker": "菲尔戈黛特",
                    "text": "这样吧，先去找大厨要一份杏仁豆腐，再加上一道你拿手的菜。"
                },
                {
                    "id": "10030417",
                    "speaker": "菲尔戈黛特",
                    "text": "杏仁豆腐是魈难得喜欢的人间食物，拿手的菜就靠你自由发挥了。"
                },
                {
                    "id": "10030418",
                    "speaker": "派蒙",
                    "text": "#唔，自由发挥…{NICKNAME}，你最擅长做什么菜呢？",
                    "choices": [
                        {
                            "id": "10030419",
                            "text": "「满足沙拉」吧。",
                            "response": [
                                {
                                    "id": "10030420",
                                    "speaker": "派蒙",
                                    "text": "是那种很难出错的食物呢。"
                                },
                                {
                                    "id": "10030423",
                                    "speaker": "派蒙",
                                    "text": "不过，送给仙人的礼物还是保守一点，就用「满足沙拉」好了…"
                                }
                            ]
                        },
                        {
                            "id": "10030421",
                            "text": "「大红莲麻辣火史莱姆」吧。",
                            "response": [
                                {
                                    "id": "10030422",
                                    "speaker": "派蒙",
                                    "text": "哇，听起来很新奇，想吃吃看！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "100305",
            "objective": "制作一份「美味的满足沙拉」",
            "dialogues": []
        },
        {
            "id": "100306",
            "objective": "与大厨对话",
            "dialogues": [
                {
                    "id": "10030601",
                    "speaker": "言笑",
                    "text": "大爷我正在休息，闲人勿扰。"
                },
                {
                    "id": "10030602",
                    "speaker": "Player",
                    "text": "请问，杏仁豆腐…"
                },
                {
                    "id": "10030603",
                    "speaker": "言笑",
                    "text": "闲人勿扰。"
                },
                {
                    "id": "10030604",
                    "speaker": "派蒙",
                    "text": "呜…这位大厨的服务热情，和蒙德的铁匠瓦格纳先生不相上下呢。"
                },
                {
                    "id": "10030605",
                    "speaker": "Player",
                    "text": "菜是戈黛特老板点的。"
                },
                {
                    "id": "10030606",
                    "speaker": "言笑",
                    "text": "……"
                },
                {
                    "id": "10030607",
                    "speaker": "言笑",
                    "text": "原来如此。老板吩咐下来的事，那就没办法了。"
                },
                {
                    "id": "10030608",
                    "speaker": "言笑",
                    "text": "但很可惜，我现在有心无力，没法做出杏仁豆腐这种细致甜食。"
                },
                {
                    "id": "10030609",
                    "speaker": "派蒙",
                    "text": "这是为什么呢？"
                },
                {
                    "id": "10030610",
                    "speaker": "言笑",
                    "text": "剑客的手必须稳定，咱当厨子的自然也是如此。"
                },
                {
                    "id": "10030611",
                    "speaker": "言笑",
                    "text": "但现在我的手，不好意思…有点不太稳…"
                },
                {
                    "id": "10030612",
                    "speaker": "言笑",
                    "text": "原因嘛…是因为有客人传言，这客栈里…闹鬼…"
                },
                {
                    "id": "10030613",
                    "speaker": "言笑",
                    "text": "而且就在刚才！刚才…我在厨房…也看见了…不太对劲的东西…"
                },
                {
                    "id": "10030614",
                    "speaker": "派蒙",
                    "text": "（这位大厨看起来这么凶恶，说起灵异话题来，语气就变得很虚弱呢。）"
                },
                {
                    "id": "10030615",
                    "speaker": "言笑",
                    "text": "总之…一想到连望舒客栈都不安全了，我磨甜杏仁的手就稳定不下来…"
                },
                {
                    "id": "10030616",
                    "speaker": "派蒙",
                    "text": "#好吧，{NICKNAME}。为了最高品质的精美杏仁豆腐，我们就去厨房看一下吧。"
                }
            ]
        },
        {
            "id": "100307",
            "objective": "前往厨房",
            "dialogues": []
        },
        {
            "id": "100308",
            "objective": "在厨房查看$HIDDEN",
            "dialogues": [
                {
                    "id": "10030801",
                    "speaker": "派蒙",
                    "text": "这里好像什么都…"
                },
                {
                    "id": "10030802",
                    "speaker": "派蒙",
                    "text": "……"
                },
                {
                    "id": "10030803",
                    "speaker": "派蒙",
                    "text": "…………"
                },
                {
                    "id": "10030804",
                    "speaker": "派蒙",
                    "text": "##%^%*&……！！"
                }
            ]
        },
        {
            "id": "100309",
            "objective": "将情形告知言笑",
            "dialogues": [
                {
                    "id": "10030901",
                    "speaker": "言笑",
                    "text": "啊！你们果然也看到了！真的有鬼！"
                },
                {
                    "id": "10030902",
                    "speaker": "言笑",
                    "text": "这…这可如何是好…"
                },
                {
                    "id": "10030903",
                    "speaker": "派蒙",
                    "text": "他已经不行了…怎么办？"
                },
                {
                    "id": "10030904",
                    "speaker": "派蒙",
                    "text": "算了，我们还是去问问老板娘吧。"
                }
            ]
        },
        {
            "id": "100310",
            "objective": "向戈黛特求助",
            "dialogues": [
                {
                    "id": "10031001",
                    "speaker": "菲尔戈黛特",
                    "text": "哼哼…被这种小事吓到，亏他曾经还是江洋大盗。"
                },
                {
                    "id": "10031002",
                    "speaker": "派蒙",
                    "text": "戈黛特老板好像不怎么怕鬼的样子？"
                },
                {
                    "id": "10031003",
                    "speaker": "菲尔戈黛特",
                    "text": "神神鬼鬼的，我可见得多了…"
                },
                {
                    "id": "10031004",
                    "speaker": "派蒙",
                    "text": "啊，说起来，别人好像也不知道仙人在客栈出没，但戈黛特老板…"
                },
                {
                    "id": "10031005",
                    "speaker": "菲尔戈黛特",
                    "text": "嘘…"
                },
                {
                    "id": "10031006",
                    "speaker": "菲尔戈黛特",
                    "text": "再细说下去，就是我的「小秘密」的范围了哦。"
                },
                {
                    "id": "10031007",
                    "speaker": "菲尔戈黛特",
                    "text": "好了，你们不如去跑一趟吧。让那小鬼别再吓人了。"
                },
                {
                    "id": "10031008",
                    "speaker": "菲尔戈黛特",
                    "text": "这可不是差使你们——正如那位仙人所说，人的灵魂不如仙人强韧。"
                },
                {
                    "id": "10031009",
                    "speaker": "菲尔戈黛特",
                    "text": "为了接触仙人时不受伤害，就从接触小鬼开始锻炼吧。",
                    "choices": [
                        {
                            "id": "10031010",
                            "text": "我没问题。",
                            "response": [
                                {
                                    "id": "10031011",
                                    "speaker": "派蒙",
                                    "text": "但要怎么劝说鬼魂呢？"
                                },
                                {
                                    "id": "10031013",
                                    "speaker": "菲尔戈黛特",
                                    "text": "客栈里有一幅字画，描摹了璃月通行千年的「降魔印」，你们可以去看看它的样子。"
                                },
                                {
                                    "id": "10031014",
                                    "speaker": "菲尔戈黛特",
                                    "text": "——然后，就在这间客栈附近，寻找「能够见到完整降魔印的地方」吧。"
                                }
                            ]
                        },
                        {
                            "id": "10031012",
                            "text": "但要怎么劝说鬼魂呢？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "100321",
            "objective": "观察挂画",
            "dialogues": []
        },
        {
            "id": "100311",
            "objective": "寻找能见到完整降魔印的地方",
            "dialogues": [
                {
                    "id": "10031101",
                    "speaker": "派蒙",
                    "text": "好！按老板娘的说法，这下它就没法像上次一样消失了！"
                }
            ]
        },
        {
            "id": "100312",
            "objective": "发现鬼魂$HIDDEN",
            "dialogues": [
                {
                    "id": "10031201",
                    "speaker": "派蒙",
                    "text": "#出…出现了！好吓人…{NICKNAME}，抓她就靠…靠你了…"
                }
            ]
        },
        {
            "id": "100313",
            "objective": "追逐鬼魂",
            "dialogues": []
        },
        {
            "id": "100314",
            "objective": "打倒遗迹猎者",
            "dialogues": [
                {
                    "id": "10031401",
                    "speaker": "派蒙",
                    "text": "啊——不服输的小鬼！"
                }
            ]
        },
        {
            "id": "100315",
            "objective": "与小冥对话",
            "dialogues": [
                {
                    "id": "10031501",
                    "speaker": "小冥",
                    "text": "大丘丘病了♪，二丘丘瞧♪…"
                },
                {
                    "id": "10031502",
                    "speaker": "派蒙",
                    "text": "呼…呼…终于抓到你了，真是累人。"
                },
                {
                    "id": "10031503",
                    "speaker": "小冥",
                    "text": "三丘丘采药♪，四丘丘熬♪…"
                },
                {
                    "id": "10031504",
                    "speaker": "派蒙",
                    "text": "闹鬼是不好的！小朋友你明白吗？"
                },
                {
                    "id": "10031505",
                    "speaker": "小冥",
                    "text": "五丘丘死了♪，六丘丘抬♪…"
                },
                {
                    "id": "10031506",
                    "speaker": "派蒙",
                    "text": "有没有在听我说话啊！"
                },
                {
                    "id": "10031507",
                    "speaker": "小冥",
                    "text": "……"
                },
                {
                    "id": "10031508",
                    "speaker": "小冥",
                    "text": "好喔。"
                },
                {
                    "id": "10031509",
                    "speaker": "小冥",
                    "text": "小冥不会再捉弄住店的客人了。"
                },
                {
                    "id": "10031510",
                    "speaker": "小冥",
                    "text": "#下次，就换{NICKNAME}{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}再来和小冥一起玩吧。"
                },
                {
                    "id": "10031511",
                    "speaker": "小冥",
                    "text": "#如果{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}不来的话，小冥会去找你的…"
                }
            ]
        },
        {
            "id": "100316",
            "objective": "将情形告知言笑",
            "dialogues": [
                {
                    "id": "10031601",
                    "speaker": "言笑",
                    "text": "什…什么，居然从鬼魂口中要到了不再作祟的保证…"
                },
                {
                    "id": "10031602",
                    "speaker": "言笑",
                    "text": "您…真是高人。"
                },
                {
                    "id": "10031603",
                    "speaker": "言笑",
                    "text": "我言笑服了。"
                },
                {
                    "id": "10031604",
                    "speaker": "言笑",
                    "text": "请稍等，我为您认真做一道最细最滑的杏仁豆腐，包您满意。"
                },
                {
                    "id": "10031605",
                    "speaker": "言笑",
                    "text": "哈哈，手指重新变得稳定的感觉，好。"
                }
            ]
        },
        {
            "id": "100317",
            "objective": "与魈对话",
            "dialogues": [
                {
                    "id": "10031701",
                    "speaker": "魈",
                    "text": "…又是你们。"
                },
                {
                    "id": "10031702",
                    "speaker": "派蒙",
                    "text": "等等！这次先别急着消失。"
                },
                {
                    "id": "10031703",
                    "speaker": "魈",
                    "text": "这是…？"
                },
                {
                    "id": "10031704",
                    "speaker": "派蒙",
                    "text": "是你最喜欢的杏仁豆腐，和这位异国旅行者的拿手好菜，充满异国风情的沙拉喔。"
                },
                {
                    "id": "10031705",
                    "speaker": "派蒙",
                    "text": "#{NICKNAME}！快！趁他吃东西的时候…把事情都跟他说了！"
                },
                {
                    "id": "10031706",
                    "speaker": "魈",
                    "text": "岩王帝君…竟遭此厄。"
                },
                {
                    "id": "10031707",
                    "speaker": "魈",
                    "text": "我…无法想象。不论时代如何变易，我都从未想象过失去帝君的璃月之地。"
                },
                {
                    "id": "10031708",
                    "speaker": "魈",
                    "text": "掌管人间的七星…究竟在这件事里扮演了怎样的角色？"
                },
                {
                    "id": "10031709",
                    "speaker": "魈",
                    "text": "……"
                },
                {
                    "id": "10031710",
                    "speaker": "魈",
                    "text": "我会去找削月、理水、留云三位真君。他们也是时候作出决断了。",
                    "choices": [
                        {
                            "id": "10031711",
                            "text": "仙人会来接管璃月吗？",
                            "response": [
                                {
                                    "id": "10031713",
                                    "speaker": "魈",
                                    "text": "仙人不会逃避责任。"
                                },
                                {
                                    "id": "10031714",
                                    "speaker": "魈",
                                    "text": "虽然…我有不愿沾染凡尘的理由，但职责终归是职责。"
                                },
                                {
                                    "id": "10031715",
                                    "speaker": "魈",
                                    "text": "因为我们的神，乃是「契约」之神。"
                                },
                                {
                                    "id": "10031716",
                                    "speaker": "派蒙",
                                    "text": "等一下！我还有最后一个问题。"
                                },
                                {
                                    "id": "10031717",
                                    "speaker": "魈",
                                    "text": "嗯？"
                                },
                                {
                                    "id": "10031718",
                                    "speaker": "派蒙",
                                    "text": "那个…小冥…究竟是…"
                                },
                                {
                                    "id": "10031719",
                                    "speaker": "魈",
                                    "text": "降妖除魔时，偶尔也会遇到从未害过人的恶灵，又暂时难以超度。"
                                },
                                {
                                    "id": "10031720",
                                    "speaker": "魈",
                                    "text": "所以拜托「老板」与「掌柜」，收留一段时日。"
                                },
                                {
                                    "id": "10031721",
                                    "speaker": "派蒙",
                                    "text": "原来是望舒客栈帮忙养着的啊——！这家客栈的业务范围也太广了吧？！"
                                }
                            ]
                        },
                        {
                            "id": "10031712",
                            "text": "仙人会去质问七星吗？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "100303",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "10030304",
                    "speaker": "魈",
                    "text": "「百无禁忌箓」？看来你们有备而来…"
                },
                {
                    "id": "10030305",
                    "speaker": "魈",
                    "text": "但这只是让我不伤害你们的信物，并不代表你们不会受到伤害。"
                },
                {
                    "id": "10030306",
                    "speaker": "派蒙",
                    "text": "呃…我不太明白…"
                },
                {
                    "id": "10030307",
                    "speaker": "魈",
                    "text": "过分接近仙与魔的世界，即为逾矩。"
                }
            ]
        },
        {
            "id": "100387",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "10038701",
                    "speaker": "菲尔戈黛特",
                    "text": "鬼也不过是在世上存在的另一种形式，「以理服鬼」也一定能够做得到的。"
                }
            ]
        },
        {
            "id": "100388",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "10038801",
                    "speaker": "菲尔戈黛特",
                    "text": "仙缘难结又易逝，抓住机会哦。"
                }
            ]
        },
        {
            "id": "100389",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "10038901",
                    "speaker": "言笑",
                    "text": "久违的舒畅感，刚才这道菜也算是超常发挥了。"
                }
            ]
        },
        {
            "id": "100390",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "10039001",
                    "speaker": "言笑",
                    "text": "岩、岩王保佑…各路神仙保佑！"
                }
            ]
        },
        {
            "id": "100391",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "10039101",
                    "speaker": "言笑",
                    "text": "若不是老板和掌柜对我有恩在先，我怎会情愿受这种罪…"
                }
            ]
        },
        {
            "id": "100392",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "10039201",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "10039202",
                    "speaker": "菲尔戈黛特",
                    "text": "祝您旅途平安。"
                }
            ]
        },
        {
            "id": "100393",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "10039301",
                    "speaker": "Player",
                    "text": "关于你丈夫？"
                },
                {
                    "id": "10039302",
                    "speaker": "菲尔戈黛特",
                    "text": "他就在那边，是客栈的掌柜。"
                },
                {
                    "id": "10039303",
                    "speaker": "菲尔戈黛特",
                    "text": "别看他笑嘻嘻的，其实拳脚功夫很厉害的。"
                },
                {
                    "id": "10039304",
                    "speaker": "菲尔戈黛特",
                    "text": "我也是，我们的厨子也是，都是这么招进来的。"
                },
                {
                    "id": "10039305",
                    "speaker": "菲尔戈黛特",
                    "text": "不会功夫还怎么招待好客人呢，你说是不是这个道理。"
                }
            ]
        },
        {
            "id": "100394",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "10039401",
                    "speaker": "Player",
                    "text": "请问你是？"
                },
                {
                    "id": "10039402",
                    "speaker": "菲尔戈黛特",
                    "text": "我叫戈黛特，来自蒙德。是望舒客栈的老板。"
                },
                {
                    "id": "10039403",
                    "speaker": "菲尔戈黛特",
                    "text": "不是老板娘。"
                },
                {
                    "id": "10039404",
                    "speaker": "菲尔戈黛特",
                    "text": "是、老、板。",
                    "choices": [
                        {
                            "id": "10039405",
                            "text": "有些传闻…",
                            "response": [
                                {
                                    "id": "10039406",
                                    "speaker": "菲尔戈黛特",
                                    "text": "哈哈哈，能在这里开店，怎么可能和七星没有关系呢。"
                                },
                                {
                                    "id": "10039407",
                                    "speaker": "菲尔戈黛特",
                                    "text": "我意思是，肯定需要他们同意嘛。"
                                },
                                {
                                    "id": "10039408",
                                    "speaker": "菲尔戈黛特",
                                    "text": "其他一些有的没的，那当然都是谣言啦。"
                                },
                                {
                                    "id": "10039409",
                                    "speaker": "菲尔戈黛特",
                                    "text": "这么说来，您听到过什么有意思的事情吗？"
                                }
                            ]
                        },
                        {
                            "id": "10039410",
                            "text": "关于这猫…",
                            "response": [
                                {
                                    "id": "10039411",
                                    "speaker": "菲尔戈黛特",
                                    "text": "唉…这猫是自己跟来的，不过看着挺可爱的就留下了。"
                                },
                                {
                                    "id": "10039412",
                                    "speaker": "菲尔戈黛特",
                                    "text": "名字吗，叫阿伟，随便起的。"
                                },
                                {
                                    "id": "10039413",
                                    "speaker": "菲尔戈黛特",
                                    "text": "它可能会捣蛋一下，猫嘛，是这样的。您可千万别和它一般见识。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "100395",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "10039501",
                    "speaker": "菲尔戈黛特",
                    "text": "您好啊。打扮、面庞…还有奇怪的伙伴小精灵。猜不出来了呢…"
                }
            ]
        }
    ]
}