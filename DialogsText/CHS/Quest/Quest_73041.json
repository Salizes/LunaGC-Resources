        {
            "id": "7304102",
            "objective": "找到兰梨娄！",
            "dialogues": [
                {
                    "id": "730410501",
                    "speaker": "兰难世",
                    "text": "哈哈哈哈哈哈！兰梨娄果然更弱！"
                },
                {
                    "id": "730410502",
                    "speaker": "兰梨娄",
                    "text": "金色的那菈果然厉害，居然这么快就被识破…唔…"
                },
                {
                    "id": "730410503",
                    "speaker": "兰难世",
                    "text": "金色的那菈虽然厉害，更多还是兰梨娄太弱，兰难世就不会这么快被找到，哼，瞧着。"
                }
            ]
        },
        {
            "id": "7304103",
            "objective": "找到兰难世！",
            "dialogues": []
        },
        {
            "id": "7304104",
            "objective": "找到兰难世！",
            "dialogues": [
                {
                    "id": "730410601",
                    "speaker": "兰难世",
                    "text": "哇！怎么会？"
                },
                {
                    "id": "730410602",
                    "speaker": "兰梨娄",
                    "text": "兰难世也这么快被找到，跟兰梨娄一样弱！"
                },
                {
                    "id": "730410603",
                    "speaker": "兰难世",
                    "text": "呜…都弱，只有金色的那菈强…"
                },
                {
                    "id": "730410604",
                    "speaker": "兰梨娄",
                    "text": "这样下去可不行，要锻炼兰迦拉梨，有了很强的兰迦拉梨，那菈朋友一定就找不到了！",
                    "choices": [
                        {
                            "id": "730410605",
                            "text": "应该不是这个道理…",
                            "response": [
                                {
                                    "id": "730410606",
                                    "speaker": "兰梨娄",
                                    "text": "那菈朋友是不是怕输？玩游戏，不要在乎输赢！"
                                },
                                {
                                    "id": "730410609",
                                    "speaker": "兰梨娄",
                                    "text": "虽然输了，但是玩得开心，金色的那菈果然是好那菈。"
                                },
                                {
                                    "id": "730410610",
                                    "speaker": "兰难世",
                                    "text": "那菈朋友赢了。好厉害！收下我们的花吧！"
                                },
                                {
                                    "id": "730410611",
                                    "speaker": "兰梨娄",
                                    "text": "谢谢好那菈！你是好朋友！"
                                }
                            ]
                        },
                        {
                            "id": "730410607",
                            "text": "要加油啊。",
                            "response": [
                                {
                                    "id": "730410608",
                                    "speaker": "兰难世",
                                    "text": "嗯！下次一定不会输了！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7304101",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "730410101",
                    "speaker": "兰难世",
                    "text": "呀，是金色的那菈。"
                },
                {
                    "id": "730410102",
                    "speaker": "兰梨娄",
                    "text": "那菈朋友，来和兰梨娄玩耍吧！兰难世，弱得很，不要和他玩。"
                },
                {
                    "id": "730410103",
                    "speaker": "兰难世",
                    "text": "噗噗，上次兰梨娄输给兰难世，兰梨娄更弱。"
                },
                {
                    "id": "730410104",
                    "speaker": "兰梨娄",
                    "text": "好哦，不要再管什么太阳月亮，正好那菈朋友在这里，我们和那菈朋友一起玩，比一比谁强谁弱。"
                },
                {
                    "id": "730410105",
                    "speaker": "兰难世",
                    "text": "比就比，兰难世才不会怕。"
                },
                {
                    "id": "730410106",
                    "speaker": "兰梨娄",
                    "text": "兰梨娄先躲，让那菈朋友来找。之后兰难世躲，那菈朋友找。先被找到的就输。"
                },
                {
                    "id": "730410107",
                    "speaker": "兰梨娄",
                    "text": "那菈朋友，要不要来玩？准备好了的话，马上就开始！"
                }
            ]
        },
