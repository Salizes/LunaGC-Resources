        {
            "id": "101303",
            "objective": "寻找三位工人$HIDDEN",
            "dialogues": [
                {
                    "id": "10130301",
                    "speaker": "阿大",
                    "text": "哦？帮工？可以啊，我阿大做事一向百分百出力。当然，要百分之一百二出力的话，价钱另算。"
                },
                {
                    "id": "10130302",
                    "speaker": "阿大",
                    "text": "说说看，你们要做什么？"
                },
                {
                    "id": "10130303",
                    "speaker": "钟离",
                    "text": "我想想…玉京台那边，还缺些木制的用具。因为不是什么稀罕物件，我就没特地准备了。"
                },
                {
                    "id": "10130304",
                    "speaker": "Player",
                    "text": "勇士！50根树枝、20捆木材！"
                },
                {
                    "id": "10130305",
                    "speaker": "阿大",
                    "text": "没问题。跑一趟只收<color=#00E1FFFF>两万摩拉</color>，如何？"
                },
                {
                    "id": "10130306",
                    "speaker": "钟离",
                    "text": "好，成交。",
                    "choices": [
                        {
                            "id": "10130307",
                            "text": "不，还是谈谈价格吧…"
                        },
                        {
                            "id": "10130308",
                            "text": "好，成交。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "101321",
            "objective": "寻找三位工人",
            "dialogues": []
        },
        {
            "id": "101304",
            "objective": "与阿大沟通",
            "dialogues": [
                {
                    "id": "10130401",
                    "speaker": "阿大",
                    "text": "算了算了！看来是我太好说话了！两万摩拉！一摩拉不少！不行的话就别雇老子了！"
                },
                {
                    "id": "10130402",
                    "speaker": "派蒙",
                    "text": "#别，别动气呀…唉，{NICKNAME}，没办法，这下我们只能付全额了吧。"
                }
            ]
        },
