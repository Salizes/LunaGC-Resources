    "talks": [
        {
            "id": "101301",
            "objective": "前往购买风筝",
            "dialogues": [
                {
                    "id": "10130101",
                    "speaker": "阿山婆",
                    "text": "客人，来啦？之前预定的七只风筝都已经扎好了，是现在要取么？"
                },
                {
                    "id": "10130102",
                    "speaker": "钟离",
                    "text": "是的，辛苦了。"
                },
                {
                    "id": "10130103",
                    "speaker": "阿山婆",
                    "text": "这年头，愿意买这式样风筝的客人，还真少见。要说早年间，倒是有些三教九流的朋友会用上…"
                },
                {
                    "id": "10130104",
                    "speaker": "派蒙",
                    "text": "嗯，这位钟离先生是「往生堂」的客卿，所以他对三教九流的游戏规则也都能理解吧。"
                },
                {
                    "id": "10130105",
                    "speaker": "派蒙",
                    "text": "不过，这次旅途里跟钟离闲聊的东西，还远远不止这些…",
                    "choices": [
                        {
                            "id": "10130106",
                            "text": "他也懂衣冠日用、珠玉瓷器…",
                            "response": [
                                {
                                    "id": "10130108",
                                    "speaker": "派蒙",
                                    "text": "唔…他好像也能接上璃月人最爱的金融和政治话题，但却更喜欢说那些比较「无用」的知识呢。"
                                },
                                {
                                    "id": "10130109",
                                    "speaker": "钟离",
                                    "text": "哈哈…因为我更愿意把这些趣事分享给你们。"
                                },
                                {
                                    "id": "10130110",
                                    "speaker": "阿山婆",
                                    "text": "哎呀，孩子的玩具就是很有趣的东西嘛。不过…虽然我也挺喜欢看孩子笑，但毕竟，还有点别的念想。"
                                },
                                {
                                    "id": "10130111",
                                    "speaker": "阿山婆",
                                    "text": "精巧的玩意，总能讨孩子喜欢。但这份「精巧」也是千多年的积淀，背后都是有「意义」的。"
                                },
                                {
                                    "id": "10130112",
                                    "speaker": "阿山婆",
                                    "text": "我在璃月做了四十年风筝，对祖上传下的式样一清二楚。这位客人订的七只风筝，意义可不一般。"
                                },
                                {
                                    "id": "10130113",
                                    "speaker": "钟离",
                                    "text": "没错。这是「送仙典仪」用的饰物，七只风筝…象征七神。"
                                },
                                {
                                    "id": "10130114",
                                    "speaker": "阿山婆",
                                    "text": "呵呵呵…敬献风神的纹样，我特意把颜色「自由」地涂出了界。"
                                },
                                {
                                    "id": "10130115",
                                    "speaker": "阿山婆",
                                    "text": "至于敬献岩神的，就要好好按照「契约」来画咯。这种花纹是很古的，在「黄金屋」里也找得到呢。"
                                },
                                {
                                    "id": "10130116",
                                    "speaker": "派蒙",
                                    "text": "啊，「黄金屋」，这个名字我最近听过——",
                                    "choices": [
                                        {
                                            "id": "10130117",
                                            "text": "嘘…",
                                            "response": [
                                                {
                                                    "id": "10130119",
                                                    "speaker": "派蒙",
                                                    "text": "咦？"
                                                },
                                                {
                                                    "id": "10130120",
                                                    "speaker": "钟离",
                                                    "text": "这只风筝的雷纹…嗯，旋回感把握得很好，正如雷神想要的「永恒」。"
                                                },
                                                {
                                                    "id": "10130121",
                                                    "speaker": "钟离",
                                                    "text": "敬献「智慧」的草叶纹路、银木年轮…巧妙地融合在风筝的骨架里，令人赞叹。"
                                                },
                                                {
                                                    "id": "10130122",
                                                    "speaker": "钟离",
                                                    "text": "水面般平衡的「正义」、如火炽烈的「战争」，还有冰神曾经的…嗯，细节做得都很到位啊。"
                                                },
                                                {
                                                    "id": "10130123",
                                                    "speaker": "阿山婆",
                                                    "text": "嚯嚯嚯，偶尔能听懂行的客人多夸几句，也是赏心乐事。"
                                                },
                                                {
                                                    "id": "10130124",
                                                    "speaker": "钟离",
                                                    "text": "那么阿山婆，我就先把这些预定的货取走了。余款的话…",
                                                    "choices": [
                                                        {
                                                            "id": "10130125",
                                                            "text": "完了！",
                                                            "response": [
                                                                {
                                                                    "id": "10130127",
                                                                    "speaker": "「公子」",
                                                                    "text": "余款的话…我来付吧。"
                                                                },
                                                                {
                                                                    "id": "10130128",
                                                                    "speaker": "派蒙",
                                                                    "text": "呀，是「公子」。",
                                                                    "choices": [
                                                                        {
                                                                            "id": "10130129",
                                                                            "text": "你们约好在这里见面吗。",
                                                                            "response": [
                                                                                {
                                                                                    "id": "10130130",
                                                                                    "speaker": "「公子」",
                                                                                    "text": "哈哈，只是路过。"
                                                                                },
                                                                                {
                                                                                    "id": "10130133",
                                                                                    "speaker": "「公子」",
                                                                                    "text": "钟离先生还是老样子。付账…或者喊人付账的时候，从来不看价格，也不看荷包。"
                                                                                },
                                                                                {
                                                                                    "id": "10130134",
                                                                                    "speaker": "「公子」",
                                                                                    "text": "不过话说回来，他其实既懂金钱的价值，也很明白人间疾苦。但他似乎不能理解「穷」也是一种可能出现在自己身上的境况…"
                                                                                },
                                                                                {
                                                                                    "id": "10130135",
                                                                                    "speaker": "「公子」",
                                                                                    "text": "或者换句话说，只是根本不能想象一个没有钱的自己。"
                                                                                },
                                                                                {
                                                                                    "id": "10130136",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "真是绝了，这种人怎么还没饿死。"
                                                                                },
                                                                                {
                                                                                    "id": "10130137",
                                                                                    "speaker": "钟离",
                                                                                    "text": "…「公子」先生还是这么爱开玩笑。好了，买风筝一切顺利，进行下一项准备之前，就不必休息了吧。"
                                                                                },
                                                                                {
                                                                                    "id": "10130138",
                                                                                    "speaker": "钟离",
                                                                                    "text": "「送仙典仪」需要物资，也需要人。在码头附近，我们可以雇到一些不错的帮工。"
                                                                                },
                                                                                {
                                                                                    "id": "10130139",
                                                                                    "speaker": "「公子」",
                                                                                    "text": "#{NICKNAME}，把这个钱袋拿去——我不说你也明白的吧？讨价还价的事，你自己来，可千万别让钟离插手喔。"
                                                                                },
                                                                                {
                                                                                    "id": "10130140",
                                                                                    "speaker": "「公子」",
                                                                                    "text": "嗯…来晚一步，似乎错过了什么有趣的消息。"
                                                                                },
                                                                                {
                                                                                    "id": "10130141",
                                                                                    "speaker": "「公子」",
                                                                                    "text": "…下次，想办法在更合适的时机出现吧。"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "10130131",
                                                                            "text": "你在埋伏我们？",
                                                                            "response": [
                                                                                {
                                                                                    "id": "10130132",
                                                                                    "speaker": "「公子」",
                                                                                    "text": "哈哈，怎么会呢？只是恰好路过。"
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "10130126",
                                                            "text": "「余款的话」！"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "10130118",
                                            "text": "派蒙，别往下说…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "10130107",
                            "text": "路上谈过茶叶香料、花卉虫鸟…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "101302",
            "objective": "（test）前往飞云商会，与钟离碰头",
            "dialogues": []
