        {
            "id": "101306",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "10130601",
                    "speaker": "阿大",
                    "text": "东西带来了么？"
                }
            ]
        },
        {
            "id": "101310",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "10131001",
                    "speaker": "阿二",
                    "text": "东西带来了么？"
                }
            ]
        },
        {
            "id": "101314",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "10131401",
                    "speaker": "阿三",
                    "text": "东西带来了么？"
                }
            ]
        },
        {
            "id": "101380",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "10138001",
                    "speaker": "阿三",
                    "text": "我想想…不。得再往上加点，否则我不干。"
                }
            ]
        },
        {
            "id": "101381",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "10138101",
                    "speaker": "阿三",
                    "text": "客官，不行啊，太少，太少。"
                }
            ]
        },
        {
            "id": "101383",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "10138301",
                    "speaker": "阿三",
                    "text": "5只岩晶蝶…行吧，差不多就值这个价。"
                }
            ]
        },
        {
            "id": "101385",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "10138501",
                    "speaker": "阿三",
                    "text": "嗯，交易愉快。"
                }
            ]
        },
        {
            "id": "101387",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "10138701",
                    "speaker": "阿二",
                    "text": "这…不太行。多少再加点，我还能考虑考虑。"
                }
            ]
        },
        {
            "id": "101388",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "10138801",
                    "speaker": "阿二",
                    "text": "太少了，这价可不公道。"
                }
            ]
        },
        {
            "id": "101390",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "10139001",
                    "speaker": "阿二",
                    "text": "这价钱…行吧行吧，雇我一天，我也不亏了。"
                }
            ]
        },
        {
            "id": "101392",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "10139201",
                    "speaker": "阿二",
                    "text": "嘿，有这么些摩拉，也算是好价吧。"
                }
            ]
        },
        {
            "id": "101394",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "10139401",
                    "speaker": "阿大",
                    "text": "嗯？不不…再加点儿吧，这价钱真是，不值得专门跑一趟吧。"
                }
            ]
        },
        {
            "id": "101395",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "10139501",
                    "speaker": "阿大",
                    "text": "别啊，这也太少了吧。"
                }
            ]
        },
        {
            "id": "101397",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "10139701",
                    "speaker": "阿大",
                    "text": "我想想…成，这价也算公道，我就为你走一遭。"
                }
            ]
        },
        {
            "id": "101399",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "10139901",
                    "speaker": "阿大",
                    "text": "哦？老板是实在人，不错，我们成交了。"
                }
            ]
        }
    ]
}