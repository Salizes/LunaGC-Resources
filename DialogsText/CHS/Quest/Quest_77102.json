        },
        {
            "id": "7710218",
            "objective": "(test)废弃$HIDDEN",
            "dialogues": [
                {
                    "id": "771020401",
                    "speaker": "娜斯佳",
                    "text": "说起来，被兽怪抓走那天，所有的孩子都被要求到礼堂，我的…我的朋友们应该也到过这里…"
                },
                {
                    "id": "771020402",
                    "speaker": "娜斯佳",
                    "text": "我和他们也有好长一段时间没见面了。"
                },
                {
                    "id": "771020403",
                    "speaker": "娜斯佳",
                    "text": "唔，你们找到线索了吗？",
                    "choices": [
                        {
                            "id": "771020404",
                            "text": "暂时还没有发现。",
                            "response": [
                                {
                                    "id": "771020405",
                                    "speaker": "娜斯佳",
                                    "text": "我也是，那我们还是抓紧时间吧。"
                                }
                            ]
                        },
                        {
                            "id": "771020406",
                            "text": "有些眉目了…",
                            "response": [
                                {
                                    "id": "771020407",
                                    "speaker": "娜斯佳",
                                    "text": "好厉害，我还什么都没发现呢，那我要加油了！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
