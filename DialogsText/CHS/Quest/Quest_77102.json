            "dialogues": [
                {
                    "id": "771021201",
                    "speaker": "娜斯佳",
                    "text": "#怎么了，{NICKNAME}{M#大哥哥}{F#大姐姐}？发生什么事了吗？",
                    "choices": [
                        {
                            "id": "771021202",
                            "text": "…有点不放心你和派蒙。",
                            "response": [
                                {
                                    "id": "771021203",
                                    "speaker": "娜斯佳",
                                    "text": "不要担心噢，我会保护小小派蒙，小小派蒙也会保护我。"
                                },
                                {
                                    "id": "771021204",
                                    "speaker": "娜斯佳",
                                    "text": "一棵小树会被风吹倒，两棵小树会成为互相的依靠。"
                                }
                            ]
                        },
                        {
                            "id": "771021205",
                            "text": "没事。",
                            "response": [
                                {
                                    "id": "771021206",
                                    "speaker": "娜斯佳",
                                    "text": "好哦，我们等你的好消息。"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
