            "dialogues": []
        },
        {
            "id": "7710208",
            "objective": "(test)与娜斯佳对话",
            "dialogues": []
        },
        {
            "id": "7710209",
            "objective": "前往另一幕布开关处",
            "dialogues": [
                {
                    "id": "771020901",
                    "speaker": "派蒙",
                    "text": "#咦，{NICKNAME}已经到对面了吗？"
                },
                {
                    "id": "771020902",
                    "speaker": "派蒙",
                    "text": "#那我要大声喊，免得{M#他}{F#她}听不见。"
                }
            ]
        },
        {
            "id": "7710206",
            "objective": "(test)隔空喊话",
            "dialogues": []
        },
        {
            "id": "7710210",
            "objective": "同时启动两处幕布开关",
            "dialogues": [
                {
                    "id": "771021001",
                    "speaker": "Black Screen",
                    "text": "(test)火鸟站在屋顶俯视，逆光下展示剪影，然后飞往树湖"
                }
            ]
        },
        {
            "id": "7710211",
            "objective": "同时启动两处幕布开关",
            "dialogues": [
                {
                    "id": "771021101",
                    "speaker": "娜斯佳",
                    "text": "我们能一起上去打开开关了吗？",
                    "choices": [
                        {
                            "id": "771021102",
                            "text": "我还需要想想办法。",
                            "response": [
                                {
                                    "id": "771021104",
                                    "speaker": "娜斯佳",
                                    "text": "好哦…那你加油。"
                                }
                            ]
                        },
                        {
                            "id": "771021103",
                            "text": "我已经想好要怎么做了。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7710213",
            "objective": "(test)向娜斯佳喊话",
            "dialogues": []
        },
        {
            "id": "7710214",
            "objective": "与娜斯佳和派蒙会合",
            "dialogues": []
        },
        {
            "id": "7710227",
            "objective": "(test)与娜斯佳对话",
            "dialogues": [
                {
                    "id": "771020601",
                    "speaker": "娜斯佳",
                    "text": "我记得，这里是照着扎拉样子雕的浮雕，现在的样子是不对的。"
                },
                {
                    "id": "771020602",
                    "speaker": "娜斯佳",
                    "text": "我们要继续向前走，穿过这里…"
                },
                {
                    "id": "771020603",
                    "speaker": "派蒙",
                    "text": "哦哦好，往前走！等下，这里不是一堵墙吗？"
                },
                {
                    "id": "771020604",
                    "speaker": "娜斯佳",
                    "text": "这里是「家」的门扉，只有被选择的人才能穿过门扉，变成「永恒的无忧的生命」。"
                },
                {
                    "id": "771020605",
                    "speaker": "娜斯佳",
                    "text": "按理说，只有莫罗医生才知道怎么打开，不过…不过有一次我偷偷躲在了礼堂的角落，看到了打开的方法…"
                },
                {
                    "id": "771020606",
                    "speaker": "Black Screen",
                    "text": "娜斯佳简单绘制了示意图，并递给了你们。"
                },
                {
                    "id": "771020607",
                    "speaker": "派蒙",
                    "text": "唔，所以说这东西其实是个转盘，只要把转盘转成相应的样子，后面的门扉就能够打开…"
                }
            ]
        },
        {
            "id": "7710215",
            "objective": "打开前往「家」的门扉",
            "dialogues": [
                {
                    "id": "771021501",
                    "speaker": "派蒙",
                    "text": "转盘没有反应呢…呃，这里的机关是不是坏了？"
                },
                {
                    "id": "771021502",
                    "speaker": "娜斯佳",
                    "text": "…啊，我想起来了，最后一步，要把「盐」放到那里才行。"
                },
                {
                    "id": "771021503",
                    "speaker": "娜斯佳",
                    "text": "莫罗医生说，人要变成「完全树」，就得从三个方面进行转变…"
                },
                {
                    "id": "771021504",
                    "speaker": "娜斯佳",
                    "text": "「舍弃旧日的灵魂吧，为灵魂不再为地星的隐脉所拘。」然后，替换旧日灵魂的，就是灵魂之硫…硫磺？"
                },
                {
                    "id": "771021505",
                    "speaker": "娜斯佳",
                    "text": "「舍弃旧日的意志吧，为意志不再为天上的视线注视。」然后，替换意志的就是，精神之银。"
                },
                {
                    "id": "771021506",
                    "speaker": "娜斯佳",
                    "text": "最后要舍弃的是…「舍弃旧日的躯体吧，为躯体不再为尘世的纷劳磨损。」现在要献上的，就是要替换身体的材料。"
                },
                {
                    "id": "771021507",
                    "speaker": "娜斯佳",
                    "text": "呃…「盐」就是…从旧的身体里长出的新的身体，就是这个！"
                },
                {
                    "id": "771021508",
                    "speaker": "娜斯佳",
                    "text": "呜，这个比想象中要稍微疼一点呢。"
                },
                {
                    "id": "771021509",
                    "speaker": "派蒙",
                    "text": "娜斯佳…没事吧！"
                },
                {
                    "id": "771021510",
                    "speaker": "娜斯佳",
                    "text": "没事，虽然很疼，但是我很高兴。这样，我就能回到「家」，你们也可以找到医生问卡谢伊的事。"
                },
                {
                    "id": "771021511",
                    "speaker": "娜斯佳",
                    "text": "所以这点痛不要紧…快点，快点献上「盐」吧。"
                },
                {
                    "id": "771021512",
                    "speaker": "派蒙",
                    "text": "#…好、好吧，就听你的。{NICKNAME}，我们把这个小树枝放在那个台子上吧。"
                }
            ]
        },
        {
            "id": "7710233",
            "objective": "(test)与娜斯佳对话",
            "dialogues": []
        },
        {
            "id": "7710216",
            "objective": "乘坐升降梯",
            "dialogues": [
                {
                    "id": "771021601",
                    "speaker": "娜斯佳",
                    "text": "唔，只要穿过门扉，就能回「家」了，可是…",
                    "choices": [
                        {
                            "id": "771021602",
                            "text": "娜斯佳在担心什么？",
                            "response": [
                                {
                                    "id": "771021603",
                                    "speaker": "娜斯佳",
                                    "text": "没、没有，不知道为什么，我的心里有点乱糟糟的，像是堆满了落叶一样…"
                                },
                                {
                                    "id": "771021604",
                                    "speaker": "娜斯佳",
                                    "text": "医生以前教过我「近乡情怯」这个词，当时我总是不懂，现在突然有点明白了呢…"
                                },
                                {
                                    "id": "771021606",
                                    "speaker": "娜斯佳",
                                    "text": "好、好哦，我相信你。"
                                }
                            ]
                        },
                        {
                            "id": "771021605",
                            "text": "别担心，我会打开门扉。"
                        }
                    ]
                }
            ]
        },
