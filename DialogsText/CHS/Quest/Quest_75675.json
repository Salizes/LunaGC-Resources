    "talks": [
        {
            "id": "7567501",
            "objective": "前往悠悠度假村",
            "dialogues": [
                {
                    "id": "756750101",
                    "speaker": "昂吉安妮",
                    "text": "嘿！哈！"
                },
                {
                    "id": "756750102",
                    "speaker": "昂吉安妮",
                    "text": "我的脑袋已经被音乐占满了，跳舞跳舞！"
                },
                {
                    "id": "756750103",
                    "speaker": "瑟琪",
                    "text": "摇摆摇摆~"
                },
                {
                    "id": "756750104",
                    "speaker": "梅内娅",
                    "text": "快快乐乐——"
                },
                {
                    "id": "756750105",
                    "speaker": "莫乌",
                    "text": "呜啊呜啊！"
                },
                {
                    "id": "756750106",
                    "speaker": "玛因",
                    "text": "还赚了外快。"
                },
                {
                    "id": "756750107",
                    "speaker": "昂吉安妮",
                    "text": "咦？你这小妞，什么时候的事？"
                },
                {
                    "id": "756750108",
                    "speaker": "玛因",
                    "text": "努斯妲小姐忙不过来，我就抽空去支援了她的学徒，清剿了几个魔物的巢穴。"
                },
                {
                    "id": "756750109",
                    "speaker": "玛因",
                    "text": "在纳塔，战斗和跳舞一样尽兴，喜欢。"
                },
                {
                    "id": "756750110",
                    "speaker": "努斯妲",
                    "text": "真是麻烦你了，玛因。我的本意是让新人们多多锻炼，没想到他们还是不能独立完成那一组任务。"
                },
                {
                    "id": "756750111",
                    "speaker": "努斯妲",
                    "text": "等我回去后，给他们狠狠加练！"
                },
                {
                    "id": "756750112",
                    "speaker": "玛因",
                    "text": "不麻烦，他们也打得很漂亮。只不过之前没想到，巢穴里有预估七倍的魔物罢了。"
                },
                {
                    "id": "756750113",
                    "speaker": "玛因",
                    "text": "「花羽会」给的好多，我为爱贝尔买礼物的钱都凑够了。"
                },
                {
                    "id": "756750114",
                    "speaker": "昂吉安妮",
                    "text": "但你的假期时间好像也差不多了？"
                },
                {
                    "id": "756750115",
                    "speaker": "昂吉安妮",
                    "text": "再玩几天，就可以预订船票琢磨返程的事。"
                },
                {
                    "id": "756750116",
                    "speaker": "玛因",
                    "text": "不急，还可以跳舞。小萝克珊、勒泰利埃，谢妮和弗雷瑞斯最近在争着任务做，我可不能和他们抢。"
                },
                {
                    "id": "756750117",
                    "speaker": "瑟琪",
                    "text": "那就继续跳舞，继续开心。"
                },
                {
                    "id": "756750118",
                    "speaker": "梅内娅",
                    "text": "跳累就吃，吃饱就睡，无忧无虑！"
                },
                {
                    "id": "756750119",
                    "speaker": "莫乌",
                    "text": "咿啊——"
                },
                {
                    "id": "756750120",
                    "speaker": "Black Screen",
                    "text": "美露莘们和小鳍游龙排成一列，向着舞台蹦蹦跳跳过去了。"
                },
                {
                    "id": "756750121",
                    "speaker": "努斯妲",
                    "text": "真是一群可爱的客人…"
                },
                {
                    "id": "756750122",
                    "speaker": "派蒙",
                    "text": "嘿嘿，你也很享受嘛，努斯妲。",
                    "choices": [
                        {
                            "id": "756750123",
                            "text": "笑容更轻松畅快了。",
                            "response": [
                                {
                                    "id": "756750125",
                                    "speaker": "努斯妲",
                                    "text": "当真？那以后，每次「舞力聚会」，我都非来不可。"
                                },
                                {
                                    "id": "756750126",
                                    "speaker": "努斯妲",
                                    "text": "要让那些见面就喊我大姐，甚至是阿姨的后辈…有一天发现，我的精神面貌比他们都年轻。"
                                },
                                {
                                    "id": "756750127",
                                    "speaker": "努斯妲",
                                    "text": "以后的「舞力聚会」应该以这次为典范，办得越频繁越好！成为每个月都有的惯例，都在情理之中！"
                                }
                            ]
                        },
                        {
                            "id": "756750124",
                            "text": "好像整个人都年轻了不少。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7567599",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "756759901",
                    "speaker": "派蒙",
                    "text": "呼啊，这段时间的舞力聚会，玩得还真开心！"
                },
                {
                    "id": "756759902",
                    "speaker": "派蒙",
                    "text": "不知道大家的感觉怎么样呢？"
                }
            ]
        }
    ]
}