    "talks": [
        {
            "id": "7213201",
            "objective": "前往无明砦",
            "dialogues": [
                {
                    "id": "721320101",
                    "speaker": "梶",
                    "text": "感谢你的努力，虽然岛上依然危险重重，但多亏了你，那些背井离乡的人们才多少恢复了一点回家的希望。"
                },
                {
                    "id": "721320102",
                    "speaker": "梶",
                    "text": "虽说现在大雨停了，交战的双方可能会更积极地进军争夺这座岛吧…"
                },
                {
                    "id": "721320103",
                    "speaker": "梶",
                    "text": "不过岛上的境况，既然他们无暇改变，我们所做的一切至少比就这样放着恶化好。"
                },
                {
                    "id": "721320104",
                    "speaker": "梶",
                    "text": "那么，之前说好的谢礼就交给你了。"
                },
                {
                    "id": "721320105",
                    "speaker": "梶",
                    "text": "这是几百年前八酝守大人使用的名枪…我不清楚这幅画对你来说有没有用。"
                },
                {
                    "id": "721320107",
                    "speaker": "梶",
                    "text": "不过把它拿给手艺足够精湛的工匠的话，或许能够重现喜多院大人的英姿吧…"
                },
                {
                    "id": "721320108",
                    "speaker": "梶",
                    "text": "唉，当今不再是英雄的时代了，曾扑灭无数邪魔的喜多院大人也不复归来…"
                },
                {
                    "id": "721320109",
                    "speaker": "梶",
                    "text": "不过幸好有你相助，喜多院大人的功业…现在我们也追上了一点吧。"
                },
                {
                    "id": "721320110",
                    "speaker": "梶",
                    "text": "接下来我会去幕府军的朋友那边，看看能帮上什么忙，希望来日有缘再见。"
                }
            ]
        },
        {
            "id": "7213202",
            "objective": "调查遗迹内部",
            "dialogues": [
                {
                    "id": "721320201",
                    "speaker": "放置",
                    "text": "似乎镇物缺少了两个关键部件。"
                },
                {
                    "id": "721320202",
                    "speaker": "Player",
                    "text": "（是这个吗？）"
                }
            ]
