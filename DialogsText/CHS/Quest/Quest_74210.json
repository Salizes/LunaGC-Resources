        }
    },
    "talks": [
        {
            "id": "7413612",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "741361201",
                    "speaker": "雷蒙多",
                    "text": "您有什么想问的话，荣誉高级研究员？",
                    "choices": [
                        {
                            "id": "741361202",
                            "text": "关于纳克和艾德温的处理…",
                            "response": [
                                {
                                    "id": "741361203",
                                    "speaker": "雷蒙多",
                                    "text": "他们会暂时待在梅洛彼得堡里，为他们所犯下的罪行悔过。"
                                },
                                {
                                    "id": "741361204",
                                    "speaker": "雷蒙多",
                                    "text": "当然，以艾德温的性格，大概率也不会做「悔过」这种事。"
                                },
                                {
                                    "id": "741361205",
                                    "speaker": "雷蒙多",
                                    "text": "但无论如何，只要能让艾德温远离研究器材和始基矿就好。"
                                },
                                {
                                    "id": "741361206",
                                    "speaker": "雷蒙多",
                                    "text": "至于纳克…我想他不会再给我们添麻烦了。"
                                },
                                {
                                    "id": "741361207",
                                    "speaker": "雷蒙多",
                                    "text": "唉，希望我不要遇见那种…非启用他们不可的事务…"
                                }
                            ]
                        },
                        {
                            "id": "741361208",
                            "text": "菲希里耶之前很崇拜艾德温？",
                            "response": [
                                {
                                    "id": "741361209",
                                    "speaker": "雷蒙多",
                                    "text": "…艾德温·伊斯丁豪斯先生是一个天才。和他在同一领域工作的人要么自暴自弃，要么就成为他的信徒。"
                                },
                                {
                                    "id": "741361210",
                                    "speaker": "雷蒙多",
                                    "text": "菲希里耶小姐是一位非常有热情和创意的研究员，经常用很小的成本做出精彩的成果。"
                                },
                                {
                                    "id": "741361211",
                                    "speaker": "雷蒙多",
                                    "text": "在加入始基矿研究项目的第三技术组后，她负责抑制器的结构设计工作，和艾德温的接触次数很多。"
                                },
                                {
                                    "id": "741361212",
                                    "speaker": "雷蒙多",
                                    "text": "也许，她就是那个时候成为了艾德温的信徒吧。和其他的信徒一样，艾德温的认可是她唯一的追求。"
                                },
                                {
                                    "id": "741361213",
                                    "speaker": "雷蒙多",
                                    "text": "在爆炸后，她不愿意相信艾德温是爆炸的肇事者，主动申请参与调查，试图为艾德温翻案。"
                                },
                                {
                                    "id": "741361214",
                                    "speaker": "雷蒙多",
                                    "text": "你也和艾德温打过交道了，对他感觉如何？"
                                },
                                {
                                    "id": "741361215",
                                    "speaker": "派蒙",
                                    "text": "是个除了研究之外什么都不管的怪人！就会推卸责任，而且连菲希里耶小姐的名字都记不住！"
                                },
                                {
                                    "id": "741361216",
                                    "speaker": "雷蒙多",
                                    "text": "没错，他就是这样的人。除了手头的研究之外，几乎没有任何东西和人值得他注意。"
                                },
                                {
                                    "id": "741361217",
                                    "speaker": "雷蒙多",
                                    "text": "只要研究顺利，他也几乎不会管其他任何事务，就连他手下的研究员偷偷倒卖研究资产也毫不关心。"
                                },
                                {
                                    "id": "741361218",
                                    "speaker": "雷蒙多",
                                    "text": "我之所以答应菲希里耶参与调查…只是希望她能早日明白，自己所追逐的一个由她自己想象出来的幻影。"
                                },
                                {
                                    "id": "741361219",
                                    "speaker": "雷蒙多",
                                    "text": "现在，幻影终于破灭了。希望她能早日振作起来…枫丹科学院不能再失去任何研究员了。"
                                }
                            ]
                        },
                        {
                            "id": "741361220",
                            "text": "再见。",
                            "response": [
                                {
                                    "id": "741361221",
                                    "speaker": "雷蒙多",
                                    "text": "再见，荣誉高级研究员。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7413613",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "741361301",
                    "speaker": "舒瓦瑟尔",
                    "text": "呼…没关系，没关系，噩梦都结束了…",
                    "choices": [
                        {
                            "id": "741361302",
                            "text": "对艾德温复活有什么感想？",
                            "response": [
                                {
                                    "id": "741361303",
                                    "speaker": "舒瓦瑟尔",
                                    "text": "哎哟！您吓我一跳，感想？我没什么感想，只希望这不负责任的混账能付出代价！"
                                },
                                {
                                    "id": "741361304",
                                    "speaker": "舒瓦瑟尔",
                                    "text": "如果可能的话，我恨不得把他的手脚都绑上，眼睛蒙起来，免得他再接触始基矿！"
                                }
                            ]
                        },
                        {
                            "id": "741361305",
                            "text": "现在能放下心了吗？",
                            "response": [
                                {
                                    "id": "741361306",
                                    "speaker": "舒瓦瑟尔",
                                    "text": "与之前相比，我的确能稍微安心一些了。"
                                },
                                {
                                    "id": "741361307",
                                    "speaker": "舒瓦瑟尔",
                                    "text": "但说实话…把纳克和艾德温关在一起？天哪！我都不知道他们会做什么事！"
                                },
                                {
                                    "id": "741361308",
                                    "speaker": "舒瓦瑟尔",
                                    "text": "上次是爆炸，下次是什么？用枫达淹没整个枫丹？我真是不敢想…"
                                }
                            ]
                        },
                        {
                            "id": "741361309",
                            "text": "祝你有个好心情。",
                            "response": [
                                {
                                    "id": "741361310",
                                    "speaker": "舒瓦瑟尔",
                                    "text": "也祝您有美好的一天，荣誉高级研究员。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7413614",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "741361401",
                    "speaker": "菲希里耶",
                    "text": "…没有价值…我的研究没价值…"
                },
                {
                    "id": "741361402",
                    "speaker": "勒马克",
                    "text": "小姐，您不必这么想，您的发明可是救了我一命啊。"
                },
                {
                    "id": "741361403",
                    "speaker": "菲希里耶",
                    "text": "但…但艾德温前辈…呜呜…艾德温先生说，说这个东西没价值！呜呜呜…"
                },
                {
                    "id": "741361404",
                    "speaker": "肖西韦尔",
                    "text": "是那个叫艾德温的人没眼力，明明是个宝贝！什么叫没价值？我都想给我手下的兄弟每人配一个了。"
                },
                {
                    "id": "741361405",
                    "speaker": "Player",
                    "text": "艾德温是坏人，他说的是谎话。"
                },
                {
                    "id": "741361406",
                    "speaker": "菲希里耶",
                    "text": "艾德温前辈不是坏人！他…他…反正…他都不记得我的名字！我还给他看过好多次设计图，呜呜呜…"
                },
                {
                    "id": "741361407",
                    "speaker": "派蒙",
                    "text": "菲希里耶小姐，你明明就是一个很厉害的人呀，为什么一定要让艾德温那家伙评价你呢？"
                },
                {
                    "id": "741361408",
                    "speaker": "Player",
                    "text": "他觉得坏，我觉得好！"
                },
                {
                    "id": "741361409",
                    "speaker": "菲希里耶",
                    "text": "真…真的？"
                },
                {
                    "id": "741361410",
                    "speaker": "肖西韦尔",
                    "text": "真的啊，你看我们都这么觉得。"
                },
                {
                    "id": "741361411",
                    "speaker": "菲希里耶",
                    "text": "可是，你们又不懂研究——呜呜呜——"
                },
                {
                    "id": "741361412",
                    "speaker": "派蒙",
                    "text": "菲希里耶小姐…完全陷入混乱状态了呢。不然…我们还是让她一个人静一会吧…"
                },
                {
                    "id": "741361413",
                    "speaker": "肖西韦尔",
                    "text": "行…我和勒马克就在旁边等着，有什么事叫我们。"
                }
            ]
        }
    ]
}