        }
    },
    "talks": [
        {
            "id": "7335001",
            "objective": "与奥古斯都对话",
            "dialogues": [
                {
                    "id": "733500101",
                    "speaker": "奥古斯都·洛夫莱斯",
                    "text": "啊…阿嚏！这些香料的味道真是太…啊…阿嚏！"
                },
                {
                    "id": "733500102",
                    "speaker": "奥古斯都·洛夫莱斯",
                    "text": "还是快点留个影，回去屋里待着吧…"
                },
                {
                    "id": "733500103",
                    "speaker": "奥古斯都·洛夫莱斯",
                    "text": "旅行者，嗨，旅行者！请您留步！",
                    "choices": [
                        {
                            "id": "733500104",
                            "text": "你叫我？",
                            "response": [
                                {
                                    "id": "733500106",
                                    "speaker": "奥古斯都·洛夫莱斯",
                                    "text": "我想请您帮我在这里留个影，一张就好，不会花多长时间的。"
                                },
                                {
                                    "id": "733500109",
                                    "speaker": "奥古斯都·洛夫莱斯",
                                    "text": "这地方的香料味道对我来说，实在是太刺激了…"
                                },
                                {
                                    "id": "733500110",
                                    "speaker": "奥古斯都·洛夫莱斯",
                                    "text": "我在枫丹的时候，吃的菜里可是连一点辣味都不能有，最多放一点盐。"
                                },
                                {
                                    "id": "733500111",
                                    "speaker": "奥古斯都·洛夫莱斯",
                                    "text": "在这里，我喷嚏打得连…阿嚏！连留影机都要拿不稳了…"
                                },
                                {
                                    "id": "733500112",
                                    "speaker": "奥古斯都·洛夫莱斯",
                                    "text": "所以，我只能拜托…拜托其他人帮我留影。"
                                },
                                {
                                    "id": "733500113",
                                    "speaker": "奥古斯都·洛夫莱斯",
                                    "text": "您看上去就是个好心肠的人，所以…我就想请您来帮我这个忙。"
                                },
                                {
                                    "id": "733500114",
                                    "speaker": "Player",
                                    "text": "你来自枫丹？"
                                },
                                {
                                    "id": "733500115",
                                    "speaker": "奥古斯都·洛夫莱斯",
                                    "text": "没错，我都忘记自我介绍了，真是抱歉…"
                                },
                                {
                                    "id": "733500116",
                                    "speaker": "奥古斯都·洛夫莱斯",
                                    "text": "我的名字是奥古斯都·洛夫莱斯，「枫丹动能工程科学研究院」的一名研究员。",
                                    "choices": [
                                        {
                                            "id": "733500117",
                                            "text": "「枫丹动能工程科学研究院」？",
                                            "response": [
                                                {
                                                    "id": "733500119",
                                                    "speaker": "奥古斯都·洛夫莱斯",
                                                    "text": "这串字是不是太长了？您也可以把它称作「枫丹科学院」，枫丹人也都这么叫。"
                                                },
                                                {
                                                    "id": "733500120",
                                                    "speaker": "奥古斯都·洛夫莱斯",
                                                    "text": "之前，枫丹科学院可以说是枫丹科研者的一座圣地，大部分的机关造物都出自我们院内。"
                                                },
                                                {
                                                    "id": "733500121",
                                                    "speaker": "奥古斯都·洛夫莱斯",
                                                    "text": "但在天才的艾德温先生主持下，枫丹科学院的大部分建筑现在已经成了一片废墟…"
                                                },
                                                {
                                                    "id": "733500122",
                                                    "speaker": "奥古斯都·洛夫莱斯",
                                                    "text": "而雷蒙多和舒瓦瑟尔先生接手重建工作之后，院里的「研究精神」也正在坍塌。"
                                                },
                                                {
                                                    "id": "733500123",
                                                    "speaker": "奥古斯都·洛夫莱斯",
                                                    "text": "我是一个爱好整洁的人，不愿意在废墟堆里生活。所以就四处旅行，散散心。"
                                                },
                                                {
                                                    "id": "733500124",
                                                    "speaker": "奥古斯都·洛夫莱斯",
                                                    "text": "别皱眉，这些烦心事都和您无关。"
                                                },
                                                {
                                                    "id": "733500125",
                                                    "speaker": "奥古斯都·洛夫莱斯",
                                                    "text": "来，请您快些给我拍一张画片吧。等泽维尔见识到须弥的风光，他肯定不会再待在稻妻了。"
                                                },
                                                {
                                                    "id": "733500126",
                                                    "speaker": "Player",
                                                    "text": "提到泽维尔…"
                                                },
                                                {
                                                    "id": "733500127",
                                                    "speaker": "奥古斯都·洛夫莱斯",
                                                    "text": "泽维尔是枫丹科学院里的研究员。我曾与他在同一间研究室共事，他也曾经为我提供了许多指导。"
                                                },
                                                {
                                                    "id": "733500128",
                                                    "speaker": "奥古斯都·洛夫莱斯",
                                                    "text": "他坚持要拍「映影」，还要做「映影导演」，在当时的枫丹科学院里，这个想法可不受欢迎。"
                                                },
                                                {
                                                    "id": "733500129",
                                                    "speaker": "奥古斯都·洛夫莱斯",
                                                    "text": "即使后来被赶到了其他项目，他仍借着记录项目研究过程的名头，不断地拍摄着「记录映影」。"
                                                },
                                                {
                                                    "id": "733500132",
                                                    "speaker": "奥古斯都·洛夫莱斯",
                                                    "text": "就这样，他在项目与研究室之间辗转，直到最终他被派到稻妻…"
                                                },
                                                {
                                                    "id": "733500130",
                                                    "speaker": "奥古斯都·洛夫莱斯",
                                                    "text": "很有想法的人，假使他诞生在研究方向更为开明、经费更加充裕的过去，或者是美好的未来，想必能大有成就吧…"
                                                },
                                                {
                                                    "id": "733500131",
                                                    "speaker": "奥古斯都·洛夫莱斯",
                                                    "text": "先不说这些了，请您来帮我拍一张画片吧，在这里就行。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "733500118",
                                            "text": "那是什么地方？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "733500105",
                            "text": "有什么事吗？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7335002",
            "objective": "拍摄画片",
            "dialogues": [
                {
                    "id": "733500201",
                    "speaker": "奥古斯都·洛夫莱斯",
                    "text": "您帮我拍完画片了吗？"
                },
                {
                    "id": "733500202",
                    "speaker": "Player",
                    "text": "还没有。"
                },
                {
                    "id": "733500203",
                    "speaker": "奥古斯都·洛夫莱斯",
                    "text": "唔，您慢慢来，拍摄画片确实不是一件简单的事。"
                }
            ]
        },
        {
            "id": "7335003",
            "objective": "向奥古斯都回报",
            "dialogues": [
                {
                    "id": "733500301",
                    "speaker": "奥古斯都·洛夫莱斯",
                    "text": "这画片真不错，您在留影方面很有天赋。"
                },
                {
                    "id": "733500302",
                    "speaker": "奥古斯都·洛夫莱斯",
                    "text": "自从开始旅行以来，对于构图与色彩把握有如此水准的人，我还是第一次见呢。"
                },
                {
                    "id": "733500303",
                    "speaker": "Player",
                    "text": "你都到过什么地方？"
                },
                {
                    "id": "733500304",
                    "speaker": "奥古斯都·洛夫莱斯",
                    "text": "这个啊，嗯…我本来可以直接从枫丹到须弥。毕竟枫丹有一条航线直通须弥的拜达港嘛。"
                },
                {
                    "id": "733500312",
                    "speaker": "奥古斯都·洛夫莱斯",
                    "text": "但俗话说，旅行最重要的是过程嘛，所以我还是选择了一条…更具有趣味性的旅游路线。"
                },
                {
                    "id": "733500313",
                    "speaker": "奥古斯都·洛夫莱斯",
                    "text": "首先，我先通过柔灯港来到了沉玉谷，并途经轻策庄到达了分隔蒙德与璃月的石门。"
                },
                {
                    "id": "733500310",
                    "speaker": "奥古斯都·洛夫莱斯",
                    "text": "在拜访晨曦酒庄以后，我还是决定南下到璃月港看看。"
                },
                {
                    "id": "733500305",
                    "speaker": "奥古斯都·洛夫莱斯",
                    "text": "在璃月港我搭上了去奥摩斯港的渡船，再经河道北上，就来到了这里，遇到了您。"
                },
                {
                    "id": "733500306",
                    "speaker": "奥古斯都·洛夫莱斯",
                    "text": "毕竟，这次旅行的动机还是散心。倘若我是个热衷冒险的勇士…"
                },
                {
                    "id": "733500311",
                    "speaker": "奥古斯都·洛夫莱斯",
                    "text": "或许我会乐意从海露港出发，走走古代的朝圣之路，向南深入沙漠吧。"
                },
                {
                    "id": "733500307",
                    "speaker": "奥古斯都·洛夫莱斯",
                    "text": "…谁知道呢？或许返程时，我会试试穿越大沙漠。这么说来，现在经费还很充足，或许穿越沙漠去纳塔看看也不错…"
                },
                {
                    "id": "733500308",
                    "speaker": "奥古斯都·洛夫莱斯",
                    "text": "好了，不耽误您的时间了。感谢您帮我留影，这些报酬请您收下。"
                },
                {
                    "id": "733500309",
                    "speaker": "奥古斯都·洛夫莱斯",
                    "text": "我得赶紧去给泽维尔写信了，他再不来须弥，我就要回枫丹了…"
                }
            ]
        },
