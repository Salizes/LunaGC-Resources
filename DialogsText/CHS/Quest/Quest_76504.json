    "talks": [
        {
            "id": "7650401",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "765040101",
                    "speaker": "伊涅芙",
                    "text": "#{NICKNAME}，派蒙，你们好。吃了吗？"
                },
                {
                    "id": "765040102",
                    "speaker": "派蒙",
                    "text": "伊涅芙？你怎么也跑到屋顶上来啦。难道是…在观察云的形状，计算下雨的概率？"
                },
                {
                    "id": "765040103",
                    "speaker": "伊涅芙",
                    "text": "我正在执行一项…意外偏离预定轨道的任务。"
                },
                {
                    "id": "765040104",
                    "speaker": "伊涅芙",
                    "text": "原定计划是为爱诺采购她清单上指定的「高精度齿轮」和「特制六角螺丝」。"
                },
                {
                    "id": "765040105",
                    "speaker": "伊涅芙",
                    "text": "但在返回工坊的途中，遭遇了一次…不可预见的物资拦截事件。一只鹰隼，以极快的速度，从我的手中叼走了那枚特制螺丝。"
                },
                {
                    "id": "765040106",
                    "speaker": "Player",
                    "text": "所以你就跑到屋顶上来找鹰隼了？"
                },
                {
                    "id": "765040107",
                    "speaker": "伊涅芙",
                    "text": "是的。根据该生物的习性，屋顶是其可能的临时停落点。我正在进行全方位的视觉扫描与声音探测，试图定位目标。"
                },
                {
                    "id": "765040108",
                    "speaker": "伊涅芙",
                    "text": "不过，截至目前，并未捕捉到有效踪迹。初步推测，目标已逃离我的追踪范围，或已将「猎物」转移至更隐蔽的巢穴。"
                },
                {
                    "id": "765040109",
                    "speaker": "伊涅芙",
                    "text": "后备计划已启动：重新前往指定供应商处，采购一枚同型号螺丝。"
                },
                {
                    "id": "765040110",
                    "speaker": "伊涅芙",
                    "text": "话说回来。你们出现在高处，难道也在…追踪某种小动物吗？",
                    "choices": [
                        {
                            "id": "765040111",
                            "text": "没有没有。",
                            "response": [
                                {
                                    "id": "765040113",
                                    "speaker": "派蒙",
                                    "text": "对呀对呀，我们本来是想找个视野开阔的地方，拍一拍那夏镇的全景照片，记录下这里繁忙又有活力的样子。"
                                },
                                {
                                    "id": "765040114",
                                    "speaker": "派蒙",
                                    "text": "想不到竟然会在这里遇上正在「追捕小偷」的伊涅芙！这也是一种超小概率的「偏离轨道的惊喜事件」吧！",
                                    "choices": [
                                        {
                                            "id": "765040115",
                                            "text": "机会难得…",
                                            "response": [
                                                {
                                                    "id": "765040117",
                                                    "speaker": "伊涅芙",
                                                    "text": "可以。请指示我需要配合的站立位置、身体朝向以及推荐的面部表情。"
                                                },
                                                {
                                                    "id": "765040118",
                                                    "speaker": "伊涅芙",
                                                    "text": "#我想，我会登上屋顶，然后在这里遇到你们，还能让{NICKNAME}为我拍摄画片，这一系列事件的发生概率，恐怕比那只鹰隼归还螺丝还要低。"
                                                },
                                                {
                                                    "id": "765040119",
                                                    "speaker": "伊涅芙",
                                                    "text": "请务必将这难得的「惊喜」时刻，精确地记录下来。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "765040116",
                                            "text": "可以为你拍摄画片吗？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "765040112",
                            "text": "我只是在寻找拍摄素材。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7650402",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7650404",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "765040401",
                    "speaker": "伊涅芙",
                    "text": "已经想好怎么拍摄了吗？如果需要，我随时都可以配合。"
                }
            ]
        },
        {
            "id": "7650405",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "765040501",
                    "speaker": "Player",
                    "text": "没问题，我们开始留影吧！"
                }
            ]
        },
        {
            "id": "7650406",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "765040601",
                    "speaker": "Player",
                    "text": "请稍等，我再找找灵感。"
                }
            ]
        },
        {
            "id": "7650407",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "765040701",
                    "speaker": "伊涅芙",
                    "text": "#{NICKNAME}，派蒙，你们好。吃了吗？今天有什么特别的预定安排吗？",
                    "choices": [
                        {
                            "id": "765040702",
                            "text": "我们正在四处参观。",
                            "response": [
                                {
                                    "id": "765040704",
                                    "speaker": "伊涅芙",
                                    "text": "了解了。四处走走，用镜头记录见闻，是不错的放松方式。"
                                },
                                {
                                    "id": "765040705",
                                    "speaker": "伊涅芙",
                                    "text": "不过，我没有在你身上检测到留影机呢。是不是出门的时候太匆忙，把它忘在什么地方了？"
                                }
                            ]
                        },
                        {
                            "id": "765040703",
                            "text": "顺便寻找拍摄素材。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7650408",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "765040801",
                    "speaker": "伊涅芙",
                    "text": "找到合适的拍摄素材了吗？不必着急，美好的事物总是值得耐心发掘的。",
                    "choices": [
                        {
                            "id": "765040803",
                            "text": "没问题，我们开始留影吧！",
                            "response": [
                                {
                                    "id": "765040804",
                                    "speaker": "伊涅芙",
                                    "text": "了解了。不过，我没有在你身上检测到留影机呢。是不是出门的时候太匆忙，把它忘在什么地方了？"
                                }
                            ]
                        },
                        {
                            "id": "765040802",
                            "text": "请稍等，我再找找灵感。"
                        }
                    ]
                }
            ]
        }
    ]
}