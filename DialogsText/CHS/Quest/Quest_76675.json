        {
            "id": "7667516",
            "objective": "运送酒桶$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7667505",
            "objective": "运送酒桶",
            "dialogues": [
                {
                    "id": "766750501",
                    "speaker": "法尔伽",
                    "text": "嗯？需要我帮你把酒桶复位吗？还是想要闲聊？",
                    "choices": [
                        {
                            "id": "766750502",
                            "text": "请帮忙复位…",
                            "response": [
                                {
                                    "id": "766750503",
                                    "speaker": "法尔伽",
                                    "text": "好嘞，别放弃，再来一次！"
                                }
                            ]
                        },
                        {
                            "id": "766750504",
                            "text": "想聊会天…",
                            "response": [
                                {
                                    "id": "766750505",
                                    "speaker": "法尔伽",
                                    "text": "之前教导诺艾尔的时候，她一紧张就会把木桶打碎一地，然后说什么也要独自打扫干净。"
                                },
                                {
                                    "id": "766750506",
                                    "speaker": "法尔伽",
                                    "text": "时间一久…她打扫清理的本领，就冠绝整个骑士团了。呵，虽然她本人也没意识到，这其实也是一种「进步」。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7667506",
            "objective": "运送酒桶",
            "dialogues": [
                {
                    "id": "766750601",
                    "speaker": "法尔伽",
                    "text": "嗯？需要我帮你把酒桶复位吗？还是想要闲聊？",
                    "choices": [
                        {
                            "id": "766750602",
                            "text": "请帮忙复位…",
                            "response": [
                                {
                                    "id": "766750603",
                                    "speaker": "法尔伽",
                                    "text": "好嘞，别放弃，再来一次！"
                                }
                            ]
                        },
                        {
                            "id": "766750604",
                            "text": "想聊会天…",
                            "response": [
                                {
                                    "id": "766750605",
                                    "speaker": "法尔伽",
                                    "text": "头一次让雷泽尝试这项训练的时候，他花了整整一天才完成。你猜是为什么？"
                                },
                                {
                                    "id": "766750606",
                                    "speaker": "法尔伽",
                                    "text": "——其中有四分之一天用来移动木桶，四分之三天用来理解我在说什么。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7667507",
            "objective": "运送酒桶",
            "dialogues": [
                {
                    "id": "766750701",
                    "speaker": "法尔伽",
                    "text": "嗯？需要我帮你把酒桶复位吗？还是想要闲聊？",
                    "choices": [
                        {
                            "id": "766750702",
                            "text": "请帮忙复位…",
                            "response": [
                                {
                                    "id": "766750703",
                                    "speaker": "法尔伽",
                                    "text": "好嘞，别放弃，再来一次！"
                                }
                            ]
                        },
                        {
                            "id": "766750704",
                            "text": "想聊会天…",
                            "response": [
                                {
                                    "id": "766750705",
                                    "speaker": "法尔伽",
                                    "text": "关于「火花骑士」需不需要参与这些基础训练，琴和阿贝多曾经认真找我讨论过。"
                                },
                                {
                                    "id": "766750706",
                                    "speaker": "法尔伽",
                                    "text": "基本的骑士训练有助于培养品性…但「火花骑士」毕竟年纪尚小…所以我决定听取她本人的意见。"
                                },
                                {
                                    "id": "766750707",
                                    "speaker": "法尔伽",
                                    "text": "…于是她开开心心地带着炸弹去了训练场。结果我们一致同意，在她稍微再长大一点之前，不再讨论这个议题。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7667508",
            "objective": "运送酒桶",
            "dialogues": [
                {
                    "id": "766750801",
                    "speaker": "法尔伽",
                    "text": "嗯？需要我帮你把酒桶复位吗？还是想要闲聊？",
                    "choices": [
                        {
                            "id": "766750802",
                            "text": "请帮忙复位…",
                            "response": [
                                {
                                    "id": "766750803",
                                    "speaker": "法尔伽",
                                    "text": "好嘞，别放弃，再来一次！"
                                }
                            ]
                        },
                        {
                            "id": "766750804",
                            "text": "想聊会天…",
                            "response": [
                                {
                                    "id": "766750805",
                                    "speaker": "法尔伽",
                                    "text": "说起来，你应该还没见过洛恩吧？那小子我行我素惯了，到了训练的日子也不见人影。"
                                },
                                {
                                    "id": "766750806",
                                    "speaker": "法尔伽",
                                    "text": "后来一问，他说自己跑去捅魔物的老巢了，至于木桶训练嘛…不会还手的目标，他没兴趣。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7667509",
            "objective": "与骑士们交谈",
            "dialogues": [
                {
                    "id": "766750901",
                    "speaker": "温弗里德",
                    "text": "啊！大团长！荣誉骑士！他们回来了——"
                },
                {
                    "id": "766750902",
                    "speaker": "艾克贝特",
                    "text": "回来了——他们回来了——大家！快来迎接！"
                },
                {
                    "id": "766750903",
                    "speaker": "派蒙",
                    "text": "哇呜，居然这么受欢迎…还真有点不好意思呢。"
                },
                {
                    "id": "766750904",
                    "speaker": "莱夫赫姆",
                    "text": "——我隔着几百米就从风里闻出来了！是蒲公英酒的味道！"
                },
                {
                    "id": "766750905",
                    "speaker": "温弗里德",
                    "text": "还是晨曦酒庄出产的特制品！回来了…我的回忆…全都回来了！"
                },
                {
                    "id": "766750906",
                    "speaker": "派蒙",
                    "text": "呃…所以你们迎接的对象不是我们吧…"
                },
                {
                    "id": "766750907",
                    "speaker": "艾克贝特",
                    "text": "嗯…就是这个味道…跟记忆里的一模一样！"
                },
                {
                    "id": "766750908",
                    "speaker": "莱夫赫姆",
                    "text": "真好啊，这么多年了…"
                },
                {
                    "id": "766750909",
                    "speaker": "温弗里德",
                    "text": "我还以为，自己已经忘记晨曦酒庄的酒是什么味道的了。"
                },
                {
                    "id": "766750910",
                    "speaker": "艾克贝特",
                    "text": "酒的味道没变…那清泉镇的老家，应该也什么都没变吧？应该…",
                    "choices": [
                        {
                            "id": "766750911",
                            "text": "……",
                            "response": [
                                {
                                    "id": "766750913",
                                    "speaker": "艾克贝特",
                                    "text": "…谢谢你，荣誉骑士！"
                                },
                                {
                                    "id": "766750914",
                                    "speaker": "法尔伽",
                                    "text": "…好了，别那么激动，还有人没回营吧？等人齐了再开封。你们先去做酒会的准备吧。"
                                },
                                {
                                    "id": "766750915",
                                    "speaker": "温弗里德",
                                    "text": "是！我们这就去准备！"
                                },
                                {
                                    "id": "766750916",
                                    "speaker": "法尔伽",
                                    "text": "…看，我说过的吧：喝酒可是一等一的正经事。"
                                },
                                {
                                    "id": "766750917",
                                    "speaker": "派蒙",
                                    "text": "呜呜…蜜酱胡萝卜煎肉…甜甜花酿鸡…居然能在这吃到这么正宗的蒙德菜…"
                                },
                                {
                                    "id": "766750918",
                                    "speaker": "派蒙",
                                    "text": "咦…法尔伽呢？好像没看到他？总不能是在哪个角落里喝到醉了吧？",
                                    "choices": [
                                        {
                                            "id": "766750919",
                                            "text": "以他的酒量没可能吧？",
                                            "response": [
                                                {
                                                    "id": "766750921",
                                                    "speaker": "派蒙",
                                                    "text": "好…我再吃完一盘就去找你！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "766750920",
                                            "text": "我去找找，你接着吃。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "766750912",
                            "text": "是的，我去过。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7667513",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7667510",
            "objective": "寻找法尔伽",
            "dialogues": [
                {
                    "id": "766751001",
                    "speaker": "法尔伽",
                    "text": "为大家带回美酒的「主角」，怎么跑到这角落里来了？",
                    "choices": [
                        {
                            "id": "766751002",
                            "text": "我倒想问你呢？",
                            "response": [
                                {
                                    "id": "766751004",
                                    "speaker": "法尔伽",
                                    "text": "嗯…其实我杯里的是「特制品」中的「特制品」，只能一个人喝…"
                                },
                                {
                                    "id": "766751005",
                                    "speaker": "法尔伽",
                                    "text": "——不过被你发现就没办法了，就分你一杯吧。",
                                    "choices": [
                                        {
                                            "id": "766751006",
                                            "text": "…我就知道。",
                                            "response": [
                                                {
                                                    "id": "766751008",
                                                    "speaker": "法尔伽",
                                                    "text": "抱歉啦，开个玩笑！我身边现在是一滴酒都没有。你要是想喝的话，回头可以去找欧蜜涅，她那边管够。"
                                                },
                                                {
                                                    "id": "766751009",
                                                    "speaker": "法尔伽",
                                                    "text": "一个营地里总得留下一个没醉的人，来看住喝醉的同伴跟夜里的危险——这是我在远征之初就立下的规矩。"
                                                },
                                                {
                                                    "id": "766751010",
                                                    "speaker": "法尔伽",
                                                    "text": "真不凑巧啊，今天刚刚好轮到我来当这个不能醉的人。"
                                                },
                                                {
                                                    "id": "766751011",
                                                    "speaker": "法尔伽",
                                                    "text": "…所以在他们都喝醉的夜里，我是不能醉的。",
                                                    "choices": [
                                                        {
                                                            "id": "766751012",
                                                            "text": "真就刚刚好这么巧？",
                                                            "response": [
                                                                {
                                                                    "id": "766751014",
                                                                    "speaker": "法尔伽",
                                                                    "text": "谁知道呢？没准命运就是这么喜欢捉弄人？要是晚个一天到，说不定就轮着我在下面畅饮了？"
                                                                },
                                                                {
                                                                    "id": "766751015",
                                                                    "speaker": "法尔伽",
                                                                    "text": "但要是晚个一天，没准你就不会凑巧来到这个营地，也不会凑巧赶上我们的酒会，更没机会像现在这样对话。"
                                                                },
                                                                {
                                                                    "id": "766751016",
                                                                    "speaker": "法尔伽",
                                                                    "text": "什么样的选择会引向什么样的结果，在时候到来之前，谁都说不准。"
                                                                },
                                                                {
                                                                    "id": "766751017",
                                                                    "speaker": "法尔伽",
                                                                    "text": "就像我决定从蒙德出发远征的时候，也没想到会一路走到今天。"
                                                                },
                                                                {
                                                                    "id": "766751018",
                                                                    "speaker": "Player",
                                                                    "text": "发起远征的目的…是狂猎吗？"
                                                                },
                                                                {
                                                                    "id": "766751019",
                                                                    "speaker": "法尔伽",
                                                                    "text": "嗯…从结果来说，确实如此。但在出发的时候，我只「知道」会有一场席卷提瓦特的深渊灾厄正在北方酝酿。"
                                                                },
                                                                {
                                                                    "id": "766751020",
                                                                    "speaker": "法尔伽",
                                                                    "text": "我们也用了些时间来动员筹备…但敌人会在哪里、以什么形式出现？"
                                                                },
                                                                {
                                                                    "id": "766751021",
                                                                    "speaker": "法尔伽",
                                                                    "text": "…这些对出发时的我们而言依旧是未知。只能一路收集情报，做好任何可能用得上的准备。",
                                                                    "choices": [
                                                                        {
                                                                            "id": "766751022",
                                                                            "text": "只有这点情报就发起远征了？",
                                                                            "response": [
                                                                                {
                                                                                    "id": "766751024",
                                                                                    "speaker": "法尔伽",
                                                                                    "text": "呵，学得很快嘛！但很可惜，敌人可不会乖乖等着我们准备万全。"
                                                                                },
                                                                                {
                                                                                    "id": "766751025",
                                                                                    "speaker": "法尔伽",
                                                                                    "text": "在我们犹犹豫豫的时候，深渊也正戕害无数人的性命。早一刻出征，就能早一刻改变他们的命运。"
                                                                                },
                                                                                {
                                                                                    "id": "766751026",
                                                                                    "speaker": "法尔伽",
                                                                                    "text": "——光是知道这条情报，就足够支撑我们发起这场「远征」了。",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "766751027",
                                                                                            "text": "不愧是「北风骑士」…",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "766751029",
                                                                                                    "speaker": "法尔伽",
                                                                                                    "text": "别那么见外，「荣誉骑士」！你不是也一样吗？你的旅途同样改变了许多人的命运。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "766751030",
                                                                                                    "speaker": "法尔伽",
                                                                                                    "text": "无论是从前的蒙德、特瓦林…还是如今的挪德卡莱、远征军…还有我。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "766751031",
                                                                                                    "speaker": "法尔伽",
                                                                                                    "text": "#现在能围着篝火唱着诗歌，喝着美酒畅想未来…都离不开{NICKNAME}，你的出现。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "766751032",
                                                                                                    "speaker": "Player",
                                                                                                    "text": "…我真有那么厉害吗？"
                                                                                                },
                                                                                                {
                                                                                                    "id": "766751033",
                                                                                                    "speaker": "法尔伽",
                                                                                                    "text": "…哈哈，谁又能说得清呢？毕竟命运就是这么捉摸不定的东西。但只要还活着，就总还有希望。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "766751034",
                                                                                                    "speaker": "法尔伽",
                                                                                                    "text": "今晚喝不上的酒，明天也能喝——他们会记得帮我留上一杯的。只要还活着，就有美酒和朋友在明天等着！"
                                                                                                },
                                                                                                {
                                                                                                    "id": "766751035",
                                                                                                    "speaker": "法尔伽",
                                                                                                    "text": "#所以，{NICKNAME}，干了这一杯！敬明天！敬希望！"
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "766751028",
                                                                                            "text": "不愧是「西风骑士团」…"
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "766751023",
                                                                            "text": "不是说情报是行军的基础吗？"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "766751013",
                                                            "text": "在蒲公英酒送到的这天？"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "766751007",
                                            "text": "果然是苹果酿。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "766751003",
                            "text": "怎么一个人喝酒？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7667599",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "766759901",
                    "speaker": "重要线人？",
                    "text": "救——救命啊！"
                },
                {
                    "id": "766759906",
                    "speaker": "法尔伽",
                    "text": "关于「火花骑士」需不需要参与这些基础训练，琴和阿贝多曾经认真找我讨论过。"
                },
                {
                    "id": "766759907",
                    "speaker": "法尔伽",
                    "text": "基本的骑士训练有助于培养品性…但「火花骑士」毕竟年纪尚小…所以我决定听取她本人的意见。"
                },
                {
                    "id": "766759908",
                    "speaker": "法尔伽",
                    "text": "…于是她开开心心地带着炸弹去了训练场。结果我们一致同意，在她稍微再长大一点之前，不再讨论这个议题。"
                },
                {
                    "id": "766759909",
                    "speaker": "法尔伽",
                    "text": "说起来，你应该还没见过洛恩吧？那小子我行我素惯了，到了训练的日子也不见人影。"
                },
                {
                    "id": "766759910",
                    "speaker": "法尔伽",
                    "text": "后来一问，他说自己跑去捅魔物的老巢了，至于木桶训练嘛…不会还手的目标，他没兴趣。"
                }
            ]
        }
    ]
}