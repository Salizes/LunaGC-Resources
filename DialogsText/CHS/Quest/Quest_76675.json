        },
        {
            "id": "7667501",
            "objective": "在西风戍垒与法尔伽对话",
            "dialogues": [
                {
                    "id": "766750101",
                    "speaker": "法尔伽",
                    "text": "…北方有纳尼娜看着，东边就让洛朗去吧…嗯，就先这样。"
                },
                {
                    "id": "766750102",
                    "speaker": "派蒙",
                    "text": "你好呀，法尔伽！"
                },
                {
                    "id": "766750103",
                    "speaker": "法尔伽",
                    "text": "哦？荣誉骑士和派蒙？怎么逛到这营地来了？",
                    "choices": [
                        {
                            "id": "766750104",
                            "text": "到处转着转着就遇上了…",
                            "response": [
                                {
                                    "id": "766750106",
                                    "speaker": "法尔伽",
                                    "text": "没有的事，西风骑士团的营地，就是荣誉骑士的营地，你直接把这儿当成家就好。"
                                },
                                {
                                    "id": "766750107",
                                    "speaker": "法尔伽",
                                    "text": "不过下次过来也可以提前打声招呼，我好让后勤班多准备点好酒好菜来招待你。"
                                },
                                {
                                    "id": "766750108",
                                    "speaker": "派蒙",
                                    "text": "这里就是远征军的营地吗，人比想象的要少欸…"
                                },
                                {
                                    "id": "766750109",
                                    "speaker": "法尔伽",
                                    "text": "远征军里留在这的人不多。剩下的人也被分配到各处巡逻，要说的话…呵，确实有点冷清。"
                                },
                                {
                                    "id": "766750110",
                                    "speaker": "Player",
                                    "text": "剩下的人都在做什么？"
                                },
                                {
                                    "id": "766750111",
                                    "speaker": "法尔伽",
                                    "text": "收集跟深渊相关的各项情报，当然，目前主要是在应付狂猎。"
                                },
                                {
                                    "id": "766750112",
                                    "speaker": "法尔伽",
                                    "text": "收集挪德卡莱各地的情报。虽然雷利尔已经被封印了，但这里的风波还没有彻底平息。"
                                },
                                {
                                    "id": "766750113",
                                    "speaker": "法尔伽",
                                    "text": "收集跟深渊相关的各项情报。虽然挪德卡莱暂时安稳了些，但还是得警惕深渊卷土重来。"
                                },
                                {
                                    "id": "766750114",
                                    "speaker": "法尔伽",
                                    "text": "情报是行军的基础，不只是敌人的动向，还有地理环境、天气变化，都能成为左右战局的胜负手。"
                                },
                                {
                                    "id": "766750115",
                                    "speaker": "法尔伽",
                                    "text": "往后西风骑士团还打算跟北大陆情报网建立长期合作，把这个临时驻地变成一个情报站点。"
                                },
                                {
                                    "id": "766750116",
                                    "speaker": "派蒙",
                                    "text": "情、情报站点？难道是枫丹谍战小说里的那种…"
                                },
                                {
                                    "id": "766750117",
                                    "speaker": "法尔伽",
                                    "text": "哈哈，怎么可能呢！你在那种书里见过这么不设防的营地吗？"
                                },
                                {
                                    "id": "766750118",
                                    "speaker": "法尔伽",
                                    "text": "这些年里我们一路远征，发现提瓦特各地都出现过不同的深渊灾害。它们狡猾异常、形态多变。"
                                },
                                {
                                    "id": "766750119",
                                    "speaker": "法尔伽",
                                    "text": "我希望通过北大陆情报网把远征军的见闻分享出去，也希望继续借此收集深渊的资料。"
                                },
                                {
                                    "id": "766750120",
                                    "speaker": "法尔伽",
                                    "text": "对抗深渊可不是一国一家的事。每天都有无数阵风吹进吹出的挪德卡莱…应该是最适合设立这站点的地方吧。"
                                },
                                {
                                    "id": "766750121",
                                    "speaker": "派蒙",
                                    "text": "原来是这样…这就是「骑士精神」吧！"
                                },
                                {
                                    "id": "766750122",
                                    "speaker": "法尔伽",
                                    "text": "「精神」是挺好，但现实嘛…现在这个站点才刚建立没多久，连周边的地形情报都还不完整。"
                                },
                                {
                                    "id": "766750123",
                                    "speaker": "法尔伽",
                                    "text": "#{NICKNAME}，你要是在附近收集到建材、情报什么的，也记得顺手带些回来？"
                                },
                                {
                                    "id": "766750124",
                                    "speaker": "法尔伽",
                                    "text": "放心，西风骑士团绝对不会亏待自家的「荣誉骑士」。"
                                },
                                {
                                    "id": "766750125",
                                    "speaker": "Player",
                                    "text": "包在我身上！"
                                },
                                {
                                    "id": "766750126",
                                    "speaker": "法尔伽",
                                    "text": "呵，又是一场新的「远征」啊。"
                                },
                                {
                                    "id": "766750127",
                                    "speaker": "温弗里德",
                                    "text": "大——大团长！不好了大团长！"
                                },
                                {
                                    "id": "766750128",
                                    "speaker": "法尔伽",
                                    "text": "嗯？什么情况？"
                                },
                                {
                                    "id": "766750129",
                                    "speaker": "温弗里德",
                                    "text": "今天预定要来的那位客人…被困在山下了！"
                                },
                                {
                                    "id": "766750130",
                                    "speaker": "法尔伽",
                                    "text": "什么！难道是…那位客人？"
                                },
                                {
                                    "id": "766750131",
                                    "speaker": "温弗里德",
                                    "text": "对！就是他！我们的人手都还在其他地方巡逻，现在该从哪里调派…"
                                },
                                {
                                    "id": "766750132",
                                    "speaker": "法尔伽",
                                    "text": "——不用调人了！你指个路，我亲自去！两位，我们回头再见！"
                                },
                                {
                                    "id": "766750133",
                                    "speaker": "Black Screen",
                                    "text": "法尔伽风风火火地离开了…"
                                },
                                {
                                    "id": "766750134",
                                    "speaker": "派蒙",
                                    "text": "…呜哇，头一次见法尔伽这么紧张…那位客人究竟是什么来头？"
                                },
                                {
                                    "id": "766750135",
                                    "speaker": "Player",
                                    "text": "难道是…重要线人？"
                                },
                                {
                                    "id": "766750136",
                                    "speaker": "派蒙",
                                    "text": "感觉有可能！我们也跟上去帮把手吧！"
                                }
                            ]
                        },
                        {
                            "id": "766750105",
                            "text": "打扰到你们了吗？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7667502",
            "objective": "前往寻找「重要人物」",
            "dialogues": []
        },
        {
            "id": "7667503",
            "objective": "为「重要人物」解围",
            "dialogues": []
        },
        {
            "id": "7667504",
            "objective": "查看「重要人物」的情况",
            "dialogues": [
                {
                    "id": "766750401",
                    "speaker": "派蒙",
                    "text": "——嘿，你没事吧？"
                },
                {
                    "id": "766750402",
                    "speaker": "杜纳塔斯",
                    "text": "没、没事…呼，还好你们来得及时，要不然就真赶不上日落了。"
                },
                {
                    "id": "766750403",
                    "speaker": "法尔伽",
                    "text": "…万幸，看起来我们的「重要物资」没出什么大事。"
                },
                {
                    "id": "766750404",
                    "speaker": "派蒙",
                    "text": "呃，是什么物资这么重要…",
                    "choices": [
                        {
                            "id": "766750405",
                            "text": "这就是酒吧。",
                            "response": [
                                {
                                    "id": "766750407",
                                    "speaker": "法尔伽",
                                    "text": "好眼光——这是我们从晨曦酒庄专门订购的蒲公英酒！最纯正的蒙德风味！"
                                },
                                {
                                    "id": "766750408",
                                    "speaker": "杜纳塔斯",
                                    "text": "一路从蒙德运过来，可费了我们好大的劲呢。"
                                },
                                {
                                    "id": "766750409",
                                    "speaker": "法尔伽",
                                    "text": "哈哈，辛苦了老板！晚上的酒会，你也来喝一杯吧？我们可都盼着你来呢！"
                                },
                                {
                                    "id": "766750410",
                                    "speaker": "派蒙",
                                    "text": "…所以你之前这么着急，就只是为了赶晚上的酒会？难得看你正经一次，居然还是为了这么不正经的事…"
                                },
                                {
                                    "id": "766750411",
                                    "speaker": "法尔伽",
                                    "text": "嗯？喝酒不就是一等一的正经事吗？我都想现在就来上一杯了。"
                                },
                                {
                                    "id": "766750412",
                                    "speaker": "杜纳塔斯",
                                    "text": "等、等一等——现在恐怕不太方便！"
                                },
                                {
                                    "id": "766750413",
                                    "speaker": "派蒙",
                                    "text": "是啊是啊，起码先干正事…"
                                },
                                {
                                    "id": "766750414",
                                    "speaker": "杜纳塔斯",
                                    "text": "这酒是特殊定制的，需要长时间滚动防止沉淀来保持口感！现在静置了这么久，估计口感…起码打了九折！"
                                },
                                {
                                    "id": "766750415",
                                    "speaker": "法尔伽",
                                    "text": "九折？可恶！那可绝对不能现在喝了。"
                                },
                                {
                                    "id": "766750416",
                                    "speaker": "派蒙",
                                    "text": "…行吧，你们高兴就好。"
                                },
                                {
                                    "id": "766750417",
                                    "speaker": "Player",
                                    "text": "要怎么恢复口感？"
                                },
                                {
                                    "id": "766750418",
                                    "speaker": "杜纳塔斯",
                                    "text": "我们原本专门找人造了滚动酒桶的机关…不过刚刚像是摔坏了，现在么…估计只能靠人力让它滚起来了吧。"
                                },
                                {
                                    "id": "766750419",
                                    "speaker": "法尔伽",
                                    "text": "唔，所以是要<color=#00E1FFFF>持续打击木桶，让它滚动到目的地</color>吗…听起来很像西风骑士团的传统力量训练啊。"
                                },
                                {
                                    "id": "766750420",
                                    "speaker": "Player",
                                    "text": "西风骑士团还有这训练项目？"
                                },
                                {
                                    "id": "766750421",
                                    "speaker": "法尔伽",
                                    "text": "嗯，这种训练既要控制出手的力度，又要控制打击的角度，提防木桶偏离路线。是许多骑士的入门训练。",
                                    "choices": [
                                        {
                                            "id": "766750422",
                                            "text": "听起来还有点意思。",
                                            "response": [
                                                {
                                                    "id": "766750424",
                                                    "speaker": "法尔伽",
                                                    "text": "哦？「荣誉骑士」也会对骑士团的基础训练感兴趣吗？嗯…离洛朗他们回营也还有一点时间。"
                                                },
                                                {
                                                    "id": "766750425",
                                                    "speaker": "法尔伽",
                                                    "text": "那就交给你了，荣誉骑士。放心，要是一不小心把酒桶滚得太远就跟我说一声，我来帮你扔回原位。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "766750423",
                                            "text": "荣誉骑士也想试试。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "766750406",
                            "text": "怎么闻都是酒吧？"
                        }
                    ]
                }
            ]
        },
