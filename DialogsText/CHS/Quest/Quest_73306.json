    "talks": [
        {
            "id": "7305525",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "730552501",
                    "speaker": "提尔扎德",
                    "text": "…是你们啊，还有什么话要说吗？",
                    "choices": [
                        {
                            "id": "730552502",
                            "text": "关于哲伯莱勒。",
                            "response": [
                                {
                                    "id": "730552503",
                                    "speaker": "提尔扎德",
                                    "text": "…我居然到最后还怀疑了他。我真是个混蛋…"
                                },
                                {
                                    "id": "730552504",
                                    "speaker": "提尔扎德",
                                    "text": "现在我对他只有感谢…"
                                },
                                {
                                    "id": "730552505",
                                    "speaker": "提尔扎德",
                                    "text": "之前我一直摇摆不定，无论是学术上还是生活上…但从今往后我不会再动摇了。我会走自己坚信的那条路，无论有多么艰难…"
                                },
                                {
                                    "id": "730552506",
                                    "speaker": "提尔扎德",
                                    "text": "就算是为了告慰哲伯莱勒…"
                                }
                            ]
                        },
                        {
                            "id": "730552507",
                            "text": "关于赤王。",
                            "response": [
                                {
                                    "id": "730552508",
                                    "speaker": "提尔扎德",
                                    "text": "我开始怀疑自己之前读到的那些文献究竟有多少可信度…"
                                },
                                {
                                    "id": "730552509",
                                    "speaker": "提尔扎德",
                                    "text": "那首「祷文」…有种说不上来的怪异的感觉，还有萨梅尔…说的那些话…有必要回去之后重新深入研究一下。"
                                },
                                {
                                    "id": "730552510",
                                    "speaker": "提尔扎德",
                                    "text": "当然，首要任务还是按原计划写完论文。"
                                }
                            ]
                        },
                        {
                            "id": "730552511",
                            "text": "关于婕德。",
                            "response": [
                                {
                                    "id": "730552512",
                                    "speaker": "提尔扎德",
                                    "text": "唉…我也希望自己能为她做些什么，可是…"
                                },
                                {
                                    "id": "730552513",
                                    "speaker": "提尔扎德",
                                    "text": "我什么都做不到…"
                                },
                                {
                                    "id": "730552514",
                                    "speaker": "提尔扎德",
                                    "text": "她又什么都不肯说，但凡她能说出一个愿望，只要是我力所能及的，我都愿意为她办到…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7305526",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "730552601",
                    "speaker": "婕德",
                    "text": "抱歉…还不能很好地控制自己的情绪。"
                },
                {
                    "id": "730552602",
                    "speaker": "Player",
                    "text": "不要道歉。"
                },
                {
                    "id": "730552603",
                    "speaker": "派蒙",
                    "text": "对啊…婕德很难过，我们都知道的。"
                },
                {
                    "id": "730552604",
                    "speaker": "婕德",
                    "text": "谢谢你们…祝你们今后的旅途一切顺利…"
                },
                {
                    "id": "730552605",
                    "speaker": "派蒙",
                    "text": "唔…也希望婕德今后可以一切顺利…一定会的！"
                }
            ]
        },
        {
            "id": "7305527",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "730552701",
                    "speaker": "博尼法兹",
                    "text": "怎么没有看到奥米德和米尔萨德？难道说他们…"
                },
                {
                    "id": "730552702",
                    "speaker": "纳赫蒂加尔",
                    "text": "他们没事，只是…都各自有了打算，不跟着我们做驮兽生意了。"
                },
                {
                    "id": "730552703",
                    "speaker": "博尼法兹",
                    "text": "啊？那怎么办，光凭我们俩，人手不够吧，还得再招人…可是又没几个人愿意到阿如村来…"
                },
                {
                    "id": "730552704",
                    "speaker": "博尼法兹",
                    "text": "算了，这些事情以后再说，塞琉斯平安回来了就行。下次可不能让它再去这么危险的地方了。"
                },
                {
                    "id": "730552705",
                    "speaker": "纳赫蒂加尔",
                    "text": "你这是说的什么话？我们可是驮兽商人，不让驮兽出去干活，我们吃什么？"
                },
                {
                    "id": "730552706",
                    "speaker": "纳赫蒂加尔",
                    "text": "光喝风可填不饱肚子，再说了，这种地方你张嘴试试，保准一嘴沙…"
                },
                {
                    "id": "730552707",
                    "speaker": "博尼法兹",
                    "text": "那也不能让塞琉斯去冒险啊，我看你身体也挺强健的，不如你来驮货物。"
                },
                {
                    "id": "730552708",
                    "speaker": "纳赫蒂加尔",
                    "text": "？"
                }
            ]
        }
    ]
}