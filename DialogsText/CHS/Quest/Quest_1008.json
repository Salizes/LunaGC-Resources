    "talks": [
        {
            "id": "100808",
            "objective": "（test）隐藏标记阿鸟开启$HIDDEN",
            "dialogues": []
        },
        {
            "id": "100801",
            "objective": "寻找「理水叠山真君」",
            "dialogues": []
        },
        {
            "id": "100802",
            "objective": "与李丁对话$HIDDEN",
            "dialogues": [
                {
                    "id": "10080201",
                    "speaker": "李丁",
                    "text": "仙人饶命！仙人饶命…求仙人网开一面，放我们兄弟一条生路，仙人饶命，仙人饶命…"
                },
                {
                    "id": "10080202",
                    "speaker": "Player",
                    "text": "你怎么了？"
                },
                {
                    "id": "10080203",
                    "speaker": "李丁",
                    "text": "你，你…你是谁？怎么…"
                },
                {
                    "id": "10080204",
                    "speaker": "派蒙",
                    "text": "明明是我们在提问…"
                },
                {
                    "id": "10080205",
                    "speaker": "李丁",
                    "text": "啊！您能在这绝云间安全行走…我知道了！"
                },
                {
                    "id": "10080206",
                    "speaker": "李丁",
                    "text": "您一定是…仙使吧！是仙人派您来解救我兄弟的！"
                },
                {
                    "id": "10080207",
                    "speaker": "派蒙",
                    "text": "这个人到底在说什么呀…"
                },
                {
                    "id": "10080208",
                    "speaker": "李丁",
                    "text": "仙使慈悲，求仙使搭救！我们两兄弟只因实在无钱供养家里，又听人说，琥牢山中的琥珀藏有宝物。"
                },
                {
                    "id": "10080209",
                    "speaker": "李丁",
                    "text": "一时间犯了糊涂，只想从山中琥珀里寻得几件宝物，卖了钱，再回去接济家里…"
                },
                {
                    "id": "10080210",
                    "speaker": "李丁",
                    "text": "我们<color=#00E1FFFF>顺着山路</color>一路往上，但不曾想，我兄弟李当就突然被琥珀给…给吃了！"
                },
                {
                    "id": "10080211",
                    "speaker": "李丁",
                    "text": "我一路奔逃到了这里，细细想来，只怕是我们冲撞了仙家府邸，这是仙人下的惩诫…"
                },
                {
                    "id": "10080212",
                    "speaker": "李丁",
                    "text": "我不知道如何搭救我兄弟，只能在此求仙人开恩…恳求许久，才等来了二位仙使…"
                },
                {
                    "id": "10080213",
                    "speaker": "派蒙",
                    "text": "仙使？我们不是什么仙使，我们也是来找仙人的。"
                },
                {
                    "id": "10080214",
                    "speaker": "李丁",
                    "text": "不，不不不，你们肯定是仙使，你们肯定是仙使！"
                },
                {
                    "id": "10080215",
                    "speaker": "李丁",
                    "text": "李当被关在山里不知道哪个琥珀里面，求仙使慈悲，求仙使搭救…",
                    "choices": [
                        {
                            "id": "10080216",
                            "text": "好吧…我去看看。",
                            "response": [
                                {
                                    "id": "10080217",
                                    "speaker": "李丁",
                                    "text": "好，好！谢谢仙使慈悲，我等以后再也不敢了…"
                                }
                            ]
                        },
                        {
                            "id": "10080218",
                            "text": "本仙知道了，此后莫再犯糊涂。",
                            "response": [
                                {
                                    "id": "10080219",
                                    "speaker": "派蒙",
                                    "text": "呜哇…你还真的入戏了，而且还挺有「仙使」气势的。"
                                },
                                {
                                    "id": "10080220",
                                    "speaker": "李丁",
                                    "text": "谢谢仙使，谢谢仙使，我等以后再也不敢了…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "100803",
            "objective": "敲碎山路旁的琥珀救人$HIDDEN",
            "dialogues": []
        },
        {
            "id": "100804",
            "objective": "敲碎山路旁的琥珀救人",
            "dialogues": []
        },
        {
            "id": "100805",
            "objective": "与李当对话",
            "dialogues": [
                {
                    "id": "10080501",
                    "speaker": "李当",
                    "text": "咳！咳咳，咳…咳咳！"
                },
                {
                    "id": "10080502",
                    "speaker": "李当",
                    "text": "我怎么…是你们救我出来的？谢谢你们…"
                },
                {
                    "id": "10080503",
                    "speaker": "李当",
                    "text": "对了！你们看见过我兄弟吗？他叫李丁，我们俩是一同上山的。"
                },
                {
                    "id": "10080504",
                    "speaker": "李当",
                    "text": "不知道…我兄弟是不是也一样被琥珀给吞了…",
                    "choices": [
                        {
                            "id": "10080505",
                            "text": "就是李丁拜托我来救你的。",
                            "response": [
                                {
                                    "id": "10080506",
                                    "speaker": "李当",
                                    "text": "那他应该是安全了…"
                                },
                                {
                                    "id": "10080509",
                                    "speaker": "李当",
                                    "text": "谢谢您，我这就去找我兄弟。"
                                },
                                {
                                    "id": "10080510",
                                    "speaker": "李当",
                                    "text": "希望不会在路上再被琥珀给吞了…"
                                }
                            ]
                        },
                        {
                            "id": "10080507",
                            "text": "他现在在山顶上。",
                            "response": [
                                {
                                    "id": "10080508",
                                    "speaker": "李当",
                                    "text": "在山顶上？那他应该是安全的…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "100806",
            "objective": "与李丁、李当对话",
            "dialogues": [
                {
                    "id": "10080601",
                    "speaker": "李丁",
                    "text": "谢谢仙使，谢谢仙使救我兄弟。"
                },
                {
                    "id": "10080602",
                    "speaker": "Player",
                    "text": "你们见过仙人吗？"
                },
                {
                    "id": "10080603",
                    "speaker": "李丁",
                    "text": "啊？我们…我们也只是听说，这琥牢山是仙人府邸。"
                },
                {
                    "id": "10080604",
                    "speaker": "李丁",
                    "text": "但我们这种凡夫俗子，自然是无缘得见仙人的。"
                },
                {
                    "id": "10080605",
                    "speaker": "李丁",
                    "text": "不过您贵为仙使，肯定与我们不同。"
                },
                {
                    "id": "10080606",
                    "speaker": "李丁",
                    "text": "啊，对了，可不能再叨扰仙府，我们这就下山，谢谢仙使…"
                },
                {
                    "id": "10080607",
                    "speaker": "李当",
                    "text": "谢谢仙使…"
                },
                {
                    "id": "10080608",
                    "speaker": "派蒙",
                    "text": "…要是我们真是什么「仙使」就好了。"
                },
                {
                    "id": "10080609",
                    "speaker": "派蒙",
                    "text": "总感觉，这位仙人的脾气不太好呢…"
                },
                {
                    "id": "10080610",
                    "speaker": "派蒙",
                    "text": "不过我们也没有做什么坏事，应该也不会…"
                },
                {
                    "id": "10089601",
                    "speaker": "理水叠山真君",
                    "text": "擅扰山门，又私放受诫贼人。"
                },
                {
                    "id": "10089602",
                    "speaker": "理水叠山真君",
                    "text": "无知凡众，还不速速前来领诫！"
                }
            ]
        },
        {
            "id": "100807",
            "objective": "面见「理水叠山真君」",
            "dialogues": [
                {
                    "id": "10080701",
                    "speaker": "理水叠山真君",
                    "text": "…不仅闯入「琥牢山」，毁坏山上琥珀，还擅放了正受诫的贼人。"
                },
                {
                    "id": "10080702",
                    "speaker": "理水叠山真君",
                    "text": "这帮贼人确是不晓仙威，但你们，也同样无礼至极。"
                },
                {
                    "id": "10080703",
                    "speaker": "派蒙",
                    "text": "呜啊！我们，我们是有理由的！",
                    "choices": [
                        {
                            "id": "10080704",
                            "text": "请看这个…",
                            "response": [
                                {
                                    "id": "10080705",
                                    "speaker": "理水叠山真君",
                                    "text": "…「百无禁忌箓」，没想到世间还有此物。"
                                },
                                {
                                    "id": "10080708",
                                    "speaker": "理水叠山真君",
                                    "text": "哦？这是「百无禁忌箓」？世间居然还有此物。"
                                },
                                {
                                    "id": "10080709",
                                    "speaker": "理水叠山真君",
                                    "text": "昔日帝君铸此神箓，赐予凡人，本就数量稀少，千百年来也散失得差不多了…"
                                },
                                {
                                    "id": "10080710",
                                    "speaker": "理水叠山真君",
                                    "text": "你们先陈明详情吧，我会听你们说的，稍后我会查证。"
                                },
                                {
                                    "id": "10080711",
                                    "speaker": "理水叠山真君",
                                    "text": "璃月港也并不远在天边，若有虚言，也骗不过我。"
                                },
                                {
                                    "id": "10080712",
                                    "speaker": "理水叠山真君",
                                    "text": "帝君…遇刺了？"
                                },
                                {
                                    "id": "10080713",
                                    "speaker": "理水叠山真君",
                                    "text": "还是在「请仙典仪」上？！"
                                },
                                {
                                    "id": "10080714",
                                    "speaker": "理水叠山真君",
                                    "text": "璃月…凡间…谁敢如此！不…这世上又有多少力量，能刺杀帝君？"
                                },
                                {
                                    "id": "10080715",
                                    "speaker": "理水叠山真君",
                                    "text": "我等众仙遵帝君律令，护佑璃月。因人间兴盛，逐步退于山野，这本是对凡人的好意。"
                                },
                                {
                                    "id": "10080716",
                                    "speaker": "理水叠山真君",
                                    "text": "但如今…帝君…帝君…唉…"
                                },
                                {
                                    "id": "10080717",
                                    "speaker": "理水叠山真君",
                                    "text": "旅者，你述之事我已知晓。削月筑阳真君延请我等的意思，也已经很明白了。"
                                },
                                {
                                    "id": "10080718",
                                    "speaker": "理水叠山真君",
                                    "text": "待我将此山之事稍作处理，就去会见众仙。"
                                },
                                {
                                    "id": "10080719",
                                    "speaker": "Player",
                                    "text": "话说，那些琥珀是…"
                                },
                                {
                                    "id": "10080720",
                                    "speaker": "派蒙",
                                    "text": "我知道！一定是这位仙人的仙力啦，就和小说里写的一样…"
                                },
                                {
                                    "id": "10080721",
                                    "speaker": "派蒙",
                                    "text": "羽毛就能化为草木，唾液也能化为瀑流。这些琥珀，一定也是类似的形成原理！",
                                    "choices": [
                                        {
                                            "id": "10080722",
                                            "text": "类似「燕窝」的原理吗？",
                                            "response": [
                                                {
                                                    "id": "10080724",
                                                    "speaker": "理水叠山真君",
                                                    "text": "…这又是什么说法。这些琥珀，来自于我植下的花，名叫「踱山葵」。"
                                                },
                                                {
                                                    "id": "10080725",
                                                    "speaker": "理水叠山真君",
                                                    "text": "它本身大部分隐于地下，若被踩到，就会生出琥珀，将入侵者包裹在其中。"
                                                },
                                                {
                                                    "id": "10080726",
                                                    "speaker": "理水叠山真君",
                                                    "text": "我归隐到此处后，为了山门清静，将它种植在四周，这些年为我挡了不少滋扰，不过，也关了许多莫名的东西…"
                                                },
                                                {
                                                    "id": "10080727",
                                                    "speaker": "派蒙",
                                                    "text": "所以，这些「琥珀」，其实都是…活的？"
                                                },
                                                {
                                                    "id": "10080728",
                                                    "speaker": "理水叠山真君",
                                                    "text": "正是如此。所以，若我离开此山，只怕害了无辜性命。"
                                                },
                                                {
                                                    "id": "10080729",
                                                    "speaker": "理水叠山真君",
                                                    "text": "我稍作处理后，就会动身。你们自行速速离去吧。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "10080723",
                                            "text": "…呃，有点恶心。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "10080706",
                            "text": "是削月筑阳真君让我们来…",
                            "response": [
                                {
                                    "id": "10080707",
                                    "speaker": "理水叠山真君",
                                    "text": "削月筑阳真君…他托凡人带口信？"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "100897",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "10089701",
                    "speaker": "李丁",
                    "text": "我都听我兄弟说了，谢谢你们，谢谢你们搭救我兄弟。"
                },
                {
                    "id": "10089702",
                    "speaker": "李丁",
                    "text": "唉，我们也是迫不得已，实在是无钱供养家庭，又听人说，琥牢山上的琥珀中藏有宝物…"
                },
                {
                    "id": "10089703",
                    "speaker": "李当",
                    "text": "我们就鬼迷心窍，偷偷上山，想从琥珀里寻得几件宝物，拿回去卖点钱。"
                },
                {
                    "id": "10089704",
                    "speaker": "李当",
                    "text": "结果…您也看到了，仙人对我施以惩诫，我就被琥珀给吞了下去，如果没你们搭救，还不知道什么时候能出来。"
                },
                {
                    "id": "10089705",
                    "speaker": "李丁",
                    "text": "还好仙人慈悲，派下你们这两位仙使搭救…",
                    "choices": [
                        {
                            "id": "10089706",
                            "text": "仙，仙使？",
                            "response": [
                                {
                                    "id": "10089707",
                                    "speaker": "李丁",
                                    "text": "是啊，我刚在山上祈祷，你们就搭救了我兄弟。"
                                },
                                {
                                    "id": "10089708",
                                    "speaker": "李当",
                                    "text": "你们一定是仙人派下来的仙使。"
                                },
                                {
                                    "id": "10089712",
                                    "speaker": "李丁",
                                    "text": "蒙仙使搭救，我们兄弟以后一定痛改前非，去寻个正路赚钱，哪怕是去码头卖点力气，也是个说法。"
                                },
                                {
                                    "id": "10089713",
                                    "speaker": "李丁",
                                    "text": "啊，对了，可不能再叨扰仙府，我们这就下山，谢谢仙使…"
                                },
                                {
                                    "id": "10089714",
                                    "speaker": "李当",
                                    "text": "谢谢仙使…"
                                },
                                {
                                    "id": "10089715",
                                    "speaker": "派蒙",
                                    "text": "…要是我们真是什么「仙使」就好了。"
                                },
                                {
                                    "id": "10089716",
                                    "speaker": "派蒙",
                                    "text": "总感觉，这位仙人的脾气不太好呢…"
                                },
                                {
                                    "id": "10089717",
                                    "speaker": "派蒙",
                                    "text": "不过我们也没有做什么坏事，应该也不会…"
                                }
                            ]
                        },
                        {
                            "id": "10089709",
                            "text": "本仙知道了，此后莫再犯糊涂。",
                            "response": [
                                {
                                    "id": "10089710",
                                    "speaker": "派蒙",
                                    "text": "…呜哇，你怎么入戏这么快，不过…确实挺有「仙使」气势的。"
                                },
                                {
                                    "id": "10089711",
                                    "speaker": "李丁",
                                    "text": "是，是，我们兄弟受教了。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "100899",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "10089901",
                    "speaker": "李丁",
                    "text": "求仙使救救我兄弟，我也不知道他被关在这座山的哪块琥珀里了…"
                },
                {
                    "id": "10089902",
                    "speaker": "李丁",
                    "text": "但我们俩一直都在<color=#00E1FFFF>顺着山路</color>走，关着他的琥珀也一定在山路旁边。"
                },
                {
                    "id": "10089903",
                    "speaker": "李丁",
                    "text": "求仙使搭救，求仙使搭救…"
                }
            ]
        }
    ]
}