    "talks": [
        {
            "id": "2070101",
            "objective": "与齐格芙丽雅对话",
            "dialogues": [
                {
                    "id": "207010201",
                    "speaker": "Player",
                    "text": "交给我吧。"
                },
                {
                    "id": "207010202",
                    "speaker": "齐格芙丽雅",
                    "text": "太好了！那就拜托你了，我就在这等着你！"
                },
                {
                    "id": "207010203",
                    "speaker": "齐格芙丽雅",
                    "text": "嘿嘿，「翡玉什锦袋」…又可以吃到了…"
                }
            ]
        },
        {
            "id": "2070102",
            "objective": "制作翡玉什锦袋",
            "dialogues": []
        },
        {
            "id": "2070103",
            "objective": "将「翡玉什锦袋」交给齐格芙丽雅",
            "dialogues": [
                {
                    "id": "207010301",
                    "speaker": "Player",
                    "text": "不吃点别的吗？"
                },
                {
                    "id": "207010302",
                    "speaker": "齐格芙丽雅",
                    "text": "唔…别的我也想吃，但要是什么都想吃，那就什么都吃不过来啦。"
                },
                {
                    "id": "207010303",
                    "speaker": "齐格芙丽雅",
                    "text": "总之，我还是先弄清「翡玉什锦袋」的味道吧。"
                }
            ]
        },
        {
            "id": "2070104",
            "objective": "",
            "dialogues": [
                {
                    "id": "207010502",
                    "speaker": "齐格芙丽雅",
                    "text": "…啊，已经吃完了。"
                },
                {
                    "id": "207010503",
                    "speaker": "齐格芙丽雅",
                    "text": "那个蔬菜的口感…火腿和莲子之间的味道搭配…还有这个高汤…"
                },
                {
                    "id": "207010504",
                    "speaker": "齐格芙丽雅",
                    "text": "就是这个味道，这就是我上次吃到的味道！"
                },
                {
                    "id": "207010531",
                    "speaker": "齐格芙丽雅",
                    "text": "谢谢你专门过来给我做菜，我要赶紧回去做笔记了。"
                },
                {
                    "id": "207010532",
                    "speaker": "齐格芙丽雅",
                    "text": "下次，我一定能做出完美的「翡玉什锦袋」。"
                },
                {
                    "id": "207010533",
                    "speaker": "齐格芙丽雅",
                    "text": "到时候，你一定要来尝尝看啊。"
                }
            ]
        },
        {
            "id": "2070105",
            "objective": "",
            "dialogues": [
                {
                    "id": "207010510",
                    "speaker": "齐格芙丽雅",
                    "text": "这火腿的鲜味，蔬菜的口感也刚刚好，还有这微微的辣味…"
                },
                {
                    "id": "207010511",
                    "speaker": "齐格芙丽雅",
                    "text": "嗯，味道真不错，是一份很不错的「翡玉什锦袋」呢！"
                }
            ]
        },
        {
            "id": "2070106",
            "objective": "",
            "dialogues": [
                {
                    "id": "207010520",
                    "speaker": "齐格芙丽雅",
                    "text": "唔…菜叶的口感好干…里面好像还有食材没熟透…"
                },
                {
                    "id": "207010521",
                    "speaker": "齐格芙丽雅",
                    "text": "和之前吃到的味道差太多了…难道，这是你琢磨出的什么新做法？"
                },
                {
                    "id": "207010522",
                    "speaker": "齐格芙丽雅",
                    "text": "总感觉这道菜味道有些不对…不过，也可以作为参考。"
                }
            ]
        },
        {
            "id": "2070107",
            "objective": "与齐格芙丽雅对话",
            "dialogues": []
        },
        {
            "id": "2070101",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "207010101",
                    "speaker": "齐格芙丽雅",
                    "text": "肚子怎么又饿了…"
                },
                {
                    "id": "207010102",
                    "speaker": "齐格芙丽雅",
                    "text": "咦，是你啊！太好了，你还记得我吗？"
                },
                {
                    "id": "207010103",
                    "speaker": "齐格芙丽雅",
                    "text": "香菱，料理对决，是我呀，齐格芙丽雅！"
                },
                {
                    "id": "207010104",
                    "speaker": "齐格芙丽雅",
                    "text": "嘿嘿，记起来了吗，你来得正好，我能不能…拜托你一件事…"
                },
                {
                    "id": "207010105",
                    "speaker": "Player",
                    "text": "什么事？"
                },
                {
                    "id": "207010106",
                    "speaker": "齐格芙丽雅",
                    "text": "你还记得，你上次做的那道「翡玉什锦袋」吗？"
                },
                {
                    "id": "207010107",
                    "speaker": "齐格芙丽雅",
                    "text": "我一直记得那个味道，实在是太好吃了。"
                },
                {
                    "id": "207010108",
                    "speaker": "齐格芙丽雅",
                    "text": "所以，我想要自己也来做一做看，但是…感觉做出来的味道始终都差一点点…"
                },
                {
                    "id": "207010109",
                    "speaker": "齐格芙丽雅",
                    "text": "我觉得，只要再仔细品尝几次，我就能重现那个味道！"
                },
                {
                    "id": "207010110",
                    "speaker": "齐格芙丽雅",
                    "text": "能不能拜托你，再把「翡玉什锦袋」做给我尝尝看？"
                }
            ]
        },
        {
            "id": "2070104",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "207010401",
                    "speaker": "齐格芙丽雅",
                    "text": "太好了，总算可以再吃到你做的「翡玉什锦袋」了。"
                },
                {
                    "id": "207010402",
                    "speaker": "齐格芙丽雅",
                    "text": "虽然我知道菜谱，也摸索清楚了做法，但就是一直还原不了你做的那种味道。"
                },
                {
                    "id": "207010403",
                    "speaker": "齐格芙丽雅",
                    "text": "唉，要是你能多做几次「翡玉什锦袋」给我吃就好了，这道菜里，我还有很多细节想要弄清楚呢…"
                }
            ]
        },
        {
            "id": "2070105",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "207010501",
                    "speaker": "齐格芙丽雅",
                    "text": "「翡玉什锦袋」做好了吗？"
                }
            ]
        }
    ]
}