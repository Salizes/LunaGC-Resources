    "talks": [
        {
            "id": "601101",
            "objective": "返回那夏镇与同伴会合",
            "dialogues": [
                {
                    "id": "60110101",
                    "speaker": "Black Screen",
                    "text": "众人聚在一起，分享了两边发生的事与获得的情报…"
                },
                {
                    "id": "60110102",
                    "speaker": "菈乌玛",
                    "text": "万幸的是，事件危害被控制在了最小程度，只有一些镇民受伤。"
                },
                {
                    "id": "60110103",
                    "speaker": "菈乌玛",
                    "text": "但如今猎月人获得了完整的形体，而我们依然对他的目的一无所知。"
                },
                {
                    "id": "60110104",
                    "speaker": "伊涅芙",
                    "text": "听起来，就像是把凶恶的绒翼龙放归野外了。"
                },
                {
                    "id": "60110105",
                    "speaker": "伊涅芙",
                    "text": "…大家都不熟悉绒翼龙吗？"
                },
                {
                    "id": "60110106",
                    "speaker": "派蒙",
                    "text": "我、我知道，但你的比喻还是太温和了…"
                },
                {
                    "id": "60110107",
                    "speaker": "奈芙尔",
                    "text": "他说这个世界对他来说都无关紧要，或许他暂时还没有和我们冲突的理由。"
                },
                {
                    "id": "60110108",
                    "speaker": "奈芙尔",
                    "text": "如果只是来寻仇的话，那我们眼下也无计可施。"
                },
                {
                    "id": "60110109",
                    "speaker": "雅珂达",
                    "text": "现在辞职还来得及吗？"
                },
                {
                    "id": "60110110",
                    "speaker": "雅珂达",
                    "text": "我开玩笑的，开玩笑的，老板！事到如今肯定跑不掉了嘛！"
                },
                {
                    "id": "60110111",
                    "speaker": "爱诺",
                    "text": "呜…结果我无比自豪的大炮根本就在帮倒忙啊…哼！我马上就把它拆了！",
                    "choices": [
                        {
                            "id": "60110112",
                            "text": "这不是爱诺的错…",
                            "response": [
                                {
                                    "id": "60110114",
                                    "speaker": "派蒙",
                                    "text": "是啊，对付普通的狂猎还是能派上用场的，不要灰心啊。"
                                },
                                {
                                    "id": "60110115",
                                    "speaker": "奈芙尔",
                                    "text": "菲林斯，之后需要你去执灯人那边走些事后流程。但我已经帮你解释过了，他们不会找你麻烦。"
                                },
                                {
                                    "id": "60110116",
                                    "speaker": "菲林斯",
                                    "text": "#不胜感激。我还听说您帮了{M#他}{F#她}很多忙，不然我们也没那么容易接触到真相。"
                                },
                                {
                                    "id": "60110117",
                                    "speaker": "奈芙尔",
                                    "text": "如果你愿意更多展露自己，也不至于落到孤身无援的处境中。"
                                },
                                {
                                    "id": "60110118",
                                    "speaker": "菲林斯",
                                    "text": "呵呵，您的良言我记下了。我会考虑考虑的。"
                                },
                                {
                                    "id": "60110119",
                                    "speaker": "菲林斯",
                                    "text": "如果我能接替索西军士长的位置，想必会受益匪浅。"
                                },
                                {
                                    "id": "60110120",
                                    "speaker": "派蒙",
                                    "text": "什么，你要升官了吗？"
                                },
                                {
                                    "id": "60110121",
                                    "speaker": "Player",
                                    "text": "他在开玩笑…"
                                },
                                {
                                    "id": "60110122",
                                    "speaker": "派蒙",
                                    "text": "这样啊，欸，为什么只有我没有意识到。"
                                },
                                {
                                    "id": "60110123",
                                    "speaker": "菲林斯",
                                    "text": "#{NICKNAME}，如果有空的话，愿意和我来一趟吗？"
                                },
                                {
                                    "id": "60110124",
                                    "speaker": "菲林斯",
                                    "text": "我想送那位先生最后一程。"
                                }
                            ]
                        },
                        {
                            "id": "60110113",
                            "text": "也不是大炮的错…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "601114",
            "objective": "跟随菲林斯",
            "dialogues": []
        },
        {
            "id": "601102",
            "objective": "跟随菲林斯",
            "dialogues": [
                {
                    "id": "60110201",
                    "speaker": "菲林斯",
                    "text": "这位先生，就像是一座灯塔…"
                },
                {
                    "id": "60110202",
                    "speaker": "菲林斯",
                    "text": "他理所当然地存在于这里，为周围的人提供光亮，施予恩惠。但人们习惯了光，就会忽视这盏灯的存在。"
                },
                {
                    "id": "60110203",
                    "speaker": "菲林斯",
                    "text": "渐渐地，渐渐地，他自己也这么认为。"
                },
                {
                    "id": "60110204",
                    "speaker": "菲林斯",
                    "text": "「我做的事没什么大不了的，我做的还不够好，我还需要保持耐心，继续等待…」"
                },
                {
                    "id": "60110205",
                    "speaker": "菲林斯",
                    "text": "或许这是个悲伤的结局，但我依然为他曾照亮过他人的前路而骄傲。"
                },
                {
                    "id": "60110206",
                    "speaker": "菲林斯",
                    "text": "每一道由光而生的影，都会铭记它。"
                },
                {
                    "id": "60110207",
                    "speaker": "派蒙",
                    "text": "真是太可惜了…"
                },
                {
                    "id": "60110208",
                    "speaker": "Player",
                    "text": "我曾听过一个灯之妖精的故事。"
                },
                {
                    "id": "60110209",
                    "speaker": "菲林斯",
                    "text": "哦，那个我也有所耳闻。",
                    "choices": [
                        {
                            "id": "60110210",
                            "text": "对他我也想说同样的话。",
                            "response": [
                                {
                                    "id": "60110212",
                                    "speaker": "菲林斯",
                                    "text": "这样吗？"
                                },
                                {
                                    "id": "60110213",
                                    "speaker": "菲林斯",
                                    "text": "你说得对，即便是这次，我们的努力看上去也是徒劳的，猎月人还是达成了自己的目的。"
                                },
                                {
                                    "id": "60110214",
                                    "speaker": "菲林斯",
                                    "text": "但我们依然会追逐他到最后一刻，哪怕结果仍非我们所愿。"
                                },
                                {
                                    "id": "60110215",
                                    "speaker": "菲林斯",
                                    "text": "这就像是守墓人的工作——"
                                },
                                {
                                    "id": "60110216",
                                    "speaker": "菲林斯",
                                    "text": "绝非是为了令逝者复生，只是为了死地安宁。"
                                },
                                {
                                    "id": "60110217",
                                    "speaker": "Player",
                                    "text": "你能这么想那就好。"
                                },
                                {
                                    "id": "60110218",
                                    "speaker": "菲林斯",
                                    "text": "嗯。"
                                },
                                {
                                    "id": "60110219",
                                    "speaker": "派蒙",
                                    "text": "你、你们在说什么，能解释一下吗？"
                                },
                                {
                                    "id": "60110220",
                                    "speaker": "Player",
                                    "text": "气氛不太好，回去再讲给你听。"
                                },
                                {
                                    "id": "60110221",
                                    "speaker": "派蒙",
                                    "text": "好吧…"
                                },
                                {
                                    "id": "60110222",
                                    "speaker": "菲林斯",
                                    "text": "毕竟这次送葬的主角，并不是那个什么灯之妖精呢。"
                                },
                                {
                                    "id": "60110223",
                                    "speaker": "菲林斯",
                                    "text": "「执光之人，以鲜血践行荣光与正义。」"
                                },
                                {
                                    "id": "60110224",
                                    "speaker": "菲林斯",
                                    "text": "「行迹匆匆，你我即便满身疮痍，也请片刻驻足，回望爱憎。」"
                                },
                                {
                                    "id": "60110225",
                                    "speaker": "菲林斯",
                                    "text": "「直至深夜世界阖眼，那盏无人可见的，只为你一人的灯缓缓亮起。」"
                                },
                                {
                                    "id": "60110226",
                                    "speaker": "菲林斯",
                                    "text": "承蒙关照，索西军士长。"
                                }
                            ]
                        },
                        {
                            "id": "60110211",
                            "text": "不必对结果如此执着。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "601110",
            "objective": "跟随努昂诺塔",
            "dialogues": [
                {
                    "id": "60110801",
                    "speaker": "爱诺",
                    "text": "菲林斯？难得你会到我的蛋卷工坊来。感兴趣的话你就自由参观吧，我忙着呢。"
                },
                {
                    "id": "60110802",
                    "speaker": "菲林斯",
                    "text": "我是来探望您的，可敬的爱诺小姐。我给您带了些镇上的点心，传统黄油口味，您看放在哪…"
                },
                {
                    "id": "60110803",
                    "speaker": "爱诺",
                    "text": "嘘！…别给伊涅芙听见。"
                },
                {
                    "id": "60110804",
                    "speaker": "爱诺",
                    "text": "…你找我有什么事？该不会想说…我的大炮做了坏事，从今往后的狂猎问题都要由执灯人接管了吧？"
                },
                {
                    "id": "60110805",
                    "speaker": "菲林斯",
                    "text": "用我们谁都没有提前预料到的结果，来苛责您这样的天才技术人员？实在太失礼了。"
                },
                {
                    "id": "60110806",
                    "speaker": "菲林斯",
                    "text": "如果真有人这么做，我敢说这世上再也不会有技术突破了。"
                },
                {
                    "id": "60110807",
                    "speaker": "爱诺",
                    "text": "哼，你这话倒挺中听…"
                },
                {
                    "id": "60110808",
                    "speaker": "菲林斯",
                    "text": "能让您感到宽心是我的荣幸。"
                },
                {
                    "id": "60110809",
                    "speaker": "爱诺",
                    "text": "所以，到底有什么事嘛？"
                },
                {
                    "id": "60110810",
                    "speaker": "菲林斯",
                    "text": "您愿意抽空帮我修理这盏灯吗？上次我拿去那夏镇修过一回，但不幸在刚才的战斗中又坏了。"
                },
                {
                    "id": "60110811",
                    "speaker": "爱诺",
                    "text": "修一盏灯？就这点事要我天才爱诺来做？"
                },
                {
                    "id": "60110812",
                    "speaker": "菲林斯",
                    "text": "哦，失礼了，这么看来我应该去委托伊涅芙小姐，那个点心…"
                },
                {
                    "id": "60110813",
                    "speaker": "爱诺",
                    "text": "呃呃呃，我…我是说这点小事费不了什么功夫，坐着等吧，马上就好！"
                },
                {
                    "id": "60110814",
                    "speaker": "菲林斯",
                    "text": "有劳您了。"
                },
                {
                    "id": "60110815",
                    "speaker": "爱诺",
                    "text": "下次再有这种事，你记得一开始就来找我哦！"
                }
            ]
        },
        {
            "id": "601103",
            "objective": "跟随努昂诺塔",
            "dialogues": [
                {
                    "id": "60110401",
                    "speaker": "伊涅芙",
                    "text": "蛋卷制作完毕，请趁热享用。"
                },
                {
                    "id": "60110402",
                    "speaker": "菈乌玛",
                    "text": "感谢你一直将这些事情放在心上，伊涅芙小姐。这份美味是可贵友谊的见证，愿它经年而不变。"
                },
                {
                    "id": "60110403",
                    "speaker": "伊涅芙",
                    "text": "收到。但蛋卷的保质期很短，可能一周即变。"
                },
                {
                    "id": "60110404",
                    "speaker": "菈乌玛",
                    "text": "哦，我说的「经年不变」是…咦？"
                },
                {
                    "id": "60110405",
                    "speaker": "伊涅芙",
                    "text": "嗯？那边似乎藏着一些客人。"
                },
                {
                    "id": "60110406",
                    "speaker": "菈乌玛",
                    "text": "大家循着蛋卷香气而来…没关系，靠近些吧，无须顾忌，伊涅芙小姐是我们的朋友。"
                },
                {
                    "id": "60110407",
                    "speaker": "伊涅芙",
                    "text": "没错。我可以依照各位的喜好，制作一份谷物蛋饼，碾碎成屑分享给大家。"
                },
                {
                    "id": "60110408",
                    "speaker": "菈乌玛",
                    "text": "……"
                },
                {
                    "id": "60110409",
                    "speaker": "伊涅芙",
                    "text": "它们怎么说？"
                },
                {
                    "id": "60110410",
                    "speaker": "菈乌玛",
                    "text": "它们…在谈论你的住址，说想和你回家。"
                }
            ]
        },
        {
            "id": "601109",
            "objective": "跟随努昂诺塔",
            "dialogues": [
                {
                    "id": "60110501",
                    "speaker": "雅珂达",
                    "text": "老板，那个…就是那个…我还是需要探探你的口风…"
                },
                {
                    "id": "60110502",
                    "speaker": "雅珂达",
                    "text": "如果以后我们又要和其他人合作，那「秘闻馆」究竟应该出几成的力啊？"
                },
                {
                    "id": "60110503",
                    "speaker": "奈芙尔",
                    "text": "呵呵。"
                },
                {
                    "id": "60110504",
                    "speaker": "雅珂达",
                    "text": "一成？！是不是太低了点…"
                },
                {
                    "id": "60110505",
                    "speaker": "奈芙尔",
                    "text": "再猜。"
                },
                {
                    "id": "60110506",
                    "speaker": "雅珂达",
                    "text": "不出力？！那不就成了挂名的嘛？还不如散伙呢！"
                },
                {
                    "id": "60110507",
                    "speaker": "奈芙尔",
                    "text": "唉，雅珂达。"
                },
                {
                    "id": "60110508",
                    "speaker": "奈芙尔",
                    "text": "我的意思是，不设上限，不设下限。"
                },
                {
                    "id": "60110509",
                    "speaker": "雅珂达",
                    "text": "噢！不愧是老板，想的就是深远…"
                },
                {
                    "id": "60110510",
                    "speaker": "雅珂达",
                    "text": "不对啊，这不是说了跟没说一样嘛！所以到底是几成啦，老板！"
                }
            ]
        },
        {
            "id": "601111",
            "objective": "跟随努昂诺塔",
            "dialogues": [
                {
                    "id": "60110901",
                    "speaker": "多莉",
                    "text": "哎哟？你们怎么来了？没想到我们还有机会见面啊。"
                },
                {
                    "id": "60110902",
                    "speaker": "派蒙",
                    "text": "之前你去哪儿了啊，不会是跑掉了吧！"
                },
                {
                    "id": "60110903",
                    "speaker": "多莉",
                    "text": "哎呀，怎么会呢，我只是去别的地方谈生意了嘛。"
                },
                {
                    "id": "60110904",
                    "speaker": "多莉",
                    "text": "多亏了你们，才保住了我桑歌玛哈巴依老爷的小店，呜呜呜呜，我好欣慰呀。"
                },
                {
                    "id": "60110905",
                    "speaker": "Player",
                    "text": "演的也太夸张了…"
                },
                {
                    "id": "60110906",
                    "speaker": "多莉",
                    "text": "这哪有半点演的成分在呀？"
                },
                {
                    "id": "60110907",
                    "speaker": "多莉",
                    "text": "早告诉过你们我这儿的价格经济又实惠，可你们还是去了那个什么「秘闻馆」。"
                },
                {
                    "id": "60110908",
                    "speaker": "多莉",
                    "text": "哎，连熟客都一个个离我而去，我不就只能去别处谋生了…"
                },
                {
                    "id": "60110909",
                    "speaker": "Player",
                    "text": "你也太在意「秘闻馆」了…"
                },
                {
                    "id": "60110910",
                    "speaker": "多莉",
                    "text": "那能不在意吗！在国外做小生意本就不容易，现在又遇到了那么厉害的竞争对手…"
                },
                {
                    "id": "60110911",
                    "speaker": "多莉",
                    "text": "哎，算了，富贵有命，我也不抱怨。"
                },
                {
                    "id": "60110912",
                    "speaker": "多莉",
                    "text": "真要说的话，奈芙尔这位老乡在我刚来的时候也帮过我。"
                },
                {
                    "id": "60110913",
                    "speaker": "多莉",
                    "text": "要怪，就怪我这么久都没找到机会给她卖个天大的人情吧！"
                },
                {
                    "id": "60110914",
                    "speaker": "多莉",
                    "text": "你们要是打听到了那位老板娘想要什么的话，千万要记得第一个来找我啊！"
                }
            ]
        },
        {
            "id": "601112",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": []
        },
        {
            "id": "601113",
            "objective": "离开此地",
            "dialogues": []
