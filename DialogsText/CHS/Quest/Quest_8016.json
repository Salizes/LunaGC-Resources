    "talks": [
        {
            "id": "801601",
            "objective": "前往「沃陆之邦」",
            "dialogues": [
                {
                    "id": "80160101",
                    "speaker": "伊安珊",
                    "text": "这么巧，我们的英雄「杜麦{RUBY#[S]希望}尼」还有派蒙，居然会在这里遇到你们。"
                },
                {
                    "id": "80160102",
                    "speaker": "派蒙",
                    "text": "这不是伊安珊教练嘛！你怎么一个人在这里…"
                },
                {
                    "id": "80160103",
                    "speaker": "派蒙",
                    "text": "先、先说好，我可不是刻意来找你的，你的那些减肥和增肌的训练课程我暂时还没有兴趣！"
                },
                {
                    "id": "80160104",
                    "speaker": "伊安珊",
                    "text": "哈哈哈…知道知道，我也不是什么魔鬼教练，一向还是很尊重学员自己的意志的。"
                },
                {
                    "id": "80160105",
                    "speaker": "伊安珊",
                    "text": "不过…适度的有氧训练应该还是百利而无一害的，比如代替我在这一带巡逻一下。",
                    "choices": [
                        {
                            "id": "80160106",
                            "text": "与其说是训练…",
                            "response": [
                                {
                                    "id": "80160108",
                                    "speaker": "伊安珊",
                                    "text": "开个玩笑，你说得没错，我是想找个帮手。"
                                },
                                {
                                    "id": "80160109",
                                    "speaker": "伊安珊",
                                    "text": "最近我们「沃陆之邦」正在筹备一场健美比赛，临时抱佛脚加练的人太多了，以至于附近巡逻都缺了人手。"
                                },
                                {
                                    "id": "80160110",
                                    "speaker": "派蒙",
                                    "text": "所以你在替他们巡逻？你自己不需要准备吗？"
                                },
                                {
                                    "id": "80160111",
                                    "speaker": "伊安珊",
                                    "text": "我就算了吧，一方面是我一向认为只有长期的自律才能呈现最优秀的身体状态，临时抱佛脚没什么意义。"
                                },
                                {
                                    "id": "80160112",
                                    "speaker": "伊安珊",
                                    "text": "另一方面则是…如你们所见我的身材，比较大众的重量级比赛我无法参加，而我所在的重量级又没有对手。"
                                },
                                {
                                    "id": "80160113",
                                    "speaker": "派蒙",
                                    "text": "是这个道理哦…"
                                },
                                {
                                    "id": "80160114",
                                    "speaker": "派蒙",
                                    "text": "欸！看着我干嘛，我才不要和你比！我们才不是一个重量级！"
                                },
                                {
                                    "id": "80160115",
                                    "speaker": "派蒙",
                                    "text": "#{NICKNAME}，我们去帮她巡逻吧，我怕伊安珊一会儿把我抓去比赛了！"
                                },
                                {
                                    "id": "80160116",
                                    "speaker": "伊安珊",
                                    "text": "哈哈哈…真好，一个眼神就搞定了委托的事。",
                                    "choices": [
                                        {
                                            "id": "80160117",
                                            "text": "好吧，看在派蒙的面子上。",
                                            "response": [
                                                {
                                                    "id": "80160119",
                                                    "speaker": "伊安珊",
                                                    "text": "那就谢谢两位了，麻烦确保这一带没有什么异常情况就好，只是最基础的巡逻工作。"
                                                },
                                                {
                                                    "id": "80160120",
                                                    "speaker": "伊安珊",
                                                    "text": "我到另外一边再转转，晚些时候我们回「沃陆之邦」集合吧。"
                                                },
                                                {
                                                    "id": "80160121",
                                                    "speaker": "派蒙",
                                                    "text": "没问题，你快去吧，伊安珊教练。我们很擅长四处闲晃的。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "80160118",
                                            "text": "好吧，看在伊安珊的面子上。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "80160107",
                            "text": "更像是给你帮忙。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "801611",
            "objective": "在「沃陆之邦」附近巡逻",
            "dialogues": []
        },
        {
            "id": "801602",
            "objective": "查看山洞的情况",
            "dialogues": [
                {
                    "id": "80160201",
                    "speaker": "派蒙",
                    "text": "欸，有个丘丘人在这里呢，是在休息吗？看起来好像没什么攻击性。"
                },
                {
                    "id": "80160202",
                    "speaker": "派蒙",
                    "text": "为什么躲在这里呢…"
                },
                {
                    "id": "80160203",
                    "speaker": "派蒙",
                    "text": "啊，你把它吵醒了…"
                },
                {
                    "id": "80160204",
                    "speaker": "派蒙",
                    "text": "嗯？跑掉了…我们在纳塔的名号，已经对丘丘人都这么有威慑力了吗？"
                },
                {
                    "id": "80160205",
                    "speaker": "Player",
                    "text": "好像有东西。"
                },
                {
                    "id": "80160206",
                    "speaker": "派蒙",
                    "text": "你说那个亮晶晶的？刚刚它逃跑的时候从身上掉出来的吧？"
                },
                {
                    "id": "80160207",
                    "speaker": "派蒙",
                    "text": "唔…我猜是它自以为捡到了什么宝贝，准备在这里藏起来吧，没想到这么快就被我们给发现了。"
                },
                {
                    "id": "80160208",
                    "speaker": "派蒙",
                    "text": "我看看我看看，虽然感觉以丘丘人的智慧，应该不是什么好东西…"
                },
                {
                    "id": "80160209",
                    "speaker": "Player",
                    "text": "……！"
                },
                {
                    "id": "80160210",
                    "speaker": "派蒙",
                    "text": "#啊？怎么了，{NICKNAME}，怎么你的表情这么严肃？"
                },
                {
                    "id": "80160211",
                    "speaker": "派蒙",
                    "text": "这不就是一把普通的钥匙吗，不过样式确实有点稀奇，不像是纳塔的风格…嗯…会是哪个国家造的呢？",
                    "choices": [
                        {
                            "id": "80160212",
                            "text": "这是…",
                            "response": [
                                {
                                    "id": "80160214",
                                    "speaker": "派蒙",
                                    "text": "飞船休眠仓？什么飞船，什么休眠仓…"
                                },
                                {
                                    "id": "80160215",
                                    "speaker": "派蒙",
                                    "text": "等等！飞船休眠仓？难、难道说！是你来到提瓦特乘坐的那个飞船？"
                                },
                                {
                                    "id": "80160216",
                                    "speaker": "Player",
                                    "text": "没错。"
                                },
                                {
                                    "id": "80160217",
                                    "speaker": "派蒙",
                                    "text": "怎么会突然出现在这里！你确定不是你刚才自己掉的？",
                                    "choices": [
                                        {
                                            "id": "80160218",
                                            "text": "我的在这里…",
                                            "response": [
                                                {
                                                    "id": "80160220",
                                                    "speaker": "派蒙",
                                                    "text": "哦~看上去一模一样…那么这把不是你的，难道说它应该属于…",
                                                    "choices": [
                                                        {
                                                            "id": "80160221",
                                                            "text": "一共就只有这两把。",
                                                            "response": [
                                                                {
                                                                    "id": "80160223",
                                                                    "speaker": "派蒙",
                                                                    "text": "果然如此…唔，这个时候我才真切地感受到你是个「外星人」…哦不，「降临者」呢。"
                                                                },
                                                                {
                                                                    "id": "80160224",
                                                                    "speaker": "派蒙",
                                                                    "text": "那么这个情况，让我推断一下，逻辑应该是…"
                                                                },
                                                                {
                                                                    "id": "80160225",
                                                                    "speaker": "派蒙",
                                                                    "text": "#丘丘人之所以能在附近捡到这把钥匙并且藏起来，是因为你{M#妹妹}{F#哥哥}在这附近弄丢了它…"
                                                                },
                                                                {
                                                                    "id": "80160226",
                                                                    "speaker": "派蒙",
                                                                    "text": "#也就说明你的{M#妹妹}{F#哥哥}最近曾在这一带活动…",
                                                                    "choices": [
                                                                        {
                                                                            "id": "80160227",
                                                                            "text": "也就是说…",
                                                                            "response": [
                                                                                {
                                                                                    "id": "80160229",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "#是啊…没想到原本只是随口答应帮伊安珊巡逻，结果有了这么重大的发现，甚至还得到了你{M#妹妹}{F#哥哥}的线索…"
                                                                                },
                                                                                {
                                                                                    "id": "80160230",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "我们现在是继续在附近找找线索呢，还是先到「沃陆之邦」找伊安珊呢…"
                                                                                },
                                                                                {
                                                                                    "id": "80160231",
                                                                                    "speaker": "伊安珊",
                                                                                    "text": "你们在这儿啊，辛苦了，看来你们巡逻很用心。"
                                                                                },
                                                                                {
                                                                                    "id": "80160232",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "伊安珊！你怎么过来了，不是应该在「沃陆之邦」集合吗？"
                                                                                },
                                                                                {
                                                                                    "id": "80160233",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "我们正考虑要不要去找你，刚刚有了重大发现！"
                                                                                },
                                                                                {
                                                                                    "id": "80160234",
                                                                                    "speaker": "伊安珊",
                                                                                    "text": "我是来通知你们不用继续巡逻了，因为健美比赛刚刚取消了，一会儿会有巡逻队过来接手。"
                                                                                },
                                                                                {
                                                                                    "id": "80160235",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "等等，发生什么了，这么突然？"
                                                                                },
                                                                                {
                                                                                    "id": "80160236",
                                                                                    "speaker": "伊安珊",
                                                                                    "text": "「深渊教团」打过来了。"
                                                                                },
                                                                                {
                                                                                    "id": "80160237",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "啊？"
                                                                                },
                                                                                {
                                                                                    "id": "80160238",
                                                                                    "speaker": "Player",
                                                                                    "text": "没想到这么快就印证了猜想。"
                                                                                },
                                                                                {
                                                                                    "id": "80160239",
                                                                                    "speaker": "Player",
                                                                                    "text": "#（看来是{M#荧}{F#哥哥}又有行动了。）"
                                                                                },
                                                                                {
                                                                                    "id": "80160240",
                                                                                    "speaker": "Player",
                                                                                    "text": "#（这次一定要把握住机会，与{M#她}{F#他}见面。）"
                                                                                },
                                                                                {
                                                                                    "id": "80160241",
                                                                                    "speaker": "伊安珊",
                                                                                    "text": "我之前对深渊教团的名号有所耳闻，但从未见过它们如此大规模、大范围的行动。"
                                                                                },
                                                                                {
                                                                                    "id": "80160242",
                                                                                    "speaker": "伊安珊",
                                                                                    "text": "简直…像是准备与纳塔整个国家开战一样。"
                                                                                },
                                                                                {
                                                                                    "id": "80160243",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "单单一个「教团」，要与被称为「战争之国」的国家开战？难以置信…"
                                                                                },
                                                                                {
                                                                                    "id": "80160244",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "印象里深渊教团大多情况下都是在暗中活动，这种情况我们也是第一次见…他们到底想要做什么？"
                                                                                },
                                                                                {
                                                                                    "id": "80160245",
                                                                                    "speaker": "伊安珊",
                                                                                    "text": "现在单单从「沃陆之邦」的视角，战况还不够明确。"
                                                                                },
                                                                                {
                                                                                    "id": "80160246",
                                                                                    "speaker": "伊安珊",
                                                                                    "text": "目前「沃陆之邦」的防御应该不成问题，我决定到圣火竞技场去找玛薇卡了解一下情况，毕竟那里才是中枢。"
                                                                                },
                                                                                {
                                                                                    "id": "80160247",
                                                                                    "speaker": "伊安珊",
                                                                                    "text": "#要不要跟我一起，{NICKNAME}，有纳塔的英雄坐镇总归更让人放心一些。",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "80160248",
                                                                                            "text": "我也很需要了解情况。",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "80160250",
                                                                                                    "speaker": "伊安珊",
                                                                                                    "text": "那正好，我们一起过去吧。"
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "80160249",
                                                                                            "text": "我对深渊教团也有所了解。"
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "80160228",
                                                                            "text": "「深渊教团」很可能也来过了。"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "80160222",
                                                            "text": "#一把在我身上，一把属于我{M#妹妹}{F#哥哥}。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "80160219",
                                            "text": "…我一直有好好带在身上。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "80160213",
                            "text": "…飞船休眠仓的钥匙。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "801603",
            "objective": "去「话事处」找玛薇卡",
            "dialogues": [
                {
                    "id": "80160301",
                    "speaker": "伊安珊",
                    "text": "玛薇卡！"
                },
                {
                    "id": "80160302",
                    "speaker": "玛薇卡",
                    "text": "#哦？你们来了，我正准备派人去找你，伊安珊。既然{NICKNAME}也在，那就更好了。"
                },
                {
                    "id": "80160303",
                    "speaker": "伊安珊",
                    "text": "目前战况怎么样？信使们有汇报些什么吗？"
                },
                {
                    "id": "80160304",
                    "speaker": "玛薇卡",
                    "text": "纳塔各地同时有深渊教团的家伙出现，很明显是有组织和计划的。"
                },
                {
                    "id": "80160305",
                    "speaker": "玛薇卡",
                    "text": "敌人数量也不容小觑，如果不是这次的事，我们根本不知道深渊教团的势力在暗中已经发展到了这般规模。"
                },
                {
                    "id": "80160306",
                    "speaker": "伊安珊",
                    "text": "也就是说…倾巢出动来进攻我们？可他们的目的究竟是…"
                },
                {
                    "id": "80160307",
                    "speaker": "玛薇卡",
                    "text": "这也是我所疑惑的，深渊教团过去在纳塔的活动并不多，也从来没有什么过节。"
                },
                {
                    "id": "80160308",
                    "speaker": "伊安珊",
                    "text": "总不能是为了…给刚被纳塔打败的「深渊」报仇吧？"
                },
                {
                    "id": "80160309",
                    "speaker": "派蒙",
                    "text": "虽然这理由听起来很莫名其妙，但如果是他们的话，倒也不奇怪。"
                },
                {
                    "id": "80160310",
                    "speaker": "玛薇卡",
                    "text": "还不能下定论，对方的真实目的还需要多多留意。"
                },
                {
                    "id": "80160311",
                    "speaker": "派蒙",
                    "text": "那你们现在打得过他们吗？伤亡情况怎么样？"
                },
                {
                    "id": "80160312",
                    "speaker": "玛薇卡",
                    "text": "虽说他们是倾巢出动，但深渊教团现在面对的，可是刚刚与真正的深渊正面对抗并且取胜的纳塔勇士们。"
                },
                {
                    "id": "80160313",
                    "speaker": "伊安珊",
                    "text": "没错，而且有一整个国家那么多。"
                },
                {
                    "id": "80160314",
                    "speaker": "玛薇卡",
                    "text": "深渊教团的战力与正牌的「深渊」还是有不小差距的，没有那种无休无止的气势。"
                },
                {
                    "id": "80160315",
                    "speaker": "玛薇卡",
                    "text": "但毕竟也算是「战争」，我们必须重视，尽可能将伤亡降到最低。"
                },
                {
                    "id": "80160316",
                    "speaker": "玛薇卡",
                    "text": "#现在各部族已经积极组织防御了，{NICKNAME}，这次的事件算是纳塔自己的事，你可以选择和我一起留在圣火竞技场…"
                },
                {
                    "id": "80160317",
                    "speaker": "Player",
                    "text": "不，与我有关。"
                },
                {
                    "id": "80160318",
                    "speaker": "玛薇卡",
                    "text": "嗯？你指的是…？",
                    "choices": [
                        {
                            "id": "80160319",
                            "text": "目前深渊教团的领导者…",
                            "response": [
                                {
                                    "id": "80160321",
                                    "speaker": "派蒙",
                                    "text": "是的，就是这么一回事。"
                                },
                                {
                                    "id": "80160322",
                                    "speaker": "玛薇卡",
                                    "text": "没想到…居然还有这层关系在…"
                                },
                                {
                                    "id": "80160323",
                                    "speaker": "玛薇卡",
                                    "text": "#既然如此，你知道{M#她}{F#他}的目的是什么吗？"
                                },
                                {
                                    "id": "80160324",
                                    "speaker": "Player",
                                    "text": "这也是我一直想知道的。"
                                },
                                {
                                    "id": "80160325",
                                    "speaker": "派蒙",
                                    "text": "至少现在，他们两个的关系并不好。"
                                },
                                {
                                    "id": "80160326",
                                    "speaker": "派蒙",
                                    "text": "#{NICKNAME}一直想要找到{M#她}{F#他}，弄清楚到底发生了什么…可对方却似乎一直在回避。"
                                },
                                {
                                    "id": "80160327",
                                    "speaker": "伊安珊",
                                    "text": "原来如此，兄妹矛盾吗…挺常见的，嗯。"
                                },
                                {
                                    "id": "80160328",
                                    "speaker": "派蒙",
                                    "text": "是没错啦…但你真的搞明白情况了吗喂！"
                                },
                                {
                                    "id": "80160329",
                                    "speaker": "玛薇卡",
                                    "text": "不愧是你们，兄妹两个人闹别扭这种事，都能左右世界的命运。"
                                },
                                {
                                    "id": "80160330",
                                    "speaker": "玛薇卡",
                                    "text": "按照我的理解，你现在的立场还是站在我们这边的，并且也是一头雾水，没错吧？",
                                    "choices": [
                                        {
                                            "id": "80160331",
                                            "text": "那是当然。",
                                            "response": [
                                                {
                                                    "id": "80160333",
                                                    "speaker": "玛薇卡",
                                                    "text": "哈哈哈，那我就放心了，一开始听你说的时候，我还担心要陷入两难的局面了。"
                                                },
                                                {
                                                    "id": "80160334",
                                                    "speaker": "玛薇卡",
                                                    "text": "根据已知的情报，深渊教团似乎将主力攻势放在了「烟谜主」部族…"
                                                },
                                                {
                                                    "id": "80160335",
                                                    "speaker": "玛薇卡",
                                                    "text": "如果不想跟我留在这里坐镇中央，我建议你优先去支援「烟谜主」。"
                                                },
                                                {
                                                    "id": "80160336",
                                                    "speaker": "Player",
                                                    "text": "正合我意。"
                                                },
                                                {
                                                    "id": "80160337",
                                                    "speaker": "伊安珊",
                                                    "text": "那我也跟你一起去吧，「沃陆之邦」现在承受的压力很小，战力应该分配给更需要的地方。"
                                                },
                                                {
                                                    "id": "80160338",
                                                    "speaker": "玛薇卡",
                                                    "text": "嗯，拜托你们了，需要支援的话请随时联系我。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "80160332",
                                            "text": "甚至比你们更想揍深渊教团。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "80160320",
                            "text": "#是我的{M#妹妹}{F#哥哥}。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "801604",
            "objective": "前往「烟谜主」进行支援",
            "dialogues": [
                {
                    "id": "80160401",
                    "speaker": "茜特菈莉",
                    "text": "呼…神清气爽。"
                },
                {
                    "id": "80160402",
                    "speaker": "伊安珊",
                    "text": "不愧是黑曜石奶奶，早知道有你在，支援「烟谜主」的必要性就该重新审视一下了。"
                },
                {
                    "id": "80160403",
                    "speaker": "茜特菈莉",
                    "text": "还是深渊教团更应该重新审视下进攻目标才对。"
                },
                {
                    "id": "80160404",
                    "speaker": "伊安珊",
                    "text": "我看刚才他们过来的方向，根据作战经验，应该有深渊教团的据点才对。"
                },
                {
                    "id": "80160405",
                    "speaker": "伊安珊",
                    "text": "不如乘胜追击，一举拔掉他们进攻所依托的据点吧。"
                },
                {
                    "id": "80160406",
                    "speaker": "苏图拉",
                    "text": "刚刚这里是发生了战斗吗？需不需要帮忙？"
                },
                {
                    "id": "80160407",
                    "speaker": "派蒙",
                    "text": "「烟谜主」的战士们也来了！"
                },
                {
                    "id": "80160408",
                    "speaker": "伊安珊",
                    "text": "刚经历过大战，大家的作战协同性就是高。"
                },
                {
                    "id": "80160409",
                    "speaker": "伊安珊",
                    "text": "气势都到这里了，一鼓作气攻上去吧！"
                }
            ]
        },
        {
            "id": "801605",
            "objective": "与茜特菈莉对话",
            "dialogues": [
                {
                    "id": "80160501",
                    "speaker": "派蒙",
                    "text": "欸，是茜特菈莉！"
                },
                {
                    "id": "80160502",
                    "speaker": "茜特菈莉",
                    "text": "你们怎么过来了，是来支援的吗？"
                },
                {
                    "id": "80160503",
                    "speaker": "伊安珊",
                    "text": "情况怎么样了？玛薇卡让我们来的。"
                },
                {
                    "id": "80160504",
                    "speaker": "派蒙",
                    "text": "你居然没缩在家里，在这里晃荡，看来「烟谜主」确实遇到麻烦了吧？"
                },
                {
                    "id": "80160505",
                    "speaker": "茜特菈莉",
                    "text": "麻烦…也谈不上吧，只是让人有点不爽。"
                },
                {
                    "id": "80160506",
                    "speaker": "茜特菈莉",
                    "text": "我听说各个部族里面，「烟谜主」是被集中攻击的那个，真是的…不知道为什么有种被当成软柿子了的感觉，唔…"
                },
                {
                    "id": "80160507",
                    "speaker": "茜特菈莉",
                    "text": "…越想越气，在家完全看不进去书了，哼。"
                },
                {
                    "id": "80160508",
                    "speaker": "派蒙",
                    "text": "原来是这种理由惹到了黑曜石奶奶呀…"
                },
                {
                    "id": "80160509",
                    "speaker": "茜特菈莉",
                    "text": "「深渊教团」吗…名字听起来就没什么品味，像是三流小说里面专门为了让读者一眼就看出是反派阵营的廉价名字…"
                },
                {
                    "id": "80160510",
                    "speaker": "派蒙",
                    "text": "#她这样说你{M#妹妹}{F#哥哥}的组织欸…",
                    "choices": [
                        {
                            "id": "80160511",
                            "text": "我也早就这么觉得。",
                            "response": [
                                {
                                    "id": "80160513",
                                    "speaker": "茜特菈莉",
                                    "text": "#欸？啊？你的意思是{NICKNAME}的{M#妹妹}{F#哥哥}是深渊教团的？"
                                },
                                {
                                    "id": "80160514",
                                    "speaker": "茜特菈莉",
                                    "text": "（虽然是因为刚刚在气头上，但我是不是评价得确实有点过分了…）"
                                },
                                {
                                    "id": "80160515",
                                    "speaker": "伊安珊",
                                    "text": "喂，几位等等再聊吧，是遭遇战。"
                                },
                                {
                                    "id": "80160516",
                                    "speaker": "茜特菈莉",
                                    "text": "太好了！可以撒气的机会送上门来了，又顺带打破了刚刚的尴尬气氛，不用考虑怎么把话圆回来了呢。"
                                },
                                {
                                    "id": "80160517",
                                    "speaker": "派蒙",
                                    "text": "后面半句不说的话会更好，茜特菈莉…总之，大家快上吧！"
                                }
                            ]
                        },
                        {
                            "id": "80160512",
                            "text": "#我要是{M#她}{F#他}早把名字改了。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "801609",
            "objective": "解决深渊教团的魔物",
            "dialogues": []
        },
        {
            "id": "801610",
            "objective": "与茜特菈莉对话",
            "dialogues": []
        },
        {
            "id": "801606",
            "objective": "对深渊教团进行反击",
            "dialogues": []
        },
        {
            "id": "801607",
            "objective": "与茜特菈莉对话",
            "dialogues": [
                {
                    "id": "80160701",
                    "speaker": "伊安珊",
                    "text": "拔除掉据点了，各位辛苦了。"
                },
                {
                    "id": "80160702",
                    "speaker": "派蒙",
                    "text": "不过如此嘛，深渊教团的家伙们。"
                },
                {
                    "id": "80160703",
                    "speaker": "茜特菈莉",
                    "text": "不算令人满意的结果，本来还想听他们亲口向我道歉，然后承认「烟谜主」的实力的…"
                },
                {
                    "id": "80160704",
                    "speaker": "茜特菈莉",
                    "text": "算了，只能回去用庆功酒来补足这份情绪上的落差了。"
                },
                {
                    "id": "80160705",
                    "speaker": "伊安珊",
                    "text": "尽管除掉了这个据点，附近的深渊教团应该会老实一阵子，但是…总觉得不能掉以轻心。"
                },
                {
                    "id": "80160706",
                    "speaker": "伊安珊",
                    "text": "发现了吗，一般来说，据点的攻略越到后期，遭遇的反抗应该越顽强才对…"
                },
                {
                    "id": "80160707",
                    "speaker": "伊安珊",
                    "text": "可刚刚总觉得除了一小部分殊死挣扎的家伙之外，他们好像感知到了什么一样，选择了撤离。"
                },
                {
                    "id": "80160708",
                    "speaker": "茜特菈莉",
                    "text": "哦？这有什么，难道不是战略性放弃了据点吗？"
                },
                {
                    "id": "80160709",
                    "speaker": "伊安珊",
                    "text": "不太像，要知道他们可是会选择贸然挑战一个国家的「深渊教团」，战略上一直很激进，刚刚不像是他们会做出的决策。"
                },
                {
                    "id": "80160710",
                    "speaker": "茜特菈莉",
                    "text": "那就是说，你觉得他们是有什么猫腻咯？"
                },
                {
                    "id": "80160711",
                    "speaker": "伊安珊",
                    "text": "反正目前我们掌握不到任何信息，保持怀疑，做好防御吧。"
                },
                {
                    "id": "80160712",
                    "speaker": "Player",
                    "text": "（结果还是对深渊教团此次的目的一无所知，缺少情报来源…）"
                },
                {
                    "id": "80160713",
                    "speaker": "Player",
                    "text": "#（但如果能见到{M#荧}{F#哥哥}的话，我的问题，纳塔的问题，就都能一并得到解决了吧。）",
                    "choices": [
                        {
                            "id": "80160714",
                            "text": "我准备再去一次「沃陆之邦」。",
                            "response": [
                                {
                                    "id": "80160716",
                                    "speaker": "派蒙",
                                    "text": "你果然还是在意钥匙的事呢…"
                                },
                                {
                                    "id": "80160717",
                                    "speaker": "派蒙",
                                    "text": "也对，如果顺着这条线索可以直接找到你的血亲的话，战争说不定就能提前结束了，你们也能再次相见。"
                                },
                                {
                                    "id": "80160718",
                                    "speaker": "茜特菈莉",
                                    "text": "欸，这就要走了吗，就在我犹豫要不要发出「阶段性庆功酒」的邀请的时候？"
                                },
                                {
                                    "id": "80160719",
                                    "speaker": "伊安珊",
                                    "text": "嗯，你们去吧，这里有我和茜特菈莉在，敬请放心就是了。"
                                }
                            ]
                        },
                        {
                            "id": "80160715",
                            "text": "目前唯一的线索是那把钥匙。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "801608",
            "objective": "离开战场",
            "dialogues": []
        },
        {
            "id": "801610",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "80161001",
                    "speaker": "玛薇卡",
                    "text": "放心，就算始作俑者是你的血亲，我也不可能把责任推在我们的英雄身上。"
                },
                {
                    "id": "80161002",
                    "speaker": "玛薇卡",
                    "text": "#不过，假如真的抓到了你的{M#妹妹}{F#哥哥}，我会好好地给{M#她}{F#他}来上一拳作为教训，你应该没意见吧？"
                }
            ]
        },
        {
            "id": "801699",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "80169901",
                    "speaker": "派蒙",
                    "text": "嗯？之前好像没注意过，这里原来有个山洞。"
                },
                {
                    "id": "80169902",
                    "speaker": "派蒙",
                    "text": "过去瞧瞧吧，毕竟我们是来巡逻的。"
                }
            ]
        }
    ]
}