    "talks": [
        {
            "id": "7222706",
            "objective": "(test)进圈刷狗$HIDDEN",
            "dialogues": [
                {
                    "id": "722270601",
                    "speaker": "阿瑠",
                    "text": "木簧笛是很重要的东西吗…？"
                }
            ]
        },
        {
            "id": "7222701",
            "objective": "(test)阿瑠说话$HIDDEN",
            "dialogues": [
                {
                    "id": "722270101",
                    "speaker": "阿瑠",
                    "text": "#{NICKNAME}{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}战斗的样子，好帅气！"
                },
                {
                    "id": "722270102",
                    "speaker": "派蒙",
                    "text": "原来阿瑠在这里啊！",
                    "choices": [
                        {
                            "id": "722270103",
                            "text": "没事吧？",
                            "response": [
                                {
                                    "id": "722270105",
                                    "speaker": "阿瑠",
                                    "text": "我没事喔！"
                                },
                                {
                                    "id": "722270106",
                                    "speaker": "Player",
                                    "text": "那些魔物…"
                                },
                                {
                                    "id": "722270108",
                                    "speaker": "阿瑠",
                                    "text": "不知道这些怪物是什么地方来的。"
                                },
                                {
                                    "id": "722270109",
                                    "speaker": "派蒙",
                                    "text": "的确，看起来不像是这里的生物呢…"
                                },
                                {
                                    "id": "722270110",
                                    "speaker": "阿瑠",
                                    "text": "嗯。以前，我们这里是没有这些东西的，也没有那些身上很多毛的人和大机器人。"
                                },
                                {
                                    "id": "722270111",
                                    "speaker": "阿瑠",
                                    "text": "以前，我们这里有一种叫「鹈猿兽」的动物。但是它很温顺，而且也很好吃。"
                                },
                                {
                                    "id": "722270112",
                                    "speaker": "Player",
                                    "text": "没听说过。"
                                },
                                {
                                    "id": "722270113",
                                    "speaker": "阿瑠",
                                    "text": "我想也是呢。在我们这里，从什么时候开始，鹈猿兽都消失了，这些家伙却出现了。"
                                },
                                {
                                    "id": "722270114",
                                    "speaker": "阿瑠",
                                    "text": "不知道是不是从「雾海」外面来的呢…"
                                },
                                {
                                    "id": "722270115",
                                    "speaker": "Player",
                                    "text": "外面也有丘丘人之类的魔物。"
                                },
                                {
                                    "id": "722270116",
                                    "speaker": "阿瑠",
                                    "text": "听起来好危险…",
                                    "choices": [
                                        {
                                            "id": "722270117",
                                            "text": "确实很危险。",
                                            "response": [
                                                {
                                                    "id": "722270118",
                                                    "speaker": "派蒙",
                                                    "text": "不过，冒险的经历也很有趣呢！"
                                                },
                                                {
                                                    "id": "722270120",
                                                    "speaker": "阿瑠",
                                                    "text": "我也好想冒险哦！"
                                                },
                                                {
                                                    "id": "722270121",
                                                    "speaker": "派蒙",
                                                    "text": "那阿瑠要好好长大，然后变成了不起的冒险家！"
                                                },
                                                {
                                                    "id": "722270122",
                                                    "speaker": "阿瑠",
                                                    "text": "嗯！"
                                                },
                                                {
                                                    "id": "722270123",
                                                    "speaker": "派蒙",
                                                    "text": "那这座栖木也交给我们吧。毕竟有魔物，阿瑠到处乱跑的话会很危险的。"
                                                },
                                                {
                                                    "id": "722270124",
                                                    "speaker": "Player",
                                                    "text": "交给我们吧。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "722270119",
                                            "text": "不过，冒险很有趣。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "722270104",
                            "text": "没受伤吧。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7222707",
            "objective": "(test)共鸣按钮$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7222708",
            "objective": "(test)共鸣之后cs$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7222702",
            "objective": "(test)记录栖木供奉$HIDDEN",
            "dialogues": [
                {
                    "id": "722270201",
                    "speaker": "阿瑠",
                    "text": "#我要快点长大，然后变成像{NICKNAME}{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}一样的冒险家！"
                }
            ]
        },
        {
            "id": "7222703",
            "objective": "(test)cs树叶生长$HIDDEN",
            "dialogues": [
                {
                    "id": "722270301",
                    "speaker": "派蒙",
                    "text": "这座栖木也好了呢！"
                },
                {
                    "id": "722270302",
                    "speaker": "阿瑠",
                    "text": "太厉害了！这就是真正的冒险家吗？"
                },
                {
                    "id": "722270303",
                    "speaker": "阿瑠",
                    "text": "唔…之前也有别人来过这里。"
                },
                {
                    "id": "722270304",
                    "speaker": "阿瑠",
                    "text": "#但是，都不如{NICKNAME}{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}和派蒙这么厉害！"
                },
                {
                    "id": "722270305",
                    "speaker": "派蒙",
                    "text": "别人？"
                },
                {
                    "id": "722270306",
                    "speaker": "阿瑠",
                    "text": "嗯，他们是来找木簧笛的。",
                    "choices": [
                        {
                            "id": "722270307",
                            "text": "难道是墨田…",
                            "response": [
                                {
                                    "id": "722270309",
                                    "speaker": "派蒙",
                                    "text": "不过，木簧笛到底是什么呀？虽然之前听说是鹤观人的乐器…"
                                },
                                {
                                    "id": "722270310",
                                    "speaker": "阿瑠",
                                    "text": "嗯~的确是一种能发出声音的装置哦。"
                                },
                                {
                                    "id": "722270311",
                                    "speaker": "阿瑠",
                                    "text": "因为雾海，我们这不是很难看清楚东西吗？所以大家就会用木簧笛来传达自己的位置。"
                                },
                                {
                                    "id": "722270312",
                                    "speaker": "阿瑠",
                                    "text": "毕竟靠喊的太吵啦！而且对嗓子不好。"
                                },
                                {
                                    "id": "722270313",
                                    "speaker": "派蒙",
                                    "text": "确实什么都看不见呢…"
                                },
                                {
                                    "id": "722270314",
                                    "speaker": "阿瑠",
                                    "text": "对吧？"
                                },
                                {
                                    "id": "722270315",
                                    "speaker": "阿瑠",
                                    "text": "爸…又爷爷还说，木簧笛的声音可以让迷失在雾里的灵魂找到回家的路。所以是很重要的东西。"
                                },
                                {
                                    "id": "722270316",
                                    "speaker": "派蒙",
                                    "text": "嗯？原来这么重要吗？"
                                },
                                {
                                    "id": "722270317",
                                    "speaker": "Player",
                                    "text": "难怪祭典会需要。"
                                },
                                {
                                    "id": "722270318",
                                    "speaker": "阿瑠",
                                    "text": "#嗯，祭典一定能让{NICKNAME}{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}和派蒙开心的！"
                                },
                                {
                                    "id": "722270319",
                                    "speaker": "阿瑠",
                                    "text": "你们先走吧！我还想在树下待一会儿。"
                                },
                                {
                                    "id": "722270320",
                                    "speaker": "派蒙",
                                    "text": "没问题吗？外面可能有魔物…"
                                },
                                {
                                    "id": "722270321",
                                    "speaker": "阿瑠",
                                    "text": "没问题的哦。"
                                }
                            ]
                        },
                        {
                            "id": "722270308",
                            "text": "难怪凯瑟琳小姐说是高难度委托…"
                        }
                    ]
                }
            ]
        },
