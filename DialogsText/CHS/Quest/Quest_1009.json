    "talks": [
        {
            "id": "100901",
            "objective": "寻找「留云借风真君」",
            "dialogues": []
        },
        {
            "id": "100915",
            "objective": "寻找「留云借风真君」",
            "dialogues": [
                {
                    "id": "10091501",
                    "speaker": "派蒙",
                    "text": "咦？这里怎么有张石桌，上面还摆着这么多餐具，还有酒壶…"
                },
                {
                    "id": "10091502",
                    "speaker": "派蒙",
                    "text": "这旁边的椅子上还刻着字呢，「此处居留云」…"
                },
                {
                    "id": "10091510",
                    "speaker": "派蒙",
                    "text": "「此处坐归终」，还有「此处借帝君」。"
                },
                {
                    "id": "10091503",
                    "speaker": "派蒙",
                    "text": "「帝君」难道说的是「岩王帝君」？「归终」…不知道是什么意思…"
                },
                {
                    "id": "10091504",
                    "speaker": "派蒙",
                    "text": "「留云」…对了，那位削月筑阳真君提到的仙人里，有一位就叫「留云借风真君」来着！"
                },
                {
                    "id": "10091505",
                    "speaker": "派蒙",
                    "text": "这么说来，这里说不定就是那位「留云借风真君」和其他仙人聚餐的地方了。"
                },
                {
                    "id": "10091506",
                    "speaker": "派蒙",
                    "text": "嘿嘿，假如真是这样，那我们做点仙人喜欢的美食，是不是就能引起这位「留云借风真君」的注意了？"
                },
                {
                    "id": "10091507",
                    "speaker": "派蒙",
                    "text": "不过，仙人到底会想要吃什么好吃的呢？完全没有头绪…"
                },
                {
                    "id": "10091508",
                    "speaker": "派蒙",
                    "text": "没办法了，我们去周围看看吧，希望之前来这里供奉的人，能留下一点痕迹，当作参考。"
                },
                {
                    "id": "10091509",
                    "speaker": "派蒙",
                    "text": "对了，你说…仙人会喜欢吃蜜酱胡萝卜煎肉吗？"
                }
            ]
        },
        {
            "id": "100902",
            "objective": "寻找供奉食物的痕迹",
            "dialogues": [
                {
                    "id": "10090201",
                    "speaker": "派蒙",
                    "text": "好像是有人在这里做过菜，是用来供奉仙人的吗？"
                },
                {
                    "id": "10090202",
                    "speaker": "派蒙",
                    "text": "这旁边还有没用完的食材呢。金鱼草…莲蓬…还有豆腐，这道菜可真复杂…"
                },
                {
                    "id": "10090203",
                    "speaker": "派蒙",
                    "text": "哎，看那里，好像是…笔记。"
                },
                {
                    "id": "10090204",
                    "speaker": "派蒙",
                    "text": "这么复杂的菜，也难怪要把做菜的方法用纸记下来…我们仔细看看吧。"
                }
            ]
        },
        {
            "id": "100903",
            "objective": "寻找供奉食物的痕迹",
            "dialogues": [
                {
                    "id": "10090301",
                    "speaker": "派蒙",
                    "text": "呜哇，好多面粉都撒在地上了，在这里做菜的人真马虎…"
                },
                {
                    "id": "10090302",
                    "speaker": "派蒙",
                    "text": "锅里的东西好像是肉…但具体是什么肉就不知道了。"
                },
                {
                    "id": "10090303",
                    "speaker": "派蒙",
                    "text": "这道菜，会不会是为了供奉仙人才做的？"
                },
                {
                    "id": "10090304",
                    "speaker": "派蒙",
                    "text": "嗯…要用到「肉类」和「面粉」的菜…"
                },
                {
                    "id": "10090305",
                    "speaker": "派蒙",
                    "text": "咦？地上怎么丢着一页纸…呃，还有个占了半页的脚印…"
                },
                {
                    "id": "10090306",
                    "speaker": "派蒙",
                    "text": "不过，说不定它和这道菜有关…？"
                }
            ]
        },
        {
            "id": "100904",
            "objective": "寻找供奉食物的痕迹",
            "dialogues": [
                {
                    "id": "10090401",
                    "speaker": "派蒙",
                    "text": "这里好干净，应该是在这里做菜的人细心收拾过了…"
                },
                {
                    "id": "10090402",
                    "speaker": "派蒙",
                    "text": "说不定，正是为了供奉仙人…"
                },
                {
                    "id": "10090403",
                    "speaker": "派蒙",
                    "text": "这些材料是…「松茸」和「兽肉」。"
                },
                {
                    "id": "10090404",
                    "speaker": "派蒙",
                    "text": "菜谱就摊在旁边，在这里做菜的人，真的很有条理啊…"
                }
            ]
        },
        {
