    "talks": [
        {
            "id": "2200501",
            "objective": "与宝儿交谈",
            "dialogues": [
                {
                    "id": "220050101",
                    "speaker": "宝儿",
                    "text": "到底在哪里…"
                },
                {
                    "id": "220050102",
                    "speaker": "Player",
                    "text": "你在做什么？"
                },
                {
                    "id": "220050103",
                    "speaker": "宝儿",
                    "text": "呜哇！你是从哪冒出来的？怎么无声无息的…"
                },
                {
                    "id": "220050104",
                    "speaker": "宝儿",
                    "text": "我？我…是一个学者，正在研究归离原的古代建筑和遗物。你…就叫我宝儿吧。"
                },
                {
                    "id": "220050105",
                    "speaker": "宝儿",
                    "text": "不过，我研究太入神，把一个随身的包裹给弄丢了。"
                },
                {
                    "id": "220050106",
                    "speaker": "宝儿",
                    "text": "那里面是我好不容易找到的宝…文物，你愿意帮我找找吗？",
                    "choices": [
                        {
                            "id": "220050107",
                            "text": "我知道了。",
                            "response": [
                                {
                                    "id": "220050110",
                                    "speaker": "宝儿",
                                    "text": "太好了，应该就掉在附近了…或者再远点，总之，请你仔细找找吧。"
                                }
                            ]
                        },
                        {
                            "id": "220050108",
                            "text": "是什么样的包裹？",
                            "response": [
                                {
                                    "id": "220050111",
                                    "speaker": "宝儿",
                                    "text": "就是…平常大家用的包裹啦，一个四四方方的盒子…"
                                },
                                {
                                    "id": "220050112",
                                    "speaker": "宝儿",
                                    "text": "为什么用这个装文物？呃，因为…这样的盒子方便啊！"
                                },
                                {
                                    "id": "220050113",
                                    "speaker": "宝儿",
                                    "text": "而且，我也在盒子里面垫了好几层衣服，绝对不会损坏文物的，请你快去帮我找找吧。"
                                }
                            ]
                        },
                        {
                            "id": "220050109",
                            "text": "是什么样的文物？",
                            "response": [
                                {
                                    "id": "220050114",
                                    "speaker": "宝儿",
                                    "text": "是…总之是很贵重的文物，哎呀！说了你也不明白啦。"
                                },
                                {
                                    "id": "220050115",
                                    "speaker": "宝儿",
                                    "text": "只有我这种专业人士，才能判断出它的价值，拜托你了，快帮我找找吧。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
