    "talks": [
        {
            "id": "7055501",
            "objective": "与法尔伽等人对话",
            "dialogues": [
                {
                    "id": "705550101",
                    "speaker": "派蒙",
                    "text": "#{NICKNAME}，收工啦？"
                },
                {
                    "id": "705550102",
                    "speaker": "派蒙",
                    "text": "听说，在我跟着格兰菲狄小姐捣鼓外送订单的时候，你把事情办得超漂亮嘛！",
                    "choices": [
                        {
                            "id": "705550103",
                            "text": "这次我的灵感很多哦…",
                            "response": [
                                {
                                    "id": "705550105",
                                    "speaker": "法尔伽",
                                    "text": "…总之，荣誉骑士是目前蒙德最有才华的调饮师之一。"
                                },
                                {
                                    "id": "705550106",
                                    "speaker": "法尔伽",
                                    "text": "#考虑到从业时间，我觉得，{M#他}{F#她}甚至有潜力追上猫尾酒馆的那位小小传说。"
                                },
                                {
                                    "id": "705550107",
                                    "speaker": "格兰菲狄",
                                    "text": "我无条件支持这个决策，大团长，这段时间实在有劳荣誉骑士了。"
                                },
                                {
                                    "id": "705550108",
                                    "speaker": "格兰菲狄",
                                    "text": "饮品小站还会营业一段时间，确保做好迎接远征队员的万全准备。找到合适的店面后，还会试点常态开放…"
                                },
                                {
                                    "id": "705550109",
                                    "speaker": "派蒙",
                                    "text": "好欸！骑士团的大家都要有美味饮料喝了！"
                                },
                                {
                                    "id": "705550110",
                                    "speaker": "法尔伽",
                                    "text": "不愧是赫塔的亲传弟子，格兰菲狄考虑得很周到！"
                                },
                                {
                                    "id": "705550111",
                                    "speaker": "格兰菲狄",
                                    "text": "还有，荣誉骑士开发的新品特调…如果您不介意，要留下配方，将它们作为正式饮品，加入小站的清单吗？",
                                    "choices": [
                                        {
                                            "id": "705550112",
                                            "text": "完全没关系，大家一起喝！",
                                            "response": [
                                                {
                                                    "id": "705550114",
                                                    "speaker": "派蒙",
                                                    "text": "#唔…嗯…感觉{NICKNAME}好像还有什么愿望没有说…我来猜猜看？"
                                                },
                                                {
                                                    "id": "705550115",
                                                    "speaker": "派蒙",
                                                    "text": "以你的性格，应该会要求…标注每一杯特调的来历！"
                                                },
                                                {
                                                    "id": "705550116",
                                                    "speaker": "派蒙",
                                                    "text": "让客人们知道，你是为了谁，受了谁的启发，才完成了这些厉害的作品！",
                                                    "choices": [
                                                        {
                                                            "id": "705550117",
                                                            "text": "完全正确！派蒙最懂我！",
                                                            "response": [
                                                                {
                                                                    "id": "705550119",
                                                                    "speaker": "格兰菲狄",
                                                                    "text": "没有任何问题！如果你们还有需求，我可以请专人拟定文书，申请这些特调的专利。"
                                                                },
                                                                {
                                                                    "id": "705550120",
                                                                    "speaker": "法尔伽",
                                                                    "text": "哈哈哈哈，希望以后新招募的酒保，也能领会我们荣誉骑士的奇妙手法…"
                                                                },
                                                                {
                                                                    "id": "705550121",
                                                                    "speaker": "法尔伽",
                                                                    "text": "不说调出旗鼓相当的杰作，还原荣誉骑士的七成功力，就算顶尖高手！"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "705550118",
                                                            "text": "这一点对大家都很重要！"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "705550113",
                                            "text": "介意的话…好像有点小气？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "705550104",
                            "text": "和大家聊天找到了点子…"
                        }
                    ]
                }
            ]
        }
    ]
}