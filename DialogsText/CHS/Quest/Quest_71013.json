                    "text": "是"
                }
            ]
        },
        {
            "id": "7101307",
            "objective": "选择炼化$HIDDEN",
            "dialogues": [
                {
                    "id": "710130701",
                    "speaker": "遗迹宝藏",
                    "text": "我等卫道世间，是否仅以己心度正邪？"
                }
            ]
        },
        {
            "id": "7101308",
            "objective": "保存选择杀戮$HIDDEN",
            "dialogues": [
                {
                    "id": "710130801",
                    "speaker": "Player",
                    "text": "是"
                }
            ]
        },
        {
            "id": "7101309",
            "objective": "保存选择炼化$HIDDEN",
            "dialogues": [
                {
                    "id": "710130901",
                    "speaker": "遗迹宝藏",
                    "text": "魔物祸乱世间，我等卫道者，心中只需有一句除恶务尽就是！"
                },
                {
                    "id": "710130902",
                    "speaker": "Player",
                    "text": "触摸石碑"
                }
            ]
        },
        {
            "id": "7101310",
            "objective": "尽情杀戮$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7101311",
            "objective": "爱的感化$HIDDEN",
            "dialogues": [
                {
                    "id": "710131001",
                    "speaker": "遗迹宝藏",
                    "text": "我以先前三问问师弟？他却斥我背离本责，又愤愤离去…如能解此三问，或能平定世间。我四处搜寻典籍，潜修于此，并修习魔物言语，希望能探其本质。立碑于此，望后世者能解此三问。"
                },
                {
                    "id": "710131002",
                    "speaker": "Player",
                    "text": "触摸石碑"
                }
            ]
        },
        {
            "id": "7101312",
            "objective": "炼化检测1$HIDDEN",
            "dialogues": [
                {
                    "id": "710130401",
                    "speaker": "Player",
                    "text": "是"
                }
            ]
        },
        {
            "id": "7101313",
            "objective": "炼化检测2$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7101314",
            "objective": "炼化检测3$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7101320",
            "objective": "防止回滚$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7101303",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "710130301",
                    "speaker": "遗迹宝藏",
                    "text": "世间魔物，是否生而为恶？"
                }
            ]
        },
        {
            "id": "7101305",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "710130501",
                    "speaker": "遗迹宝藏",
                    "text": "世间仙凡，是否生而为善？"
                }
            ]
        },
        {
            "id": "7101314",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "710131401",
                    "speaker": "遗迹宝藏",
                    "text": "后世观此碑者，不知你是否得解那三问。"
                },
                {
                    "id": "710131402",
                    "speaker": "遗迹宝藏",
                    "text": "你能观见此文，想必也是与我一样的心性…"
                },
                {
                    "id": "710131403",
                    "speaker": "遗迹宝藏",
                    "text": "<color=#00E1FFFF>若有兴趣，可去池边一探，我在那埋下了些许财帛，你可自取。</color>"
                },
                {
                    "id": "710131404",
                    "speaker": "遗迹宝藏",
                    "text": "但那三问，请你谨记于心，希望有一天，你能寻得解答…"
                }
            ]
        },
        {
            "id": "7101315",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "710131501",
                    "speaker": "遗迹宝藏",
                    "text": "<color=#00E1FFFF>『神之眼』</color>…实是超凡之物，世人皆说此物是上天所赐。却无人能说出，究竟何人可得此神物，又是为何得此神物。"
                },
                {
                    "id": "710131502",
                    "speaker": "遗迹宝藏",
                    "text": "我看典籍中，有人说天道悯人，<color=#00E1FFFF>『神之眼』</color>乃是上天赐予凡人中出类拔萃者，助其降妖除魔，卫道世间。但我…却已经对魔物生不出荡涤之意，只想与他们沟通交流，探其本质。"
                },
                {
                    "id": "710131503",
                    "speaker": "遗迹宝藏",
                    "text": "这<color=#00E1FFFF>『神之眼』</color>…不要也罢了。"
                }
            ]
        },
        {
            "id": "7101316",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "710131601",
                    "speaker": "遗迹宝藏",
                    "text": "后世观此碑者。山中有前碑未观，尚不是观此碑之时。"
                },
                {
                    "id": "710131602",
                    "speaker": "遗迹宝藏",
                    "text": "若真想解我迷惑，可在山中寻碑，依次观看。"
                }
            ]
        },
        {
            "id": "7101317",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "710131701",
                    "speaker": "遗迹宝藏",
                    "text": "后世观此碑者。山中有前碑未观，尚不是观此碑之时。"
                },
