        }
    },
    "talks": [
        {
            "id": "7750501",
            "objective": "与琪琪科娃对话",
            "dialogues": [
                {
                    "id": "775050101",
                    "speaker": "琪琪科娃",
                    "text": "姐姐寄回来的拳谱真不错！"
                },
                {
                    "id": "775050102",
                    "speaker": "琪琪科娃",
                    "text": "我刚刚去车站南边转了两圈，揍了揍不听话的极地熊，活动了一下筋骨…"
                },
                {
                    "id": "775050103",
                    "speaker": "琪琪科娃",
                    "text": "突然，脑袋里「咔啦」一下，闪出了新的灵感，我想想要怎么用语言描述…最好让你们很快就能活用。"
                },
                {
                    "id": "775050104",
                    "speaker": "大喜儿",
                    "text": "哦？是你提过的《枫丹搏击术概论》？我也想读读…"
                },
                {
                    "id": "775050105",
                    "speaker": "琪琪科娃",
                    "text": "好啊，就放在那边，直接拿走都行，看完记得还给我。"
                },
                {
                    "id": "775050106",
                    "speaker": "「燃爆木头人」",
                    "text": "新拳法！好东西！"
                },
                {
                    "id": "775050107",
                    "speaker": "派蒙",
                    "text": "欸？完全没注意到琪琪科娃离开过呀？"
                },
                {
                    "id": "775050108",
                    "speaker": "琪琪科娃",
                    "text": "嘿嘿，这不是显得我身法好，来无影去无踪吗？"
                },
                {
                    "id": "775050109",
                    "speaker": "琪琪科娃",
                    "text": "让我瞧瞧，你们的探索计划完成得怎么样了…"
                },
                {
                    "id": "775050110",
                    "speaker": "琪琪科娃",
                    "text": "这…这么厉害？你们才用了几天时间啊？大喜儿一个多月的进度还不到你们的两成…",
                    "choices": [
                        {
                            "id": "775050111",
                            "text": "我们有特别的探索技巧。",
                            "response": [
                                {
                                    "id": "775050113",
                                    "speaker": "琪琪科娃",
                                    "text": "还是头一次碰见…不，头一次听说，有这么神奇的新人！"
                                },
                                {
                                    "id": "775050114",
                                    "speaker": "琪琪科娃",
                                    "text": "请务必分享你们的心得，肯定能让新人们进步的速度达到以前的三倍以上！"
                                },
                                {
                                    "id": "775050115",
                                    "speaker": "派蒙",
                                    "text": "放心吧，我们本来也是这么打算的。"
                                },
                                {
                                    "id": "775050116",
                                    "speaker": "派蒙",
                                    "text": "#那，{NICKNAME}，我们商量一下，怎么样表达才更简单易懂…"
                                },
                                {
                                    "id": "775050117",
                                    "speaker": "Black Screen",
                                    "text": "和派蒙斟酌了措辞，在琪琪科娃的「冒险技巧共享手册」上，简单写下了这段时间在至冬游历的感悟，特别标注了需要注意的事项…\\n包括但不限于：如何预测野生动物们的动向、如何合理运用臻冰造物辅助探索未知区域、如何在暗中观察的状态下初步判断魔物集群的危险度和警戒圈…"
                                },
                                {
                                    "id": "775050118",
                                    "speaker": "Black Screen",
                                    "text": "从纳塔朋友的角度看，这或许也算是一种「大英雄的经验」？"
                                },
                                {
                                    "id": "775050119",
                                    "speaker": "琪琪科娃",
                                    "text": "我就说嘛，我的直觉真准，一下就发现了两个天才级的新人。"
                                },
                                {
                                    "id": "775050120",
                                    "speaker": "琪琪科娃",
                                    "text": "以后，你们就是互助协会的核心成员了！"
                                },
                                {
                                    "id": "775050121",
                                    "speaker": "琪琪科娃",
                                    "text": "哪天姐姐回来了，我带你们去见她，还能和姐姐学到更多秘密——愚人众精英的限定技巧哦~"
                                },
                                {
                                    "id": "775050122",
                                    "speaker": "派蒙",
                                    "text": "嘿呀，到时候…就请你的姐姐多多指教啦。",
                                    "choices": [
                                        {
                                            "id": "775050123",
                                            "text": "没准我们也能给她个惊喜。",
                                            "response": [
                                                {
                                                    "id": "775050125",
                                                    "speaker": "琪琪科娃",
                                                    "text": "那就这么说定了哦，我随时在海屑镇等着姐姐回来，你们再来！"
                                                },
                                                {
                                                    "id": "775050126",
                                                    "speaker": "琪琪科娃",
                                                    "text": "这次「强化互助会」的活动，差不多算是圆满结束了。我要再补充一批「热诚票券」和立像的部件，留给之后的新人…"
                                                },
                                                {
                                                    "id": "775050127",
                                                    "speaker": "「燃爆木头人」",
                                                    "text": "那杜杜杜麦尼，这次这么走运，居然能跟着你学到真本事…"
                                                },
                                                {
                                                    "id": "775050128",
                                                    "speaker": "「燃爆木头人」",
                                                    "text": "如果还有机会在至冬再见面…请允许我们给你准备一份谢礼！"
                                                },
                                                {
                                                    "id": "775050129",
                                                    "speaker": "「小松果」",
                                                    "text": "爸爸给我的旅费里，确实预留了不少礼物钱，我们会好好挑选的。"
                                                },
                                                {
                                                    "id": "775050130",
                                                    "speaker": "派蒙",
                                                    "text": "倒也不用这么客气啦，你们还是小朋友，旅费要节省一点。"
                                                },
                                                {
                                                    "id": "775050131",
                                                    "speaker": "派蒙",
                                                    "text": "这样才能去更多地方旅行，认识更多朋友嘛。",
                                                    "choices": [
                                                        {
                                                            "id": "775050132",
                                                            "text": "不必学习大人们送礼的习惯哦。",
                                                            "response": [
                                                                {
                                                                    "id": "775050134",
                                                                    "speaker": "「燃爆木头人」",
                                                                    "text": "这一点请绝对放心！待会儿我们就继续去找大白熊们切磋。来到至冬后，我们每天都在进步！"
                                                                },
                                                                {
                                                                    "id": "775050135",
                                                                    "speaker": "「小松果」",
                                                                    "text": "从基本的格斗，到部族里的大家都没怎么用过的铳枪，都会认真学习，回家就给爸爸一个大惊喜…"
                                                                },
                                                                {
                                                                    "id": "775050136",
                                                                    "speaker": "琪琪科娃",
                                                                    "text": "说起来，我之前就注意到了，「小松果」和「燃爆木头人」对你们的用词格外客气欸，都有点像和长辈说话了…"
                                                                },
                                                                {
                                                                    "id": "775050137",
                                                                    "speaker": "Player",
                                                                    "text": "是朋友之间的尊敬哦。"
                                                                },
                                                                {
                                                                    "id": "775050138",
                                                                    "speaker": "派蒙",
                                                                    "text": "啊…对对对！在纳塔那边，只要认真切磋过一次，都会对彼此拿出最高的敬重！"
                                                                },
                                                                {
                                                                    "id": "775050139",
                                                                    "speaker": "琪琪科娃",
                                                                    "text": "原来纳塔朋友这么有礼貌？文雅的程度完全不输枫丹的有钱人嘛…"
                                                                },
                                                                {
                                                                    "id": "775050140",
                                                                    "speaker": "琪琪科娃",
                                                                    "text": "要是哪天，我也有机会去那边玩了，也要千万记得，对每个人和每只龙都用敬称…"
                                                                },
                                                                {
                                                                    "id": "775050141",
                                                                    "speaker": "琪琪科娃",
                                                                    "text": "尤其是木头人提过的那位…阿乔领主！"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "775050133",
                                                            "text": "你们变强的喜讯才是好的礼物。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "775050124",
                                            "text": "没准我们也能帮她点小忙。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "775050112",
                            "text": "你的计划对我们很友好。"
                        }
                    ]
                }
            ]
        }
    ]
}