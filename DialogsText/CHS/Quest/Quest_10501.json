                        },
                        {
                            "id": "105011604",
                            "text": "专门为你做的。",
                            "response": [
                                {
                                    "id": "105011605",
                                    "speaker": "莫娜",
                                    "text": "就，就算你这么说…！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "1050105",
            "objective": "将黄金蟹（普通或美味）赠予莫娜",
            "dialogues": []
        },
        {
            "id": "1050106",
            "objective": "重新启程，前往石门",
            "dialogues": [
                {
                    "id": "105010601",
                    "speaker": "朱老板",
                    "text": "太谢谢你们了，之后也欢迎你们常来啊。"
                },
                {
                    "id": "105010602",
                    "speaker": "朱老板",
                    "text": "前提是这客栈还没关张，哈哈…"
                }
            ]
        },
        {
            "id": "1050107",
            "objective": "与正在歇息的莫娜交谈",
            "dialogues": []
        },
        {
            "id": "1050108",
            "objective": "击退强盗",
            "dialogues": [
                {
                    "id": "105010801",
                    "speaker": "Player",
                    "text": "这个「金丝虾球」…"
                },
                {
                    "id": "105010802",
                    "speaker": "毓华",
                    "text": "选用又大又肥的虾，裹上炸得脆脆的土豆，口感非常奇妙。"
                }
            ]
        },
        {
            "id": "1050109",
            "objective": "与莫娜交谈",
            "dialogues": [
                {
                    "id": "105010501",
                    "speaker": "莫娜",
                    "text": "哼，怎么样？这下算是回应了你们的期待了吧？",
                    "choices": [
                        {
                            "id": "105010502",
                            "text": "战斗力，很厉害…",
                            "response": [
                                {
                                    "id": "105010504",
                                    "speaker": "莫娜",
                                    "text": "对占星术士来说，这可是基本功。"
                                },
                                {
                                    "id": "105010505",
                                    "speaker": "莫娜",
                                    "text": "在占星术的面前谎言毫无意义，「命运」与「真实」都在星空中一览无余。"
                                },
                                {
                                    "id": "105010506",
                                    "speaker": "莫娜",
                                    "text": "虽然结果越具体，就越花时间，但大概的趋势一眼就能明白了。"
                                },
                                {
                                    "id": "105010507",
                                    "speaker": "派蒙",
                                    "text": "可是，一路上好像也有不少失算的时候啊…"
                                },
                                {
                                    "id": "105010508",
                                    "speaker": "莫娜",
                                    "text": "那是因为提瓦特的星空，只展示「此世」的命运与真实。"
                                },
                                {
                                    "id": "105010509",
                                    "speaker": "莫娜",
                                    "text": "只要是和你们有关的事情，就会变得模糊起来，就算是我也没法准确判断。"
                                },
                                {
                                    "id": "105010510",
                                    "speaker": "莫娜",
                                    "text": "所以，我才要和那个继承者见面，结合她的知识，说不定就能洞悉你的命运了。",
                                    "choices": [
                                        {
                                            "id": "105010511",
                                            "text": "有点期待。",
                                            "response": [
                                                {
                                                    "id": "105010513",
                                                    "speaker": "莫娜",
                                                    "text": "呵，无论如何，对你来说都是有益无害的一次旅程。"
                                                },
                                                {
                                                    "id": "105010514",
                                                    "speaker": "莫娜",
                                                    "text": "好了，我也休息够了，那我们就一口气走到<color=#00E1FFFF>蒙德城</color>去吧！"
                                                },
                                                {
                                                    "id": "105010515",
                                                    "speaker": "派蒙",
                                                    "text": "唉，要是有车坐就好了…"
                                                },
                                                {
                                                    "id": "105010516",
                                                    "speaker": "莫娜",
                                                    "text": "你不是不累吗！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "105010512",
                                            "text": "不太抱期望…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "105010503",
                            "text": "看穿强盗的真实，很厉害…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1050103",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "105010301",
                    "speaker": "莫娜",
                    "text": "不用为我费工夫，我一点都不馋…"
                },
                {
                    "id": "105010302",
                    "speaker": "莫娜",
                    "text": "虽然还是有点饿，但…也没什么大不了的。"
                }
            ]
        },
        {
            "id": "1050107",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "105010701",
                    "speaker": "毓华",
                    "text": "请问想点些什么呢？"
                }
            ]
        },
        {
            "id": "1050109",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "105010901",
                    "speaker": "Player",
                    "text": "这个「素鲍鱼」…"
                },
                {
                    "id": "105010902",
                    "speaker": "毓华",
                    "text": "顾名思义，就是素的鲍鱼啦，一点都不输给真正的鲍鱼哦？"
                }
            ]
        },
        {
            "id": "1050111",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "105011101",
                    "speaker": "Player",
                    "text": "这个「腌笃鲜」…"
                },
                {
                    "id": "105011102",
                    "speaker": "毓华",
                    "text": "这是老主顾们特别喜欢的一道菜，笋和肉和火腿一起煮，调出风味浓郁的汤汁。"
                },
                {
                    "id": "105011103",
                    "speaker": "毓华",
                    "text": "要是浇上两勺进饭碗，配多少米饭都不够！"
                }
            ]
        }
    ]
}