    "talks": [
        {
            "id": "1050101",
            "objective": "向蒙德进发，前往望舒客栈",
            "dialogues": [
                {
                    "id": "105010101",
                    "speaker": "派蒙",
                    "text": "既然是莫娜请客，我们想点什么都可以吧？"
                },
                {
                    "id": "105010102",
                    "speaker": "莫娜",
                    "text": "当然，师父是很大方的。不过前提是你们吃得完，浪费食物可不好。"
                }
            ]
        },
        {
            "id": "1050113",
            "objective": "在桌边坐下，接受莫娜的宴请",
            "dialogues": []
        },
        {
            "id": "1050102",
            "objective": "与莫娜交谈，享用美食",
            "dialogues": [
                {
                    "id": "105011201",
                    "speaker": "Player",
                    "text": "那就都点吧。"
                },
                {
                    "id": "105011202",
                    "speaker": "莫娜",
                    "text": "都、都点？！我们只有三…不对，两个半人？太多了吧！"
                },
                {
                    "id": "105011203",
                    "speaker": "派蒙",
                    "text": "派蒙不是这样计数的！而且我想吃的都还没点呢！"
                },
                {
                    "id": "105011204",
                    "speaker": "派蒙",
                    "text": "「松鼠鱼」，「香嫩椒椒鸡」，还有「珍珠翡翠白玉汤」！"
                },
                {
                    "id": "105011205",
                    "speaker": "毓华",
                    "text": "好的，那这边这位客人还需要点什么呢？"
                },
                {
                    "id": "105011206",
                    "speaker": "莫娜",
                    "text": "我，我想随便问一下，现在点的菜，一共大概多少摩拉？"
                },
                {
                    "id": "105011207",
                    "speaker": "毓华",
                    "text": "唔，两万摩拉的样子吧。"
                },
                {
                    "id": "105011208",
                    "speaker": "莫娜",
                    "text": "那不就…呃——我、我只要一碗素面就好了。"
                },
                {
                    "id": "105011209",
                    "speaker": "毓华",
                    "text": "好的，一碗素面是吧。请你们稍坐片刻，马上为你们上菜。"
                },
                {
                    "id": "105011210",
                    "speaker": "派蒙",
                    "text": "其实我吃饭的时候就很奇怪…"
                },
                {
                    "id": "105011211",
                    "speaker": "Player",
                    "text": "她为什么只点了一份素面啊？"
                },
                {
                    "id": "105011212",
                    "speaker": "派蒙",
                    "text": "是因为…她其实很缺钱吗？"
                },
                {
                    "id": "105011213",
                    "speaker": "莫娜",
                    "text": "我都听到了！说了是我请客，怎么可能是因为摩拉这么俗气的理由！"
                },
                {
                    "id": "105011214",
                    "speaker": "莫娜",
                    "text": "占星术士要专注于研究星空，若是被世间凡庸之物扰了心神，就会影响判断。"
                },
                {
                    "id": "105011215",
                    "speaker": "莫娜",
                    "text": "尤其是用摩拉去过度满足生理欲望，是低俗…"
                },
                {
                    "id": "105011216",
                    "speaker": "？？？",
                    "text": "咕咕咕——"
                },
                {
                    "id": "105011217",
                    "speaker": "莫娜",
                    "text": "…又危险的。"
                },
                {
                    "id": "105011218",
                    "speaker": "派蒙",
                    "text": "所以不吃我们点的菜，这也是占星术士的尊严吗？真的好难懂。"
                },
                {
                    "id": "105011219",
                    "speaker": "派蒙",
                    "text": "但只有我们大吃大喝了一顿，会不会不太好？"
                },
                {
                    "id": "105011220",
                    "speaker": "Player",
                    "text": "我来露一手吧。"
                },
                {
                    "id": "105011221",
                    "speaker": "派蒙",
                    "text": "哦，对啊，还可以这样！你等我们一下！"
                }
            ]
        },
        {
            "id": "1050114",
            "objective": "(test)上菜$HIDDEN",
            "dialogues": [
                {
                    "id": "105011401",
                    "speaker": "莫娜",
                    "text": "不用为我费工夫，我一点都不馋…"
                },
                {
                    "id": "105011402",
                    "speaker": "莫娜",
                    "text": "虽然还是有点饿，但…也没什么大不了的。"
                }
            ]
        },
        {
            "id": "1050103",
            "objective": "找掌柜借用厨房，为莫娜加菜",
            "dialogues": [
                {
                    "id": "105010201",
                    "speaker": "淮安",
                    "text": "您好，请问有什么事吗？"
                },
                {
                    "id": "105010202",
                    "speaker": "派蒙",
                    "text": "我们想借这里的厨房用一下。",
                    "choices": [
                        {
                            "id": "105010203",
                            "text": "我的朋友想吃特殊的菜。",
                            "response": [
                                {
                                    "id": "105010205",
                                    "speaker": "淮安",
                                    "text": "原来如此，那当然可以。只要自备食材，厨房就请尽管借用吧。"
                                },
                                {
                                    "id": "105010206",
                                    "speaker": "淮安",
                                    "text": "不过我想多一句嘴，这位客人，想必烹饪技术很精湛吧？",
                                    "choices": [
                                        {
                                            "id": "105010207",
                                            "text": "当然，做什么都是「美味的」。",
                                            "response": [
                                                {
                                                    "id": "105010208",
                                                    "speaker": "淮安",
                                                    "text": "哈哈，果然不凡。其实，我有一个小建议…"
                                                },
                                                {
                                                    "id": "105010211",
                                                    "speaker": "淮安",
                                                    "text": "看您的衣服，像是外国人。但既然来了璃月，要不要试试看做璃月的菜式呢？"
                                                },
                                                {
                                                    "id": "105010212",
                                                    "speaker": "淮安",
                                                    "text": "我这里有一份「黄金蟹」的食谱，是非常经典的「月菜」。"
                                                },
                                                {
                                                    "id": "105010213",
                                                    "speaker": "淮安",
                                                    "text": "裹上面粉的螃蟹先用油炸，再跟姜蒜一起炒，盛到盘里的螃蟹就像躺在黄金上。"
                                                },
                                                {
                                                    "id": "105010214",
                                                    "speaker": "派蒙",
                                                    "text": "黄…黄金蟹！",
                                                    "choices": [
                                                        {
                                                            "id": "105010215",
                                                            "text": "听起来有点麻烦。",
                                                            "response": [
                                                                {
                                                                    "id": "105010217",
                                                                    "speaker": "派蒙",
                                                                    "text": "#黄金蟹！{NICKNAME}，黄金蟹！",
                                                                    "choices": [
                                                                        {
                                                                            "id": "105010218",
                                                                            "text": "知道了知道了，黄金蟹。",
                                                                            "response": [
                                                                                {
                                                                                    "id": "105010220",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "嘿嘿，那我们现在就去做吧。"
                                                                                },
                                                                                {
                                                                                    "id": "105010221",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "凭借你在烹饪上的造诣，肯定一下——就学会了！"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "105010219",
                                                                            "text": "…也算是为你学的吧。"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "105010216",
                                                            "text": "为了莫娜专门学一道菜是不是…"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "105010209",
                                            "text": "也没有…",
                                            "response": [
                                                {
                                                    "id": "105010210",
                                                    "speaker": "淮安",
                                                    "text": "哈哈，真谦虚呢。其实，我有一个小建议…"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "105010204",
                            "text": "我的朋友想吃我亲手做的菜。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1050104",
            "objective": "烹制「黄金蟹」",
            "dialogues": [
                {
                    "id": "105010401",
                    "speaker": "莫娜",
                    "text": "终于到蒙德了，唉，好累啊。"
                },
                {
                    "id": "105010402",
                    "speaker": "莫娜",
                    "text": "想得到伟大而深奥的知识，果然不容易…"
                },
                {
                    "id": "105010403",
                    "speaker": "派蒙",
                    "text": "我倒是没那么累。"
                },
                {
                    "id": "105010404",
                    "speaker": "莫娜",
                    "text": "因为你是飘在天上的啊。"
                },
                {
                    "id": "105010405",
                    "speaker": "派蒙",
                    "text": "唉，看来占星术士也没那么厉害。"
                },
                {
                    "id": "105010406",
                    "speaker": "莫娜",
                    "text": "那是因为你对占星术有太多不切实际的幻想了吧。"
                },
                {
                    "id": "105010407",
                    "speaker": "泰勒",
                    "text": "你们几位，也是在这里歇脚么？"
                },
                {
                    "id": "105010408",
                    "speaker": "派蒙",
                    "text": "请问你是？"
                },
                {
                    "id": "105010409",
                    "speaker": "泰勒",
                    "text": "哦，我们几兄弟都是商人，刚在璃月港做完生意，准备回蒙德。"
                },
                {
                    "id": "105010410",
                    "speaker": "泰勒",
                    "text": "看你们好像挺累的样子，我们订的马车一会儿就来了，要不要一起走？",
                    "choices": [
                        {
                            "id": "105010411",
                            "text": "我也有点累了…",
                            "response": [
                                {
                                    "id": "105010412",
                                    "speaker": "泰勒",
                                    "text": "哈哈，那就一起走吧，路上多几个伴聊聊天。"
                                },
                                {
                                    "id": "105010415",
                                    "speaker": "莫娜",
                                    "text": "没这个需要，快闪开快闪开。"
                                },
                                {
                                    "id": "105010416",
                                    "speaker": "泰勒",
                                    "text": "欸？这位小姐…有什么不方便吗？"
                                },
                                {
                                    "id": "105010417",
                                    "speaker": "莫娜",
                                    "text": "别装模作样了，强盗先生。"
                                },
                                {
                                    "id": "105010418",
                                    "speaker": "莫娜",
                                    "text": "挑路上看起来好欺负的人下手，只要对方上了车，就会把车拉到荒郊野岭，洗劫一通，对吧。"
                                },
                                {
                                    "id": "105010419",
                                    "speaker": "泰勒",
                                    "text": "你、你在说什么？！咱们好心来搭话，却被当驴肝肺，还血口喷人！"
                                },
                                {
                                    "id": "105010420",
                                    "speaker": "泰勒",
                                    "text": "不坐车就不坐，神经病。"
                                },
                                {
                                    "id": "105010421",
                                    "speaker": "莫娜",
                                    "text": "那，要不要我现在说说你们身上，有哪些东西是抢来的？"
                                },
                                {
                                    "id": "105010422",
                                    "speaker": "莫娜",
                                    "text": "不服气的话，我说完之后，找人来对质一番，就什么都明白了。"
                                },
                                {
                                    "id": "105010423",
                                    "speaker": "莫娜",
                                    "text": "如果我输了，我愿意赔你两万摩拉。如果我赢了，那你们就得去璃月港吃牢饭。"
                                },
                                {
                                    "id": "105010424",
                                    "speaker": "莫娜",
                                    "text": "怎么样，要真是正经做生意的人，没什么不敢的吧？"
                                },
                                {
                                    "id": "105010425",
                                    "speaker": "泰勒",
                                    "text": "你、你…！"
                                },
                                {
                                    "id": "105010426",
                                    "speaker": "泰勒",
                                    "text": "你真是把我惹毛了！小丫头！"
                                },
                                {
                                    "id": "105010427",
                                    "speaker": "泰勒",
                                    "text": "我不知道你是怎么知道的，但只要灭了你的口，就不会有人知道了！"
                                }
                            ]
                        },
                        {
                            "id": "105010413",
                            "text": "要收钱吗？",
                            "response": [
                                {
                                    "id": "105010414",
                                    "speaker": "泰勒",
                                    "text": "不用啦不用啦，反正是顺路的。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "1050110",
            "objective": "(test)交付黄金蟹$HIDDEN",
            "dialogues": [
                {
                    "id": "105011001",
                    "speaker": "Player",
                    "text": "这个「蟹黄豆腐」…"
                },
                {
                    "id": "105011002",
                    "speaker": "毓华",
                    "text": "虽然豆腐这种食材普普通通，但和蟹黄简直是天造地设的一对，是我们的招牌菜之一呢。"
                }
            ]
        },
        {
            "id": "1050111",
            "objective": "(test)交付之后对话A$HIDDEN",
            "dialogues": [
                {
                    "id": "105011501",
                    "speaker": "莫娜",
                    "text": "这、这个香味是…",
                    "choices": [
                        {
                            "id": "105011502",
                            "text": "就当是素面的配菜了。",
                            "response": [
                                {
                                    "id": "105011503",
                                    "speaker": "莫娜",
                                    "text": "没想到会这么豪华…"
                                },
                                {
                                    "id": "105011506",
                                    "speaker": "莫娜",
                                    "text": "好吧。看在弟子这么辛苦，也花了心思的份上，我就勉为其难地接受吧。"
                                },
                                {
                                    "id": "105011507",
                                    "speaker": "莫娜",
                                    "text": "…唔唔！好棒的味道！这是我最近吃过最好吃的菜了！"
                                },
                                {
                                    "id": "105011508",
                                    "speaker": "莫娜",
                                    "text": "啊，那个，我是说…咳咳，没想到徒弟如此擅长烹饪，为师很是欣慰。",
                                    "choices": [
                                        {
                                            "id": "105011509",
                                            "text": "能吃饱就好。",
                                            "response": [
                                                {
                                                    "id": "105011511",
                                                    "speaker": "莫娜",
                                                    "text": "璃月佳肴的美味，不是说说而已啊。"
                                                },
                                                {
                                                    "id": "105011512",
                                                    "speaker": "莫娜",
                                                    "text": "这么一想，花了这么多摩拉也不是那么心痛了…"
                                                },
                                                {
                                                    "id": "105011513",
                                                    "speaker": "莫娜",
                                                    "text": "啊，没什么，没什么。吃饱喝足，我们该出发了。"
                                                },
                                                {
                                                    "id": "105011514",
                                                    "speaker": "莫娜",
                                                    "text": "从这里继续往北，就能抵达<color=#00E1FFFF>石门</color>，然后就进入蒙德境内了。"
                                                },
                                                {
                                                    "id": "105011515",
                                                    "speaker": "莫娜",
                                                    "text": "究竟能学到多么深奥的知识呢？哼哼，真是期待。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "105011510",
                                            "text": "明明吃得很开心。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "105011504",
                            "text": "专门为你做的。",
                            "response": [
                                {
                                    "id": "105011505",
                                    "speaker": "莫娜",
                                    "text": "就，就算你这么说…！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
