    "talks": [
        {
            "id": "303002",
            "objective": "与天目十五对话",
            "dialogues": [
                {
                    "id": "30300201",
                    "speaker": "派蒙",
                    "text": "到天目锻冶屋了！"
                },
                {
                    "id": "30300202",
                    "speaker": "天目十五",
                    "text": "噢，许久不见了。"
                },
                {
                    "id": "30300203",
                    "speaker": "Player",
                    "text": "您好，我想打听一些消息。"
                },
                {
                    "id": "30300204",
                    "speaker": "天目十五",
                    "text": "当然可以啦，请说。",
                    "choices": [
                        {
                            "id": "30300205",
                            "text": "关于「雷电五传」的事…",
                            "response": [
                                {
                                    "id": "30300207",
                                    "speaker": "天目十五",
                                    "text": "噢，没想到你会问起这些…也好，想知道的话，我就再说说。"
                                },
                                {
                                    "id": "30300208",
                                    "speaker": "天目十五",
                                    "text": "曾享誉稻妻的「雷电五传」，乃是这五支：天目、经津、一心、百目、千手。"
                                },
                                {
                                    "id": "30300209",
                                    "speaker": "天目十五",
                                    "text": "五方所用的锻造技艺，最初是由将军大人亲自传下，经诸多天赋异禀的工匠改进后变得越发优异。"
                                },
                                {
                                    "id": "30300210",
                                    "speaker": "天目十五",
                                    "text": "后来，这些锻刀世家渐渐都没落了。流传至今的，原本只有我们「天目」一脉。"
                                },
                                {
                                    "id": "30300211",
                                    "speaker": "天目十五",
                                    "text": "但好在近期枫原万叶回到稻妻，继承了「一心传」的技艺。如此一来，五传算是还剩两家。"
                                },
                                {
                                    "id": "30300212",
                                    "speaker": "天目十五",
                                    "text": "要是我没记错，他锻刀那次，你也在场呢。"
                                },
                                {
                                    "id": "30300213",
                                    "speaker": "派蒙",
                                    "text": "这么一说我也想起来了，是有这回事！"
                                },
                                {
                                    "id": "30300214",
                                    "speaker": "派蒙",
                                    "text": "当时就听说了雷电五传没落的事，听得我好唏嘘呀…"
                                },
                                {
                                    "id": "30300215",
                                    "speaker": "Player",
                                    "text": "那没落的原因是…？"
                                },
                                {
                                    "id": "30300216",
                                    "speaker": "天目十五",
                                    "text": "…唉。如此说起来，又是一段伤心事。"
                                },
                                {
                                    "id": "30300217",
                                    "speaker": "天目十五",
                                    "text": "本来，那都不是我能知道的东西，但我多年来只听说各家衰落，至今不清楚缘由…在意之下，就请教了枫原万叶。"
                                },
                                {
                                    "id": "30300218",
                                    "speaker": "天目十五",
                                    "text": "他告诉我，同为雷电五传后人，他认为我应当知道这些。"
                                },
                                {
                                    "id": "30300219",
                                    "speaker": "天目十五",
                                    "text": "…告诉你也无妨。只不过，这个故事并不让人高兴就是了。"
                                },
                                {
                                    "id": "30300220",
                                    "speaker": "天目十五",
                                    "text": "——雷电五传，是被一个杀红了眼的刀匠后人给报复了。"
                                },
                                {
                                    "id": "30300221",
                                    "speaker": "派蒙",
                                    "text": "报复？为什么呢？"
                                },
                                {
                                    "id": "30300222",
                                    "speaker": "天目十五",
                                    "text": "传说四百余年前踏鞴砂的炉心发生事故。某位刀匠当时在场，为救众人，不顾自己安危冲入炉中…"
                                },
                                {
                                    "id": "30300223",
                                    "speaker": "天目十五",
                                    "text": "踏鞴砂的锻造冶炼技术十分了得，而当年负责管理踏鞴砂的造兵司正姓丹羽，丹羽与枫原有姻亲。"
                                },
                                {
                                    "id": "30300224",
                                    "speaker": "天目十五",
                                    "text": "造兵司正丹羽大人与那名刀匠一同跃入炉中，这之后，炉心似乎安稳下来，但他们二人也…"
                                },
                                {
                                    "id": "30300225",
                                    "speaker": "天目十五",
                                    "text": "刀匠家一落千丈，他的儿子因而成了无人照看的孤儿，每一天都活在憎恨之中。"
                                },
                                {
                                    "id": "30300226",
                                    "speaker": "天目十五",
                                    "text": "他将此事归咎于整个稻妻，憎恨将军大人对父亲的死不闻不问，憎恨一切未能挽救他父亲的人…"
                                },
                                {
                                    "id": "30300227",
                                    "speaker": "天目十五",
                                    "text": "他很无力，只能将落魄之恨传给子孙。这户人家便世世代代背负着恨意，过着苦闷的生活。"
                                },
                                {
                                    "id": "30300228",
                                    "speaker": "天目十五",
                                    "text": "原本，故事到这里就可以结束了。但百年前那代家主对现状极为不满，又无力翻身。"
                                },
                                {
                                    "id": "30300229",
                                    "speaker": "天目十五",
                                    "text": "最终…他做出一个极为偏激的决定——向雷电五传复仇，泄愤之余还能动摇稻妻的锻造业根基。"
                                },
                                {
                                    "id": "30300230",
                                    "speaker": "天目十五",
                                    "text": "那人来自百目家族，却连自家的其他匠人都杀。近百年前，就是他主导了一切攻击。"
                                },
                                {
                                    "id": "30300231",
                                    "speaker": "天目十五",
                                    "text": "然而，对付枫原家与神里家的后人与刀匠时，因有旁人在场，他遭到猛烈反击，当场死去了。"
                                },
                                {
                                    "id": "30300232",
                                    "speaker": "天目十五",
                                    "text": "也是因为这样，枫原所代表的「一心流」才未遭到灭绝，姑且能说是不幸中的万幸。"
                                },
                                {
                                    "id": "30300233",
                                    "speaker": "Player",
                                    "text": "（有关雷电五传的传说变得不一样了，当时加害诸位刀匠的竟然另有其人？）"
                                },
                                {
                                    "id": "30300234",
                                    "speaker": "Player",
                                    "text": "（看来，散兵确实对世界树做了什么。但…丹羽似乎还是死去了。）"
                                },
                                {
                                    "id": "30300235",
                                    "speaker": "派蒙",
                                    "text": "#{NICKNAME}，你还有其他要问的吗？"
                                },
                                {
                                    "id": "30300236",
                                    "speaker": "Player",
                                    "text": "您这几天见过万叶吗？"
                                },
                                {
                                    "id": "30300237",
                                    "speaker": "天目十五",
                                    "text": "枫原万叶啊，昨天还来我这坐了坐，聊了会儿天，喝了杯茶。看他的样子，精神还不错呢。"
                                },
                                {
                                    "id": "30300238",
                                    "speaker": "Player",
                                    "text": "（太好了，人还存在…而且没有什么异样，怎么说都比昨晚想的极端情况好得多。）"
                                },
                                {
                                    "id": "30300239",
                                    "speaker": "Player",
                                    "text": "我没有其他问题了，谢谢您。"
                                },
                                {
                                    "id": "30300240",
                                    "speaker": "天目十五",
                                    "text": "不用客气。"
                                },
                                {
                                    "id": "30300241",
                                    "speaker": "派蒙",
                                    "text": "看你的表情，是不是还要去其他地方呀？哼哼，我可是很会察言观色的哦！"
                                },
                                {
                                    "id": "30300242",
                                    "speaker": "派蒙",
                                    "text": "那么出发吧，前往下一站！你走前面，我跟着就是。"
                                }
                            ]
                        },
                        {
                            "id": "30300206",
                            "text": "能再对我说一遍吗？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "303010",
            "objective": "前往社奉行府",
            "dialogues": [
                {
                    "id": "30301201",
                    "speaker": "古田",
                    "text": "都是实话。"
                },
                {
                    "id": "30301202",
                    "speaker": "古田",
                    "text": "平日奉行大人用膳，托马大人总会陪伴左右。在旁服侍顺道听听他们闲聊，是我最放松的时刻之一。"
                },
                {
                    "id": "30301203",
                    "speaker": "古田",
                    "text": "公务不由人，奉行大人有时不得不在外用餐，可若能回来，他还是比较喜欢在府内用膳。"
                },
                {
                    "id": "30301204",
                    "speaker": "古田",
                    "text": "据说是因为托马大人的料理能力比一般厨师更出众，呵呵，奉行大人心中总是有「家」。"
                },
                {
                    "id": "30301205",
                    "speaker": "古田",
                    "text": "您或许还不知道，他们也会聊到您。那种口气，像是说一个认识挺久，能谈得来的朋友。"
                },
                {
                    "id": "30301206",
                    "speaker": "古田",
                    "text": "大小姐偶尔也会陪着一起，而最近几次家族团聚的时刻，免不了说到有趣的人事与见闻。这其中，总是有您一份。"
                },
                {
                    "id": "30301207",
                    "speaker": "古田",
                    "text": "…前代奉行大人与夫人过世至今，神里家也走过了许多个年头啊。"
                },
                {
                    "id": "30301208",
                    "speaker": "古田",
                    "text": "老婆子我看着奉行大人与大小姐长大，像他们这般身份能结交到有趣又可靠的朋友，真是太好啦。"
                },
                {
                    "id": "30301209",
                    "speaker": "古田",
                    "text": "所以，您若有时间，欢迎常来奉行府走走。就当是老婆子我冒昧的请求了。",
                    "choices": [
                        {
                            "id": "30301210",
                            "text": "非常感谢，我会的。",
                            "response": [
                                {
                                    "id": "30301212",
                                    "speaker": "古田",
                                    "text": "那真是太好了，呵呵，谢谢您。"
                                },
                                {
                                    "id": "30301213",
                                    "speaker": "派蒙",
                                    "text": "嘿嘿，我也很喜欢来这里哦，而且听婆婆刚才说的，社奉行府的饭菜是不是很棒？"
                                },
                                {
                                    "id": "30301214",
                                    "speaker": "派蒙",
                                    "text": "说得我都心痒了，下次我们来蹭…啊不是不是，来拜访吧！最好挑个饭点！"
                                },
                                {
                                    "id": "30301215",
                                    "speaker": "古田",
                                    "text": "当然好，欢迎呀。"
                                },
                                {
                                    "id": "30301401",
                                    "speaker": "派蒙",
                                    "text": "那我们就先不打扰啦，不过…呃，我们接下来要去哪里呀？"
                                },
                                {
                                    "id": "30301402",
                                    "speaker": "Player",
                                    "text": "踏鞴砂。"
                                },
                                {
                                    "id": "30301403",
                                    "speaker": "派蒙",
                                    "text": "好的好的，那婆婆再见！不用送我们啦！"
                                },
                                {
                                    "id": "30301404",
                                    "speaker": "古田",
                                    "text": "哎哎，好，再会。"
                                },
                                {
                                    "id": "30301405",
                                    "speaker": "宏达",
                                    "text": "二位这就要走了吗？"
                                },
                                {
                                    "id": "30301406",
                                    "speaker": "派蒙",
                                    "text": "对对，事办完了，你不用担心哦！"
                                },
                                {
                                    "id": "30301407",
                                    "speaker": "宏达",
                                    "text": "好，祝二位旅途顺利。再见。"
                                }
                            ]
                        },
                        {
                            "id": "30301211",
                            "text": "神里家的人也是我的朋友，谢谢。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "303004",
            "objective": "前往踏鞴砂寻找线索",
            "dialogues": []
        },
        {
            "id": "303006",
            "objective": "与泽维尔对话",
            "dialogues": [
                {
                    "id": "30300602",
                    "speaker": "泽维尔",
                    "text": "当然啦，我研究过这一带的炉心。"
                },
                {
                    "id": "30300603",
                    "speaker": "泽维尔",
                    "text": "有什么要问的，尽管问吧！"
                },
                {
                    "id": "30300604",
                    "speaker": "Player",
                    "text": "了解这里的历史吗？"
                },
                {
                    "id": "30300605",
                    "speaker": "泽维尔",
                    "text": "了若指掌！要知道，我可是在附近来回走动过许多次的人。"
                },
                {
                    "id": "30300606",
                    "speaker": "泽维尔",
                    "text": "而且，我还在别处遇到过以前在踏鞴砂居住过的人的后代呢。亲属所说，均是真实历史啊。"
                },
                {
                    "id": "30300607",
                    "speaker": "Player",
                    "text": "还请介绍一下。"
                },
                {
                    "id": "30300608",
                    "speaker": "泽维尔",
                    "text": "唔？突然这么说，三言两语可说不清啊，您应该知道吧？踏鞴砂这地方很有年头了。"
                },
                {
                    "id": "30300609",
                    "speaker": "泽维尔",
                    "text": "据我所知，踏鞴砂作为锻造冶炼业的核心地区之一，已经有上千年历史，只不过炉心似乎出过两次问题…"
                },
                {
                    "id": "30300610",
                    "speaker": "派蒙",
                    "text": "两次？哪两次呢？"
                },
                {
                    "id": "30300611",
                    "speaker": "泽维尔",
                    "text": "最近这些年一次，几百年前还有一次。说到这个，我听稻妻人提过，踏鞴砂以前也有枫丹工匠来过。"
                },
                {
                    "id": "30300612",
                    "speaker": "泽维尔",
                    "text": "看起来，两个国家交流技术由来已久了，那个枫丹工匠据说还是踏鞴砂的重要客人。"
                },
                {
                    "id": "30300613",
                    "speaker": "Player",
                    "text": "（是「博士」。看来「博士」故意毁坏炉心引发动乱的历史似乎也没有受到影响…）"
                },
                {
                    "id": "30300614",
                    "speaker": "派蒙",
                    "text": "喂，你到踏鞴砂来是要打听什么，要不要直接问泽维尔？"
                },
                {
                    "id": "30300615",
                    "speaker": "Player",
                    "text": "已经在问了哦。"
                },
                {
                    "id": "30300616",
                    "speaker": "泽维尔",
                    "text": "哦，原来二位是来研究历史的啊。"
                },
                {
                    "id": "30300617",
                    "speaker": "派蒙",
                    "text": "对，这家伙今天不知道怎么了，一直在打听各种历史…"
                },
                {
                    "id": "30300618",
                    "speaker": "泽维尔",
                    "text": "嗯？该不会是突然迸发了对历史的兴趣吧？"
                },
                {
                    "id": "30300619",
                    "speaker": "Player",
                    "text": "是啊。所以，想再问一个问题。"
                },
                {
                    "id": "30300620",
                    "speaker": "泽维尔",
                    "text": "好啊，请说。"
                },
                {
                    "id": "30300621",
                    "speaker": "Player",
                    "text": "你听说过踏鞴砂有一个「倾奇者」吗？"
                },
                {
                    "id": "30300622",
                    "speaker": "泽维尔",
                    "text": "倾奇者？唔…好像没听过呢。"
                },
                {
                    "id": "30300623",
                    "speaker": "泽维尔",
                    "text": "我知道这个词在稻妻一般指那些特立独行、衣饰特殊的人，倒是一直想见见配得上这个说辞的人。"
                },
                {
                    "id": "30300624",
                    "speaker": "泽维尔",
                    "text": "但很可惜，既没见过这类人，也没在与踏鞴砂有关的说法里听过相关事宜。"
                },
                {
                    "id": "30300625",
                    "speaker": "Player",
                    "text": "（没有倾奇者…难道说散兵在世界树里做了什么，成功抹去了有关自己的记录？）"
                },
                {
                    "id": "30300626",
                    "speaker": "Player",
                    "text": "（如果是那样，他应该是想改变世界，让一切回到原点吧。但是，目前看来所有影响只跟他自己有关？）"
                },
                {
                    "id": "30300627",
                    "speaker": "Player",
                    "text": "谢谢你，泽维尔。"
                },
                {
                    "id": "30300628",
                    "speaker": "泽维尔",
                    "text": "没什么，不用客气。"
                },
                {
                    "id": "30300629",
                    "speaker": "派蒙",
                    "text": "要走了吗？那再见啦泽维尔！"
                },
                {
                    "id": "30300630",
                    "speaker": "泽维尔",
                    "text": "噢！不必客气，我能帮上忙就好。"
                },
                {
                    "id": "30300631",
                    "speaker": "泽维尔",
                    "text": "那就再会了。"
                },
                {
                    "id": "30300632",
                    "speaker": "派蒙",
                    "text": "看来，你想问的事都打听到了呢。"
                },
                {
                    "id": "30300633",
                    "speaker": "Player",
                    "text": "回去见小吉祥草王吧。"
                },
                {
                    "id": "30300634",
                    "speaker": "派蒙",
                    "text": "好啊，不过，不知道你今天到底怎么了…看上去心事重重的。"
                },
                {
                    "id": "30300635",
                    "speaker": "派蒙",
                    "text": "打起精神来呀！无论发生什么我都会陪着你的。",
                    "choices": [
                        {
                            "id": "30300636",
                            "text": "…嗯。",
                            "response": [
                                {
                                    "id": "30300637",
                                    "speaker": "派蒙",
                                    "text": "要振作哦，不行的话就吃点东西！空腹的人无法战胜生活！"
                                },
                                {
                                    "id": "30300640",
                                    "speaker": "派蒙",
                                    "text": "那么，出发去见纳西妲吧！"
                                }
                            ]
                        },
                        {
                            "id": "30300638",
                            "text": "谢谢你，派蒙。",
                            "response": [
                                {
                                    "id": "30300639",
                                    "speaker": "派蒙",
                                    "text": "我们之间客气什么嘛，嘿嘿。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "303009",
            "objective": "(test）控制泽维尔初见任务$HIDDEN",
            "dialogues": []
        },
        {
            "id": "303008",
            "objective": "(test)了解这段时空的海滩小屋孩子",
            "dialogues": [
                {
                    "id": "30300801",
                    "speaker": "泽维尔",
                    "text": "嗯？有人？"
                },
                {
                    "id": "30300802",
                    "speaker": "派蒙",
                    "text": "这种地方竟然有人在发呆！机会难得，我们不如就问他吧！"
                },
                {
                    "id": "30300803",
                    "speaker": "泽维尔",
                    "text": "等等，谁在发呆啊！我是在想问题。"
                },
                {
                    "id": "30300804",
                    "speaker": "派蒙",
                    "text": "骗人，你刚才眼神直直的，根本就是在走神嘛。"
                },
                {
                    "id": "30300805",
                    "speaker": "泽维尔",
                    "text": "欸？您怎么拿我开玩笑呢？都说了那不是发呆，是在考虑很多技术、环境之类的问题，这可是踏鞴砂啊。"
                },
                {
                    "id": "30300806",
                    "speaker": "派蒙",
                    "text": "喔，他说踏鞴砂呢，看来我们找对人了。"
                },
                {
                    "id": "30300807",
                    "speaker": "泽维尔",
                    "text": "怎么，二位是想问有关踏鞴砂的事情吗？"
                },
                {
                    "id": "30300808",
                    "speaker": "Player",
                    "text": "怎么称呼你？"
                },
                {
                    "id": "30300809",
                    "speaker": "泽维尔",
                    "text": "我叫泽维尔。"
                },
                {
                    "id": "30300601",
                    "speaker": "Player",
                    "text": "你对踏鞴砂了解多吗？"
                }
            ]
        },
        {
            "id": "303007",
            "objective": "(test)打听丹羽的故事",
            "dialogues": [
                {
                    "id": "30300701",
                    "speaker": "派蒙",
                    "text": "到啦，不过我们来这里是要找什么东西吗？还是说，找人？"
                },
                {
                    "id": "30300702",
                    "speaker": "泽维尔",
                    "text": "#咦？{NICKNAME}和派蒙？"
                },
                {
                    "id": "30300703",
                    "speaker": "派蒙",
                    "text": "泽维尔？你怎么在这里！"
                },
                {
                    "id": "30300704",
                    "speaker": "泽维尔",
                    "text": "在这附近有事要办，就来了嘛。倒是二位，怎么也来这里了。"
                },
                {
                    "id": "30300705",
                    "speaker": "派蒙",
                    "text": "我们有些事要打听。"
                }
            ]
        },
        {
            "id": "303005",
            "objective": "(test)偶遇泽维尔",
            "dialogues": []
        },
        {
            "id": "303003",
            "objective": "(test)回到城内询问NPC翔太",
            "dialogues": []
        },
        {
            "id": "303001",
            "objective": "(test)等待（改为跟床互动）",
            "dialogues": []
        },
        {
            "id": "303010",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "30301001",
                    "speaker": "派蒙",
                    "text": "到啦，这里是社奉行府，所以…"
                },
                {
                    "id": "30301002",
                    "speaker": "宏达",
                    "text": "#{NICKNAME}，好久不见了。"
                },
                {
                    "id": "30301003",
                    "speaker": "Player",
                    "text": "你好。"
                },
                {
                    "id": "30301004",
                    "speaker": "宏达",
                    "text": "如果阁下是来找奉行大人和大小姐，实在不巧，他们都不在府中…"
                },
                {
                    "id": "30301005",
                    "speaker": "派蒙",
                    "text": "是有公务吗？"
                },
                {
                    "id": "30301006",
                    "speaker": "宏达",
                    "text": "奉行大人公务在身，大小姐则是替奉行大人出席一些会议，如有急事，可以到府内稍事休息，等候他们归来。"
                },
                {
                    "id": "30301007",
                    "speaker": "派蒙",
                    "text": "怎么样？要进去吗？"
                },
                {
                    "id": "30301008",
                    "speaker": "Player",
                    "text": "那就打扰一下了。"
                },
                {
                    "id": "30301009",
                    "speaker": "Player",
                    "text": "可以在院子里随便走走吗？"
                },
                {
                    "id": "30301010",
                    "speaker": "宏达",
                    "text": "换作别人，当然是不可以的了。但您与奉行大人和大小姐关系甚佳，我想，应该没什么问题。"
                },
                {
                    "id": "30301011",
                    "speaker": "派蒙",
                    "text": "谢谢啦，那我们就进去了哦！"
                },
                {
                    "id": "30301012",
                    "speaker": "古田",
                    "text": "嗯？您这样看着我，是有什么话要问我吗？"
                },
                {
                    "id": "30301013",
                    "speaker": "Player",
                    "text": "老婆婆，可以请教一些事吗？"
                },
                {
                    "id": "30301014",
                    "speaker": "古田",
                    "text": "#呵呵，可以啊。我知道您是{NICKNAME}，大小姐跟我说起过您。"
                },
                {
                    "id": "30301015",
                    "speaker": "古田",
                    "text": "您有什么想知道的？"
                },
                {
                    "id": "30301016",
                    "speaker": "Player",
                    "text": "奉行大人和大小姐最近好吗？"
                },
                {
                    "id": "30301017",
                    "speaker": "古田",
                    "text": "托您的福，他们二位一切都好。大小姐近日忙于出席各色会议，时而帮奉行大人走访一下民间组织…"
                },
                {
                    "id": "30301018",
                    "speaker": "古田",
                    "text": "而奉行大人，您知道的，他总是忙得很，没什么变化。但要说的话，最近心情应是不错。"
                },
                {
                    "id": "30301019",
                    "speaker": "派蒙",
                    "text": "听起来一切如常，对吧？"
                },
                {
                    "id": "30301020",
                    "speaker": "古田",
                    "text": "是啊。"
                },
                {
                    "id": "30301021",
                    "speaker": "Player",
                    "text": "（神里绫人依然担任社奉行，而神里绫华依然是奉行府的大小姐…与原先并无不同。）"
                },
                {
                    "id": "30301022",
                    "speaker": "Player",
                    "text": "（社奉行眼下的情况，似乎也没有什么变化…）"
                },
                {
                    "id": "30301023",
                    "speaker": "Player",
                    "text": "（虽然是意料中的结果，但听到他们兄妹一切都好的消息，还是觉得放心不少。）"
                },
                {
                    "id": "30301024",
                    "speaker": "派蒙",
                    "text": "怎么样，还有其他要问的吗？"
                },
                {
                    "id": "30301025",
                    "speaker": "Player",
                    "text": "暂时没有了，谢谢您。"
                },
                {
                    "id": "30301026",
                    "speaker": "古田",
                    "text": "您实在是太客气啦，要不是听说您也非常繁忙，我都想请您常来奉行府做客了呢。"
                },
                {
                    "id": "30301027",
                    "speaker": "古田",
                    "text": "大小姐她啊，经常提起您。她似乎很高兴能有您这样的朋友，还说您各方面都很厉害，令人钦佩。"
                },
                {
                    "id": "30301028",
                    "speaker": "古田",
                    "text": "总觉得，自从您来到稻妻之后，许多事都朝着好的方向转变了。我想，您也许就是俗语说的贵人与有缘人吧。"
                },
                {
                    "id": "30301029",
                    "speaker": "Player",
                    "text": "您过奖了。"
                }
            ]
        },
        {
            "id": "303015",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "30301501",
                    "speaker": "天目十五",
                    "text": "唉，过去那些事，提起来总有些伤感…"
                }
            ]
        },
        {
            "id": "303016",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "30301601",
                    "speaker": "古田",
                    "text": "您出门在外也要注意安全和健康。"
                }
            ]
        },
        {
            "id": "303017",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "30301701",
                    "speaker": "宏达",
                    "text": "祝二位旅途顺利。再见。"
                }
            ]
        }
    ]
}