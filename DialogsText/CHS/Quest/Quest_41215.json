    "talks": [
        {
            "id": "4121501",
            "objective": "",
            "dialogues": [
                {
                    "id": "412100301",
                    "speaker": "派蒙",
                    "text": "阿贝多——！"
                },
                {
                    "id": "412100302",
                    "speaker": "Player",
                    "text": "嗨，又是我们哦。"
                },
                {
                    "id": "412100303",
                    "speaker": "阿贝多",
                    "text": "嗯？你们怎么回来了？"
                },
                {
                    "id": "412100304",
                    "speaker": "阿贝多",
                    "text": "迷路了吗？"
                },
                {
                    "id": "412100305",
                    "speaker": "派蒙",
                    "text": "不是啦！",
                    "choices": [
                        {
                            "id": "412100306",
                            "text": "在路上接了砂糖的委托，来调查你的秘密。",
                            "response": [
                                {
                                    "id": "412100308",
                                    "speaker": "阿贝多",
                                    "text": "哦？秘密？"
                                },
                                {
                                    "id": "412100309",
                                    "speaker": "派蒙",
                                    "text": "啊啊啊，你在干什么呀！"
                                },
                                {
                                    "id": "412100310",
                                    "speaker": "派蒙",
                                    "text": "这种时候不是应该悄悄调查吗？怎么就说出来了！"
                                },
                                {
                                    "id": "412100311",
                                    "speaker": "Player",
                                    "text": "反正也瞒不过阿贝多吧。"
                                },
                                {
                                    "id": "412100312",
                                    "speaker": "派蒙",
                                    "text": "呜…就算你这么说…"
                                },
                                {
                                    "id": "412100313",
                                    "speaker": "阿贝多",
                                    "text": "来得正好，我也有事要找你，旅行者。"
                                },
                                {
                                    "id": "412100314",
                                    "speaker": "阿贝多",
                                    "text": "接着！"
                                },
                                {
                                    "id": "412100315",
                                    "speaker": "派蒙",
                                    "text": "咦，这是什么？"
                                },
                                {
                                    "id": "412100316",
                                    "speaker": "阿贝多",
                                    "text": "如你所见，一把单手剑。",
                                    "choices": [
                                        {
                                            "id": "412100317",
                                            "text": "原来你会锻造？",
                                            "response": [
                                                {
                                                    "id": "412100319",
                                                    "speaker": "阿贝多",
                                                    "text": "剑不是我打的，不过，我刚才在上面施了炼金术。"
                                                },
                                                {
                                                    "id": "412100320",
                                                    "speaker": "阿贝多",
                                                    "text": "想试试吗？"
                                                },
                                                {
                                                    "id": "412100321",
                                                    "speaker": "Player",
                                                    "text": "哎？要把它给我吗？"
                                                },
                                                {
                                                    "id": "412100322",
                                                    "speaker": "阿贝多",
                                                    "text": "根据我的研究，这把剑情况特殊，只有你能使用。"
                                                },
                                                {
                                                    "id": "412100323",
                                                    "speaker": "阿贝多",
                                                    "text": "但我现在迫切需要它的数据，麻烦你拿着它多多战斗。"
                                                },
                                                {
                                                    "id": "412100324",
                                                    "speaker": "派蒙",
                                                    "text": "喂喂，等一下，怎么会有只给一个人使用的剑呀？"
                                                },
                                                {
                                                    "id": "412100325",
                                                    "speaker": "Player",
                                                    "text": "该不会有什么副作用吧？"
                                                },
                                                {
                                                    "id": "412100326",
                                                    "speaker": "阿贝多",
                                                    "text": "很敏锐嘛。这把剑确实不同寻常，它受到了某种诅咒。"
                                                },
                                                {
                                                    "id": "412100327",
                                                    "speaker": "阿贝多",
                                                    "text": "寻常人完全无法使用这把单手剑，但你不一样。"
                                                },
                                                {
                                                    "id": "412100328",
                                                    "speaker": "派蒙",
                                                    "text": "哎…？"
                                                },
                                                {
                                                    "id": "412100329",
                                                    "speaker": "阿贝多",
                                                    "text": "可以说，这把被诅咒的剑唯独对你没有害处。既然如此，除了你我还能找谁帮忙呢？"
                                                },
                                                {
                                                    "id": "412100330",
                                                    "speaker": "阿贝多",
                                                    "text": "多说无益，到附近找几只怪物吧。有些事，一试便知。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "412100318",
                                            "text": "炼金术士也要兼职铁匠吗？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "412100307",
                            "text": "砂糖说你有些不可告人的小秘密。"
                        }
                    ]
                }
            ]
        }
    ]
}