    "talks": [
        {
            "id": "1200901",
            "objective": "与稻妻的凯瑟琳交谈",
            "dialogues": [
                {
                    "id": "120090101",
                    "speaker": "派蒙",
                    "text": "凯瑟琳，我们来了，有什么事找我们帮忙吗？"
                },
                {
                    "id": "120090102",
                    "speaker": "凯瑟琳",
                    "text": "不好意思，又要麻烦你们了。这次是天领奉行直接交给冒险家协会的委托，很重要，也很危险。"
                },
                {
                    "id": "120090103",
                    "speaker": "凯瑟琳",
                    "text": "协会在评估后认为，这份委托只能交给最资深的冒险家，于是我就想到了你们。"
                },
                {
                    "id": "120090104",
                    "speaker": "派蒙",
                    "text": "嘿嘿，也没有那么厉害啦。",
                    "choices": [
                        {
                            "id": "120090105",
                            "text": "听上去有点危险？",
                            "response": [
                                {
                                    "id": "120090107",
                                    "speaker": "凯瑟琳",
                                    "text": "先由我来说明一下吧。天领奉行近日下发了通缉令，他们想要找一个名叫「荒泷一斗」的鬼族青年。"
                                },
                                {
                                    "id": "120090108",
                                    "speaker": "派蒙",
                                    "text": "鬼族？我好像听说过，就是头上长角，看起来很凶的人吧。"
                                },
                                {
                                    "id": "120090109",
                                    "speaker": "凯瑟琳",
                                    "text": "是的，这个人很张扬很吵闹，所以在町街有点名气。但话虽如此，他以前也没有闯过什么大祸。"
                                },
                                {
                                    "id": "120090110",
                                    "speaker": "凯瑟琳",
                                    "text": "没想到，最近他竟然做起了抢劫和掳掠的勾当…"
                                },
                                {
                                    "id": "120090111",
                                    "speaker": "凯瑟琳",
                                    "text": "不只是做了坏事，在天领奉行众打算逮捕他的时候，他还袭击了执行抓捕的同心，带着身边的人逃走了。"
                                },
                                {
                                    "id": "120090112",
                                    "speaker": "Player",
                                    "text": "感觉很恶劣。"
                                },
                                {
                                    "id": "120090113",
                                    "speaker": "派蒙",
                                    "text": "总而言之，就是想让我们去把坏人抓回来吧。"
                                },
                                {
                                    "id": "120090114",
                                    "speaker": "派蒙",
                                    "text": "#放心放心，{NICKNAME}{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}可厉害了，什么对手都不在话下。"
                                },
                                {
                                    "id": "120090115",
                                    "speaker": "凯瑟琳",
                                    "text": "嗯，不过还是不要鲁莽行动为好，这个人是神之眼的持有者，手下还管理着一个名为「荒泷派」的组织。",
                                    "choices": [
                                        {
                                            "id": "120090116",
                                            "text": "我不那么擅长打群架…",
                                            "response": [
                                                {
                                                    "id": "120090117",
                                                    "speaker": "派蒙",
                                                    "text": "也对，毕竟我们完全不了解他。听你的吧，还是谨慎一点好。"
                                                },
                                                {
                                                    "id": "120090120",
                                                    "speaker": "凯瑟琳",
                                                    "text": "有关荒泷一斗这个人，他为什么要做这样的事，现在又逃到了什么地方去，这些信息我们都还没有掌握。"
                                                },
                                                {
                                                    "id": "120090121",
                                                    "speaker": "凯瑟琳",
                                                    "text": "町街的各位应该比我更熟悉他，你们应该能从他们那里获得有用的情报。"
                                                },
                                                {
                                                    "id": "120090122",
                                                    "speaker": "Player",
                                                    "text": "嗯，我会去打听看看。"
                                                },
                                                {
                                                    "id": "120090123",
                                                    "speaker": "凯瑟琳",
                                                    "text": "感谢你的协助，我在这里等待你的好消息。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "120090118",
                                            "text": "我手下有派蒙。",
                                            "response": [
                                                {
                                                    "id": "120090119",
                                                    "speaker": "派蒙",
                                                    "text": "对不起，对不起啦！别让我去打架，我不该夸下海口的…"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "120090106",
                            "text": "天领奉行自己解决不了吗？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1200902",
            "objective": "打听荒泷一斗的消息",
            "dialogues": [
                {
                    "id": "120090201",
                    "speaker": "小仓澪",
                    "text": "荒泷一斗？啊，他的事我知道，我一直觉得是天领奉行的人搞错了，他不可能为恶啦。"
                },
                {
                    "id": "120090202",
                    "speaker": "派蒙",
                    "text": "欸？为什么这么肯定，你很信任他吗？"
                },
                {
                    "id": "120090203",
                    "speaker": "小仓澪",
                    "text": "你误会了，我的意思是，他可能并没有为恶的「能力」。",
                    "choices": [
                        {
                            "id": "120090204",
                            "text": "是指…力气？",
                            "response": [
                                {
                                    "id": "120090206",
                                    "speaker": "小仓澪",
                                    "text": "听我讲一个他的故事你们就明白了，他以前经常和町街的小孩子玩猜拳和捉迷藏。"
                                },
                                {
                                    "id": "120090207",
                                    "speaker": "小仓澪",
                                    "text": "小孩子单纯又好懂，你们肯定明白。但就算是和他们做游戏，荒泷一斗有时候也输得很惨。"
                                },
                                {
                                    "id": "120090208",
                                    "speaker": "派蒙",
                                    "text": "是他故意的吧？"
                                },
                                {
                                    "id": "120090209",
                                    "speaker": "小仓澪",
                                    "text": "不不不，有一次我亲眼见到他赢了一个小孩子，他开心地跳了起来，喊着什么「终于赢了！」…「本大爷无敌！」之类的话…"
                                },
                                {
                                    "id": "120090210",
                                    "speaker": "小仓澪",
                                    "text": "还赢走了这个孩子手里的硬糖，当着他的面吃掉了。"
                                },
                                {
                                    "id": "120090211",
                                    "speaker": "派蒙",
                                    "text": "呜哇，好差劲！"
                                },
                                {
                                    "id": "120090212",
                                    "speaker": "小仓澪",
                                    "text": "那次确实有点过分了，所以我帮那个快哭出来的小孩子教训了他。"
                                },
                                {
                                    "id": "120090213",
                                    "speaker": "小仓澪",
                                    "text": "他认错的速度很快，态度也很坦率，所以孩子马上又笑了出来。"
                                },
                                {
                                    "id": "120090214",
                                    "speaker": "小仓澪",
                                    "text": "因为他「愿赌服输，从不放水」，有些孩子还挺喜欢找他玩的。"
                                },
                                {
                                    "id": "120090215",
                                    "speaker": "小仓澪",
                                    "text": "但这样一个经常输给小孩子的人…要怎么去作恶呢？",
                                    "choices": [
                                        {
                                            "id": "120090216",
                                            "text": "我懂你的意思了。",
                                            "response": [
                                                {
                                                    "id": "120090218",
                                                    "speaker": "派蒙",
                                                    "text": "这么听起来，他好像不是个坏人啊，而且是个有原则的人。"
                                                },
                                                {
                                                    "id": "120090219",
                                                    "speaker": "小仓澪",
                                                    "text": "嗯，原本我也这样想，但听说天领奉行的人已经掌握了确凿的证据。"
                                                },
                                                {
                                                    "id": "120090220",
                                                    "speaker": "小仓澪",
                                                    "text": "我不想为他辩解，他如果真的犯了错，那就该乖乖受罚。"
                                                },
                                                {
                                                    "id": "120090221",
                                                    "speaker": "派蒙",
                                                    "text": "嗯，谢谢你！我们再去打听一下！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "120090217",
                                            "text": "挺意外的。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "120090205",
                            "text": "是指…心智？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1200903",
            "objective": "打听荒泷一斗的消息",
            "dialogues": [
                {
                    "id": "120090301",
                    "speaker": "古谷升",
                    "text": "你想问荒泷一斗？嗯，我听说他最近犯了事，已经逃走了…"
                },
                {
                    "id": "120090302",
                    "speaker": "古谷升",
                    "text": "刚听说的时候，我有点意外，但…也不算非常意外。"
                },
                {
                    "id": "120090303",
                    "speaker": "派蒙",
                    "text": "是因为他以前名声就不好吗？"
                },
                {
                    "id": "120090304",
                    "speaker": "古谷升",
                    "text": "不，怎么说呢…咳咳，他无论干什么事都声势浩大，给人一种血气方刚，又有点聒噪的感觉。"
                },
                {
                    "id": "120090305",
                    "speaker": "古谷升",
                    "text": "这样的人，说好听一点叫爽朗，说不好听的话，就是情绪不安定，开心的时候很开心，愤怒的时候很愤怒…"
                },
                {
                    "id": "120090306",
                    "speaker": "古谷升",
                    "text": "我对荒泷一斗这个人的印象并不差，但他冲动起来会不会失控，我也说不好。",
                    "choices": [
                        {
                            "id": "120090307",
                            "text": "他平时是做什么的？",
                            "response": [
                                {
                                    "id": "120090309",
                                    "speaker": "古谷升",
                                    "text": "这个我也不清楚，咳咳…我平时还算比较注意城里发生的事，但荒泷一斗好像就只是在混日子而已…"
                                },
                                {
                                    "id": "120090310",
                                    "speaker": "古谷升",
                                    "text": "有人需要帮忙的话，他会帮忙，其他时候，就是在和手下或者小孩子胡闹了吧。"
                                },
                                {
                                    "id": "120090311",
                                    "speaker": "古谷升",
                                    "text": "唉，是不是因为没有收入，日子过不下去了，才想要做坏事呢？"
                                },
                                {
                                    "id": "120090312",
                                    "speaker": "派蒙",
                                    "text": "好奇怪的人啊。"
                                },
                                {
                                    "id": "120090313",
                                    "speaker": "古谷升",
                                    "text": "抱歉了，其他的情况我也不清楚，他更喜欢和精神好一点的人待在一起。"
                                },
                                {
                                    "id": "120090314",
                                    "speaker": "古谷升",
                                    "text": "或许你们可以找其他人再打听一下。"
                                },
                                {
                                    "id": "120090315",
                                    "speaker": "派蒙",
                                    "text": "好的，谢谢你！"
                                }
                            ]
                        },
                        {
                            "id": "120090308",
                            "text": "他有什么稳定的工作吗？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1200904",
            "objective": "打听荒泷一斗的消息",
            "dialogues": [
                {
                    "id": "120090401",
                    "speaker": "上杉",
                    "text": "荒泷一斗？啊，我知道，我们正在抓捕他。"
                },
                {
                    "id": "120090402",
                    "speaker": "上杉",
                    "text": "他已经逃离稻妻城了，因为没有进一步的线索，我们才会委托其他人协同搜寻，包括冒险家们。"
                },
                {
                    "id": "120090403",
                    "speaker": "派蒙",
                    "text": "凯瑟琳和我们说，荒泷一斗以前没有闯过大祸，这次好像事出突然…"
                },
                {
                    "id": "120090404",
                    "speaker": "派蒙",
                    "text": "所谓的掳掠和抢劫，这些都是有证据的吗？"
                },
                {
                    "id": "120090405",
                    "speaker": "上杉",
                    "text": "那是当然，不然也不会因为他，动用这么多人手了。"
                },
                {
                    "id": "120090406",
                    "speaker": "上杉",
                    "text": "虽然抢劫的人都会想办法隐藏自己的身份，但是鬼族的角太显眼了，一下就能认出来是他。"
                },
                {
                    "id": "120090407",
                    "speaker": "Player",
                    "text": "不可能是别的鬼吗？"
                },
                {
                    "id": "120090408",
                    "speaker": "上杉",
                    "text": "起初我们只是怀疑他，但去调查的时候，他直接亲口承认了罪行，还挑衅了我们。"
                },
                {
                    "id": "120090409",
                    "speaker": "上杉",
                    "text": "最可气的是，最后居然还让他带着身边的人逃掉了…这家伙一定是早有准备！"
                },
                {
                    "id": "120090410",
                    "speaker": "Player",
                    "text": "他有作恶动机吗？"
                },
                {
                    "id": "120090411",
                    "speaker": "上杉",
                    "text": "当然，无论是现实动机还是心理动机，都很充足。"
                },
                {
                    "id": "120090412",
                    "speaker": "上杉",
                    "text": "他的生活一直都很拮据，也没做什么正经工作，听说他还要照顾一个帮派的人，负担相当大。"
                },
                {
                    "id": "120090413",
                    "speaker": "上杉",
                    "text": "与其一直受苦，他可能觉得，作恶能让他过得更轻松。"
                },
                {
                    "id": "120090414",
                    "speaker": "上杉",
                    "text": "至于心理上的动机，虽然现在有点难以启齿，在实施「眼狩令」的时候，他的神之眼被我们夺走了。"
                },
                {
                    "id": "120090415",
                    "speaker": "Player",
                    "text": "原来是想报复天领奉行啊。"
                },
                {
                    "id": "120090416",
                    "speaker": "上杉",
                    "text": "那个时候，荒泷一斗反抗得很厉害，我们费了非常大的力气，还求助了九条裟罗大人，这才成功。"
                },
                {
                    "id": "120090417",
                    "speaker": "上杉",
                    "text": "…这件事确实是我们的错，但没想到他为了报复，采取了如此过激的手段。"
                },
                {
                    "id": "120090418",
                    "speaker": "派蒙",
                    "text": "听起来，好像确实是个情绪很不稳定的人。",
                    "choices": [
                        {
                            "id": "120090419",
                            "text": "动机上也能够说通。",
                            "response": [
                                {
                                    "id": "120090421",
                                    "speaker": "上杉",
                                    "text": "嗯，如果你们能制服荒泷一斗，就直接把他带到我这里来，我们会依规处置他的。"
                                },
                                {
                                    "id": "120090422",
                                    "speaker": "派蒙",
                                    "text": "好的，谢谢你的情报。"
                                }
                            ]
                        },
                        {
                            "id": "120090420",
                            "text": "看来证据确凿。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1200906",
            "objective": "(test)保护回滚~$HIDDEN",
            "dialogues": []
        },
        {
            "id": "1200905",
            "objective": "向珊瑚打听更多消息",
            "dialogues": [
                {
                    "id": "120090501",
                    "speaker": "派蒙",
                    "text": "你好，我们想打听关于荒泷一斗的事。"
                },
                {
                    "id": "120090502",
                    "speaker": "珊瑚",
                    "text": "又是他啊…当然没问题，之前我已经帮天领奉行做过一些调查了。不过更重要的，你们的咨询费带够了吗？"
                },
                {
                    "id": "120090503",
                    "speaker": "珊瑚",
                    "text": "你们的名号我也听过，见过那么多大风大浪，自然每一行每一路的规矩都是明白的吧。"
                },
                {
                    "id": "120090504",
                    "speaker": "派蒙",
                    "text": "这、这个…要多少钱啊？"
                },
                {
                    "id": "120090505",
                    "speaker": "珊瑚",
                    "text": "三十九万七千摩拉，先行一次性支付，若成功将荒泷一斗捉拿归案，我还要收取协会报酬的百分之五作为提成。"
                },
                {
                    "id": "120090506",
                    "speaker": "派蒙",
                    "text": "太贵了！这个数字是怎么算出来的啊！"
                },
                {
                    "id": "120090507",
                    "speaker": "珊瑚",
                    "text": "呵呵，听我说完嘛——这笔咨询费之前天领奉行已经付过了，所以你们只需要支付提成就行啦。"
                },
                {
                    "id": "120090508",
                    "speaker": "珊瑚",
                    "text": "而提成的部分，到时候我会直接和冒险家协会结算的。你们可是捡了个大便宜。"
                },
                {
                    "id": "120090509",
                    "speaker": "珊瑚",
                    "text": "那么，要了解这件事的原委，就不得不提到，在稻妻很有名的童话故事——"
                },
                {
                    "id": "120090510",
                    "speaker": "派蒙",
                    "text": "青鬼呢？青鬼后来怎么样了！"
                },
                {
                    "id": "120090511",
                    "speaker": "珊瑚",
                    "text": "后来青鬼就消失了吧，再也没见过了，现在留下来的也只有赤鬼了。"
                },
                {
                    "id": "120090512",
                    "speaker": "派蒙",
                    "text": "呜呜呜，怎么这样…青鬼真是个好孩子啊——"
                },
                {
                    "id": "120090513",
                    "speaker": "Player",
                    "text": "童话故事和现实有关系吗？"
                },
                {
                    "id": "120090514",
                    "speaker": "珊瑚",
                    "text": "当然，不然我也不会讲了。有一种说法是…这个童话就是由历史改编而来，而荒泷一斗就是故事里赤鬼的后代。"
                },
                {
                    "id": "120090515",
                    "speaker": "珊瑚",
                    "text": "我想告诉你们的是，鬼族当年牺牲了很多，最后才能融入人类，但鬼族的性格里仍然有不安定的要素。"
                },
                {
                    "id": "120090516",
                    "speaker": "珊瑚",
                    "text": "这种不安定是从血脉中传承下来的，荒泷一斗以前并没有做过什么坏事，但说不定有一天会性情大变呢？"
                },
                {
                    "id": "120090517",
                    "speaker": "派蒙",
                    "text": "但这样的话，赤鬼不就背叛了青鬼的愿望嘛…"
                },
                {
                    "id": "120090518",
                    "speaker": "珊瑚",
                    "text": "那都是很久远的事了。青鬼已经不知道多久没有出现过，估计早就消亡了，背叛自然也无从谈起。"
                },
                {
                    "id": "120090519",
                    "speaker": "珊瑚",
                    "text": "而且…既然当事人都已经承认了，那还有什么可怀疑的呢？"
                },
                {
                    "id": "120090520",
                    "speaker": "珊瑚",
                    "text": "根据我的调查，他一直朝着西南方向走，很有可能已经到了<color=#00E1FFFF>八酝岛</color>。"
                },
                {
                    "id": "120090521",
                    "speaker": "珊瑚",
                    "text": "天领奉行众没办法到珊瑚宫军的控制范围去抓人，所以荒泷一斗逃去那里也有足够的理由。"
                },
                {
                    "id": "120090522",
                    "speaker": "Player",
                    "text": "我明白了，谢谢你的情报。"
                },
                {
                    "id": "120090523",
                    "speaker": "珊瑚",
                    "text": "没关系，这是我应该做的。"
                },
                {
                    "id": "120090524",
                    "speaker": "派蒙",
                    "text": "等等，我还有个问题，如果这个叫荒泷一斗的人性情大变，那是不是就会很凶恶，很暴躁？"
                },
                {
                    "id": "120090525",
                    "speaker": "珊瑚",
                    "text": "应该是吧，从他之前和别人交手的情况看，他很擅长打架，有一股蛮力，光凭你们不知道能不能制服他。"
                },
                {
                    "id": "120090526",
                    "speaker": "派蒙",
                    "text": "那…故事里面说对鬼族撒豆子的事，也是有用的吗？"
                },
                {
                    "id": "120090527",
                    "speaker": "珊瑚",
                    "text": "哦，你这么一说我想起来了，荒泷一斗他好像对豆子过敏。"
                },
                {
                    "id": "120090528",
                    "speaker": "珊瑚",
                    "text": "鬼族都有点害怕豆子，他尤其害怕，据说连碰一下都不行。"
                },
                {
                    "id": "120090529",
                    "speaker": "珊瑚",
                    "text": "能让他过敏，变得虚弱的话，就能很顺利地把他带回来了。",
                    "choices": [
                        {
                            "id": "120090530",
                            "text": "只能这样了。",
                            "response": [
                                {
                                    "id": "120090531",
                                    "speaker": "派蒙",
                                    "text": "对吧，能找到弱点就方便多啦。"
                                },
                                {
                                    "id": "120090534",
                                    "speaker": "珊瑚",
                                    "text": "我这里正好有一袋豆子，本来是煮粥用的，交给你们好了。"
                                },
                                {
                                    "id": "120090535",
                                    "speaker": "珊瑚",
                                    "text": "——豆子的钱，我会找协会以实惠的价格结算的。"
                                },
                                {
                                    "id": "120090536",
                                    "speaker": "派蒙",
                                    "text": "果然你在打这样的主意！不过，还是谢谢你…"
                                },
                                {
                                    "id": "120090537",
                                    "speaker": "派蒙",
                                    "text": "那我们就去<color=#00E1FFFF>八酝岛</color>找人了！"
                                }
                            ]
                        },
                        {
                            "id": "120090532",
                            "text": "好像有点胜之不武。",
                            "response": [
                                {
                                    "id": "120090533",
                                    "speaker": "派蒙",
                                    "text": "对付作恶者就不用考虑太多了吧。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "1200907",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "120090701",
                    "speaker": "凯瑟琳",
                    "text": "虽然协助天领奉行并非协会的本职工作，但既然是他们的委托，我们也同样会按规矩处理。"
                },
                {
                    "id": "120090702",
                    "speaker": "凯瑟琳",
                    "text": "这件事就拜托你了，等待你的好消息。"
                }
            ]
        },
        {
            "id": "1200909",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "120090901",
                    "speaker": "小仓澪",
                    "text": "可能我的说法比较难以理解，如果你们真的见过他，就能感受到他独特的气质了。"
                },
                {
                    "id": "120090902",
                    "speaker": "小仓澪",
                    "text": "不过他这样的性格，确实没办法让每个人都喜欢他…"
                }
            ]
        },
        {
            "id": "1200911",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "120091101",
                    "speaker": "古谷升",
                    "text": "咳咳…找其他人打听看看吧，说不定有什么新的收获。"
                }
            ]
        },
        {
            "id": "1200913",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "120091301",
                    "speaker": "上杉",
                    "text": "如果你们抓到他，就把他送回来吧。"
                },
                {
                    "id": "120091302",
                    "speaker": "上杉",
                    "text": "虽然之后的麻烦事肯定也少不了…"
                }
            ]
        },
        {
            "id": "1200999",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "120099901",
                    "speaker": "派蒙",
                    "text": "那我们就找街上的人打听看看吧，荒泷一斗的基本情况，还有他去了哪里。"
                },
                {
                    "id": "120099902",
                    "speaker": "派蒙",
                    "text": "结果还是不清楚他的去向，我们还是去找更专业的情报人士吧。"
                },
                {
                    "id": "120099903",
                    "speaker": "派蒙",
                    "text": "我记得稻妻有一家侦探社，我们去那边看看好了。"
                }
            ]
        }
    ]
}