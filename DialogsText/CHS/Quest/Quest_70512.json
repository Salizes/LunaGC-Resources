        }
    },
    "talks": [
        {
            "id": "7051201",
            "objective": "前往晨曦酒庄",
            "dialogues": [
                {
                    "id": "705120201",
                    "speaker": "爱德琳",
                    "text": "贵安，两位。好久不见了，你们还是很有精神呢。"
                },
                {
                    "id": "705120202",
                    "speaker": "派蒙",
                    "text": "爱德琳女仆长，你好啊！"
                },
                {
                    "id": "705120203",
                    "speaker": "爱德琳",
                    "text": "两位是来找迪卢克老爷商议要事的吗？",
                    "choices": [
                        {
                            "id": "705120204",
                            "text": "只是为了葡萄汁…",
                            "response": [
                                {
                                    "id": "705120206",
                                    "speaker": "派蒙",
                                    "text": "确实，既然爱德琳小姐站在门口，还是直接拜托爱德琳小姐吧。"
                                },
                                {
                                    "id": "705120207",
                                    "speaker": "派蒙",
                                    "text": "爱德琳小姐，我们总是错过酒庄的特价葡萄汁，这次想早点过来预定…"
                                },
                                {
                                    "id": "705120208",
                                    "speaker": "派蒙",
                                    "text": "我们多付一点定金也可以哦，请给我们预留一瓶吧！"
                                },
                                {
                                    "id": "705120209",
                                    "speaker": "爱德琳",
                                    "text": "当然没问题，完全不用定金！"
                                },
                                {
                                    "id": "705120210",
                                    "speaker": "爱德琳",
                                    "text": "只不过，要麻烦你们稍微等等了。晨曦酒庄的特价葡萄汁需要不少准备时间。"
                                },
                                {
                                    "id": "705120211",
                                    "speaker": "爱德琳",
                                    "text": "每年夏天，迪卢克老爷都会亲自挑选两桶品质上好的葡萄，用来制作特价葡萄汁。"
                                },
                                {
                                    "id": "705120212",
                                    "speaker": "派蒙",
                                    "text": "为什么要把良品低价卖出去呢？「品质上好的葡萄」，明明一听就很贵啊。"
                                },
                                {
                                    "id": "705120213",
                                    "speaker": "爱德琳",
                                    "text": "老爷没有明确解释过，我也只能揣测他的想法——"
                                },
                                {
                                    "id": "705120214",
                                    "speaker": "爱德琳",
                                    "text": "特价只是一种手段，标着特价的商品往往能吸引更多顾客。"
                                },
                                {
                                    "id": "705120215",
                                    "speaker": "爱德琳",
                                    "text": "也许老爷希望用这种方法让果汁流行起来，为人们提供一种新的选择。"
                                },
                                {
                                    "id": "705120216",
                                    "speaker": "爱德琳",
                                    "text": "酗酒的人能找到理想替代品，这样就不会在酩酊大醉后闹事，不能喝酒的人们也可以获得别样的乐趣。",
                                    "choices": [
                                        {
                                            "id": "705120217",
                                            "text": "酒庄的生意不会变差吗…",
                                            "response": [
                                                {
                                                    "id": "705120219",
                                                    "speaker": "爱德琳",
                                                    "text": "老爷不是计较那一点小钱的人。也许，相比毫无节制地增长营收，他更希望人们都能适度饮酒。"
                                                },
                                                {
                                                    "id": "705120220",
                                                    "speaker": "爱德琳",
                                                    "text": "享受美酒和生活的同时也保持理智，不给别人增加麻烦…这不是很好吗？"
                                                },
                                                {
                                                    "id": "705120221",
                                                    "speaker": "派蒙",
                                                    "text": "迪卢克老爷可真是用心良苦啊…"
                                                },
                                                {
                                                    "id": "705120222",
                                                    "speaker": "派蒙",
                                                    "text": "所以现在，迪卢克正在挑选今年的葡萄吗？"
                                                },
                                                {
                                                    "id": "705120223",
                                                    "speaker": "爱德琳",
                                                    "text": "暂时还没有。等到老爷处理完手边的麻烦事，就会开始这道工序的。"
                                                },
                                                {
                                                    "id": "705120224",
                                                    "speaker": "爱德琳",
                                                    "text": "如果你们有兴趣，老爷或许会邀请你们，参考你们的建议。"
                                                },
                                                {
                                                    "id": "705120225",
                                                    "speaker": "Player",
                                                    "text": "麻烦事？"
                                                },
                                                {
                                                    "id": "705120226",
                                                    "speaker": "爱德琳",
                                                    "text": "两位是知道的，老爷常常听见风声，提前去「招待」一些无礼无德之徒，这次也一样。"
                                                },
                                                {
                                                    "id": "705120227",
                                                    "speaker": "爱德琳",
                                                    "text": "今天老爷大概是去鹰翔海滩附近了，还请两位少安毋躁，先到酒庄里边坐坐吧？"
                                                },
                                                {
                                                    "id": "705120228",
                                                    "speaker": "爱德琳",
                                                    "text": "我还要在门口等待某些客人，海莉和摩可会招待你们的。"
                                                },
                                                {
                                                    "id": "705120229",
                                                    "speaker": "派蒙",
                                                    "text": "无德…无礼？有点不明白爱德琳小姐的意思…",
                                                    "choices": [
                                                        {
                                                            "id": "705120230",
                                                            "text": "我猜，是迪卢克的「兼职」吧。",
                                                            "response": [
                                                                {
                                                                    "id": "705120231",
                                                                    "speaker": "派蒙",
                                                                    "text": "欸？难道说的是暗…"
                                                                },
                                                                {
                                                                    "id": "705120232",
                                                                    "speaker": "派蒙",
                                                                    "text": "咳咳！对付暗中作祟的深渊教团吗？"
                                                                },
                                                                {
                                                                    "id": "705120233",
                                                                    "speaker": "派蒙",
                                                                    "text": "作为迪卢克老爷的伙伴，我们可不能坐视不理！"
                                                                },
                                                                {
                                                                    "id": "705120238",
                                                                    "speaker": "爱德琳",
                                                                    "text": "如果你们两位愿意协助，也是一件好事。毕竟你们是老爷信任的人，实力有保障。"
                                                                },
                                                                {
                                                                    "id": "705120239",
                                                                    "speaker": "爱德琳",
                                                                    "text": "感谢两位主动伸出援手。"
                                                                },
                                                                {
                                                                    "id": "705120240",
                                                                    "speaker": "派蒙",
                                                                    "text": "没什么啦！迪卢克老爷早点闲下来，我们也能更早买到好喝的葡萄汁嘛。"
                                                                },
                                                                {
                                                                    "id": "705120241",
                                                                    "speaker": "派蒙",
                                                                    "text": "#走吧，{NICKNAME}，我们现在就去鹰翔海滩那边看看！"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "705120234",
                                                            "text": "那就先去酒庄里等迪卢克吧。",
                                                            "response": [
                                                                {
                                                                    "id": "705120235",
                                                                    "speaker": "派蒙",
                                                                    "text": "唔，总觉得迪卢克在外面忙，我们却坐在他家里发呆，有点不合适呢。"
                                                                },
                                                                {
                                                                    "id": "705120236",
                                                                    "speaker": "派蒙",
                                                                    "text": "我们还是去鹰翔海滩那边看看，帮迪卢克搞定那些麻烦吧。"
                                                                },
                                                                {
                                                                    "id": "705120237",
                                                                    "speaker": "派蒙",
                                                                    "text": "虽然迪卢克老爷很强，但帮手总是多多益善的嘛。"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "705120218",
                                            "text": "这是在开展额外业务吗…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "705120205",
                            "text": "好像算不上要事…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7051203",
            "objective": "前往鹰翔海滩",
            "dialogues": []
        },
        {
            "id": "7051204",
            "objective": "调查营地",
            "dialogues": [
                {
                    "id": "705120401",
                    "speaker": "派蒙",
                    "text": "看起来不像是迪卢克的帐篷，会是冒险家的营地吗？"
                },
                {
                    "id": "705120402",
                    "speaker": "派蒙",
                    "text": "那里有一张纸条和一本笔记？我们读读看吧。"
                },
                {
                    "id": "705120403",
                    "speaker": "谁人的笔记",
                    "text": "诰告「暗夜英雄」，当年的异常现象再次出现了。"
                },
                {
                    "id": "705120404",
                    "speaker": "谁人的笔记",
                    "text": "原本你已彻底解决问题，但这次地脉又受到了某种刺激，再次释放出了记录中的魔物。"
                },
                {
                    "id": "705120405",
                    "speaker": "谁人的笔记",
                    "text": "你想必会在第一时间赶来，处理掉威胁最大的魔物。"
                },
                {
                    "id": "705120406",
                    "speaker": "谁人的笔记",
                    "text": "我就遵照行动守则，先去通知必要人士了。"
                },
                {
                    "id": "705120407",
                    "speaker": "派蒙",
                    "text": "嗯…看这张纸条的口吻，好像是迪卢克认识的人呢，就先叫他「老爷朋友」吧。"
                },
                {
                    "id": "705120408",
                    "speaker": "派蒙",
                    "text": "他在这里发现了什么不得了的事，给迪卢克老爷留下纸条以后就离开了。"
                },
                {
                    "id": "705120409",
                    "speaker": "派蒙",
                    "text": "真粗心啊，这种纸条要是被别人看到了怎么办？还有笔记本，也没带走…"
                },
                {
                    "id": "705120410",
                    "speaker": "派蒙",
                    "text": "不过这么说来，海滩上那个奇怪的地脉淤积点…"
                },
                {
                    "id": "705120411",
                    "speaker": "Player",
                    "text": "就是他所说的「异常现象」吧。"
                },
                {
                    "id": "705120412",
                    "speaker": "派蒙",
                    "text": "周围没有魔物，也没有不对劲的地方呀？"
                },
                {
                    "id": "705120413",
                    "speaker": "派蒙",
                    "text": "#{NICKNAME}，你还想读一读老爷朋友的笔记吗？"
                },
                {
                    "id": "705120414",
                    "speaker": "派蒙",
                    "text": "如果你不想读了，我们就直接过去，凑近点看看吧。"
                }
            ]
        },
        {
            "id": "7051205",
            "objective": "调查异常的地脉淤积点",
            "dialogues": [
                {
                    "id": "705120501",
                    "speaker": "派蒙",
                    "text": "呜哇！怎么突然冒出来这么多魔物！"
                },
                {
                    "id": "705120502",
                    "speaker": "派蒙",
                    "text": "等等…那是迪卢克老爷吗？"
                },
                {
                    "id": "705120503",
                    "speaker": "派蒙",
                    "text": "和平时的迪卢克不太一样呢…"
                },
                {
                    "id": "705120504",
                    "speaker": "派蒙",
                    "text": "锐气满满，很有干劲的样子！难道这就是「正义人」火力全开的形态吗！",
                    "choices": [
                        {
                            "id": "705120505",
                            "text": "是以前在这里战斗的迪卢克吧。",
                            "response": [
                                {
                                    "id": "705120507",
                                    "speaker": "派蒙",
                                    "text": "确实呢，仔细一看，这个迪卢克好像更年轻。"
                                },
                                {
                                    "id": "705120508",
                                    "speaker": "派蒙",
                                    "text": "但是，以前发生了什么事呢？迪卢克为什么要在这里战斗？"
                                },
                                {
                                    "id": "705120509",
                                    "speaker": "派蒙",
                                    "text": "唔，等到之后去问他本人好了。"
                                },
                                {
                                    "id": "705120510",
                                    "speaker": "派蒙",
                                    "text": "#{NICKNAME}，我们怎么办？",
                                    "choices": [
                                        {
                                            "id": "705120511",
                                            "text": "不能草率行动。",
                                            "response": [
                                                {
                                                    "id": "705120513",
                                                    "speaker": "派蒙",
                                                    "text": "好，那就来看看以前迪卢克战斗的作风吧。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "705120512",
                                            "text": "先观察一下吧。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "705120506",
                            "text": "地脉记录并重现了当时的情景。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7051206",
            "objective": "击败敌人",
            "dialogues": []
        },
        {
            "id": "7051207",
            "objective": "与派蒙讨论当前的情况",
            "dialogues": [
                {
                    "id": "705120701",
                    "speaker": "派蒙",
                    "text": "结束了呢。迪卢克赢得还挺轻松的，不愧是他。"
                },
                {
                    "id": "705120702",
                    "speaker": "派蒙",
                    "text": "可是，现在这里只有一些过去的幻影，好像也没什么危险？",
                    "choices": [
                        {
                            "id": "705120703",
                            "text": "现在的迪卢克应该已经来过了。",
                            "response": [
                                {
                                    "id": "705120705",
                                    "speaker": "派蒙",
                                    "text": "所以说，迪卢克已经收工了吗？"
                                },
                                {
                                    "id": "705120706",
                                    "speaker": "派蒙",
                                    "text": "如果我们再触碰那个异常的地脉淤积点，还会有魔物出现吗？以前的迪卢克呢？"
                                },
                                {
                                    "id": "705120707",
                                    "speaker": "派蒙",
                                    "text": "就像以前在其他地脉淤积点做过的那样，打败所有出现的魔物后，异常的现象就会消失了。",
                                    "choices": [
                                        {
                                            "id": "705120708",
                                            "text": "派蒙对以前的迪卢克很好奇吗？",
                                            "response": [
                                                {
                                                    "id": "705120710",
                                                    "speaker": "派蒙",
                                                    "text": "不是啦，只是有点不放心。"
                                                },
                                                {
                                                    "id": "705120711",
                                                    "speaker": "派蒙",
                                                    "text": "万一有好奇的路人凑过来看热闹，结果「呀~」地跳出来一只魔物，「哐~」地给他一棒，就糟糕了。"
                                                },
                                                {
                                                    "id": "705120712",
                                                    "speaker": "Player",
                                                    "text": "为什么要用奇怪的拟声词…"
                                                },
                                                {
                                                    "id": "705120713",
                                                    "speaker": "派蒙",
                                                    "text": "这样听起来才足够危险呀！"
                                                },
                                                {
                                                    "id": "705120714",
                                                    "speaker": "派蒙",
                                                    "text": "反正，我们原本就打算帮迪卢克的忙，帮人帮到底，干脆多待一会儿，确认没危险再走。"
                                                },
                                                {
                                                    "id": "705120715",
                                                    "speaker": "Player",
                                                    "text": "派蒙也有了很强的责任心呢。"
                                                },
                                                {
                                                    "id": "705120716",
                                                    "speaker": "派蒙",
                                                    "text": "嘿嘿…倒也没有啦，只是为了好喝的葡萄汁。"
                                                },
                                                {
                                                    "id": "705120717",
                                                    "speaker": "派蒙",
                                                    "text": "#好，{NICKNAME}，你再努力一点，等拿到葡萄汁，给你多喝一口！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "705120709",
                                            "text": "派蒙对地脉异常很好奇吗？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "705120704",
                            "text": "就算还有敌人，也只是残兵败将。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7051202",
            "objective": "(test)",
            "dialogues": []
        },
        {
            "id": "7051208",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "705120801",
                    "speaker": "爱德琳",
                    "text": "如果见到了老爷，请代我问候他。"
                },
                {
                    "id": "705120802",
                    "speaker": "爱德琳",
                    "text": "还请两位一定要小心。"
                },
                {
                    "id": "705120803",
                    "speaker": "爱德琳",
                    "text": "「哪怕有着九成的胜算，也不能掉以轻心」，这是老爷的告诫。"
                }
            ]
        },
        {
            "id": "7051299",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "705129906",
                    "speaker": "派蒙",
                    "text": "那边好像有一个营地？迪卢克居然在野外扎营了？"
                },
                {
                    "id": "705129907",
                    "speaker": "派蒙",
                    "text": "总觉得这种事不对劲…难道敌人很棘手，变成了持久战？"
                },
                {
                    "id": "705129908",
                    "speaker": "派蒙",
                    "text": "我们快过去看看吧！"
                }
            ]
        }
    ]
}