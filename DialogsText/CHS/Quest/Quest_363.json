    "talks": [
        {
            "id": "36301",
            "objective": "",
            "dialogues": [
                {
                    "id": "3532801",
                    "speaker": "派蒙",
                    "text": "呀，是不是感受到这个世界的「元素」了？"
                },
                {
                    "id": "3532802",
                    "speaker": "派蒙",
                    "text": "看起来，你只要触碰神像，就能获得「风」的元素力呢。"
                },
                {
                    "id": "3532803",
                    "speaker": "派蒙",
                    "text": "这个世界的人想要获得力量，绝对不可能像你这样轻松…",
                    "choices": [
                        {
                            "id": "3532804",
                            "text": "这力量的来源…果然是…",
                            "response": [
                                {
                                    "id": "3532805",
                                    "speaker": "派蒙",
                                    "text": "嗯，因为你本来就不是这个世界的人嘛。"
                                },
                                {
                                    "id": "3532809",
                                    "speaker": "派蒙",
                                    "text": "从这里向西走，就可以抵达自由城邦「蒙德」。"
                                },
                                {
                                    "id": "3532817",
                                    "speaker": "派蒙",
                                    "text": "蒙德是「风」的城市，在七神中供奉的正是风神。"
                                },
                                {
                                    "id": "3532810",
                                    "speaker": "派蒙",
                                    "text": "能从神像获得力量的你，会不会在那里找到神的线索呢…？"
                                },
                                {
                                    "id": "3532811",
                                    "speaker": "派蒙",
                                    "text": "#而且，蒙德有很多吟游诗人，说不定能打听到你{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTER]}的消息。"
                                },
                                {
                                    "id": "3532812",
                                    "speaker": "派蒙",
                                    "text": "好，那就出发吧！"
                                },
                                {
                                    "id": "3532813",
                                    "speaker": "派蒙",
                                    "text": "这个世界的「元素」回应了祈愿，我觉得这算是一个好兆头哦。"
                                }
                            ]
                        },
                        {
                            "id": "3532807",
                            "text": "真是邪门。",
                            "response": [
                                {
                                    "id": "3532808",
                                    "speaker": "派蒙",
                                    "text": "「邪门」这种词对神灵真是太不尊重了！"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
