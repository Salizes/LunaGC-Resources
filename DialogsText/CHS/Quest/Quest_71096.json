    "talks": [
        {
            "id": "7109601",
            "objective": "test隐藏-将三枚老石交给沐宁$HIDDEN",
            "dialogues": [
                {
                    "id": "710960101",
                    "speaker": "沐宁",
                    "text": "请问两位找到「老石」了吗？"
                },
                {
                    "id": "710960102",
                    "speaker": "Player",
                    "text": "在这里了。"
                }
            ]
        },
        {
            "id": "7109602",
            "objective": "test隐藏-与沐宁对话$HIDDEN",
            "dialogues": [
                {
                    "id": "710960201",
                    "speaker": "沐宁",
                    "text": "又是三枚「老石」。"
                },
                {
                    "id": "710960202",
                    "speaker": "沐宁",
                    "text": "这两位「热心群众」上交的「老石」，我就好好收下了。"
                },
                {
                    "id": "710960203",
                    "speaker": "沐宁",
                    "text": "没想到这么快就找到了三枚，而且品相比我之前见过的都好上不少。"
                },
                {
                    "id": "710960204",
                    "speaker": "沐宁",
                    "text": "唉…这让我想起以前我有的那枚。"
                },
                {
                    "id": "710960205",
                    "speaker": "派蒙",
                    "text": "你的那枚？",
                    "choices": [
                        {
                            "id": "710960206",
                            "text": "你自己有还让我们找？",
                            "response": [
                                {
                                    "id": "710960208",
                                    "speaker": "沐宁",
                                    "text": "是「以前」我有的那枚啦。"
                                },
                                {
                                    "id": "710960209",
                                    "speaker": "沐宁",
                                    "text": "我爸在盛露厅，那枚「老石」是一小块过他手的边角料，品相也不是很好，他就把那枚石头当玩具丢给了我。"
                                },
                                {
                                    "id": "710960210",
                                    "speaker": "沐宁",
                                    "text": "我那时天天和他吵架，游手好闲，还流连那个时候的岩上茶室，欠了一大笔钱，走投无路…"
                                },
                                {
                                    "id": "710960211",
                                    "speaker": "派蒙",
                                    "text": "啊…"
                                },
                                {
                                    "id": "710960212",
                                    "speaker": "Player",
                                    "text": "有点差劲…"
                                },
                                {
                                    "id": "710960213",
                                    "speaker": "沐宁",
                                    "text": "这个，谁都有年轻的时候嘛，反正就是我走投无路之时…"
                                },
                                {
                                    "id": "710960214",
                                    "speaker": "沐宁",
                                    "text": "正好有认出「老石」的人愿意花钱买，一块石头罢了，卖就卖了，得了摩拉解了一时之忧。"
                                },
                                {
                                    "id": "710960215",
                                    "speaker": "沐宁",
                                    "text": "结果前几日我爸聊起这件事时，说，「沐宁啊，你以前玩的那块石头怎么不见了…」"
                                },
                                {
                                    "id": "710960216",
                                    "speaker": "沐宁",
                                    "text": "我只好说，「一块石头而已，还能留到现在？」"
                                },
                                {
                                    "id": "710960217",
                                    "speaker": "沐宁",
                                    "text": "嘴上那么说，心里却想着，要是当初没卖那石头，他聊起的时候掏出来给他看看…"
                                },
                                {
                                    "id": "710960218",
                                    "speaker": "沐宁",
                                    "text": "…算了算了，想这些也没用。"
                                },
                                {
                                    "id": "710960219",
                                    "speaker": "派蒙",
                                    "text": "现在改正了就好。"
                                },
                                {
                                    "id": "710960220",
                                    "speaker": "沐宁",
                                    "text": "你说的是…只不过以前欠的钱还是要慢慢偿还。"
                                },
                                {
                                    "id": "710960221",
                                    "speaker": "沐宁",
                                    "text": "不说了，如果还发现老石，记得带给我。",
                                    "choices": [
                                        {
                                            "id": "710960222",
                                            "text": "还不够吗？",
                                            "response": [
                                                {
                                                    "id": "710960224",
                                                    "speaker": "沐宁",
                                                    "text": "三枚吧，再给我三枚应该够了。"
                                                },
                                                {
                                                    "id": "710960225",
                                                    "speaker": "沐宁",
                                                    "text": "老石本来就是稀有矿材，辉山厅如果还要，层岩巨渊这边估计也找不到更多了。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "710960223",
                                            "text": "到底需要多少？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "710960207",
                            "text": "来，把你自己的先缴了。"
                        }
                    ]
                }
            ]
        }
    ]
}