        {
            "id": "7267801",
            "objective": "前往风龙废墟",
            "dialogues": [
                {
                    "id": "726780101",
                    "speaker": "「吉法师」",
                    "text": "好大的城市，但是…感觉，好荒凉。"
                },
                {
                    "id": "726780102",
                    "speaker": "派蒙",
                    "text": "#以前，我和{NICKNAME}、还有很多同伴一起，曾经在这里和「风魔龙」战斗呢。"
                },
                {
                    "id": "726780103",
                    "speaker": "「吉法师」",
                    "text": "是那种，身体大大，翅膀飞飞、牙齿尖尖，很可怕的龙吗？",
                    "choices": [
                        {
                            "id": "726780104",
                            "text": "其实没有那么可怕。",
                            "response": [
                                {
                                    "id": "726780106",
                                    "speaker": "派蒙",
                                    "text": "吉法师还记得，之前我们在蒙德城看到的风神像吗？"
                                },
                                {
                                    "id": "726780107",
                                    "speaker": "「吉法师」",
                                    "text": "风神像…？"
                                },
                                {
                                    "id": "726780108",
                                    "speaker": "派蒙",
                                    "text": "就是那个，好高好高的石头像啦。"
                                },
                                {
                                    "id": "726780109",
                                    "speaker": "「吉法师」",
                                    "text": "呶！记得。风神的手好大。"
                                },
                                {
                                    "id": "726780110",
                                    "speaker": "派蒙",
                                    "text": "「风魔龙」是风神的好朋友呢！以前，风神也是从这个「城市」来的…"
                                },
                                {
                                    "id": "726780111",
                                    "speaker": "「吉法师」",
                                    "text": "喔！"
                                },
                                {
                                    "id": "726780112",
                                    "speaker": "「吉法师」",
                                    "text": "但是，如果风风龙很大，那要怎么进来呢？",
                                    "choices": [
                                        {
                                            "id": "726780113",
                                            "text": "以前好像也有谁问过一样的问题…",
                                            "response": [
                                                {
                                                    "id": "726780115",
                                                    "speaker": "派蒙",
                                                    "text": "啊，这个派蒙知道！因为它不用像我们这样，从那边走…"
                                                },
                                                {
                                                    "id": "726780116",
                                                    "speaker": "「吉法师」",
                                                    "text": "吉法师想到了。风风龙会飞，所以不用走进来。"
                                                },
                                                {
                                                    "id": "726780117",
                                                    "speaker": "派蒙",
                                                    "text": "可、可恶…"
                                                },
                                                {
                                                    "id": "726780118",
                                                    "speaker": "「吉法师」",
                                                    "text": "呶？派蒙，好像有点不开心？"
                                                },
                                                {
                                                    "id": "726780119",
                                                    "speaker": "派蒙",
                                                    "text": "嗯…这些之后再说，先在这里拍照纪念吧！吉法师，不要乱动喔！"
                                                },
                                                {
                                                    "id": "726780120",
                                                    "speaker": "「吉法师」",
                                                    "text": "吉法师站好！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "726780114",
                                            "text": "是「风魔龙」啦。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "726780105",
                            "text": "其实也很漂亮。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7267802",
            "objective": "为吉法师拍照",
            "dialogues": []
        },
        {
            "id": "7267803",
            "objective": "与吉法师对话",
            "dialogues": [
                {
                    "id": "726780301",
                    "speaker": "「吉法师」",
                    "text": "呶…很好看…"
                },
                {
                    "id": "726780302",
                    "speaker": "派蒙",
                    "text": "吉法师，你怎么啦？"
                },
                {
                    "id": "726780303",
                    "speaker": "「吉法师」",
                    "text": "这个城市很荒凉，感觉有点难过，不知道为什么。奇怪。",
                    "choices": [
                        {
                            "id": "726780304",
                            "text": "我也觉得。",
                            "response": [
                                {
                                    "id": "726780306",
                                    "speaker": "派蒙",
                                    "text": "接下来，我们就向「城市」的中心前进吧。"
                                }
                            ]
                        },
                        {
                            "id": "726780305",
                            "text": "吉法师真奇怪！"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7267804",
            "objective": "向风龙废墟的高塔前进",
            "dialogues": [
                {
                    "id": "726780401",
                    "speaker": "「吉法师」",
                    "text": "呜呶呶…风好大…"
                },
                {
                    "id": "726780402",
                    "speaker": "派蒙",
                    "text": "这里的风墙，是过不去的喔！要绕路走才行。"
                },
                {
                    "id": "726780403",
                    "speaker": "派蒙",
                    "text": "吉法师，跟着我们慢慢从旁边绕上去吧。"
                }
            ]
        },
        {
            "id": "7267809",
            "objective": "沿着风龙废墟的高塔前进",
            "dialogues": []
        },
        {
            "id": "7267805",
            "objective": "沿着风龙废墟的高塔前进",
            "dialogues": [
                {
                    "id": "726780501",
                    "speaker": "派蒙",
                    "text": "终于上来了！"
                },
                {
                    "id": "726780502",
                    "speaker": "派蒙",
                    "text": "这里的视线，比下面好多了。你看，那边就是我们来的地方。"
                },
                {
                    "id": "726780503",
                    "speaker": "「吉法师」",
                    "text": "派蒙很喜欢高的地方？",
                    "choices": [
                        {
                            "id": "726780504",
                            "text": "在高的地方视野很好，滑翔也方便。",
                            "response": [
                                {
                                    "id": "726780507",
                                    "speaker": "「吉法师」",
                                    "text": "风风龙睡在这个塔里面吗？"
                                },
                                {
                                    "id": "726780508",
                                    "speaker": "派蒙",
                                    "text": "嗯，在里面睡了好久好久。"
                                },
                                {
                                    "id": "726780509",
                                    "speaker": "派蒙",
                                    "text": "#虽然{NICKNAME}和「风魔龙」战斗，但是它不是坏龙。"
                                },
                                {
                                    "id": "726780510",
                                    "speaker": "派蒙",
                                    "text": "只是遇到了难过的事情，受了伤害，又被坏人骗了，所以以为，风神朋友不要它了。"
                                },
                                {
                                    "id": "726780511",
                                    "speaker": "「吉法师」",
                                    "text": "呶…后来呢？"
                                },
                                {
                                    "id": "726780512",
                                    "speaker": "派蒙",
                                    "text": "#后来呀…{NICKNAME}，你还记得吗？"
                                },
                                {
                                    "id": "726780513",
                                    "speaker": "Player",
                                    "text": "我们在战斗中，净化了「毒血」。"
                                },
                                {
                                    "id": "726780514",
                                    "speaker": "派蒙",
                                    "text": "但是，战斗的平台也坍塌了。本来，我们，还有风神都要掉到好深好深、好黑好黑的地方去…"
                                },
                                {
                                    "id": "726780515",
                                    "speaker": "「吉法师」",
                                    "text": "#呶！好可怕…那么，派蒙和{NICKNAME}怎么办？飞出来？",
                                    "choices": [
                                        {
                                            "id": "726780516",
                                            "text": "特瓦林救了我们。载着我们飞走了。",
                                            "response": [
                                                {
                                                    "id": "726780517",
                                                    "speaker": "「吉法师」",
                                                    "text": "特…？"
                                                },
                                                {
                                                    "id": "726780518",
                                                    "speaker": "派蒙",
                                                    "text": "就是「风魔龙」啦。"
                                                },
                                                {
                                                    "id": "726780520",
                                                    "speaker": "派蒙",
                                                    "text": "#「风魔龙」是有自己的名字的喔，就像吉法师、派蒙和{NICKNAME}一样。它叫特瓦林。"
                                                },
                                                {
                                                    "id": "726780521",
                                                    "speaker": "派蒙",
                                                    "text": "开始，特瓦林受了伤害、又被坏人骗了，非常非常生气，还到蒙德城去大闹了一场。大家都觉得它是坏龙，所以叫它「风魔龙」。"
                                                },
                                                {
                                                    "id": "726780522",
                                                    "speaker": "派蒙",
                                                    "text": "后来，我们打倒了坏人，又和风神一起净化了污染它的毒血，它才知道，风神其实没有抛弃它。"
                                                },
                                                {
                                                    "id": "726780523",
                                                    "speaker": "「吉法师」",
                                                    "text": "喔！特…风风龙就变好了。"
                                                },
                                                {
                                                    "id": "726780524",
                                                    "speaker": "派蒙",
                                                    "text": "没错！所以说呀…派蒙今天带吉法师到这里来修行，就是想告诉吉法师特瓦林的故事。"
                                                },
                                                {
                                                    "id": "726780525",
                                                    "speaker": "派蒙",
                                                    "text": "吉法师长大以后，也会遇到误解、遇到伤害、遇到难过的事情。"
                                                },
                                                {
                                                    "id": "726780526",
                                                    "speaker": "派蒙",
                                                    "text": "但是，也一定不能变成坏人。因为，「风向是会转变的」…"
                                                },
                                                {
                                                    "id": "726780527",
                                                    "speaker": "Player",
                                                    "text": "总有一天，会吹向更光明的方向。"
                                                },
                                                {
                                                    "id": "726780528",
                                                    "speaker": "「吉法师」",
                                                    "text": "呶？"
                                                },
                                                {
                                                    "id": "726780529",
                                                    "speaker": "Player",
                                                    "text": "对吉法师来说，会不会太难懂？"
                                                },
                                                {
                                                    "id": "726780530",
                                                    "speaker": "「吉法师」",
                                                    "text": "好像懂了，但又不太懂呶…"
                                                },
                                                {
                                                    "id": "726780531",
                                                    "speaker": "「吉法师」",
                                                    "text": "#不过，吉法师知道是很重要的事情。派蒙和{NICKNAME}说的事情，不会忘记的。"
                                                },
                                                {
                                                    "id": "726780532",
                                                    "speaker": "派蒙",
                                                    "text": "嗯！那就没辜负我花了好长好长时间想的故事！"
                                                },
                                                {
                                                    "id": "726780533",
                                                    "speaker": "派蒙",
                                                    "text": "不过，吉法师也不要太贪玩、太调皮，被人封印起来喔。",
                                                    "choices": [
                                                        {
                                                            "id": "726780534",
                                                            "text": "吉法师这次的修行也告一段落了。",
                                                            "response": [
                                                                {
                                                                    "id": "726780536",
                                                                    "speaker": "「吉法师」",
                                                                    "text": "呜呶呶…"
                                                                },
                                                                {
                                                                    "id": "726780537",
                                                                    "speaker": "派蒙",
                                                                    "text": "别这么难过嘛！要笑着回去，这样五百藏才会高兴！"
                                                                },
                                                                {
                                                                    "id": "726780538",
                                                                    "speaker": "派蒙",
                                                                    "text": "#好啦，派蒙和{NICKNAME}也要完成好向导最后的职责啦…"
                                                                },
                                                                {
                                                                    "id": "726780539",
                                                                    "speaker": "派蒙",
                                                                    "text": "那就是，把吉法师送回五百藏身边。",
                                                                    "choices": [
                                                                        {
                                                                            "id": "726780540",
                                                                            "text": "我们走吧。",
                                                                            "response": [
                                                                                {
                                                                                    "id": "726780542",
                                                                                    "speaker": "「吉法师」",
                                                                                    "text": "呶。"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "726780541",
                                                                            "text": "我们走吧，吉法师。"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "726780535",
                                                            "text": "五百藏的委托也算是完成了吧。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "726780519",
                                            "text": "风魔龙救了我们。载着我们飞走了。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "726780505",
                            "text": "「笨蛋和烟…」",
                            "response": [
                                {
                                    "id": "726780506",
                                    "speaker": "派蒙",
                                    "text": "喂！才不是这么回事啦。在高的地方，视野很好，而且空气也比较清新。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7267806",
            "objective": "沿着风龙废墟的高塔前进",
            "dialogues": []
        },
        {
            "id": "7267807",
            "objective": "沿着风龙废墟的高塔前进",
            "dialogues": []
        },
        {
            "id": "7267811",
            "objective": "回到镇守之森，拜访五百藏",
            "dialogues": [
                {
                    "id": "726790101",
                    "speaker": "派蒙",
                    "text": "五百藏，我们回来啦！"
                },
                {
                    "id": "726790102",
                    "speaker": "五百藏",
                    "text": "喔，回来啦！吉法师，修行的成果如何？"
                },
                {
                    "id": "726790103",
                    "speaker": "「吉法师」",
                    "text": "咔嚓咔嚓，砰砰！"
                },
                {
                    "id": "726790104",
                    "speaker": "五百藏",
                    "text": "呶哈哈哈，真不错！"
                },
                {
                    "id": "726790105",
                    "speaker": "派蒙",
                    "text": "呜哇，又听不懂吉法师说的话了…"
                },
                {
                    "id": "726790106",
                    "speaker": "派蒙",
                    "text": "我们还拍了好多好多照片。五百藏，你看…"
                },
                {
                    "id": "726790107",
                    "speaker": "Black Screen",
                    "text": "将这段时间一同旅行时，为吉法师拍的照片，一张张交给了五百藏。\\n连同旅行中遇到的事情，也说给了五百藏听。"
                },
                {
                    "id": "726790108",
                    "speaker": "派蒙",
                    "text": "…就这样，我们完成了五百藏「带吉法师去八个地方修行」的要求。"
                },
                {
                    "id": "726790109",
                    "speaker": "五百藏",
                    "text": "嗯！不愧是吾辈看上的人，真不错。假如你们这些小辈是狸子，那想必也能成为名震天下的大妖狸。可能加起来有吾辈一半强吧！"
                },
                {
                    "id": "726790110",
                    "speaker": "派蒙",
                    "text": "（听起来也没有很强嘛…）"
                },
                {
                    "id": "726790111",
                    "speaker": "派蒙",
                    "text": "不过，既然任务完成了，我们也该走了。"
                },
                {
                    "id": "726790112",
                    "speaker": "「吉法师」",
                    "text": "呜呶呶。"
                },
                {
                    "id": "726790113",
                    "speaker": "派蒙",
                    "text": "好啦好啦，别这样。派蒙再教吉法师一件事！"
                },
                {
                    "id": "726790114",
                    "speaker": "派蒙",
                    "text": "和朋友告别的时候，要笑着告别！这样的话，下次再见的时候，会更加开心！"
                },
                {
                    "id": "726790115",
                    "speaker": "五百藏",
                    "text": "…唔？好的，没问题。交给吾辈吧。"
                },
                {
                    "id": "726790116",
                    "speaker": "五百藏",
                    "text": "吉法师说，「知道了。白毛。」"
                },
                {
                    "id": "726790117",
                    "speaker": "派蒙",
                    "text": "欸？难道…",
                    "choices": [
                        {
                            "id": "726790118",
                            "text": "吉法师又不能说话了？",
                            "response": [
                                {
                                    "id": "726790120",
                                    "speaker": "五百藏",
                                    "text": "过了这么久时间，妖狸饭的效果也该消退了嘛。"
                                },
                                {
                                    "id": "726790121",
                                    "speaker": "五百藏",
                                    "text": "哼，吾辈要是没被封印在石头里的话，想要让你们一直都能听懂妖狸说的话，也是易如…"
                                },
                                {
                                    "id": "726790122",
                                    "speaker": "五百藏",
                                    "text": "…嗯？好，吾辈帮你传达一下。"
                                },
                                {
                                    "id": "726790123",
                                    "speaker": "五百藏",
                                    "text": "「吉法师要努力修行。」"
                                },
                                {
                                    "id": "726790124",
                                    "speaker": "五百藏",
                                    "text": "「变成像五百藏那样的大妖狸。」"
                                },
                                {
                                    "id": "726790125",
                                    "speaker": "五百藏",
                                    "text": "…呶？你这家伙，口气不小。呶哈哈哈，有吾辈当年的气魄。"
                                },
                                {
                                    "id": "726790126",
                                    "speaker": "五百藏",
                                    "text": "「那样，白毛、黄毛不用吃妖狸的饭，也可以听懂吉法师说话。」"
                                },
                                {
                                    "id": "726790127",
                                    "speaker": "派蒙",
                                    "text": "…嗯！我会等着，下次和吉法师一起修行。"
                                },
                                {
                                    "id": "726790128",
                                    "speaker": "Player",
                                    "text": "吉法师要加油。"
                                },
                                {
                                    "id": "726790129",
                                    "speaker": "Player",
                                    "text": "不要被人封印了喔。"
                                },
                                {
                                    "id": "726790130",
                                    "speaker": "五百藏",
                                    "text": "呶？！"
                                },
                                {
                                    "id": "726790131",
                                    "speaker": "「吉法师」",
                                    "text": "呶！"
                                },
                                {
                                    "id": "726790132",
                                    "speaker": "五百藏",
                                    "text": "算了，看你们这些人类带吉法师修行的份上，吾辈就不计较了。"
                                },
                                {
                                    "id": "726790133",
                                    "speaker": "五百藏",
                                    "text": "对了。之前有个叫歌麿的家伙，在镇守之森里画被封印的狸子，还留下了一些画稿。"
                                },
                                {
                                    "id": "726790134",
                                    "speaker": "五百藏",
                                    "text": "就给你们吧。如果想念我们妖狸一族的俊朗模样，就看看这些画像吧！"
                                },
                                {
                                    "id": "726790135",
                                    "speaker": "五百藏",
                                    "text": "唉，如果你们是妖狸就好了…"
                                },
                                {
                                    "id": "726790136",
                                    "speaker": "Player",
                                    "text": "…那我们早该变成石头了。"
                                },
                                {
                                    "id": "726790137",
                                    "speaker": "五百藏",
                                    "text": "哼，也对。没啥事就快走吧，吾辈，还要教吉法师法术呢。"
                                }
                            ]
                        },
                        {
                            "id": "726790119",
                            "text": "我们又听不懂吉法师说的话了？"
                        }
                    ]
                }
            ]
