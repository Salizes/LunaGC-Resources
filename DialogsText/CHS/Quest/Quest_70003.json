    "talks": [
        {
            "id": "7000301",
            "objective": "(test)【隐藏】活动界面接取任务$HIDDEN",
            "dialogues": [
                {
                    "id": "700030101",
                    "speaker": "阿拉米",
                    "text": "唉，该怎么办呢…"
                },
                {
                    "id": "700030102",
                    "speaker": "Player",
                    "text": "你遇到什么麻烦了？"
                },
                {
                    "id": "700030103",
                    "speaker": "阿拉米",
                    "text": "风花节一到，总有人到这里向神像献上各种花卉，风一吹，那些花卉散落的花瓣就会飞向全城。"
                },
                {
                    "id": "700030104",
                    "speaker": "阿拉米",
                    "text": "为了清理这些枯花，我们也没少花力气，但是，广场上的花瓣和落叶我还能帮着清理一下，吹到屋顶和城墙上的我可就没辙了。"
                },
                {
                    "id": "700030105",
                    "speaker": "阿拉米",
                    "text": "特别是我这个膝盖，真是越来越顶不住了…"
                },
                {
                    "id": "700030106",
                    "speaker": "Player",
                    "text": "我可以帮忙。"
                },
                {
                    "id": "700030107",
                    "speaker": "阿拉米",
                    "text": "你愿意帮忙吗？那太好了，那些枯萎的花瓣堆很明显，你爬上屋顶之后，应该就能很容易看到了。"
                }
            ]
        },
        {
            "id": "7000302",
            "objective": "与阿拉米对话",
            "dialogues": []
        },
        {
            "id": "7000303",
            "objective": "扫除房顶上的枯花堆",
            "dialogues": [
                {
                    "id": "700030301",
                    "speaker": "派蒙",
                    "text": "哇…真的堆积了不少呢，快把这些花瓣堆清理干净吧。"
                }
            ]
        },
        {
            "id": "7000304",
            "objective": "扫除房顶上的枯花堆",
            "dialogues": [
                {
                    "id": "700030401",
                    "speaker": "派蒙",
                    "text": "咦？是什么声音？好像是猫叫…"
                },
                {
                    "id": "700030402",
                    "speaker": "派蒙",
                    "text": "不知道在哪…我们一边清理，一边留意一下吧。"
                }
            ]
        },
        {
            "id": "7000305",
            "objective": "扫除城墙上的枯花堆",
            "dialogues": [
                {
                    "id": "700030501",
                    "speaker": "派蒙",
                    "text": "真的有只小猫呢，为什么会跑到这里来呢…"
                },
                {
                    "id": "700030502",
                    "speaker": "迷路的小猫",
                    "text": "喵…喵…",
                    "choices": [
                        {
                            "id": "700030503",
                            "text": "喵喵喵？",
                            "response": [
                                {
                                    "id": "700030505",
                                    "speaker": "迷路的小猫",
                                    "text": "喵，喵！"
                                },
                                {
                                    "id": "700030506",
                                    "speaker": "派蒙",
                                    "text": "嗯…我觉得它听不懂你在说什么…"
                                },
                                {
                                    "id": "700030507",
                                    "speaker": "派蒙",
                                    "text": "还是先把它抱下去吧，说不定阿拉米先生会知道它的主人是谁呢。"
                                }
                            ]
                        },
                        {
                            "id": "700030504",
                            "text": "你迷路了吗？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7000306",
            "objective": "寻找小猫",
            "dialogues": [
                {
                    "id": "700030601",
                    "speaker": "阿拉米",
                    "text": "实在抱歉，我好像没见到，如果真的看见的话，我应该有印象才对…"
                },
                {
                    "id": "700030602",
                    "speaker": "玛格丽特",
                    "text": "是吗，那孩子一直很喜欢花瓣，我还以为它会追着花瓣跑到这来…"
                },
                {
                    "id": "700030603",
                    "speaker": "Player",
                    "text": "你们是在找猫吗？"
                },
                {
                    "id": "700030604",
                    "speaker": "迷路的小猫",
                    "text": "喵…喵！"
                },
                {
                    "id": "700030605",
                    "speaker": "玛格丽特",
                    "text": "这声音是…小蝴蝶？真是的，你跑到哪儿去了？"
                },
                {
                    "id": "700030606",
                    "speaker": "Player",
                    "text": "它跑到屋顶上去了。"
                },
                {
                    "id": "700030607",
                    "speaker": "玛格丽特",
                    "text": "果然和我想的一样…多谢你了。小蝴蝶总喜欢追着花瓣到处跑，在这个满城都飘着花瓣的风花节，也格外让人头疼，幸好有你帮忙。"
                },
                {
                    "id": "700030608",
                    "speaker": "玛格丽特",
                    "text": "下次你来「猫尾酒馆」的话，我可以请你喝一杯哦，啊，当然是不含酒的。",
                    "choices": [
                        {
                            "id": "700030609",
                            "text": "果然是这样…",
                            "response": [
                                {
                                    "id": "700030611",
                                    "speaker": "玛格丽特",
                                    "text": "呵呵，总之谢谢你了，那就回头再见啦。祝你风花节快乐。"
                                },
                                {
                                    "id": "700030612",
                                    "speaker": "阿拉米",
                                    "text": "没想到连猫也会被花瓣吸引，风花节还真是热闹…不过，还好是让你给找到了。"
                                },
                                {
                                    "id": "700030613",
                                    "speaker": "阿拉米",
                                    "text": "要是让我爬上城墙去找猫，我这膝盖可真的就吃不消了…"
                                },
                                {
                                    "id": "700030614",
                                    "speaker": "阿拉米",
                                    "text": "真是麻烦你了，这些谢礼请你收下吧。"
                                }
                            ]
                        },
                        {
                            "id": "700030610",
                            "text": "还是留到将来吧。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7000307",
            "objective": "(test)【隐藏】自动触发找猫对话$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7000308",
            "objective": "向阿拉米回报",
            "dialogues": []
        },
        {
            "id": "7000302",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "700030201",
                    "speaker": "阿拉米",
                    "text": "唉，又是台阶又是楼顶的，爬上爬下…不知道我的膝盖还能撑几年…"
                }
            ]
        }
    ]
