    "talks": [
        {
            "id": "7304929",
            "objective": "",
            "dialogues": [
                {
                    "id": "730492901",
                    "speaker": "鲁克沙",
                    "text": "这次真是多谢你们了…"
                },
                {
                    "id": "730492902",
                    "speaker": "鲁克沙",
                    "text": "对了，如果有卡西姆的行踪，也欢迎你们告诉我。"
                }
            ]
        },
        {
            "id": "7304903",
            "objective": "",
            "dialogues": [
                {
                    "id": "730490317",
                    "speaker": "派蒙",
                    "text": "#嘘，{NICKNAME}，你看那边！有一个镀金旅团的和…一个愚人众！"
                },
                {
                    "id": "730490301",
                    "speaker": "？？？",
                    "text": "卡西姆…这些桑格吉拉光机运作情况怎么样？"
                },
                {
                    "id": "730490302",
                    "speaker": "卡西姆",
                    "text": "情况良好，奥列格…"
                },
                {
                    "id": "730490303",
                    "speaker": "卡西姆",
                    "text": "这就是这次的结果报告，按现在的情况进行下去…不用多长时间就能提取到你们愚人众想要的东西…"
                },
                {
                    "id": "730490304",
                    "speaker": "奥列格",
                    "text": "好啊，哈哈哈，有你的帮助，一定能够在最短的时间内完成执行官大人的命令。"
                },
                {
                    "id": "730490305",
                    "speaker": "奥列格",
                    "text": "不过，如果你胆敢骗我…你自己知道后果！"
                },
                {
                    "id": "730490306",
                    "speaker": "卡西姆",
                    "text": "骗你对我有什么好处？"
                },
                {
                    "id": "730490307",
                    "speaker": "奥列格",
                    "text": "你清楚就好。"
                },
                {
                    "id": "730490308",
                    "speaker": "奥列格",
                    "text": "嘿，那个特洛芬·雪奈茨维奇…办事不力，在这里好几年都毫无建树，我这么快就拿出成果，到时候，看他还有什么狡辩的话说…"
                },
                {
                    "id": "730490309",
                    "speaker": "卡西姆",
                    "text": "特洛芬·雪奈茨维奇…我在须弥可没听过这个名字…"
                },
                {
                    "id": "730490310",
                    "speaker": "奥列格",
                    "text": "哈哈那是当然，他怎么可能用这个名字，岂不是一下就暴露了…执行官大人交给他的任务，几年了，一点进展也没有。"
                },
                {
                    "id": "730490311",
                    "speaker": "奥列格",
                    "text": "…不对，谁，谁在那里？你是怎么到这儿来的？"
                },
                {
                    "id": "730490312",
                    "speaker": "派蒙",
                    "text": "#呜哇，{NICKNAME}，被发现了！"
                },
                {
                    "id": "730490313",
                    "speaker": "卡西姆",
                    "text": "…我也该走了。"
                },
                {
                    "id": "730490314",
                    "speaker": "卡西姆",
                    "text": "呵，愚人众，不会被区区一个误入此地的冒险家击败吧。"
                },
                {
                    "id": "730490315",
                    "speaker": "奥列格",
                    "text": "这还用不着镀金旅团的人操心…哼，等我先把这个偷跑进来的老鼠消灭了，再去说好的实验营地找你！"
                },
                {
                    "id": "730490316",
                    "speaker": "Black Screen",
                    "text": "卡西姆离开了…"
                }
            ]
        },
        {
            "id": "7304904",
            "objective": "与奥列格战斗",
            "dialogues": []
        },
        {
            "id": "7304905",
            "objective": "与奥列格对话",
            "dialogues": [
                {
                    "id": "730490501",
                    "speaker": "奥列格",
                    "text": "要不是为了重新占领营地没有好好休息…哼，我之后再找你们算账！"
                },
                {
                    "id": "730490502",
                    "speaker": "Black Screen",
                    "text": "奥列格趁乱逃跑了…"
                },
                {
                    "id": "730490503",
                    "speaker": "派蒙",
                    "text": "哇，没想到跑得还是挺快的，一溜烟人就没影了…"
                },
                {
                    "id": "730490504",
                    "speaker": "派蒙",
                    "text": "不过他刚才掉下来的这个是…「紧急调整计划书」？"
                },
                {
                    "id": "730490505",
                    "speaker": "派蒙",
                    "text": "我看看上面写了什么…"
                },
                {
                    "id": "730490506",
                    "speaker": "派蒙",
                    "text": "「关于桑格吉拉光机一事，乃至冬国在须弥研究极为重要的一环，绝不容许有失…近来实验营地连番遭人攻破，致使光机停运…」"
                },
                {
                    "id": "730490507",
                    "speaker": "派蒙",
                    "text": "是嘛，居然有人连番攻破了他们的营地，真不知道是哪里来的好心人！",
                    "choices": [
                        {
                            "id": "730490508",
                            "text": "就是我们啦！",
                            "response": [
                                {
                                    "id": "730490510",
                                    "speaker": "派蒙",
                                    "text": "嘿嘿，对哦…然后呢，「须重新夺回实验营地，今日将加强巡逻…<color=#00E1FFFF>按此图所标营地之顺序</color>，依次进行检查…」"
                                },
                                {
                                    "id": "730490511",
                                    "speaker": "派蒙",
                                    "text": "从这张图上看来，我们所在的营地就是巡逻的起点。"
                                },
                                {
                                    "id": "730490512",
                                    "speaker": "派蒙",
                                    "text": "也就是说，他们必须占回来的就是这四个营地吧！没想到镀金旅团居然会和愚人众搭上线呢…"
                                },
                                {
                                    "id": "730490513",
                                    "speaker": "派蒙",
                                    "text": "唔…最后是「立即自行动据点出发，执行上述计划。」他们居然还有一个行动据点…"
                                },
                                {
                                    "id": "730490514",
                                    "speaker": "派蒙",
                                    "text": "哼，要是让我们知道这个行动据点在哪里…"
                                },
                                {
                                    "id": "730490515",
                                    "speaker": "Player",
                                    "text": "就把他们一锅端了！"
                                },
                                {
                                    "id": "730490516",
                                    "speaker": "派蒙",
                                    "text": "嗯！现在就按照图上标注的营地顺序走一趟吧，一定能在那边抓住愚人众！"
                                }
                            ]
                        },
                        {
                            "id": "730490509",
                            "text": "也没有别人了吧！"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7304908",
            "objective": "前往第二个营地",
            "dialogues": []
        },
        {
            "id": "7304909",
            "objective": "与奥列格战斗",
            "dialogues": []
        },
        {
            "id": "7304910",
            "objective": "与奥列格对话",
            "dialogues": [
                {
                    "id": "730491001",
                    "speaker": "奥列格",
                    "text": "唔，没想到这次也…"
                },
                {
                    "id": "730491002",
                    "speaker": "奥列格",
                    "text": "看你们的样子，应该也是「拿摩拉办事」的那种类型吧。"
                },
                {
                    "id": "730491003",
                    "speaker": "奥列格",
                    "text": "不如这样，我给你们摩拉，你就别妨碍我们在这做事，行不行？"
                },
                {
                    "id": "730491004",
                    "speaker": "派蒙",
                    "text": "#哇，{NICKNAME}，他虽然是个愚人众，但是看人的眼光还挺准的！"
                },
                {
                    "id": "730491005",
                    "speaker": "派蒙",
                    "text": "不过你听好了，摩拉我们要…"
                },
                {
                    "id": "730491006",
                    "speaker": "Player",
                    "text": "事我们也要管！"
                },
                {
                    "id": "730491007",
                    "speaker": "奥列格",
                    "text": "怎么有你们这么麻烦的人，给我记住了，下次有你们好看的！"
                },
                {
                    "id": "730491008",
                    "speaker": "Black Screen",
                    "text": "奥列格趁乱逃跑了…"
                },
                {
                    "id": "730491009",
                    "speaker": "派蒙",
                    "text": "唔，根本看不清他逃跑的动作…感觉眼前一黑，他就不见踪影了。"
                },
                {
                    "id": "730491010",
                    "speaker": "派蒙",
                    "text": "这个愚人众，论起逃跑来还真有两把刷子！"
                },
                {
                    "id": "730491011",
                    "speaker": "派蒙",
                    "text": "一个…两个…那下一个就是巡逻路线上第三个营地了。我们不会在那还能碰见他吧…"
                }
            ]
        },
        {
            "id": "7304911",
            "objective": "前往第三个营地",
            "dialogues": []
        },
        {
            "id": "7304912",
            "objective": "与奥列格战斗",
            "dialogues": []
        },
        {
            "id": "7304913",
            "objective": "与奥列格对话",
            "dialogues": [
                {
                    "id": "730491301",
                    "speaker": "奥列格",
                    "text": "天哪，你们到底想要什么啊？"
                },
                {
                    "id": "730491302",
                    "speaker": "派蒙",
                    "text": "当然是希望你们不要再做坏事了！"
                },
                {
                    "id": "730491303",
                    "speaker": "Player",
                    "text": "还有说出这些机器的作用！"
                },
                {
                    "id": "730491304",
                    "speaker": "奥列格",
                    "text": "…哼，怎么可能，想太多了吧你们！"
                },
                {
                    "id": "730491305",
                    "speaker": "奥列格",
                    "text": "不行，今天已经花费太多精力在战斗上了…得回据点休整一番…"
                },
                {
                    "id": "730491306",
                    "speaker": "Black Screen",
                    "text": "奥列格趁乱逃跑了…"
                },
                {
                    "id": "730491307",
                    "speaker": "派蒙",
                    "text": "可恶，到底为什么，每次都能被他逃掉呀…"
                },
                {
                    "id": "730491308",
                    "speaker": "派蒙",
                    "text": "不过，他好像根本没发现自己的计划书被我们捡到了，看到我们时还挺惊讶的呢…"
                },
                {
                    "id": "730491309",
                    "speaker": "派蒙",
                    "text": "他说要回据点休整，就不会去巡逻图上最后的试验营地了吧…",
                    "choices": [
                        {
                            "id": "730491310",
                            "text": "但是计划书上写着…",
                            "response": [
                                {
                                    "id": "730491312",
                                    "speaker": "派蒙",
                                    "text": "嗯，说得对，也不能不管那些被打开的奇怪吸风机…"
                                }
                            ]
                        },
                        {
                            "id": "730491311",
                            "text": "就当去清理愚人众了！"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7304914",
            "objective": "前往路线最后的营地",
            "dialogues": []
        },
        {
            "id": "7304915",
            "objective": "击败「大盗卡西姆」",
            "dialogues": []
        },
        {
            "id": "7304916",
            "objective": "与卡西姆对话",
            "dialogues": [
                {
                    "id": "730491601",
                    "speaker": "卡西姆",
                    "text": "痛痛痛痛痛，哎呦呦，别打了，别打了…住手住手！"
                },
                {
                    "id": "730491602",
                    "speaker": "派蒙",
                    "text": "你真的是什么传说大盗吗…"
                },
                {
                    "id": "730491603",
                    "speaker": "Player",
                    "text": "未免太弱了一些..."
                },
                {
                    "id": "730491604",
                    "speaker": "卡西姆",
                    "text": "所谓的大盗，有的时候靠的并不是个人的武力..."
                },
                {
                    "id": "730491605",
                    "speaker": "派蒙",
                    "text": "哼，油嘴滑舌的，看来我们得好好盘问他！"
                }
            ]
        },
        {
            "id": "7304917",
            "objective": "盘问卡西姆",
            "dialogues": [
                {
                    "id": "730491701",
                    "speaker": "卡西姆",
                    "text": "你们问，你们问，我一定知无不言，言无不尽，嘿嘿…"
                },
                {
                    "id": "730491702",
                    "speaker": "Player",
                    "text": "你真的是镀金旅团的大盗贼吗？"
                },
                {
                    "id": "730491703",
                    "speaker": "卡西姆",
                    "text": "那当然了…",
                    "choices": [
                        {
                            "id": "730491704",
                            "text": "镀金旅团构成还真复杂啊…",
                            "response": [
                                {
                                    "id": "730491705",
                                    "speaker": "卡西姆",
                                    "text": "毕竟是镀金旅团嘛，来自各处的，可是什么人都有啊，哈哈!"
                                },
                                {
                                    "id": "730491709",
                                    "speaker": "派蒙",
                                    "text": "说起来，到底愚人众是怎么找到你的呀！"
                                },
                                {
                                    "id": "730491710",
                                    "speaker": "卡西姆",
                                    "text": "当然是因为我在镀金旅团闯下的赫赫声名…",
                                    "choices": [
                                        {
                                            "id": "730491711",
                                            "text": "毕竟镀金旅团是须弥本地人…",
                                            "response": [
                                                {
                                                    "id": "730491712",
                                                    "speaker": "卡西姆",
                                                    "text": "虽然教令院部分贤者好像和愚人众明面上有合作，不过，暗中的手可是很难伸到须弥来的…这就是我起作用的时候啦！"
                                                },
                                                {
                                                    "id": "730491713",
                                                    "speaker": "派蒙",
                                                    "text": "居然还说的这么自豪…"
                                                },
                                                {
                                                    "id": "730491718",
                                                    "speaker": "派蒙",
                                                    "text": "总之就是，愚人众为了什么奇怪的实验找上了你，让你在营地里布置那些奇怪的吸气机器…"
                                                },
                                                {
                                                    "id": "730491719",
                                                    "speaker": "卡西姆",
                                                    "text": "哎呀，原来二位说的是「桑格吉拉光机」呀，愚人众好像想要一个能够提取死域能量的机器，所以我就提供给他们了…"
                                                },
                                                {
                                                    "id": "730491720",
                                                    "speaker": "派蒙",
                                                    "text": "提取死域能量的机器！"
                                                },
                                                {
                                                    "id": "730491721",
                                                    "speaker": "卡西姆",
                                                    "text": "对啊，提取死域能量的机器，那可是我好不容易从遗迹中发掘而出…",
                                                    "choices": [
                                                        {
                                                            "id": "730491722",
                                                            "text": "真的吗？",
                                                            "response": [
                                                                {
                                                                    "id": "730491723",
                                                                    "speaker": "派蒙",
                                                                    "text": "感觉须弥的遗迹里出现什么都不奇怪…"
                                                                },
                                                                {
                                                                    "id": "730491728",
                                                                    "speaker": "卡西姆",
                                                                    "text": "不过到底能不能从死域里提取能量我就不知道了，反正愚人众也不懂这些，每次我就编造点实验结果给他们…"
                                                                },
                                                                {
                                                                    "id": "730491729",
                                                                    "speaker": "派蒙",
                                                                    "text": "什么呀，你岂不是在骗那些愚人众！"
                                                                },
                                                                {
                                                                    "id": "730491730",
                                                                    "speaker": "卡西姆",
                                                                    "text": "哎呀，不过这个，嘿嘿，我骗愚人众，对二位来说不就是好事嘛…"
                                                                },
                                                                {
                                                                    "id": "730491731",
                                                                    "speaker": "派蒙",
                                                                    "text": "说是这么说…我甚至一瞬间都不知道你和愚人众谁更坏一点了。"
                                                                },
                                                                {
                                                                    "id": "730491732",
                                                                    "speaker": "派蒙",
                                                                    "text": "对了，既然你和愚人众合作了这么久，你一定知道他们据点的位置吧！"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "730491724",
                                                            "text": "又骗人，想挨揍吗？",
                                                            "response": [
                                                                {
                                                                    "id": "730491725",
                                                                    "speaker": "卡西姆",
                                                                    "text": "…好啦我说实话，其实是我从一个叫「阿巴图伊」的学者手里买过来的，具体我也忘了，不过我记得也是个什么提取器吧！"
                                                                },
                                                                {
                                                                    "id": "730491726",
                                                                    "speaker": "卡西姆",
                                                                    "text": "我就取了个名字，说是能够提取死域的能量…"
                                                                },
                                                                {
                                                                    "id": "730491727",
                                                                    "speaker": "卡西姆",
                                                                    "text": "反正也只是为了骗骗那群愚人众，毕竟这个造型看上去还是挺唬人的嘛，嘿嘿嘿…"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "730491714",
                                            "text": "老实点，说实话！",
                                            "response": [
                                                {
                                                    "id": "730491715",
                                                    "speaker": "卡西姆",
                                                    "text": "哎…其实我以前离开过须弥一段时间，自称「须弥大盗卡西姆」搭上了愚人众的线…嘿嘿…"
                                                },
                                                {
                                                    "id": "730491716",
                                                    "speaker": "卡西姆",
                                                    "text": "之后就用愚人众的钱回须弥招兵买马，在镀金旅团这儿也坐实了「大盗卡西姆」之名，但是相对的…也没法拒绝愚人众的要求…"
                                                },
                                                {
                                                    "id": "730491717",
                                                    "speaker": "派蒙",
                                                    "text": "原来是这么一回事…"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "730491706",
                            "text": "那我们去见见三十人团…",
                            "response": [
                                {
                                    "id": "730491707",
                                    "speaker": "卡西姆",
                                    "text": "哎，别什么都扯上三十人团嘛，有话好说有话好说…唉，好吧，「大盗卡西姆」只是一个「艺名」，总要有幌子才能骗到人嘛…"
                                },
                                {
                                    "id": "730491708",
                                    "speaker": "卡西姆",
                                    "text": "像这次，愚人众就上了我的当…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7304927",
            "objective": "",
            "dialogues": [
                {
                    "id": "730492701",
                    "speaker": "卡西姆",
                    "text": "唉，事到如今也没什么好瞒着你们的啦…最近一直给他们编造出来的实验结果，他们好像也多少有点起疑心了…"
                },
                {
                    "id": "730492702",
                    "speaker": "卡西姆",
                    "text": "我告诉你们据点在哪，你们把他们抓住吧，这样我编造假结果的事，愚人众就再也发现不了了…"
                },
                {
                    "id": "730492703",
                    "speaker": "派蒙",
                    "text": "哇，这个人真是一肚子坏水，愚人众跟他合作，真是倒了大霉了！"
                },
                {
                    "id": "730492704",
                    "speaker": "Player",
                    "text": "不过姑且还是听他说说…"
                },
                {
                    "id": "730492705",
                    "speaker": "卡西姆",
                    "text": "在水天丛林山上的帐篷附近，有四个火把。在夜晚点亮火把…"
                },
                {
                    "id": "730492706",
                    "speaker": "卡西姆",
                    "text": "这样，愚人众就会用信号灯映照山上营地，你要是看见附近山崖上的闪光点…"
                },
                {
                    "id": "730492707",
                    "speaker": "派蒙",
                    "text": "就说明愚人众行动据点就在那里了吧！这办法听上去还挺神奇的…"
                },
                {
                    "id": "730492708",
                    "speaker": "卡西姆",
                    "text": "对，到时候愚人众就会隔着门跟你对暗号，暗号说对了才会放你进去…"
                },
                {
                    "id": "730492709",
                    "speaker": "派蒙",
                    "text": "还有暗号！"
                },
                {
                    "id": "730492710",
                    "speaker": "卡西姆",
                    "text": "对，我想想，上半句是这样的，「不要带着自己的规则手册…」"
                },
                {
                    "id": "730492711",
                    "speaker": "卡西姆",
                    "text": "下半句则是，「去别人的地盘。」"
                },
                {
                    "id": "730492712",
                    "speaker": "派蒙",
                    "text": "哇，真希望愚人众能够做到自己暗号里说的事啊…"
                },
                {
                    "id": "730492713",
                    "speaker": "卡西姆",
                    "text": "来，试一次，「不要带着自己的规则手册…」"
                },
                {
                    "id": "730492714",
                    "speaker": "Player",
                    "text": "「去别人的地盘。」"
                },
                {
                    "id": "730492715",
                    "speaker": "卡西姆",
                    "text": "好，去吧！就算是为了我不暴露，也得把他们全部抓起来啊！"
                },
                {
                    "id": "730492716",
                    "speaker": "卡西姆",
                    "text": "嘿嘿，你看，这么紧要的情报我都告诉你们了，不知道你们愿不愿意，就是…高抬贵手…"
                },
                {
                    "id": "730492717",
                    "speaker": "派蒙",
                    "text": "哼，以后可不许再做坏事了！要是下次遇见你又在搞什么阴谋诡计…我们就把你送到三十人团手上！"
                },
                {
                    "id": "730492718",
                    "speaker": "卡西姆",
                    "text": "再也不敢了，有二位在须弥，我可是一千万个不敢，绝不做坏事了，所以就饶了我这一回吧！"
                },
                {
                    "id": "730492719",
                    "speaker": "卡西姆",
                    "text": "嘿嘿，那我就先走了，祝两位旗开得胜啊！"
                },
                {
                    "id": "730492720",
                    "speaker": "Black Screen",
                    "text": "卡西姆狼狈地离开了…"
                },
                {
                    "id": "730492721",
                    "speaker": "派蒙",
                    "text": "嗯…虽然总觉得应该先把这个家伙交给治安官…"
                },
                {
                    "id": "730492722",
                    "speaker": "派蒙",
                    "text": "不过还是先去解决愚人众吧。"
                }
            ]
        },
        {
            "id": "7304928",
            "objective": "",
            "dialogues": [
                {
                    "id": "730492801",
                    "speaker": "卡西姆",
                    "text": "愚人众行动据点的位置…哎呀，据点的位置那当然是知道的…就在…"
                },
                {
                    "id": "730492802",
                    "speaker": "卡西姆",
                    "text": "…对了，你们看到那边的山了吗？"
                },
                {
                    "id": "730492803",
                    "speaker": "派蒙",
                    "text": "那边的山，难道愚人众的行动据点就在那里？"
                },
                {
                    "id": "730492804",
                    "speaker": "派蒙",
                    "text": "那边看上去什么都没有啊…卡西姆，咦卡西姆人呢？"
                },
                {
                    "id": "730492805",
                    "speaker": "Player",
                    "text": "看来是趁机开溜啦！"
                },
                {
                    "id": "730492806",
                    "speaker": "派蒙",
                    "text": "呜哇，真是卑鄙！"
                },
                {
                    "id": "730492808",
                    "speaker": "派蒙",
                    "text": "明明很快就能问到关键的情报了！"
                },
                {
                    "id": "730492809",
                    "speaker": "派蒙",
                    "text": "不过卡西姆和愚人众原本是要在这里见面…说不定这周围会有什么线索…"
                },
                {
                    "id": "730492810",
                    "speaker": "派蒙",
                    "text": "我们先在这个营地里找一找吧！"
                }
            ]
        },
        {
            "id": "7304920",
            "objective": "在营地里寻找愚人众据点的线索",
            "dialogues": [
                {
                    "id": "687220101",
                    "speaker": "派蒙",
                    "text": "快看，这里有一本《与愚人众秘密联络指南》…不知道有没有和愚人众行动据点相关的线索…"
                },
                {
                    "id": "687220102",
                    "speaker": "《与愚人众秘密联络指南》",
                    "text": "「夜晚，至水天丛林山上的帐篷附近，点亮四个火把…」"
                },
                {
                    "id": "687220103",
                    "speaker": "《与愚人众秘密联络指南》",
                    "text": "「其后，前往信号灯打来之处，即为据点之所在…」哇，原来他们之间一直都是这样联系的…"
                },
                {
                    "id": "687220104",
                    "speaker": "《与愚人众秘密联络指南》",
                    "text": "「记住，暗号是…『不要带着自己的规则手册，去别人的地盘。』…」"
                },
                {
                    "id": "687220105",
                    "speaker": "派蒙",
                    "text": "#居然还有暗号！{NICKNAME}，我们来试试吧，「不要带着自己的规则手册…」"
                },
                {
                    "id": "687220106",
                    "speaker": "Player",
                    "text": "「去别人的地盘。」"
                },
                {
                    "id": "687220107",
                    "speaker": "派蒙",
                    "text": "说着不要带着自己的规则手册去别人的地盘，哼，但是这个联络愚人众的规则却被带到须弥来了呢…"
                },
                {
                    "id": "687220108",
                    "speaker": "派蒙",
                    "text": "好，那我们这就出发去水天丛林那儿吧！一定要把那群愚人众一网打尽！"
                }
            ]
        },
        {
            "id": "7304918",
            "objective": "前往秘密联络处的营地",
            "dialogues": []
        },
        {
            "id": "7304919",
            "objective": "在夜间点亮火把（20点~24点）",
            "dialogues": []
        },
        {
            "id": "7304921",
            "objective": "前往愚人众的据点",
            "dialogues": []
        },
        {
            "id": "7304922",
            "objective": "与接应的奥列格对话",
            "dialogues": [
                {
                    "id": "730492201",
                    "speaker": "奥列格",
                    "text": "咦，怎么会…咳咳，暗号，「不要带着自己的规则手册…」"
                },
                {
                    "id": "730492202",
                    "speaker": "Player",
                    "text": "「去别人的地盘。」"
                },
                {
                    "id": "730492203",
                    "speaker": "奥列格",
                    "text": "哼，进来吧，你们…哼，你们一定是来支援的新人吧，来得还真慢啊。"
                }
            ]
        },
        {
            "id": "7304923",
            "objective": "跟随奥列格",
            "dialogues": []
        },
        {
            "id": "7304906",
            "objective": "与奥列格对话",
            "dialogues": [
                {
                    "id": "730490601",
                    "speaker": "奥列格",
                    "text": "你们根本不明白这次实验的重要性，你们不仅来晚了，你们还…"
                },
                {
                    "id": "730490602",
                    "speaker": "奥列格",
                    "text": "哼，你们还抢夺营地！关闭桑格吉拉光机！让我们的实验停滞！"
                },
                {
                    "id": "730490603",
                    "speaker": "Player",
                    "text": "居然暴露了！"
                },
                {
                    "id": "730490604",
                    "speaker": "奥列格",
                    "text": "拜托，我可是三次被你们…和你们打了三场，为什么你们会以为戴个面罩就能够骗过我啊…"
                },
                {
                    "id": "730490605",
                    "speaker": "奥列格",
                    "text": "你以为我为什么认出你了还要放你进来！当然是故意的！"
                },
                {
                    "id": "730490606",
                    "speaker": "奥列格",
                    "text": "上啊，这人就是打断我们实验的元凶！"
                }
            ]
        },
        {
            "id": "7304924",
            "objective": "与奥列格战斗",
            "dialogues": []
        },
        {
            "id": "7304925",
            "objective": "与奥列格对话",
            "dialogues": [
                {
                    "id": "730492501",
                    "speaker": "奥列格",
                    "text": "居然这么多人都…没有办法打赢…"
                },
                {
                    "id": "730492502",
                    "speaker": "奥列格",
                    "text": "明明只要顺利进行实验，我就能够…"
                },
                {
                    "id": "730492503",
                    "speaker": "派蒙",
                    "text": "别想了，那是不可能的，卡西姆的那个什么桑什么机，根本就没办法提取死域的能量…"
                },
                {
                    "id": "730492504",
                    "speaker": "派蒙",
                    "text": "也就是说，他从头到尾都是在骗你啦！"
                },
                {
                    "id": "730492505",
                    "speaker": "奥列格",
                    "text": "怎么会这样！"
                },
                {
                    "id": "730492506",
                    "speaker": "派蒙",
                    "text": "就在三十人团那好好悔过，这辈子都别来须弥啦！"
                },
                {
                    "id": "730492507",
                    "speaker": "Black Screen",
                    "text": "通知了三十人团的掌旗官鲁克沙。\\n鲁克沙的手下将愚人众收押走了。"
                }
            ]
        },
        {
            "id": "7304926",
            "objective": "与鲁克沙对话",
            "dialogues": [
                {
                    "id": "730492601",
                    "speaker": "鲁克沙",
                    "text": "这次真是多亏你们，没想到营地被用来干这种奇怪的事…这些心怀不轨的愚人众我们也都押走了。"
                },
                {
                    "id": "730492602",
                    "speaker": "鲁克沙",
                    "text": "唉，找学者调查了一下那个机器，虽然无法影响死域，但是本身的运作就会造成一定程度的污染，要是无法及时叫停…"
                },
                {
                    "id": "730492603",
                    "speaker": "鲁克沙",
                    "text": "森林会遭到破坏吧。"
                },
                {
                    "id": "730492604",
                    "speaker": "Player",
                    "text": "这样啊…"
                },
                {
                    "id": "730492605",
                    "speaker": "鲁克沙",
                    "text": "嗯，机器会由三十人团收押，以后应该不会再出现这样的事了…"
                },
                {
                    "id": "730492606",
                    "speaker": "鲁克沙",
                    "text": "不过那些营地由于归属权的问题，可能很难统一管理…但也不是什么大碍。"
                },
                {
                    "id": "730492607",
                    "speaker": "鲁克沙",
                    "text": "另外，根据你们所说，现在也增加了对卡西姆的悬赏…那家伙本来就是个大骗子，真让人头疼。"
                },
                {
                    "id": "730492608",
                    "speaker": "鲁克沙",
                    "text": "这次被骗过来的镀金旅团也上了他的当，他绕过三十人团找上镀金旅团，说是要从地脉提取能量来赚上一笔…"
                },
                {
                    "id": "730492609",
                    "speaker": "鲁克沙",
                    "text": "算了，等下次见到他再收拾他吧！"
                },
                {
                    "id": "730492610",
                    "speaker": "鲁克沙",
                    "text": "来，这是你们揭发愚人众的酬劳！这次的事，真是多谢你们了。"
                },
                {
                    "id": "730492611",
                    "speaker": "Black Screen",
                    "text": "鲁克沙离开了…"
                }
            ]
        },
        {
            "id": "7304907",
            "objective": "(test)与派蒙商量对策",
            "dialogues": []
        }
    ]
}