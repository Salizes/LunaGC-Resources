    "talks": [
        {
            "id": "7451701",
            "objective": "和「执律庭」队员们对话",
            "dialogues": [
                {
                    "id": "745170101",
                    "speaker": "蒂蕾娜",
                    "text": "#果然，这边刚刚摆开兵棋，准备好想定的脚本，准领队{NICKNAME}就出现了！"
                },
                {
                    "id": "745170102",
                    "speaker": "昂吉安妮",
                    "text": "不是吧你，还真应了那句传闻？"
                },
                {
                    "id": "745170103",
                    "speaker": "昂吉安妮",
                    "text": "「感知到战术对抗的火热温度后，准领队必将如枪弹般赶来，给出最准狠的指挥…」",
                    "choices": [
                        {
                            "id": "745170104",
                            "text": "看来我来得正是时候。",
                            "response": [
                                {
                                    "id": "745170106",
                                    "speaker": "蒂蕾娜",
                                    "text": "懂了，您觉得目前的铳枪的弹头初速还有提升空间，我也有这种感觉！"
                                },
                                {
                                    "id": "745170107",
                                    "speaker": "昂吉安妮",
                                    "text": "#哎，蒂蕾娜，你先收敛点！好不容易把{NICKNAME}吸引过来，正事要紧！"
                                },
                                {
                                    "id": "745170108",
                                    "speaker": "蒂蕾娜",
                                    "text": "我明白我明白，关于铳枪的发展方向，可以稍后再闲聊。现在，准领队应该状态绝佳，随时可以大展身手了！",
                                    "choices": [
                                        {
                                            "id": "745170109",
                                            "text": "是新的桌上推演吗？",
                                            "response": [
                                                {
                                                    "id": "745170110",
                                                    "speaker": "蒂蕾娜",
                                                    "text": "没错！根据特巡队面临的作战环境，对推演的各种设计和规则进行了迭代。"
                                                },
                                                {
                                                    "id": "745170113",
                                                    "speaker": "昂吉安妮",
                                                    "text": "总之，现在的推演变得更有挑战性了，还准备了不少特别的想定，包括特巡队精锐留下的难题。"
                                                },
                                                {
                                                    "id": "745170114",
                                                    "speaker": "昂吉安妮",
                                                    "text": "有的想定，我应付起来都触角发麻。就让我见识一下吧，准领队带兵打仗的能力！"
                                                },
                                                {
                                                    "id": "745170115",
                                                    "speaker": "蒂蕾娜",
                                                    "text": "苦劳费好说哦，肯定能让您玩个痛快，又大赚一笔！",
                                                    "choices": [
                                                        {
                                                            "id": "745170116",
                                                            "text": "那我就好好展现准领队的能力！",
                                                            "response": [
                                                                {
                                                                    "id": "745170118",
                                                                    "speaker": "昂吉安妮",
                                                                    "text": "#你就看着吧，蒂蕾娜，就算{NICKNAME}认认真真，也会被第三个进攻想定卡住…"
                                                                },
                                                                {
                                                                    "id": "745170119",
                                                                    "speaker": "蒂蕾娜",
                                                                    "text": "#那关也不可能难住{M#他}{F#她}！只是教官现在闲了太久，变弱了而已嘛。"
                                                                },
                                                                {
                                                                    "id": "745170120",
                                                                    "speaker": "昂吉安妮",
                                                                    "text": "你这小妞！我…你！"
                                                                },
                                                                {
                                                                    "id": "745170121",
                                                                    "speaker": "蒂蕾娜",
                                                                    "text": "我和你打赌哦，教官！就赌…夏沃蕾队长同款的那种限量竞赛弹药！"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "745170117",
                                                            "text": "拿钱玩推演，这事我在行。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "745170111",
                                            "text": "其实还没太看懂…",
                                            "response": [
                                                {
                                                    "id": "745170112",
                                                    "speaker": "蒂蕾娜",
                                                    "text": "简单说来，之前我们在璃月进行了一场联合推演，回来后，我们又按照特巡队面临的作战环境，对其迭代了多种设计。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "745170105",
                            "text": "枪弹的比喻不如闪电…"
                        }
                    ]
                }
            ]
        }
    ]
}