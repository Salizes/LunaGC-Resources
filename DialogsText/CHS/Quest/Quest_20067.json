    "talks": [
        {
            "id": "2006701",
            "objective": "与安娜对话",
            "dialogues": [
                {
                    "id": "200671301",
                    "speaker": "安娜",
                    "text": "喔…我差不多了解了！不过光听理论也不行…"
                },
                {
                    "id": "200671302",
                    "speaker": "安娜",
                    "text": "旅行者，能请你为我演示一下风之翼的操纵方式吗？",
                    "choices": [
                        {
                            "id": "200671303",
                            "text": "没问题。",
                            "response": [
                                {
                                    "id": "200671305",
                                    "speaker": "安娜",
                                    "text": "那就拜托你啦，我们赶紧出发吧！"
                                }
                            ]
                        },
                        {
                            "id": "200671304",
                            "text": "你可要看好了。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "2006702",
            "objective": "为安娜演示操纵风之翼的方法",
            "dialogues": [
                {
                    "id": "200670201",
                    "speaker": "Player",
                    "text": "一架风之翼只可由一人使用。"
                },
                {
                    "id": "200670202",
                    "speaker": "安娜",
                    "text": "原来如此…"
                }
            ]
        },
        {
            "id": "2006703",
            "objective": "为安娜演示操纵风之翼的方法",
            "dialogues": [
                {
                    "id": "200670301",
                    "speaker": "Player",
                    "text": "这取决于风之翼操纵者的水平。"
                },
                {
                    "id": "200670302",
                    "speaker": "安娜",
                    "text": "原来如此…"
                }
            ]
        },
        {
            "id": "2006704",
            "objective": "与安娜对话",
            "dialogues": [
                {
                    "id": "200671401",
                    "speaker": "安娜",
                    "text": "你操纵风之翼的手法可真是太厉害了，怪不得安柏小姐要我来请教你呢。"
                },
                {
                    "id": "200671402",
                    "speaker": "安娜",
                    "text": "嘿嘿，有你给我辅导，我肯定能通过飞行执照的考试。"
                },
                {
                    "id": "200671403",
                    "speaker": "安娜",
                    "text": "谢谢你啦，这些东西请你收下，我先回去复习了。"
                },
                {
                    "id": "200671404",
                    "speaker": "安娜",
                    "text": "唔…我的风之翼用什么颜色比较好呢…"
                },
                {
                    "id": "200671405",
                    "speaker": "安娜",
                    "text": "蓝色？绿色？不然都要一点好了…"
                }
            ]
        },
        {
            "id": "2006705",
            "objective": "",
            "dialogues": [
                {
                    "id": "200670501",
                    "speaker": "安娜",
                    "text": "第二个问题是，使用风之翼起飞时，需要注意什么？"
                }
            ]
        },
        {
            "id": "2006706",
            "objective": "",
            "dialogues": [
                {
                    "id": "200670601",
                    "speaker": "Player",
                    "text": "需采取合理的起飞动作与起飞地点。"
                },
                {
                    "id": "200670602",
                    "speaker": "安娜",
                    "text": "是这样吗…"
                }
            ]
        },
        {
            "id": "2006701",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "200670101",
                    "speaker": "安娜",
                    "text": "到底是哪里出了问题…"
                },
                {
                    "id": "200670102",
                    "speaker": "Player",
                    "text": "怎么了？"
                },
                {
                    "id": "200670103",
                    "speaker": "安娜",
                    "text": "旅行者…呜…"
                },
                {
                    "id": "200670104",
                    "speaker": "安娜",
                    "text": "自从上次你给我辅导之后，我又很认真地学习了很久。"
                },
                {
                    "id": "200670105",
                    "speaker": "安娜",
                    "text": "然后，我就请杰克来帮我做了一次模拟考试。"
                },
                {
                    "id": "200670106",
                    "speaker": "安娜",
                    "text": "结果…结果考下来，我不及格…"
                },
                {
                    "id": "200670107",
                    "speaker": "安娜",
                    "text": "真不知道是哪里出了问题…旅行者，你能再辅导我一下吗？",
                    "choices": [
                        {
                            "id": "200670108",
                            "text": "没问题。",
                            "response": [
                                {
                                    "id": "200670110",
                                    "speaker": "安娜",
                                    "text": "那就拜托你了，旅行者！"
                                },
                                {
                                    "id": "200670111",
                                    "speaker": "安娜",
                                    "text": "唔…第一个问题是，在飞行时，最多可以同时几人共用一架风之翼？"
                                }
                            ]
                        },
                        {
                            "id": "200670109",
                            "text": "（难道上次有答案错了…）"
                        }
                    ]
                }
            ]
        },
        {
            "id": "2006704",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "200670401",
                    "speaker": "Player",
                    "text": "这取决于风之翼操纵者的体重。"
                },
                {
                    "id": "200670402",
                    "speaker": "安娜",
                    "text": "原来如此…"
                }
            ]
        },
        {
            "id": "2006707",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "200670701",
                    "speaker": "Player",
                    "text": "用风史莱姆起飞很有趣。"
                },
                {
                    "id": "200670702",
                    "speaker": "安娜",
                    "text": "是这样吗…"
                }
            ]
        },
        {
            "id": "2006708",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "200670801",
                    "speaker": "Player",
                    "text": "要保证自己处于风之翼下方。"
                },
                {
                    "id": "200670802",
                    "speaker": "安娜",
                    "text": "是这样吗…"
                }
            ]
        },
        {
            "id": "2006709",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "200670901",
                    "speaker": "安娜",
                    "text": "第三个问题是，在使用风之翼降落时，需要注意什么？"
                }
            ]
        },
        {
            "id": "2006710",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "200671001",
                    "speaker": "Player",
                    "text": "需合理挑选降落地点，不可直接收起风之翼。"
                },
                {
                    "id": "200671002",
                    "speaker": "安娜",
                    "text": "是这样吗…"
                }
            ]
        },
        {
            "id": "2006711",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "200671101",
                    "speaker": "Player",
                    "text": "最重要的是降落时的姿势。"
                },
                {
                    "id": "200671102",
                    "speaker": "安娜",
                    "text": "是这样吗…"
                }
            ]
        },
        {
            "id": "2006712",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "200671201",
                    "speaker": "Player",
                    "text": "尽可能落在地上。"
                },
                {
                    "id": "200671202",
                    "speaker": "安娜",
                    "text": "是这样吗…"
                }
            ]
        }
    ]
}