    "talks": [
        {
            "id": "7424601",
            "objective": "",
            "dialogues": [
                {
                    "id": "742460101",
                    "speaker": "丰泰",
                    "text": "得嘞，客人，您要的霄灯零件我都做好了，每一份都单独做了防水。"
                },
                {
                    "id": "742460102",
                    "speaker": "丰泰",
                    "text": "每一份都包了五六层油纸，丢到水底泡个七八天都不成问题。"
                },
                {
                    "id": "742460103",
                    "speaker": "那维莱特",
                    "text": "辛苦老板了，该付的工本费我也会如数支付。现在不是海灯节，采购这些一定很麻烦吧。"
                },
                {
                    "id": "742460104",
                    "speaker": "丰泰",
                    "text": "哎——小问题小问题，不需要这么客气，咱们做生意，主打的就是一个急客人之所急啊。"
                },
                {
                    "id": "742460105",
                    "speaker": "丰泰",
                    "text": "对了，您上次买的茶叶，喝得还顺口吗？要不要再看看刚到的沉玉仙茗，刚炒出来不久，可都是上好的货啊！"
                },
                {
                    "id": "742460106",
                    "speaker": "那维莱特",
                    "text": "唔，如果有折扣的话…"
                }
            ]
        },
        {
            "id": "7424602",
            "objective": "（隐藏）海灯节期间闲置$HIDDEN",
            "dialogues": [
                {
                    "id": "742460201",
                    "speaker": "丰泰",
                    "text": "得嘞，客人，您要的霄灯零件我都做好了，每一份都单独做了防水。"
                },
                {
                    "id": "742460202",
                    "speaker": "丰泰",
                    "text": "每一份都包了五六层油纸，丢到水底泡个七八天都不成问题。"
                },
                {
                    "id": "742460203",
                    "speaker": "那维莱特",
                    "text": "辛苦老板了，该付的工本费我也会如数支付。"
                },
                {
                    "id": "742460204",
                    "speaker": "丰泰",
                    "text": "哎——客人，不需要这么客气，咱们做生意，主打的就是一个急客人之所急啊。"
                },
                {
                    "id": "742460205",
                    "speaker": "丰泰",
                    "text": "对了，您上次买的茶叶，喝得还顺口吗？要不要再看看刚到的沉玉仙茗，刚炒出来不久，可都是上好的货啊！"
                },
                {
                    "id": "742460206",
                    "speaker": "那维莱特",
                    "text": "唔，如果有折扣的话…"
                },
                {
                    "id": "742460207",
                    "speaker": "派蒙",
                    "text": "等一下！那维莱特——有折扣也要思考！"
                },
                {
                    "id": "742460208",
                    "speaker": "Player",
                    "text": "上次的你都没喝完！"
                },
                {
                    "id": "742460209",
                    "speaker": "那维莱特",
                    "text": "#{NICKNAME}，派蒙？真是巧遇，我正在思考，你们是不是会也来璃月港度海灯节，祝你们海灯节快乐。"
                },
                {
                    "id": "742460210",
                    "speaker": "派蒙",
                    "text": "那维莱特刚才是在买霄灯零件么？还特意让老板做了防水措施，难道说这些霄灯是…"
                },
                {
                    "id": "742460211",
                    "speaker": "那维莱特",
                    "text": "是的。我打算将这些霄灯送给美露莘们，她们从未见过这种灯具，应该会喜欢的。"
                },
                {
                    "id": "742460212",
                    "speaker": "那维莱特",
                    "text": "我还想多买一些霄灯，挂在沫芒宫外面。但我正在苦恼，如果单单只有沫芒宫悬挂霄灯，是否会有些不公平…"
                },
                {
                    "id": "742460213",
                    "speaker": "那维莱特",
                    "text": "或许，我应当回到沫芒宫，让复律官们来做一次整体采购，让枫丹廷和梅洛彼得堡里的各处都能挂上霄灯。"
                },
                {
                    "id": "742460214",
                    "speaker": "莱欧斯利",
                    "text": "要是让复律官们来采购，那枫丹廷在明年的海灯节时，或许能挂上今年的霄灯。"
                },
                {
                    "id": "742460215",
                    "speaker": "莱欧斯利",
                    "text": "而且，还是别在梅洛彼得堡里挂霄灯了，我的最高审判官大人。"
                },
                {
                    "id": "742460216",
                    "speaker": "莱欧斯利",
                    "text": "在梅洛彼得堡里，霄灯可飞不高，而且那些罪人们写在霄灯上面的愿望，大部分也不会被实现。"
                },
                {
                    "id": "742460217",
                    "speaker": "莱欧斯利",
                    "text": "你知道的，那帮人可许不出什么利国利民的好愿望，咱们还是尽量让霄灯保持正面形象吧。"
                },
                {
                    "id": "742460218",
                    "speaker": "希格雯",
                    "text": "而那些可以被许出来的「好愿望」，我也已经帮许愿者放飞了。"
                },
                {
                    "id": "742460219",
                    "speaker": "Player",
                    "text": "哇，海灯节真热闹。"
                },
                {
                    "id": "742460220",
                    "speaker": "莱欧斯利",
                    "text": "噢，对了，祝各位海灯节愉快，我就不一个一个问候了，心意到了就行。",
                    "choices": [
                        {
                            "id": "742460221",
                            "text": "还是要挨个问候的。",
                            "response": [
                                {
                                    "id": "742460226",
                                    "speaker": "派蒙",
                                    "text": "喂！为什么到我了要加一个「也」啊。"
                                },
                                {
                                    "id": "742460227",
                                    "speaker": "那维莱特",
                                    "text": "#呵呵，莱欧斯利先生，希格雯小姐，{NICKNAME}，派蒙，我也祝你们节日愉快。"
                                },
                                {
                                    "id": "742460228",
                                    "speaker": "那维莱特",
                                    "text": "看来这个好节日，把我们都吸引了过来。"
                                },
                                {
                                    "id": "742460229",
                                    "speaker": "莱欧斯利",
                                    "text": "#哦唷，气氛烘托得这么热烈，可惜我没有买那种吉语钱包，不然按照璃月习俗，咱们得给{NICKNAME}和派蒙各发一封才行。"
                                },
                                {
                                    "id": "742460230",
                                    "speaker": "Player",
                                    "text": "也可以直接把摩拉给我的…"
                                },
                                {
                                    "id": "742460231",
                                    "speaker": "莱欧斯利",
                                    "text": "哈哈哈哈哈，行啊，等一下咱们一起去吃一顿好的，就由派蒙带路吧。"
                                },
                                {
                                    "id": "742460232",
                                    "speaker": "派蒙",
                                    "text": "真的？嘿嘿嘿，那我可要好好点菜了！"
                                },
                                {
                                    "id": "742460233",
                                    "speaker": "希格雯",
                                    "text": "那维莱特大人，请您也一起去吧。"
                                },
                                {
                                    "id": "742460234",
                                    "speaker": "那维莱特",
                                    "text": "好的，我很乐意。"
                                },
                                {
                                    "id": "742460235",
                                    "speaker": "莱欧斯利",
                                    "text": "喔，我突然发现…你这身衣服真不错，新做的？和这里的节日气氛，还有你放松的表情很搭啊。"
                                },
                                {
                                    "id": "742460236",
                                    "speaker": "希格雯",
                                    "text": "这些缀饰和编织的手法…那维莱特大人，如果我猜的没错，应当是美露莘们的手艺？"
                                },
                                {
                                    "id": "742460237",
                                    "speaker": "派蒙",
                                    "text": "欸？希格雯这都能看出来？"
                                },
                                {
                                    "id": "742460238",
                                    "speaker": "希格雯",
                                    "text": "嗯，看这件衣服的版型，应当是芙洛设计的，洛梅肯定也出了不少点子。"
                                },
                                {
                                    "id": "742460239",
                                    "speaker": "希格雯",
                                    "text": "总而言之，是一件很帅气的衣服，很适合那维莱特大人。"
                                },
                                {
                                    "id": "742460240",
                                    "speaker": "那维莱特",
                                    "text": "是的。这是各位美露莘送给我的珍贵礼物。"
                                },
                                {
                                    "id": "742460241",
                                    "speaker": "Black Screen",
                                    "text": "那维莱特讲述了美露莘们赠送礼物的过程…"
                                },
                                {
                                    "id": "742460242",
                                    "speaker": "莱欧斯利",
                                    "text": "所以，你打算用霄灯做回礼？"
                                },
                                {
                                    "id": "742460243",
                                    "speaker": "那维莱特",
                                    "text": "是的。这是礼貌。"
                                },
                                {
                                    "id": "742460244",
                                    "speaker": "莱欧斯利",
                                    "text": "那美露莘们肯定又要给你回礼了。"
                                },
                                {
                                    "id": "742460245",
                                    "speaker": "那维莱特",
                                    "text": "是的。我想她们会的。"
                                },
                                {
                                    "id": "742460246",
                                    "speaker": "莱欧斯利",
                                    "text": "行吧，礼物总归是好东西，要是你的办公室放不下礼物了，可以放到我那边去。"
                                },
                                {
                                    "id": "742460247",
                                    "speaker": "莱欧斯利",
                                    "text": "护士长应该很擅长保存美露莘的礼物。"
                                },
                                {
                                    "id": "742460248",
                                    "speaker": "希格雯",
                                    "text": "交给我吧，我会把那些心意都完善地保存起来的。"
                                },
                                {
                                    "id": "742460249",
                                    "speaker": "莱欧斯利",
                                    "text": "但在那之前，咱们要不然还是先去别的地方逛一逛？"
                                },
                                {
                                    "id": "742460250",
                                    "speaker": "莱欧斯利",
                                    "text": "璃月风景优美，和枫丹见惯的景色相比，别有一番滋味。"
                                },
                                {
                                    "id": "742460251",
                                    "speaker": "莱欧斯利",
                                    "text": "这种滋味，倒也不必只局限在好茶之上了。"
                                }
                            ]
                        },
                        {
                            "id": "742460222",
                            "text": "希格雯海灯节快乐。"
                        },
                        {
                            "id": "742460223",
                            "text": "莱欧斯利海灯节快乐。"
                        },
                        {
                            "id": "742460224",
                            "text": "那维莱特海灯节快乐！"
                        },
                        {
                            "id": "742460225",
                            "text": "派蒙也海灯节快乐！"
                        }
                    ]
                }
            ]
        },
        {
