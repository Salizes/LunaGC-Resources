    "talks": [
        {
            "id": "7566301",
            "objective": "与加希菈对话",
            "dialogues": [
                {
                    "id": "756630101",
                    "speaker": "加希菈",
                    "text": "#哦呀？这不是{NICKNAME}吗？欢迎，有兴趣的话，来打两枪玩玩？"
                },
                {
                    "id": "756630102",
                    "speaker": "Player",
                    "text": "你是「花羽会」的成员？"
                },
                {
                    "id": "756630103",
                    "speaker": "加希菈",
                    "text": "没错。我之前曾经在「花羽会」里担任射击术教官，训练大家的空中射击技术。"
                },
                {
                    "id": "756630104",
                    "speaker": "加希菈",
                    "text": "在我教导过的那批学生里，有不少人都在战场上立下了赫赫战功。"
                },
                {
                    "id": "756630105",
                    "speaker": "加希菈",
                    "text": "不过…能够回到我身边的，也只有他们的赫赫战功了。"
                },
                {
                    "id": "756630106",
                    "speaker": "加希菈",
                    "text": "我之前也想要投身战场，和我的学生们并肩作战。但却被部族里的人拦住了…"
                },
                {
                    "id": "756630107",
                    "speaker": "加希菈",
                    "text": "他们说，我教导射击的能力比我的射击术本身更加宝贵，为了部族，我必须留下。"
                },
                {
                    "id": "756630108",
                    "speaker": "加希菈",
                    "text": "我服从了命令，继续研究训练射击术的方式，直到现在。"
                },
                {
                    "id": "756630109",
                    "speaker": "Player",
                    "text": "所以，你来这里也是为了研究这个？"
                },
                {
                    "id": "756630110",
                    "speaker": "加希菈",
                    "text": "呃…算是吧。准确来说，我来这里主要是为了研究…如何让孩子对射击术感兴趣。"
                },
                {
                    "id": "756630111",
                    "speaker": "加希菈",
                    "text": "普通的射击术训练很困难，也十分枯燥，战士们当然能够靠自己的毅力耐住性子训练…"
                },
                {
                    "id": "756630112",
                    "speaker": "加希菈",
                    "text": "但孩子们…正好处于爱玩的年纪，只怕是没有那么多耐心的。要是受的挫折多了，说不定反而会对射击术产生反感。"
                },
                {
                    "id": "756630113",
                    "speaker": "加希菈",
                    "text": "于是，我就想要研究出一套既有趣，也能让孩子们学习到基本射击术技巧的训练方式。"
                },
                {
                    "id": "756630114",
                    "speaker": "加希菈",
                    "text": "喏，这就是我的「研究成果」了。保证既有趣，又刺激，还十分安全。",
                    "choices": [
                        {
                            "id": "756630115",
                            "text": "给孩子们玩的啊…",
                            "response": [
                                {
                                    "id": "756630117",
                                    "speaker": "加希菈",
                                    "text": "哈哈哈哈哈，没关系，如果你需要的话，我可以再为你布设一套更加困难的挑战。"
                                },
                                {
                                    "id": "756630118",
                                    "speaker": "加希菈",
                                    "text": "来，站上台子，拿好射击器具，我保证一定让你尽兴而归。"
                                }
                            ]
                        },
                        {
                            "id": "756630116",
                            "text": "总觉得难度有点低…"
                        }
                    ]
                }
            ]
        }
    ]
}