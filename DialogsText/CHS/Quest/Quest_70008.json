        {
            "id": "7000810",
            "objective": "与玛格丽特对话",
            "dialogues": [
                {
                    "id": "700081001",
                    "speaker": "玛格丽特",
                    "text": "已经调好了吗？"
                },
                {
                    "id": "700081002",
                    "speaker": "Player",
                    "text": "调制好了。"
                }
            ]
        },
        {
            "id": "7000818",
            "objective": "与玛格丽特对话",
            "dialogues": [
                {
                    "id": "700081503",
                    "speaker": "玛格丽特",
                    "text": "……"
                },
                {
                    "id": "700081504",
                    "speaker": "玛格丽特",
                    "text": "清冽的口感中隐约有一丝甜味，同时还带有风一样的清凉口感…"
                },
                {
                    "id": "700081505",
                    "speaker": "玛格丽特",
                    "text": "是一杯很适合风花节气氛的饮品啊，找你帮忙果然是正确的选择。"
                },
                {
                    "id": "700081506",
                    "speaker": "玛格丽特",
                    "text": "接下来，就要把这种饮品拿出去给人试喝一下了，旅行者，能拜托你再帮忙跑一趟吗？"
                },
                {
                    "id": "700081507",
                    "speaker": "Player",
                    "text": "交给我吧。"
                },
                {
                    "id": "700081508",
                    "speaker": "玛格丽特",
                    "text": "那就拜托你了，风神像附近应该有很多人，你就去那边找人试喝吧。"
                }
            ]
        },
        {
            "id": "7000819",
            "objective": "与玛格丽特对话",
            "dialogues": [
                {
                    "id": "700081003",
                    "speaker": "玛格丽特",
                    "text": "……"
                },
                {
                    "id": "700081004",
                    "speaker": "玛格丽特",
                    "text": "尝起来有点涩，不同的味道好像没有融合好。应该是调制的时候出了什么问题吧…"
                },
                {
                    "id": "700081005",
                    "speaker": "玛格丽特",
                    "text": "嗯…不然，你再去试试看？有什么不明白的来问我就好。"
                }
            ]
        },
        {
            "id": "7000811",
            "objective": "与宁禄对话",
            "dialogues": [
                {
                    "id": "700081101",
                    "speaker": "宁禄",
                    "text": "欸…大过节的，果然还是喝点…"
                },
                {
                    "id": "700081102",
                    "speaker": "Player",
                    "text": "关于猫尾酒馆的风花节新饮品…"
                },
                {
                    "id": "700081103",
                    "speaker": "宁禄",
                    "text": "你是想让我试喝吗？哈哈哈，没问题，我对酒可是很精通的。"
                },
                {
                    "id": "700081104",
                    "speaker": "宁禄",
                    "text": "我尝尝…咦？这饮料怎么，一点酒味都没有，感觉就像是牛奶饮料一样。"
                },
                {
                    "id": "700081105",
                    "speaker": "宁禄",
                    "text": "唔，虽然喝起来味道不错，但这一点酒味都没有，可不太适合这个节日啊。"
                },
                {
                    "id": "700081106",
                    "speaker": "宁禄",
                    "text": "毕竟，可是有很多人都期待着在这个风花节里「合理醉酒」的，这样一滴酒都没有的饮品，只怕受众会很少啊。"
                }
            ]
        },
        {
            "id": "7000812",
            "objective": "与阿拉米对话",
            "dialogues": [
                {
                    "id": "700081201",
                    "speaker": "阿拉米",
                    "text": "您好，有什么可以帮您的吗？"
                },
                {
                    "id": "700081202",
                    "speaker": "Player",
                    "text": "关于猫尾酒馆的风花节新饮品…"
                },
                {
                    "id": "700081203",
                    "speaker": "阿拉米",
                    "text": "抱歉，我现在正在执勤，喝酒这件事还是免了。"
                },
                {
                    "id": "700081204",
                    "speaker": "Player",
                    "text": "这杯饮品不含酒。"
                },
                {
                    "id": "700081205",
                    "speaker": "阿拉米",
                    "text": "不含酒？啊…那、那应该还行，我正好也口渴了，谢谢，我尝一尝…"
                },
                {
                    "id": "700081206",
                    "speaker": "阿拉米",
                    "text": "喔，这个味道真不错啊，而且这种清凉的感觉，也有些提神的作用。"
                },
                {
                    "id": "700081207",
                    "speaker": "阿拉米",
                    "text": "这是猫尾酒馆的新品对吧？等我有空的时候，我会去再好好尝尝的。"
                }
            ]
        },
        {
            "id": "7000813",
            "objective": "与诺拉对话",
            "dialogues": [
                {
                    "id": "700081301",
                    "speaker": "诺拉",
                    "text": "你要陪诺拉玩吗？"
                },
                {
                    "id": "700081302",
                    "speaker": "Player",
                    "text": "关于猫尾酒馆的风花节新饮品…"
                },
                {
                    "id": "700081303",
                    "speaker": "诺拉",
                    "text": "猫尾酒馆…可是葛瑞丝阿姨说，小孩子不能喝酒的。"
                },
                {
                    "id": "700081304",
                    "speaker": "Player",
                    "text": "这杯饮品不含酒。"
                },
                {
                    "id": "700081305",
                    "speaker": "诺拉",
                    "text": "真的吗？那我尝尝看…"
                },
                {
                    "id": "700081306",
                    "speaker": "诺拉",
                    "text": "#好喝！甜甜的，凉凉的！{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，这是猫尾酒馆那边的新饮料吗？"
                },
                {
                    "id": "700081307",
                    "speaker": "诺拉",
                    "text": "我要去告诉提米和莉莉！他们肯定也想喝喝看！"
                }
            ]
        },
        {
            "id": "7000814",
            "objective": "向玛格丽特回报",
            "dialogues": [
                {
                    "id": "700081401",
                    "speaker": "玛格丽特",
                    "text": "怎么样，你找到人试喝了吗？"
                },
                {
                    "id": "700081402",
                    "speaker": "Player",
                    "text": "找到了。"
                },
                {
                    "id": "700081403",
                    "speaker": "玛格丽特",
                    "text": "在风花节期间「合理醉酒」啊…怪不得「天使的馈赠」里的客人更多了…"
                },
                {
                    "id": "700081404",
                    "speaker": "玛格丽特",
                    "text": "不过，这样也不错，除了那些期待着「合理醉酒」的人之外，孩子们和站岗的卫兵们，也需要一份节日特饮呢。"
                },
                {
                    "id": "700081405",
                    "speaker": "玛格丽特",
                    "text": "我会继续调整这份特饮的，谢谢你帮忙，这些报酬请你收下吧。"
                },
                {
                    "id": "700081406",
                    "speaker": "玛格丽特",
                    "text": "对了，祝你风花节玩得开心。"
                }
            ]
        },
        {
            "id": "7000818",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "700081801",
                    "speaker": "玛格丽特",
                    "text": "你们找到东西了吗？"
                },
                {
                    "id": "700081802",
                    "speaker": "玛格丽特",
                    "text": "很不错的风车菊，用来调制饮品的话，不知道会调出什么风味…"
                }
            ]
        },
        {
            "id": "7000828",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "700082802",
                    "speaker": "玛格丽特",
                    "text": "这蒲公英籽看上去还不错，用来调制饮品的话，不知道会调出什么风味…"
                }
            ]
        },
        {
            "id": "7000851",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "700085101",
                    "speaker": "玛格丽特",
                    "text": "忘记了调制的顺序吗，没关系，我再讲解一次好了。"
                },
                {
                    "id": "700085102",
                    "speaker": "玛格丽特",
                    "text": "先放入<color=#00E1FFFF>甜甜花</color>，再浇入<color=#00E1FFFF>牛奶</color>，这就有了口感清甜的基底。"
                },
                {
                    "id": "700085103",
                    "speaker": "玛格丽特",
                    "text": "为了增添风味，这时候再加入<color=#00E1FFFF>风车菊</color>。"
                },
                {
                    "id": "700085104",
                    "speaker": "玛格丽特",
                    "text": "然后别急着混合，得<color=#00E1FFFF>静置</color>一会儿，让花的香味慢慢散发出来。"
                },
                {
                    "id": "700085105",
                    "speaker": "玛格丽特",
                    "text": "再撒入<color=#00E1FFFF>蒲公英籽</color>，加入<color=#00E1FFFF>冰块</color>，这样就可以了，记住的话就可以动手试试了。"
                }
            ]
        },
        {
            "id": "7000852",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "700085201",
                    "speaker": "宁禄",
                    "text": "欸，我还是去再喝点蒲公英酒好了…"
                }
            ]
        },
        {
            "id": "7000853",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "700085301",
                    "speaker": "阿拉米",
                    "text": "喝一点不含酒的饮料，应该没问题吧…"
                }
            ]
        },
        {
            "id": "7000854",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "700085401",
                    "speaker": "诺拉",
                    "text": "提米和莉莉肯定也喜欢喝这种饮料，我等下就去告诉他们！"
                }
            ]
        }
    ]
}