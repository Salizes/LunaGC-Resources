    "talks": [
        {
            "id": "7217801",
            "objective": "（test）隐藏神龛总控$HIDDEN",
            "dialogues": [
                {
                    "id": "721780101",
                    "speaker": "神龛",
                    "text": "（看起来很普通的神龛，并没有任何奇特的元素痕迹。）"
                },
                {
                    "id": "721780102",
                    "speaker": "Player",
                    "text": "调查"
                },
                {
                    "id": "721780103",
                    "speaker": "神龛",
                    "text": "（这座神龛看起来状态良好，似乎不久前才被精心照料过。打理这里的，或许是一个细心的人。）"
                },
                {
                    "id": "721780104",
                    "speaker": "神龛",
                    "text": "（但除此之外，并没有谁来过的痕迹。）"
                },
                {
                    "id": "721780105",
                    "speaker": "派蒙",
                    "text": "奇怪呢…好像有人来过。"
                }
            ]
        },
        {
            "id": "7217802",
            "objective": "对话1$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7217803",
            "objective": "对话2$HIDDEN",
            "dialogues": [
                {
                    "id": "721780201",
                    "speaker": "派蒙",
                    "text": "这里也有一座神龛，我们去看看吧？"
                },
                {
                    "id": "721780202",
                    "speaker": "神龛",
                    "text": "（看起来很普通的神龛，并没有任何奇特的元素痕迹。）"
                },
                {
                    "id": "721780203",
                    "speaker": "Player",
                    "text": "调查"
                },
                {
                    "id": "721780204",
                    "speaker": "神龛",
                    "text": "（这座神龛看起来干净整洁，散发着淡淡的神樱香气。或许不久前有人在此处祈祷过。）"
                },
                {
                    "id": "721780205",
                    "speaker": "神龛",
                    "text": "（但除此之外，并没有更新近的痕迹。）"
                },
                {
                    "id": "721780206",
                    "speaker": "派蒙",
                    "text": "是神樱花瓣的气味呢…长次的妈妈或许来过！"
                },
                {
                    "id": "721780207",
                    "speaker": "派蒙",
                    "text": "而且一定是不久前！"
                }
            ]
        },
        {
            "id": "7217804",
            "objective": "对话3$HIDDEN",
            "dialogues": [
                {
                    "id": "721780301",
                    "speaker": "派蒙",
                    "text": "这座神龛看起来好新，我们调查一下吧！"
                },
                {
                    "id": "721780302",
                    "speaker": "神龛",
                    "text": "（看起来很普通的神龛，并没有任何奇特的元素痕迹。）"
                },
                {
                    "id": "721780303",
                    "speaker": "Player",
                    "text": "调查"
                },
                {
                    "id": "721780304",
                    "speaker": "神龛",
                    "text": "（这座神龛木料稍旧，但良好的维护使外表暗淡的颜色也不显得破败，反而更有韵味。）"
                },
                {
                    "id": "721780305",
                    "speaker": "派蒙",
                    "text": "似乎有人经常来这里…经常照顾这座神龛呢。"
                }
            ]
        },
        {
            "id": "7217805",
            "objective": "对话4$HIDDEN",
            "dialogues": [
                {
                    "id": "721780401",
                    "speaker": "派蒙",
                    "text": "这就是长次所说的神龛了吧？"
                },
                {
                    "id": "721780402",
                    "speaker": "神龛",
                    "text": "（看起来很普通的神龛，并没有任何奇特的元素痕迹。）"
                },
                {
                    "id": "721780403",
                    "speaker": "Player",
                    "text": "调查"
                },
                {
                    "id": "721780404",
                    "speaker": "神龛",
                    "text": "（这座神龛朴素却优雅，木造的龛体微微闪烁着流光，以端庄的沉默迎接来客的供奉。）"
                },
                {
                    "id": "721780405",
                    "speaker": "神龛",
                    "text": "（神龛旁边散落着许多神樱花瓣，看起来不像是自然所成，却像是有人特意在这里洒下了绯樱绣球。）"
                },
                {
                    "id": "721780406",
                    "speaker": "派蒙",
                    "text": "唔…这里也没有痕迹呢。",
                    "choices": [
                        {
                            "id": "721780407",
                            "text": "看，绯樱绣球…",
                            "response": [
                                {
                                    "id": "721780409",
                                    "speaker": "派蒙",
                                    "text": "对哦，长次提到过他妈妈会在神龛供奉这个的！"
                                },
                                {
                                    "id": "721780410",
                                    "speaker": "派蒙",
                                    "text": "这么多花瓣出现在这里…应该不会是偶然。"
                                },
                                {
                                    "id": "721780411",
                                    "speaker": "派蒙",
                                    "text": "我们快回去告诉他吧！"
                                }
                            ]
                        },
                        {
                            "id": "721780408",
                            "text": "是长次妈妈的供品…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7217806",
            "objective": "对话5$HIDDEN",
            "dialogues": [
                {
                    "id": "721780501",
                    "speaker": "派蒙",
                    "text": "这里也有神龛呢，看起来好眼熟！"
                },
                {
                    "id": "721780502",
                    "speaker": "神龛",
                    "text": "（看起来很普通的神龛，并没有任何奇特的元素痕迹。）"
                },
                {
                    "id": "721780503",
                    "speaker": "Player",
                    "text": "调查"
                },
                {
                    "id": "721780504",
                    "speaker": "神龛",
                    "text": "（这座神龛看起来略显破败，木造的外壳已经坑坑洼洼、有所褪色，局部显露出凶险的暗红色痕迹。）"
                },
                {
                    "id": "721780505",
                    "speaker": "派蒙",
                    "text": "这个神龛…怪可怕的，我鸡皮疙瘩都要起来了…"
                },
                {
                    "id": "721780506",
                    "speaker": "派蒙",
                    "text": "我们离开这里吧！"
                }
            ]
        },
