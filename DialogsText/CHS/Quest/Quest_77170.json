                },
                {
                    "id": "771700103",
                    "speaker": "(test)数霜精玩法引导员",
                    "text": "(test)要开始吗？"
                },
                {
                    "id": "771700104",
                    "speaker": "Player",
                    "text": "(test)我来试试！"
                },
                {
                    "id": "771700105",
                    "speaker": "(test)数霜精玩法引导员",
                    "text": "(test)好的，这就给您开门"
                }
            ]
        },
