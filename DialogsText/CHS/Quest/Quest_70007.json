        {
            "id": "7000707",
            "objective": "与派蒙商量对策",
            "dialogues": [
                {
                    "id": "700070701",
                    "speaker": "派蒙",
                    "text": "唉，好像没人听我们的劝告。"
                },
                {
                    "id": "700070702",
                    "speaker": "派蒙",
                    "text": "他们的用书习惯都不太好，我们只能去找威拉格商量一下了。"
                }
            ]
        },
        {
            "id": "7000708",
            "objective": "与威拉格交谈",
            "dialogues": [
                {
                    "id": "700070801",
                    "speaker": "Player",
                    "text": "关于图书馆的吵闹声…"
                },
                {
                    "id": "700070802",
                    "speaker": "威拉格",
                    "text": "原来如此，那应该可以用「那个办法」了。"
                },
                {
                    "id": "700070803",
                    "speaker": "威拉格",
                    "text": "丽莎小姐说过，如果有人违反了图书馆的规定，就必须要受到惩罚…"
                },
                {
                    "id": "700070804",
                    "speaker": "威拉格",
                    "text": "麻烦你们去图书馆里，传达一下丽莎小姐的意思吧。"
                },
                {
                    "id": "700070805",
                    "speaker": "派蒙",
                    "text": "折坏书页、塞玫瑰花进书里、把书倒着插进书架…肯定算是违反了图书馆的规则吧。"
                },
                {
                    "id": "700070806",
                    "speaker": "派蒙",
                    "text": "我们走，去向那些来图书馆却不读书的人传达一下丽莎小姐的意思吧。"
                }
            ]
        },
        {
            "id": "7000709",
            "objective": "传达丽莎小姐的意思",
            "dialogues": []
        },
        {
            "id": "7000710",
            "objective": "(test)自动触发与派蒙的对话$HIDDEN",
            "dialogues": [
                {
                    "id": "700071001",
                    "speaker": "派蒙",
                    "text": "欸——什么？丽莎小姐马上就要回来了？"
                },
                {
                    "id": "700071002",
                    "speaker": "派蒙",
                    "text": "要是她知道，有人把书乱用乱放的话，还折页损坏，一定会很生气吧？"
                },
                {
                    "id": "700071003",
                    "speaker": "Player",
                    "text": "是啊，怎么办呢，真是糟糕啊。"
                },
                {
                    "id": "700071004",
                    "speaker": "派蒙",
                    "text": "要怎么办呢？如果现在开始收拾，还有机会补救吧？"
                },
                {
                    "id": "700071005",
                    "speaker": "艾拉·马斯克",
                    "text": "没想到你们能想到这么好的办法。"
                },
                {
                    "id": "700071006",
                    "speaker": "Player",
                    "text": "都是威拉格的主意…"
                },
                {
                    "id": "700071007",
                    "speaker": "Player",
                    "text": "还是多亏了丽莎小姐…"
                },
                {
                    "id": "700071008",
                    "speaker": "艾拉·马斯克",
                    "text": "不过要是丽莎小姐看到刚刚的场面，确实会生气吧，这可是图书馆，是学习的地方。"
                },
                {
                    "id": "700071009",
                    "speaker": "艾拉·马斯克",
                    "text": "我终于可以安心做研究了，这是给你们的报酬，谢谢你们。"
                }
            ]
        },
        {
            "id": "7000711",
            "objective": "(test)处理约会NPC$HIDDEN",
            "dialogues": []
        },
        {
