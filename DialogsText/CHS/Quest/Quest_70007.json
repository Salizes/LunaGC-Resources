        {
            "id": "6164802",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "616480201",
                    "speaker": "Player",
                    "text": "这里是？"
                },
                {
                    "id": "616480202",
                    "speaker": "威拉格",
                    "text": "这是西风骑士团总部的大厅，请注意不要大声喧哗。"
                },
                {
                    "id": "616480203",
                    "speaker": "威拉格",
                    "text": "进入图书馆前记得清理鞋底，不要把灰尘和污泥带进去。"
                }
            ]
        },
        {
            "id": "6164803",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "616480301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "616480302",
                    "speaker": "威拉格",
                    "text": "再见，请记得离开时要关门。"
                }
            ]
        },
        {
            "id": "7000751",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "700075101",
                    "speaker": "艾拉·马斯克",
                    "text": "拜托你们了，我真的很需要安静…"
                }
            ]
        },
        {
            "id": "7000752",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "700075201",
