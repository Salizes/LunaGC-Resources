    "talks": [
        {
            "id": "7000701",
            "objective": "(test)接取任务用隐藏任务$HIDDEN",
            "dialogues": [
                {
                    "id": "700070101",
                    "speaker": "艾拉·马斯克",
                    "text": "Ye ika gusha mosi！",
                    "choices": [
                        {
                            "id": "700070102",
                            "text": "感觉你心情不太好…",
                            "response": [
                                {
                                    "id": "700070104",
                                    "speaker": "艾拉·马斯克",
                                    "text": "不好意思，因为最近图书馆实在非常吵闹，我很难安静下来研究丘丘人语。"
                                },
                                {
                                    "id": "700070105",
                                    "speaker": "艾拉·马斯克",
                                    "text": "风花节开始之后，有很多人到这里来约会。他们一开始还能保持安静地看看书，后来就聊起来了。"
                                },
                                {
                                    "id": "700070106",
                                    "speaker": "艾拉·马斯克",
                                    "text": "而且…而且他们还做了各种可怕的事…"
                                },
                                {
                                    "id": "700070107",
                                    "speaker": "艾拉·马斯克",
                                    "text": "把书的书角折坏…在书页里塞各种奇奇怪怪的东西…甚至、甚至他们还把书倒着插进书架！"
                                },
                                {
                                    "id": "700070108",
                                    "speaker": "艾拉·马斯克",
                                    "text": "图书馆可不是谈情说爱的地方！这样只会打扰到真正在这里看书做研究的人！",
                                    "choices": [
                                        {
                                            "id": "700070109",
                                            "text": "威拉格应该来维持秩序。",
                                            "response": [
                                                {
                                                    "id": "700070110",
                                                    "speaker": "艾拉·马斯克",
                                                    "text": "他也没什么好办法，把人赶走也只是治标不治本。"
                                                },
                                                {
                                                    "id": "700070113",
                                                    "speaker": "艾拉·马斯克",
                                                    "text": "总之，麻烦你帮帮忙，让这里的人都安静下来吧。",
                                                    "choices": [
                                                        {
                                                            "id": "700070114",
                                                            "text": "交给我吧。",
                                                            "response": [
                                                                {
                                                                    "id": "700070116",
                                                                    "speaker": "艾拉·马斯克",
                                                                    "text": "谢谢你，最吵闹的就是那边的三对，只要让他们注意到影响，我就能继续研究了。"
                                                                },
                                                                {
                                                                    "id": "700070117",
                                                                    "speaker": "艾拉·马斯克",
                                                                    "text": "不过当心点，他们都没那么好对付…"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "700070115",
                                                            "text": "我试试看。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "700070111",
                                            "text": "可以找丽莎…",
                                            "response": [
                                                {
                                                    "id": "700070112",
                                                    "speaker": "艾拉·马斯克",
                                                    "text": "但我听说，她现在正在陪代理团长巡逻，暂时不在。如果她在的话，这些情侣肯定会收敛很多的…"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "700070103",
                            "text": "语气比平常更凶了。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7000712",
            "objective": "去图书馆找艾拉·马斯克",
            "dialogues": []
        },
        {
            "id": "7000702",
            "objective": "去劝说约会者保持安静",
            "dialogues": [
                {
                    "id": "700070201",
                    "speaker": "热恋中的青年",
                    "text": "真是感人的故事啊，可惜最后没有一个圆满的结局。"
                },
                {
                    "id": "700070202",
                    "speaker": "热恋中的少女",
                    "text": "我们以后不会变成那样的，对吧？"
                },
                {
                    "id": "700070203",
                    "speaker": "热恋中的青年",
                    "text": "那是当然的，就算我们天各一方，我也会想办法把你带回我的身边。",
                    "choices": [
                        {
                            "id": "700070204",
                            "text": "图书馆应该保持安静。",
                            "response": [
                                {
                                    "id": "700070206",
                                    "speaker": "热恋中的少女",
                                    "text": "欸？我应该很克制我的声音了。"
                                },
                                {
                                    "id": "700070207",
                                    "speaker": "热恋中的青年",
                                    "text": "唉，或许这也是恋爱的阻碍吧…"
                                },
                                {
                                    "id": "700070208",
                                    "speaker": "派蒙",
                                    "text": "看过的故事书，也应该放回正确的地方。"
                                },
                                {
                                    "id": "700070209",
                                    "speaker": "派蒙",
                                    "text": "像现在这样随便乱放，负责整理书架的人会很头疼的。"
                                },
                                {
                                    "id": "700070210",
                                    "speaker": "热恋中的青年",
                                    "text": "知道了，知道了，请不要再打扰我们了，正在关键的时候呢。"
                                },
                                {
                                    "id": "700070211",
                                    "speaker": "派蒙",
                                    "text": "关键的时候…？"
                                },
                                {
                                    "id": "700070212",
                                    "speaker": "热恋中的少女",
                                    "text": "不管有多少阻碍，你都会像现在这样，永远不变吧？"
                                },
                                {
                                    "id": "700070213",
                                    "speaker": "热恋中的青年",
                                    "text": "是的，我以我的生命起誓。"
                                },
                                {
                                    "id": "700070214",
                                    "speaker": "热恋中的少女",
                                    "text": "也不用这么夸张…生命什么的，我会心疼的。"
                                },
                                {
                                    "id": "700070215",
                                    "speaker": "热恋中的青年",
                                    "text": "啊，就是你这样的温柔，令人沉醉…"
                                },
                                {
                                    "id": "700070216",
                                    "speaker": "派蒙",
                                    "text": "我觉得，他们完全没听进去。"
                                }
                            ]
                        },
                        {
                            "id": "700070205",
                            "text": "有人说你们太吵了。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7000703",
            "objective": "去劝说约会者保持安静",
            "dialogues": [
                {
                    "id": "700070301",
                    "speaker": "陷入爱河的女性",
                    "text": "嗯？请问有是什么事吗？",
                    "choices": [
                        {
                            "id": "700070302",
                            "text": "图书馆应该保持安静。",
                            "response": [
                                {
                                    "id": "700070304",
                                    "speaker": "陷入爱河的女性",
                                    "text": "抱歉，我会注意的，但有时候，这都属于不可抗力。"
                                },
                                {
                                    "id": "700070305",
                                    "speaker": "变魔术的男性",
                                    "text": "比如，在你没注意到的时候，我从书页的背后取出了一朵玫瑰。"
                                },
                                {
                                    "id": "700070306",
                                    "speaker": "变魔术的男性",
                                    "text": "从书中诞生的玫瑰，就像你一样，充满了温柔和知性美…"
                                },
                                {
                                    "id": "700070307",
                                    "speaker": "陷入爱河的女性",
                                    "text": "哇？！好厉害！"
                                },
                                {
                                    "id": "700070308",
                                    "speaker": "派蒙",
                                    "text": "声音太大了！还有，不能用书本来变魔术！会折坏的！"
                                },
                                {
                                    "id": "700070309",
                                    "speaker": "Player",
                                    "text": "派蒙你的声音也大起来了…"
                                },
                                {
                                    "id": "700070310",
                                    "speaker": "派蒙",
                                    "text": "哦，对不起，一不小心就…"
                                },
                                {
                                    "id": "700070311",
                                    "speaker": "陷入爱河的女性",
                                    "text": "你也明白了吧，有时候这就是不可抗力。"
                                },
                                {
                                    "id": "700070312",
                                    "speaker": "陷入爱河的女性",
                                    "text": "我会注意控制我的声音的，实在不好意思。"
                                },
                                {
                                    "id": "700070313",
                                    "speaker": "派蒙",
                                    "text": "看起来，他们完全没听进去呢…"
                                }
                            ]
                        },
                        {
                            "id": "700070303",
                            "text": "有人说你们太吵了。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7000704",
            "objective": "去劝说约会者保持安静",
            "dialogues": [
                {
                    "id": "700070401",
                    "speaker": "看似理性的女性",
                    "text": "你所主张的「情感波动会影响研究分析的准确性」，还是没有确切的论据。"
                },
                {
                    "id": "700070402",
                    "speaker": "看似理性的男性",
                    "text": "唉，我明白，我现在可能是陷入了一种奇怪的瓶颈…"
                },
                {
                    "id": "700070403",
                    "speaker": "看似理性的男性",
                    "text": "你们来得正好，我有一个困扰需要听听看外人的意见。"
                },
                {
                    "id": "700070404",
                    "speaker": "看似理性的男性",
                    "text": "如果我要证明我理论的正确性，就要保证我没有情感的波动。"
                },
                {
                    "id": "700070405",
                    "speaker": "看似理性的男性",
                    "text": "但我总是做不到这件事，尤其是和她在讨论的时候，我总是不能冷静下来好好思考。"
                },
                {
                    "id": "700070406",
                    "speaker": "看似理性的女性",
                    "text": "我也觉得有点奇怪，难道是睡眠不足吗？还是昨天酒精摄入过头了呢？",
                    "choices": [
                        {
                            "id": "700070407",
                            "text": "总之，图书馆不可以大声讲话。",
                            "response": [
                                {
                                    "id": "700070408",
                                    "speaker": "Player",
                                    "text": "总之，先压低音量吧。"
                                },
                                {
                                    "id": "700070409",
                                    "speaker": "看似理性的男性",
                                    "text": "抱歉，但在弄明白这件事之前，我就是不甘心。"
                                },
                                {
                                    "id": "700070410",
                                    "speaker": "派蒙",
                                    "text": "完、完全听不明白…"
                                },
                                {
                                    "id": "700070411",
                                    "speaker": "派蒙",
                                    "text": "呃，总之，不能打扰别人，还有，看过的书不能倒着塞进书架！"
                                },
                                {
                                    "id": "700070412",
                                    "speaker": "派蒙",
                                    "text": "好吧…他们好像不搭理我们了…"
                                }
                            ]
                        },
                        {
                            "id": "700070408",
                            "text": "总之，先压低音量吧。"
                        }
                    ]
                }
            ]
        },
        {
