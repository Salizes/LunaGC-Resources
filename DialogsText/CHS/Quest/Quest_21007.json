    "talks": [
        {
            "id": "2100701",
            "objective": "搜索明蕴镇",
            "dialogues": [
                {
                    "id": "210070101",
                    "speaker": "遗训",
                    "text": "「…孤木孑立，无林可依…坚石存金，同心共取…富贵晓明，笃念祖训…」"
                }
            ]
        },
        {
            "id": "2100702",
            "objective": "搜寻「祖训」$HIDDEN",
            "dialogues": [
                {
                    "id": "210070201",
                    "speaker": "元青",
                    "text": "可恶！可恶！我到底是造了什么孽…"
                },
                {
                    "id": "210070202",
                    "speaker": "元青",
                    "text": "好不容易趁他们没反应过来，抢先跑过来矿洞里拿宝贝，怎么这么多怪物…"
                },
                {
                    "id": "210070203",
                    "speaker": "元青",
                    "text": "可恶，可恶…"
                }
            ]
        },
        {
            "id": "2100703",
            "objective": "搜寻「祖训」",
            "dialogues": [
                {
                    "id": "210070301",
                    "speaker": "元成",
                    "text": "什么兄弟，大哥们只会把好东西自己先拿到手！"
                },
                {
                    "id": "210070302",
                    "speaker": "元成",
                    "text": "老头子也是一副老糊涂的样子，睁一只眼闭一只眼…"
                },
                {
                    "id": "210070303",
                    "speaker": "元成",
                    "text": "他们应该还不知道，宝贝在矿洞里。"
                },
                {
                    "id": "210070304",
                    "speaker": "元成",
                    "text": "必须要快点去拿宝贝，然后就走…走得远远的…"
                }
            ]
        },
        {
            "id": "2100704",
            "objective": "搜寻「祖训」",
            "dialogues": [
                {
                    "id": "210070401",
                    "speaker": "元良",
                    "text": "嘿嘿…这下宝贝都是我的了…"
                },
                {
                    "id": "210070402",
                    "speaker": "元良",
                    "text": "大哥和小弟可真是傻子，抓了两句就跑，嘿嘿嘿…"
                },
                {
                    "id": "210070403",
                    "speaker": "元良",
                    "text": "什么祖训，有用的就一句，宝贝就在矿洞里，嘿嘿嘿，这下子宝贝全都是我的了…"
                }
            ]
        },
        {
            "id": "2100705",
            "objective": "搜寻「祖训」",
            "dialogues": [
                {
                    "id": "210070501",
                    "speaker": "元鸿",
                    "text": "走啦…都走啦…"
                },
                {
                    "id": "210070502",
                    "speaker": "元鸿",
                    "text": "元青，元良…还有元成，傻孩子们，你们再好好看看，再好好想想啊…"
                }
            ]
        },
        {
            "id": "2100706",
            "objective": "搜寻「祖训」",
            "dialogues": [
                {
                    "id": "210070601",
                    "speaker": "派蒙",
                    "text": "呜哇…是，是之前的那些人…"
                },
                {
                    "id": "210070602",
                    "speaker": "元青",
                    "text": "孤木孑立，无林可依…哈哈，一个人，果然是什么都做不到…"
                },
                {
                    "id": "210070603",
                    "speaker": "元成",
                    "text": "红叶萋萋，无风自离…如果我能相信大哥和老头子的话…"
                },
                {
                    "id": "210070604",
                    "speaker": "元良",
                    "text": "红叶簌簌，乘风散去…宝贝，宝贝…为了宝贝，什么都没了…"
                },
                {
                    "id": "210070605",
                    "speaker": "元鸿",
                    "text": "盘木森森，荫蔽家庭…孩子们，我们都是一家人呐。"
                },
                {
                    "id": "210070606",
                    "speaker": "元鸿",
                    "text": "你们都觉得，我把宝贝藏在了矿洞里…"
                },
                {
                    "id": "210070607",
                    "speaker": "元鸿",
                    "text": "但是，我哪里有什么宝贝…你们还记得这棵树吗，这是你们小时候，我们全家一起栽的…"
                },
                {
                    "id": "210070608",
                    "speaker": "元鸿",
                    "text": "我每年都会过来，在这里面埋点东西，希望你们长大之后，我们全家再一起去挖出来。"
                },
                {
                    "id": "210070609",
                    "speaker": "元鸿",
                    "text": "到时候，我们就用这里面的东西去买点好吃的，买点小酒，全家在一起，聊聊过去的小事…"
                },
                {
                    "id": "210070610",
                    "speaker": "元鸿",
                    "text": "孩子们哪，孩子们哪…"
                }
            ]
        },
