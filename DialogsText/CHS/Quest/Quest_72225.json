    "talks": [
        {
            "id": "7222501",
            "objective": "(test)阿瑠说话$HIDDEN",
            "dialogues": [
                {
                    "id": "722250101",
                    "speaker": "阿久",
                    "text": "好疼…"
                },
                {
                    "id": "722250102",
                    "speaker": "阿瑠",
                    "text": "#{NICKNAME}{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}、派蒙！你们来得正好…"
                },
                {
                    "id": "722250103",
                    "speaker": "Player",
                    "text": "发生什么事了？"
                },
                {
                    "id": "722250104",
                    "speaker": "阿久",
                    "text": "脚崴着了…"
                },
                {
                    "id": "722250105",
                    "speaker": "阿瑠",
                    "text": "阿久哥又受伤了，能请你们供奉栖木吗？",
                    "choices": [
                        {
                            "id": "722250106",
                            "text": "这样的发展也不是没猜到…",
                            "response": [
                                {
                                    "id": "722250107",
                                    "speaker": "派蒙",
                                    "text": "没问题，那就交给我们吧！"
                                },
                                {
                                    "id": "722250109",
                                    "speaker": "阿瑠",
                                    "text": "太感谢了！"
                                },
                                {
                                    "id": "722250110",
                                    "speaker": "派蒙",
                                    "text": "对了，阿瑠你不是也对「元素」很敏感吗？"
                                },
                                {
                                    "id": "722250111",
                                    "speaker": "派蒙",
                                    "text": "为什么你不自己去供奉栖木呢？"
                                },
                                {
                                    "id": "722250112",
                                    "speaker": "阿瑠",
                                    "text": "唔…以前我也在祭典里做过各种各样的事情，但最后的结果好像不太好。",
                                    "choices": [
                                        {
                                            "id": "722250113",
                                            "text": "为什么？",
                                            "response": [
                                                {
                                                    "id": "722250114",
                                                    "speaker": "阿瑠",
                                                    "text": "我也不知道…"
                                                },
                                                {
                                                    "id": "722250117",
                                                    "speaker": "派蒙",
                                                    "text": "真没办法，那栖木就交给我们吧。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "722250115",
                                            "text": "那就交给我吧。"
                                        },
                                        {
                                            "id": "722250116",
                                            "text": "受伤的人就交给你了。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "722250108",
                            "text": "交给我吧。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7222506",
            "objective": "（test）共鸣$HIDDEN",
            "dialogues": [
                {
                    "id": "722250601",
                    "speaker": "阿久",
                    "text": "真是难堪…希望不会影响祭典。"
                },
                {
                    "id": "722250602",
                    "speaker": "阿久",
                    "text": "不然的话，就太对不起阿瑠了。"
                },
                {
                    "id": "722250603",
                    "speaker": "阿瑠",
                    "text": "怎么会呢。阿久哥一直都对我很好。"
                }
            ]
        },
        {
            "id": "7222502",
            "objective": "(test)栖木供奉$HIDDEN",
            "dialogues": [
                {
                    "id": "722250201",
                    "speaker": "阿瑠",
                    "text": "供奉栖木的事情，就拜托啦。"
                },
                {
                    "id": "722250202",
                    "speaker": "阿瑠",
                    "text": "我在这里陪着阿久哥。"
                }
            ]
        },
        {
            "id": "7222503",
            "objective": "(test)cs树叶生长$HIDDEN",
            "dialogues": [
                {
                    "id": "722250301",
                    "speaker": "阿瑠",
                    "text": "栖木焕发生机了！"
                },
                {
                    "id": "722250302",
                    "speaker": "阿久",
                    "text": "供奉栖木，总算是完成了呢。真不容易。"
                },
                {
                    "id": "722250303",
                    "speaker": "派蒙",
                    "text": "哼哼，我们可是处理这种问题的专家。"
                },
                {
                    "id": "722250304",
                    "speaker": "Player",
                    "text": "和「导光仪式」差不多。"
                },
                {
                    "id": "722250305",
                    "speaker": "派蒙",
                    "text": "为了处理一件事，需要解决分散在三个地点的三个问题…"
                },
                {
                    "id": "722250306",
                    "speaker": "派蒙",
                    "text": "总感觉，和你一起，总会遇到这种事情。"
                },
                {
                    "id": "722250307",
                    "speaker": "阿瑠",
                    "text": "虽然别的事情我不是很明白，但大人中有这样的说法…"
                },
                {
                    "id": "722250308",
                    "speaker": "阿瑠",
                    "text": "就是「万事皆三」喔。"
                },
                {
                    "id": "722250309",
                    "speaker": "派蒙",
                    "text": "万事皆三…是什么意思？"
                },
                {
                    "id": "722250310",
                    "speaker": "阿瑠",
                    "text": "嗯…大概就是，任何事情都要经历三次以后，才能迎来结果吧？"
                },
                {
                    "id": "722250311",
                    "speaker": "阿瑠",
                    "text": "比如说，吉兆要发生三次，好运才会真正降临。然后，如果凶兆发生了三次，那一定会发生坏事。"
                },
                {
                    "id": "722250312",
                    "speaker": "阿瑠",
                    "text": "做事情的时候，也会遇到三次困难，第四次才会成功。"
                },
                {
                    "id": "722250313",
                    "speaker": "派蒙",
                    "text": "但是，那样的话，不应该是「万事皆四」吗？"
                },
                {
                    "id": "722250314",
                    "speaker": "阿瑠",
                    "text": "也是呢！派蒙的数学真好！"
                },
                {
                    "id": "722250315",
                    "speaker": "派蒙",
                    "text": "哼哼，那当然了。",
                    "choices": [
                        {
                            "id": "722250316",
                            "text": "重点是数学？",
                            "response": [
                                {
                                    "id": "722250317",
                                    "speaker": "派蒙",
                                    "text": "话说回来，阿久的伤没问题吗？"
                                },
                                {
                                    "id": "722250319",
                                    "speaker": "阿瑠",
                                    "text": "不用担心哦。阿久哥总是这样。"
                                },
                                {
                                    "id": "722250320",
                                    "speaker": "阿久",
                                    "text": "真是难堪…希望不会影响祭典。"
                                },
                                {
                                    "id": "722250321",
                                    "speaker": "阿久",
                                    "text": "不然的话，就太对不起阿瑠了。"
                                },
                                {
                                    "id": "722250322",
                                    "speaker": "阿瑠",
                                    "text": "怎么会呢。阿久哥一直都对我很好。"
                                },
                                {
                                    "id": "722250323",
                                    "speaker": "阿久",
                                    "text": "……"
                                },
                                {
                                    "id": "722250324",
                                    "speaker": "阿瑠",
                                    "text": "#{NICKNAME}{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}、派蒙，你们先走吧。"
                                },
                                {
                                    "id": "722250325",
                                    "speaker": "阿瑠",
                                    "text": "我陪阿久哥多坐一会。然后，再为供奉收尾。"
                                }
                            ]
                        },
                        {
                            "id": "722250318",
                            "text": "阿久受的伤…"
                        }
                    ]
                }
            ]
        },
