        }
    },
    "talks": [
        {
            "id": "2201901",
            "objective": "与珊瑚对话",
            "dialogues": [
                {
                    "id": "220190101",
                    "speaker": "珊瑚",
                    "text": "…那么，就拜托两位了。"
                },
                {
                    "id": "220190102",
                    "speaker": "安藤",
                    "text": "就交给我们了，放心吧，珊瑚小姐。"
                },
                {
                    "id": "220190103",
                    "speaker": "天野",
                    "text": "居然在我们眼皮底下藏了这么久，真是胆大包天的家伙。"
                },
                {
                    "id": "220190104",
                    "speaker": "天野",
                    "text": "而且，还用…那种身份。"
                },
                {
                    "id": "220190105",
                    "speaker": "珊瑚",
                    "text": "不管怎么样，他犯案的日子今天就要到头了。龙二，我交代你的事你记住了吧？"
                },
                {
                    "id": "220190106",
                    "speaker": "龙二",
                    "text": "是，社长。"
                },
                {
                    "id": "220190107",
                    "speaker": "珊瑚",
                    "text": "那就好…旅行者，你也来了啊，那太好了。",
                    "choices": [
                        {
                            "id": "220190108",
                            "text": "是要去抓犯人了吗？",
                            "response": [
                                {
                                    "id": "220190111",
                                    "speaker": "珊瑚",
                                    "text": "证据已经搜集充足，犯人的行为我也已经摸清了。"
                                },
                                {
                                    "id": "220190112",
                                    "speaker": "珊瑚",
                                    "text": "旅行者，你就和龙二，还有安藤先生和天野先生同行，让那个犯人伏法吧。"
                                },
                                {
                                    "id": "220190113",
                                    "speaker": "珊瑚",
                                    "text": "那家伙应该有不少同伙，有你在的话，行动成功的把握就更大了。",
                                    "choices": [
                                        {
                                            "id": "220190114",
                                            "text": "我要做什么？",
                                            "response": [
                                                {
                                                    "id": "220190115",
                                                    "speaker": "珊瑚",
                                                    "text": "用你那无敌的气势震慑住犯人就好，免得他做出什么…不太明智的举动。"
                                                },
                                                {
                                                    "id": "220190116",
                                                    "speaker": "珊瑚",
                                                    "text": "不过，我想这种只会偷偷摸摸的盗贼，应该也没有做出什么激烈举动的气魄。"
                                                },
                                                {
                                                    "id": "220190121",
                                                    "speaker": "珊瑚",
                                                    "text": "如果我估计得没错，现在那家伙应该已经去了野外，准备把新一批的赃物埋在地里。"
                                                },
                                                {
                                                    "id": "220190122",
                                                    "speaker": "珊瑚",
                                                    "text": "你们现在过去，应该刚好可以人赃并获。快出发吧，我在这里等你们的好消息。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "220190117",
                                            "text": "你不一起去吗？",
                                            "response": [
                                                {
                                                    "id": "220190118",
                                                    "speaker": "珊瑚",
                                                    "text": "对我来说，这桩案子已经结束了，剩下的事我就不参与了。"
                                                },
                                                {
                                                    "id": "220190119",
                                                    "speaker": "珊瑚",
                                                    "text": "旅行者，你就去用你那无敌的气势震慑住犯人吧。免得他做出什么…不太明智的举动。"
                                                },
                                                {
                                                    "id": "220190120",
                                                    "speaker": "珊瑚",
                                                    "text": "不过，我想这种只会偷偷摸摸的盗贼，应该也没有做出什么激烈举动的气魄。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "220190109",
                            "text": "是要结案了吗？",
                            "response": [
                                {
                                    "id": "220190110",
                                    "speaker": "珊瑚",
                                    "text": "嗯，只要一切顺利，今天就可以结案了。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2201902",
            "objective": "前往犯人所在地",
            "dialogues": [
                {
                    "id": "220190201",
                    "speaker": "龙二",
                    "text": "发现那家伙了，果然正在埋自己的赃物…",
                    "choices": [
                        {
                            "id": "220190202",
                            "text": "我们上！",
                            "response": [
                                {
                                    "id": "220190203",
                                    "speaker": "龙二",
                                    "text": "等一下，旅行者，现在…还不是我们该上的时候。"
                                },
                                {
                                    "id": "220190206",
                                    "speaker": "龙二",
                                    "text": "再等一下…嗯…应该差不多了…"
                                },
                                {
                                    "id": "220190207",
                                    "speaker": "安藤",
                                    "text": "你这家伙，在做什么！"
                                },
                                {
                                    "id": "220190208",
                                    "speaker": "天野",
                                    "text": "放下手里的东西，别动！"
                                },
                                {
                                    "id": "220190209",
                                    "speaker": "石川八郎",
                                    "text": "你、你们是怎么…"
                                },
                                {
                                    "id": "220190210",
                                    "speaker": "石川八郎",
                                    "text": "可恶…别看着了！一起上！解决掉这两个家伙，我们就远走高飞！"
                                },
                                {
                                    "id": "220190211",
                                    "speaker": "天野",
                                    "text": "几个盗宝团，居然敢这么嚣张…"
                                },
                                {
                                    "id": "220190212",
                                    "speaker": "龙二",
                                    "text": "安藤先生，天野先生，我们来帮你！"
                                },
                                {
                                    "id": "220190213",
                                    "speaker": "安藤",
                                    "text": "哦！就拜托你们了！"
                                },
                                {
                                    "id": "220190214",
                                    "speaker": "龙二",
                                    "text": "旅行者，现在我们可以上场了。"
                                },
                                {
                                    "id": "220190215",
                                    "speaker": "Player",
                                    "text": "搞这么麻烦…"
                                },
                                {
                                    "id": "220190216",
                                    "speaker": "龙二",
                                    "text": "这都是社长的嘱咐。"
                                },
                                {
                                    "id": "220190217",
                                    "speaker": "龙二",
                                    "text": "好了，我们上吧。"
                                }
                            ]
                        },
                        {
                            "id": "220190204",
                            "text": "要上吗？",
                            "response": [
                                {
                                    "id": "220190205",
                                    "speaker": "龙二",
                                    "text": "稍等一下，现在还不是我们该上的时候。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2201903",
            "objective": "与龙二对话",
            "dialogues": []
        },
        {
            "id": "2201904",
            "objective": "打倒所有盗宝团",
            "dialogues": [
                {
                    "id": "220190401",
                    "speaker": "龙二",
                    "text": "…安藤和天野应该已经带着犯人回奉行所了。事情就是这样，社长。"
                },
                {
                    "id": "220190402",
                    "speaker": "珊瑚",
                    "text": "嗯，知道了，这样解决了就好。"
                },
                {
                    "id": "220190403",
                    "speaker": "珊瑚",
                    "text": "旅行者，你也回来了啊，这次辛苦你了。",
                    "choices": [
                        {
                            "id": "220190404",
                            "text": "就…这么完了？",
                            "response": [
                                {
                                    "id": "220190406",
                                    "speaker": "珊瑚",
                                    "text": "毕竟人是天野和安藤带走的，有这种感觉也正常。拿着这些报酬吧，这样你多少会有点「实感」吧。",
                                    "choices": [
                                        {
                                            "id": "220190407",
                                            "text": "那你的报酬呢？",
                                            "response": [
                                                {
                                                    "id": "220190408",
                                                    "speaker": "珊瑚",
                                                    "text": "我？能够帮助奉行所的大人们侦破案件，让这条街恢复平静，对我来说就是最大的报酬。"
                                                },
                                                {
                                                    "id": "220190412",
                                                    "speaker": "珊瑚",
                                                    "text": "但老实说，这次我确实能算是「一无所获」。"
                                                },
                                                {
                                                    "id": "220190413",
                                                    "speaker": "珊瑚",
                                                    "text": "既没有见识到新奇的犯罪手法，也没有听见新奇的犯罪理念。"
                                                },
                                                {
                                                    "id": "220190414",
                                                    "speaker": "珊瑚",
                                                    "text": "只不过是毫无趣味的一般犯罪而已，还好没有费太大的功夫。",
                                                    "choices": [
                                                        {
                                                            "id": "220190415",
                                                            "text": "珊瑚社长…",
                                                            "response": [
                                                                {
                                                                    "id": "220190416",
                                                                    "speaker": "珊瑚",
                                                                    "text": "怎么？你第一次见到我这种对「犯罪」感兴趣的人吗？"
                                                                },
                                                                {
                                                                    "id": "220190419",
                                                                    "speaker": "珊瑚",
                                                                    "text": "这种对于「犯罪」的兴趣，也是我成为侦探的原因。"
                                                                },
                                                                {
                                                                    "id": "220190420",
                                                                    "speaker": "Player",
                                                                    "text": "…你也想「犯罪」吗？"
                                                                },
                                                                {
                                                                    "id": "220190421",
                                                                    "speaker": "珊瑚",
                                                                    "text": "对啊。我可是很想「犯罪」的。我想进行一场完美的，毫无破绽的「犯罪」。"
                                                                },
                                                                {
                                                                    "id": "220190422",
                                                                    "speaker": "珊瑚",
                                                                    "text": "但可惜的是…人在犯下罪案的时候，几乎都会留下痕迹。只要留下了痕迹，这桩罪案被侦破也是早晚的事。",
                                                                    "choices": [
                                                                        {
                                                                            "id": "220190423",
                                                                            "text": "如果不是人犯的罪呢？",
                                                                            "response": [
                                                                                {
                                                                                    "id": "220190426",
                                                                                    "speaker": "珊瑚",
                                                                                    "text": "你瞧，你也不由自主地开始思考起「犯罪」了，对不？"
                                                                                },
                                                                                {
                                                                                    "id": "220190427",
                                                                                    "speaker": "珊瑚",
                                                                                    "text": "没什么好不安的，你也只不过是思考一下而已。"
                                                                                },
                                                                                {
                                                                                    "id": "220190428",
                                                                                    "speaker": "珊瑚",
                                                                                    "text": "我也经常对「犯罪」进行思考，比如犯罪的手法啦，犯罪的理由啦…"
                                                                                },
                                                                                {
                                                                                    "id": "220190429",
                                                                                    "speaker": "Player",
                                                                                    "text": "你思考这些做什么？"
                                                                                },
                                                                                {
                                                                                    "id": "220190430",
                                                                                    "speaker": "珊瑚",
                                                                                    "text": "当然是为了能更好地侦办案件啦。最近我接手的案件越来越复杂，不思考可不行啊。"
                                                                                },
                                                                                {
                                                                                    "id": "220190431",
                                                                                    "speaker": "珊瑚",
                                                                                    "text": "不过，那些案件里倒是也没有一桩能称得上是「完美犯罪」啦。"
                                                                                },
                                                                                {
                                                                                    "id": "220190432",
                                                                                    "speaker": "Player",
                                                                                    "text": "那你见过「完美犯罪」吗？"
                                                                                },
                                                                                {
                                                                                    "id": "220190433",
                                                                                    "speaker": "珊瑚",
                                                                                    "text": "见过喔。那桩「完美犯罪」…我到现在也没能找出真正的犯人。"
                                                                                },
                                                                                {
                                                                                    "id": "220190434",
                                                                                    "speaker": "珊瑚",
                                                                                    "text": "不过，我还是相信，只要是人犯下的案件，就一定会留下痕迹，我只不过是…还没有发现那些痕迹而已。"
                                                                                },
                                                                                {
                                                                                    "id": "220190435",
                                                                                    "speaker": "珊瑚",
                                                                                    "text": "好了，这些报酬给你，谢谢你帮我的忙，旅行者。"
                                                                                },
                                                                                {
                                                                                    "id": "220190436",
                                                                                    "speaker": "珊瑚",
                                                                                    "text": "以后有空了记得多来转转，没空的话…嗯…也没关系。"
                                                                                },
                                                                                {
                                                                                    "id": "220190437",
                                                                                    "speaker": "珊瑚",
                                                                                    "text": "我的直觉告诉我，我们还会有机会再一起联手的。"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "220190424",
                                                                            "text": "如果犯人不存在呢？"
                                                                        },
                                                                        {
                                                                            "id": "220190425",
                                                                            "text": "怎么清除全部痕迹呢？"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "220190417",
                                                            "text": "这就是「侦探」吗…",
                                                            "response": [
                                                                {
                                                                    "id": "220190418",
                                                                    "speaker": "珊瑚",
                                                                    "text": "也不能这么一概而论。但就我个人而言，是对「犯罪」很感兴趣的。"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "220190409",
                                            "text": "你什么都不要吗？",
                                            "response": [
                                                {
                                                    "id": "220190410",
                                                    "speaker": "珊瑚",
                                                    "text": "我已经收获了「正义」，除此之外，我也不需要什么了。"
                                                },
                                                {
                                                    "id": "220190411",
                                                    "speaker": "珊瑚",
                                                    "text": "…我是不是应该这么说比较好？"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "220190405",
                            "text": "没什么结束的实感…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "2201905",
            "objective": "与龙二对话",
            "dialogues": [
                {
                    "id": "220190301",
                    "speaker": "安藤",
                    "text": "这下子可算是人赃并获了，多谢了龙二，还有旅行者，你也辛苦了。"
                },
                {
                    "id": "220190302",
                    "speaker": "安藤",
                    "text": "我和天野现在就把这些盗宝团带回奉行所，剩下的事就交给我们吧。"
                },
                {
                    "id": "220190303",
                    "speaker": "天野",
                    "text": "不过，珊瑚还真是神了，居然能这么准确地找到犯人…"
                },
                {
                    "id": "220190304",
                    "speaker": "安藤",
                    "text": "毕竟是珊瑚嘛，这种案件，怎么想也难不住她。"
                },
                {
                    "id": "220190305",
                    "speaker": "安藤",
                    "text": "龙二，那我们就先回奉行所了。等处理好了这家伙，我们会再登门拜谢的。"
                },
                {
                    "id": "220190306",
                    "speaker": "龙二",
                    "text": "客气了，请慢走。"
                },
                {
                    "id": "220190307",
                    "speaker": "龙二",
                    "text": "好了，旅行者，我们也回去向社长报告一下吧。"
                }
            ]
        },
        {
            "id": "2201906",
            "objective": "与珊瑚对话",
            "dialogues": []
        },
        {
            "id": "2201906",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "220190601",
                    "speaker": "珊瑚",
                    "text": "你们现在过去，应该刚好可以人赃并获。快出发吧，我在这里等你们的好消息。"
                },
                {
                    "id": "220190602",
                    "speaker": "珊瑚",
                    "text": "怎么，还有什么事吗？旅行者。",
                    "choices": [
                        {
                            "id": "220190603",
                            "text": "你看上去情绪好像不高。",
                            "response": [
                                {
                                    "id": "220190604",
                                    "speaker": "珊瑚",
                                    "text": "一桩没什么意思的案子，一个没什么意思的犯罪者，犯罪的手法也称不上精致，只不过是一些小机灵。"
                                },
                                {
                                    "id": "220190605",
                                    "speaker": "珊瑚",
                                    "text": "如果要我评价这桩案子的话…应该只能称得上「无聊」吧。"
                                },
                                {
                                    "id": "220190606",
                                    "speaker": "珊瑚",
                                    "text": "不过，再怎么说这也是一桩罪案，能了结掉也是好事吧。"
                                }
                            ]
                        },
                        {
                            "id": "220190607",
                            "text": "你不一起去吗？",
                            "response": [
                                {
                                    "id": "220190608",
                                    "speaker": "珊瑚",
                                    "text": "对我来说，这桩案子已经结束了，剩下的事我就不参与了。"
                                },
                                {
                                    "id": "220190609",
                                    "speaker": "珊瑚",
                                    "text": "再说了，以我的身手和体格，要是被犯人反过来制服住，然后用来要挟你们就糟糕了。"
                                },
                                {
                                    "id": "220190610",
                                    "speaker": "珊瑚",
                                    "text": "我对自己可是有着很清醒的认知。所以，对付犯人的事就交给你们了。"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}