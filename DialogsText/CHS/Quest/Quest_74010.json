                }
            ]
        },
        {
            "id": "7401010",
            "objective": "(test)(隐藏)提交花回滚隔离$HIDDEN",
            "dialogues": [
                {
                    "id": "740101001",
                    "speaker": "Player",
                    "text": "就送霓裳花吧。"
                },
                {
                    "id": "740101002",
                    "speaker": "派蒙",
                    "text": "嗯，就送这个吧！这可是在枫丹少见的花朵，柯莎这下可以在人类面前炫耀啦！"
                }
            ]
        },
        {
            "id": "7401015",
            "objective": "(test)(隐藏)刷出花group$HIDDEN",
            "dialogues": [
                {
                    "id": "740101501",
                    "speaker": "派蒙",
                    "text": "呼！栽种异国的花朵，真是费力气啊。"
                },
                {
                    "id": "740101502",
                    "speaker": "Player",
                    "text": "出力的明明是我和柯莎。"
                },
                {
                    "id": "740101503",
                    "speaker": "派蒙",
                    "text": "我可是一直在为这些娇嫩的花朵提心吊胆呢，精神上的负重也消耗体力啊！"
                },
                {
                    "id": "740101504",
                    "speaker": "柯莎",
                    "text": "异国的花…真是新奇又美丽。柯莎的花圃，这下漂亮得人类都羡慕了！"
                },
                {
                    "id": "740101505",
                    "speaker": "派蒙",
                    "text": "没错，这可是在枫丹很少见的花朵哦。以后可以好好地向枫丹人炫耀啦！"
                }
            ]
        },
        {
            "id": "7401003",
            "objective": "与柯莎对话$HIDDEN",
            "dialogues": [
                {
                    "id": "740102001",
                    "speaker": "派蒙",
                    "text": "没想到，柯莎对花朵的印象会和我们差别这么大…解释起来又那么困难…有点伤脑筋。"
                },
                {
                    "id": "740102002",
                    "speaker": "柯莎",
                    "text": "为什么要伤脑筋呢？派蒙认为很美丽的花朵，在柯莎眼中也是一样的美丽呀。"
                },
                {
                    "id": "740102003",
                    "speaker": "派蒙",
                    "text": "美丽是美丽，但并不「一样」啦…不过喜爱花朵的心情确实是共通的。那就先不纠结这些，好好地照料花朵吧！"
                },
                {
                    "id": "740102004",
                    "speaker": "柯莎",
                    "text": "嗯！接下来柯莎要去打些<color=#00E1FFFF>水</color>来，浇灌珍贵的花朵…"
                },
                {
                    "id": "740102005",
                    "speaker": "Player",
                    "text": "没必要跑一趟，让我来吧。"
                },
                {
                    "id": "740102006",
                    "speaker": "派蒙",
                    "text": "#对呀，放心交给{NICKNAME}吧！"
                }
            ]
        },
        {
            "id": "7401004",
            "objective": "给花浇水$HIDDEN",
            "dialogues": [
                {
                    "id": "740100401",
                    "speaker": "Player",
                    "text": "比如说鸣草。"
                },
                {
                    "id": "740100402",
                    "speaker": "派蒙",
                    "text": "对呀，鸣草在天天下雷雨的地方都能生长，海沫村至少没有整天都噼里啪啦嘛！"
                },
                {
                    "id": "740100403",
                    "speaker": "柯莎",
                    "text": "「名草」，陌生的名字，人类有「园艺会」评选「名花」，异国也评选「名草」吗？"
                },
                {
                    "id": "740100404",
                    "speaker": "派蒙",
                    "text": "不不不，「鸣草」不是草，是一种花啦！即便没有风，它也会随雷声隐隐震动，所以，当地的居民还会用它来预报雷雨呢！"
                },
                {
                    "id": "740100405",
                    "speaker": "柯莎",
                    "text": "能自己振动的花朵…是什么样子呢？真想早点知道。"
                }
            ]
        },
        {
            "id": "7401005",
            "objective": "与柯莎对话$HIDDEN",
            "dialogues": [
                {
                    "id": "740102101",
                    "speaker": "派蒙",
                    "text": "这么多应该够了吧，接下来就看花的成长了。"
                },
                {
                    "id": "740102102",
                    "speaker": "Player",
                    "text": "希望能在柯莎的花圃顺利成活。"
                },
                {
                    "id": "740102103",
                    "speaker": "柯莎",
                    "text": "异国的花朵…柯莎一定会照顾好你们。"
                },
                {
                    "id": "740102104",
                    "speaker": "柯莎",
                    "text": "#派蒙和{NICKNAME}送来了异国的花，柯莎要用花一样美丽的礼物来报答。"
                },
                {
                    "id": "740102105",
                    "speaker": "派蒙",
                    "text": "嘿嘿，这个时候再说报答什么的，怪不好意思的…话说，这个零件就是「像花一样美丽的礼物」吗？"
                },
                {
                    "id": "740102106",
                    "speaker": "柯莎",
                    "text": "对呀，零件又美丽，在村里又有用处，柯莎最喜欢了，所以收集了很多，每天看到零件就会很快乐。"
                },
                {
                    "id": "740102107",
                    "speaker": "派蒙",
                    "text": "（…说零件有用倒能理解，说零件美丽…）"
                },
                {
                    "id": "740102108",
                    "speaker": "Player",
                    "text": "（派蒙不也觉得摩拉很美丽嘛。）"
                },
                {
                    "id": "740102109",
                    "speaker": "派蒙",
                    "text": "（欸嘿嘿，也对哦…而且每天看到摩拉也会很快乐。）"
                },
                {
                    "id": "740102110",
                    "speaker": "柯莎",
                    "text": "人类的生活很辛苦，他们是看到什么才会快乐呢？…柯莎就去人类的村里看——原来他们有好多美丽的花儿！"
                },
                {
                    "id": "740102111",
                    "speaker": "柯莎",
                    "text": "要是海沫村也能有许多美丽的花儿，那大家一定也会更快乐吧。"
                },
                {
                    "id": "740102112",
                    "speaker": "柯莎",
                    "text": "所以柯莎决心成为花匠，要让村里也有美丽的花圃！就算必须要付出美丽的零件，还会变得像人类一样辛苦…"
                },
                {
                    "id": "740102113",
                    "speaker": "派蒙",
                    "text": "原来柯莎为了种好自己喜爱的花朵，下了这么大的决心…嗯！你的付出绝不会白费，好心肠的派蒙会继续帮助你的！",
                    "choices": [
                        {
                            "id": "740102114",
                            "text": "不如派蒙也学习柯莎…",
                            "response": [
                                {
                                    "id": "740102116",
                                    "speaker": "派蒙",
                                    "text": "#这个…因为有更好心肠的{NICKNAME}在身边！所以，所以派蒙只要努力一点点就够了吧？…"
                                }
                            ]
                        },
                        {
                            "id": "740102115",
                            "text": "…努力赚自己喜欢的摩拉吧？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7401001",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "740100101",
                    "speaker": "柯莎",
                    "text": "为什么呢，为什么不发芽呢…"
                },
                {
                    "id": "740100102",
                    "speaker": "派蒙",
                    "text": "这是在忙什么吗？让我看看…啊，我懂了，这一定就是所谓的「家庭菜园」吧？"
                },
                {
                    "id": "740100103",
                    "speaker": "柯莎",
                    "text": "菜、菜园？可这明明是花圃…居然会被当成菜园…柯莎果然不是称职的花匠，呜…"
                },
                {
                    "id": "740100104",
                    "speaker": "派蒙",
                    "text": "欸，是我认错了吗？对不起啦。"
                },
                {
                    "id": "740100105",
                    "speaker": "派蒙",
                    "text": "对哦，之前柯莎说过没有花可以送给我们，就是在说这件事吧？"
                },
                {
                    "id": "740100106",
                    "speaker": "柯莎",
                    "text": "是呀，柯莎在花圃把花种埋下，全没动静。这些花种，该不会全都坏掉了吧？"
                },
                {
                    "id": "740100107",
                    "speaker": "派蒙",
                    "text": "好可惜，如果是这样的话，那只能从头做起了吧？"
                },
                {
                    "id": "740100108",
                    "speaker": "柯莎",
                    "text": "是啊，只能从头做起了呀。柯莎想要美丽的花圃，不想被当成菜园…"
                },
                {
                    "id": "740100109",
                    "speaker": "派蒙",
                    "text": "#唔…既然这样，就让什么忙都能帮的小帮手派蒙和大帮手{NICKNAME}来帮帮柯莎吧！"
                },
                {
                    "id": "740100110",
                    "speaker": "柯莎",
                    "text": "#派蒙和{NICKNAME}…会种花，会帮助柯莎吗？",
                    "choices": [
                        {
                            "id": "740100111",
                            "text": "我之前种过一些花卉和作物。",
                            "response": [
                                {
                                    "id": "740100112",
                                    "speaker": "柯莎",
                                    "text": "真令人羡慕！…柯莎的愿望是成为厉害的花匠，可种下的花朵总是枯萎。"
                                },
                                {
                                    "id": "740100115",
                                    "speaker": "柯莎",
                                    "text": "开始想要移栽，可是移栽的花儿总是不能成活。之后想到要从花种开始培育，花种却迟迟不肯发芽…"
                                },
                                {
                                    "id": "740100116",
                                    "speaker": "柯莎",
                                    "text": "花儿这么美丽，照顾花儿却这么辛苦…不过人类已经习惯了做辛苦的工作，所以照顾起花儿也很轻松。"
                                },
                                {
                                    "id": "740100117",
                                    "speaker": "Player",
                                    "text": "可能只是人类种花的地方环境更好。"
                                },
                                {
                                    "id": "740100118",
                                    "speaker": "柯莎",
                                    "text": "环境…卖花的人类也说，「外面的环境对花儿比较好」。但是种在外面，柯莎就很难去照看。"
                                },
                                {
                                    "id": "740100119",
                                    "speaker": "柯莎",
                                    "text": "据说，遥远的地方有各种各样的花。也许，也许其中有些，能适应村里的环境…可惜柯莎出不了远门，不能自己去找。"
                                },
                                {
                                    "id": "740100120",
                                    "speaker": "派蒙",
                                    "text": "#嘿嘿，那你碰到对的人了。派蒙和{NICKNAME}游历过许多地方，见到过各种各样的花。"
                                }
                            ]
                        },
                        {
                            "id": "740100113",
                            "text": "我见过别人种花。",
                            "response": [
                                {
                                    "id": "740100114",
                                    "speaker": "柯莎",
                                    "text": "见过别人种花的人类，很容易就能学会。柯莎也见过人类种花，自己做却总失败。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7401003",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "740100301",
                    "speaker": "Player",
                    "text": "比如说霓裳花。"
                },
                {
                    "id": "740100302",
                    "speaker": "柯莎",
                    "text": "「泥长花」，陌生的名字，也许是种在泥里，花瓣长长的花。"
                },
                {
                    "id": "740100303",
                    "speaker": "派蒙",
                    "text": "不是这样啦…「霓裳」是漂亮衣服的意思，这种花不但美丽，还可以被做成漂亮的衣服穿在身上哦。"
                },
                {
                    "id": "740100304",
                    "speaker": "柯莎",
                    "text": "异国的花朵又美丽，又可以穿在身上！…越想越羡慕。好想马上就能看到。"
                }
            ]
        },
        {
            "id": "7401005",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "740100501",
                    "speaker": "Player",
                    "text": "比如说须弥蔷薇。"
                },
                {
                    "id": "740100502",
                    "speaker": "派蒙",
                    "text": "对呀，须弥蔷薇在须弥的雨林中到处都有，是生命力很强的花。而且雨林的环境也比较潮湿，跟海沫村有些相似。"
                },
                {
                    "id": "740100503",
                    "speaker": "柯莎",
                    "text": "须弥蔷薇…柯莎种过别的蔷薇，须弥蔷薇有什么特别呢？"
                },
                {
                    "id": "740100504",
                    "speaker": "派蒙",
                    "text": "这个…要说花朵的品种，我也不是很懂啦，至少颜色是和枫丹的蔷薇不太一样。"
                },
                {
                    "id": "740100505",
                    "speaker": "派蒙",
                    "text": "不过，要说须弥蔷薇最出众的，还是它的味道——可以做成名贵的香水，放在甜食里面也很好吃，嘿嘿…"
                },
                {
                    "id": "740100506",
                    "speaker": "柯莎",
                    "text": "没见过的异国蔷薇，还有出众的香气…好想早些闻到。"
                },
                {
                    "id": "740100507",
                    "speaker": "Player",
                    "text": "或许闻到前就先被派蒙吃掉了。"
                },
                {
                    "id": "740100508",
                    "speaker": "派蒙",
                    "text": "不会的啦！派蒙要等到它做成料理才会吃！"
                }
            ]
        },
        {
            "id": "7401011",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "740101101",
                    "speaker": "Player",
                    "text": "就送鸣草吧。"
                },
                {
                    "id": "740101102",
                    "speaker": "派蒙",
                    "text": "嗯，就送这个吧！这可是在枫丹少见的花朵，柯莎这下可以在人类面前炫耀啦！"
                }
            ]
        },
        {
            "id": "7401012",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "740101201",
                    "speaker": "Player",
                    "text": "就送须弥蔷薇吧。"
                },
                {
                    "id": "740101202",
                    "speaker": "派蒙",
                    "text": "嗯，就送这个吧！这可是在枫丹少见的花朵，柯莎这下可以在人类面前炫耀啦！"
                }
            ]
        },
        {
            "id": "7401016",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "740101601",
                    "speaker": "柯莎",
                    "text": "原来风车菊是一种金灿灿的花，很温暖，很耀眼。"
                },
                {
                    "id": "740101602",
                    "speaker": "柯莎",
                    "text": "而且就像派蒙说的一样，会骨碌骨碌转圈圈！哎呀，看得久了，还有点灼眼睛呢…"
                },
                {
                    "id": "740101603",
                    "speaker": "派蒙",
                    "text": "金灿灿的…还会灼眼睛？"
                },
                {
                    "id": "740101604",
                    "speaker": "柯莎",
                    "text": "风车菊这么亮，「风车」一定也很亮，人们把它装在房子上，大概是用来做灯光。"
                },
                {
                    "id": "740101605",
                    "speaker": "派蒙",
                    "text": "…风车不是用来干这个的啦。"
                }
            ]
        },
        {
            "id": "7401017",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "740101701",
                    "speaker": "柯莎",
                    "text": "原来霓裳花是像水珠一样的花朵，晶莹剔透。"
                },
                {
                    "id": "740101702",
                    "speaker": "派蒙",
                    "text": "欸，霓裳花晶莹剔透？"
                },
                {
                    "id": "740101703",
                    "speaker": "柯莎",
                    "text": "把晶莹剔透的霓裳花穿在身上，就像披着瀑布，柯莎没见过这样的衣服。"
                },
                {
                    "id": "740101704",
                    "speaker": "派蒙",
                    "text": "我其实也没见过…"
                },
                {
                    "id": "740101705",
                    "speaker": "柯莎",
                    "text": "…对了，这就是人类的「时尚」！「时尚」就是越奇怪越好。"
                },
                {
                    "id": "740101706",
                    "speaker": "派蒙",
                    "text": "霓裳花不是这样用的，时尚也不是这种东西啦…大概不是吧？"
                }
            ]
        },
        {
            "id": "7401018",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "740101801",
                    "speaker": "柯莎",
                    "text": "这就是，能振动的花儿…"
                },
                {
                    "id": "740101802",
                    "speaker": "派蒙",
                    "text": "果然，在不打雷的洞窟里面，鸣草的振动很微弱，几乎看不出来呢。"
                },
                {
                    "id": "740101803",
                    "speaker": "柯莎",
                    "text": "…真的很难看出来，不过，振动发出的声音很好听！"
                },
                {
                    "id": "740101804",
                    "speaker": "派蒙",
                    "text": "鸣草的振动…发出的声音好听？我怎么听不见啊…"
                },
                {
                    "id": "740101805",
                    "speaker": "柯莎",
                    "text": "…清脆悦耳，怎么也听不够。这么美丽的花朵，振动的响声也这么惹人喜爱…"
                },
                {
                    "id": "740101806",
                    "speaker": "派蒙",
                    "text": "奇怪，看她那么陶醉，好像真的能听到鸣草振动的声音…"
                },
                {
                    "id": "740101807",
                    "speaker": "柯莎",
                    "text": "…对了，如果打「雷」，鸣草就会振动得更厉害，悦耳的声音就会更响吧？"
                },
                {
                    "id": "740101808",
                    "speaker": "柯莎",
                    "text": "一定是这样…花儿都要打肥料，鸣草也一样。那么「雷」这种肥料哪里买得到？"
                },
                {
                    "id": "740101809",
                    "speaker": "派蒙",
                    "text": "从雷电将军那里？…不对，「雷」可不是肥料啦！"
                }
            ]
        },
        {
            "id": "7401019",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "740101901",
                    "speaker": "派蒙",
                    "text": "闻着须弥蔷薇的香气，总会忍不住想起用它做的美味料理呢！蔷薇奶糊啦，枣椰蜜糖啦，还有兰巴德鱼卷…"
                },
                {
                    "id": "740101902",
                    "speaker": "柯莎",
                    "text": "这就是派蒙爱吃的须弥蔷薇…嗯，有许多的花瓣，也有许多种颜色呢。"
                },
                {
                    "id": "740101903",
                    "speaker": "派蒙",
                    "text": "欸，须弥蔷薇…有许多种颜色？"
                },
                {
                    "id": "740101904",
                    "speaker": "柯莎",
                    "text": "对呀，各色的花瓣凑成了花朵，晃动起来还会变色…"
                },
                {
                    "id": "740101905",
                    "speaker": "派蒙",
                    "text": "还…还会变色？"
                },
                {
                    "id": "740101906",
                    "speaker": "柯莎",
                    "text": "原来是这样，放入须弥蔷薇，料理也会变得五彩缤纷，也会变色了！样子这么美丽，难怪派蒙会喜欢。"
                },
                {
                    "id": "740101907",
                    "speaker": "派蒙",
                    "text": "料理看上去五彩缤纷会变色…这应该是吃了毒蘑菇才会出现的症状吧…"
                }
            ]
        },
        {
            "id": "7401023",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "740102301",
                    "speaker": "柯莎",
                    "text": "#异国的花，异国的花~派蒙和{NICKNAME}带来了吗？",
                    "choices": [
                        {
                            "id": "740102304",
                            "text": "（把异国的花交给柯莎试试吧。）"
                        },
                        {
                            "id": "740102302",
                            "text": "还没有。",
                            "response": [
