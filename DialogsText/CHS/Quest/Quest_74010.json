    "talks": [
        {
            "id": "7401016",
            "objective": "（隐藏）柯莎开场白$HIDDEN",
            "dialogues": [
                {
                    "id": "740100801",
                    "speaker": "柯莎",
                    "text": "啊，是外面的人。欢、欢迎你们，可是…可是我现在没有花可以送给你们。"
                },
                {
                    "id": "740100802",
                    "speaker": "派蒙",
                    "text": "送花？也不用这么隆重吧。"
                },
                {
                    "id": "740100803",
                    "speaker": "柯莎",
                    "text": "好吧，那柯莎只能很热情很热情地欢迎你们来到海沫村了，欢迎！"
                },
                {
                    "id": "740100804",
                    "speaker": "Player",
                    "text": "谢谢你，柯莎！"
                },
                {
                    "id": "740100805",
                    "speaker": "柯莎",
                    "text": "嗯，柯莎很热情，所以你们有什么想知道的，柯莎都愿意告诉你们。"
                },
                {
                    "id": "740100806",
                    "speaker": "派蒙",
                    "text": "那太好啦，柯莎可以简单介绍一下海沫村吗？"
                },
                {
                    "id": "740100807",
                    "speaker": "柯莎",
                    "text": "当然可以。海沫村是很多美露莘的家，嗯…在这里还看不到，再往前走一点就能看到了。"
                },
                {
                    "id": "740100808",
                    "speaker": "柯莎",
                    "text": "大家都是很好的美露莘，如果你们也是很好的人的话，大家也会欢迎你们的！",
                    "choices": [
                        {
                            "id": "740100809",
                            "text": "我是好人。",
                            "response": [
                                {
                                    "id": "740100810",
                                    "speaker": "派蒙",
                                    "text": "那我也是！"
                                },
                                {
                                    "id": "740100811",
                                    "speaker": "柯莎",
                                    "text": "嗯！那就好。"
                                },
                                {
                                    "id": "740100818",
                                    "speaker": "柯莎",
                                    "text": "接下来应该说什么呢？柯莎想不起来了…但是记得结尾应该是：「祝你们在海沫村度过愉快的时光！」"
                                },
                                {
                                    "id": "740100819",
                                    "speaker": "派蒙",
                                    "text": "#好喔！{NICKNAME}，不如我们去看看？就暂时先跟柯莎道别吧。"
                                },
                                {
                                    "id": "740100820",
                                    "speaker": "柯莎",
                                    "text": "再见！希望你们下次来的时候，柯莎已经准备好了花。"
                                }
                            ]
                        },
                        {
                            "id": "740100812",
                            "text": "很难说完全没做过坏事…",
                            "response": [
                                {
                                    "id": "740100813",
                                    "speaker": "柯莎",
                                    "text": "啊！怎么会这样…得去告诉在逐影庭工作的伙伴…"
                                },
                                {
                                    "id": "740100814",
                                    "speaker": "派蒙",
                                    "text": "#呜哇！{NICKNAME}只是在开玩笑的！我们没做过要被逐影庭盯上的坏事！"
                                },
                                {
                                    "id": "740100815",
                                    "speaker": "柯莎",
                                    "text": "…真的吗？"
                                },
                                {
                                    "id": "740100816",
                                    "speaker": "派蒙",
                                    "text": "真的！当然是真的！"
                                },
                                {
                                    "id": "740100817",
                                    "speaker": "柯莎",
                                    "text": "好吧，柯莎相信你们。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7401001",
            "objective": "(隐藏)与柯莎对话$HIDDEN",
            "dialogues": [
                {
                    "id": "740101301",
                    "speaker": "柯莎",
                    "text": "能在人类面前炫耀的花朵…真是做梦也想不到的好事！",
                    "choices": [
                        {
                            "id": "740101302",
                            "text": "能实现你的愿望就好了。",
                            "response": [
                                {
                                    "id": "740101303",
                                    "speaker": "柯莎",
                                    "text": "#{NICKNAME}和派蒙真是好心！柯莎感谢你们的帮助，一定会报答你们。"
                                }
                            ]
                        },
                        {
                            "id": "740101304",
                            "text": "就当是替派蒙赔礼了。",
                            "response": [
                                {
                                    "id": "740101305",
                                    "speaker": "柯莎",
                                    "text": "#没关系，柯莎已经不在意了。柯莎想请{NICKNAME}和派蒙带来异国的花，带来漂亮的花圃！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7401002",
            "objective": "将异国的花交给柯莎$HIDDEN",
            "dialogues": [
                {
                    "id": "740100201",
                    "speaker": "Player",
                    "text": "比如说风车菊。"
                },
                {
                    "id": "740100202",
                    "speaker": "派蒙",
                    "text": "对呀，风车菊生长在野外，是一种顽强的花朵呢，或许也能在这里成活。"
                },
                {
                    "id": "740100203",
                    "speaker": "柯莎",
                    "text": "「蜂车菊」，陌生的名字呢…是吸引很多蜜蜂的花？"
                },
                {
                    "id": "740100204",
                    "speaker": "派蒙",
                    "text": "和蜜蜂没关系啦…「风车」是种装在房子上的东西，有许多花瓣一样的叶片，被风一吹就会骨碌骨碌转圈圈~"
                },
                {
                    "id": "740100205",
                    "speaker": "派蒙",
                    "text": "风车菊就像风车，也能迎风旋转哦。"
                },
                {
                    "id": "740100206",
                    "speaker": "柯莎",
                    "text": "骨碌骨碌转圈圈？…好奇妙！真想现在就能看到。"
                }
            ]
        },
        {
            "id": "7401006",
            "objective": "(test)(隐藏)提交蒙德的花$HIDDEN",
            "dialogues": [
                {
                    "id": "740100601",
                    "speaker": "Player",
                    "text": "（就先介绍这么多吧。）"
                },
                {
                    "id": "740100602",
                    "speaker": "派蒙",
                    "text": "哼哼，既然柯莎这么好奇，不如我们来帮你找一些异国的花吧！"
                },
                {
                    "id": "740100603",
                    "speaker": "柯莎",
                    "text": "真的吗？那可不可以把这几种全都…唔，不对不对，柯莎要做认真负责的花匠，先照顾好一种。"
                },
                {
                    "id": "740100604",
                    "speaker": "柯莎",
                    "text": "#{NICKNAME}……愿意帮柯莎，带来哪种花朵呢？"
                }
            ]
        },
        {
            "id": "7401011",
            "objective": "(test)(隐藏)蒙德的花提交后$HIDDEN",
            "dialogues": [
                {
                    "id": "740102701",
                    "speaker": "柯莎",
                    "text": "异国的花，异国的花~这就把它栽下。"
                }
            ]
        },
        {
