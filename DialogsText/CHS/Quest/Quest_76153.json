    "talks": [
        {
            "id": "7615301",
            "objective": "与萨维特对话",
            "dialogues": [
                {
                    "id": "761530101",
                    "speaker": "萨维特",
                    "text": "出版业也不挣钱哪，要不干脆只做投资算了…"
                },
                {
                    "id": "761530102",
                    "speaker": "Player",
                    "text": "想看看投资券…"
                },
                {
                    "id": "761530103",
                    "speaker": "萨维特",
                    "text": "好嘞，投资券2000摩拉一张，每周结算一次，嘿嘿，这小袋子里…"
                },
                {
                    "id": "761530104",
                    "speaker": "萨维特",
                    "text": "…呃！"
                },
                {
                    "id": "761530105",
                    "speaker": "Player",
                    "text": "怎么了？"
                },
                {
                    "id": "761530106",
                    "speaker": "萨维特",
                    "text": "雅珂达，你怎么来了，是奈芙尔老板有什么…"
                },
                {
                    "id": "761530107",
                    "speaker": "雅珂达",
                    "text": "没有，我就是陪着我的朋友来这里随便逛逛。"
                },
                {
                    "id": "761530108",
                    "speaker": "雅珂达",
                    "text": "嘿嘿，看来萨维特老板的投资生意确实做得很好啊。"
                },
                {
                    "id": "761530109",
                    "speaker": "萨维特",
                    "text": "一般！一般，哈哈哈…小本生意，糊口罢了。"
                },
                {
                    "id": "761530110",
                    "speaker": "萨维特",
                    "text": "（这丫头…话里有话！肯定是奈芙尔派她过来的…嘁。）"
                },
                {
                    "id": "761530111",
                    "speaker": "Player",
                    "text": "这真的能赚钱吗？"
                },
                {
                    "id": "761530112",
                    "speaker": "雅珂达",
                    "text": "当然啦，老板说了，萨维特老板可是最最有声望，最最有能力的商人。跟着他投资，准没错。"
                },
                {
                    "id": "761530113",
                    "speaker": "萨维特",
                    "text": "是…是…哈哈哈…"
                },
                {
                    "id": "761530114",
                    "speaker": "萨维特",
                    "text": "（果然是奈芙尔…！）"
                },
                {
                    "id": "761530115",
                    "speaker": "Player",
                    "text": "那什么时候能结算投资…"
                },
                {
                    "id": "761530116",
                    "speaker": "萨维特",
                    "text": "今天！就在今天，您刚才买的是我们刚刚推出的…短线投资券！盈亏立即结算！"
                },
                {
                    "id": "761530117",
                    "speaker": "派蒙",
                    "text": "怎么感觉这些话都是你刚刚才编出来的…"
                },
                {
                    "id": "761530118",
                    "speaker": "萨维特",
                    "text": "呃…总、总之，感谢您购买短线投资券！"
                },
                {
                    "id": "761530119",
                    "speaker": "萨维特",
                    "text": "这是您的投资回报，祝您拥有美好的一天！",
                    "choices": [
                        {
                            "id": "761530120",
                            "text": "总之赚钱是好事啦…",
                            "response": [
                                {
                                    "id": "761530122",
                                    "speaker": "派蒙",
                                    "text": "真的？嘿嘿嘿，那你给我买一个小鸟形状的，我就喜欢那样的！"
                                },
                                {
                                    "id": "761530123",
                                    "speaker": "雅珂达",
                                    "text": "欸，我和你们一起去，给老板也带一个回去。"
                                },
                                {
                                    "id": "761530124",
                                    "speaker": "萨维特",
                                    "text": "雅…雅珂达小姐，稍等！"
                                },
                                {
                                    "id": "761530125",
                                    "speaker": "萨维特",
                                    "text": "…那个，奈芙尔老板是否交代您了什么…"
                                },
                                {
                                    "id": "761530126",
                                    "speaker": "雅珂达",
                                    "text": "啊。老板说：「东西已经找到了。」"
                                },
                                {
                                    "id": "761530127",
                                    "speaker": "雅珂达",
                                    "text": "「萨维特先生，不要心急。事情，要一步一步地做才稳当。」"
                                },
                                {
                                    "id": "761530128",
                                    "speaker": "萨维特",
                                    "text": "是、是，奈芙尔老板说的是…那就麻烦了，我就指望二位了…"
                                }
                            ]
                        },
                        {
                            "id": "761530121",
                            "text": "走，派蒙，我们去买糖雕吃。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7615302",
