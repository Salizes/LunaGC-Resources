    "talks": [
        {
            "id": "7904601",
            "objective": "聆听剧目告示",
            "dialogues": [
                {
                    "id": "790460101",
                    "speaker": "乐园告示喇叭",
                    "text": "参演人员已就位，所有机关运转正常。"
                },
                {
                    "id": "790460102",
                    "speaker": "乐园告示喇叭",
                    "text": "「黛依阿的三日遐想」之「瞳孔里的固形魔咒」，正式开幕…"
                },
                {
                    "id": "790460103",
                    "speaker": "来自喇叭的旁白",
                    "text": "在幽深诡异的密林边缘，两位兼具学识与胆量的智者，发现了一位落单的水形幻灵…"
                },
                {
                    "id": "790460104",
                    "speaker": "落单的水形幻灵",
                    "text": "谁来帮帮我…我不想抛弃我的伙伴…"
                },
                {
                    "id": "790460105",
                    "speaker": "派蒙",
                    "text": "「小水珠」？「小水珠」居然说话了！",
                    "choices": [
                        {
                            "id": "790460106",
                            "text": "其实是喇叭在代它说话吧。",
                            "response": [
                                {
                                    "id": "790460108",
                                    "speaker": "派蒙",
                                    "text": "原来如此，这位「小水珠」就是话剧里的关键演员了，要和我们配合？"
                                },
                                {
                                    "id": "790460109",
                                    "speaker": "来自喇叭的旁白",
                                    "text": "真是万幸，两位智者对于水形幻灵的言语早有研究，听懂了水形幻灵的求助。"
                                },
                                {
                                    "id": "790460110",
                                    "speaker": "来自喇叭的旁白",
                                    "text": "这简直是命运的安排！如此令人感动的相逢，岂有不帮水形幻灵的道理？"
                                },
                                {
                                    "id": "790460111",
                                    "speaker": "派蒙",
                                    "text": "我们也有新的设定吗？听起来蛮厉害的！",
                                    "choices": [
                                        {
                                            "id": "790460112",
                                            "text": "还是言归正传吧。",
                                            "response": [
                                                {
                                                    "id": "790460114",
                                                    "speaker": "落单的水形幻灵",
                                                    "text": "我们…我们在森林里迷路时，找到了一座古堡，不小心吵醒了古堡里的幽魂…"
                                                },
                                                {
                                                    "id": "790460115",
                                                    "speaker": "落单的水形幻灵",
                                                    "text": "两个幽魂头领对我们降下了…魔咒，只要被幽魂们看见，就会变成石头！"
                                                },
                                                {
                                                    "id": "790460116",
                                                    "speaker": "落单的水形幻灵",
                                                    "text": "我好不容易才逃出来，但其他同伴都…"
                                                },
                                                {
                                                    "id": "790460117",
                                                    "speaker": "落单的水形幻灵",
                                                    "text": "呜…他们一定很痛苦…这是我们的错吗？"
                                                },
                                                {
                                                    "id": "790460118",
                                                    "speaker": "派蒙",
                                                    "text": "当然不是了，就算有起床气，也不能这样欺负人家吧！"
                                                },
                                                {
                                                    "id": "790460119",
                                                    "speaker": "派蒙",
                                                    "text": "可恶…把迷路的「小水珠」变成石头这种事，已经不是欺负的程度了，那些幽魂都是超级坏家伙！",
                                                    "choices": [
                                                        {
                                                            "id": "790460120",
                                                            "text": "把它们狠狠修理一顿的话…",
                                                            "response": [
                                                                {
                                                                    "id": "790460122",
                                                                    "speaker": "落单的水形幻灵",
                                                                    "text": "不行的，两个幽魂头领从来不露面，古堡又很大，本领再强的人都没法找到它们…"
                                                                },
                                                                {
                                                                    "id": "790460123",
                                                                    "speaker": "落单的水形幻灵",
                                                                    "text": "但我听其中一个幽魂说，古堡深处的宝箱里，有着破除魔咒的古老药剂，那是唯一的希望…"
                                                                },
                                                                {
                                                                    "id": "790460124",
                                                                    "speaker": "落单的水形幻灵",
                                                                    "text": "宝箱被锁在一间密室里，还需要找到附近的钥匙。"
                                                                },
                                                                {
                                                                    "id": "790460125",
                                                                    "speaker": "落单的水形幻灵",
                                                                    "text": "可是，我已经中了魔咒，独自回到古堡的话，肯定会被其他幽魂盯上，慢慢石化，最后永远被固定住…"
                                                                },
                                                                {
                                                                    "id": "790460126",
                                                                    "speaker": "派蒙",
                                                                    "text": "那也没什么难的嘛！就由我们来护送你，回到古堡里去寻找钥匙，拿到最关键的药剂。"
                                                                },
                                                                {
                                                                    "id": "790460127",
                                                                    "speaker": "派蒙",
                                                                    "text": "只要帮你避开那些什么…幽魂的视线，应该就没问题了吧？听起来不算难嘛！"
                                                                },
                                                                {
                                                                    "id": "790460128",
                                                                    "speaker": "落单的水形幻灵",
                                                                    "text": "没错，你们是…智者，你们应该有办法…求求你们了…",
                                                                    "choices": [
                                                                        {
                                                                            "id": "790460129",
                                                                            "text": "派蒙很快就进入了角色嘛。",
                                                                            "response": [
                                                                                {
                                                                                    "id": "790460131",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "嘿嘿，听起来还挺简单的。"
                                                                                },
                                                                                {
                                                                                    "id": "790460132",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "虽然不能把幕后黑手揍一顿，但你可以打趴所有幽魂，帮「小水珠」救出同伴还不是轻轻松松！"
                                                                                },
                                                                                {
                                                                                    "id": "790460133",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "放心吧，「小水珠」，我们一起出发，找到那个药剂，解除你身上的魔咒，救出你的伙伴！"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "790460130",
                                                                            "text": "准确猜到了剧情的走向哦。"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "790460121",
                                                            "text": "是不是就能救出你的同伴？"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "790460113",
                                            "text": "你的同伴怎么了？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "790460107",
                            "text": "当成「小水珠」的台词就行。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7904602",
            "objective": "前往「古堡」",
            "dialogues": []
        },
        {
            "id": "7904605",
            "objective": "乘坐「呼呼飞车」前往古堡",
            "dialogues": []
        },
        {
            "id": "7904606",
            "objective": "乘坐「呼呼飞车」前往古堡",
            "dialogues": []
        },
        {
            "id": "7904603",
            "objective": "跟随「落单的水形幻灵」",
            "dialogues": []
        },
        {
            "id": "7904607",
            "objective": "使用「聚流映灯」取得钥匙",
            "dialogues": []
        },
        {
            "id": "7904610",
            "objective": "设法应对幽魂的诡计",
            "dialogues": [
                {
                    "id": "790461001",
                    "speaker": "派蒙",
                    "text": "可恶，根本不可能躲开这一大片视线，这是耍赖，耍赖！"
                },
                {
                    "id": "790461002",
                    "speaker": "派蒙",
                    "text": "好想把那些幽魂的机关一脚踢翻！"
                },
                {
                    "id": "790461003",
                    "speaker": "派蒙",
                    "text": "等等，「小水珠」，你要干什么？那边是幽魂的视野，危险！"
                },
                {
                    "id": "790461004",
                    "speaker": "愤怒的幽魂头领",
                    "text": "吵闹的家伙，你疯了吗？还是你已经放弃希望了，想要和你的同伴在另一个世界相见？"
                },
                {
                    "id": "790461005",
                    "speaker": "愉悦的幽魂头领",
                    "text": "不对，它要用身体遮挡视线…怎么会有这么古典的献身思想！"
                },
                {
                    "id": "790461006",
                    "speaker": "来自喇叭的旁白",
                    "text": "事态出现了转机！落单的水形幻灵拦在了幽魂前方，慢慢化为了石像，用自己的身体挡住了致命的视线！"
                },
                {
                    "id": "790461007",
                    "speaker": "派蒙",
                    "text": "「小水珠」…主动变成石头了…全都是为了让我们拿到钥匙…",
                    "choices": [
                        {
                            "id": "790461008",
                            "text": "「小水珠」还能恢复！",
                            "response": [
                                {
                                    "id": "790461010",
                                    "speaker": "派蒙",
                                    "text": "对，对哦！只要被幽魂盯住的时间不长，应该没有问题的！"
                                },
                                {
                                    "id": "790461011",
                                    "speaker": "派蒙",
                                    "text": "难道「小水珠」反过来利用了这一点？好聪明，好勇敢！"
                                },
                                {
                                    "id": "790461012",
                                    "speaker": "派蒙",
                                    "text": "#{NICKNAME}，我们赶快去找钥匙，拿回解药，不要让「小水珠」难受太久！"
                                }
                            ]
                        },
                        {
                            "id": "790461009",
                            "text": "我们要抓紧时间！"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7904611",
            "objective": "使用「聚流映灯」取得钥匙",
            "dialogues": [
                {
                    "id": "790461101",
                    "speaker": "Black Screen",
                    "text": "来自喇叭的旁白继续描述着眼前的神奇景象——\\n两位智者将药剂轻轻滴在水形幻灵的石像上，奇妙的现象发生了…\\n时间仿佛发生了倒转，石化的水形幻灵恢复如初…"
                },
                {
                    "id": "790461102",
                    "speaker": "落单的水形幻灵",
                    "text": "呜…原来彻底变成石头是这样的感觉…好难受好难受，不能让同伴们继续忍受这种委屈了。"
                },
                {
                    "id": "790461103",
                    "speaker": "派蒙",
                    "text": "「小水珠」，你怎么一声不吭就冲了上去，吓死我了啦！还好我们马上就拿到了解药…"
                },
                {
                    "id": "790461104",
                    "speaker": "落单的水形幻灵",
                    "text": "刚才那些幽魂一直在怪叫，我好害怕，完全不敢说话…"
                },
                {
                    "id": "790461105",
                    "speaker": "落单的水形幻灵",
                    "text": "而且你们是智者，我觉得，根本不用我来提醒你们。"
                },
                {
                    "id": "790461106",
                    "speaker": "落单的水形幻灵",
                    "text": "就算我彻底变成了石头，拿到解药后，你们也会第一时间救我的，和之前没什么区别，不用这么焦急！"
                },
                {
                    "id": "790461107",
                    "speaker": "派蒙",
                    "text": "呃啊…难道，难道是我太投入了吗？只顾着担心「小水珠」了…",
                    "choices": [
                        {
                            "id": "790461108",
                            "text": "投入也是好事哦。",
                            "response": [
                                {
                                    "id": "790461110",
                                    "speaker": "派蒙",
                                    "text": "噫！明明是来玩的游客，自己却演上头了，有点难为情…"
                                },
                                {
                                    "id": "790461111",
                                    "speaker": "派蒙",
                                    "text": "总之…我们已经成功了，接下来，你就拿着这份解药，去拯救你的同伴吧！"
                                },
                                {
                                    "id": "790461112",
                                    "speaker": "落单的水形幻灵",
                                    "text": "谢谢，太谢谢你们了，我…无比感激你们！"
                                },
                                {
                                    "id": "790461113",
                                    "speaker": "落单的水形幻灵",
                                    "text": "我和伙伴们会一直牢记你们的恩情的！",
                                    "choices": [
                                        {
                                            "id": "790461114",
                                            "text": "没事没事！",
                                            "response": [
                                                {
                                                    "id": "790461116",
                                                    "speaker": "派蒙",
                                                    "text": "也不知道那些坏家伙会不会继续捣乱…"
                                                },
                                                {
                                                    "id": "790461117",
                                                    "speaker": "派蒙",
                                                    "text": "你们以后在森林里玩的时候，还要小心一点，不要再到这个古堡来了哦！"
                                                },
                                                {
                                                    "id": "790461118",
                                                    "speaker": "来自喇叭的旁白",
                                                    "text": "可喜可贺，可喜可贺！两位智者无懈可击的计策与水形幻灵的勇气形成了完美的配合，幽魂魔咒的危机即将被彻底解除！"
                                                },
                                                {
                                                    "id": "790461119",
                                                    "speaker": "来自喇叭的旁白",
                                                    "text": "智者们的到来让幽魂们不敢再肆意妄为，落单的水形幻灵和伙伴们又可以无忧无虑地玩耍了。"
                                                },
                                                {
                                                    "id": "790461120",
                                                    "speaker": "来自喇叭的旁白",
                                                    "text": "原本阴森诡异的密林，渐渐展现出了寂静与祥和的一面…"
                                                },
                                                {
                                                    "id": "790461121",
                                                    "speaker": "来自喇叭的旁白",
                                                    "text": "「瞳孔里的固形魔咒」全剧终，感谢您的观看！"
                                                },
                                                {
                                                    "id": "790461122",
                                                    "speaker": "派蒙",
                                                    "text": "好了，我们完成了「瞳孔里的固形魔咒」！代入感还不错嘛！"
                                                },
                                                {
                                                    "id": "790461123",
                                                    "speaker": "派蒙",
                                                    "text": "这样看来，如果台词和旁白合适，确实能影响观众的情绪呢…黛依阿究竟是从哪些地方学到的这些手法？"
                                                },
                                                {
                                                    "id": "790461124",
                                                    "speaker": "派蒙",
                                                    "text": "如果有机会见到黛依阿，我们仔细问问她吧！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "790461115",
                                            "text": "不用客气！"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "790461109",
                            "text": "说明派蒙很享受！"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7904608",
            "objective": "开启密室，取得解药",
            "dialogues": []
        },
        {
            "id": "7904604",
            "objective": "开启密室，取得解药",
            "dialogues": []
        },
        {
            "id": "7904609",
            "objective": "解救落单的水形幻灵",
            "dialogues": [
                {
                    "id": "790460901",
                    "speaker": "派蒙",
                    "text": "「小水珠」变成不能动的石头了，还能喝下解药吗？而且，水要怎么喝水…"
                },
                {
                    "id": "790460902",
                    "speaker": "派蒙",
                    "text": "难道说，这种药剂是外用的？我们快试试看！"
                }
            ]
        },
        {
            "id": "7904612",
            "objective": "解救落单的水形幻灵",
            "dialogues": []
        },
        {
            "id": "7904612",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "790461201",
                    "speaker": "落单的水形幻灵",
                    "text": "通过那部机关，就有可能找到密室的钥匙…拜托你们两位了！"
                }
            ]
        },
        {
            "id": "7904613",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "790461301",
                    "speaker": "来自喇叭的旁白",
                    "text": "两位智者注视着眼前的水形幻灵，可惜它已变成了冰冷的石像，不会再回应智者们的呼唤…"
                },
                {
                    "id": "790461302",
                    "speaker": "来自喇叭的旁白",
                    "text": "但这一切努力不会白费，它会这样主动冒险，当然是因为深信着两位智者！"
                }
            ]
        }
    ]
}