            "dialogues": []
        },
        {
            "id": "7468201",
            "objective": "前往「千年珍珠骏麟王庭」",
            "dialogues": [
                {
                    "id": "746820101",
                    "speaker": "兰吉特",
                    "text": "终于还是走到了今天这一步啊…"
                },
                {
                    "id": "746820102",
                    "speaker": "Player",
                    "text": "儿时的梦想呢？"
                },
                {
                    "id": "746820103",
                    "speaker": "兰吉特",
                    "text": "长大成人之后，终于理解了当年巡林官面露难色的理由…"
                },
                {
                    "id": "746820104",
                    "speaker": "兰吉特",
                    "text": "咳，不管怎么说，至少尝试过了。"
                },
                {
                    "id": "746820105",
                    "speaker": "兰吉特",
                    "text": "而且也知道了不该带着未经处理的爆炎树果实接近翠翎恐蕈…"
                },
                {
                    "id": "746820106",
                    "speaker": "兰吉特",
                    "text": "闻到枯焦味道的时候已经晚了，差点被它散播的孢子淹没。"
                },
                {
                    "id": "746820107",
                    "speaker": "兰吉特",
                    "text": "常常会忘记蕈兽毕竟不是蕈猪，是完全不同的物种呢。"
                },
                {
                    "id": "746820108",
                    "speaker": "派蒙",
                    "text": "对哦，说起来，蕈兽应该算是菌类吧？"
                },
                {
                    "id": "746820109",
                    "speaker": "兰吉特",
                    "text": "是啊，炖汤的话特别鲜美。"
                },
                {
                    "id": "746820110",
                    "speaker": "派蒙",
                    "text": "呃，要不我们还是说回今天的挑战对象吧。"
                },
                {
                    "id": "746820111",
                    "speaker": "兰吉特",
                    "text": "我还没想好怎么料理…哦！你是在说「交涉」，抱歉。"
                },
                {
                    "id": "746820112",
                    "speaker": "兰吉特",
                    "text": "不知道两位听说过原海异种的两位霸主的故事没有，故事里形容千年珍珠骏麟都是用的孤傲、高洁这样的词。"
                },
                {
                    "id": "746820113",
                    "speaker": "兰吉特",
                    "text": "相比之下，铁甲熔火帝皇听起来就像是什么不好惹的狠角色，强大但是暴戾。"
                },
                {
                    "id": "746820114",
                    "speaker": "派蒙",
                    "text": "我还以为你会选听起来更强的那个挑战呢，毕竟之前也说过既然要讲故事，对手当然是越强越好。"
                },
                {
                    "id": "746820115",
                    "speaker": "兰吉特",
                    "text": "铁甲熔火帝皇确实很强，可那毕竟是重甲蟹…相比之下，千年珍珠骏麟可是能飞的海马！",
                    "choices": [
                        {
                            "id": "746820116",
                            "text": "能飞的海马是不是应该叫天马？",
                            "response": [
                                {
                                    "id": "746820117",
                                    "speaker": "派蒙",
                                    "text": "你在意的居然是这个问题吗？"
                                },
                                {
                                    "id": "746820119",
                                    "speaker": "兰吉特",
                                    "text": "不管怎么说，只要让我骑乘哪怕一次…"
                                },
                                {
                                    "id": "746820120",
                                    "speaker": "派蒙",
                                    "text": "好吧，看来你是要坚持到底了。"
                                },
                                {
                                    "id": "746820121",
                                    "speaker": "兰吉特",
                                    "text": "来都来了，总不能无功而返！准备好了的话，我们这就出发吧。",
                                    "choices": [
                                        {
                                            "id": "746820122",
                                            "text": "准备好了。"
                                        },
                                        {
                                            "id": "746820123",
                                            "text": "还有别的事，稍候。",
                                            "response": [
                                                {
                                                    "id": "746820124",
                                                    "speaker": "兰吉特",
                                                    "text": "没问题，我就在这儿等你。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "746820118",
                            "text": "对我来说都没有区别…"
                        }
                    ]
                }
            ]
        }
    ]
}