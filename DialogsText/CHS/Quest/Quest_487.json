        {
            "id": "48712",
            "objective": "(test)与玛格丽特对话，完成委托$HIDDEN",
            "dialogues": [
                {
                    "id": "4871201",
                    "speaker": "派蒙",
                    "text": "居然又让它跑掉了…唉…"
                },
                {
                    "id": "4871202",
                    "speaker": "派蒙",
                    "text": "欸？可是看它这次逃跑的方向…莫非是…"
                }
            ]
        },
        {
            "id": "48710",
            "objective": "完成玛格丽特的委托",
            "dialogues": [
                {
                    "id": "4871001",
                    "speaker": "玛格丽特",
                    "text": "「小王子」~！真是听话的宝贝，居然自己回来了。"
                }
            ]
        },
        {
            "id": "48703",
            "objective": "完成玛格丽特的委托",
            "dialogues": [
                {
                    "id": "4870301",
                    "speaker": "玛格丽特",
                    "text": "「小王子」~！你跑哪儿去了呀，终于回来了。"
                },
                {
                    "id": "4870302",
                    "speaker": "派蒙",
                    "text": "可让我们好找呢。"
                },
                {
                    "id": "4870303",
                    "speaker": "玛格丽特",
                    "text": "唉，「小王子」呀，你怎么忍心这样抛弃我呢…"
                },
                {
                    "id": "4870304",
                    "speaker": "派蒙",
                    "text": "已经进入「二人世界」了吗…"
                },
                {
                    "id": "4870305",
                    "speaker": "派蒙",
                    "text": "还有你的星铁弦在这儿哦，温迪。"
                },
                {
                    "id": "4870306",
                    "speaker": "温迪",
                    "text": "还真的被你们找到了，我原本都不怎么抱希望了。"
                },
                {
                    "id": "4870307",
                    "speaker": "温迪",
                    "text": "为了表示感谢，用这弦为你们办一场「专场演唱」都不过分呢…阿、阿…"
                },
                {
                    "id": "4870308",
                    "speaker": "派蒙",
                    "text": "阿？"
                },
                {
                    "id": "4870309",
                    "speaker": "温迪",
                    "text": "阿嚏——！"
                },
                {
                    "id": "4870310",
                    "speaker": "温迪",
                    "text": "咳咳…啊哈哈…离「小王子」这么近的话，我对猫过敏的体质果然又…"
                },
                {
                    "id": "4870311",
                    "speaker": "派蒙",
                    "text": "怪不得你没有自己去抓它…"
                },
                {
                    "id": "4870312",
                    "speaker": "温迪",
                    "text": "欸嘿，总之帮了大忙啦，那我先走啦…阿、阿嚏——"
                }
            ]
        },
