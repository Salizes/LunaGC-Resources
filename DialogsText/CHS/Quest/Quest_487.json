    "talks": [
        {
            "id": "48701",
            "objective": "与玛格丽特对话",
            "dialogues": [
                {
                    "id": "4870101",
                    "speaker": "温迪",
                    "text": "…原来那只猫是你家走丢的呀。"
                },
                {
                    "id": "4870102",
                    "speaker": "派蒙",
                    "text": "温迪！你也是来帮忙的吗？"
                },
                {
                    "id": "4870103",
                    "speaker": "温迪",
                    "text": "帮忙？我倒觉得，需要帮忙的其实是我…"
                },
                {
                    "id": "4870104",
                    "speaker": "派蒙",
                    "text": "咦？我看你刚才好像也在问玛格丽特小姐的「小王子」的事…"
                },
                {
                    "id": "4870105",
                    "speaker": "温迪",
                    "text": "哦，所以偷走我备用的<color=#00E1FFFF>星铁弦</color>的那只猫，名字叫「小王子」吗。"
                },
                {
                    "id": "4870106",
                    "speaker": "温迪",
                    "text": "虽说看到蒙德的生灵如此自由自在，是件好事…但未免也太为所欲为了吧。"
                },
                {
                    "id": "4870107",
                    "speaker": "玛格丽特",
                    "text": "啊哈哈，「小王子」就是这样调皮机灵的宝贝呢。"
                },
                {
                    "id": "4870108",
                    "speaker": "Player",
                    "text": "这就是喜欢放纵孩子的家长吧。"
                },
                {
                    "id": "4870109",
                    "speaker": "派蒙",
                    "text": "好像巴巴托斯一样呢。"
                },
                {
                    "id": "4870110",
                    "speaker": "温迪",
                    "text": "哈哈哈…真是巧妙的比喻，咳咳。还是先找到「小王子」再说吧。"
                },
                {
                    "id": "4870111",
                    "speaker": "温迪",
                    "text": "今晚我还有演出，拿不回备用弦的话，可就要让听众失望了。"
                },
                {
                    "id": "4870112",
                    "speaker": "派蒙",
                    "text": "话说猫咪为什么会去偷温迪的备用琴弦呢？"
                },
                {
                    "id": "4870113",
                    "speaker": "玛格丽特",
                    "text": "猫咪都喜欢玩毛线团的呀！"
                },
                {
                    "id": "4870114",
                    "speaker": "派蒙",
                    "text": "欸欸！？"
                },
                {
                    "id": "4870115",
                    "speaker": "温迪",
                    "text": "星铁做的琴弦蕴含着风的元素力，有超乎意料的韧性，所以平时我都卷成毛线团的样子带在身上啦。"
                },
                {
                    "id": "4870116",
                    "speaker": "温迪",
                    "text": "这可是吟游诗人的小秘密，哼哼。"
                },
                {
                    "id": "4870117",
                    "speaker": "派蒙",
                    "text": "咦？你说那弦上有风的元素力？"
                },
                {
                    "id": "4870118",
                    "speaker": "派蒙",
                    "text": "#那好，我们有线索啦！{NICKNAME}，快用<color=#00E1FFFF>「元素视野」</color>查看一下吧？"
                }
            ]
        },
        {
            "id": "48711",
            "objective": "找玛格丽特听取委托内容",
            "dialogues": [
                {
                    "id": "4871101",
                    "speaker": "玛格丽特",
                    "text": "你们刚才到哪里去了呀？"
                },
                {
                    "id": "4871102",
                    "speaker": "玛格丽特",
                    "text": "「小王子」应该就在城里的商业区和居民区附近，是一只纯黑色的猫哦。"
                }
            ]
        },
        {
            "id": "48702",
            "objective": "寻找「小王子」",
            "dialogues": [
                {
                    "id": "4870201",
                    "speaker": "小猫",
                    "text": "喵！"
                }
            ]
        },
        {
            "id": "48704",
            "objective": "(test)完成找猫猫$HIDDEN",
            "dialogues": [
                {
                    "id": "4870401",
                    "speaker": "玛格丽特",
                    "text": "「小王子」应该就在城里的商业区和居民区附近，是一只纯黑色的猫哦。"
                }
            ]
        },
        {
            "id": "48705",
            "objective": "(test)完成找猫猫$HIDDEN",
            "dialogues": [
                {
                    "id": "4870501",
                    "speaker": "派蒙",
                    "text": "还真是警觉呀，就这么让「小王子」跑掉了。"
                },
                {
                    "id": "4870502",
                    "speaker": "派蒙",
                    "text": "想办法<color=#00E1FFFF>从它身后接近</color>吧，最好蹲下来，好让脚步轻一些。"
                },
                {
                    "id": "4870503",
                    "speaker": "派蒙",
                    "text": "不会飞就是麻烦，嘿嘿。"
                },
                {
                    "id": "4870504",
                    "speaker": "派蒙",
                    "text": "如果不放心的话，不如先用<color=#00E1FFFF>鱼肉</color>来吸引「小王子」的注意，猫都喜欢吃鱼的吧？"
                },
                {
                    "id": "4870505",
                    "speaker": "派蒙",
                    "text": "<color=#00E1FFFF>鱼肉</color>没有了的话就去附近的湖里抓，快点行动吧~！"
                }
            ]
        },
        {
            "id": "48706",
