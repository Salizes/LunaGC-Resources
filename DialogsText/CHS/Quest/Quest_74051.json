    "talks": [
        {
            "id": "7405103",
            "objective": "",
            "dialogues": [
                {
                    "id": "740510201",
                    "speaker": "兴晔",
                    "text": "老板，这下可怎么办？映影没拍好，映影机还丢了…"
                },
                {
                    "id": "740510202",
                    "speaker": "邱老板",
                    "text": "行了，别唉声叹气的。咱们不是已经去冒险家协会挂过委托了吗？"
                },
                {
                    "id": "740510203",
                    "speaker": "邱老板",
                    "text": "为今之计，只有一个等字…"
                },
                {
                    "id": "740510204",
                    "speaker": "弈丰",
                    "text": "但是，咱们拍了一半的映影片还在机器里。"
                },
                {
                    "id": "740510205",
                    "speaker": "弈丰",
                    "text": "就算机器不容易坏，但要是那些片子被弄坏了…"
                },
                {
                    "id": "740510206",
                    "speaker": "邱老板",
                    "text": "这…",
                    "choices": [
                        {
                            "id": "740510207",
                            "text": "什么映影机？",
                            "response": [
                                {
                                    "id": "740510208",
                                    "speaker": "邱老板",
                                    "text": "瞧！这不就来了吗？我就说嘛，要沉下心来等！"
                                },
                                {
                                    "id": "740510221",
                                    "speaker": "弈丰",
                                    "text": "冒险家协会的效率，什么时候这么高了？"
                                },
                                {
                                    "id": "740510209",
                                    "speaker": "兴晔",
                                    "text": "唔，看来枫丹人办事也不都是磨磨蹭蹭的嘛。"
                                },
                                {
                                    "id": "740510210",
                                    "speaker": "邱老板",
                                    "text": "您好，您好，冒险家。您一定是接到了协会的委托，来帮助我们拿回映影机的吧？"
                                },
                                {
                                    "id": "740510211",
                                    "speaker": "邱老板",
                                    "text": "我们就是在那边被魔物袭击的，请您快点…",
                                    "choices": [
                                        {
                                            "id": "740510212",
                                            "text": "我什么委托也没接到啊。",
                                            "response": [
                                                {
                                                    "id": "740510214",
                                                    "speaker": "兴晔",
                                                    "text": "呃…"
                                                },
                                                {
                                                    "id": "740510215",
                                                    "speaker": "弈丰",
                                                    "text": "这…"
                                                },
                                                {
                                                    "id": "740510216",
                                                    "speaker": "邱老板",
                                                    "text": "没…关系！没关系，我就知道冒险家协会不靠谱…"
                                                },
                                                {
                                                    "id": "740510217",
                                                    "speaker": "邱老板",
                                                    "text": "冒险家，你现在愿意临时接受一个委托吗？报酬都好说。",
                                                    "choices": [
                                                        {
                                                            "id": "740510218",
                                                            "text": "倒是没问题…",
                                                            "response": [
                                                                {
                                                                    "id": "740510220",
                                                                    "speaker": "邱老板",
                                                                    "text": "好！太好了，请您快点去那边帮我们拿回映影机，拜托您了！"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "740510219",
                                                            "text": "报酬给足就行。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "740510213",
                                            "text": "我只是刚好路过这里而已。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "740510222",
                            "text": "发生什么了？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7405104",
            "objective": "打倒所有魔物，取回映影机",
            "dialogues": [
                {
                    "id": "740510401",
                    "speaker": "邱老板",
                    "text": "(test)原来他们三个来此之后不小心把装胶片的箱子掉到水里了，三个人都不会潜水。"
                },
                {
                    "id": "740510402",
                    "speaker": "兴晔",
                    "text": "(test)所以现在只能在这里干瞪眼了。拜托主角帮忙取回来。"
                }
            ]
        },
        {
            "id": "7405105",
            "objective": "与邱老板一行人对话",
            "dialogues": [
                {
                    "id": "740510301",
                    "speaker": "邱老板",
                    "text": "太好了，映影机完好无损，里面的映影也没有被破坏…"
                },
                {
                    "id": "740510328",
                    "speaker": "邱老板",
                    "text": "谢天谢地，我还以为又要从头开拍了。",
                    "choices": [
                        {
                            "id": "740510302",
                            "text": "你们为什么在这里拍映影？",
                            "response": [
                                {
                                    "id": "740510329",
                                    "speaker": "邱老板",
                                    "text": "这事情就说来话长了…"
                                },
                                {
                                    "id": "740510305",
                                    "speaker": "邱老板",
                                    "text": "庄里的人大部分都是做茶叶生意的，但我们…对茶叶生意没什么兴趣…"
                                },
                                {
                                    "id": "740510306",
                                    "speaker": "邱老板",
                                    "text": "所以就转了行，去帮庄里的茶叶商拍宣传用的记录映影。"
                                },
                                {
                                    "id": "740510307",
                                    "speaker": "弈丰",
                                    "text": "其实是做茶叶生意的人太多，我们原本的生意比不过他们啦。"
                                },
                                {
                                    "id": "740510308",
                                    "speaker": "兴晔",
                                    "text": "店里的好手也一个接一个地跑去别家干活，再做茶叶生意，我们就没饭吃了。"
                                },
                                {
                                    "id": "740510309",
                                    "speaker": "邱老板",
                                    "text": "你们两个…就不能说点好听的吗？！"
                                },
                                {
                                    "id": "740510310",
                                    "speaker": "邱老板",
                                    "text": "给庄里的茶叶拍宣传映影这件事，赚得也不少了。"
                                },
                                {
                                    "id": "740510311",
                                    "speaker": "弈丰",
                                    "text": "可是，最近庄里也有其他人开始拍宣传映影了啊。"
                                },
                                {
                                    "id": "740510312",
                                    "speaker": "兴晔",
                                    "text": "有的映影里还有人唱戏呢，派头可大了。"
                                },
                                {
                                    "id": "740510313",
                                    "speaker": "邱老板",
                                    "text": "所以我们才来枫丹，寻求映影专家的建议啊！"
                                },
                                {
                                    "id": "740510314",
                                    "speaker": "Player",
                                    "text": "所以，你们是来枫丹学拍摄映影的？"
                                },
                                {
                                    "id": "740510315",
                                    "speaker": "邱老板",
                                    "text": "没错。我们找到了一个名叫热塞尔的「映影专家」。"
                                },
                                {
                                    "id": "740510316",
                                    "speaker": "邱老板",
                                    "text": "他很擅长在映影中用光影来…那什么来着？"
                                },
                                {
                                    "id": "740510317",
                                    "speaker": "弈丰",
                                    "text": "「叙事」。"
                                },
                                {
                                    "id": "740510318",
                                    "speaker": "邱老板",
                                    "text": "对！用光影来「叙事」。"
                                },
                                {
                                    "id": "740510319",
                                    "speaker": "邱老板",
                                    "text": "有了热塞尔先生的指导，我们一定能拍出整个翘英庄里最好的映影！"
                                },
                                {
                                    "id": "740510320",
                                    "speaker": "兴晔",
                                    "text": "老板，你上个月才说要拍出整个璃月里最好的映影。"
                                },
                                {
                                    "id": "740510321",
                                    "speaker": "邱老板",
                                    "text": "做生意就是要合理地调整自己对未来的预期…你懂什么？"
                                },
                                {
                                    "id": "740510322",
                                    "speaker": "邱老板",
                                    "text": "总之，感谢您的帮忙，旅行者，这些钱请您收下。"
                                },
                                {
                                    "id": "740510323",
                                    "speaker": "邱老板",
                                    "text": "兴晔、弈丰，把东西赶紧架起来！今天必须把样片拍完，拿过去给热塞尔先生看。"
                                },
                                {
                                    "id": "740510324",
                                    "speaker": "邱老板",
                                    "text": "注意打光！镜头要…这么对着光源，打出一个…有高级质感的光线！"
                                },
                                {
                                    "id": "740510325",
                                    "speaker": "邱老板",
                                    "text": "你们都看过那本书了吧，光影要有质感，质感你们明白吗？"
                                },
                                {
                                    "id": "740510326",
                                    "speaker": "兴晔",
                                    "text": "老板，虽然热塞尔先生的那本书我们的确都看过了…"
                                },
                                {
                                    "id": "740510327",
                                    "speaker": "弈丰",
                                    "text": "但就凭这个镜头，就算我们再折腾，拍出来的光线质感也高级不到哪去啊…"
                                }
                            ]
                        },
                        {
                            "id": "740510303",
                            "text": "看起来你们也不是枫丹人。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7405106",
