    "talks": [
        {
            "id": "7614312",
            "objective": "跃入月心深坑",
            "dialogues": [
                {
                    "id": "761431201",
                    "speaker": "终端",
                    "text": "…因为无法准确定位坐标…不知需要多久…回讯才能抵达你…"
                },
                {
                    "id": "761431202",
                    "speaker": "终端",
                    "text": "…但我想要…在此时此刻…应答…"
                },
                {
                    "id": "761431203",
                    "speaker": "终端",
                    "text": "…我们是在宇宙间…孤独穿行许久的旅者…而你们的声音…就像黑暗森林中突然燃起的篝火…"
                },
                {
                    "id": "761431204",
                    "speaker": "终端",
                    "text": "…这很冒险…却又无畏…让我们感到振奋与温暖…"
                },
                {
                    "id": "761431205",
                    "speaker": "终端",
                    "text": "…我相信…这个时刻…是星海与命运的引力…将你我连接在一起…"
                },
                {
                    "id": "761431206",
                    "speaker": "终端",
                    "text": "…未来…我们会尝试…寻找你们…星球…但很遗憾不是现在…因为还有一些…的麻烦…"
                },
                {
                    "id": "761431207",
                    "speaker": "终端",
                    "text": "（…一阵干扰的杂音…）"
                },
                {
                    "id": "761431208",
                    "speaker": "终端",
                    "text": "#…{M#哥哥！好了吗？}{F#荧，怎么样了？}"
                },
                {
                    "id": "761431209",
                    "speaker": "终端",
                    "text": "#…{M#荧，马上来}{F#哥哥，马上好}…"
                },
                {
                    "id": "761431210",
                    "speaker": "终端",
                    "text": "（…一阵干扰的杂音…）"
                },
                {
                    "id": "761431211",
                    "speaker": "终端",
                    "text": "…那么…向你致意…"
                },
                {
                    "id": "761431212",
                    "speaker": "终端",
                    "text": "…就像你说的，星海广阔无垠，我们并不孤单…"
                },
                {
                    "id": "761431213",
                    "speaker": "终端",
                    "text": "…愿我们有天能在星空下再见…"
                }
            ]
        },
        {
            "id": "7614302",
            "objective": "穿越发射井",
            "dialogues": [
                {
                    "id": "761430201",
                    "speaker": "哥伦比娅",
                    "text": "我们下来了。"
                },
                {
                    "id": "761430202",
                    "speaker": "Player",
                    "text": "这里就是月心吗？"
                },
                {
                    "id": "761430203",
                    "speaker": "哥伦比娅",
                    "text": "不，月心还在前面。这次有你同行，我们就得用常规方法进入那里。"
                },
                {
                    "id": "761430204",
                    "speaker": "哥伦比娅",
                    "text": "至于这里…是那位漆黑龙王的杰作。"
                },
                {
                    "id": "761430205",
                    "speaker": "哥伦比娅",
                    "text": "他将月球改造成了可怕的武器，这里就是武器的发射井。"
                },
                {
                    "id": "761430206",
                    "speaker": "哥伦比娅",
                    "text": "而月心中的月亮本源力量，就成了射向提瓦特的炮火。"
                },
                {
                    "id": "761430207",
                    "speaker": "哥伦比娅",
                    "text": "不过，那位原初之主最终还是败于天理手中。现在这里已经不会再有威胁了。"
                },
                {
                    "id": "761430208",
                    "speaker": "哥伦比娅",
                    "text": "我们往前走吧。"
                }
            ]
        },
        {
            "id": "7614303",
            "objective": "通过正确的路前进",
            "dialogues": [
                {
                    "id": "761430301",
                    "speaker": "哥伦比娅",
                    "text": "这道门下面，就是我们要去的地方了。"
                },
                {
                    "id": "761430302",
                    "speaker": "Player",
                    "text": "好像需要钥匙才能开门。"
                },
                {
                    "id": "761430303",
                    "speaker": "哥伦比娅",
                    "text": "钥匙就在你身上。"
                },
                {
                    "id": "761430304",
                    "speaker": "哥伦比娅",
                    "text": "这里是卢沙里姆最后的研究场所，而上一个是月幕实验室，也就是现在的月海。"
                },
                {
                    "id": "761430305",
                    "speaker": "Player",
                    "text": "是…月海的古月之源？"
                },
                {
                    "id": "761430306",
                    "speaker": "哥伦比娅",
                    "text": "就是这个。"
                },
                {
                    "id": "761430307",
                    "speaker": "哥伦比娅",
                    "text": "嗯？是识别到了入侵者吗？"
                },
                {
                    "id": "761430308",
                    "speaker": "哥伦比娅",
                    "text": "不过它们拦不住我们。"
                }
            ]
        },
        {
            "id": "7614304",
            "objective": "通过正确的路前进",
            "dialogues": [
                {
                    "id": "761430401",
                    "speaker": "哥伦比娅",
                    "text": "玛歌已经带上派蒙和宁宁返回了，等你准备好了，我们也动身吧。",
                    "choices": [
                        {
                            "id": "761430402",
                            "text": "准备好了。",
                            "response": [
                                {
                                    "id": "761430403",
                                    "speaker": "哥伦比娅",
                                    "text": "那我们走吧。"
                                }
                            ]
                        },
                        {
                            "id": "761430404",
                            "text": "稍等一下。",
                            "response": [
                                {
                                    "id": "761430405",
                                    "speaker": "哥伦比娅",
                                    "text": "嗯，最好不要耽误太久。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7614319",
            "objective": "通过正确的路前进",
            "dialogues": []
        },
        {
            "id": "7614317",
            "objective": "跃入月心深坑",
            "dialogues": []
        },
        {
            "id": "7614305",
            "objective": "打开月心通道",
            "dialogues": [
                {
                    "id": "761430501",
                    "speaker": "哥伦比娅",
                    "text": "我们回来了。"
                },
                {
                    "id": "761430502",
                    "speaker": "派蒙",
                    "text": "#{NICKNAME}，哥伦比娅，看来你们在月心的冒险很顺利！"
                },
                {
                    "id": "761430503",
                    "speaker": "Player",
                    "text": "我们确实知道了很多。"
                },
                {
                    "id": "761430504",
                    "speaker": "派蒙",
                    "text": "哦？黑蛋的来历，还有望月者计划的内容，都知道了吗？"
                },
                {
                    "id": "761430505",
                    "speaker": "哥伦比娅",
                    "text": "嗯，还有打开望月者模块的钥匙，都在这里了。"
                },
                {
                    "id": "761430506",
                    "speaker": "哥伦比娅",
                    "text": "宁宁，我现在把它交给你。"
                },
                {
                    "id": "761430507",
                    "speaker": "哥伦比娅",
                    "text": "等你读取了这里的信息，就会知道你的使命是什么。"
                },
                {
                    "id": "761430508",
                    "speaker": "黑蛋",
                    "text": "谢谢你！我一直在等待这一刻。"
                },
                {
                    "id": "761430509",
                    "speaker": "哥伦比娅",
                    "text": "……"
                },
                {
                    "id": "761430510",
                    "speaker": "派蒙",
                    "text": "#哥伦比娅？{NICKNAME}？你们的脸色怎么都那么沉重呀？"
                },
                {
                    "id": "761430511",
                    "speaker": "Player",
                    "text": "因为她的使命中存在不可知的风险。"
                },
                {
                    "id": "761430512",
                    "speaker": "黑蛋",
                    "text": "什么风险？"
                },
                {
                    "id": "761430513",
                    "speaker": "哥伦比娅",
                    "text": "等你读取了这里面的信息，你就知道了。"
                },
                {
                    "id": "761430514",
                    "speaker": "黑蛋",
                    "text": "……"
                },
                {
                    "id": "761430515",
                    "speaker": "派蒙",
                    "text": "我有点不明白了，黑蛋的使命到底是什么呀？"
                },
                {
                    "id": "761430516",
                    "speaker": "Black Screen",
                    "text": "在黑蛋读取信息的同时，你们将一切告诉了派蒙。"
                },
                {
                    "id": "761430517",
                    "speaker": "派蒙",
                    "text": "向星空中发送信息？原来这就是望月者计划的内容…"
                },
                {
                    "id": "761430518",
                    "speaker": "派蒙",
                    "text": "所以风险是…这可能会让提瓦特暴露？怎么会这样…好为难！"
                },
                {
                    "id": "761430519",
                    "speaker": "派蒙",
                    "text": "黑蛋…你还好吗？"
                },
                {
                    "id": "761430520",
                    "speaker": "黑蛋",
                    "text": "……"
                },
                {
                    "id": "761430521",
                    "speaker": "派蒙",
                    "text": "哎呀，你先别伤心呀。我们还可以再商量一下对不对？"
                },
                {
                    "id": "761430522",
                    "speaker": "派蒙",
                    "text": "给你零食，我们五五开！"
                },
                {
                    "id": "761430523",
                    "speaker": "黑蛋",
                    "text": "不，我没有伤心。"
                },
                {
                    "id": "761430524",
                    "speaker": "派蒙",
                    "text": "你都流眼泪了！"
                },
                {
                    "id": "761430525",
                    "speaker": "黑蛋",
                    "text": "我不伤心，眼泪也没有流，这只是…这只是…"
                },
                {
                    "id": "761430526",
                    "speaker": "黑蛋",
                    "text": "是敬给前辈们的酒。"
                },
                {
                    "id": "761430527",
                    "speaker": "黑蛋",
                    "text": "#哥伦比娅，{NICKNAME}，派蒙。谢谢你们。"
                },
                {
                    "id": "761430528",
                    "speaker": "黑蛋",
                    "text": "你们是我的朋友，我不想让朋友为难，所以我愿意…放弃这个使命。"
                },
                {
                    "id": "761430529",
                    "speaker": "派蒙",
                    "text": "黑蛋…"
                },
                {
                    "id": "761430530",
                    "speaker": "黑蛋",
                    "text": "没关系，派蒙。我不是第一个执行望月者计划的人。"
                },
                {
                    "id": "761430531",
                    "speaker": "黑蛋",
                    "text": "我的前辈，早就向星空发出了属于我们的声音。"
                },
                {
                    "id": "761430532",
                    "speaker": "黑蛋",
                    "text": "那些充满勇气的声音，一定已经传递到很远很远的星空深处了吧。"
                },
                {
                    "id": "761430533",
                    "speaker": "黑蛋",
                    "text": "只要有那些声音在，星空就不会是一片死寂，那样就足够了。"
                },
                {
                    "id": "761430534",
                    "speaker": "哥伦比娅",
                    "text": "#{NICKNAME}…你考虑好了吗？",
                    "choices": [
                        {
                            "id": "761430535",
                            "text": "也许可以最后执行一次望月者计划。",
                            "response": [
                                {
                                    "id": "761430536",
                                    "speaker": "哥伦比娅",
                                    "text": "嗯，我也这么想。"
                                },
                                {
                                    "id": "761430537",
                                    "speaker": "黑蛋",
                                    "text": "真、真的吗？"
                                },
                                {
                                    "id": "761430538",
                                    "speaker": "派蒙",
                                    "text": "我们真的可以冒一次险吗？"
                                },
                                {
                                    "id": "761430539",
                                    "speaker": "哥伦比娅",
                                    "text": "迄今为止，望月者计划已经执行了不止一次。"
                                },
                                {
                                    "id": "761430540",
                                    "speaker": "哥伦比娅",
                                    "text": "用来隐藏提瓦特的虚假之天，也已经被打开了不止一次。"
                                },
                                {
                                    "id": "761430541",
                                    "speaker": "哥伦比娅",
                                    "text": "霜月曾在虚假之天外存在了数千年。现在月球上也并没有出现深渊污染的痕迹。"
                                },
                                {
                                    "id": "761430542",
                                    "speaker": "派蒙",
                                    "text": "哦？你是说，也许并没有想象中那么危险？"
                                },
                                {
                                    "id": "761430543",
                                    "speaker": "哥伦比娅",
                                    "text": "可能性有很多，也许深渊不是每时每刻都盯着这里，也许是高天的主宰做了其它措施…"
                                },
                                {
                                    "id": "761430544",
                                    "speaker": "哥伦比娅",
                                    "text": "而为了把风险降到最低，我也会用月神的力量，掩护宁宁发出的信息。"
                                },
                                {
                                    "id": "761430545",
                                    "speaker": "派蒙",
                                    "text": "欸？那是什么意思？"
                                },
                                {
                                    "id": "761430549",
                                    "speaker": "哥伦比娅",
                                    "text": "月矩力和古月之力本质上都是光界力，我可以将我的力量融入宁宁发出的信息中。"
                                },
                                {
                                    "id": "761430550",
                                    "speaker": "哥伦比娅",
                                    "text": "等到那些信息穿越虚假之天后，我还可以通过那些力量，监测附近的情况。"
                                },
                                {
                                    "id": "761430551",
                                    "speaker": "哥伦比娅",
                                    "text": "一旦有危险，我可以将信息抹除。这样一来，我们就不会被发现。"
                                },
                                {
                                    "id": "761430552",
                                    "speaker": "派蒙",
                                    "text": "哦？这好像是个好办法！但你的力量…可以一直维持吗？"
                                },
                                {
                                    "id": "761430553",
                                    "speaker": "哥伦比娅",
                                    "text": "唔，我的力量也有极限，只能坚持到一定距离。"
                                },
                                {
                                    "id": "761430554",
                                    "speaker": "哥伦比娅",
                                    "text": "我会尽全力，把它送去我能抵达的极限。届时它的来源也不会被轻易定位了吧。"
                                },
                                {
                                    "id": "761430555",
                                    "speaker": "Player",
                                    "text": "这样听起来比较可行。"
                                },
                                {
                                    "id": "761430556",
                                    "speaker": "黑蛋",
                                    "text": "可是…这会让你受伤吗？"
                                },
                                {
                                    "id": "761430557",
                                    "speaker": "哥伦比娅",
                                    "text": "放心。支持着我们的，是一整个月亮。"
                                },
                                {
                                    "id": "761430558",
                                    "speaker": "派蒙",
                                    "text": "那黑蛋你做好准备了吗？一旦决定，可就无法回头了！"
                                },
                                {
                                    "id": "761430559",
                                    "speaker": "黑蛋",
                                    "text": "…我能再问一个问题吗？"
                                },
                                {
                                    "id": "761430560",
                                    "speaker": "哥伦比娅",
                                    "text": "嗯？"
                                },
                                {
                                    "id": "761430561",
                                    "speaker": "黑蛋",
                                    "text": "为什么你们愿意为我做这些？"
                                },
                                {
                                    "id": "761430562",
                                    "speaker": "哥伦比娅",
                                    "text": "我们可是朋友啊。"
                                },
                                {
                                    "id": "761430563",
                                    "speaker": "黑蛋",
                                    "text": "就这个？"
                                },
                                {
                                    "id": "761430564",
                                    "speaker": "哥伦比娅",
                                    "text": "足够了。",
                                    "choices": [
                                        {
                                            "id": "761430565",
                                            "text": "望月者…",
                                            "response": [
                                                {
                                                    "id": "761430567",
                                                    "speaker": "派蒙",
                                                    "text": "我、我也是！"
                                                },
                                                {
                                                    "id": "761430568",
                                                    "speaker": "黑蛋",
                                                    "text": "我明白了，那么，我做好准备了。"
                                                },
                                                {
                                                    "id": "761430569",
                                                    "speaker": "黑蛋",
                                                    "text": "我的诞生，就是为了这一刻。"
                                                },
                                                {
                                                    "id": "761430570",
                                                    "speaker": "哥伦比娅",
                                                    "text": "嗯，向星空发出你的声音吧，提瓦特的月光会送你远航。"
                                                },
                                                {
                                                    "id": "761430571",
                                                    "speaker": "黑蛋",
                                                    "text": "呃…你好…你们好！"
                                                },
                                                {
                                                    "id": "761430572",
                                                    "speaker": "黑蛋",
                                                    "text": "很高兴…能够向神秘又浩瀚的星空送出这条讯息…"
                                                },
                                                {
                                                    "id": "761430573",
                                                    "speaker": "黑蛋",
                                                    "text": "我不知道，它能否被接收…但我想，它至少能为冰冷的宇宙驱散一些死寂。"
                                                },
                                                {
                                                    "id": "761430574",
                                                    "speaker": "黑蛋",
                                                    "text": "如果真有一个你听见了，那说明一定存在着某种特别的引力，像月亮一样，捕捉了我们。"
                                                },
                                                {
                                                    "id": "761430575",
                                                    "speaker": "黑蛋",
                                                    "text": "所以，我希望你们的文明知道…在这片无垠的星空下，你们并不孤单。"
                                                },
                                                {
                                                    "id": "761430576",
                                                    "speaker": "黑蛋",
                                                    "text": "我们的时代快要落幕了…但我们的勇气、信念、智慧会和这道渺小的讯息一起回荡在星海间。"
                                                },
                                                {
                                                    "id": "761430577",
                                                    "speaker": "黑蛋",
                                                    "text": "它微不足道，但它是我们的光…我希望它能鼓舞你们——在这片星空下，你们不是在独自地迎接未知与黑暗。"
                                                },
                                                {
                                                    "id": "761430578",
                                                    "speaker": "黑蛋",
                                                    "text": "请继续向星空发出属于你们的声音吧，让它也成为你们的光。"
                                                },
                                                {
                                                    "id": "761430579",
                                                    "speaker": "黑蛋",
                                                    "text": "一束光很微弱，很容易会被黑暗吞没，但只要在它消失前有另一束光亮起…"
                                                },
                                                {
                                                    "id": "761430580",
                                                    "speaker": "黑蛋",
                                                    "text": "那么总有一天，总有一束光，会成为刺破夜幕的曙光。"
                                                },
                                                {
                                                    "id": "761430581",
                                                    "speaker": "黑蛋",
                                                    "text": "最后…我们是…宇宙中一个不起眼角落里的… 望月{RUBY#[S]星空}者…"
                                                },
                                                {
                                                    "id": "761430582",
                                                    "speaker": "黑蛋",
                                                    "text": "我们的名字是…"
                                                },
                                                {
                                                    "id": "761430583",
                                                    "speaker": "黑蛋",
                                                    "text": "伊比尼伯龙…"
                                                },
                                                {
                                                    "id": "761430584",
                                                    "speaker": "黑蛋",
                                                    "text": "乌吉恩…"
                                                },
                                                {
                                                    "id": "761430585",
                                                    "speaker": "黑蛋",
                                                    "text": "玛歌洁蒂…"
                                                },
                                                {
                                                    "id": "761430586",
                                                    "speaker": "黑蛋",
                                                    "text": "卢沙里姆…"
                                                },
                                                {
                                                    "id": "761430587",
                                                    "speaker": "黑蛋",
                                                    "text": "宁希姬娅…"
                                                },
                                                {
                                                    "id": "761430588",
                                                    "speaker": "黑蛋",
                                                    "text": "向所有能听见的你…致意…"
                                                },
                                                {
                                                    "id": "761430589",
                                                    "speaker": "黑蛋",
                                                    "text": "朋友们…谢谢…我们在星空下…再见吧…"
                                                },
                                                {
                                                    "id": "761430590",
                                                    "speaker": "派蒙",
                                                    "text": "黑蛋完成了她的使命…"
                                                },
                                                {
                                                    "id": "761430591",
                                                    "speaker": "派蒙",
                                                    "text": "她的帽子…"
                                                },
                                                {
                                                    "id": "761430592",
                                                    "speaker": "Player",
                                                    "text": "你还好吗？哥伦比娅。"
                                                },
                                                {
                                                    "id": "761430593",
                                                    "speaker": "哥伦比娅",
                                                    "text": "我没问题。不过接下来，我需要集中注意力，直到我的力量达到极限。"
                                                },
                                                {
                                                    "id": "761430594",
                                                    "speaker": "派蒙",
                                                    "text": "那我们快去找一个安静的地方吧。"
                                                },
                                                {
                                                    "id": "761430595",
                                                    "speaker": "派蒙",
                                                    "text": "再见了，黑蛋，我会永远记得你。"
                                                },
                                                {
                                                    "id": "761430596",
                                                    "speaker": "终端",
                                                    "text": "（…一阵信号的杂音…）"
                                                },
                                                {
                                                    "id": "761430597",
                                                    "speaker": "终端",
                                                    "text": "（…似乎因为望月者模块的激活，无意间开启了一段尘封的数据…）"
                                                },
                                                {
                                                    "id": "761430598",
                                                    "speaker": "终端",
                                                    "text": "…这里是…号…"
                                                },
                                                {
                                                    "id": "761430599",
                                                    "speaker": "终端",
                                                    "text": "…已接收…讯息…并向你…答复…"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "761430566",
                                            "text": "我向所有的你们致意。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "761430546",
                            "text": "虽然很遗憾，但我们不能冒险。",
                            "response": [
                                {
                                    "id": "761430547",
                                    "speaker": "哥伦比娅",
                                    "text": "如果说，我可以用月神的力量，掩护宁宁发出的信息呢？"
                                },
                                {
                                    "id": "761430548",
                                    "speaker": "Player",
                                    "text": "具体是什么意思？"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7614318",
            "objective": "打开月心通道",
            "dialogues": []
        },
