            "dialogues": []
        },
        {
            "id": "35723",
            "objective": "(test)与安柏对话$HIDDEN",
            "dialogues": [
                {
                    "id": "3572301",
                    "speaker": "安柏",
                    "text": "风魔龙…竟然开始直接袭击城市内部了！"
                },
                {
                    "id": "3572302",
                    "speaker": "安柏",
                    "text": "#凯亚、{NICKNAME}，你们来得正好，我们赶快…"
                },
                {
                    "id": "3572303",
                    "speaker": "凯亚",
                    "text": "等等，安柏。这里还有人没来得及互相认识吧？"
                },
                {
                    "id": "3572304",
                    "speaker": "安柏",
                    "text": "啊…好的。这是凯亚，是我们的骑兵队长。"
                },
                {
                    "id": "3572305",
                    "speaker": "安柏",
                    "text": "#这两位是远方来的旅者，{NICKNAME}和派蒙。"
                },
                {
                    "id": "3572306",
                    "speaker": "凯亚",
                    "text": "（只知道是「远方」吗…）"
                },
                {
                    "id": "3572307",
                    "speaker": "安柏",
                    "text": "事情是这样的…"
                },
                {
                    "id": "3572308",
                    "speaker": "凯亚",
                    "text": "原来如此，欢迎来到蒙德。但很遗憾，是在这种糟糕的时机…"
                },
                {
                    "id": "3572309",
                    "speaker": "凯亚",
                    "text": "我很理解血亲分离的痛苦心情，旅行者。"
                },
                {
                    "id": "3572310",
                    "speaker": "凯亚",
                    "text": "另外，虽然不知道你们为什么要找风神…"
                },
                {
                    "id": "3572311",
                    "speaker": "凯亚",
                    "text": "但每个人都有自己的秘密，对吧？"
                },
                {
                    "id": "3572312",
                    "speaker": "凯亚",
                    "text": "哈哈，我是不会追问的。"
                },
                {
                    "id": "3572313",
                    "speaker": "凯亚",
                    "text": "总之，首先我要代骑士团向你们道谢。",
                    "choices": [
                        {
                            "id": "3572314",
                            "text": "不能放着灾难不管…",
                            "response": [
                                {
                                    "id": "3572318",
                                    "speaker": "凯亚",
                                    "text": "刚才那场抵御魔龙的战斗，被守护的市民们都是亲眼目睹了的。"
                                },
                                {
                                    "id": "3572319",
                                    "speaker": "凯亚",
                                    "text": "代理团长大人对两位也很有兴趣，希望能在<color=#00E1FFFF>骑士团总部</color>一叙。"
                                }
                            ]
                        },
                        {
                            "id": "3572315",
                            "text": "不客气，那么谢礼呢？",
                            "response": [
                                {
                                    "id": "3572316",
                                    "speaker": "凯亚",
                                    "text": "嗯…蒙德特色的蜜酱胡萝卜煎肉？"
                                },
                                {
                                    "id": "3572317",
                                    "speaker": "Player",
                                    "text": "这句话我刚才已经听过了。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
