    "talks": [
        {
            "id": "7050201",
            "objective": "与卢卡对话",
            "dialogues": [
                {
                    "id": "705020116",
                    "speaker": "Player",
                    "text": "好吧，那就试试。"
                },
                {
                    "id": "705020117",
                    "speaker": "卢卡",
                    "text": "欢迎欢迎。请进，查尔斯先生会教你基本的调制手法。"
                }
            ]
        },
        {
            "id": "7050202",
            "objective": "和卢卡对话，进入酒馆",
            "dialogues": [
                {
                    "id": "705020201",
                    "speaker": "查尔斯",
                    "text": "没想到是老面孔，今天想喝点儿什么？"
                },
                {
                    "id": "705020202",
                    "speaker": "Player",
                    "text": "你好，查尔斯。"
                },
                {
                    "id": "705020203",
                    "speaker": "派蒙",
                    "text": "查尔斯，我们是来当酒保的！"
                },
                {
                    "id": "705020204",
                    "speaker": "查尔斯",
                    "text": "当酒保…啊，原来卢卡招揽到了你们吗，他运气真够好的。"
                },
                {
                    "id": "705020205",
                    "speaker": "查尔斯",
                    "text": "#{NICKNAME}，我很信任你处理问题的能力，不过，调酒毕竟是个技术活，希望你不要掉以轻心。"
                },
                {
                    "id": "705020206",
                    "speaker": "查尔斯",
                    "text": "原料的配比，混合的手法…都会影响出品的质量。"
                },
                {
                    "id": "705020207",
                    "speaker": "派蒙",
                    "text": "#没事，{M#他}{F#她}做的菜可好吃了，美食的原理是相通的！"
                },
                {
                    "id": "705020208",
                    "speaker": "查尔斯",
                    "text": "好，还有一件事…"
                },
                {
                    "id": "705020209",
                    "speaker": "查尔斯",
                    "text": "之前活动中有位实习生，凭自己的理解混合了三种烈酒，结果一杯就灌倒了客人。"
                },
                {
                    "id": "705020210",
                    "speaker": "查尔斯",
                    "text": "从那之后，我们就不敢再向新人提供含酒精的材料了，这点请你见谅。"
                },
                {
                    "id": "705020211",
                    "speaker": "Player",
                    "text": "能够理解。"
                },
                {
                    "id": "705020212",
                    "speaker": "查尔斯",
                    "text": "好，那就全部交待完了。手法和技巧，就在实际调制过程中教你吧。"
                }
            ]
        },
        {
            "id": "7050203",
            "objective": "与查尔斯对话",
            "dialogues": []
        },
        {
            "id": "7050204",
            "objective": "学习并调制指定饮品",
            "dialogues": [
                {
                    "id": "705020401",
                    "speaker": "卢卡",
                    "text": "怎么样，你意下如何？"
                }
            ]
        },
        {
            "id": "7050205",
            "objective": "与查尔斯对话",
            "dialogues": [
                {
                    "id": "705020301",
                    "speaker": "查尔斯",
                    "text": "你学得很快，味道也确实不错。"
                },
                {
                    "id": "705020302",
                    "speaker": "派蒙",
                    "text": "嗯嗯，我也觉得好喝！"
                },
                {
                    "id": "705020303",
                    "speaker": "查尔斯",
                    "text": "刚才只是情景模拟。实际上，顾客可能也会有一些个性化点单。"
                },
                {
                    "id": "705020304",
                    "speaker": "查尔斯",
                    "text": "浓一点、酸一点，诸如此类。你只需要将对应口味的辅料加量就好。"
                },
                {
                    "id": "705020305",
                    "speaker": "派蒙",
                    "text": "我想要一杯焦糖松果，甜一点，最大的杯子！"
                },
                {
                    "id": "705020306",
                    "speaker": "查尔斯",
                    "text": "差不多就类似这样。但对一个优秀的酒保来说，除了具备调制技术，还需要掌握和客人聊天的技巧…",
                    "choices": [
                        {
                            "id": "705020307",
                            "text": "交给我吧！",
                            "response": [
                                {
                                    "id": "705020309",
                                    "speaker": "查尔斯",
                                    "text": "那好，这吧台的位置就交给你们了。遇到问题或者有什么需要，可以随时找我。"
                                },
                                {
                                    "id": "705020310",
                                    "speaker": "派蒙",
                                    "text": "呼…终于学完了！不对…我的焦糖松果呢？"
                                },
                                {
                                    "id": "705020311",
                                    "speaker": "Player",
                                    "text": "原来你真的在点单…"
                                }
                            ]
                        },
                        {
                            "id": "705020308",
                            "text": "我很会聊天。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7050206",
            "objective": "(test)传送进入酒馆$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7050207",
            "objective": "(test)失败回滚传送任务$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7050201",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "705020101",
                    "speaker": "卢卡",
                    "text": "你好，想必你就是那位大名鼎鼎的旅行者吧。",
                    "choices": [
                        {
                            "id": "705020102",
                            "text": "我就是。",
                            "response": [
                                {
                                    "id": "705020104",
                                    "speaker": "派蒙",
                                    "text": "喂，还有我呢，我是大名鼎鼎的派蒙！"
                                },
                                {
                                    "id": "705020105",
                                    "speaker": "卢卡",
                                    "text": "是这样的。最近「天使的馈赠」酒馆在举行「酒保体验周」的活动，我想你或许会感兴趣。"
                                },
                                {
                                    "id": "705020106",
                                    "speaker": "卢卡",
                                    "text": "简单来说，你可以亲自参与调酒…或者调别的什么，原料随便用。"
                                },
                                {
                                    "id": "705020107",
                                    "speaker": "卢卡",
                                    "text": "只要不浪费，成品也供你们无限畅饮。"
                                },
                                {
                                    "id": "705020108",
                                    "speaker": "派蒙",
                                    "text": "无限畅饮！"
                                },
                                {
                                    "id": "705020109",
                                    "speaker": "卢卡",
                                    "text": "另外，如果能让顾客们满意，报酬肯定也不会少你们的。"
                                },
                                {
                                    "id": "705020110",
                                    "speaker": "派蒙",
                                    "text": "哇，还有报酬！"
                                },
                                {
                                    "id": "705020111",
                                    "speaker": "Player",
                                    "text": "派蒙彻底沦陷了…"
                                },
                                {
                                    "id": "705020112",
                                    "speaker": "派蒙",
                                    "text": "我们参加吧！好不好？"
                                },
                                {
                                    "id": "705020113",
                                    "speaker": "卢卡",
                                    "text": "虽说是「体验周」，其实对考勤没有要求…"
                                },
                                {
                                    "id": "705020114",
                                    "speaker": "卢卡",
                                    "text": "现在做不了决定也没关系，可以先来试一次。"
                                },
                                {
                                    "id": "705020115",
                                    "speaker": "卢卡",
                                    "text": "怎么样，你意下如何？"
                                }
                            ]
                        },
                        {
                            "id": "705020103",
                            "text": "有什么事吗？"
                        }
                    ]
                },
                {
                    "id": "705020118",
                    "speaker": "Player",
                    "text": "请稍等一下。"
                },
                {
                    "id": "705020119",
                    "speaker": "卢卡",
                    "text": "没问题，要是你想好了，随时来找我就行。"
                }
            ]
        }
    ]
}