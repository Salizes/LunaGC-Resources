    "talks": [
        {
            "id": "7605001",
            "objective": "同「少女」见面",
            "dialogues": [
                {
                    "id": "760500101",
                    "speaker": "月灵",
                    "text": "~！"
                },
                {
                    "id": "760500102",
                    "speaker": "月灵",
                    "text": "！！"
                },
                {
                    "id": "760500103",
                    "speaker": "派蒙",
                    "text": "哇，今天这里好热闹啊，有好多月灵都在哥伦比娅身边起舞呢。"
                },
                {
                    "id": "760500104",
                    "speaker": "派蒙",
                    "text": "呃，等等…好像不是跳舞！月灵们是想朝她撒娇吗？哥伦比娅快要被淹没了！"
                },
                {
                    "id": "760500105",
                    "speaker": "「少女」",
                    "text": "救…救救。"
                },
                {
                    "id": "760500106",
                    "speaker": "Player",
                    "text": "把手给我。"
                },
                {
                    "id": "760500107",
                    "speaker": "「少女」",
                    "text": "呼…谢谢你们…"
                },
                {
                    "id": "760500108",
                    "speaker": "派蒙",
                    "text": "刚才那是发生什么了？月灵们平时不会那么激动吧…"
                },
                {
                    "id": "760500109",
                    "speaker": "月灵",
                    "text": "~！"
                },
                {
                    "id": "760500110",
                    "speaker": "「少女」",
                    "text": "嗯…"
                },
                {
                    "id": "760500111",
                    "speaker": "「少女」",
                    "text": "我陪这些孩子玩了点游戏，它们似乎很享受。"
                },
                {
                    "id": "760500112",
                    "speaker": "派蒙",
                    "text": "享受完游戏时间之后围到你身边转…怎么感觉像狗狗一样呢？"
                },
                {
                    "id": "760500113",
                    "speaker": "Player",
                    "text": "这就是它们表达感谢的方式吧。"
                },
                {
                    "id": "760500114",
                    "speaker": "「少女」",
                    "text": "只不过这次一不留神，谢意就像雪堆一样积起来了…"
                },
                {
                    "id": "760500115",
                    "speaker": "派蒙",
                    "text": "说是这么说，你不还是很宠它们嘛！"
                },
                {
                    "id": "760500116",
                    "speaker": "「少女」",
                    "text": "你们也想试试看吗？",
                    "choices": [
                        {
                            "id": "760500117",
                            "text": "被围在中间的感觉？",
                            "response": [
                                {
                                    "id": "760500118",
                                    "speaker": "「少女」",
                                    "text": "嗯…这个也行。只要你答得上来。"
                                },
                                {
                                    "id": "760500121",
                                    "speaker": "派蒙",
                                    "text": "行啊，我倒要看看是什么游戏，那么受月灵欢迎。"
                                },
                                {
                                    "id": "760500122",
                                    "speaker": "「少女」",
                                    "text": "去吧。"
                                },
                                {
                                    "id": "760500123",
                                    "speaker": "月灵",
                                    "text": "~！"
                                },
                                {
                                    "id": "760500124",
                                    "speaker": "月灵",
                                    "text": "！！"
                                }
                            ]
                        },
                        {
                            "id": "760500119",
                            "text": "和月灵玩游戏？",
                            "response": [
                                {
                                    "id": "760500120",
                                    "speaker": "「少女」",
                                    "text": "嗯。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7605003",
            "objective": "同月灵玩耍",
            "dialogues": [
                {
                    "id": "760500901",
                    "speaker": "月灵",
                    "text": "~！"
                },
                {
                    "id": "760500902",
                    "speaker": "月灵",
                    "text": "！！"
                },
                {
                    "id": "760500903",
                    "speaker": "派蒙",
                    "text": "满意了吧？"
                },
                {
                    "id": "760500904",
                    "speaker": "Player",
                    "text": "真的软乎乎的。"
                },
                {
                    "id": "760500905",
                    "speaker": "派蒙",
                    "text": "怎么猜错了的人也有奖励啦，难道是参与奖？"
                },
                {
                    "id": "760500906",
                    "speaker": "Player",
                    "text": "好乖好乖。"
                },
                {
                    "id": "760500907",
                    "speaker": "「少女」",
                    "text": "它们喜欢你。"
                },
                {
                    "id": "760500908",
                    "speaker": "「少女」",
                    "text": "我能感觉到，当这些孩子靠近你的时候，它们本身也放松了下来。"
                },
                {
                    "id": "760500909",
                    "speaker": "「少女」",
                    "text": "就像凛角鹿喜欢沐浴着月光生长，月灵们也喜欢你心中散发出的什么。"
                },
                {
                    "id": "760500910",
                    "speaker": "派蒙",
                    "text": "嗯？那是什么呢？"
                },
                {
                    "id": "760500911",
                    "speaker": "「少女」",
                    "text": "温柔与善良吧。"
                }
            ]
        },
        {
            "id": "7605002",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "760500201",
                    "speaker": "「少女」",
                    "text": "如果你愿意的话，下次也来陪月灵们玩游戏吧。"
                }
            ]
        },
        {
            "id": "7605003",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "760500301",
                    "speaker": "「少女」",
                    "text": "猜猜看这是什么图案吧。"
                },
                {
                    "id": "760500302",
                    "speaker": "派蒙",
                    "text": "欸？这…这也太抽象了。"
                },
                {
                    "id": "760500303",
                    "speaker": "派蒙",
                    "text": "哥伦比娅，你刚刚真的答对了吗？"
                },
                {
                    "id": "760500304",
                    "speaker": "「少女」",
                    "text": "好像错的时候更多一些。"
                },
                {
                    "id": "760500305",
                    "speaker": "派蒙",
                    "text": "#我放弃了。{NICKNAME}，你猜吧。",
                    "choices": [
                        {
                            "id": "760500306",
                            "text": "凛角鹿。",
                            "response": [
                                {
                                    "id": "760500307",
                                    "speaker": "月灵",
                                    "text": "！！"
                                },
                                {
                                    "id": "760500308",
                                    "speaker": "派蒙",
                                    "text": "噢！看这反应是！"
                                },
                                {
                                    "id": "760500309",
                                    "speaker": "「少女」",
                                    "text": "恭喜，猜对了呢。"
                                }
                            ]
                        },
                        {
                            "id": "760500310",
                            "text": "长颈角犀。",
                            "response": [
                                {
                                    "id": "760500311",
                                    "speaker": "派蒙",
                                    "text": "好担心啊！它的脖子是不是出了点问题啊！"
                                },
                                {
                                    "id": "760500312",
                                    "speaker": "「少女」",
                                    "text": "嗯…是没有见过的生物呢…"
                                },
                                {
                                    "id": "760500313",
                                    "speaker": "「少女」",
                                    "text": "正确答案是凛角鹿。"
                                },
                                {
                                    "id": "760500314",
                                    "speaker": "「少女」",
                                    "text": "月灵们，回来吧。"
                                }
                            ]
                        },
                        {
                            "id": "760500315",
                            "text": "翻折了一根叉刺的渔叉。",
                            "response": [
                                {
                                    "id": "760500316",
                                    "speaker": "派蒙",
                                    "text": "好丰富的想象力…"
                                },
                                {
                                    "id": "760500317",
                                    "speaker": "「少女」",
                                    "text": "哈…很有趣的答案。"
                                },
                                {
                                    "id": "760500318",
                                    "speaker": "「少女」",
                                    "text": "正确答案是凛角鹿。"
                                },
                                {
                                    "id": "760500319",
                                    "speaker": "「少女」",
                                    "text": "月灵们，回来吧。"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}