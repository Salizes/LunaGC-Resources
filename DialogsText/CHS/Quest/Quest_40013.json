    "talks": [
        {
            "id": "4001308",
            "objective": "(test)四阶段桥接任务$HIDDEN",
            "dialogues": []
        },
        {
            "id": "4001312",
            "objective": "休息至翌日清晨（次日早6点-8点）",
            "dialogues": []
        },
        {
            "id": "4001310",
            "objective": "回到巨大海螺旁",
            "dialogues": [
                {
                    "id": "400130301",
                    "speaker": "芭芭拉",
                    "text": "荣誉骑士，这边这边！"
                },
                {
                    "id": "400130302",
                    "speaker": "Player",
                    "text": "鱼的情况怎么样？"
                },
                {
                    "id": "400130303",
                    "speaker": "琴",
                    "text": "和我们预估的一样，被水晶吸引过来了。"
                },
                {
                    "id": "400130304",
                    "speaker": "可莉",
                    "text": "捞鱼捞鱼，捞鱼！"
                },
                {
                    "id": "400130305",
                    "speaker": "派蒙",
                    "text": "啊！不行不行！"
                },
                {
                    "id": "400130306",
                    "speaker": "派蒙",
                    "text": "为了避免可莉把鱼炸掉，捞鱼还是交给我们吧。毕竟，打捞采摘什么的，我们也是老手了呢。"
                }
            ]
        },
        {
            "id": "4001301",
            "objective": "抓住鱼获取鳞片",
            "dialogues": [
                {
                    "id": "400130101",
                    "speaker": "派蒙",
                    "text": "可莉——！"
                },
                {
                    "id": "400130102",
                    "speaker": "Player",
                    "text": "我们把鱼鳞放好了哦。"
                },
                {
                    "id": "400130103",
                    "speaker": "可莉",
                    "text": "你真棒！嘿嘿嘿，那接下来就轮到可莉了对吧？"
                },
                {
                    "id": "400130104",
                    "speaker": "派蒙",
                    "text": "对，那边的机关就交给你啦！"
                },
                {
                    "id": "400130105",
                    "speaker": "可莉",
                    "text": "好——！"
                },
                {
                    "id": "400130106",
                    "speaker": "Player",
                    "text": "可莉。"
                },
                {
                    "id": "400130107",
                    "speaker": "可莉",
                    "text": "嗯？",
                    "choices": [
                        {
                            "id": "400130108",
                            "text": "请务必注意安全。",
                            "response": [
                                {
                                    "id": "400130110",
                                    "speaker": "可莉",
                                    "text": "嗯，可莉知道了！"
                                },
                                {
                                    "id": "400130111",
                                    "speaker": "可莉",
                                    "text": "……"
                                },
                                {
                                    "id": "400130112",
                                    "speaker": "芭芭拉",
                                    "text": "可莉，怎么了吗？"
                                },
                                {
                                    "id": "400130113",
                                    "speaker": "可莉",
                                    "text": "可莉…可莉担心…这里面真是嘟嘟大魔王该怎么办？"
                                },
                                {
                                    "id": "400130114",
                                    "speaker": "可莉",
                                    "text": "万一嘟嘟大魔王不认同可莉成为嘟嘟可的家人，或者、或者万一可莉输给了他…"
                                },
                                {
                                    "id": "400130115",
                                    "speaker": "可莉",
                                    "text": "那嘟嘟可就不能陪着可莉了，妈妈也会很难过…嘟嘟可是妈妈送给可莉的重要朋友。"
                                },
                                {
                                    "id": "400130116",
                                    "speaker": "可莉",
                                    "text": "然后就…不敢按了…"
                                },
                                {
                                    "id": "400130117",
                                    "speaker": "阿贝多",
                                    "text": "……"
                                },
                                {
                                    "id": "400130118",
                                    "speaker": "可莉",
                                    "text": "#荣誉骑士{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}，能不能请你来帮我按呢？"
                                },
                                {
                                    "id": "400130119",
                                    "speaker": "Player",
                                    "text": "#可莉，{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}不能帮你按。"
                                },
                                {
                                    "id": "400130120",
                                    "speaker": "可莉",
                                    "text": "为什么呀？"
                                },
                                {
                                    "id": "400130121",
                                    "speaker": "Player",
                                    "text": "#因为{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}要握紧武器。"
                                },
                                {
                                    "id": "400130122",
                                    "speaker": "Player",
                                    "text": "这样就能保护你啦。"
                                },
                                {
                                    "id": "400130123",
                                    "speaker": "琴",
                                    "text": "是啊，可莉，我们大家都在这里陪着你。"
                                },
                                {
                                    "id": "400130124",
                                    "speaker": "派蒙",
                                    "text": "人多势众说的就是这种场面吧！"
                                },
                                {
                                    "id": "400130125",
                                    "speaker": "凯亚",
                                    "text": "不论是什么样的敌人，只要有我们在就不用害怕。"
                                },
                                {
                                    "id": "400130126",
                                    "speaker": "迪卢克",
                                    "text": "正好，我也想见识一下这座岛上的敌人有多强。"
                                },
                                {
                                    "id": "400130127",
                                    "speaker": "雷泽",
                                    "text": "去吧。"
                                },
                                {
                                    "id": "400130128",
                                    "speaker": "雷泽",
                                    "text": "我在这里。"
                                },
                                {
                                    "id": "400130129",
                                    "speaker": "芭芭拉",
                                    "text": "大家，不要说这种话呀…万一嘟嘟大魔王只是请可莉去他家友好商谈呢？又或者…对！说不定他已经承认了可莉！"
                                },
                                {
                                    "id": "400130130",
                                    "speaker": "可莉",
                                    "text": "他会承认可莉吗？"
                                },
                                {
                                    "id": "400130131",
                                    "speaker": "阿贝多",
                                    "text": "为什么不会呢？可莉非常认真，做得很好。"
                                },
                                {
                                    "id": "400130132",
                                    "speaker": "可莉",
                                    "text": "真的吗？",
                                    "choices": [
                                        {
                                            "id": "400130133",
                                            "text": "可莉是最好的小朋友。",
                                            "response": [
                                                {
                                                    "id": "400130135",
                                                    "speaker": "可莉",
                                                    "text": "…嗯！"
                                                },
                                                {
                                                    "id": "400130136",
                                                    "speaker": "可莉",
                                                    "text": "那，可莉要上了！"
                                                },
                                                {
                                                    "id": "400130137",
                                                    "speaker": "可莉",
                                                    "text": "按钮按钮…按！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "400130134",
                                            "text": "他会承认的，我保证。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "400130109",
                            "text": "我们都会陪你一起。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "4001302",
            "objective": "抓住鱼获取鳞片",
            "dialogues": [
                {
                    "id": "400130201",
                    "speaker": "琴",
                    "text": "这是…等等，我都糊涂了，这是什么？！"
                },
                {
                    "id": "400130202",
                    "speaker": "芭芭拉",
                    "text": "整座岛，简直像是藏在能量罩底下的巨大礼物箱…"
                },
                {
                    "id": "400130203",
                    "speaker": "阿贝多",
                    "text": "那里好像有什么东西哦，不去看看吗？"
                },
                {
                    "id": "400130204",
                    "speaker": "可莉",
                    "text": "嗯，要看！"
                },
                {
                    "id": "400130205",
                    "speaker": "嘟嘟大魔王",
                    "text": "邪恶的红色女孩，你终于来了。我等得太久太久，实在是好无聊啊！"
                },
                {
                    "id": "400130206",
                    "speaker": "嘟嘟大魔王",
                    "text": "你胆敢面对我，嘟嘟一族的统治者——嘟嘟大魔王，勇气可嘉！"
                },
                {
                    "id": "400130207",
                    "speaker": "嘟嘟大魔王",
                    "text": "勇气虽然值得敬佩，但现在已经没有意义了，因为…"
                },
                {
                    "id": "400130208",
                    "speaker": "艾莉丝",
                    "text": "因为嘟嘟大魔王就是我，你的妈妈艾莉丝哦！"
                },
                {
                    "id": "400130209",
                    "speaker": "可莉",
                    "text": "咦，妈妈！"
                },
                {
                    "id": "400130210",
                    "speaker": "派蒙",
                    "text": "艾莉丝…是那个写《提瓦特游览指南》的人？！"
                },
                {
                    "id": "400130211",
                    "speaker": "艾莉丝",
                    "text": "可莉，还有陪同可莉一起前来海岛的各位，你们好啊。"
                },
                {
                    "id": "400130212",
                    "speaker": "艾莉丝",
                    "text": "如何，这片海岛好玩吗？夏天的阳光和海滩，嗯~应该是个不错的假日吧？"
                },
                {
                    "id": "400130213",
                    "speaker": "艾莉丝",
                    "text": "不用找了，我不在你们身旁。面前这台正在说话的机器是我发明的「艾莉丝留声机」，用于传递妈妈的爱哦！"
                },
                {
                    "id": "400130214",
                    "speaker": "凯亚",
                    "text": "哦？这可真是…"
                },
                {
                    "id": "400130215",
                    "speaker": "艾莉丝",
                    "text": "啊呀，不会吓到大家了吧？抱歉抱歉，我家可莉喜欢玩各式各样的小玩具，作为母亲的我自然要支持了。"
                },
                {
                    "id": "400130216",
                    "speaker": "派蒙",
                    "text": "这些玩具一点都不小！"
                },
                {
                    "id": "400130217",
                    "speaker": "雷泽",
                    "text": "妈…妈？"
                },
                {
                    "id": "400130218",
                    "speaker": "艾莉丝",
                    "text": "不能见面很可惜，但我会从远方留意着你们的一举一动，像过去那样守望着各位。"
                },
                {
                    "id": "400130219",
                    "speaker": "琴",
                    "text": "竟然是艾莉丝女士！我…我大意了…"
                },
                {
                    "id": "400130220",
                    "speaker": "芭芭拉",
                    "text": "哎？哎？"
                },
                {
                    "id": "400130221",
                    "speaker": "艾莉丝",
                    "text": "也许各位会为这一切感到奇怪，为什么一个离家千里的母亲要大费周章地建造这样一座水上乐园呢？"
                },
                {
                    "id": "400130222",
                    "speaker": "艾莉丝",
                    "text": "叮叮！没错，我也亲自去过那座岛，对岛上古老的遗迹和特殊的地形很是喜爱，为了让大家都享受到这份快乐，才做了这些安排。"
                },
                {
                    "id": "400130223",
                    "speaker": "派蒙",
                    "text": "可莉的妈妈也是个非常自由的人呢…"
                },
                {
                    "id": "400130224",
                    "speaker": "艾莉丝",
                    "text": "哦呵呵，是不是有人在说我坏话呀？"
                },
                {
                    "id": "400130225",
                    "speaker": "派蒙",
                    "text": "哎？没、没有啊！她是在监听吗？"
                },
                {
                    "id": "400130226",
                    "speaker": "琴",
                    "text": "不，不需要这么麻烦。"
                },
                {
                    "id": "400130227",
                    "speaker": "派蒙",
                    "text": "什么意思？"
                },
                {
                    "id": "400130228",
                    "speaker": "阿贝多",
                    "text": "可莉的母亲艾莉丝是一位极其神秘又近乎万能的魔女。千万别太惊讶，她就是这样的人。"
                },
                {
                    "id": "400130229",
                    "speaker": "艾莉丝",
                    "text": "你们一定在想，那些信是怎么回事，那些船又是怎么回事，还有那些浮标、能量罩…"
                },
                {
                    "id": "400130230",
                    "speaker": "艾莉丝",
                    "text": "嗯嗯~其实我也觉得有些大费周章了，但只有这样，才能把各位请来这里，不是吗？"
                },
                {
                    "id": "400130231",
                    "speaker": "艾莉丝",
                    "text": "那座岛本就很有故事，原住民、沉船、神秘机械…无数巧合汇聚在此，要是不做些布置，岂不是太浪费了。"
                },
                {
                    "id": "400130232",
                    "speaker": "艾莉丝",
                    "text": "让我猜猜看，收到信的各位应该都在吧。凯亚先生、迪卢克先生、雷泽小朋友、琴小姐、芭芭拉小姐…"
                },
                {
                    "id": "400130233",
                    "speaker": "艾莉丝",
                    "text": "#然后是可靠又聪明的小阿贝多，以及…神秘的旅行者和{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}的好伙伴，派蒙。"
                },
                {
                    "id": "400130234",
                    "speaker": "艾莉丝",
                    "text": "你们都是受我邀请前来陪伴可莉的人。谢谢你们，让这孩子过了一个不错的夏天。"
                },
                {
                    "id": "400130235",
                    "speaker": "艾莉丝",
                    "text": "岛上的一切都是我给你们的礼物，谢谢你们陪着她。不过等你们听到这段录音，我应该已经在别处旅行了吧。"
                },
                {
                    "id": "400130236",
                    "speaker": "艾莉丝",
                    "text": "旅行生活是如此匆忙又有趣，哈哈，问问你们身旁那位旅行者就知道了。"
                },
                {
                    "id": "400130237",
                    "speaker": "琴",
                    "text": "艾莉丝女士，是因为太忙无法陪伴可莉才做这些的吗…"
                },
                {
                    "id": "400130238",
                    "speaker": "可莉",
                    "text": "不是哦，妈妈就是这样的！"
                },
                {
                    "id": "400130239",
                    "speaker": "艾莉丝",
                    "text": "各位，如果你此刻正在思考更深一层的用意，我必须得说，情况没有你想的那么复杂。"
                },
                {
                    "id": "400130240",
                    "speaker": "艾莉丝",
                    "text": "我之所以中意蒙德这座城邦，是因为自由也正是我们母女的期望哦。"
                },
                {
                    "id": "400130241",
                    "speaker": "艾莉丝",
                    "text": "我的愿望很简单，希望可莉怀抱着好奇心与善意长大，只要她想，她就能做任何事，去任何地方。"
                },
                {
                    "id": "400130242",
                    "speaker": "琴",
                    "text": "原来如此…确实是艾莉丝女士的风格，抱歉，是我误会了。"
                },
                {
                    "id": "400130243",
                    "speaker": "派蒙",
                    "text": "总觉得是好有性格的妈妈呢。"
                },
                {
                    "id": "400130244",
                    "speaker": "可莉",
                    "text": "嗯！妈妈是最好的妈妈哦！"
                },
                {
                    "id": "400130245",
                    "speaker": "可莉",
                    "text": "妈妈，这次我们抓鱼、开船、游泳…玩了很多很多东西！"
                },
                {
                    "id": "400130246",
                    "speaker": "可莉",
                    "text": "大家都超——级超级好，对可莉非常温柔！"
                },
                {
                    "id": "400130247",
                    "speaker": "可莉",
                    "text": "下次你也一起来，我们再到这里玩！"
                },
                {
                    "id": "400130248",
                    "speaker": "凯亚",
                    "text": "母女俩都是自由自在的精灵啊。"
                },
                {
                    "id": "400130249",
                    "speaker": "艾莉丝",
                    "text": "夏天啊…说到夏天，我去那座岛时，刚好也是夏天呢。坐在沙滩上，倾听着海浪拂过脚背发出的细响，就想到了你。"
                },
                {
                    "id": "400130250",
                    "speaker": "艾莉丝",
                    "text": "可莉，你是出生在夏天的孩子，是海与风送给妈妈的礼物。妈妈很感谢你的诞生，也想送点东西给你。"
                },
                {
                    "id": "400130251",
                    "speaker": "艾莉丝",
                    "text": "于是妈妈在岛上做了些布置，把古老的遗迹改造成夏日游乐园，再用嘟嘟大魔王的名义请你过来。"
                },
                {
                    "id": "400130252",
                    "speaker": "艾莉丝",
                    "text": "异世界传说里有过一座以「金苹果」为名的奇迹之岛。它有多种化名，承载着人们对美好幻梦的想象。"
                },
                {
                    "id": "400130253",
                    "speaker": "艾莉丝",
                    "text": "妈妈喜欢那个故事，也希望你能享受到故事中的美好之事。所以妈妈送你碧蓝的海水、珍珠般白亮的细沙、不可思议的乐园…"
                },
                {
                    "id": "400130254",
                    "speaker": "艾莉丝",
                    "text": "和那些爱你的人。"
                },
                {
                    "id": "400130255",
                    "speaker": "琴",
                    "text": "……"
                },
                {
                    "id": "400130256",
                    "speaker": "芭芭拉",
                    "text": "所以水晶才只有三块吗…花瓣般的浅红色、海浪般的浅蓝色、秋叶般的浅黄色…"
                },
                {
                    "id": "400130257",
                    "speaker": "琴",
                    "text": "或许在艾莉丝看来，这片群岛就是天然存在的第四块水晶吧…位于大海正中，被植被覆盖的、绿宝石般璀璨的「夏之水晶」。"
                },
                {
                    "id": "400130258",
                    "speaker": "艾莉丝",
                    "text": "可莉，你和妈妈一样，是比普通人更长寿的种族。对我们而言，时间是一阵风，吹过便是结束。"
                },
                {
                    "id": "400130259",
                    "speaker": "艾莉丝",
                    "text": "在如此漫长的生命里，父母不过是孩子人生的第一环。即使我们不愿分离，终有一日，你也会走上属于自己的路。"
                },
                {
                    "id": "400130260",
                    "speaker": "艾莉丝",
                    "text": "可莉，妈妈会一直爱你，但除了妈妈，还有许多人围在你身旁。"
                },
                {
                    "id": "400130261",
                    "speaker": "艾莉丝",
                    "text": "陪伴你的好友、教导你的老师、哪怕知道有蹊跷也愿意为了你留在岛上的人们…"
                },
                {
                    "id": "400130262",
                    "speaker": "艾莉丝",
                    "text": "夏天是属于大家的。无论生活如何变化，无论这一年发生多少事，夏天都不会消失，就像人们之间的爱一样。"
                },
                {
                    "id": "400130263",
                    "speaker": "艾莉丝",
                    "text": "希望你从今以后无论去往何处都不要忘记，世界上有那么多爱你的人。"
                },
                {
                    "id": "400130264",
                    "speaker": "艾莉丝",
                    "text": "啊对了，在家也要听阿贝多哥哥的话，妈妈会定期回来看望你们。其实啊，我一有空就会偷偷回来探望可莉和大家。嘻嘻，谁都没有发现吧？"
                },
                {
                    "id": "400130265",
                    "speaker": "阿贝多",
                    "text": "还是老样子啊，艾莉丝阿姨。"
                },
                {
                    "id": "400130266",
                    "speaker": "派蒙",
                    "text": "阿贝多这家伙，该不会从一开始就知道了吧…"
                },
                {
                    "id": "400130267",
                    "speaker": "艾莉丝",
                    "text": "唔？时间差不多了，就先说到这里吧。对了对了，我做这些费了不少力气，你们一定要尽情地玩哦！"
                },
                {
                    "id": "400130268",
                    "speaker": "艾莉丝",
                    "text": "那么各位，还有我的宝贝可莉，下次再见咯。"
                },
                {
                    "id": "400130269",
                    "speaker": "可莉",
                    "text": "妈妈再见！"
                },
                {
                    "id": "400130270",
                    "speaker": "Player",
                    "text": "可莉，好像非常开心呢。"
                },
                {
                    "id": "400130271",
                    "speaker": "可莉",
                    "text": "嘿嘿…大魔王就是妈妈，不知为什么，可莉觉得好开心！"
                },
                {
                    "id": "400130272",
                    "speaker": "可莉",
                    "text": "不管是炸蒙德大门的妈妈，被关禁闭的妈妈，还是写奇怪的信给我的妈妈…可莉都好喜欢。"
                },
                {
                    "id": "400130273",
                    "speaker": "Player",
                    "text": "可莉不会觉得寂寞吗？"
                },
                {
                    "id": "400130274",
                    "speaker": "可莉",
                    "text": "不会，因为妈妈是最厉害的大魔女，无论在哪都陪着可莉，永远不会让可莉感到无聊！"
                },
                {
                    "id": "400130275",
                    "speaker": "可莉",
                    "text": "可莉最最最最喜欢妈妈啦！"
                },
                {
                    "id": "400130276",
                    "speaker": "可莉",
                    "text": "#荣誉骑士{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}，你喜欢可莉吗？"
                },
                {
                    "id": "400130277",
                    "speaker": "Player",
                    "text": "嗯。"
                },
                {
                    "id": "400130278",
                    "speaker": "可莉",
                    "text": "可莉也很爱你，你要陪着可莉在这里玩个够，否则，妈妈会觉得很可惜哦！"
                },
                {
                    "id": "400130279",
                    "speaker": "可莉",
                    "text": "我还有很多蹦蹦炸弹，还有嘟嘟可也一起…我带你去游泳、炸鱼！"
                },
                {
                    "id": "400130280",
                    "speaker": "派蒙",
                    "text": "跟可莉在一起就是开心！"
                },
                {
                    "id": "400130281",
                    "speaker": "可莉",
                    "text": "喂——快来呀——"
                },
                {
                    "id": "400130282",
                    "speaker": "派蒙",
                    "text": "别让可莉久等了，我们也快过去吧！"
                }
            ]
        },
        {
            "id": "4001303",
            "objective": "抓住鱼获取鳞片",
            "dialogues": []
        },
        {
            "id": "4001304",
            "objective": "(test)取得鳞片进度记录$HIDDEN",
            "dialogues": [
                {
                    "id": "400130401",
                    "speaker": "可莉",
                    "text": "#荣誉骑士{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}，要放鳞片了吗？"
                },
                {
                    "id": "400130402",
                    "speaker": "Player",
                    "text": "是的。"
                },
                {
                    "id": "400130403",
                    "speaker": "可莉",
                    "text": "可莉、可莉够不着…"
                },
                {
                    "id": "400130404",
                    "speaker": "Player",
                    "text": "那我来做可莉的帮手。"
                },
                {
                    "id": "400130405",
                    "speaker": "Player",
                    "text": "可莉说「好」，我再放，好吗？"
                },
                {
                    "id": "400130406",
                    "speaker": "可莉",
                    "text": "嗯，好！"
                },
                {
                    "id": "400130407",
                    "speaker": "可莉",
                    "text": "不过不过，可莉也不懂这些…"
                },
                {
                    "id": "400130408",
                    "speaker": "可莉",
                    "text": "可莉相信你！你替可莉放，肯定没问题！"
                },
                {
                    "id": "400130409",
                    "speaker": "派蒙",
                    "text": "那么，鱼鳞我们来放，最后最重要的机关就让可莉按吧。"
                },
                {
                    "id": "400130410",
                    "speaker": "可莉",
                    "text": "好啊好啊！"
                },
                {
                    "id": "400130411",
                    "speaker": "可莉",
                    "text": "终于要见到你了，嘟嘟大魔王！哼哼，显出原形！"
                },
                {
                    "id": "400130412",
                    "speaker": "琴",
                    "text": "可莉…兴致真高啊。"
                },
                {
                    "id": "400130413",
                    "speaker": "可莉",
                    "text": "#荣誉骑士{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}，加油呀，可莉给你打气！"
                }
            ]
        },
