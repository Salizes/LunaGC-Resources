        {
            "id": "501130",
            "objective": "击败魔物，破坏深渊界门",
            "dialogues": []
        },
        {
            "id": "501133",
            "objective": "(test)(hide)对话中途修改天气和scenetag$HIDDEN",
            "dialogues": [
                {
                    "id": "50113101",
                    "speaker": "派蒙",
                    "text": "那、那是什么…"
                },
                {
                    "id": "50113102",
                    "speaker": "阿乔",
                    "text": "恐惧和毁灭凝聚成实体，这团漆黑的灾厄终于打算把你们一口吃掉了！"
                },
                {
                    "id": "50113103",
                    "speaker": "派蒙",
                    "text": "还在幸灾乐祸，难道你不会被吃掉吗！"
                },
                {
                    "id": "50113104",
                    "speaker": "基尼奇",
                    "text": "难道那个就是深渊力量的源头？",
                    "choices": [
                        {
                            "id": "50113105",
                            "text": "它抛洒出了大量的深渊力量。",
                            "response": [
                                {
                                    "id": "50113107",
                                    "speaker": "基尼奇",
                                    "text": "我要赶紧去看看怎么回事，可能已经来不及了。"
                                },
                                {
                                    "id": "50113108",
                                    "speaker": "基尼奇",
                                    "text": "你们快去战报上提到的地方，这家伙出现之后，情况一定会恶化得非常快，没有时间了！"
                                },
                                {
                                    "id": "50113109",
                                    "speaker": "Player",
                                    "text": "知道了。"
                                },
                                {
                                    "id": "50113110",
                                    "speaker": "派蒙",
                                    "text": "平时没什么情绪起伏的基尼奇，都紧张到这种程度…"
                                },
                                {
                                    "id": "50113111",
                                    "speaker": "派蒙",
                                    "text": "#我们快走吧，{NICKNAME}，灾难真的发生了。"
                                }
                            ]
                        },
                        {
                            "id": "50113106",
                            "text": "这是对纳塔的总进攻。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "501131",
            "objective": "与基尼奇交谈",
            "dialogues": []
        },
        {
            "id": "501150",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "50115001",
                    "speaker": "达尔戈",
                    "text": "趁机喘口气，谁知道深渊的魔物还会不会出现…"
                }
            ]
        },
        {
            "id": "501151",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "50115101",
                    "speaker": "阿尔妲",
                    "text": "这些东西很重要，丢掉太可惜了。"
                },
                {
                    "id": "50115102",
                    "speaker": "科科庞",
                    "text": "唉，行吧，我来帮你。赶紧捡回来重新打包好。"
                }
            ]
        },
        {
            "id": "501152",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "50115201",
                    "speaker": "蓬普",
                    "text": "你们之后遇到了其他悬木人的讯使，都可以向他们了解现阶段各地的情况。"
                }
            ]
        },
        {
            "id": "501153",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "50115301",
                    "speaker": "阿奇亚库",
                    "text": "说起来，部族营地是什么情况？"
                },
                {
                    "id": "50115302",
                    "speaker": "瓦伊妲",
                    "text": "目前还算安全，但大家都去送信了，守备力量没那么充足，要是深渊魔物大量出现的话…"
                },
                {
                    "id": "50115303",
                    "speaker": "阿奇亚库",
                    "text": "那…就只能靠我们了吧。怎么，你不会害怕了吧。"
                },
                {
                    "id": "50115304",
                    "speaker": "瓦伊妲",
                    "text": "开什么玩笑。"
                }
            ]
        },
        {
            "id": "501154",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "50115401",
                    "speaker": "细心的匿叶龙",
                    "text": "……"
                }
            ]
        },
        {
            "id": "501155",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "50115501",
                    "speaker": "维莎",
                    "text": "我不要走，我要和妈妈在一起！"
                },
                {
                    "id": "50115502",
                    "speaker": "阿乌琪",
                    "text": "听话，妈妈受伤了，不能跟你们一起走。但没关系的，等把你送回去，叔叔阿姨就会把我也送回家。"
                },
                {
                    "id": "50115503",
                    "speaker": "维莎",
                    "text": "不行，我不要！"
                }
            ]
        },
        {
            "id": "501156",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "50115601",
                    "speaker": "勇猛的嵴锋龙",
                    "text": "……"
                }
            ]
        },
        {
            "id": "501157",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "50115701",
                    "speaker": "阿乔",
                    "text": "伟大的圣龙库胡勒阿乔正在休息，不想听到下贱生物的噪音，也不接受任何问询。"
                },
                {
                    "id": "50115702",
                    "speaker": "基尼奇",
                    "text": "谁问你了？"
                }
            ]
        },
        {
            "id": "501158",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "50115801",
                    "speaker": "瓦卡尔",
                    "text": "吓死我了，幸好没出什么事…"
                }
            ]
        },
        {
            "id": "501159",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "50115901",
                    "speaker": "雅蕾希",
                    "text": "冷静，冷静…要勇敢，要勇敢…"
                },
                {
                    "id": "50115902",
                    "speaker": "雅蕾希",
                    "text": "我是战士，我要站在普通人的前面，保护他们…"
                }
            ]
        },
        {
            "id": "501160",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "50116001",
                    "speaker": "阿卡马",
                    "text": "有阵子没穿这套装备了，让我回想起了很多事。"
                },
                {
                    "id": "50116002",
                    "speaker": "阿卡马",
                    "text": "…没想到还挺合身的嘛。"
                }
            ]
        },
        {
            "id": "501161",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "50116101",
                    "speaker": "古塞尼科夫",
                    "text": "正如「队长」大人所言，情况很不乐观，我们已经救下了好几队纳塔人。"
                },
                {
                    "id": "50116102",
                    "speaker": "古塞尼科夫",
                    "text": "不能在这里久留，等他们准备重新上路，我们的队伍也要赶紧去别的地方。"
                }
            ]
        },
        {
            "id": "501162",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "50116201",
                    "speaker": "卡马加",
                    "text": "没想到能得到愚人众的帮助，运气太好了…"
                }
            ]
        },
        {
            "id": "501163",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "50116301",
                    "speaker": "安蒂妮",
                    "text": "我觉得我们需要更多支援，这个地方很关键，光靠这点人还不够。"
                },
                {
                    "id": "50116302",
                    "speaker": "特沃德罗斯",
                    "text": "是啊，但现在哪里不缺人…"
                }
            ]
        },
        {
            "id": "501164",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "50116401",
                    "speaker": "马提库伊",
                    "text": "哈啊，哈啊…实在是走不动了，我要歇一会儿。"
                }
            ]
        },
        {
            "id": "501165",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "50116501",
                    "speaker": "伊莫莎",
                    "text": "太吓人了。跑到这里，还会有深渊魔物吗…"
                }
            ]
        },
        {
            "id": "501170",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "50117001",
                    "speaker": "阿尔妲",
                    "text": "原来是你们！看到你们没事，我们也安心了。"
                },
                {
                    "id": "50117002",
                    "speaker": "派蒙",
                    "text": "哦，你们平安回来了啊！"
                },
                {
                    "id": "50117003",
                    "speaker": "科科庞",
                    "text": "是的，达尔戈把我们送回来之后，马不停蹄地又去了其他地方。"
                },
                {
                    "id": "50117004",
                    "speaker": "阿尔妲",
                    "text": "多亏有你们帮忙，我们运送的医疗用品才能及时送达竞技场，真是太好了。"
                }
            ]
        },
        {
            "id": "501171",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "50117101",
                    "speaker": "细心的匿叶龙",
                    "text": "外面好危险，不能出去。你们最好也别出去哦。"
                }
            ]
        },
        {
            "id": "501172",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "50117201",
                    "speaker": "勇猛的嵴锋龙",
                    "text": "得救了，谢谢人类。讨厌的魔物要是再来，我把它们打出去。"
                }
            ]
        },
        {
            "id": "501173",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "50117301",
                    "speaker": "阿孔",
                    "text": "没想到委托一个接一个，一个接一个，要是平常应该还挺开心的…"
                },
                {
                    "id": "50117302",
                    "speaker": "波蒂薇",
                    "text": "现在感觉都不能叫「委托」了，收取报酬的那才是委托。"
                },
                {
                    "id": "50117303",
                    "speaker": "克维库",
                    "text": "就算没有报酬，冒险家们现在都行动起来了。不管什么样的人都能成为冒险家…"
                },
                {
                    "id": "50117304",
                    "speaker": "波蒂薇",
                    "text": "只有不愿冒险的人不行。"
                }
            ]
        },
        {
            "id": "501174",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "50117401",
                    "speaker": "阿卡马",
                    "text": "路上辛苦了，这些分给你。"
                },
                {
                    "id": "50117402",
                    "speaker": "阿卡马",
                    "text": "记得要补充能量，不然关键的时候会使不上劲的。"
                }
            ]
        },
        {
            "id": "501198",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "50119801",
                    "speaker": "Black Screen",
                    "text": ""
                }
            ]
        },
        {
            "id": "501199",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "50119901",
                    "speaker": "派蒙",
                    "text": "快看，就是他们被困住了吧！我们赶紧去帮忙！"
                },
                {
                    "id": "50119902",
                    "speaker": "达尔戈",
                    "text": "太好了，有人来帮我们了。"
                },
                {
                    "id": "50119907",
                    "speaker": "派蒙",
                    "text": "战报上说，这里也出现了很多魔物。"
                },
                {
                    "id": "50119908",
                    "speaker": "派蒙",
                    "text": "等等，正在和魔物战斗的是…愚人众？！"
                },
                {
                    "id": "50119909",
                    "speaker": "派蒙",
                    "text": "真的有很多人聚集到这里，看来已经不能随便到野外去了。"
                },
                {
                    "id": "50119910",
                    "speaker": "派蒙",
                    "text": "情况还在继续恶化吧…总之，我们还要继续战斗。"
                },
                {
                    "id": "50119915",
                    "speaker": "派蒙",
                    "text": "就是这里，他们正在战斗，我们快去吧！"
                },
                {
                    "id": "50119921",
                    "speaker": "派蒙",
                    "text": "哇，动起来了，挺方便的嘛！"
                },
                {
                    "id": "50119922",
                    "speaker": "派蒙",
                    "text": "这样不仅快，还能省好多力气！"
                },
                {
                    "id": "50119924",
                    "speaker": "派蒙",
                    "text": "屋子里好像聚集了很多人，都是来避难的吗？"
                }
            ]
        }
    ]
}