    "talks": [
        {
            "id": "501128",
            "objective": "离开「倦意之屋」，加入战斗",
            "dialogues": []
        },
        {
            "id": "501101",
            "objective": "与玛薇卡交谈，了解战况",
            "dialogues": [
                {
                    "id": "50110101",
                    "speaker": "玛薇卡",
                    "text": "我知道了，那这两个地方我会调度人手去帮忙。这里太危险了，我去。"
                },
                {
                    "id": "50110102",
                    "speaker": "玛薇卡",
                    "text": "至于剩下的位置，都比较偏远，人烟稀少，让战士们都先回来吧，注意不要在撤退的时候受伤。"
                },
                {
                    "id": "50110103",
                    "speaker": "通皮斯",
                    "text": "我知道了，我现在就和伙伴们去传达。"
                },
                {
                    "id": "50110104",
                    "speaker": "希诺宁",
                    "text": "我们来了，现在是什么情况，深渊又冒头了吗？"
                },
                {
                    "id": "50110105",
                    "speaker": "玛薇卡",
                    "text": "嗯，情况不乐观，之前深渊魔物还只是零星出现，部署在各处的队伍还有能力处理，但现在魔物更多，频率也更高了。"
                },
                {
                    "id": "50110106",
                    "speaker": "希诺宁",
                    "text": "范围呢，分布在什么地方？"
                },
                {
                    "id": "50110107",
                    "speaker": "玛薇卡",
                    "text": "纳塔全境，不只是竞技场附近，就连遥远的沃陆之邦也传来了被袭击的消息。"
                },
                {
                    "id": "50110108",
                    "speaker": "茜特菈莉",
                    "text": "这难道也是某种预兆吗？如果再继续这样下去…"
                },
                {
                    "id": "50110109",
                    "speaker": "玛薇卡",
                    "text": "很可能马上就没办法应对了。我明白这点，我认为深渊现在很急躁，因为它也知道，六位英雄现在只剩一人缺席。"
                },
                {
                    "id": "50110110",
                    "speaker": "玛薇卡",
                    "text": "我现在并没有与之一战的力量，这是它最好的机会，也是最后的机会。"
                },
                {
                    "id": "50110111",
                    "speaker": "派蒙",
                    "text": "所以说，现在只能靠我们硬撑了是吗？"
                },
                {
                    "id": "50110112",
                    "speaker": "玛薇卡",
                    "text": "会是一场持久战，现在最应该关注的是平民的安全，以及战力的保存。"
                },
                {
                    "id": "50110113",
                    "speaker": "玛薇卡",
                    "text": "现在有很多战士已经前往野外各处，解救被困在那里的商队和冒险者，但人手依然远远不够。"
                },
                {
                    "id": "50110114",
                    "speaker": "卡齐娜",
                    "text": "那就交给我们吧，我们现在都可以行动。"
                },
                {
                    "id": "50110115",
                    "speaker": "玛薇卡",
                    "text": "拜托了，希诺宁和卡齐娜去支援回声之子附近的营地。茜特菈莉的话，回烟谜主，那边的人需要你。"
                },
                {
                    "id": "50110116",
                    "speaker": "玛薇卡",
                    "text": "烟谜主距离圣火竞技场有一段路程，欧洛伦作为计划中最重要的六人之一，会留在这里。"
                },
                {
                    "id": "50110117",
                    "speaker": "茜特菈莉",
                    "text": "我知道了，那我马上回去。"
                },
                {
                    "id": "50110118",
                    "speaker": "玛薇卡",
                    "text": "这里准备了热气球，可以把你们送去目的地。"
                },
                {
                    "id": "50110119",
                    "speaker": "玛薇卡",
                    "text": "在完成任务之后，请将现状分享给奔波于各地的悬木人讯使，他们会将消息整合起来，做成战报。"
                },
                {
                    "id": "50110120",
                    "speaker": "玛薇卡",
                    "text": "我会根据各地的实时信息，为你们安排下一步行动的计划。"
                },
                {
                    "id": "50110121",
                    "speaker": "希诺宁",
                    "text": "好，那事不宜迟，我们先走了。"
                },
                {
                    "id": "50110122",
                    "speaker": "卡齐娜",
                    "text": "你们都要注意安全啊！"
                },
                {
                    "id": "50110123",
                    "speaker": "派蒙",
                    "text": "那我们呢，我们应该去什么地方？"
                },
                {
                    "id": "50110124",
                    "speaker": "玛薇卡",
                    "text": "根据讯使的情报，有一队护送平民前往竞技场的小队被深渊魔物缠上，他们虽然有抵抗的能力，但坚持不了太久。"
                },
                {
                    "id": "50110125",
                    "speaker": "玛薇卡",
                    "text": "他们就交给你了，没问题吧？"
                },
                {
                    "id": "50110126",
                    "speaker": "Player",
                    "text": "放心。"
                },
                {
                    "id": "50110127",
                    "speaker": "玛薇卡",
                    "text": "好，热气球就在那边，快去吧。"
                }
            ]
        },
        {
            "id": "501138",
            "objective": "查看地图，选择支援地点",
