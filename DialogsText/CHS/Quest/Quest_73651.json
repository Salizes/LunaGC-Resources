    },
    "talks": [
        {
            "id": "7365101",
            "objective": "与悬崖边的怪人对话",
            "dialogues": [
                {
                    "id": "736510101",
                    "speaker": "？？？",
                    "text": "嘿嘿嘿，哈哈哈…"
                },
                {
                    "id": "736510102",
                    "speaker": "？？？",
                    "text": "大功告成了！接下来就是论证环节了！我要向大家证明，这就是炼金药剂的最强形态！"
                },
                {
                    "id": "736510103",
                    "speaker": "派蒙",
                    "text": "…这个人怎么站在悬崖边傻笑？还不停自言自语？"
                },
                {
                    "id": "736510104",
                    "speaker": "派蒙",
                    "text": "#我感觉心里毛毛的，{NICKNAME}，我们离这个怪人远一点吧。",
                    "choices": [
                        {
                            "id": "736510105",
                            "text": "万一她有点想不开呢？",
                            "response": [
                                {
                                    "id": "736510107",
                                    "speaker": "派蒙",
                                    "text": "喂喂，你也太替别人着想了吧？"
                                },
                                {
                                    "id": "736510108",
                                    "speaker": "？？？",
                                    "text": "嗯？你们什么时候过来的？"
                                },
                                {
                                    "id": "736510109",
                                    "speaker": "？？？",
                                    "text": "居然在背后议论别人，真没礼貌！"
                                },
                                {
                                    "id": "736510110",
                                    "speaker": "哈贾娜德",
                                    "text": "我可是悉般多摩学院的明日之星哈贾娜德！等我成为知名的学者，一定要写篇文章来埋汰你们…"
                                },
                                {
                                    "id": "736510111",
                                    "speaker": "派蒙",
                                    "text": "好凶！名字也好拗口！"
                                },
                                {
                                    "id": "736510112",
                                    "speaker": "哈贾娜德",
                                    "text": "等等？这个小家伙难道是…那篇奇闻上的「白色高智能浮游助手单元」？"
                                },
                                {
                                    "id": "736510113",
                                    "speaker": "派蒙",
                                    "text": "什么胡说八道的奇闻，从没听过这种外号啦！"
                                },
                                {
                                    "id": "736510114",
                                    "speaker": "哈贾娜德",
                                    "text": "总之，带着「白色高智能浮游助手单元」的金发异乡人…不会错，我走运了。"
                                },
                                {
                                    "id": "736510115",
                                    "speaker": "哈贾娜德",
                                    "text": "呃咳！听我说，我可以让需要战斗的人变得更强。和我做个交易，怎么样？",
                                    "choices": [
                                        {
                                            "id": "736510116",
                                            "text": "好耳熟的展开…",
                                            "response": [
                                                {
                                                    "id": "736510118",
                                                    "speaker": "哈贾娜德",
                                                    "text": "不奇怪，提瓦特各地有不少像我一样的炼金术士，致力于发掘炼金术的最高价值。"
                                                },
                                                {
                                                    "id": "736510119",
                                                    "speaker": "哈贾娜德",
                                                    "text": "辅助战斗是炼金术的重要功能。如果能将药剂的效力发挥到极致，就有机会改写战斗的规则。"
                                                },
                                                {
                                                    "id": "736510120",
                                                    "speaker": "哈贾娜德",
                                                    "text": "以你们的见闻，应该遇到过其他钻研药剂的炼金术士吧。"
                                                },
                                                {
                                                    "id": "736510121",
                                                    "speaker": "哈贾娜德",
                                                    "text": "不过和我相比，其他炼金术士大多还在摸索，只有少数人取得了一点进展。"
                                                },
                                                {
                                                    "id": "736510122",
                                                    "speaker": "哈贾娜德",
                                                    "text": "比如一位蒙德的炼金术士，他发表了「广域散布雾化液体药剂，改变战斗环境」的研究论文…"
                                                },
                                                {
                                                    "id": "736510123",
                                                    "speaker": "哈贾娜德",
                                                    "text": "太幼稚了！就算增加了辅助挥发的成分，散布药剂的速度和浓度也不可能合格！"
                                                },
                                                {
                                                    "id": "736510124",
                                                    "speaker": "派蒙",
                                                    "text": "突然就变得滔滔不绝了，她好像要证明自己在这方面做得最好呢。"
                                                },
                                                {
                                                    "id": "736510125",
                                                    "speaker": "Player",
                                                    "text": "所以说，交易的内容…"
                                                },
                                                {
                                                    "id": "736510126",
                                                    "speaker": "派蒙",
                                                    "text": "对啊，哈贾娜德小姐，你做出了更强的药剂，打算特价卖给我们吗？"
                                                },
                                                {
                                                    "id": "736510127",
                                                    "speaker": "哈贾娜德",
                                                    "text": "问得好！我正要向你展示我的最新研究成果。"
                                                },
                                                {
                                                    "id": "736510128",
                                                    "speaker": "哈贾娜德",
                                                    "text": "我将两种高浓度的药剂制成片状的结晶，划分成许多小块，并将它们装入高压密封的炼金装置。"
                                                },
                                                {
                                                    "id": "736510129",
                                                    "speaker": "哈贾娜德",
                                                    "text": "需要使用药剂时，就点燃装置内的小型炸药，将两片药剂的一部分瞬间气化，充分混合。"
                                                },
                                                {
                                                    "id": "736510130",
                                                    "speaker": "哈贾娜德",
                                                    "text": "并且利用爆炸的压力，将药剂烟雾推出装置，散布在广阔的空间内，提供战斗的助力。"
                                                },
                                                {
                                                    "id": "736510131",
                                                    "speaker": "哈贾娜德",
                                                    "text": "我称这个过程为「重熔效应」，装置为「重熔装置」，药剂则叫「重熔片剂」。"
                                                },
                                                {
                                                    "id": "736510132",
                                                    "speaker": "派蒙",
                                                    "text": "重…重熔？"
                                                },
                                                {
                                                    "id": "736510133",
                                                    "speaker": "Player",
                                                    "text": "爆…爆炸？"
                                                },
                                                {
                                                    "id": "736510134",
                                                    "speaker": "哈贾娜德",
                                                    "text": "强而有力的爆炸后，空气中就充满了沁人心脾的芳香，使用者的力量也随之急速增长。"
                                                },
                                                {
                                                    "id": "736510135",
                                                    "speaker": "哈贾娜德",
                                                    "text": "怎么样？很诱人吧？不想试试吗？只需要在战斗中留意药剂的功效，帮我记录一些细节表现就行。"
                                                },
                                                {
                                                    "id": "736510136",
                                                    "speaker": "哈贾娜德",
                                                    "text": "当然，绝不是打白工，会有相当不错的佣金哦。"
                                                },
                                                {
                                                    "id": "736510137",
                                                    "speaker": "派蒙",
                                                    "text": "原来只想让我们来当实验品吗？听起来好危险！我们才不干咧！"
                                                },
                                                {
                                                    "id": "736510138",
                                                    "speaker": "派蒙",
                                                    "text": "要是出了意外，给我们一千倍佣金的赔偿，还勉强可以考虑考虑…"
                                                },
                                                {
                                                    "id": "736510139",
                                                    "speaker": "哈贾娜德",
                                                    "text": "没问题。反正我已经试验过很多次了，我的装置是绝对安全的！"
                                                },
                                                {
                                                    "id": "736510140",
                                                    "speaker": "派蒙",
                                                    "text": "这么干脆？",
                                                    "choices": [
                                                        {
                                                            "id": "736510141",
                                                            "text": "我们倒也不缺这点摩拉。",
                                                            "response": [
                                                                {
                                                                    "id": "736510143",
                                                                    "speaker": "哈贾娜德",
                                                                    "text": "唔…想来也是，毕竟是登上过奇闻刊物的人，肯定也家缠万贯…"
                                                                },
                                                                {
                                                                    "id": "736510144",
                                                                    "speaker": "哈贾娜德",
                                                                    "text": "那就…那就…求求你嘛。"
                                                                },
                                                                {
                                                                    "id": "736510145",
                                                                    "speaker": "哈贾娜德",
                                                                    "text": "之前对你们态度恶劣，还想用这点小钱收买你们，真的很对不起！"
                                                                },
                                                                {
                                                                    "id": "736510146",
                                                                    "speaker": "哈贾娜德",
                                                                    "text": "如果你们帮我完成试验，就是我的大恩人！等我成为了知名的学者，我一定不会亏待你们的！"
                                                                },
                                                                {
                                                                    "id": "736510147",
                                                                    "speaker": "派蒙",
                                                                    "text": "噫！突然就变脸了，还敢做出这种承诺…"
                                                                },
                                                                {
                                                                    "id": "736510148",
                                                                    "speaker": "Player",
                                                                    "text": "好势利。"
                                                                },
                                                                {
                                                                    "id": "736510149",
                                                                    "speaker": "哈贾娜德",
                                                                    "text": "说到底是我有求于人吧。需要依附别人的时候，最好端正姿态。"
                                                                },
                                                                {
                                                                    "id": "736510150",
                                                                    "speaker": "哈贾娜德",
                                                                    "text": "我知道这副嘴脸很难看，但你们以后十有八九还会碰到我这样的人。"
                                                                },
                                                                {
                                                                    "id": "736510151",
                                                                    "speaker": "哈贾娜德",
                                                                    "text": "起码我还会给你们报酬和承诺，有的人可能想着空手套白狼哦。这样一想，我还算挺实在的吧？"
                                                                },
                                                                {
                                                                    "id": "736510152",
                                                                    "speaker": "派蒙",
                                                                    "text": "呃，虽然这样揣测别人不礼貌，但好像也不是危言耸听…"
                                                                },
                                                                {
                                                                    "id": "736510153",
                                                                    "speaker": "Player",
                                                                    "text": "派蒙动摇了。"
                                                                },
                                                                {
                                                                    "id": "736510154",
                                                                    "speaker": "派蒙",
                                                                    "text": "话都说到这份上了，我也想看看她的炼金药剂究竟有多厉害啦。"
                                                                },
                                                                {
                                                                    "id": "736510155",
                                                                    "speaker": "派蒙",
                                                                    "text": "而且，我感觉她也没什么坏心眼，可能只因为搞研究太心急了，才给人一种怪怪的感觉。"
                                                                },
                                                                {
                                                                    "id": "736510156",
                                                                    "speaker": "派蒙",
                                                                    "text": "完成研究以后，也许她会变成一个不错的人呢？"
                                                                },
                                                                {
                                                                    "id": "736510157",
                                                                    "speaker": "哈贾娜德",
                                                                    "text": "哦？你们在商量测试装置的方法？"
                                                                },
                                                                {
                                                                    "id": "736510158",
                                                                    "speaker": "哈贾娜德",
                                                                    "text": "附近正好有一个秘境，根据其他冒险家的报告，很适合这次的战斗测试。"
                                                                },
                                                                {
                                                                    "id": "736510159",
                                                                    "speaker": "Player",
                                                                    "text": "你倒是一点也不客气…"
                                                                },
                                                                {
                                                                    "id": "736510160",
                                                                    "speaker": "哈贾娜德",
                                                                    "text": "我都把未来托付给你们两位了，你们也爽快点嘛！"
                                                                },
                                                                {
                                                                    "id": "736510161",
                                                                    "speaker": "派蒙",
                                                                    "text": "唔…反正和普通的冒险委托也没太多区别，那就上吧，我们去秘境里试试这个装置。"
                                                                },
                                                                {
                                                                    "id": "736510162",
                                                                    "speaker": "哈贾娜德",
                                                                    "text": "好，一言为定！我就在附近等着你们的好消息哦。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "736510142",
                                                            "text": "我不需要炼金术也能变强。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "736510117",
                                            "text": "好像听到过这种话…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "736510106",
                            "text": "为了防止她突然冲动…"
                        }
                    ]
                }
            ]
        }
    ]
}