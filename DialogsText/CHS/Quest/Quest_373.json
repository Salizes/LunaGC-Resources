    "talks": [
        {
            "id": "37301",
            "objective": "前往风起地",
            "dialogues": [
                {
                    "id": "3730101",
                    "speaker": "派蒙",
                    "text": "唔…你觉得他的声音熟悉吗？但我完全没听出来耶…"
                }
            ]
        },
        {
            "id": "37302",
            "objective": "与温迪对话",
            "dialogues": [
                {
                    "id": "3730201",
                    "speaker": "温迪",
                    "text": "欸？你怎么来了？"
                },
                {
                    "id": "3730202",
                    "speaker": "温迪",
                    "text": "虽然我刚才还在想，你是不是会跟来…"
                },
                {
                    "id": "3730203",
                    "speaker": "Player",
                    "text": "我想知道更多风神的事。"
                },
                {
                    "id": "3730204",
                    "speaker": "温迪",
                    "text": "风神巴巴托斯？那家伙已经从蒙德消失了。"
                },
                {
                    "id": "3730205",
                    "speaker": "温迪",
                    "text": "邻国璃月的岩神、稻妻的雷神都还在，但蒙德人已经很久没见过他们的神了。"
                },
                {
                    "id": "3730206",
                    "speaker": "温迪",
                    "text": "为什么要打听风神的事？是因为特瓦林吗？"
                },
                {
                    "id": "3730207",
                    "speaker": "派蒙",
                    "text": "啊，这个嘛…是因为「神」…"
                },
                {
                    "id": "3730208",
                    "speaker": "Player",
                    "text": "嗯，有人告诉我龙的过往。"
                },
                {
                    "id": "3730209",
                    "speaker": "温迪",
                    "text": "哦？大家现在是怎么看待「风魔龙」的？我很感兴趣。"
                },
                {
                    "id": "3730210",
                    "speaker": "温迪",
                    "text": "不过，也不用那么急着说给我听——"
                },
                {
                    "id": "3730211",
                    "speaker": "温迪",
                    "text": "很久没回这里了，好像有些东西对我的到来很不满呢。"
                }
            ]
        },
        {
            "id": "37303",
            "objective": "击败来袭的敌人",
            "dialogues": [
                {
                    "id": "3730301",
                    "speaker": "派蒙",
                    "text": "风——吹得——睁不开眼睛——"
                }
            ]
        },
        {
            "id": "37304",
            "objective": "与温迪对话",
            "dialogues": [
                {
                    "id": "3730401",
                    "speaker": "温迪",
                    "text": "呼…风向的变化，影响的不止是龙…"
                },
                {
                    "id": "3730402",
                    "speaker": "温迪",
                    "text": "对了，刚才你说，有人告诉你龙的过往？"
                }
            ]
        }
    ]
