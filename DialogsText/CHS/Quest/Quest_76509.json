    "talks": [
        {
            "id": "7650901",
            "objective": "到郊外散步",
            "dialogues": [
                {
                    "id": "765090101",
                    "speaker": "维斯菈娃",
                    "text": "好你个「热心商人」…怎么，买卖做到这样的地方来了？"
                },
                {
                    "id": "765090102",
                    "speaker": "埃德勒",
                    "text": "唉，你不懂，像我们这样兜里空空的平民，看到了哪有商机，就像野狗嗅到了煮得香喷喷的骨头一样…"
                },
                {
                    "id": "765090103",
                    "speaker": "维斯菈娃",
                    "text": "哼，惯会贫嘴…"
                },
                {
                    "id": "765090104",
                    "speaker": "维斯菈娃",
                    "text": "还是多看看你眼前的局势吧，我看你也是马上要「兵败如山倒」了。"
                },
                {
                    "id": "765090105",
                    "speaker": "埃德勒",
                    "text": "#我看未必…正好，{NICKNAME}您也来了啊，快来帮我看看，怎么在这位的手下「逆转颓势」？"
                },
                {
                    "id": "765090106",
                    "speaker": "派蒙",
                    "text": "哼哼，那你们可算问对人啦！"
                },
                {
                    "id": "765090107",
                    "speaker": "Player",
                    "text": "和我之前玩的有些不同…"
                },
                {
                    "id": "765090108",
                    "speaker": "埃德勒",
                    "text": "啊，没错，来一个新地方「做生意」，总是要做出一些特别的改变的，你面前的是我改良过的、最新版的兵棋推演。"
                },
                {
                    "id": "765090109",
                    "speaker": "埃德勒",
                    "text": "总之，就是玩法更丰富的推演——现在，有「战线领队」，有不同作用的旗帜…玩起来就会更像是在指挥一支真正的军队了！"
                },
                {
                    "id": "765090110",
                    "speaker": "埃德勒",
                    "text": "只不过和客人推销到半路时，被这位搅了买卖。"
                },
                {
                    "id": "765090111",
                    "speaker": "埃德勒",
                    "text": "为了证明我卖的是合法商品，不被这位报警抓起来，我只好和她来上一盘，以证明我卖的东西不是什么危险的「军事武器」。"
                },
                {
                    "id": "765090112",
                    "speaker": "维斯菈娃",
                    "text": "你又自顾自说上了半天啊…啊，您一定是大名鼎鼎的旅行者吧，还有这位，最好的向导派蒙，久仰久仰！"
                },
                {
                    "id": "765090113",
                    "speaker": "维斯菈娃",
                    "text": "没想到我们这位热心的枫丹商人人脉竟如此惊人…两位声名远播，今天我终于有幸一窥真容了。"
                },
                {
                    "id": "765090114",
                    "speaker": "维斯菈娃",
                    "text": "我叫维斯菈娃，是一个…「热心保镖」。"
                },
                {
                    "id": "765090115",
                    "speaker": "维斯菈娃",
                    "text": "只可惜这盘推演还没结束，不然我一定现在就好好招待你们。",
                    "choices": [
                        {
                            "id": "765090116",
                            "text": "（真招待还是真「招待」。）",
                            "response": [
                                {
                                    "id": "765090118",
                                    "speaker": "派蒙",
                                    "text": "嘿嘿，不用这么客气！"
                                },
                                {
                                    "id": "765090119",
                                    "speaker": "派蒙",
                                    "text": "你人还是蛮不错的嘛！以前碰到像你这样打扮的，呃…一般二话不说就是要先打一架的！"
                                },
                                {
                                    "id": "765090120",
                                    "speaker": "维斯菈娃",
                                    "text": "啊哈，现在是休假期，一般情况下，能动手的时候也尽量不动手，更何况…总之，现在我怎么都不会对您动手。"
                                },
                                {
                                    "id": "765090121",
                                    "speaker": "Player",
                                    "text": "但你们看起来要动手了。"
                                },
                                {
                                    "id": "765090122",
                                    "speaker": "派蒙",
                                    "text": "对啊！刚刚过来的时候，虽然你俩只是在玩兵棋推演，但感觉气氛很紧张，看来是误会…"
                                },
                                {
                                    "id": "765090123",
                                    "speaker": "维斯菈娃",
                                    "text": "想切磋切磋？不错的主意。"
                                },
                                {
                                    "id": "765090124",
                                    "speaker": "埃德勒",
                                    "text": "也不是不行…"
                                },
                                {
                                    "id": "765090125",
                                    "speaker": "派蒙",
                                    "text": "喂喂喂！只是打个比方啦，你俩怎么一副当真的样子！"
                                },
                                {
                                    "id": "765090126",
                                    "speaker": "埃德勒",
                                    "text": "哈哈，别担心，我们也只是开玩笑。"
                                },
                                {
                                    "id": "765090127",
                                    "speaker": "埃德勒",
                                    "text": "不过看来我这个新商品还有调节矛盾的作用——在紧急关头，两位正欲要战的人掏出了这款新版兵棋推演…"
                                },
                                {
                                    "id": "765090128",
                                    "speaker": "埃德勒",
                                    "text": "哎呀，废话多了，不如你直接上手试试！"
                                },
                                {
                                    "id": "765090129",
                                    "speaker": "Player",
                                    "text": "好主意。"
                                },
                                {
                                    "id": "765090130",
                                    "speaker": "埃德勒",
                                    "text": "或者，你先来帮我打败她？"
                                },
                                {
                                    "id": "765090131",
                                    "speaker": "维斯菈娃",
                                    "text": "不许请外援！"
                                }
                            ]
                        },
                        {
                            "id": "765090117",
                            "text": "（这个人看起来很危险。）"
                        }
                    ]
                }
            ]
        }
    ]
}