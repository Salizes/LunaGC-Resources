    "talks": [
        {
            "id": "201101",
            "objective": "向凯瑟琳打听前往稻妻的情报",
            "dialogues": [
                {
                    "id": "20110101",
                    "speaker": "凯瑟琳",
                    "text": "旅行者，有什么可以帮你的吗？",
                    "choices": [
                        {
                            "id": "20110102",
                            "text": "关于前往稻妻的事…",
                            "response": [
                                {
                                    "id": "20110104",
                                    "speaker": "凯瑟琳",
                                    "text": "嗯，我听说了，你们和南十字船队的大姐头约好了，会带你们前往稻妻是吧？"
                                },
                                {
                                    "id": "20110105",
                                    "speaker": "凯瑟琳",
                                    "text": "确实已经过去蛮久了，我这边倒也没有什么值得注意的情报…"
                                },
                                {
                                    "id": "20110106",
                                    "speaker": "海龙",
                                    "text": "可找到你了！你就是大姐头看好的那个旅行者吧？",
                                    "choices": [
                                        {
                                            "id": "20110107",
                                            "text": "等你很久了！",
                                            "response": [
                                                {
                                                    "id": "20110108",
                                                    "speaker": "海龙",
                                                    "text": "是吗哈哈，可真是荣幸。"
                                                },
                                                {
                                                    "id": "20110110",
                                                    "speaker": "海龙",
                                                    "text": "我们船队的补给工作已经做得差不多了，到了清点人头的环节了。"
                                                },
                                                {
                                                    "id": "20110111",
                                                    "speaker": "海龙",
                                                    "text": "大姐头派我来找你，说等你一到就开船。"
                                                },
                                                {
                                                    "id": "20110112",
                                                    "speaker": "派蒙",
                                                    "text": "北斗果然是个很守约的人呢。"
                                                },
                                                {
                                                    "id": "20110113",
                                                    "speaker": "海龙",
                                                    "text": "那是当然，大姐头身上让人死心塌地的地方可多得是，等出了航，你们就慢慢体会吧。"
                                                },
                                                {
                                                    "id": "20110114",
                                                    "speaker": "凯瑟琳",
                                                    "text": "二位这就准备离开了吗？还是要恭喜你们呢。"
                                                },
                                                {
                                                    "id": "20110115",
                                                    "speaker": "凯瑟琳",
                                                    "text": "不论前路是星辰还是深渊，能向前迈出下一步都是值得庆贺的事。"
                                                },
                                                {
                                                    "id": "20110116",
                                                    "speaker": "凯瑟琳",
                                                    "text": "那我们就再见吧，祝你们一路顺风~！",
                                                    "choices": [
                                                        {
                                                            "id": "20110117",
                                                            "text": "凯瑟琳小姐…",
                                                            "response": [
                                                                {
                                                                    "id": "20110119",
                                                                    "speaker": "派蒙",
                                                                    "text": "是啊，有些舍不得，毕竟我们几乎天天都会见面呢。"
                                                                },
                                                                {
                                                                    "id": "20110120",
                                                                    "speaker": "凯瑟琳",
                                                                    "text": "呵呵，既然如此，到了稻妻就快点找到我哦？我会在鸣神岛等着你们的。",
                                                                    "choices": [
                                                                        {
                                                                            "id": "20110121",
                                                                            "text": "……",
                                                                            "response": [
                                                                                {
                                                                                    "id": "20110123",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "果然稻妻也有一个凯瑟琳小姐吗！那就不要这么郑重其事的告别啦！"
                                                                                },
                                                                                {
                                                                                    "id": "20110124",
                                                                                    "speaker": "海龙",
                                                                                    "text": "哈哈，跟璃月好好道个别吧，船还停在孤云阁附近，既然通知到了你们，我就先回去了。"
                                                                                },
                                                                                {
                                                                                    "id": "20110125",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "嗯，辛苦你跑一趟了！"
                                                                                },
                                                                                {
                                                                                    "id": "20110126",
                                                                                    "speaker": "海龙",
                                                                                    "text": "没事，咱们船上见。"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "20110122",
                                                                            "text": "…我就知道！"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "20110118",
                                                            "text": "我们会想念你的。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "20110109",
                                            "text": "情报送上门来了。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "20110103",
                            "text": "关于南十字船队的事…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "201102",
            "objective": "登上「死兆星」号，寻找北斗",
            "dialogues": []
        },
        {
            "id": "201103",
            "objective": "与北斗对话",
            "dialogues": [
                {
                    "id": "20110301",
                    "speaker": "北斗",
                    "text": "哟，你们终于来了。"
                },
                {
                    "id": "20110302",
                    "speaker": "北斗",
                    "text": "过去连暴风雨都没法让「南十字船队」耽搁，这次我可是给足了你们面子啊。",
                    "choices": [
                        {
                            "id": "20110303",
                            "text": "久等了，大姐头。",
                            "response": [
                                {
                                    "id": "20110305",
                                    "speaker": "北斗",
                                    "text": "哈哈哈，玩笑话而已。你们来得正好，出海工作刚刚就绪。"
                                },
                                {
                                    "id": "20110306",
                                    "speaker": "北斗",
                                    "text": "既然人都到齐了，也是时候——"
                                },
                                {
                                    "id": "20110307",
                                    "speaker": "北斗",
                                    "text": "朝着雷霆骤雨所包围的「永恒」国度，起航！"
                                },
                                {
                                    "id": "20110308",
                                    "speaker": "派蒙",
                                    "text": "出发！"
                                }
                            ]
                        },
                        {
                            "id": "20110304",
                            "text": "荣幸之至！"
                        }
                    ]
                }
            ]
        },
        {
            "id": "201104",
            "objective": "前往稻妻",
            "dialogues": []
        },
        {
            "id": "201105",
            "objective": "前往稻妻",
            "dialogues": []
        },
        {
            "id": "201106",
            "objective": "前往稻妻",
            "dialogues": []
        },
        {
            "id": "201107",
            "objective": "与接洽人托马对话",
            "dialogues": [
                {
                    "id": "20110701",
                    "speaker": "托马",
                    "text": "终于来了，「璃月人的大姐头」，可让我好等。"
                },
                {
                    "id": "20110702",
                    "speaker": "托马",
                    "text": "还有这两位偷渡客…哦不，贵客。"
                },
                {
                    "id": "20110703",
                    "speaker": "派蒙",
                    "text": "嘘！"
                },
                {
                    "id": "20110704",
                    "speaker": "北斗",
                    "text": "还不是因为你们的将军大人，最近稻妻外海的雷暴和风浪比之前还要强烈了…"
                },
                {
                    "id": "20110705",
                    "speaker": "北斗",
                    "text": "我的船队尽管大显身手了一番，但还是耽误了些时间。"
                },
                {
                    "id": "20110706",
                    "speaker": "北斗",
                    "text": "哦对了，给你们介绍一下，这位是托马，算是我最近才熟络的商业伙伴。"
                },
                {
                    "id": "20110707",
                    "speaker": "托马",
                    "text": "哟，我一直很期待见到你们。"
                },
                {
                    "id": "20110708",
                    "speaker": "北斗",
                    "text": "托马，这两位是…"
                },
                {
                    "id": "20110709",
                    "speaker": "托马",
                    "text": "不用介绍了，异乡旅人的名望，可是外海的暴风雨都拦不住的，早就如雷贯耳了。",
                    "choices": [
                        {
                            "id": "20110710",
                            "text": "你好，托马。",
                            "response": [
                                {
                                    "id": "20110712",
                                    "speaker": "派蒙",
                                    "text": "你说话真好听，嘿嘿。"
                                },
                                {
                                    "id": "20110713",
                                    "speaker": "北斗",
                                    "text": "嗯，这样倒也方便了。"
                                },
                                {
                                    "id": "20110714",
                                    "speaker": "北斗",
                                    "text": "#{NICKNAME}，托马在离岛混迹了很长一段时间了，说他是这里的地头蛇也不为过。"
                                },
                                {
                                    "id": "20110715",
                                    "speaker": "北斗",
                                    "text": "如果有什么难处就找他吧，但如果他对你图谋不轨…等下次来稻妻，我会替你出头的。"
                                },
                                {
                                    "id": "20110716",
                                    "speaker": "托马",
                                    "text": "哈哈哈…放心放心，我预感我们会相处很愉快的。"
                                },
                                {
                                    "id": "20110717",
                                    "speaker": "北斗",
                                    "text": "那时间差不多了，毕竟我的船上还藏了个「通缉犯」，不方便久留。"
                                },
                                {
                                    "id": "20110718",
                                    "speaker": "派蒙",
                                    "text": "是说万叶呀…"
                                },
                                {
                                    "id": "20110719",
                                    "speaker": "北斗",
                                    "text": "下次再见吧，旅行者，不管你在稻妻遇上什么「惊涛骇浪」，都要好好给我捱过去啊！",
                                    "choices": [
                                        {
                                            "id": "20110720",
                                            "text": "我可是自信满满。",
                                            "response": [
                                                {
                                                    "id": "20110722",
                                                    "speaker": "派蒙",
                                                    "text": "拜拜，一路顺风，北斗船长。"
                                                },
                                                {
                                                    "id": "20110723",
                                                    "speaker": "托马",
                                                    "text": "那么，还是先去监察站登记一下吧。"
                                                },
                                                {
                                                    "id": "20110724",
                                                    "speaker": "派蒙",
                                                    "text": "欸，要去直面稻妻的官方人员吗？不是说偷偷地…"
                                                },
                                                {
                                                    "id": "20110725",
                                                    "speaker": "托马",
                                                    "text": "哈哈，可不要小瞧「锁国令」啊，查验身份的事，躲是躲不过的。"
                                                },
                                                {
                                                    "id": "20110726",
                                                    "speaker": "托马",
                                                    "text": "所以我们要规规矩矩地…把不规矩的事儿给办了。",
                                                    "choices": [
                                                        {
                                                            "id": "20110727",
                                                            "text": "好、好吧。"
                                                        },
                                                        {
                                                            "id": "20110728",
                                                            "text": "有点紧张起来了。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "20110721",
                                            "text": "很期待下次见面！"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "20110711",
                            "text": "过奖，过奖。"
                        }
                    ]
                }
            ]
        }
    ]
}