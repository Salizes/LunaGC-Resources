    "talks": [
        {
            "id": "7406101",
            "objective": "(test)靠近办公室入口$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7406102",
            "objective": "与德瑟布尔对话",
            "dialogues": [
                {
                    "id": "740610201",
                    "speaker": "德瑟布尔",
                    "text": "有没有人能帮我一个忙啊？求求你们了，帮帮我这个可怜人吧！"
                },
                {
                    "id": "740610202",
                    "speaker": "派蒙",
                    "text": "你还好吗？"
                },
                {
                    "id": "740610203",
                    "speaker": "德瑟布尔",
                    "text": "哦，天啊！终于遇到一个好心人了。是这样的，明天就是我儿子的生日了，我想给他写一封信。"
                },
                {
                    "id": "740610204",
                    "speaker": "德瑟布尔",
                    "text": "然而如果要向外面送信的话，就必须在这里排队。可我现在根本没有这个时间…"
                },
                {
                    "id": "740610205",
                    "speaker": "派蒙",
                    "text": "啊？为什么啊？"
                },
                {
                    "id": "740610206",
                    "speaker": "德瑟布尔",
                    "text": "生产区出现了很严重的安全事故，我必须迅速到场处理。因此我想找个人帮忙排队，但…"
                },
                {
                    "id": "740610207",
                    "speaker": "德瑟布尔",
                    "text": "唉…我知道，这都是报应。可、可我的儿子他没有错啊。为什么要让我的错误变成对他的惩罚呢？"
                },
                {
                    "id": "740610208",
                    "speaker": "德瑟布尔",
                    "text": "我只是想给他写一封信，告诉他爸爸没有忘记他的生日，爸爸很爱他。可惜就连这个我都没办法做到…"
                },
                {
                    "id": "740610209",
                    "speaker": "派蒙",
                    "text": "#他听上去好可怜。{NICKNAME}我们帮帮他吧？"
                },
                {
                    "id": "740610210",
                    "speaker": "德瑟布尔",
                    "text": "真的吗？虽然我现在手头也不是很宽裕，但我一定会按市场价给你们结算报酬的！"
                },
                {
                    "id": "740610211",
                    "speaker": "Player",
                    "text": "市场价？"
                },
                {
                    "id": "740610212",
                    "speaker": "德瑟布尔",
                    "text": "对，我帮人排过队，我知道价格的。"
                },
                {
                    "id": "740610213",
                    "speaker": "派蒙",
                    "text": "没关系，重点不在报酬上面啦！"
                },
                {
                    "id": "740610214",
                    "speaker": "德瑟布尔",
                    "text": "太感谢了！你们真是好人。对了，我还没有问你们的名字呢。我叫德瑟布尔，请问两位的名字是？"
                },
                {
                    "id": "740610215",
                    "speaker": "派蒙",
                    "text": "#我是派蒙，{M#他}{F#她}是{NICKNAME}，我们是一起冒险的好伙伴！"
                },
                {
                    "id": "740610216",
                    "speaker": "德瑟布尔",
                    "text": "#这个是我想要送出去的信，把它直接交给里面那个叫卢茨的就好。派蒙和{NICKNAME}，一切就拜托你们了。"
                },
                {
                    "id": "740610217",
                    "speaker": "派蒙",
                    "text": "嘿嘿，你放心，就交给我们吧！"
                },
                {
                    "id": "740610218",
                    "speaker": "Black Screen",
                    "text": "德瑟布尔将东西交到你们手中后便匆忙地离开了。\\n过了良久你和派蒙方才发现，那看似稀疏的队伍有如凝固住了一般，完全没有向前移动分毫。\\n正在此时，你们的身后某两人的对话响起，引走了你们的注意。"
                },
                {
                    "id": "740610219",
                    "speaker": "疲惫的男人",
                    "text": "唉，好慢啊。空气也好闷，我都快喘不过来气了…"
                },
                {
                    "id": "740610220",
                    "speaker": "开朗的男人",
                    "text": "年轻人，你是第一次来这里排队？这里的排队时间，可是出了名的久，整个梅洛彼得堡无人不知无人不晓。"
                },
                {
                    "id": "740610221",
                    "speaker": "开朗的男人",
                    "text": "毕竟卢茨总是管不住他那个边打字边往信里添油加醋的老毛病嘛。大家都要花很多时间检查的。"
                },
                {
                    "id": "740610222",
                    "speaker": "疲惫的男人",
                    "text": "很多时间？哎呦，天啊，我的腿都软了。"
                },
                {
                    "id": "740610223",
                    "speaker": "开朗的男人",
                    "text": "哈哈，那你千万要撑住。万一一不小心晕过去的话，那就要明天重新来过了。我们这里有人可是来了三次都没把信送出去。"
                },
                {
                    "id": "740610224",
                    "speaker": "疲惫的男人",
                    "text": "三次？这也太倒霉了吧…"
                },
                {
                    "id": "740610225",
                    "speaker": "开朗的男人",
                    "text": "谁说不是呢！也只有他才能创造三次排队都惨遭失败的传说。因此我们都叫他倒霉的德瑟布尔。"
                },
                {
                    "id": "740610226",
                    "speaker": "开朗的男人",
                    "text": "你既然这么有兴趣的话，我就给你讲讲这个传说。"
                },
                {
                    "id": "740610227",
                    "speaker": "疲惫的男人",
                    "text": "说实话我没有那个心情。"
                },
                {
                    "id": "740610228",
                    "speaker": "开朗的男人",
                    "text": "别这样嘛，高兴点。咳咳，那是在前天，一个闷热的下午…"
                },
                {
                    "id": "740610229",
                    "speaker": "疲惫的男人",
                    "text": "我都说了…唉，算了，你讲吧…"
                },
                {
                    "id": "740610230",
                    "speaker": "开朗的男人",
                    "text": "在那个下午，德瑟布尔他找到我，说是自己在下一天要排队送信，希望我帮忙顶替他在特许食堂的搬运工作。"
                },
                {
                    "id": "740610231",
                    "speaker": "开朗的男人",
                    "text": "我本因为嫌麻烦不想答应的。结果他可怜巴巴地说自己上一次排队因为早上一不小心睡过了没排上。而他的儿子还在等他的信。"
                },
                {
                    "id": "740610232",
                    "speaker": "开朗的男人",
                    "text": "最后我心一软就给答应帮忙了。但等我昨天下了班，你猜怎么着？我发现他又在找人代班，还是说自己要送信。"
                },
                {
                    "id": "740610233",
                    "speaker": "开朗的男人",
                    "text": "我就凑过去问他发生了什么。他回答说，他吸取了自己前天的教训，一大早就起了床。可还是发生了意外依旧没把信送出去。"
                },
                {
                    "id": "740610234",
                    "speaker": "疲惫的男人",
                    "text": "总不能是排错了队伍吧。"
                },
                {
                    "id": "740610235",
                    "speaker": "开朗的男人",
                    "text": "比那可有趣多了。他告诉我说，为了赶早来排队，他连饭都没顾得上吃，结果排到下午的时候他就坚持不住了。"
                },
                {
                    "id": "740610236",
                    "speaker": "开朗的男人",
                    "text": "他本打算硬撑着熬过去，结果没想到突然就眼前一黑，「哐啷」一声晕了过去。等再醒来的时候，排队都已经结束了。"
                },
                {
                    "id": "740610237",
                    "speaker": "疲惫的男人",
                    "text": "哈哈哈，真是个…等等我好像也没有吃饭。完了，我怎么突然感觉肚子开始响了…"
                },
                {
                    "id": "740610238",
                    "speaker": "派蒙",
                    "text": "他们说的，不会是德瑟布尔先生吧？没想在这里排队是这么辛苦的事情…还好我们随身带着吃的！",
                    "choices": [
                        {
                            "id": "740610239",
                            "text": "没错，还有派蒙在呢！",
                            "response": [
                                {
                                    "id": "740610240",
                                    "speaker": "派蒙",
                                    "text": "唔唔，虽然听着是在夸我，但感觉好奇怪…"
                                },
                                {
                                    "id": "740610243",
                                    "speaker": "Black Screen",
                                    "text": "漫长的排队时光烦闷且枯燥，身处其中的你们已然渐渐忘记了自己的任务。\\n只有少数人那略显聒噪的闲聊在提醒着时间的流逝。"
                                },
                                {
                                    "id": "740610244",
                                    "speaker": "疲惫的男人",
                                    "text": "我真的有点晕了…完了，我不会也要明天才能把信送出去吧。"
                                },
                                {
                                    "id": "740610245",
                                    "speaker": "开朗的男人",
                                    "text": "先拿这个垫垫肚子吧。记住了，准备好干粮和水，可是在这里排队的常识。"
                                },
                                {
                                    "id": "740610246",
                                    "speaker": "疲惫的男人",
                                    "text": "谢谢，可这也太夸张了…我们真的是在说排队吗？"
                                },
                                {
                                    "id": "740610247",
                                    "speaker": "开朗的男人",
                                    "text": "哼，听好了新人。这里是梅洛彼得堡中最残酷的战场，即使是拳力斗技场也不及它的分毫！"
                                },
                                {
                                    "id": "740610248",
                                    "speaker": "疲惫的男人",
                                    "text": "啊，可这未免也太…"
                                },
                                {
                                    "id": "740610249",
                                    "speaker": "开朗的男人",
                                    "text": "每一个排队者都会制定详尽的计划，有些人会带上凳子用来休息，而更极端的人则会在晚上睡在门口等待开门！"
                                },
                                {
                                    "id": "740610250",
                                    "speaker": "疲惫的男人",
                                    "text": "不就是个排队而已…"
                                },
                                {
                                    "id": "740610251",
                                    "speaker": "开朗的男人",
                                    "text": "年轻人，这不是一场普通的排队，这是战争！每个人都应该全力以赴！就连倒霉的德瑟布尔都准备好了各种预案。"
                                },
                                {
                                    "id": "740610252",
                                    "speaker": "疲惫的男人",
                                    "text": "……"
                                },
                                {
                                    "id": "740610253",
                                    "speaker": "开朗的男人",
                                    "text": "但很遗憾，预案并没有拯救他失败的命运。我刚刚从生产区回来的时候，看见他离开队伍在向特许食堂那边移动。"
                                },
                                {
                                    "id": "740610254",
                                    "speaker": "开朗的男人",
                                    "text": "于是我就问他，哟，怎么不排队了？你猜他怎么回答？"
                                },
                                {
                                    "id": "740610255",
                                    "speaker": "开朗的男人",
                                    "text": "他太过专注于之前的经验了。结果他忘记了最重要的事情，那就是带上他要寄的信！因此只能重新来过了。"
                                },
                                {
                                    "id": "740610256",
                                    "speaker": "疲惫的男人",
                                    "text": "…听你这么一说，我突然很想认识一下这位先生了。"
                                },
                                {
                                    "id": "740610257",
                                    "speaker": "派蒙",
                                    "text": "欸？！没带信！德瑟布尔先生真的好倒霉啊…",
                                    "choices": [
                                        {
                                            "id": "740610258",
                                            "text": "那我们拿到的是个什么？",
                                            "response": [
                                                {
                                                    "id": "740610260",
                                                    "speaker": "派蒙",
                                                    "text": "对哦！信不是在我们手里吗？唔，我开始搞不懂了…"
                                                },
                                                {
                                                    "id": "740610261",
                                                    "speaker": "Player",
                                                    "text": "我们打开信看一眼吧…"
                                                },
                                                {
                                                    "id": "740610262",
                                                    "speaker": "派蒙",
                                                    "text": "我看看都写了些什么啊…呜哇！好可怕，这都是什么啊，感觉跟生日和德瑟布尔先生完全没有关系呢。",
                                                    "choices": [
                                                        {
                                                            "id": "740610263",
                                                            "text": "（各种信息都对不上。）",
                                                            "response": [
                                                                {
                                                                    "id": "740610265",
                                                                    "speaker": "派蒙",
                                                                    "text": "#{NICKNAME}快到我们了，我们要不先把信交上去吧！"
                                                                },
                                                                {
                                                                    "id": "740610266",
                                                                    "speaker": "Black Screen",
                                                                    "text": "这一切或许是有意义的，因为你们终于结束了这次堪称折磨的等待。\\n然而这对你而言并不算解脱，毕竟仍有一个疑惑萦绕在你的心头。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "740610264",
                                                            "text": "（一会要好好问问他…）"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "740610259",
                                            "text": "他不是把信给我们了？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "740610241",
                            "text": "毕竟派蒙永远都饥肠辘辘的呢…",
                            "response": [
                                {
                                    "id": "740610242",
                                    "speaker": "派蒙",
                                    "text": "嘿嘿，填饱肚子是最重要的事情啦。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7406103",
            "objective": "离开发信室",
            "dialogues": []
        },
        {
            "id": "7406104",
            "objective": "与德瑟布尔对话",
            "dialogues": [
                {
                    "id": "740610401",
                    "speaker": "德瑟布尔",
                    "text": "唉，两位两位。呼——赶上了。"
                },
                {
                    "id": "740610402",
                    "speaker": "派蒙",
                    "text": "你怎么气喘吁吁的？"
                },
                {
                    "id": "740610403",
                    "speaker": "德瑟布尔",
                    "text": "我刚把废弃生产区那边的事情办完，就赶紧跑过来了。"
                },
                {
                    "id": "740610404",
                    "speaker": "德瑟布尔",
                    "text": "怎么样事情办好了吗？信是不是已经送出去了？太好了！",
                    "choices": [
                        {
                            "id": "740610405",
                            "text": "信上的署名是纯白铃兰。",
                            "response": [
                                {
                                    "id": "740610407",
                                    "speaker": "德瑟布尔",
                                    "text": "啊？原来那小姑娘给自己起了这么个名字…"
                                },
                                {
                                    "id": "740610408",
                                    "speaker": "德瑟布尔",
                                    "text": "好吧，实话说吧，这封信是一个小姑娘托我来寄的，我看她病得厉害就答应了，甚至分文未取！给你们的报酬可是我自掏腰包…"
                                },
                                {
                                    "id": "740610409",
                                    "speaker": "派蒙",
                                    "text": "欸？！",
                                    "choices": [
                                        {
                                            "id": "740610410",
                                            "text": "看信的内容的确病得不轻。",
                                            "response": [
                                                {
                                                    "id": "740610412",
                                                    "speaker": "德瑟布尔",
                                                    "text": "一定是我出门的时候拿错信了。坏了，这下要赶不上我儿子他的生日了…"
                                                },
                                                {
                                                    "id": "740610413",
                                                    "speaker": "派蒙",
                                                    "text": "啊？今天居然是拿错了信？德瑟布尔先生就和传说中一样倒霉呢。"
                                                },
                                                {
                                                    "id": "740610414",
                                                    "speaker": "德瑟布尔",
                                                    "text": "可能这就是我的命运吧。唉，不跟你们说了，我要赶快回去取信。希望还来得及。"
                                                },
                                                {
                                                    "id": "740610415",
                                                    "speaker": "德瑟布尔",
                                                    "text": "两位这是你们的报酬，合作愉快。我还要给儿子送信，下次再见！"
                                                },
                                                {
                                                    "id": "740610416",
                                                    "speaker": "派蒙",
                                                    "text": "啊啊怎么这就走了！明明还有一堆问题想问…"
                                                },
                                                {
                                                    "id": "740610417",
                                                    "speaker": "派蒙",
                                                    "text": "算了，反正有特许券就没问题。欸？！怎么才这么点？这还不够吃一顿饭的呢!",
                                                    "choices": [
                                                        {
                                                            "id": "740610418",
                                                            "text": "看来今晚要挨饿了。",
                                                            "response": [
                                                                {
                                                                    "id": "740610419",
                                                                    "speaker": "派蒙",
                                                                    "text": "不要啦，我好饿，呜呜呜。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "740610420",
                                                            "text": "要不我们再接一次排队的委托？",
                                                            "response": [
                                                                {
                                                                    "id": "740610421",
                                                                    "speaker": "派蒙",
                                                                    "text": "那我宁愿饿着啦！"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "740610411",
                                            "text": "真的假的…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "740610406",
                            "text": "你就是纯白铃兰？"
                        }
                    ]
                }
            ]
        }
    ]
}