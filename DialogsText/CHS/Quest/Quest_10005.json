    "talks": [
        {
            "id": "1000501",
            "objective": "前往龙脊雪山",
            "dialogues": []
        },
        {
            "id": "1000502",
            "objective": "与阿贝多对话",
            "dialogues": [
                {
                    "id": "100051301",
                    "speaker": "？？？",
                    "text": "阿贝多，难得见到你这么闲。"
                },
                {
                    "id": "100051302",
                    "speaker": "？？？",
                    "text": "不过，既然完成了莱茵多特主人留下的「课题」，你确实也应该放松放松。"
                },
                {
                    "id": "100051303",
                    "speaker": "派蒙",
                    "text": "你看！你话都没说完，麻烦就找上门了啊！"
                },
                {
                    "id": "100051304",
                    "speaker": "阿贝多",
                    "text": "赛巴斯，你怎么来了？"
                },
                {
                    "id": "100051305",
                    "speaker": "Player",
                    "text": "阿贝多认识它？"
                },
                {
                    "id": "100051306",
                    "speaker": "阿贝多",
                    "text": "是，它也是我老师莱茵多特的造物，勉强算是我的「家庭成员」吧。"
                },
                {
                    "id": "100051307",
                    "speaker": "Player",
                    "text": "不愧是你的家庭关系。"
                },
                {
                    "id": "100051308",
                    "speaker": "赛巴斯",
                    "text": "勉强？你这是什么口气，那么大一个屋子，就我一个管家。"
                },
                {
                    "id": "100051309",
                    "speaker": "赛巴斯",
                    "text": "你和莱茵多特主人用过的瓶瓶罐罐，可都是我一只猫来清理的。"
                },
                {
                    "id": "100051310",
                    "speaker": "派蒙",
                    "text": "你…不是一只猫吗？猫要怎么做管家啊，还要收拾瓶瓶罐罐…"
                },
                {
                    "id": "100051311",
                    "speaker": "赛巴斯",
                    "text": "你怎么会飞在天上？"
                },
                {
                    "id": "100051312",
                    "speaker": "派蒙",
                    "text": "欸？我一直都会啊。"
                },
                {
                    "id": "100051313",
                    "speaker": "赛巴斯",
                    "text": "我也一直都会。请不要把事实当做问题，这种问题找不到答案。"
                },
                {
                    "id": "100051314",
                    "speaker": "派蒙",
                    "text": "你，你你你…好生气！我要…",
                    "choices": [
                        {
                            "id": "100051315",
                            "text": "它的主人是莱茵多特…",
                            "response": [
                                {
                                    "id": "100051317",
                                    "speaker": "派蒙",
                                    "text": "我…我要拒绝听它讲话了！"
                                },
                                {
                                    "id": "100051318",
                                    "speaker": "赛巴斯",
                                    "text": "闲话就到此为止。阿贝多，我此次前来，是受莱茵多特主人所命，向你递送口信。"
                                },
                                {
                                    "id": "100051319",
                                    "speaker": "赛巴斯",
                                    "text": "咳咳…咳！"
                                },
                                {
                                    "id": "100051320",
                                    "speaker": "「莱茵多特」",
                                    "text": "「亲爱的阿贝多，很高兴你为那个课题找到了『自己认可的解』。」"
                                },
                                {
                                    "id": "100051321",
                                    "speaker": "「莱茵多特」",
                                    "text": "「不过，被解答后的问题，就失去了为之思考的意义。」"
                                },
                                {
                                    "id": "100051322",
                                    "speaker": "「莱茵多特」",
                                    "text": "「你脑子里那枚闲不下来的钟摆，现在应该已经快要摆向『无聊』那一端了吧？」"
                                },
                                {
                                    "id": "100051323",
                                    "speaker": "「莱茵多特」",
                                    "text": "「那么，你不如尝试一下，自己向自己提问吧。」"
                                },
                                {
                                    "id": "100051324",
                                    "speaker": "「莱茵多特」",
                                    "text": "「丢开『已知的答案』，寻找『未知的问题』。」"
                                },
                                {
                                    "id": "100051325",
                                    "speaker": "「莱茵多特」",
                                    "text": "「问题总是比答案更有趣的，也更能打发时间。」"
                                },
                                {
                                    "id": "100051326",
                                    "speaker": "「莱茵多特」",
                                    "text": "「我很期待，下次见面时，你会给我带来什么样的『问题』。」"
                                },
                                {
                                    "id": "100051327",
                                    "speaker": "「莱茵多特」",
                                    "text": "「如果你能找到连我都未曾设想过的问题，那就最好了。」"
                                },
                                {
                                    "id": "100051328",
                                    "speaker": "「莱茵多特」",
                                    "text": "「虽然这种可能性不太大，但你还是先努努力吧，如果你运气够好，说不定真能吓我一跳。」"
                                },
                                {
                                    "id": "100051329",
                                    "speaker": "「莱茵多特」",
                                    "text": "「对了，别想着造一个专门用来思考或者回答问题的『自己』。师父我已经试过了，压根没用。」"
                                },
                                {
                                    "id": "100051330",
                                    "speaker": "「莱茵多特」",
                                    "text": "「最后说一句，我让赛巴斯顺便给你带了一份礼物，注意收起来，也别喂它吃东西，它根本不会饿。」"
                                },
                                {
                                    "id": "100051331",
                                    "speaker": "阿贝多",
                                    "text": "谨遵老师教诲。"
                                },
                                {
                                    "id": "100051332",
                                    "speaker": "赛巴斯",
                                    "text": "咳，咳咳咳，莱茵多特主人就说了这么多…真是费劲，咳咳…咳…"
                                },
                                {
                                    "id": "100051333",
                                    "speaker": "赛巴斯",
                                    "text": "你已经听到口信了，我就不在这个冷得要命的地方陪你玩了。我接下来还得去蒙德城里送口信呢。"
                                },
                                {
                                    "id": "100051334",
                                    "speaker": "Player",
                                    "text": "蒙德城？"
                                },
                                {
                                    "id": "100051335",
                                    "speaker": "派蒙",
                                    "text": "蒙德城里还有和莱茵多特有关的人…啊！难道说…"
                                },
                                {
                                    "id": "100051336",
                                    "speaker": "赛巴斯",
                                    "text": "虽然他刚刚「诞生不久」，但莱茵多特主人早已预见了他所需要解决的「课题」。"
                                },
                                {
                                    "id": "100051337",
                                    "speaker": "赛巴斯",
                                    "text": "好了好了，我真的要走了，这地方太冷，冻得我尾巴痛。"
                                },
                                {
                                    "id": "100051338",
                                    "speaker": "赛巴斯",
                                    "text": "莱茵多特主人给你的「礼物」我放桌上了，记得收好。"
                                },
                                {
                                    "id": "100051339",
                                    "speaker": "派蒙",
                                    "text": "阿贝多…你的家庭关系，好像越来越复杂了呢…"
                                },
                                {
                                    "id": "100051340",
                                    "speaker": "Player",
                                    "text": "又突然冒出来这么一只猫…"
                                },
                                {
                                    "id": "100051341",
                                    "speaker": "派蒙",
                                    "text": "但话又说回来，这只猫真的能算成你的「家庭成员」吗？虽然它自称是管家什么的…"
                                },
                                {
                                    "id": "100051342",
                                    "speaker": "阿贝多",
                                    "text": "赛巴斯确实很早就被老师创造出来了。如果按照一般人的理论，赛巴斯应该算是我的「长辈」。"
                                },
                                {
                                    "id": "100051343",
                                    "speaker": "阿贝多",
                                    "text": "不过，鉴于我们并不是一般的「家庭」，所以这一层关系也没有意义。"
                                },
                                {
                                    "id": "100051344",
                                    "speaker": "阿贝多",
                                    "text": "但我当时的确受了赛巴斯不少照顾，它除了帮我收拾瓶瓶罐罐外，有时候甚至会当我的素描模特。"
                                },
                                {
                                    "id": "100051345",
                                    "speaker": "派蒙",
                                    "text": "等一下，你今天画的这只猫，难道就是赛巴斯？"
                                },
                                {
                                    "id": "100051346",
                                    "speaker": "阿贝多",
                                    "text": "没错。这是我的一个习惯，在思考某些问题时，我会让我的手进行一些无意识的工作，以此来辅助思考。"
                                },
                                {
                                    "id": "100051347",
                                    "speaker": "阿贝多",
                                    "text": "这个时候，我一般就会选择默画赛巴斯的画像…毕竟画了不知道多少遍，已经很熟练了，基本不用动脑。",
                                    "choices": [
                                        {
                                            "id": "100051348",
                                            "text": "这么一说…",
                                            "response": [
                                                {
                                                    "id": "100051350",
                                                    "speaker": "派蒙",
                                                    "text": "我还以为那就是普普通通的一只小猫呢！怎么来头也这么大…"
                                                },
                                                {
                                                    "id": "100051351",
                                                    "speaker": "阿贝多",
                                                    "text": "现在，你知道这只猫的真名了。之后要是有空，我可以为你们多讲一些它和我的故事。"
                                                },
                                                {
                                                    "id": "100051352",
                                                    "speaker": "阿贝多",
                                                    "text": "但现在…"
                                                },
                                                {
                                                    "id": "100051353",
                                                    "speaker": "「莱茵多特」",
                                                    "text": "「树为最完美的果实骄傲，它是如此圆满而无瑕疵。」"
                                                },
                                                {
                                                    "id": "100051354",
                                                    "speaker": "「莱茵多特」",
                                                    "text": "「但是寄宿了梦的种子啊，不要止当果壳中的宇宙之王。」"
                                                },
                                                {
                                                    "id": "100051355",
                                                    "speaker": "阿贝多",
                                                    "text": "…我要继续思考了。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "100051349",
                                            "text": "之前确实见过阿贝多画猫…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "100051316",
                            "text": "派蒙，不然还是…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1000502",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "100050201",
                    "speaker": "派蒙",
                    "text": "阿贝多，你果然在这里呀。嗯…你是在画画么？"
                },
                {
                    "id": "100050202",
                    "speaker": "阿贝多",
                    "text": "嗯，之前太忙没空画画，最近正好闲下来，想着重新捡起画笔，练习一下。"
                },
                {
                    "id": "100050203",
                    "speaker": "Player",
                    "text": "之前确实经历好多事。"
                },
                {
                    "id": "100050204",
                    "speaker": "阿贝多",
                    "text": "是啊。但好在有你们和骑士团的大家协助，算是有惊无险地解决了那件事。"
                },
                {
                    "id": "100050205",
                    "speaker": "阿贝多",
                    "text": "而且，我还完成了老师留给我的最后一个课题。"
                },
                {
                    "id": "100050206",
                    "speaker": "阿贝多",
                    "text": "要论结果，可以说是再完美不过了。"
                },
                {
                    "id": "100050207",
                    "speaker": "阿贝多",
                    "text": "砂糖最近也学习得很快，已经能独立处理很多和炼金相关的事务了。"
                },
                {
                    "id": "100050208",
                    "speaker": "阿贝多",
                    "text": "骑士团暂时也没什么需要我出面解决的事…"
                },
                {
                    "id": "100050209",
                    "speaker": "阿贝多",
                    "text": "没有课题，没有事务，没有麻烦…",
                    "choices": [
                        {
                            "id": "100050210",
                            "text": "怎么了？",
                            "response": [
                                {
                                    "id": "100050212",
                                    "speaker": "阿贝多",
                                    "text": "没什么。我想，或许是习惯了每天都高频用脑的日子吧…"
                                },
                                {
                                    "id": "100050213",
                                    "speaker": "阿贝多",
                                    "text": "就这样完全地闲下来，老实说，我还真的有点不适应。"
                                },
                                {
                                    "id": "100050214",
                                    "speaker": "阿贝多",
                                    "text": "总是不由自主地思考，还有什么问题等待着我去解决。"
                                },
                                {
                                    "id": "100050215",
                                    "speaker": "阿贝多",
                                    "text": "但是很遗憾，在目前的蒙德城，似乎所有问题都已经有了「完美的解」…"
                                },
                                {
                                    "id": "100050216",
                                    "speaker": "派蒙",
                                    "text": "休息一下也没什么不好啊，要是每天都忙忙碌碌的，那身体不就累坏了？"
                                },
                                {
                                    "id": "100050217",
                                    "speaker": "派蒙",
                                    "text": "实在不行，就和我们一起出去玩吧，我可是很懂怎么偷懒的喔！"
                                },
                                {
                                    "id": "100050218",
                                    "speaker": "阿贝多",
                                    "text": "呵呵，那就要请派蒙好好教教我了。",
                                    "choices": [
                                        {
                                            "id": "100050219",
                                            "text": "要是你真想找点麻烦解决…",
                                            "response": [
                                                {
                                                    "id": "100050221",
                                                    "speaker": "派蒙",
                                                    "text": "呸呸呸，不许说！每次你说这种话的时候，麻烦就会——"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "100050220",
                                            "text": "那也好办，只要有我在…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "100050211",
                            "text": "是遇见新麻烦了？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1000512",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "100051201",
                    "speaker": "阿贝多",
                    "text": "…新的，问题…"
                }
            ]
        },
