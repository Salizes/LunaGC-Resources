    "talks": [
        {
            "id": "45109",
            "objective": "前往奔狼领$HIDDEN",
            "dialogues": []
        },
        {
            "id": "45101",
            "objective": "前往奔狼领",
            "dialogues": [
                {
                    "id": "4510101",
                    "speaker": "派蒙",
                    "text": "这里叫做「奔狼领」，据说蒙德的人很少涉足这里…"
                },
                {
                    "id": "4510102",
                    "speaker": "派蒙",
                    "text": "虽然就在蒙德城附近，但这里生态原始，是一个自然法则至上的地方。"
                },
                {
                    "id": "4510103",
                    "speaker": "派蒙",
                    "text": "正所谓弱肉强食，连史莱姆都能长得很巨大哦！"
                },
                {
                    "id": "4510104",
                    "speaker": "派蒙",
                    "text": "看，就是这——么巨大。"
                },
                {
                    "id": "4510105",
                    "speaker": "Player",
                    "text": "…它们进攻过来了！做好准备！"
                }
            ]
        },
        {
            "id": "45102",
            "objective": "与派蒙对话$HIDDEN",
            "dialogues": []
        },
        {
            "id": "45107",
            "objective": "与派蒙对话",
            "dialogues": []
        },
        {
            "id": "45103",
            "objective": "消灭史莱姆",
            "dialogues": [
                {
                    "id": "4510301",
                    "speaker": "派蒙",
                    "text": "谢…谢谢你——奔狼领的狼群来了！快逃吧！"
                },
                {
                    "id": "4510303",
                    "speaker": "？？？",
                    "text": "不用担心。 狼是朋友。 可，你们是谁？"
                },
                {
                    "id": "4510304",
                    "speaker": "派蒙",
                    "text": "我们只是普通的旅行者……"
                },
                {
                    "id": "4510305",
                    "speaker": "？？？",
                    "text": "不普通，你们。 不过，有熟悉的气味。"
                },
                {
                    "id": "4510306",
                    "speaker": "派蒙",
                    "text": "熟悉的气味？"
                },
                {
                    "id": "4510307",
                    "speaker": "？？？",
                    "text": "骑士团，对吧？骑士团里有朋友。",
                    "choices": [
                        {
                            "id": "4510308",
                            "text": "你叫什么名字？",
                            "response": [
                                {
                                    "id": "4510310",
                                    "speaker": "雷泽",
                                    "text": "我是雷泽。"
                                },
                                {
                                    "id": "4510311",
                                    "speaker": "派蒙",
                                    "text": "你也是西风骑士团的人吗？"
                                },
                                {
                                    "id": "4510312",
                                    "speaker": "雷泽",
                                    "text": "和骑士团没关系。"
                                },
                                {
                                    "id": "4510314",
                                    "speaker": "派蒙",
                                    "text": "呜啊…"
                                },
                                {
                                    "id": "4510315",
                                    "speaker": "Player",
                                    "text": "狼群…是怎么回事？"
                                },
                                {
                                    "id": "4510316",
                                    "speaker": "雷泽",
                                    "text": "啊……狼群，是家人。"
                                },
                                {
                                    "id": "4510317",
                                    "speaker": "派蒙",
                                    "text": "家人？"
                                },
                                {
                                    "id": "4510318",
                                    "speaker": "雷泽",
                                    "text": "家人。将我养大，和我一起生活的家人。"
                                },
                                {
                                    "id": "4510319",
                                    "speaker": "派蒙",
                                    "text": "好像这中间有很复杂的故事……"
                                },
                                {
                                    "id": "4510320",
                                    "speaker": "雷泽",
                                    "text": "他们在责怪我。为了帮助你们，埋伏暴露了。没有抓到野猪。"
                                },
                                {
                                    "id": "4510321",
                                    "speaker": "派蒙",
                                    "text": "#这样吗…那就让{NICKNAME}来帮忙抓野猪吧。"
                                },
                                {
                                    "id": "4510322",
                                    "speaker": "派蒙",
                                    "text": "#{NICKNAME}也是很厉害的。"
                                },
                                {
                                    "id": "4510323",
                                    "speaker": "雷泽",
                                    "text": "我，我觉得不必了。骑士团的朋友每次动手，狼群都要饿肚子…"
                                },
                                {
                                    "id": "4510324",
                                    "speaker": "派蒙",
                                    "text": "不用和我们客气啦。你们就等着我们的好消息吧。"
                                }
                            ]
                        },
                        {
                            "id": "4510309",
                            "text": "你也是骑士团的人吗？",
                            "response": [
                                {
                                    "id": "4510313",
                                    "speaker": "雷泽",
                                    "text": "我是雷泽。 和骑士团没有关系。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "45104",
            "objective": "感谢相助的少年",
            "dialogues": []
        },
        {
            "id": "45105",
            "objective": "获取足够的兽肉",
            "dialogues": [
                {
                    "id": "4510501",
                    "speaker": "雷泽",
                    "text": "啊，你们真的要帮忙吗…"
                },
                {
                    "id": "4510502",
                    "speaker": "雷泽",
                    "text": "狼群有自己的方法，更有效。不过陷阱，很新鲜。"
                },
                {
                    "id": "4510503",
                    "speaker": "雷泽",
                    "text": "放置好以后，把野猪赶过去，对吧。"
                },
                {
                    "id": "4510504",
                    "speaker": "雷泽",
                    "text": "不会爆炸吧…"
                }
            ]
        },
        {
            "id": "45108",
            "objective": "狩猎提示$HIDDEN",
            "dialogues": [
                {
                    "id": "4510801",
                    "speaker": "派蒙",
                    "text": "哼哼，那么是时候拿出真正的本事了。"
                }
            ]
        },
        {
            "id": "45106",
            "objective": "将三块兽肉带给雷泽",
            "dialogues": [
                {
                    "id": "4510601",
                    "speaker": "派蒙",
                    "text": "你看，我们弄到了！"
                },
                {
                    "id": "4510602",
                    "speaker": "雷泽",
                    "text": "谢谢你们。不过…"
                },
                {
                    "id": "4510603",
                    "speaker": "雷泽",
                    "text": "不过要是我们自己来，能抓五六头。有狼今晚要空肚子了…"
                },
                {
                    "id": "4510604",
                    "speaker": "派蒙",
                    "text": "呜啊…"
                },
                {
                    "id": "4510605",
                    "speaker": "雷泽",
                    "text": "不要在意，谢谢你们。"
                },
                {
                    "id": "4510606",
                    "speaker": "雷泽",
                    "text": "你们比起骑士团那个红色，看起来很烫的女孩子——朋友，要厉害多了。"
                },
                {
                    "id": "4510607",
                    "speaker": "雷泽",
                    "text": "她出手的话，估计山会烧起来。猪，一头也抓不到。"
                },
                {
                    "id": "4510608",
                    "speaker": "雷泽",
                    "text": "我该走了。"
                },
                {
                    "id": "4510609",
                    "speaker": "雷泽",
                    "text": "最近这里不安全。你们小心，保护好自己。"
                },
                {
                    "id": "4510610",
                    "speaker": "派蒙",
                    "text": "真是奇特的人啊。"
                },
                {
                    "id": "4510611",
                    "speaker": "派蒙",
                    "text": "他提到的骑士团那个朋友。红色，很烫的女孩子——"
                },
                {
                    "id": "4510612",
                    "speaker": "派蒙",
                    "text": "#{NICKNAME}，你想到了谁？"
                }
            ]
        }
    ]
}