    "talks": [
        {
            "id": "102001",
            "objective": "前往天衡山",
            "dialogues": [
                {
                    "id": "10200101",
                    "speaker": "派蒙",
                    "text": "看！天上那个就是「群玉阁」了。",
                    "choices": [
                        {
                            "id": "10200102",
                            "text": "好高啊。",
                            "response": [
                                {
                                    "id": "10200104",
                                    "speaker": "派蒙",
                                    "text": "唔…唔…"
                                },
                                {
                                    "id": "10200105",
                                    "speaker": "派蒙",
                                    "text": "失策了！作为向导的我，好像并不知道通往「天上」的路在哪里…",
                                    "choices": [
                                        {
                                            "id": "10200106",
                                            "text": "现在才发现这一点吗…",
                                            "response": [
                                                {
                                                    "id": "10200108",
                                                    "speaker": "派蒙",
                                                    "text": "呜…"
                                                },
                                                {
                                                    "id": "10200109",
                                                    "speaker": "派蒙",
                                                    "text": "不过，既然要去群玉阁，那直接在地图上找群玉阁的位置，也是很合理的！"
                                                },
                                                {
                                                    "id": "10200110",
                                                    "speaker": "派蒙",
                                                    "text": "一定是在附近就有上去的办法吧？我们找找！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "10200107",
                                            "text": "当时应该问问那位叫做甘雨的使者。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "10200103",
                            "text": "要怎么上去呢？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "102002",
            "objective": "寻找前往群玉阁的方法",
            "dialogues": [
                {
                    "id": "10200201",
                    "speaker": "派蒙",
                    "text": "快看，这里有机关！"
                },
                {
                    "id": "10200202",
                    "speaker": "派蒙",
                    "text": "既然出现在对应的位置，那肯定是跟群玉阁有关。",
                    "choices": [
                        {
                            "id": "10200203",
                            "text": "会是通往群玉阁的路吗？",
                            "response": [
                                {
                                    "id": "10200204",
                                    "speaker": "派蒙",
                                    "text": "错不了！"
                                }
                            ]
                        },
                        {
                            "id": "10200205",
                            "text": "会是普通的陷阱吗？",
                            "response": [
                                {
                                    "id": "10200206",
                                    "speaker": "派蒙",
                                    "text": "怎么会？要相信我的直觉！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "102003",
            "objective": "尝试操控机关",
            "dialogues": []
        },
        {
            "id": "102007",
            "objective": "(test)派蒙对话$HIDDEN",
            "dialogues": [
                {
                    "id": "10200701",
                    "speaker": "派蒙",
                    "text": "哎哎？只能飞到这里…"
                },
                {
                    "id": "10200702",
                    "speaker": "派蒙",
                    "text": "都怪风场不够厉害，不然就能直接上到顶啦！"
                },
                {
                    "id": "10200703",
                    "speaker": "Player",
                    "text": "回璃月港吧…找千岩军打听一下。"
                },
                {
                    "id": "10200704",
                    "speaker": "派蒙",
                    "text": "嗯？为什么？"
                },
                {
                    "id": "10200705",
                    "speaker": "Player",
                    "text": "上去的方法应该不是秘密，否则…"
                },
                {
                    "id": "10200706",
                    "speaker": "派蒙",
                    "text": "否则？…喔，我明白了，否则甘雨让我们自己拜访群玉阁，就说不通了，对吧？"
                },
                {
                    "id": "10200707",
                    "speaker": "派蒙",
                    "text": "好吧，那就按你说的办吧，我们…"
                },
                {
                    "id": "10200708",
                    "speaker": "派蒙",
                    "text": "啊！先等一等，你看下面。"
                },
                {
                    "id": "10200709",
                    "speaker": "派蒙",
                    "text": "原来我们已经走到<color=#00E1FFFF>「归终机」</color>附近了呀。"
                },
                {
                    "id": "10200710",
                    "speaker": "派蒙",
                    "text": "这样的话…唔…我有个新点子！"
                },
                {
                    "id": "10200711",
                    "speaker": "派蒙",
                    "text": "——不如，用「归终机」把你发射上去吧？",
                    "choices": [
                        {
                            "id": "10200712",
                            "text": "不了，会死的。",
                            "response": [
                                {
                                    "id": "10200713",
                                    "speaker": "派蒙",
                                    "text": "唔呃…这么说来，确实没有考虑到安全细节…"
                                },
                                {
                                    "id": "10200716",
                                    "speaker": "Player",
                                    "text": "不过我记得，归终机有望远的功能。"
                                },
                                {
                                    "id": "10200717",
                                    "speaker": "派蒙",
                                    "text": "啊，对哦！"
                                },
                                {
                                    "id": "10200718",
                                    "speaker": "派蒙",
                                    "text": "这么说来，确实可以利用…那就靠归终机来找找看，附近还有没有上去的路吧！"
                                }
                            ]
                        },
                        {
                            "id": "10200714",
                            "text": "难道你很恨我吗？",
                            "response": [
                                {
                                    "id": "10200715",
                                    "speaker": "派蒙",
                                    "text": "唔呃…只是没有考虑到安全细节而已…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "102004",
            "objective": "前往归终机附近",
            "dialogues": [
                {
                    "id": "10200401",
                    "speaker": "华清",
                    "text": "站住！"
                },
                {
                    "id": "10200402",
                    "speaker": "华清",
                    "text": "什么人，竟敢私闯重地！",
                    "choices": [
                        {
                            "id": "10200403",
                            "text": "私闯？我们只是路过…",
                            "response": [
                                {
                                    "id": "10200405",
                                    "speaker": "派蒙",
                                    "text": "是啊是啊，真不懂你们在说什么！"
                                },
                                {
                                    "id": "10200406",
                                    "speaker": "派蒙",
                                    "text": "我们是受邀来这里的，是贵客！凭什么这样对我们…"
                                },
                                {
                                    "id": "10200407",
                                    "speaker": "派蒙",
                                    "text": "不…等一下…难道凝光…她是故意的！"
                                },
                                {
                                    "id": "10200408",
                                    "speaker": "派蒙",
                                    "text": "她假装请我们上群玉阁，其实在这里埋伏了千岩军，想要把我们抓起来！",
                                    "choices": [
                                        {
                                            "id": "10200409",
                                            "text": "我觉得不是这样…",
                                            "response": [
                                                {
                                                    "id": "10200411",
                                                    "speaker": "派蒙",
                                                    "text": "呜啊——我生气了！那边的士兵，你们这是钓鱼执法！无耻！"
                                                },
                                                {
                                                    "id": "10200412",
                                                    "speaker": "华清",
                                                    "text": "什么…正常的守卫任务，怎么就无耻了？"
                                                },
                                                {
                                                    "id": "10200413",
                                                    "speaker": "阿阳",
                                                    "text": "一派胡言，总之，先把可疑人士控制起来再说！"
                                                },
                                                {
                                                    "id": "10200414",
                                                    "speaker": "派蒙",
                                                    "text": "要来了，把他们统统打趴下！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "10200410",
                                            "text": "还没跟他们解释邀请的事…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "10200404",
                            "text": "重地？这里只是天衡山的野外…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "102005",
            "objective": "与千岩军战斗",
            "dialogues": []
        },
        {
            "id": "102006",
            "objective": "(test)战斗后对话$HIDDEN",
            "dialogues": [
                {
                    "id": "10200601",
                    "speaker": "？？？",
                    "text": "住手！何事喧哗？"
                },
                {
                    "id": "10200602",
                    "speaker": "华清",
                    "text": "刻晴大人，这两个怪人突然出现，似乎对归终机有所图谋。"
                },
                {
                    "id": "10200603",
                    "speaker": "派蒙",
                    "text": "你、你说谁是怪人！"
                },
                {
                    "id": "10200604",
                    "speaker": "Player",
                    "text": "我只是在找前往群玉阁的路。"
                },
                {
                    "id": "10200605",
                    "speaker": "刻晴",
                    "text": "嗯？你们要上「群玉阁」？你们是谁？"
                },
                {
                    "id": "10200606",
                    "speaker": "派蒙",
                    "text": "我们是受邀请的客人，想找「璃月七星」！你又是谁呀？"
                },
                {
                    "id": "10200607",
                    "speaker": "刻晴",
                    "text": "……"
                },
                {
                    "id": "10200608",
                    "speaker": "刻晴",
                    "text": "真巧，我就是「璃月七星」。"
                },
                {
                    "id": "10200609",
                    "speaker": "派蒙",
                    "text": "？？？"
                },
                {
                    "id": "10200610",
                    "speaker": "刻晴",
                    "text": "我是刻晴，璃月七星之一的「玉衡星」。"
                },
                {
                    "id": "10200611",
                    "speaker": "刻晴",
                    "text": "我知道你的事，旅行者，你是凝光的客人吧？没想到会在山间偶遇。"
                },
                {
                    "id": "10200612",
                    "speaker": "派蒙",
                    "text": "哇——我也没想到会在荒郊野岭遇见有钱的大人物。"
                },
                {
                    "id": "10200613",
                    "speaker": "刻晴",
                    "text": "天衡古城垣的归终机损坏，却在一夜之间修复完好。我在这里，原本是想调查一番。"
                },
                {
                    "id": "10200614",
                    "speaker": "刻晴",
                    "text": "这些千岩军只是负责守卫现场，不是来抓人的。"
                },
                {
                    "id": "10200615",
                    "speaker": "派蒙",
                    "text": "原来是误会啊？嗯…真是完全没想到。"
                },
                {
                    "id": "10200616",
                    "speaker": "Player",
                    "text": "还是很容易想到的。"
                },
                {
                    "id": "10200617",
                    "speaker": "刻晴",
                    "text": "话说回来，仙人所造的机关，居然有凡人能修好。这即使对「七星」来说，也算一件奇事。"
                },
                {
                    "id": "10200618",
                    "speaker": "派蒙",
                    "text": "嘿嘿，那个是…",
                    "choices": [
                        {
                            "id": "10200619",
                            "text": "（嘘…别节外生枝了，派蒙。）",
                            "response": [
                                {
                                    "id": "10200621",
                                    "speaker": "派蒙",
                                    "text": "咦？啊，哦…对了，这位「玉衡」大人，你知道「天权」大人为什么要邀请我们去群玉阁吗？"
                                },
                                {
                                    "id": "10200622",
                                    "speaker": "刻晴",
                                    "text": "叫我刻晴就好。"
                                },
                                {
                                    "id": "10200623",
                                    "speaker": "刻晴",
                                    "text": "凝光约你见面，我想，无非是希望「拯救蒙德的英雄」中立一些。至少…不要完全站在仙人一方。"
                                },
                                {
                                    "id": "10200624",
                                    "speaker": "派蒙",
                                    "text": "我们可没有站边！我们和那些仙人聊过，他们也是准备庇佑璃月的…"
                                },
                                {
                                    "id": "10200625",
                                    "speaker": "刻晴",
                                    "text": "你说的「庇佑」，就是指那种居高临下的傲慢吗？"
                                },
                                {
                                    "id": "10200626",
                                    "speaker": "派蒙",
                                    "text": "欸？"
                                },
                                {
                                    "id": "10200627",
                                    "speaker": "刻晴",
                                    "text": "因为你们是凡民，是他们庇佑的对象，所以他们不会把你当做「有能力刺杀神明的刺客」。"
                                },
                                {
                                    "id": "10200628",
                                    "speaker": "刻晴",
                                    "text": "所以他们一定也觉得，凝光封锁现场、盘问凡民、追捕刺客…这些命令全都是无用功，甚至是在掩盖什么。"
                                },
                                {
                                    "id": "10200629",
                                    "speaker": "刻晴",
                                    "text": "我直说了吧：这是在小看人。"
                                },
                                {
                                    "id": "10200630",
                                    "speaker": "派蒙",
                                    "text": "你这么说，确实也有点道理…"
                                },
                                {
                                    "id": "10200631",
                                    "speaker": "派蒙",
                                    "text": "不过，像你这样「不敬仙神」的璃月人，我还是第一次遇见呢。"
                                },
                                {
                                    "id": "10200632",
                                    "speaker": "刻晴",
                                    "text": "哈…我是要敬他们时间观念淡薄，又对凡人心存傲慢，所以暂时还不会对我们「七星」出手吗？"
                                },
                                {
                                    "id": "10200633",
                                    "speaker": "刻晴",
                                    "text": "算了，我不该这样谈论仙人。「不敬仙神」只是我个人的态度，凝光就绝对不会说这种话。"
                                },
                                {
                                    "id": "10200634",
                                    "speaker": "刻晴",
                                    "text": "总之，我也承认，这一次仙人们的行事，已经足够克制。"
                                },
                                {
                                    "id": "10200635",
                                    "speaker": "刻晴",
                                    "text": "帝君遇害，实在非比寻常。面对如此超出常理的事态，他们仍然愿意召集众仙商议、没有直接打来…"
                                },
                                {
                                    "id": "10200636",
                                    "speaker": "刻晴",
                                    "text": "这还挺文明的，真叫人意外。",
                                    "choices": [
                                        {
                                            "id": "10200637",
                                            "text": "所以，会有和谈的可能吗？",
                                            "response": [
                                                {
                                                    "id": "10200639",
                                                    "speaker": "刻晴",
                                                    "text": "凝光那个人呐…在她眼里，最好万事都能坐下商量——但这是不可能的。"
                                                },
                                                {
                                                    "id": "10200640",
                                                    "speaker": "刻晴",
                                                    "text": "「仙人」的时代已经过去了，如果连「璃月七星」都不敢正视这一点，那璃月的未来要怎么办啊？"
                                                },
                                                {
                                                    "id": "10200641",
                                                    "speaker": "派蒙",
                                                    "text": "唔…又是一句非常大胆的发言呢。"
                                                },
                                                {
                                                    "id": "10200642",
                                                    "speaker": "刻晴",
                                                    "text": "呼…那就言尽于此吧。其实我本来没必要说这么多，但你是很好的听众呢，旅行者。"
                                                },
                                                {
                                                    "id": "10200643",
                                                    "speaker": "刻晴",
                                                    "text": "好了，你们该去群玉阁了。要准时喔？因为求见凝光的预约，都已经排到明年了。"
                                                },
                                                {
                                                    "id": "10200644",
                                                    "speaker": "刻晴",
                                                    "text": "璃月的顶级富商们，都把「登上群玉阁」当作从商生涯的无上荣耀。人人都带着豪礼，只为从凝光手中换取些许好处。"
                                                },
                                                {
                                                    "id": "10200645",
                                                    "speaker": "派蒙",
                                                    "text": "好、好处？！",
                                                    "choices": [
                                                        {
                                                            "id": "10200646",
                                                            "text": "派蒙，那不是重点。",
                                                            "response": [
                                                                {
                                                                    "id": "10200648",
                                                                    "speaker": "派蒙",
                                                                    "text": "可是…可是！"
                                                                },
                                                                {
                                                                    "id": "10200649",
                                                                    "speaker": "派蒙",
                                                                    "text": "对了！「见面礼」也是璃月的珍贵文化，我们不是为了好处，是为了尊重璃月的传统文化…"
                                                                },
                                                                {
                                                                    "id": "10200650",
                                                                    "speaker": "Player",
                                                                    "text": "瞧这个派蒙殷勤的样子…"
                                                                },
                                                                {
                                                                    "id": "10200651",
                                                                    "speaker": "刻晴",
                                                                    "text": "好了好了，要送什么见面礼你们慢慢想，我先把去群玉阁的方法告诉你们。"
                                                                },
                                                                {
                                                                    "id": "10200652",
                                                                    "speaker": "刻晴",
                                                                    "text": "其实你们不必来天衡山的。回璃月港去吧，到月海亭找「引路人」，然后如此这般…"
                                                                },
                                                                {
                                                                    "id": "10200653",
                                                                    "speaker": "刻晴",
                                                                    "text": "那么，我们有缘再见吧，旅者。"
                                                                },
                                                                {
                                                                    "id": "10200654",
                                                                    "speaker": "派蒙",
                                                                    "text": "嗯…那位「玉衡星」虽然不敬仙神，但我觉得她是个相当飒爽的人呢。",
                                                                    "choices": [
                                                                        {
                                                                            "id": "10200655",
                                                                            "text": "我对她的印象也不错。",
                                                                            "response": [
                                                                                {
                                                                                    "id": "10200657",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "对了，要给凝光送什么见面礼呢…我想想…"
                                                                                },
                                                                                {
                                                                                    "id": "10200658",
                                                                                    "speaker": "Player",
                                                                                    "text": "派蒙的重点真的变成送礼了…"
                                                                                },
                                                                                {
                                                                                    "id": "10200659",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "对了！昨天我睡觉的时候，梦见了一道无比尊贵的点心——<color=#00E1FFFF>「糖霜史莱姆」</color>！"
                                                                                },
                                                                                {
                                                                                    "id": "10200660",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "我有预感，它很适合凝光这种身份的大富豪。"
                                                                                },
                                                                                {
                                                                                    "id": "10200661",
                                                                                    "speaker": "派蒙",
