    "talks": [
        {
            "id": "7050501",
            "objective": "与卢卡对话，进入酒馆",
            "dialogues": [
                {
                    "id": "705050101",
                    "speaker": "派蒙",
                    "text": "迪卢克老爷！真难得！是今天刚好闲着没事干吗？"
                },
                {
                    "id": "705050102",
                    "speaker": "迪卢克",
                    "text": "什么叫闲着没事干。我收到了你们兼任酒保的消息，过来看看而已。"
                },
                {
                    "id": "705050103",
                    "speaker": "派蒙",
                    "text": "哇，情报太灵通了！"
                },
                {
                    "id": "705050104",
                    "speaker": "迪卢克",
                    "text": "#所以，{NICKNAME}，当酒保的体验如何？"
                },
                {
                    "id": "705050105",
                    "speaker": "Player",
                    "text": "才刚开始…"
                },
                {
                    "id": "705050106",
                    "speaker": "派蒙",
                    "text": "是啊，迪卢克老爷问得太早啦，我们开张还没多久呢。"
                },
                {
                    "id": "705050107",
                    "speaker": "迪卢克",
                    "text": "只是想问问第一感觉。"
                },
                {
                    "id": "705050108",
                    "speaker": "迪卢克",
                    "text": "兴奋吗？还是困扰？有什么感受，直说就好。",
                    "choices": [
                        {
                            "id": "705050109",
                            "text": "还挺新奇的…",
                            "response": [
                                {
                                    "id": "705050111",
                                    "speaker": "迪卢克",
                                    "text": "原来如此。"
                                },
                                {
                                    "id": "705050112",
                                    "speaker": "派蒙",
                                    "text": "不、不问问我吗？"
                                },
                                {
                                    "id": "705050113",
                                    "speaker": "派蒙",
                                    "text": "我的第一感觉是…好喝！"
                                },
                                {
                                    "id": "705050114",
                                    "speaker": "迪卢克",
                                    "text": "……"
                                },
                                {
                                    "id": "705050115",
                                    "speaker": "迪卢克",
                                    "text": "那就好，为你高兴。"
                                },
                                {
                                    "id": "705050116",
                                    "speaker": "迪卢克",
                                    "text": "能请你帮我调一杯苍谷落日吗？杯量随意。"
                                },
                                {
                                    "id": "705050117",
                                    "speaker": "Player",
                                    "text": "明白了，请稍等片刻。"
                                },
                                {
                                    "id": "705050118",
                                    "speaker": "迪卢克",
                                    "text": "嗯，不用着急。"
                                }
                            ]
                        },
                        {
                            "id": "705050110",
                            "text": "有点手忙脚乱…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7050505",
            "objective": "前往吧台并完成营业准备",
            "dialogues": []
        },
        {
            "id": "7050504",
            "objective": "与迪卢克对话",
            "dialogues": []
        },
        {
            "id": "7050502",
            "objective": "为迪卢克调制指定饮品",
            "dialogues": [
                {
                    "id": "705050201",
                    "speaker": "迪卢克",
                    "text": "味道很不错。"
                },
                {
                    "id": "705050202",
                    "speaker": "派蒙",
                    "text": "主要还是原材料好！只要水果新鲜，就算什么也不加都会很甜。"
                },
                {
                    "id": "705050203",
                    "speaker": "迪卢克",
                    "text": "那就感谢蒙德的土地吧。"
                },
                {
                    "id": "705050204",
                    "speaker": "迪卢克",
                    "text": "…苍谷落日，是我第一次调出的饮品。"
                },
                {
                    "id": "705050205",
                    "speaker": "迪卢克",
                    "text": "那时还小，父亲摆出了几种材料，让我自己动手尝试。"
                },
                {
                    "id": "705050206",
                    "speaker": "迪卢克",
                    "text": "没有要求，也没有提示，多半是为了看我的灵性吧。"
                },
                {
                    "id": "705050207",
                    "speaker": "迪卢克",
                    "text": "最后我做出的，就是这样一杯果汁。"
                },
                {
                    "id": "705050208",
                    "speaker": "派蒙",
                    "text": "欸，为、为什么…"
                },
                {
                    "id": "705050209",
                    "speaker": "迪卢克",
                    "text": "父亲也很诧异。但当时的我并未考虑其他因素，只知道果汁很甜。"
                },
                {
                    "id": "705050210",
                    "speaker": "迪卢克",
                    "text": "现在想来，那是多么幼稚又短浅的认知啊…"
                },
                {
                    "id": "705050211",
                    "speaker": "Player",
                    "text": "我不这么认为。"
                },
                {
                    "id": "705050212",
                    "speaker": "迪卢克",
                    "text": "……",
                    "choices": [
                        {
                            "id": "705050213",
                            "text": "对他来说一定也是好饮品。",
                            "response": [
                                {
                                    "id": "705050215",
                                    "speaker": "迪卢克",
                                    "text": "我没有那样想过…毕竟，当时父亲什么都没说。"
                                },
                                {
                                    "id": "705050216",
                                    "speaker": "迪卢克",
                                    "text": "不过，谢谢你。"
                                },
                                {
                                    "id": "705050217",
                                    "speaker": "迪卢克",
                                    "text": "另外，有件东西想给你。"
                                },
                                {
                                    "id": "705050218",
                                    "speaker": "迪卢克",
                                    "text": "…等你对酒保工作有更多体验之后，再交给你比较好。以你的能力，一定能出色地完成这份工作。"
                                },
                                {
                                    "id": "705050219",
                                    "speaker": "派蒙",
                                    "text": "我也会…帮忙打气！"
                                },
                                {
                                    "id": "705050220",
                                    "speaker": "迪卢克",
                                    "text": "嗯，期待你们的成果。那我就先告辞了。"
                                },
                                {
                                    "id": "705050221",
                                    "speaker": "派蒙",
                                    "text": "有空再来哦！"
                                }
                            ]
                        },
                        {
                            "id": "705050214",
                            "text": "他一定也觉得很美味。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7050503",
            "objective": "将饮品交给迪卢克",
            "dialogues": []
        },
        {
            "id": "7050599",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "705059901",
                    "speaker": "派蒙",
                    "text": "好像不是对方想要的饮品…再重做一杯吧，这杯我来解决！"
                }
            ]
        }
    ]
