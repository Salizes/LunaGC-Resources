        {
            "id": "2074102",
            "objective": "将一份蒲公英带给葛瑞丝",
            "dialogues": []
        },
        {
            "id": "2074103",
            "objective": "把蒲公英籽交给葛瑞丝",
            "dialogues": [
                {
                    "id": "207411001",
                    "speaker": "葛瑞丝",
                    "text": "您搜集到蒲公英了吗？"
                },
                {
                    "id": "207411002",
                    "speaker": "Player",
                    "text": "搜集到了。"
                },
                {
                    "id": "207411003",
                    "speaker": "葛瑞丝",
                    "text": "这些就足够了，请您在这里稍等一下…"
                },
                {
                    "id": "207411004",
                    "speaker": "葛瑞丝",
                    "text": "…巴巴托斯大人，请您聆听我…"
                },
                {
                    "id": "207411005",
                    "speaker": "派蒙",
                    "text": "呜哇…她好虔诚啊，说了好多话。"
                },
                {
                    "id": "207411006",
                    "speaker": "派蒙",
                    "text": "…也不知道那个「卖唱的」能不能听到…"
                },
                {
                    "id": "207411007",
                    "speaker": "葛瑞丝",
                    "text": "好了，这些蒲公英籽交给您，请您帮我上去播撒一下吧。"
                },
                {
                    "id": "207411008",
                    "speaker": "葛瑞丝",
                    "text": "其实是应该我自己去的，但是…以我的身手，就算能爬上去，应该也难得下来了…"
                },
                {
                    "id": "207411009",
                    "speaker": "葛瑞丝",
                    "text": "所以，就拜托您了。"
                }
            ]
        },
        {
            "id": "2074104",
            "objective": "在风神像手上播撒蒲公英",
            "dialogues": []
        },
        {
            "id": "2074105",
            "objective": "与葛瑞丝对话",
            "dialogues": [
                {
                    "id": "207412001",
                    "speaker": "葛瑞丝",
                    "text": "您把蒲公英播撒出去了吗？",
                    "choices": [
                        {
                            "id": "207412002",
                            "text": "已经播撒出去了。",
                            "response": [
                                {
                                    "id": "207412005",
                                    "speaker": "葛瑞丝",
                                    "text": "无论如何，希望巴巴托斯大人能够听到我的声音。"
                                },
                                {
                                    "id": "207412006",
                                    "speaker": "葛瑞丝",
                                    "text": "谢谢您愿意帮忙，这是谢礼，请收下吧。愿风神护佑您。"
                                }
                            ]
                        },
                        {
                            "id": "207412003",
                            "text": "应该会随风飘很远的。",
                            "response": [
                                {
                                    "id": "207412004",
                                    "speaker": "葛瑞丝",
                                    "text": "那样就太好了，巴巴托斯大人也会更容易注意到。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2074190",
            "objective": "Additional",
            "dialogues": [
                {
