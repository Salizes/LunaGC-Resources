    "talks": [
        {
            "id": "7904401",
            "objective": "聆听特别的广播$HIDDEN",
            "dialogues": [
                {
                    "id": "790440101",
                    "speaker": "乐园告示喇叭",
                    "text": "由衷感谢命运的指引，四处徘徊的旅人们啊，你们总算来到了这里！"
                },
                {
                    "id": "790440102",
                    "speaker": "乐园告示喇叭",
                    "text": "你们必然也在寻找一场超越惊喜的邂逅，一次超乎想象的旅途？"
                },
                {
                    "id": "790440103",
                    "speaker": "乐园告示喇叭",
                    "text": "如今，我们互相成全的机会，正摆在你们面前！"
                },
                {
                    "id": "790440104",
                    "speaker": "乐园告示喇叭",
                    "text": "投身于全新的剧集「黛依阿的三日遐想」，置身于话剧的舞台之上，你们就能获得前所未有的新奇体验！"
                },
                {
                    "id": "790440105",
                    "speaker": "乐园告示喇叭",
                    "text": "畅游于摩拉的浴池之中…驱散古堡中的幽魂…挣脱重力的束缚…"
                },
                {
                    "id": "790440106",
                    "speaker": "乐园告示喇叭",
                    "text": "轻轻念出暗号：「带我们前往遐想的世界」，昭示你们的好奇与热情，就此启程吧！"
                },
                {
                    "id": "790440107",
                    "speaker": "派蒙",
                    "text": "唔，喇叭那一头的人真是激动啊，虽然不知道她具体在说什么…"
                },
                {
                    "id": "790440108",
                    "speaker": "派蒙",
                    "text": "旅途？剧集？舞台？还有什么…摩拉的浴池！",
                    "choices": [
                        {
                            "id": "790440109",
                            "text": "可能是一种新的游乐项目。",
                            "response": [
                                {
                                    "id": "790440111",
                                    "speaker": "派蒙",
                                    "text": "喔！这么一说，我好像能理解了，以前听说过类似的活动呢。"
                                },
                                {
                                    "id": "790440112",
                                    "speaker": "派蒙",
                                    "text": "所以喇叭后面正在说话的那个人，就是「黛依阿」吗？她是话剧的导演。"
                                },
                                {
                                    "id": "790440113",
                                    "speaker": "派蒙",
                                    "text": "如果我们报名，就可以成为这些话剧中的角色？",
                                    "choices": [
                                        {
                                            "id": "790440114",
                                            "text": "派蒙感兴趣吗？",
                                            "response": [
                                                {
                                                    "id": "790440116",
                                                    "speaker": "派蒙",
                                                    "text": "听起来还挺有意思的！我想见识一下摩拉的浴池…"
                                                },
                                                {
                                                    "id": "790440117",
                                                    "speaker": "派蒙",
                                                    "text": "呃…不对！我想看看，能在「琉形蜃境」里占据一席之地的游乐项目，究竟有什么神奇的地方。"
                                                },
                                                {
                                                    "id": "790440118",
                                                    "speaker": "派蒙",
                                                    "text": "那，我们就一起念出报名的口号吧！"
                                                },
                                                {
                                                    "id": "790440119",
                                                    "speaker": "Player",
                                                    "text": "带我们前往遐想的世界吧！"
                                                },
                                                {
                                                    "id": "790440120",
                                                    "speaker": "派蒙",
                                                    "text": "带我们前往遐想的世界吧！"
                                                },
                                                {
                                                    "id": "790440121",
                                                    "speaker": "乐园告示喇叭",
                                                    "text": "居然这么干脆？"
                                                },
                                                {
                                                    "id": "790440122",
                                                    "speaker": "乐园告示喇叭",
                                                    "text": "咳咳，简直完美！报名信号已确认，「黛依阿的三日遐想」即将开幕！"
                                                },
                                                {
                                                    "id": "790440123",
                                                    "speaker": "乐园告示喇叭",
                                                    "text": "「古老的传说重现天日，价值连城的宝藏有了新的线索，一队侠义的海盗擦亮了武器，升起了船帆…」"
                                                },
                                                {
                                                    "id": "790440124",
                                                    "speaker": "乐园告示喇叭",
                                                    "text": "「漂浮在天空之中的小镇遭遇了空前的危机，创造奇迹的建筑师要及时挽救这座正在坠落的高城…」"
                                                },
                                                {
                                                    "id": "790440125",
                                                    "speaker": "乐园告示喇叭",
                                                    "text": "「为了拯救不幸罹难的伙伴，落单的水形幻灵即将闯入幽魂盘踞的古堡，寻找破除『魔咒』的希望…」"
                                                },
                                                {
                                                    "id": "790440126",
                                                    "speaker": "乐园告示喇叭",
                                                    "text": "三个不同主题的剧集，任各位自由赏玩。"
                                                },
                                                {
                                                    "id": "790440127",
                                                    "speaker": "乐园告示喇叭",
                                                    "text": "寻找这样的告示喇叭，遵循旁白的指引，就能向着遐想之地进发！"
                                                },
                                                {
                                                    "id": "790440128",
                                                    "speaker": "派蒙",
                                                    "text": "#我明白了！{NICKNAME}，接下来我们就去找找这样的喇叭，好好试试看吧！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "790440115",
                                            "text": "我们一起来当演员？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "790440110",
                            "text": "比如游客参与表演的话剧。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7904402",
            "objective": "完成三个剧目：",
            "dialogues": []
        },
        {
            "id": "7904407",
            "objective": "(test)完成海盗-计数用$HIDDEN",
            "dialogues": [
                {
                    "id": "790440701",
                    "speaker": "派蒙",
                    "text": "唔…等等，之前还没有注意到，这里有一个隐藏的门？"
                },
                {
                    "id": "790440702",
                    "speaker": "派蒙",
                    "text": "我好像明白了，念出报名时的那句暗号，就能打开新的道路！"
                },
                {
                    "id": "790440703",
                    "speaker": "Player",
                    "text": "我们一起来念暗号吧！"
                },
                {
                    "id": "790440704",
                    "speaker": "派蒙",
                    "text": "好啊！报名的时候，我们就是一起喊出口号的，这种时候当然也要注重仪式感！"
                },
                {
                    "id": "790440705",
                    "speaker": "Black Screen",
                    "text": "和派蒙一起念出关键的暗号：「带我们前往遐想的世界」。"
                },
                {
                    "id": "790440706",
                    "speaker": "Black Screen",
                    "text": "随着机件运作的声响，活动的门板开启，展现出了下方的通道。"
                }
            ]
        },
        {
            "id": "7904408",
            "objective": "(test)完成古堡-计数用$HIDDEN",
            "dialogues": [
                {
                    "id": "790440801",
                    "speaker": "派蒙",
                    "text": "果然没错！下面有一个暗室，肯定藏着什么秘密！"
                },
                {
                    "id": "790440802",
                    "speaker": "派蒙",
                    "text": "嘿嘿，特别的礼物，还有神奇的黛依阿，我们来啦！"
                }
            ]
        },
        {
            "id": "7904409",
            "objective": "(test)完成飞屋-计数用$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7904403",
            "objective": "(test)完成奇影之旅$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7904410",
            "objective": "前往广播室",
            "dialogues": []
        },
        {
            "id": "7904404",
            "objective": "探索广播室",
            "dialogues": []
        },
        {
            "id": "7904405",
            "objective": "见证剧目背后的真相",
            "dialogues": [
                {
                    "id": "790440601",
                    "speaker": "派蒙",
                    "text": "呜啊！怎么有这么多的「小水珠」…它们围着一台超大的机器，在忙来忙去？"
                },
                {
                    "id": "790440602",
                    "speaker": "派蒙",
                    "text": "完全不明白，这台机器是干什么的？黛依阿又在哪里？"
                },
                {
                    "id": "790440603",
                    "speaker": "乐园告示喇叭",
                    "text": "欢迎探访「三日遐想」最真实的幕后！你们现在一定很疑惑吧——眼前的场景说明了什么？"
                },
                {
                    "id": "790440604",
                    "speaker": "乐园告示喇叭",
                    "text": "我们这就向你们详细展示！"
                },
                {
                    "id": "790440605",
                    "speaker": "乐园告示喇叭",
                    "text": "「偷懒鬼」，别打盹了，快去一号位置，进行二号操作！"
                },
                {
                    "id": "790440606",
                    "speaker": "乐园告示喇叭",
                    "text": "「由衷感谢命运的指引，四处徘徊的旅人们啊，你们总算来到了这里！」"
                },
                {
                    "id": "790440607",
                    "speaker": "派蒙",
                    "text": "那个「小水珠」在操纵喇叭，播放…录音？"
                },
                {
                    "id": "790440608",
                    "speaker": "派蒙",
                    "text": "好耳熟…总觉得在哪里听过这句话？",
                    "choices": [
                        {
                            "id": "790440609",
                            "text": "最开始发现活动的告示喇叭…",
                            "response": [
                                {
                                    "id": "790440611",
                                    "speaker": "乐园告示喇叭",
                                    "text": "「全勤王」，在三号位置进行七号操作，拜托了！"
                                },
                                {
                                    "id": "790440612",
                                    "speaker": "来自喇叭的旁白",
                                    "text": "「出现在新人眼前的大副衣衫褴褛，全身上下打满绷带，显然，不久之前，他才经历过一场激烈的战斗…」"
                                },
                                {
                                    "id": "790440613",
                                    "speaker": "派蒙",
                                    "text": "我想起来了！这一段是「黑水晶号与吞金海怪」的旁白，我们与大副刚刚见面的情景！"
                                },
                                {
                                    "id": "790440614",
                                    "speaker": "派蒙",
                                    "text": "原来当时听到的录音是这样播放出来的…时机也很准确呢！"
                                },
                                {
                                    "id": "790440615",
                                    "speaker": "乐园告示喇叭",
                                    "text": "「大冒失」，「黑水晶」号快要抵达宝藏前的关隘了，赶快把所有布景和机关都升起来…千万别搞错了！"
                                },
                                {
                                    "id": "790440616",
                                    "speaker": "派蒙",
                                    "text": "那个「小水珠」好像在用什么看不见的方法…操作面前的仪器？",
                                    "choices": [
                                        {
                                            "id": "790440617",
                                            "text": "监测、播音和机关控制…",
                                            "response": [
                                                {
                                                    "id": "790440619",
                                                    "speaker": "乐园告示喇叭",
                                                    "text": "没错，这台巨大设备的功能，正是对剧目中的所有功能进行调度！"
                                                },
                                                {
                                                    "id": "790440620",
                                                    "speaker": "乐园告示喇叭",
                                                    "text": "勤恳的水形幻灵们时刻观察着剧目演出的进度，在游客抵达特定位置时，就播放剧本上的旁白，启动相应的机关…"
                                                },
                                                {
                                                    "id": "790440621",
                                                    "speaker": "乐园告示喇叭",
                                                    "text": "只要游客老老实实跟着流程走，就能顺利观赏到「三日遐想」的全部演出！"
                                                },
                                                {
                                                    "id": "790440622",
                                                    "speaker": "乐园告示喇叭",
                                                    "text": "当然，假如游客中途跳车，或者做出了其他超出预期的行为，那就没法完整体验剧目了。"
                                                },
                                                {
                                                    "id": "790440623",
                                                    "speaker": "乐园告示喇叭",
                                                    "text": "我们的员工数量不够，暂时没法应对这种情况…但我们相信，游客们肯定不会乱来的！"
                                                },
                                                {
                                                    "id": "790440624",
                                                    "speaker": "派蒙",
                                                    "text": "好，好厉害！我们当时光顾着玩了，没想到幕后还有这么多门道！"
                                                },
                                                {
                                                    "id": "790440625",
                                                    "speaker": "派蒙",
                                                    "text": "现在想想，一路上有那么多机关要启动，控制演出的难度不是一般的高呢…",
                                                    "choices": [
                                                        {
                                                            "id": "790440626",
                                                            "text": "真是巧妙的设计。",
                                                            "response": [
                                                                {
                                                                    "id": "790440628",
                                                                    "speaker": "派蒙",
                                                                    "text": "所以说…现在正在和我们说话的这个声音，就是黛依阿吗？"
                                                                },
                                                                {
                                                                    "id": "790440629",
                                                                    "speaker": "派蒙",
                                                                    "text": "你在借助这些水形幻灵控制「三日遐想」演出？为什么不亲自和我们解释呢？"
                                                                },
                                                                {
                                                                    "id": "790440630",
                                                                    "speaker": "派蒙",
                                                                    "text": "我还有好多问题想问你！"
                                                                },
                                                                {
                                                                    "id": "790440631",
                                                                    "speaker": "乐园告示喇叭",
                                                                    "text": "猜对了，但也不全对。"
                                                                },
                                                                {
                                                                    "id": "790440632",
                                                                    "speaker": "乐园告示喇叭",
                                                                    "text": "你们所见的，这间广播室里的一切——控制器、「总导演」、「假编剧」、「偷懒鬼」、「全勤王」和「大冒失」…"
                                                                },
                                                                {
                                                                    "id": "790440633",
                                                                    "speaker": "乐园告示喇叭",
                                                                    "text": "当然，还有没露面或者没发声的，其他维护着剧目演出的水形幻灵。"
                                                                },
                                                                {
                                                                    "id": "790440634",
                                                                    "speaker": "乐园告示喇叭",
                                                                    "text": "所有组合在一起，才是这道声音——「黛依阿」的本尊，创造并控制演出的关键体系，而非一个具体的人。"
                                                                },
                                                                {
                                                                    "id": "790440635",
                                                                    "speaker": "派蒙",
                                                                    "text": "黛依阿不是一个人…是一个体系？"
                                                                },
                                                                {
                                                                    "id": "790440636",
                                                                    "speaker": "派蒙",
                                                                    "text": "慢着慢着，有点超出我的理解能力了…"
                                                                },
                                                                {
                                                                    "id": "790440637",
                                                                    "speaker": "派蒙",
                                                                    "text": "虽然我知道「小水珠」们也很聪明，但只凭「小水珠」们，真的能设计出这么复杂的一套…体系吗？",
                                                                    "choices": [
                                                                        {
                                                                            "id": "790440638",
                                                                            "text": "幕后应该有着专门的设计师。",
                                                                            "response": [
                                                                                {
                                                                                    "id": "790440640",
                                                                                    "speaker": "黛依阿",
                                                                                    "text": "最初的确是这样啦，你们的惊讶也在预料之中。"
                                                                                },
                                                                                {
                                                                                    "id": "790440641",
                                                                                    "speaker": "黛依阿",
                                                                                    "text": "说来话长了，「黛依阿的三日遐想」起源于热情洋溢的佐西摩斯导演。"
                                                                                },
                                                                                {
                                                                                    "id": "790440642",
                                                                                    "speaker": "黛依阿",
                                                                                    "text": "他在「琉形蜃境」中暂住时，将大部分精力放在了那部最精彩的舞台剧上，无暇再筹备其他剧目。"
                                                                                },
                                                                                {
                                                                                    "id": "790440643",
                                                                                    "speaker": "黛依阿",
                                                                                    "text": "与水形幻灵们相处一段时间后，他发现了水形幻灵们的智慧与丰富的情感。"
                                                                                },
                                                                                {
                                                                                    "id": "790440644",
                                                                                    "speaker": "黛依阿",
                                                                                    "text": "水形幻灵们很喜欢他的话剧，想要见证更多精彩的演出，并将这份喜悦传递给其他访客。"
                                                                                },
                                                                                {
                                                                                    "id": "790440645",
                                                                                    "speaker": "黛依阿",
                                                                                    "text": "一个想法在佐西摩斯导演心中萌生了：可不可以让水形幻灵们自行导演剧目，甚至设计剧目？"
                                                                                },
                                                                                {
                                                                                    "id": "790440646",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "好大胆！听起来就像是…教一群孩子来当导演！"
                                                                                },
                                                                                {
                                                                                    "id": "790440647",
                                                                                    "speaker": "黛依阿",
                                                                                    "text": "确实有难度，好在大家一起努力，成功克服了所有困难！"
                                                                                },
                                                                                {
                                                                                    "id": "790440648",
                                                                                    "speaker": "黛依阿",
                                                                                    "text": "佐西摩斯导演努力教导几位热爱话剧的水形幻灵，让它们理解了操办演出的关键流程。"
                                                                                },
                                                                                {
                                                                                    "id": "790440649",
                                                                                    "speaker": "黛依阿",
                                                                                    "text": "经过一番试错，他用水形幻灵们能理解的语言，写下了许多部范例剧目，以及详实的剧作说明书。"
                                                                                },
                                                                                {
                                                                                    "id": "790440650",
                                                                                    "speaker": "黛依阿",
                                                                                    "text": "在伊迪娅的帮助下，他制造了这台控制器，在各地搭建了与其相连的机关。"
                                                                                },
                                                                                {
                                                                                    "id": "790440651",
                                                                                    "speaker": "黛依阿",
                                                                                    "text": "除了剧本里的台词，佐西摩斯导演还录下了大部分常见字词的语音，好让我们组合出正确的语句，和游客们沟通。"
                                                                                },
                                                                                {
                                                                                    "id": "790440652",
                                                                                    "speaker": "黛依阿",
                                                                                    "text": "经过一段时间的磨合，我们终于可以顺利运作三部范例剧目了。"
                                                                                },
                                                                                {
                                                                                    "id": "790440653",
                                                                                    "speaker": "黛依阿",
                                                                                    "text": "它们正是「黑水晶号与吞金海怪」、「瞳孔里的固形魔咒」、还有「天空高城救守记」！"
                                                                                },
                                                                                {
                                                                                    "id": "790440654",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "也就是说…佐西摩斯导演为「黛依阿的三日遐思」留下了基础的条件，合适的剧本，还有详细的说明书。"
                                                                                },
                                                                                {
                                                                                    "id": "790440655",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "我们在游玩的过程中完全没有察觉到，这一切都是「小水珠」们在控制的呢。"
                                                                                },
                                                                                {
                                                                                    "id": "790440656",
                                                                                    "speaker": "黛依阿",
                                                                                    "text": "多谢夸奖！你们的游玩肯定了我们的努力，验证了我们的许多想法…"
                                                                                },
                                                                                {
                                                                                    "id": "790440657",
                                                                                    "speaker": "黛依阿",
                                                                                    "text": "所以，我们想给你们一份丰厚的谢礼，并将创作路上的一切与你们分享。",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "790440658",
                                                                                            "text": "客气客气。",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "790440660",
                                                                                                    "speaker": "派蒙",
                                                                                                    "text": "对哦，我们体验到了特别的游乐项目，还开拓了眼界，我们也要谢谢你们，黛依阿！"
                                                                                                },
                                                                                                {
                                                                                                    "id": "790440661",
                                                                                                    "speaker": "黛依阿",
                                                                                                    "text": "啊哈哈！现在我们要向着下一个目标前进了，那就是独立创作剧本！"
                                                                                                },
                                                                                                {
                                                                                                    "id": "790440662",
                                                                                                    "speaker": "黛依阿",
                                                                                                    "text": "为此，我们还要进一步加强我们对「剧作」的理解，不断取材。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "790440663",
                                                                                                    "speaker": "黛依阿",
                                                                                                    "text": "我们当中有一位「假编剧」，它会听取各种访客的故事，充实我们的想法。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "790440664",
                                                                                                    "speaker": "黛依阿",
                                                                                                    "text": "就算没有遇见合适的访客，「假编剧」也会探访其他水形幻灵，聊聊它们与访客们的经历。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "790440665",
                                                                                                    "speaker": "派蒙",
                                                                                                    "text": "原来如此，所以说，我们和「假编剧」讲故事，就是在帮你们创作新的话剧！"
                                                                                                },
                                                                                                {
                                                                                                    "id": "790440666",
                                                                                                    "speaker": "黛依阿",
                                                                                                    "text": "没错没错！如果你们有空，就请和「假编剧」多聊聊！"
                                                                                                },
                                                                                                {
                                                                                                    "id": "790440667",
                                                                                                    "speaker": "黛依阿",
                                                                                                    "text": "另外，还请你们继续在「琉形蜃境」里好好游玩，尽情冒险，多多和其他水形幻灵互动！"
                                                                                                },
                                                                                                {
                                                                                                    "id": "790440668",
                                                                                                    "speaker": "派蒙",
                                                                                                    "text": "#不用担心哦，我和{NICKNAME}可喜欢这里了，一定会为你们提供很多素材的！"
                                                                                                },
                                                                                                {
                                                                                                    "id": "790440669",
                                                                                                    "speaker": "派蒙",
                                                                                                    "text": "嗯…还有一个问题…我已经好奇很久了！"
                                                                                                },
                                                                                                {
                                                                                                    "id": "790440670",
                                                                                                    "speaker": "派蒙",
                                                                                                    "text": "「三日遐思」里的「三日」到底是什么意思呢？"
                                                                                                },
                                                                                                {
                                                                                                    "id": "790440671",
                                                                                                    "speaker": "派蒙",
                                                                                                    "text": "难道说，佐西摩斯导演写下每个剧本的时间，都是三天？还是说，一共用了三天？",
                                                                                                    "choices": [
                                                                                                        {
                                                                                                            "id": "790440672",
                                                                                                            "text": "哈哈，这一题我会！",
                                                                                                            "response": [
                                                                                                                {
                                                                                                                    "id": "790440674",
                                                                                                                    "speaker": "派蒙",
                                                                                                                    "text": "「昨天」、「今天」和「明天」？好像很有道理！"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "790440675",
                                                                                                                    "speaker": "派蒙",
                                                                                                                    "text": "这说明佐西摩斯导演…不对，是「黛依阿」的所有成员，每天都在专心创作，超级努力！"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "790440676",
                                                                                                                    "speaker": "黛依阿",
                                                                                                                    "text": "好想法！可惜有点抬举我们了啦。"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "790440677",
                                                                                                                    "speaker": "黛依阿",
                                                                                                                    "text": "「三日」的真实含义其实是——"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "790440678",
                                                                                                                    "speaker": "黛依阿",
                                                                                                                    "text": "「时间还早的明天」、「状态更好的明天」和「再不搞定就完蛋了的明天」。"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "790440679",
                                                                                                                    "speaker": "派蒙",
                                                                                                                    "text": "欸？怎么这样！"
                                                                                                                }
                                                                                                            ]
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "790440673",
                                                                                                            "text": "是「昨天」、「今天」和「明天」吧！"
                                                                                                        }
                                                                                                    ]
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "790440659",
                                                                                            "text": "我们也玩得很开心。"
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "790440639",
                                                                            "text": "还要有把控剧本的人才对吧？"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "790440627",
                                                            "text": "真是准确的配合。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "790440618",
                                            "text": "有这些控制功能就够了。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "790440610",
                            "text": "它就在播放这一段宣传词。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7904406",
