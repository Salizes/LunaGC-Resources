        "rewards_formatted": "冒险阅历 x150, 原石 x20, 摩拉 x25000",
        "chapter": {
            "icon": "UI_ChapterIcon_Common",
            "id": "10135",
            "num": "",
            "title": "黛依阿的三日遐想"
        },
        "total_dialogue_lines": 115,
        "total_speaker_counts": {
            "Black Screen": 2,
            "Player": 18,
            "乐园告示喇叭": 28,
            "来自喇叭的旁白": 1,
